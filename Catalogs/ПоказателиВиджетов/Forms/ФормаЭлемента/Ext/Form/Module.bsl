
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РеквизитОбъект = РеквизитФормыВЗначение("Объект");
	Шрифт = РеквизитОбъект.Шрифт.Получить();
	Если Шрифт = Неопределено Тогда
		Шрифт = ШрифтыСтиля.ОбычныйШрифтТекста;
	КонецЕсли;
	
	ЗаполнитьИсточник();
	ОбновитьДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.Шрифт = Новый ХранилищеЗначения(Шрифт);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДействиеПриИзменении(Элемент)
	
	Объект.Источник = "";
	ОбновитьДоступностьЭлементов();
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьИсточник()
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Метаданные.Справочники);
	МассивТипов.Добавить(Метаданные.Документы);
	МассивТипов.Добавить(Метаданные.ЖурналыДокументов);
	МассивТипов.Добавить(Метаданные.РегистрыСведений);
	МассивТипов.Добавить(Метаданные.РегистрыНакопления);
	
	Для Каждого ТипМетаданных Из МассивТипов Цикл
		Для Каждого ОчередныеМетаданные Из Метаданные.Справочники Цикл
			Элементы.Источник.СписокВыбора.Добавить(ОчередныеМетаданные.ПолноеИмя());
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьЭлементов()
	
	Элементы.Источник.Доступность = (Объект.Действие = Перечисления.ДействияВиджетов.ОткрытьФормуСписка);
	Элементы.АлгоритмДействия.Доступность = (Объект.Действие = Перечисления.ДействияВиджетов.ВыполнитьАлгоритм);
	
КонецПроцедуры

#КонецОбласти

