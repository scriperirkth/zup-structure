#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Не должно быть результатов с одинаковым представлением,
	// иначе это приведет к появлению кнопок с одинаковыми заголовками
	Для Каждого РезультатВыполнения Из РезультатыВыполнения Цикл
		
		Если РезультатыВыполнения.НайтиСтроки(Новый Структура("ПредставлениеРезультата",РезультатВыполнения.ПредставлениеРезультата)).Количество() > 1 Тогда
			
			ТекстСообщения = НСтр("ru='Не должно быть результатов выполнения с одинаковым представлением.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,ЭтотОбъект,"РезультатыВыполнения["+(РезультатВыполнения.НомерСтроки-1)+"].ПредставлениеРезультата",,Отказ);
			
			Прервать;
			
		КонецЕсли;
		
		Если РезультатыВыполнения.НайтиСтроки(Новый Структура("СтатусПослеВыполнения",РезультатВыполнения.СтатусПослеВыполнения)).Количество() > 1 Тогда
			
			ТекстСообщения = НСтр("ru='Не должно быть результатов выполнения, устанавливающих одинаковый статус.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,ЭтотОбъект,"РезультатыВыполнения["+(РезультатВыполнения.НомерСтроки-1)+"].СтатусПослеВыполнения",,Отказ);
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИдентификаторПоддержки = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
