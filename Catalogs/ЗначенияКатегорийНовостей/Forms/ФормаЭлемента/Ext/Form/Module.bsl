#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Владелец.Пустая() Тогда // Возможно, вручную создают
		Элементы.Владелец.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.Владелец.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ОбновляетсяССервера = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Объект.Владелец,
		"ОбновляетсяССервера");
	
	Если ОбновляетсяССервера Тогда
		
		ПараметрыСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
		ПараметрыСообщения.ТипСообщения = "Информация";
		ПараметрыСообщения.Сообщение =  НСтр("ru = 'Значения категории обновляются автоматически, редактирование не требуется.'");
		ПараметрыСообщения.Идентификатор = "ОбновлениеССервера";
		ПараметрыСообщения.КраткоеПредставление = НСтр("ru = 'Обновление с сервера'");
		ПараметрыСообщения.Скрываемый = Ложь;
		ОбщегоНазначения.ДобавитьВажноеСообщение(
			ЭтотОбъект,
			ПараметрыСообщения);
		
		ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(
			ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
