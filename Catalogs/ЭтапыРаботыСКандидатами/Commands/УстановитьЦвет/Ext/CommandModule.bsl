
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Кандидаты") Тогда
		ЭтапРаботы = ЭтапРаботыПоКандидату(ПараметрКоманды);
	Иначе
		ЭтапРаботы = ПараметрКоманды;
	КонецЕсли;
	
	ПараметрФормы = Новый Структура("ЭтапРаботы", ЭтапРаботы);
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ОбновитьТекущуюФорму", ЭтотОбъект);
	
	ОткрытьФорму("РегистрСведений.ЦветаЭтаповРаботыСКандидатами.Форма.ЦветЭтапа",
		ПараметрФормы, ЭтотОбъект,,,, ОписаниеОповещенияОЗакрытии);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЭтапРаботыПоКандидату(Кандидат)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТекущиеЭтапыРаботыСКандидатами.ЭтапРаботы
		|ИЗ
		|	РегистрСведений.ТекущиеЭтапыРаботыСКандидатами КАК ТекущиеЭтапыРаботыСКандидатами
		|ГДЕ
		|	ТекущиеЭтапыРаботыСКандидатами.Кандидат = &Кандидат";
	
	Запрос.УстановитьПараметр("Кандидат", Кандидат);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка= РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЭтапРаботы;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьТекущуюФорму(Результат, ДопПараметры) Экспорт
	
	Оповестить("ОбновитьУсловноеОформление");
	
КонецПроцедуры

#КонецОбласти
