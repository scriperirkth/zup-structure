#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Вакансии", ПараметрКоманды);
	ДополнительныеПараметры.Вставить("ДатаСостояния", НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()));
	
	СостоянияВакансийКлиент.НачатьУстановкуСостояния(
		ПараметрКоманды, 
		НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()), 
		ПредопределенноеЗначение("Перечисление.СостоянияВакансии.Приостановлена"),
		Новый ОписаниеОповещения("ПриостановитьНабор", ЭтотОбъект, ДополнительныеПараметры));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриостановитьНабор(Результат, ДополнительныеПараметры) Экспорт
	
	Вакансии = ДополнительныеПараметры.Вакансии;
	
	ПриостановитьНаборНаСервере(Вакансии, ДополнительныеПараметры.ДатаСостояния);
	ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъектов(Вакансии);
	
	НачатьСнятиеПубликаций(ПубликацииВакансий(Вакансии));
	
КонецПроцедуры

&НаСервере
Процедура ПриостановитьНаборНаСервере(Вакансии, ДатаПриостановки)
	Справочники.Вакансии.ПриостановитьНабор(Вакансии, ДатаПриостановки);
КонецПроцедуры

&НаСервере
Функция ПубликацииВакансий(Вакансии)
	Возврат РекрутинговыеСайты.ПубликацииВакансий(Вакансии, , Истина);
КонецФункции

&НаКлиенте
Процедура НачатьСнятиеПубликаций(ПубликацииВакансий)
	
	Если ПубликацииВакансий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПубликацииВакансий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ПубликацииВакансий");
	ДополнительныеПараметры.ПубликацииВакансий = ПубликацииВакансий;

	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Отмена публикаций на сайтах'");
	ПараметрыВопроса.КнопкаПоУмолчанию = КодВозвратаДиалога.Да;
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗавершитьСнятиеПубликаций", ЭтотОбъект, ДополнительныеПараметры), 
		НСтр("ru = 'На рекрутинговых сайтах остались активные публикации.
			 |Снять эти вакансии с публикации?'"), 
		РежимДиалогаВопрос.ДаНет, 
		ПараметрыВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСнятиеПубликаций(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = Неопределено Или Ответ.Значение <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РекрутинговыеСайтыКлиент.СнятьПубликациюВакансий(ДополнительныеПараметры.ПубликацииВакансий);
	Оповестить("ПубликацияВакансии");
	
КонецПроцедуры

#КонецОбласти