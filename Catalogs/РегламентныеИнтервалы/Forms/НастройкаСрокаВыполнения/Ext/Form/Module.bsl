
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Срок выполнения регламентного интервала ""%1""'"),
		Параметры.НаименованиеРегламентногоИнтервала);
	
	СрокЗависитОтВремениНачала = Параметры.СрокЗависитОтВремениНачала;
	ВремяНачала = Параметры.ВремяНачала;
	СрокВыполненияЧасы = Параметры.СрокВыполненияЧасы;
	СрокВыполненияДни = Параметры.СрокВыполненияДни;
	СпособУказанияВремениОкончания = Параметры.СпособУказанияВремениОкончания;
	ВремяОкончания = Параметры.ВремяОкончания;
	СрокВыполненияЧасыПосле = Параметры.СрокВыполненияЧасыПосле;
	СрокВыполненияДниПосле = Параметры.СрокВыполненияДниПосле;
	СпособУказанияВремениОкончанияПосле = Параметры.СпособУказанияВремениОкончанияПосле;
	ВремяОкончанияПосле = Параметры.ВремяОкончанияПосле;
	
	ИспользуютсяГрафикиРаботы = ПроцессыОбработкиДокументовВызовСервера.ИспользуютсяГрафикиРаботы();
	ПредставлениеВариантаДоКонцаДня = ?(ИспользуютсяГрафикиРаботы, НСтр("ru='до конца рабочего дня'"), НСтр("ru='до конца дня'"));
	
	СписокВариантовОкончанияДня.Добавить(0, ПредставлениеВариантаДоКонцаДня);
	СписокВариантовОкончанияДня.Добавить(1, НСтр("ru='до указанного времени:'"));
	СписокВариантовОкончанияДня.Добавить(2, НСтр("ru='окончание дня не указано'"));
	
	ПредставлениеВариантаКонцаДня = СписокВариантовОкончанияДня.НайтиПоЗначению(СпособУказанияВремениОкончания).Представление;
	ПредставлениеВариантаКонцаДняПосле = СписокВариантовОкончанияДня.НайтиПоЗначению(СпособУказанияВремениОкончанияПосле).Представление;
	
	УстановитьСвойстваЭлементовСрок(Элементы, СрокВыполненияЧасы, СпособУказанияВремениОкончания);
	УстановитьСвойстваЭлементовСрокПосле(Элементы, СрокВыполненияЧасыПосле, СпособУказанияВремениОкончанияПосле);
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьТекстПодсказки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СрокВыполненияЗависитОтВремениНачалаПриИзменении(Элемент)
	
	Если СрокЗависитОтВремениНачала Тогда
		
		Если Не ЗначениеЗаполнено(ВремяНачала) Тогда
			ВремяНачала = Дата(1,1,1,12,0,0);
		КонецЕсли;
		
		Если СрокВыполненияДниПосле = 0 И СрокВыполненияЧасыПосле = 0 И СпособУказанияВремениОкончанияПосле = 0 Тогда
			
			СрокВыполненияДниПосле = СрокВыполненияДни;
			СрокВыполненияЧасыПосле = СрокВыполненияЧасы;
			СпособУказанияВремениОкончанияПосле = СпособУказанияВремениОкончания;
			
			УстановитьСвойстваЭлементовСрокПосле(Элементы, СрокВыполненияЧасыПосле, СпособУказанияВремениОкончанияПосле);
			
		КонецЕсли;
		
	Иначе
		СрокВыполненияДниПосле = 0;
		СрокВыполненияЧасыПосле = 0;
		СпособУказанияВремениОкончанияПосле = 0;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы();
	ОбновитьТекстПодсказки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеВариантаКонцаДняНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораКонцаДня", ЭтотОбъект);
	ПоказатьВыборИзМеню(Оповещение, СписокВариантовОкончанияДня);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКонцаДня(ВыбранныйВариант, ДопПараметры) Экспорт
	
	Если ВыбранныйВариант <> Неопределено Тогда
		
		СпособУказанияВремениОкончания = ВыбранныйВариант.Значение;
		ПредставлениеВариантаКонцаДня = ВыбранныйВариант.Представление;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВремяОкончанияДня", "Видимость", СпособУказанияВремениОкончания = 1);
		
		Если СпособУказанияВремениОкончания = 1 И Не ЗначениеЗаполнено(ВремяОкончания) Тогда
			ВремяОкончания = Дата(1,1,1,23,59,00);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьТекстПодсказки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеВариантаКонцаДняПослеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораКонцаДняПосле", ЭтотОбъект);
	ПоказатьВыборИзМеню(Оповещение, СписокВариантовОкончанияДня);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКонцаДняПосле(ВыбранныйВариант, ДопПараметры) Экспорт
	
	Если ВыбранныйВариант <> Неопределено Тогда
		
		СпособУказанияВремениОкончанияПосле = ВыбранныйВариант.Значение;
		ПредставлениеВариантаКонцаДняПосле = ВыбранныйВариант.Представление;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВремяОкончанияДняПосле", "Видимость", СпособУказанияВремениОкончанияПосле = 1);
		
		Если СпособУказанияВремениОкончанияПосле = 1 И Не ЗначениеЗаполнено(ВремяОкончанияПосле) Тогда
			ВремяОкончанияПосле = Дата(1,1,1,23,59,00);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьТекстПодсказки();
	
КонецПроцедуры

&НаКлиенте
Процедура СрокВыполненияЧасыПриИзменении(Элемент)
	
	УстановитьСвойстваЭлементовСрок(Элементы, СрокВыполненияЧасы, СпособУказанияВремениОкончания);
	
	ОбновитьТекстПодсказки();
	
КонецПроцедуры

&НаКлиенте
Процедура СрокВыполненияЧасыПослеПриИзменении(Элемент)
	
	УстановитьСвойстваЭлементовСрокПосле(Элементы, СрокВыполненияЧасыПосле, СпособУказанияВремениОкончанияПосле);
	
	ОбновитьТекстПодсказки();
	
КонецПроцедуры

&НаКлиенте
Процедура СрокВыполненияДниПриИзменении(Элемент)
	ОбновитьТекстПодсказки();
КонецПроцедуры

&НаКлиенте
Процедура СрокВыполненияДниПослеПриИзменении(Элемент)
	ОбновитьТекстПодсказки();
КонецПроцедуры

&НаКлиенте
Процедура ВремяОкончанияДняПриИзменении(Элемент)
	ВремяОкончания = НачалоМинуты(ВремяОкончания);
	ОбновитьТекстПодсказки();
КонецПроцедуры

&НаКлиенте
Процедура ВремяОкончанияДняПослеПриИзменении(Элемент)
	ВремяОкончанияПосле = НачалоМинуты(ВремяОкончанияПосле);
	ОбновитьТекстПодсказки();
КонецПроцедуры

&НаКлиенте
Процедура ВремяНачалаЭтапаПриИзменении(Элемент)
	ОбновитьТекстПодсказки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Готово(Команда)
	
	ДанныеВозврата = Новый Структура;
	ДанныеВозврата.Вставить("СрокЗависитОтВремениНачала", СрокЗависитОтВремениНачала);
	ДанныеВозврата.Вставить("ВремяНачала", ВремяНачала);
	ДанныеВозврата.Вставить("СрокВыполненияЧасы", СрокВыполненияЧасы);
	ДанныеВозврата.Вставить("СрокВыполненияДни", СрокВыполненияДни);
	ДанныеВозврата.Вставить("СпособУказанияВремениОкончания", СпособУказанияВремениОкончания);
	ДанныеВозврата.Вставить("ВремяОкончания", ВремяОкончания);
	ДанныеВозврата.Вставить("СрокВыполненияЧасыПосле", СрокВыполненияЧасыПосле);
	ДанныеВозврата.Вставить("СрокВыполненияДниПосле", СрокВыполненияДниПосле);
	ДанныеВозврата.Вставить("СпособУказанияВремениОкончанияПосле", СпособУказанияВремениОкончанияПосле);
	ДанныеВозврата.Вставить("ВремяОкончанияПосле", ВремяОкончанияПосле);
	
	Закрыть(ДанныеВозврата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьТекстПодсказки()
	
	СрокИнтервалаПредставление = ПроцессыОбработкиДокументовКлиент.ПредставлениеСрокаВыполненияИнтервала(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	РеквизитыСЗависимостьюОтСрокаСоздания = Новый Массив;
	РеквизитыСЗависимостьюОтСрокаСоздания.Добавить("ГруппаВремяНачала");
	РеквизитыСЗависимостьюОтСрокаСоздания.Добавить("ГруппаПосле");
	
	Для Каждого Реквизит Из РеквизитыСЗависимостьюОтСрокаСоздания Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость", СрокЗависитОтВремениНачала);
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Декорация2", "Заголовок",
		?(СрокЗависитОтВремениНачала, НСтр("ru=' тогда:'"), НСтр("ru='Срок:'")));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСроки", "Отображение",
		?(СрокЗависитОтВремениНачала, ОтображениеОбычнойГруппы.СильноеВыделение, ОтображениеОбычнойГруппы.Нет));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваЭлементовСрок(Элементы, СрокВыполненияЧасы, СпособУказанияВремениОкончания)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПредставлениеВариантаКонцаДня", "Видимость", СрокВыполненияЧасы = 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВремяОкончанияДня", "Видимость", СрокВыполненияЧасы = 0 И СпособУказанияВремениОкончания = 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СрокВыполненияЧасы", "Заголовок", ?(СрокВыполненияЧасы = 0, НСтр("ru='ч,'"), НСтр("ru='ч'")));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваЭлементовСрокПосле(Элементы, СрокВыполненияЧасы, СпособУказанияВремениОкончания)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПредставлениеВариантаКонцаДняПосле", "Видимость", СрокВыполненияЧасы = 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВремяОкончанияДняПосле", "Видимость", СрокВыполненияЧасы = 0 И СпособУказанияВремениОкончания = 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СрокВыполненияЧасыПосле", "Заголовок", ?(СрокВыполненияЧасы = 0, НСтр("ru='ч,'"), НСтр("ru='ч'")));
	
КонецПроцедуры

#КонецОбласти
