#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПроцессыОбработкиДокументовПереопределяемый.ПриСозданииНаСервереФормыСпискаРегламентныхИнтервалов(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Для Каждого Строка Из Строки Цикл
		Строка.Значение.Данные["СрокВыполнения"] = ПроцессыОбработкиДокументов.ПредставлениеСрокаВыполненияИнтервала(Строка.Значение.Данные);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВвестиВДействие(Команда)
	ВвестиВДействиеРегламентныеИнтервалы(Элементы.Список.ВыделенныеСтроки);
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВводВДействие(Команда)
	ОтменитьВводВДействиеРегламентныхИнтервалов(Элементы.Список.ВыделенныеСтроки);
	Элементы.Список.Обновить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВвестиВДействиеРегламентныеИнтервалы(Знач РегламентныеИнтервалы)
	
	ВвестиВДействиеРегламентныеИнтервалыСервер(РегламентныеИнтервалы);
	
	Если РегламентныеИнтервалы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Команда не может быть выполнена для указанного объекта.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВвестиВДействиеРегламентныеИнтервалыСервер(РегламентныеИнтервалы)
	
	ВведенныеВДействиеРИ = Новый Массив;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого РегламентныйИнтервал Из РегламентныеИнтервалы Цикл
			
			Если ТипЗнч(РегламентныйИнтервал) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
				Продолжить;
			КонецЕсли;
			
			СвойстваРИ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РегламентныйИнтервал, "Владелец, ИдентификаторНачальногоЭтапа, ПометкаУдаления");
			
			Если СвойстваРИ.ПометкаУдаления Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Интервал ""%1"" не может быть введен в действие: установлена пометка удаления'"),
					РегламентныйИнтервал);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
			
			ПроцессыОбработкиДокументов.ВвестиРегламентныйИнтервалВДействие(
				РегламентныйИнтервал, СвойстваРИ.Владелец, СвойстваРИ.ИдентификаторНачальногоЭтапа);
			
			ВведенныеВДействиеРИ.Добавить(РегламентныйИнтервал);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	РегламентныеИнтервалы = ВведенныеВДействиеРИ;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВводВДействиеРегламентныхИнтервалов(Знач РегламентныеИнтервалы)
	
	ОтменитьВводВДействиеРегламентныхИнтерваловСервер(РегламентныеИнтервалы);
	
	Если РегламентныеИнтервалы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Команда не может быть выполнена для указанного объекта.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВводВДействиеРегламентныхИнтерваловСервер(РегламентныеИнтервалы)
	
	ОтмененныеРИ = Новый Массив;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого РегламентныйИнтервал Из РегламентныеИнтервалы Цикл
			
			Если ТипЗнч(РегламентныйИнтервал) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
				Продолжить;
			КонецЕсли;
			
			СвойстваРИ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РегламентныйИнтервал, "Владелец, ИдентификаторНачальногоЭтапа");
			
			ПроцессыОбработкиДокументов.ОтменитьВводВДействиеРегламентногоИнтервала(
				РегламентныйИнтервал, СвойстваРИ.Владелец, СвойстваРИ.ИдентификаторНачальногоЭтапа);
			
			ОтмененныеРИ.Добавить(РегламентныйИнтервал);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	РегламентныеИнтервалы = ОтмененныеРИ;
	
КонецПроцедуры

#КонецОбласти
