#Область ПрограммныйИнтерфейс

// Возвращает список задач, наименование которых начинается на переданную строку.
//
// Параметры:
//  НачинаетсяНа - Строка - строка поиска.
//  Количество - Число - определяет количество строк в результате поиска.
// 
// Возвращаемое значение:
//  СписокЗначений - список найденных задач.
//
Функция ЗадачиПоНаименованию(Знач НачинаетсяНа, Количество = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РучныеЗадачиБухгалтера.Ссылка КАК Ссылка,
	|	РучныеЗадачиБухгалтера.Наименование КАК Наименование
	|ИЗ
	|	Справочник.РучныеЗадачиБухгалтера КАК РучныеЗадачиБухгалтера
	|ГДЕ
	|	ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	РучныеЗадачиБухгалтера.ДатаПоследнегоИспользования УБЫВ,
	|	РучныеЗадачиБухгалтера.Код УБЫВ";
	
	НачинаетсяНа = СокрЛП(НачинаетсяНа);
	Если ЗначениеЗаполнено(НачинаетсяНа) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА", "РучныеЗадачиБухгалтера.Наименование ПОДОБНО &СтрокаПоиска");
		Запрос.Параметры.Вставить("СтрокаПоиска", НачинаетсяНа + "%");
	КонецЕсли;
	Если ТипЗнч(Количество) = Тип("Число") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ", СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1", Количество));
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает задачу бухгалтера по наименованию.
//
// Параметры:
//  Наименование - Строка - наименование задачи.
// 
// Возвращаемое значение:
//  СправочникСсылка.РучныеЗадачиБухгалтера, Неопределено - ссылка задачу,
//                                                          Неопределено, если задача не найдена.
//
Функция Прочитать(Наименование) Экспорт
	
	НаименованиеЗадачи = СокрЛП(Наименование);
	
	Если Не ЗначениеЗаполнено(НаименованиеЗадачи) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("Наименование", НаименованиеЗадачи);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РучныеЗадачиБухгалтера.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РучныеЗадачиБухгалтера КАК РучныеЗадачиБухгалтера
	|ГДЕ
	|	РучныеЗадачиБухгалтера.Наименование = &Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Добавляет новую задачу бухгалтера.
//
// Параметры:
//  Наименование - Строка - наименование задачи.
// 
// Возвращаемое значение:
//  СправочникСсылка.РучныеЗадачиБухгалтера, Неопределено - ссылка на созданную задачу, либо Неопределено
//                                                          в случае возникновения ошибки.
//
Функция Добавить(Наименование) Экспорт
	
	НаименованиеЗадачи = СокрЛП(Наименование);
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(НаименованиеЗадачи) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.РучныеЗадачиБухгалтера");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		Результат = Прочитать(НаименованиеЗадачи);
		Если Результат = Неопределено Тогда
			НоваяЗадача = Справочники.РучныеЗадачиБухгалтера.СоздатьЭлемент();
			НоваяЗадача.Наименование = НаименованиеЗадачи;
			НоваяЗадача.ДатаПоследнегоИспользования = ВыполнениеЗадачБухгалтера.ТекущаяДатаНаСервере();
			НоваяЗадача.Записать();
			Результат = НоваяЗадача.Ссылка;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			ИмяДляЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Переименовывает задачу бухгалтера.
//
// Параметры:
//  Задача - СправочникСсылка.РучныеЗадачиБухгалтера - ссылка на изменяемую задачу.
//  Наименование - Строка - новое наименование задачи.
// 
Процедура Переименовать(Задача, Наименование) Экспорт
	
	НаименованиеЗадачи = СокрЛП(Наименование);
	
	Если Не ЗначениеЗаполнено(НаименованиеЗадачи) Или Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;
	
	ЗадачаОбъект = Задача.ПолучитьОбъект();
	Если ЗадачаОбъект.Наименование <> НаименованиеЗадачи Тогда
		ЗадачаОбъект.Наименование = НаименованиеЗадачи;
		ЗадачаОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает дату использования задачи на текущую дату.
// Дата последнего использования применяется для сортировки задач в списке.
//
// Параметры:
//  Задача - СправочникСсылка.РучныеЗадачиБухгалтера - ссылка на задачу.
// 
Процедура ОбновитьДатуИспользования(Задача) Экспорт
	
	ЗадачаОбъект = Задача.ПолучитьОбъект();
	ЗадачаОбъект.ДатаПоследнегоИспользования = ВыполнениеЗадачБухгалтера.ТекущаяДатаНаСервере();
	ЗадачаОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяДляЖурналаРегистрации()
	
	Возврат НСтр("ru = 'Ручные задачи бухгалтера'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

#КонецОбласти

#КонецЕсли