#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПользовательДляОтправкиУведомлений = Константы.ПользовательДляУведомлений.Получить();

	СпособНастройкиПользователя = ?(ЗначениеЗаполнено(ПользовательДляОтправкиУведомлений), 
		"ВыбратьИзСуществующих", "СозданиеНовогоПользователя");
	
	Если СпособНастройкиПользователя = "ВыбратьИзСуществующих" Тогда
		Пользователь = ПользовательДляОтправкиУведомлений;
		Элементы.ГруппаИмяКартинка.Доступность = Ложь;
		Элементы.СпособНастройкиПользователяВыборИзСуществующих.СписокВыбора[0].Представление = НСтр("ru = 'Выбран из существующих'");
	Иначе
		Заголовок = НСтр("ru = 'Настройка пользователя'");
		Элементы.Установить.Заголовок = НСтр("ru = 'Создать и установить'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗавершитьНастройкуПользователя" Тогда
		Закрыть(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АдресКартинкиПользователяНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОповещениеОЗавершение = Новый ОписаниеОповещения("АдресКартинкиНажатиеЗавершение", ЭтотОбъект);
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Фильтр = НСтр("ru = 'Изображения'") + "|*.JPG;*.JPEG;*.JP2;*.JPG2;*.PNG;*.BMP;*.TIFF";
	ФайловаяСистемаКлиент.ЗагрузитьФайл(ОповещениеОЗавершение, ПараметрыЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура СпособНастройкиПользователяПриИзменении(Элемент)
	
	СоздаватьНовогоПользователя = СпособНастройкиПользователя = "СозданиеНовогоПользователя";
	Элементы.Установить.Заголовок = ?(
		СоздаватьНовогоПользователя,
		НСтр("ru = 'Создать и установить'"),
		НСтр("ru = 'Установить'"));
	Элементы.ГруппаИмяКартинка.Доступность = СоздаватьНовогоПользователя;
	Элементы.Пользователь.Доступность = Не СоздаватьНовогоПользователя;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяПользователяОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ИмяПользователя = Текст;
	Пользователь = ПроверитьСуществованиеПользователя(Текст);
	
	Если ЗначениеЗаполнено(Пользователь) Тогда
		ДополнительныеПараметры = Новый Структура("Пользователь", Пользователь);
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ИмяПользователяОкончаниеВводаТекстаЗавершение", ЭтотОбъект, ДополнительныеПараметры),
				НСтр("ru = 'Пользователь с таким именем уже существует. Установить его?'"),
				РежимДиалогаВопрос.ДаНет,
				,
				,
				НСтр("ru = 'Создание пользователя'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Установить(Команда)
	
	Если НЕ ЗначениеЗаполнено(СпособНастройкиПользователя) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран способ настройки пользователя'"));
		Возврат;
	КонецЕсли;

	Если СпособНастройкиПользователя = "СозданиеНовогоПользователя" Тогда
		СоздатьИУстановитьПользователя();
	ИначеЕсли СпособНастройкиПользователя = "ВыбратьИзСуществующих" Тогда
		ВыбратьИУстановитьПользователя();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКартинку(Команда)
	
	Если Не ЗначениеЗаполнено(АдресКартинкиПользователя) Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьИзВременногоХранилища(АдресКартинкиПользователя);
	АдресКартинкиПользователя = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКартинку(Команда)
	
	АдресКартинкиПользователяНажатие(Элементы.Картинка, Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СоздатьИУстановитьПользователя()
	
	Состояние(НСтр("ru = 'Устанавливаем пользователя для рассылки уведомлений. Пожалуйста, подождите...'"));
	НовыйПользователь = СоздатьПользователя(ИмяПользователя);
	Если НовыйПользователь <> Неопределено Тогда
		УстановитьПользователя(НовыйПользователь);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Пользователь не создан.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИУстановитьПользователя()
	
	Если ЗначениеЗаполнено(Пользователь) Тогда
		УстановитьПользователя(Пользователь);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите пользователя'"), , "Пользователь");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПользователя(ПользовательСсылка)
	
	УстановитьЗначениеКонстанты(ПользовательСсылка);
	Оповестить("ИзмененыНастройкиУведомлений");
	
КонецПроцедуры

&НаКлиенте
Процедура АдресКартинкиНажатиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
#Если Не ВебКлиент Тогда
	Картинка = Новый Картинка(ПолучитьИзВременногоХранилища(Результат.Хранение));
	Если Картинка.Формат() = ФорматКартинки.НеизвестныйФормат Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите файл с изображением.'"));
		Возврат;
	КонецЕсли;
	
	Если Картинка.РазмерФайла() > 2 * 1024 * 1024 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите файл с изображением меньше 2 Мб.'"));
		Возврат;
	КонецЕсли;
#КонецЕсли
	
	Если ЭтоАдресВременногоХранилища(АдресКартинкиПользователя) Тогда
		УдалитьИзВременногоХранилища(АдресКартинкиПользователя);
	КонецЕсли;
	
	АдресКартинкиПользователя = Результат.Хранение;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеКонстанты(Пользователь)

	Если Константы.ПользовательДляУведомлений.Получить() = Пользователь Тогда
		Возврат;
	Иначе
		Константы.ПользовательДляУведомлений.Установить(Пользователь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяПользователяОкончаниеВводаТекстаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УстановитьПользователя(ДополнительныеПараметры.Пользователь);
	Иначе
		ИмяПользователя = "";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьСуществованиеПользователя(Имя)

	ПользовательСсылка = Справочники.Пользователи.НайтиПоНаименованию(Имя, Истина);
	
	Возврат ПользовательСсылка;
	
КонецФункции

&НаСервере
Функция СоздатьПользователя(ИмяПользователя)
	
	Если Не ЗначениеЗаполнено(ИмяПользователя) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Поле ""Имя пользователя"" не заполнено.'"),, "ИмяПользователя");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресКартинкиПользователя) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать картинку.'"),, "АдресКартинкиПользователя");
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйПользователь = Справочники.Пользователи.СоздатьЭлемент();
	НовыйПользователь.Наименование = ИмяПользователя;
	НовыйПользователь.Недействителен = Ложь;
	НовыйПользователь.Фотография = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресКартинкиПользователя));
	ОписаниеПользователяИБ = Пользователи.НовоеОписаниеПользователяИБ();
	ОписаниеПользователяИБ.Имя = ИмяПользователя;
	ОписаниеПользователяИБ.ПолноеИмя = ИмяПользователя;
	ОписаниеПользователяИБ.АутентификацияСтандартная = Ложь;
	ОписаниеПользователяИБ.ПоказыватьВСпискеВыбора = Ложь;
	ОписаниеПользователяИБ.Пароль = НовыйПароль();
	ОписаниеПользователяИБ.Вставить("Действие", "Записать");
	НовыйПользователь.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);
	
	Попытка
		НовыйПользователь.Записать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Ошибка при создании пользователя'"));
		Возврат Неопределено;
	КонецПопытки;
	
	ОбсужденияПодключены = ОбсужденияСлужебныйВызовСервера.Подключены();
	
	Если ОбсужденияПодключены Тогда
		Обсуждения.ПользовательСистемыВзаимодействия(НовыйПользователь.Ссылка);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат НовыйПользователь.Ссылка;
	
КонецФункции

&НаСервере
Функция НовыйПароль()
	
	МинимальнаяДлинаПароля = ПолучитьМинимальнуюДлинуПаролейПользователей();
	Если МинимальнаяДлинаПароля <= 8 Тогда
		МинимальнаяДлинаПароля = 8;
	КонецЕсли;
	ПараметрыПароля = Пользователи.СвойстваПароля();
	ПараметрыПароля.НаименьшаяДлина = МинимальнаяДлинаПароля;
	ПараметрыПароля.Сложный = Истина;
	
	Возврат Пользователи.СоздатьПароль(ПараметрыПароля);
	
КонецФункции 

#КонецОбласти
