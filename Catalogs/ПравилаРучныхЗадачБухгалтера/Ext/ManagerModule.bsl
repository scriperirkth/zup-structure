
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Конструктор нового правила задачи.
//
// Возвращаемое значение:
//  Структура
//
Функция НовыйПравилоЗадачи() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("НаименованиеОрганизации", "");
	Результат.Вставить("Ссылка", Справочники.ПравилаРучныхЗадачБухгалтера.ПустаяСсылка());
	Результат.Вставить("ИдентификаторПравила", "");
	Результат.Вставить("Задача", Справочники.РучныеЗадачиБухгалтера.ПустаяСсылка());
	Результат.Вставить("ИдентификаторЗадачи", "");
	Результат.Вставить("НаименованиеЗадачи", "");
	Результат.Вставить("Срок", Дата(1, 1, 1));
	Результат.Вставить("Периодичность", Перечисления.Периодичность.ПустаяСсылка());
	Результат.Вставить("ПеренестиНаРабочийДень", 0);
	Результат.Вставить("ДатаАктуальности", Дата(1, 1, 1));
	
	Возврат Результат;
	
КонецФункции

// Добавляет новое правило задачи.
//
// Параметры:
//  Параметры - Структура - параметры нового правила, см. НовыйПравилоЗадачи().
//  ДополнительныеСвойства - Соответствие, Неопределено - дополнительные свойства, которые можно передать при записи объекта.
// 
// Возвращаемое значение:
//  СправочникСсылка.ПравилаРучныхЗадачБухгалтера - ссылка на созданное правило.
//
Функция Добавить(Параметры, ДополнительныеСвойства = Неопределено) Экспорт
	
	Результат = Неопределено;
	НачатьТранзакцию();
	
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.ПравилаРучныхЗадачБухгалтера");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		Результат = Прочитать(Параметры.Организация, Параметры.Задача, Параметры.Срок);
		Если Результат = Неопределено Тогда
			НовоеПравило = Справочники.ПравилаРучныхЗадачБухгалтера.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НовоеПравило, Параметры);
			НовоеПравило.Владелец = Параметры.Задача;
			
			Если ТипЗнч(ДополнительныеСвойства) = Тип("Соответствие") Тогда
				Для Каждого ДопСвойство Из ДополнительныеСвойства Цикл
					НовоеПравило.ДополнительныеСвойства.Вставить(ДопСвойство.Ключ, ДопСвойство.Значение);
				КонецЦикла;
			КонецЕсли;
			
			НовоеПравило.Записать();
			Результат = НовоеПравило.Ссылка;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			ИмяДляЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Вносит изменения в правило задачи.
//
// Параметры:
//  Параметры - Структура - параметры правила, см. НовыйПравилоЗадачи()
//  ДополнительныеСвойства - Соответствие, Неопределено - дополнительные свойства, которые можно передать при записи объекта.
//
Процедура Изменить(Параметры, ДополнительныеСвойства = Неопределено) Экспорт
	
	НачатьТранзакцию();
	
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.ПравилаРучныхЗадачБухгалтера");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		СуществующееПравило = Параметры.Ссылка;
		Если Не ЗначениеЗаполнено(СуществующееПравило) Тогда
			СуществующееПравило = Прочитать(Параметры.Организация, Параметры.Задача, Параметры.Срок);
			Если СуществующееПравило = Неопределено Тогда
				ВызватьИсключение(НСтр("ru = 'Правило не найдено'"));
			КонецЕсли;
		КонецЕсли;
		
		ПравилоОбъект = СуществующееПравило.ПолучитьОбъект();
		ПравилоОбъект.Владелец = Параметры.Задача;
		ПравилоОбъект.Организация = Параметры.Организация;
		ПравилоОбъект.Срок = Параметры.Срок;
		ПравилоОбъект.Периодичность = Параметры.Периодичность;
		ПравилоОбъект.ПеренестиНаРабочийДень = Параметры.ПеренестиНаРабочийДень;
		ПравилоОбъект.ДатаАктуальности = Параметры.ДатаАктуальности;
		
		Если ТипЗнч(ДополнительныеСвойства) = Тип("Соответствие") Тогда
			Для Каждого ДопСвойство Из ДополнительныеСвойства Цикл
				ПравилоОбъект.ДополнительныеСвойства.Вставить(ДопСвойство.Ключ, ДопСвойство.Значение);
			КонецЦикла;
		КонецЕсли;
		
		ПравилоОбъект.Записать();
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Читает из базы параметры правила выполнения ручной задачи.
//
// Параметры:
//  Организация - СправочникСсылка.Организация - организация.
//  Задача - СправочникСсылка.РучныеЗадачиБухгалтера - ручная задача.
//  Срок - Дата - крайний срок выполнения задачи
// 
// Возвращаемое значение:
//  Структура - см. НовыйПравилоЗадачи().
//
Функция Прочитать(Организация, Задача, Срок) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("Организация", Организация);
	Запрос.Параметры.Вставить("Задача", Задача);
	Запрос.Параметры.Вставить("Срок", Срок);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Организация КАК Организация,
	|	Правила.Организация.Наименование КАК НаименованиеОрганизации,
	|	Правила.Владелец КАК Задача,
	|	Правила.Владелец.Код КАК ИдентификаторЗадачи,
	|	Правила.Владелец.Наименование КАК НаименованиеЗадачи,
	|	Правила.Срок КАК Срок,
	|	Правила.Периодичность КАК Периодичность,
	|	Правила.ПеренестиНаРабочийДень КАК ПеренестиНаРабочийДень,
	|	Правила.Код КАК ИдентификаторПравила,
	|	Правила.Ссылка КАК Ссылка,
	|	Правила.ДатаАктуальности КАК ДатаАктуальности
	|ИЗ
	|	Справочник.ПравилаРучныхЗадачБухгалтера КАК Правила
	|ГДЕ
	|	Правила.Организация = &Организация
	|	И Правила.Владелец = &Задача
	|	И Правила.Срок = &Срок";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Правило = НовыйПравилоЗадачи();
		ЗаполнитьЗначенияСвойств(Правило, Выборка);
		Возврат Правило;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Читает из базы параметры правила выполнения ручной задачи по ссылке.
//
// Параметры:
//  ПравилоСсылка - СправочникСсылка.ПравилаРучныхЗадачБухгалтера - ссылка на правило.
// 
// Возвращаемое значение:
//  Структура - см. НовыйПравилоЗадачи().
//
Функция ПрочитатьПоСсылке(ПравилоСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("Ссылка", ПравилоСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Организация КАК Организация,
	|	Правила.Организация.Наименование КАК НаименованиеОрганизации,
	|	Правила.Владелец КАК Задача,
	|	Правила.Владелец.Код КАК ИдентификаторЗадачи,
	|	Правила.Владелец.Наименование КАК НаименованиеЗадачи,
	|	Правила.Срок КАК Срок,
	|	Правила.Периодичность КАК Периодичность,
	|	Правила.ПеренестиНаРабочийДень КАК ПеренестиНаРабочийДень,
	|	Правила.Код КАК ИдентификаторПравила,
	|	Правила.Ссылка КАК Ссылка,
	|	Правила.ДатаАктуальности КАК ДатаАктуальности
	|ИЗ
	|	Справочник.ПравилаРучныхЗадачБухгалтера КАК Правила
	|ГДЕ
	|	Правила.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Правило = НовыйПравилоЗадачи();
		ЗаполнитьЗначенияСвойств(Правило, Выборка);
		Возврат Правило;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Получает правила организации, задачи по которым должны выполняться в переданный интервал времени.
//
// Параметры:
//  Организация - СправочникСсылка.Организация - организация.
//  НачалоПериода - Дата - начало периода.
//  КонецПериода - Дата - окончание периода.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. НовыйТаблицаПравил().
//
Функция ПравилаОрганизации(Организация, НачалоПериода, КонецПериода) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравилаРучныхЗадачБухгалтера.Ссылка КАК Правило,
	|	ПравилаРучныхЗадачБухгалтера.Организация КАК Организация,
	|	ПравилаРучныхЗадачБухгалтера.Срок КАК Срок,
	|	ПравилаРучныхЗадачБухгалтера.Периодичность КАК Периодичность,
	|	ПравилаРучныхЗадачБухгалтера.Владелец.Наименование КАК Наименование,
	|	ПравилаРучныхЗадачБухгалтера.ПеренестиНаРабочийДень КАК ПеренестиНаРабочийДень
	|ИЗ
	|	Справочник.ПравилаРучныхЗадачБухгалтера КАК ПравилаРучныхЗадачБухгалтера
	|ГДЕ
	|	ПравилаРучныхЗадачБухгалтера.Срок МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПравилаРучныхЗадачБухгалтера.Организация = &Организация
	|	И ПравилаРучныхЗадачБухгалтера.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПравилаРучныхЗадачБухгалтера.Ссылка,
	|	ПравилаРучныхЗадачБухгалтера.Организация,
	|	ПравилаРучныхЗадачБухгалтера.Срок,
	|	ПравилаРучныхЗадачБухгалтера.Периодичность,
	|	ПравилаРучныхЗадачБухгалтера.Владелец.Наименование,
	|	ПравилаРучныхЗадачБухгалтера.ПеренестиНаРабочийДень
	|ИЗ
	|	Справочник.ПравилаРучныхЗадачБухгалтера КАК ПравилаРучныхЗадачБухгалтера
	|ГДЕ
	|	ПравилаРучныхЗадачБухгалтера.Срок <= &КонецПериода
	|	И ПравилаРучныхЗадачБухгалтера.Организация = &Организация
	|	И ПравилаРучныхЗадачБухгалтера.Периодичность <> ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выгрузить();
	ТаблицаПравил = НовыйТаблицаПравил();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Выборка, ТаблицаПравил);
	
	Возврат ТаблицаПравил;
	
КонецФункции

// Возвращает даты, в которые должна выполняться периодическая задача в указанном интервале времени.
//
// Параметры:
//  НачалоПериода - Дата - начало периода.
//  КонецПериода - Дата - окончание периода.
//  Периодичность - Перечисление.Периодичность - периодичность выполнения задачи.
// 
// Возвращаемое значение:
//  Массив - массив дат выполнения задачи.
//
Функция ПериодыЗадачи(НачалоПериода, КонецПериода, Периодичность) Экспорт
	
	Периоды = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Периодичность) Тогда
		Периоды.Добавить(НачалоПериода);
		Возврат Периоды;
	КонецЕсли;
	
	ТекущийПериод = НачалоПериода;
	Пока ТекущийПериод < КонецПериода Цикл
		Периоды.Добавить(ТекущийПериод);
		ТекущийПериод = ИнтерфейсыВзаимодействияБРОКлиентСервер.ДобавитьПериод(ТекущийПериод, Периодичность);
	КонецЦикла;
	
	Возврат Периоды;
	
КонецФункции

// Отключает периодичность выполнения задачи. Задача больше не будет повторяться.
//
// Параметры:
//  ПравилоСсылка - СправочникСсылка.ПравилаРучныхЗадачБухгалтера - ссылка на правило.
//
Процедура ОтключитьПериодичность(ПравилоСсылка) Экспорт
	
	ПравилоОбъект = ПравилоСсылка.ПолучитьОбъект();
	ПравилоОбъект.Периодичность = Перечисления.Периодичность.ПустаяСсылка();
	ПравилоОбъект.ПеренестиНаРабочийДень = 0;
	ПравилоОбъект.Записать();
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

