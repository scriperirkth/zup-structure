#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. ВариантыОтчетовПереопределяемый.ОпределитьОбъектыСКомандамиОтчетов
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПроцессыНаграждения") Тогда
		МодульПроцессыНаграждения = ОбщегоНазначения.ОбщийМодуль("ПроцессыНаграждения");
		МодульПроцессыНаграждения.ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры);
	КонецЕсли;
	
КонецПроцедуры

// Создает и возвращает новый элемент награды физического лица.
// 
// Параметры:
//  НаименованиеНаграды - Строка - 
//  ТипНаграды - Строка - 
//  КатегорияНаграды - СправочникСсылка.КатегорииНаград - 
Функция НоваяНаграда(НаименованиеНаграды, ТипНаграды = Неопределено, КатегорияНаграды = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Награды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Награды КАК Награды
	|ГДЕ
	|	Награды.Наименование = &Наименование
	|	И (Награды.КатегорияНаграды = &КатегорияНаграды
	|			ИЛИ &КатегорияНаграды = НЕОПРЕДЕЛЕНО)
	|	И (Награды.ТипНаграды = &ТипНаграды
	|			ИЛИ &ТипНаграды = НЕОПРЕДЕЛЕНО)"	
	;
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеНаграды);
	Запрос.УстановитьПараметр("КатегорияНаграды", КатегорияНаграды);
	Запрос.УстановитьПараметр("ТипНаграды", ТипНаграды);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		УстановитьПривилегированныйРежим(Истина);
		Награда = Справочники.Награды.СоздатьЭлемент();
		Награда.Наименование = НаименованиеНаграды;
		Награда.КатегорияНаграды = КатегорияНаграды;
		Награда.ТипНаграды = ТипНаграды;
		Награда.ОбменДанными.Загрузка = Истина;
		Награда.Записать();
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат Награда.Ссылка;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

