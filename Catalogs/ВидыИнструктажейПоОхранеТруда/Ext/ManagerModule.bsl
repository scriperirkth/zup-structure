#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК Т
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыИнструктажейПоОхранеТруда.РабочиеМеста КАК Т1
	|	ПО Т1.Ссылка = Т.Ссылка
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодчиненностьПодразделенийОрганизаций КАК Т2 
	|	ПО Т2.Подразделение = Т1.Подразделение
	|;
	|РазрешитьЧтение
	|ГДЕ
	|	ИСТИНА
	|;
	|РазрешитьИзменениеЕслиРазрешеноЧтение
	|ГДЕ
	|	(Т1.Организация ЕСТЬ NULL
	|		ИЛИ ДляВсехСтрок(ЗначениеРазрешено(Т1.Организация)))
	|	И (Т1.Подразделение ЕСТЬ NULL
	|		ИЛИ ДляВсехСтрок(
	|			ЗначениеРазрешено(Т2.Подразделение)
	|			ИЛИ ДляОднойИзСтрок(ЗначениеРазрешено(Т2.ВышестоящееПодразделение))))";
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("НачальноеЗаполнение");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура выполняет первоначальное видов происшествий.
Процедура НачальноеЗаполнение() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЗначениеИстина
	|ИЗ
	|	Справочник.ВидыИнструктажейПоОхранеТруда КАК ВидыИнструктажейПоОхранеТруда
	|ГДЕ
	|	ВидыИнструктажейПоОхранеТруда.Ссылка <> ЗНАЧЕНИЕ(Справочник.ВидыИнструктажейПоОхранеТруда.Вводный)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	
	// Вводный
	ВидИнструктажаОбъект = Справочники.ВидыИнструктажейПоОхранеТруда.Вводный.ПолучитьОбъект();
	ВидИнструктажаОбъект.КонтролироватьПроведение = Истина;
	ВидИнструктажаОбъект.ПроводитсяПовторно = Ложь;
	ВидИнструктажаОбъект.ИспользоватьДляВсехРабочихМест = Истина;
	ВидИнструктажаОбъект.Записать();
	
	// На рабочем месте (первичный и повторный)
	ВидИнструктажаОбъект = Справочники.ВидыИнструктажейПоОхранеТруда.СоздатьЭлемент();
	ВидИнструктажаОбъект.Наименование = НСтр("ru = 'На рабочем месте (первичный и повторный)'");
	ВидИнструктажаОбъект.КонтролироватьПроведение = Истина;
	ВидИнструктажаОбъект.ПроводитсяПовторно = Истина;
	ВидИнструктажаОбъект.ИспользоватьДляВсехРабочихМест = Истина;
	ВидИнструктажаОбъект.КоличествоРаз = 1;
	ВидИнструктажаОбъект.КоличествоПериодов = 1;
	ВидИнструктажаОбъект.Периодичность = Перечисления.Периодичность.Месяц;
	ВидИнструктажаОбъект.Записать();
	
	// Внеплановый
	ВидИнструктажаОбъект = Справочники.ВидыИнструктажейПоОхранеТруда.СоздатьЭлемент();
	ВидИнструктажаОбъект.Наименование = НСтр("ru = 'Внеплановый'");
	ВидИнструктажаОбъект.ИспользоватьДляВсехРабочихМест = Истина;
	ВидИнструктажаОбъект.Записать();
	
	// Целевой
	ВидИнструктажаОбъект = Справочники.ВидыИнструктажейПоОхранеТруда.СоздатьЭлемент();
	ВидИнструктажаОбъект.Наименование = НСтр("ru = 'Целевой'");
	ВидИнструктажаОбъект.ИспользоватьДляВсехРабочихМест = Истина;
	ВидИнструктажаОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли