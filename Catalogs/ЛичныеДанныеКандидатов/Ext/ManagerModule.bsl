#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// Параметры:
//   Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК Т
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеЭтапыРаботыСКандидатами КАК Т1
	|	ПО Т1.Кандидат.ЛичныеДанные = Т.Ссылка
	|;
	|
	|РазрешитьЧтениеИзменение
	|ГДЕ
	|	(ГруппаДоступа = ЗНАЧЕНИЕ(Справочник.ГруппыДоступаКандидатов.ПустаяСсылка)
	|	И ДляВсехСтрок(Т1.ЭтапРаботы = ЗНАЧЕНИЕ(Перечисление.ЭтапыРаботыСКандидатами.РассмотрениеОтклика) ИЛИ Т1.ЭтапРаботы ЕСТЬ NULL))
	|	ИЛИ ЗначениеРазрешено(Ссылка)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Заполнить данные для электронного тестирования кандидата.
// 
// Параметры:
//  ДанныеДляЗаполнения - Структура: см. ЭлектронноеТестированиеКандидатов.НовыйДанныеДляФормыЭлектронногоТестированияКандидата
//  Учащийся - СправочникСсылка.ЛичныеДанныеКандидатов
Процедура ЗаполнитьДанныеДляЭлектронногоТестированияКандидата(ДанныеДляЗаполнения, Учащийся) Экспорт
	
	ТаблицаКандидатов = Справочники.Кандидаты.КандидатыПоЛичнымДаннымКандидатов(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Учащийся));

	Если ТаблицаКандидатов.Количество() > 0 Тогда
		ДанныеДляЗаполнения.ИмяОтчество = СтрШаблон("%1 %2", ТаблицаКандидатов[0].Имя, ТаблицаКандидатов[0].Отчество);
		ДанныеДляЗаполнения.Кандидат = ТаблицаКандидатов[0].Кандидат;
	КонецЕсли;
	
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ИсторияВзаимоотношений", Истина);
	Методы.Вставить("ЗаполнитьФИОСлужебныеСБуквамиЕЁ");
	Методы.Вставить("ЗаполнитьМессенджерыКандидатов");
КонецПроцедуры

#КонецОбласти

#Область КонструкторыСтруктурХранения

// Возвращает структуру для описания личных данных кандидата
//
// Возвращаемое значение:
//  Структура - Новые данные кандидата:
//   * ФИО - Строка -
//   * Фамилия - Строка -
//   * Имя - Строка -
//   * Отчество - Строка -
//   * УточнениеНаименования - Строка -
//   * ДатаРождения - Дата -
//   * МестоРождения - Строка -
//   * Пол - ПеречислениеСсылка.ПолФизическогоЛица -
//   * СостояниеВБраке - СправочникСсылка.СостояниеВБраке -
//   * Гражданство - СправочникСсылка.СтраныМира -
//   * Фотография - СправочникСсылка.ЛичныеДанныеКандидатовПрисоединенныеФайлы -
//   * ГруппаДоступа - СправочникСсылка.ГруппыДоступаКандидатов -
//   * ЗнаниеЯзыков - Массив из Структура -
//   * Образование - Массив из Структура -
//   * Курсы - Массив из Структура -
//   * УченыеСтепени - Массив из Структура -
//   * ОпытРаботы - Массив из Структура -
Функция НовыеДанныеКандидата() Экспорт
	
	ДанныеКандидата = Новый Структура;
	
	ДанныеКандидата.Вставить("ФИО", "");
	ДанныеКандидата.Вставить("Фамилия", "");
	ДанныеКандидата.Вставить("Имя", "");
	ДанныеКандидата.Вставить("Отчество", "");
	ДанныеКандидата.Вставить("УточнениеНаименования", "");
	ДанныеКандидата.Вставить("ДатаРождения", Дата(1, 1, 1));
	ДанныеКандидата.Вставить("МестоРождения", "");
	ДанныеКандидата.Вставить("Пол", Перечисления.ПолФизическогоЛица.Мужской);
	ДанныеКандидата.Вставить("СостояниеВБраке", Справочники.СостояниеВБраке.ПустаяСсылка());
	ДанныеКандидата.Вставить("Гражданство", Справочники.СтраныМира.Россия);
	ДанныеКандидата.Вставить("Фотография", Справочники.ЛичныеДанныеКандидатовПрисоединенныеФайлы.ПустаяСсылка());
	ДанныеКандидата.Вставить("ГруппаДоступа", Справочники.ГруппыДоступаКандидатов.ПустаяСсылка());
	
	ДанныеКандидата.Вставить("ЗнаниеЯзыков", Новый Массив);
	ДанныеКандидата.Вставить("Образование", Новый Массив);
	ДанныеКандидата.Вставить("Курсы", Новый Массив);
	ДанныеКандидата.Вставить("УченыеСтепени", Новый Массив);
	ДанныеКандидата.Вставить("ОпытРаботы", Новый Массив);
	
	Возврат ДанныеКандидата;
	
КонецФункции

// Возвращает структуру для описания данных об образовании физического лица.
// 
// Возвращаемое значение:
//  Структура:
//   * УчебноеЗаведение - СправочникСсылка.УчебныеЗаведения
//   * Факультет - Строка -
//   * Квалификация - Строка -
//   * Специальность - СправочникСсылка.КлассификаторСпециальностейПоОбразованию
//   * НаименованиеКурса - Строка -
//   * Окончание - Число
//   * ВидОбразования - СправочникСсылка.ВидыОбразованияФизическихЛиц
//   * ВидПослевузовскогоОбразования - СправочникСсылка.ВидыОбразованияФизическихЛиц
//   * ВидДополнительногоОбучения - ПеречислениеСсылка.ВидыПрофессиональнойПодготовки
Функция НовоеОбразованиеДляФизическогоЛица() Экспорт
	
	Образование = Новый Структура;
	
	Образование.Вставить("УчебноеЗаведение", Справочники.УчебныеЗаведения.ПустаяСсылка());
	Образование.Вставить("Факультет", "");
	Образование.Вставить("Квалификация", "");
	Образование.Вставить("Специальность", Справочники.КлассификаторСпециальностейПоОбразованию.ПустаяСсылка());
	Образование.Вставить("НаименованиеКурса", "");
	Образование.Вставить("Окончание", Год(ТекущаяДатаСеанса()));
	Образование.Вставить("ВидОбразования", Справочники.ВидыОбразованияФизическихЛиц.ПустаяСсылка());
	Образование.Вставить("ВидПослевузовскогоОбразования", Справочники.ВидыОбразованияФизическихЛиц.ПустаяСсылка());
	Образование.Вставить("ВидДополнительногоОбучения", Перечисления.ВидыПрофессиональнойПодготовки.ПустаяСсылка());
	Образование.Вставить("СкрыватьТ2", Ложь);
	Образование.Вставить("СрокДействия", Дата(1,1,1));
	Образование.Вставить("ЭлектронныйСертификат", "");
	
	Возврат Образование;
	
КонецФункции

