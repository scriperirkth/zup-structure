#Область ОбъединениеДублей

// Возвращает дерево значений с информацией о найденных дублях.
// 
// Возвращаемое значение:
//  ДеревоЗначений
Функция ДеревоДублей() Экспорт
	
	ДеревоДублей = Новый ДеревоЗначений();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПодборПерсонала.СоздатьВТЗадублированныеКандидаты(Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗадублированныеКандидаты.ОбластьПоиска КАК ОбластьПоиска,
		|	ЗадублированныеКандидаты.Значение КАК Значение,
		|	ЗадублированныеКандидаты.ЛичныеДанныеКандидата КАК Дубль,
		|	ЗадублированныеКандидаты.Представление КАК Представление,
		|	ЗадублированныеКандидаты.ФИО КАК ФИО,
		|	ЗадублированныеКандидаты.Телефон КАК Телефон,
		|	ЗадублированныеКандидаты.EMail КАК EMail,
		|	ЗадублированныеКандидаты.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	ВТЗадублированныеКандидаты КАК ЗадублированныеКандидаты
		|ИТОГИ
		|	МАКСИМУМ(ФИО),
		|	МАКСИМУМ(Телефон),
		|	МАКСИМУМ(EMail),
		|	МАКСИМУМ(ФизическоеЛицо)
		|ПО
		|	ОбластьПоиска,
		|	Значение";
		
	ДеревоДублей = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);

	Возврат ДеревоДублей;
		
КонецФункции

// См. Обработки.ОбъединениеДублейПерсональныхДанных.ДополнитьКолонкиТаблицыПоискаДублей
Процедура ДополнитьКолонкиТаблицыПоискаДублей(ОписанияКолонок) Экспорт
	
	ОписанияКолонок.Добавить(Обработки.ОбъединениеДублейПерсональныхДанных.ОписаниеКолонки("Телефон",
		Новый ОписаниеТипов("Строка"), НСтр("ru = 'Телефон'")));
		
	ОписанияКолонок.Добавить(Обработки.ОбъединениеДублейПерсональныхДанных.ОписаниеКолонки("EMail",
		Новый ОписаниеТипов("Строка"), НСтр("ru = 'E-mail'")));
		
	ОписанияКолонок.Добавить(Обработки.ОбъединениеДублейПерсональныхДанных.ОписаниеКолонки("ФизическоеЛицо",
		Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"), НСтр("ru = 'Физическое лицо'")));
		
КонецПроцедуры

// См. Обработки.ОбъединениеДублейПерсональныхДанных.ДанныеДублей
Функция ДанныеДублей(Дубли) Экспорт
	
	ОбщегоНазначенияБЗККлиентСервер.УдалитьВсеВхожденияКромеТипаИзМассива(Дубли,
		Тип("СправочникСсылка.ЛичныеДанныеКандидатов"));
	
	ДанныеДублей = ПодборПерсонала.ОсновныеСведенияОЛичныхДанныхКандидатов(Дубли);
	ДанныеДублей.Колонки.Добавить("Дубль", Метаданные.ОпределяемыеТипы.СубъектПерсональныхДанных.Тип);
	
	Для Каждого СтрокаТаблицы Из ДанныеДублей Цикл
		СтрокаТаблицы.Дубль = СтрокаТаблицы.ЛичныеДанныеКандидата;
		СтрокаТаблицы.Телефон = ПоискФизическихЛиц.ТелефонВФорматеПоиска(СтрокаТаблицы.Телефон);
	КонецЦикла;
		
	Возврат ДанныеДублей;
	
КонецФункции

// Возвращает параметры получения данных дублей личных данных кандидатов.
// 
// Параметры:
//  Дубли - Массив из СправочникСсылка.ЛичныеДанныеКандидатов
// 
// Возвращаемое значение:
//  см. Обработки.ОбъединениеДублейПерсональныхДанных.НовыеПараметрыПолученияДанныхНайденныхДублей
Функция ПараметрыПолученияДанныхДублей(Дубли) Экспорт
	
	Параметры = Обработки.ОбъединениеДублейПерсональныхДанных.НовыеПараметрыПолученияДанныхНайденныхДублей();
	Параметры.МетаданныеОбъекта = Метаданные.Справочники.ЛичныеДанныеКандидатов;
	Параметры.ИмяКолонкиОбъекта = "ЛичныеДанныеКандидата";
	Параметры.ОписанияТабличныхЧастей = ОписанияСравниваемыхТабличныхЧастей();
	Параметры.Дубли = Дубли;
	Параметры.ОсновныеДанные = ОсновныеДанныеДублей(Дубли);
	
	Возврат Параметры;
	
КонецФункции

// Выполняет дополнительные действия при объединении дублей физических лиц.
// 
// Параметры:
//  ОставляемыйДубль - СправочникСсылка.ФизическиеЛица
//  ДанныеДляОбъединения - ДеревоЗначений - данные, которыми будет заполнен оставляемый дубль:
//   * Поле - Строка
//   * Значение - Произвольный
//  ДополнительныеПараметры - Структура, Неопределено - 
Процедура ПриОбъединенииДублей(ОставляемыйДубль, ДанныеДляОбъединения, ДополнительныеПараметры) Экспорт
	
	Обработки.ОбъединениеДублейПерсональныхДанных.ОбработатьРегистрыСведений(ОставляемыйДубль,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ЛичныеДанныеКандидата"), ДанныеДляОбъединения);
		
КонецПроцедуры

// Дополняет массив имен метаданных, исключаемых при замене ссылок на дубли.
// 
// Параметры:
//  ИсключаемыеМетаданные - Массив из Строка
Процедура ДополнитьМетаданныеИсключаемыеПриЗаменеСсылокНаДубли(ИсключаемыеМетаданные) Экспорт
	
	ИсключаемыеМетаданные.Добавить(Метаданные.РегистрыСведений.ФизическиеЛицаКандидатов.ПолноеИмя());
	ИсключаемыеМетаданные.Добавить(Метаданные.РегистрыСведений.ДанныеПоискаФизическихЛиц.ПолноеИмя());
	
КонецПроцедуры

// Выполняет дополнительные действия перед записью оставляемого дубля.
// 
// Параметры:
//  ДубльОбъект - СправочникОбъект.ЛичныеДанныеКандидатов
Процедура ПередЗаписьюОставляемогоДубля(ДубльОбъект) Экспорт
	
	// Если изменилось ФИО, то при заполнении будут актуализированы части имени и наименование.
	ДубльОбъект.Заполнить(Новый Структура("ФИО", ДубльОбъект.ФИО));
	
	// При объединении могла измениться фотография и теперь реквизит Фотография ссылается на присоединенный файл
	// с другим владельцем.
	Если ЗначениеЗаполнено(ДубльОбъект.Фотография) Тогда
		СтараяФотография = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДубльОбъект.Ссылка, "Фотография");
		Если ЗначениеЗаполнено(СтараяФотография) Тогда
			Если ДубльОбъект.Фотография <> СтараяФотография Тогда
				// Возьмем двоичные данные "чужой" фотографии и обновим присоединенный файл с фотографией.
				ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(ДубльОбъект.Фотография, Ложь);
				АдресНовойФотографии = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
				РаботаСФайлами.ОбновитьФайл(СтараяФотография,
					Новый Структура("АдресФайлаВоВременномХранилище, АдресВременногоХранилищаТекста",
						АдресНовойФотографии, ""));
				ДубльОбъект.Фотография = СтараяФотография;
			КонецЕсли;
		Иначе
			// Создадим новый файл с фотографией.
			ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(ДубльОбъект.Фотография, Ложь);
			АдресНовойФотографии = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
			ДубльОбъект.Фотография = СохраненнаяФотография(ДубльОбъект.Ссылка, АдресНовойФотографии);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Выполняет дополнительные действия после объединения дублей.
// 
// Параметры:
//  ОставляемыйДубль - СправочникСсылка.ЛичныеДанныеКандидатов
//  УдаляемыеДубли - Массив из СправочникСсылка.ЛичныеДанныеКандидатов
//  ДополнительныеПараметры - Структура, Неопределено - 
Процедура ПослеОбъединенияДублей(ОставляемыйДубль, УдаляемыеДубли, ДополнительныеПараметры) Экспорт
	
	ОставляемыйДубль.ПолучитьОбъект().ОбновитьНаименованияКандидатов();
	
	СоответствиеФизическихЛицУдаляемыхДублей = ФизическиеЛицаЛичныхДанныхКандидатов(УдаляемыеДубли);
	
	// Установим связь оставляемого дубля с физическим лицом.
	ФизическоеЛицоОставляемогоДубля = ФизическоеЛицоЛичныхДанныхКандидата(ОставляемыйДубль);
	Если Не ЗначениеЗаполнено(ФизическоеЛицоОставляемогоДубля) Тогда
		ФизическиеЛицаУдаляемыхДублей = ОбщегоНазначения.ВыгрузитьКолонку(СоответствиеФизическихЛицУдаляемыхДублей,
			"Значение", Истина);
		Если ЗначениеЗаполнено(ФизическиеЛицаУдаляемыхДублей) Тогда
			РегистрыСведений.ФизическиеЛицаКандидатов.УстановитьСвязьКандидатаСФизическимЛицом(ОставляемыйДубль,
				ФизическиеЛицаУдаляемыхДублей[0]);
		КонецЕсли;
	КонецЕсли;
	
	// Удалим связи удаляемых дублей с физическими лицами.
	Для Каждого КлючЗначение Из СоответствиеФизическихЛицУдаляемыхДублей Цикл
		РегистрыСведений.ФизическиеЛицаКандидатов.УдалитьСвязьКандидатаСФизическимЛицом(КлючЗначение.Ключ);
	КонецЦикла;

	// Пометим на удаление файлы фотографий, пришедшие от дублей.
	Справочники.ЛичныеДанныеКандидатовПрисоединенныеФайлы.ИзменитьВладельцевФайловФотографий(ОставляемыйДубль);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.КонтрольВеденияУчета") Тогда
		МодульКонтрольВеденияУчета = ОбщегоНазначения.ОбщийМодуль("КонтрольВеденияУчета");
		Проверка = КонтрольВеденияУчета.ПроверкаПоИдентификатору(
			ПодборПерсоналаПроверки.ИдентификаторГруппыПроверокКонтрольПодбораПерсонала()
				+ ".ПроверкаНаличияДублейЛичныхДанныхКандидатов");
		МодульКонтрольВеденияУчета.ВыполнитьПроверку(Проверка);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает значение, показываемое после объединения дублей.
// 
// Параметры:
//  ОставляемыйДубль - СправочникСсылка.ЛичныеДанныеКандидатов
//
// Возвращаемое значение:
//  СправочникСсылка.Кандидаты, СправочникСсылка.ЛичныеДанныеКандидатов - 
Функция ЗначениеПоказываемоеПослеОбъединенияДублей(ОставляемыйДубль) Экспорт
	
	ТаблицаКандидатов = ПодборПерсонала.КандидатыПоЛичнымДаннымКандидатов(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОставляемыйДубль));
		
	Если ТаблицаКандидатов.Количество() = 0 Тогда
		ПоказываемоеЗначение = ОставляемыйДубль;
	Иначе
		ПоказываемоеЗначение = ТаблицаКандидатов[0].Кандидат;
	КонецЕсли;
	
	Возврат ПоказываемоеЗначение;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы <> "ФормаОбъекта" Тогда
		Возврат;
	КонецЕсли;
	
	Кандидат = ПодборПерсонала.СсылкаНаКандидатаПоЛичнымДанным(Параметры.Ключ);
	Если ЗначениеЗаполнено(Кандидат) Тогда
		Параметры.Ключ = Кандидат;
		ВыбраннаяФорма = Метаданные.Справочники.Кандидаты.Формы.ФормаЭлемента;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

