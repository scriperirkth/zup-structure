//@skip-check invocation-parameter-type-intersect
Процедура ЗапомнитьРеквизитыПрежнегоСостоянияОбъекта()
	
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = ОбщегоНазначения.ВыгрузитьКолонку(
		Метаданные.Справочники.ЛичныеДанныеКандидатов.Реквизиты, "Имя"); // Массив из Строка
	ИменаРеквизитов.Добавить("Наименование");
	
	ПрежниеЗначения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, СтрСоединить(ИменаРеквизитов, ",")); 
	ПрежниеЗначения.Вставить("ТаблицаКИ", Новый ФиксированныйМассив(Новый Массив));
	ПрежниеЗначения.Вставить("МобильныйТелефон", "");
	ПрежниеЗначения.Вставить("ЭлектроннаяПочта", "");
	
	ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка,,,Ложь);
	
	Если ЗначениеЗаполнено(ТаблицаКИ) Тогда
		ПрежниеЗначения.ТаблицаКИ = ОбщегоНазначения.ФиксированныеДанные(ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаКИ));
		
		НайденнаяСтрокаТелефон = ТаблицаКИ.Найти(ОбщегоНазначения.ПредопределенныйЭлемент(
			"Справочник.ВидыКонтактнойИнформации.ТелефонЛичныеДанныеКандидатов"), "Вид");
		Если НайденнаяСтрокаТелефон <> Неопределено Тогда
			ПрежниеЗначения.МобильныйТелефон = НайденнаяСтрокаТелефон.Представление;
		КонецЕсли;
		
		НайденнаяСтрокаЭлектроннаяПочта = ТаблицаКИ.Найти(ОбщегоНазначения.ПредопределенныйЭлемент(
			"Справочник.ВидыКонтактнойИнформации.EMailЛичныеДанныеКандидатов"), "Вид");
		Если НайденнаяСтрокаЭлектроннаяПочта <> Неопределено Тогда
			ПрежниеЗначения.ЭлектроннаяПочта = НайденнаяСтрокаЭлектроннаяПочта.Представление;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ПрежниеЗначения", ПрежниеЗначения);
	
КонецПроцедуры

Процедура ОбновитьНаименованияКандидатов() Экспорт
	
	Если ДополнительныеСвойства.Свойство("ПрежниеЗначения") Тогда
		//@skip-check property-return-type
		ПрежнееНаименование = ДополнительныеСвойства.ПрежниеЗначения.Наименование; // Строка
	Иначе
		ПрежнееНаименование = "";
	КонецЕсли;
	
	Если Наименование = ПрежнееНаименование Тогда
		Возврат;
	КонецЕсли;
	
	Кандидаты = ПодборПерсонала.КандидатыПоЛичнымДаннымКандидатов(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка), Ложь).ВыгрузитьКолонку("Кандидат"); // Массив из СправочникСсылка.Кандидаты
	ИсключаемыйКандидат = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "ЗаписываемыйКандидат");
	
	Для Каждого Кандидат Из Кандидаты Цикл
		
		Если Кандидат = ИсключаемыйКандидат Тогда
			Продолжить;
		КонецЕсли;
		
		КандидатОбъект = Кандидат.ПолучитьОбъект();
		ПрежнееНаименованиеКандидата = КандидатОбъект.Наименование;
		КандидатОбъект.ЗаполнитьНаименованиеПоДаннымКандидата(ЭтотОбъект);
		Если КандидатОбъект.Наименование <> ПрежнееНаименованиеКандидата Тогда
			Попытка 
				КандидатОбъект.Заблокировать();
			Исключение
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось изменить наименование у кандидата %1.
					|Возможно, данные редактируются другим пользователем'"),
					ПрежнееНаименованиеКандидата);
				ВызватьИсключение ТекстСообщения;
			КонецПопытки;
			КандидатОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//@skip-check property-return-type
//@skip-check invocation-parameter-type-intersect
Процедура ЗаписатьСвязанныеОбъекты()
	
	Если Не ДополнительныеСвойства.Свойство("СвязанныеОбъекты") Тогда
		Возврат;
	КонецЕсли;
	
	СвязанныеОбъекты = ДополнительныеСвойства.СвязанныеОбъекты; // Структура
	
	Если ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СвязанныеОбъекты, "ФизическоеЛицоСсылка")) Тогда
		ОбработатьСвязанноеФизическоеЛицо(СвязанныеОбъекты.ФизическоеЛицоСсылка);
	КонецЕсли;
	
	ДополнительныеСвойства.Удалить("СвязанныеОбъекты");
	
КонецПроцедуры

// Параметры:
//  ФизическоеЛицо - СправочникСсылка.ФизическиеЛица
//@skip-check invocation-parameter-type-intersect
//@skip-check property-return-type
Процедура ОбработатьСвязанноеФизическоеЛицо(ФизическоеЛицо)
	
	Если ДополнительныеСвойства.Свойство("ДанныеДляЗаполненияИзАрхива") Тогда
		Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.АрхивФизическихЛиц") Тогда
			МодульАрхивФизическихЛиц = ОбщегоНазначения.ОбщийМодуль("АрхивФизическихЛиц");
			МодульАрхивФизическихЛиц.ОбновитьФизическоеЛицоПоДаннымИзАрхива(ФизическоеЛицо,
				ДополнительныеСвойства.ДанныеДляЗаполненияИзАрхива);
		КонецЕсли;
		ДополнительныеСвойства.Удалить("ДанныеДляЗаполненияИзАрхива");
	КонецЕсли;
	
	РегистрыСведений.ФизическиеЛицаКандидатов.УстановитьСвязьКандидатаСФизическимЛицом(Ссылка, ФизическоеЛицо);
		
КонецПроцедуры

