
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ЕстьОшибки = Ложь;
	
	СоответсвиеВиджетов = Новый Соответствие;
	Для Каждого Стр Из Схема Цикл
		
		Если СоответсвиеВиджетов[Стр.ПозицияСтроки] = Неопределено Тогда
			Если Стр.ПозицияСтроки > КоличествоСтрок Тогда
				ТекстОшибки = НСтр("ru = 'Не верно заполнена позиция'");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, СтрШаблон("Схема[%1].ПозицияПоВысоте", Стр.НомерСтроки));
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			СоответсвиеВиджетов[Стр.ПозицияСтроки] = Новый Соответствие;
		КонецЕсли;
		
		СоотвествиеПоВысоте = СоответсвиеВиджетов[Стр.ПозицияСтроки];
		Если СоотвествиеПоВысоте[Стр.ПозицияКолонки] = Неопределено Тогда
			Если Стр.ПозицияКолонки > КоличествоКолонок Тогда
				ПолеСОшибкой = СтрШаблон(НСтр("ru = 'Схема[%1].ПозицияПоШирине'"), Схема.Индекс(Стр));
				ТекстОшибки = НСтр("ru = 'Не верно заполнена позиция'");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, ПолеСОшибкой);
				ЕстьОшибки = Истина;
			КонецЕсли;
			СоотвествиеПоВысоте[Стр.ПозицияКолонки] = Истина;
		Иначе
			ТекстОшибки = СтрШаблон(НСтр("ru = 'На позиции %1; %2 находится более одного виджета'"), 
				Стр.ПозицияСтроки, Стр.ПозицияКолонки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект);
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	МатрицаТалантов = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ГруппыВиджетов.МатрицаТалантов");
	Если Ссылка = МатрицаТалантов Тогда 
		ОбновитьВиджеты();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура ОбновитьВиджеты()
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.Виджеты");
		Блокировка.Заблокировать();
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Виджеты.Ссылка КАК Ссылка,
		|	Виджеты.ИспользуетсяВМатрицеТалантов КАК ИспользуетсяВМатрицеТалантов
		|ПОМЕСТИТЬ СписокВиджетов
		|ИЗ
		|	Справочник.Виджеты КАК Виджеты
		|ГДЕ
		|	Виджеты.Ссылка В(&Виджеты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СписокВиджетов.Ссылка КАК Ссылка,
		|	ИСТИНА КАК НовоеЗначение
		|ИЗ
		|	СписокВиджетов КАК СписокВиджетов
		|ГДЕ
		|	НЕ СписокВиджетов.ИспользуетсяВМатрицеТалантов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Виджеты.Ссылка,
		|	ЛОЖЬ
		|ИЗ
		|	Справочник.Виджеты КАК Виджеты
		|		ЛЕВОЕ СОЕДИНЕНИЕ СписокВиджетов КАК СписокВиджетов
		|		ПО Виджеты.Ссылка = СписокВиджетов.Ссылка
		|ГДЕ
		|	СписокВиджетов.Ссылка ЕСТЬ NULL
		|	И Виджеты.ИспользуетсяВМатрицеТалантов";
		
		Запрос.УстановитьПараметр("Виджеты", Схема.ВыгрузитьКолонку("Виджет"));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Виджет = Выборка.Ссылка.ПолучитьОбъект();
			Виджет.ИспользуетсяВМатрицеТалантов = Выборка.НовоеЗначение;
			Виджет.Записать();
			
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры
#КонецОбласти

#КонецЕсли