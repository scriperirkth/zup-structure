// Создает и возвращает новую категорию награды.
// 
// Параметры:
//  Наименование - Строка - 
Функция НоваяКатегорияНаграды(Наименование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КатегорииНаград.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КатегорииНаград КАК КатегорииНаград
	|ГДЕ
	|	КатегорииНаград.Наименование = &Наименование"	
	;
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		УстановитьПривилегированныйРежим(Истина);
		КатегорияНаграды = Справочники.КатегорииНаград.СоздатьЭлемент();
		КатегорияНаграды.Наименование = Наименование;
		КатегорияНаграды.ОбменДанными.Загрузка = Истина;
		КатегорияНаграды.Записать();
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат КатегорияНаграды.Ссылка;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецЕсли