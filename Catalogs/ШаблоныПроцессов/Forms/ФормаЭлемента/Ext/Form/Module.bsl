&НаКлиенте
Процедура ОткрытьФормуНастройкиДополнительныхОбработчиков(Знач Объект, ДанныеЭтапа, Элемент) Экспорт
	
	ДопОбработчики = Новый Массив;
	Для Каждого ДопОбработчик Из Объект.ДополнительныеОбработчики Цикл
		Если ДопОбработчик.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеОбработчика = Новый Структура;
			ДанныеОбработчика.Вставить("Статус", ДопОбработчик.Статус);
			ДанныеОбработчика.Вставить("Обработчик", ДопОбработчик.Обработчик);
			ДанныеОбработчика.Вставить("ОбработчикДоТранзакции", ДопОбработчик.ОбработчикДоТранзакции);
			ДанныеОбработчика.Вставить("ОбработчикКлиентский", ДопОбработчик.ОбработчикКлиентский);
			ДопОбработчики.Добавить(ДанныеОбработчика);
		КонецЕсли;
	КонецЦикла;
	
	События = Новый Массив;
	Для Каждого Событие Из Объект.ИнициирующиеСобытия Цикл
		Если Событие.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеСобытия = Новый Структура;
			ДанныеСобытия.Вставить("Статус", Событие.Статус);
			ДанныеСобытия.Вставить("Событие", Событие.Событие);
			События.Добавить(ДанныеСобытия);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторТекущегоЭтапа", 	ДанныеЭтапа.ИдентификаторЭтапа);
	ПараметрыФормы.Вставить("НаименованиеТекущегоЭтапа", 	ДанныеЭтапа.НаименованиеЭтапа);
	ПараметрыФормы.Вставить("НомерТекущегоЭтапа", 			ПолучитьПредставлениеЭтапа(Объект, ДанныеЭтапа.ИдентификаторЭтапа));
	ПараметрыФормы.Вставить("ТекущийЭтап", 					ДанныеЭтапа.Этап);
	ПараметрыФормы.Вставить("ВладелецЭтапа", 				Объект.Ссылка);
	ПараметрыФормы.Вставить("ИдентификаторДокумента", 		Объект.ИдентификаторДокумента);
	ПараметрыФормы.Вставить("ДопОбработчики", 				ДопОбработчики);
	ПараметрыФормы.Вставить("События", 						События);
	
	ОткрытьФорму("Справочник.ШаблоныПроцессов.Форма.НастройкаДополнительныхОбработчиков", ПараметрыФормы, Элемент);
	
КонецПроцедуры

