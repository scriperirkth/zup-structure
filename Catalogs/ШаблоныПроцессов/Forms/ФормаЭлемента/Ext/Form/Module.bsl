
#Область ОписаниеПеременных

&НаКлиенте
Перем ИдентификаторДокументаПрежнееЗначение;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроцессыОбработкиДокументов.ЗаполнитьСписокДоступныхИдентификаторов(СписокДоступныхИдентификаторов);
	
	Элементы.ИдентификаторДокумента.ПараметрыВыбора = Новый ФиксированныйМассив(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		Новый ПараметрВыбора("Отбор.Ссылка", СписокДоступныхИдентификаторов)));
	
	ГиперссылкиЭлементовСхемы = Новый Структура;
	
	ЗаполнитьСписокПодключаемыхОбработчиков();
	
	ЗаполнитьСписокИнициирующихСобытий();
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ОбновитьВычисляемыеПоля();
	КонецЕсли;
	
	УстановитьРежимРедактированияСхемы(Элементы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ЭтапыФлажокПодписыватьФайлыЭП",
		"Видимость",
		Константы.ПодписыватьПрисоединенныеФайлы.Получить()
		И Константы.ПодписьФайловНастраиваетсяВШаблоне.Получить());
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ЭтапыФлажокОбменСЛичнымКабинетом",
		"Видимость",
		Константы.ИспользоватьОбменСЛичнымКабинетомПОД.Получить());
		
	ФормированиеФормуляровВключено = ПроцессыОбработкиДокументов.ВключенаПоддержкаФормированияИПодписанияФормуляров();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаЭДОСКонтрагентами",
		"Видимость",
		ПроцессыОбработкиДокументов.ПоддерживаетсяИнтеграцияСБЭД() И ФормированиеФормуляровВключено);
		
	ПроцессыОбработкиДокументовПереопределяемый.ПриСозданииНаСервереФормыШаблонаПроцесса(ЭтотОбъект, Отказ);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ВерсионированиеОбъектов") Тогда
		МодульВерсионированиеОбъектов = ОбщегоНазначения.ОбщийМодуль("ВерсионированиеОбъектов");
		МодульВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЗаполнитьСписокРеквизитовДляРасчетаСроковОбработки();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ИдентификаторПоддержкиСтрокой = Объект.ИдентификаторПоддержки;
	
	ОбновитьВычисляемыеПоля();
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриЧтенииНаСервереФормыШаблонаПроцесса(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписьЭтапаПроцесса" Тогда
		
		ЗаполнитьРеквизитыЭтапов(Объект.Этапы, СтатусыЭтапов);
		
		ЗаполнитьПризнакиОтстутвующихСтатусов(Объект, СтатусыЭтапов);
		
		ВычислитьНомераКартинок(Объект.Этапы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьСписокПоключаемыхКлиентскихОбработчиков();
	
	ВычислитьОписаниеДополнительныхОбработчиков(Объект, СписокПодключаемыхОбработчиков, СписокПодключаемыхКлиентскихОбработчиков);
	ВычислитьОписаниеИнициирующихСобытий(Объект, СписокИнициирующихСобытий);
	
	ИдентификаторДокументаПрежнееЗначение = Объект.ИдентификаторДокумента;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
		Отказ = Истина;
		ТекстСообщения = НСтр("ru = 'Для шаблона процесса не выбран тип документа. Запись шаблона невозможна.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект.Ссылка);
		Возврат;
	КонецЕсли;
	
	ПроверитьНаличиеОшибочноДоступныхРеквизитов(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьНаличиеЗапущенныхПроцессовИУдаленныхЭтапов(Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ЗначениеЗаполнено(ИдентификаторПоддержкиСтрокой)
		И ИдентификаторПоддержкиСтрокой <> Строка(ТекущийОбъект.ИдентификаторПоддержки) Тогда
		ТекущийОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержкиСтрокой);
	КонецЕсли;  

	Если Константы.ИспользоватьРеквизитыДокументовДляРасчетаСроковОбработки.Получить()
		И ТекущийОбъект.ИспользоватьРеквизитДляРасчетаСроковОбработки 
		И НЕ ЗначениеЗаполнено(ТекущийОбъект.РеквизитДляРасчетаСроковОбработки) Тогда
		ТекстСообщения = НСтр("ru = 'Необходимо заполнить реквизит документа для расчета сроков обработки,
								|относительно которого будет рассчитываться предельный срок выполнения'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,"Объект.РеквизитДляРасчетаСроковОбработки");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ВычислитьОписаниеПредшественников(Объект);
	ВычислитьОписаниеОграниченийДоступа(Объект, ПодписьФайловНастраиваетсяВШаблоне);
	ВычислитьОписаниеДополнительныхОбработчиков(Объект, СписокПодключаемыхОбработчиков, СписокПодключаемыхКлиентскихОбработчиков);
	ВычислитьОписаниеИнициирующихСобытий(Объект, СписокИнициирующихСобытий);
	ВычислитьОписаниеВлиянияНаДругиеПроцессы(Объект);
	ВычислитьНомераКартинок(Объект.Этапы);
	
	Оповестить("Запись_ШаблонПроцесса");
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьВычисляемыеПоляЭтапов(Объект.Этапы, Объект.ИсполнителиГрупповыхЭтапов);
	ЗаполнитьОписаниеУсловий();
	ЗаполнитьРеквизитТребуетсяПроведение(Объект);
	ЗаполнитьРеквизитыЭтапов(Объект.Этапы, СтатусыЭтапов);
	ЗаполнитьПризнакиОтстутвующихСтатусов(Объект, СтатусыЭтапов);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	Если ЗначениеЗаполнено(ИдентификаторПоддержкиСтрокой) Тогда
		Если Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторПоддержкиСтрокой) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Введен некорректный уникальный идентификатор'"),,
				"ИдентификаторПоддержкиСтрокой",, Отказ);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИдентификаторДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПроцессыОбработкиДокументовКлиент.ОткрытьФормуВыбораТипаДокумента(
		Элемент, ДанныеВыбора, СтандартнаяОбработка,
		Новый Структура("ТекущаяСтрока", Объект.ИдентификаторДокумента), СписокДоступныхИдентификаторов);
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторДокументаПриИзменении(Элемент)
	
	Если Объект.ИдентификаторДокумента = ИдентификаторДокументаПрежнееЗначение Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторДокументаПрежнееЗначение) Тогда
		ТекстСообщения = НСтр("ru='При изменении типа документа будут очищены данные, связанные с реквизитами документа:
			|ответственность, доступность, влияние на другие процессы, доп. условия старта и прерывания этапов.
			|
			|Продолжить и изменить тип документа?'");
			
		ОписаниеОповещения = Новый ОписаниеОповещения("ИдентификаторДокументаПриИзменении_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 30);
	Иначе
		ИдентификаторДокументаПрежнееЗначение = Объект.ИдентификаторДокумента;
	КонецЕсли;
	
	ЗаполнитьСписокРеквизитовДляРасчетаСроковОбработки();

КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторДокументаПриИзменении_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		Объект.ОтветственностьЗаРеквизиты.Очистить();
		Объект.ИзменениеРеквизитовЭтапов.Очистить();
		Объект.ОбязательныеРеквизиты.Очистить();
		Объект.НедоступныеРеквизиты.Очистить();
		Объект.ВлияниеНаДругиеПроцессы.Очистить();
		
		Для Каждого СтрокаПредшественник Из Объект.ПредшественникиЭтапов Цикл
			СтрокаПредшественник.УсловиеПерехода = "";
		КонецЦикла;
		Для Каждого СтрокаПрерывание Из Объект.ПрерываниеЭтапов Цикл
			СтрокаПрерывание.УсловиеПерехода = "";
		КонецЦикла;
		
		ПроверитьДопустимостьФункцийПоЭтапам();
		
		ВычислитьОписаниеПредшественников(Объект);
		ВычислитьОписаниеОграниченийДоступа(Объект, ПодписьФайловНастраиваетсяВШаблоне);
		ВычислитьОписаниеДополнительныхОбработчиков(Объект, СписокПодключаемыхОбработчиков, СписокПодключаемыхКлиентскихОбработчиков);
		ВычислитьОписаниеИнициирующихСобытий(Объект, СписокИнициирующихСобытий);
		ВычислитьОписаниеВлиянияНаДругиеПроцессы(Объект);
		ВычислитьНомераКартинок(Объект.Этапы);
		
		ИдентификаторДокументаПрежнееЗначение = Объект.ИдентификаторДокумента;
		
		ЕстьОтстутствующиеВМетаданныхРеквизиты = Ложь;
		
	Иначе
		Объект.ИдентификаторДокумента = ИдентификаторДокументаПрежнееЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СхемаШаблонаВыбор(Элемент)
	
	ПроцессыОбработкиДокументовКлиент.ОткрытьГиперссылкуЭлементаСхемы(Элемент.ТекущийЭлемент, ГиперссылкиЭлементовСхемы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования,
																	ЭтотОбъект,
																	"Объект.Описание",
																	"Описание шаблона процесса");
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьРеквизитДляРасчетаСроковОбработкиПриИзменении(Элемент)
	ЕстьЗаписьЧасовДнейДляРегламента = Ложь;
	Для Каждого СтрокаЭтап из Объект.Этапы Цикл
		
		Если ЗначениеЗаполнено(СтрокаЭтап.СрокиОбработкиПоРеквизитуДни) Тогда
			ЕстьЗаписьЧасовДнейДляРегламента = Истина;
			Прервать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаЭтап.СрокиОбработкиПоРеквизитуЧасы) Тогда
			ЕстьЗаписьЧасовДнейДляРегламента = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьЗаписьЧасовДнейДляРегламента Тогда
		Оповещение   = Новый ОписаниеОповещения("ОтветНаВопросОчисткаСроковОбработкиПоРеквизиту", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Существуют заполненные данные для расчета сроков обработки
									|по реквизиту. Произвести очистку?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("Очистить", НСтр("ru = 'Очистить'"));
		Кнопки.Добавить("Отмена", НСтр("ru = 'Отмена'"));
		ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
		ПараметрыВопроса.КнопкаПоУмолчанию = "Очистить";
		ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(Оповещение, ТекстВопроса, Кнопки, ПараметрыВопроса);	
	Иначе
		Объект.РеквизитДляРасчетаСроковОбработки = "";
		ВидимостьСрокиОбработкиПоРеквизиту = ?(Объект.ИспользоватьРеквизитДляРасчетаСроковОбработки, Истина, Ложь);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "РеквизитДляРасчетаСроковОбработки", "Видимость", ВидимостьСрокиОбработкиПоРеквизиту);

		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ЭтапыСрокиОбработкиПоРеквизитуДни", "Видимость", ВидимостьСрокиОбработкиПоРеквизиту);
	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ЭтапыСрокиОбработкиПоРеквизитуЧасы", "Видимость", ВидимостьСрокиОбработкиПоРеквизиту);

	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура РеквизитДляРасчетаСроковОбработкиОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
		Объект.РеквизитДляРасчетаСроковОбработки = ВыбранноеЗначение;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Этапы

&НаКлиенте
Процедура ЭтапыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекущегоЭтапа = Новый УникальныйИдентификатор;
	Элементы.Этапы.ТекущиеДанные.ИдентификаторЭтапа = ИдентификаторТекущегоЭтапа;
	Элементы.Этапы.ТекущиеДанные.ПредшественникиВариантИспользования = "ОдинИзПредшественников";
	
	Если Объект.Этапы.Количество() = 1 Тогда
		// Если добавляется первое действие, то его предшественник - старт процесса
		Элементы.Этапы.ТекущиеДанные.ПредшественникиВариантИспользования =
			"Старт,"+Элементы.Этапы.ТекущиеДанные.ПредшественникиВариантИспользования;
	ИначеЕсли Объект.Этапы.Количество() > 1 Тогда
		// В предшественники записывается действие, расположенной в таблице действий перед добавленным действием.
		КоличествоЭтапов = Объект.Этапы.Количество();
		НоваяСтрокаПредшественникиЭтапов = Объект.ПредшественникиЭтапов.Добавить();
		НоваяСтрокаПредшественникиЭтапов.ИдентификаторПредшественника = 
			Объект.Этапы[КоличествоЭтапов - 2].ИдентификаторЭтапа;
		НоваяСтрокаПредшественникиЭтапов.ИдентификаторПоследователя = ИдентификаторТекущегоЭтапа;
		НоваяСтрокаПредшественникиЭтапов.УсловиеРассмотрения = 
			ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка");
		
	КонецЕсли;
	
	Элементы.Этапы.ТекущиеДанные.ТребуетсяПроведение = Неопределено;
	Элементы.Этапы.ТекущиеДанные.ЗапретитьПроведениеОтменуПроведения = Ложь;
	Элементы.Этапы.ТекущиеДанные.ЗапретитьПерепроведение = Ложь;
	Элементы.Этапы.ТекущиеДанные.ВключатьВШтампВизуализацииЭП = Ложь;
	Элементы.Этапы.ТекущиеДанные.ИдентификаторыКомандПечатиСоШтампом = "";
	Элементы.Этапы.ТекущиеДанные.ОбособленнаяЗонаОтветственности = Ложь;
	
	ВычислитьОписаниеПредшественников(Объект);
	ВычислитьОписаниеОграниченийДоступа(Объект, ПодписьФайловНастраиваетсяВШаблоне);
	ВычислитьОписаниеДополнительныхОбработчиков(Объект, СписокПодключаемыхОбработчиков, СписокПодключаемыхКлиентскихОбработчиков);
	ВычислитьОписаниеИнициирующихСобытий(Объект, СписокИнициирующихСобытий);
	ВычислитьОписаниеВлиянияНаДругиеПроцессы(Объект);
	ВычислитьНомераКартинок(Объект.Этапы);
	
	ЗаполнитьВычисляемыеПоляЭтапов(Элементы.Этапы.ТекущиеДанные, Объект.ИсполнителиГрупповыхЭтапов);
	
	ЗаполнитьПорядокЭтаповШаблона();
	
	ЗаполнитьНедоступностьРеквизитовПоУмолчанию(Элементы.Этапы.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	Если НоваяСтрока И ОтменаРедактирования Тогда
		УдалитьСтрокиСвязанныхТабличныхЧастей(Элемент.ВыделенныеСтроки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущегоЭтапа = Элемент.ТекущиеДанные.ИдентификаторЭтапа;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыПередУдалением(Элемент, Отказ)
	УдалитьСтрокиСвязанныхТабличныхЧастей(Элемент.ВыделенныеСтроки);
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыПослеУдаления(Элемент)
	ЗаполнитьПорядокЭтаповШаблона();
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Настройки предшествеников.
	Если Поле.Имя = "ЭтапыПредшественникиЭтапаСтрокой" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиПредшественниковЭтапа(Объект, Элемент.ТекущиеДанные, Элемент);
		
	// Настройки ответственности.
	ИначеЕсли Поле.Имя = "ЭтапыОтветственностьСтрокой" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокОтветственность" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаОтветственность";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыОбособленнаяЗонаОтветственности" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаОтветственность";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокПервичныеДокументы" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаПервичныеДокументы";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокТребованияКПроведению" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаПроведение";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокОтменаПроведения" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаПроведение";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокТребованияКВыполнению" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаВыполение";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокЗапрещеноДобавлениеФайлов" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаПрисоединенныеФайлы";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокЗапрещеноИзменениеФайлов" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаПрисоединенныеФайлы";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокОбязательноНаличиеФайлов" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаПрисоединенныеФайлы";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокПодписыватьФайлыЭП" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаПрисоединенныеФайлы";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
	ИначеЕсли Поле.Имя = "ЭтапыФлажокОбменСЛичнымКабинетом" Тогда
		СтандартнаяОбработка = Ложь;
		СтартоваяСтраницаФормы = "СтраницаОбменСЛичнымКабинетом";
		ОткрытьФормуНастройкиОтветственности(Объект, Элемент.ТекущиеДанные, Элемент, СтартоваяСтраницаФормы);
		
	//Настройки обработчиков.
	ИначеЕсли Поле.Имя = "ЭтапыОбработчикиСтрокой" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиДополнительныхОбработчиков(Объект, Элемент.ТекущиеДанные, Элемент);
	
	//Настройки влияния на другие процессы.
	ИначеЕсли Поле.Имя = "ЭтапыВлияниеНаПроцессыСтрокой" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиВлиянияНаДругиеПроцессы(Объект, Элемент.ТекущиеДанные, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Модифицированность = Истина;
	
	ДанныеЭтапа = Элемент.ТекущиеДанные;
	
	Если ВыбранноеЗначение.ИмяНастройки = "НастройкаПорядкаВыполнения" Тогда
		
		ДанныеЭтапа.ПредшественникиВариантИспользования = ВыбранноеЗначение.ПредшественникиВариантИспользования;
		
		УстановитьПредшественниковЭтапа(Объект.ПредшественникиЭтапов, ДанныеЭтапа.ИдентификаторЭтапа, ВыбранноеЗначение.Предшественники);
		
		ВычислитьОписаниеПредшественников(Объект, ДанныеЭтапа);
		
		УстановитьПредшественниковЭтапа(Объект.ПрерываниеЭтапов, ДанныеЭтапа.ИдентификаторЭтапа, ВыбранноеЗначение.ПредшественникиПрерывание);
		
		ДанныеЭтапа.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске =
			ВыбранноеЗначение.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске;
		
		ДанныеЭтапа.НеЗапрещатьОтменуВыполненияПриНаличииПрерванных =
			ВыбранноеЗначение.НеЗапрещатьОтменуВыполненияПриНаличииПрерванных;
		
		ЗаполнитьПорядокЭтаповШаблона();
		
		Если ВыбранноеЗначение.УдаленыНесуществующиеСтатусы Тогда
			ДанныеЭтапа.ЕстьОтсутствующиеСтатусыВПорядкеВыполнения = Ложь;
		КонецЕсли;
		
	ИначеЕсли ВыбранноеЗначение.ИмяНастройки = "НастройкаОграниченийДоступа" Тогда
		
		ДанныеЭтапа.ЗапретитьПроведениеОтменуПроведения = ВыбранноеЗначение.ЗапретитьПроведениеОтменуПроведения;
		ДанныеЭтапа.ЗапретитьПерепроведение = ВыбранноеЗначение.ЗапретитьПерепроведение;
		ДанныеЭтапа.ВключатьВШтампВизуализацииЭП = ВыбранноеЗначение.ВключатьВШтампВизуализацииЭП;
		ДанныеЭтапа.ИдентификаторыКомандПечатиСоШтампом = ВыбранноеЗначение.ИдентификаторыКомандПечатиСоШтампом;
		ДанныеЭтапа.ЗапрещеноДобавлениеФайлов = ВыбранноеЗначение.ЗапрещеноДобавлениеФайлов;
		ДанныеЭтапа.ЗапрещеноИзменениеФайлов = ВыбранноеЗначение.ЗапрещеноИзменениеФайлов;
		ДанныеЭтапа.ОбособленнаяЗонаОтветственности = ВыбранноеЗначение.ОбособленнаяЗонаОтветственности;
		ДанныеЭтапа.НаличиеФайловОбязательно = ВыбранноеЗначение.НаличиеФайловОбязательно; 
		ДанныеЭтапа.РасшифровкаОбязательныхПрисоединенныхФайлов = ?(ДанныеЭтапа.НаличиеФайловОбязательно,
																	ВыбранноеЗначение.РасшифровкаОбязательныхПрисоединенныхФайлов, "");
		ДанныеЭтапа.ПодписыватьФайлыЭП = ВыбранноеЗначение.ПодписыватьФайлыЭП;
		ДанныеЭтапа.ЗапрещеноИсполнителюОтменятьВыполнениеЭтапа = ВыбранноеЗначение.ЗапрещеноИсполнителюОтменятьВыполнениеЭтапа;
		ДанныеЭтапа.ОбменСЛичнымКабинетом = ВыбранноеЗначение.ОбменСЛичнымКабинетом;
		ДанныеЭтапа.КодыНастройкиФормированияИПодписанияФормуляров = ВыбранноеЗначение.КодыНастройкиФормированияИПодписанияФормуляров; 
		ДанныеЭтапа.ФлажокФормированиеФормуляров = ВыбранноеЗначение.ЕстьНастройкиФормированияИПодписанияФормуляровЭтапа;
		
		УстановитьТребованияКПроведению(Объект, ДанныеЭтапа.ИдентификаторЭтапа, ВыбранноеЗначение.ТребованияКПроведению);
		ЗаполнитьРеквизитТребуетсяПроведение(Объект);
		
		УстановитьТребованияКВыполнению(Объект, ДанныеЭтапа.ИдентификаторЭтапа, ВыбранноеЗначение.ТребованияКВыполнению);
		
		УстановитьОграниченияДоступа(Объект,
			ДанныеЭтапа.ИдентификаторЭтапа,
			ВыбранноеЗначение.ОтмеченныеРеквизитыОтветственность,
			ВыбранноеЗначение.ОтмеченныеРеквизитыИзменение,
			ВыбранноеЗначение.ОтмеченныеОбязательныеРеквизиты,
			ВыбранноеЗначение.ОтмеченныеНедоступныеРеквизиты);
		
		УстановитьОграниченияДоступаПервичныеДокументы(Объект,
			ДанныеЭтапа.ИдентификаторЭтапа,
			ВыбранноеЗначение.ПервичныеДокументыОтветственность,
			ВыбранноеЗначение.ПервичныеДокументыНедоступность,
			ВыбранноеЗначение.ПервичныеДокументыОбязательность);
		
		Если ВыбранноеЗначение.УдалитьНесуществующиеРеквизиты Тогда
			УдалитьНесуществующиеРеквизитыНаСервере();
			ЕстьОтстутствующиеВМетаданныхРеквизиты = Ложь;
		КонецЕсли;
		
		Если ВыбранноеЗначение.УдаленыНесуществующиеСтатусы Тогда
			ДанныеЭтапа.ЕстьОтсутствующиеСтатусыВНастройкеПроведения = Ложь;
			ДанныеЭтапа.ЕстьОтсутствующиеСтатусыВНастройкеВыполнения = Ложь;
		КонецЕсли;
		
		ВычислитьОписаниеОграниченийДоступа(Объект, ПодписьФайловНастраиваетсяВШаблоне);
		ВычислитьНомераКартинок(Объект.Этапы);

		СохранитьНастройкиСвойствЭлементовФормы(ВыбранноеЗначение, ДанныеЭтапа.ИдентификаторЭтапа);	
		
	ИначеЕсли ВыбранноеЗначение.ИмяНастройки = "НастройкаДополнительныхОбработчиков" Тогда
		
		УстановитьДополнительныеОбработчики(Объект, ДанныеЭтапа.ИдентификаторЭтапа, ВыбранноеЗначение.ДопОбработчики);
		
		ВычислитьОписаниеДополнительныхОбработчиков(Объект, СписокПодключаемыхОбработчиков, СписокПодключаемыхКлиентскихОбработчиков);
		
		УстановитьИнициирующиеСобытия(Объект, ДанныеЭтапа.ИдентификаторЭтапа, ВыбранноеЗначение.События);
		
		ВычислитьОписаниеИнициирующихСобытий(Объект, СписокИнициирующихСобытий);
		
		Если ВыбранноеЗначение.УдаленыНесуществующиеСтатусы Тогда
			ДанныеЭтапа.ЕстьОтсутствующиеСтатусыВДопОбработчиках = Ложь;
		КонецЕсли;
		
	ИначеЕсли ВыбранноеЗначение.ИмяНастройки = "НастройкаВлиянияНаДругиеПроцессы" Тогда
		
		УстановитьВлияниеНаДругиеПроцессы(Объект, ДанныеЭтапа.ИдентификаторЭтапа, ВыбранноеЗначение.ВлияниеНаДругиеПроцессы);
		
		ВычислитьОписаниеВлиянияНаДругиеПроцессы(Объект);
		
		Если ВыбранноеЗначение.УдаленыНесуществующиеСтатусы Тогда
			ДанныеЭтапа.ЕстьОтсутствующиеСтатусыВНастройкеВлияния = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыПриИзменении(Элемент)
	ВычислитьОписаниеПредшественников(Объект);
	ЗаполнитьВычисляемыеПоляЭтапов(Объект.Этапы, Объект.ИсполнителиГрупповыхЭтапов);
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыИсполнительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Этапы.ТекущиеДанные;
	
	ПараметрыВыбораИсполнителя = Новый Структура;
	ПараметрыВыбораИсполнителя.Вставить("ЭтапВыполняетсяНесколькимиИсполнителями", ТекущиеДанные.ЭтапВыполняетсяНесколькимиИсполнителями);
	ПараметрыВыбораИсполнителя.Вставить("ЭтоВыборИзСпискаИсполнителей", Ложь);
	
	РезультатИсполнители = Новый Массив;
	Для Каждого Исполнитель Из Объект.ИсполнителиГрупповыхЭтапов Цикл
		Если Исполнитель.ИдентификаторЭтапа <> ТекущиеДанные.ИдентификаторЭтапа Тогда
			Продолжить;
		КонецЕсли;
		РезультатИсполнитель = Новый Структура;
		РезультатИсполнитель.Вставить("Исполнитель", Исполнитель.Исполнитель);
		РезультатИсполнитель.Вставить("ОсновнойОбъектАдресации", Исполнитель.ОсновнойОбъектАдресации);
		РезультатИсполнитель.Вставить("ДополнительныйОбъектАдресации", Исполнитель.ДополнительныйОбъектАдресации);
		РезультатИсполнитель.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", Исполнитель.ИмяРеквизитаОсновногоОбъектаАдресации);
		РезультатИсполнитель.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", Исполнитель.ИмяРеквизитаДополнительногоОбъектаАдресации);
		РезультатИсполнители.Добавить(РезультатИсполнитель);
	КонецЦикла;
	
	ПараметрыВыбораИсполнителя.Вставить("ИдентификаторЭтапаКуратора", ТекущиеДанные.ИдентификаторЭтапаКуратора);
	
	ПараметрыВыбораИсполнителя.Вставить("Исполнители", РезультатИсполнители);
	
	НедоступныеКураторы = Новый Соответствие;
	Для Каждого Этап Из Объект.Этапы Цикл
		// Текущий этап не может курировать сам себя
		Если Этап.ИдентификаторЭтапа = ТекущиеДанные.ИдентификаторЭтапа Тогда
			НедоступныеКураторы.Вставить(Этап.ИдентификаторЭтапа, Истина);
		// Один этап не может курировать несколько других
		ИначеЕсли ЗначениеЗаполнено(Этап.ИдентификаторЭтапаКуратора) Тогда
			НедоступныеКураторы.Вставить(Этап.ИдентификаторЭтапаКуратора, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Кураторы = Новый Массив;
	Для Каждого Этап Из Объект.Этапы Цикл
		Если НедоступныеКураторы.Получить(Этап.ИдентификаторЭтапа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Куратор = Новый Структура;
		Куратор.Вставить("НомерЭтапа", Этап.НомерСтроки);
		Куратор.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
		Куратор.Вставить("Этап", Этап.Этап);
		Куратор.Вставить("Исполнитель", Этап.Исполнитель);
		Кураторы.Добавить(Куратор);
	КонецЦикла;
	
	ПараметрыВыбораИсполнителя.Вставить("ДоступныеЭтапыКуратора", Кураторы);
	
	ПроцессыОбработкиДокументовКлиент.ВыбратьИсполнителя(
		Элемент, ТекущиеДанные.Исполнитель, , Истина, , Объект.ИдентификаторДокумента, ПараметрыВыбораИсполнителя);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыИсполнительОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Этапы.ТекущиеДанные;
	
	ОчиститьИсполнителяЭтапа(ТекущиеДанные);
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		Если ВыбранноеЗначение.Свойство("ЭтапВыполняетсяНесколькимиИсполнителями") Тогда
			ТекущиеДанные.ЭтапВыполняетсяНесколькимиИсполнителями = Истина;
			ТекущиеДанные.ИдентификаторЭтапаКуратора = ВыбранноеЗначение.ИдентификаторЭтапаКуратора;
			Для Каждого Исполнитель Из ВыбранноеЗначение.Исполнители Цикл
				ИсполнительГрупповогоЭтапа = Объект.ИсполнителиГрупповыхЭтапов.Добавить();
				ЗаполнитьЗначенияСвойств(ИсполнительГрупповогоЭтапа, Исполнитель);
				ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа = ТекущиеДанные.ИдентификаторЭтапа;
			КонецЦикла;
		Иначе
			ТекущиеДанные.Исполнитель = ВыбранноеЗначение.РольИсполнителя;
			ТекущиеДанные.ОсновнойОбъектАдресации = ВыбранноеЗначение.ОсновнойОбъектАдресации;
			ТекущиеДанные.ДополнительныйОбъектАдресации = ВыбранноеЗначение.ДополнительныйОбъектАдресации;
			ТекущиеДанные.ИмяРеквизитаОсновногоОбъектаАдресации = ВыбранноеЗначение.ИмяРеквизитаОсновногоОбъектаАдресации;
			ТекущиеДанные.ИмяРеквизитаДополнительногоОбъектаАдресации = ВыбранноеЗначение.ИмяРеквизитаДополнительногоОбъектаАдресации;
		КонецЕсли;
		Модифицированность = Истина;
	Иначе
		ТекущиеДанные.Исполнитель = ВыбранноеЗначение;
	КонецЕсли;
	
	ЗаполнитьПредставлениеИсполнителя(ТекущиеДанные, Объект.ИсполнителиГрупповыхЭтапов);
	
	// Если был сброшен флаг группового выполнения, то необходимо сбросить флаг "ЛюбаяЗадачаПредшественника"
	// в таблицах "ПредшественникиЭтапов" и "ПрерываниеЭтапов"
	Если НЕ ТекущиеДанные.ЭтапВыполняетсяНесколькимиИсполнителями Тогда
		Для Каждого ПредшественникиЭтапов Из Объект.ПредшественникиЭтапов Цикл
			Если ПредшественникиЭтапов.ИдентификаторПредшественника = ТекущиеДанные.ИдентификаторЭтапа
				И ПредшественникиЭтапов.ЛюбаяЗадачаПредшественника Тогда
				ПредшественникиЭтапов.ЛюбаяЗадачаПредшественника = Ложь;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ПрерываниеЭтапов Из Объект.ПрерываниеЭтапов Цикл
			Если ПрерываниеЭтапов.ИдентификаторПредшественника = ТекущиеДанные.ИдентификаторЭтапа
				И ПрерываниеЭтапов.ЛюбаяЗадачаПредшественника Тогда
				ПрерываниеЭтапов.ЛюбаяЗадачаПредшественника = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыИсполнительЭтапаСтрокойОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Этапы.ТекущиеДанные;
	
	ОчиститьИсполнителяЭтапа(ТекущиеДанные);
	
