&НаКлиенте
Процедура ОтветНаВопросОчисткаСроковОбработкиПоРеквизиту(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ОтветНаВопрос = Результат.Значение;
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда 
		ОтветНаВопрос = Результат;
	Иначе 
		Объект.ИспользоватьРеквизитДляРасчетаСроковОбработки = Истина;
	КонецЕсли;
	
	Если ОтветНаВопрос = "Очистить" Тогда
		
		 Для Каждого СтрокаЭтап из Объект.Этапы Цикл
			
			Если ЗначениеЗаполнено(СтрокаЭтап.СрокиОбработкиПоРеквизитуДни) Тогда
				СтрокаЭтап.СрокиОбработкиПоРеквизитуДни = 0;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаЭтап.СрокиОбработкиПоРеквизитуЧасы) Тогда
				СтрокаЭтап.СрокиОбработкиПоРеквизитуЧасы = 0;
			КонецЕсли;
			
		КонецЦикла;
		
		Объект.РеквизитДляРасчетаСроковОбработки = "";
		ВидимостьСрокиОбработкиПоРеквизиту = ?(Объект.ИспользоватьРеквизитДляРасчетаСроковОбработки, Истина, Ложь);
	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ЭтапыСрокиОбработкиПоРеквизитуДни", "Видимость", ВидимостьСрокиОбработкиПоРеквизиту);
	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ЭтапыСрокиОбработкиПоРеквизитуЧасы", "Видимость", ВидимостьСрокиОбработкиПоРеквизиту);
		
    ИначеЕсли  ОтветНаВопрос = "Отмена" Тогда

		Объект.ИспользоватьРеквизитДляРасчетаСроковОбработки = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСписокРеквизитовДляРасчетаСроковОбработки()
	
	Если Константы.ИспользоватьРеквизитыДокументовДляРасчетаСроковОбработки.Получить() 
		И ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
		
		ИдентификаторДокумента = Объект.ИдентификаторДокумента;
		ТипДата = Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата));
		ТипДатаВремя = Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
		
		СписокВыбораВВидеМасива = Новый Массив; 
		МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
		Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл 
			
			Если Реквизит.Тип = ТипДата Или Реквизит.Тип=ТипДатаВремя Тогда
				Если Не СтрНайти(Реквизит.Имя,"Удалить",,1) > 0 Тогда 
					СписокВыбораВВидеМасива.Добавить(Реквизит.Имя);
					Элементы.РеквизитДляРасчетаСроковОбработки.СписокВыбора.Добавить(Реквизит.Имя, 
																			Реквизит.Синоним + " ["+Реквизит.Имя+"]");
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;
		
		ВидимостьСрокиОбработкиПоРеквизиту = ?(Объект.ИспользоватьРеквизитДляРасчетаСроковОбработки, Истина, Ложь);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "РеквизитДляРасчетаСроковОбработки", "Видимость", ВидимостьСрокиОбработкиПоРеквизиту); 
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ЭтапыСрокиОбработкиПоРеквизитуДни", "Видимость", ВидимостьСрокиОбработкиПоРеквизиту);
	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ЭтапыСрокиОбработкиПоРеквизитуЧасы", "Видимость", ВидимостьСрокиОбработкиПоРеквизиту);

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиСвойствЭлементовФормы(СтруктураЭлементов, ИдентификаторЭтапа)
	МассивЭлементов = Новый Массив;
	МассивСтраницаРодитель = Новый Массив;
	ЗначениеСтраницыПоУмолчанию = Неопределено;

	//удаление всех элементов текущего этапа
	КоличествоЭлементов = Объект.УправлениеЭлементамиФормы.Количество() - 1;
	ИндексСтроки = КоличествоЭлементов;
	Для Счетчик = 0 по КоличествоЭлементов Цикл
		Запись = Объект.УправлениеЭлементамиФормы.Получить(ИндексСтроки);
		Если Запись.ИдентификаторЭтапа = ИдентификаторЭтапа Тогда
			Объект.УправлениеЭлементамиФормы.Удалить(Запись);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтруктураЭлементов.СтартоваяСтраница) 
		И СтруктураЭлементов.СтартоваяСтраница.Количество() = 2  Тогда
		МассивСтраницаРодитель.Добавить(СтруктураЭлементов.СтартоваяСтраница[0]);
		ЗначениеСтраницыПоУмолчанию = СтруктураЭлементов.СтартоваяСтраница[1];
	КонецЕсли;
	
	МассивНедоступныхЭлементов = СтруктураЭлементов.НедоступныеЭлементы; 
	МассивНевидимыхЭлементов = СтруктураЭлементов.НевидимыеЭлементы;
	МассивЭлементовСОтметкойНезаполненного = СтруктураЭлементов.ЭлементыСОтметкойНезаполненного;
	

	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЭлементов, МассивНедоступныхЭлементов, Истина); 
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЭлементов, МассивНевидимыхЭлементов, Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЭлементов, МассивЭлементовСОтметкойНезаполненного, Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЭлементов, МассивСтраницаРодитель, Истина);

	Для Каждого СохраняемыйЭлемент Из МассивЭлементов Цикл
		
		Отбор = Новый Структура("ИдентификаторЭтапа, ИмяЭлемента", ИдентификаторЭтапа, СохраняемыйЭлемент);
		НайденныеСтроки = Объект.УправлениеЭлементамиФормы.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НовыйЭлемент = Объект.УправлениеЭлементамиФормы.Добавить();
			НовыйЭлемент.ИмяЭлемента = СохраняемыйЭлемент;
			НовыйЭлемент.ИдентификаторЭтапа = ИдентификаторЭтапа;
			
		Иначе
			НовыйЭлемент = НайденныеСтроки[0];
		КонецЕсли;
		
		НовыйЭлемент.ЗапретДоступности = МассивНедоступныхЭлементов.Найти(СохраняемыйЭлемент) <> Неопределено;
		НовыйЭлемент.ЗапретВидимости = МассивНевидимыхЭлементов.Найти(СохраняемыйЭлемент) <> Неопределено;
		НовыйЭлемент.ОтметкаНезаполненного = МассивЭлементовСОтметкойНезаполненного.Найти(СохраняемыйЭлемент) <> Неопределено;
		Если МассивСтраницаРодитель.Найти(СохраняемыйЭлемент) <> Неопределено 
			И ЗначениеЗаполнено(ЗначениеСтраницыПоУмолчанию) Тогда
			НовыйЭлемент.СтартоваяСтраница = ЗначениеСтраницыПоУмолчанию;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

#КонецОбласти
