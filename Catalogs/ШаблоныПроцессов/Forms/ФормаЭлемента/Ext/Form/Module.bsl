&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеЭтапа(Знач Объект, ИдентификаторЭтапа)
	
	ПараметрыОтбора = Новый Структура("ИдентификаторЭтапа", ИдентификаторЭтапа);
	МассивНайденных = Объект.Этапы.НайтиСтроки(ПараметрыОтбора);
	Если МассивНайденных.Количество() > 0 Тогда
		НайденныйЭтап = МассивНайденных[0];
		Возврат Строка(Объект.Этапы.Индекс(НайденныйЭтап) + 1);
	КонецЕсли;
	Возврат "";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьВычисляемыеПоляЭтапов(ЭтапЭтапы, ИсполнителиГрупповыхЭтапов) Экспорт
	
	Если ТипЗнч(ЭтапЭтапы) = Тип("ДанныеФормыЭлементКоллекции") Тогда
		МассивЭтапов = Новый Массив;
		МассивЭтапов.Добавить(ЭтапЭтапы);
	Иначе
		МассивЭтапов = ЭтапЭтапы;
	КонецЕсли;
	
	Для Каждого Этап Из МассивЭтапов Цикл
		
		Этап.НаименованиеЭтапа = Строка(Этап.Этап);
		
		ЗаполнитьПредставлениеИсполнителя(Этап, ИсполнителиГрупповыхЭтапов);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВлияниеНаДругиеПроцессы(Знач Объект, ИдентификаторЭтапа, ВлияниеНаДругиеПроцессы)
	
	МассивЭлементовКУдалению = Новый Массив;
	Для Каждого Элемент Из Объект.ВлияниеНаДругиеПроцессы Цикл
		Если Элемент.ИдентификаторЭтапа = ИдентификаторЭтапа Тогда
			МассивЭлементовКУдалению.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементКУдалению Из МассивЭлементовКУдалению Цикл
		Объект.ВлияниеНаДругиеПроцессы.Удалить(ЭлементКУдалению);
	КонецЦикла;
	
	Для Каждого Влияние Из ВлияниеНаДругиеПроцессы Цикл
		НоваяСтрока = Объект.ВлияниеНаДругиеПроцессы.Добавить();
		НоваяСтрока.ИдентификаторЭтапа = ИдентификаторЭтапа;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Влияние.Значение);
	КонецЦикла;
	
КонецПроцедуры

