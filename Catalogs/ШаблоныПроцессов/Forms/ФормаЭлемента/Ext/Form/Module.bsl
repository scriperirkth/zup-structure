&НаКлиенте
Процедура ЗаполнитьПорядокЭтаповШаблона()
	
	Для Каждого Этап Из Объект.Этапы Цикл
		Этап.Порядок = 99;
		Если Лев(Этап.ПредшественникиВариантИспользования,6) = "Старт," Тогда
			Этап.Порядок = 0;
		КонецЕсли;
	КонецЦикла;
	
	ТекущийПорядок = 0;
	ПоследнееКоличествоСНеПрисвоеннымПорядком = 0;
	ТекущееКоличествоСНеПрисвоеннымПорядком = 99;
	Пока ТекущееКоличествоСНеПрисвоеннымПорядком <> ПоследнееКоличествоСНеПрисвоеннымПорядком Цикл
		ТекущееКоличествоСНеПрисвоеннымПорядком = ПоследнееКоличествоСНеПрисвоеннымПорядком;
		ПоследнееКоличествоСНеПрисвоеннымПорядком = 0;
		Для Каждого Этап Из Объект.Этапы Цикл
			Если Этап.Порядок <> 99 Тогда
				Продолжить;
			КонецЕсли;
			Предшественники = Объект.ПредшественникиЭтапов.НайтиСтроки(Новый Структура("ИдентификаторПоследователя", Этап.ИдентификаторЭтапа));
			МаксимальныйПорядокПредшественника = Неопределено;
			Для Каждого Предшественник Из Предшественники Цикл
				ДанныеПредшественника = Объект.Этапы.НайтиСтроки(Новый Структура("ИдентификаторЭтапа", Предшественник.ИдентификаторПредшественника));
				Если ДанныеПредшественника[0].Порядок = 99 Тогда
					// Если у одного из предшественников еще не заполнен порядок, то этапу на этой итерации порядок не присваивается
					Прервать;
				КонецЕсли;
				// Вычисляем максимальный порядок среди предшественников
				Если МаксимальныйПорядокПредшественника = Неопределено Тогда
					МаксимальныйПорядокПредшественника = ДанныеПредшественника[0].Порядок;
				Иначе
					МаксимальныйПорядокПредшественника = Макс(МаксимальныйПорядокПредшественника, ДанныеПредшественника[0].Порядок);
				КонецЕсли;
			КонецЦикла;
			Если МаксимальныйПорядокПредшественника <> Неопределено Тогда
				Этап.Порядок = МаксимальныйПорядокПредшественника + 1;
			КонецЕсли;
			Если Этап.Порядок = 99 Тогда
				ПоследнееКоличествоСНеПрисвоеннымПорядком = ПоследнееКоличествоСНеПрисвоеннымПорядком + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиСвязанныхТабличныхЧастей(ВыделенныеСтроки)
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		Строка = Объект.Этапы.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если Строка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторПоследователя", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ПредшественникиЭтапов.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ПредшественникиЭтапов.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторПредшественника", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ПредшественникиЭтапов.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ПредшественникиЭтапов.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторПоследователя", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ПрерываниеЭтапов.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ПрерываниеЭтапов.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторПредшественника", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ПрерываниеЭтапов.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ПрерываниеЭтапов.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторЭтапа", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ОтветственностьЗаРеквизиты.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ОтветственностьЗаРеквизиты.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторЭтапа", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ИзменениеРеквизитовЭтапов.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ИзменениеРеквизитовЭтапов.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторЭтапа", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.НедоступныеРеквизиты.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.НедоступныеРеквизиты.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторЭтапа", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ДополнительныеОбработчики.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ДополнительныеОбработчики.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторЭтапа", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ВлияниеНаДругиеПроцессы.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ВлияниеНаДругиеПроцессы.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторЭтапа", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ИнициирующиеСобытия.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ИнициирующиеСобытия.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторЭтапа", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.ИсполнителиГрупповыхЭтапов.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			Объект.ИсполнителиГрупповыхЭтапов.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторЭтапаКуратора", Строка.ИдентификаторЭтапа);
		МассивКУдалению = Объект.Этапы.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
			СтрокаКУдалению.ИдентификаторЭтапаКуратора = "";
			ТекстСообщения = НСтр("ru = 'Очищен этап куратора в этапе '") + СтрокаКУдалению.НомерСтроки + ". " + Строка(СтрокаКУдалению.Этап);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиПредшественниковЭтапа(Знач Объект, ДанныеЭтапа, Элемент) Экспорт
	
	ДоступнаОтметкаСтартовогоЭтапа = Истина;
	ВсеЭтапы = Новый СписокЗначений;
	Для Каждого Этап Из Объект.Этапы Цикл
		ДанныеОдногоЭтапа = Новый Структура;
		ДанныеОдногоЭтапа.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
		ДанныеОдногоЭтапа.Вставить("НаименованиеЭтапа", Этап.НаименованиеЭтапа);
		ДанныеОдногоЭтапа.Вставить("НомерЭтапа", ПолучитьПредставлениеЭтапа(Объект, Этап.ИдентификаторЭтапа));
		ДанныеОдногоЭтапа.Вставить("ШаблонЭтапа", Этап.Этап);
		ДанныеОдногоЭтапа.Вставить("ЭтапВыполняетсяНесколькимиИсполнителями", Этап.ЭтапВыполняетсяНесколькимиИсполнителями);
		ВсеЭтапы.Добавить(ДанныеОдногоЭтапа);
		Если Лев(Этап.ПредшественникиВариантИспользования, 6) = "Старт,"
			И Этап.ИдентификаторЭтапа <> ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДоступнаОтметкаСтартовогоЭтапа = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ПредшественникиЭтапа = Новый СписокЗначений;
	Для Каждого Предшественник Из Объект.ПредшественникиЭтапов Цикл
		Если Предшественник.ИдентификаторПоследователя = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеПредшественника = Новый Структура;
			ДанныеПредшественника.Вставить("ИдентификаторПредшественника", Предшественник.ИдентификаторПредшественника);
			ДанныеПредшественника.Вставить("УсловиеПерехода", Предшественник.УсловиеПерехода);
			ДанныеПредшественника.Вставить("УсловиеРассмотрения", Предшественник.УсловиеРассмотрения);
			ДанныеПредшественника.Вставить("ЛюбаяЗадачаПредшественника", Предшественник.ЛюбаяЗадачаПредшественника);
			ДанныеПредшественника.Вставить("ОписаниеУсловия", Предшественник.ОписаниеУсловия);
			ПредшественникиЭтапа.Добавить(ДанныеПредшественника);
		КонецЕсли;
	КонецЦикла;
	
	ПредшественникиПрерыванияЭтапа = Новый СписокЗначений;
	Для Каждого Предшественник Из Объект.ПрерываниеЭтапов Цикл
		Если Предшественник.ИдентификаторПоследователя = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеПредшественника = Новый Структура;
			ДанныеПредшественника.Вставить("ИдентификаторПредшественника", Предшественник.ИдентификаторПредшественника);
			ДанныеПредшественника.Вставить("УсловиеПерехода", Предшественник.УсловиеПерехода);
			ДанныеПредшественника.Вставить("УсловиеРассмотрения", Предшественник.УсловиеРассмотрения);
			ДанныеПредшественника.Вставить("ЛюбаяЗадачаПредшественника", Предшественник.ЛюбаяЗадачаПредшественника);
			ПредшественникиПрерыванияЭтапа.Добавить(ДанныеПредшественника);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Этапы", ВсеЭтапы);
	ПараметрыФормы.Вставить("Предшественники", ПредшественникиЭтапа);
	ПараметрыФормы.Вставить("ПредшественникиВариантИспользования", ДанныеЭтапа.ПредшественникиВариантИспользования);
	ПараметрыФормы.Вставить("ПредшественникиПрерывания", ПредшественникиПрерыванияЭтапа);
	ПараметрыФормы.Вставить("ИдентификаторТекущегоЭтапа", ДанныеЭтапа.ИдентификаторЭтапа);
	ПараметрыФормы.Вставить("ВладелецЭтапа", Объект.Ссылка);
	ПараметрыФормы.Вставить("ДоступнаОтметкаСтартовогоЭтапа", ДоступнаОтметкаСтартовогоЭтапа);
	ПараметрыФормы.Вставить("ИдентификаторДокумента", Объект.ИдентификаторДокумента);
	ПараметрыФормы.Вставить("РолеваяАдресация", ТипЗнч(ДанныеЭтапа.Исполнитель) = Тип("СправочникСсылка.РолиИсполнителей"));
	ПараметрыФормы.Вставить("ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске",
		ДанныеЭтапа.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске);
	ПараметрыФормы.Вставить("НеЗапрещатьОтменуВыполненияПриНаличииПрерванных",
		ДанныеЭтапа.НеЗапрещатьОтменуВыполненияПриНаличииПрерванных);
	
	ОткрытьФорму("Справочник.ШаблоныПроцессов.Форма.НастройкаПредшественниковЭтапа", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтветственности(Знач Объект, ДанныеЭтапа, Элемент, СтартоваяСтраницаФормы = "") Экспорт
	
	Предшественники = Новый Соответствие;
	Для Каждого Этап Из Объект.Этапы Цикл
		Если Этап.Порядок < ДанныеЭтапа.Порядок Тогда
			Предшественники.Вставить(Этап.ИдентификаторЭтапа, Истина);
		КонецЕсли;
	КонецЦикла;
	
	НесвязанныеЭтапы = ЭтапыНеИмеющиеОбщегоМаршрутаСЭтапом(ДанныеЭтапа.ИдентификаторЭтапа);
	
	ОтмеченныеРеквизитыОтветственность = Новый СписокЗначений;
	НедоступныеРеквизитыОтветственность = Новый СписокЗначений;
	НедоступныеРеквизитыДоступность = Новый СписокЗначений;
	Для Каждого ОтмеченныйРеквизит Из Объект.ОтветственностьЗаРеквизиты Цикл
		ДанныеРеквизита = Новый Структура;
		ДанныеРеквизита.Вставить("ИмяТабличнойЧасти", ОтмеченныйРеквизит.ИмяТабличнойЧасти);
		ДанныеРеквизита.Вставить("ИмяРеквизита", ОтмеченныйРеквизит.ИмяРеквизита);
		Если ОтмеченныйРеквизит.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ОтмеченныеРеквизитыОтветственность.Добавить(ДанныеРеквизита);
		Иначе
			Если НесвязанныеЭтапы.Получить(ОтмеченныйРеквизит.ИдентификаторЭтапа) = Неопределено Тогда
				НедоступныеРеквизитыОтветственность.Добавить(ДанныеРеквизита);
			КонецЕсли;
			Если Предшественники.Получить(ОтмеченныйРеквизит.ИдентификаторЭтапа) <> Неопределено Тогда
				НедоступныеРеквизитыДоступность.Добавить(ДанныеРеквизита);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОтмеченныеРеквизитыИзменение = Новый СписокЗначений;
	Для Каждого ОтмеченныйРеквизит Из Объект.ИзменениеРеквизитовЭтапов Цикл
		Если ОтмеченныйРеквизит.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеРеквизита = Новый Структура;
			ДанныеРеквизита.Вставить("ИмяТабличнойЧасти", ОтмеченныйРеквизит.ИмяТабличнойЧасти);
			ДанныеРеквизита.Вставить("ИмяРеквизита", ОтмеченныйРеквизит.ИмяРеквизита);
			ОтмеченныеРеквизитыИзменение.Добавить(ДанныеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	ОтмеченныеНедоступныеРеквизиты = Новый СписокЗначений;
	Для Каждого ОтмеченныйРеквизит Из Объект.НедоступныеРеквизиты Цикл
		Если ОтмеченныйРеквизит.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеРеквизита = Новый Структура;
			ДанныеРеквизита.Вставить("ИмяТабличнойЧасти", ОтмеченныйРеквизит.ИмяТабличнойЧасти);
			ДанныеРеквизита.Вставить("ИмяРеквизита", ОтмеченныйРеквизит.ИмяРеквизита);
			ОтмеченныеНедоступныеРеквизиты.Добавить(ДанныеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	ОтмеченныеОбязательныеРеквизиты = Новый СписокЗначений;
	Для Каждого ОтмеченныйРеквизит Из Объект.ОбязательныеРеквизиты Цикл
		Если ОтмеченныйРеквизит.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеРеквизита = Новый Структура;
			ДанныеРеквизита.Вставить("ИмяТабличнойЧасти", ОтмеченныйРеквизит.ИмяТабличнойЧасти);
			ДанныеРеквизита.Вставить("ИмяРеквизита", ОтмеченныйРеквизит.ИмяРеквизита);
			ОтмеченныеОбязательныеРеквизиты.Добавить(ДанныеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	ПервичныеДокументыОтветственность = Новый СписокЗначений;
	НедоступныеПервичныеДокументыОтветственность = Новый СписокЗначений;
	Для Каждого ОтмеченныйРеквизит Из Объект.ОтветственностьПервичныеДокументы Цикл
		ДанныеРеквизита = Новый Структура;
		ДанныеРеквизита.Вставить("ИдентификаторПечатнойФормы", ОтмеченныйРеквизит.ИдентификаторПечатнойФормы);
		ДанныеРеквизита.Вставить("ИмяТабличнойЧасти", ОтмеченныйРеквизит.ИмяТабличнойЧасти);
		ДанныеРеквизита.Вставить("ИмяРеквизита", ОтмеченныйРеквизит.ИмяРеквизита);
		Если ОтмеченныйРеквизит.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ПервичныеДокументыОтветственность.Добавить(ДанныеРеквизита);
		Иначе
			Если НесвязанныеЭтапы.Получить(ОтмеченныйРеквизит.ИдентификаторЭтапа) = Неопределено Тогда
				НедоступныеПервичныеДокументыОтветственность.Добавить(ДанныеРеквизита);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПервичныеДокументыНедоступность = Новый СписокЗначений;
	Для Каждого ОтмеченныйРеквизит Из Объект.НедоступностьПервичныеДокументы Цикл
		Если ОтмеченныйРеквизит.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеРеквизита = Новый Структура;
			ДанныеРеквизита.Вставить("ИдентификаторПечатнойФормы", ОтмеченныйРеквизит.ИдентификаторПечатнойФормы);
			ДанныеРеквизита.Вставить("ИмяТабличнойЧасти", ОтмеченныйРеквизит.ИмяТабличнойЧасти);
			ДанныеРеквизита.Вставить("ИмяРеквизита", ОтмеченныйРеквизит.ИмяРеквизита);
			ПервичныеДокументыНедоступность.Добавить(ДанныеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	ПервичныеДокументыОбязательность = Новый СписокЗначений;
	Для Каждого ОтмеченныйРеквизит Из Объект.ОбязательностьПервичныеДокументы Цикл
		Если ОтмеченныйРеквизит.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеРеквизита = Новый Структура;
			ДанныеРеквизита.Вставить("ИдентификаторПечатнойФормы", ОтмеченныйРеквизит.ИдентификаторПечатнойФормы);
			ДанныеРеквизита.Вставить("ИмяТабличнойЧасти", ОтмеченныйРеквизит.ИмяТабличнойЧасти);
			ДанныеРеквизита.Вставить("ИмяРеквизита", ОтмеченныйРеквизит.ИмяРеквизита);
			ПервичныеДокументыОбязательность.Добавить(ДанныеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	ТребованияКПроведению = Новый СписокЗначений;
	Для Каждого ТребованиеКПроведению Из Объект.ТребованияКПроведению Цикл
		Если ТребованиеКПроведению.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеПроведения = Новый Структура;
			ДанныеПроведения.Вставить("Статус", ТребованиеКПроведению.Статус);
			ДанныеПроведения.Вставить("ПризнакПроведенности", ТребованиеКПроведению.ПризнакПроведенности);
			ТребованияКПроведению.Добавить(ДанныеПроведения);
		КонецЕсли;
	КонецЦикла;
	
	ТребованияКВыполнению = Новый СписокЗначений;
	Для Каждого ТребованиеКВыполнению Из Объект.ТребованияКВыполнению Цикл
		Если ТребованиеКВыполнению.ИдентификаторЭтапа = ДанныеЭтапа.ИдентификаторЭтапа Тогда
			ДанныеПроведения = Новый Структура;
			ДанныеПроведения.Вставить("Статус", ТребованиеКВыполнению.Статус);
			ДанныеПроведения.Вставить("УсловиеВыполнения", ТребованиеКВыполнению.УсловиеВыполнения);
			ТребованияКВыполнению.Добавить(ДанныеПроведения);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНастроекСвойствЭлементовФормы = Объект.УправлениеЭлементамиФормы;
	СтруктураНастроекСвойствЭлементов = ПроцессыОбработкиДокументовКлиентСервер.ПолучитьСтруктуруНастроекСвойствЭлементовСогласноЭтапу(
		ТаблицаНастроекСвойствЭлементовФормы, ДанныеЭтапа.ИдентификаторЭтапа);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторТекущегоЭтапа", ДанныеЭтапа.ИдентификаторЭтапа);
	ПараметрыФормы.Вставить("НаименованиеТекущегоЭтапа", ДанныеЭтапа.НаименованиеЭтапа);
	ПараметрыФормы.Вставить("НомерТекущегоЭтапа", ПолучитьПредставлениеЭтапа(Объект, ДанныеЭтапа.ИдентификаторЭтапа));
	ПараметрыФормы.Вставить("ЗапретитьПроведениеОтменуПроведения", ДанныеЭтапа.ЗапретитьПроведениеОтменуПроведения);
	ПараметрыФормы.Вставить("ЗапретитьПерепроведение", ДанныеЭтапа.ЗапретитьПерепроведение);
	ПараметрыФормы.Вставить("ТребуетсяЭП", ДанныеЭтапа.ТребуетсяЭП ИЛИ ДанныеЭтапа.ТребуетсяПростаяЭП);
	ПараметрыФормы.Вставить("ВключатьВШтампВизуализацииЭП", ДанныеЭтапа.ВключатьВШтампВизуализацииЭП);
	ПараметрыФормы.Вставить("ИдентификаторыКомандПечатиСоШтампом", ДанныеЭтапа.ИдентификаторыКомандПечатиСоШтампом);
	ПараметрыФормы.Вставить("ОбособленнаяЗонаОтветственности", ДанныеЭтапа.ОбособленнаяЗонаОтветственности);
	ПараметрыФормы.Вставить("ТекущийЭтап", ДанныеЭтапа.Этап);
	ПараметрыФормы.Вставить("ЗапрещеноДобавлениеФайлов", ДанныеЭтапа.ЗапрещеноДобавлениеФайлов);
	ПараметрыФормы.Вставить("ЗапрещеноИзменениеФайлов", ДанныеЭтапа.ЗапрещеноИзменениеФайлов);
	ПараметрыФормы.Вставить("НаличиеФайловОбязательно", ДанныеЭтапа.НаличиеФайловОбязательно);
	ПараметрыФормы.Вставить("РасшифровкаОбязательныхПрисоединенныхФайлов", ДанныеЭтапа.РасшифровкаОбязательныхПрисоединенныхФайлов);

	ПараметрыФормы.Вставить("ПодписыватьФайлыЭП", ДанныеЭтапа.ПодписыватьФайлыЭП);
	ПараметрыФормы.Вставить("ОбменСЛичнымКабинетом", ДанныеЭтапа.ОбменСЛичнымКабинетом);
	ПараметрыФормы.Вставить("КодыНастройкиФормированияИПодписанияФормуляров", ДанныеЭтапа.КодыНастройкиФормированияИПодписанияФормуляров);
	
	ПараметрыФормы.Вставить("ВладелецЭтапа", Объект.Ссылка);
	ПараметрыФормы.Вставить("ВладелецЭтапаОбъект", Объект);
	ПараметрыФормы.Вставить("ИдентификаторДокумента", Объект.ИдентификаторДокумента);
	
	ПараметрыФормы.Вставить("ОтмеченныеРеквизитыОтветственность", ОтмеченныеРеквизитыОтветственность);
	ПараметрыФормы.Вставить("НедоступныеРеквизитыОтветственность", НедоступныеРеквизитыОтветственность);
	ПараметрыФормы.Вставить("НедоступныеРеквизитыДоступность", НедоступныеРеквизитыДоступность);
	ПараметрыФормы.Вставить("ОтмеченныеРеквизитыИзменение", ОтмеченныеРеквизитыИзменение);
	ПараметрыФормы.Вставить("ОтмеченныеНедоступныеРеквизиты", ОтмеченныеНедоступныеРеквизиты);
	ПараметрыФормы.Вставить("ОтмеченныеОбязательныеРеквизиты", ОтмеченныеОбязательныеРеквизиты);
	
	ПараметрыФормы.Вставить("ПервичныеДокументыОтветственность", ПервичныеДокументыОтветственность);
	ПараметрыФормы.Вставить("НедоступныеПервичныеДокументыОтветственность", НедоступныеПервичныеДокументыОтветственность);
	ПараметрыФормы.Вставить("ПервичныеДокументыНедоступность", ПервичныеДокументыНедоступность);
	ПараметрыФормы.Вставить("ПервичныеДокументыОбязательность", ПервичныеДокументыОбязательность);
	
