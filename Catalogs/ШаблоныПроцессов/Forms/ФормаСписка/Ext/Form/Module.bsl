
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьНастройки = Ложь;

	ФормированиеФормуляровВключено = ПроцессыОбработкиДокументов.ВключенаПоддержкаФормированияИПодписанияФормуляров();

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ЕстьНастройкиФормированияИПодписанияФормуляров",
		"Видимость",
		ФормированиеФормуляровВключено);
	
	ОформитьНеиспользуемыеШаблоны();
	
	ДоступностьНастроекУсиленнаяЭП = Константы.ИспользоватьЭлектронныеПодписи.Получить() И Константы.ИспользоватьЭППриВыполненииЭтапов.Получить();
	ДоступностьНастроекПростаяЭП = Константы.ИспользоватьПростыеЭППриВыполненииЭтапов.Получить();
	Элементы.ФормаНастройкаПодписиСсылочныхДанных.Видимость = ДоступностьНастроекУсиленнаяЭП ИЛИ ДоступностьНастроекПростаяЭП;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "НеИспользуется", Ложь, , , НЕ Настройки["ПоказыватьНеиспользуемыеШаблоны"]);
	
	ЕстьНастройки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЕстьНастройки Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список, "НеИспользуется", Ложь, , , НЕ ПоказыватьНеиспользуемыеШаблоны);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказыватьНеиспользуемыеШаблоныПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "НеИспользуется", Ложь, , , НЕ ПоказыватьНеиспользуемыеШаблоны);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьИмпортЭкспорт(Команда)
	ОткрытьФорму("Обработка.ИмпортЭкспортШаблоновПроцессов.Форма");
КонецПроцедуры

&НаКлиенте
Процедура НастроитьИспользование(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Шаблон", ТекущиеДанные.Ссылка);
	ПараметрыФормы.Вставить("ИдентификаторДокумента", ТекущиеДанные.ИдентификаторДокумента);
	
	ОткрытьФорму("РегистрСведений.НастройкаИспользованияШаблонов.Форма.НастройкаИспользованияШаблонов", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКорректностьШаблонов(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СтраницаОткрытия", "ПроверкаШаблонов");
	
	ОткрытьФорму("Справочник.ШаблоныПроцессов.Форма.ПроверкаКорректностиШаблонов", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПодписиСсылочныхДанных(Команда)
	ОткрытьФорму("РегистрСведений.НастройкаПодписиСсылочныхДанных.Форма.ФормаСписка",,ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОформитьНеиспользуемыеШаблоны()
	
	ЭлементОформления = Список.КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	ЭлементЦветаОформления = ЭлементОформления.Оформление.Элементы.Найти("TextColor");
	ЭлементЦветаОформления.Значение = Метаданные.ЭлементыСтиля.ТекстЗапрещеннойЯчейкиЦвет.Значение;
	ЭлементЦветаОформления.Использование = Истина;
	
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("НеИспользуется");
	ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОтбора.Использование  = Истина;
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти
