
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого ВыбранныйОбработчик Из СтрРазделить(Параметры.ВыбранныеОбработчики, ";", Ложь) Цикл
		ДоступныйОбработчик = Параметры.ДоступныеОбработчики.НайтиПоЗначению(ВыбранныйОбработчик);
		ДоступныйОбработчикГрупповой = Параметры.ДоступныеОбработчикиГрупповые.НайтиПоЗначению(ВыбранныйОбработчик);
		Если ДоступныйОбработчик <> Неопределено Тогда
			Представление = ДоступныйОбработчик.Представление;
		ИначеЕсли ДоступныйОбработчикГрупповой <> Неопределено Тогда
			Представление = ДоступныйОбработчикГрупповой.Представление;
		Иначе
			Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не найден обработчик с ID ""%1""'"), ВыбранныйОбработчик);
		КонецЕсли;
		НоваяСтрока = ДополнительныеОбработчики.Добавить();
		НоваяСтрока.Обработчик = ВыбранныйОбработчик;
		НоваяСтрока.Представление = Представление;
	КонецЦикла;
	
	Для Каждого ДоступныйОбработчик Из Параметры.ДоступныеОбработчики Цикл
		Элементы.ДополнительныеОбработчикиОбработчик.СписокВыбора.Добавить(
			ДоступныйОбработчик.Значение, ДоступныйОбработчик.Представление);
	КонецЦикла;
	Для Каждого ДоступныйОбработчик Из Параметры.ДоступныеОбработчикиГрупповые Цикл
		Элементы.ДополнительныеОбработчикиОбработчик.СписокВыбора.Добавить(
			ДоступныйОбработчик.Значение, ДоступныйОбработчик.Представление);
	КонецЦикла;
	
	ДоступныеОбработчикиГрупповые = Параметры.ДоступныеОбработчикиГрупповые;
	
	ВидОбработчиков = Параметры.ВидОбработчиков;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДополнительныеОбработчики

&НаКлиенте
Процедура ДополнительныеОбработчикиОбработчикПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДополнительныеОбработчики.ТекущиеДанные;
	ТекущиеДанные.Обработчик = ТекущиеДанные.Представление;
	
	Если НЕ ПустаяСтрока(ТекущиеДанные.Обработчик) Тогда
		ТекущийОбработчик = Элементы.ДополнительныеОбработчикиОбработчик.СписокВыбора.НайтиПоЗначению(ТекущиеДанные.Обработчик);
		Если ТекущийОбработчик = Неопределено Тогда
			ТекущиеДанные.Представление = "";
		Иначе
			ТекущиеДанные.Представление = ТекущийОбработчик.Представление;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	КоличествоГрупповыхОбработчиков = 0;
	ЕстьНегрупповые = Ложь;
	
	Для Каждого ДоступныйОбработчик Из ДополнительныеОбработчики Цикл
		Если НЕ ЗначениеЗаполнено(ДоступныйОбработчик.Обработчик) Тогда
			Продолжить;
		КонецЕсли;
		Если ДоступныеОбработчикиГрупповые.НайтиПоЗначению(ДоступныйОбработчик.Обработчик) <> Неопределено Тогда
			КоличествоГрупповыхОбработчиков = КоличествоГрупповыхОбработчиков + 1;
		Иначе
			ЕстьНегрупповые = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоГрупповыхОбработчиков > 0 И ЕстьНегрупповые Тогда
		ТекстСообщения = НСтр("ru = 'В списке не должно быть одновременно групповых и не групповых обработчиков'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если КоличествоГрупповыхОбработчиков > 1 Тогда
		ТекстСообщения = НСтр("ru = 'В списке может быть только один групповой обработчик'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ВыбранныеДопОбработчики = Новый Массив;
	
	Для Каждого ДоступныйОбработчик Из ДополнительныеОбработчики Цикл
		Если НЕ ЗначениеЗаполнено(ДоступныйОбработчик.Обработчик) Тогда
			Продолжить;
		КонецЕсли;
		ВыбранныеДопОбработчики.Добавить(ДоступныйОбработчик.Обработчик);
	КонецЦикла;
	
	ДанныеВозврата = Новый Структура;
	ДанныеВозврата.Вставить("ВидОбработчиков", ВидОбработчиков);
	ДанныеВозврата.Вставить("ВыбранныеДопОбработчики", ВыбранныеДопОбработчики);
	
	ОповеститьОВыборе(ДанныеВозврата);
	
КонецПроцедуры

#КонецОбласти
