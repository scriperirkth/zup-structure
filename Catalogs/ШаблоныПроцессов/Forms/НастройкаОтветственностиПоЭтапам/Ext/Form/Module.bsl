
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИдентификаторЭтапа = Параметры.ИдентификаторТекущегоЭтапа;
	ВладелецЭтапа = Параметры.ВладелецЭтапа;
	ИдентификаторДокумента = Параметры.ИдентификаторДокумента;
	
	ТекущийЭтапСтрокой = "№" + Параметры.НомерТекущегоЭтапа + " " + Параметры.НаименованиеТекущегоЭтапа;
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Настройка ответственности для этапа ""%1""'"),
		ТекущийЭтапСтрокой);
	
	ЗапретитьПроведениеОтменуПроведения = Параметры.ЗапретитьПроведениеОтменуПроведения;
	ЗапретитьПерепроведение = Параметры.ЗапретитьПерепроведение;
	ВключатьВШтампВизуализацииЭП = Параметры.ВключатьВШтампВизуализацииЭП;
	ОбособленнаяЗонаОтветственности = Параметры.ОбособленнаяЗонаОтветственности;
	
	ИдентификаторыКомандПечатиСоШтампом = Параметры.ИдентификаторыКомандПечатиСоШтампом;
	ВсеФормы = ПустаяСтрока(ИдентификаторыКомандПечатиСоШтампом) И ВключатьВШтампВизуализацииЭП;

	КодыНастройкиФормированияИПодписанияФормуляров = Параметры.КодыНастройкиФормированияИПодписанияФормуляров;

	ЗапрещеноДобавлениеФайлов = Параметры.ЗапрещеноДобавлениеФайлов;
	ЗапрещеноИзменениеФайлов = Параметры.ЗапрещеноИзменениеФайлов;
	НаличиеФайловОбязательно = Параметры.НаличиеФайловОбязательно;
	ПодписыватьФайлыЭП = Параметры.ПодписыватьФайлыЭП;

	ФормированиеФормуляровВключено = ПроцессыОбработкиДокументов.ВключенаПоддержкаФормированияИПодписанияФормуляров();
	
	ЗапрещеноИсполнителюОтменятьВыполнениеЭтапа = Параметры.ЗапрещеноИсполнителюОтменятьВыполнениеЭтапа;
	
	ЕстьЗамечанияКИнтеграцииМеханизмаФормированияФормуляров = ЕстьЗамечанияКИнтеграцииМеханизмаФормированияФормуляров();
	
	ОбменСЛичнымКабинетом = Параметры.ОбменСЛичнымКабинетом;
	
	ЗаполнитьДеревоРеквизитов(Параметры.ВладелецЭтапаОбъект);
	
	ОтметитьРеквизитыСогласноСписку(
		Параметры.ОтмеченныеРеквизитыОтветственность,
		Параметры.ОтмеченныеРеквизитыИзменение,
		Параметры.НедоступныеРеквизитыОтветственность,
		Параметры.НедоступныеРеквизитыДоступность,
		Параметры.ОтмеченныеОбязательныеРеквизиты,
		Параметры.ОтмеченныеНедоступныеРеквизиты);
	
	ЗаполнитьПервичныеДокументы(Параметры.ВладелецЭтапаОбъект);
	
	ОтметитьПервичныеДокументыСогласноСписку(
		Параметры.ПервичныеДокументыОтветственность,
		Параметры.НедоступныеПервичныеДокументыОтветственность,
		Параметры.ПервичныеДокументыНедоступность,
		Параметры.ПервичныеДокументыОбязательность);
		
	РасшифровкаОбязательныхПрисоединенныхФайлов = Параметры.РасшифровкаОбязательныхПрисоединенныхФайлов;
	
	РасшифровкаПрисоединенныхФайлов.ЗагрузитьЗначения(СтрРазделить(РасшифровкаОбязательныхПрисоединенныхФайлов, ";", Ложь));
	
	ПроцессыОбработкиДокументов.ПриПолученииФормыВидовПрисоединенныхФайлов(НаименованиеФормыВыбораВидовПрисоединенныхФайлов);
	
	ВидимостьГруппыЭП = ?(Параметры.ТребуетсяЭП, Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ПервичныеДокументыНастройкаФормированияИПодписанияФормуляра",
		"Видимость",
		ФормированиеФормуляровВключено);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаЭП",
		"Видимость",
		ВидимостьГруппыЭП);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СтраницаПервичныеДокументы",
		"Видимость",
		ВидимостьГруппыЭП);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаОтстутствующиеРеквизиты",
		"Видимость",
		Справочники.ШаблоныПроцессов.ПроверитьУдалитьНесуществующиеРеквизиты(Параметры.ВладелецЭтапаОбъект));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ПодписыватьФайлыЭП",
		"Видимость",
		ВидимостьГруппыЭП
		И Константы.ПодписыватьПрисоединенныеФайлы.Получить()
		И Константы.ПодписьФайловНастраиваетсяВШаблоне.Получить());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СтраницаОбменСЛичнымКабинетом",
		"Видимость",
		Константы.ИспользоватьОбменСЛичнымКабинетомПОД.Получить());
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ПредставлениеПечатныхФорм",
		"Доступность",
		ВключатьВШтампВизуализацииЭП);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
										Элементы,
										"РасшифровкаПрисоединенныхФайлов",
										"Видимость",
										НаличиеФайловОбязательно);
	
	ЗаполнитьТаблицуРезультатовВыполнения();
	
	Если ЗначениеЗаполнено(Параметры.СтартоваяСтраницаФормы) Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[Параметры.СтартоваяСтраницаФормы];
	КонецЕсли; 
	
	ЗаполнитьНастройкиУправленияСвойствамиЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеФлагамиДереваРеквизитов("Все");
	УправлениеФлагамиДереваПервичныхДокументов("Все");
	
	УправлениеДоступностьюЭлементовФормы();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаОтстутствующиеСтатусы", "Видимость", ВНастройкеЕстьОтсутствующиеСтатусы());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаОтстутствующиеСтатусы1", "Видимость", ВНастройкеЕстьОтсутствующиеСтатусы());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ИмяФормыНастроекСвойствЭлементов = "Справочник.ШаблоныПроцессов.Форма.НастройкаСвойствЭлементовПоЭтапам";
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ИсточникВыбора, "ИмяФормы")
		И ИсточникВыбора.ИмяФормы = ИмяФормыНастроекСвойствЭлементов Тогда
		
		НедоступныеЭлементы.ЗагрузитьЗначения(ВыбранноеЗначение.НедоступныеЭлементы); 
		НевидимыеЭлементы.ЗагрузитьЗначения(ВыбранноеЗначение.НевидимыеЭлементы); 
		ЭлементыСОтметкойНезаполненного.ЗагрузитьЗначения(ВыбранноеЗначение.ЭлементыСОтметкойНезаполненного);
		СтартоваяСтраница.ЗагрузитьЗначения(ВыбранноеЗначение.СтартоваяСтраница);
		
	Иначе
		
		ИдентификаторыКомандПечатиСоШтампом = ВыбранноеЗначение.ИдентификаторыКомандПечатиСоШтампом;
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗапретитьПроведениеОтменуПроведенияПриИзменении(Элемент)
	
	//Если ЗапретитьПроведениеОтменуПроведения Тогда
	//	Для Каждого ТекущиеДанные Из РезультатыВыполнения Цикл
	//		ТекущиеДанные.ТребованиеКПроведению = 0;
	//		ТекущиеДанные.ПредставлениеТребованиеКПроведению =
	//			Элементы.РезультатыВыполненияПредставлениеТребованиеКПроведению.СписокВыбора.НайтиПоЗначению(ТекущиеДанные.ТребованиеКПроведению).Представление;
	//	КонецЦикла;
	//КонецЕсли;
	
	ЗапретитьПерепроведение = ЗапретитьПроведениеОтменуПроведения;
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьПерепроведениеПриИзменении(Элемент)
	УправлениеДоступностьюЭлементовФормы();
КонецПроцедуры

&НаКлиенте
Процедура ВключатьВШтампВизуализацииЭППриИзменении(Элемент)
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВсеФормыПриИзменении(Элемент)
	
	Если ВсеФормы Тогда
		Для Каждого ПервичныйДокумент Из ПервичныеДокументы.ПолучитьЭлементы() Цикл
			ПервичныйДокумент.Пометка = ?(ПервичныйДокумент.НеИспользуется, Ложь, Истина);
		КонецЦикла;
	КонецЕсли;
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_РеквизитыДокумента

&НаКлиенте
Процедура РеквизитыПометкаПриИзменении(Элемент)
	УправлениеФлагамиДереваРеквизитов("Ответственность");
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПометкаДоступностьПриИзменении(Элемент)
	УправлениеФлагамиДереваРеквизитов("Доступность");
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПометкаИзменениеПриИзменении(Элемент)
	УправлениеФлагамиДереваРеквизитов("Изменение");
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПометкаОбязательныйПриИзменении(Элемент)
	УправлениеФлагамиДереваРеквизитов("Обязательность");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПервичныеДокументы

&НаКлиенте
Процедура ПервичныеДокументыПометкаОтветственностьПриИзменении(Элемент)
	УправлениеФлагамиДереваПервичныхДокументов("Ответственность");
КонецПроцедуры

&НаКлиенте
Процедура ПервичныеДокументыПометкаИзменениеПриИзменении(Элемент)
	УправлениеФлагамиДереваПервичныхДокументов("Изменение");
