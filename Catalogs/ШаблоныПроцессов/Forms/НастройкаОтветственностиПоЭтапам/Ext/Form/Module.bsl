&НаКлиенте
Процедура УстановитьОбязательностьРодителейРекурсивно(СтрокаДерева, ЗначениеФлага)
	
	Родитель = СтрокаДерева.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеФлагаГруппы = ЗначениеФлага;
	Для Каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
		Если Элемент.ПометкаОбязательный <> ЗначениеФлага Тогда
			ЗначениеФлагаГруппы = 2;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Родитель.ПометкаОбязательный = ЗначениеФлагаГруппы;
	
	УстановитьОбязательностьРодителейРекурсивно(Родитель, ЗначениеФлага);
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФлагамиДереваРеквизитовОтветственностьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ДополнительныеПараметры.ЭлементыДляОбработки Цикл
		Если Элемент.ЗапрещеноРедактированиеОтветственности Тогда
			Продолжить;
		КонецЕсли;
		
		Элемент.ПометкаОтветственность = ДополнительныеПараметры.ЗначениеФлага;
		
		Если ДополнительныеПараметры.ЗначениеФлага = 1 Тогда
			Элемент.ПометкаДоступность = 1;
			Элемент.ПометкаИзменение = 1;
			Элемент.ЗапрещеноРедактированиеИзменения = 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФлагамиДереваРеквизитовДоступностьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ДополнительныеПараметры.ЭлементыДляОбработки Цикл
		Элемент.ПометкаДоступность = ДополнительныеПараметры.ЗначениеФлага;
		
		Элемент.ПометкаИзменение = Элемент.ПометкаДоступность;
		Элемент.ЗапрещеноРедактированиеИзменения = Элемент.ПометкаДоступность = 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФлагамиДереваРеквизитовИзменениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ДополнительныеПараметры.ЭлементыДляОбработки Цикл
		Если Элемент.ЗапрещеноРедактированиеИзменения Тогда
			Продолжить;
		КонецЕсли;
		Элемент.ПометкаИзменение = ДополнительныеПараметры.ЗначениеФлага;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФлагамиДереваРеквизитовОбязательностьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ДополнительныеПараметры.ЭлементыДляОбработки Цикл
		Элемент.ПометкаОбязательный = ДополнительныеПараметры.ЗначениеФлага;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЕстьЗамечанияКИнтеграцииМеханизмаФормированияФормуляров()
	Результат = Ложь;
	
	ПроверяемыйДокумент = Документы.ФормулярПервичногоДокументаПОД.ПустаяСсылка();
	Если НЕ Метаданные.ОпределяемыеТипы.ВладелецПрисоединенныхФайлов.Тип.СодержитТип(ТипЗнч(ПроверяемыйДокумент)) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если НЕ Метаданные.ОпределяемыеТипы.ПолеРегистраКлючейДоступаКРегистрам.Тип.СодержитТип(ТипЗнч(ПроверяемыйДокумент)) Тогда
		Результат = Истина;
	КонецЕсли;
	
	ПроверяемыйСправочник = Справочники.ФормулярПервичногоДокументаПОДПрисоединенныеФайлы.ПустаяСсылка();
	Если НЕ Метаданные.ОпределяемыеТипы.ПодписанныйОбъект.Тип.СодержитТип(ТипЗнч(ПроверяемыйСправочник)) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если НЕ Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипЗнч(ПроверяемыйСправочник)) Тогда
		Результат = Истина;
	КонецЕсли;
	
    Возврат Результат;
КонецФункции	

&НаКлиенте
// Выделяет полужирным строку по разделителю.
//
// Параметры:
//  Текст  - Строка - текст, в котором нужно сделать форматное выделение.
//  Разделитель - Строка - разделитель, внутри которой будет выделение.
//  
// Возвращаемое значение:
//  ФорматированнаяСтрока - с полужирным выделением между разделителей.
//
Функция ВыделитьСтрокуПолужирнымПоРазделителю(Текст, Разделитель)
	   МассивФорматныхСтрок = Новый Массив;
	
	   МассивПодстрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Текст, Разделитель);
	   
	   Для Каждого ПодСтрока Из МассивПодстрок Цикл
	         ИндексСтроки=МассивПодстрок.Найти(ПодСтрока);
			 			 
			 Если ИндексСтроки%2 Тогда
				  МассивФорматныхСтрок.Добавить(Новый ФорматированнаяСтрока(Разделитель + ПодСтрока + Разделитель, Новый Шрифт(,,Истина)));
			  Иначе
				  МассивФорматныхСтрок.Добавить(Новый ФорматированнаяСтрока(ПодСтрока, Новый Шрифт(,, Ложь)));
			  КонецЕсли;	
			  
		КонецЦикла;	
		
		
		Возврат Новый ФорматированнаяСтрока(МассивФорматныхСтрок);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНастройкиУправленияСвойствамиЭлементовФормы()
	
	ПереченьТиповОграниченийДокументов = Новый Массив;
	ПроцессыОбработкиДокументовПереопределяемый.ПриПолученииОграниченийТиповДокументовУправленияСвойствамиФормы(
		ПереченьТиповОграниченийДокументов); 
	
	ПустаяСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "ЗначениеПустойСсылки");
	УправлениеСвойствамиФормыВозможно = ПереченьТиповОграниченийДокументов.Найти(ТипЗнч(ПустаяСсылка)) = Неопределено;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Элементы,
	"НастройкаСвойствЭлементовФормыДокумента",
	"Видимость",
	УправлениеСвойствамиФормыВозможно);
	
	Если Не УправлениеСвойствамиФормыВозможно Тогда
		Возврат;
	КонецЕсли;	
	
	Если Параметры.Свойство("НедоступныеЭлементы")
		И Параметры.НедоступныеЭлементы.Количество() > 0 Тогда
		НедоступныеЭлементы.ЗагрузитьЗначения(Параметры.НедоступныеЭлементы);
	КонецЕсли;
	
	Если Параметры.Свойство("НевидимыеЭлементы")
		И Параметры.НевидимыеЭлементы.Количество() > 0 Тогда
		НевидимыеЭлементы.ЗагрузитьЗначения(Параметры.НевидимыеЭлементы);
	КонецЕсли; 
	
	Если Параметры.Свойство("ЭлементыСОтметкойНезаполненного")
		И Параметры.НевидимыеЭлементы.Количество() > 0 Тогда
		ЭлементыСОтметкойНезаполненного.ЗагрузитьЗначения(Параметры.ЭлементыСОтметкойНезаполненного);
	КонецЕсли;
	
	Если Параметры.Свойство("СтартоваяСтраница")
		И Параметры.СтартоваяСтраница.Количество() = 2 Тогда
		СтартоваяСтраница.ЗагрузитьЗначения(Параметры.СтартоваяСтраница);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти