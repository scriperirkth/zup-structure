
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИдентификаторЭтапа = Параметры.ИдентификаторТекущегоЭтапа;
	ВладелецЭтапа = Параметры.ВладелецЭтапа;
	ИдентификаторДокумента = Параметры.ИдентификаторДокумента;
	
	Для Каждого Этап Из Параметры.Этапы Цикл
		
		ПодходитДляЗапуска = Истина;
		ПодходитДляПрерывания = Истина;
		Если Этап.Значение.ИдентификаторЭтапа = ИдентификаторЭтапа Тогда
			ТекущийЭтапСтрокой = "№" + Этап.Значение.НомерЭтапа + " " + Этап.Значение.НаименованиеЭтапа;
			ШаблонТекущегоЭтапа = Этап.Значение.ШаблонЭтапа;
			Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Порядок выполнения этапа ""%1""'"),
				ТекущийЭтапСтрокой);
			// этап не может инициировать сам себя
			ПодходитДляЗапуска = Ложь;
			// групповой этап разрешено использовать для прерывания самого себя, когда одна задача может прервать параллельные
			ПодходитДляПрерывания = Этап.Значение.ЭтапВыполняетсяНесколькимиИсполнителями;
		КонецЕсли;
		
		Если ПодходитДляЗапуска Тогда
			НовыйЭтап = Этапы.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйЭтап, Этап.Значение);
			НовыйЭтап.НеУдалять = Истина;
			НовыйЭтап.СписокРезультатовВыполнения = ПолучитьСписокУсловийРассмотрения(НовыйЭтап.ШаблонЭтапа);
			НовыйЭтап.СписокВыбораРезультатовВыполнения = СписокВыбораУсловийРассмотренияПоСпискуРезультатовВыполнения(
				НовыйЭтап.СписокРезультатовВыполнения, Этап.Значение.ЭтапВыполняетсяНесколькимиИсполнителями);
			Для Каждого Предшественник Из Параметры.Предшественники Цикл
				Если Предшественник.Значение.ИдентификаторПредшественника <> Этап.Значение.ИдентификаторЭтапа Тогда
					Продолжить;
				КонецЕсли;
				Если НовыйЭтап.Использовать Тогда
					НовыйЭтап = Этапы.Добавить();
					ЗаполнитьЗначенияСвойств(НовыйЭтап, Этап.Значение);
					НовыйЭтап.СписокРезультатовВыполнения = ПолучитьСписокУсловийРассмотрения(НовыйЭтап.ШаблонЭтапа);
					НовыйЭтап.СписокВыбораРезультатовВыполнения = СписокВыбораУсловийРассмотренияПоСпискуРезультатовВыполнения(
						НовыйЭтап.СписокРезультатовВыполнения, Этап.Значение.ЭтапВыполняетсяНесколькимиИсполнителями);
				КонецЕсли;
				НовыйЭтап.Использовать = Истина;
				НовыйЭтап.УсловиеПерехода = Предшественник.Значение.УсловиеПерехода;
				НовыйЭтап.УсловиеРассмотрения = Предшественник.Значение.УсловиеРассмотрения;
				Если НЕ ЗначениеЗаполнено(НовыйЭтап.УсловиеРассмотрения) Тогда
					НовыйЭтап.УсловиеРассмотрения = ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка");
				КонецЕсли;
				НовыйЭтап.ЛюбаяЗадачаПредшественника = Предшественник.Значение.ЛюбаяЗадачаПредшественника;
				// Поиск отсутствующих статусов
				НовыйЭтап.СтатусНеНайден = Истина;
				Для Каждого РезультатыВыполнения Из НовыйЭтап.СписокВыбораРезультатовВыполнения Цикл
					Если НовыйЭтап.УсловиеРассмотрения = РезультатыВыполнения.Значение.Статус
						И НовыйЭтап.ЛюбаяЗадачаПредшественника = РезультатыВыполнения.Значение.ЛюбаяЗадача Тогда
						НовыйЭтап.СтатусНеНайден = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НовыйЭтап.СтатусНеНайден Тогда
					НовыйЭтап.УсловиеРассмотренияПредставление = Строка(НовыйЭтап.УсловиеРассмотрения);
				Иначе
					НовыйЭтап.УсловиеРассмотренияПредставление = РезультатыВыполнения.Представление;
				КонецЕсли;
				НовыйЭтап.ОписаниеУсловия = ПроцессыОбработкиДокументов.ПредставлениеОтбораКомпоновщикаНастроек(НовыйЭтап.УсловиеПерехода);
			КонецЦикла;
		КонецЕсли;
		
		Если ПодходитДляПрерывания Тогда
			НовыйЭтап = ЭтапыПрерывание.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйЭтап, Этап.Значение);
			НовыйЭтап.НеУдалять = Истина;
			НовыйЭтап.СписокРезультатовВыполнения = ПолучитьСписокУсловийРассмотрения(НовыйЭтап.ШаблонЭтапа);
			НовыйЭтап.СписокВыбораРезультатовВыполнения = СписокВыбораУсловийРассмотренияПоСпискуРезультатовВыполнения(
				НовыйЭтап.СписокРезультатовВыполнения, Этап.Значение.ЭтапВыполняетсяНесколькимиИсполнителями, ПодходитДляЗапуска);
			Для Каждого Предшественник Из Параметры.ПредшественникиПрерывания Цикл
				Если Предшественник.Значение.ИдентификаторПредшественника <> Этап.Значение.ИдентификаторЭтапа Тогда
					Продолжить;
				КонецЕсли;
				Если НовыйЭтап.Использовать Тогда
					НовыйЭтап = ЭтапыПрерывание.Добавить();
					ЗаполнитьЗначенияСвойств(НовыйЭтап, Этап.Значение);
					НовыйЭтап.СписокРезультатовВыполнения = ПолучитьСписокУсловийРассмотрения(НовыйЭтап.ШаблонЭтапа);
					НовыйЭтап.СписокВыбораРезультатовВыполнения = СписокВыбораУсловийРассмотренияПоСпискуРезультатовВыполнения(
						НовыйЭтап.СписокРезультатовВыполнения, Этап.Значение.ЭтапВыполняетсяНесколькимиИсполнителями, ПодходитДляЗапуска);
				КонецЕсли;
				НовыйЭтап.Использовать = Истина;
				НовыйЭтап.УсловиеПерехода = Предшественник.Значение.УсловиеПерехода;
				НовыйЭтап.УсловиеРассмотрения = Предшественник.Значение.УсловиеРассмотрения;
				Если НЕ ЗначениеЗаполнено(НовыйЭтап.УсловиеРассмотрения) Тогда
					НовыйЭтап.УсловиеРассмотрения = ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка");
				КонецЕсли;
				НовыйЭтап.ЛюбаяЗадачаПредшественника = Предшественник.Значение.ЛюбаяЗадачаПредшественника;
				// Поиск отсутствующих статусов
				НовыйЭтап.СтатусНеНайден = Истина;
				Для Каждого РезультатыВыполнения Из НовыйЭтап.СписокВыбораРезультатовВыполнения Цикл
					Если НовыйЭтап.УсловиеРассмотрения = РезультатыВыполнения.Значение.Статус
						И НовыйЭтап.ЛюбаяЗадачаПредшественника = РезультатыВыполнения.Значение.ЛюбаяЗадача Тогда
						НовыйЭтап.СтатусНеНайден = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НовыйЭтап.СтатусНеНайден Тогда
					НовыйЭтап.УсловиеРассмотренияПредставление = Строка(НовыйЭтап.УсловиеРассмотрения);
				Иначе
					НовыйЭтап.УсловиеРассмотренияПредставление = РезультатыВыполнения.Представление;
				КонецЕсли;
				НовыйЭтап.ОписаниеУсловия = ПроцессыОбработкиДокументов.ПредставлениеОтбораКомпоновщикаНастроек(НовыйЭтап.УсловиеПерехода);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Параметры.ПредшественникиВариантИспользования) Тогда
		Если Лев(Параметры.ПредшественникиВариантИспользования,6) = "Старт," Тогда
			ПорядокИспользования = Сред(Параметры.ПредшественникиВариантИспользования,7);
			СтартовыйЭтап = Истина;
		Иначе
			ПорядокИспользования = Параметры.ПредшественникиВариантИспользования;
		КонецЕсли;
	Иначе
		ПорядокИспользования = "ВсеПредшественники";
		Для Каждого Строка Из Этапы Цикл
			Если Строка.Использовать Тогда
				ПорядокИспользования = "ВсеПредшественники";
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	НайденИспользуемыйПредшественник = Ложь;
	Для Каждого Строка Из Этапы Цикл
		Если Строка.Использовать Тогда
			НайденИспользуемыйПредшественник = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ НайденИспользуемыйПредшественник Тогда
		ПорядокИспользования = "ВсеПредшественники";
	КонецЕсли;
	
	ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске =
		Параметры.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске;
	
	НеЗапрещатьОтменуВыполненияПриНаличииПрерванных =
		Параметры.НеЗапрещатьОтменуВыполненияПриНаличииПрерванных;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтартовыйЭтап", "Видимость", Параметры.ДоступнаОтметкаСтартовогоЭтапа);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаОтстутствующиеСтатусы", "Видимость", ВНастройкеЕстьОтсутствующиеСтатусы(Этапы, ЭтапыПрерывание));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске", "Видимость", Параметры.РолеваяАдресация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ВыборЭтапаПроцесса"
		И ВыбранноеЗначение <> Неопределено Тогда
		
		Если Элементы.ГруппаСтраницыФормы.ТекущаяСтраница = Элементы.СтраницаСтарт Тогда
			СписокЭтапов = Этапы;
			ТаблицаЭтапы = Элементы.ОбъектЭтапы;
		ИначеЕсли Элементы.ГруппаСтраницыФормы.ТекущаяСтраница = Элементы.СтраницаПрерывание Тогда
			СписокЭтапов = ЭтапыПрерывание;
			ТаблицаЭтапы = Элементы.ОбъектЭтапыПрерывание;
		Иначе
			Возврат;
		КонецЕсли;
		
		КоличествоЭлементовКоллекции = СписокЭтапов.Количество();
		Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
			Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
			
			Этап = СписокЭтапов[Индекс];
			
			Если Этап.ИдентификаторЭтапа <> ВыбранноеЗначение.ИдентификаторЭтапа Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйЭтап = СписокЭтапов.Вставить(СписокЭтапов.Индекс(Этап) + 1);
			
			ЗаполнитьЗначенияСвойств(НовыйЭтап, Этап);
			
			НовыйЭтап.УсловиеПерехода = Неопределено;
			НовыйЭтап.ОписаниеУсловия = "";
			
			НовыйЭтап.НеУдалять = Ложь;
			
			ТаблицаЭтапы.ТекущаяСтрока = СписокЭтапов.Количество() - 1;
			
			Прервать;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОбъектЭтапы

&НаКлиенте
Процедура ОбъектЭтапыИспользоватьПриИзменении(Элемент)
	
	ТекущийЭтап = Элементы.ОбъектЭтапы.ТекущиеДанные;
	
	УстановитьДоступностьУсловияРассмотрения(ТекущийЭтап.СписокВыбораРезультатовВыполнения, Элементы.УсловиеРассмотрения);
	
	Если НЕ ТекущийЭтап.Использовать Тогда
		
		Элементы.УсловиеРассмотрения.ТолькоПросмотр = Истина;
		
		ТекущийЭтап.УсловиеРассмотрения = Неопределено;
		ТекущийЭтап.УсловиеПерехода = Неопределено;
		ТекущийЭтап.ИмяПредметаУсловия = Неопределено;
		ТекущийЭтап.ОписаниеУсловия = "";
		ТекущийЭтап.УсловиеРассмотренияПредставление = "";
		ТекущийЭтап.СтатусНеНайден = Ложь;
		ТекущийЭтап.ЛюбаяЗадачаПредшественника = Ложь;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ГруппаОтстутствующиеСтатусы", "Видимость", ВНастройкеЕстьОтсутствующиеСтатусы(Этапы, ЭтапыПрерывание));
		
		Возврат;
	КонецЕсли;
	
	Если ТекущийЭтап.СписокВыбораРезультатовВыполнения.Количество() > 0 Тогда
		ТекущийЭтап.УсловиеРассмотрения = ТекущийЭтап.СписокВыбораРезультатовВыполнения[0].Значение.Статус;
	КонецЕсли;
	
	ТекущийЭтап.ОписаниеУсловия = "";
	
	Для Каждого ЭлементСпискаВыбора Из Элементы.УсловиеРассмотрения.СписокВыбора Цикл
		Если ЭлементСпискаВыбора.Значение.Статус = ТекущийЭтап.УсловиеРассмотрения
			И ЭлементСпискаВыбора.Значение.ЛюбаяЗадача = ТекущийЭтап.ЛюбаяЗадачаПредшественника Тогда
			ТекущийЭтап.УсловиеРассмотренияПредставление = ЭлементСпискаВыбора.Представление;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ОбъектЭтапы.ЗакончитьРедактированиеСтроки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектЭтапыПриАктивизацииСтроки(Элемент)
	
	ТекущийЭтап = Элементы.ОбъектЭтапы.ТекущиеДанные;
	Если ТекущийЭтап = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьДоступностьУсловияРассмотрения(ТекущийЭтап.СписокВыбораРезультатовВыполнения, Элементы.УсловиеРассмотрения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "УдалитьЭтап", "Доступность", НЕ ТекущийЭтап.НеУдалять);
	
	Если НЕ ТекущийЭтап.Использовать Тогда
		Элементы.УсловиеРассмотрения.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектЭтапыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущийЭтап = Элементы.ОбъектЭтапы.ТекущиеДанные;
	
	Если ТекущийЭтап.Использовать
		И ЗначениеЗаполнено(ИдентификаторДокумента)
		И Поле.Имя = "ОбъектЭтапыОписаниеУсловия" Тогда
		ПараметрыФормы = Новый Структура("ИдентификаторДокумента, НастройкиОтбора, ЗаголовокОкна, ВидНастройкиФункцийУсловий",
			ИдентификаторДокумента,
			ТекущийЭтап.УсловиеПерехода,
			НСтр("ru = 'Установка условия перехода'"),
			"НастройкиУсловийПерехода");
		ОткрытьФорму("ОбщаяФорма.НастройкаОтбора", ПараметрыФормы, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектЭтапыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ОбъектЭтапы.ТекущиеДанные;
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		ТекущаяСтрока.УсловиеПерехода = ВыбранноеЗначение.НастройкиОтбора;
		ТекущаяСтрока.ОписаниеУсловия = ВыбранноеЗначение.ПредставлениеОтбора;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловиеРассмотренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОбъектЭтапы.ТекущиеДанные;
	
	ТекущиеДанные.УсловиеРассмотрения = ВыбранноеЗначение.Статус;
	ТекущиеДанные.УсловиеРассмотренияПредставление = Строка(ТекущиеДанные.УсловиеРассмотрения);
	ТекущиеДанные.ЛюбаяЗадачаПредшественника = ВыбранноеЗначение.ЛюбаяЗадача;
	Для Каждого ЭлементСпискаВыбора Из Элементы.УсловиеРассмотрения.СписокВыбора Цикл
		Если ЭлементСпискаВыбора.Значение.Статус = ТекущиеДанные.УсловиеРассмотрения
			И ЭлементСпискаВыбора.Значение.ЛюбаяЗадача = ВыбранноеЗначение.ЛюбаяЗадача Тогда
			ТекущиеДанные.УсловиеРассмотренияПредставление = ЭлементСпискаВыбора.Представление;
			ТекущиеДанные.СтатусНеНайден = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ОбъектЭтапы.ЗакончитьРедактированиеСтроки(Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаОтстутствующиеСтатусы", "Видимость", ВНастройкеЕстьОтсутствующиеСтатусы(Этапы, ЭтапыПрерывание));
	
