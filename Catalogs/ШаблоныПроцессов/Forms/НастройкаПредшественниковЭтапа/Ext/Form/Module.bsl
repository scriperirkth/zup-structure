КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ОчиститьСообщения();
	
	// Для запуска по И не должно быть дублей инициирующих этапов
	Если ПорядокИспользования = "ВсеПредшественники" Тогда
		ИдентификаторЭтапаПредшественника = Неопределено;
		Для Каждого Этап Из Этапы Цикл
			Если НЕ Этап.Использовать Тогда
				Продолжить;
			КонецЕсли;
			Если ИдентификаторЭтапаПредшественника <> Этап.ИдентификаторЭтапа Тогда
				ИдентификаторЭтапаПредшественника = Этап.ИдентификаторЭтапа;
			Иначе
				ТекстСообщения = НСтр("ru = 'При старте этапа по И не должно быть дублей инициирующих этапов'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,"Этапы");
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Условия старта этапа не должны пересекаться
	
	СписокПредшественников = Новый СписокЗначений;
	Для Каждого Этап Из Этапы Цикл
		Если НЕ Этап.Использовать Тогда
			Продолжить;
		КонецЕсли;
		ДанныеПредшественника = Новый Структура;
		ДанныеПредшественника.Вставить("УсловиеПерехода", Этап.УсловиеПерехода);
		ДанныеПредшественника.Вставить("ОписаниеУсловия", Этап.ОписаниеУсловия);
		ДанныеПредшественника.Вставить("УсловиеРассмотрения", Этап.УсловиеРассмотрения);
		ДанныеПредшественника.Вставить("ИдентификаторПредшественника", Этап.ИдентификаторЭтапа);
		ДанныеПредшественника.Вставить("ЛюбаяЗадачаПредшественника", Этап.ЛюбаяЗадачаПредшественника);
		СписокПредшественников.Добавить(ДанныеПредшественника);
	КонецЦикла;
	
	Если СписокПредшественников.Количество() = 0
		И НЕ СтартовыйЭтап Тогда
		ТекстСообщения = НСтр("ru = 'Если этап не стартовый, необходимо отметить хотя бы одно действие'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,"Этапы");
		Возврат;
	КонецЕсли;
	
	СписокПредшественниковПрерывание = Новый СписокЗначений;
	Для Каждого Этап Из ЭтапыПрерывание Цикл
		Если НЕ Этап.Использовать Тогда
			Продолжить;
		КонецЕсли;
		ДанныеПредшественника = Новый Структура;
		ДанныеПредшественника.Вставить("УсловиеПерехода", Этап.УсловиеПерехода);
		ДанныеПредшественника.Вставить("ОписаниеУсловия", Этап.ОписаниеУсловия);
		ДанныеПредшественника.Вставить("УсловиеРассмотрения", Этап.УсловиеРассмотрения);
		ДанныеПредшественника.Вставить("ИдентификаторПредшественника", Этап.ИдентификаторЭтапа);
		ДанныеПредшественника.Вставить("ЛюбаяЗадачаПредшественника", Этап.ЛюбаяЗадачаПредшественника);
		СписокПредшественниковПрерывание.Добавить(ДанныеПредшественника);
	КонецЦикла;
	
	ДанныеВозврата = Новый Структура;
	Если СтартовыйЭтап Тогда
		ДанныеВозврата.Вставить("ПредшественникиВариантИспользования","Старт,"+ПорядокИспользования);
	Иначе
		ДанныеВозврата.Вставить("ПредшественникиВариантИспользования", ПорядокИспользования);
	КонецЕсли;
	
	ДанныеВозврата.Вставить("Предшественники", СписокПредшественников);
	ДанныеВозврата.Вставить("ПредшественникиПрерывание", СписокПредшественниковПрерывание);
	ДанныеВозврата.Вставить("ИдентификаторЭтапа", ИдентификаторЭтапа);
	ДанныеВозврата.Вставить("УдаленыНесуществующиеСтатусы", НЕ ВНастройкеЕстьОтсутствующиеСтатусы(Этапы, ЭтапыПрерывание));
	ДанныеВозврата.Вставить("ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске",
		ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске);
	ДанныеВозврата.Вставить("НеЗапрещатьОтменуВыполненияПриНаличииПрерванных",
		НеЗапрещатьОтменуВыполненияПриНаличииПрерванных);
	
	ДанныеВозврата.Вставить("ИмяНастройки", "НастройкаПорядкаВыполнения");
	
	ОповеститьОВыборе(ДанныеВозврата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьУсловияРассмотрения(СписокВыбораРезультатовВыполнения, ЭлементУсловиеРассмотрения)
	
	Если СписокВыбораРезультатовВыполнения.Количество() > 1 Тогда
		Если ЭлементУсловиеРассмотрения.ТолькоПросмотр Тогда
			ЭлементУсловиеРассмотрения.ТолькоПросмотр = Ложь;
		КонецЕсли;
	Иначе
		Если НЕ ЭлементУсловиеРассмотрения.ТолькоПросмотр Тогда
			ЭлементУсловиеРассмотрения.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ЭлементУсловиеРассмотрения.СписокВыбора.Очистить();
	Для Каждого ЭлементСпискаРезультатовВыполнения Из СписокВыбораРезультатовВыполнения Цикл
		ЭлементУсловиеРассмотрения.СписокВыбора.Добавить(ЭлементСпискаРезультатовВыполнения.Значение,
			ЭлементСпискаРезультатовВыполнения.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокУсловийРассмотрения(ШаблонЭтапа)
	
	СписокУсловий = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка КАК Ссылка,
	|	ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения КАК СтатусПослеВыполнения,
	|	ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения.Наименование КАК СтатусПослеВыполненияНаименование
	|ИЗ
	|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|ГДЕ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка = &Ссылка
	|	И НЕ ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = ЗНАЧЕНИЕ(Справочник.СтатусыДокументов.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Ссылка", ШаблонЭтапа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокУсловий.Добавить(Выборка.СтатусПослеВыполнения, Выборка.СтатусПослеВыполненияНаименование);
	КонецЦикла;
	
	Возврат СписокУсловий;
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокВыбораУсловийРассмотренияПоСпискуРезультатовВыполнения(СписокРезультатовВыполнения,
	ГрупповойЭтап = Ложь, РазрешеныВсеЗадачи = Истина)
	
	СписокВыбора = Новый СписокЗначений;
	
	Для Каждого ЭлементСпискаРезультатовВыполнения Из СписокРезультатовВыполнения Цикл
		Если РазрешеныВсеЗадачи Тогда
			СписокВыбора.Добавить(Новый Структура("Статус, ЛюбаяЗадача", ЭлементСпискаРезультатовВыполнения.Значение, Ложь),
				ЭлементСпискаРезультатовВыполнения.Представление + ?(ГрупповойЭтап, НСтр("ru = ' (все задачи)'"), ""));
		КонецЕсли;
		Если ГрупповойЭтап Тогда
			СписокВыбора.Добавить(Новый Структура("Статус, ЛюбаяЗадача", ЭлементСпискаРезультатовВыполнения.Значение, Истина),
				ЭлементСпискаРезультатовВыполнения.Представление + НСтр("ru = ' (любая задача)'"));
		КонецЕсли;
	КонецЦикла;
	
	Если РазрешеныВсеЗадачи Тогда
		СписокВыбора.Добавить(Новый Структура("Статус, ЛюбаяЗадача", ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка"), Ложь),
			НСтр("ru = 'Любой результат'") + ?(ГрупповойЭтап, НСтр("ru = ' (все задачи)'"), ""));
	КонецЕсли;
	Если ГрупповойЭтап Тогда
		СписокВыбора.Добавить(Новый Структура("Статус, ЛюбаяЗадача", ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка"), Истина),
			НСтр("ru = 'Любой результат'") + НСтр("ru = ' (любая задача)'"));
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВНастройкеЕстьОтсутствующиеСтатусы(Этапы, ЭтапыПрерывание)
	
	Для Каждого Этап Из Этапы Цикл
		Если Этап.СтатусНеНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Этап Из ЭтапыПрерывание Цикл
		Если Этап.СтатусНеНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
