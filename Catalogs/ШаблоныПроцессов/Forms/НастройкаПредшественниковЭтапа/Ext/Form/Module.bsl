	ДоступныеЭтапы = Новый Массив;
	Для Каждого Этап Из ЭтапыПрерывание Цикл
		ДоступныеЭтапы.Добавить(Этап.ИдентификаторЭтапа);
	КонецЦикла;
	
	ДоступныеЭтапы = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ДоступныеЭтапы);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", 				НСтр("ru = 'Выбор этапа'"));
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", 		Истина);
	ПараметрыФормы.Вставить("Шаблон", 					ВладелецЭтапа);
	ПараметрыФормы.Вставить("ИдентификаторЭтапа",		ТекущиеДанные.ИдентификаторЭтапа);
	ПараметрыФормы.Вставить("ОграничитьСпискокЭтапов", 	Истина);
	ПараметрыФормы.Вставить("ДоступныеЭтапы", 			ДоступныеЭтапы);
	
