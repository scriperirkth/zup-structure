&НаСервере
Процедура ЗаполнитьСписокСобытий()
	
	События.Очистить();
	
	ОписаниеСобытий = ПроцессыОбработкиДокументов.ОписаниеСобытийИнициирующихВыполнениеЭтапов();
	Для Каждого ОписаниеСобытия Из ОписаниеСобытий Цикл
		
		ИменаОбъектовМетаданных = СтрРазделить(ОписаниеСобытия.ОбъектыМетаданных, "," + Символы.ПС, Ложь);
		
		Если ИменаОбъектовМетаданных.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ИмяОбъектаМетаданных Из ИменаОбъектовМетаданных Цикл
			Если ИмяОбъектаМетаданных = ИмяИдентификатораДокумента Тогда
				События.Добавить(ОписаниеСобытия);
				Элементы.РезультатыВыполненияСобытияПредставлениеСобытия.СписокВыбора.Добавить(
					ОписаниеСобытия.Идентификатор, ОписаниеСобытия.Представление);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставленияЗаполненныхСобытий()
	
	Для Каждого ПараметрСобытие Из Параметры.События Цикл
		
		Если ПустаяСтрока(ПараметрСобытие.Событие) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура("Статус", ПараметрСобытие.Статус);
		НайденныеСтроки = РезультатыВыполнения.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			РезультатВыполнения = НайденныеСтроки[0];
		Иначе
			РезультатВыполнения = РезультатыВыполнения.Добавить();
			РезультатВыполнения.Статус = ПараметрСобытие.Статус;
			РезультатВыполнения.ПредставлениеРезультатаИСтатус = НСтр("ru = 'Отстуствует статус: '") + ПараметрСобытие.Статус;
			РезультатВыполнения.СтатусНеНайден = Истина;
		КонецЕсли;
		РезультатВыполнения.Событие = ПараметрСобытие.Событие;
		
		НайденоВТаблицеСобытий = Ложь;
		Для Каждого Событие Из События Цикл
			Если Событие.Значение.Идентификатор = ПараметрСобытие.Событие Тогда
				РезультатВыполнения.ПредставлениеСобытия = Событие.Значение.Представление;
				РезультатВыполнения.ОписаниеСобытия = Событие.Значение.Описание;
				НайденоВТаблицеСобытий = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ НайденоВТаблицеСобытий Тогда
			РезультатВыполнения.ПредставлениеСобытия = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не найдено инициирующее событие с ID ""%1""; '"), ПараметрСобытие.Событие);
			РезультатВыполнения.ОписаниеСобытия = "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьДублированиеИнициирующихСобытий()
	
	КэшСобытий = Новый Структура;
	Для Каждого РезультатВыполнения Из РезультатыВыполнения Цикл
		
		Если ПустаяСтрока(РезультатВыполнения.Событие) Тогда
			Продолжить;
		КонецЕсли;
		
		Если КэшСобытий.Свойство(РезультатВыполнения.Событие) Тогда
			Возврат Истина;
		Иначе
			КэшСобытий.Вставить(РезультатВыполнения.Событие);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ВНастройкеЕстьОтсутствующиеСтатусы()
	
	Для Каждого РезультатВыполнения Из РезультатыВыполнения Цикл
		Если РезультатВыполнения.СтатусНеНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

