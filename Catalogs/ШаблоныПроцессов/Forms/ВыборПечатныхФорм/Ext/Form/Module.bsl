
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	Иначе
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В программе отсутствует подсистема БСП ""Печать""'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Параметры.ИдентификаторДокумента;
	ИдентификаторыКомандПечатиСоШтампом = Параметры.ИдентификаторыКомандПечатиСоШтампом;
	
	ВсеФормы = ПустаяСтрока(ИдентификаторыКомандПечатиСоШтампом);
	
	ИдентификаторыКомандПечати = СтрРазделить(ИдентификаторыКомандПечатиСоШтампом, ",", Ложь);
	
	ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	
	ИсточникиКомандПечати = МодульУправлениеПечатью.ИсточникиКомандПечати();
	Если ИсточникиКомандПечати.Найти(ОбъектМетаданных) = Неопределено Тогда
		КомандыПечати = Новый Массив;
	Иначе
		КомандыПечати = МодульУправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
	КонецЕсли;
	
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		
		НоваяКоманда = ПечатныеФормы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяКоманда, КомандаПечати);
		
		ИндексКомандыПечати = ИдентификаторыКомандПечати.Найти(КомандаПечати.Идентификатор);
		
		Если ВсеФормы ИЛИ ИндексКомандыПечати <> Неопределено Тогда
			НоваяКоманда.Отметка = Истина;
		КонецЕсли;
		
		Если ИндексКомандыПечати <> Неопределено Тогда
			ИдентификаторыКомандПечати.Удалить(ИндексКомандыПечати);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаОтстутствующиеФормы", "Видимость", ИдентификаторыКомандПечати.Количество() > 0);
	
	// Оставшиеся в массиве команды не найдены в списке команд объекта
	Для Каждого ИдентификаторКомандПечати Из ИдентификаторыКомандПечати Цикл
		НоваяКоманда = ПечатныеФормы.Добавить();
		НоваяКоманда.Отметка = Истина;
		НоваяКоманда.Идентификатор = ИдентификаторКомандПечати;
		НоваяКоманда.Представление = ИдентификаторКомандПечати;
		НоваяКоманда.ФормаНеНайдена = Истина;
	КонецЦикла;
	
	УправлениеДоступностьюЭлементов();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВсеФормыПриИзменении(Элемент)
	
	Если ВсеФормы Тогда
		Для Каждого ПечатнаяФорма Из ПечатныеФормы Цикл
			ПечатнаяФорма.Отметка = Истина;
		КонецЦикла;
	КонецЕсли;
	
	УправлениеДоступностьюЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УдалитьОтсутствующиеФормы(Команда)
	
	КоличествоЭлементовКоллекции = ПечатныеФормы.Количество();
	Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
		Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
		ПолеЗапроса = ПечатныеФормы[Индекс];
		Если ПолеЗапроса.ФормаНеНайдена Тогда
			ПечатныеФормы.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаОтстутствующиеФормы", "Видимость", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ВыбранныеФормы = "";
	
	Если НЕ ВсеФормы Тогда
		ОтмеченныеФормы = Новый Массив;
		Для Каждого ПечатнаяФорма Из ПечатныеФормы Цикл
			Если НЕ ПечатнаяФорма.Отметка Тогда
				Продолжить;
			КонецЕсли;
			ОтмеченныеФормы.Добавить(ПечатнаяФорма.Идентификатор);
		КонецЦикла;
		Если ОтмеченныеФормы.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru = 'Необоходимо отметить хотя бы одну печатную форму'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		ВыбранныеФормы = СтрСоединить(ОтмеченныеФормы, ",");
	КонецЕсли;
	
	ДанныеВозврата = Новый Структура;
	ДанныеВозврата.Вставить("ИдентификаторыКомандПечатиСоШтампом", ВыбранныеФормы);
	
	ОповеститьОВыборе(ДанныеВозврата);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Для Каждого ПечатнаяФорма Из ПечатныеФормы Цикл
		ПечатнаяФорма.Отметка = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВсех(Команда)
	Для Каждого ПечатнаяФорма Из ПечатныеФормы Цикл
		ПечатнаяФорма.Отметка = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление() 
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВсеФормы");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПечатныеФормыПредставление");
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Кирпичный);
	
	ОтборГруппа = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ОтборГруппа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ОтборГруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВсеФормы");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = ОтборГруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПечатныеФормы.ФормаНеНайдена");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПечатныеФормыПредставление");
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВсеФормы");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПечатныеФормыОтметка");
	
КонецПроцедуры

Процедура УправлениеДоступностьюЭлементов()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтметитьВсе", "Доступность", НЕ ВсеФормы);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СнятьОтметкуВсех", "Доступность", НЕ ВсеФормы);
	
КонецПроцедуры

#КонецОбласти
