#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьСтартовыйЭтап = Ложь;
	БолееОдногоСтартовогоЭтапа = Ложь;
	Для Каждого Этап Из Этапы Цикл
		Если Лев(Этап.ПредшественникиВариантИспользования, 6) = "Старт," Тогда
			Если ЕстьСтартовыйЭтап Тогда
				БолееОдногоСтартовогоЭтапа = Истина;
			КонецЕсли;
			ЕстьСтартовыйЭтап = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьСтартовыйЭтап Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Один из этапов шаблона необходимо указать в качестве стартового.'"),,,, Отказ);
	КонецЕсли;
	Если БолееОдногоСтартовогоЭтапа Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Более одного этапа указано в качестве стартового.'"),,,, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Этап Из Этапы Цикл
		Если Этап.Порядок = 99 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Этап ""%1"" (номер строки %2) не связан с предыдущими.'"),
				Этап.Этап,
				Этап.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "Этапы["+(Этап.НомерСтроки-1)+"].Этап", , Отказ);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	// Проверка вхождения одного реквизита в зону ответственности двух и более этапов
	НесвязанныеЭтапы = Справочники.ШаблоныПроцессов.ВсеНесвязанныеЭтапыШаблона(ЭтотОбъект);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОтветственность.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ТаблицаОтветственность.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ТаблицаОтветственность.ИмяРеквизита КАК ИмяРеквизита
	|ПОМЕСТИТЬ ВТОтветственность
	|ИЗ
	|	&ТаблицаОтветственность КАК ТаблицаОтветственность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЭтапы.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ТаблицаЭтапы.Этап КАК Этап,
	|	ТаблицаЭтапы.НомерСтроки КАК НомерЭтапа
	|ПОМЕСТИТЬ ВТЭтапы
	|ИЗ
	|	&ТаблицаЭтапы КАК ТаблицаЭтапы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОтветственность.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ВТОтветственность.ИмяРеквизита КАК ИмяРеквизита
	|ПОМЕСТИТЬ ВТЗадвоеннаяОтветственность
	|ИЗ
	|	ВТОтветственность КАК ВТОтветственность
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТОтветственность.ИмяТабличнойЧасти,
	|	ВТОтветственность.ИмяРеквизита
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТОтветственность.ИдентификаторЭтапа) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЭтапы.НомерЭтапа КАК НомерЭтапа,
	|	ВТЭтапы.Этап КАК Этап,
	|	ВТЭтапы.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ВТОтветственность.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ВТОтветственность.ИмяРеквизита КАК ИмяРеквизита
	|ИЗ
	|	ВТОтветственность КАК ВТОтветственность
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗадвоеннаяОтветственность КАК ВТЗадвоеннаяОтветственность
	|		ПО ВТОтветственность.ИмяТабличнойЧасти = ВТЗадвоеннаяОтветственность.ИмяТабличнойЧасти
	|			И ВТОтветственность.ИмяРеквизита = ВТЗадвоеннаяОтветственность.ИмяРеквизита
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЭтапы КАК ВТЭтапы
	|		ПО ВТОтветственность.ИдентификаторЭтапа = ВТЭтапы.ИдентификаторЭтапа
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЭтапа
	|ИТОГИ ПО
	|	ИмяТабличнойЧасти,
	|	ИмяРеквизита";
	
	Запрос.УстановитьПараметр("ТаблицаОтветственность", ОтветственностьЗаРеквизиты);
	Запрос.УстановитьПараметр("ТаблицаЭтапы", Этапы);
	
	ВыборкаТЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТЧ.Следующий() Цикл
		ВыборкаРеквизит = ВыборкаТЧ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРеквизит.Следующий() Цикл
			
			КонкурирующиеЭтапы = Новый Массив;
			
			Выборка = ВыборкаРеквизит.Выбрать();
			Пока Выборка.Следующий() Цикл
				КонкурирующийЭтап = Новый Структура("НомерЭтапа, Этап, ИдентификаторЭтапа");
				ЗаполнитьЗначенияСвойств(КонкурирующийЭтап, Выборка);
				КонкурирующиеЭтапы.Добавить(КонкурирующийЭтап);
			КонецЦикла;
			
			ЭтапыДляОтображения = Новый Соответствие;
			Для к = 0 По КонкурирующиеЭтапы.ВГраница() Цикл
				Для л = к + 1 По КонкурирующиеЭтапы.ВГраница() Цикл
					// Если этапы с совпадением ответственности связаны по маршруту, то их необходимо отобразить + Отказ = Истина
					Если НесвязанныеЭтапы[КонкурирующиеЭтапы[к].ИдентификаторЭтапа].Получить(КонкурирующиеЭтапы[л].ИдентификаторЭтапа) = Неопределено Тогда
						ЭтапыДляОтображения.Вставить(КонкурирующиеЭтапы[к]);
						ЭтапыДляОтображения.Вставить(КонкурирующиеЭтапы[л]);
					КонецЕсли;
				КонецЦикла
			КонецЦикла;
			
			Если ЭтапыДляОтображения.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В шаблоне ""%1"" реквизит ""%2%3"" одновременно входит в зону ответственности нескольких связанных общим маршрутом этапов:'"),
				Ссылка,
				?(ВыборкаРеквизит.ИмяТабличнойЧасти = "", "", ВыборкаРеквизит.ИмяТабличнойЧасти + "."),
				ВыборкаРеквизит.ИмяРеквизита);
			
			Для Каждого ЭтапДляОтображения Из ЭтапыДляОтображения Цикл
				ТекстСообщения = ТекстСообщения + "
					|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '- этап ""%1. %2""'"),
					ЭтапДляОтображения.Ключ.НомерЭтапа,
					ЭтапДляОтображения.Ключ.Этап);
				КонецЦикла;
				
			ТекстСообщения = ТекстСообщения + "
				|" + НСтр("ru = 'Необходимо удалить один из этапов и добавить его заново.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
			
		КонецЦикла;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка существования статусов, используемых в порядке выполнения этапов
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка КАК Этап,
	|	ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения КАК Статус
	|ИЗ
	|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|ГДЕ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка В(&Ссылка)";
	Запрос.УстановитьПараметр("Ссылка", Этапы.ВыгрузитьКолонку("Этап"));
	
	СтатусыЭтапов = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтатусыЭтапа = СтатусыЭтапов.Получить(Выборка.Этап);
		Если СтатусыЭтапа = Неопределено Тогда
			СтатусыЭтапа = Новый Соответствие;
		КонецЕсли;
		СтатусыЭтапа.Вставить(Выборка.Статус, Истина);
		СтатусыЭтапов.Вставить(Выборка.Этап, СтатусыЭтапа);
	КонецЦикла;
	
	ИдентификаторыЭтапов = Новый Соответствие;
	Для Каждого Этап Из Этапы Цикл
		ИдентификаторыЭтапов.Вставить(Этап.ИдентификаторЭтапа, Этап.Этап);
	КонецЦикла;
	
	Для Каждого ПредшественникЭтапа Из ПредшественникиЭтапов Цикл
		Если НЕ ЗначениеЗаполнено(ПредшественникЭтапа.УсловиеРассмотрения) Тогда
			Продолжить;
		КонецЕсли;
		Этап = ИдентификаторыЭтапов[ПредшественникЭтапа.ИдентификаторПредшественника];
		Если Этап = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтатусыЭтапов[Этап].Получить(ПредшественникЭтапа.УсловиеРассмотрения) = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'В условиях старта или прерывания этапов используются статусы, отсутствующие в этих этапах процессов'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	// Проверка совпадения условий старта у группового этапа и его куратора
	Для Каждого Этап Из Этапы Цикл
		Если Не Этап.ЭтапВыполняетсяНесколькимиИсполнителями Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Этап.ИдентификаторЭтапаКуратора) Тогда
			Продолжить;
		КонецЕсли;
		ЭтапКуратора = Этапы.Найти(Этап.ИдентификаторЭтапаКуратора, "ИдентификаторЭтапа");
		Если ЭтапКуратора = Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для группового этапа ""%1"" не найден этап куратора'"),
				Этап.Этап);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Иначе
			ПредшественникиГрупповогоЭтапа = ПредшественникиЭтапов.Выгрузить(
				Новый Структура("ИдентификаторПоследователя", Этап.ИдентификаторЭтапа));
			ПредшественникиКуратора = ПредшественникиЭтапов.Выгрузить(
				Новый Структура("ИдентификаторПоследователя", ЭтапКуратора.ИдентификаторЭтапа));
				
			КоличествоЭлементовКоллекции = ПредшественникиГрупповогоЭтапа.Количество();
			Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
				Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
				ПредшественникГрупповогоЭтапа = ПредшественникиГрупповогоЭтапа[Индекс];
				Для Каждого ПредшественникКуратора Из ПредшественникиКуратора Цикл
					Если ПредшественникГрупповогоЭтапа.ИдентификаторПредшественника = ПредшественникКуратора.ИдентификаторПредшественника
						И ПредшественникГрупповогоЭтапа.УсловиеПерехода = ПредшественникКуратора.УсловиеПерехода
						И ПредшественникГрупповогоЭтапа.УсловиеРассмотрения = ПредшественникКуратора.УсловиеРассмотрения
						И ПредшественникГрупповогоЭтапа.ЛюбаяЗадачаПредшественника = ПредшественникКуратора.ЛюбаяЗадачаПредшественника Тогда
						ПредшественникиГрупповогоЭтапа.Удалить(Индекс);
						ПредшественникиКуратора.Удалить(ПредшественникКуратора);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
			Если ПредшественникиГрупповогоЭтапа.Количество() > 0
				ИЛИ ПредшественникиКуратора.Количество() > 0 Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'У группового этапа ""%1"" и его этапа куратора ""%2"" должны совпадать условия старта'"),
					Этап.Этап,
					ЭтапКуратора.Этап);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	// Для записываемого шаблона могут быть влияющие шаблоны, где могла нарушится связь с ним
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.Ссылка КАК Ссылка,
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.ИдентификаторЭтапаЗависимогоШаблона КАК ИдентификаторЭтапаЗависимогоШаблона,
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.УстанавливаемыйСтатус КАК УстанавливаемыйСтатус
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ВлияниеНаДругиеПроцессы КАК ШаблоныПроцессовВлияниеНаДругиеПроцессы
	|ГДЕ
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.ЗависимыйШаблон = &ЗависимыйШаблон";
	Запрос.УстановитьПараметр("ЗависимыйШаблон", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаЭтап = Этапы.Найти(Выборка.ИдентификаторЭтапаЗависимогоШаблона, "ИдентификаторЭтапа");
		Если СтрокаЭтап = Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В шаблоне ""%1"" нарушена настройка влияния на записываемый шаблон ""%2"".
				|Необходимо удалить настройку влияния и перезаполнить ее после записи текущего шаблона.'"),
				Выборка.Ссылка,
				Ссылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка,,, Отказ);
		Иначе
			// устанавливаемый статус может не входить в список допустимых статусов зависимого этапа
			ДоступныеЭтапы = СтрокаЭтап.Этап.РезультатыВыполнения.ВыгрузитьКолонку("СтатусПослеВыполнения");
			Если ДоступныеЭтапы.Найти(Выборка.УстанавливаемыйСтатус) = Неопределено Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В шаблоне ""%1"" нарушена настройка влияния на записываемый шаблон ""%2"".
					|В настройке указан некорректный устанавливаемый статус зависимого этапа.
					|Необходимо удалить настройку влияния и перезаполнить ее после записи текущего шаблона.'"),
					Выборка.Ссылка,
					Ссылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка,,, Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Проверка существования настройки подписи ссылочных данных для подписываемых реквизитов
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЭППриВыполненииЭтапов")
		ИЛИ ПолучитьФункциональнуюОпцию("ИспользоватьПростыеЭППриВыполненииЭтапов") Тогда
		
		ТипыДанных = Новый Соответствие;
		
		СтандартныеРеквизиты = Новый Массив;
		СтандартныеРеквизиты.Добавить("Номер");
		СтандартныеРеквизиты.Добавить("Дата");
		
		ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
		Для Каждого ОтмеченныйРеквизит Из ОтветственностьЗаРеквизиты Цикл
			Если ПустаяСтрока(ОтмеченныйРеквизит.ИмяРеквизита) Тогда
				Продолжить;
			ИначеЕсли ПустаяСтрока(ОтмеченныйРеквизит.ИмяТабличнойЧасти) Тогда
				Если СтандартныеРеквизиты.Найти(ОтмеченныйРеквизит.ИмяРеквизита) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ОбъектМетаданных.Реквизиты.Найти(ОтмеченныйРеквизит.ИмяРеквизита) = Неопределено Тогда
					// значит этот реквизит был добавлен в переопределяемом модуле - наличие настройки не проверяется.
					Продолжить;
				КонецЕсли;
				ОписаниеТиповРеквизита = ОбъектМетаданных.Реквизиты[ОтмеченныйРеквизит.ИмяРеквизита].Тип;
				ПолноеИмяРеквизита = ОтмеченныйРеквизит.ИмяРеквизита;
			Иначе
				Если ОбъектМетаданных.ТабличныеЧасти.Найти(ОтмеченныйРеквизит.ИмяТабличнойЧасти) = Неопределено Тогда
					// значит этот реквизит был добавлен в переопределяемом модуле - наличие настройки не проверяется.
					Продолжить;
				КонецЕсли;
				ОписаниеТиповРеквизита = ОбъектМетаданных.ТабличныеЧасти[ОтмеченныйРеквизит.ИмяТабличнойЧасти].Реквизиты[ОтмеченныйРеквизит.ИмяРеквизита].Тип;
				ПолноеИмяРеквизита = ОтмеченныйРеквизит.ИмяТабличнойЧасти+"."+ОтмеченныйРеквизит.ИмяРеквизита;
			КонецЕсли;
			Для Каждого Тип Из ОписаниеТиповРеквизита.Типы() Цикл
				
				Если НЕ Справочники.ТипВсеСсылки().СодержитТип(Тип)
					И НЕ ПланыСчетов.ТипВсеСсылки().СодержитТип(Тип) Тогда
					Продолжить;
				КонецЕсли;
				
				ТипДанных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип);
				ТипыДанных.Вставить(ТипДанных, ПолноеИмяРеквизита);
				
			КонецЦикла;
		КонецЦикла;
		
		ТипыДанныхДляЗапроса = Новый Массив;
		Для Каждого ТипДанных Из ТипыДанных Цикл
			ТипыДанныхДляЗапроса.Добавить(ТипДанных.Ключ);
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НастройкаПодписиСсылочныхДанных.ТипДанных КАК ТипДанных
		|ИЗ
		|	РегистрСведений.НастройкаПодписиСсылочныхДанных КАК НастройкаПодписиСсылочныхДанных
		|ГДЕ
		|	НастройкаПодписиСсылочныхДанных.ТипДанных В(&ТипДанных)";
		
		Запрос.УстановитьПараметр("ТипДанных", ТипыДанныхДляЗапроса);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		// вычеркиваем найденные типы данных, останутся те, у которых нет настройки
		Пока Выборка.Следующий() Цикл
			ТипыДанных.Удалить(Выборка.ТипДанных);
		КонецЦикла;
		
		Для Каждого ТипДанных Из ТипыДанных Цикл
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Реквизит ""%1"" включен в зону ответственности одного из исполнителей.
				|При этом для типа данных ""%2"" не задана настройка состава реквизитов для электронной подписи.'"),
				ТипДанных.Значение,
				ТипДанных.Ключ);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЦикла;
		
	КонецЕсли;
	
	// Проверка корректности подчиненных регламентных интервалов
	ИдентификаторыЭтапаШаблона = Этапы.ВыгрузитьКолонку("ИдентификаторЭтапа");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегламентныеИнтервалы.Ссылка КАК Ссылка,
	|	РегламентныеИнтервалы.Наименование КАК Наименование,
	|	РегламентныеИнтервалы.ИдентификаторНачальногоЭтапа КАК ИдентификаторНачальногоЭтапа,
	|	РегламентныеИнтервалы.ИдентификаторКонечногоЭтапа КАК ИдентификаторКонечногоЭтапа,
	|	РегламентныеИнтервалы.Этапы.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|		СрокВыполненияЧасы КАК СрокВыполненияЧасы
	|	) КАК Этапы,
	|	РегламентныеИнтервалы.ПредшественникиЭтапов.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИдентификаторПоследователя КАК ИдентификаторПоследователя,
	|		ИдентификаторПредшественника КАК ИдентификаторПредшественника
	|	) КАК ПредшественникиЭтапов
	|ИЗ
	|	Справочник.РегламентныеИнтервалы КАК РегламентныеИнтервалы
	|ГДЕ
	|	РегламентныеИнтервалы.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ИдентификаторыЭтапаШаблона.Найти(Выборка.ИдентификаторНачальногоЭтапа) = Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В шаблоне удален этап, который используется в регламентном интервале ""%1"" в качестве начального.'"),
				Выборка.Ссылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			Продолжить;
		КонецЕсли;
		
		Если ИдентификаторыЭтапаШаблона.Найти(Выборка.ИдентификаторКонечногоЭтапа) = Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В шаблоне удален этап, который используется в регламентном интервале ""%1"" в качестве конечного.'"),
				Выборка.Ссылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			Продолжить;
		КонецЕсли;
		
		Маршруты = ПроцессыОбработкиДокументов.МаршрутыШаблонаОтНачальногоЭтапаДоКонечного(
			ПредшественникиЭтапов, Выборка.ИдентификаторНачальногоЭтапа, Выборка.ИдентификаторКонечногоЭтапа);
		
		ПредшественникиНовые = ПроцессыОбработкиДокументов.ТаблицаПредшественниковПоМаршрутам(Маршруты);
		
		ПредшественникиСтарые = Выборка.ПредшественникиЭтапов.Выгрузить();
		
		// Таблицы предшественников должны быть идентичны
		Для Каждого ПредшественникНовый Из ПредшественникиНовые Цикл
			ПараметрыОтбора = Новый Структура("ИдентификаторПредшественника, ИдентификаторПоследователя",
				ПредшественникНовый.ИдентификаторПредшественника, ПредшественникНовый.ИдентификаторПоследователя);
			Если ПредшественникиСтарые.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В шаблоне изменен состав или порядок выполнения этапов так, что в регламентном интервале ""%1"" " + 
					"состав этапов или порядок этапов интервала стал отличаться от заполняемого автоматически.'"),
					Выборка.Ссылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ПредшественникСтарый Из ПредшественникиСтарые Цикл
			ПараметрыОтбора = Новый Структура("ИдентификаторПредшественника, ИдентификаторПоследователя",
				ПредшественникСтарый.ИдентификаторПредшественника, ПредшественникСтарый.ИдентификаторПоследователя);
			Если ПредшественникиНовые.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В шаблоне изменен состав или порядок выполнения этапов так, что в регламентном интервале ""%1"" " + 
					"состав этапов или порядок этапов интервала стал отличаться от заполняемого автоматически.'"),
					Выборка.Ссылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ЕстьНастройкиФормированияИПодписанияФормуляров = 
	ПроцессыОбработкиДокументов.ЕстьНастройкиФормированияИПодписанияФормуляровУЭтапов(ЭтотОбъект);
	ОшибкиФормуляровШаблона = ПроцессыОбработкиДокументов.ПроверитьНастройкиФормированияИПодписанияФормуляров(
								ЭтотОбъект, ЕстьНастройкиФормированияИПодписанияФормуляров);
	
	Если ЗначениеЗаполнено(Ссылка) И ОшибкиФормуляровШаблона.Количество() > 0 Тогда
		ТекстСообщения = СтрСоединить(ОшибкиФормуляровШаблона, Символы.ПС);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
	
	Если ОтветственностьПервичныеДокументы.Количество() > 0 Тогда
		
		ТипТаблицаЗначений = Новый ОписаниеТипов("ТаблицаЗначений");
		
		ФорматыПервичныхДокументов = Новый Структура;
		ПроцессыОбработкиДокументовПереопределяемый.ПриЗаполненииФорматовПервичныхДокументов(
			ФорматыПервичныхДокументов, ИдентификаторДокумента);
		
		ПервичныеДокументыВШаблоне = Новый Соответствие;
		Для Каждого Ответственность Из ОтветственностьПервичныеДокументы Цикл
			РеквизитыВключенныеВОтветственность = ПервичныеДокументыВШаблоне[Ответственность.ИдентификаторПечатнойФормы];
			Если РеквизитыВключенныеВОтветственность = Неопределено Тогда
				РеквизитыВключенныеВОтветственность = Новый Соответствие;
				ПервичныеДокументыВШаблоне.Вставить(Ответственность.ИдентификаторПечатнойФормы, РеквизитыВключенныеВОтветственность);
			КонецЕсли;
			РеквизитыВключенныеВОтветственность.Вставить(Ответственность.ИмяТабличнойЧасти+"."+Ответственность.ИмяРеквизита, Истина);
		КонецЦикла;
		
		Для Каждого ПервичныйДокумент Из ПервичныеДокументыВШаблоне Цикл
			
			ИдентификаторПечатнойФормы = ПервичныйДокумент.Ключ;
			
			РеквизитыВключенныеВОтветственность = ПервичныйДокумент.Значение;
			
			РеквизитыНеВключенныеВОтветственность = Новый Массив;
			
			Реквизиты = ФорматыПервичныхДокументов[ИдентификаторПечатнойФормы];
			
			Для Каждого Реквизит Из Реквизиты["Шапка"].Колонки Цикл
				Если Реквизит.ТипЗначения <> ТипТаблицаЗначений Тогда
					Если РеквизитыВключенныеВОтветственность["."+Реквизит.Имя] = Неопределено Тогда
						РеквизитыНеВключенныеВОтветственность.Добавить(Реквизит.Имя);
					КонецЕсли;
				Иначе
					Для Каждого СтрокаТЧ Из Реквизиты[Реквизит.Имя].Колонки Цикл
						Если РеквизитыВключенныеВОтветственность[Реквизит.Имя+"."+СтрокаТЧ.Имя] = Неопределено Тогда
							РеквизитыНеВключенныеВОтветственность.Добавить(Реквизит.Имя+"."+СтрокаТЧ.Имя);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
			Если РеквизитыНеВключенныеВОтветственность.Количество() > 0 Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В шаблоне есть реквизиты первичного документа ""%1"", " + 
						"не включенные в зону ответственности ни одного исполнителя:'"),
					ИдентификаторПечатнойФормы);
				Для Каждого Реквизит Из РеквизитыНеВключенныеВОтветственность Цикл
					ТекстСообщения = ТекстСообщения + Символы.ПС + Реквизит
				КонецЦикла;
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИдентификаторПоддержки = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";
	Если Справочники.ШаблоныПроцессов.ПроверитьУдалитьНесуществующиеРеквизиты(ЭтотОбъект, , ТекстСообщения) Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС +
			НСтр("ru = 'Для исправления требуется выполнить команду ""удалить"" в форме настройки ответственности'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НеИспользуется Тогда
		НаборЗаписей = РегистрыСведений.НастройкаИспользованияШаблонов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторДокумента.Установить(ИдентификаторДокумента); 
		НаборЗаписей.Отбор.Шаблон.Установить(Ссылка); 
		НаборЗаписей.Записать();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли