#Область ПрограммныйИнтерфейс

// Осуществляет проверку табличных частей шаблона на наличие реквизитов либо удаление из табличных частей шаблона реквизитов,
// которых нет в метаданных объекта, например, после удаления, переименования в конфигурации
//
// Параметры:
//	Шаблон - СправочникОбъект.ШаблоныПроцессов, ДанныеФормыСтруктура - проверяемый шаблон
//	Режим - Строка - может принимать одно из значений
//		"Проверка" - проверяет наличие несуществующих реквизитов и передает их перечень в параметр ТекстСообщения
//		"Удаление" - удаляет несуществующие реквизиты
//	ТекстСообщения - Строка - в параметр передается перечень ошибочных реквизитов, если проверка не пройдена
// 
// Возвращаемое значение:
//  Булево - Результат проверки реквизитов, если Истина, тогда в шаблоне есть несуществующие в метаданных реквизиты.
//		Имеет смысл только для режима "Проверка"
//
Функция ПроверитьУдалитьНесуществующиеРеквизиты(Шаблон, Режим = "Проверка", ТекстСообщения = "") Экспорт
	
	// не нужно проверять зоны ответственности, добавленные в переопределяемом модуле
	ДобавленныеЗоныОтветственности = Новый ДеревоЗначений;
	ДобавленныеЗоныОтветственности.Колонки.Добавить("ИмяТабличнойЧасти", ОбщегоНазначения.ОписаниеТипаСтрока(255));
	ДобавленныеЗоныОтветственности.Колонки.Добавить("ИмяРеквизита", ОбщегоНазначения.ОписаниеТипаСтрока(255));
	ДобавленныеЗоныОтветственности.Колонки.Добавить("Представление", ОбщегоНазначения.ОписаниеТипаСтрока(0));
	ДобавленныеЗоныОтветственности.Колонки.Добавить("НомерКартинки", ОбщегоНазначения.ОписаниеТипаЧисло(2));
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриЗаполненииДереваЗонОтветственности(ДобавленныеЗоныОтветственности, Шаблон.ИдентификаторДокумента);
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Шаблон.ИдентификаторДокумента);
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("ОтветственностьЗаРеквизиты");
	МассивТЧ.Добавить("ИзменениеРеквизитовЭтапов");
	МассивТЧ.Добавить("ОбязательныеРеквизиты");
	МассивТЧ.Добавить("НедоступныеРеквизиты");
	
	МассивЭлементовКУдалению = Новый Массив;
	
	Для Каждого ТЧ Из МассивТЧ Цикл
		Если Режим = "Удаление" Тогда
			МассивЭлементовКУдалению = Новый Массив;
		КонецЕсли;
		Для Каждого Элемент Из Шаблон[ТЧ] Цикл
			Отбор = Новый Структура("ИмяТабличнойЧасти, ИмяРеквизита", Элемент.ИмяТабличнойЧасти, Элемент.ИмяРеквизита);
			Если ДобавленныеЗоныОтветственности.Строки.НайтиСтроки(Отбор, Истина).Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(Элемент.ИмяТабличнойЧасти) Тогда
				Если НЕ ОбщегоНазначения.ЭтоСтандартныйРеквизит(МетаданныеДокумента.СтандартныеРеквизиты, Элемент.ИмяРеквизита)
					И НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта(Элемент.ИмяРеквизита, МетаданныеДокумента) Тогда
					Если Режим = "Удаление" Тогда
						МассивЭлементовКУдалению.Добавить(Элемент);
					Иначе
						МассивЭлементовКУдалению.Добавить(Элемент.ИмяРеквизита);
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ПустаяСтрока(Элемент.ИмяРеквизита) Тогда
				Если МетаданныеДокумента.ТабличныеЧасти.Найти(Элемент.ИмяТабличнойЧасти) = Неопределено Тогда
					Если Режим = "Удаление" Тогда
						МассивЭлементовКУдалению.Добавить(Элемент);
					Иначе
						МассивЭлементовКУдалению.Добавить(Элемент.ИмяТабличнойЧасти);
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если МетаданныеДокумента.ТабличныеЧасти.Найти(Элемент.ИмяТабличнойЧасти) = Неопределено
					ИЛИ НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта(Элемент.ИмяРеквизита, МетаданныеДокумента.ТабличныеЧасти[Элемент.ИмяТабличнойЧасти]) Тогда
					Если Режим = "Удаление" Тогда
						МассивЭлементовКУдалению.Добавить(Элемент);
					Иначе
						МассивЭлементовКУдалению.Добавить(Элемент.ИмяТабличнойЧасти+"."+Элемент.ИмяРеквизита);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Режим = "Удаление" Тогда
			Для Каждого ЭлементКУдалению Из МассивЭлементовКУдалению Цикл
				Шаблон[ТЧ].Удалить(ЭлементКУдалению);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивЭлементовКУдалению.Количество() > 0 И Режим = "Проверка" Тогда
		МассивЭлементовКУдалению = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЭлементовКУдалению);
		Для Каждого ЭлементКУдалению Из МассивЭлементовКУдалению Цикл
			Если ПустаяСтрока(ТекстСообщения) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В зоне ответственности этапов имеется отсутствующий в метаданных реквизит ""%1""'"),
					ЭлементКУдалению);
			Иначе
				ТекстСообщения = ТекстСообщения + Символы.ПС +
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'В зоне ответственности этапов имеется отсутствующий в метаданных реквизит ""%1""'"),
						ЭлементКУдалению);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивЭлементовКУдалению.Количество() > 0;
	
КонецФункции

// Осуществляет проверку табличной части "Этапы" шаблона на наличие недоступных печатных форм для 
// сценариев работы в ПОД
//
// Параметры:
//	Шаблон - СправочникОбъект.ШаблоныПроцессов, ДанныеФормыСтруктура - проверяемый шаблон
//	ТекстСообщения - Строка - в параметр передается перечень ошибочных реквизитов, если проверка не пройдена
// 
// Возвращаемое значение:
//  Булево - Результат проверки реквизитов, если Истина, тогда в шаблоне есть недоступные печатные формы, вкладка (ПервичныеДокументы)
Функция ПроверитьУдалитьНедоступныеПервичныеДокументы(Шаблон, Режим="Проверка", ТекстСообщения="") Экспорт
	
	ИдентификаторДокумента = Шаблон.ИдентификаторДокумента; 
	
	ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	КомандыПечати = УправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
	
	ЗначениеПустойСсылки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "ЗначениеПустойСсылки");
	
	ТаблицаКомандПечатиИсключений = ПроцессыОбработкиДокументов.ПодготовитьТаблицуИсключенийПервичныхДокументов();
	ПроцессыОбработкиДокументовПереопределяемый.ПриЗаполненииТаблицыИсключенийПервичныхДокументов(ТаблицаКомандПечатиИсключений);
	
	Если Режим = "Удаление" Тогда
		МассивЭлементовКУдалению = Новый Массив;
		ЕстьУдаленные = Ложь;
	КонецЕсли;
	
	Для Каждого Этап Из Шаблон["Этапы"] Цикл
		
		Если ЗначениеЗаполнено(Этап.ИдентификаторыКомандПечатиСоШтампом) Тогда 
			ИдентификаторыКомандПечатиСоШтампом = СтрРазделить(Этап.ИдентификаторыКомандПечатиСоШтампом, ",", Ложь);
			
			Для Каждого Идентификатор Из ИдентификаторыКомандПечатиСоШтампом Цикл
				СтруктураОтбора = Новый Структура;  
				СтруктураОтбора.Вставить("УчетныйДокумент", ЗначениеПустойСсылки);  
				СтруктураОтбора.Вставить("ИдентификаторКомандыПечати", Идентификатор);  
				
				КомандаПечатиИсключение = ТаблицаКомандПечатиИсключений.НайтиСтроки(СтруктураОтбора);
				
				Если КомандаПечатиИсключение.Количество() > 0 Тогда 
					
					НайденныеКоманды = КомандыПечати.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
					ВидПечатнойФормы = ?(НайденныеКоманды.Количество() > 0,
					                     НайденныеКоманды[0].Представление,
										 Идентификатор);
					
					НаименованиеЭтапа=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Этап.Этап, "Наименование");
					ТекстСообщения = ТекстСообщения + 
										СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
										НСтр("ru = 'Для этапа ""%1"" указан недопустимый первичный документ ""%2"". Необходимо отключить этот вид первичного документа для указанного этапа. %3'"),
											НаименованиеЭтапа, 
											ВидПечатнойФормы, 
											КомандаПечатиИсключение[0].ПричинаИсключенияКомандыПечати) + Символы.ПС;
					
					Если Режим = "Удаление" Тогда
						ИндексВМассиве = ИдентификаторыКомандПечатиСоШтампом.Найти(Идентификатор);
						МассивЭлементовКУдалению.Добавить(ИндексВМассиве);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если Режим = "Удаление" и МассивЭлементовКУдалению.Количество() > 0 Тогда
				
				ИндексПоследнего = МассивЭлементовКУдалению.ВГраница();  
				Для Индекс = -ИндексПоследнего По 0 Цикл  
						ИдентификаторыКомандПечатиСоШтампом.Удалить(МассивЭлементовКУдалению.Получить(-Индекс));  
				КонецЦикла;
				
				НовыеИдентификаторыКомандПечатиСоШтампом = СтрСоединить(ИдентификаторыКомандПечатиСоШтампом, ",");
				Этап.ИдентификаторыКомандПечатиСоШтампом = НовыеИдентификаторыКомандПечатиСоШтампом;
				
				ЕстьУдаленные = Истина;
				МассивЭлементовКУдалению.Очистить();
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Режим = "Удаление" и ЕстьУдаленные Тогда
		Возврат Истина;
	ИначеЕсли Режим = "Проверка" и ЗначениеЗаполнено(ТекстСообщения) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	

КонецФункции

// Осуществляет проверку табличных частей шаблона на наличие измененных при обновлении идентификаторов обработчиков.
// Поиск осуществляется по свойству обработчика "ДополнительныйИдентификаторПриОбновлении" либо определяется в модуле 
// ПроцессыОбработкиДокументовОбработчикиПереопределяемый.ПриОпределенииОбновляемыхИдентификаторовОбработчиков() 
//
// Параметры:
//	Шаблон - СправочникОбъект.ШаблоныПроцессов, ДанныеФормыСтруктура - проверяемый шаблон
//  ЗаменяемыеИдентификаторы - соответствие старых/новых идентификаторов дополнительных обработчиков
//	Режим - Строка - может принимать одно из значений
//		"Проверка" - проверяет наличие измененных идентификаторов и передает их перечень в параметр ТекстСообщения
//		"Замена"   - обновляет в шаблоне измененные идентификаторы на новые значения
//	ТекстСообщения - Строка - в параметр передается перечень измененных идентификаторов
// 
// Возвращаемое значение:
//  Булево - Результат проверки реквизитов, если Истина, тогда в шаблоне есть измененные идентификаторы шаблонов.
//		Имеет смысл только для режима "Проверка"
//
Функция ПроверитьЗаменитьИзмененныеИдентификаторыОбработчиков(Шаблон, ЗаменяемыеИдентификаторы, Режим = "Проверка", ТекстСообщения = "") Экспорт
	
	Результат = Ложь; 
	
	Если ЗаменяемыеИдентификаторы.Количество() > 0 Тогда
		ОбработчикиКПроверке = Новый Массив;
		
		// Дополнительные обработчики этапов шаблонов
		Для Каждого Обработчик Из Шаблон["ДополнительныеОбработчики"] Цикл
			
			ПроверитьЗаменитьИдентификаторОбработчика(ЗаменяемыеИдентификаторы, Обработчик["ОбработчикДоТранзакции"], Режим, ОбработчикиКПроверке);
			ПроверитьЗаменитьИдентификаторОбработчика(ЗаменяемыеИдентификаторы, Обработчик["Обработчик"], Режим, ОбработчикиКПроверке);
			ПроверитьЗаменитьИдентификаторОбработчика(ЗаменяемыеИдентификаторы, Обработчик["ОбработчикКлиентский"], Режим, ОбработчикиКПроверке);
			
		КонецЦикла; 
		
		// дополнительные функции определения исполнителя
		Для Каждого Обработчик Из Шаблон["Этапы"] Цикл
			Если ТипЗнч(Обработчик.Исполнитель) = Тип("Строка") И Обработчик.Исполнитель = "(функция)" Тогда 
				
				ПроверитьЗаменитьИдентификаторОбработчика(ЗаменяемыеИдентификаторы, Обработчик["ИмяРеквизитаОсновногоОбъектаАдресации"], Режим, ОбработчикиКПроверке);
				ПроверитьЗаменитьИдентификаторОбработчика(ЗаменяемыеИдентификаторы, Обработчик["ИмяРеквизитаДополнительногоОбъектаАдресации"], Режим, ОбработчикиКПроверке);
				
			КонецЕсли;
		КонецЦикла; 

		Если ОбработчикиКПроверке.Количество() > 0 Тогда
			Если  Режим = "Проверка" Тогда
				ТекстСообщения = СтрСоединить(ОбработчикиКПроверке, Символы.ПС);
				Результат = Истина;
			ИначеЕсли Режим = "Замена" Тогда
				Результат = Истина;
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;  
	
КонецФункции 

// Осуществляет проверку табличной части "УправлениеЭлементамиФормы" шаблона на наличие некорректных имен элементов 
// в форме учетного документа 
//
// Параметры:
//	ТаблицаНастроекСвойствЭлементов - ТаблицаЗначений - 
//                                   *ИдентификаторДокумента - Идентификатор объекта метаданных 
//	                                 *СписокДоступныхЭлементов- Строка - список всех доступных элементов формы
// Возвращает РезультатыПроверкиШаблонов -  ТаблицаЗначений - таблица ошибок в шаблонах с некорректными
//                                 настройками свойств элементов формы
Функция ПроверитьНастройкиУправленияСвойствамиЭлементовФормы(Знач ТаблицаНастроекСвойствЭлементов) Экспорт
	ОписаниеТиповБулево = Новый ОписаниеТипов("Булево");
	МассивСтрокОшибок = Новый Массив;
	МассивОшибокЭтапа = Новый Массив;
	
	РезультатыПроверкиШаблонов = Новый ТаблицаЗначений;
	РезультатыПроверкиШаблонов.Колонки.Добавить("ТекстОшибки",		 		Новый ОписаниеТипов("Строка"));
	РезультатыПроверкиШаблонов.Колонки.Добавить("Шаблон",			 		Новый ОписаниеТипов("СправочникСсылка.ШаблоныПроцессов"));
	РезультатыПроверкиШаблонов.Колонки.Добавить("Пометка",			 		ОписаниеТиповБулево);
	РезультатыПроверкиШаблонов.Колонки.Добавить("ПометкаУдаления",	 		ОписаниеТиповБулево);
	РезультатыПроверкиШаблонов.Колонки.Добавить("НеИспользуется",	 		ОписаниеТиповБулево);
	РезультатыПроверкиШаблонов.Колонки.Добавить("НастройкаСвойствЭлементов",ОписаниеТиповБулево);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессов.Ссылка КАК Шаблон,
	|	ШаблоныПроцессов.ПометкаУдаления КАК ПометкаУдаления,
	|	ШаблоныПроцессов.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ШаблоныПроцессов.НеИспользуется КАК НеИспользуется,
	|	ШаблоныПроцессовУправлениеЭлементамиФормы.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ШаблоныПроцессовУправлениеЭлементамиФормы.ИмяЭлемента КАК ИмяЭлемента,
	|	ШаблоныПроцессовЭтапы.Этап КАК Этап,
	|	Представление(ШаблоныПроцессовЭтапы.Этап) КАК ЭтапПредставление,
	|	ШаблоныПроцессов.Представление КАК ШаблонПредставление
	|ИЗ
	|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов КАК ШаблоныПроцессов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.УправлениеЭлементамиФормы КАК ШаблоныПроцессовУправлениеЭлементамиФормы
	|			ПО (ШаблоныПроцессовУправлениеЭлементамиФормы.Ссылка = ШаблоныПроцессов.Ссылка)
	|		ПО ШаблоныПроцессовЭтапы.Ссылка = ШаблоныПроцессов.Ссылка
	|			И (ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = ШаблоныПроцессовУправлениеЭлементамиФормы.ИдентификаторЭтапа)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ШаблонПредставление,
	|	ШаблоныПроцессовЭтапы.НомерСтроки
	|ИТОГИ ПО
	|	Шаблон,
	|	Этап";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	//выбрка по шаблону
	ВыборкаШаблон = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Шаблон");
	Пока ВыборкаШаблон.Следующий() Цикл
		
		МассивОшибокЭтапа.Очистить();
		ШаблонПометкаУдаления = ВыборкаШаблон.ПометкаУдаления;
		ШаблонНеИспользуется = ВыборкаШаблон.НеИспользуется;
		
		ПараметрыОтбора = Новый Структура("ИдентификаторДокумента", ВыборкаШаблон.ИдентификаторДокумента);
		НайденныеСтроки = ТаблицаНастроекСвойствЭлементов.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			МассивДоступныхЭлементов = СтрРазделить(НайденныеСтроки[0].СписокДоступныхЭлементов, ";");
						
			//выбрка по этапу
			ВыборкаЭтап = ВыборкаШаблон.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Этап");
			Пока ВыборкаЭтап.Следующий() Цикл 
			     
				 ЭтапПредставление = ВыборкаЭтап.ЭтапПредставление;
				 МассивСтрокОшибок.Очистить();
				 //выбрка элементов
				 ВыборкаДетальныеЗаписи = ВыборкаЭтап.Выбрать();
				 Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
					 
					 ИмяЭлемента = ВыборкаДетальныеЗаписи.ИмяЭлемента; 
					 
					 Если МассивДоступныхЭлементов.Найти(ИмяЭлемента) = Неопределено Тогда
						 МассивСтрокОшибок.Добавить(ИмяЭлемента);
					 КонецЕсли;
					 
				 КонецЦикла; 
				 
				 Если МассивСтрокОшибок.Количество() = 1 Тогда
					 
					 ТекстСообщенияСтрок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					 НСтр("ru = 'В настройках управления свойствами элементов формы на этапе ""%1"" " +
					 "присутствует несуществующий элемент формы ""%2"".'"), 
					 ЭтапПредставление, МассивСтрокОшибок[0]);
					 
					 МассивОшибокЭтапа.Добавить(ТекстСообщенияСтрок);
				 ИначеЕсли МассивСтрокОшибок.Количество() > 1 Тогда
					 ТекстСообщенияСтрок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					 НСтр("ru = 'В настройках управления свойствами элементов формы на этапе ""%1"" " +
					 "присутствуют несуществующиие элементы формы ""%2"".'"), 
					 ЭтапПредставление, СтрСоединить(МассивСтрокОшибок, ","));
					 
					 МассивОшибокЭтапа.Добавить(ТекстСообщенияСтрок);
					 
				 КонецЕсли;	
			 КонецЦикла; 
			 
			  Если МассивОшибокЭтапа.Количество() > 0 Тогда

			  		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					 НСтр("ru = '%1
					 |Необходимо перейти в шаблон процессов и пересохранить настройки управления "+
					 "свойствами элементов формы.'"), 
					 СтрСоединить(МассивОшибокЭтапа, Символы.ПС)); 
					 
			 
					 НоваяСтрока = РезультатыПроверкиШаблонов.Добавить();
					 НоваяСтрока.Шаблон = ВыборкаШаблон.Шаблон;
					 НоваяСтрока.ПометкаУдаления = ШаблонПометкаУдаления;
					 НоваяСтрока.НеИспользуется = ШаблонНеИспользуется;
					 НоваяСтрока.ТекстОшибки = ТекстСообщения;
					 //!!! добавить на форму ПроверкаКорректностиШаблонов
					 НоваяСтрока.НастройкаСвойствЭлементов = Истина;
					 НоваяСтрока.Пометка = Ложь;

			 КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;	

	Возврат РезультатыПроверкиШаблонов;
	
КонецФункции

// Переопределяет настройки печати для объекта.
//
// Параметры:
//  Настройки - см. УправлениеПечатью.НастройкиПечатиОбъекта.
//
Процедура ПриОпределенииНастроекПечати(Настройки) Экспорт
	Настройки.ПриДобавленииКомандПечати = Истина;
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Справочник.ШаблоныПроцессов";
	КомандаПечати.Идентификатор = "ПФ_MXL_НастройкиОтветственности";
	КомандаПечати.Представление = НСтр("ru = 'Настройки ответственности'");
	КомандаПечати.ЗаголовокФормы = НСтр("ru = 'Печать'");
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//                                            представление - имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Проверяем, нужно ли для макета формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_НастройкиОтветственности") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_НастройкиОтветственности",
			НСтр("ru = 'Настройки ответственности'"),
			ПечатьДоступностиРеквизитовПоЭтапамПроцесса(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры

// СтандартныеПодсистемы.ВерсионированиеОбъектов
// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
//  Настройки - Структура - настройки подсистемы.
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЭтапыНеИмеющиеОбщегоМаршрутаСЭтапом(Шаблон, ИдентификаторЭтапа) Экспорт
	
	Результат = Новый Соответствие;
	
	Для Каждого Этап Из Шаблон.Этапы Цикл
		
		Если Этап.ИдентификаторЭтапа = ИдентификаторЭтапа Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПроцессыОбработкиДокументов.МаршрутыШаблонаОтНачальногоЭтапаДоКонечного(
			Шаблон.ПредшественникиЭтапов, Этап.ИдентификаторЭтапа, ИдентификаторЭтапа).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПроцессыОбработкиДокументов.МаршрутыШаблонаОтНачальногоЭтапаДоКонечного(
			Шаблон.ПредшественникиЭтапов, ИдентификаторЭтапа, Этап.ИдентификаторЭтапа).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Вставить(Этап.ИдентификаторЭтапа, Истина);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВсеНесвязанныеЭтапыШаблона(Шаблон) Экспорт
	
	Результат = Новый Соответствие;
	
	Для Каждого Этап Из Шаблон.Этапы Цикл
		Результат.Вставить(Этап.ИдентификаторЭтапа, ЭтапыНеИмеющиеОбщегоМаршрутаСЭтапом(Шаблон, Этап.ИдентификаторЭтапа));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьДоступностиРеквизитовПоЭтапамПроцесса(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_НастройкиОтветственности";
	ТабличныйДокумент.ФиксацияСлева = 2;
	ТабличныйДокумент.ОтображатьГруппировки = Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.ШаблоныПроцессов.ПФ_MXL_НастройкиОтветственности");
	
	ОбластьЗаголовок 					= Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаРеквизит 				= Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаРеквизит");
	ОбластьШапкаЭтап 					= Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаЭтапИсполнитель");
	ОбластьСтрокаРеквизитШапкиРеквизит 	= Макет.ПолучитьОбласть("СтрокаРеквизитШапки|КолонкаРеквизит");
	ОбластьСтрокаРеквизитШапкиЭтап 		= Макет.ПолучитьОбласть("СтрокаРеквизитШапки|КолонкаЭтапИсполнитель");
	ОбластьСтрокаРеквизитТЧРеквизит		= Макет.ПолучитьОбласть("СтрокаРеквизитТЧ|КолонкаРеквизит");
	ОбластьСтрокаРеквизитТЧЭтап			= Макет.ПолучитьОбласть("СтрокаРеквизитТЧ|КолонкаЭтапИсполнитель");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессов.Ссылка КАК Ссылка,
	|	ШаблоныПроцессов.Наименование КАК Шаблон,
	|	ШаблоныПроцессов.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ШаблоныПроцессов.ИдентификаторДокумента.Синоним КАК ИмяДокумента,
	|	ШаблоныПроцессов.Этапы.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|		Этап КАК Этап,
	|		Исполнитель КАК Исполнитель,
	|		ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
	|		ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации,
	|		ИмяРеквизитаОсновногоОбъектаАдресации КАК ИмяРеквизитаОсновногоОбъектаАдресации,
	|		ИмяРеквизитаДополнительногоОбъектаАдресации КАК ИмяРеквизитаДополнительногоОбъектаАдресации
	|	) КАК Этапы,
	|	ШаблоныПроцессов.ИзменениеРеквизитовЭтапов.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|		ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|		ИмяРеквизита КАК ИмяРеквизита
	|	) КАК ИзменениеРеквизитовЭтапов,
	|	ШаблоныПроцессов.НедоступныеРеквизиты.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|		ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|		ИмяРеквизита КАК ИмяРеквизита
	|	) КАК НедоступныеРеквизиты,
	|	ШаблоныПроцессов.ОтветственностьЗаРеквизиты.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|		ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|		ИмяРеквизита КАК ИмяРеквизита
	|	) КАК ОтветственностьЗаРеквизиты,
	|	ШаблоныПроцессов.ОбязательныеРеквизиты.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|		ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|		ИмяРеквизита КАК ИмяРеквизита
	|	) КАК ОбязательныеРеквизиты
	|ИЗ
	|	Справочник.ШаблоныПроцессов КАК ШаблоныПроцессов
	|ГДЕ
	|	ШаблоныПроцессов.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЗаполнитьЗначенияСвойств(ОбластьЗаголовок.Параметры, Выборка);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		Дерево = Новый ДеревоЗначений;
		Дерево.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
		Дерево.Колонки.Добавить("ИмяТабличнойЧасти", Новый ОписаниеТипов("Строка"));
		Дерево.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
		Дерево.Колонки.Добавить("НомерКартинки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2,0)));
		
		ПроцессыОбработкиДокументов.ЗаполнитьДеревоРеквизитовПоИдентификатору(Дерево, Выборка.ИдентификаторДокумента);
		
		ПроцессыОбработкиДокументовПереопределяемый.ПриЗаполненииДереваЗонОтветственности(Дерево, Выборка.ИдентификаторДокумента);
		
		ВыборкаПоЭтапам = Выборка.Этапы.Выбрать();
		ТаблицаИзменение = Выборка.ИзменениеРеквизитовЭтапов.Выгрузить();
		ТаблицаИзменение.Индексы.Добавить("ИдентификаторЭтапа, ИмяТабличнойЧасти, ИмяРеквизита");
		ТаблицаНедоступность = Выборка.НедоступныеРеквизиты.Выгрузить();
		ТаблицаНедоступность.Индексы.Добавить("ИдентификаторЭтапа, ИмяТабличнойЧасти, ИмяРеквизита");
		ТаблицаОтветственность = Выборка.ОтветственностьЗаРеквизиты.Выгрузить();
		ТаблицаОтветственность.Индексы.Добавить("ИдентификаторЭтапа, ИмяТабличнойЧасти, ИмяРеквизита");
		ТаблицаОбязательность = Выборка.ОбязательныеРеквизиты.Выгрузить();
		ТаблицаОбязательность.Индексы.Добавить("ИдентификаторЭтапа, ИмяТабличнойЧасти, ИмяРеквизита");
		
		ТабличныйДокумент.Вывести(ОбластьШапкаРеквизит);
		
		Пока ВыборкаПоЭтапам.Следующий() Цикл
			ОбластьШапкаЭтап.Параметры.Этап = ВыборкаПоЭтапам.Этап;
			ОбластьШапкаЭтап.Параметры.Исполнитель = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(
				ВыборкаПоЭтапам.Исполнитель,
				ВыборкаПоЭтапам.ОсновнойОбъектАдресации,
				ВыборкаПоЭтапам.ДополнительныйОбъектАдресации,
				ВыборкаПоЭтапам.ИмяРеквизитаОсновногоОбъектаАдресации,
				ВыборкаПоЭтапам.ИмяРеквизитаДополнительногоОбъектаАдресации);
			ТабличныйДокумент.Присоединить(ОбластьШапкаЭтап);
		КонецЦикла;
		
		Для Каждого РеквизитПервогоУровня Из Дерево.Строки Цикл
			Если РеквизитПервогоУровня.ИмяТабличнойЧасти = "" И РеквизитПервогоУровня.ИмяРеквизита = "" Тогда
				ОбластьСтрокаРеквизитШапкиРеквизит.Параметры.Представление = РеквизитПервогоУровня.Представление;
				ТабличныйДокумент.Вывести(ОбластьСтрокаРеквизитШапкиРеквизит);
				ВыборкаПоЭтапам.Сбросить();
				Пока ВыборкаПоЭтапам.Следующий() Цикл
					ОбластьСтрокаРеквизитШапкиЭтап.Параметры.Ответственность = "";
					ОбластьСтрокаРеквизитШапкиЭтап.Параметры.Изменение = "";
					ОбластьСтрокаРеквизитШапкиЭтап.Параметры.Редактирование = "";
					ОбластьСтрокаРеквизитШапкиЭтап.Параметры.Обязательный = "";
					ТабличныйДокумент.Присоединить(ОбластьСтрокаРеквизитШапкиЭтап);
				КонецЦикла;
			ИначеЕсли РеквизитПервогоУровня.ИмяТабличнойЧасти <> "" ИЛИ РеквизитПервогоУровня.ИмяРеквизита <> "" Тогда
				ОбластьСтрокаРеквизитШапкиРеквизит.Параметры.Представление = РеквизитПервогоУровня.Представление;
				ТабличныйДокумент.Вывести(ОбластьСтрокаРеквизитШапкиРеквизит);
				ВыборкаПоЭтапам.Сбросить();
				Пока ВыборкаПоЭтапам.Следующий() Цикл
					
					Ответственность = "";
					Изменение = "";
					Редактирование = "";
					Обязательный = "";
					
					Отбор = Новый Структура("ИдентификаторЭтапа, ИмяТабличнойЧасти, ИмяРеквизита",
						ВыборкаПоЭтапам.ИдентификаторЭтапа,
						РеквизитПервогоУровня.ИмяТабличнойЧасти,
						РеквизитПервогоУровня.ИмяРеквизита);
						
					Если ТаблицаИзменение.НайтиСтроки(Отбор).Количество() > 0 Тогда
						Изменение = "V";
					ИначеЕсли ТаблицаНедоступность.НайтиСтроки(Отбор).Количество() > 0 Тогда
						
					Иначе
						Изменение = "V";
						Редактирование = "V";
					КонецЕсли;
					
					Если ТаблицаОбязательность.НайтиСтроки(Отбор).Количество() > 0 Тогда
						Обязательный = "V";
					КонецЕсли;
					
					Если ТаблицаОтветственность.НайтиСтроки(Отбор).Количество() > 0 Тогда
						Ответственность = "V";
					КонецЕсли;
					
					ОбластьСтрокаРеквизитШапкиЭтап.Параметры.Ответственность = Ответственность;
					ОбластьСтрокаРеквизитШапкиЭтап.Параметры.Изменение = Изменение;
					ОбластьСтрокаРеквизитШапкиЭтап.Параметры.Редактирование = Редактирование;
					ОбластьСтрокаРеквизитШапкиЭтап.Параметры.Обязательный = Обязательный;
					
					ТабличныйДокумент.Присоединить(ОбластьСтрокаРеквизитШапкиЭтап);
				КонецЦикла;
			КонецЕсли;
			ТабличныйДокумент.НачатьГруппуСтрок(РеквизитПервогоУровня.ИмяТабличнойЧасти, Истина);
			Для Каждого РеквизитВторогоУровня Из РеквизитПервогоУровня.Строки Цикл
				ОбластьСтрокаРеквизитТЧРеквизит.Параметры.Представление = РеквизитВторогоУровня.Представление;
				ТабличныйДокумент.Вывести(ОбластьСтрокаРеквизитТЧРеквизит);
				ВыборкаПоЭтапам.Сбросить();
				Пока ВыборкаПоЭтапам.Следующий() Цикл
					
					Ответственность = "";
					Изменение = "";
					Редактирование = "";
					Обязательный = "";
					
					Отбор = Новый Структура("ИдентификаторЭтапа, ИмяТабличнойЧасти, ИмяРеквизита",
						ВыборкаПоЭтапам.ИдентификаторЭтапа,
						РеквизитВторогоУровня.ИмяТабличнойЧасти,
						РеквизитВторогоУровня.ИмяРеквизита);
						
					Если ТаблицаИзменение.НайтиСтроки(Отбор).Количество() > 0 Тогда
						Изменение = "V";
					ИначеЕсли ТаблицаНедоступность.НайтиСтроки(Отбор).Количество() > 0 Тогда
						
					Иначе
						Изменение = "V";
						Редактирование = "V";
					КонецЕсли;
					
					Если ТаблицаОбязательность.НайтиСтроки(Отбор).Количество() > 0 Тогда
						Обязательный = "V";
					КонецЕсли;
					
					Если ТаблицаОтветственность.НайтиСтроки(Отбор).Количество() > 0 Тогда
						Ответственность = "V";
					КонецЕсли;
					
					ОбластьСтрокаРеквизитТЧЭтап.Параметры.Ответственность = Ответственность;
					ОбластьСтрокаРеквизитТЧЭтап.Параметры.Изменение = Изменение;
					ОбластьСтрокаРеквизитТЧЭтап.Параметры.Редактирование = Редактирование;
					ОбластьСтрокаРеквизитТЧЭтап.Параметры.Обязательный = Обязательный;
					
					ТабличныйДокумент.Присоединить(ОбластьСтрокаРеквизитТЧЭтап);
				КонецЦикла;
			КонецЦикла;
			ТабличныйДокумент.ЗакончитьГруппуСтрок();
		КонецЦикла;
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати комплектов документов.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ПроверитьЗаменитьИдентификаторОбработчика(Знач ЗаменяемыеИдентификаторы, ИдентификаторыОбработчиков, Знач Режим, ОбработчикиКПроверке)
	 
	Если Режим = "Замена" Тогда 
		ИзменятьОбработчик = Ложь;
	КонецЕсли;	 
	
	ИменаОбработчиков = СтрРазделить(ИдентификаторыОбработчиков, ";", Ложь);
	
	Для Каждого ИдентификаторОбработчика Из ИменаОбработчиков Цикл
		НовыйИдентификаторОбработчика = ЗаменяемыеИдентификаторы.Получить(ИдентификаторОбработчика);
		
		Если НовыйИдентификаторОбработчика <> Неопределено Тогда
			Если Режим = "Проверка" Тогда 
				
				ОбработчикиКПроверке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Присутствует обработчик ""%1"", требующий замены идентификатора в связи с обновлением на ""%2""'"),
						ИдентификаторОбработчика,
						НовыйИдентификаторОбработчика));				
			ИначеЕсли Режим = "Замена" Тогда 	
				
				ИзменятьОбработчик = Истина; 
				ОбработчикиКПроверке.Добавить(ИдентификаторОбработчика);
				Индекс = ИменаОбработчиков.Найти(ИдентификаторОбработчика); 
				ИменаОбработчиков.Установить(Индекс, НовыйИдентификаторОбработчика);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	Если Режим = "Замена" И ИзменятьОбработчик Тогда
		ИдентификаторыОбработчиков = СтрСоединить(ИменаОбработчиков,";"); 
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#КонецЕсли