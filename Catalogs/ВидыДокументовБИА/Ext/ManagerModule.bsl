Функция ИдентификаторСвязи(НаименованиеВидаДокументов) Экспорт
	Возврат СтрЗаменить(ТРег(НаименованиеВидаДокументов), " ", "");
КонецФункции

Функция ОписаниеНастроекПоУмолчанию()
	ОписаниеНастроек = Новый ТаблицаЗначений;
	ОписаниеНастроек.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ОписаниеНастроек.Колонки.Добавить("ИдентификаторПечатнойФормыПоУмолчанию", Новый ОписаниеТипов("Строка"));
	ОписаниеНастроек.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ОписаниеНастроек.Колонки.Добавить("ИдентификаторПечатнойФормы", Новый ОписаниеТипов("Строка"));
	ОписаниеНастроек.Колонки.Добавить("ИдентификаторОбъектаМетаданных", Новый ОписаниеТипов("СправочникСсылка.ИдентификаторыОбъектовМетаданных"));
	Возврат ОписаниеНастроек;
КонецФункции

Процедура ДобавитьОписаниеНастройки(ОписаниеНастроек, Наименование, ИдентификаторПечатнойФормыПоУмолчанию, Представление, ИдентификаторПечатнойФормы, ПолноеИмяИдентификатораОбъекта)
	ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмяИдентификатораОбъекта, Ложь);
	Если ЗначениеЗаполнено(ИдентификаторОбъектаМетаданных) Тогда
		НовоеОписаниеНастроек = ОписаниеНастроек.Добавить();
		НовоеОписаниеНастроек.Наименование = Наименование;
		НовоеОписаниеНастроек.Представление = Представление;
		НовоеОписаниеНастроек.ИдентификаторПечатнойФормы = ИдентификаторПечатнойФормы;
		НовоеОписаниеНастроек.ИдентификаторОбъектаМетаданных = ИдентификаторОбъектаМетаданных;
		НовоеОписаниеНастроек.ИдентификаторПечатнойФормыПоУмолчанию = ИдентификаторПечатнойФормыПоУмолчанию;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьНастройкиПоУмолчанию(ОписаниеНастроек)
	
	Для Каждого Настройка Из ОписаниеНастроек Цикл
		
		Если НайтиВидДокумента(Настройка.ИдентификаторПечатнойФормы, Настройка.ИдентификаторОбъектаМетаданных) = Неопределено Тогда
			
			ВидДокументаБИА = НайтиВидДокументаПоИдентификаторуПоУмолчанию(Настройка.ИдентификаторПечатнойФормыПоУмолчанию);
			Если ВидДокументаБИА = Неопределено Тогда
				ВидДокументаБИА = Справочники.ВидыДокументовБИА.СоздатьЭлемент();
				ЗаполнитьЗначенияСвойств(ВидДокументаБИА, Настройка, "Наименование, ИдентификаторПечатнойФормыПоУмолчанию");
				ВидДокументаБИА.ПометкаУдаления = Ложь;
				ВидДокументаБИА.ИдентификаторСвязи = Справочники.ВидыДокументовБИА.ИдентификаторСвязи(ВидДокументаБИА.Наименование);
			Иначе
				ВидДокументаБИА = ВидДокументаБИА.ПолучитьОбъект();
			КонецЕсли;
			НастройкаВидаДокументаБИА = ВидДокументаБИА.ПечатныеФормы.Добавить();
			ЗаполнитьЗначенияСвойств(НастройкаВидаДокументаБИА, Настройка, "Представление, ИдентификаторПечатнойФормы");
			НастройкаВидаДокументаБИА.ИдентификаторОбъектаМетаданных = Настройка.ИдентификаторОбъектаМетаданных;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ВидДокументаБИА);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиВидДокументаПоИдентификаторуПоУмолчанию(ИдентификаторПечатнойФормыПоУмолчанию)
	
	НайденныйВид = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторПечатнойФормыПоУмолчанию", ИдентификаторПечатнойФормыПоУмолчанию);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВидыДокументовБИА.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыДокументовБИА КАК ВидыДокументовБИА
	|ГДЕ
	|	НЕ ВидыДокументовБИА.ПометкаУдаления
	|	И ВидыДокументовБИА.ИдентификаторПечатнойФормыПоУмолчанию = &ИдентификаторПечатнойФормыПоУмолчанию";
	ВидыДокументовБИА = Запрос.Выполнить().Выбрать();
	Если ВидыДокументовБИА.Количество() > 0 Тогда
		ВидыДокументовБИА.Следующий();
		НайденныйВид = ВидыДокументовБИА.Ссылка;
	КонецЕсли;
	
	Возврат НайденныйВид;
	
КонецФункции


