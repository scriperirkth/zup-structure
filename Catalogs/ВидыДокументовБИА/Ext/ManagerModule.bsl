#Область ПрограммныйИнтерфейс

// Возвращает вид документа, соответствующий переданным значениям реквизитов.
//
// Параметры:
//  ИдентификаторПечатнойФормы - Строка - идентификатор печатной формы, как он задан в командах печати.
//  ИдентификаторОбъектаМетаданных - Справочник.ДополнительныеОтчетыИОбработки, Справочник.ИдентификаторыОбъектовМетаданных.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыДокументовБИА, Неопределено - найденный элемент.
//
Функция НайтиВидДокумента(ИдентификаторПечатнойФормы, ИдентификаторОбъектаМетаданных) Экспорт 
	
	НайденныйВид = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторОбъектаМетаданных", ИдентификаторОбъектаМетаданных);
	Запрос.УстановитьПараметр("ИдентификаторПечатнойФормы", ИдентификаторПечатнойФормы);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВидыДокументовБИАПечатныеФормы.Ссылка КАК ВидДокументаБИА,
	|	ВидыДокументовБИАПечатныеФормы.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы
	|ИЗ
	|	Справочник.ВидыДокументовБИА.ПечатныеФормы КАК ВидыДокументовБИАПечатныеФормы
	|ГДЕ
	|	(ВидыДокументовБИАПечатныеФормы.ИдентификаторОбъектаМетаданных = &ИдентификаторОбъектаМетаданных
	|			И ВидыДокументовБИАПечатныеФормы.ИдентификаторПечатнойФормы = &ИдентификаторПечатнойФормы)
	|	И НЕ ВидыДокументовБИАПечатныеФормы.Ссылка.ПометкаУдаления";
	ВидыДокументовБИА = Запрос.Выполнить().Выбрать();
	Если ВидыДокументовБИА.Количество() > 0 Тогда
		ВидыДокументовБИА.Следующий();
		НайденныйВид = ВидыДокументовБИА.ВидДокументаБИА;
	КонецЕсли;
	
	Возврат НайденныйВид;
	
КонецФункции

