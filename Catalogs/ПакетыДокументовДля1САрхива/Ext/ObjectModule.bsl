
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПакетыТабЧасть.Документ КАК ДокументВЭтомПакете,
		|	ПакетыТабЧасть.Документ КАК ДокументВДругомПакете,
		|	ПакетыТабЧасть.Ссылка КАК Пакет
		|ИЗ
		|	Справочник.ПакетыДокументовДля1САрхива.Документы КАК ПакетыТабЧасть
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПакетыДокументовДля1САрхива КАК Пакеты
		|		ПО ПакетыТабЧасть.Ссылка = Пакеты.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДокументыБИА КАК ДокументыБИА
		|		ПО ПакетыТабЧасть.Документ = ДокументыБИА.Ссылка
		|ГДЕ
		|	ПакетыТабЧасть.Документ В(&ДокументыПакета)
		|	И ПакетыТабЧасть.Ссылка <> &Ссылка
		|	И НЕ Пакеты.ПометкаУдаления
		|	И НЕ ДокументыБИА.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДокументыЭтогоПакета.Ссылка,
		|	ДокументыДругогоПакета.Ссылка,
		|	ПакетыТабЧасть.Ссылка
		|ИЗ
		|	Справочник.ДокументыБИА КАК ДокументыЭтогоПакета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДокументыБИА КАК ДокументыДругогоПакета
		|		ПО ДокументыЭтогоПакета.ОбъектОснование = ДокументыДругогоПакета.ОбъектОснование
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПакетыДокументовДля1САрхива.Документы КАК ПакетыТабЧасть
		|		ПО ДокументыДругогоПакета.Ссылка = ПакетыТабЧасть.Документ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПакетыДокументовДля1САрхива КАК Пакеты
		|		ПО ПакетыТабЧасть.Ссылка = Пакеты.Ссылка
		|ГДЕ
		|	ДокументыЭтогоПакета.Ссылка В(&ДокументыПакета)
		|	И НЕ ДокументыДругогоПакета.Ссылка В (&ДокументыПакета)
		|	И ПакетыТабЧасть.Ссылка <> &Ссылка
		|	И НЕ Пакеты.ПометкаУдаления
		|	И НЕ ДокументыЭтогоПакета.ПометкаУдаления
		|	И НЕ ДокументыДругогоПакета.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДокументыПакета", Документы.ВыгрузитьКолонку("Документ"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		Отказ = Истина
	КонецЕсли;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ДокументВЭтомПакете = Выборка.ДокументВДругомПакете Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Документ %1 уже добавлен в %2'"),
				Выборка.ДокументВЭтомПакете, Выборка.Пакет));
		Иначе
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Документ %1 не может быть помещен в этот пакет, т.к. документ %2,
						|созданный на основании того же объекта, добавлен в %3'"),
				Выборка.ДокументВЭтомПакете, Выборка.ДокументВДругомПакете, Выборка.Пакет));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ДатаСоздания = ТекущаяДатаСеанса();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитовДоИзменения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Ссылка, "СтатусОбменаСАрхивом, ПометкаУдаления");
	ДополнительныеСвойства.Вставить("ЗначенияРеквизитовДоИзменения", ЗначенияРеквизитовДоИзменения);
	
	Если (Не ДополнительныеСвойства.Свойство("ПропуститьПроверкуСтатусаПриЗаписи")
				Или ДополнительныеСвойства.ПропуститьПроверкуСтатусаПриЗаписи <> Истина)
			И ЗначениеЗаполнено(ЗначенияРеквизитовДоИзменения.СтатусОбменаСАрхивом)
			И Не ОбменСАрхивом.ДоступноРедактированиеПоСтатусу(
				ЗначенияРеквизитовДоИзменения.СтатусОбменаСАрхивом, Истина) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Запрещено изменение пакета в статусе ""%1""'"),
			ЗначенияРеквизитовДоИзменения.СтатусОбменаСАрхивом);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		Если Не ЗначениеЗаполнено(ДатаСоздания) Тогда
			ДатаСоздания = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Создал) Тогда
			Создал = ОбменСАрхивом.ФизЛицоТекущегоПользователя();
		КонецЕсли;
	КонецЕсли;
	
	Если СтатусОбменаСАрхивом = Перечисления.СтатусыОбменаС1САрхивом.ГотовКВыгрузке Тогда
		ДатаПередачи = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитовДоИзменения = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("ЗначенияРеквизитовДоИзменения", ЗначенияРеквизитовДоИзменения) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЭтоНовый = ЗначенияРеквизитовДоИзменения.ПометкаУдаления = Неопределено;
	ИзмененаПометка = Не ЭтоНовый И ПометкаУдаления <> ЗначенияРеквизитовДоИзменения.ПометкаУдаления;
	ИзмененСтатус = Не ЭтоНовый И ЗначенияРеквизитовДоИзменения.СтатусОбменаСАрхивом <> СтатусОбменаСАрхивом;
	Если Не ПометкаУдаления И (ЭтоНовый Или ИзмененСтатус Или ИзмененаПометка) Тогда
		ТекущаяДатаСеанса = ТекущаяДатаСеанса();
		Событие = ОбменСАрхивом.СобытиеДляЛога();
		Событие.ОсновнойОбъект = Ссылка;
		Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
		Если ЭтоНовый Тогда
			Событие.КраткоеОписание = НСтр("ru = 'Пакет создан'");
		ИначеЕсли ИзмененаПометка Тогда
			Событие.КраткоеОписание = НСтр("ru = 'Снята пометка удаления'");
		ИначеЕсли ИзмененСтатус Тогда
			Событие.КраткоеОписание = СтрШаблон(НСтр("ru = 'Статус обмена изменен с ""%1"" на ""%2""'"),
				ЗначенияРеквизитовДоИзменения.СтатусОбменаСАрхивом, СтатусОбменаСАрхивом);
		КонецЕсли;
		ОбменСАрхивом.ЗаписатьВЛог(Событие);
		СтатусыДокументовНабор = РегистрыСведений.СтатусыОбменаДокументовБИА.СоздатьНаборЗаписей();
		СтатусыДокументовНабор.Отбор.ПакетДокументов.Установить(Ссылка);
		Для Каждого Стр Из Документы Цикл
			СтатусЗапись = СтатусыДокументовНабор.Добавить();
			СтатусЗапись.ДокументБИА = Стр.Документ;
			СтатусЗапись.ПакетДокументов = Ссылка;
			СтатусЗапись.Статус = СтатусОбменаСАрхивом;
			СтатусЗапись.Дата = ТекущаяДатаСеанса;
		КонецЦикла;
		СтатусыДокументовНабор.Записать();
		Если СтатусОбменаСАрхивом = Перечисления.СтатусыОбменаС1САрхивом.ПринятВАрхив Тогда
			ОбъектыДляОбработки = ОбъектыОснованияПринятыеВАрхив();
			ОбменСАрхивом.УдалитьДанныеДокументовПринятыхВАрхив(ОбъектыДляОбработки);
		КонецЕсли;
	ИначеЕсли ПометкаУдаления И ИзмененаПометка Тогда
		Событие = ОбменСАрхивом.СобытиеДляЛога();
		Событие.ОсновнойОбъект = Ссылка;
		Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
		Событие.КраткоеОписание = НСтр("ru = 'Пакет помечен на удаление'");
		ОбменСАрхивом.ЗаписатьВЛог(Событие);
		СтатусыДокументовНабор = РегистрыСведений.СтатусыОбменаДокументовБИА.СоздатьНаборЗаписей();
		СтатусыДокументовНабор.Отбор.ПакетДокументов.Установить(Ссылка);
		СтатусыДокументовНабор.Записать();
		ОбменСАрхивом.ОтменитьУдалениеДанныхДокументовПринятыхВАрхив(ОбъектыДляОбработки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбъектыОснованияПринятыеВАрхив() 
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДокументыБИА.ОбъектОснование КАК ОбъектОснование
		|ПОМЕСТИТЬ ОбъектыВПакетах
		|ИЗ
		|	Справочник.ПакетыДокументовДля1САрхива.Документы КАК ПакетыДокументовДля1САрхиваДокументы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДокументыБИА КАК ДокументыБИА
		|		ПО ПакетыДокументовДля1САрхиваДокументы.Документ = ДокументыБИА.Ссылка
		|ГДЕ
		|	ДокументыБИА.ПометкаУдаления = ЛОЖЬ
		|	И ПакетыДокументовДля1САрхиваДокументы.Документ.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыБИА.Ссылка) КАК Количество,
		|	ДокументыБИА.ОбъектОснование КАК ОбъектОснование
		|ПОМЕСТИТЬ КоличествоВсехДокументовБИА
		|ИЗ
		|	Справочник.ДокументыБИА КАК ДокументыБИА
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбъектыВПакетах КАК ОбъектыВПакетах
		|		ПО ДокументыБИА.ОбъектОснование = ОбъектыВПакетах.ОбъектОснование
		|			И (ДокументыБИА.ПометкаУдаления = ЛОЖЬ)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументыБИА.ОбъектОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыБИАВСтатусе.Ссылка) КАК Количество,
		|	ДокументыБИАВСтатусе.ОбъектОснование КАК ОбъектОснование
		|ПОМЕСТИТЬ КоличествоДокументовБИАВСтатусе
		|ИЗ
		|	Справочник.ДокументыБИА КАК ДокументыБИАВСтатусе
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбъектыВПакетах КАК ОбъектыВПакетах
		|		ПО ДокументыБИАВСтатусе.ОбъектОснование = ОбъектыВПакетах.ОбъектОснование
		|			И (ДокументыБИАВСтатусе.ПометкаУдаления = ЛОЖЬ)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыОбменаДокументовБИА КАК СтатусыОбменаДокументовБИА
		|		ПО (СтатусыОбменаДокументовБИА.ДокументБИА = ДокументыБИАВСтатусе.Ссылка)
		|			И (СтатусыОбменаДокументовБИА.Статус = &Статус)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументыБИАВСтатусе.ОбъектОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КоличествоВсехДокументовБИА.ОбъектОснование КАК ОбъектОснование
		|ИЗ
		|	КоличествоВсехДокументовБИА КАК КоличествоВсехДокументовБИА
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КоличествоДокументовБИАВСтатусе КАК КоличествоДокументовБИАВСтатусе
		|		ПО (КоличествоДокументовБИАВСтатусе.ОбъектОснование = КоличествоВсехДокументовБИА.ОбъектОснование)
		|			И (КоличествоДокументовБИАВСтатусе.Количество = КоличествоВсехДокументовБИА.Количество)";
	
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыОбменаС1САрхивом.ПринятВАрхив);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции	

#КонецОбласти

#КонецЕсли
