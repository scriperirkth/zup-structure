
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ПравоДоступа("Редактирование", Метаданные.Справочники.КадровыйРезерв) Тогда
		Доступность = Ложь;
	КонецЕсли;
	ЗаполнитьДанныеФормы(Параметры);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = ЭтотОбъект И ИмяСобытия = "ИзмененыПодразделения" Тогда
		ЗагрузитьПодразделения(Параметр.Должность, Параметр.Подразделения);
		УстановитьПредставленияПодразделений();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДолжности

&НаКлиенте
Процедура ДолжностиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОбработатьВыборДолжностей(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ДолжностиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ДолжностиПодразделенияСтрокой Тогда
		ПараметрыФормы = Новый Структура("Должность, Подразделения",
			ТекущиеДанные.Должность,
			ТекущиеДанные.Подразделения.ВыгрузитьЗначения());
		ОткрытьФорму("ОбщаяФорма.ЗаполнениеПодразделенийКлючевыхДолжностей",
			ПараметрыФормы, ЭтотОбъект, Новый УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДолжностиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	НачатьПодборДолжностей();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подбор(Команда)
	
	НачатьПодборДолжностей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Если Модифицированность Тогда
		СтруктураПараметраОповещения = Новый Структура;
		СтруктураПараметраОповещения.Вставить("Должности", АдресДолжностей());
		Оповестить("ИзмененыДолжности", СтруктураПараметраОповещения, ВладелецФормы);
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДанныеФормы(Параметры)

	Если НЕ Параметры.Свойство("ТаблицаДолжностей") Тогда
		Возврат;
	КонецЕсли;
	
	Должности.Загрузить(ПолучитьИзВременногоХранилища(Параметры.ТаблицаДолжностей));
	
	ПодразделенияДолжностей = Параметры.Подразделения;
	Для Каждого Строка Из ПодразделенияДолжностей Цикл
		НайденныеСтроки = Должности.НайтиСтроки(Новый Структура("Должность", Строка.Должность));
		Если НайденныеСтроки.Количество() = 1 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
			НайденнаяСтрока.Подразделения.Добавить(Строка.Подразделение);
		КонецЕсли;
	КонецЦикла;
	УстановитьПредставленияПодразделений();
	
КонецПроцедуры

&НаСервере
Функция АдресДолжностей()
	
	Возврат ПоместитьВоВременноеХранилище(Должности.Выгрузить(), Новый УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция АдресПодобранныхДолжностей()
	Возврат ПоместитьВоВременноеХранилище(Должности.Выгрузить().ВыгрузитьКолонку("Должность"));
КонецФункции

&НаКлиенте
Процедура НачатьПодборДолжностей()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("АдресСпискаПодобранных", АдресПодобранныхДолжностей());
	ОткрытьФорму("Справочник.Должности.ФормаСписка", ПараметрыФормы, Элементы.Должности,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборДолжностей(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Для Каждого Значение Из ВыбранноеЗначение Цикл
		НоваяСтрока = Должности.Добавить();
		НоваяСтрока.Должность = Значение;
		НоваяСтрока.ПодразделенияСтрокой = НСтр("ru = 'Все подразделения'");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПодразделения(Должность, Подразделения)
	
	НайденныеСтроки = Должности.НайтиСтроки(Новый Структура("Должность", Должность));
	Если НайденныеСтроки.Количество() = 1 Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
		Если Подразделения.Количество() = 0 Тогда
			НайденнаяСтрока.Подразделения.Очистить();
		Иначе
			НайденнаяСтрока.Подразделения.ЗагрузитьЗначения(Подразделения);
		КонецЕсли;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставленияПодразделений()
	
	Для Каждого Строка Из Должности Цикл
		КоличествоПодразделений = Строка.Подразделения.Количество();
		Если КоличествоПодразделений = 0 Тогда
			Строка.ПодразделенияСтрокой = НСтр("ru = 'Все подразделения'");
		ИначеЕсли КоличествоПодразделений >= 5 Тогда
			Строка.ПодразделенияСтрокой = СтрШаблон(НСтр("ru = '%1 подразделений'"), КоличествоПодразделений);
		Иначе
			ПодразделенияТекст = "";
			Для Каждого Подразделение Из Строка.Подразделения Цикл
				Если ПодразделенияТекст = "" Тогда
					ПодразделенияТекст = Строка(Подразделение);
				Иначе
					ПодразделенияТекст = СтрШаблон("%1, %2", 
						ПодразделенияТекст,
						Подразделение);
				КонецЕсли;
			КонецЦикла;
			Строка.ПодразделенияСтрокой = ПодразделенияТекст;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти