&НаСервере
Процедура ЗаполнитьХарактеристикиСотрудникаНаСервере()
	
	Запрос = Новый Запрос;
	Если Объект.Назначение = Перечисления.НазначенияКадровогоРезерва.ГруппаКадровогоРезерва
		И ЗначениеЗаполнено(Объект.ПрофильДолжности) Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПрофилиДолжностейХарактеристикиПерсонала.Характеристика,
			|	ПрофилиДолжностейХарактеристикиПерсонала.Значение,
			|	ПрофилиДолжностейХарактеристикиПерсонала.Вес,
			|	ПрофилиДолжностейХарактеристикиПерсонала.ТребуетсяПроверка,
			|	ПрофилиДолжностейХарактеристикиПерсонала.ТребуетсяОбучение,
			|	ПрофилиДолжностейХарактеристикиПерсонала.ВесЗначения
			|ИЗ
			|	Справочник.ПрофилиДолжностей.ХарактеристикиПерсонала КАК ПрофилиДолжностейХарактеристикиПерсонала
			|ГДЕ
			|	ПрофилиДолжностейХарактеристикиПерсонала.Ссылка = &ПрофильДолжности";
		Запрос.УстановитьПараметр("ПрофильДолжности", Объект.ПрофильДолжности);
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПрофилиДолжностейХарактеристикиПерсонала.Характеристика,
			|	ПрофилиДолжностейХарактеристикиПерсонала.Значение,
			|	ПрофилиДолжностейХарактеристикиПерсонала.Вес,
			|	ПрофилиДолжностейХарактеристикиПерсонала.ТребуетсяПроверка,
			|	ПрофилиДолжностейХарактеристикиПерсонала.ТребуетсяОбучение,
			|	ПрофилиДолжностейХарактеристикиПерсонала.ВесЗначения
			|ИЗ
			|	Справочник.ПрофилиДолжностей.ХарактеристикиПерсонала КАК ПрофилиДолжностейХарактеристикиПерсонала
			|ГДЕ
			|	ПрофилиДолжностейХарактеристикиПерсонала.Ссылка.Должность В (&СписокДолжностей)";
		Запрос.УстановитьПараметр("СписокДолжностей", ДолжностиПозиции());
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивСтруктурХарактеристик = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтруктураХарактеристик = ХарактеристикиПерсонала.ОписаниеСтруктурыХарактеристик();
		ЗаполнитьЗначенияСвойств(СтруктураХарактеристик, Выборка);
		МассивСтруктурХарактеристик.Добавить(СтруктураХарактеристик);
	КонецЦикла;
	
	ХарактеристикиПерсоналаФормы.ДобавитьХарактеристикиСоЗначениями(Характеристики, ЗначенияХарактеристики,
		МассивСтруктурХарактеристик)

КонецПроцедуры

