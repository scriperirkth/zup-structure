#КонецОбласти

#Область ИсправлениеКлассификатораДолжностейМедицинскогоПерсоналаСлужебные

Функция ИсправитьДолжностиМедицинскогоПерсоналаНСИ(ПараметрыОбновления)
	
	КлассификаторСсылка = Справочники.КлассификаторыФедеральныхМедрегистров.НайтиПоКоду("1.2.643.5.1.13.13.99.2.181"); 
	
	Если Не ЗначениеЗаполнено(КлассификаторСсылка) Тогда 
	    Возврат 0;
	КонецЕсли;   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭлементыКлассификаторов.Ссылка КАК ЭлементСсылка,
		|	ЭлементыКлассификаторов.НаименованиеПолное КАК НаименованиеПолное,
		|	ХарактеристикиОбъектов.Объект КАК Объект
		|ИЗ
		|	Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК ЭлементыКлассификаторов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров.ОписаниеЭлемента КАК ОписанияЭлементовДляID
		|		ПО ЭлементыКлассификаторов.Ссылка = ОписанияЭлементовДляID.Ссылка
		|			И (ОписанияЭлементовДляID.Поле = ""id"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров КАК ХарактеристикиОбъектов
		|		ПО ЭлементыКлассификаторов.Ссылка = ХарактеристикиОбъектов.Характеристика
		|			И (ХарактеристикиОбъектов.Классификатор = &Классификатор)
		|ГДЕ
		|	ЭлементыКлассификаторов.Владелец = &Классификатор
		|	И НЕ ЭлементыКлассификаторов.ПометкаУдаления
		|	И ЭлементыКлассификаторов.Код <> ОписанияЭлементовДляID.Значение";
	
	Запрос.УстановитьПараметр("Классификатор", КлассификаторСсылка);
	ПрежниеЭлементы = Запрос.Выполнить().Выгрузить(); 
	КоличествоЭлементов = ПрежниеЭлементы.Количество();
	Если КоличествоЭлементов=0 Тогда 
	    Возврат 0;
	КонецЕсли;   
	
	Если ПараметрыОбновления<>Неопределено Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.КлассификаторыФедеральныхМедрегистров");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", КлассификаторСсылка);
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров");
		ЭлементБлокировки.УстановитьЗначение("Владелец", КлассификаторСсылка);
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров");
		ЭлементБлокировки.УстановитьЗначение("Классификатор", КлассификаторСсылка);
		НачатьТранзакцию();
		Попытка 
			Блокировка.Заблокировать();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Обновление информационной базы.Ошибка блокировки'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Предупреждение, , КлассификаторСсылка, "Справочник.КлассификаторыФедеральныхМедрегистров, Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров, РегистрСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров");
			Возврат КоличествоЭлементов;
		КонецПопытки;
	КонецЕсли;
	
	ОписаниеКлассификатораJSON = Справочники.КлассификаторыФедеральныхМедрегистров.ПолучитьОписаниеКлассификатораДолжностиМедицинскогоПерсоналаJSON();
	ДанныеКлассификатораJSON = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.ПолучитьДанныеКлассификатораДолжностиМедицинскогоПерсоналаJSON();
	
	ОписаниеСправочника = ПолучитьОписаниеКлассификатораДолжностей(ОписаниеКлассификатораJSON);
	СправочникСсылка = ОбновитьКлассификаторДолжностейФРМР(КлассификаторСсылка, ОписаниеСправочника);
	СодержимоеСправочника = ПолучитьСодержимоеКлассификатораДолжностей(ДанныеКлассификатораJSON);
	СодержимоеСправочника.Индексы.Добавить("НаименованиеПолное");
	ОтборПоНаименованию = Новый Структура("НаименованиеПолное");
	Для Каждого Элемент Из ПрежниеЭлементы Цикл
		ОтборПоНаименованию.НаименованиеПолное = Элемент.НаименованиеПолное;
		СовпаденияПоНаименованию = СодержимоеСправочника.НайтиСтроки(ОтборПоНаименованию);
		КоличествоСовпадений = СовпаденияПоНаименованию.Количество();
		Если КоличествоСовпадений>0 Тогда
			СовпаденияПоНаименованию[КоличествоСовпадений-1].ЭлементСсылка = Элемент.ЭлементСсылка;
			СовпаденияПоНаименованию[КоличествоСовпадений-1].Объект = ?(ЗначениеЗаполнено(Элемент.Объект), Элемент.Объект, Неопределено);
		КонецЕсли;
	КонецЦикла;
	
	ОбработанныеПрежниеЭлементы = Новый Массив;
	КодыГрупп = Новый Соответствие;
	СоздатьГруппыКлассификатораДолжностей(ОбработанныеПрежниеЭлементы, КлассификаторСсылка, КодыГрупп, СодержимоеСправочника, ""); 
	
	Для Каждого Элемент Из СодержимоеСправочника Цикл 
		Если Элемент.КоличествоПодчиненных=0 Тогда 
			Родитель = ?(Элемент.КодРодителя<>"", КодыГрупп[Элемент.КодРодителя], Неопределено); 
			Если ЗначениеЗаполнено(Элемент.ЭлементСсылка) Тогда 
				НовыйОбъект = Элемент.ЭлементСсылка.ПолучитьОбъект();
				ОбработанныеПрежниеЭлементы.Добавить(Элемент.ЭлементСсылка);
			Иначе 
				ЭлементКлассификатора = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.НайтиПоКоду(Элемент.Код, , Родитель, КлассификаторСсылка);
				ЭлементКлассификатораИзДругойГруппы = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.НайтиПоКоду(Элемент.Код, , , КлассификаторСсылка);
				Если ЗначениеЗаполнено(ЭлементКлассификатора) Тогда 
					НовыйОбъект = ЭлементКлассификатора.ПолучитьОбъект();
				Иначе 
					НовыйОбъект = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.СоздатьЭлемент();
				КонецЕсли;
				Если ЗначениеЗаполнено(ЭлементКлассификатораИзДругойГруппы) И ЭлементКлассификатора<>ЭлементКлассификатораИзДругойГруппы Тогда 
					ОбъектКлассификатораИзДругойГруппы = ЭлементКлассификатораИзДругойГруппы.ПолучитьОбъект();
					ОбъектКлассификатораИзДругойГруппы.ОбменДанными.Загрузка = Истина; 
					ОбъектКлассификатораИзДругойГруппы.ПометкаУдаления = Истина;
					ОбъектКлассификатораИзДругойГруппы.Записать();
				КонецЕсли;
			КонецЕсли;
			НовыйОбъект.ОбменДанными.Загрузка = Истина; 
            НовыйОбъект.Владелец = КлассификаторСсылка; 
            НовыйОбъект.Код = Элемент.Код; 
            НовыйОбъект.НаименованиеПолное = Элемент.НаименованиеПолное; 
			НовыйОбъект.Родитель = Родитель;
			НовыйОбъект.ОписаниеЭлемента.Очистить();
			Для Каждого СтрокаОписания Из Элемент.ОписаниеЭлемента Цикл 
				НовоеОписание = НовыйОбъект.ОписаниеЭлемента.Добавить();
				НовоеОписание.Поле = СтрокаОписания.Ключ;
				НовоеОписание.Значение = СтрокаОписания.Значение;
			КонецЦикла;
			НовыйОбъект.Записать();
		КонецЕсли;
	КонецЦикла; 

	// Если вдруг остались необработанные элементы (например, не удалось их сопоставить по наименованию), пометим их на удаление.
	// Это позволит избежать зацикливания процесса обновления.
	Для Каждого Элемент Из ПрежниеЭлементы Цикл
		Если ОбработанныеПрежниеЭлементы.Найти(Элемент.ЭлементСсылка)=Неопределено Тогда 
			СтарыйОбъект = Элемент.ЭлементСсылка.ПолучитьОбъект();
			Если Не СтарыйОбъект.ПометкаУдаления Тогда  
				СтарыйОбъект.ОбменДанными.Загрузка = Истина; 
				СтарыйОбъект.ПометкаУдаления = Истина;
				СтарыйОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ПараметрыОбновления<>Неопределено Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;

	Возврат КоличествоЭлементов;
	
КонецФункции

Процедура СоздатьГруппыКлассификатораДолжностей(ОбработанныеПрежниеЭлементы, КлассификаторСсылка, КодыГрупп, ЭлементыКлассификатора, КодРодителя, Родитель = Неопределено)
	Для Каждого Элемент Из ЭлементыКлассификатора Цикл 
		Если Элемент.КодРодителя = КодРодителя И Элемент.КоличествоПодчиненных>0 Тогда 
			Если ЗначениеЗаполнено(Элемент.Объект) Тогда  
				НаборЗаписей = РегистрыСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров.СоздатьНаборЗаписей();
	 			НаборЗаписей.Отбор.Объект.Установить(Элемент.Объект);
	 			НаборЗаписей.Отбор.Классификатор.Установить(КлассификаторСсылка);
				НаборЗаписей.Записать();
			КонецЕсли;
			Если ЗначениеЗаполнено(Элемент.ЭлементСсылка) Тогда 
				СтарыйОбъект = Элемент.ЭлементСсылка.ПолучитьОбъект();
				СтарыйОбъект.ОбменДанными.Загрузка = Истина; 
				СтарыйОбъект.ПометкаУдаления = Истина;
				СтарыйОбъект.Записать();
				ОбработанныеПрежниеЭлементы.Добавить(Элемент.ЭлементСсылка);
			КонецЕсли;
			ЭлементКлассификатора = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.НайтиПоКоду(Элемент.Код, , Родитель, КлассификаторСсылка);
			Если ЗначениеЗаполнено(ЭлементКлассификатора) Тогда 
				НовыйОбъект = ЭлементКлассификатора.ПолучитьОбъект();
				НовыйОбъект.ОписаниеЭлемента.Очистить();
			Иначе 
				НовыйОбъект = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.СоздатьГруппу();
            	НовыйОбъект.Код = Элемент.Код; 
			КонецЕсли;
			НовыйОбъект.ОбменДанными.Загрузка = Истина; 
            НовыйОбъект.Владелец = КлассификаторСсылка; 
            НовыйОбъект.НаименованиеПолное = Элемент.НаименованиеПолное; 
			НовыйОбъект.Родитель = Родитель;
			Для Каждого СтрокаОписания Из Элемент.ОписаниеЭлемента Цикл
				НовоеОписание = НовыйОбъект.ОписаниеЭлемента.Добавить();
				НовоеОписание.Поле = СтрокаОписания.Ключ;
				НовоеОписание.Значение = СтрокаОписания.Значение;
			КонецЦикла;
			НовыйОбъект.Записать();
			КодыГрупп.Вставить(Элемент.Код, НовыйОбъект.Ссылка);
			СоздатьГруппыКлассификатораДолжностей(ОбработанныеПрежниеЭлементы, КлассификаторСсылка, КодыГрупп, ЭлементыКлассификатора, Элемент.Код, НовыйОбъект.Ссылка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьСодержимоеКлассификатораДолжностей(ДанныеКлассификатораJSON)
	
	СодержимоеКлассификатора = ПустаяТаблицаСодержимогоКлассификатораДолжностейФРМР();
	КоличествоПодчиненных = Новый Соответствие;
	Для Каждого СтрокаЭлемента Из ДанныеКлассификатораJSON["list"] Цикл
		СтруктураЭлемента = Новый Структура();
		Для Каждого ОписаниеРеквизита Из СтрокаЭлемента Цикл
			СтруктураЭлемента.Вставить(ОписаниеРеквизита["column"], ОписаниеРеквизита["value"]);
		КонецЦикла;
		
		Родитель = СтруктураЭлемента["parent_id"];
		ЭлементКлассификатора = СодержимоеКлассификатора.Добавить();
		ЭлементКлассификатора.Код = СтруктураЭлемента["id"];
		ЭлементКлассификатора.НаименованиеПолное = СтруктураЭлемента["work_position"];
		ЭлементКлассификатора.КодРодителя = Родитель;
		ЭлементКлассификатора.ОписаниеЭлемента = СтруктураЭлемента;
		ЭлементКлассификатора.КоличествоПодчиненных = 0;
		
		ПодсчитаноПодчиненных = ?(КоличествоПодчиненных[Родитель]=Неопределено, 0, КоличествоПодчиненных[Родитель]);
		КоличествоПодчиненных.Вставить(Родитель, ПодсчитаноПодчиненных + 1);
	КонецЦикла;  
	
	Для Каждого ЭлементКлассификатора Из СодержимоеКлассификатора Цикл
		ПодсчитаноПодчиненных = ?(КоличествоПодчиненных[ЭлементКлассификатора.Код]=Неопределено, 0, КоличествоПодчиненных[ЭлементКлассификатора.Код]);
		ЭлементКлассификатора.КоличествоПодчиненных = ПодсчитаноПодчиненных;
	КонецЦикла;
	
	Возврат СодержимоеКлассификатора;

КонецФункции

Функция ПолучитьОписаниеКлассификатораДолжностей(ОписаниеКлассификатораJSON)
	
	ОписаниеСправочника = ПустаяСтруктураКлассификатораДолжностейФРМР();
	Для Каждого ЭлементОписания Из ОписаниеСправочника Цикл
		ОписаниеСправочника[ЭлементОписания.Ключ] = ОписаниеКлассификатораJSON[ЭлементОписания.Ключ];
	КонецЦикла;
	ОписаниеСправочника.lastUpdate = СтроковыеФункцииКлиентСервер.СтрокаВДату(ОписаниеКлассификатораJSON["lastUpdate"]);
	ОписаниеСправочника.fieldId = "id";
	
	ПоляСправочника = Новый Структура();
	Для Каждого ПоляСтруктурыСправочника Из ОписаниеКлассификатораJSON["fields"] Цикл
		ПоляСправочника.Вставить(ПоляСтруктурыСправочника["field"], ПоляСтруктурыСправочника["alias"]);
	КонецЦикла;
	
	ОписаниеСправочника.Вставить("fields",ПоляСправочника);
	
	Возврат ОписаниеСправочника;
	
КонецФункции

Функция ПустаяТаблицаСодержимогоКлассификатораДолжностейФРМР()
	ТаблицаСправочникаФРМР = Новый ТаблицаЗначений();
	ТаблицаСправочникаФРМР.Колонки.Добавить("ЭлементСсылка", Новый ОписаниеТипов("СправочникСсылка.ЭлементыКлассификаторовФедеральныхМедрегистров"));
	ТаблицаСправочникаФРМР.Колонки.Добавить("Код",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаСправочникаФРМР.Колонки.Добавить("НаименованиеПолное",ОбщегоНазначения.ОписаниеТипаСтрока(500));
	ТаблицаСправочникаФРМР.Колонки.Добавить("КодРодителя",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаСправочникаФРМР.Колонки.Добавить("КоличествоПодчиненных", Новый ОписаниеТипов("Число"));
	ТаблицаСправочникаФРМР.Колонки.Добавить("ОписаниеЭлемента", Новый ОписаниеТипов("Структура"));
	ТаблицаСправочникаФРМР.Колонки.Добавить("Объект");
	Возврат ТаблицаСправочникаФРМР;
КонецФункции

Функция ПустаяСтруктураКлассификатораДолжностейФРМР()
	Результат = Новый Структура();
	Результат.Вставить("oid");
	Результат.Вставить("version");
	Результат.Вставить("rowsCount");
	Результат.Вставить("lastUpdate");
	Результат.Вставить("fullName");
	Результат.Вставить("shortName");
	Результат.Вставить("hierarchical");
	Результат.Вставить("fieldId");
	Результат.Вставить("fields");
	Возврат Результат;
КонецФункции

Функция ОбновитьКлассификаторДолжностейФРМР(Ссылка,ОписаниеСправочника) Экспорт 
	Если ОписаниеСправочника = Неопределено Тогда
		Возврат Справочники.КлассификаторыФедеральныхМедрегистров.ПустаяСсылка();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		СправочникОбъект = Ссылка.ПолучитьОбъект();
	Иначе
		НайденноеОписаниеСправочника = Справочники.КлассификаторыФедеральныхМедрегистров.НайтиПоКоду(ОписаниеСправочника.oid);
		Если ЗначениеЗаполнено(НайденноеОписаниеСправочника) Тогда 
			СправочникОбъект = НайденноеОписаниеСправочника.ПолучитьОбъект();
		Иначе
			СправочникОбъект = Справочники.КлассификаторыФедеральныхМедрегистров.СоздатьЭлемент();
		КонецЕсли;
	КонецЕсли;
	
	СправочникОбъект.Наименование = ОписаниеСправочника.shortName;
	СправочникОбъект.Код 		= ОписаниеСправочника.oid;
	СправочникОбъект.Версия		= ОписаниеСправочника.version;
	СправочникОбъект.КоличествоЭлементов = ОписаниеСправочника.rowsCount;
	СправочникОбъект.Иерархия 	= ОписаниеСправочника.hierarchical;
	СправочникОбъект.Изменен 	= ОписаниеСправочника.lastUpdate;
	СправочникОбъект.ПолеИдентификатор = ОписаниеСправочника.fieldId;
	
	СправочникОбъект.СтруктураСправочника.Очистить();
	Для Каждого ПолеСправочника Из ОписаниеСправочника.fields Цикл
		ЭлементСтруктуры = СправочникОбъект.СтруктураСправочника.Добавить();
		ЭлементСтруктуры.ИмяПоля = ПолеСправочника.Ключ;
		ЭлементСтруктуры.Представление = ПолеСправочника.Значение;
	КонецЦикла;
	
	СправочникОбъект.ОбменДанными.Загрузка = Истина;
	
	СправочникОбъект.Записать();
	
	Возврат СправочникОбъект.Ссылка;
		
КонецФункции

