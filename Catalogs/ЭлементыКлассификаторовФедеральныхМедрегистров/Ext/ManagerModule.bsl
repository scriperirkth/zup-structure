// Возвращает структуру категорий гражданства в мед. регистре.
//
Функция НаименованияКатегорийГражданстваМедицинскихРаботников() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлементыКлассификаторовФедеральныхМедрегистров.Ссылка КАК Ссылка,
	               |	ЭлементыКлассификаторовФедеральныхМедрегистров.НаименованиеПолное КАК Наименование,
	               |	ВЫБОР
	               |		КОГДА ЭлементыКлассификаторовФедеральныхМедрегистров.Код = ""1""
	               |			ТОГДА ""ГражданинРоссии""
	               |		КОГДА ЭлементыКлассификаторовФедеральныхМедрегистров.Код = ""3""
	               |			ТОГДА ""ИностранныйГражданин""
	               |		КОГДА ЭлементыКлассификаторовФедеральныхМедрегистров.Код = ""4""
	               |			ТОГДА ""БезГражданства""
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК Код
	               |ИЗ
	               |	Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК ЭлементыКлассификаторовФедеральныхМедрегистров
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторыФедеральныхМедрегистров КАК КлассификаторыФедеральныхМедрегистров
	               |		ПО ЭлементыКлассификаторовФедеральныхМедрегистров.Владелец = КлассификаторыФедеральныхМедрегистров.Ссылка
	               |ГДЕ
	               |	КлассификаторыФедеральныхМедрегистров.Код = &ИдентификаторКлассификатора";
	
	Запрос.УстановитьПараметр("ИдентификаторКлассификатора", "1.2.643.5.1.13.13.99.2.315");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Гражданство = Новый Структура("ГражданинРоссии, ИностранныйГражданин, БезГражданства");
	
	Пока Выборка.Следующий() Цикл 
		
		Если ПустаяСтрока(Выборка.Код ) Тогда
			Продолжить;
		КонецЕсли;
		
		Гражданство.Вставить(Выборка.Код, Выборка.Наименование);
		
	КонецЦикла;
	
	Возврат Гражданство;
	
КонецФункции	

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Представление = Данные.НаименованиеПолное;
	
	Если Данные.Ссылка.ЭтоГруппа = Ложь
		И ЗначениеЗаполнено(Данные.Владелец)
		И Данные.Владелец.Код = "1.2.643.5.1.13.13.99.2.319" Тогда
		СтрокаКод = Данные.Ссылка.ОписаниеЭлемента.Найти("code","Поле");
		Если СтрокаКод <> Неопределено 
			И ЗначениеЗаполнено(СтрокаКод.Значение) Тогда
			Представление = СтрокаКод.Значение + " " + Представление;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("НаименованиеПолное");
	Поля.Добавить("Владелец");
	Поля.Добавить("Ссылка");
КонецПроцедуры

// Процедура исправляет неверно заполненные коды элементов некоторых классификаторов НСИ.
Процедура ИсправитьНекорректныеКодыЭлементов(ПараметрыОбновления = Неопределено) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("РаботаВМедицинскомУчреждении") Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
	
	ЭлементовДляИсправления = 0;
	ЭлементовДляИсправления = ЭлементовДляИсправления + ИсправитьНекорректныеКодыЭлементовКлассификатораНСИ("1.2.643.5.1.13.13.11.1066", "ID", "PARENT", ПараметрыОбновления);
	ЭлементовДляИсправления = ЭлементовДляИсправления + ИсправитьНекорректныеКодыЭлементовКлассификатораНСИ("1.2.643.5.1.13.13.99.2.170", "id", "parent_id", ПараметрыОбновления);
	ЭлементовДляИсправления = ЭлементовДляИсправления + ИсправитьНекорректныеКодыЭлементовКлассификатораНСИ("1.2.643.5.1.13.13.99.2.196", "ID", "PARENT_ID", ПараметрыОбновления);
	ЭлементовДляИсправления = ЭлементовДляИсправления + ИсправитьНекорректныеКодыЭлементовКлассификатораНСИ("1.2.643.5.1.13.13.99.2.220", "id", "parent_Id", ПараметрыОбновления);
	
	ЭлементовДляИсправления = ЭлементовДляИсправления + ИсправитьДолжностиМедицинскогоПерсоналаНСИ(ПараметрыОбновления);

	Если ЭлементовДляИсправления = 0 Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	КонецЕсли;	
	
КонецПроцедуры

#Область ИсправлениеНекорректныхКодовЭлементовСлужебные 

Функция ИсправитьНекорректныеКодыЭлементовКлассификатораНСИ(КодКлассификатора, ИмяПоляID, ИмяПоляPARENT, ПараметрыОбновления = Неопределено) Экспорт
	
	КлассификаторСсылка = Справочники.КлассификаторыФедеральныхМедрегистров.НайтиПоКоду(КодКлассификатора);
	
	Если Не ЗначениеЗаполнено(КлассификаторСсылка) Тогда 
	    Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭлементыКлассификаторов.Ссылка КАК ЭлементСсылка,
		|	ЭлементыКлассификаторов.НаименованиеПолное КАК НаименованиеПолное,
		|	ОписанияЭлементовДляID.Значение КАК Код,
		|	ОписанияЭлементовДляPARENT.Значение КАК КодРодителя,
		|	ХарактеристикиОбъектов.Объект КАК Объект
		|ПОМЕСТИТЬ ВТЭлементыКлассификаторов
		|ИЗ
		|	Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК ЭлементыКлассификаторов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров.ОписаниеЭлемента КАК ОписанияЭлементовДляID
		|		ПО ЭлементыКлассификаторов.Ссылка = ОписанияЭлементовДляID.Ссылка
		|			И (ОписанияЭлементовДляID.Поле = &ИмяПоляID)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров.ОписаниеЭлемента КАК ОписанияЭлементовДляPARENT
		|		ПО ЭлементыКлассификаторов.Ссылка = ОписанияЭлементовДляPARENT.Ссылка
		|			И (ОписанияЭлементовДляPARENT.Поле = &ИмяПоляPARENT)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров КАК ХарактеристикиОбъектов
		|		ПО (ХарактеристикиОбъектов.Характеристика = ЭлементыКлассификаторов.Ссылка)
		|			И (ХарактеристикиОбъектов.Классификатор = ЭлементыКлассификаторов.Владелец)
		|ГДЕ
		|	ЭлементыКлассификаторов.Владелец = &КлассификаторСсылка
		|	И ЭлементыКлассификаторов.Код <> ОписанияЭлементовДляID.Значение
		|	И НЕ ЭлементыКлассификаторов.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Таблица.ЭлементСсылка КАК ЭлементСсылка,
		|	Таблица.НаименованиеПолное КАК НаименованиеПолное,
		|	Таблица.Код КАК Код,
		|	Таблица.КодРодителя КАК КодРодителя,
		|	Таблица.Объект КАК Объект,
		|	КОЛИЧЕСТВО(ТаблицаПодчиненных.Код) КАК КоличествоПодчиненных
		|ИЗ
		|	ВТЭлементыКлассификаторов КАК Таблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЭлементыКлассификаторов КАК ТаблицаПодчиненных
		|		ПО Таблица.Код = ТаблицаПодчиненных.КодРодителя
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.ЭлементСсылка,
		|	Таблица.НаименованиеПолное,
		|	Таблица.Код,
		|	Таблица.КодРодителя,
		|	Таблица.Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код,
		|	Объект";
	
	Запрос.УстановитьПараметр("КлассификаторСсылка", КлассификаторСсылка);
	Запрос.УстановитьПараметр("ИмяПоляID", ИмяПоляID);
	Запрос.УстановитьПараметр("ИмяПоляPARENT", ИмяПоляPARENT);
	
	ЭлементыКлассификатора = Запрос.Выполнить().Выгрузить();
	КоличествоЭлементов = ЭлементыКлассификатора.Количество();
	Если КоличествоЭлементов=0 Тогда 
	    Возврат 0;
	КонецЕсли;
	
	Если ПараметрыОбновления<>Неопределено Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров");
		ЭлементБлокировки.УстановитьЗначение("Владелец", КлассификаторСсылка);
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров");
		ЭлементБлокировки.УстановитьЗначение("Классификатор", КлассификаторСсылка);
		НачатьТранзакцию();
		Попытка 
			Блокировка.Заблокировать();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Обновление информационной базы.Ошибка блокировки'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Предупреждение, , КлассификаторСсылка, "Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров, РегистрСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров");
			Возврат КоличествоЭлементов;
		КонецПопытки;
	КонецЕсли;
		
	СкорректироватьДубли(КодКлассификатора, ЭлементыКлассификатора, ИмяПоляID, ИмяПоляPARENT);
	КодыГрупп = Новый Соответствие;
	СоздатьГруппы(КлассификаторСсылка, КодыГрупп, ЭлементыКлассификатора, ""); 
	
	Для Каждого Элемент Из ЭлементыКлассификатора Цикл 
		Если Элемент.КоличествоПодчиненных=0 Тогда 
			Родитель = ?(Элемент.КодРодителя<>"", КодыГрупп[Элемент.КодРодителя], Неопределено); 
			СтарыйОбъект = Элемент.ЭлементСсылка.ПолучитьОбъект();
			СтарыйОбъект.ОбменДанными.Загрузка = Истина; 
            СтарыйОбъект.Код = Элемент.Код; 
			СтарыйОбъект.Родитель = Родитель;
			СуществующийЭлемент = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.НайтиПоКоду(Элемент.Код, , Родитель, КлассификаторСсылка);
			Если СуществующийЭлемент <> Неопределено Тогда
				СтарыйОбъект.ПометкаУдаления = Истина;
			КонецЕсли;
			СтарыйОбъект.Записать();
		КонецЕсли;
	КонецЦикла; 
	
	Если ПараметрыОбновления<>Неопределено Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;

	Возврат КоличествоЭлементов;
	
КонецФункции

Процедура СкорректироватьДубли(КодКлассификатора, ЭлементыКлассификатора, ИмяПоляID, ИмяПоляPARENT)
	
	Скорректированные220 = Новый Массив;
	Скорректированные1066 = Новый Массив;
	Для Каждого Элемент Из ЭлементыКлассификатора Цикл
		Если КодКлассификатора = "1.2.643.5.1.13.13.99.2.220" Тогда 
			Если Элемент.Код = "88" Тогда
				СкорректироватьЭлемент220(Скорректированные220, Элемент, "87", "61", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "96" Тогда 
				СкорректироватьЭлемент220(Скорректированные220, Элемент, "95", "94", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "326" Тогда 
				СкорректироватьЭлемент220(Скорректированные220, Элемент, "325", "287", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "492" Тогда 
				СкорректироватьЭлемент220(Скорректированные220, Элемент, "400", "399", ИмяПоляID, ИмяПоляPARENT);
			КонецЕсли;	
		ИначеЕсли КодКлассификатора = "1.2.643.5.1.13.13.11.1066" Тогда 
			Если Элемент.Код = "284" Тогда // Бактериология
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "54", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "213" Тогда // Гигиеническое воспитание
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "162", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "231" Тогда // Диетология
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "84", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "206" Тогда // Лечебное дело
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "1", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "225" Тогда // Рентгенология
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "24", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "219" Тогда // Сестринское дело 
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "5", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "208" Тогда // Стоматология 
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "3", "0", ИмяПоляID, ИмяПоляPARENT, "07.10.2015");
			ИначеЕсли Элемент.Код = "209" Тогда // Стоматология ортопедическая
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "175", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "234" Тогда // Судебно-медицинская экспертиза
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "26", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "218" Тогда // Фармация 
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "4", "0", ИмяПоляID, ИмяПоляPARENT, "07.10.2015");
			ИначеЕсли Элемент.Код = "227" Тогда // Физиотерапия 
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "34", "0", ИмяПоляID, ИмяПоляPARENT);
			ИначеЕсли Элемент.Код = "226" Тогда // Функциональная диагностика
				СкорректироватьЭлемент1066(Скорректированные1066, Элемент, "35", "0", ИмяПоляID, ИмяПоляPARENT);
			КонецЕсли;	
		ИначеЕсли КодКлассификатора = "1.2.643.5.1.13.13.99.2.196" Тогда 
			Если Элемент.Код = "43" Тогда
				СкорректироватьЭлемент196(Элемент, "42", "", ИмяПоляID, ИмяПоляPARENT);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура СкорректироватьЭлемент220(Скорректированные, Элемент, НовыйКод, НовыйКодРодителя, ИмяПоляID, ИмяПоляPARENT)
