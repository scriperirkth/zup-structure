Процедура УстановитьУсловноеОформлениеТаблицыФормыОпытРаботы()
	
	// Отключаем видимость сферы деятельности компании, если она не заполнена.
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.ОпытРаботыСфераДеятельностиКомпании.Имя);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, 
		"ЛичныеДанныеКандидата.ОпытРаботы.СфераДеятельностиКомпании", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

