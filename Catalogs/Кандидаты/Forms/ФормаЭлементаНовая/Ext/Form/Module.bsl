	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияОжидаемыйДоход", "Видимость", ВидимостьОжидаемогоДохода);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЛичныеДанные(ЛичныеДанные, КонтактнаяИнформация, Элементы)
	
	РедактироватьЛичныеДанные = Ложь;
	ЗаполнитьМестоРожденияГражданство(ЛичныеДанные, Элементы, РедактироватьЛичныеДанные);
	ЗаполнитьВозрастПолСемейноеПоложение(ЛичныеДанные, Элементы, РедактироватьЛичныеДанные);
	ЗаполнитьКонтактнуюИнформацию(КонтактнаяИнформация, Элементы, РедактироватьЛичныеДанные);
	ЗаполнитьОпытРаботы(ЛичныеДанные.ОпытРаботы, Элементы);
	ЗаполнитьОбразование(ЛичныеДанные.Образование, Элементы);
	ЗаполнитьКурсы(ЛичныеДанные.Курсы, Элементы);
	ЗаполнитьЗнаниеЯзыков(ЛичныеДанные.ЗнаниеЯзыков, Элементы);
	ЗаполнитьУченыеСтепени(ЛичныеДанные.УченыеСтепени, Элементы);
	
	Если РедактироватьЛичныеДанные Тогда
		ЗаголовокРедактированияЛичныхДанных = НСтр("ru = 'Редактировать'");
	Иначе
		ЗаголовокРедактированияЛичныхДанных = НСтр("ru = 'Добавить личные данные'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаРедактироватьЛичныеДанные", "Заголовок", ЗаголовокРедактированияЛичныхДанных);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьМестоРожденияГражданство(ЛичныеДанные, Элементы, РедактироватьЛичныеДанные = Неопределено)
	
	МестоРожденияГражданство = Новый Массив;
	
	Если ЗначениеЗаполнено(ЛичныеДанные.МестоРождения) Тогда
		РедактироватьЛичныеДанные = Истина;
		МестоРожденияГражданство.Добавить(СтрШаблон(НСтр("ru = 'Место рождения: %1'"),
			Прав(ЛичныеДанные.МестоРождения, СтрДлина(ЛичныеДанные.МестоРождения) - 2)));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЛичныеДанные.Гражданство) Тогда
		МестоРожденияГражданство.Добавить(СтрШаблон(НСтр("ru = 'Гражданство: %1'"),
			ЛичныеДанные.Гражданство));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияМестоРожденияГражданство", "Заголовок",
		СтрСоединить(МестоРожденияГражданство, ", "));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьВозрастПолСемейноеПоложение(ЛичныеДанные, Элементы, РедактироватьЛичныеДанные = Неопределено)
	
	ВозрастПолСемейноеПоложение = Новый Массив;
	
	ДатаРождения = ЛичныеДанные.ДатаРождения;
	Если ЗначениеЗаполнено(ДатаРождения) Тогда
		ВозрастРезюме = ВозрастРезюме(ДатаРождения, ДатаОтсчетаВозраста());
		РедактироватьЛичныеДанные = Истина;
	Иначе
		ВозрастРезюме = НСтр("ru = 'Возраст не указан'");
	КонецЕсли;
	ВозрастПолСемейноеПоложение.Добавить(ВозрастРезюме);
	
	ПолРезюме = ПолРезюме(ЛичныеДанные);
	Если ЗначениеЗаполнено(ПолРезюме) Тогда
		РедактироватьЛичныеДанные = Истина;
		ВозрастПолСемейноеПоложение.Добавить(ПолРезюме);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЛичныеДанные.СостояниеВБраке) Тогда
		РедактироватьЛичныеДанные = Истина;
		ВозрастПолСемейноеПоложение.Добавить(НРег(ЛичныеДанные.СостояниеВБраке));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияВозрастПолСемейноеПоложение", "Заголовок",
		СтрСоединить(ВозрастПолСемейноеПоложение, ", "));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКонтактнуюИнформацию(КонтактнаяИнформация, Элементы, РедактироватьЛичныеДанные = Неопределено)
	
	Для Каждого Контакт Из КонтактнаяИнформация Цикл
		Если Контакт.ИмяРеквизита = "КонтактнаяИнформацияПолеТелефонЛичныеДанныеКандидатов" Тогда
			Если Не ЗначениеЗаполнено(Контакт.Представление) Тогда
				ВидимостьТелефона = Ложь;
			Иначе
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
					Элементы, "ДекорацияТелефон", "Заголовок", Контакт.Представление);
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
					Элементы, "ДекорацияТелефонКомментарий", "Заголовок", Контакт.Комментарий);
				ВидимостьТелефона = Истина;
				РедактироватьЛичныеДанные = Истина;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ГруппаТелефон", "Видимость", ВидимостьТелефона);
			Продолжить;
		КонецЕсли;
		
		Если Контакт.ИмяРеквизита = "КонтактнаяИнформацияПолеEMailЛичныеДанныеКандидатов" Тогда
			Если Не ЗначениеЗаполнено(Контакт.Представление) Тогда
				ВидимостьПочты = Ложь;
			Иначе
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
					Элементы, "ДекорацияПочта", "Заголовок", Контакт.Представление);
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
					Элементы, "ДекорацияПочтаКомментарий", "Заголовок", Контакт.Комментарий);
				ВидимостьПочты = Истина;
				РедактироватьЛичныеДанные = Истина;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ГруппаПочта", "Видимость", ВидимостьПочты);
			Продолжить;
		КонецЕсли;
		
		Если Контакт.ИмяРеквизита = "КонтактнаяИнформацияПолеАдресЛичныеДанныеКандидатов" Тогда
			Если Не ЗначениеЗаполнено(Контакт.Представление) Тогда
				ВидимостьАдреса = Ложь;
			Иначе
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
					Элементы, "ДекорацияАдрес", "Заголовок", Контакт.Представление);
				ВидимостьАдреса = Истина;
				РедактироватьЛичныеДанные = Истина;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ГруппаАдрес", "Видимость", ВидимостьАдреса);
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОпытРаботы(ОпытРаботы, Элементы)
	
	Если ОпытРаботы.Количество() = 0 Тогда
		БезОпытаРаботы = Истина;
		ЗаголовокРедактироватьОпытРаботы = НСтр("ru = 'Добавить опыт работы'");
	Иначе
		БезОпытаРаботы = Ложь;
		ЗаголовокРедактироватьОпытРаботы = НСтр("ru = 'Редактировать'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияОпытРаботы", "Видимость", БезОпытаРаботы);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаРедактироватьОпытРаботы", "Заголовок", ЗаголовокРедактироватьОпытРаботы);
	
	Для Каждого Работа Из ОпытРаботы Цикл
		ИмяГруппы = "ГруппаОпытРаботы" + Работа.НомерСтроки;
		Группа = Элементы.Найти(ИмяГруппы);
		Если Группа <> Неопределено Тогда
			Элементы.Удалить(Группа);
		КонецЕсли;
		Группа = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Элементы.ГруппаОпытРаботы);
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.ОтображатьЗаголовок = Ложь;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		
		НовыйЭлемент = Элементы.Добавить("ОпытРаботыКомпанияСтаж" + Работа.НомерСтроки, Тип("ДекорацияФормы"), Группа);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
		НовыйЭлемент.Шрифт = ШрифтЗаголовкаРезюме();
		НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '%1, %2 - %3, %4'"),
			Работа.Компания,
			Работа.ДатаНачалаПредставление,
			Работа.ДатаОкончанияПредставление,
			СтажПоОпытуРаботы(Работа.ДатаНачала, Работа.ДатаОкончания));
		
		НовыйЭлемент = Элементы.Добавить("ОпытРаботыДолжность" + Работа.НомерСтроки, Тип("ДекорацияФормы"), Группа);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
		НовыйЭлемент.Заголовок = Работа.Должность;
		
		НовыйЭлемент = Элементы.Добавить("ОпытРаботыОбязанности" + Работа.НомерСтроки, Тип("ДекорацияФормы"), Группа);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
		НовыйЭлемент.Заголовок = Работа.Обязанности;
	КонецЦикла;
	
КонецПроцедуры 

