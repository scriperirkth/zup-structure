Функция ЗаголовокСобытия(Форма, ВидСобытия, ПредметСобытия, НомерСобытия)
	
	Если ВидСобытия = ПредопределенноеЗначение("Перечисление.СобытияПоКандидату.Комментарий") Тогда
		ЗаголовокСобытия = НСтр("ru = 'Оставлен комментарий:'");
	ИначеЕсли ВидСобытия = ПредопределенноеЗначение("Перечисление.СобытияПоКандидату.ЗагрузкаФайлов") Тогда
		ЗаголовокСобытия = НСтр("ru = 'Загружен файл:'");
	ИначеЕсли ВидСобытия = ПредопределенноеЗначение("Перечисление.СобытияПоКандидату.ДобавлениеИнформации") Тогда
		Если ПредметСобытия = "Кандидат" Тогда
			ЗаголовокСобытия = НСтр("ru = 'Вписаны данные кандидата:'");
		ИначеЕсли ПредметСобытия = "ЛичныеДанные" Тогда
			ЗаголовокСобытия = НСтр("ru = 'Вписаны личные данные:'");
		Иначе
			ЗаголовокСобытия = НСтр("ru = 'Вписана ифнормация:'");
		КонецЕсли;
	ИначеЕсли ВидСобытия = ПредопределенноеЗначение("Перечисление.СобытияПоКандидату.ИзменениеИнформации") Тогда
		Если ПредметСобытия = "Кандидат" Тогда
			ЗаголовокСобытия = НСтр("ru = 'Изменены данные кандидата:'");
		ИначеЕсли ПредметСобытия = "ЛичныеДанные" Тогда 
			ЗаголовокСобытия = НСтр("ru = 'Изменены личные данные:'");
		Иначе
			ЗаголовокСобытия = НСтр("ru = 'Изменена ифнормация:'");
		КонецЕсли;
	ИначеЕсли СобытиеЭтапРаботы(ВидСобытия) Тогда
		ТекущиеДанные = Форма.РаботаСКандидатамиНаборЗаписей[НомерСобытия];
		Если ТекущиеДанные.СостояниеЭтапа =
			ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Запланирован") Тогда
			ЗаголовокСобытия = НСтр("ru = 'Этап запланирован'");
		ИначеЕсли ТекущиеДанные.СостояниеЭтапа =
			ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Пройден") Тогда
			ЗаголовокСобытия = НСтр("ru = 'Этап пройден'");
		ИначеЕсли ТекущиеДанные.СостояниеЭтапа =
			ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Пропущен") Тогда
			ЗаголовокСобытия = НСтр("ru = 'Этап пропущен'");
		Иначе
			ЗаголовокСобытия = НСтр("ru = 'Этап'");
		КонецЕсли;
	Иначе
		ЗаголовокСобытия = "";
	КонецЕсли;
	
	Возврат ЗаголовокСобытия;
	
КонецФункции

