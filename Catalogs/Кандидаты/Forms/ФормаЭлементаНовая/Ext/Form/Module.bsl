Функция ПредставлениеОтветственного(Ответственный)
	
	ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ответственный, "ФизическоеЛицо");
	КадровыеДанные = КадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, ФизическоеЛицо, "Фамилия,Имя");
	Если КадровыеДанные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат КадровыеДанные[0].Фамилия + " " + КадровыеДанные[0].Имя;
	
