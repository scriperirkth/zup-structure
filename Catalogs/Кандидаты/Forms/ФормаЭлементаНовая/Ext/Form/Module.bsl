&НаКлиенте
Процедура Подключаемый_КомандаПанелиПрисоединенныхФайлов(Команда)
	РаботаСФайламиКлиент.КомандаУправленияПрисоединеннымиФайлами(ЭтотОбъект, Команда);
КонецПроцедуры
// Конец СтандартныеПодсистемы.РаботаСФайлами

&НаКлиенте
Процедура НастроитьПереносКонтактнойИнформации(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ЭтотОбъект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения",
		Сред(Команда.Имя, СтрДлина("КонтактнаяИнформацияДобавитьПолеВвода") + 1));
	ДополнительныеПараметры.Вставить("АсинхронныйВызов", Ложь);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияФормыСпискаВидыКонтактнойИнформации",
		УправлениеКонтактнойИнформациейКлиент, ДополнительныеПараметры);
	ОткрытьФорму("РегистрСведений.НастройкаВидовКонтактнойИнформацииКандидатов.Форма.ФормаНастройкиСоответствия", ,
		ЭтотОбъект, , , , Оповещение);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Оценки

&НаСервере
Процедура ЗаполнитьОценкуПоХарактеристикам()
	
	Если КандидатОбъект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОценкиКандидатовПоХарактеристикам.Оценка КАК Оценка
		|ИЗ
		|	РегистрСведений.ОценкиКандидатовПоХарактеристикам КАК ОценкиКандидатовПоХарактеристикам
		|ГДЕ
		|	ОценкиКандидатовПоХарактеристикам.Кандидат = &Кандидат";
	Запрос.УстановитьПараметр("Кандидат", КандидатОбъект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Оценка) Тогда
			ОценкаПоХарактеристикам = Выборка.Оценка;
		Иначе
			ОценкаПоХарактеристикам = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьРейтинга()
	
	Если Не ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Для НомерЗвезды = 1 По 5 Цикл
		Элементы["Звезда_Неактивная_" + НомерЗвезды].Доступность = Ложь;
		Элементы["Звезда_Активная_" + НомерЗвезды].Доступность = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция РейтингДляОтображения(ТекущийОбъект)
	
	// Если есть общий рейтинг, показываем его.
	Если ТекущийОбъект.Рейтинг <> 0 Тогда
		Возврат ТекущийОбъект.Рейтинг;
	КонецЕсли;
	
	// Если нет, то ищем индивидуальный по пользователю.
	ИндивидуальнаяОценка = ИндивидуальнаяОценка(ТекущийОбъект.Оценки);
	Если ИндивидуальнаяОценка <> Неопределено Тогда
		Возврат ИндивидуальнаяОценка;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция ИндивидуальнаяОценка(Оценки)
	
	СтрокаОценки = СтрокаИндивидуальнойОценки(Оценки, Пользователи.АвторизованныйПользователь());
	Если СтрокаОценки <> Неопределено Тогда
		Возврат СтрокаОценки.Оценка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСреднийРейтинг(Форма)
	
	КандидатОбъект = Форма.КандидатОбъект;
	ВсегоОценок = КандидатОбъект.Оценки.Количество();
	
	Если ВсегоОценок < 1 Тогда
		Форма.Элементы.НадписьАгрегированнаяОценка.Видимость = Ложь;
		Возврат;
	Иначе
		Форма.Элементы.НадписьАгрегированнаяОценка.Видимость = Истина;
	КонецЕсли;
	
	СреднийРейтинг = СреднийРейтинг(Форма, ВсегоОценок);
	КандидатОбъект.Рейтинг = Окр(СреднийРейтинг, 2);
	
	Форма.Элементы.НадписьАгрегированнаяОценка.Заголовок = СтрШаблон(
		НСтр("ru = 'Средняя: %1, всего оценок %2'"), КандидатОбъект.Рейтинг, ВсегоОценок);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОтобразитьРейтинг(Форма, Рейтинг)
	
	Элементы = Форма.Элементы;
	
	Для НомерЗвезды = 1 По 5 Цикл
		Страница = "Неактивная";
		Если НомерЗвезды <= Рейтинг Тогда
			Страница = "Активная";
		КонецЕсли;
		Если Элементы["Звезда" + НомерЗвезды + "Страницы"].ТекущаяСтраница <> Элементы["Звезда" + НомерЗвезды + "Страница" + Страница] Тогда
			Элементы["Звезда" + НомерЗвезды + "Страницы"].ТекущаяСтраница = Элементы["Звезда" + НомерЗвезды + "Страница" + Страница];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СреднийРейтинг(Форма, ВсегоОценок = Неопределено)
	
	Если ВсегоОценок = Неопределено Тогда
		ВсегоОценок = Форма.КандидатОбъект.Оценки.Количество();
	КонецЕсли;
	
	Если ВсегоОценок = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Форма.КандидатОбъект.Оценки.Итог("Оценка") / ВсегоОценок;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаИндивидуальнойОценки(Оценки, ТекущийПользователь)
	
	НайденныеСтроки = Оценки.НайтиСтроки(Новый Структура("Пользователь", ТекущийПользователь));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ЭтапыРаботыСКандидатом

&НаСервере
Процедура УстановитьПанельСостояния(ТекущийОбъект = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = КандидатОбъект;
	КонецЕсли;
	
	КандидатОтклонен = Ложь;
	Если ТекущийОбъект.Состояние = Перечисления.СостоянияСогласования.Согласовано Тогда
		ДатаПриема = ДатаПриемаНаРаботу();
		Если ЗначениеЗаполнено(ДатаПриема) Тогда
			Сотрудник = ПодборПерсонала.СотрудникКандидата(КандидатСсылка);
			Элементы.ДекорацияНадписьСостояние.Заголовок = ПредставлениеСотрудника(ДатаПриема);
		КонецЕсли;
		Если ТекущийЭтап.ЭтапРаботы = Перечисления.ЭтапыРаботыСКандидатами.РаботаЗавершена Тогда
			Элементы.ГруппаСостояние.ЦветФона = ЦветаСтиля.ЦветФонаПоложительногоЗначения;
		Иначе
			Элементы.ГруппаСостояние.ЦветФона = ЦветаСтиля.ЦветФонаПодсказки;
		КонецЕсли;
		Элементы.ГруппаСостояние.Видимость = Истина;
	ИначеЕсли ТекущийОбъект.Состояние = Перечисления.СостоянияСогласования.Отклонено Тогда
		Элементы.ГруппаСостояние.ЦветФона = ЦветаСтиля.ЦветФонаОтрицательногоЗначения;
		Элементы.ГруппаСостояние.Видимость = Истина;
		Элементы.ДекорацияНадписьСостояние.Заголовок = СтрШаблон(НСтр("ru = '%1 %2'"),
			?(ЭтоЖенскийПол(ЛичныеДанныеКандидата.Пол), НСтр("ru = 'Отклонена'"), НСтр("ru = 'Отклонен'")),
			Формат(ТекущийОбъект.ДатаРешения, "ДЛФ=D"));
		Если ЗначениеЗаполнено(ТекущийОбъект.ПричинаОтклонения) Тогда
			Элементы.ДекорацияНадписьСостояние.Заголовок = СтрШаблон(НСтр("ru = '%1 по причине: %2'"),
				Элементы.ДекорацияНадписьСостояние.Заголовок,
				ТекущийОбъект.ПричинаОтклонения);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущийОбъект.КомментарийРешения) Тогда
			Элементы.ДекорацияНадписьСостояние.Заголовок = СтрШаблон(НСтр("ru = '%1 c комментарием: %2'"),
				Элементы.ДекорацияНадписьСостояние.Заголовок,
				ТекущийОбъект.КомментарийРешения);
		КонецЕсли;
		КандидатОтклонен = Истина;
	ИначеЕсли ТекущийЭтап.ЭтапРаботы = Неопределено Тогда
		Элементы.ГруппаСостояние.Видимость = Ложь;
		Возврат;
	Иначе
		Элементы.ГруппаСостояние.ЦветФона = ЦветаСтиля.ЦветФонаПодсказки;
		Элементы.ГруппаСостояние.Видимость = Истина;
	КонецЕсли;
	
	ЗаполнитьПолосуЭтапов(РаботаСКандидатамиНаборЗаписей, ТекущийЭтап.ЭтапРаботы, КандидатОтклонен, Элементы);
	
	Если ТекущийОбъект.Состояние = Перечисления.СостоянияСогласования.Отклонено Тогда
		КандидатОтклонен = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьТекущийЭтапРаботы()

	МенеджерЗаписи = РегистрыСведений.ТекущиеЭтапыРаботыСКандидатами.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Кандидат = КандидатСсылка;
	МенеджерЗаписи.Прочитать();

	ЗначениеВРеквизитФормы(МенеджерЗаписи, "ТекущийЭтап");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеТекущегоЭтапа()
	
	Если ТипЗнч(ТекущийЭтап.ЭтапРаботы) = Тип("ПеречислениеСсылка.ЭтапыРаботыСКандидатами") Тогда
		Элементы.ДекорацияНадписьСостояние.Заголовок = ПредставлениеПредопределенногоЭтапа(ТекущийЭтап, 
			НайтиСтрокуРаботыСКандидатом(ЭтотОбъект, ТекущийЭтап));
	Иначе
		Элементы.ДекорацияНадписьСостояние.Заголовок = ПредставлениенеНеПредопределенногоЭтапа(ТекущийЭтап, 
			НайтиСтрокуРаботыСКандидатом(ЭтотОбъект, ТекущийЭтап));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПробел(ЧастиСтроки)
	ЧастиСтроки.Добавить(" ");
КонецПроцедуры

&НаСервере
Процедура ПрочитатьРаботуСКандидатом(ТекущийОбъект = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = КандидатОбъект;
	КонецЕсли;
	
	ТаблицаЭтапов = ПодборПерсонала.ТаблицаЭтаповРаботыСКандидатомНаВакансию(КандидатСсылка, КандидатОбъект.Вакансия);
	АнкетыПоЭтапам = АнкетыПоЭтапам(ТекущийОбъект.Ссылка, ТекущийОбъект.Вакансия);
	ОбщегоНазначенияБЗК.ДобавитьИндексКоллекции(АнкетыПоЭтапам, "ЭтапРаботы");
	
	РаботаСКандидатамиНаборЗаписей.Очистить();
	
	// Установим этап "Рассмотрение отклика" в начало
	СтрокиЭтапаРассмотрениеОтклика = ТаблицаЭтапов.НайтиСтроки(
		Новый Структура("ЭтапРаботы", Перечисления.ЭтапыРаботыСКандидатами.РассмотрениеОтклика));
	Если СтрокиЭтапаРассмотрениеОтклика.Количество() <> 0 Тогда
		СтрокаЭтапаРассмотрениеОтклика = СтрокиЭтапаРассмотрениеОтклика[0];
		ТаблицаЭтапов.Сдвинуть(СтрокаЭтапаРассмотрениеОтклика,
			-ТаблицаЭтапов.Индекс(СтрокаЭтапаРассмотрениеОтклика));
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаЭтапов Цикл
		НоваяСтрока = РаботаСКандидатамиНаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.Период = СтрокаТаблицы.ДатаВремя;
		СтрокиАнкеты = АнкетыПоЭтапам.НайтиСтроки(Новый Структура("ЭтапРаботы", СтрокаТаблицы.ЭтапРаботы));
		Если СтрокиАнкеты.Количество() > 0 Тогда
			НоваяСтрока.АнкетаСсылка = СтрокиАнкеты[0].Анкета;
			НоваяСтрока.АнкетаТолькоПросмотр = СтрокиАнкеты[0].ТолькоПросмотр;
		КонецЕсли;
	КонецЦикла;
	
	ПрочитатьТекущийЭтапРаботы();
	ЗаполнитьПредставлениеТекущегоЭтапа();
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя = "СтраницаЛентаСобытий" Тогда
		ЗаполнитьЛентуСобытий();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеЭтапаРаботыНаСервере(РезультатВыбора)
	
	ПодборПерсонала.УстановитьСостояниеЭтапаРаботыКандидатов(РезультатВыбора);
	
	Если РезультатВыбора.ЭтапРаботы.Этап = Перечисления.ЭтапыРаботыСКандидатами.РассмотрениеОтклика
		И РезультатВыбора.ЭтапРаботы.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Пройден
		И КандидатОбъект.Состояние = Перечисления.СостоянияСогласования.Отклонено Тогда
		ОтменитьРешениеНаСервере();
	КонецЕсли;
	
	ЗаписанныйОбъект = КандидатСсылка.ПолучитьОбъект();
	ЗначениеВРеквизитФормы(ЗаписанныйОбъект, "КандидатОбъект");
	
	ПриПолученииДанныхНаСервере(ЗаписанныйОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьРешениеНаСервере()
	
	Кандидаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатСсылка);
	ПодборПерсонала.ОтменитьРешениеПоКандидатам(Кандидаты);
	
	ЗаписанныйОбъект = КандидатСсылка.ПолучитьОбъект();
	ЗначениеВРеквизитФормы(ЗаписанныйОбъект, "КандидатОбъект");
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя = "СтраницаЛентаСобытий" Тогда
		ЗаполнитьЛентуСобытий();
	КонецЕсли;
	
	ПриПолученииДанныхНаСервере(ЗаписанныйОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРешениеНаСервере(РезультатВыбора)
	
	Кандидаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатСсылка);
	ПодборПерсонала.УстановитьРешениеПоКандидатам(Кандидаты, РезультатВыбора);
	
	ЗаписанныйОбъект = КандидатСсылка.ПолучитьОбъект();
	ЗначениеВРеквизитФормы(ЗаписанныйОбъект, "КандидатОбъект");
	
	ПриПолученииДанныхНаСервере(ЗаписанныйОбъект);
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеСотрудника(ДатаПриема)

	Если Не УправлениеДоступом.ЧтениеРазрешено(Сотрудник) Тогда
		Возврат НСтр("ru = 'Информация недоступна'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаПриема) Тогда
		Возврат "";
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудника(Ложь, 
		Сотрудник, "Организация, ДолжностьПоШтатномуРасписанию", ДатаПриема);
	УстановитьПривилегированныйРежим(Ложь);
	Если КадровыеДанные = Неопределено Или Не ЗначениеЗаполнено(КадровыеДанные.Организация) Тогда
		Возврат НСтр("ru = 'Не удалось получить кадровые данные'");
	КонецЕсли;
	
	МужскойПол = НСтр("ru = 'Принят в %1 с %2 на позицию <a href=""%3"">%4</a>'");
	ЖенскийПол = НСтр("ru = 'Принята в %1 с %2 на позицию <a href=""%3"">%4</a>'");
	
	Возврат СтроковыеФункции.ФорматированнаяСтрока(
		?(ЭтоЖенскийПол(ЛичныеДанныеКандидата.Пол), ЖенскийПол, МужскойПол), 
		КадровыеДанные.Организация, 
		Формат(ДатаПриема, "ДЛФ=D"), 
		ПолучитьНавигационнуюСсылку(Сотрудник), 
		КадровыеДанные.ДолжностьПоШтатномуРасписанию)
	
КонецФункции

&НаСервере
Функция ПредставлениеДаты(Дата)
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
	Если НачалоДня(ТекущаяДата) = НачалоДня(Дата) Тогда
		Возврат НСтр("ru = 'сегодня'");
	КонецЕсли;
	
	Если КонецДня(ТекущаяДата) + 1 = НачалоДня(Дата) Тогда
		Возврат НСтр("ru = 'завтра'");
	КонецЕсли;
	
	Если НачалоГода(ТекущаяДата) <> НачалоГода(Дата) Тогда
		Возврат Формат(Дата, "ДЛФ=D");
	КонецЕсли;
	
	Возврат Формат(Дата, "ДФ='д ММММ (ддд)'");
	
КонецФункции

&НаСервере
Функция ПредставлениеПредопределенногоЭтапа(ТекущийЭтап, СтрокаНабора)
	
	Если ТекущийЭтап.ЭтапРаботы = Перечисления.ЭтапыРаботыСКандидатами.Утверждение Тогда
		// Ожидает утверждения (одобрения) Утвердить или Отклонить.
		Возврат СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = 'Ожидает утверждения (одобрения) <a href=""%1"">Утвердить</a> или <a href=""%2"">Отклонить</a>'"), 
			НавигационныеСсылкиФорматированнойСтроки().Утвердить, 
			НавигационныеСсылкиФорматированнойСтроки().Отклонить);
	ИначеЕсли ТекущийЭтап.ЭтапРаботы = Перечисления.ЭтапыРаботыСКандидатами.РешениеОПриемеНаРаботу Тогда
		Если ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.ПустаяСсылка() Тогда
			// Ожидается ввод решения о приеме на работу. Ввести
			Если ПравоДоступа("Добавление", Метаданные.Документы.РешениеОПриемеНаРаботу) Тогда
				Возврат СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = 'Ожидается ввод решения о приеме на работу. <a href=""%1"">Ввести</a>'"), 
					НавигационныеСсылкиФорматированнойСтроки().РешениеОПриемеНаРаботуВвести);
			Иначе
				Возврат НСтр("ru = 'Ожидается ввод решения о приеме на работу'");
			КонецЕсли;
		ИначеЕсли ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Запланирован Тогда
			// Ссылка на документ, не проведен
			Возврат СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru = '<a href=""%1"">%2</a>, не проведен'"), 
				ПолучитьНавигационнуюСсылку(СтрокаНабора.ДокументОснование),
				Строка(СтрокаНабора.ДокументОснование));
		Иначе
			ОбщегоНазначенияКлиентСервер.Проверить(Ложь, 
				СтрШаблон(НСтр("ru = 'Неожиданное состояние %1 для этапа Решение о приеме на работу'"), 
					ТекущийЭтап.Состояние), 
				"Кандидаты.ФормаЭлемента.ПредставлениеПредопределенногоЭтапа");
		КонецЕсли;
	ИначеЕсли ТекущийЭтап.ЭтапРаботы = Перечисления.ЭтапыРаботыСКандидатами.ПриемНаРаботу Тогда
		Если ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.ПустаяСсылка() Тогда
			// Все этапы пройдены, ожидается прием на работу
			Возврат НСтр("ru = 'Ожидается приказ о приеме на работу'");
		ИначеЕсли ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Запланирован Тогда
			// Ссылка на документ, не проведен
			Возврат СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru = '<a href=""%1"">%2</a>, не проведен'"), 
				ПолучитьНавигационнуюСсылку(СтрокаНабора.ДокументОснование),
				Строка(СтрокаНабора.ДокументОснование));
		КонецЕсли;
	ИначеЕсли ТекущийЭтап.ЭтапРаботы = Перечисления.ЭтапыРаботыСКандидатами.РассмотрениеОтклика Тогда
		ЧастиСтроки = Новый Массив;
		Если ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Запланирован Тогда
			// Отклик не отработан
			Если КандидатОбъект.Состояние <> Перечисления.СостоянияСогласования.Отклонено Тогда
				ЧастиСтроки.Добавить(
					Новый ФорматированнаяСтрока(НСтр("ru = 'Кандидат откликнулся сам. Его можно'") + " "));
				ЧастиСтроки.Добавить(
					Новый ФорматированнаяСтрока(НСтр("ru = 'Принять к рассмотрению'"), , , ,
						НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапВыполнить));
				ЧастиСтроки.Добавить(" " + НСтр("ru = 'или'")+ " ");
				ЧастиСтроки.Добавить(
					Новый ФорматированнаяСтрока(НСтр("ru = 'Отклонить'"), , , ,
						НавигационныеСсылкиФорматированнойСтроки().Отклонить));
			Иначе
				ЧастиСтроки.Добавить(
					Новый ФорматированнаяСтрока(НСтр("ru = 'Кандидат откликнулся сам и был отклонен. Его можно'") + " "));
				ЧастиСтроки.Добавить(
					Новый ФорматированнаяСтрока(НСтр("ru = 'Принять к рассмотрению'"), , , ,
						НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапВыполнить));
			КонецЕсли;
		КонецЕсли;
		Возврат Новый ФорматированнаяСтрока(ЧастиСтроки);
	ИначеЕсли ТекущийЭтап.ЭтапРаботы = Перечисления.ЭтапыРаботыСКандидатами.РаботаЗавершена Тогда
		Возврат НСтр("ru = 'Работа с кандидатом по этапам завершена'");
	Иначе
		ОбщегоНазначенияКлиентСервер.Проверить(Ложь, 
			СтрШаблон(НСтр("ru = 'Неожиданный текущий предопределенный этап %1'"), 
				ТекущийЭтап.ЭтапРаботы), 
			"Кандидаты.ФормаЭлемента.ПредставлениеПредопределенногоЭтапа");
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПредставлениенеНеПредопределенногоЭтапа(ТекущийЭтап, СтрокаНабора)
	
	ДобавлятьКоманды = РольДоступнаДобавлениеИзменениеДанныхКандидатов;

	ТекстДатаВремя = СтрШаблон(НСтр("ru = '%1 в %2'"), 
		ПредставлениеДаты(ТекущийЭтап.ДатаВремя), Формат(ТекущийЭтап.ДатаВремя, "ДФ=ЧЧ:мм"));
	
	ЧастиСтроки = Новый Массив;
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = 'Текущий этап «%1»'"), ТекущийЭтап.ЭтапРаботы));
	
	ДобавитьПробел(ЧастиСтроки);
	Если ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Запланирован Тогда
		ЧастиСтроки.Добавить(
			СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru = 'запланирован <a href=""%1"">%2</a>'"), 
				НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапЗапланировать, 
				ТекстДатаВремя));
	Иначе
		Если ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Пройден Тогда
			ЧастиСтроки.Добавить(
				СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = 'пройден <a href=""%1"">%2</a>'"), 
					НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапВыполнить, 
					ТекстДатаВремя));
			ДобавлятьКоманды = Ложь;
		ИначеЕсли ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Пропущен Тогда
			ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = 'пропущен %1'"), ТекстДатаВремя));
			ДобавлятьКоманды = Ложь;
		Иначе
			ЧастиСтроки.Добавить(НСтр("ru = 'пока не запланирован'"));
			Если ДобавлятьКоманды Тогда
				ДобавитьПробел(ЧастиСтроки);
				ЧастиСтроки.Добавить(
					Новый ФорматированнаяСтрока(НСтр("ru = 'Запланировать'"), , , , 
						НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапЗапланировать));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ДобавлятьКоманды Тогда
		ДобавитьПробел(ЧастиСтроки);
		Если ЗначениеЗаполнено(СвойствоСтруктуры(СтрокаНабора, "ШаблонАнкеты")) Тогда
			ЧастиСтроки.Добавить(
				Новый ФорматированнаяСтрока(НСтр("ru = 'Пройти'"), , , , 
					НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапПройти));	
		Иначе
			ЧастиСтроки.Добавить(
				Новый ФорматированнаяСтрока(НСтр("ru = 'Отметить пройденным'"), , , , 
					НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапВыполнить));
		КонецЕсли;
		ДобавитьПробел(ЧастиСтроки);
		ЧастиСтроки.Добавить(
			Новый ФорматированнаяСтрока(НСтр("ru = 'Пропустить'"), , , , 
				НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапПропустить));
	КонецЕсли;
	
	Возврат Новый ФорматированнаяСтрока(ЧастиСтроки);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаНавигационнойСсылкиТекущийЭтапЗапланировать(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки <> НавигационныеСсылкиФорматированнойСтроки().ТекущийЭтапЗапланировать Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	НачатьУстановкуСостоянияТекущегоЭтапаРаботы(ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Запланирован"));
	
КонецПроцедуры

