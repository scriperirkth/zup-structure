&НаКлиенте
Процедура ОжидаемыйДоходПриИзменении(Элемент)
	
	ИсторияОжидаемогоДохода.Очистить();
	ОтобразитьОжидаемыйДоходПоУмолчанию(ЭтотОбъект);
	ПересчитыватьОжидаемыйДоход = Ложь;
	ЗаполнитьОжидаемыйДоход(КандидатОбъект, Элементы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(КандидатОбъект.ВалютаДохода) Тогда
		КандидатОбъект.ВалютаДохода = ЗарплатаКадрыВызовСервера.ВалютаУчетаЗаработнойПлаты();
	КонецЕсли;
	ОтобразитьОжидаемыйДоходПоУмолчанию(ЭтотОбъект); 
	ЗаполнитьОжидаемыйДоход(КандидатОбъект, Элементы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьДоходаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(КандидатОбъект.ПериодичностьДохода) Тогда
		КандидатОбъект.ПериодичностьДохода = ПредопределенноеЗначение("Перечисление.ПериодичностьОжидаемогоДоходаКандидатов.Месяц");
	КонецЕсли;
	ОтобразитьОжидаемыйДоходПоУмолчанию(ЭтотОбъект); 
	ЗаполнитьОжидаемыйДоход(КандидатОбъект, Элементы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ПересчитыватьОжидаемыйДоход Тогда
		Возврат;
	КонецЕсли;
	
	ОжидаемыйДоходВИстории = ОжидаемыйДоходВИстории(ВыбранноеЗначение, КандидатОбъект.ПериодичностьДохода);
	Если ОжидаемыйДоходВИстории <> Неопределено Тогда
		КандидатОбъект.ОжидаемыйДоход = ОжидаемыйДоходВИстории;
	Иначе
		ПодборПерсоналаКлиентСервер.РассчитатьДоходПоВалюте(
			КандидатОбъект.ОжидаемыйДоход, КандидатОбъект.ВалютаДохода, ВыбранноеЗначение);
		СохранитьОжидаемыйДоход(ЭтотОбъект, 
			КандидатОбъект.ОжидаемыйДоход, ВыбранноеЗначение, КандидатОбъект.ПериодичностьДохода);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьДоходаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ПересчитыватьОжидаемыйДоход Тогда
		Возврат;
	КонецЕсли;
	
	ОжидаемыйДоходВИстории = ОжидаемыйДоходВИстории(КандидатОбъект.ВалютаДохода, ВыбранноеЗначение);
	Если ОжидаемыйДоходВИстории <> Неопределено Тогда
		КандидатОбъект.ОжидаемыйДоход = ОжидаемыйДоходВИстории;
	Иначе
		ПодборПерсоналаКлиентСервер.РассчитатьДоходПоПериодичности(
			КандидатОбъект.ОжидаемыйДоход, КандидатОбъект.ПериодичностьДохода, ВыбранноеЗначение);
		СохранитьОжидаемыйДоход(ЭтотОбъект, 
			КандидатОбъект.ОжидаемыйДоход, КандидатОбъект.ВалютаДохода, ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФотографияНажатие(Элемент, СтандартнаяОбработка)
	СотрудникиКлиентРасширенный.ФизическиеЛицаАдресФотографииНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ФИОИспользуетсяПриИзменении(Элемент)
	
	ПоказыватьПредупреждение = ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("НастройкиПрограммы",
		"ПоказыватьПредупреждениеОПустомФИОКандидата", Истина);
	
	Если Не ФИОИспользуется И ПоказыватьПредупреждение Тогда
		
		ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
		ПараметрыВопроса.Картинка = БиблиотекаКартинок.Информация32;
		ПараметрыВопроса.ТекстФлажка = НСтр("ru = 'Больше не предупреждать'");
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.ОК);
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		Если ЗначениеЗаполнено(ЛичныеДанныеКандидата.ФИО) Тогда
			
			ПараметрыВопроса.Заголовок = НСтр("ru = 'Стереть данные?'");
			ТекстВопроса =
				НСтр("ru = 'Поле ""ФИО"" будет очищено,
				| а представление кандидата в списке будет формироваться автоматически.
				| После того как ФИО станет известно, измените положение переключателя.'");
			
		Иначе
			ПараметрыВопроса.Заголовок = НСтр("ru = 'Отсутствует ФИО?'");
			ТекстВопроса =
				НСтр("ru = 'Если в резюме кандидата нет ФИО, то его представление в списке будет формироваться автоматически.
				| После того как ФИО станет известно, измените положение переключателя.'");
		КонецЕсли;
		
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
			Новый ОписаниеОповещения("ФИОИспользуетсяПриИзмененииЗавершение", ЭтотОбъект),
				СтрЗаменить(ТекстВопроса, Символы.ПС, ""), Кнопки, ПараметрыВопроса);
				
	Иначе
		ФИОИспользуетсяПриИзмененииЗавершение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНастройкаЛентыНажатие(Элемент)
	
	ОткрытьФорму("Справочник.Кандидаты.Форма.НастройкаЛентыСобытий",,,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПозицияПриИзменении(Элемент)
	
	ДанныеПозиции = ДанныеПозиции(КандидатОбъект.Позиция);
	КандидатОбъект.Подразделение = ДанныеПозиции.МестоВСтруктуреПредприятия;
	
	УстановитьДоступностьПодразделения(ЭтотОбъект);
	
