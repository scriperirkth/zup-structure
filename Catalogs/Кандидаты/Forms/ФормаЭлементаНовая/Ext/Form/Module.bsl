КонецПроцедуры

&НаКлиенте
Процедура НачатьПринятиеРешения(Решение)
	
	Если Не Модифицированность Тогда
		ПоказатьФормуПринятияРешения(Решение);
		Возврат;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура("Решение");
	ПараметрыОповещения.Решение = Решение;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ПринятьРешениеПослеВопросаЗаписать", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопросЗаписиКандидата(ОбработчикОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОтменуРешения()
	
	Если Не Модифицированность Тогда
		ОтменитьРешениеНаКлиенте();
		Возврат;
	КонецЕсли;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОтменитьРешениеПослеВопросаЗаписать", ЭтотОбъект);
	ПоказатьВопросЗаписиКандидата(ОбработчикОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьРешениеПослеВопросаЗаписать(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьФормуПринятияРешения(ДополнительныеПараметры.Решение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФормуПринятияРешения(Решение)
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ЗавершитьПринятиеРешения", ЭтотОбъект);
	
	Кандидаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатСсылка);
	ПодборПерсоналаКлиент.НачатьПринятиеРешенияПоКандидату(Кандидаты, Решение, ОбработчикОповещения, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПринятиеРешения(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьРешениеНаСервере(РезультатВыбора);
	
	ОповеститьОРешении();
	
	Если РезультатВыбора.РешениеОПриемеНаРаботу.Создавать Тогда
		НачатьВводНовогоРешенияОПриемеНаРаботу(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРешениеПослеВопросаЗаписать(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	ОтменитьРешениеНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРешениеНаКлиенте()
	
	ОтменитьРешениеНаСервере();
	
	ОповеститьОРешении();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОРешении()
	
	ПараметрыОповещения = Новый Структура("Кандидаты, Вакансии");
	ПараметрыОповещения.Кандидаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатСсылка);
	ПараметрыОповещения.Вакансии = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатОбъект.Вакансия);
	
	Оповестить("РешениеПоКандидату", ПараметрыОповещения, ЭтотОбъект);
	ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъектов(ПараметрыОповещения.Кандидаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросЗаписиКандидата(ОбработчикОповещения)
	
	ТекстВопроса = НСтр("ru = 'Данные кандидата не записаны.
                         |Для продолжения данные кандидата необходимо записать.'");
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Записать и продолжить'"));
	СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
	ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, СписокКнопок);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПрохождениеЭлектронногоИнтервьюТекущегоЭтапаРаботы()
	
	СтрокаНабора = НайтиСтрокуРаботыСКандидатом(ЭтотОбъект, ТекущийЭтап);
	НачатьПрохождениеЭлектронногоИнтервьюЭтапаРаботы(СтрокаНабора);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПрохождениеЭлектронногоИнтервьюЭтапаРаботы(ДанныеЭтапа)
	
	Если Не Модифицированность Тогда
		ПройтиЭлектронноеИнтервьюЭтапаРаботы(ДанныеЭтапа);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ДанныеЭтапа");
	ДополнительныеПараметры.ДанныеЭтапа = ДанныеЭтапа;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ПройтиЭлектронноеИнтервьюТекущегоЭтапаРаботыПослеВопросаЗаписать",
		ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопросЗаписиКандидата(ОбработчикОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПройтиЭлектронноеИнтервьюТекущегоЭтапаРаботыПослеВопросаЗаписать(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	ПройтиЭлектронноеИнтервьюЭтапаРаботы(ДополнительныеПараметры.ДанныеЭтапа);
	
КонецПроцедуры

&НаКлиенте
Процедура ПройтиЭлектронноеИнтервьюЭтапаРаботы(ДанныеЭтапа)
	
	Если Не ЗначениеЗаполнено(ДанныеЭтапа.АнкетаСсылка) Или ДанныеЭтапа.АнкетаТолькоПросмотр Тогда
		ЭлектронноеИнтервьюКлиент.НачатьИнтервью(
			КандидатСсылка, ЛичныеДанныеКандидатаСсылка, ДанныеЭтапа.ЭтапРаботы, ДанныеЭтапа.ШаблонАнкеты);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТолькоФормаЗаполнения", Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
	ПараметрыФормы.Вставить("Ключ", ДанныеЭтапа.АнкетаТолькоПросмотр);
	ПараметрыФормы.Вставить("ВозможностьПредварительногоСохранения", Истина);
	ОткрытьФорму("Документ.Анкета.ФормаОбъекта", ПараметрыФормы);	
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОтменуЭтапаРаботы(ТекущиеДанные)
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СостояниеЭтапа) Тогда
		// Не нужно отменять этап, у которого и так пустое состояние.
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.Утверждение") Тогда
		НачатьОтменуРешения();
		Возврат;
	ИначеЕсли ТекущиеДанные.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.РешениеОПриемеНаРаботу") Тогда
		НачатьОтменуРешенияОПриемеНаРаботу(ТекущиеДанные.ДокументОснование);
		Возврат;
	ИначеЕсли ТекущиеДанные.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.ПриемНаРаботу") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.СостояниеЭтапа = ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Пропущен") Тогда
		// Не спрашиваем, чтобы отменить пропущенный этап.
		ТекущиеДанные.Период = Неопределено;
		НачатьУстановкуСостоянияЭтапаРаботы(Неопределено, ТекущиеДанные, Ложь);
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.СостояниеЭтапа = ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Пройден") Тогда
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Этап «%1» отмечен как пройденный кандидатом. 
                  |При отмене этого результата убедитесь, что уведомлены все заинтересованные стороны.'"), 
			ТекущиеДанные.ЭтапРаботы);
		Если ЗначениеЗаполнено(ТекущиеДанные.ШаблонАнкеты) Тогда
			ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru = 'Кроме того, действие приведет к отмене результатов интервью по этому этапу.'");
		КонецЕсли;
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru = 'Продолжить?'");
	ИначеЕсли ТекущиеДанные.СостояниеЭтапа = ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Запланирован") Тогда
		ТекстВопроса = НСтр("ru = 'При отмене запланированного этапа убедитесь, что уведомлены все заинтересованные стороны.
                             |Продолжить?'"); 
		
	КонецЕсли;
	
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Отменить этап'"));
	СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
	
	ДополнительныеПараметры = Новый Структура("ДанныеЭтапа");
	ДополнительныеПараметры.ДанныеЭтапа = ТекущиеДанные;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОтменитьЭтапПослеВопросаПодтверждения", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, СписокКнопок);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьЭтапПослеВопросаПодтверждения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ДанныеЭтапа.Период = Неопределено;
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ДанныеЭтапа.ИдентификаторВидеоконференции) Тогда
		ВидеособеседованияКлиент.ПриОтменеЭтапа(ЭтотОбъект, ДополнительныеПараметры.ДанныеЭтапа);
	КонецЕсли;
	
	НачатьУстановкуСостоянияЭтапаРаботы(Неопределено, ДополнительныеПараметры.ДанныеЭтапа, Ложь);
	ОтменитьАнкетуКандидата(КандидатСсылка, КандидатОбъект.Вакансия, ДополнительныеПараметры.ДанныеЭтапа.ЭтапРаботы);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьУстановкуСостоянияТекущегоЭтапаРаботы(СостояниеЭтапа, ОткрыватьФорму = Истина)
	СтрокаНабора = НайтиСтрокуРаботыСКандидатом(ЭтотОбъект, ТекущийЭтап);
	НачатьУстановкуСостоянияЭтапаРаботы(СостояниеЭтапа, СтрокаНабора, ОткрыватьФорму);
КонецПроцедуры

&НаКлиенте
Процедура НачатьУстановкуСостоянияЭтапаРаботы(СостояниеЭтапа, ДанныеЭтапа, ОткрыватьФорму = Истина)
	
	Если ИспользоватьОграничениеПоГруппамДоступа
		И ТекущийЭтап.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.РассмотрениеОтклика")
		И Не ЗначениеЗаполнено(ЛичныеДанныеКандидата.ГруппаДоступа) Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Для продолжения работы с кандидатом необходимо заполнить группу доступа'"), ,
			"ЛичныеДанныеКандидата.ГруппаДоступа");
		Возврат;
	КонецЕсли;
	
	Если Не Модифицированность Тогда
		УстановитьСостояниеЭтапаРаботы(СостояниеЭтапа, ДанныеЭтапа, ОткрыватьФорму);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура(
		"СостояниеЭтапа, 
		|ДанныеЭтапа,
		|ОткрыватьФорму");
	ДополнительныеПараметры.СостояниеЭтапа = СостояниеЭтапа;
	ДополнительныеПараметры.ДанныеЭтапа = ДанныеЭтапа;
	ДополнительныеПараметры.ОткрыватьФорму = ОткрыватьФорму;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("УстановитьСостояниеЭтапаРаботыПослеВопросаЗаписать",
		ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопросЗаписиКандидата(ОбработчикОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЭтапаРаботыПослеВопросаЗаписать(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСостояниеЭтапаРаботы(ДополнительныеПараметры.СостояниеЭтапа, ДополнительныеПараметры.ДанныеЭтапа, 
		ДополнительныеПараметры.ОткрыватьФорму);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьИзменениеСостоянияЭтапаРаботы(ДанныеЭтапа)
	
	Если Не Модифицированность Тогда
		ИзменитьСостояниеЭтапаРаботы(ДанныеЭтапа);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ДанныеЭтапа");
	ДополнительныеПараметры.ДанныеЭтапа = ДанныеЭтапа;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ИзменитьСостояниеЭтапаРаботыПослеВопросаЗаписать", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопросЗаписиКандидата(ОбработчикОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСостояниеЭтапаРаботыПослеВопросаЗаписать(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьСостояниеЭтапаРаботы(ДополнительныеПараметры.ДанныеЭтапа);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСостояниеЭтапаРаботы(ДанныеЭтапа)
	
	ПараметрыФормы = ПодборПерсоналаКлиентСервер.ПараметрыРедактированияЭтапаРаботыСКандидатом();
	ПараметрыФормы.Кандидаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатСсылка);
	ПараметрыФормы.СостояниеЭтапа = ДанныеЭтапа.СостояниеЭтапа;
	ПараметрыФормы.ЭтапРаботы = ДанныеЭтапа.ЭтапРаботы;
	ПараметрыФормы.Период = ДанныеЭтапа.Период;
	ПараметрыФормы.ТолькоПросмотр = Не РольДоступнаДобавлениеИзменениеДанныхКандидатов;
	ПараметрыФормы.ШаблонАнкеты = ДанныеЭтапа.ШаблонАнкеты;
	ПараметрыФормы.Комментарий = ДанныеЭтапа.Комментарий;
	ПараметрыФормы.Организатор = ДанныеЭтапа.Организатор;
	ПараметрыФормы.Бронь = ДанныеЭтапа.Бронь;
	ПараметрыФормы.УчетнаяЗаписьВидеоконференции = ДанныеЭтапа.УчетнаяЗаписьВидеоконференции;
	ПараметрыФормы.ИдентификаторВидеоконференции = ДанныеЭтапа.ИдентификаторВидеоконференции;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("УстановитьСостояниеЭтапаРаботыПослеВыбора", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.РаботаСКандидатами.Форма.ЭтапРаботыСКандидатом", ПараметрыФормы, ЭтотОбъект, 
		ЭтотОбъект, , , ОбработчикОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЭтапаРаботы(Состояние, ДанныеЭтапа, ОткрыватьФорму = Истина)
	
	Если Не ОткрыватьФорму Тогда
		Результат = ПодборПерсоналаКлиентСервер.РезультатУстановкиЭтапаРаботыСКандидатом();
		Результат.Кандидаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатСсылка);
		Результат.ЭтапРаботы.Этап = ДанныеЭтапа.ЭтапРаботы;
		Результат.ЭтапРаботы.Состояние = Состояние;
		Результат.ЭтапРаботы.Период = ДанныеЭтапа.Период;
		Если Не ЗначениеЗаполнено(ДанныеЭтапа.Период) Тогда
			Результат.ЭтапРаботы.Период = ОбщегоНазначенияКлиент.ДатаСеанса();
		КонецЕсли;
		УстановитьСостояниеЭтапаРаботыНаСервере(Результат);
		ОповеститьОбИзмененииЭтапаРаботы();
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = ПодборПерсоналаКлиентСервер.ПараметрыРедактированияЭтапаРаботыСКандидатом();
	ПараметрыФормы.Кандидаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатСсылка);
	ПараметрыФормы.СостояниеЭтапа = Состояние;
	ПараметрыФормы.ЭтапРаботы = ДанныеЭтапа.ЭтапРаботы;
	ПараметрыФормы.ТолькоПросмотр = Не РольДоступнаДобавлениеИзменениеДанныхКандидатов;
	ПараметрыФормы.ШаблонАнкеты = ДанныеЭтапа.ШаблонАнкеты;
	ПараметрыФормы.Комментарий = ДанныеЭтапа.Комментарий;
	ПараметрыФормы.УчетнаяЗаписьВидеоконференции = ДанныеЭтапа.УчетнаяЗаписьВидеоконференции;
	ПараметрыФормы.ИдентификаторВидеоконференции = ДанныеЭтапа.ИдентификаторВидеоконференции;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("УстановитьСостояниеЭтапаРаботыПослеВыбора", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.РаботаСКандидатами.Форма.ЭтапРаботыСКандидатом", ПараметрыФормы, ЭтотОбъект, 
		ЭтотОбъект, , , ОбработчикОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЭтапаРаботыПослеВыбора(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСостояниеЭтапаРаботыНаСервере(РезультатВыбора);
	ОповеститьОбИзмененииЭтапаРаботы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОбИзмененииЭтапаРаботы()
	
	Оповестить("ИзмененЭтапРаботыСКандидатом", ПараметрыОповещения(), ЭтотОбъект);
	ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъекта(КандидатСсылка, ПараметрыОповещения()); 
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя = "СтраницаЛентаСобытий" Тогда
		ЗаполнитьЛентуСобытий();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьВводНовогоРешенияОПриемеНаРаботу(ЗадаватьВопрос)
	
	Если Не ЗадаватьВопрос Или Не ЗадаватьВопросОВводеНовогоРешенияОПриемеНаРаботу() Тогда
		КадровыеРешенияКлиентРасширенный.ОткрытьФормуНовогоРешенияОПриемеНаРаботу(КандидатСсылка);
		Возврат;
	КонецЕсли;
	
	КнопкиОтвета = Новый СписокЗначений();
	КнопкиОтвета.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Продолжить'"));
	КнопкиОтвета.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Создание нового документа'");
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Истина;

	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗавершитьВводНовогоРешенияОПриемеНаРаботу", ЭтотОбъект), 
		НСтр("ru = 'На этого кандидата будет введен и заполнен новый документ «Решение о приеме на работу»'"), 
		КнопкиОтвета,
		ПараметрыВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводНовогоРешенияОПриемеНаРаботу(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = Неопределено Или Ответ.Значение <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ.БольшеНеЗадаватьЭтотВопрос Тогда
		СохранитьЗадаватьВопросОВводеНовогоРешенияОПриемеНаРаботу(Ложь);
	КонецЕсли;
	
	КадровыеРешенияКлиентРасширенный.ОткрытьФормуНовогоРешенияОПриемеНаРаботу(КандидатСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОтменуРешенияОПриемеНаРаботу(РешениеОПриемеНаРаботу)

	КнопкиОтвета = Новый СписокЗначений();
	КнопкиОтвета.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Продолжить'"));
	КнопкиОтвета.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Отмена решения о приеме на работу'");

	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗавершитьОтменуРешенияОПриемеНаРаботу", 
			ЭтотОбъект, Новый Структура("РешениеОПриемеНаРаботу", РешениеОПриемеНаРаботу)), 
		СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = 'Проведение документа <a href=""%1"">«%2»</a> будет отменено. 
				 |Не проведенный документ по-прежнему будет доступен по ссылке.
				 |Чтобы документ перестал отображаться, можно пометить его на удаление'"), 
			ПолучитьНавигационнуюСсылку(РешениеОПриемеНаРаботу), 
			РешениеОПриемеНаРаботу), 
		КнопкиОтвета,
		ПараметрыВопроса);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОтменуРешенияОПриемеНаРаботу(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = Неопределено Или Ответ.Значение <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОтменитьРешениеОПриемеНаРаботу(ДополнительныеПараметры.РешениеОПриемеНаРаботу);
	
	ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъекта(ДополнительныеПараметры.РешениеОПриемеНаРаботу, 
		Новый Структура("Кандидат", КандидатСсылка));
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьКарточкуЭтапа(Элемент)
	
	НомерЭтапа = СтрЗаменить(Элемент.Имя, "ПолосаЭтап", "");
	НомерЭтапа = СтрЗаменить(НомерЭтапа, "ДекорацияТекстРаботаСКандидатом", "");
	
	ТекущиеДанные = РаботаСКандидатамиНаборЗаписей[Число(НомерЭтапа)];
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбработатьВыборЭтапаУтверждение(ТекущиеДанные) Тогда
	ИначеЕсли ОбработатьВыборЭтапаРешениеОПриемеНаРаботу(ТекущиеДанные) Тогда
	ИначеЕсли ОбработатьВыборЭтапаПриемНаРаботу(ТекущиеДанные) Тогда
	Иначе
		Если ЗначениеЗаполнено(ТекущиеДанные.СостояниеЭтапа) Тогда
			НачатьИзменениеСостоянияЭтапаРаботы(ТекущиеДанные);
		Иначе
			НачатьУстановкуСостоянияЭтапаРаботы(
				ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Запланирован"), ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОбработатьВыборЭтапаУтверждение(ДанныеЭтапа)
	
	Если ДанныеЭтапа.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.Утверждение") Тогда
		НачатьПринятиеРешения(ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Согласовано"));
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ОбработатьВыборЭтапаРешениеОПриемеНаРаботу(ДанныеЭтапа)

	Если ДанныеЭтапа.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.РешениеОПриемеНаРаботу") Тогда
		Если ЗначениеЗаполнено(ДанныеЭтапа.ДокументОснование) Тогда
			ПоказатьЗначение(, ДанныеЭтапа.ДокументОснование);
		Иначе
			НачатьВводНовогоРешенияОПриемеНаРаботу(Истина);
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция ОбработатьВыборЭтапаПриемНаРаботу(ДанныеЭтапа)

	Если ДанныеЭтапа.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.ПриемНаРаботу") Тогда
		Если ЗначениеЗаполнено(ДанныеЭтапа.ДокументОснование) Тогда
			ПоказатьЗначение(, ДанныеЭтапа.ДокументОснование);
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция ПараметрыОповещения()
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("Кандидаты", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатСсылка));
	ПараметрыОповещения.Вставить("Вакансии", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатОбъект.Вакансия));
	ПараметрыОповещения.Вставить("ДляЗаписи", ДляЗаписи);
	
	Если ЗначениеЗаполнено(ФизическоеЛицоСсылка) Тогда
		ПараметрыОповещения.Вставить("ФизическоеЛицо", ФизическоеЛицоСсылка);
	КонецЕсли;
	
	Возврат ПараметрыОповещения;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПолосуЭтапов(ЭтапыРаботы, ТекущийЭтап, КандидатОтклонен, Элементы) 
	
	ПодчиненныеЭлементы = Элементы["ГруппаПолосаЭтапов"].ПодчиненныеЭлементы;
	Пока ПодчиненныеЭлементы.Количество() <> 0 Цикл
		Элементы.Удалить(ПодчиненныеЭлементы[0]);
	КонецЦикла;
	
	НомерЭтапа = 0;
	Для Каждого ЭтапРаботы Из ЭтапыРаботы Цикл
		Если НомерЭтапа <> 0 Тогда
			НовыйЭлемент = Элементы.Добавить("ПолосаСоединение" + НомерЭтапа, Тип("ДекорацияФормы"), Элементы.ГруппаПолосаЭтапов);
			НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
			НовыйЭлемент.Картинка = БиблиотекаКартинок.ПолосаЭтаповСоединение;
		КонецЕсли;
		
		НовыйЭлемент = Элементы.Добавить("ПолосаЭтап" + НомерЭтапа, Тип("ДекорацияФормы"), Элементы.ГруппаПолосаЭтапов);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
		НовыйЭлемент.Гиперссылка = Истина;
		НовыйЭлемент.Картинка = КартинкаПолосыЭтапов(ЭтапРаботы, ТекущийЭтап, КандидатОтклонен);
		НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_ОткрытьКарточкуЭтапа");
		НовыйЭлемент.Подсказка = СтрШаблон(НСтр("ru = '%1%2'"),
			ЭтапРаботы.ЭтапРаботы,
			?(ЗначениеЗаполнено(ЭтапРаботы.Период), ", " + Формат(ЭтапРаботы.Период, "ДФ='dd.MM.yyyy ЧЧ:мм'"), ""));
		НомерЭтапа = НомерЭтапа + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьРешениеОПриемеНаРаботу(РешениеОПриемеНаРаботу)
	ДокументОбъект = РешениеОПриемеНаРаботу.ПолучитьОбъект(); // ДокументОбъект.РешениеОПриемеНаРаботу
	ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьЗадаватьВопросОВводеНовогоРешенияОПриемеНаРаботу(ЗадаватьВопрос)
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		Метаданные.Справочники.Кандидаты.Формы.ФормаЭлементаНовая.ПолноеИмя(), 
		"ЗадаватьВопросОВводеНовогоРешенияОПриемеНаРаботу", 
		ЗадаватьВопрос);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗадаватьВопросОВводеНовогоРешенияОПриемеНаРаботу()
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		Метаданные.Справочники.Кандидаты.Формы.ФормаЭлементаНовая.ПолноеИмя(),
		"ЗадаватьВопросОВводеНовогоРешенияОПриемеНаРаботу", 
		Истина);
КонецФункции

&НаСервереБезКонтекста
Функция КартинкаПолосыЭтапов(ЭтапРаботы, ТекущийЭтап, КандидатОтклонен)
	
	Если ЭтапРаботы.ЭтапРаботы = ТекущийЭтап Тогда
		КартинкаПолосыЭтапов = БиблиотекаКартинок.ПолосаЭтаповТекущий;
	ИначеЕсли ЭтапРаботы.СостояниеЭтапа = Перечисления.СостоянияЭтаповРаботыСКандидатами.Пройден Тогда
		КартинкаПолосыЭтапов = БиблиотекаКартинок.ПолосаЭтаповПройден;
	ИначеЕсли ЭтапРаботы.СостояниеЭтапа = Перечисления.СостоянияЭтаповРаботыСКандидатами.Пропущен Тогда
		КартинкаПолосыЭтапов = БиблиотекаКартинок.ПолосаЭтаповПропущен;
	ИначеЕсли КандидатОтклонен Тогда
		КартинкаПолосыЭтапов = БиблиотекаКартинок.ПолосаЭтаповОтклонен;
		КандидатОтклонен = Ложь;
	Иначе
		КартинкаПолосыЭтапов = БиблиотекаКартинок.ПолосаЭтаповПустой;
	КонецЕсли;
	
	Возврат КартинкаПолосыЭтапов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НавигационныеСсылкиФорматированнойСтроки()
	
	Структура = Новый Структура();
	Структура.Вставить("ТекущийЭтапЗапланировать", "ТекущийЭтапЗапланировать");
	Структура.Вставить("ТекущийЭтапВыполнить", "ТекущийЭтапВыполнить");
	Структура.Вставить("ТекущийЭтапПройти", "ТекущийЭтапПройти");
	Структура.Вставить("ТекущийЭтапПройти", "ТекущийЭтапПройти");
	Структура.Вставить("ТекущийЭтапПропустить", "ТекущийЭтапПропустить");
	Структура.Вставить("Утвердить", "Утвердить");
	Структура.Вставить("Отклонить", "Отклонить");
	Структура.Вставить("РешениеОПриемеНаРаботуВвести", "РешениеОПриемеНаРаботуВвести");
	Возврат Структура;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НайтиСтрокуРаботыСКандидатом(Форма, ТекущийЭтап)
	
	Если Не ЗначениеЗаполнено(ТекущийЭтап.ЭтапРаботы) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденныеСтроки = Форма.РаботаСКандидатамиНаборЗаписей.НайтиСтроки(
		Новый Структура("ЭтапРаботы", ТекущийЭтап.ЭтапРаботы));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат НайденныеСтроки[0];
	
КонецФункции

