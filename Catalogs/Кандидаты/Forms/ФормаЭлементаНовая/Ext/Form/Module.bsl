&НаСервере
Процедура ЗаполнитьДанныеКандидата()
	
	Если Параметры.Свойство("ДанныеКандидата") Тогда
		СправочникОбъект = РеквизитФормыВЗначение("КандидатОбъект");
		СправочникОбъект.Заполнить(Параметры.ДанныеКандидата);
		СправочникОбъект.Заполнить(Параметры.ЗначенияЗаполнения);
		ЗначениеВРеквизитФормы(СправочникОбъект, "КандидатОбъект");
		КандидатСсылка = СправочникОбъект.ДополнительныеСвойства.КандидатСсылка;
		ПриПолученииДанныхНаСервере(СправочникОбъект);
		УстановитьВидимостьПолученияКонтактов(ЭтотОбъект, Параметры.ДанныеКандидата.ДоступностьКонтактов);
		ВыполнятьПроверкуОднофамильцев = Истина;
	ИначеЕсли ОбщегоНазначенияБЗККлиентСервер.ЗначениеСвойства(Параметры,
		"ЗначенияЗаполнения.ФизическоеЛицо") <> Неопределено Тогда
		СправочникОбъект = РеквизитФормыВЗначение("КандидатОбъект");
		СправочникОбъект.Заполнить(Параметры.ЗначенияЗаполнения);
		ЗначениеВРеквизитФормы(СправочникОбъект, "КандидатОбъект");
		ПриПолученииДанныхНаСервере(СправочникОбъект);
		ВыполнятьПроверкуОднофамильцев = Ложь;
		ФизическоеЛицоСсылка = Параметры.ЗначенияЗаполнения.ФизическоеЛицо;
	КонецЕсли;
	
	// Если личные данные кандидата были указаны в обработке заполнения.
	Если КандидатОбъект.ЛичныеДанные.Пустая() Тогда
		// Генерируем ссылку, при записи установим ее объекту.
		КандидатОбъект.ЛичныеДанные = Справочники.ЛичныеДанныеКандидатов.ПолучитьСсылку();
		ВыполнятьПроверкуОднофамильцев = Истина;
	КонецЕсли;
	
	// Получаем ссылку нового.
	Если КандидатСсылка.Пустая() Тогда
		КандидатСсылка = Справочники.Кандидаты.ПолучитьСсылку();
		ПриПолученииДанныхНаСервере();
	КонецЕсли;
	
	СкрытьКомандуСоздатьКандидата();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьTelegram(Форма)
	
	Если ЗначениеЗаполнено(Форма.КонтактнаяИнформацияПолеTelegramЛичныеДанныеКандидатов) Тогда
		Форма.Элементы.Telegram.Видимость = Истина;
		Если Лев(Форма.КонтактнаяИнформацияПолеTelegramЛичныеДанныеКандидатов, 1) <> "@" Тогда
			Форма.Элементы.ПредупреждениеTelegram.Видимость = Истина;
		Иначе
			Форма.Элементы.ПредупреждениеTelegram.Видимость = Ложь;
		КонецЕсли;
	Иначе
		Форма.Элементы.Telegram.Видимость = Ложь;
		Форма.Элементы.ПредупреждениеTelegram.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

