		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
		НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '%1 - %2'"),
			ЗнаниеЯзыка.Язык,
			ЗнаниеЯзыка.СтепеньЗнанияЯзыкаКандидата);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьУченыеСтепени(УченыеСтепени, Элементы)
	
	Если УченыеСтепени.Количество() = 0 Тогда
		БезУченыхСтепеней = Истина;
		ЗаголовокРедактироватьУченыеСтепени = НСтр("ru = 'Добавить ученые степени'");
	Иначе
		БезУченыхСтепеней = Ложь;
		ЗаголовокРедактироватьУченыеСтепени = НСтр("ru = 'Редактировать'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияУченыеСтепени", "Видимость", БезУченыхСтепеней);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаРедактироватьУченыеСтепени", "Заголовок", ЗаголовокРедактироватьУченыеСтепени);
	
	Для Каждого УченаяСтепень Из УченыеСтепени Цикл
		ИмяГруппы = "ГруппаУченаяСтепень" + УченаяСтепень.НомерСтроки;
		Группа = Элементы.Найти(ИмяГруппы);
		Если Группа <> Неопределено Тогда
			Элементы.Удалить(Группа);
		КонецЕсли;
		Группа = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Элементы.ГруппаУченыеСтепени);
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.ОтображатьЗаголовок = Ложь;
		
		НовыйЭлемент = Элементы.Добавить("УченаяСтепень" + УченаяСтепень.НомерСтроки, Тип("ДекорацияФормы"), Группа);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
		НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '%1, %2'"),
			УченаяСтепень.УченаяСтепень,
			Формат(Год(УченаяСтепень.ДатаПрисужденияУченойСтепени), "ЧГ=") + " г.");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКандидатОСебе(Кандидат, Элементы)
	
	ЕстьСопроводительноеПисьмо = ЗначениеЗаполнено(Кандидат.СопроводительноеПисьмо);
	Если ЗначениеЗаполнено(Кандидат.ОСебе) Тогда
		ОСебе = Кандидат.ОСебе;
		ЗаголовокРедактироватьКандидатОСебе = НСтр("ru = 'Редактировать'");
	Иначе
		Если ЕстьСопроводительноеПисьмо Тогда
			ОСебе = "";
		Иначе
			ОСебе = НСтр("ru = 'Информация не указана'");
		КонецЕсли;
		ЗаголовокРедактироватьКандидатОСебе = НСтр("ru = 'Добавить информацию о кандидате'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияОСебе", "Видимость", ЗначениеЗаполнено(ОСебе));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияОСебе", "Заголовок", ОСебе);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаРедактироватьКандидатОСебе", "Заголовок", ЗаголовокРедактироватьКандидатОСебе);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияСопроводительноеПисьмо", "Видимость", ЕстьСопроводительноеПисьмо);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияСопроводительноеПисьмо", "Заголовок",
		СтрШаблон(НСтр("ru = 'В сопроводительном письме:%1%1%2'"), Символы.ПС, Кандидат.СопроводительноеПисьмо));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтажПоОпытуРаботы(ДатаНачала, ДатаОкончания)
	
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ДатаОтсчетаВозраста();
	КонецЕсли;
	
	СтажМесяцевВсего = ЗарплатаКадрыРасширенныйКлиентСервер.РазницаВМесяцах(ДатаНачала, ДатаОкончания);
	МесяцевВГоду = 12;
	СтажЛет = Цел(СтажМесяцевВсего / МесяцевВГоду);
	СтажМесяцев = СтажМесяцевВсего % МесяцевВГоду;
	
	Если ЗначениеЗаполнено(СтажЛет) Тогда
		СклонениеЛет = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru = ';%1 год;;%1 года;%1 лет;'"), СтажЛет);
	Иначе
		СклонениеЛет = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтажМесяцев) Тогда
		СклонениеМесяцев = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru = ';%1 месяц;;%1 месяца;%1 месяцев;'"), СтажМесяцев); 
	Иначе
		СклонениеМесяцев = "";
	КонецЕсли;
	
	Возврат СтрШаблон(НСтр("ru = '%1 %2'"), СклонениеЛет, СклонениеМесяцев);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОжидаемыйДоходРезюме(Кандидат)
	
	Возврат СтрШаблон(НСтр("ru = '%1 %2 %3'"),
		Кандидат.ОжидаемыйДоход,
		Кандидат.ВалютаДохода,
		Кандидат.ПериодичностьДохода);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВозрастРезюме(ДатаРождения, ДатаВозраста)
	
	Если ДатаРождения > ДатаВозраста Тогда
		ДатаВозраста = ДатаРождения;
	КонецЕсли;
	
	Возврат ФизическиеЛицаЗарплатаКадрыКлиентСервер.ПредставлениеВозраста(ДатаРождения, ДатаВозраста);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолРезюме(ЛичныеДанные)
	
	Пол = ЛичныеДанные.Пол;
	Если Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской") Тогда
		ПолРезюме = НСтр("ru = 'мужчина'");
	ИначеЕсли Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский") Тогда
		ПолРезюме = НСтр("ru = 'женщина'");
	Иначе
		ПолРезюме = "";
	КонецЕсли;
	
	Возврат ПолРезюме;
	
КонецФункции

#КонецОбласти

#Область ЛентаСобытий

&НаСервере
Процедура ЗаполнитьЛентуСобытий()
	
	ЭлементыЛентыСобытий = Элементы["ГруппаСобытия"].ПодчиненныеЭлементы;
	Пока ЭлементыЛентыСобытий.Количество() <> 0 Цикл
		Элементы.Удалить(ЭлементыЛентыСобытий[0]);
	КонецЦикла;
	
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"Кандидаты", "НастройкиЛентыСобытий", ПодборПерсонала.НастройкиЛентыСобытийПоУмолчанию());
	
	События = ТаблицаСобытий();
	
	Если Настройки.СозданиеКандидата Тогда
		ДобавитьСобытиеСозданиеКандидата(События, КандидатОбъект, ЛичныеДанныеКандидата.Пол);
	КонецЕсли;
	Если Настройки.РаботаСКандидатами Тогда
		ДобавитьСобытияРаботыСКандидатом(События, РаботаСКандидатамиНаборЗаписей, КандидатОбъект);
	КонецЕсли;
	Если Настройки.Комментарии Тогда
		ДобавитьСобытияКомментарии(События, КомментарииКандидатовНаборЗаписей);
	КонецЕсли;
	Если Настройки.Оценки Тогда
		ДобавитьСобытияОценки(События, КандидатОбъект.Оценки, КандидатОбъект.ДатаРегистрации);
	КонецЕсли;
	Если Настройки.ЗагрузкаФайловПоКандидату Тогда
		ДобавитьСобытияЗагрузкаФайлов(События, КандидатСсылка, ДанныеПрисоединенныхФайлов);
	КонецЕсли;
	
	ДобавлениеИнформации = Настройки.ДобавлениеИнформацииПоКандидату;
	ИзменениеИнформации = Настройки.ИзменениеИнформацииПоКандидату;
	Если ДобавлениеИнформации Или ИзменениеИнформации Тогда
		ДобавитьСобытияИзменениеИнформации(События, КандидатСсылка, ЛичныеДанныеКандидатаСсылка,
			ДобавлениеИнформации, ИзменениеИнформации);
	КонецЕсли;
	
	События.Сортировать("Период");
	КоличествоСобытий = 0;
	Для Каждого Событие Из События Цикл
		ДобавитьСобытиеВЛенту(Событие);
		КоличествоСобытий = КоличествоСобытий + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьИзменениеКомментарияНаСервере(Результат, ДополнительныеПараметры)
	
	НомерКомментария = ДополнительныеПараметры.НомерКомментария;
	СтрокиНабора = КомментарииКандидатовНаборЗаписей.НайтиСтроки(Новый Структура("ИсходныйНомерСтроки", НомерКомментария));
	Если СтрокиНабора.Количество() <> 0 Тогда
		СтрокаНабора = СтрокиНабора[0];
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Результат.Действие = ПодборПерсоналаКлиентСервер.ДействияСКомментариемПриРедактировании().Изменение Тогда
		ЗаполнитьЗначенияСвойств(СтрокаНабора, Результат.Данные);
		СтрокаНабора.Комментарий = Результат.Данные.Комментарий;
		СтрокаНабора.Период = ТекущаяДатаСеанса();
		СтрокаНабора.Кандидат = КандидатСсылка;
		ЗаписатьКомментарии();
		УдалитьКомментарийИзЛентыСобытий(НомерКомментария);
		ДобавитьКомментарийВЛентуСобытий(СтрокаНабора);
	ИначеЕсли Результат.Действие = ПодборПерсоналаКлиентСервер.ДействияСКомментариемПриРедактировании().Удаление Тогда
		КомментарииКандидатовНаборЗаписей.Удалить(СтрокаНабора);
		УдалитьКомментарийИзЛентыСобытий(НомерКомментария);
		КомментарииУдалены = Истина;
	Иначе
		ОбщегоНазначенияКлиентСервер.Проверить(Ложь,
			НСтр("ru = 'Неопознанное действие в результате редактирования комментария'"),
			"Справочник.Кандидаты.Формы.ФормаЭлемента");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОставитьКомментарийНаСервере()
	
	СтрокаНабора = КомментарииКандидатовНаборЗаписей.Добавить();
	СтрокаНабора.Период = ТекущаяДатаСеанса();
	СтрокаНабора.Кандидат = КандидатСсылка;
	СтрокаНабора.Пользователь = Пользователи.ТекущийПользователь();
	СтрокаНабора.Комментарий = Комментарий;
	СтрокаНабора.Доступность = ?(КомментарийВиденТолькоМне,
		Перечисления.ДоступностьКомментарияКандидата.ТолькоДляАвтора,
		Перечисления.ДоступностьКомментарияКандидата.Общедоступный);
	
	НачатьТранзакцию();
	Попытка
		Идентификатор = КомментарииКандидатовНаборЗаписей.Количество() - 1;
		ДобавитьКомментарийВЛентуСобытий(КомментарииКандидатовНаборЗаписей.Получить(Идентификатор));
		ЗаписатьКомментарии();
		ЗаполнитьЛентуСобытий();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Комментарии кандидатов'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКомментарии()
	
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	
	// Пользователь имеет права только на изменение своих комментариев, поэтому меняем набор с отбором по текущему пользователю.
	НаборЗаписей = РегистрыСведений.КомментарииКандидатов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Кандидат.Установить(КандидатСсылка);
	НаборЗаписей.Отбор.Пользователь.Установить(АвторизованныйПользователь);
	
	// Добавляем все комментарии текущего пользователя из текущей формы.
	Для Каждого СтрокаНабора Из КомментарииКандидатовНаборЗаписей Цикл
		Если СтрокаНабора.Пользователь = АвторизованныйПользователь Тогда
			НоваяСтрока = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНабора);
			НоваяСтрока.Кандидат = КандидатСсылка;
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
	ЗначениеВРеквизитФормы(НаборЗаписей, "КомментарииКандидатовНаборЗаписей");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКомментарийВЛентуСобытий(СтрокаНабора)
	
	ДопустимаяДлинаКомментария = ДопустимаяДлинаКомментария();
	
	СобытиеКомментарий = Новый Структура;
	СобытиеКомментарий.Вставить("Период", СтрокаНабора.Период);
	СобытиеКомментарий.Вставить("Автор", ПредставлениеОтветственного(СтрокаНабора.Пользователь));
	СобытиеКомментарий.Вставить("ВидСобытия", Перечисления.СобытияПоКандидату.Комментарий);
	СобытиеКомментарий.Вставить("Гиперссылка", Истина);
	СобытиеКомментарий.Вставить("НомерСобытия", СтрокаНабора.ИсходныйНомерСтроки);
	СобытиеКомментарий.Вставить("ПредметСобытия", "");
	Текст = Лев(СтрокаНабора.Комментарий, ДопустимаяДлинаКомментария);
	НомерСимволаПереноса = СтрНайти(Текст, Символы.ПС);
	Если НомерСимволаПереноса <> 0 Тогда
		Текст = Лев(Текст, НомерСимволаПереноса - 1);
	КонецЕсли;
	Если СтрДлина(СтрокаНабора.Комментарий) > ДопустимаяДлинаКомментария Тогда
		ТекстСобытия = СтрШаблон(НСтр("ru = '%1...'"), Текст);
	Иначе
		ТекстСобытия = Текст;
	КонецЕсли;
	СобытиеКомментарий.Вставить("ТекстСобытия", ТекстСобытия);
	
	ДобавитьСобытиеВЛенту(СобытиеКомментарий);
	КоличествоСобытий = КоличествоСобытий + 1;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьКомментарийИзЛентыСобытий(НомерКомментария)
	
	Элементы.Удалить(Элементы["ГруппаКомментарий" + НомерКомментария]);
	КоличествоСобытий = КоличествоСобытий - 1;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьКомментарии(ОбъектКандидат, КандидатСсылка)
	
	ЗагрузитьКомментарииРекрутинговыхСайтов(КандидатСсылка);
	
	Если ТипЗнч(ОбъектКандидат) = Тип("СправочникОбъект.Кандидаты") И ОбъектКандидат.ЭтоНовый() Тогда
		НаборЗаписей = СвойствоСтруктуры(ОбъектКандидат.ДополнительныеСвойства, "СвязанныеОбъекты.КомментарииКандидатов");
		Если НаборЗаписей <> Неопределено Тогда
			ЗначениеВРеквизитФормы(НаборЗаписей, "КомментарииКандидатовНаборЗаписей");
		КонецЕсли;
	Иначе
		ПрочитатьКомментарииИзРегистраСведений(КандидатСсылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьДобавленияИзмененияКомментариев()
	
	ДобавлениеИзменениеКомментариевДоступно = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.КомментарииКандидатов);
	Если ДобавлениеИзменениеКомментариевДоступно Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаКомментарий.Доступность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКомментарииРекрутинговыхСайтов(КандидатСсылка)
	РекрутинговыеСайты.ЗагрузитьКомментарииКандидата(КандидатСсылка);
КонецПроцедуры

&НаСервере
Процедура ПрочитатьКомментарииИзРегистраСведений(КандидатСсылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Кандидат", КандидатСсылка);
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.АвторизованныйПользователь());
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КомментарииКандидатов.Период КАК Период,
		|	КомментарииКандидатов.Кандидат КАК Кандидат,
		|	КомментарииКандидатов.Пользователь КАК Пользователь,
		|	КомментарииКандидатов.Комментарий КАК Комментарий,
		|	КомментарииКандидатов.Доступность КАК Доступность,
		|	КомментарииКандидатов.МестоПубликации КАК МестоПубликации,
		|	КомментарииКандидатов.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.КомментарииКандидатов КАК КомментарииКандидатов
		|ГДЕ
		|	КомментарииКандидатов.Кандидат = &Кандидат
		|	И (КомментарииКандидатов.Доступность = ЗНАЧЕНИЕ(Перечисление.ДоступностьКомментарияКандидата.Общедоступный)
		|			ИЛИ КомментарииКандидатов.Пользователь = &ТекущийПользователь)";
		
	НаборЗаписей = РегистрыСведений.КомментарииКандидатов.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЗначениеВРеквизитФормы(НаборЗаписей, "КомментарииКандидатовНаборЗаписей");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСобытиеВЛенту(Событие)
	
	Группа = Элементы.ГруппаСобытия;
	ИмяСобытия = ИмяСобытия(Событие.ВидСобытия);
	НомерСобытия = Событие.НомерСобытия;
	ПредметСобытия = Событие.ПредметСобытия;
	
	ГруппаСобытие = Элементы.Добавить("Группа" + ИмяСобытия + ПредметСобытия + НомерСобытия, Тип("ГруппаФормы"), Группа);
	ГруппаСобытие.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСобытие.ОтображатьЗаголовок = Ложь;
	ГруппаСобытие.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	Если КоличествоСобытий <> 0 Тогда
		НовыйЭлемент = Элементы.Добавить("ДекорацияОтступ" + ИмяСобытия + ПредметСобытия + НомерСобытия,
			Тип("ДекорацияФормы"), ГруппаСобытие);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
		НовыйЭлемент.Картинка = БиблиотекаКартинок.ЛентаСобытийОтступ;
	КонецЕсли;
	
	ГруппаСобытиеОсновное = Элементы.Добавить("ГруппаОсновное" + ИмяСобытия + ПредметСобытия + НомерСобытия,
		Тип("ГруппаФормы"), ГруппаСобытие);
	ГруппаСобытиеОсновное.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСобытиеОсновное.ОтображатьЗаголовок = Ложь;
	ГруппаСобытиеОсновное.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	НовыйЭлемент = Элементы.Добавить("ДекорацияКартинка" + ИмяСобытия + ПредметСобытия + НомерСобытия,
		Тип("ДекорацияФормы"), ГруппаСобытиеОсновное);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка = КартинкаПоВидуСобытия(Событие.ВидСобытия);
	
	ГруппаСобытиеАвторДатаТекст = Элементы.Добавить("ГруппаАвторДатаТекст" + ИмяСобытия + ПредметСобытия + НомерСобытия,
		Тип("ГруппаФормы"), ГруппаСобытиеОсновное);
	ГруппаСобытиеАвторДатаТекст.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСобытиеАвторДатаТекст.ОтображатьЗаголовок = Ложь;
	ГруппаСобытиеАвторДатаТекст.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	НовыйЭлемент = Элементы.Добавить("ДекорацияАвторДата" + ИмяСобытия + ПредметСобытия + НомерСобытия,
		Тип("ДекорацияФормы"), ГруппаСобытиеАвторДатаТекст);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	Если Час(Событие.Период) = 0 И Минута(Событие.Период) = 0 Тогда
		ФорматнаяСтрока = "ДЛФ=D";
	Иначе
		ФорматнаяСтрока = "ДФ='dd.MM.yyyy ЧЧ:мм'";
	КонецЕсли;
	Если Событие.Период = ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата() Тогда
		Событие.Период = Неопределено;
	КонецЕсли;
	НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '%1 %2'"), Событие.Автор,
		Формат(Событие.Период, ФорматнаяСтрока));
	НовыйЭлемент.ЦветТекста = ЦветаСтиля.ЦветТекстаЛентыСобытийВспомогательный;
	НовыйЭлемент.Шрифт = ШрифтыСтиля.ШрифтЛентыСобытийВспомогательный;
	
	ГруппаСобытиеТекст = Элементы.Добавить("ГруппаТекст" + ИмяСобытия + ПредметСобытия + НомерСобытия,
		Тип("ГруппаФормы"), ГруппаСобытиеАвторДатаТекст);
	ГруппаСобытиеТекст.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСобытиеТекст.ОтображатьЗаголовок = Ложь;
	ГруппаСобытиеТекст.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаСобытиеТекст.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	
	Если Событие.Гиперссылка Тогда
		НовыйЭлемент = Элементы.Добавить("ДекорацияЗаголовок" + ИмяСобытия + ПредметСобытия + НомерСобытия,
			Тип("ДекорацияФормы"), ГруппаСобытиеТекст);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.Заголовок = ЗаголовокСобытия(ЭтотОбъект, Событие.ВидСобытия, ПредметСобытия, НомерСобытия);
		НовыйЭлемент.Шрифт = ШрифтыСтиля.ШрифтЛентыСобытийОсновной;
	КонецЕсли;
	
	НовыйЭлемент = Элементы.Добавить("ДекорацияТекст" + ИмяСобытия + ПредметСобытия + НомерСобытия,
		Тип("ДекорацияФормы"), ГруппаСобытиеТекст);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = Событие.ТекстСобытия;
	НовыйЭлемент.Шрифт = ШрифтыСтиля.ШрифтЛентыСобытийОсновной;
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	Если Событие.Гиперссылка Тогда
		НовыйЭлемент.Гиперссылка = Истина;
		Если Событие.ВидСобытия = Перечисления.СобытияПоКандидату.Комментарий Тогда
			Действие = "Подключаемый_НачатьИзменениеКомментария";
		ИначеЕсли Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ЗагрузкаФайлов Тогда
			Действие = "Подключаемый_ОткрытьФайл";
		ИначеЕсли Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ДобавлениеИнформации
			Или Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ИзменениеИнформации Тогда
			Действие = "Подключаемый_ОткрытьВерсию";
		ИначеЕсли СобытиеЭтапРаботы(Событие.ВидСобытия) Тогда
			Действие = "Подключаемый_ОткрытьКарточкуЭтапа";
			СоздатьКомандыЭтапаРаботы(ЭтотОбъект, Событие.ВидСобытия, НомерСобытия, ГруппаСобытиеТекст);
		КонецЕсли;
		НовыйЭлемент.УстановитьДействие("Нажатие", Действие);
	Иначе
		НовыйЭлемент.ЦветТекста = ЦветаСтиля.ЦветТекстаЛентыСобытийОсновной;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьИзменениеКомментария(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершитьИзменениеКомментарияНаСервере(Результат, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийПередЗакрытиемВопрос() Экспорт
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("КомментарийПередЗакрытиемЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОповещениеОЗакрытии, СтрШаблон(НСтр("ru = 'Сохранить комментарий ""%1""?'"), Комментарий),
		РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийПередЗакрытиемЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтветПередЗакрытием = Истина;
		ОставитьКомментарийНаСервере();
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		ОтветПередЗакрытием = Истина;
		Закрыть();
	Иначе
		ОтветПередЗакрытием = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСобытиеСозданиеКандидата(События, Кандидат, Пол)
	
	Событие = События.Добавить();
	Событие.Период = Кандидат.ДатаРегистрации;
	Событие.Автор = ПредставлениеОтветственного(Кандидат.Ответственный);
	Событие.ТекстСобытия = ЗаголовокСобытияСозданияКандидата(Кандидат, Пол);
	Событие.ВидСобытия = Перечисления.СобытияПоКандидату.Создание;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСобытияКомментарии(События, Комментарии)
	
	ДопустимаяДлинаКомментария = ДопустимаяДлинаКомментария();
	
	Для Каждого Комментарий Из Комментарии Цикл
		Событие = События.Добавить();
		Событие.Период = Комментарий.Период;
		Событие.Автор = ПредставлениеОтветственного(Комментарий.Пользователь);
		Текст = Лев(Комментарий.Комментарий, ДопустимаяДлинаКомментария);
		НомерСимволаПереноса = СтрНайти(Текст, Символы.ПС);
		Если НомерСимволаПереноса <> 0 Тогда
			Текст = Лев(Текст, НомерСимволаПереноса - 1);
		КонецЕсли;
		Если СтрДлина(Комментарий.Комментарий) > ДопустимаяДлинаКомментария Тогда
			Событие.ТекстСобытия = СтрШаблон(НСтр("ru = '%1...'"), Текст);
		Иначе
			Событие.ТекстСобытия = Текст;
		КонецЕсли;
		Событие.Гиперссылка = Истина;
		Событие.ВидСобытия = Перечисления.СобытияПоКандидату.Комментарий;
		Событие.НомерСобытия = Комментарий.ИсходныйНомерСтроки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСобытияОценки(События, Оценки, ДатаРегистрации)
	
	Для Каждого Оценка Из Оценки Цикл
		Событие = События.Добавить();
		Если ЗначениеЗаполнено(Оценка.ДатаОценки) Тогда
			ДатаОценки = Оценка.ДатаОценки;
		Иначе
			ДатаОценки = ДатаРегистрации;
		КонецЕсли;
		Событие.Период = ДатаОценки;
		Событие.Автор = ПредставлениеОтветственного(Оценка.Пользователь);
		Событие.ТекстСобытия = СтрШаблон(НСтр("ru = 'Поставлена оценка: %1'"), Оценка.Оценка);
		Событие.ВидСобытия = Перечисления.СобытияПоКандидату.Оценка;
		Событие.НомерСобытия = Оценка.ИсходныйНомерСтроки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСобытияЗагрузкаФайлов(События, Кандидат, ДанныеПрисоединенныхФайлов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Кандидат);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КандидатыПрисоединенныеФайлы.Ссылка КАК Файл,
		|	КандидатыПрисоединенныеФайлы.Автор КАК Автор,
		|	КандидатыПрисоединенныеФайлы.ДатаСоздания КАК ДатаСоздания,
		|	КандидатыПрисоединенныеФайлы.Наименование КАК Наименование
		|ИЗ
		|	Справочник.КандидатыПрисоединенныеФайлы КАК КандидатыПрисоединенныеФайлы
		|ГДЕ
		|	КандидатыПрисоединенныеФайлы.ВладелецФайла = &Владелец";
	
	ПрисоединенныеФайлы = Запрос.Выполнить().Выгрузить();
	
	НомерФайла = 0;
	Для Каждого ПрисоединенныйФайл Из ПрисоединенныеФайлы Цикл
		Событие = События.Добавить();
		Событие.Период = ПрисоединенныйФайл.ДатаСоздания;
		Событие.Автор = ПредставлениеОтветственного(ПрисоединенныйФайл.Автор);
		Событие.ТекстСобытия = ПрисоединенныйФайл.Наименование;
		Событие.Гиперссылка = Истина;
		Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ЗагрузкаФайлов;
		Событие.НомерСобытия = НомерФайла;
		
		ПараметрыДанныхФайла = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ПараметрыДанныхФайла.ДляРедактирования = Ложь;
		ПараметрыДанныхФайла.ВызыватьИсключение = Ложь;
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл.Файл, ПараметрыДанныхФайла);
		ДанныеПрисоединенныхФайлов.Добавить(ДанныеФайла);
		НомерФайла = НомерФайла + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСобытияРаботыСКандидатом(События, РаботаСКандидатом, Кандидат)
	
	КандидатОтклонен = Ложь;
	Если Кандидат.Состояние = Перечисления.СостоянияСогласования.Отклонено Тогда
		КандидатОтклонен = Истина;
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого Работа Из РаботаСКандидатом Цикл
		Событие = События.Добавить();
		Событие.Период = ?(ЗначениеЗаполнено(Работа.Период), Работа.Период,
			ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата());
		Событие.Автор = ПредставлениеОтветственного(Кандидат.Ответственный);
		Событие.ТекстСобытия = Работа.ЭтапРаботы;
		Если Работа.СостояниеЭтапа = Перечисления.СостоянияЭтаповРаботыСКандидатами.Пройден Тогда
			Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ПрохождениеЭтапа;
		ИначеЕсли ЗначениеЗаполнено(Работа.СостояниеЭтапа) Тогда
			Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ЭтапРаботы;
		ИначеЕсли КандидатОтклонен Тогда
			Событие.Период = Кандидат.ДатаРешения;
			Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ОтклонениеСЭтапа;
			КандидатОтклонен = Ложь;
		Иначе
			Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ЭтапРаботы;
		КонецЕсли;
		Событие.НомерСобытия = НомерСтроки;
		Событие.Гиперссылка = Истина;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТаблицаСобытий()
	
	События = Новый ТаблицаЗначений;
	События.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	События.Колонки.Добавить("Автор", Новый ОписаниеТипов("Строка"));
	События.Колонки.Добавить("Гиперссылка", Новый ОписаниеТипов("Булево"));
	События.Колонки.Добавить("НомерСобытия", Новый ОписаниеТипов("Число"));
	События.Колонки.Добавить("ВидСобытия", Новый ОписаниеТипов("ПеречислениеСсылка.СобытияПоКандидату"));
	События.Колонки.Добавить("ПредметСобытия", Новый ОписаниеТипов("Строка"));
	
	СписокТипов = Новый Массив;
	СписокТипов.Добавить(Тип("Строка"));
	СписокТипов.Добавить(Тип("ФорматированнаяСтрока"));
	События.Колонки.Добавить("ТекстСобытия", Новый ОписаниеТипов(СписокТипов));
	
	Возврат События;
	
КонецФункции

&НаСервереБезКонтекста
Функция КартинкаПоВидуСобытия(ВидСобытия)
	
	Если ВидСобытия = Перечисления.СобытияПоКандидату.Комментарий Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийКомментарий;
	ИначеЕсли ВидСобытия = Перечисления.СобытияПоКандидату.Оценка Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийОценка;
	ИначеЕсли ВидСобытия = Перечисления.СобытияПоКандидату.ЗагрузкаФайлов Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийЗагрузкаФайлов;
	ИначеЕсли ВидСобытия = Перечисления.СобытияПоКандидату.ИзменениеИнформации Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийИзменеиеИнформации;
	ИначеЕсли ВидСобытия = Перечисления.СобытияПоКандидату.ДобавлениеИнформации Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийДобавлениеИнформации;
	ИначеЕсли ВидСобытия = Перечисления.СобытияПоКандидату.Создание Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийСозданиеКандидата;
	ИначеЕсли ВидСобытия = Перечисления.СобытияПоКандидату.ПрохождениеЭтапа Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийЭтапПройден;
	ИначеЕсли ВидСобытия = Перечисления.СобытияПоКандидату.ЭтапРаботы Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийЭтап;
	ИначеЕсли ВидСобытия = Перечисления.СобытияПоКандидату.ОтклонениеСЭтапа Тогда
		Картинка = БиблиотекаКартинок.ЛентаСобытийЭтапОтклонен;
	Иначе
		Картинка = БиблиотекаКартинок.ЛентаСобытийПромежуточный;
	КонецЕсли;
	
	Возврат Картинка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаголовокСобытияСозданияКандидата(Кандидат, Пол)
	
	Обращение = ?(ЭтоЖенскийПол(Пол), НСтр("ru = 'Создана'"), НСтр("ru = 'Создан'"));
	Если Кандидат.СпособСозданияКандидата = Перечисления.СпособыСозданияКандидата.РекрутинговыйСайт
		Или (Не ЗначениеЗаполнено(Кандидат.СпособСозданияКандидата) И ЗначениеЗаполнено(Кандидат.АдресРезюме)) Тогда
		ЧастиСтроки = Новый Массив;
		ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = '%1 с рекрутингового сайта: '"), Обращение));
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(Кандидат.АдресРезюме,,,, Кандидат.АдресРезюме));
		ЗаголовокСобытия = Новый ФорматированнаяСтрока(ЧастиСтроки);
	ИначеЕсли Кандидат.СпособСозданияКандидата = Перечисления.СпособыСозданияКандидата.ФайлРезюме Тогда
		ЗаголовокСобытия = СтрШаблон(НСтр("ru = '%1 из файла'"), Обращение);
	ИначеЕсли Кандидат.СпособСозданияКандидата = Перечисления.СпособыСозданияКандидата.РучнойВвод Тогда
		ЗаголовокСобытия = СтрШаблон(НСтр("ru = '%1'"), Обращение);
	ИначеЕсли Кандидат.СпособСозданияКандидата = Перечисления.СпособыСозданияКандидата.Отклик Тогда
		ЧастиСтроки = Новый Массив;
		ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = '%1 по отклику: '"), Обращение));
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(Кандидат.АдресРезюме,,,, Кандидат.АдресРезюме));
		ЗаголовокСобытия = Новый ФорматированнаяСтрока(ЧастиСтроки);
	Иначе
		ЗаголовокСобытия = СтрШаблон(НСтр("ru = '%1'"), Обращение);
	КонецЕсли;
	
	Возврат ЗаголовокСобытия;
	
КонецФункции

