// Параметры:
//  РезультатВыбора - Структура, Неопределено - 
//  ДополнительныеПараметры - Произвольный
&НаКлиенте
Процедура ПроверкаОднофамильцевЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		ЗаполнитьПредставлениеОпытаРаботы();
	ИначеЕсли ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		ПроверкаОднофамильцевЗавершениеНаСервере(РезультатВыбора);
	Иначе
		ОбщегоНазначенияКлиентСервер.Проверить(Ложь, НСтр("ru = 'Некорректный результат проверки однофамильцев'"),
			"ПроверкаОднофамильцевЗавершение");
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  РезультатВыбора - Структура
&НаСервере
Процедура ПроверкаОднофамильцевЗавершениеНаСервере(РезультатВыбора)
	
	Если ТипЗнч(РезультатВыбора.ПохожийЧеловек) = Тип("СправочникСсылка.ЛичныеДанныеКандидатов") Тогда
		ЛичныеДанныеКандидатаСсылка = РезультатВыбора.ПохожийЧеловек;
		КандидатОбъект.ЛичныеДанные = РезультатВыбора.ПохожийЧеловек;
		ФизическоеЛицоСсылка = ПодборПерсонала.ФизическоеЛицоЛичныхДанныхКандидата(ЛичныеДанныеКандидатаСсылка);
		Если РезультатВыбора.ВАрхивеФизическихЛиц Тогда
			ОбъектЛичныеДанныеКандидата = ЛичныеДанныеКандидатаПоДаннымВыбораПохожегоИзАрхива(РезультатВыбора,
				ЛичныеДанныеКандидатаСсылка);
			ДанныеДляЗаполненияИзАрхива = РезультатВыбора;
		Иначе
			ОбъектЛичныеДанныеКандидата = Неопределено;
		КонецЕсли;
		Если КандидатОбъект.ЛичныеДанные.Пустая() Тогда
			КандидатОбъект.ЛичныеДанные = Справочники.ЛичныеДанныеКандидатов.ПолучитьСсылку();
		КонецЕсли;
		Если ОбъектЛичныеДанныеКандидата = Неопределено
			И ОбщегоНазначения.СсылкаСуществует(КандидатОбъект.ЛичныеДанные) Тогда
			ОбъектЛичныеДанныеКандидата = КандидатОбъект.ЛичныеДанные.ПолучитьОбъект();
			ДополнитьЛичныеДанные(ОбъектЛичныеДанныеКандидата, ЛичныеДанныеКандидата);
		КонецЕсли;
		ЗначениеВРеквизитФормы(ОбъектЛичныеДанныеКандидата, "ЛичныеДанныеКандидата");
	ИначеЕсли ТипЗнч(РезультатВыбора.ПохожийЧеловек) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		ФизическоеЛицоСсылка = РезультатВыбора.ПохожийЧеловек;
		ЗаполнитьОбъектЛичныеДанныеКандидатаПоФизЛицу(ФизическоеЛицоСсылка, РезультатВыбора);
	Иначе
		ОбщегоНазначенияКлиентСервер.Проверить(Ложь,
			НСтр("ru = 'В результате поиска получен похожий человек неподдерживаемого типа'"),
			"ПроверкаОднофамильцевЗавершениеНаСервере");
	КонецЕсли;
	
	ЗаполнитьНаименованиеПоДаннымКандидата();
	ЗаполнитьОбразованиеКвалификацию();
	ЗаполнитьПредставлениеОпытаРаботы();
	ЗаполнитьРезюме(ЭтотОбъект);
	Модифицированность = Истина;
	
КонецПроцедуры

// Параметры:
//  РезультатВыбора - Структура
//  ЛичныеДанныеКандидата - СправочникСсылка.ЛичныеДанныеКандидатов
&НаСервере
Функция ЛичныеДанныеКандидатаПоДаннымВыбораПохожегоИзАрхива(РезультатВыбора, ЛичныеДанныеКандидата)
	
	ОбъектЛичныеДанныеКандидата = ЛичныеДанныеКандидата.ПолучитьОбъект();
	
	Если Не ОбщегоНазначения.СсылкаСуществует(ЛичныеДанныеКандидата) Тогда
		ОбъектЛичныеДанныеКандидата = Справочники.ЛичныеДанныеКандидатов.СоздатьЭлемент();
		ОбъектЛичныеДанныеКандидата.УстановитьСсылкуНового(ЛичныеДанныеКандидата);
	КонецЕсли;
	ОбъектЛичныеДанныеКандидата.Заполнить(ДанныеЗаполненияКандидатаИзАрхива(РезультатВыбора));
	
	// Очистим контактную информацию, и затем добавим то, что нашли в архиве при поиске похожих.
	УправлениеКонтактнойИнформацией.УстановитьКонтактнуюИнформациюОбъекта(ОбъектЛичныеДанныеКандидата,
		УправлениеКонтактнойИнформацией.НоваяКонтактнаяИнформация());
	Если ЗначениеЗаполнено(РезультатВыбора.МобильныйТелефон) Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектЛичныеДанныеКандидата,
			РезультатВыбора.МобильныйТелефон,
			ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыКонтактнойИнформации.ТелефонЛичныеДанныеКандидатов"));
	КонецЕсли;
	Если ЗначениеЗаполнено(РезультатВыбора.АдресЭлектроннойПочты) Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектЛичныеДанныеКандидата,
			РезультатВыбора.АдресЭлектроннойПочты,
			ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыКонтактнойИнформации.EMailЛичныеДанныеКандидатов"));
	КонецЕсли;
	
	Возврат ОбъектЛичныеДанныеКандидата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеЗаполненияКандидатаИзАрхива(РезультатВыбора)
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ФИО", РезультатВыбора.ФИОПолные);
	ДанныеЗаполнения.Вставить("ДатаРождения", СтроковыеФункцииКлиентСервер.СтрокаВДату(РезультатВыбора.ДатаРождения));
	ДанныеЗаполнения.Вставить("Образование", Неопределено);
	ДанныеЗаполнения.Вставить("Курсы", Неопределено);
	ДанныеЗаполнения.Вставить("ОпытРаботы", Неопределено);
	ДанныеЗаполнения.Вставить("УченыеСтепени", Неопределено);
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

