#Область ОписаниеПеременных

&НаКлиенте
Перем ОтветПередЗакрытием;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ГруппаКнопокПодключаемыеКоманды;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ПараметрыОтображенияМеток = УправлениеСвойствами.ПараметрыОтображенияМеток();
	ПараметрыОтображенияМеток.ИмяЭлементаДляРазмещенияМеток = "ГруппаМетки";
	ПараметрыОтображенияМеток.ВариантОтображенияМеток = Перечисления.ВариантыОтображенияМеток.Надпись;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("Объект", КандидатОбъект);
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	ДополнительныеПараметры.Вставить("ПараметрыОтображенияМеток", ПараметрыОтображенияМеток);
	
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	УправлениеСвойствами.ЗаполнитьМеткиОбъекта(ЭтотОбъект, ЛичныеДанныеКандидата);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "ГруппаКнопокРаботаСФайлами";
	ПараметрыГиперссылки.Владелец = "КандидатОбъект.Ссылка"; 
	
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// СтандартныеПодсистемы.УправлениеДоступом
	ЭтоНовыйОтклик = ЭтоНовыйОтклик();
	ПараметрыУправленияДоступом = УправлениеДоступом.ПараметрыПриСозданииФормыЗначенияДоступа();
	ПараметрыУправленияДоступом.Реквизит = "ЛичныеДанныеКандидата.ГруппаДоступа";
	ПараметрыУправленияДоступом.ТипЗначения = Тип("СправочникСсылка.ЛичныеДанныеКандидатов");
	ПараметрыУправленияДоступом.СозданиеНового = ЭтоНовыйОтклик Или Параметры.Ключ.Пустая();
	УправлениеДоступом.ПриСозданииФормыЗначенияДоступа(ЭтотОбъект, ПараметрыУправленияДоступом);
	
	// Для отклика не нужно автоматически заполнять группу доступа
	Если ЭтоНовыйОтклик И ЗначениеЗаполнено(ЛичныеДанныеКандидата.ГруппаДоступа) Тогда
		ЛичныеДанныеКандидата.ГруппаДоступа = Неопределено;
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	РазмещеныНаФорме = Новый Соответствие;
	РазмещеныНаФорме.Вставить("АдресЛичныеДанныеКандидатов", Истина);
	РазмещеныНаФорме.Вставить("ТелефонЛичныеДанныеКандидатов", Истина);
	РазмещеныНаФорме.Вставить("EMailЛичныеДанныеКандидатов", Истина);
	РазмещеныНаФорме.Вставить("TelegramЛичныеДанныеКандидатов", Истина);
	РазмещеныНаФорме.Вставить("MAXЛичныеДанныеКандидатов", Истина);
	
	ДополнительныеПараметры = УправлениеКонтактнойИнформацией.ПараметрыКонтактнойИнформации();
	ДополнительныеПараметры.РазмещеныНаФорме = РазмещеныНаФорме;
	ДополнительныеПараметры.ИмяЭлементаДляРазмещения = "ГруппаДополнительнаяКонтактнаяИнформация";
	ДополнительныеПараметры.ПоложениеЗаголовкаКИ = ПоложениеЗаголовкаЭлементаФормы.Лево;
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, ЛичныеДанныеКандидата, ДополнительныеПараметры);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.КонтактнаяИнформация") Тогда
		ИзменитьОтображениеДополнительнойКонтактнойИнформации();
	КонецЕсли;
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// Заполнение данных кандидата.
	Если Параметры.Ключ.Пустая() Тогда
		ЗаполнитьДанныеКандидата();
	ИначеЕсли ТекущийЭтап.ЭтапРаботы = Перечисления.ЭтапыРаботыСКандидатами.РассмотрениеОтклика
		И ТекущийЭтап.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Запланирован Тогда
		ВыполнятьПроверкуОднофамильцев = Истина;
	КонецЕсли;
	
	// Подготовить оповещения взаимодействий.
	Взаимодействия.ПодготовитьОповещения(ЭтотОбъект, Параметры, Ложь);
	
	УстановитьУсловноеОформлениеТаблицыФормыОпытРаботы();
	
	ЗаполнитьИсториюВыбораВакансии();
	ЗаполнитьРезюме(ЭтотОбъект);
	УстановитьВидимостьTelegram(ЭтотОбъект);
	УстановитьВидимостьMAX(ЭтотОбъект);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.Наставничество") Тогда
		МодульНаставничество = ОбщегоНазначения.ОбщийМодуль("Наставничество");
		МодульНаставничество.СоздатьКомандуНаставничествоВФорме(ЭтотОбъект, Элементы.ГруппаНаставничество, ВидКнопкиФормы.КнопкаКоманднойПанели);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, КандидатОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.КонтрольВеденияУчета
	КонтрольВеденияУчетаБЗК.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтрольВеденияУчета
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ЛичныеДанныеКандидата,
		"ГруппаДополнительнаяКонтактнаяИнформация");
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	КандидатСсылка = ТекущийОбъект.Ссылка;
	ПриПолученииДанныхНаСервере(ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПодборПерсоналаФормыКлиент.ЗаполненыДанныеИдентифицирующиеКандидата(ЭтотОбъект) Тогда
		ПроверитьУникальностьЛичныхДанныхКандидата(Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(КандидатСсылка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийОбъект.ЛичныеДанные) Тогда
		ТекущийОбъект.ЛичныеДанные = ЛичныеДанныеКандидатаСсылка;
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтотОбъект, ЛичныеДанныеКандидата);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	ЗаполнитьСвязанныеОбъектыКандидата(ТекущийОбъект, ПараметрыЗаписи);
	
	Если ТекущийЭтап.ЭтапРаботы = Перечисления.ЭтапыРаботыСКандидатами.РассмотрениеОтклика Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ЭтоОтклик", Истина);
	КонецЕсли;
	
	ЗаполнитьСреднийРейтинг(ТекущийОбъект);
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗаписьИзФормы", Истина);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ДляЗаписи", ДляЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайлами.ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи, Параметры);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	Если КомментарииУдалены Тогда
		ЗаписатьКомментарии();
		КомментарииУдалены = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.КонтрольВеденияУчета
	КонтрольВеденияУчетаБЗК.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.КонтрольВеденияУчета
	
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(КандидатСсылка);
	КонецЕсли;
	
	РазблокироватьДанныеФормыДляРедактирования();
	РазблокироватьЛичныеДанныеКандидатаОбъектДляРедактирования();
	
	ПриПолученииДанныхНаСервере(ТекущийОбъект);
	
	ПоказатьКомандуСоздатьКандидата();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты, КандидатОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, ЛичныеДанныеКандидата, Отказ);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	ПроверитьПериодВТабличнойЧастиЛичныхДанныхКандидата(
		Метаданные.Справочники.ЛичныеДанныеКандидатов.ТабличныеЧасти.ОпытРаботы.Имя, Отказ);
	
	Если ИспользоватьОграничениеПоГруппамДоступа
		И ТекущийЭтап.ЭтапРаботы <> Перечисления.ЭтапыРаботыСКандидатами.РассмотрениеОтклика
		И Не ЗначениеЗаполнено(ЛичныеДанныеКандидата.ГруппаДоступа) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнена группа доступа'"), ,
			"ЛичныеДанныеКандидата.ГруппаДоступа", , Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЛичныеДанныеКандидата.ФИО) И Не ЛичныеДанныеКандидата.ФИООтсутствует Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнено ФИО кандидата'"), ,
			"ЛичныеДанныеКандидата.ФИО", , Отказ);
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОценкуЭффективностиИсточниковИнформацииОКандидатах") И
		Не ЗначениеЗаполнено(КандидатОбъект.ИсточникИнформации) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнен источник информации о кандидате'"), ,
			"КандидатОбъект.ИсточникИнформации", , Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	Если КандидатОбъект.Ссылка.Пустая()
		Или ТекущийЭтап.ЭтапРаботы =
			ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.РассмотрениеОтклика") Тогда
		// Проверить дубли.
		Если ВыполнятьПроверкуОднофамильцев Тогда
			ПодключитьОбработчикОжидания("ПроверитьОднофамильцев", 0.1, Истина);
		КонецЕсли;
	Иначе
		ПроверитьДоступностьКонтактов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		Если ИмяСобытия = "Запись_ИзменениеМеток" Тогда
			ОбновитьМетки();
		КонецЕсли;
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ЗащитаПерсональныхДанных
	ЗащитаПерсональныхДанныхКлиент.ОбработкаОповещенияФормы(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.ЗащитаПерсональныхДанных
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	Если ИмяСобытия = "ИзмененыДанныеДополнительнойФормы" И Источник = ЭтотОбъект Тогда
		ПрочитатьДанныеИзХранилищаВФормуНаСервере(Параметр);
		СотрудникиКлиентСервер.УстановитьПризнакРедактированияДанныхВДополнительнойФорме(Параметр.ИмяФормы, ЭтотОбъект);
		ЗаблокироватьЛичныеДанныеКандидатаОбъектДляРедактирования();
		ЗаполнитьОбразованиеКвалификацию();
	ИначеЕсли ИмяСобытия = "Проведение_Анкета" Или ИмяСобытия = "Запись_Кандидаты" Тогда
		Прочитать();
	ИначеЕсли ИмяСобытия = "Запись_ПриемНаРаботу" Тогда
		ПрочитатьРаботуСКандидатом();
		УстановитьПанельСостояния();
	ИначеЕсли ИмяСобытия = "Запись_РешениеОПриемеНаРаботу" И СвойствоСтруктуры(Параметр, "Кандидат") = КандидатСсылка Тогда
		ПрочитатьРаботуСКандидатом();
		УстановитьПанельСостояния();
	КонецЕсли;
	
	Если ИмяСобытия = "ЗагруженаФотография" И Источник = ЭтотОбъект Тогда
		ЗавершитьВыборФотографии();
	КонецЕсли;
	
	Если ИмяСобытия = "ИзмененаВидеоконференция" Тогда
		ПрочитатьРаботуСКандидатом();
	КонецЕсли;
	
	Если ИмяСобытия = "ИзмененыНастройкиЛентыСобытий" Тогда
		ЗаполнитьЛентуСобытий();
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_Кандидаты" Тогда
		ЗаполнитьДругиеОбращенияКандидата();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	ОбработкаНавигационнойСсылкиТекущийЭтапЗапланировать(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	ОбработкаНавигационнойСсылкиТекущийЭтапВыполнить(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	ОбработкаНавигационнойСсылкиТекущийЭтапПропустить(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	ОбработкаНавигационнойСсылкиТекущийЭтапПройти(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	
	ОбработкаНавигационнойСсылкиУтвердить(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	ОбработкаНавигационнойСсылкиОтклонить(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	
	ОбработкаНавигационнойСсылкиРешениеОПриемеНаРаботуВвести(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ФайлРезюме <> Неопределено Тогда
		ПараметрыЗаписи.Вставить("ФайлРезюмеДляЗагрузки", ФайлРезюме.ПолноеИмя);
	КонецЕсли;
	ФайлРезюме = Неопределено;
	
	ПараметрыЗаписи.Вставить("ЛичныеДанные", ЛичныеДанныеКандидатаСсылка);
	ПараметрыЗаписи.Вставить("Кандидат", КандидатСсылка);
	ВзаимодействияКлиент.ВзаимодействиеПредметПослеЗаписи(ЭтотОбъект, КандидатОбъект, ПараметрыЗаписи, "Кандидаты");
	
	ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъекта(ЛичныеДанныеКандидатаСсылка);
	ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъекта(КандидатСсылка, ПараметрыОповещения());
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы
		И ОтветПередЗакрытием <> Истина
		И ЗначениеЗаполнено(Комментарий) Тогда
		Отказ = Истина;
		КомментарийПередЗакрытиемВопрос();
	КонецЕсли;
	
КонецПроцедуры

