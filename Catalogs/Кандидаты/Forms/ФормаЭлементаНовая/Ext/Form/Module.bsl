&НаСервере
Процедура УстановитьСвойстваПоляФИО()
	
	Элементы.ФИО.Доступность = ФИОИспользуется;
	
	Если ФИОИспользуется Тогда
		Элементы.ФИО.ПодсказкаВвода = НСтр("ru = 'Фамилия Имя Отчество'");
	Иначе
		Элементы.ФИО.ПодсказкаВвода = КандидатОбъект.Наименование;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаименованиеПоДаннымКандидата()
	
	ЗаблокироватьЛичныеДанныеКандидатаОбъектДляРедактированияНаСервере();
	
	Объект = РеквизитФормыВЗначение("КандидатОбъект");
	Объект.ЗаполнитьНаименованиеПоДаннымКандидата(ЛичныеДанныеКандидата);
	ЗначениеВРеквизитФормы(Объект, "КандидатОбъект");
	
	Элементы.ФИО.ПодсказкаВвода = КандидатОбъект.Наименование;
	
КонецПроцедуры

&НаКлиенте
Процедура ФИОИспользуетсяПриИзмененииЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат <> Неопределено И Результат.Значение = КодВозвратаДиалога.Отмена Тогда
		ФИОИспользуется = Не ФИОИспользуется;
		Возврат;
	КонецЕсли;
	
	ЛичныеДанныеКандидата.ФИООтсутствует = Не ФИОИспользуется;
	
	Если Результат <> Неопределено И Результат.БольшеНеЗадаватьЭтотВопрос Тогда
		ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("НастройкиПрограммы",
			"ПоказыватьПредупреждениеОПустомФИОКандидата", Ложь);
	КонецЕсли;
	
	ЗаполнитьНаименованиеПоДаннымКандидата();
	ЛичныеДанныеКандидата.ФИО = "";
	ФИОПриИзмененииНаСервере();
	
	УстановитьСвойстваПоляФИО();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьАнкетуКандидата(Кандидат, Вакансия, ЭтапРаботы)
	
	ЭлектронноеИнтервью.ОтменитьАнкетыПоЭтапу(Вакансия, ЭтапРаботы, Кандидат);
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Кандидат);
	ЭлектронноеИнтервью.РассчитатьОценкиКандидатов(Вакансия, Кандидаты);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПериодВТабличнойЧастиЛичныхДанныхКандидата(ИмяТабличнойЧасти, Отказ)
	
	Для Каждого ТекущаяСтрока Из ЛичныеДанныеКандидата[ИмяТабличнойЧасти] Цикл
		ПутьКПроверяемойДате = СтрШаблон("ЛичныеДанныеКандидата.%1[%2].ДатаОкончанияПредставление", ИмяТабличнойЧасти,
			ТекущаяСтрока.НомерСтроки - 1);
		ЗарплатаКадры.ПроверитьКорректностьДаты(КандидатОбъект.Ссылка, ТекущаяСтрока.ДатаОкончания,
			ПутьКПроверяемойДате, Отказ, НСтр("ru='Конец периода'"), ТекущаяСтрока.ДатаНачала,
			НСтр("ru='начала периода'"), Ложь);
	КонецЦикла;
	
КонецПроцедуры

