&НаКлиенте
Процедура Подключаемый_ОткрытьВерсию(Элемент)
	
	ДанныеВерсия = СтрЗаменить(Элемент.Имя, "ДекорацияТекстДобавлениеИнформации", "");
	ДанныеВерсия = СтрЗаменить(ДанныеВерсия, "ДекорацияТекстИзменениеИнформации", "");
	
	Данные = "";
	НомерВерсии = 1;
	Если СтрНайти(ДанныеВерсия, "Кандидат") <> 0 Тогда
		Данные = КандидатСсылка;
		НомерВерсии = Число(СтрЗаменить(ДанныеВерсия, "Кандидат", ""));
	КонецЕсли;
	
	Если СтрНайти(ДанныеВерсия, "ЛичныеДанные") <> 0 Тогда
		Данные = ЛичныеДанныеКандидатаСсылка;
		НомерВерсии = Число(СтрЗаменить(ДанныеВерсия, "ЛичныеДанные", ""));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Данные, НомерВерсии", Данные, НомерВерсии);
	ОткрытьФорму("ФормаДанныхВерсииИсторииДанных", ПараметрыФормы);
	
КонецПроцедуры

