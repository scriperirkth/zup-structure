&НаКлиентеНаСервереБезКонтекста
Процедура СоздатьКомандыЭтапаРаботы(Форма, ВидСобытия, НомерСобытия, Группа)
	
	ТекущиеДанные = Форма.РаботаСКандидатамиНаборЗаписей[НомерСобытия];
	Если ТекущиеДанные.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.Утверждение") Тогда
		Если ВидСобытия = ПредопределенноеЗначение("Перечисление.СобытияПоКандидату.ПрохождениеЭтапа") Тогда
			СоздатьДекорациюОтменитьЭтап(НомерСобытия, Группа, Форма.Элементы);
		Иначе
			СоздатьДекорациюУтверждение(Группа, Форма.Элементы);
		КонецЕсли;
		Возврат;
	ИначеЕсли ТекущиеДанные.ЭтапРаботы =
		ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.РешениеОПриемеНаРаботу") Тогда
		Если ВидСобытия = ПредопределенноеЗначение("Перечисление.СобытияПоКандидату.ПрохождениеЭтапа") Тогда
			СоздатьДекорациюОтменитьЭтап(НомерСобытия, Группа, Форма.Элементы);
		Иначе
			СоздатьДекорациюРешениеОПриеме(Группа, Форма.Элементы);
		КонецЕсли;
		Возврат;
	ИначеЕсли ТекущиеДанные.ЭтапРаботы = ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.ПриемНаРаботу")
		Или ТекущиеДанные.ЭтапРаботы =
		ПредопределенноеЗначение("Перечисление.ЭтапыРаботыСКандидатами.РассмотрениеОтклика") Тогда
		Возврат;
	КонецЕсли;
	СоздатьДекорациюЗапланироватьЭтап(НомерСобытия, Группа, Форма.Элементы);
	Если ТекущиеДанные.СостояниеЭтапа <>
		ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Пройден") Тогда
		Если (Форма.ИспользоватьЭлектронноеИнтервью Или Форма.ИспользоватьЭлектронноеТестирование)
			И ЗначениеЗаполнено(ТекущиеДанные.ШаблонАнкеты) Тогда
			СоздатьДекорациюПройтиИнтервью(НомерСобытия, Группа, Форма.Элементы);
		Иначе
			СоздатьДекорациюЗавершитьЭтап(НомерСобытия, Группа, Форма.Элементы);
		КонецЕсли;
	КонецЕсли;
	Если (Форма.ИспользоватьЭлектронноеИнтервью Или Форма.ИспользоватьЭлектронноеТестирование)
		И ЗначениеЗаполнено(ТекущиеДанные.ШаблонАнкеты) Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.АнкетаСсылка) Тогда
			СоздатьДекорациюОткрытьАнкету(НомерСобытия, Группа, Форма.Элементы);
		КонецЕсли;
		СоздатьДекорациюПечатьАнкеты(НомерСобытия, Группа, Форма.Элементы);
	КонецЕсли;
	Если ТекущиеДанные.СостояниеЭтапа <>
		ПредопределенноеЗначение("Перечисление.СостоянияЭтаповРаботыСКандидатами.Пропущен") Тогда
		СоздатьДекорациюПропуститьЭтап(НомерСобытия, Группа, Форма.Элементы);
	КонецЕсли;
	СоздатьДекорациюОтменитьЭтап(НомерСобытия, Группа, Форма.Элементы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТекстДобавленияДанныхКандидата(Различия, Событие)
	
	Если Различия.Количество() = 1 Тогда
		Ключ = Различия[0].Ключ;
		Значение = Различия[0].Значение;
		ЗначениеПослеИзменения = Значение.ЗначениеПослеИзменения;
		Если Ключ = "Вакансия" Тогда
			Событие.ТекстСобытия = СтрШаблон(НСтр("ru = 'Вписана вакансия: %1'"), ЗначениеПослеИзменения.Представление);
		ИначеЕсли Ключ = "Ответственный" Тогда
			Событие.ТекстСобытия = СтрШаблон(НСтр("ru = 'Вписан ответственный: %1'"), ЗначениеПослеИзменения.Представление);
		ИначеЕсли Ключ = "ДатаРегистрации" Тогда
			Событие.ТекстСобытия = СтрШаблон(НСтр("ru = 'Вписана дата поступления: %1'"),
				Формат(ЗначениеПослеИзменения, "ДФ='dd.MM.yyyy ЧЧ:мм'"));
		ИначеЕсли Ключ = "ОжидаемыйДоход" Тогда
			Событие.ТекстСобытия = СтрШаблон(НСтр("ru = 'Вписан ожидаемый доход: %1'"), ЗначениеПослеИзменения);
		ИначеЕсли Ключ = "НазваниеРезюме" Тогда
			Событие.ТекстСобытия = СтрШаблон(НСтр("ru = 'Вписано название резюме: %1'"), ЗначениеПослеИзменения);
		КонецЕсли;
	Иначе
		ИменаПолей = Новый Массив;
		Для Каждого Различие Из Различия Цикл
			Если Различие.Ключ = "Вакансия" И ЗначениеЗаполнено(Различие.Значение.ЗначениеПослеИзменения.Ссылка) Тогда
				ИменаПолей.Добавить(НСтр("ru = 'вакансия'"));
			ИначеЕсли Различие.Ключ = "Ответственный" И ЗначениеЗаполнено(Различие.Значение.ЗначениеПослеИзменения.Ссылка) Тогда
				ИменаПолей.Добавить(НСтр("ru = 'ответственный'"));
			ИначеЕсли Различие.Ключ = "ДатаРегистрации" И ЗначениеЗаполнено(Различие.Значение.ЗначениеПослеИзменения) Тогда
				ИменаПолей.Добавить(НСтр("ru = 'дата поступления'"));
			ИначеЕсли Различие.Ключ = "ОжидаемыйДоход" И ЗначениеЗаполнено(Различие.Значение.ЗначениеПослеИзменения) Тогда
				ИменаПолей.Добавить(НСтр("ru = 'ожидаемый доход'"));
			ИначеЕсли Различие.Ключ = "НазваниеРезюме" И ЗначениеЗаполнено(Различие.Значение.ЗначениеПослеИзменения) Тогда
				ИменаПолей.Добавить(НСтр("ru = 'название резюме'"));
			КонецЕсли;
		КонецЦикла;
		Событие.ТекстСобытия = СтрСоединить(ИменаПолей, ", ");
		Событие.Гиперссылка = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТекстИзмененияДанныхКандидата(Различия, Событие)
	
	Если Различия.Количество() = 1 Тогда
		Ключ = Различия[0].Ключ;
		Значение = Различия[0].Значение;
		ЗначениеДоИзменения = Значение.ЗначениеДоИзменения;
		ЗначениеПослеИзменения = Значение.ЗначениеПослеИзменения;
		Если Ключ = "Вакансия" Тогда
			Событие.ТекстСобытия = СтрШаблон(НСтр("ru = 'Изменена вакансия с %1 на %2'"),
				ЗначениеДоИзменения.Ссылка, ЗначениеПослеИзменения.Ссылка);
		ИначеЕсли Ключ = "ДатаРегистрации" Тогда
			Событие.ТекстСобытия = СтрШаблон(НСтр("ru = 'Изменена дата поступления с %1 на %2'"),
				Формат(ЗначениеДоИзменения, "ДФ='dd.MM.yyyy ЧЧ:мм'"),
				Формат(ЗначениеПослеИзменения, "ДФ='dd.MM.yyyy ЧЧ:мм'"));
