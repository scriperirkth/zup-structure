#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отклонить(Команда)
	
	ОбщегоНазначенияКлиентСервер.Проверить(Не КандидатОбъект.Ссылка.Пустая(),
		НСтр("ru = 'Отклонение возможно только после записи кандидата.'"));
	
	Решение = ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Отклонено");
	НачатьПринятиеРешения(Решение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРешение(Команда)
	
	ОбщегоНазначенияКлиентСервер.Проверить(Не КандидатОбъект.Ссылка.Пустая(),
		НСтр("ru = 'Отменить решение возможно только после записи кандидата.'"));
	
	НачатьОтменуРешения();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКандидатов(Команда)
	
	ПараметрыСписка = Новый Структура("Отбор");
	ПараметрыСписка.Отбор = Новый Структура("ЛичныеДанные", КандидатОбъект.ЛичныеДанные);
	
	ОткрытьФорму("Справочник.Кандидаты.ФормаСписка", ПараметрыСписка, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКандидата(Команда)
	
	ПодборПерсоналаКлиент.ОткрытьФормуНовогоКандидата(
		Новый Структура("ЛичныеДанныеКандидата", КандидатОбъект.ЛичныеДанные),,
		КандидатОбъект.ЛичныеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетПоСравнениюХарактеристик(Команда)
	
	Если Не ЗначениеЗаполнено(КандидатОбъект.Вакансия) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Вакансия", КандидатОбъект.Вакансия);
	ОткрытьФорму("Обработка.СравнениеХарактеристикКандидатов.Форма", ПараметрыОткрытия,, Новый УникальныйИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ПодробныйОтчетПоХарактеристикам(Команда)
	
	Если КандидатОбъект.Ссылка.Пустая() Или Не ЗначениеЗаполнено(КандидатОбъект.Вакансия) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Вакансия", КандидатОбъект.Вакансия);
	ПараметрыОткрытия.Вставить("Кандидат", КандидатОбъект.Ссылка);
	ОткрытьФорму("Отчет.СравнениеХарактеристикКандидатовПодробно.Форма", ПараметрыОткрытия,, Новый УникальныйИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьОценку(Команда)
	
	Если Не ЗначениеЗаполнено(КандидатОбъект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Кандидат", КандидатОбъект.Ссылка);
	ОткрытьФорму("Отчет.ОценкиКандидатаРасшифровка.Форма", ПараметрыОткрытия,, Новый УникальныйИдентификатор());	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФотографию(Команда)
	НачатьВыборФотографии();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФотографию(Команда)
	
	Если Не ЗначениеЗаполнено(АдресФотографии) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьЛичныеДанныеКандидатаОбъектДляРедактирования();
	УдалитьИзВременногоХранилища(АдресФотографии);
	АдресФотографии = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьКонтакты(Команда)
	
	ПоказатьВопросПоКонтактногоДоступа(КандидатОбъект.ИсточникИнформации, СкрытыеКонтактыПредставление);
	
КонецПроцедуры

&НаКлиенте
Процедура ОставитьКомментарий(Команда)
	
	Если ЗначениеЗаполнено(Комментарий) Тогда
		ОставитьКомментарийНаСервере();
	КонецЕсли;
	
	Комментарий = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьСтаруюФормуОбъекта(Команда)
	
	Если Не КандидатОбъект.Ссылка.Пустая() И Не Модифицированность Тогда
		ОткрытьСтаруюФормуОбъекта();
		Возврат;
	КонецЕсли;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОткрытьСтаруюФормуОбъектаПослеВопросаЗаписать", ЭтотОбъект);
	ПоказатьВопросЗаписиКандидата(ОбработчикОповещения);
	
КонецПроцедуры

