&НаСервереБезКонтекста
Процедура ДобавитьСобытияИзменениеИнформации(События, Кандидат, ЛичныеДанные, Добавления, Изменения)
	
	//Кандидат
	ДоступныеКлючиИзмененияИнформации = ДоступныеКлючиИзмененияКандидата();
	
	ИсторияДанных.ОбновитьИсторию(Кандидат);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Данные", Кандидат);
	ВерсииКандидата = ИсторияДанных.ВыбратьВерсии(Отбор);
	ВерсииКандидата.Сортировать("НомерВерсии");
	
	КоличествоВерсий = ВерсииКандидата.Количество();
	Для НомерВерсии = 0 По КоличествоВерсий - 1 Цикл
		ОтслеживаемыеРазличияДобавление = Новый Массив;
		ОтслеживаемыеРазличияИзменение = Новый Массив;
		РазлицияВерсий = ИсторияДанных.ПолучитьРазличияВерсий(Кандидат, НомерВерсии + 1);
		Для Каждого Различие Из РазлицияВерсий Цикл
			Если ДоступныеКлючиИзмененияИнформации.Найти(Различие.Ключ) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Различие.Значение.Свойство("ЗначениеДоИзменения") Тогда
				Если Изменения И ((Различие.Ключ = "Вакансия" Или Различие.Ключ = "Ответственный")
						И ЗначениеЗаполнено(Различие.Значение.ЗначениеДоИзменения.Ссылка))
					Или ((Различие.Ключ = "ДатаРегистрации" Или Различие.Ключ = "ОжидаемыйДоход" Или Различие.Ключ = "НазваниеРезюме")
						И ЗначениеЗаполнено(Различие.Значение.ЗначениеДоИзменения))
					Или (Различие.Ключ = "ПериодичностьДохода" Или Различие.Ключ = "ВалютаДохода") Тогда
					ОтслеживаемыеРазличияИзменение.Добавить(Различие);
				ИначеЕсли Добавления Тогда
					ОтслеживаемыеРазличияДобавление.Добавить(Различие);
				КонецЕсли;
			ИначеЕсли Добавления Тогда
				ОтслеживаемыеРазличияДобавление.Добавить(Различие);
			КонецЕсли;
		КонецЦикла;
		
		Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ВерсииКандидата[НомерВерсии].ИмяПользователя); 
		Автор = ПредставлениеОтветственного(Ответственный);
		Если ОтслеживаемыеРазличияДобавление.Количество() <> 0 Тогда
			Событие = События.Добавить();
			Событие.Период = ВерсииКандидата[НомерВерсии].Дата;
			Событие.Автор = Автор;
			Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ДобавлениеИнформации;
			Событие.НомерСобытия = НомерВерсии + 1;
			Событие.ПредметСобытия = "Кандидат";
			ЗаполнитьТекстДобавленияДанныхКандидата(ОтслеживаемыеРазличияДобавление, Событие);
		КонецЕсли;
		
		Если ОтслеживаемыеРазличияИзменение.Количество() <> 0 Тогда
			Событие = События.Добавить();
			Событие.Период = ВерсииКандидата[НомерВерсии].Дата;
			Событие.Автор = Автор;
			Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ИзменениеИнформации;
			Событие.НомерСобытия = НомерВерсии + 1;
			Событие.ПредметСобытия = "Кандидат";
			ЗаполнитьТекстИзмененияДанныхКандидата(ОтслеживаемыеРазличияИзменение, Событие);
		КонецЕсли;
	КонецЦикла;
	
	// Личные данные кандидата
	ДоступныеКлючиИзмененияИнформации = ДоступныеКлючиИзмененияЛичныхДанныхКандидата();
	
	ИсторияДанных.ОбновитьИсторию(ЛичныеДанные);
	
	Отбор.Вставить("Данные", ЛичныеДанные);
	ВерсииЛичныхДанных = ИсторияДанных.ВыбратьВерсии(Отбор);
	ВерсииЛичныхДанных.Сортировать("НомерВерсии");
	
	Для НомерВерсии = 0 По ВерсииЛичныхДанных.Количество() - 1 Цикл
		ОтслеживаемыеРазличияДобавление = Новый Массив;
		ОтслеживаемыеРазличияИзменение = Новый Массив;
		РазлицияВерсий = ИсторияДанных.ПолучитьРазличияВерсий(ЛичныеДанные, НомерВерсии + 1);
		Для Каждого Различие Из РазлицияВерсий Цикл
			Если ДоступныеКлючиИзмененияИнформации.Найти(Различие.Ключ) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоТаблицаЛичныхДанных(Различие.Ключ) Тогда
				Если Различие.Значение.Количество() <> 0 Тогда
					Если Добавления И Различие.Значение[0].ВидИзмененияСтроки = ВидИзмененияСтрокиДанных.Добавление Тогда
						ОтслеживаемыеРазличияДобавление.Добавить(Различие);
					ИначеЕсли Изменения Тогда
						ОтслеживаемыеРазличияИзменение.Добавить(Различие);
					КонецЕсли;
				КонецЕсли;
				Продолжить;
			ИначеЕсли Различие.Значение.Свойство("ЗначениеДоИзменения") Тогда
				Если Изменения И ((Различие.Ключ = "ФИО" Или Различие.Ключ = "ДатаРождения" Или Различие.Ключ = "МестоРождения")
						И ЗначениеЗаполнено(Различие.Значение.ЗначениеДоИзменения))
					Или (Различие.Ключ = "СостояниеВБраке"
						И ЗначениеЗаполнено(Различие.Значение.ЗначениеДоИзменения.Ссылка)) Тогда
					ОтслеживаемыеРазличияИзменение.Добавить(Различие);
				ИначеЕсли Добавления Тогда
					ОтслеживаемыеРазличияДобавление.Добавить(Различие);
				КонецЕсли;
			ИначеЕсли Добавления Тогда
				ОтслеживаемыеРазличияДобавление.Добавить(Различие);
			КонецЕсли;
		КонецЦикла;
		
		Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ВерсииЛичныхДанных[НомерВерсии].ИмяПользователя); 
		Автор = ПредставлениеОтветственного(Ответственный);
		Если ОтслеживаемыеРазличияДобавление.Количество() <> 0 Тогда
			Событие = События.Добавить();
			Событие.Период = ВерсииЛичныхДанных[НомерВерсии].Дата;
			Событие.Автор = Автор;
			Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ДобавлениеИнформации;
			Событие.НомерСобытия = НомерВерсии + 1;
			Событие.ПредметСобытия = "ЛичныеДанные";
			ЗаполнитьТекстДобавленияЛичныхДанных(ОтслеживаемыеРазличияДобавление, Событие);
		КонецЕсли;
		
		Если ОтслеживаемыеРазличияИзменение.Количество() <> 0 Тогда
			Событие = События.Добавить();
			Событие.Период = ВерсииЛичныхДанных[НомерВерсии].Дата;
			Событие.Автор = Автор;
			Событие.ВидСобытия = Перечисления.СобытияПоКандидату.ИзменениеИнформации;
			Событие.НомерСобытия = НомерВерсии + 1;
			Событие.ПредметСобытия = "ЛичныеДанные";
			ЗаполнитьТекстИзмененияЛичныхДанных(ОтслеживаемыеРазличияИзменение, Событие);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ИзменениеФормыОбъекта

&НаКлиенте
Процедура ОткрытьСтаруюФормуОбъектаПослеВопросаЗаписать(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьСтаруюФормуОбъекта();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтаруюФормуОбъекта()
	
	ПодборПерсоналаВызовСервера.СохранитьНастройкуОткрытияФормы(Истина);
	ОткрытьФорму("Справочник.Кандидаты.ФормаОбъекта", Новый Структура("Ключ", Параметры.Ключ),, Истина);
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

