		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
		НовыйЭлемент.Шрифт = ШрифтЗаголовкаРезюме();
		НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '%1%2'"),
			Образование.УчебноеЗаведение,
			?(Образование.ГодОкончания = 0, "", ", " + Формат((Образование.ГодОкончания), "ЧГ=") + " г."));
		
		НовыйЭлемент = Элементы.Добавить("ОбразованиеСпециальностьВидОбразования" + Образование.НомерСтроки,
			Тип("ДекорацияФормы"), Группа);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
		НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '%1 (%2)'"),
			Образование.Специальность,
			Образование.ВидОбразования);
		
		НовыйЭлемент = Элементы.Добавить("ОбразованиеФакультет" + Образование.НомерСтроки, Тип("ДекорацияФормы"), Группа);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.Заголовок = Образование.Факультет;
	КонецЦикла;
	
