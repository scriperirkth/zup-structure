// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Подразделение)";
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ИнформационнаяСтрокаЗанятости", Истина);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиПравилРегистрации

// См. ЗарплатаКадрыРасширенныйСинхронизацияДанных.ШаблонОбработчика
Процедура ПриЗаполненииНастроекОбработчиковПравилРегистрации(Настройки) Экспорт
	ЗарплатаКадрыРасширенныйСинхронизацияДанных.ДляОтбораПоПодразделению(Настройки);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаИнформационныхСтрокЗанятости()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Сценарий", Новый ОписаниеТипов("СправочникСсылка.Сценарии"));
	Таблица.Колонки.Добавить("КоличествоСтавок", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ЗапланированоСтавок", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ЗанятоСтавок", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ЗанятоСотрудниками", Новый ОписаниеТипов("Массив"));
	Таблица.Колонки.Добавить("ИнформационнаяСтрокаЗанятости", Новый ОписаниеТипов("ФорматированнаяСтрока"));
	
	Возврат Таблица;
	
КонецФункции

Процедура ЗаполнитьИнформационныеСтрокиЗанятости(ТаблицаИнформационныхСтрок, ДанныеПозиции)
	
	Запрос = Новый Запрос;
	ТекущаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ТекущаяДата));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ТекущаяДата));
	Запрос.УстановитьПараметр("Позиция", ДанныеПозиции.Позиция);
	Запрос.УстановитьПараметр("Показатель", КадровоеПланирование.ПоказательКоличествоСтавок());
	Запрос.Текст =
		"ВЫБРАТЬ
		|	&Позиция КАК ПозицияКадровогоПлана
		|ПОМЕСТИТЬ ВТПозицииКадровогоПлана
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоказателиКадровогоПлана.Сценарий КАК Сценарий,
		|	СУММА(ЕСТЬNULL(ПоказателиКадровогоПлана.Значение, 0)) КАК ЗапланированоСтавок
		|ИЗ
		|	ВТПозицииКадровогоПлана КАК ПозицииКадровогоПлана
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПоказателиКадровогоПлана КАК ПоказателиКадровогоПлана
		|		ПО ПозицииКадровогоПлана.ПозицияКадровогоПлана = ПоказателиКадровогоПлана.Позиция
		|			И (ПоказателиКадровогоПлана.Период МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|			И (ПоказателиКадровогоПлана.Показатель = &Показатель)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПоказателиКадровогоПлана.Сценарий";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаИнформационныхСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	// Составляем перечень связанных позиций ШР с позицией кадрового плана.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПозицияКадровогоПлана", ДанныеПозиции.Позиция);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПозицииШтатногоРасписания.ПозицияШтатногоРасписания КАК ПозицияШтатногоРасписания
		|ИЗ
		|	РегистрСведений.ПозицииШтатногоРасписанияПоКадровомуПлану КАК ПозицииШтатногоРасписания
		|ГДЕ
		|	ПозицииШтатногоРасписания.ПозицияКадровогоПлана = &ПозицияКадровогоПлана";
	
	ПозицииШтатногоРасписания = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПозицияШтатногоРасписания");
	
	Если ПозицииШтатногоРасписания.Количество() = 0 Тогда
		Для Каждого СтрокаИнформации Из ТаблицаИнформационныхСтрок Цикл
			КадровоеПланирование.ЗаполнитьИнформационнуюСтрокуЗанятости(СтрокаИнформации);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	// Получаем сотрудников, работающих на связанных позициях ШР.
	ПараметрыЗапроса = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы, "ДолжностьПоШтатномуРасписанию", "В", ПозицииШтатногоРасписания);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы, "ДатаУвольнения", "=", Дата(1, 1, 1));
	
	УстановитьПривилегированныйРежим(Истина);
	СотрудникиОрганизации = КадровыйУчет.СотрудникиОрганизации(Ложь, ПараметрыЗапроса);
	УстановитьПривилегированныйРежим(Ложь);
	
	ЗанятоСтавок = СотрудникиОрганизации.Количество();
	Сотрудники = СотрудникиОрганизации.ВыгрузитьКолонку("Сотрудник");
	КоличествоСтавокШР = КоличествоСтавокШтатногоРасписания(ПозицииШтатногоРасписания);
	
	Для Каждого СтрокаИнформации Из ТаблицаИнформационныхСтрок Цикл
		СтрокаИнформации.ЗанятоСтавок = ЗанятоСтавок;
		СтрокаИнформации.ЗанятоСотрудниками = Сотрудники;
		СтрокаИнформации.КоличествоСтавок = КоличествоСтавокШР;
		КадровоеПланирование.ЗаполнитьИнформационнуюСтрокуЗанятости(СтрокаИнформации);
	КонецЦикла;
		
КонецПроцедуры

Функция ИнформационнаяСтрокаЗанятости(ДанныеПозиции) Экспорт
	
	ТаблицаИнформационныхСтрок = ТаблицаИнформационныхСтрокЗанятости();
	ЗаполнитьИнформационныеСтрокиЗанятости(ТаблицаИнформационныхСтрок, ДанныеПозиции);
	
	Если ТаблицаИнформационныхСтрок.Количество() = 0 Тогда
		ТаблицаИнформационныхСтрок.Добавить();
	КонецЕсли;
	
	ЧастиНадписи = Новый Массив;
	Для Каждого Строка Из ТаблицаИнформационныхСтрок Цикл
		Если ЧастиНадписи.Количество() > 0 Тогда
			ЧастиНадписи.Добавить(Символы.ПС);
		КонецЕсли;
		ЧастиНадписи.Добавить(Строка.ИнформационнаяСтрокаЗанятости);
	КонецЦикла;
	
	Возврат Новый Структура("ИнформационнаяСтрокаЗанятости", Новый ФорматированнаяСтрока(ЧастиНадписи));
	
КонецФункции

Функция КоличествоСтавокШтатногоРасписания(ПозицииШтатногоРасписания)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПараметрыПостроения = УправлениеШтатнымРасписанием.ПараметрыПостроенияВТШтатноеРасписание(
		ОбщегоНазначения.ТекущаяДатаПользователя(), , , ПозицииШтатногоРасписания);
	УправлениеШтатнымРасписанием.СоздатьВТШтатноеРасписание(
		Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыПостроения, "КоличествоСтавок");
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ПозицииШтатногоРасписания.КоличествоСтавок) КАК КоличествоСтавок
		|ИЗ
		|	ВТШтатноеРасписание КАК ПозицииШтатногоРасписания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоСтавок;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

#КонецОбласти

#КонецЕсли