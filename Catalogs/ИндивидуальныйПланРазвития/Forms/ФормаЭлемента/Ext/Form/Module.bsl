// СтандартныеПодсистемы.Свойства
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено,
	СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры
// Конец СтандартныеПодсистемы.Свойства

&НаКлиенте
Процедура ПоКомпетенциям(Команда)
	
	Элементы.ХарактеристикиПерсоналаПоКомпетенциям.Пометка = Не Элементы.ХарактеристикиПерсоналаПоКомпетенциям.Пометка;
	ПоКомпетенциямНаСервере();
	РазвернутьУзлыДереваХарактеристик();

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРезультатОбучения(Команда)
	
	ТекущиеДанные = Элементы.ПланРазвития.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
	 Или Не ЗначениеЗаполнено(ТекущиеДанные.Мероприятие) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ДокументыОбучения.Количество() <> 0 Тогда
		НачатьИзменениеДокументаОбучения(ТекущиеДанные);
	Иначе
		НачатьСозданиеДокументаОбучения(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультатОбучения(Команда)
	
	ТекущиеДанные = Элементы.ПланРазвития.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
	 Или Не ЗначениеЗаполнено(ТекущиеДанные.Мероприятие) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ВыбранноеОбучение = Неопределено;
	ТекущиеДанные.Обучение = "";
	ТекущиеДанные.ДокументыОбучения = Новый СписокЗначений();
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриПолученииДанныхНаСервере()
	
	// Использование целей развития
	ИспользоватьЦелиРазвитияСотрудников = ПолучитьФункциональнуюОпцию("ИспользоватьЦелиРазвитияСотрудников");
	ВидимостьПланаРазвития = (Объект.ЦелиРазвития.Количество() > 0) Или (Объект.Мероприятия.Количество() = 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПрограммаОбученияСтраница", "Видимость", Не ИспользоватьЦелиРазвитияСотрудников Или Не ВидимостьПланаРазвития);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПланРазвитияСтраница", "Видимость", ИспользоватьЦелиРазвитияСотрудников И ВидимостьПланаРазвития);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПодборЦелейРазвития", "Видимость", ИспользоватьЦелиРазвитияСотрудников И ВидимостьПланаРазвития);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВидимостьПланаРазвития", "Видимость", ИспользоватьЦелиРазвитияСотрудников);
	
	УстановитьСвойстваЭлементовФормы();
	
	ОбучениеРазвитиеФормы.ЗаполнитьКэшХарактеристикиМероприятияПоХарактеристикам(КэшХарактеристикиМероприятия, 
		Объект.РазвиваемыеХарактеристики.Выгрузить(, "Характеристика").ВыгрузитьКолонку("Характеристика"));
	
	ЗаполнитьВторичнуюТаблицуХарактеристики();
	ЗаполнитьВторичнуюИнформациюПланаОбучения(); 
	ЗаполнитьРезультатыОбучения();
	
	Элементы.ХарактеристикиПерсоналаПоКомпетенциям.Пометка = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователя", ИмяНастройкиОтображенияПоКомпетенциям(), Ложь);
	УстановитьСвойстваЭлементовХарактеристикПерсонала();
	ЗаполнитьДеревоХарактеристик();
	
	ВключитьНаставника(ЭтотОбъект, Объект.ЕстьНаставник);
	ВключитьКуратора(ЭтотОбъект, Объект.ЕстьКуратор);
	
	ЧтениеПрогрессаОбученияСотрудников = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ПрогрессОбученияСотрудников);
	ДобавлениеИзменениеПрогрессаОбученияСотрудников = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ПрогрессОбученияСотрудников);
	Если Не Пользователи.ЭтоПолноправныйПользователь()
		И Не ЧтениеПрогрессаОбученияСотрудников 
		И Не ДобавлениеИзменениеПрогрессаОбученияСотрудников Тогда
		Возврат;
	КонецЕсли;
	
	Если ЧтениеПрогрессаОбученияСотрудников И Не ДобавлениеИзменениеПрогрессаОбученияСотрудников Тогда
		Элементы.ПланРазвитияПрогрессГруппа.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ИспользоватьОценкуПрохожденияИПР = ПолучитьФункциональнуюОпцию("ИспользоватьПрогрессОбучения");
	Если Не ИспользоватьОценкуПрохожденияИПР Тогда
		Объект.ИспользоватьПрогрессРазвития = Ложь;
	Иначе
		НастройкиОбученияРазвития = РегистрыСведений.НастройкиОбученияРазвития.ЗначенияНастроек();
		Если НастройкиОбученияРазвития.ИспользоватьПрогрессОбучения Тогда
			Объект.ИспользоватьПрогрессРазвития = НастройкиОбученияРазвития.ИспользоватьПрогрессОбучения;
			Объект.ПродолжительностьПрогрессаРазвития = НастройкиОбученияРазвития.ПродолжительностьПрогрессаОбучения;
			Объект.РазмерностьПродолжительностиПрогрессаРазвития =
				НастройкиОбученияРазвития.РазмерностьПродолжительностиПрогрессаОбучения;
		КонецЕсли;
		СоздатьИЗаполнитьРеквизитыПрогрессаОбучения();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроцентВыполненияПланаРазвития()
	
	ЧислоКолонок = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "Объект.ПродолжительностьПрогрессаРазвития");
	Дерево = РеквизитФормыВЗначение("ПланРазвития");
	Объект.ПрогрессВыполнения = 0;
	Для Сч = 1 По ЧислоКолонок Цикл
		ОбщийПрогресс = Новый Массив;
		Для Каждого СтрокаЦели Из Дерево.Строки Цикл
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОбщийПрогресс,
				СтрокаЦели.Строки.ВыгрузитьКолонку("Прогресс" + Строка(Сч)));
		КонецЦикла;
		
		КоличествоМероприятий = 0;
		СуммаПрогресса = 0;
		ВыполнениеПланаРазвития = Истина;
		Для Каждого ЗначениеПрогресса Из ОбщийПрогресс Цикл
			Если ЗначениеПрогресса = Справочники.ЗначенияПрогрессаОбучения.ПустаяСсылка() Тогда
				ВыполнениеПланаРазвития = Ложь;
				Прервать;
			Иначе
				Прогресс = ЗначениеПрогресса.Прогресс;
			КонецЕсли;
			СуммаПрогресса = СуммаПрогресса + Прогресс;
			КоличествоМероприятий = КоличествоМероприятий + 1;
		КонецЦикла;
		Если ВыполнениеПланаРазвития И КоличествоМероприятий <> 0 Тогда
			ИтогПрогресса = СуммаПрогресса / КоличествоМероприятий;
			ЭтотОбъект["ИтогПрогресса" + Строка(Сч)] = Формат(ИтогПрогресса, "ЧДЦ=0;") + "%";
			Объект.ПрогрессВыполнения = ИтогПрогресса;
		Иначе
			ИтогПрогресса = 0;
			ЭтотОбъект["ИтогПрогресса" + Строка(Сч)] = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьИЗаполнитьРеквизитыПрогрессаОбучения()
	
	ПараметрыПрогрессаОбучения = ОбучениеРазвитиеФормы.ПараметрыПрогрессаОбучения();
	ПараметрыПрогрессаОбучения.Группа = "ПланРазвитияПрогрессГруппа";
	ПараметрыПрогрессаОбучения.ЧислоКолонок = Объект.ПродолжительностьПрогрессаРазвития;
	ПараметрыПрогрессаОбучения.РасположениеРеквизитов = "ПланРазвития";
	ПараметрыПрогрессаОбучения.Источник = "ИПР";
	ПараметрыПрогрессаОбучения.Размерность = Объект.РазмерностьПродолжительностиПрогрессаРазвития;
	
	ОбучениеРазвитиеФормы.СоздатьРеквизитыПрогрессаОбучения(ЭтотОбъект, ПараметрыПрогрессаОбучения);
	
	УстановитьЗначенияПериодовПрогрессаРазвития();
	ЗаполнитьПроцентВыполненияПланаРазвития();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияПериодовПрогрессаРазвития()
	
	Дерево = РеквизитФормыВЗначение("ПланРазвития");
	Дерево.Строки.Очистить();
	
	РеквизитПланРазвития = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ПланРазвития");
	ПрогрессРазвития = РегистрыСведений.ПрогрессОбученияСотрудников.ПрогрессОбучения(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Владелец));
	
	Для Каждого Цель Из РеквизитПланРазвития.ПолучитьЭлементы() Цикл
		Мероприятия = Цель.ПолучитьЭлементы();
		Для Каждого Мероприятие Из Мероприятия Цикл
			ЕстьОбучение = Ложь;
			Если Мероприятие.ДокументыОбучения.Количество() <> 0 Тогда
				ЕстьОбучение = Истина;
				Обучение = Мероприятие.ДокументыОбучения[0].Значение;
			Иначе
				Отборы = Новый Структура;
				Отборы.Вставить("Мероприятие", Мероприятие.Мероприятие);
				ПрогрессМероприятия = ПрогрессРазвития.НайтиСтроки(Отборы);
				Если ПрогрессМероприятия.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Для Сч = 1 По ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "Объект.ПродолжительностьПрогрессаРазвития") Цикл
				Отборы = Новый Структура;
				Если ЕстьОбучение Тогда
					Отборы.Вставить("РегистраторПрогресса", Обучение);
				Иначе
					Если Параметры.Ключ.Пустая() И ЗначениеЗаполнено(Объект.СкорректированныйИПР) Тогда
						РегистраторПрогресса = Объект.СкорректированныйИПР;
					Иначе
						РегистраторПрогресса = Объект.Ссылка;
					КонецЕсли;
					Отборы.Вставить("РегистраторПрогресса", РегистраторПрогресса);
					Отборы.Вставить("Мероприятие", Мероприятие.Мероприятие);
				КонецЕсли;
				Отборы.Вставить("НомерПериода", Сч);
				ПрогрессМероприятия = ПрогрессРазвития.НайтиСтроки(Отборы);
				Если ПрогрессМероприятия.Количество() = 0 Тогда
					Мероприятие["Прогресс" + Строка(Сч)] = Справочники.ЗначенияПрогрессаОбучения.ПустаяСсылка();
				Иначе
					Мероприятие["Прогресс" + Строка(Сч)] = ПрогрессМероприятия[0].Прогресс;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьХарактеристики()
	
	ДополнитьХарактеристикиОценками();
	ДополнитьХарактеристикиЦелевымУровнем();
	ДополнитьХарактеристикиДаннымиХарактеристикСотрудника();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичнуюТаблицуХарактеристики()
	
	ХарактеристикиПерсоналаФормы.ПрочитатьХарактеристикиВТаблицы(Объект.РазвиваемыеХарактеристики, Характеристики,
		ЗначенияХарактеристики);
	
	// загружаем цели, мероприятия
	Дерево = РеквизитФормыВЗначение("ПланРазвития");
	Дерево.Строки.Очистить();
	
	Для Каждого Строка Из Объект.ЦелиРазвития Цикл
		СтрокаЦель = Дерево.Строки.Добавить();
		СтрокаЦель.Цель = Строка.Цель;
		НайденныеСтроки = Объект.Мероприятия.НайтиСтроки(Новый Структура("Цель", Строка.Цель));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			СтрокаМероприятие = СтрокаЦель.Строки.Добавить();
			СтрокаМероприятие.Мероприятие = НайденнаяСтрока.Мероприятие;
			СтрокаМероприятие.ДатаНачала = НайденнаяСтрока.ДатаНачала;
			СтрокаМероприятие.ДатаОкончания = НайденнаяСтрока.ДатаОкончания;
			СтрокаМероприятие.Ответственный = НайденнаяСтрока.Ответственный;
			СтрокаМероприятие.Результат = НайденнаяСтрока.РезультатВыполнения;
			СтрокаМероприятие.Обучение = НайденнаяСтрока.Обучение;
			Если ЗначениеЗаполнено(НайденнаяСтрока.ВыбранноеОбучение)
				И НайденнаяСтрока.ВыбранноеОбучение.Проведен
				И Не НайденнаяСтрока.ВыбранноеОбучение.ПометкаУдаления Тогда
				СтрокаМероприятие.ВыбранноеОбучение = НайденнаяСтрока.ВыбранноеОбучение;
				СтрокаМероприятие.Обучение = СтрШаблон(НСтр("ru = 'Обучение с %1 по %2'"), 
					Формат(НайденнаяСтрока.ВыбранноеОбучение.ДатаНачала, "ДЛФ=D;"), 
					Формат(НайденнаяСтрока.ВыбранноеОбучение.ДатаОкончания, "ДЛФ=D;"));
				СтрокаМероприятие.ДокументыОбучения = Новый СписокЗначений();
				СтрокаМероприятие.ДокументыОбучения.Добавить(НайденнаяСтрока.ВыбранноеОбучение);
			Иначе
				СтрокаМероприятие.ВыбранноеОбучение = Неопределено;
				СтрокаМероприятие.Обучение = "";
				СтрокаМероприятие.ДокументыОбучения = Новый СписокЗначений();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево,"ПланРазвития");
	
	Элементы.ПланРазвития.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	
	ДополнитьХарактеристики();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичнуюИнформациюПланаОбучения()
	
	ОбучениеРазвитиеФормы.ЗаполнитьСтрокиХарактеристикВТаблицеПрограммаОбучения(
		Объект.Мероприятия, Объект.РазвиваемыеХарактеристики, КэшХарактеристикиМероприятия);
	ОбучениеРазвитиеФормы.ЗаполнитьУчебныеЧасыПланаОбучения(ЭтотОбъект, , "Объект.Мероприятия");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРезультатыОбучения(СтрокиТаблицы = Неопределено)
	
	Если Не РезультатыОбученияДоступны Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрокМероприятие = Новый Структура("Мероприятие, ДатаНачала, ДатаОкончания");
	ОтборСтрокВыбранноеОбучение = Новый Структура("ВыбранноеОбучение");
	Результаты = РезультатыОбучения(Объект.Владелец,
		Объект.Мероприятия.Выгрузить(СтрокиТаблицы, "Мероприятие, ДатаНачала, ДатаОкончания, ВыбранноеОбучение"));
	Обход = Обработки.ОбходКоллекции.НовыйОбход(Результаты);
	
	Если Не ВидимостьПланаРазвития Тогда
		Пока Обход.СледующийПоЗначениямПолей("ФизическоеЛицо, Мероприятие, ДатаНачалаПлан, ДатаОкончанияПлан") Цикл
			ТекущиеДанные = Обход.ТекущиеДанные();
			ОтборСтрокМероприятие.Мероприятие = ТекущиеДанные.Мероприятие;
			ОтборСтрокМероприятие.ДатаНачала = ТекущиеДанные.ДатаНачалаПлан;
			ОтборСтрокМероприятие.ДатаОкончания = ТекущиеДанные.ДатаОкончанияПлан;
			НайденныеСтроки = Объект.Мероприятия.НайтиСтроки(ОтборСтрокМероприятие);
			
			Если ЗначениеЗаполнено(ТекущиеДанные.ВыбранноеОбучение) Тогда
				ОтборСтрокВыбранноеОбучение.ВыбранноеОбучение = ТекущиеДанные.ВыбранноеОбучение;
				НайденныеСтрокиОбучения = Объект.Мероприятия.НайтиСтроки(ОтборСтрокВыбранноеОбучение);
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НайденныеСтроки, НайденныеСтрокиОбучения, Истина);
			КонецЕсли;
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокиРезультатов = Новый Массив;
			Пока Обход.Следующий() Цикл
				СтрокиРезультатов.Добавить(Обход.ТекущиеДанные());
			КонецЦикла;
			
			Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
				ЗаполнитьРезультатОбученияВСтроке(СтрокаТаблицы, СтрокиРезультатов);
			КонецЦикла;
		КонецЦикла;
	Иначе
		План = РеквизитФормыВЗначение("ПланРазвития");
		Цели = План.Строки;
		Пока Обход.СледующийПоЗначениямПолей("ФизическоеЛицо, Мероприятие, ДатаНачалаПлан, ДатаОкончанияПлан") Цикл
			ТекущиеДанные = Обход.ТекущиеДанные();
			ОтборСтрокМероприятие.Мероприятие = ТекущиеДанные.Мероприятие;
			ОтборСтрокМероприятие.ДатаНачала = ТекущиеДанные.ДатаНачалаПлан;
			ОтборСтрокМероприятие.ДатаОкончания = ТекущиеДанные.ДатаОкончанияПлан;
			
			НайденныеСтроки = Новый Массив;
			Для Каждого Цель Из Цели Цикл
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НайденныеСтроки,
					Цель.Строки.НайтиСтроки(ОтборСтрокМероприятие));
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ТекущиеДанные.ВыбранноеОбучение) Тогда
				ОтборСтрокВыбранноеОбучение.ВыбранноеОбучение = ТекущиеДанные.ВыбранноеОбучение;
				Для Каждого Цель Из Цели Цикл
					ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НайденныеСтроки,
						Цель.Строки.НайтиСтроки(ОтборСтрокВыбранноеОбучение));
				КонецЦикла;
			КонецЕсли;
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			СтрокиРезультатов = Новый Массив;
			Пока Обход.Следующий() Цикл
				СтрокиРезультатов.Добавить(Обход.ТекущиеДанные());
			КонецЦикла;
			
			Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
				ЗаполнитьРезультатОбученияВСтроке(СтрокаТаблицы, СтрокиРезультатов);
			КонецЦикла;
		КонецЦикла;
		ЗначениеВРеквизитФормы(План, "ПланРазвития");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРезультатОбучения(ТекущиеДанные)
	
	Если Не РезультатыОбученияДоступны Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Мероприятие) Или Не ЗначениеЗаполнено(ТекущиеДанные.ДатаНачала)
		Или Не ЗначениеЗаполнено(ТекущиеДанные.ДатаОкончания) Тогда
		Возврат;
	КонецЕсли;
	
	Результаты = РезультатОбучения(Объект.Владелец, ТекущиеДанные.Мероприятие, ТекущиеДанные.ДатаНачала,
		ТекущиеДанные.ДатаОкончания, ТекущиеДанные.ВыбранноеОбучение);
		
	ЗаполнитьРезультатОбученияВСтроке(ТекущиеДанные, Результаты);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРезультатОбученияВСтроке(СтрокаТаблицы, РезультатыОбучения)
	
	СтрокаТаблицы.Обучение = ОбучениеРазвитиеКлиентСервер.ПредставлениеРезультатовОбучения(РезультатыОбучения);
	СтрокаТаблицы.ДокументыОбучения = Новый СписокЗначений();
	Для Каждого СтрокаРезультата Из РезультатыОбучения Цикл
		СтрокаТаблицы.ВыбранноеОбучение = СтрокаРезультата.ДокументОбучения;
		СтрокаТаблицы.ДокументыОбучения.Добавить(СтрокаРезультата.ДокументОбучения);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РезультатОбучения(ФизическоеЛицо, Мероприятие, ДатаНачала, ДатаОкончания, ВыбранноеОбучение)
	
	ПланМероприятий = ОбучениеРазвитие.НовыйПланМероприятий();
	НоваяСтрока = ПланМероприятий.Добавить();
	НоваяСтрока.ФизическоеЛицо = ФизическоеЛицо;
	НоваяСтрока.Мероприятие = Мероприятие;
	НоваяСтрока.ДатаНачала = ДатаНачала;
	НоваяСтрока.ДатаОкончания = ДатаОкончания;
	НоваяСтрока.ВыбранноеОбучение = ВыбранноеОбучение;
	
	РезультатыТаблица = РезультатыОбучения(ФизическоеЛицо, ПланМероприятий);
	
	Результаты = Новый Массив;
	Для Каждого СтрокаТаблицы Из РезультатыТаблица Цикл
		Результаты.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицы));
	КонецЦикла;
	
	Возврат Результаты;
	
КонецФункции

&НаСервереБезКонтекста
Функция РезультатыОбучения(ФизическоеЛицо, СтрокиТаблицы)
	
	ПланМероприятий = ОбучениеРазвитие.НовыйПланМероприятий();
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		НоваяСтрока = ПланМероприятий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.ФизическоеЛицо = ФизическоеЛицо;
	КонецЦикла;
	
	Возврат ОбучениеРазвитие.РезультатыОбучения(ПланМероприятий);
	
КонецФункции

