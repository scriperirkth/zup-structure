&НаСервереБезКонтекста
Процедура ПроверитьПериодыМероприятийПланаРазвития(Отказ, Форма)
	
	Объект = Форма.Объект;
	ПланРазвития = Форма.ПланРазвития.ПолучитьЭлементы();
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Для Каждого Цель Из ПланРазвития Цикл
			Мероприятия = Цель.ПолучитьЭлементы();
			Для Каждого Мероприятие Из Мероприятия Цикл
				Если НЕ ЗначениеЗаполнено(Мероприятие.ДатаНачала)
					ИЛИ Мероприятие.ДатаНачала > Мероприятие.ДатаОкончания
					ИЛИ Мероприятие.ДатаНачала < Объект.ДатаНачала
					ИЛИ Мероприятие.ДатаНачала > Объект.ДатаОкончания Тогда
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru ='Неверно заполнен период мероприятий.'"),,,, Отказ);
				ИначеЕсли НЕ ЗначениеЗаполнено(Мероприятие.ДатаОкончания)
					ИЛИ Мероприятие.ДатаОкончания < Объект.ДатаНачала
					ИЛИ Мероприятие.ДатаОкончания > Объект.ДатаОкончания Тогда
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru ='Неверно заполнен период мероприятий.'"),,,, Отказ);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКорректировкуИПР()
	
	Если Параметры.Свойство("СкорректированныйИПР") И Параметры.Ключ.Пустая() Тогда
		Параметры.Свойство("СкорректированныйИПР", Объект.СкорректированныйИПР);
		Объект.Статус = Справочники.СтатусыИндивидуальныхПлановРазвития.НаРассмотрении;
		Элементы.Корректировка.Видимость = Ложь;
		Элементы.КорректировкаПодсказка.Заголовок = НСтр("ru = 'ИПР был ранее скорректирован'");
		Элементы.КорректировкаОткрыть.Видимость = Истина;
		Элементы.КорректировкаОткрыть.Заголовок = НСтр("ru = 'Открыть прошлый ИПР'");
		ТаблицыСкорректированногоИПР = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.СкорректированныйИПР,
			"Мероприятия, РазвиваемыеХарактеристики");
		Объект.Мероприятия.Загрузить(ТаблицыСкорректированногоИПР.Мероприятия.Выгрузить());
		Объект.РазвиваемыеХарактеристики.Загрузить(ТаблицыСкорректированногоИПР.РазвиваемыеХарактеристики.Выгрузить());
		Возврат;
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаКорректировка", "Видимость", Ложь);
		Возврат;
	КонецЕсли;
	
	СкорректированныйИПР = СкорректированныйИПР(Объект.Ссылка);
	Если ЗначениеЗаполнено(СкорректированныйИПР) Тогда
		ЗапретитьРедактированиеСкорректированногоИПР(ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	Если Объект.Статус <> Справочники.СтатусыИндивидуальныхПлановРазвития.Согласован Тогда
		Элементы.ГруппаКорректировка.Видимость = Ложь;
		Возврат;
	Иначе
		Элементы.ГруппаКорректировка.Видимость = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СкорректированныйИПР) Тогда
		Элементы.Корректировка.Видимость = Истина;
		Элементы.Корректировка.Заголовок = НСтр("ru = 'Скорректировать повторно'");
		Элементы.КорректировкаПодсказка.Заголовок = НСтр("ru = 'ИПР был ранее скорректирован'");
		Элементы.КорректировкаОткрыть.Видимость = Истина;
		Элементы.КорректировкаОткрыть.Заголовок = НСтр("ru = 'Открыть прошлый ИПР'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СкорректированныйИПР(ИПР)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИПР", ИПР);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИндивидуальныйПланРазвития.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИндивидуальныйПланРазвития КАК ИндивидуальныйПланРазвития
		|ГДЕ
		|	ИндивидуальныйПланРазвития.СкорректированныйИПР = &ИПР
		|	И НЕ ИндивидуальныйПланРазвития.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗапретитьРедактированиеСкорректированногоИПР(Форма)
	
	Элементы = Форма.Элементы;
	
	Форма.КоманднаяПанель.Доступность = Ложь;
	Форма.Элементы.ГруппаКомандыХарактеристик.Доступность = Ложь;
	Форма.Элементы.ГруппаШапки.ТолькоПросмотр = Истина;
	Форма.Элементы.ТаблицыСтраница.ТолькоПросмотр = Истина;
	Форма.Элементы.ГруппаПодвала.ТолькоПросмотр = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "УстановитьИнтервал", "Доступность", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПланРазвитияПодборЦелейРазвития", "Доступность", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КоманднаяПанельПланРазвития", "Доступность", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПланРазвития", "ИзменятьСоставСтрок", Ложь);
	
	Элементы.Корректировка.Видимость = Ложь;
	Элементы.КорректировкаПредупреждениеСтрока.Видимость = Истина;
	Элементы.КорректировкаПодсказка.Видимость = Ложь;
	Элементы.КорректировкаОткрыть.Видимость = Истина;
	Элементы.КорректировкаОткрыть.Заголовок = НСтр("ru = 'Открыть скорректированный ИПР'");
	
КонецПроцедуры

&НаСервере
Функция ПараметрыПодбораЦелейРазвития()

	ПараметрыПодбора = Новый Структура;
	РазвиваемыеХарактеристики = Характеристики.Выгрузить(Новый Структура("ТребуетсяОбучение", Истина),
		"Характеристика,КартинкаВида,ТребуетсяОбучение");
	Если РазвиваемыеХарактеристики.Количество() = 0 Тогда
		Возврат ПараметрыПодбора;
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("АдресХарактеристикПерсонала", АдресРазвиваемыхХарактеристик(РазвиваемыеХарактеристики));
	ПараметрыПодбора.Вставить("АдресЦелей", АдресЦелей());
	ПараметрыПодбора.Вставить("АдресПрограммыОбучения", АдресПрограммыОбучения());  
	
	Возврат ПараметрыПодбора;

КонецФункции

&НаСервере
Процедура ЗагрузитьЦелиМероприятия(ТекущийОбъект)
	
	// Загружаем цели и мероприятия в ТЧ
	ТекущийОбъект.ЦелиРазвития.Очистить();
	ТекущийОбъект.Мероприятия.Очистить();
	Если Объект.ИспользоватьПрогрессРазвития Тогда
		ПрогрессМероприятий = Новый Соответствие;
	КонецЕсли;
	Дерево = РеквизитФормыВЗначение("ПланРазвития");
	Если Не ТекущийОбъект.ИспользоватьПрогрессРазвития Тогда
		Для Каждого СтрокаЦели Из Дерево.Строки Цикл
			НоваяСтрокаЦель = ТекущийОбъект.ЦелиРазвития.Добавить();
			НоваяСтрокаЦель.Цель = СтрокаЦели.Цель;
			Для Каждого СтрокаМероприятия Из СтрокаЦели.Строки Цикл
				ДобавитьСтрокуМероприятия(ТекущийОбъект, СтрокаЦели, СтрокаМероприятия);
			КонецЦикла;
		КонецЦикла;
	Иначе
		Для Каждого СтрокаЦели Из Дерево.Строки Цикл
			НоваяСтрокаЦель = ТекущийОбъект.ЦелиРазвития.Добавить();
			НоваяСтрокаЦель.Цель = СтрокаЦели.Цель;
			Для Каждого СтрокаМероприятия Из СтрокаЦели.Строки Цикл
				ДобавитьСтрокуМероприятия(ТекущийОбъект, СтрокаЦели, СтрокаМероприятия);
				Если Объект.ИспользоватьПрогрессРазвития Тогда
					ДобавитьПрогрессМероприятия(ТекущийОбъект, СтрокаМероприятия, ПрогрессМероприятий);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если Объект.ИспользоватьПрогрессРазвития Тогда
			АдресПрогрессаМероприятий = ПоместитьВоВременноеХранилище(ПрогрессМероприятий);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуМероприятия(ТекущийОбъект, СтрокаЦели, СтрокаМероприятия)
	
	НоваяСтрокаМероприятие = ТекущийОбъект.Мероприятия.Добавить();
	НоваяСтрокаМероприятие.Цель = СтрокаЦели.Цель;
	НоваяСтрокаМероприятие.Мероприятие = СтрокаМероприятия.Мероприятие;
	НоваяСтрокаМероприятие.ДатаНачала = СтрокаМероприятия.ДатаНачала;
	НоваяСтрокаМероприятие.ДатаОкончания = СтрокаМероприятия.ДатаОкончания;
	НоваяСтрокаМероприятие.Ответственный = СтрокаМероприятия.Ответственный;
	НоваяСтрокаМероприятие.РезультатВыполнения = СтрокаМероприятия.Результат;
	НоваяСтрокаМероприятие.Обучение = СтрокаМероприятия.Обучение;
	НоваяСтрокаМероприятие.ВыбранноеОбучение = СтрокаМероприятия.ВыбранноеОбучение;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьПрогрессМероприятия(ТекущийОбъект, СтрокаМероприятия, ПрогрессМероприятий)
	
	ПрогрессМероприятия = Новый Соответствие;
	Для Номер = 1 По ТекущийОбъект.ПродолжительностьПрогрессаРазвития Цикл
		Прогресс = СтрокаМероприятия["Прогресс" + Номер];
		ПрогрессМероприятия.Вставить(Номер, Прогресс);
	КонецЦикла;
	ПрогрессМероприятий.Вставить(СтрокаМероприятия.Мероприятие, ПрогрессМероприятия);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТаблицаЗначенийПрогресса()
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияПрогрессаОбучения.Ссылка КАК Сслыка,
		|	ЗначенияПрогрессаОбучения.Прогресс КАК Прогресс
		|ИЗ
		|	Справочник.ЗначенияПрогрессаОбучения КАК ЗначенияПрогрессаОбучения";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ТаблицаЗначенийПрогресса = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ТаблицаЗначенийПрогресса.Вставить(Выборка.Сслыка, Выборка.Прогресс);
	КонецЦикла;
	
	Возврат ТаблицаЗначенийПрогресса;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьВидимостьОснования(Форма)
	
	ЧтениеКадровогоРезерва = ПравоДоступа("Чтение", Метаданные.Справочники.КадровыйРезерв);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Основание", "Видимость", ЧтениеКадровогоРезерва);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначенияПрогрессаОбученияНаСервере()
	
	Возврат Справочники.ЗначенияПрогрессаОбучения.ЗначенияПрогрессаОбучения();
	
КонецФункции

&НаКлиенте
Процедура ПоказатьВопросИспользованияПланаРазвития()
	
	Оповещение = Новый ОписаниеОповещения("ПоказатьВопросИспользованияПланаРазвитияЗавершение", ЭтотОбъект);
	
	ТекстВопроса = СтрШаблон(НСтр("ru = '%1. %2'"),
		"В индивидуальном плане развития заполнена программа обучения",
		"Переключение на план развития потребует повторного подбора мероприятий в рамках целей развития");
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
	КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Использование плана развития'");
	ПараметрыВопроса.Картинка = БиблиотекаКартинок.Предупреждение32;
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(Оповещение, ТекстВопроса, КнопкиВопроса, ПараметрыВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросИспользованияПланаРазвитияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(РезультатВопроса) Или Не РезультатВопроса.Значение = КодВозвратаДиалога.Да Тогда
		ВидимостьПланаРазвития = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьПланаРазвития();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПланаРазвития()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПрограммаОбученияСтраница", "Видимость", Не ВидимостьПланаРазвития);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПланРазвитияСтраница", "Видимость", ВидимостьПланаРазвития);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПодборЦелейРазвития", "Видимость", ВидимостьПланаРазвития);
	ЗаполнитьРезультатыОбучения();
	
КонецПроцедуры

&НаСервере
Функция ИспользуютсяЦелиРазвития()
	
	ИспользуютсяЦелиРазвития =
		ИспользоватьЦелиРазвитияСотрудников
		И ВидимостьПланаРазвития;
	
	Возврат ИспользуютсяЦелиРазвития;
	
КонецФункции

#КонецОбласти