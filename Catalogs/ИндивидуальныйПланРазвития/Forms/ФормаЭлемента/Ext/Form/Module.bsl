
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Корректировка
	УстановитьКорректировкуИПР();
	
	Если Параметры.Ключ.Пустая() Тогда
		ЗначенияДляЗаполнения = Новый Структура("Ответственный", "Объект.Ответственный");
		ЗарплатаКадры.ЗаполнитьПервоначальныеЗначенияВФорме(ЭтотОбъект, ЗначенияДляЗаполнения);
		ПриПолученииДанныхНаСервере();
		Если ЗначениеЗаполнено(Объект.Основание) И Не Параметры.Свойство("СкорректированныйИПР") Тогда
			ЗаполнитьПоДаннымОснования();
		КонецЕсли;
	КонецЕсли;
	
	// Обработчик подсистемы "ВерсионированиеОбъектов".
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	УстановитьУсловноеОформление();
	УстановитьВидимостьОснования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриПолученииДанныхНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	СвойствоНеПроверятьСтатус = "НеПроверятьСтатус";
	Если ПараметрыЗаписи.Свойство(СвойствоНеПроверятьСтатус) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ХарактеристикиПерсоналаФормы.ПеренестиХарактеристикиВТабличнуюЧасть(ТекущийОбъект.РазвиваемыеХарактеристики,
		Характеристики, ЗначенияХарактеристики);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	Если ИспользуютсяЦелиРазвития() Тогда
		ЗагрузитьЦелиМероприятия(ТекущийОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
	ПроверитьПериодыМероприятийПланаРазвития(Отказ, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	ОбработатьОповещениеДокументаОбучения(ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "Запись_ИндивидуальныйПланРазвития" И Объект.Ссылка <> Источник Тогда
		УстановитьКорректировкуИПР();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьКорректировкуИПР();
	
	Если ИспользуютсяЦелиРазвития() И Объект.ИспользоватьПрогрессРазвития Тогда
		РегистрыСведений.ПрогрессОбученияСотрудников.ВнестиПрогрессОбучения(
			ТекущийОбъект.Ссылка, ТекущийОбъект.Владелец, ПолучитьИзВременногоХранилища(АдресПрогрессаМероприятий));
	КонецЕсли;
	
	ПриПолученииДанныхНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РазвернутьДерево();
	
	Если ЗначениеЗаполнено(Объект.СкорректированныйИПР) Тогда
		ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъекта(Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	ДополнитьХарактеристики();
	
КонецПроцедуры

&НаКлиенте
Процедура ВладелецНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОтборИзПодразделения = ОтборИзПодразделения(Объект.Подразделение);
	
	Если ОтборИзПодразделения.Свойство("Организация") И ЗначениеЗаполнено(ОтборИзПодразделения.Организация) Тогда
		Организация = ОтборИзПодразделения.Организация;
	Иначе
		Организация = Неопределено;
	КонецЕсли;
	Если ОтборИзПодразделения.Свойство("Подразделение") И ЗначениеЗаполнено(ОтборИзПодразделения.Подразделение) Тогда
		Подразделение = ОтборИзПодразделения.Подразделение;
	Иначе
		Подразделение = Неопределено;
	КонецЕсли;
	
	КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(
		Элементы.Владелец,
		Организация,
		Подразделение, Объект.ДатаНачала,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВладелецОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОбработкаВыбораФизическогоЛица(ВыбранноеЗначение);
	ДополнитьХарактеристики();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	Объект.Владелец = Неопределено;
	ДополнитьХарактеристики();
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеПриИзменении(Элемент)
	
	ЕстьЗаполненныеДанные = (Объект.Мероприятия.Количество() > 0
		Или Объект.ДействияСотрудников.Количество() > 0
		Или Объект.РазвиваемыеХарактеристики.Количество() > 0);
	
	Если ЕстьЗаполненныеДанные Тогда
		ТекстВопроса = НСтр("ru = 'Заполнить ИПР по данным основания?'");
		ОбработчикОповещенияОЗакрытии = Новый ОписаниеОповещения("ЗаполнитьПоДаннымОснованияЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОбработчикОповещенияОЗакрытии, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			НСтр("ru = 'Продолжить?'"));
	Иначе
		ЗаполнитьПоДаннымОснованияЗавершение(КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект,
		"Объект.Комментарий");
		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицыСтраницаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	// СтандартныеПодсистемы.Свойства
	Если ЭтотОбъект.ПараметрыСвойств.Свойство(ТекущаяСтраница.Имя)
		И Не ЭтотОбъект.ПараметрыСвойств.ВыполненаОтложеннаяИнициализация Тогда
		СвойстваВыполнитьОтложеннуюИнициализацию();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	Если Объект.Мероприятия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнитьПланОбученияПериодами();
	
КонецПроцедуры

&НаКлиенте
Процедура ЕстьНаставникПриИзменении(Элемент)
	ВключитьНаставника(ЭтотОбъект, Объект.ЕстьНаставник);
КонецПроцедуры

&НаКлиенте
Процедура ЕстьКураторПриИзменении(Элемент)
	ВключитьКуратора(ЭтотОбъект, Объект.ЕстьКуратор);
КонецПроцедуры

&НаКлиенте
Процедура НаставникОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		Объект.Наставник = ФизическоеЛицоСотрудника(ВыбранноеЗначение);
	Иначе
		Объект.Наставник = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НаставникНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(
		Элемент,,, Объект.ДатаНачала, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КураторОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		Объект.Куратор = ФизическоеЛицоСотрудника(ВыбранноеЗначение);
	Иначе
		Объект.Куратор = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КураторНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(
		Элемент,,, Объект.ДатаНачала, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПрогрессПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПланРазвития.ТекущиеДанные;
	Если Параметры.Ключ.Пустая() Тогда
		ТекущиеДанные[Элемент.Имя] = ПредопределенноеЗначение("Справочник.ЗначенияПрогрессаОбучения.ПустаяСсылка");
		ВызватьИсключение НСтр("ru = 'Внесение прогресса развития возможно только после записи ИПР.'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные[Элемент.Имя]) Тогда
		ТаблицаЗначенийПрогресса = ТаблицаЗначенийПрогресса();
		Для Номер = 1 По Объект.ПродолжительностьПрогрессаРазвития Цикл
			ИмяПрогресса = "Прогресс" + Номер;
			ЗначениеПрогресса = ТекущиеДанные[ИмяПрогресса];
			Если ЗначениеПрогресса = ПредопределенноеЗначение("Справочник.ЗначенияПрогрессаОбучения.ПустаяСсылка") Тогда
				Продолжить;
			КонецЕсли;
			Если Элемент.Имя = ИмяПрогресса  Тогда
				Если Номер = Объект.ПродолжительностьПрогрессаРазвития Тогда
					Прервать;
				КонецЕсли;
				ИмяПрогресса = "Прогресс" + (Номер + 1);
				ЗначениеПрогресса = ТекущиеДанные[ИмяПрогресса];
				Если ЗначениеПрогресса <> ПредопределенноеЗначение("Справочник.ЗначенияПрогрессаОбучения.ПустаяСсылка")
					И ТаблицаЗначенийПрогресса.Получить(ТекущиеДанные[Элемент.Имя])
						> ТаблицаЗначенийПрогресса.Получить(ЗначениеПрогресса) Тогда
					ТекущиеДанные[Элемент.Имя] = ЗначениеПрогресса;
				КонецЕсли;
				Прервать;
			КонецЕсли;
			ПоследнийПрогрессМероприятия = ЗначениеПрогресса;
		КонецЦикла;
		Если ЗначениеЗаполнено(ПоследнийПрогрессМероприятия)
			И ТаблицаЗначенийПрогресса.Получить(ТекущиеДанные[Элемент.Имя])
			< ТаблицаЗначенийПрогресса.Получить(ПоследнийПрогрессМероприятия) Тогда
			ТекущиеДанные[Элемент.Имя] = ПоследнийПрогрессМероприятия;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьПроцентВыполненияПланаРазвития();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПрогрессНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Элемент.СписокВыбора.Очистить();
	ЗначенияПрогрессаОбучения = ЗначенияПрогрессаОбученияНаСервере();
	Для Каждого Значение Из ЗначенияПрогрессаОбучения Цикл
		Элемент.СписокВыбора.Добавить(Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СкорректированныйИПР", Объект.Ссылка);
	ПараметрыФормы.Вставить("ЗначениеКопирования", Объект.Ссылка);
	
	ОткрытьФорму("Справочник.ИндивидуальныйПланРазвития.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаОткрытьНажатие(Элемент)
	
	Если ЗначениеЗаполнено(Объект.СкорректированныйИПР)
		И Не ЗначениеЗаполнено(СкорректированныйИПР) Тогда
		СкорректированныйИПР = Объект.СкорректированныйИПР;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СкорректированныйИПР) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", СкорректированныйИПР);
	ОткрытьФорму("Справочник.ИндивидуальныйПланРазвития.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьПланаРазвитияПриИзменении(Элемент)
	
	Если Объект.Мероприятия.Количество() > 0
		И ПланРазвития.ПолучитьЭлементы().Количество() = 0
		И ВидимостьПланаРазвития Тогда
		ПоказатьВопросИспользованияПланаРазвития();
	Иначе
		УстановитьВидимостьПланаРазвития();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМероприятия

&НаКлиенте
Процедура МероприятияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьХарактеристикиМероприятия(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	ОткрытьДокументОбучение(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура МероприятияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ДатаНачала = Объект.ДатаНачала;
		Элемент.ТекущиеДанные.ДатаОкончания = Объект.ДатаОкончания;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МероприятияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.Мероприятия.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРезультатОбучения(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МероприятияМероприятиеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Мероприятия.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьВторичныеДанныеОбученияНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
	ОчиститьРезультатыОбучения(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МероприятияДатаНачалаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Мероприятия.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьРезультатыОбучения(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МероприятияДатаОкончанияПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Мероприятия.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьРезультатыОбучения(ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура МероприятияРезультатВыполненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	НачатьРедактированиеРезультатаВыполнения(Элемент.ТекстРедактирования);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыХарактеристики

&НаКлиенте
Процедура ХарактеристикиТребуетсяОбучениеПриИзменении(Элемент)
	
	ХарактеристикиТребуетсяОбучениеПриИзмененииНаКлиенте();
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоХарактеристик

&НаКлиенте
Процедура ДеревоХарактеристикТребуетсяОбучениеПриИзменении(Элемент)
	
	ХарактеристикиТребуетсяОбучениеПриИзмененииНаКлиенте();
	
	ТекущиеДанные = Элементы.ДеревоХарактеристик.ТекущиеДанные;
	Характеристика = ТекущиеДанные.Характеристика;
	ТребуетсяОбучение = ТекущиеДанные.ТребуетсяОбучение;
	
	УстановитьТребуетсяОбучениеВДереве(ДеревоХарактеристик.ПолучитьЭлементы(), Характеристика,
		ТребуетсяОбучение);
	УстановитьТребуетсяОбучениеДляХарактеристикиВТаблице(Характеристика, ТребуетсяОбучение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПланРазвития

&НаКлиенте
Процедура ПланРазвитияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущийЭлемент.Имя = "ПланРазвитияЦель" Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(Элементы.ПланРазвития.ТекущиеДанные.Мероприятие) Тогда
			ПараметрыФормы = Новый Структура("Ключ", Элементы.ПланРазвития.ТекущиеДанные.Мероприятие);
			ОткрытьФорму("Справочник.МероприятияОбученияРазвития.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ЗначениеЗаполнено(Элементы.ПланРазвития.ТекущиеДанные.Цель) Тогда
			ПараметрыФормы = Новый Структура("Ключ", Элементы.ПланРазвития.ТекущиеДанные.Цель);
			ОткрытьФорму("Справочник.ЦелиРазвития.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ПланРазвитияОбучение"
		И ЗначениеЗаполнено(Элементы.ПланРазвития.ТекущиеДанные.Мероприятие) Тогда
		ОткрытьДокументОбучение(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРазвитияРезультатНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	НачатьРедактированиеРезультатаВыполнения(Элемент.ТекстРедактирования);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРазвитияПослеУдаления(Элемент)
	ЗаполнитьПроцентВыполненияПланаРазвития();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьИнтервал(Команда)
	
	ПараметрПериода = Новый СтандартныйПериод;
	ПараметрПериода.ДатаНачала = Объект.ДатаНачала;
	ПараметрПериода.ДатаОкончания = Объект.ДатаОкончания;
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = ПараметрПериода;
	Диалог.Показать(Новый ОписаниеОповещения("РедактироватьПериодЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодборПрограммыОбученияПоХарактеристикам(Команда)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("АдресХарактеристикПерсонала", АдресХарактеристикПерсонала());
	СтруктураПараметров.Вставить("АдресПрограммыОбучения", АдресПрограммыОбучения());
	
	ОбучениеРазвитиеКлиент.ОткрытьФормуПодбораПрограммыОбучения(ЭтотОбъект,
		Новый Структура("ПараметрыФормыПодбора", СтруктураПараметров),
		Новый ОписаниеОповещения("ЗагрузитьПрограммуОбученияНаКлиенте", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборХарактеристик(Команда)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ДобавлятьЗначенияХарактеристик", Истина);
	
	ХарактеристикиПерсоналаКлиент.ОткрытьФормуПодбораХарактеристик(ЭтотОбъект, ПараметрыПодбора,
		Новый ОписаниеОповещения("ДобавитьХарактеристикиПерсоналаНаКлиенте", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборЦелейРазвития(Команда)
	
	ПараметрыФормыПодбора = ПараметрыПодбораЦелейРазвития();
	Если Не ЗначениеЗаполнено(ПараметрыФормыПодбора) Тогда
		ТекстПредупреждения = НСтр("ru = 'Не отмечены характеристики, требующие развития.'");
		ПоказатьПредупреждение( , ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ОбучениеРазвитиеКлиент.ОткрытьФормуПодбораЦелейРазвития(ЭтотОбъект,
		Новый Структура("ПараметрыФормыПодбора", ПараметрыФормыПодбора),
		Новый ОписаниеОповещения("ЗагрузитьПрограммуОбученияНаКлиенте", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьВсе(Команда)
	
	Для Каждого СтрокаХарактеристика Из Характеристики Цикл
		СтрокаХарактеристика.ТребуетсяОбучение = Истина;
	КонецЦикла;
	УстановитьТребуетсяОбучениеВДереве(ДеревоХарактеристик.ПолучитьЭлементы(), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыделитьВсе(Команда)
	
	Для Каждого СтрокаХарактеристика Из Характеристики Цикл
		СтрокаХарактеристика.ТребуетсяОбучение = Ложь;
	КонецЦикла;
	УстановитьТребуетсяОбучениеВДереве(ДеревоХарактеристик.ПолучитьЭлементы(), Ложь);
	
КонецПроцедуры

