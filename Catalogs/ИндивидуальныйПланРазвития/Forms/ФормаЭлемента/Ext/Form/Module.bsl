&НаКлиенте
Процедура ЗаполнитьПоДаннымОснованияЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоДаннымОснования();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымОснования()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КадровыйРезервДействияСотрудников.ДействиеСотрудника КАК ДействиеСотрудника
		|ИЗ
		|	Справочник.КадровыйРезерв.ДействияСотрудников КАК КадровыйРезервДействияСотрудников
		|ГДЕ
		|	КадровыйРезервДействияСотрудников.Ссылка = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КадровыйРезервХарактеристикиПерсонала.Характеристика КАК Характеристика,
		|	КадровыйРезервХарактеристикиПерсонала.Значение КАК Значение,
		|	ИСТИНА КАК ТребуетсяОбучение
		|ИЗ
		|	Справочник.КадровыйРезерв.ХарактеристикиПерсонала КАК КадровыйРезервХарактеристикиПерсонала
		|ГДЕ
		|	КадровыйРезервХарактеристикиПерсонала.Ссылка = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КадровыйРезерв.РазмерностьПродолжительностиПланаОбучения КАК РазмерностьПродолжительностиПланаОбучения
		|ИЗ
		|	Справочник.КадровыйРезерв КАК КадровыйРезерв
		|ГДЕ
		|	КадровыйРезерв.Ссылка = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КадровыйРезервПрограммаОбучения.Мероприятие.ВидМероприятия КАК ВидМероприятия,
		|	КадровыйРезервПрограммаОбучения.Мероприятие КАК Мероприятие,
		|	КадровыйРезервПрограммаОбучения.Ответственный КАК Ответственный,
		|	КадровыйРезервПрограммаОбучения.Начало КАК Начало,
		|	КадровыйРезервПрограммаОбучения.Окончание КАК Окончание
		|ИЗ
		|	Справочник.КадровыйРезерв.ПрограммаОбучения КАК КадровыйРезервПрограммаОбучения
		|ГДЕ
		|	КадровыйРезервПрограммаОбучения.Ссылка = &Основание";
	
	Запрос.УстановитьПараметр("Основание", Объект.Основание);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатыДействия = РезультатыЗапроса[РезультатыЗапроса.Количество() - 4];
	РезультатыХарактеристики = РезультатыЗапроса[РезультатыЗапроса.Количество() - 3];
	РезультатыПараметрыПрограммы = РезультатыЗапроса[РезультатыЗапроса.Количество() - 2];
	РезультатыПрограмма = РезультатыЗапроса[РезультатыЗапроса.Количество() - 1];
	
	// Действия.
	Объект.ДействияСотрудников.Загрузить(РезультатыДействия.Выгрузить());
	
	// План обучения.
	ПланОбученияТаблица = РезультатыПрограмма.Выгрузить();
	ПланОбучения.Загрузить(ПланОбученияТаблица);
	Объект.Мероприятия.Загрузить(ПланОбученияТаблица);
	
	// Характеристики.
	Объект.РазвиваемыеХарактеристики.Загрузить(РезультатыХарактеристики.Выгрузить());
	ЗаполнитьВторичнуюТаблицуХарактеристики();
	
	Если Объект.РазвиваемыеХарактеристики.Количество() = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПрофилиДолжностейХарактеристикиПерсонала.Характеристика КАК Характеристика,
			|	ПрофилиДолжностейХарактеристикиПерсонала.Значение КАК Значение
			|ИЗ
			|	Справочник.ПрофилиДолжностей.ХарактеристикиПерсонала КАК ПрофилиДолжностейХарактеристикиПерсонала
			|ГДЕ
			|	ПрофилиДолжностейХарактеристикиПерсонала.Ссылка = &ПрофильДолжности";
		Запрос.УстановитьПараметр("ПрофильДолжности", ПрофильДолжностиПозицииРезерва(Объект.Основание));
		Объект.РазвиваемыеХарактеристики.Загрузить(Запрос.Выполнить().Выгрузить());
		ЗаполнитьВторичнуюТаблицуХарактеристики();
	КонецЕсли;
	
	ВыборкаПараметры = РезультатыПараметрыПрограммы.Выбрать();
	ВыборкаПараметры.Следующий();
	РазмерностьПродолжительностиПланаОбучения = ВыборкаПараметры.РазмерностьПродолжительностиПланаОбучения;
	Если ПланОбучения.Количество() <> 0 Тогда
		ДополнитьПланОбученияПериодами();
	КонецЕсли;
	
	ОбучениеРазвитиеФормы.ЗаполнитьКэшХарактеристикиМероприятияПоХарактеристикам(КэшХарактеристикиМероприятия,
		Объект.ХарактеристикиСотрудника.Выгрузить(, "Характеристика").ВыгрузитьКолонку("Характеристика"));
	
	ЗаполнитьВторичнуюИнформациюПланаОбучения();
	ЗаполнитьНаставникаКуратора();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаставникаКуратора()
	
	Объект.ЕстьНаставник = Ложь;
	Объект.ЕстьКуратор = Ложь;
	Объект.Наставник = Неопределено;
	Объект.Куратор = Неопределено;
	ДанныеРезервистаПоОснованию = РегистрыСведений.КадровыйРезерв.ДанныеРезервистаПоПозиции(
		Объект.Основание, Объект.Владелец);
	Если ДанныеРезервистаПоОснованию <> Неопределено Тогда
		Если ЗначениеЗаполнено(ДанныеРезервистаПоОснованию.Наставник) Тогда
			Объект.ЕстьНаставник = Истина;
			Объект.Наставник = ДанныеРезервистаПоОснованию.Наставник;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеРезервистаПоОснованию.Куратор) Тогда
			Объект.ЕстьКуратор = Истина;
			Объект.Куратор = ДанныеРезервистаПоОснованию.Куратор;
		КонецЕсли;
	КонецЕсли;
	ВключитьНаставника(ЭтотОбъект, Объект.ЕстьНаставник);
	ВключитьКуратора(ЭтотОбъект, Объект.ЕстьКуратор);
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьХарактеристикиДаннымиХарактеристикСотрудника()

	Для каждого СтрокаХарактеристик Из Характеристики Цикл
		НайденныеСтроки = Объект.ХарактеристикиСотрудника.НайтиСтроки(
			Новый Структура("Характеристика", СтрокаХарактеристик.Характеристика));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаХарактеристик.ЗначениеХарактеристикиСотрудника = НайденныеСтроки[0].Значение;
		СтрокаХарактеристик.БаллХарактеристикиСотрудника = НайденныеСтроки[0].БаллХарактеристики;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПрограммуОбученияНаКлиенте(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Элементы.ТаблицыСтраница.ТекущаяСтраница = Элементы.ПланРазвитияСтраница;
	ЗагрузитьПрограммуОбученияНаСервере(Результат, ДополнительныеПараметры);
	Если Объект.ИспользоватьПрогрессРазвития Тогда
		СоздатьИЗаполнитьРеквизитыПрогрессаОбучения();
	КонецЕсли;
	СтандартныеПодсистемыКлиент.РазвернутьУзлыДерева(ЭтотОбъект, "ПланРазвития", , Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПрограммуОбученияНаСервере(Результат, ДополнительныеПараметры)
	
	Если Не ИспользоватьЦелиРазвитияСотрудников Или Не ВидимостьПланаРазвития Тогда
		ОбучениеРазвитиеФормы.ЗагрузитьПрограммуОбучения(ЭтотОбъект, Результат, "Объект.Мероприятия");
		ОбучениеРазвитиеФормы.ЗаполнитьКэшХарактеристикиМероприятияПоХарактеристикам(КэшХарактеристикиМероприятия, 
		Характеристики.Выгрузить(, "Характеристика").ВыгрузитьКолонку("Характеристика"));
		ОбучениеРазвитиеФормы.ЗаполнитьСтрокиХарактеристикВТаблицеПрограммаОбучения(
			Объект.Мероприятия, Характеристики, КэшХарактеристикиМероприятия);
		Возврат;
	КонецЕсли;
	
	ПодобранныеЦели = ПолучитьИзВременногоХранилища(Результат.АдресЦелейРазвития);
	ПодобранныеМероприятияЦелей = ПолучитьИзВременногоХранилища(Результат.АдресМероприятийЦелей);
	
	ДеревоСтарое = РеквизитФормыВЗначение("ПланРазвития");
	Дерево = ДеревоСтарое.Скопировать();
	Дерево.Строки.Очистить();
	
	Для Каждого ПодобраннаяЦель Из ПодобранныеЦели Цикл
		СтрокаЦель = Дерево.Строки.Добавить();
		СтрокаЦель.Цель = ПодобраннаяЦель;
		СтрокаЦельСтарая = ДеревоСтарое.Строки.Найти(ПодобраннаяЦель);
		НайденныеСтроки = ПодобранныеМероприятияЦелей.НайтиСтроки(Новый Структура("Цель", ПодобраннаяЦель));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			СтрокаМероприятие = СтрокаЦель.Строки.Добавить();
			СтрокаМероприятие.Мероприятие = НайденнаяСтрока.Мероприятие;
			СтрокаМероприятие.Ответственный = НайденнаяСтрока.Мероприятие.Ответственный;
			Если Не ЗначениеЗаполнено(СтрокаМероприятие.ДатаНачала) Тогда
				СтрокаМероприятие.ДатаНачала = Объект.ДатаНачала;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаМероприятие.ДатаОкончания) Тогда
				СтрокаМероприятие.ДатаОкончания = Объект.ДатаОкончания;
			КонецЕсли;
			Если СтрокаЦельСтарая = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтрокаМероприятиеСтарая = СтрокаЦельСтарая.Строки.Найти(НайденнаяСтрока.Мероприятие);
			Если СтрокаМероприятиеСтарая <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаМероприятие, СтрокаМероприятиеСтарая);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ПланРазвития");
	
КонецПроцедуры

&НаСервере
Функция АдресХарактеристикПерсонала()
	
	Возврат ПоместитьВоВременноеХранилище(Характеристики.Выгрузить(, "Характеристика,КартинкаВида,ТребуетсяОбучение"),
		УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция АдресРазвиваемыхХарактеристик(РазвиваемыеХарактеристики)
	
	Возврат ПоместитьВоВременноеХранилище(РазвиваемыеХарактеристики, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция АдресПрограммыОбучения()
	
	Если Не ИспользоватьЦелиРазвитияСотрудников Или Не ВидимостьПланаРазвития Тогда
		Возврат ПоместитьВоВременноеХранилище(Объект.Мероприятия.Выгрузить(, "Мероприятие,Ответственный"),
			УникальныйИдентификатор);
	КонецЕсли;
	
	МероприятияПланаРазвития = Новый Массив;
	Дерево = РеквизитФормыВЗначение("ПланРазвития");
	Для Каждого СтрокаЦели Из Дерево.Строки Цикл
		Для Каждого СтрокаМероприятие Из СтрокаЦели.Строки Цикл
			МероприятиеПланаРазвития = Новый Структура("Мероприятие, Ответственный, Цель");
			МероприятиеПланаРазвития.Цель = СтрокаЦели.Цель;
			ЗаполнитьЗначенияСвойств(МероприятиеПланаРазвития, СтрокаМероприятие, "Мероприятие, Ответственный");
			МероприятияПланаРазвития.Добавить(МероприятиеПланаРазвития);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(МероприятияПланаРазвития, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция АдресЦелей()
	
	МассивЦелей = Новый Массив;
	Дерево = РеквизитФормыВЗначение("ПланРазвития");
	Для Каждого СтрокаЦели Из Дерево.Строки Цикл
		МассивЦелей.Добавить(СтрокаЦели.Цель);
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(МассивЦелей, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ХарактеристикиТребуетсяОбучениеПриИзмененииНаКлиенте()

	ХарактеристикиТребуетсяОбучениеПриИзмененииНаСервере();
	
	СтрокиСУдаленнымиМероприятиями = Новый Массив;
	Для каждого СтрокаМероприятия Из Объект.Мероприятия Цикл
		Если СтрокаМероприятия.СтрокаХарактеристикОчистилась Тогда
			СтрокиСУдаленнымиМероприятиями.Добавить(СтрокаМероприятия);
		КонецЕсли;
	КонецЦикла; 
	
	Если СтрокиСУдаленнымиМероприятиями.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("УдалитьВыбранноеМероприятиеЗавершение", ЭтотОбъект,
		Новый Структура("СтрокиСУдаленнымиМероприятиями", СтрокиСУдаленнымиМероприятиями));
	
	ТекстВопроса = ТекстВопросаУдаления(СтрокиСУдаленнымиМероприятиями);
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Да, исключить'"));
	СписокКнопок.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Нет, оставить'"));
	
	ПоказатьВопрос(ОповещениеОЗакрытии, ТекстВопроса, СписокКнопок,, КодВозвратаДиалога.Да);
		
КонецПроцедуры

&НаКлиенте
Функция ТекстВопросаУдаления(СтрокиСУдаленнымиМероприятиями)

	Если СтрокиСУдаленнымиМероприятиями.Количество() = 1 Тогда
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не осталось характеристик, которое развивает мероприятие ""%1"".
								|Исключить его из программы обучения?'"),
			СтрокиСУдаленнымиМероприятиями[0].Мероприятие);
	Иначе
		ТекстМероприятий = "";
		Для каждого СтрокаУдаляемогоМероприятия Из СтрокиСУдаленнымиМероприятиями Цикл
			ТекстМероприятий = ТекстМероприятий + ?(ТекстМероприятий = "", "", ", ") + """"
				+ СтрокаУдаляемогоМероприятия.Мероприятие + """";
		КонецЦикла; 
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не осталось характеристик, которые развивают мероприятия ""%1"".
								|Исключить их из программы обучения?'"),
			ТекстМероприятий);
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ХарактеристикиТребуетсяОбучениеПриИзмененииНаСервере()
	
	ОбучениеРазвитиеФормы.ЗаполнитьСтрокиХарактеристикВТаблицеПрограммаОбучения(Объект.Мероприятия, Характеристики,
		КэшХарактеристикиМероприятия, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранноеМероприятиеЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеПараметры = Неопределено Или Не ДополнительныеПараметры.Свойство("СтрокиСУдаленнымиМероприятиями") Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого УдаляемаяСтрока Из ДополнительныеПараметры.СтрокиСУдаленнымиМероприятиями Цикл
		Объект.Мероприятия.Удалить(УдаляемаяСтрока);
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеДанныеОбученияНаСервере(ИдентификаторТекущейСтроки)
	
	ОбучениеРазвитиеФормы.ЗаполнитьУчебныеЧасыПланаОбучения(ЭтотОбъект, ИдентификаторТекущейСтроки, "Объект.Мероприятия");
	ОбучениеРазвитиеФормы.ЗаполнитьОтветственногоВСтрокеПрограммыОбучения(ЭтотОбъект, ИдентификаторТекущейСтроки,
		"Объект.Мероприятия");
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьРедактированиеРезультатаВыполнения(ТекстРедактирования)
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(
		Новый ОписаниеОповещения("ЗавершитьРедактированиеРезультатаВыполнения", ЭтотОбъект, 
			Новый Структура("ИдентификаторСтроки", ?(ИспользоватьЦелиРазвитияСотрудников И ВидимостьПланаРазвития,
			Элементы.ПланРазвития.ТекущиеДанные.ПолучитьИдентификатор(),
			Элементы.Мероприятия.ТекущиеДанные.ПолучитьИдентификатор()))),
			ТекстРедактирования);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактированиеРезультатаВыполнения(ВведенныйТекст, ДополнительныеПараметры) Экспорт
	
	Если ВведенныйТекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьЦелиРазвитияСотрудников И ВидимостьПланаРазвития Тогда
		ПланРазвития.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки).Результат = ВведенныйТекст;
	Иначе
		Объект.Мероприятия.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки).РезультатВыполнения =
			ВведенныйТекст;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьХарактеристикиМероприятия(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя <> Элементы.МероприятияСтрокаХарактеристик.Имя Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.Мероприятия.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Мероприятие) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ключ", ТекущиеДанные.Мероприятие);
	СтруктураПараметров.Вставить("ОткрытьСписокХарактеристик", Истина);
	
	ОткрытьФорму("Справочник.МероприятияОбученияРазвития.ФормаОбъекта", СтруктураПараметров, ЭтотОбъект,
		УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументОбучение(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле <> Элементы.ПланРазвитияОбучение
		И Поле <> Элементы.МероприятияОбучение Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РезультатыОбученияДоступны Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидимостьПланаРазвития Тогда
		ТекущиеДанные = Элементы.ПланРазвития.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.Мероприятия.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыОбучения = ТекущиеДанные.ДокументыОбучения;
	
	Если ДокументыОбучения.Количество() = 0 Тогда
		СоздатьНовыйДокументОбучение(ТекущиеДанные);
	ИначеЕсли ДокументыОбучения.Количество() = 1 Тогда
		ОткрытьСуществующийДокументОбучение(ДокументыОбучения[0].Значение);
	Иначе
		ПоказатьВыборИзСписка(
			Новый ОписаниеОповещения("ЗавершитьВыборДокументаОбученияИзСписка", ЭтотОбъект), ДокументыОбучения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборДокументаОбученияИзСписка(ЭлементСписка, ДополнительныеПараметры) Экспорт
	
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьСуществующийДокументОбучение(ЭлементСписка.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСуществующийДокументОбучение(ДокументОбучения)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ДокументОбучения);
	
	ОткрытьФорму("Документ.ОбучениеРазвитиеСотрудников.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйДокументОбучение(СтрокаТаблицы)
	
	Если Не ВводОбученияДоступен Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Обучение пока не пройдено.'"));
		Возврат;
	КонецЕсли;
	
	НачатьСозданиеДокументаОбучения(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьИзменениеДокументаОбучения(СтрокаТаблицы)
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Обучение уже подобрано'");
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	
	Кнопки = Новый СписокЗначений();
	Кнопки.Добавить(КодВозвратаДиалога.Да, 		НСтр("ru = 'Создать'"));
	Кнопки.Добавить(КодВозвратаДиалога.Нет,  	НСтр("ru = 'Выбрать'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, 	НСтр("ru = 'Отмена'"));
	
	ТекстВопроса = НСтр("ru = 'Обучение уже подобрано. Изменить текущий документ обучения?'");
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗавершитьСозданиеДокументаОбучения", ЭтотОбъект, Новый Структура("СтрокаТаблицы", СтрокаТаблицы)), 
		ТекстВопроса, Кнопки, ПараметрыВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСозданиеДокументаОбучения(СтрокаТаблицы)
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Обучение не пройдено'");
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	
	Кнопки = Новый СписокЗначений();
	Кнопки.Добавить(КодВозвратаДиалога.Да, 		НСтр("ru = 'Создать'"));
	Кнопки.Добавить(КодВозвратаДиалога.Нет,  	НСтр("ru = 'Выбрать'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, 	НСтр("ru = 'Отмена'"));
	
	ТекстВопроса = НСтр("ru = 'Обучение пока не пройдено. Необходимо ввести новый документ обучения или выбрать существующий'");
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗавершитьСозданиеДокументаОбучения", ЭтотОбъект, Новый Структура("СтрокаТаблицы", СтрокаТаблицы)), 
		ТекстВопроса, Кнопки, ПараметрыВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСозданиеДокументаОбучения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если СвойствоСтруктуры(Ответ, "Значение") = КодВозвратаДиалога.Нет Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ПараметрыФормы.Вставить("Мероприятие", ДополнительныеПараметры.СтрокаТаблицы.Мероприятие);
		ПараметрыФормы.Вставить("ФизическоеЛицо", Объект.Владелец);
		ПараметрыФормы.Вставить("ДатаНачала", Объект.ДатаНачала);
		ПараметрыФормы.Вставить("ДатаОкончания", Объект.ДатаОкончания);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗавершитьВыборДокументаОбучения", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму("Документ.ОбучениеРазвитиеСотрудников.ФормаВыбора", ПараметрыФормы, ЭтотОбъект,,,, ОповещениеОЗакрытии);
	КонецЕсли;
	
	Если СвойствоСтруктуры(Ответ, "Значение") <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = ДополнительныеПараметры.СтрокаТаблицы;
	
	КадровыеДанные = КадровыеДанные(Объект.Владелец, СтрокаТаблицы.ДатаНачала);
	
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("Мероприятие", СтрокаТаблицы.Мероприятие);
	ЗначенияЗаполнения.Вставить("ДатаНачала", СтрокаТаблицы.ДатаНачала);
	ЗначенияЗаполнения.Вставить("ДатаОкончания", СтрокаТаблицы.ДатаОкончания);
	ЗначенияЗаполнения.Вставить("Сотрудники", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КадровыеДанные.Сотрудник));
	ЗначенияЗаполнения.Вставить("Подразделение", КадровыеДанные.МестоВСтруктуреПредприятия);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.ОбучениеРазвитиеСотрудников.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборДокументаОбучения(ВыбранныйДокумент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ДополнительныеПараметры.СтрокаТаблицы;
	ТекущиеДанные.ВыбранноеОбучение = ВыбранныйДокумент;
	ПериодВыбранногоДокумента = ПериодВыбранногоДокумента(ВыбранныйДокумент);
	
	ТекущиеДанные.Обучение = СтрШаблон(НСтр("ru = 'Обучение с %1 по %2'"), 
		Формат(ПериодВыбранногоДокумента.ДатаНачала, "ДЛФ=D;"), 
		Формат(ПериодВыбранногоДокумента.ДатаОкончания, "ДЛФ=D;"));
	
	ТекущиеДанные.ДокументыОбучения = Новый СписокЗначений();
	ТекущиеДанные.ДокументыОбучения.Добавить(ВыбранныйДокумент);
	
	УстановитьЗначенияПериодовПрогрессаРазвития();
	ЗаполнитьПроцентВыполненияПланаРазвития();
	ОчиститьПрогрессОбучения(ТекущиеДанные.Мероприятие);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПериодВыбранногоДокумента(ВыбранныйДокумент)
	
	ПериодВыбранногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыбранныйДокумент, "ДатаНачала, ДатаОкончания");
	
	Возврат ПериодВыбранногоДокумента;
	
КонецФункции

&НаСервереБезКонтекста
Функция КадровыеДанные(ФизическоеЛицо, ДатаАктуальности)
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.КадровыеДанные = "МестоВСтруктуреПредприятия";
	ПараметрыПолучения.СписокФизическихЛиц = ФизическоеЛицо;
	ПараметрыПолучения.НачалоПериода = ДатаАктуальности;
	ПараметрыПолучения.ОкончаниеПериода = ДатаАктуальности;
	
	КадровыеДанные = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыПолучения);
	
	ОбщегоНазначенияКлиентСервер.Проверить(КадровыеДанные.Количество() > 0,
		СтрШаблон(НСтр("ru = 'Не удалось получить кадровые данные.
					|Возможно, %1 не принят на работу по состоянию на %2.'"),
				ФизическоеЛицо, Формат(ДатаАктуальности, "ДЛФ=D;")),
		Метаданные.Справочники.ИндивидуальныйПланРазвития.ПолноеИмя());
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(КадровыеДанные[0]);
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Элемент.Отбор, "ПланРазвития.Обучение", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Элемент.Отбор, "ПланРазвития.Цель", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ПланРазвитияОбучение");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстПодобранногоЗначенияЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<Обучение не пройдено>'"));
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Элемент.Отбор, "ПланРазвития.Результат", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Элемент.Отбор, "ПланРазвития.Цель", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ПланРазвитияРезультат");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстПодобранногоЗначенияЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Комментарий'"));
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Элемент.Отбор, "Объект.Мероприятия.Обучение", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("МероприятияОбучение");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстПодобранногоЗначенияЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<Обучение не пройдено>'"));

	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Элемент.Отбор, "Объект.Мероприятия.РезультатВыполнения", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("МероприятияРезультатВыполнения");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстПодобранногоЗначенияЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Комментарий'"));
	
	// Элемент оформления для таблицы ПланРазвития - если цель заполнена
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Элемент.Отбор, "ПланРазвития.Цель", , ВидСравненияКомпоновкиДанных.Заполнено);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ПланРазвития");
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Элемент оформления для таблицы ПланРазвития - если обучение заполнено
	Если Объект.ИспользоватьПрогрессРазвития Тогда
		Элемент = УсловноеОформление.Элементы.Добавить();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
			Элемент.Отбор, "ПланРазвития.Обучение", , ВидСравненияКомпоновкиДанных.Заполнено);
		Для Номер = 1 По Объект.ПродолжительностьПрогрессаРазвития Цикл
			Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("Прогресс" + Номер);
		КонецЦикла;
		Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультатыОбучения(СтрокаТаблицы)
	СтрокаТаблицы.Обучение = Неопределено;
	СтрокаТаблицы.ДокументыОбучения.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОповещениеДокументаОбучения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия <> "Запись_ОбучениеРазвитиеСотрудников" Тогда
		Возврат;
	КонецЕсли;
	
	Если СвойствоСтруктуры(Параметр, "РежимЗаписи", РежимЗаписиДокумента.Запись) = РежимЗаписиДокумента.Запись Тогда
		Возврат;
	КонецЕсли;
	
	Мероприятие = СвойствоСтруктуры(Параметр, "Мероприятие");
	Если Не ЗначениеЗаполнено(Мероприятие) Тогда
		Возврат;
	КонецЕсли;
	
	Если СвойствоСтруктуры(Параметр, "ДатаОкончания", Дата(1, 1, 1)) < Объект.ДатаНачала 
		Или СвойствоСтруктуры(Параметр, "ДатаНачала", Дата(1, 1, 1)) > Объект.ДатаОкончания Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ИспользоватьПрогрессРазвития Тогда
		ОчиститьПрогрессОбучения(Мероприятие);
		УстановитьЗначенияПериодовПрогрессаРазвития();
	КонецЕсли;
	ЗаполнитьРезультатыОбученияПоМероприятию(Мероприятие);
	СтандартныеПодсистемыКлиент.РазвернутьУзлыДерева(ЭтотОбъект, "ПланРазвития");
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПрогрессОбучения(Мероприятие)
	
	РегистрыСведений.ПрогрессОбученияСотрудников.ОчиститьПрогрессОбучения(
		Объект.Ссылка, Объект.Владелец, Мероприятие);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРезультатыОбученияПоМероприятию(Мероприятие)
	
	НайденныеСтроки = Объект.Мероприятия.НайтиСтроки(Новый Структура("Мероприятие", Мероприятие));
	Если НайденныеСтроки.Количество() > 0 Тогда
		ЗаполнитьРезультатыОбучения(НайденныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено)
	Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию);
КонецФункции

&НаСервере
Процедура УстановитьСвойстваЭлементовФормы()
	
	РезультатыОбученияДоступны = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ОбучениеСотрудников);
	ВводОбученияДоступен = ПравоДоступа("Чтение", Метаданные.Документы.ОбучениеРазвитиеСотрудников);
	
	Если Не РезультатыОбученияДоступны Тогда
		Элементы.МероприятияОбучение.Видимость = Ложь;
	КонецЕсли;
	
	УстановитьТолькоПросмотрПланаРазвития();
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьПланОбученияПериодами()
	
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Возврат;
	КонецЕсли;
	
	ПланОбученияСДатами = ОбучениеРазвитие.ПрограммаОбученияПоДатам(Объект.ДатаНачала, ПланОбучения.Выгрузить(),
		РазмерностьПродолжительностиПланаОбучения);
		
	Для каждого СтрокаМероприятия Из Объект.Мероприятия Цикл
		НайденныеСтроки = ПланОбученияСДатами.НайтиСтроки(Новый Структура("Мероприятие", СтрокаМероприятия.Мероприятие));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаМероприятия, НайденныеСтроки[0], "ДатаНачала, ДатаОкончания");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьХарактеристикиПерсоналаНаКлиенте(НовыеХарактеристики, ДополнительныеПараметры = Неопределено) Экспорт
	
	ДобавитьХарактеристикиПерсоналаНаСервере(НовыеХарактеристики, ДополнительныеПараметры);
	ДополнитьХарактеристики();
	ДополнитьХарактеристикиПризнакомТребуетсяРазвитие(НовыеХарактеристики);
	ЗаполнитьДеревоХарактеристик();
	РазвернутьУзлыДереваХарактеристик();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьУзлыДереваХарактеристик()
	
	СтандартныеПодсистемыКлиент.РазвернутьУзлыДерева(ЭтотОбъект, "ДеревоХарактеристик");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьХарактеристикиПерсоналаНаСервере(НовыеХарактеристики, ДополнительныеПараметры)
	
	ХарактеристикиПерсоналаФормы.ДобавитьХарактеристикиВТабличнуюЧасть(ЭтотОбъект, НовыеХарактеристики,
		ДополнительныеПараметры);
		
КонецПроцедуры

&НаСервере
Процедура ДополнитьХарактеристикиОценками()
	
	Если ЗначениеЗаполнено(Объект.Основание) Тогда
		ЧтениеОценок = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ОценкиОтветовОпросаПоКомпетенциям);
	Иначе
		ЧтениеОценок = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.РезультатыЭкспертнойОценкиПерсонала);
	КонецЕсли;
	
	Если Не ЧтениеОценок Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ЭкспертнаяОценкаПерсонала.ДополнитьХарактеристикиОценками(ЭтотОбъект);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьХарактеристикиЦелевымУровнем()
	
	Если Характеристики.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Характеристики.Характеристика КАК Характеристика,
		|	Характеристики.Значение КАК Значение
		|ПОМЕСТИТЬ ВТХарактеристики
		|ИЗ
		|	&Характеристики КАК Характеристики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТХарактеристики.Характеристика КАК Характеристика,
		|	МИНИМУМ(ВТХарактеристики.Значение.ЧисловоеЗначение) КАК ЦелевойУровень
		|ИЗ
		|	ВТХарактеристики КАК ВТХарактеристики
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТХарактеристики.Характеристика";
	Запрос.УстановитьПараметр("Характеристики", ЗначенияХарактеристики.Выгрузить());
	
	ЦеловойУровень = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаХарактеристик Из Характеристики Цикл
		НайденныеСтроки = ЦеловойУровень.НайтиСтроки(
			Новый Структура("Характеристика", СтрокаХарактеристик.Характеристика));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаХарактеристик.ЦелевойУровень = НайденныеСтроки[0].ЦелевойУровень;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьХарактеристикиПризнакомТребуетсяРазвитие(НовыеХарактеристики)
	
	ХарактеристикиДляОбновления = Новый Массив;
	Для Каждого НоваяХарактеристика Из НовыеХарактеристики Цикл
		ХарактеристикиДляОбновления.Добавить(НоваяХарактеристика.Характеристика);
	КонецЦикла;
	
	Для Каждого СтрокаХарактеристик Из Характеристики Цикл
		Если ХарактеристикиДляОбновления.Найти(СтрокаХарактеристик.Характеристика) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаХарактеристик.Оценка = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаХарактеристик.ТребуетсяОбучение = ?(СтрокаХарактеристик.Оценка < СтрокаХарактеристик.ЦелевойУровень,
			Истина, Ложь);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтборИзПодразделения(Знач Подразделение)

	ОтборИзПодразделения = Новый Структура;
	Источник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "Источник");
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Организации") Тогда
		ОтборИзПодразделения.Вставить("Организация", Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		ОтборИзПодразделения.Вставить("Подразделение", Источник);
		ОтборИзПодразделения.Вставить("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник,
			"ГоловнаяОрганизация"));
	КонецЕсли;
	
	Возврат ОтборИзПодразделения

КонецФункции

&НаСервере
Процедура ОбработкаВыбораФизическогоЛица(Знач ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		Объект.Владелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыбранноеЗначение, "ФизическоеЛицо");
	Иначе
		Объект.Владелец = ВыбранноеЗначение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПрофильДолжностиПозицииРезерва(ПозицияКадровогоРезерва)
	
	Если ПозицияКадровогоРезерва.Назначение = Перечисления.НазначенияКадровогоРезерва.ГруппаКадровогоРезерва Тогда
		Возврат ПозицияКадровогоРезерва.ПрофильДолжности;
	Иначе
		ПрофильДолжностиМассив = ХарактеристикиПерсонала.ПрофильДолжностиПоПозицииШтатногоРасписания(ПозицияКадровогоРезерва.ПозицияШтатногоРасписания);
		Если ПрофильДолжностиМассив.Количество() > 0 Тогда
			Возврат ПрофильДолжностиМассив[0];
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура РедактироватьПериодЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДатаНачала = Результат.ДатаНачала;
	Объект.ДатаОкончания = Результат.ДатаОкончания;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяНастройкиОтображенияПоКомпетенциям()
	
	Возврат "ОтображениеПоКомпетенциямВИндивидуальномПланеРазвития";
	
КонецФункции

&НаСервере
Процедура ПоКомпетенциямНаСервере()
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкиПользователя", ИмяНастройкиОтображенияПоКомпетенциям(),
		Элементы.ХарактеристикиПерсоналаПоКомпетенциям.Пометка);
	
	УстановитьСвойстваЭлементовХарактеристикПерсонала();
	ЗаполнитьДеревоХарактеристик();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементовХарактеристикПерсонала()

	ХарактеристикиПерсоналаКлиентСервер.УстановитьВидимостьГруппХарактеристикПерсонала(ЭтотОбъект,
		Элементы.ХарактеристикиПерсоналаПоКомпетенциям);
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоХарактеристик()

	Если Не Элементы.ХарактеристикиПерсоналаПоКомпетенциям.Пометка Тогда
		Возврат;
	КонецЕсли;
	
	ХарактеристикиДерево = РеквизитФормыВЗначение("ДеревоХарактеристик");
	ХарактеристикиПерсоналаФормы.ЗаполнитьДеревоХарактеристикПоКомпетенциям(ДанныеДляЗаполненияДереваХарактеристик(),
		ХарактеристикиДерево);
	ЗначениеВРеквизитФормы(ХарактеристикиДерево, "ДеревоХарактеристик");
	
КонецПроцедуры

&НаСервере
Функция ДанныеДляЗаполненияДереваХарактеристик()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаХарактеристик.Характеристика КАК Характеристика,
		|	ТаблицаХарактеристик.ВидХарактеристики КАК ВидХарактеристики,
		|	ТаблицаХарактеристик.ЗначенияСтрокой,
		|	ТаблицаХарактеристик.КартинкаВида КАК КартинкаВида,
		|	ТаблицаХарактеристик.Оценка КАК Оценка,
		|	ТаблицаХарактеристик.ПредыдущаяОценка КАК ПредыдущаяОценка,
		|	ТаблицаХарактеристик.ТребуетсяОбучение КАК ТребуетсяОбучение,
		|	ТаблицаХарактеристик.БаллХарактеристикиСотрудника КАК БаллХарактеристикиСотрудника,
		|	ТаблицаХарактеристик.ЗначениеХарактеристикиСотрудника КАК ЗначениеХарактеристикиСотрудника,
		|	ТаблицаХарактеристик.ЦелевойУровень КАК ЦелевойУровень
		|ПОМЕСТИТЬ ВТХарактеристики
		|ИЗ
		|	&ТаблицаХарактеристик КАК ТаблицаХарактеристик
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КомпетенцииПерсоналаХарактеристикиПерсонала.Ссылка КАК Компетенция,
		|	КомпетенцииПерсоналаХарактеристикиПерсонала.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ ВТКомпетенции
		|ИЗ
		|	Справочник.КомпетенцииПерсонала.ХарактеристикиПерсонала КАК КомпетенцииПерсоналаХарактеристикиПерсонала
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТХарактеристики КАК ВТХарактеристики
		|		ПО КомпетенцииПерсоналаХарактеристикиПерсонала.Характеристика = ВТХарактеристики.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТКомпетенции.Компетенция КАК Компетенция,
		|	ВТХарактеристики.Характеристика КАК Характеристика,
		|	ВТХарактеристики.ВидХарактеристики КАК ВидХарактеристики,
		|	ВТХарактеристики.ЗначенияСтрокой КАК ЗначенияСтрокой,
		|	ВТХарактеристики.КартинкаВида КАК КартинкаВида,
		|	ВТХарактеристики.Оценка КАК Оценка,
		|	ВТХарактеристики.ПредыдущаяОценка КАК ПредыдущаяОценка,
		|	ВТХарактеристики.ТребуетсяОбучение КАК ТребуетсяОбучение,
		|	ВТХарактеристики.БаллХарактеристикиСотрудника КАК БаллХарактеристикиСотрудника,
		|	ВТХарактеристики.ЗначениеХарактеристикиСотрудника КАК ЗначениеХарактеристикиСотрудника,
		|	ВТХарактеристики.ЦелевойУровень КАК ЦелевойУровень
		|ИЗ
		|	ВТХарактеристики КАК ВТХарактеристики
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКомпетенции КАК ВТКомпетенции
		|		ПО ВТХарактеристики.Характеристика = ВТКомпетенции.Характеристика
		|ИТОГИ ПО
		|	Компетенция";
	Запрос.УстановитьПараметр("ТаблицаХарактеристик", Характеристики.Выгрузить());
	
	Возврат Запрос.Выполнить();
	
КонецФункции

&НаКлиенте
Процедура УстановитьТребуетсяОбучениеВДереве(СтрокиДерева, ТребуетсяОбучение, Характеристика = Неопределено)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.ЭтоКомпетенция Тогда
			УстановитьТребуетсяОбучениеВДереве(СтрокаДерева.ПолучитьЭлементы(), ТребуетсяОбучение, Характеристика);
		ИначеЕсли Характеристика = Неопределено Или СтрокаДерева.Характеристика = Характеристика Тогда
			СтрокаДерева.ТребуетсяОбучение = ТребуетсяОбучение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТребуетсяОбучениеДляХарактеристикиВТаблице(Характеристика, ТребуетсяОбучение)
	
	НайденныеСтроки = Характеристики.НайтиСтроки(Новый Структура("Характеристика", Характеристика));
	Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		НайденнаяСтрока.ТребуетсяОбучение = ТребуетсяОбучение;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево(Развернуть = Истина)

	Для каждого СтрокаДерева Из ДеревоХарактеристик.ПолучитьЭлементы() Цикл
		Элементы.ДеревоХарактеристик.Развернуть(СтрокаДерева.ПолучитьИдентификатор(), Развернуть);
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура УстановитьТолькоПросмотрПланаРазвития()
	
	РазрешеноРедактированиеСтатуса = Справочники.СтатусыИндивидуальныхПлановРазвития.РазрешеноРедактированиеПланаРазвитияСЛюбымСтатусом();
	Если РазрешеноРедактированиеСтатуса Тогда
		ТолькоПросмотр = Ложь;
		Возврат;
	Иначе
		ТолькоПросмотр = Истина;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодборХарактеристик", "Доступность", Ложь);
	КонецЕсли;
	
	Если Объект.Статус = ПредопределенноеЗначение("Справочник.СтатусыИндивидуальныхПлановРазвития.НаРассмотрении") Тогда
		ТолькоПросмотр = Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Статус", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодборХарактеристик", "Доступность", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидимостьПланаРазвития", "ТолькоПросмотр", Ложь);
	ИначеЕсли Объект.Статус = ПредопределенноеЗначение("Справочник.СтатусыИндивидуальныхПлановРазвития.Согласован") Тогда
		ТолькоПросмотр = Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаШапки", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ХарактеристикиПерсоналаСтраница", "ТолькоПросмотр", Истина); 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПрограммаОбученияСтраница", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПланРазвитияЦелиМероприятия", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МероприятияОткрытьПодборПрограммыОбученияПоХарактеристикам",
			"Доступность", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПланРазвитияДатаНачала", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПланРазвитияДатаОкончания", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПланРазвитияПериодыОценкиГруппа", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПодвала", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "УстановитьИнтервал", "Доступность", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПланРазвитияПодборЦелейРазвития", "Доступность", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПодбор", "Доступность", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОтметитьТребуетсяРазвитие", "Доступность", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПланРазвития", "ИзменятьСоставСтрок", Ложь);
	ИначеЕсли Объект.Статус = ПредопределенноеЗначение("Справочник.СтатусыИндивидуальныхПлановРазвития.Остановлен") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаКорректировка", "Видимость", Ложь);
	КонецЕсли;
	
КонецПроцедуры

