#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ПроеритьНаличиеСхожихИПР();
	
	Наименование = Владелец.Наименование + " (" + Формат(ДатаНачала, "ДФ=MM.yyyy")+ " - " + Формат(ДатаОкончания, "ДФ=MM.yyyy") + ")";
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ЗаполнитьПоДаннымЗаполнения(ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Статус = Справочники.СтатусыИндивидуальныхПлановРазвития.НаРассмотрении;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоДаннымЗаполнения(ДанныеЗаполнения)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ЗначениеЗаполнено(Наставник) Тогда
		ЕстьНаставник = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Куратор) Тогда
		ЕстьКуратор = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Основание) Тогда
		Характеристики = ХарактеристикиПерсонала.ХарактеристикиПерсоналаПоПозицииКадровогоРезерва(Основание);
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Характеристики, РазвиваемыеХарактеристики);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроеритьНаличиеСхожихИПР()
	
	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СкорректированныйИПР) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИндивидуальныйПланРазвития.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИндивидуальныйПланРазвития КАК ИндивидуальныйПланРазвития
		|ГДЕ
		|	ИндивидуальныйПланРазвития.Основание = &Основание
		|	И ИндивидуальныйПланРазвития.Владелец = &Владелец
		|	И НЕ ИндивидуальныйПланРазвития.ПометкаУдаления
		|	И НЕ ИндивидуальныйПланРазвития.Ссылка = &Ссылка
		|	И НЕ (&ДатаОкончания <= ИндивидуальныйПланРазвития.ДатаНачала
		|	ИЛИ &ДатаНачала >= ИндивидуальныйПланРазвития.ДатаОкончания)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Для сотрудника: %1
					|Претендующего на позицию:
					|%2
					|В период с %3 по %4 уже введен индивидуальный план развития.'"),
		Владелец,
		Основание,
		Формат(ДатаНачала, "ДЛФ=D"),
		Формат(ДатаОкончания, "ДЛФ=D"));
		
	ВызватьИсключение ТекстСообщения;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли