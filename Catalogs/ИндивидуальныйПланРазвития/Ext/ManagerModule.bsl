// Выполняет заполенени реквизита Статус в индивидуальных планах развития при обновлении.
// 
// Параметры:
//  ПараметрыОбновления - Структура
Процедура ЗаполнитьСтатусы(ПараметрыОбновления = Неопределено) Экспорт
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления,
		"ОбработкаЗавершена", Ложь);
	
	Если Не ПараметрыОбновления.Свойство("ОбработанныеЭлементы") Тогда
		ПараметрыОбновления.Вставить("ОбработанныеЭлементы", Новый Массив);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбработанныеЭлементы", ПараметрыОбновления.ОбработанныеЭлементы);
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ИндивидуальныйПланРазвития.Ссылка КАК Ссылка,
		|	ИндивидуальныйПланРазвития.ПометкаУдаления,
		|	ИндивидуальныйПланРазвития.ДатаНачала,
		|	ИндивидуальныйПланРазвития.ДатаОкончания
		|ИЗ
		|	Справочник.ИндивидуальныйПланРазвития КАК ИндивидуальныйПланРазвития
		|ГДЕ
		|	НЕ ИндивидуальныйПланРазвития.Ссылка В (&ОбработанныеЭлементы)
		|	И ИндивидуальныйПланРазвития.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыИндивидуальныхПлановРазвития.ПустаяСсылка)";
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.ИндивидуальныйПланРазвития.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления,
				"ОбработкаЗавершена", Истина);
			ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления,
				"ОбработанныеЭлементы", Новый Массив);
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект(); // СправочникОбъект.ИндивидуальныйПланРазвития
			Если Выборка.ПометкаУдаления Тогда
				Статус = Справочники.СтатусыИндивидуальныхПлановРазвития.Отклонен;
			ИначеЕсли Выборка.ДатаОкончания < Сегодня Тогда
				Статус = Справочники.СтатусыИндивидуальныхПлановРазвития.Завершен;
			Иначе
				Статус = Справочники.СтатусыИндивидуальныхПлановРазвития.НаРассмотрении;
			КонецЕсли;
			СправочникОбъект.Статус = Статус;
			
			// Так как значение статуса зависит от даты обновления базы, то статусы в подчиненных узлах РИБ нужно
			// актуализировать из главного узла.
			// В тех планах развития, которых нет в главном узле, статус будет заполнен в подчиненных узлах самостоятельно.
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект, Не ОбщегоНазначения.ЭтоПодчиненныйУзелРИБ());
			
			ПараметрыОбновления.ОбработанныеЭлементы.Добавить(Выборка.Ссылка);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

