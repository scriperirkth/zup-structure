// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Ученический договор
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.МенеджерПечати = "Справочник.ИндивидуальныйПланРазвития";
	КомандаПечати.Идентификатор = "ИндивидуальныйПланРазвития";
	КомандаПечати.Представление = НСтр("ru = 'Индивидуальный план развития'");
	КомандаПечати.Порядок = 1;
	
	// Выполнение плана развития
	ИспользоватьЦелиРазвитияСотрудников = ПолучитьФункциональнуюОпцию("ИспользоватьЦелиРазвитияСотрудников");
	Если ИспользоватьЦелиРазвитияСотрудников Тогда
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
		КомандаПечати.МенеджерПечати = "Справочник.ИндивидуальныйПланРазвития";
		КомандаПечати.Идентификатор = "ИндивидуальныйПланРазвитияПоЦелям";
		КомандаПечати.Представление = НСтр("ru = 'Индивидуальный план развития по целям'");
		КомандаПечати.Порядок = 2;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба") Тогда
		МодульГосударственнаяСлужба = ОбщегоНазначения.ОбщийМодуль("ГосударственнаяСлужба");
		МодульГосударственнаяСлужба.ДобавитьКомандуПечатиПланаМероприятийГосслужащих(КомандыПечати);
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба") Тогда
		МодульГосударственнаяСлужба = ОбщегоНазначения.ОбщийМодуль("ГосударственнаяСлужба");
		МодульГосударственнаяСлужба.ДобавитьКомандуПечатиОтзываОРезультатахНаставничестваГосслужащих(КомандыПечати);
	КонецЕсли;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИндивидуальныйПланРазвития");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ИндивидуальныйПланРазвития",
			НСтр("ru = 'Индивидуальный план развития'"),
			ПечатьИПР(МассивОбъектов, ОбъектыПечати),
			,
			"Справочник.ИндивидуальныйПланРазвития.ПФ_MXL_ИндивидуальныйПланРазвития");
	КонецЕсли;
		
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИндивидуальныйПланРазвитияПоЦелям");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ИндивидуальныйПланРазвитияПоЦелям",
			НСтр("ru = 'Индивидуальный план развития по целям'"),
			ПечатьИПРПоЦелям(МассивОбъектов, ОбъектыПечати),
			,
			"Справочник.ИндивидуальныйПланРазвития.ПФ_MXL_ИндивидуальныйПланРазвитияПоЦелям");
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьИПР(МассивОбъектов, ОбъектыПечати)
	
	// Создаем табличный документ и устанавливаем имя параметров печати.
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_ИПР";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.ИндивидуальныйПланРазвития.ПФ_MXL_ИндивидуальныйПланРазвития");
	
	Области = Новый Структура();
	Области.Вставить("Шапка", Макет.ПолучитьОбласть("Шапка"));
	Области.Вставить("ПодписьНаставника", Макет.ПолучитьОбласть("ПодписьНаставника"));
	Области.Вставить("ПодписьКуратора", Макет.ПолучитьОбласть("ПодписьКуратора"));
	Области.Вставить("РекомендацииРазвития", Макет.ПолучитьОбласть("РекомендацииРазвития"));
	Области.Вставить("ШапкаПрограммаОбучения", Макет.ПолучитьОбласть("ШапкаПрограммаОбучения"));
	Области.Вставить("Строка", Макет.ПолучитьОбласть("СтрокаМероприятия"));
	Области.Вставить("ЗаключениеНаставника", Макет.ПолучитьОбласть("ЗаключениеНаставника"));
	Области.Вставить("ЗаключениеКуратора", Макет.ПолучитьОбласть("ЗаключениеКуратора"));
	
	ПоляПоискаРезультатов = "ФизическоеЛицо, Мероприятие, ДатаНачалаПлан, ДатаОкончанияПлан";
	ОтборРезультатов = Новый Структура(ПоляПоискаРезультатов);
	
	ДанныеДляПечати = ДанныеДляПечати(МассивОбъектов);
	Если ДанныеДляПечати.РезультатыОбучения <> Неопределено Тогда
		ОбщегоНазначенияБЗК.ДобавитьИндексКоллекции(ДанныеДляПечати.РезультатыОбучения, ПоляПоискаРезультатов);
	КонецЕсли;
	
	Обход = Обработки.ОбходКоллекции.НовыйОбход(ДанныеДляПечати.ИндивидуальныеПланыРазвития);
	Пока Обход.СледующийПоЗначениюПоля("ИндивидуальныйПланРазвития") Цикл
		
		ЗаполнитьЗначенияСвойств(Области.Шапка.Параметры, Обход.ТекущиеДанные());
		Области.Шапка.Параметры.ДатаНачалаИПР = Формат(Обход.ТекущиеДанные().ДатаНачалаИПР, "ДЛФ=D");
		Области.Шапка.Параметры.ДатаОкончанияИПР = Формат(Обход.ТекущиеДанные().ДатаОкончанияИПР, "ДЛФ=D");
		ТабличныйДокумент.Вывести(Области.Шапка);
		
		ЕстьНаставник = Обход.ТекущиеДанные().ЕстьНаставник;
		ЕстьКуратор = Обход.ТекущиеДанные().ЕстьКуратор;
		ФИОНаставника = Обход.ТекущиеДанные().ФИОНаставника;
		ФИОКуратора = Обход.ТекущиеДанные().ФИОКуратора;
		
		ВывестиОбластьВТабличныйДокумент(
			ЕстьНаставник, ФИОНаставника, "ФИОНаставника", "ПодписьНаставника", Области, ТабличныйДокумент);
		ВывестиОбластьВТабличныйДокумент(
			ЕстьКуратор, ФИОКуратора,"ФИОКуратора", "ПодписьКуратора", Области, ТабличныйДокумент);
		
		ЗаполнитьЗначенияСвойств(Области.РекомендацииРазвития.Параметры, Обход.ТекущиеДанные());
		ТабличныйДокумент.Вывести(Области.РекомендацииРазвития);
		
		ТабличныйДокумент.Вывести(Области.ШапкаПрограммаОбучения);
		
		Пока Обход.СледующийПоЗначениямПолей("НомерСтроки") Цикл
			ЗаполнитьЗначенияСвойств(Области.Строка.Параметры, Обход.ТекущиеДанные());
			Области.Строка.Параметры.ДатаНачала = Формат(Обход.ТекущиеДанные().ДатаНачала, "ДЛФ=D");
			Области.Строка.Параметры.ДатаОкончания = Формат(Обход.ТекущиеДанные().ДатаОкончания, "ДЛФ=D");
			Области.Строка.Параметры.ФамилияИООтветственного = ФизическиеЛицаЗарплатаКадрыКлиентСервер.ФамилияИнициалы(
				Обход.ТекущиеДанные().ФИООтветственного);
			ПредставлениеРезультатов = "";
			Если ДанныеДляПечати.РезультатыОбучения <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ОтборРезультатов, Обход.ТекущиеДанные());
				ОтборРезультатов.ДатаНачалаПлан = Обход.ТекущиеДанные().ДатаНачала;
				ОтборРезультатов.ДатаОкончанияПлан = Обход.ТекущиеДанные().ДатаОкончания;
				РезультатыОбучения = ДанныеДляПечати.РезультатыОбучения.НайтиСтроки(ОтборРезультатов);
				ДополнитьПредставление(ПредставлениеРезультатов, 
					ОбучениеРазвитиеКлиентСервер.ПредставлениеРезультатовОбучения(РезультатыОбучения));
			КонецЕсли;
			ДополнитьПредставление(ПредставлениеРезультатов, Обход.ТекущиеДанные().РезультатВыполнения, Символы.ПС);
			Области.Строка.Параметры.Результаты = ПредставлениеРезультатов;
			ТабличныйДокумент.Вывести(Области.Строка);
		КонецЦикла;
		
		ЗаключениеНаставника = Обход.ТекущиеДанные().ЗаключениеНаставника;
		ЗаключениеКуратора = Обход.ТекущиеДанные().ЗаключениеКуратора;
		
		ВывестиОбластьВТабличныйДокумент(
			ЕстьНаставник, ЗаключениеНаставника, "ЗаключениеНаставника", "ЗаключениеНаставника", Области, ТабличныйДокумент);
		ВывестиОбластьВТабличныйДокумент(
			ЕстьКуратор, ЗаключениеКуратора,"ЗаключениеКуратора", "ЗаключениеКуратора", Области, ТабличныйДокумент);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьИПРПоЦелям(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_ИПР";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.ИндивидуальныйПланРазвития.ПФ_MXL_ИндивидуальныйПланРазвитияПоЦелям");
	
	Области = Новый Структура();
	Области.Вставить("Шапка", Макет.ПолучитьОбласть("Шапка"));
	Области.Вставить("ШапкаОпросы", Макет.ПолучитьОбласть("ШапкаОпросы"));
	Области.Вставить("Опросы", Макет.ПолучитьОбласть("Опросы"));
	Области.Вставить("Рекомендации", Макет.ПолучитьОбласть("Рекомендации"));
	Области.Вставить("ШапкаМероприятия", Макет.ПолучитьОбласть("ШапкаМероприятия"));
	Области.Вставить("Мероприятия", Макет.ПолучитьОбласть("Мероприятия"));
	Области.Вставить("ЗаключениеНаставника", Макет.ПолучитьОбласть("ЗаключениеНаставника"));
	Области.Вставить("ЗаключениеКуратора", Макет.ПолучитьОбласть("ЗаключениеКуратора"));
	Области.Вставить("Подвал", Макет.ПолучитьОбласть("Подвал"));
	Области.Вставить("ПодписьНаставника", Макет.ПолучитьОбласть("ПодписьНаставника"));
	Области.Вставить("ПодписьКуратора", Макет.ПолучитьОбласть("ПодписьКуратора"));
	
	ПоляПоискаРезультатов = "ФизическоеЛицо, Мероприятие, ДатаНачалаПлан, ДатаОкончанияПлан";
	
	ДанныеДляПечати = ДанныеДляПечати(МассивОбъектов);
	Если ДанныеДляПечати.РезультатыОбучения <> Неопределено Тогда
		ОбщегоНазначенияБЗК.ДобавитьИндексКоллекции(ДанныеДляПечати.РезультатыОбучения, ПоляПоискаРезультатов);
	КонецЕсли;
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
	Оцениваемые = ДанныеДляПечати.ИндивидуальныеПланыРазвития.ВыгрузитьКолонку("ФизическоеЛицо");
	
	РезультатыЭкспертнойОценки = ЭкспертнаяОценкаПерсонала.РезультатыЭкспертнойОценки(Оцениваемые);
	
	Цели = ДанныеДляПечати.ИндивидуальныеПланыРазвития.ВыгрузитьКолонку("ЦельРазвития");
	Мероприятия = ДанныеДляПечати.ИндивидуальныеПланыРазвития.ВыгрузитьКолонку("Мероприятие");
	ХарактеристикиМероприятий = ХарактеристикиМероприятия(Цели, Мероприятия);
	ХарактеристикиИПР = ХарактеристикиИПР(
		ДанныеДляПечати.ИндивидуальныеПланыРазвития.ВыгрузитьКолонку("ИндивидуальныйПланРазвития"));
	
	Обход = Обработки.ОбходКоллекции.НовыйОбход(ДанныеДляПечати.ИндивидуальныеПланыРазвития);
	Пока Обход.СледующийПоЗначениюПоля("ИндивидуальныйПланРазвития") Цикл
		ТекущиеДанные = Обход.ТекущиеДанные();
		ЗаполнитьЗначенияСвойств(Области.Шапка.Параметры, ТекущиеДанные);
		Области.Шапка.Параметры.ДатаНачалаИПР = Формат(ТекущиеДанные.ДатаНачалаИПР, "ДЛФ=D");
		Области.Шапка.Параметры.ДатаОкончанияИПР = Формат(ТекущиеДанные.ДатаОкончанияИПР, "ДЛФ=D");
		
		СотрудникиФизическихЛиц = КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущиеДанные.ФизическоеЛицо),
			Истина,
			ОрганизацияИПР(ТекущиеДанные.Подразделение),
			ТекущаяДата);
		
		Если СотрудникиФизическихЛиц.Количество() > 0 Тогда
			СтрокаСотрудника = СотрудникиФизическихЛиц.Найти(ТекущиеДанные.ФизическоеЛицо, "ФизическоеЛицо");
			Если СтрокаСотрудника <> Неопределено Тогда
				Области.Шапка.Параметры.Организация = СтрокаСотрудника.ГоловнаяОрганизация;
				Области.Шапка.Параметры.Должность = КадровыйУчет.КадровыеДанныеСотрудника(
					Истина, СтрокаСотрудника.Сотрудник, "Должность", ТекущаяДата).Должность;
			КонецЕсли;
		Иначе
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Физическое лицо %1 не является сотрудником организации, необходимо проверить ИПР. '"),
				ТекущиеДанные.ФизическоеЛицо);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(Области.Шапка);
		
		ТабличныйДокумент.Вывести(Области.ШапкаОпросы);
		
		ПрофильОценки = ПрофильДолжностиПозицииРезерва(ТекущиеДанные.ПозицияКР);
		Если ЗначениеЗаполнено(ПрофильОценки) Тогда
			РезультатыОценки = РезультатыЭкспертнойОценки.НайтиСтроки(
				Новый Структура("ФизическоеЛицо, ПрофильДолжности", ТекущиеДанные.ФизическоеЛицо, ПрофильОценки));
			Если РезультатыОценки.Количество() <> 0 Тогда
				ДанныеОценки = РезультатыОценки[0];
				Области.Опросы.Параметры.ОпросыПоКомпетенциям =
					СтрШаблон(НСтр("ru = '%1 - %2'"),
					ДанныеОценки.ОпросПоКомпетенциям,
					Формат(ДанныеОценки.Оценка, "ЧДЦ=2;"));
			КонецЕсли;
		КонецЕсли;
		ТабличныйДокумент.Вывести(Области.Опросы);
		
		Области.Рекомендации.Параметры.РекомендацииРазвития = ТекущиеДанные.РекомендацииРазвития;
		ТабличныйДокумент.Вывести(Области.Рекомендации);
		
		ТабличныйДокумент.Вывести(Области.ШапкаМероприятия);
		Пока Обход.СледующийПоЗначениямПолей("НомерСтроки") Цикл
			ХарактеристикиМероприятияИПР = Новый Массив;
			ТекущиеДанные = Обход.ТекущиеДанные();
			ЗаполнитьЗначенияСвойств(Области.Мероприятия.Параметры, ТекущиеДанные);
			Области.Мероприятия.Параметры.ДатаНачала = Формат(ТекущиеДанные.ДатаНачала, "ДЛФ=D");
			Области.Мероприятия.Параметры.ДатаОкончания = Формат(ТекущиеДанные.ДатаОкончания, "ДЛФ=D");
			Области.Мероприятия.Параметры.ФормаОбучения = ТекущиеДанные.ВидМероприятия;
			Области.Мероприятия.Параметры.ФамилияИООтветственного =
				ФизическиеЛицаЗарплатаКадрыКлиентСервер.ФамилияИнициалы(ТекущиеДанные.ФИООтветственного);
			Характеристики = ХарактеристикиИПР.НайтиСтроки(Новый Структура("ИндивидуальныйПланРазвития",
				ТекущиеДанные.ИндивидуальныйПланРазвития));
			ХарактеристикиМероприятия = ХарактеристикиМероприятий.НайтиСтроки(Новый Структура("Цель, Мероприятие",
				ТекущиеДанные.ЦельРазвития, ТекущиеДанные.Мероприятие));
			Для Каждого ХарактеристикаМероприятия Из ХарактеристикиМероприятия Цикл
				Для Каждого Характеристика Из Характеристики Цикл
					Если ХарактеристикаМероприятия.Характеристика = Характеристика.Характеристика Тогда
						ХарактеристикиМероприятияИПР.Добавить(ХарактеристикаМероприятия.Характеристика);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Области.Мероприятия.Параметры.Характеристики = СтрСоединить(ХарактеристикиМероприятияИПР, ", ");
			ТабличныйДокумент.Вывести(Области.Мероприятия);
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(Области.Подвал.Параметры, ТекущиеДанные);
		Области.Подвал.Параметры.ПозицияСотрудника = КадровыйУчет.КадровыеДанныеСотрудника(
			Истина, СтрокаСотрудника.Сотрудник, "ДолжностьПоШтатномуРасписанию", ТекущаяДата).ДолжностьПоШтатномуРасписанию;
		
		Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ОтветственныйФЛ) Тогда
			Области.Подвал.Параметры.ФИООтветственногоИПР = ТекущиеДанные.ОтветственныйФЛ.ФИО;
			ЗаполнитьПозицию(ТекущиеДанные.ОтветственныйФЛ, Области.Подвал, "ПозицияОтветственного", Организация, ТекущаяДата);
		КонецЕсли;
		
		ЕстьНаставник = ТекущиеДанные.ЕстьНаставник;
		ЕстьКуратор = ТекущиеДанные.ЕстьКуратор;
		
		Если ЕстьНаставник Тогда
			Области.ЗаключениеНаставника.Параметры.ЗаключениеНаставника = ТекущиеДанные.ЗаключениеНаставника;
			ТабличныйДокумент.Вывести(Области.ЗаключениеНаставника);
			Области.ПодписьНаставника.Параметры.ФИОНаставника = ТекущиеДанные.ФИОНаставника;
			ЗаполнитьПозицию(ТекущиеДанные.Наставник, Области.ПодписьНаставника, "ПозицияНаставника", Организация, ТекущаяДата);
		КонецЕсли;
		
		Если ЕстьКуратор Тогда
			Области.ЗаключениеКуратора.Параметры.ЗаключениеКуратора = ТекущиеДанные.ЗаключениеКуратора;
			ТабличныйДокумент.Вывести(Области.ЗаключениеКуратора);
			Области.ПодписьКуратора.Параметры.ФИОКуратора = ТекущиеДанные.ФИОКуратора;
			ЗаполнитьПозицию(ТекущиеДанные.Куратор, Области.ПодписьКуратора, "ПозицияКуратора", Организация, ТекущаяДата);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(Области.Подвал);
		Если ЕстьНаставник Тогда
			ТабличныйДокумент.Вывести(Области.ПодписьНаставника);
		КонецЕсли;
		Если ЕстьКуратор Тогда
			ТабличныйДокумент.Вывести(Области.ПодписьКуратора);
		КонецЕсли;
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ДанныеДляПечати(ИндивидуальныеПланыРазвития) Экспорт
	
	Данные = Новый Структура();
	Данные.Вставить("ИндивидуальныеПланыРазвития");
	Данные.Вставить("РезультатыОбучения");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИндивидуальныеПланыРазвития", ИндивидуальныеПланыРазвития);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИндивидуальныйПланРазвития.Ссылка КАК ИндивидуальныйПланРазвития,
		|	ИндивидуальныйПланРазвития.Владелец КАК ФизическоеЛицо,
		|	ИндивидуальныйПланРазвития.Владелец.ФИО КАК ФИОСотрудника,
		|	ИндивидуальныйПланРазвития.Ответственный.ФизическоеЛицо КАК СотрудникКадровойСлужбы,
		|	ИндивидуальныйПланРазвития.Ответственный.ФизическоеЛицо.ФИО КАК ФИОСотрудникаКадровойСлужбы,
		|	ИндивидуальныйПланРазвития.ДатаНачала КАК ДатаНачалаИПР,
		|	ИндивидуальныйПланРазвития.ДатаОкончания КАК ДатаОкончанияИПР,
		|	ИндивидуальныйПланРазвития.Подразделение КАК Подразделение,
		|	ИндивидуальныйПланРазвития.РекомендацииРазвития КАК РекомендацииРазвития,
		|	ИндивидуальныйПланРазвития.Основание КАК ПозицияКР,
		|	ИндивидуальныйПланРазвития.Наставник КАК Наставник,
		|	ИндивидуальныйПланРазвития.Наставник.ФИО КАК ФИОНаставника,
		|	ИндивидуальныйПланРазвития.Куратор КАК Куратор,
		|	ИндивидуальныйПланРазвития.Куратор.ФИО КАК ФИОКуратора,
		|	ИндивидуальныйПланРазвития.Ответственный.ФизическоеЛицо КАК ОтветственныйФЛ,
		|	ПрограммаОбучения.Мероприятие КАК Мероприятие,
		|	ПрограммаОбучения.ДатаНачала КАК ДатаНачала,
		|	ПрограммаОбучения.ДатаОкончания КАК ДатаОкончания,
		|	ПрограммаОбучения.РезультатВыполнения КАК РезультатВыполнения,
		|	ПрограммаОбучения.Ответственный КАК Ответственный,
		|	ПрограммаОбучения.Мероприятие.ВидМероприятия КАК ВидМероприятия,
		|	ПрограммаОбучения.НомерСтроки КАК НомерСтроки,
		|	ПрограммаОбучения.ВыбранноеОбучение КАК ВыбранноеОбучение,
		|	ПрограммаОбучения.Цель КАК ЦельРазвития,
		|	ЕСТЬNULL(ПрограммаОбучения.Ответственный.ФИО, """") КАК ФИООтветственного,
		|	ИндивидуальныйПланРазвития.ЕстьНаставник КАК ЕстьНаставник,
		|	ИндивидуальныйПланРазвития.ЕстьКуратор КАК ЕстьКуратор,
		|	ИндивидуальныйПланРазвития.ЗаключениеНаставника КАК ЗаключениеНаставника,
		|	ИндивидуальныйПланРазвития.ЗаключениеКуратора КАК ЗаключениеКуратора
		|ИЗ
		|	Справочник.ИндивидуальныйПланРазвития КАК ИндивидуальныйПланРазвития
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИндивидуальныйПланРазвития.Мероприятия КАК ПрограммаОбучения
		|		ПО (ПрограммаОбучения.Ссылка = ИндивидуальныйПланРазвития.Ссылка)
		|ГДЕ
		|	ИндивидуальныйПланРазвития.Ссылка В(&ИндивидуальныеПланыРазвития)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИндивидуальныйПланРазвития,
		|	НомерСтроки";
	Данные.ИндивидуальныеПланыРазвития = Запрос.Выполнить().Выгрузить();
	
	Если ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ОбучениеСотрудников) Тогда
		Данные.РезультатыОбучения = ОбучениеРазвитие.РезультатыОбучения(
			Данные.ИндивидуальныеПланыРазвития.Скопировать(, 
				СтрСоединить(ОбщегоНазначения.ВыгрузитьКолонку(ОбучениеРазвитие.НовыйПланМероприятий().Колонки, "Имя"), ",")));
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция ХарактеристикиИПР(ИндивидуальныеПланыРазвития)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИндивидуальныеПланыРазвития", ИндивидуальныеПланыРазвития);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИндивидуальныйПланРазвития.Ссылка КАК ИндивидуальныйПланРазвития,
		|	Характеристики.Характеристика КАК Характеристика
		|ИЗ
		|	Справочник.ИндивидуальныйПланРазвития КАК ИндивидуальныйПланРазвития
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИндивидуальныйПланРазвития.РазвиваемыеХарактеристики КАК Характеристики
		|		ПО (Характеристики.Ссылка = ИндивидуальныйПланРазвития.Ссылка)
		|			И (Характеристики.ТребуетсяОбучение)
		|ГДЕ
		|	ИндивидуальныйПланРазвития.Ссылка В(&ИндивидуальныеПланыРазвития)
		|
		|СГРУППИРОВАТЬ ПО
		|	Характеристики.Характеристика,
		|	ИндивидуальныйПланРазвития.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИндивидуальныйПланРазвития";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ХарактеристикиМероприятия(Цели, Мероприятия)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Цели", Цели);
	Запрос.УстановитьПараметр("Мероприятия", Мероприятия);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦелиРазвития.Ссылка КАК Цель,
		|	ЦелиРазвитияМероприятияОбучения.Мероприятие КАК Мероприятие,
		|	ЦелиРазвитияМероприятияОбучения.Характеристика КАК Характеристика
		|ИЗ
		|	Справочник.ЦелиРазвития КАК ЦелиРазвития
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦелиРазвития.МероприятияОбучения КАК ЦелиРазвитияМероприятияОбучения
		|		ПО ЦелиРазвития.Ссылка = ЦелиРазвитияМероприятияОбучения.Ссылка
		|		И ЦелиРазвитияМероприятияОбучения.Мероприятие В (&Мероприятия)
		|ГДЕ
		|	ЦелиРазвития.Ссылка В (&Цели)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДополнитьПредставление(Представление, Дополнение, Разделитель = ", ") Экспорт
	ОбучениеРазвитиеКлиентСервер.ДополнитьПредставление(Представление, Дополнение, Разделитель);
КонецПроцедуры

Функция ПрофильДолжностиПозицииРезерва(ПозицияКадровогоРезерва)
	
	Если ПозицияКадровогоРезерва.Назначение = Перечисления.НазначенияКадровогоРезерва.ГруппаКадровогоРезерва Тогда
		Возврат ПозицияКадровогоРезерва.ПрофильДолжности;
	Иначе
		ПрофильДолжностиМассив = ХарактеристикиПерсонала.ПрофильДолжностиПоПозицииШтатногоРасписания(ПозицияКадровогоРезерва.ПозицияШтатногоРасписания);
		Если ПрофильДолжностиМассив.Количество() > 0 Тогда
			Возврат ПрофильДолжностиМассив[0];
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ОрганизацияИПР(Подразделение)
	
	Источник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "Источник");
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Организации") Тогда
		ОрганизацияИПР = Источник;
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		ОрганизацияИПР = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ГоловнаяОрганизация");
	Иначе
		ОрганизацияИПР = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ОрганизацияИПР;
	
КонецФункции

Процедура ЗаполнитьПозицию(ФизическоеЛицо, ОбластьПодписи, ПараметрПозиция, Организация, ТекущаяДата)
	
	СотрудникиФизическихЛиц = КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическоеЛицо),
		Истина, Организация, ТекущаяДата);
		
	Если СотрудникиФизическихЛиц.Количество() > 0 Тогда
		СтрокаСотрудника = СотрудникиФизическихЛиц.Найти(ФизическоеЛицо, "ФизическоеЛицо");
		Если СтрокаСотрудника <> Неопределено Тогда
			ОбластьПодписи.Параметры[ПараметрПозиция] = КадровыйУчет.КадровыеДанныеСотрудника(
				Истина,
				СтрокаСотрудника.Сотрудник,
				"ДолжностьПоШтатномуРасписанию", ТекущаяДата).ДолжностьПоШтатномуРасписанию;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиОбластьВТабличныйДокумент(ЕстьПризнак, ЗначениеПараметра, ИмяПараметра, ИмяОбласти, Области, ТабличныйДокумент)

	Если ЕстьПризнак Тогда
		Области[ИмяОбласти].Параметры[ИмяПараметра] = ЗначениеПараметра;
		ТабличныйДокумент.Вывести(Области[ИмяОбласти]);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли