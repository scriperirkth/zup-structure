#Область ШкалаВозраста

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьПредставлениеИнтервалаШкалыВозраста(ТаблицаИнтервалов)
	
	Для Каждого СтрокаШкалы Из ТаблицаИнтервалов Цикл
		МедицинскоеСтрахованиеКлиентСервер.СформироватьПредставлениеИнтервалаШкалыВозраста(СтрокаШкалы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УпорядочитьСтрокиШкалыВозраста(ТекущиеДанные, Шкала)
	
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ТекущаяПозиция = Шкала.Индекс(ТекущиеДанные);
	НоваяПозиция = 0;
	
	Для Каждого ТекСтрока Из Шкала Цикл 
		Если НоваяПозиция <> ТекущаяПозиция И ТекСтрока.ЗначениеОт >= ТекущиеДанные.ЗначениеОт Тогда 
			Прервать;
		КонецЕсли;
		НоваяПозиция = НоваяПозиция + 1;
	КонецЦикла;
	
	Сдвиг = ?(НоваяПозиция < ТекущаяПозиция, НоваяПозиция - ТекущаяПозиция, НоваяПозиция - ТекущаяПозиция - 1);
	Шкала.Сдвинуть(ТекущаяПозиция, Сдвиг);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтрокиШкалыВозраста(Шкала)
	
	КоличествоСтрок = Шкала.Количество();
	Если КоличествоСтрок = 0 Тогда 
		НоваяСтрока = Шкала.Добавить();
		НоваяСтрока.ЗначениеПоказателя = 1;
	ИначеЕсли Шкала[КоличествоСтрок-1].ЗначениеДо <> 0 
		И Шкала[КоличествоСтрок-1].ЗначениеДо > Шкала[КоличествоСтрок-1].ЗначениеОт Тогда
		НоваяСтрока = Шкала.Добавить();
		НоваяСтрока.ЗначениеОт = Шкала[КоличествоСтрок-1].ЗначениеДо + 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкорректироватьСоседниеСтрокиШкалыВозраста(ТекущиеДанные, Шкала);
	
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЗначениеДо <= ТекущиеДанные.ЗначениеОт Тогда
		ТекущиеДанные.ЗначениеДо = 0;
		Возврат;
	КонецЕсли;
	
	КоличествоСтрок = Шкала.Количество();
	ИндексСтроки = Шкала.Индекс(ТекущиеДанные);
	
	Если ИндексСтроки = (КоличествоСтрок - 1) Тогда 
		Возврат;
	КонецЕсли;
	
	СледующаяСтрока = Шкала[ИндексСтроки+1];
	СледующаяСтрока.ЗначениеОт = ТекущиеДанные.ЗначениеДо + 1;
	
КонецПроцедуры

&НаКлиенте
Процедура СкорректироватьИнтервалыШкалыВозраста(Шкала)
	
	НижняяГраница = Неопределено;
	КоличествоСтрок = Шкала.Количество();
	
	Для Сч = 1 По КоличествоСтрок Цикл 
		ИндексСтроки = КоличествоСтрок - Сч;
		ТекСтрока = Шкала[ИндексСтроки];
		
		Если НижняяГраница <> Неопределено И НижняяГраница <> ТекСтрока.ЗначениеДо + 1 Тогда 
			ТекСтрока.ЗначениеДо = НижняяГраница - 1;
		КонецЕсли;
		
		Если НижняяГраница = Неопределено И ТекСтрока.ЗначениеОт = ТекСтрока.ЗначениеДо Тогда 
			ТекСтрока.ЗначениеДо = 0;
		КонецЕсли;
		
		Если (ТекСтрока.ЗначениеОт > ТекСтрока.ЗначениеДо И ТекСтрока.ЗначениеДо <> 0) 
			Или (ТекСтрока.ЗначениеОт = ТекСтрока.ЗначениеДо И ТекСтрока.ЗначениеОт <> 0) Тогда
			Шкала.Удалить(ТекСтрока);
			Продолжить;
		КонецЕсли;
		
		НижняяГраница = ТекСтрока.ЗначениеОт;
	КонецЦикла;
	
	// В первой строке может быть нулевое значение До, только если это единственная строка.
	Пока Шкала.Количество() > 1 Цикл 
		Если Шкала[0].ЗначениеДо <> 0 Тогда 
			Прервать;
		КонецЕсли;
		Шкала.Удалить(0);
	КонецЦикла;
	
	СформироватьПредставлениеИнтервалаШкалыВозраста(Шкала);
	
КонецПроцедуры

#КонецОбласти
