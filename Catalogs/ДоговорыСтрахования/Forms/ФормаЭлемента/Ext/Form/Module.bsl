// @strict-types

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьДополнительныеРеквизитыИСведения = ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения");
	СвойстваДоступны = УправлениеСвойствами.СвойстваДоступны();
	
	ИспользуютсяУдержания = ПолучитьФункциональнуюОпцию("ИспользоватьУдержанияВМедицинскомСтрахованииСотрудников");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаНастройкиУдержания", "Видимость", ИспользуютсяУдержания);
	
	ПриПолученииДанныхНаСервере();
	
	Если Не ИспользоватьДополнительныеРеквизитыИСведения Или Не СвойстваДоступны Тогда
		Элементы.ОтправляемыеДополнительныеРеквизитыИСведения.Видимость = Ложь;
	КонецЕсли;
	
	Если ИспользоватьДополнительныеРеквизитыИСведения И СвойстваДоступны Тогда
		Элементы.ПояснениеДополнительныеРеквизитыИСведения.Видимость = ?(СвойстваФизическихЛиц.Количество() > 0, Ложь, Истина);
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	Если ИмяСобытия = "ПрограммыМедицинскогоСтрахованияОбработкаВыбораЗавершение" Тогда
		Если Параметр <> Неопределено Тогда
			Объект.ПрограммыМедицинскогоСтрахования.Очистить();
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицуИзМассива(Объект.ПрограммыМедицинскогоСтрахования, Параметр, "Программа");
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "РасширенияСтрахованияОбработкаВыбораЗавершение" Тогда
		Если Параметр <> Неопределено Тогда
			Объект.РасширенияПрограммМедицинскогоСтрахования.Очистить();
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицуИзМассива(Объект.РасширенияПрограммМедицинскогоСтрахования, Параметр, "РасширениеСтрахования");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ПриПолученииДанныхНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъекта(Объект.Ссылка, ПараметрыЗаписи);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТребуетсяУдержаниеПриИзменении(Элемент)
	
	УстановитьВидимостьНастроекУдержания(ЭтотОбъект, ОбщегоНазначенияКлиент);
	
	Если ЗначениеЗаполнено(Объект.СпособУдержания) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СпособУдержания = ПредопределенноеЗначение("Перечисление.СпособыУдержанияМедицинскогоСтрахованияСотрудников.Ежемесячно");
	
КонецПроцедуры

&НаКлиенте
Процедура СпособУдержанияМедицинскогоСтрахованияПриИзменении(Элемент)
	УстановитьВидимостьНастроекУдержания(ЭтотОбъект, ОбщегоНазначенияКлиент);
КонецПроцедуры

&НаКлиенте
Процедура ПрименяетсяЧастичноеУдержаниеПриИзменении(Элемент)
	УстановитьВидимостьНастроекЧастичногоУдержания(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ИспользуютсяРасширенияПрограммПриИзменении(Элемент)
	
	УстановитьВидимостьРасширенияСтрахования();
	Если Не Объект.ИспользуютсяРасширенияПрограмм Тогда
		Объект.РасширенияПрограммМедицинскогоСтрахования.Очистить();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	Объект.ПрограммыМедицинскогоСтрахования.Очистить();
	Объект.РасширенияПрограммМедицинскогоСтрахования.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыШкалаВозрастаДляСотрудников

&НаКлиенте
Процедура ШкалаВозрастаДляСотрудниковПослеУдаления(Элемент)
	
	ДобавитьСтрокиШкалыВозраста(Объект.ШкалаВозрастаДляСотрудников);
	СкорректироватьИнтервалыШкалыВозраста(Объект.ШкалаВозрастаДляСотрудников);
	
КонецПроцедуры

&НаКлиенте
Процедура ШкалаВозрастаДляСотрудниковПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	УпорядочитьСтрокиШкалыВозраста(Элемент.ТекущиеДанные, Объект.ШкалаВозрастаДляСотрудников);
	СкорректироватьСоседниеСтрокиШкалыВозраста(Элемент.ТекущиеДанные, Объект.ШкалаВозрастаДляСотрудников);
	ДобавитьСтрокиШкалыВозраста(Объект.ШкалаВозрастаДляСотрудников);
	СкорректироватьИнтервалыШкалыВозраста(Объект.ШкалаВозрастаДляСотрудников);
	
КонецПроцедуры

&НаКлиенте
Процедура ШкалаВозрастаДляСотрудниковЗначениеОтПриИзменении(Элемент)
	СформироватьПредставлениеИнтервалаШкалыВозраста(Объект.ШкалаВозрастаДляСотрудников);
КонецПроцедуры

&НаКлиенте
Процедура ШкалаВозрастаДляСотрудниковЗначениеДоПриИзменении(Элемент)
	СформироватьПредставлениеИнтервалаШкалыВозраста(Объект.ШкалаВозрастаДляСотрудников);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыШкалаВозрастаДляРодственников

&НаКлиенте
Процедура ШкалаВозрастаДляРодственниковПослеУдаления(Элемент)
	
	ДобавитьСтрокиШкалыВозраста(Объект.ШкалаВозрастаДляРодственников);
	СкорректироватьИнтервалыШкалыВозраста(Объект.ШкалаВозрастаДляРодственников);
	
КонецПроцедуры

&НаКлиенте
Процедура ШкалаВозрастаДляРодственниковПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	УпорядочитьСтрокиШкалыВозраста(Элемент.ТекущиеДанные, Объект.ШкалаВозрастаДляРодственников);
	СкорректироватьСоседниеСтрокиШкалыВозраста(Элемент.ТекущиеДанные, Объект.ШкалаВозрастаДляРодственников);
	ДобавитьСтрокиШкалыВозраста(Объект.ШкалаВозрастаДляРодственников);
	СкорректироватьИнтервалыШкалыВозраста(Объект.ШкалаВозрастаДляРодственников);
	
КонецПроцедуры

&НаКлиенте
Процедура ШкалаВозрастаДляРодственниковЗначениеОтПриИзменении(Элемент)
	СформироватьПредставлениеИнтервалаШкалыВозраста(Объект.ШкалаВозрастаДляРодственников);
КонецПроцедуры

&НаКлиенте
Процедура ШкалаВозрастаДляРодственниковЗначениеДоПриИзменении(Элемент)
	СформироватьПредставлениеИнтервалаШкалыВозраста(Объект.ШкалаВозрастаДляРодственников);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГрафикУдержаний

&НаКлиенте
Процедура ГрафикУдержанийМесяцУдержанияСтрокойПриИзменении(Элемент)
	
	ЗарплатаКадрыКлиент.ВводМесяцаПриИзменении(ЭтотОбъект,
		"Элементы.ГрафикУдержаний.ТекущиеДанные.МесяцУдержания", "Элементы.ГрафикУдержаний.ТекущиеДанные.МесяцУдержанияСтрокой");
	
	Объект.ГрафикУдержаний.Сортировать("МесяцУдержания");
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикУдержанийМесяцУдержанияСтрокойАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ЗарплатаКадрыКлиент.ВводМесяцаАвтоПодборТекста(Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ГрафикУдержанийМесяцУдержанияСтрокойНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ВводМесяцаУдержанияНачалоВыбораЗавершение", ЭтотОбъект);
	
	//@skip-check invocation-parameter-type-intersect
	ОткрытьФорму("ОбщаяФорма.ВыборПериода", 
		Новый Структура("Значение,РежимВыбораПериода,ЗапрашиватьРежимВыбораПериодаУВладельца", Неопределено, "Месяц", Ложь),
		ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикУдержанийМесяцУдержанияСтрокойОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ЗарплатаКадрыКлиент.ВводМесяцаОкончаниеВводаТекста(Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ГрафикУдержанийМесяцУдержанияСтрокойРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	ЗарплатаКадрыКлиент.ВводМесяцаРегулирование(ЭтотОбъект, "Элементы.ГрафикУдержаний.ТекущиеДанные.МесяцУдержания", "Элементы.ГрафикУдержаний.ТекущиеДанные.МесяцУдержанияСтрокой", Направление);
	Объект.ГрафикУдержаний.Сортировать("МесяцУдержания");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтправляемыеДанные

&НаКлиенте
Процедура ОтправляемыеДанныеСпособПроверкиЗаполненияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОтправляемыеДанные.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьСпособПроверкиЗаполнения(ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтправляемаяКонтактнаяИнформация

&НаКлиенте
Процедура ОтправляемаяКонтактнаяИнформацияСпособПроверкиЗаполненияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОтправляемаяКонтактнаяИнформация.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьСпособПроверкиЗаполнения(ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтправляемыеДополнительныеРеквизитыИСведения

&НаКлиенте
Процедура ОтправляемыеДополнительныеРеквизитыИСведенияСпособПроверкиЗаполненияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОтправляемыеДополнительныеРеквизитыИСведения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьСпособПроверкиЗаполнения(ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.Свойства
// 
// Параметры:
//  ЭлементИлиКоманда	- ПолеФормы
//  					- КомандаФормы
//  НавигационнаяСсылка - Неопределено - Навигационная ссылка
//  СтандартнаяОбработка - Булево - Стандартная обработка
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры
// Конец СтандартныеПодсистемы.Свойства

&НаКлиенте
Процедура ПодборПрограммМедицинскогоСтрахования(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("СтраховаяКомпания", Объект.Владелец);
	ПараметрыФормы.Вставить("АдресСпискаПодобранных", АдресСпискаПодобранныхПрограмм());
	
	ОткрытьФорму("Справочник.ПрограммыМедицинскогоСтрахования.Форма.ФормаВыбора",
		ПараметрыФормы, Элементы.ПрограммыМедицинскогоСтрахования);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПодборРасширенийМедицинскогоСтрахования(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("СтраховаяКомпания", Объект.Владелец);
	ПараметрыФормы.Вставить("АдресСпискаПодобранных", АдресСпискаПодобранныхРасширений());
	
	ОткрытьФорму("Справочник.РасширенияПрограммМедицинскогоСтрахования.Форма.ФормаВыбора",
		ПараметрыФормы, Элементы.РасширенияПрограммМедицинскогоСтрахования);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьРасширенияСтрахования()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаРасширенияСтрахования", "Видимость", Объект.ИспользуютсяРасширенияПрограмм); 
		
КонецПроцедуры

// Возвращает адрес во временном хранилище массива уже подобранных программ.
&НаСервере
Функция АдресСпискаПодобранныхПрограмм()
	
	Программы = Объект.ПрограммыМедицинскогоСтрахования.Выгрузить(, "Программа").ВыгрузитьКолонку("Программа");
	
	Возврат ПоместитьВоВременноеХранилище(Программы, УникальныйИдентификатор);
	
КонецФункции

// Возвращает адрес во временном хранилище массива уже подобранных расширений программ.
&НаСервере
Функция АдресСпискаПодобранныхРасширений()
	
	Расширения = Объект.РасширенияПрограммМедицинскогоСтрахования.Выгрузить(, "РасширениеСтрахования").ВыгрузитьКолонку("РасширениеСтрахования");
	
	Возврат ПоместитьВоВременноеХранилище(Расширения, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ПриПолученииДанныхНаСервере()
	
	ЗаполнитьОтправляемыеДанные();
	ЗаполнитьОтправляемуюКонтактнуюИнформацию();
	ЗаполнитьОтправляемыеДополнительныеРеквизитыИСведения();
	
	ДобавитьСтрокиШкалыВозраста(Объект.ШкалаВозрастаДляСотрудников);
	ДобавитьСтрокиШкалыВозраста(Объект.ШкалаВозрастаДляРодственников);
	СформироватьПредставлениеИнтервалаШкалыВозраста(Объект.ШкалаВозрастаДляСотрудников);
	СформироватьПредставлениеИнтервалаШкалыВозраста(Объект.ШкалаВозрастаДляРодственников);
	
	УстановитьВидимостьНастроекУдержания(ЭтотОбъект, ОбщегоНазначения);
	
	УстановитьВидимостьРасширенияСтрахования();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтправляемыеДанные()
	
	Для Каждого Сведение Из Перечисления.ДанныеЗастрахованных Цикл
		ПараметрыОтбора = Новый Структура("Сведение", Сведение);
		НайденныеСведения = Объект.ОтправляемыеДанные.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСведения.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Объект.ОтправляемыеДанные.Добавить();
		НоваяСтрока.Сведение = Сведение;
		НоваяСтрока.Отправлять = Истина;
		НоваяСтрока.СпособПроверкиЗаполнения = Перечисления.СпособыПроверкиЗаполненияПерсональныхДанныхМедицинскогоСтрахования.НеПроверять;
	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьОтправляемуюКонтактнуюИнформацию()
	
	ТаблицаВидовКИ = УправлениеКонтактнойИнформацией.ВидыКонтактнойИнформацииОбъекта(
		Справочники.ФизическиеЛица.ПустаяСсылка());//@skip-check invocation-parameter-type-intersect
	ВидыКонтактнойИнформацииФизическихЛиц.ЗагрузитьЗначения(ТаблицаВидовКИ.ВыгрузитьКолонку("Ссылка"));
	
	Для Каждого ВидКИ Из ВидыКонтактнойИнформацииФизическихЛиц Цикл
		ЗначениеВидаКИ = ВидКИ.Значение; // СправочникСсылка.ВидыКонтактнойИнформации
		ПараметрыОтбора = Новый Структура("ВидКонтактнойИнформации", ЗначениеВидаКИ);
		НайденныеСведения = Объект.ОтправляемаяКонтактнаяИнформация.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСведения.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Объект.ОтправляемаяКонтактнаяИнформация.Добавить();
		НоваяСтрока.ВидКонтактнойИнформации = ЗначениеВидаКИ;
		НоваяСтрока.Отправлять = Ложь;
		НоваяСтрока.СпособПроверкиЗаполнения =
			Перечисления.СпособыПроверкиЗаполненияПерсональныхДанныхМедицинскогоСтрахования.НеПроверять;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтправляемыеДополнительныеРеквизитыИСведения()
	
	Если Не ИспользоватьДополнительныеРеквизитыИСведения Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СвойстваДоступны Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваФизическихЛиц.ЗагрузитьЗначения(
		УправлениеСвойствами.СвойстваОбъекта(Справочники.ФизическиеЛица.ПустаяСсылка()));
	
	Для Каждого Свойство Из СвойстваФизическихЛиц Цикл
		ЗначениеСвойства = Свойство.Значение; // ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения
		ПараметрыОтбора = Новый Структура("Сведение", ЗначениеСвойства);
		НайденныеСведения = Объект.ОтправляемыеДополнительныеРеквизитыИСведения.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСведения.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Объект.ОтправляемыеДополнительныеРеквизитыИСведения.Добавить();
		НоваяСтрока.Сведение = ЗначениеСвойства;
		НоваяСтрока.Отправлять = Ложь;
		НоваяСтрока.СпособПроверкиЗаполнения =
			Перечисления.СпособыПроверкиЗаполненияПерсональныхДанныхМедицинскогоСтрахования.НеПроверять;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементОформления.Отбор, "Объект.ШкалаВозрастаДляСотрудников.ЗначениеОт", , ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"Текст", Новый ПолеКомпоновкиДанных("Объект.ШкалаВозрастаДляСотрудников.ПредставлениеОт"));
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ШкалаВозрастаДляСотрудниковЗначениеОт");
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементОформления.Отбор, "Объект.ШкалаВозрастаДляСотрудников.ЗначениеДо", , ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"Текст", Новый ПолеКомпоновкиДанных("Объект.ШкалаВозрастаДляСотрудников.ПредставлениеДо"));
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ШкалаВозрастаДляСотрудниковЗначениеДо");
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементОформления.Отбор, "Объект.ШкалаВозрастаДляРодственников.ЗначениеОт", , ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"Текст", Новый ПолеКомпоновкиДанных("Объект.ШкалаВозрастаДляРодственников.ПредставлениеОт"));
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ШкалаВозрастаДляРодственниковЗначениеОт");
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементОформления.Отбор, "Объект.ШкалаВозрастаДляРодственников.ЗначениеДо", , ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"Текст", Новый ПолеКомпоновкиДанных("Объект.ШкалаВозрастаДляРодственников.ПредставлениеДо"));
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ШкалаВозрастаДляРодственниковЗначениеДо");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьНастроекУдержания(Форма, МодульОбщегоНазначения)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Если Не Форма.ИспользуютсяУдержания Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СпособУдержанияМедицинскогоСтрахования.Видимость = Объект.ТребуетсяУдержание;
	Элементы.Удержание.Видимость = Объект.ТребуетсяУдержание;
	Элементы.ГруппаУдерживатьПоУмолчанию.Видимость = Объект.ТребуетсяУдержание;
	Элементы.ПрименяетсяЧастичноеУдержание.Видимость = Объект.ТребуетсяУдержание;
	Элементы.ПроцентЧастичногоУдержания.Видимость = Объект.ТребуетсяУдержание;
	Элементы.ГруппаГрафикУдержаний.Видимость = Объект.ТребуетсяУдержание И Объект.СпособУдержания =
		МодульОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.СпособыУдержанияМедицинскогоСтрахованияСотрудников.ПоГрафику");
	УстановитьВидимостьНастроекЧастичногоУдержания(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьНастроекЧастичногоУдержания(Форма)
	
	Форма.Элементы.ПроцентЧастичногоУдержания.Доступность =
		Форма.Объект.ПрименяетсяЧастичноеУдержание И Форма.Объект.ТребуетсяУдержание;
	
КонецПроцедуры

// Обработать способ проверки заполнения.
// 
// Параметры:
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции:
//	 * СпособПроверкиЗаполнения - ПеречислениеСсылка.СпособыПроверкиЗаполненияПерсональныхДанныхМедицинскогоСтрахования
&НаКлиенте
Процедура ОбработатьСпособПроверкиЗаполнения(ТекущиеДанные)
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СпособПроверкиЗаполнения) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.СпособПроверкиЗаполнения = 
		ПредопределенноеЗначение("Перечисление.СпособыПроверкиЗаполненияПерсональныхДанныхМедицинскогоСтрахования.НеПроверять");
	
КонецПроцедуры

// Ввод месяца удержания начало выбора завершение.
// 
// Параметры:
//  ВыбранноеЗначение	- Дата
//  					- Неопределено
//  ДополнительныеПараметры - Структура
&НаКлиенте
Процедура ВводМесяцаУдержанияНачалоВыбораЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ГрафикУдержаний.ТекущаяСтрока; // Число
	СтрокаГрафика = Объект.ГрафикУдержаний.НайтиПоИдентификатору(ТекущаяСтрока);
	СтрокаГрафика.МесяцУдержания = ВыбранноеЗначение;
	СтрокаГрафика.МесяцУдержанияСтрокой = Формат(ВыбранноеЗначение, НСтр("ru='ДФ=''ММММ гггг'''"));
	
	Объект.ГрафикУдержаний.Сортировать("МесяцУдержания");
	
КонецПроцедуры

