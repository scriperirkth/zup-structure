// Процедура выполняет первоначальное заполнение классификатора.
// 
// Параметры:
//  ВидыНоменклатуры - Массив Из СправочникСсылка.ВидыНоменклатуры
Процедура НачальноеЗаполнение(ВидыНоменклатуры) Экспорт
	
	ЗначенияВидовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ВидыНоменклатуры, "ТипНоменклатуры, ИспользованиеХарактеристик");
	ЗначенияРеквизитовСИЗ = Новый Соответствие;
	Для каждого ЗначенияВида Из ЗначенияВидовНоменклатуры Цикл
		РеквизитыСИЗ = НовыйРеквизитыСИЗ();
		РеквизитыСИЗ.ВидНоменклатуры = ЗначенияВида.Ключ;
		РеквизитыСИЗ.ИспользованиеХарактеристик = ЗначенияВида.Значение.ИспользованиеХарактеристик;
		ЗначенияРеквизитовСИЗ.Вставить(ЗначенияВида.Значение.ТипНоменклатуры, РеквизитыСИЗ);
	КонецЦикла;
	
	ЗаполнитьИзМакета(ЗначенияРеквизитовСИЗ);
	
КонецПроцедуры

Процедура ЗаполнитьИзМакета(ЗначенияРеквизитовСИЗ)
	
	НачатьТранзакцию();
	
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.СредстваИндивидуальнойЗащиты");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.ВидыНоменклатуры");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
	
		Запрос = Новый Запрос;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СредстваИндивидуальнойЗащиты.Ссылка,
		|	СредстваИндивидуальнойЗащиты.Наименование
		|ИЗ
		|	Справочник.СредстваИндивидуальнойЗащиты КАК СредстваИндивидуальнойЗащиты";
			
		ТаблицаСуществующихСИЗ = Запрос.Выполнить().Выгрузить();
		
		ЕстьЭлементы = Не ТаблицаСуществующихСИЗ.Количество() = 0;
		
		ТекстовыйДокумент = ПолучитьМакет("КлассификаторНоменклатураЕТН");
		ТаблицаКлассификатора = ОбщегоНазначения.ПрочитатьXMLВТаблицу(ТекстовыйДокумент.ПолучитьТекст()).Данные;
		КодыОКЕИ = Новый Соответствие;
		
		Для каждого СтрокаКлассификатора Из ТаблицаКлассификатора Цикл
			Наименование = СтрокаКлассификатора["Name"]; //Строка
			НаименованиеПолное = СтрокаКлассификатора["FullName"]; //Строка
			КоличествоПоУмолчанию = СтрокаКлассификатора["Norm"]; //Строка
			КратностьВыдачи = СтрокаКлассификатора["FrequencyMultiplicity"]; //Строка
			ПериодичностьВыдачи = СтрокаКлассификатора["FrequencyRate"]; //Строка
			ЕдиницаПериодичностиВыдачи = СтрокаКлассификатора["FrequencyPeriod"]; //Строка
			КодОКЕИ = СтрокаКлассификатора["Unit"]; //Строка
			
			Если ЕстьЭлементы И ТаблицаСуществующихСИЗ.Найти(Наименование, "Наименование") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СправочникОбъект = СоздатьЭлемент();
			СправочникОбъект.Наименование = Наименование;
			СправочникОбъект.НаименованиеПолное = НаименованиеПолное;
			СправочникОбъект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры[СтрокаКлассификатора["Type"]];
			
			РеквизитыСИЗ = ЗначенияРеквизитовСИЗ.Получить(СправочникОбъект.ТипНоменклатуры); //см. НовыйРеквизитыСИЗ()
			Если РеквизитыСИЗ = Неопределено Тогда
				МассивВидов = Новый Массив;
				Справочники.ВидыНоменклатуры.ДобавитьПредустановленныйВидНоменклатуры(МассивВидов,
					СправочникОбъект.ТипНоменклатуры, Строка(СправочникОбъект.ТипНоменклатуры));
				ВидНоменклатуры = МассивВидов[0]; //СправочникСсылка.ВидыНоменклатуры
				РеквизитыСИЗ = НовыйРеквизитыСИЗ();
				РеквизитыСИЗ.ВидНоменклатуры = ВидНоменклатуры;
				РеквизитыСИЗ.ИспользованиеХарактеристик =
					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ИспользованиеХарактеристик");
				ЗначенияРеквизитовСИЗ.Вставить(СправочникОбъект.ТипНоменклатуры, РеквизитыСИЗ);
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СправочникОбъект, РеквизитыСИЗ);
			
			Если Не ПустаяСтрока(КоличествоПоУмолчанию) Тогда
				СправочникОбъект.КоличествоПоУмолчанию = Число(КоличествоПоУмолчанию);
			КонецЕсли;
			
			ЕдиницаИзмерения = КодыОКЕИ.Получить(КодОКЕИ); //СправочникСсылка.КлассификаторЕдиницИзмерения
			Если ЕдиницаИзмерения = Неопределено Тогда
				СправочникОбъект.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ЕдиницаИзмеренияПоКоду(КодОКЕИ);
				КодыОКЕИ.Вставить(КодОКЕИ, СправочникОбъект.ЕдиницаИзмерения);
			Иначе
				СправочникОбъект.ЕдиницаИзмерения = ЕдиницаИзмерения;
			КонецЕсли;
			
			Если Не ПустаяСтрока(ЕдиницаПериодичностиВыдачи) Тогда
				СправочникОбъект.КратностьВыдачи = Число(КратностьВыдачи);
				СправочникОбъект.ПериодичностьВыдачи = Число(ПериодичностьВыдачи);
				СправочникОбъект.ЕдиницаПериодичностиВыдачи = Перечисления.Периодичность[ЕдиницаПериодичностиВыдачи];
				СправочникОбъект.СпособВыдачи = Перечисления.СпособыВыдачиСИЗ.СПериодичностью;
			Иначе
				СправочникОбъект.СпособВыдачи = Перечисления.СпособыВыдачиСИЗ.ДоИзноса;
			КонецЕсли;
			СоздатьОбновитьДополнительныеРеквизиты(СтрокаКлассификатора, СправочникОбъект);
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		КонецЦикла;
		
		Для Каждого РеквизитыСИЗ Из ЗначенияРеквизитовСИЗ Цикл
			ВидНоменклатурыОбъект = РеквизитыСИЗ.Значение.ВидНоменклатуры.ПолучитьОбъект();
			ВидНоменклатурыОбъект.РеквизитыДляКонтроляНоменклатуры.Очистить();
			ВидНоменклатурыОбъект.РеквизитыБыстрогоОтбораНоменклатуры.Очистить();
			Справочники.ВидыНоменклатуры.ЗаполнитьДопРеквизитыДляКонтроляИОтбора(ВидНоменклатурыОбъект, "Номенклатура");
			Для Каждого Реквизит Из ВидНоменклатурыОбъект.РеквизитыДляКонтроляНоменклатуры Цикл
				Если Не Реквизит.ЭтоДопРеквизит Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока = ВидНоменклатурыОбъект.РеквизитыБыстрогоОтбораНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Реквизит);
				НоваяСтрока.Используется = Истина;
			КонецЦикла;
			ВидНоменклатурыОбъект.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ПредставлениеОбработки = НСтр("ru = 'Заполнение средств индивидуальной защиты из классификатора'"); 
		ИмяСобытия = НСтр("ru = 'Средства индивидуальной защиты'", ОбщегоНазначения.КодОсновногоЯзыка());
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка при обработке средств индивидуальной защиты. Обратитесь к администратору.
					|Техническая информация:
					|При выполнении операции «%1» возникает
					|%2'"), 
			ПредставлениеОбработки,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция НовыйРеквизитыСИЗ()
	
	РеквизитыСИЗ = Новый Структура;
	РеквизитыСИЗ.Вставить("ВидНоменклатуры", Справочники.ВидыНоменклатуры.ПустаяСсылка());
	РеквизитыСИЗ.Вставить("ИспользованиеХарактеристик", Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ПустаяСсылка());
	
	Возврат РеквизитыСИЗ;
	
КонецФункции

Процедура СоздатьОбновитьДополнительныеРеквизиты(СтрокаКлассификатора, СправочникОбъект)
	
	ВидНоменклатуры = СправочникОбъект.ВидНоменклатуры;
	
	Если СтрокаКлассификатора["MoltenMetal"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от выплесков расплавленного металла'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от выплесков расплавленного металла'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["Sparks"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от искр и брызг расплавленного металла, металлической окалины'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от искр и брызг расплавленного металла, металлической окалины'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["ConvectiveHeat"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от конвективной теплоты'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от конвективной теплоты'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["ThermalRadiation"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от теплового излучения'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от теплового излучения'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["Abrasion"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (истирания)'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (истирания)'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["Cuts"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (порезов)'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (порезов)'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["Punctures"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (проколов)'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (проколов)'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["ParticulateImpact"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (ударов твердых частиц)'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (ударов твердых частиц)'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["Blows"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (ударов)'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от механических воздействий (ударов)'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["OpenAlame"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от кратковременного воздействия открытого пламени'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от кратковременного воздействия открытого пламени'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["GeneralIndustrialPollution"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от общих производственных загрязнений'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от общих производственных загрязнений'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["HotSurfaceContact"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от контакта с нагретой поверхностью'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от контакта с нагретой поверхностью'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["ColdSurfaceContact"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от контакта с охлажденной поверхностью'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от контакта с охлажденной поверхностью'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["AcidSolutions"] = "True" Тогда
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от растворов кислот'"));
		СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, НСтр("ru = 'Защита от растворов кислот'"),
			"НаборСвойствСИЗ", "Справочник_СредстваИндивидуальнойЗащиты", СправочникОбъект);
	КонецЕсли;
	Если СтрокаКлассификатора["AlkaliSolutions"] = "True" Тогда
