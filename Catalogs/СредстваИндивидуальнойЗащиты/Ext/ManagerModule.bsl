#КонецОбласти

// Таблица использования СИЗВРабочих местах.
// 
// Параметры:
//  СИЗ - Массив Из СправочникСсылка.СредстваИндивидуальнойЗащиты
//  ПараметрыСписка - Структура:
//   *Организация - СправочникСсылка.Организации
//   *Подразделение - СправочникСсылка.ПодразделенияОрганизаций
//   *ДатаАктуальности - Дата
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаИспользованияСИЗВРабочихМестах
// 
Функция ТаблицаИспользованияСИЗВРабочихМестах(СИЗ, ПараметрыСписка) Экспорт
	
	ТаблицаИнформационныхСтрок = НоваяТаблицаИспользованияСИЗВРабочихМестах();
	
	Для Каждого ЭлементСИЗ Из СИЗ Цикл
		НоваяСтрока = ТаблицаИнформационныхСтрок.Добавить();
		НоваяСтрока.СИЗ = ЭлементСИЗ;
	КонецЦикла;
	
	ЗаполнитьСведенияИспользованияСИЗВРабочихМестах(ТаблицаИнформационныхСтрок, СИЗ, ПараметрыСписка);
	
	Возврат ТаблицаИнформационныхСтрок;
	
КонецФункции

// Новая таблица использования СИЗ в рабочих местах.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Новая таблица использования СИЗВРабочих местах:
// * СИЗ - СправочникСсылка.СредстваИндивидуальнойЗащиты
// * РабочиеМестаСИЗ - Массив Из СправочникСсылка.РабочиеМестаОхраныТруда
// * КоличествоРабочихМест - Число
// * СотрудникиСИЗ - Массив Из Структура:
//   ** Сотрудник - СправочникСсылка.ФизическиеЛица
//   ** СИЗ - СправочникСсылка.СредстваИндивидуальнойЗащиты
//   ** РабочееМесто - СправочникСсылка.РабочиеМестаОхраныТруда
//   ** ДатаСледующейВыдачи - Дата
//   ** ПериодичностьМесяц - Булево
//   ** Требуется - Булево
//   ** ДоступноДляПодбора - Булево
//   ** Пометка - Булево
//   ** Выдано - Булево
// * КоличествоСотрудников - Число
// * КоличествоВыданныхСотрудникам - Число
// * ИнформационнаяСтрокаОСостоянииВыдачи - ФорматированнаяСтрока
// * Требуется - Булево
Функция НоваяТаблицаИспользованияСИЗВРабочихМестах()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СИЗ", Новый ОписаниеТипов("СправочникСсылка.СредстваИндивидуальнойЗащиты"));
	Таблица.Колонки.Добавить("РабочиеМестаСИЗ", Новый ОписаниеТипов("Массив"));
	Таблица.Колонки.Добавить("КоличествоРабочихМест", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("СотрудникиСИЗ", Новый ОписаниеТипов("Массив"));
	Таблица.Колонки.Добавить("КоличествоСотрудников", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("КоличествоВыданныхСотрудникам", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ИнформационнаяСтрокаОСостоянииВыдачи", Новый ОписаниеТипов("ФорматированнаяСтрока"));
	Таблица.Колонки.Добавить("Требуется", Новый ОписаниеТипов("Булево"));
	
	Возврат Таблица;
	
КонецФункции

// Заполняет сведения использования СИЗ в рабочих местах.
// 
// Параметры:
//  ДанныеСИЗ - см. НоваяТаблицаИспользованияСИЗВРабочихМестах
//  СИЗ - Массив Из СправочникСсылка.СредстваИндивидуальнойЗащиты
//  ПараметрыСписка - Структура:
//   *Организация - СправочникСсылка.Организации
//   *Подразделение - СправочникСсылка.ПодразделенияОрганизаций
//   *ДатаАктуальности - Дата
Процедура ЗаполнитьСведенияИспользованияСИЗВРабочихМестах(ДанныеСИЗ, СИЗ, ПараметрыСписка)
	
	Если ДанныеСИЗ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеРабочихМест = Новый ТаблицаЗначений;
	НормыВыдачиСИЗФизическихЛиц = СредстваИндивидуальнойЗащиты.НормыВыдачиСИЗФизическихЛиц(ПараметрыСписка, СИЗ, ДанныеРабочихМест);
	
	ДанныеРабочихМест.Индексы.Добавить("СИЗ");
	
	ОтборСтрок = Новый Структура("СИЗ", ПустаяСсылка());
	Для Каждого СтрокаДанныхСИЗ Из ДанныеСИЗ Цикл
		ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаДанныхСИЗ);
		ДанныеРабочихМестПоСИЗ = ДанныеРабочихМест.НайтиСтроки(ОтборСтрок);
		СтрокаДанныхСИЗ.КоличествоРабочихМест = ДанныеРабочихМестПоСИЗ.Количество();
		Для Каждого СтрокаРабочегоМеста Из ДанныеРабочихМестПоСИЗ Цикл
			РабочееМесто = СтрокаРабочегоМеста.РабочееМесто; // СправочникСсылка.РабочиеМестаОхраныТруда
			СтрокаДанныхСИЗ.РабочиеМестаСИЗ.Добавить(РабочееМесто);
		КонецЦикла;
		ДанныеСотрудников = НормыВыдачиСИЗФизическихЛиц.НайтиСтроки(ОтборСтрок);
		СтрокаДанныхСИЗ.КоличествоСотрудников = ДанныеСотрудников.Количество();
		Для Каждого СтрокаСотрудника Из ДанныеСотрудников Цикл
			Если СтрокаСотрудника.Выдано Тогда
				СтрокаДанныхСИЗ.КоличествоВыданныхСотрудникам = СтрокаДанныхСИЗ.КоличествоВыданныхСотрудникам + 1;
			КонецЕсли;
			СтрокаДанныхСИЗ.СотрудникиСИЗ.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаСотрудника));
		КонецЦикла;
		ЗаполнитьИнформационнуюСтрокуОСостоянииВыдачи(СтрокаДанныхСИЗ);
	КонецЦикла;
	
КонецПроцедуры

// Информационная строка о состоянии выдачи по СИЗ.
// 
// Параметры:
//  СИЗ - Массив Из СправочникСсылка.СредстваИндивидуальнойЗащиты
//  ПараметрыСписка - Структура:
//   *Организация - СправочникСсылка.Организации
//   *Подразделение - СправочникСсылка.ПодразделенияОрганизаций
//   *ДатаАктуальности - Дата
// 
// Возвращаемое значение:
//  Неопределено, Структура - Информационная строка о состоянии выдачи по СИЗ
Функция ИнформационнаяСтрокаОСостоянииВыдачиПоСИЗ(СИЗ, ПараметрыСписка) Экспорт

	ТаблицаИнформационныхСтрок = ТаблицаИспользованияСИЗВРабочихМестах(СИЗ, ПараметрыСписка);
	Если ТаблицаИнформационныхСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаИнформационныхСтрок[0]);
	
КонецФункции

Процедура ЗаполнитьИнформационнуюСтрокуОСостоянииВыдачи(СтрокаТаблицы)
	
	НеВыданоСотрудникам = СтрокаТаблицы.КоличествоСотрудников - СтрокаТаблицы.КоличествоВыданныхСотрудникам;
	
	Если СтрокаТаблицы.КоличествоСотрудников > 0 Тогда
		ТекстНеВыданоСотрудникам = ТекстНадписи(
			НСтр("ru = ';Требуется выдать %1 сотруднику;;Требуется выдать %1 сотрудникам;Требуется выдать %1 сотрудникам;Требуется выдать %1 сотрудникам'"), 
			НСтр("ru = 'Выдача не требуется'"), 
			НеВыданоСотрудникам);
		
		СотрудникиОжидаютВыдачи = Новый Массив; // Массив Из СправочникСсылка.ФизическиеЛица
		СотрудникиВыдано = Новый Массив; // Массив Из СправочникСсылка.ФизическиеЛица
		
		Для Каждого СтрокаСотрудник Из СтрокаТаблицы.СотрудникиСИЗ Цикл
			Если СтрокаСотрудник.ДоступноДляПодбора Тогда
				СотрудникиОжидаютВыдачи.Добавить(СтрокаСотрудник.Сотрудник);
			Иначе
				СотрудникиВыдано.Добавить(СтрокаСотрудник.Сотрудник);
			КонецЕсли;
		КонецЦикла;
		
		ИменаНавигационныхСсылок = СредстваИндивидуальнойЗащитыКлиентСервер.ИменаНавигационныхСсылокСостоянийВыдачиСотрудникам();
		
		ТекстПоСотрудникамОжидаютВыдачи = ТекстПоСотрудникам(СотрудникиОжидаютВыдачи, ИменаНавигационныхСсылок.ОжидаютВыдачи);
		
		ТекстВыданоСотрудникам = ТекстНадписи(
			НСтр("ru = ';ранее выдано %1 сотруднику;;ранее выдано %1 сотрудникам;ранее выдано %1 сотрудникам;ранее выдано %1 сотрудникам'"), 
			НСтр("ru = 'ранее не выдавалось или срок носки истек'"), 
			СтрокаТаблицы.КоличествоВыданныхСотрудникам);
		
		ТекстПоСотрудникамВыдано = ТекстПоСотрудникам(СотрудникиВыдано, ИменаНавигационныхСсылок.Выдано);
		Если ПустаяСтрока(ТекстПоСотрудникамВыдано) Тогда
			ИнформационнаяСтрокаОСостоянииВыдачи = СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru='<span style=""font:ВажнаяНадписьШрифт"">%1</span>%2, %3.'"),
				ТекстНеВыданоСотрудникам, ТекстПоСотрудникамОжидаютВыдачи, ТекстВыданоСотрудникам);
		ИначеЕсли ПустаяСтрока(ТекстПоСотрудникамОжидаютВыдачи) Тогда
			ИнформационнаяСтрокаОСостоянииВыдачи = СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru='<span style=""font:ВажнаяНадписьШрифт"">%1</span>, %2%3.'"),
				ТекстНеВыданоСотрудникам, ТекстВыданоСотрудникам, ТекстПоСотрудникамВыдано);
		Иначе
			ИнформационнаяСтрокаОСостоянииВыдачи = СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru='<span style=""font:ВажнаяНадписьШрифт"">%1</span>%2, %3%4.'"),
				ТекстНеВыданоСотрудникам, ТекстПоСотрудникамОжидаютВыдачи, ТекстВыданоСотрудникам, ТекстПоСотрудникамВыдано);
		КонецЕсли;
	Иначе
		ИнформационнаяСтрокаОСостоянииВыдачи = СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru='<span style=""font:ВажнаяНадписьШрифт"">Отсутствует в нормах сотрудников.</span>'"));
	КонецЕсли;
	
	СтрокаТаблицы.ИнформационнаяСтрокаОСостоянииВыдачи = ИнформационнаяСтрокаОСостоянииВыдачи;
	
КонецПроцедуры

// Текст по сотрудникам.
// 
// Параметры:
//  Сотрудники - Массив Из СправочникСсылка.ФизическиеЛица - Сотрудники
//  ИмяНавигационнойСсылки - Строка
Функция ТекстПоСотрудникам(Сотрудники, ИмяНавигационнойСсылки)
	
	КоличествоСотрудников = Сотрудники.Количество();
	Если КоличествоСотрудников = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстПоСотрудникам = "";
	СотрудниковВключено = 0;
	Для Каждого Сотрудник Из Сотрудники Цикл
		Если СотрудниковВключено = 3 Тогда
			Прервать;
		КонецЕсли;
		ФамилияИнициалы = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Строка(Сотрудник));
		Если СотрудниковВключено > 0 Тогда
			Шаблон = НСтр("ru = '%1, <a href=""%2"">%3</a>'");
			ТекстПоСотрудникам = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				Шаблон, ТекстПоСотрудникам, ПолучитьНавигационнуюСсылку(Сотрудник), ФамилияИнициалы);
		Иначе
			Шаблон = НСтр("ru = '<a href=""%1"">%2</a>'");
			ТекстПоСотрудникам = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				Шаблон, ПолучитьНавигационнуюСсылку(Сотрудник), ФамилияИнициалы);
		КонецЕсли;
		СотрудниковВключено = СотрудниковВключено + 1;
	КонецЦикла;
	
	ЕщеОсталось = КоличествоСотрудников - СотрудниковВключено;
	Если ЕщеОсталось > 0 Тогда
		ТекстПоСотрудникам = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 и <a href=""%2"">еще %3</a>'"), ТекстПоСотрудникам, ИмяНавигационнойСсылки, Строка(ЕщеОсталось));
	КонецЕсли;
	
	Возврат ТекстПоСотрудникам;
	
КонецФункции

// Текст надписи.
// 
// Параметры:
//  Шаблон - Строка
//  ШаблонДляНуля - Строка
//  Число - Число
// 
// Возвращаемое значение:
//  Строка - Текст надписи
Функция ТекстНадписи(Шаблон, ШаблонДляНуля, Число)
	
	Если Число = 0 Тогда
		Возврат ШаблонДляНуля;
	КонецЕсли;
	
	Возврат СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(Шаблон, Число);
	
КонецФункции

#КонецОбласти

#КонецЕсли
