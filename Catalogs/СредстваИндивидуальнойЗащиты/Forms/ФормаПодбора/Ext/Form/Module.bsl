#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.РежимВыбора Тогда
		Элементы.Список.РежимВыбора = Истина;
	КонецЕсли;
	
	Если Параметры.МножественныйВыбор = Истина Тогда
		Элементы.Список.МножественныйВыбор = Истина;
		Элементы.Список.РежимВыделения = РежимВыделенияТаблицы.Множественный;
		ЗакрыватьПриВыборе = Ложь;
	Иначе
		Элементы.Список.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
	КонецЕсли;
	
	Подобранные.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресПодобранныхСИЗ));
	ЗаполнитьДополнительныеДанныеВПодобранных();
	
	ТипНоменклатуры = СвойствоСтруктуры(Параметры, "ТипНоменклатуры");
	Если ЗначениеЗаполнено(ТипНоменклатуры) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ТипНоменклатуры", ТипНоменклатуры);
	КонецЕсли;
	
	Организация = СвойствоСтруктуры(Параметры, "Организация");
	Если ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Организация", Организация);
	КонецЕсли;
	
	Подразделение = СвойствоСтруктуры(Параметры, "Подразделение");
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Подразделение", Подразделение);
	КонецЕсли;
	
	ДатаАктуальности = СвойствоСтруктуры(Параметры, "ДатаАктуальности");
	Если ЗначениеЗаполнено(ДатаАктуальности) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаАктуальности", ДатаАктуальности);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.КоманднаяПанельФормы;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЗарплатаКадры.ПриСозданииНаСервереФормыСДинамическимСписком(ЭтотОбъект, "Список");
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	ОбработкаНавигационнойСсылкиСотрудниковСИЗ(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Элементы.Список.РежимВыбора Или Не Элементы.Список.МножественныйВыбор Тогда
		Возврат;
	КонецЕсли;
	
	Если Подобранные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	НачатьВопросОВыбореПодобранных();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	Если Не Элементы.Список.РежимВыбора Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Элементы.Список.МножественныйВыбор Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Если Значение.Количество() > 1 Или Подобранные.Количество() = 0 Тогда
		ОбновитьПодобранные(Значение, Ложь);
	КонецЕсли;
	
	ОповеститьОВыборе(ПодобранныеПоСотрудникам());
	Подобранные.Очистить();
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПодключитьОбработчикОжидания("ПриАктивизацииСтрокиНаКлиенте", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не Элементы.Список.РежимВыбора Тогда
		Возврат;
	КонецЕсли;

	Если Не Элементы.Список.МножественныйВыбор Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ОбновитьПодобранные(ВыбраннаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура СписокПередЗагрузкойПользовательскихНастроекНаСервере(Элемент, Настройки)
	ЗарплатаКадры.ПроверитьПользовательскиеНастройкиДинамическогоСписка(ЭтотОбъект, Настройки);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	СтруктураПараметров = Новый Структура;
	Для Каждого ЭлементПараметр Из Настройки.ПараметрыДанных.Элементы Цикл
		СтруктураПараметров.Вставить(Строка(ЭлементПараметр.Параметр), ЭлементПараметр.Значение);
	КонецЦикла;
	
	ТаблицаИнформационныхСтрок = ТаблицаИнформационныхСтрок(СтруктураПараметров, Строки.ПолучитьКлючи());
	
	Для Каждого СтрокаТаблицы Из ТаблицаИнформационныхСтрок Цикл
		СтрокаСписка = Строки.Получить(СтрокаТаблицы.СИЗ);
		СтрокаСписка.Данные.КоличествоРабочихМест = СтрокаТаблицы.КоличествоРабочихМест;
		СтрокаСписка.Данные.КоличествоСотрудников = СтрокаТаблицы.КоличествоСотрудников;
		СтрокаСписка.Данные.ДополнительныеДанные = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицы);
		СтрокаСписка.Данные.ДополнительныеДанные.Вставить("МоментОбновления", ТекущаяДатаСеанса());
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СписокПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	
	ЗарплатаКадры.ПроверитьПользовательскиеНастройкиДинамическогоСписка(ЭтотОбъект, , СтандартнаяОбработка);
	ДоработатьПользовательскиеНастройкиСписка();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПодобранные

&НаКлиенте
Процедура ПодобранныеПослеУдаления(Элемент)
	УточнитьПодобранныеВУсловномОформлении();
КонецПроцедуры

&НаКлиенте
Процедура ПодобранныеПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПодключитьОбработчикОжидания("ПриАктивизацииСтрокиПодбораНаКлиенте", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСотрудникиСИЗ

&НаКлиенте
Процедура СотрудникиСИЗПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СотрудникиСИЗ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СкорректироватьПометкиСотрудников(ТекущиеДанные.Пометка, ТекущиеДанные.Сотрудник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьФлажки(Команда)
	УстановитьЗначениеФлажков(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	УстановитьЗначениеФлажков(Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ОбновитьПодобранные(Выбранные, ОтложенноеОбновлениеСтроки = Истина)
	
	Для Каждого Элемент Из Выбранные Цикл
		Если Не ЕстьВПодобранных(Элемент) Тогда
			Подобранные.Добавить().СИЗ = Элемент;
			Элементы.Подобранные.ТекущаяСтрока = Подобранные[Подобранные.Количество() - 1].ПолучитьИдентификатор();
			Если Не ОтложенноеОбновлениеСтроки Тогда
				ПриАктивизацииСтрокиПодбораНаКлиенте();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	УточнитьПодобранныеВУсловномОформлении();
	
КонецПроцедуры

&НаСервере
Процедура УточнитьПодобранныеВУсловномОформлении()
	
	Для Каждого ЭлементОформления Из Список.УсловноеОформление.Элементы Цикл
		Если ЭлементОформления.ИдентификаторПользовательскойНастройки = ИдентификаторПользовательскойНастройкиВыделениеПодобранных() Тогда
			ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(
				ЭлементОформления.Отбор, "Ссылка", , Подобранные.Выгрузить(, "СИЗ").ВыгрузитьКолонку("СИЗ"));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИдентификаторПользовательскойНастройкиВыделениеПодобранных()
	Возврат "ВыделениеПодобранных";
КонецФункции

&НаКлиенте
Функция ЕстьВПодобранных(СИЗСсылка)
	
	НайденныеСтроки = Подобранные.НайтиСтроки(Новый Структура("СИЗ", СИЗСсылка));
	Возврат НайденныеСтроки.Количество() > 0;
	
КонецФункции

&НаКлиенте
Процедура НачатьВопросОВыбореПодобранных()
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Подбор средств индивидуальной защиты'");
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗавершитьВопросОВыбореПодобранных", ЭтотОбъект), 
		НСтр("ru = 'Выбрать подобранные СИЗ?'"), 
		РежимДиалогаВопрос.ДаНетОтмена,
		ПараметрыВопроса);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВопросОВыбореПодобранных(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = Неопределено Или Ответ.Значение = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ.Значение = КодВозвратаДиалога.Да Тогда
		ОповеститьОВыборе(ПодобранныеПоСотрудникам());
	КонецЕсли;
	
	Подобранные.Очистить();
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Выделение подобранных.
	ЭлементОформления = Список.УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементОформления.Отбор, "Ссылка", Подобранные.Выгрузить(, "СИЗ").ВыгрузитьКолонку("СИЗ"));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстПодобранногоЗначенияЦвет);
	ЭлементОформления.ИдентификаторПользовательскойНастройки = ИдентификаторПользовательскойНастройкиВыделениеПодобранных();
	ЭлементОформления.Представление = НСтр("ru = 'Выделение подобранных'");
	
	// Только просмотр недоступных к подбору
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "СотрудникиСИЗ.ДоступноДляПодбора", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СотрудникиСИЗПометка");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииСтрокиНаКлиенте()
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьИнформационнуюСтрокуОСостоянииВыдачи(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииСтрокиПодбораНаКлиенте()
	
	ТекущиеДанные = Элементы.Подобранные.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СИЗ = Неопределено;
	Иначе
		СИЗ = ТекущиеДанные.СИЗ;
		Если ТекущиеДанные.ДополнительныеДанные = Неопределено Тогда
			ТекущиеДанные.ДополнительныеДанные = Элементы.Список.ДанныеСтроки(СИЗ).ДополнительныеДанные;
		КонецЕсли;
	КонецЕсли;
	
	Если СИЗ = ВыбранноеСИЗ Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеСИЗ = СИЗ;
	
	ЗаполнитьРабочиеМестаСотрудниковПоСИЗ(ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеДанныеВПодобранных()
	
	Если Подобранные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаИнформационныхСтрок = ТаблицаИнформационныхСтрок(Параметры, Подобранные.Выгрузить(, "СИЗ").ВыгрузитьКолонку("СИЗ"));
	Для Каждого СтрокаПодобранные Из Подобранные Цикл
		НайденныеСтроки = ТаблицаИнформационныхСтрок.НайтиСтроки(Новый Структура("СИЗ", СтрокаПодобранные.СИЗ));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПодобранные.ДополнительныеДанные = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденныеСтроки[0]);
		СтрокаПодобранные.ДополнительныеДанные.Вставить("МоментОбновления", ТекущаяДатаСеанса());
		Для Каждого СтрокаСотрудник Из СтрокаПодобранные.ДополнительныеДанные.СотрудникиСИЗ Цикл
			Если СтрокаПодобранные.СотрудникиВДокументе = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтрокаСотрудник.Пометка = СтрокаПодобранные.СотрудникиВДокументе.Найти(СтрокаСотрудник.Сотрудник) <> Неопределено;
		КонецЦикла;
		СтрокаПодобранные.СотрудникиВДокументе = Неопределено;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРабочиеМестаСотрудниковПоСИЗ(ТекущиеДанные)
	
	РабочиеМестаСИЗ.Очистить();
	СотрудникиСИЗ.Очистить();
	
	Если ВыбранноеСИЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ДополнительныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого РабочееМесто Из ТекущиеДанные.ДополнительныеДанные.РабочиеМестаСИЗ Цикл
		НоваяСтрока = РабочиеМестаСИЗ.Добавить();
		НоваяСтрока.РабочееМесто = РабочееМесто;
	КонецЦикла;
	
	Для Каждого ДанныеСотрудника Из ТекущиеДанные.ДополнительныеДанные.СотрудникиСИЗ Цикл
		НоваяСтрока = СотрудникиСИЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСотрудника);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИнформационнуюСтрокуОСостоянииВыдачи(СИЗ)

	ИнформацияОСостоянииВыдачи = Неопределено;
	ДанныеВыбранногоСИЗ = Неопределено;
	
	Если ИнформацияОСостоянииВыдачиТребуетОбновления(СИЗ) Тогда
		НачатьЗаполнениеИнформационнойСтрокиОСостоянииВыдачи(СИЗ);
		Возврат;
	КонецЕсли;
	
	ДополнительныеДанные = ДополнительныеДанныеПоСИЗ();
	Если ДополнительныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИнформацияОСостоянииВыдачи = ДополнительныеДанные.ИнформационнаяСтрокаОСостоянииВыдачи;
	ДанныеВыбранногоСИЗ = ДополнительныеДанные;
	
КонецПроцедуры

&НаКлиенте
Функция ИнформацияОСостоянииВыдачиТребуетОбновления(СИЗ)
	
	ДополнительныеДанные = ДополнительныеДанныеПоСИЗ();
	Если ДополнительныеДанные = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ДанныеПотерялиАктуальность(ДополнительныеДанные.МоментОбновления) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ДанныеПотерялиАктуальность(МоментОбновления)
	
	Если МоментОбновления < ОбщегоНазначенияКлиент.ДатаСеанса() - ПериодичностьОбновления() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура НачатьЗаполнениеИнформационнойСтрокиОСостоянииВыдачи(СИЗ)
	
	ИнформацияОСостоянииВыдачи = Неопределено;
	Если Не ЗначениеЗаполнено(СИЗ) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ИнформацияОСостоянииВыдачиЗаполняется.Видимость = Истина;
	
	СтруктураПараметров = Новый Структура;
	Для Каждого ЭлементПараметр Из Список.Параметры.Элементы Цикл
		СтруктураПараметров.Вставить(Строка(ЭлементПараметр.Параметр), ЭлементПараметр.Значение);
	КонецЦикла;
	
	СИЗ = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СИЗ);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьЗаполнениеИнформационнойСтрокиОСостоянииВыдачи", ЭтотОбъект,
		Новый Структура("СИЗ, ПараметрыСписка", СИЗ, СтруктураПараметров));
	СредстваИндивидуальнойЗащитыФормыКлиент.НачатьЗаполнениеИнформацииОСостоянииВыдачиПоСИЗ(
		ВыбранноеСИЗ, ЭтотОбъект, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗаполнениеИнформационнойСтрокиОСостоянииВыдачи(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.ИнформацияОСостоянииВыдачиЗаполняется.Видимость = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеПараметры.СИЗ <> ВыбранноеСИЗ Тогда
		Возврат;
	КонецЕсли;
	
	ИнформацияОСостоянииВыдачи = ПолучитьИзВременногоХранилища(Результат.АдресРезультата).ИнформационнаяСтрокаОСостоянииВыдачи;
	
	ДополнительныеДанные = ДополнительныеДанныеПоСИЗ();
	Если ДополнительныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеДанные.ИнформационнаяСтрокаОСостоянииВыдачи = ИнформацияОСостоянииВыдачи;
	ДанныеВыбранногоСИЗ = ДополнительныеДанные;

КонецПроцедуры

&НаКлиенте
Функция ДополнительныеДанныеПоСИЗ()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнительныеДанные = ТекущиеДанные.ДополнительныеДанные;
	Если ДополнительныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДополнительныеДанные;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПериодичностьОбновления()
	Возврат 600;
КонецФункции

&НаКлиенте
Функция ПодобранныеПоСотрудникам()
	
	ПодобранныеПоСотрудникам = Новый Массив;
	Для Каждого СтрокаПодобранные Из Подобранные Цикл
		ДанныеПодобранныхСИЗ = НоваяДанныеПодобранныхСИЗ();
		Для Каждого СтрокаСотрудника Из СтрокаПодобранные.ДополнительныеДанные.СотрудникиСИЗ Цикл
			Если Не СтрокаСотрудника.Пометка Тогда
				Продолжить;
			КонецЕсли;
			ДанныеСотрудника = НоваяДанныеСотрудника();
			ЗаполнитьЗначенияСвойств(ДанныеСотрудника, СтрокаСотрудника);
			ДанныеПодобранныхСИЗ.СотрудникиСИЗ.Добавить(ДанныеСотрудника);
		КонецЦикла;
		Если ДанныеПодобранныхСИЗ.СотрудникиСИЗ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДанныеПодобранныхСИЗ.СИЗ = СтрокаПодобранные.СИЗ;
		ПодобранныеПоСотрудникам.Добавить(ДанныеПодобранныхСИЗ);
	КонецЦикла;
	
	Возврат ПодобранныеПоСотрудникам;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НоваяДанныеПодобранныхСИЗ()
	
	ДанныеПодобранныхСИЗ = Новый Структура;
	ДанныеПодобранныхСИЗ.Вставить("СИЗ");
	ДанныеПодобранныхСИЗ.Вставить("СотрудникиСИЗ", Новый Массив);
	
	Возврат ДанныеПодобранныхСИЗ;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НоваяДанныеСотрудника()
	
	ДанныеСотрудника = Новый Структура;
	ДанныеСотрудника.Вставить("Сотрудник");
	ДанныеСотрудника.Вставить("РабочееМесто");
	
	Возврат ДанныеСотрудника;
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗначениеФлажков(ЗначениеПометки)
	
	Для Каждого ТекущаяСтрока Из СотрудникиСИЗ Цикл
		Если ТекущаяСтрока.ДоступноДляПодбора Тогда
			ТекущаяСтрока.Пометка = ЗначениеПометки;
		КонецЕсли;
	КонецЦикла;
	
	СкорректироватьПометкиСотрудников(ЗначениеПометки);
	
КонецПроцедуры

&НаКлиенте
Процедура СкорректироватьПометкиСотрудников(ЗначениеПометки, Сотрудник = Неопределено)
	
	ТекущиеДанные = Элементы.Подобранные.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ДополнительныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьВсемСотрудникам = Сотрудник = Неопределено;
	Для Каждого ДанныеСотрудника Из ТекущиеДанные.ДополнительныеДанные.СотрудникиСИЗ Цикл
		Если УстановитьВсемСотрудникам Тогда
			ДанныеСотрудника.Пометка = ЗначениеПометки;
		Иначе
			Если Сотрудник = ДанныеСотрудника.Сотрудник Тогда
				ДанныеСотрудника.Пометка = ЗначениеПометки;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНавигационнойСсылкиСотрудниковСИЗ(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	ИменаНавигационныхСсылок = СредстваИндивидуальнойЗащитыКлиентСервер.ИменаНавигационныхСсылокСостоянийВыдачиСотрудникам();
	Если НавигационнаяСсылкаФорматированнойСтроки <> ИменаНавигационныхСсылок.ОжидаютВыдачи
	   И НавигационнаяСсылкаФорматированнойСтроки <> ИменаНавигационныхСсылок.Выдано Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ФизическиеЛицаДляОтбора = Новый Массив;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = ИменаНавигационныхСсылок.ОжидаютВыдачи Тогда
		Для Каждого СтрокаСотрудник Из ДанныеВыбранногоСИЗ.СотрудникиСИЗ Цикл
			Если СтрокаСотрудник.ДоступноДляПодбора Тогда
				ФизическиеЛицаДляОтбора.Добавить(СтрокаСотрудник.Сотрудник);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = ИменаНавигационныхСсылок.Выдано Тогда
		Для Каждого СтрокаСотрудник Из ДанныеВыбранногоСИЗ.СотрудникиСИЗ Цикл
			Если Не СтрокаСотрудник.ДоступноДляПодбора Тогда
				ФизическиеЛицаДляОтбора.Добавить(СтрокаСотрудник.Сотрудник);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не определено имя навигационной ссылки (%1)'"),
			НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор");
	ПараметрыФормы.Отбор = Новый Структура("ФизическоеЛицо", ФизическиеЛицаДляОтбора);
	
	ОткрытьФорму("Справочник.Сотрудники.ФормаСписка", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено)
	Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию);
КонецФункции

&НаСервере
Процедура ДоработатьПользовательскиеНастройкиСписка()
	
	Для Каждого ЭлементНастроек Из Элементы.СписокКомпоновщикНастроекПользовательскиеНастройки.ПодчиненныеЭлементы Цикл
		Если ЭлементНастроек.Вид = ВидПоляФормы.ПолеФлажка Тогда
			ЭлементНастроек.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТаблицаИнформационныхСтрок(СтруктураПараметров, СИЗ)
	Возврат Справочники.СредстваИндивидуальнойЗащиты.ТаблицаИспользованияСИЗВРабочихМестах(СИЗ, СтруктураПараметров);
КонецФункции

#КонецОбласти