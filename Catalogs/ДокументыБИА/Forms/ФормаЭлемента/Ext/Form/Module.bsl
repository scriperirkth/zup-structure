
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТолькоПросмотр = Истина;
	
	Элементы.ГруппаИнформация.Видимость = Объект.Уничтожен Или Объект.ПометкаУдаления;
	Если Объект.Уничтожен Тогда
		Элементы.ИнформацияНадпись.Заголовок = СтрШаблон(
			НСтр("ru = 'Документ уничтожен в 1С:Архиве %1'"),
			Формат(Объект.ДатаУничтожения, "ДЛФ=Д"));
	ИначеЕсли Объект.ПометкаУдаления Тогда
		Элементы.ИнформацияНадпись.Заголовок = 
			НСтр("ru = 'Документ помечен на удаление'");
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СтатусыОбменаДокументовБИА.Статус, &СтатусНеГотов) КАК Статус,
		|	СтатусыОбменаДокументовБИА.ПакетДокументов КАК Пакет
		|ИЗ
		|	Справочник.ДокументыБИА КАК ДокументыБИА
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыОбменаДокументовБИА КАК СтатусыОбменаДокументовБИА
		|		ПО ДокументыБИА.Ссылка = СтатусыОбменаДокументовБИА.ДокументБИА
		|ГДЕ
		|	ДокументыБИА.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("СтатусНеГотов", Перечисления.СтатусыОбменаС1САрхивом.НеГотовКВыгрузке);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтатусОбмена = Выборка.Статус;
		ПакетДокументов = Выборка.Пакет;
	КонецЕсли;
	
	Элементы.ПакетДокументов.Видимость = ЗначениеЗаполнено(ПакетДокументов);
	Элементы.ФормаВключитьВозможностьРедактирования.Видимость =
		ПравоДоступа("Изменение", Метаданные.Справочники.ДокументыБИА);
	Элементы.ФормаВключитьВозможностьРедактирования.Доступность =
		ОбменСАрхивом.ДоступноРедактированиеПоСтатусу(СтатусОбмена);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВключитьВозможностьРедактирования(Команда)
	
	ТолькоПросмотр = Ложь;
	Элементы.ФормаВключитьВозможностьРедактирования.Доступность = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПрочиеСвойства

&НаКлиенте
Процедура ПрочиеСвойстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяКолонка = Элемент.ТекущийЭлемент;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Значение) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Значение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыФайлы

&НаКлиенте
Процедура ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяКолонка = Элемент.ТекущийЭлемент;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущаяКолонка = Элементы.ФайлыФайл И ЗначениеЗаполнено(ТекущиеДанные.Файл) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Файл);
	ИначеЕсли ТекущаяКолонка = Элементы.ФайлыФайлВизуализации И ЗначениеЗаполнено(ТекущиеДанные.ФайлВизуализации) Тогда
		ПоказатьЗначение(, ТекущиеДанные.ФайлВизуализации);
	ИначеЕсли ТекущаяКолонка = Элементы.ФайлыРоль И ЗначениеЗаполнено(ТекущиеДанные.Роль) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Роль);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

