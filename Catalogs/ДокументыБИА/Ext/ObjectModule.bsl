#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет значение свойства в список свойств документа.
// 
// Параметры:
//  Значение - Произвольный - значение свойства.
//  ИмяСвойства - Строка - имя свойства.
//  ПредставлениеСвойства - Строка - представление свойства.
//
Процедура ДобавитьЗначениеСвойства(Значение, ИмяСвойства, ПредставлениеСвойства = "") Экспорт
	
	СтрокаСвойства = ПрочиеСвойства.Добавить();
	СтрокаСвойства.ИмяСвойства = ИмяСвойства;
	СтрокаСвойства.ПредставлениеСвойства = ?(ЗначениеЗаполнено(ПредставлениеСвойства),
		ПредставлениеСвойства, ИмяСвойства);
	СтрокаСвойства.Значение = Значение;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() И Не ЗначениеЗаполнено(ДатаСоздания) Тогда
		Если Не ЗначениеЗаполнено(ДатаСоздания) Тогда
			ДатаСоздания = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Автор) Тогда
		Автор = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
	Наименование = НаименованиеДокумента(ЭтотОбъект);
	
	Если Не ЭтоНовый() И ПометкаУдаления
		И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ПометкаУдаления")
		И (Не ДополнительныеСвойства.Свойство("ЭтоОтзывДокумента")
			Или ДополнительныеСвойства.ЭтоОтзывДокумента <> Истина) Тогда
		ВызватьИсключение НСтр("ru = 'Пометка документа для 1С:Архива на удаление может выполняться только при отзыве документа'");
	КонецЕсли
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ДатаСоздания = ТекущаяДатаСеанса();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Типы значений в таб. части ПрочиеСвойства.
	Если ПрочиеСвойства.Количество() > 0 Тогда
		
		ДопустимыеТипы = Новый Соответствие;
		ДопустимыеТипы[Тип("Строка")] = Истина;
		ДопустимыеТипы[Тип("Число")] = Истина;
		ДопустимыеТипы[Тип("Дата")] = Истина;
		ДопустимыеТипы[Тип("Булево")] = Истина;
		ДопустимыеТипы[Тип("СправочникСсылка.ВидыДокументовБИА")] = Истина;
		ДопустимыеТипы[Тип("СправочникСсылка.ДокументыБИА")] = Истина;
		
		ОписанияСсылочныхТипов = Новый Массив;
		ОписанияСсылочныхТипов.Добавить(Метаданные.ОпределяемыеТипы.ГрифДоступаБИА.Тип);
		ОписанияСсылочныхТипов.Добавить(Метаданные.ОпределяемыеТипы.ДолжностьБИА.Тип);
		ОписанияСсылочныхТипов.Добавить(Метаданные.ОпределяемыеТипы.КонтрагентБИА.Тип);
		ОписанияСсылочныхТипов.Добавить(Метаданные.ОпределяемыеТипы.ОрганизацияБИА.Тип);
		ОписанияСсылочныхТипов.Добавить(Метаданные.ОпределяемыеТипы.ПодразделениеБИА.Тип);
		ОписанияСсылочныхТипов.Добавить(Метаданные.ОпределяемыеТипы.ПроектБИА.Тип);
		ОписанияСсылочныхТипов.Добавить(Метаданные.ОпределяемыеТипы.СотрудникБИА.Тип);
		ОписанияСсылочныхТипов.Добавить(Метаданные.ОпределяемыеТипы.ФизическоеЛицо.Тип);
		
		Для Каждого ОписаниеТипа Из ОписанияСсылочныхТипов Цикл
			Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
				ДопустимыеТипы[Тип] = Истина;
			КонецЦикла;
		КонецЦикла;
		
		Для Каждого Стр Из ПрочиеСвойства Цикл
			Если ДопустимыеТипы[ТипЗнч(Стр.Значение)] = Неопределено Тогда
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
					НСтр("ru = 'Недопустимый тип значения свойства ""%1"": %2'"),
					Стр.ИмяСвойства, ТипЗнч(Стр.Значение)));
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Подписи.
	Для Каждого СтрПодписи Из ПодписиДокумента Цикл
		Если СтрПодписи.ВидПодписи = Перечисления.ВидыПодписейДокументовБИА.Усиленная Тогда
			ДвоичныеДанныеПодписи = СтрПодписи.Подпись.Получить();
			Если Не ЗначениеЗаполнено(ДвоичныеДанныеПодписи) Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
					НСтр("ru = 'Не заполнены данные усиленной подписи в строке %1'"),
					СтрПодписи.НомерСтроки));
				Продолжить;
			ИначеЕсли ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
				ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(СтрПодписи.Файл);
				МодульЭлектроннаяПодписьКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодписьКлиентСервер");
				РезультатСтруктура = МодульЭлектроннаяПодписьКлиентСервер.РезультатПроверкиПодписи();
				РезультатСтруктура.ПараметрыПроверкиСертификата =
					ЭлектроннаяПодписьСлужебныйКлиентСервер.НеПроверятьСертификат();
				ОписаниеОшибки = "";
				ЭлектроннаяПодпись.ПроверитьПодпись(Неопределено, ДвоичныеДанныеФайла,
					ДвоичныеДанныеПодписи, ОписаниеОшибки,, РезультатСтруктура);
				Если РезультатСтруктура.Результат <> Истина
						И РезультатСтруктура.ПодписьМатематическиВерна <> Истина Тогда
					ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
						НСтр("ru = 'Ошибка проверки усиленной подписи в строке %1: %2'"),
						СтрПодписи.НомерСтроки, ОписаниеОшибки));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЭтоЭлектронныйДокумент И СтрПодписи.ВидПодписи = Перечисления.ВидыПодписейДокументовБИА.НаБумаге Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Вид подписи ""На бумаге"" недопустим для электронных документов'")));
			Продолжить;
		КонецЕсли;
		Если СтрПодписи.ВидПодписи = Перечисления.ВидыПодписейДокументовБИА.Простая Тогда
			Если Не ЗначениеЗаполнено(СтрПодписи.Подпись.Получить()) Тогда
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
					НСтр("ru = 'Не заполнены двоичные данные ПЭП в строке %1'"),
					СтрПодписи.НомерСтроки));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОбменСАрхивомПереопределяемый.ОбработкаПроверкиЗаполненияДокументаБИА(
		ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НаименованиеДокумента(Документ) 
	
	Заголовок = СокрЛП(Документ.Заголовок);
	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = Строка(Документ.ВидДокумента);
	КонецЕсли;
	
	ДлинаНаименования = Документ.Метаданные().ДлинаНаименования;
	
	Если ЗначениеЗаполнено(Документ.Номер)
		И СтрНайти(Заголовок, Документ.Номер) = 0
		И СтрНайти(Заголовок, Формат(Документ.Дата, "ДЛФ=D")) = 0 Тогда 
		Постфикс = " " + СтрШаблон(
			НСтр("ru = '(№ %1 от %2)'"),
			СокрЛП(Документ.Номер),
			Формат(Документ.Дата, "ДЛФ=D"));
	Иначе
		Постфикс = "";
	КонецЕсли;
	
	ДлинаПостфикса = СтрДлина(Постфикс);
	Если СтрДлина(Заголовок) + ДлинаПостфикса > ДлинаНаименования Тогда 
		Заголовок = Лев(Заголовок, ДлинаНаименования - ДлинаПостфикса);
		ДлинаЗаголовка = СтрДлина(Заголовок);
		ПозицияПробела = ДлинаЗаголовка;
		Пока ПозицияПробела > 0 Цикл
			Если Сред(Заголовок, ПозицияПробела, 1) = " " Тогда
				Прервать;
			КонецЕсли;	
			ПозицияПробела = ПозицияПробела - 1;
		КонецЦикла;	
		Если ПозицияПробела > 1 Тогда 
			Заголовок = Лев(Заголовок, ПозицияПробела - 1);
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Заголовок + Постфикс;
	
КонецФункции	

#КонецОбласти

#КонецЕсли
