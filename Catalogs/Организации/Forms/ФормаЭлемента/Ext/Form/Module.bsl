&НаКлиенте
Процедура ИндивидуальныйПредпринимательПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ИндивидуальныйПредприниматель) Тогда
		Сведения = СведенияОФизическомЛице(Объект.ИндивидуальныйПредприниматель);
		
		Объект.ИНН                        = Сведения.ИНН;
		ФИОИндивидуальногоПредпринимателя = Сведения.ФИО;
		
		Фамилия  = СокрЛП(Сведения.Фамилия);
		Имя      = СокрЛП(Сведения.Имя);
		Отчество = СокрЛП(Сведения.Отчество);
		
		Объект.НаименованиеСокращенное = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'ИП %1%2%3'"),
			Фамилия,
			?(Имя = "",      "", " " + Лев(Имя, 1) + "."),
			?(Отчество = "", "", " " + Лев(Отчество, 1) + "."));
		Объект.НаименованиеПолное = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Индивидуальный предприниматель %1%2%3'"),
			Фамилия,
			?(Имя = "",      "", " " + Имя),
			?(Отчество = "", "", " " + Отчество));
		Объект.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1%2%3ИП'"),
			?(Фамилия = "",  "", Фамилия + " "),
			?(Имя = "",      "", Лев(Имя, 1) + ". "),
			?(Отчество = "", "", Лев(Отчество, 1) + ". "));
	Иначе
		Объект.ИНН = "";
		ФИОИндивидуальногоПредпринимателя = "";
	КонецЕсли;
	ОбновитьПолеИндивидуальныйПредприниматель(ЭтотОбъект);
	ОбработатьОтображениеПоляИНН(ЭтотОбъект);
	
КонецПроцедуры

