	УстановитьВидEmail("ОценивающиеЭксперты", Число(Прав(Команда.Имя,1)));
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчетИндивидуальныеРезультаты(Команда)
	
	Если Элементы.Сотрудники.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВариантОтчета = "ИндивидуальнаяОценка";
	ПользовательскиеНастройкиОтчета = ПользовательскиеНастройкиОтчетаЭкспертнойОценки(
		Новый Структура("ОпросПоКомпетенциям,ФизическоеЛицо,КлючВарианта", Объект.Ссылка, Элементы.Сотрудники.ТекущиеДанные.ФизическоеЛицо, ВариантОтчета));
	
	ПараметрыОтчета = Новый Структура("СформироватьПриОткрытии, КлючВарианта, ПользовательскиеНастройки",
		Истина, ВариантОтчета, ПользовательскиеНастройкиОтчета);
	
	ОткрытьФорму("Отчет.РезультатыОпросовПоКомпетенциям.Форма", ПараметрыОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчетИндивидуальныеРезультатыДляСотрудника(Команда)
	
	Если Элементы.Сотрудники.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВариантОтчета = "ИндивидуальнаяОценкаДляСотрудника";
	ПользовательскиеНастройкиОтчета = ПользовательскиеНастройкиОтчетаЭкспертнойОценки(
		Новый Структура("ОпросПоКомпетенциям,ФизическоеЛицо,КлючВарианта", Объект.Ссылка, Элементы.Сотрудники.ТекущиеДанные.ФизическоеЛицо, ВариантОтчета));
	
	ПараметрыОтчета = Новый Структура("СформироватьПриОткрытии, КлючВарианта, ПользовательскиеНастройки",
		Истина, ВариантОтчета, ПользовательскиеНастройкиОтчета);
	
	ОткрытьФорму("Отчет.РезультатыОпросовПоКомпетенциям.Форма", ПараметрыОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчетКорпоративныеРезультаты(Команда)
	
	СписокСотрудников = Новый СписокЗначений;
	Для Каждого СтрокаТаблицы Из Сотрудники Цикл
		СписокСотрудников.Добавить(СтрокаТаблицы.ФизическоеЛицо, , Истина);
	КонецЦикла;
	
	ВариантОтчета = "РезультатыОпросаПоКомпетенциям";
	ПользовательскиеНастройкиОтчета = ПользовательскиеНастройкиОтчетаЭкспертнойОценки(
		Новый Структура("ОпросПоКомпетенциям,ФизическоеЛицо,КлючВарианта", Объект.Ссылка, СписокСотрудников, ВариантОтчета));
	
	ПараметрыОтчета = Новый Структура("СформироватьПриОткрытии, КлючВарианта, ПользовательскиеНастройки",
		Истина, ВариантОтчета, ПользовательскиеНастройкиОтчета);
	
	ОткрытьФорму("Отчет.РезультатыОпросовПоКомпетенциям.Форма", ПараметрыОтчета);
	
