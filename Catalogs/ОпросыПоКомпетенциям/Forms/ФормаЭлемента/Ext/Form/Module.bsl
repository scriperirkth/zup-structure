&НаСервере
Процедура ДобавитьХарактеристикиПерсоналаНаСервере(НовыеХарактеристики, ДополнительныеПараметры)
	ХарактеристикиПерсоналаФормы.ДобавитьХарактеристикиВТабличнуюЧасть(ЭтотОбъект, НовыеХарактеристики, ДополнительныеПараметры, "Объект.Характеристики");
КонецПроцедуры

&НаСервере
Процедура ПриПолученииДанныхНаСервере(ЗначениеКопирования = Неопределено)

	ДатаАктуальности = ОбщегоНазначения.ТекущаяДатаПользователя();
	ПрежнееПодразделение = Объект.Подразделение;
	
	СформироватьПодменюВидовEmail("ОценивающиеЭксперты");
	
	ХарактеристикиПерсоналаФормы.ЗаполнитьКартинкуИВидХарактеристикиТаблицыХарактеристик(Объект.Характеристики);
	
	ЗаполнитьТЧЭксперты();
	ЗаполнитьТЧОцениваемые();
	
	ЗаполнитьЦветаНадписей();
	ЗагрузитьШаблонАнкеты();
	ЗагрузитьОткрытыеВопросы();
	
	ЗаполнитьВторичныеРеквизитыФормы();
	
	УстановитьСвойстваЭлементовФормы();
	
	ЗаполнитьУчастников();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементовФормы()

	УстановитьПараметрыВыбораДляРолиЭксперта();
	
	УстановитьДоступностьХарактеристик(ЭтотОбъект, ЕстьАнкетыВОпросе());
	УстановитьДоступностьОцениваемых(ЭтотОбъект);
	УстановитьДоступностьОценивающих(ЭтотОбъект);
	УстановитьДоступностьСпособаЗаполненияЭкспертов(ЭтотОбъект);
	УстановитьПодсказкиОцениваемымИОценивающим(ЭтотОбъект);
	УстановитьДоступностьПодразделения(ЭтотОбъект);
	УстановитьДоступностьЭлементовПериодаАнкетирования();
	УстановитьБлокировкуПоДатам();
	УстановитьВидимостьПредупрежденияДатаНачалаНеНаступила();
	УстановитьДоступностьКомандАнкетирования();
	УстановитьДоступностьОткрытыхВопросов(ЭтотОбъект, Объект.ИспользоватьОткрытыеВопросы);
	
	УстановитьВидимостьОценивающиеГруппы(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораДляРолиЭксперта()
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", РолиЭкспертовВОпросе()));
	
	Элементы.ОценивающиеЭкспертыРольЭксперта.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	Элементы.ОценивающиеЭкспертыЕдиныйНаборРольЭксперта.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
КонецПроцедуры

&НаСервере
Функция РолиЭкспертовВОпросе()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РолиРеспондентаОценкиПерсонала.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РолиРеспондентаОценкиПерсонала КАК РолиРеспондентаОценкиПерсонала
		|ГДЕ
		|	РолиРеспондентаОценкиПерсонала.Ссылка <> &СамооценкаПараметр";
	Запрос.УстановитьПараметр("СамооценкаПараметр", Справочники.РолиРеспондентаОценкиПерсонала.Самооценка);
	
	УстановитьПривилегированныйРежим(Истина);
	РолиЭкспертов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	УстановитьПривилегированныйРежим(Ложь);
	
	ЭкспертнаяОценкаПерсонала.ПриЗаполненииРолейЭкспертовВОпросе(РолиЭкспертов);
	
	Возврат РолиЭкспертов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОценивающиеГруппы(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"ГруппаОценивающиеИндивидуально",
		"Видимость",
		Форма.Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.Индивидуальное"));
				
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"ГруппаОценивающиеОбщие",
		"Видимость",
		Форма.Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех"));
				
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаполненияАнкетыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьОпросНаКлиенте() Тогда
			ОткрытьФормуМастераАнкетыПоРазделам();
			ПриПолученииДанныхНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Сохранение опроса
&НаСервере
Функция ЗаписатьОпросНаСервере(НачалоАнкетирования)
	
	НачатьТранзакцию();
	
	Попытка
		
		Если НачалоАнкетирования Тогда
			СоздатьПользователейЭкспертов();
			НачалоАнкетированияНаСервере();
		КонецЕсли;
		
		Если СведенияОбОпросе.АнкетированиеНачато И Не НачалоАнкетирования Тогда
			ЗаполнитьСтатусОпроса();
			ПроверитьЗаполнениеНаСервере();
			Если Не ОпросЗаполненВерно(ЭтотОбъект) Тогда
				Возврат Ложь;
			КонецЕсли;
			ПроверитьИзменениеУчастников(НачалоАнкетирования);
		КонецЕсли;
		
		ЗаписатьШаблонАнкеты();
		ЗаписатьВопросыШаблонаАнкеты();
		ЗаписатьОткрытыеВопросы();
		
		Если Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех Тогда
			Объект.ОценивающиеЭксперты.Очистить();
		Иначе
			Объект.ОценивающиеЭкспертыЕдиныйНабор.Очистить();
		КонецЕсли;
		
		// сохраним последние используемые варианты
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкиПользователя", "ИспользуемыйВидКонтактнойИнформацииОценивающиеЭксперты", Объект.ВидКонтактнойИнформацииОценивающиеЭксперты);
		
		// Записываем
		СправочникОбъект = РеквизитФормыВЗначение("Объект");
		Если Не СправочникОбъект.ПроверитьЗаполнение() Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// СтандартныеПодсистемы.Свойства
		УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, СправочникОбъект);
		// Конец СтандартныеПодсистемы.Свойства
		
		СправочникОбъект.Записать();
		
		ЗафиксироватьТранзакцию();
	
	Исключение
		
		Для Каждого Оцениваемый Из Объект.Оцениваемые Цикл
			Оцениваемый.НазначениеОпроса = Документы.НазначениеОпросов.ПустаяСсылка();
		КонецЦикла;
		
		Для Каждого ОткрытыйВопрос Из ТаблицаОткрытыеВопросы Цикл
			ОткрытыйВопрос.ЭлементарныйВопрос = ПланыВидовХарактеристик.ВопросыДляАнкетирования.ПустаяСсылка();
		КонецЦикла;
		
		Объект.ШаблонАнкеты = Справочники.ШаблоныАнкет.ПустаяСсылка();
		ЗначениеВРеквизитФормы(Справочники.ШаблоныАнкет.СоздатьЭлемент(),"ШаблонАнкетыОбъект");
		ЗаполнитьШаблонАнкетыДемоТекстами();
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
	ЗначениеВРеквизитФормы(СправочникОбъект, "Объект");
	
	АктивироватьАнкетыЭкспертов();
	
	Модифицированность = Ложь;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗначенияШкалы(ШкалаЗначений)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияХарактеристик.Ссылка КАК Ссылка,
		|	ЗначенияХарактеристик.Наименование КАК Наименование,
		|	ЗначенияХарактеристик.ЧисловоеЗначение КАК ЧисловоеЗначение,
		|	ЗначенияХарактеристик.Подсказка КАК Подсказка
		|ИЗ
		|	Справочник.ЗначенияХарактеристик КАК ЗначенияХарактеристик
		|ГДЕ
		|	ЗначенияХарактеристик.ПометкаУдаления = ЛОЖЬ
		|	И ЗначенияХарактеристик.Владелец = &ШкалаЗначений
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЧисловоеЗначение";
	Запрос.УстановитьПараметр("ШкалаЗначений", ШкалаЗначений);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ЗаписатьШаблонАнкеты()
	
	НеобходимоСоздаватьШаблон = Не ЗначениеЗаполнено(ШаблонАнкетыОбъект.Ссылка);
	ШаблонОбъект = РеквизитФормыВЗначение("ШаблонАнкетыОбъект");
	Если НеобходимоСоздаватьШаблон Тогда
		ШаблонОбъект.Наименование = СтрШаблон(НСтр("ru = 'Шаблон опроса по компетенциям %1'"), Объект.Наименование);
	КонецЕсли;
	
	Попытка
		ШаблонОбъект.Записать();
		ЗначениеВРеквизитФормы(ШаблонОбъект,"ШаблонАнкетыОбъект");
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось записать шаблон анкеты.'") + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если НеобходимоСоздаватьШаблон Тогда
		Объект.ШаблонАнкеты = ШаблонОбъект.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВопросыШаблонаАнкеты()
	
	Если Объект.ШаблонАнкеты.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьАнкетыВОпросе() Тогда
		Возврат;
	Иначе
		Объект.Характеристики.Загрузить(Объект.Характеристики.Выгрузить( , "Характеристика"));
		Анкетирование.УдалитьВопросыШаблонаАнкеты(Объект.ШаблонАнкеты);
	КонецЕсли;
		
	КатегорииХарактеристик = КатегорииХарактеристикВОпросе();
	ИспользуетсяНесколькоРазделов = Ложь;
	Если КатегорииХарактеристик.Количество() > 1 Тогда
		ИспользуетсяНесколькоРазделов = Истина;
	КонецЕсли;
	
	ВопросыПоШкале = Новый Соответствие;
	ВопросыПоТочномуЗначению = Новый Соответствие;
	
	// Наполняем анкету вопросами
	// Сначала вопросы компетенций
	Для Каждого СтрокаХарактеристика Из Объект.Характеристики Цикл
		Если ЗначениеЗаполнено(СтрокаХарактеристика.Вопрос) Тогда
			Продолжить;
		КонецЕсли;
		РеквизитыХарактеристики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаХарактеристика.Характеристика,
			"Наименование, ПолноеНаименование, Категория");
		
		Если ИспользуетсяНесколькоРазделов Тогда
			НайденнаяКатегория = КатегорииХарактеристик.Найти(РеквизитыХарактеристики.Категория);
			Если НайденнаяКатегория = Неопределено Тогда
				НаименованиеРаздела = НСтр("ru = 'Оценка компетенций'");
			Иначе
				НаименованиеРаздела = Строка(КатегорииХарактеристик[НайденнаяКатегория]);
			КонецЕсли;
		Иначе
			НаименованиеРаздела = НСтр("ru = 'Оценка компетенций'");
		КонецЕсли;
		
		// Определяем раздел анкеты
		РазделАнкеты = Справочники.ВопросыШаблонаАнкеты.НайтиПоНаименованию(НаименованиеРаздела, Истина, , Объект.ШаблонАнкеты);
		Если РазделАнкеты.Пустая() Тогда
			РазделАнкетыОбъект = Справочники.ВопросыШаблонаАнкеты.СоздатьГруппу();
			РазделАнкетыОбъект.Наименование = НаименованиеРаздела;
			РазделАнкетыОбъект.Владелец = Объект.ШаблонАнкеты;
			РазделАнкетыОбъект.Формулировка = НаименованиеРаздела;
			РазделАнкетыОбъект.Записать();
			РазделАнкеты = РазделАнкетыОбъект.Ссылка;
		КонецЕсли;
		
		// Создаем вопрос в разделе
		ВопросАнкетыОбъект = Справочники.ВопросыШаблонаАнкеты.СоздатьЭлемент();
		ВопросАнкетыОбъект.Наименование = РеквизитыХарактеристики.Наименование;
		ВопросАнкетыОбъект.Формулировка = РеквизитыХарактеристики.ПолноеНаименование;
		ВопросАнкетыОбъект.ЭлементарныйВопрос = ЭлементарныйВопросОпроса(СтрокаХарактеристика.Характеристика, ВопросыПоШкале, ВопросыПоТочномуЗначению, ВопросАнкетыОбъект.Ссылка);
		ВопросАнкетыОбъект.Обязательный = Истина;
		ВопросАнкетыОбъект.ТипВопроса = Перечисления.ТипыВопросовШаблонаАнкеты.Простой;
		ВопросАнкетыОбъект.Родитель = РазделАнкеты;
		ВопросАнкетыОбъект.Владелец = Объект.ШаблонАнкеты;
		ВопросАнкетыОбъект.ИспользоватьОтказОтОтвета = Истина;
		ВопросАнкетыОбъект.ФормулировкаОтказаОтОтвета = НСтр("ru = 'Не могу оценить'");
		ВопросАнкетыОбъект.Записать();
		
		СтрокаХарактеристика.Вопрос = ВопросАнкетыОбъект.Ссылка;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОткрытыеВопросы()
	
	Если ЕстьАнкетыВОпросе() Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОткрытыеВопросы.Очистить();
	
	Если Не Объект.ИспользоватьОткрытыеВопросы Тогда
		Возврат;
	КонецЕсли;
	
	// Определяем раздел анкеты
	РазделАнкетыОбъект = Справочники.ВопросыШаблонаАнкеты.СоздатьГруппу();
	РазделАнкетыОбъект.Наименование = Объект.ФормулировкаРазделаОткрытыхВопросов;
	РазделАнкетыОбъект.Владелец = Объект.ШаблонАнкеты;
	РазделАнкетыОбъект.Формулировка = Объект.ФормулировкаРазделаОткрытыхВопросов;
	РазделАнкетыОбъект.Записать();
	РазделАнкеты = РазделАнкетыОбъект.Ссылка;
	
	Для Каждого ОткрытыйВопрос Из ТаблицаОткрытыеВопросы Цикл
		ЗаписатьОткрытыйВопрос(РазделАнкеты, ОткрытыйВопрос.Формулировка, ОткрытыйВопрос.Обязательный, 
			ОткрытыйВопрос.ЭлементарныйВопрос);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОткрытыйВопрос(РазделАнкеты, Формулировка, Обязательный, ЭлементарныйВопрос)
	
	// Создаем вопрос в разделе
	ВопросАнкетыОбъект = Справочники.ВопросыШаблонаАнкеты.СоздатьЭлемент();
	ВопросАнкетыОбъект.Наименование = Формулировка;
	ВопросАнкетыОбъект.Формулировка = Формулировка;
	Если Не ЗначениеЗаполнено(ЭлементарныйВопрос) Тогда
		ЭлементарныйВопрос = ЭлементарныйОткрытыйВопрос(Формулировка);
	КонецЕсли;
	ВопросАнкетыОбъект.ЭлементарныйВопрос = ЭлементарныйВопрос;
	ВопросАнкетыОбъект.Обязательный = Обязательный;
	ВопросАнкетыОбъект.ТипВопроса = Перечисления.ТипыВопросовШаблонаАнкеты.Простой;
	ВопросАнкетыОбъект.Родитель = РазделАнкеты;
	ВопросАнкетыОбъект.Владелец = Объект.ШаблонАнкеты;
	ВопросАнкетыОбъект.Записать();
	
	НовыйВопрос = Объект.ОткрытыеВопросы.Добавить();
	НовыйВопрос.Вопрос = ВопросАнкетыОбъект.Ссылка;
	НовыйВопрос.Обязательный = Обязательный;
	
КонецПроцедуры

&НаСервере
Функция ЭлементарныйОткрытыйВопрос(Формулировка)
	
	ВопросОбъект = ПланыВидовХарактеристик.ВопросыДляАнкетирования.СоздатьЭлемент();
	ВопросОбъект.ТипОтвета = Перечисления.ТипыОтветовНаВопрос.Текст;
	ВопросОбъект.Наименование = Формулировка;
	ВопросОбъект.Формулировка = Формулировка;
	ВопросОбъект.Записать();
	
	Возврат ВопросОбъект.Ссылка;
	
КонецФункции

&НаСервере
Функция ЭлементарныйВопросОпроса(Характеристика, ВопросыПоШкале, ВопросыПоТочномуЗначению, ВопросыШаблонаАнкеты)
	
	Вопрос = ВопросХарактеристики(Характеристика);
	Если ЗначениеЗаполнено(Вопрос) И Не ВопросХарактеристикиИзменился(Характеристика, Вопрос) Тогда
		Возврат Вопрос;
	КонецЕсли;
	
	СпособВыбора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Характеристика, "СпособВыбораОтветаВОпросахПоКомпетенциям");
	
	Если СпособВыбора = Перечисления.СпособыВыбораОтветовВОпросахПоКомпетенциям.ПоШкале Тогда
		Вопрос = ВопросПоШкале(Характеристика, ВопросыШаблонаАнкеты);
	ИначеЕсли СпособВыбора = Перечисления.СпособыВыбораОтветовВОпросахПоКомпетенциям.ТочноеЗначение Тогда
		Вопрос = ВопросПоТочномуЗначению(Характеристика);
	КонецЕсли;
	
	ЗаписатьВопросХарактеристики(Характеристика, Вопрос);
	
	Возврат Вопрос;
	
КонецФункции

&НаСервере
Функция ВопросХарактеристикиИзменился(Характеристика, Вопрос)
	
	ДанныеХарактеристики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Характеристика, "ШкалаЗначений, СпособВыбораОтветаВОпросахПоКомпетенциям");
		
	ЗначенияШкалы = ЗначенияШкалы(ДанныеХарактеристики.ШкалаЗначений);
		
	Если ДанныеХарактеристики.СпособВыбораОтветаВОпросахПоКомпетенциям = Перечисления.СпособыВыбораОтветовВОпросахПоКомпетенциям.ПоШкале Тогда
		Если Вопрос.ТипОтвета <> Перечисления.ТипыОтветовНаВопрос.ОдинВариантИз Тогда
			Возврат Истина;
		КонецЕсли;
		
		ПорядокОтвета = 1;
		Для Каждого ЗначениеШкалы Из ЗначенияШкалы Цикл
			ВариантОтвета = Справочники.ВариантыОтветовАнкет.НайтиПоНаименованию(
				ЗначениеШкалы.Наименование, Истина, , Вопрос);
			Если Не ЗначениеЗаполнено(ВариантОтвета) Тогда
				Возврат Истина;
			КонецЕсли;
			Если ПорядокОтвета <> ВариантОтвета.РеквизитДопУпорядочивания Тогда
				Возврат Истина;
			КонецЕсли;
			Если ВариантОтвета.Подсказка <> ЗначениеШкалы.Подсказка Тогда
				Возврат Истина;
			КонецЕсли;
			ПорядокОтвета = ПорядокОтвета + 1;
		КонецЦикла;
	ИначеЕсли ДанныеХарактеристики.СпособВыбораОтветаВОпросахПоКомпетенциям = Перечисления.СпособыВыбораОтветовВОпросахПоКомпетенциям.ТочноеЗначение Тогда
		ЗначенияСПодсказками = ЗначенияШкалы.Скопировать( , "ЧисловоеЗначение, Подсказка");
		ЗначенияСПодсказками.Колонки.ЧисловоеЗначение.Имя = "ЗначениеДо";
		ДиапазонПодсказок = Вопрос.ДиапазонПодсказокЧисловогоВопроса.Выгрузить( , "ЗначениеДо, Подсказка");
		Если Не ОбщегоНазначения.КоллекцииИдентичны(ЗначенияСПодсказками, ДиапазонПодсказок) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ЗаписатьВопросХарактеристики(Характеристика, Вопрос)
	
	ДанныеХарактеристики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Характеристика, "ШкалаЗначений, СпособВыбораОтветаВОпросахПоКомпетенциям");
	
	НаборЗаписей = РегистрыСведений.ВопросыЭкспертнойОценкиПерсонала.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ШкалаЗначений.Установить(ДанныеХарактеристики.ШкалаЗначений);
	НаборЗаписей.Отбор.СпособВыбораОтвета.Установить(ДанныеХарактеристики.СпособВыбораОтветаВОпросахПоКомпетенциям);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.ШкалаЗначений = ДанныеХарактеристики.ШкалаЗначений;
	НоваяЗапись.СпособВыбораОтвета = ДанныеХарактеристики.СпособВыбораОтветаВОпросахПоКомпетенциям;
	НоваяЗапись.Вопрос = Вопрос;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

&НаСервере
Функция ВопросХарактеристики(Характеристика)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ХарактеристикиПерсонала.Ссылка КАК Ссылка,
		|	ХарактеристикиПерсонала.ШкалаЗначений КАК ШкалаЗначений,
		|	ХарактеристикиПерсонала.СпособВыбораОтветаВОпросахПоКомпетенциям КАК СпособВыбораОтветаВОпросахПоКомпетенциям
		|ПОМЕСТИТЬ ВТХарактеристики
		|ИЗ
		|	ПланВидовХарактеристик.ХарактеристикиПерсонала КАК ХарактеристикиПерсонала
		|ГДЕ
		|	ХарактеристикиПерсонала.Ссылка = &Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВопросыЭкспертнойОценкиПерсонала.Вопрос КАК Вопрос
		|ИЗ
		|	ВТХарактеристики КАК ВТХарактеристики
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВопросыЭкспертнойОценкиПерсонала КАК ВопросыЭкспертнойОценкиПерсонала
		|		ПО ВТХарактеристики.ШкалаЗначений = ВопросыЭкспертнойОценкиПерсонала.ШкалаЗначений
		|			И ВТХарактеристики.СпособВыбораОтветаВОпросахПоКомпетенциям = ВопросыЭкспертнойОценкиПерсонала.СпособВыбораОтвета";
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
		
	Возврат  Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Вопрос")[0];
	
КонецФункции

&НаСервере
Процедура УстановитьБлокировкуПоДатам()
	
	БлокировкаПоДатеНачала = (Объект.ДатаНачала > ТекущаяДатаСеанса())
		ИЛИ (Объект.ДатаНачала > Объект.ДатаОкончания);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПредупрежденияДатаНачалаНеНаступила()
	
	ВидимостьПредупреждения = БлокировкаПоДатеНачала И НЕ СведенияОбОпросе.АнкетированиеНачато;
	Если ВидимостьПредупреждения Тогда
		Заголовок = НСтр("ru = 'Дата начала анкетирования еще не наступила'");
		Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
			Заголовок = НСтр("ru = 'Дата окончания превышает дату начала'");
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СообщениеДатаНачалаНеНаступила", "Заголовок", Заголовок);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПредупрежденияДатаНачалаНеНаступила", "Видимость", ВидимостьПредупреждения);
	
КонецПроцедуры


&НаСервере
Процедура ОбработкаЗаполненияНовогоЭлемента()

	Объект.ДатаНачала = ТекущаяДатаСеанса();
	Объект.ДатаОкончания = КонецМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(),1));
	
	ЗначенияДляЗаполнения = Новый Структура("Ответственный", "Объект.Ответственный");
	ЗарплатаКадры.ЗаполнитьПервоначальныеЗначенияВФорме(ЭтотОбъект, ЗначенияДляЗаполнения);
	
	ЗаполнитьВидыКонтактнойИнформации();
	
	ЗаполнитьШаблонАнкетыДемоТекстами();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьШаблонАнкетыДемоТекстами()

	ДемоТексты = ЭкспертнаяОценкаПерсонала.ДемонстрационныеТекстыОпросаПоКомпетенциям(Объект.Наименование);
	ШаблонАнкетыОбъект.Заголовок = ДемоТексты.ШаблонАнкетыЗаголовок;
	ШаблонАнкетыОбъект.Вступление = ДемоТексты.ШаблонАнкетыВступление;
	ШаблонАнкетыОбъект.Заключение = ДемоТексты.ШаблонАнкетыЗаключение;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьШаблонАнкеты()

	ШаблонАнкетыСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ШаблонАнкеты");
	
	Если ЗначениеЗаполнено(ШаблонАнкетыСсылка) Тогда
		СправочникОбъект = ШаблонАнкетыСсылка.ПолучитьОбъект();
		ЗначениеВРеквизитФормы(СправочникОбъект, "ШаблонАнкетыОбъект");
	Иначе
		СправочникОбъект = Справочники.ШаблоныАнкет.СоздатьЭлемент();
		ЗначениеВРеквизитФормы(СправочникОбъект, "ШаблонАнкетыОбъект");
		ЗаполнитьШаблонАнкетыДемоТекстами();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОткрытыеВопросы()
	
	ТаблицаОткрытыеВопросы.Очистить();
	
	Для Каждого Строка Из Объект.ОткрытыеВопросы Цикл
		ДанныеВопроса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Строка.Вопрос, "Наименование, Обязательный, ЭлементарныйВопрос");
		НовыйВопрос = ТаблицаОткрытыеВопросы.Добавить();
		НовыйВопрос.Формулировка = ДанныеВопроса.Наименование;
		НовыйВопрос.Обязательный = ДанныеВопроса.Обязательный;
		НовыйВопрос.ЭлементарныйВопрос = ДанныеВопроса.ЭлементарныйВопрос;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыФормы()

	ЗаполнитьВторичныеРеквизитыСотрудниковРеспондентов();
	
	ЗаполнитьСтатусОпроса();
	
	ЗаполнитьШаблонСообщения();
	ЗаполнитьШаблонСообщенияТекст(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатусОпроса()

	НайденныеОшибки = Неопределено;
	Сведения = Новый Структура;
	
	// Проверка шаблонов
	Если ЗначениеЗаполнено(ШаблонАнкетыОбъект.Заголовок) Тогда
		Сведения.Вставить("ШаблонАнкетыЗаполнен", Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
			"ШаблонАнкетыОбъект",
			НСтр("ru = 'Не заполнена анкета'"),"");
		Сведения.Вставить("ШаблонАнкетыЗаполнен", Ложь);
	КонецЕсли;
	
	// Проверка характеристик
	Сведения.Вставить("ВыбраныХарактеристики", Истина);
	Если Объект.Характеристики.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки, "Характеристики",
			НСтр("ru = 'Не выбрана ни одна характеристика'"),"");
		Сведения.ВыбраныХарактеристики = Ложь;
	КонецЕсли;
	
	Сведения.Вставить("ЕдинаяШкалаХарактеристик", Истина);
	СведенияОЕдинойШкалеХарактеристик(Сведения, НайденныеОшибки);
	
	// Проверка состава
	// Проверка участников
	Сведения.Вставить("УчастникиЗаполнены", Истина);
	Сведения.Вставить("УчастникиЗаполненыСОшибками", Ложь);
	Сведения.Вставить("ДублиУчастников", Ложь);

	Если Объект.Оцениваемые.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
			"Объект.Оцениваемые",
			НСтр("ru = 'Не заполнен ни один оцениваемый'"),"");
		Сведения.УчастникиЗаполнены = Ложь;
	КонецЕсли;
	
	МассивУчастников = Новый Массив;
	Для Каждого СтрокаУчастников Из Объект.Оцениваемые Цикл
		Если Не ЗначениеЗаполнено(СтрокаУчастников.ФизическоеЛицо) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
				"Объект.Оцениваемые[%1].ФизическоеЛицо",
				НСтр("ru = 'Не заполнен участник.'"),"",
				Объект.Оцениваемые.Индекс(СтрокаУчастников));
			Сведения.УчастникиЗаполненыСОшибками = Истина;
		КонецЕсли;
		Если МассивУчастников.Найти(СтрокаУчастников.ФизическоеЛицо) <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
				"Объект.Оцениваемые[%1].ФизическоеЛицо",
				НСтр("ru = 'Один из участников указан дважды.'"),"",
				Объект.Оцениваемые.Индекс(СтрокаУчастников));
			Сведения.ДублиУчастников = Истина;
		КонецЕсли;
		МассивУчастников.Добавить(СтрокаУчастников.ФизическоеЛицо);
	КонецЦикла;
	
	// Проверка респондентов
	Сведения.Вставить("РеспондентыЗаполнены", Истина);
	Сведения.Вставить("ДублиРеспондентов", Ложь);
	Сведения.Вставить("РеспондентыЗаполненыСОшибками", Ложь);
	ДополнитьСведенияПоОценивающим(Сведения, НайденныеОшибки);
	
	// Открытые вопросы
	Сведения.Вставить("ФормулировкаРазделаЗаполнена", Истина);
	Сведения.Вставить("ФормулировкиВопросовЗаполненыСОшибками", Ложь);
	ДополнитьСведенияПоОткрытымВопросам(Сведения, НайденныеОшибки);
	
	// Заполнение состояния опроса
	МассивПустыхНазначенийОпросов = Объект.Оцениваемые.НайтиСтроки(Новый Структура("НазначениеОпроса",Документы.НазначениеОпросов.ПустаяСсылка()));
	Сведения.Вставить("АнкетированиеНачато", НЕ МассивПустыхНазначенийОпросов.Количество()= Объект.Оцениваемые.Количество());
	Сведения.Вставить("МероприятиеЗавершено", Объект.ДатаОкончания < ДатаАктуальности);
	
	// Запишем в реквизиты
	СведенияОбОпросе = Новый ФиксированнаяСтруктура(Сведения);
	ОшибкиЗаполненияОпроса = НайденныеОшибки;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуМастераАнкетыПоРазделам()
	
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("ШаблонАнкеты", Объект.ШаблонАнкеты);
	ОткрытьФорму("ОбщаяФорма.МастерАнкетыПоРазделам", СтруктураПараметры, ЭтотОбъект);
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТЧЭксперты()

	ЗаполнитьТЧФизическимиЛицамиИзОбъекта("ОценивающиеЭксперты");
	ЗаполнитьТЧВидомEmail("ОценивающиеЭксперты", Объект.ВидКонтактнойИнформацииОценивающиеЭксперты);
	
	ЗаполнитьТЧЭкспертыПользователями();
	ЗаполнитьТЧУволенныеЭксперты();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧОцениваемые()

	ЗаполнитьТЧФизическимиЛицамиИзОбъекта("Сотрудники");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧФизическимиЛицамиИзОбъекта(ИмяТаблицы)

	Если ИмяТаблицы = "ОценивающиеЭксперты" Тогда
		Если Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.Индивидуальное") Тогда
			ТаблицаОбъект = Объект.ОценивающиеЭксперты;
		Иначе
			ТаблицаОбъект = Объект.ОценивающиеЭкспертыЕдиныйНабор;
		КонецЕсли;
		ИмяПоляФизическоеЛицо = "ОценивающийЭксперт";
	ИначеЕсли ИмяТаблицы = "Сотрудники" Тогда
		ТаблицаОбъект = Объект.Оцениваемые;
		ИмяПоляФизическоеЛицо = "ФизическоеЛицо";
	Иначе
		Возврат;
	КонецЕсли;
	
	ТаблицаРеквизит = ЭтотОбъект[ИмяТаблицы];
	
	ТаблицаРеквизит.Очистить();
	
	МассивФизическихЛиц = ТаблицаОбъект.Выгрузить(, ИмяПоляФизическоеЛицо).ВыгрузитьКолонку(ИмяПоляФизическоеЛицо);
	
	Для Каждого ФизическоеЛицо Из МассивФизическихЛиц Цикл
		Если ФизическоеЛицо = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТаблицаРеквизит.НайтиСтроки(Новый Структура(ИмяПоляФизическоеЛицо, ФизическоеЛицо)).Количество() = 0 Тогда
			НоваяСтрока = ТаблицаРеквизит.Добавить();
			НоваяСтрока[ИмяПоляФизическоеЛицо] = ФизическоеЛицо;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьАнкетированиеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		НачалоАнкетированияНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьШаблонПриглашенияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		НастройкаШаблонаАнкеты();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоАнкетированияНаКлиенте()

	ОчиститьСообщения();

	Если Не ЗадаватьВопросПриСтартеОпроса() Тогда
		НачалоАнкетированияНаКлиентеПродолжение();
		Возврат;
	КонецЕсли;

	ТекстВопроса = НСтр("ru = 'Для экспертов без доступа в программу будут созданы пользователи ИБ и выполнена рассылка приглашений. Продолжить?'");
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Истина;
	ПараметрыВопроса.ТекстФлажка = НСтр("ru = 'Больше не спрашивать'");
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Начать анкетирование'");
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗавершитьВопросПередНачаломАнкетирования", ЭтотОбъект), 
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		ПараметрыВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоАнкетированияНаКлиентеПродолжение()
	
	ЗаполнитьСтатусОпроса();
	ПроверитьЗаполнениеНаСервере();
	
	Если Не ОпросЗаполненВерно(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьОпросНаСервере(Истина);
	
	ОтправитьПриглашенияПриСтартеОпроса();
	ПриПолученииДанныхНаСервере();
	ОбновитьОписаниеСостоянияМероприятия();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВопросПередНачаломАнкетирования(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = Неопределено Или Ответ.Значение = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ.БольшеНеЗадаватьЭтотВопрос Тогда
		СохранитьЗадаватьВопросПриСтартеОпроса(Ложь);
	КонецЕсли;
	
	НачалоАнкетированияНаКлиентеПродолжение();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗадаватьВопросПриСтартеОпроса()
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		Метаданные.Справочники.ОпросыПоКомпетенциям.Формы.ФормаЭлемента.ПолноеИмя(), 
		"ЗадаватьВопросПриСтартеОпроса", 
		Истина);
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьЗадаватьВопросПриСтартеОпроса(ЗадаватьВопрос)

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		Метаданные.Справочники.ОпросыПоКомпетенциям.Формы.ФормаЭлемента.ПолноеИмя(), 
		"ЗадаватьВопросПриСтартеОпроса", 
		ЗадаватьВопрос);

КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеНаСервере()

	СправочникОбъект = РеквизитФормыВЗначение("Объект");
	ОбъектЗаполненоВерно = СправочникОбъект.ПроверитьЗаполнение();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОпросЗаполненВерно(Форма)

	ОпросЗаполненоВерно = Форма.ОбъектЗаполненоВерно И (Форма.ОшибкиЗаполненияОпроса = Неопределено);
	
	Если Форма.ОшибкиЗаполненияОпроса <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Форма.ОшибкиЗаполненияОпроса);
	КонецЕсли; 
	
	Возврат ОпросЗаполненоВерно;
	
КонецФункции

&НаСервере
Процедура НачалоАнкетированияНаСервере()

	// Сохраняем шаблон анкеты и создаем опросы
	ЗаписатьШаблонАнкеты();
	СоздатьОпросы();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьОпросы()

	Для Каждого Оцениваемый Из Объект.Оцениваемые Цикл
		
		Если ЗначениеЗаполнено(Оцениваемый.НазначениеОпроса) Тогда
			// Опрос существует обновляем список респондентов и другие поля
			НазначениеОпросаОбъект = Оцениваемый.НазначениеОпроса.ПолучитьОбъект();
		Иначе
			// Создаем документ Назначение опроса
			НазначениеОпросаОбъект = Документы.НазначениеОпросов.СоздатьДокумент();
			НазначениеОпросаОбъект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;
		
		НазначениеОпросаОбъект.ПоказыватьВАрхивеАнкет = Истина;
		НазначениеОпросаОбъект.ШаблонАнкеты = Объект.ШаблонАнкеты;
		НазначениеОпросаОбъект.ТипРеспондентов = Справочники.Пользователи.ПустаяСсылка();
		НазначениеОпросаОбъект.ДатаНачала = Объект.ДатаНачала;
		НазначениеОпросаОбъект.ДатаОкончания = Объект.ДатаОкончания;
		НазначениеОпросаОбъект.ВозможностьПредварительногоСохранения = Истина;
		НазначениеОпросаОбъект.СвободныйОпрос = Ложь;
		НазначениеОпросаОбъект.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 для сотрудника %2'"),
			Объект.Наименование,
			Оцениваемый.ФизическоеЛицо);
		ОценивающиеЭкспертыСотрудника = ОценивающиеЭкспертыСотрудника(Оцениваемый.ФизическоеЛицо);
		Для Каждого СтрокаЭксперт Из ОценивающиеЭкспертыСотрудника Цикл
			СтрокаРеспондент = НазначениеОпросаОбъект.Респонденты.Добавить();
			СтрокаЭксперт = ОценивающиеЭксперты.НайтиСтроки(Новый Структура("ОценивающийЭксперт", СтрокаЭксперт.ОценивающийЭксперт));
			СтрокаРеспондент.Респондент = СтрокаЭксперт[0].ИмяПользователяИБ;
		КонецЦикла;
		
		Попытка 
			НазначениеОпросаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось назначить опрос для оценки сотрудника %1 по причине: %2'"),
					Строка(Оцениваемый.ФизическоеЛицо),
					ИнформацияОбОшибке().Описание));
		КонецПопытки;
		
		Оцениваемый.НазначениеОпроса = НазначениеОпросаОбъект.Ссылка;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОценивающиеЭкспертыСотрудника(Сотрудник)

	Если Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.Индивидуальное") Тогда
		Возврат Объект.ОценивающиеЭксперты.Выгрузить(Новый Структура("ФизическоеЛицо", Сотрудник), "ОценивающийЭксперт")	
	ИначеЕсли Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех") Тогда
		Возврат Объект.ОценивающиеЭкспертыЕдиныйНабор.Выгрузить(, "ОценивающийЭксперт")	
	КонецЕсли;	

КонецФункции

&НаКлиенте
Процедура ОбновитьОписаниеСостоянияМероприятия()
	
	ТекстИнформацииТекущаяСтадия = "";
	ЦветТекстаИнформации = ЦветаНадписей["ПоясняющийТекст"]; 
	
	Если СведенияОбОпросе.МероприятиеЗавершено Тогда 
		ТекстИнформацииТекущаяСтадия = НСтр("ru = 'Прием анкет завершен. Можно продлить анкетирование или перейти к анализу результатов'");
	Иначе
		ЦветТекстаИнформации = ЦветаНадписей["Желтый"]; 
		Если СведенияОбОпросе.АнкетированиеНачато Тогда
			ТекстИнформацииТекущаяСтадия =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Идет процесс приема анкет. Анкетирование завершается %1'"), Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yy"));
		Иначе
			ТекстИнформацииТекущаяСтадия = НСтр("ru = 'Анкетирование не начато'");
		КонецЕсли;
		// Правильно ли выполнена настройка:
		// - участников (заполнены ли участники).
		Если НЕ СведенияОбОпросе.УчастникиЗаполнены Тогда
			//	* нет участников
			ДополнитьТекстИнформации(НСтр("ru = 'Список участников не заполнен'"));
			ЦветТекстаИнформации = ЦветаНадписей["Красный"];
		Иначе
			Если СведенияОбОпросе.ДублиУчастников Тогда
				//	* корректно ли заполнены участники
				ДополнитьТекстИнформации(НСтр("ru = 'Список участников заполнен с ошибками'"));
				ЦветТекстаИнформации = ЦветаНадписей["Красный"];
			КонецЕсли;
			Если НЕ СведенияОбОпросе.РеспондентыЗаполнены Тогда
				//	* для всех ли участников есть респонденты
				ДополнитьТекстИнформации(НСтр("ru = 'Для одного или нескольких сотрудников не заполнен список экспертов'"));
				ЦветТекстаИнформации = ЦветаНадписей["Красный"];
			Иначе
				Если СведенияОбОпросе.ДублиРеспондентов Тогда
					//	* корректно ли заполнены респонденты
					ДополнитьТекстИнформации(НСтр("ru = 'Списки экспертов заполнены с ошибками'"));
					ЦветТекстаИнформации = ЦветаНадписей["Красный"];
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// шаблоны
		Если Не СведенияОбОпросе.ШаблонАнкетыЗаполнен Тогда
			ДополнитьТекстИнформации(НСтр("ru = 'Не заполнен заголовок анкеты'"));	
			ЦветТекстаИнформации = ЦветаНадписей["Красный"];
		КонецЕсли;
		//	* выбраны характеристики
		Если Не СведенияОбОпросе.ВыбраныХарактеристики Тогда
			ДополнитьТекстИнформации(НСтр("ru = 'Не выбраны характеристики для оценки персонала'"));	
			ЦветТекстаИнформации = ЦветаНадписей["Красный"];
		Иначе
			//	* одинаковая шкала оценки
			Если Не СведенияОбОпросе.ЕдинаяШкалаХарактеристик Тогда
				ДополнитьТекстИнформации(НСтр("ru = 'У выбранных характеристик разная шкала оценки'"));	
				ЦветТекстаИнформации = ЦветаНадписей["Красный"];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ТекстИнформацииТекущаяСтадия.ЦветТекста = ЦветТекстаИнформации;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьТекстИнформации(Сообщение)
	
	ТекстИнформацииТекущаяСтадия = ТекстИнформацииТекущаяСтадия + Символы.ПС + Сообщение;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦветаНадписей()

	ЦветаНадписейСтруктура = Новый Структура;
	ЦветаНадписейСтруктура.Вставить("Красный", ЦветаСтиля.ПоясняющийОшибкуТекст);
	ЦветаНадписейСтруктура.Вставить("Желтый", ЦветаСтиля.ЗаблокированныйРеквизитЦвет);
	ЦветаНадписейСтруктура.Вставить("Зеленый", ЦветаСтиля.ГруппаВариантовОтчетовЦвет);
	ЦветаНадписейСтруктура.Вставить("Синий", ЦветаСтиля.ГиперссылкаЦвет);
	ЦветаНадписейСтруктура.Вставить("Бордовый", ЦветаСтиля.УдаленныеСтроки);
	ЦветаНадписейСтруктура.Вставить("Черный", ЦветаСтиля.ЦветТекстаФормы);
	ЦветаНадписейСтруктура.Вставить("Серый", ЦветаСтиля.ЦветРамки);
	ЦветаНадписейСтруктура.Вставить("ПоясняющийТекст", ЦветаСтиля.ПоясняющийТекст);
	
	ЦветаНадписей = Новый ФиксированнаяСтруктура(ЦветаНадписейСтруктура);

КонецПроцедуры

&НаСервере
Процедура ДополнитьСведенияПоОценивающим(Сведения, НайденныеОшибки)

	МассивРеспондентов = Новый ТаблицаЗначений;
	МассивРеспондентов.Колонки.Добавить("ОценивающийЭксперт");
	
	Если Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех Тогда
		НаименованиеТаблицы = "Объект.ОценивающиеЭкспертыЕдиныйНабор";
		ФизическоеЛицоПолеОшибки = "Объект.ОценивающиеЭкспертыЕдиныйНабор[%1].ОценивающийЭксперт";
	ИначеЕсли Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.Индивидуальное Тогда
		НаименованиеТаблицы = "Объект.ОценивающиеЭксперты";
		ФизическоеЛицоПолеОшибки = "Объект.Оцениваемые[%1].ФизическоеЛицо";
		МассивРеспондентов.Колонки.Добавить("ФизическоеЛицо");
	Иначе
		Возврат;
	КонецЕсли;
	
	ПроверяемаяТаблица = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, НаименованиеТаблицы);
	
	Если ПроверяемаяТаблица.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
			НаименованиеТаблицы,
			НСтр("ru = 'Не заполнен ни один эксперт'"),"");
		Сведения.РеспондентыЗаполнены = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаРеспондентов Из ПроверяемаяТаблица Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаРеспондентов.ОценивающийЭксперт) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
				ФизическоеЛицоПолеОшибки,
				НСтр("ru = 'Не заполнен один из экспертов.'"),"",
				ИндексСтрокиДляОшибкиОценивающих(СтрокаРеспондентов));
			Сведения.РеспондентыЗаполненыСОшибками = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаРеспондентов.РольЭксперта) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
				ФизическоеЛицоПолеОшибки,
				НСтр("ru = 'Не заполнена роль одного из экспертов.'"),"",
				ИндексСтрокиДляОшибкиОценивающих(СтрокаРеспондентов));
			Сведения.РеспондентыЗаполненыСОшибками = Истина;
		КонецЕсли;
		Если ЕстьДублиРеспондентов(МассивРеспондентов, СтрокаРеспондентов) Тогда
			Если Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.Индивидуальное") Тогда
				НомерСтроки = Объект.Оцениваемые.Индекс(Объект.Оцениваемые.НайтиСтроки(Новый Структура("ФизическоеЛицо",СтрокаРеспондентов.ФизическоеЛицо))[0]);
			Иначе
				НомерСтроки = 0;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
				"Объект.Оцениваемые[%1].ФизическоеЛицо",
				НСтр("ru = 'Один из экспертов указан дважды.'"),"",
				НомерСтроки);
			Сведения.ДублиРеспондентов = Истина;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(МассивРеспондентов.Добавить(), СтрокаРеспондентов);
	КонецЦикла;
	
	Если Сведения.РеспондентыЗаполнены Тогда
		Если Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.Индивидуальное Тогда
			Для Каждого СтрокаУчастников Из Объект.Оцениваемые Цикл
				НайденныеСтроки = Объект.ОценивающиеЭксперты.НайтиСтроки(Новый Структура("ФизическоеЛицо",СтрокаУчастников.ФизическоеЛицо));
				Если НайденныеСтроки.Количество() = 0 Тогда
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
						"Объект.Оцениваемые[%1].ФизическоеЛицо",
						НСтр("ru = 'Не заполнен один из экспертов.'"),"",
						Объект.Оцениваемые.Индекс(СтрокаУчастников));
					Сведения.РеспондентыЗаполнены = Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьСведенияПоОткрытымВопросам(Сведения, НайденныеОшибки)
	
	Если Не Объект.ИспользоватьОткрытыеВопросы Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ФормулировкаРазделаОткрытыхВопросов) Тогда
		Сведения.ФормулировкаРазделаЗаполнена = Ложь;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
			"Объект.ФормулировкаРазделаОткрытыхВопросов",
			НСтр("ru = 'Не заполнена формулировка раздела с открытыми вопросами.'"),"");
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаОткрытыеВопросы Цикл
		Если Не ЗначениеЗаполнено(Строка.Формулировка) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки,
				"ТаблицаОткрытыеВопросы[%1].Формулировка",
				НСтр("ru = 'Не заполнена формулировка открытого вопроса.'"),"",
				ТаблицаОткрытыеВопросы.Индекс(Строка));
			Сведения.ФормулировкиВопросовЗаполненыСОшибками = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СведенияОЕдинойШкалеХарактеристик(Сведения, НайденныеОшибки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХарактеристикиПерсонала.ШкалаЗначений КАК ШкалаЗначений
		|ИЗ
		|	ПланВидовХарактеристик.ХарактеристикиПерсонала КАК ХарактеристикиПерсонала
		|ГДЕ
		|	ХарактеристикиПерсонала.Ссылка В(&МассивХарактеристик)
		|
		|СГРУППИРОВАТЬ ПО
		|	ХарактеристикиПерсонала.ШкалаЗначений";
	Запрос.УстановитьПараметр("МассивХарактеристик", 
		Объект.Характеристики.Выгрузить( , "Характеристика").ВыгрузитьКолонку("Характеристика"));
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(НайденныеОшибки, "Объект.Характеристики",
			НСтр("ru = 'В опросе указаны характеристики с разной шкалой оценки.'"),"");
		Сведения.ЕдинаяШкалаХарактеристик = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИндексСтрокиДляОшибкиОценивающих(СтрокаРеспондентов)

	Если Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех") Тогда
		Возврат Объект.ОценивающиеЭкспертыЕдиныйНабор.Индекс(СтрокаРеспондентов);
	ИначеЕсли Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.Индивидуальное") Тогда
		Возврат Объект.ОценивающиеЭксперты.Индекс(Объект.Оцениваемые.НайтиСтроки(Новый Структура("ФизическоеЛицо",СтрокаРеспондентов.ФизическоеЛицо))[0]);
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ЕстьДублиРеспондентов(МассивРеспондентов, СтрокаРеспондентов)
	
	Если Не ЗначениеЗаполнено(Объект.СпособЗаполненияЭкспертов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура("ОценивающийЭксперт", СтрокаРеспондентов.ОценивающийЭксперт);
	Если Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.Индивидуальное") Тогда
		СтруктураОтбора.Вставить("ФизическоеЛицо", СтрокаРеспондентов.ФизическоеЛицо);
	КонецЕсли;
	УжеЕстьРеспонденты = МассивРеспондентов.НайтиСтроки(СтруктураОтбора);
	
	Возврат (УжеЕстьРеспонденты.Количество() > 0);
	
КонецФункции

