&НаКлиенте
Процедура ОцениваемыеАктуализироватьОценивающихНаКлиенте(Элемент)

	УстановитьТекстЗаголовкаГруппыИндивидуальныхОценивающих(Элемент);
	УстановитьОтборСтрокОценивающиеИндивидуальные(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокОценивающиеИндивидуальные(Элемент)

	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Элементы.ОценивающиеЭксперты.ОтборСтрок = Неопределено;
		Возврат;
	КонецЕсли;

	АктивизированноеФизическоеЛицо = Элемент.ТекущиеДанные.ФизическоеЛицо;
	Элементы.ОценивающиеЭксперты.ОтборСтрок = Новый ФиксированнаяСтруктура("ФизическоеЛицо", Элемент.ТекущиеДанные.ФизическоеЛицо);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекстЗаголовкаГруппыИндивидуальныхОценивающих(Элемент)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущиеДанные.ФизическоеЛицо) Тогда
		ТекстЗаголовкаГруппыИндивидуальныхОценивающих = 
			СтрШаблон(НСтр("ru = 'Эксперты (оценивающие %1)'"),
			ФИОСотрудникаВВинительномПадеже(ТекущиеДанные.ФизическоеЛицо));
	Иначе		
		ТекстЗаголовкаГруппыИндивидуальныхОценивающих = НСтр("ru = 'Эксперты'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ФИОСотрудникаВВинительномПадеже(ФизическоеЛицо)
	
	ЭлементФИОСотрудника = ФИОФизическогоЛицаВинительныйПадежКеш.НайтиПоЗначению(ФизическоеЛицо);
	Если ЭлементФИОСотрудника = Неопределено Тогда
		ФИОСотрудника = ФИОСотрудникаВВинительномПадежеНаСервере(ФизическоеЛицо);
		ФИОФизическогоЛицаВинительныйПадежКеш.Добавить(ФизическоеЛицо, ФИОСотрудника);
	Иначе
		ФИОСотрудника = ЭлементФИОСотрудника.Представление;
	КонецЕсли;
	
	Возврат ФИОСотрудника;
	
КонецФункции

&НаСервереБезКонтекста
Функция ФИОСотрудникаВВинительномПадежеНаСервере(ФизическоеЛицо)
	Возврат СклонениеПредставленийОбъектов.ПросклонятьФИО(ФизическоеЛицо, 4);
КонецФункции

&НаСервере
Процедура ДобавитьВыбранныхСотрудников(ВыбранныеСотрудники)

	Для каждого ВыбранныйСотрудник Из ВыбранныеСотрудники Цикл
		НайденныеФизлица = Объект.Оцениваемые.НайтиСтроки(Новый Структура("ФизическоеЛицо",ВыбранныйСотрудник.ФизическоеЛицо));
		Если НайденныеФизлица.Количество()=0 Тогда
			НовыйУчастник = Объект.Оцениваемые.Добавить();
			НовыйУчастник.ФизическоеЛицо = ВыбранныйСотрудник.ФизическоеЛицо;
		КонецЕсли; 
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура ДобавитьВыбранныхЭкспертов(ВыбранныеЭксперты)
	
	Для Каждого ВыбранныйЭксперт Из ВыбранныеЭксперты Цикл
		НайденныеЭксперты = Объект.ОценивающиеЭксперты.НайтиСтроки(
			Новый Структура("ФизическоеЛицо, ОценивающийЭксперт", АктивизированноеФизическоеЛицо, ВыбранныйЭксперт.ФизическоеЛицо));
		Если НайденныеЭксперты.Количество() = 0 Тогда
			НовыйУчастник = Объект.ОценивающиеЭксперты.Добавить();
			НовыйУчастник.ФизическоеЛицо = АктивизированноеФизическоеЛицо;
			НовыйУчастник.ОценивающийЭксперт = ВыбранныйЭксперт.ФизическоеЛицо;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВыбранныхЭкспертовЕдиныйНабор(ВыбранныеЭксперты)

	Для каждого ВыбранныйЭксперт Из ВыбранныеЭксперты Цикл
		НайденныеФизлица = Объект.ОценивающиеЭкспертыЕдиныйНабор.НайтиСтроки(Новый Структура("ОценивающийЭксперт",ВыбранныйЭксперт.ФизическоеЛицо));
		Если НайденныеФизлица.Количество()=0 Тогда
			НовыйУчастник = Объект.ОценивающиеЭкспертыЕдиныйНабор.Добавить();
			НовыйУчастник.ОценивающийЭксперт = ВыбранныйЭксперт.ФизическоеЛицо;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура АктивироватьСтрокуОцениваемых()

	Если Объект.Оцениваемые.Количество() > 0 Тогда
		Элементы.Оцениваемые.ТекущаяСтрока = Объект.Оцениваемые[0].ПолучитьИдентификатор();
		ОцениваемыеАктуализироватьОценивающихНаКлиенте(Элементы.Оцениваемые);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УдалитьЭкспертовФизлица(ФизическоеЛицо)
	
	Если Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех") Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = Объект.ОценивающиеЭксперты.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Объект.ОценивающиеЭксперты.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПолеКоллекцииПоУсловию(Коллекция, Поле, Значение, Условие)
	
	НайденныеСтроки = Коллекция.НайтиСтроки(Условие);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		НайденнаяСтрока[Поле] = Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПолеФизлицоТаблицыЭксперты(БылоФизлицо, СталоФизлицо)
	
	Если Объект.СпособЗаполненияЭкспертов = ПредопределенноеЗначение("Перечисление.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПолеКоллекцииПоУсловию(Объект.ОценивающиеЭксперты, "ФизическоеЛицо", СталоФизлицо, Новый Структура("ФизическоеЛицо", БылоФизлицо));	
	
КонецПроцедуры

&НаКлиенте
Процедура ОценивающиеЭкспертыПередНачаломДобавленияНаКлиенте(Элемент, Отказ)

	ОтборПоФизлицуЗаполнен = Элемент.ОтборСтрок <> Неопределено И ЗначениеЗаполнено(Элемент.ОтборСтрок["ФизическоеЛицо"]);
	Если Не ОтборПоФизлицуЗаполнен Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Не выбран оцениваемый сотрудник'"));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОценивающиеЭкспертыПередОкончаниемРедактированияНаКлиенте(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)

	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	Если НоваяСтрока Тогда
		Если Не ЗначениеЗаполнено(Элемент.ОтборСтрок) Тогда
			Возврат;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Элемент.ТекущиеДанные, Элемент.ОтборСтрок);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыСотрудниковРеспондентов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОпросыПоКомпетенциямОцениваемые.ФизическоеЛицо КАК Сотрудник,
		|	НазначениеОпросовРеспонденты.Респондент.ФизическоеЛицо КАК Респондент,
		|	КОЛИЧЕСТВО(НазначениеОпросовРеспонденты.Респондент) КАК Анкет,
		|	СУММА(ВЫБОР
		|			КОГДА Анкета.Проведен
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК АнкетЗавершено,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ Анкета.Проведен
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК АнкетВРаботе,
		|	СУММА(ВЫБОР
		|			КОГДА Анкета.Ссылка ЕСТЬ NULL
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК АнкетНеНачато
		|ПОМЕСТИТЬ СтатистикаАнкет
		|ИЗ
		|	Документ.НазначениеОпросов.Респонденты КАК НазначениеОпросовРеспонденты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОпросыПоКомпетенциям.Оцениваемые КАК ОпросыПоКомпетенциямОцениваемые
		|		ПО НазначениеОпросовРеспонденты.Ссылка = ОпросыПоКомпетенциямОцениваемые.НазначениеОпроса
		|			И (ОпросыПоКомпетенциямОцениваемые.Ссылка = &Опрос)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Анкета КАК Анкета
		|		ПО НазначениеОпросовРеспонденты.Ссылка = Анкета.Опрос
		|			И НазначениеОпросовРеспонденты.Респондент = Анкета.Респондент
		|
		|СГРУППИРОВАТЬ ПО
		|	ОпросыПоКомпетенциямОцениваемые.ФизическоеЛицо,
		|	НазначениеОпросовРеспонденты.Респондент.ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтатистикаАнкет.Респондент КАК ОценивающийЭксперт,
		|	СУММА(СтатистикаАнкет.Анкет) КАК Анкет,
		|	СУММА(СтатистикаАнкет.АнкетЗавершено) КАК АнкетЗавершено,
		|	СУММА(СтатистикаАнкет.АнкетВРаботе) КАК АнкетВРаботе,
		|	СУММА(СтатистикаАнкет.АнкетНеНачато) КАК АнкетНеНачато
		|ИЗ
		|	СтатистикаАнкет КАК СтатистикаАнкет
		|
		|СГРУППИРОВАТЬ ПО
		|	СтатистикаАнкет.Респондент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтатистикаАнкет.Сотрудник КАК Сотрудник,
		|	СУММА(СтатистикаАнкет.Анкет) КАК Анкет,
		|	СУММА(СтатистикаАнкет.АнкетЗавершено) КАК АнкетЗавершено,
		|	СУММА(СтатистикаАнкет.АнкетВРаботе) КАК АнкетВРаботе,
		|	СУММА(СтатистикаАнкет.АнкетНеНачато) КАК АнкетНеНачато
		|ИЗ
		|	СтатистикаАнкет КАК СтатистикаАнкет
		|
		|СГРУППИРОВАТЬ ПО
		|	СтатистикаАнкет.Сотрудник";
	
	Запрос.УстановитьПараметр("Опрос", Объект.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ЗаполнитьВторичныеРеквизитыЭкспертов(РезультатыЗапроса[РезультатыЗапроса.Количество() - 2]);
	ЗаполнитьВторичныеРеквизитыСотрудников(РезультатыЗапроса[РезультатыЗапроса.Количество() - 1]);
	
	ЗаполнитьИнформациюОбОтправке();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыСотрудников(РезультатЗапроса)

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НайденныеСтроки = Сотрудники.НайтиСтроки(Новый Структура("ФизическоеЛицо", Выборка.Сотрудник));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока, Выборка);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыЭкспертов(РезультатЗапроса)
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НайденныеСтроки = ОценивающиеЭксперты.НайтиСтроки(Новый Структура("ОценивающийЭксперт", Выборка.ОценивающийЭксперт));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока, Выборка);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаШаблонаАнкеты()

	Если Не ЗаписатьОпросНаКлиенте() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ШаблонСообщения) Тогда
		// Создаем новый шаблон.
		ШаблонСообщения = НовыйШаблонПриглашения();
		Если ШаблонСообщения = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", ШаблонСообщения);
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбновитьШаблонСообщенияТекст", ЭтотОбъект);
	ОткрытьФорму("Справочник.ШаблоныСообщений.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,,,, ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйШаблонПриглашения()
	
	НаименованиеШаблона = СтрШаблон(НСтр("ru = 'Приглашение для участия в опросе по компетенциям'"));
	
	ПараметрыШаблона = ШаблоныСообщений.ОписаниеПараметровШаблона();
	ПараметрыШаблона.Вставить("ВладелецШаблона",
		Перечисления.ИспользованиеШаблоновСообщенийПриОценкеПерсонала.ЭкспертнаяОценка);
	ПараметрыШаблона.Вставить("ПолноеИмяТипаНазначения", "Справочник.ФизическиеЛица");
	ПараметрыШаблона.Вставить("Служебный", Истина);
	
	// Заполняем демотекстами
	ДемоТексты = ЭкспертнаяОценкаПерсонала.ДемонстрационныеТекстыШаблоныСообщений();
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыШаблона, ДемоТексты, Истина);
	
	НовыйШаблон = ШаблоныСообщений.СоздатьШаблон(НаименованиеШаблона, ПараметрыШаблона);
	
	Возврат НовыйШаблон;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьШаблонСообщенияТекст(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	ЗаполнитьШаблонСообщенияТекст(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьШаблонСообщенияТекст(Форма)
	
	Если ЗначениеЗаполнено(Форма.ШаблонСообщения) Тогда
		Форма.ШаблонСообщенияТекст = ТекстШаблонаПисьма(Форма.ШаблонСообщения);
	Иначе
		ДемоТексты = ДемонстрационныеТекстыШаблоныСообщений();
		Форма.ШаблонСообщенияТекст = СтроковыеФункцииКлиентСервер.ИзвлечьТекстИзHTML(ДемоТексты.Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстШаблонаПисьма(ШаблонСообщения)
	
	СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШаблонСообщения, "ТекстШаблонаПисьма, ТекстШаблонаПисьмаHTML");
	Если ЗначениеЗаполнено(СтруктураРеквизитов.ТекстШаблонаПисьма) Тогда
		Возврат СтруктураРеквизитов.ТекстШаблонаПисьма;
	Иначе
		Возврат СтроковыеФункцииКлиентСервер.ИзвлечьТекстИзHTML(СтруктураРеквизитов.ТекстШаблонаПисьмаHTML);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДемонстрационныеТекстыШаблоныСообщений()
	Возврат ЭкспертнаяОценкаПерсонала.ДемонстрационныеТекстыШаблоныСообщений();
КонецФункции

&НаСервере
Процедура ЗаполнитьШаблонСообщения()
	
	ПараметрыШаблона = ШаблоныСообщений.ПараметрыШаблона(
		Перечисления.ИспользованиеШаблоновСообщенийПриОценкеПерсонала.ЭкспертнаяОценка);
	ШаблонСообщения = ПараметрыШаблона.Ссылка;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВидыEmail()

	ВидыEmail.Очистить();
	
	ТаблицаВидовКонтактнойИнформацией = УправлениеКонтактнойИнформацией.ВидыКонтактнойИнформацииОбъекта(
		ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка"));
		
	СтрокиEmail = ТаблицаВидовКонтактнойИнформацией.НайтиСтроки(Новый Структура("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты")));
	Для каждого СтрокаEmail Из СтрокиEmail Цикл
		ВидыEmail.Добавить(СтрокаEmail.Ссылка, СтрокаEmail.Наименование);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СформироватьПодменюВидовEmail(ИмяПоля)
	
	Если ВидыEmail.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаПодменю = Элементы.Найти(ИмяПоля + "ВидыEmailГруппа");
	Если ГруппаПодменю = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ВидEmail Из ВидыEmail Цикл
		
		ИндексВида = ВидыEmail.Индекс(ВидEmail);
		
		Если Элементы.Найти(ИмяПоля + "ВидEmail_" + ИндексВида) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяКоманда = Команды.Добавить(ИмяПоля + "УстановитьВидEmail_" + ИндексВида);
		НоваяКоманда.Действие = "Подключаемый_" + ИмяПоля + "УстановитьВидEmail";
		НоваяКоманда.ИзменяетСохраняемыеДанные = Истина;
		
		ЭлементКнопкаПодменю = Элементы.Добавить(ИмяПоля + "ВидEmail_" + ИндексВида, Тип("КнопкаФормы"), ГруппаПодменю);
		ЭлементКнопкаПодменю.Вид                   = ВидКнопкиФормы.КнопкаКоманднойПанели;
		ЭлементКнопкаПодменю.ИмяКоманды            = НоваяКоманда.Имя;
		ЭлементКнопкаПодменю.Заголовок             = ВидEmail.Представление;
		ЭлементКнопкаПодменю.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
		
	КонецЦикла;
	
	ТекущееЗначениеКонтактнойИнформации = Объект["ВидКонтактнойИнформации" + ИмяПоля];
	Если ЗначениеЗаполнено(ТекущееЗначениеКонтактнойИнформации) Тогда
		УстановитьПометкуВПодменюВидКонтактнойИнформации(ЭтотОбъект, ИмяПоля, ВидыEmail.Индекс(ВидыEmail.НайтиПоЗначению(ТекущееЗначениеКонтактнойИнформации)));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПометкуВПодменюВидКонтактнойИнформации(Форма, Поле, ИндексВида)

	Для каждого ВидEmail Из Форма.ВидыEmail Цикл
		ЭлементУправления = Форма.Элементы.Найти(Поле + "ВидEmail_" + Форма.ВидыEmail.Индекс(ВидEmail));
		Если ЭлементУправления <> Неопределено Тогда
			ЭлементУправления.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла; 
	
	ЭлементУправления = Форма.Элементы.Найти(Поле + "ВидEmail_" + ИндексВида);
	Если ЭлементУправления <> Неопределено Тогда
		ЭлементУправления.Пометка = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидEmail(Поле, ИндексВида)
	
	Объект["ВидКонтактнойИнформации" + Поле] = ВидыEmail[ИндексВида].Значение;
	УстановитьПометкуВПодменюВидКонтактнойИнформации(ЭтотОбъект, Поле, ИндексВида);
	ЗаполнитьТЧВидомEmail(Поле, ВидыEmail[ИндексВида].Значение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧВидомEmail(ИмяТаблицы, ВидКонтактнойИнформации, ФизическоеЛицо = Неопределено)

	Если ИмяТаблицы = "ОценивающиеЭксперты" Тогда
		ИмяПоляФизическоеЛицо = "ОценивающийЭксперт";
	ИначеЕсли ИмяТаблицы = "Сотрудники" Тогда
		ИмяПоляФизическоеЛицо = "ФизическоеЛицо";
	Иначе
		Возврат;
	КонецЕсли;
	ТаблицаРеквизит = ЭтотОбъект[ИмяТаблицы];
	
	Если ТаблицаРеквизит.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ФизическоеЛицо = Неопределено Тогда
		ТаблицаФизическихЛиц = ТаблицаРеквизит.Выгрузить();
	Иначе
		ТаблицаФизическихЛиц = ТаблицаРеквизит.Выгрузить(Новый Структура(ИмяПоляФизическоеЛицо, ФизическоеЛицо));
	КонецЕсли;
	МассивФизическихЛиц = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаФизическихЛиц.ВыгрузитьКолонку(ИмяПоляФизическоеЛицо));
	Если МассивФизическихЛиц.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	
	ЭкспертнаяОценкаПерсонала.ПриЗаполненииЭлектроннойПочтыЭкспертов(ЭтотОбъект, МассивФизическихЛиц, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	УправлениеКонтактнойИнформацией.СоздатьВТКонтактнаяИнформация(
		Запрос.МенеджерВременныхТаблиц,
		МассивФизическихЛиц,,
		ВидКонтактнойИнформации);
		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаФизическихЛиц.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ ВТФизическиеЛица
		|ИЗ
		|	&ТаблицаФизическихЛиц КАК ТаблицаФизическихЛиц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФизическиеЛица.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ЕСТЬNULL(ВТКонтактнаяИнформация.Представление, """") КАК АдресЭП
		|ИЗ
		|	ВТФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКонтактнаяИнформация КАК ВТКонтактнаяИнформация
		|		ПО ФизическиеЛица.ФизическоеЛицо = ВТКонтактнаяИнформация.Объект";

	Запрос.УстановитьПараметр("ТаблицаФизическихЛиц", ТаблицаФизическихЛиц);
	
	Если ИмяПоляФизическоеЛицо = "ОценивающийЭксперт" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаФизическихЛиц.ФизическоеЛицо КАК ФизическоеЛицо", "ТаблицаФизическихЛиц.ОценивающийЭксперт КАК ФизическоеЛицо");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокиФизическогоЛица = ТаблицаРеквизит.НайтиСтроки(Новый Структура(ИмяПоляФизическоеЛицо, Выборка.ФизическоеЛицо));
		Для Каждого СтрокаФизическогоЛица Из СтрокиФизическогоЛица Цикл
			СтрокаФизическогоЛица.АдресЭП = Выборка.АдресЭП;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПриглашенияНаКлиенте(ОтправлятьВсем = Ложь)
	
	Если Не СведенияОбОпросе.АнкетированиеНачато Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Анкетирование не начато, отправка приглашений невозможна'"));
		Возврат;
	КонецЕсли;
	
	Ошибки = Неопределено;
	
	ОчиститьСообщения();
	
	Если ОтправлятьВсем Тогда
		КоллекцияРеспондентов = ОценивающиеЭксперты;
	Иначе
		КоллекцияРеспондентов = Элементы.Эксперты.ВыделенныеСтроки;
	КонецЕсли;
	
	// Подготовка респондентов
	МассивСтруктурРеспондентов = Новый Массив;
	Для каждого ВыбраннаяСтрока Из КоллекцияРеспондентов Цикл
		ТекущиеДанные = ?(ОтправлятьВсем, ВыбраннаяСтрока, ОценивающиеЭксперты.НайтиПоИдентификатору(ВыбраннаяСтрока));
		
		МожноОтправлятьПриглашение = Истина;
		Если Не ЗначениеЗаполнено(ТекущиеДанные.АдресЭП) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"ОценивающиеЭксперты[%1].АдресЭП",
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнен адрес электронной почты у эксперта ""%1""'"), ТекущиеДанные.ОценивающийЭксперт),
				"", ОценивающиеЭксперты.Индекс(ТекущиеДанные));
			МожноОтправлятьПриглашение = Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ИмяПользователяИБ) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"Респонденты[%1].ИмяПользователяИБ",
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для эксперта ""%1"" отсутствует учетная запись для входа в систему.'"), ТекущиеДанные.ОценивающийЭксперт),
				"", ОценивающиеЭксперты.Индекс(ТекущиеДанные));
			МожноОтправлятьПриглашение = Ложь;
		КонецЕсли;
			
		Если Не МожноОтправлятьПриглашение Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураРеспондента = Новый Структура;
		СтруктураРеспондента.Вставить("ФизическоеЛицо", ТекущиеДанные.ОценивающийЭксперт);
		СтруктураРеспондента.Вставить("Адрес", ТекущиеДанные.АдресЭП);
		СтруктураРеспондента.Вставить("ИмяПользователяИБ", ТекущиеДанные.ИмяПользователяИБ);
		СтруктураРеспондента.Вставить("ОтправкаУспешно", Истина);
		МассивСтруктурРеспондентов.Добавить(СтруктураРеспондента);
	
	КонецЦикла; 
	
	// Отправка приглашений
	ОтправитьПриглашения(МассивСтруктурРеспондентов);
	
	Если Не Ошибки = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПриглашения(МассивСтруктурРеспондентов)

	Если Не ВозможноОтправлятьЭлектроннуюПочту() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отправка электронной почты невозможна'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ШаблонСообщения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Заполните, пожалуйста, текст приглашения'"));
		Возврат;
	КонецЕсли;
	
	// Подготавливает финальные тексты из шаблона приглашения,
	// отсылает их адресатам,
	// записывает даты отправки.
	ПодготовитьТекстыПриглашенийИОтправитьАдресатам(МассивСтруктурРеспондентов);
	
	// Проверка результатов отправки
	Отправлено = 0;
	НеОтправлено = 0;
	// Формируем сообщения о доставленных и недоставленных
	Для каждого СтрокаРеспондента Из МассивСтруктурРеспондентов Цикл
		Если СтрокаРеспондента.ОтправкаУспешно Тогда
			Отправлено = Отправлено + 1;
		Иначе
			НеОтправлено = НеОтправлено + 1;
		КонецЕсли;
	КонецЦикла;
	
	// Сообщаем.
	Если Отправлено = 0 Тогда
		ТекстОповещения = НСтр("ru = 'Не удалось отправить сообщения.'");
		КартинкаОповещения = БиблиотекаКартинок.Ошибка32;
	ИначеЕсли НеОтправлено = 0 Тогда
		ТекстОповещения = НСтр("ru = 'Все сообщения успешно отправлены.'");
		КартинкаОповещения = БиблиотекаКартинок.Успешно32;
	Иначе
		ТекстОповещения = СтрШаблон(НСтр("ru = 'Отправлено %1, не отправлено %2.'"), Отправлено, НеОтправлено);
		КартинкаОповещения = БиблиотекаКартинок.Предупреждение32;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Отправка приглашений'"), , ТекстОповещения, КартинкаОповещения);
		
	// Обновляем информацию на форме
	ЗаполнитьИнформациюОбОтправке();

КонецПроцедуры

&НаСервере
Процедура ПодготовитьТекстыПриглашенийИОтправитьАдресатам(МассивСтруктурРеспондентов)

	// Добавим сотрудников
	ТаблицаСотрудников = ТаблицаСотрудниковИФизлиц(
		ОбщегоНазначения.ВыгрузитьКолонку(МассивСтруктурРеспондентов, "ФизическоеЛицо", Истина));
	
	УдачноОтправлены = Новый Массив;
	
	Для Каждого ПриглашаемыйРеспондент Из МассивСтруктурРеспондентов Цикл
		// Формируем параметры для процедуры подставляющей их в текст шаблонов
		ПередаваемыеПараметры = Новый Структура;
		ПередаваемыеПараметры.Вставить("ПроизвольныеПараметры", Новый Соответствие);
		ПередаваемыеПараметры.Вставить("ПараметрыСообщения", Новый Структура);
		ПередаваемыеПараметры.Вставить("ПользовательИБ", ПриглашаемыйРеспондент.ИмяПользователяИБ);
		
		ПараметрыШаблонаСообщений = ШаблоныСообщений.ТаблицаПараметров();
		ШаблоныСообщений.ДобавитьПараметрШаблона(ПараметрыШаблонаСообщений, "Получатель", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"), Истина, НСтр("ru = 'Получатель'"));
		ШаблоныСообщений.ДобавитьПараметрШаблона(ПараметрыШаблонаСообщений, "Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"), Истина, НСтр("ru = 'Сотрудник'"));
		
		Для Каждого ПараметрПриглашения Из ПараметрыШаблонаСообщений Цикл
			ТипПараметраШаблона = ПараметрПриглашения.ОписаниеТипа.Типы()[0];
			Если ТипПараметраШаблона = Тип("СправочникСсылка.ФизическиеЛица") Тогда
				ПередаваемыеПараметры.Вставить(ПараметрПриглашения.ИмяПараметра, ПриглашаемыйРеспондент.ФизическоеЛицо);
			ИначеЕсли ТипПараметраШаблона = Тип("СправочникСсылка.Пользователи") Тогда
				ПередаваемыеПараметры.Вставить(ПараметрПриглашения.ИмяПараметра, ПриглашаемыйРеспондент.ИмяПользователяИБ);
			ИначеЕсли ТипПараметраШаблона = Тип("СправочникСсылка.Сотрудники") Тогда
				НайденныйСотрудник = ТаблицаСотрудников.НайтиСтроки(Новый Структура("ФизическоеЛицо", ПриглашаемыйРеспондент.ФизическоеЛицо));
				ПередаваемыеПараметры.Вставить(ПараметрПриглашения.ИмяПараметра,?(НайденныйСотрудник.Количество()>0, НайденныйСотрудник[0].Сотрудник, Справочники.Сотрудники.ПустаяСсылка()));
			КонецЕсли;
		КонецЦикла;
		
		ЭкспертнаяОценкаПерсонала.ЗаполнитьПараметрМероприятияОценкиШаблонаСообщения(ПередаваемыеПараметры.ПараметрыСообщения, Объект);
		ЭкспертнаяОценкаПерсонала.ЗаполнитьРеквизитШаблонаВебСсылкаАнкетирования(ПередаваемыеПараметры);
		ЭкспертнаяОценкаПерсонала.ДобавитьПереопределениеПолучателейСообщения(ПередаваемыеПараметры, ПриглашаемыйРеспондент);
		
		// Отправляем приглашение
		РезультатОтправки = ШаблоныСообщений.СформироватьСообщениеИОтправить(ШаблонСообщения, ПриглашаемыйРеспондент.ФизическоеЛицо, УникальныйИдентификатор, ПередаваемыеПараметры);
		ПриглашаемыйРеспондент.ОтправкаУспешно = Не ЗначениеЗаполнено(РезультатОтправки.ОписаниеОшибки);

		// Удачных сохраняем для последующего протоколирования
		Если ПриглашаемыйРеспондент.ОтправкаУспешно Тогда
			УдачноОтправлены.Добавить(ПриглашаемыйРеспондент.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;
	// Протоколируем
	Если УдачноОтправлены.Количество() > 0 Тогда
		ЗаписатьИнформациюОбОтправкеСообщений(УдачноОтправлены);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВозможноОтправлятьЭлектроннуюПочту()

	Возврат РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();

КонецФункции

&НаСервере
Процедура ЗаполнитьТЧЭкспертыПользователями()
	
	Если ОценивающиеЭксперты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ОценивающиеЭксперты Цикл
		Строка.ИмяПользователяИБ = ФизическиеЛицаЗарплатаКадры.ПользовательФизическогоЛица(
			Строка.ОценивающийЭксперт);
		Если Не ЗначениеЗаполнено(Строка.ИмяПользователяИБ) Тогда
			Строка.СообщениеОбОшибке = НСтр("ru = 'Нет учетной записи.'");
		Иначе
			Строка.СообщениеОбОшибке = "";
		КонецЕсли;
		Строка.НедозаполненнаяСтрока = (Не ЗначениеЗаполнено(Строка.ИмяПользователяИБ));
	КонецЦикла;
	
	ЭкспертнаяОценкаПерсонала.ПриЗаполненииПользователейЭкспертов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧУволенныеЭксперты()
	
	Если ОценивающиеЭксперты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.СписокФизическихЛиц = ОценивающиеЭксперты.Выгрузить().ВыгрузитьКолонку("ОценивающийЭксперт");
	ПараметрыПолучения.НачалоПериода = Объект.ДатаНачала;
	ПараметрыПолучения.ОкончаниеПериода = Объект.ДатаОкончания;
	ПараметрыПолучения.КадровыеДанные = "Состояние, СостояниеПериодРегистрации";
	УстановитьПривилегированныйРежим(Истина);
	СотрудникиОрганизации = КадровыйУчет.СотрудникиОрганизации(Ложь, ПараметрыПолучения);
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не ЗначениеЗаполнено(СотрудникиОрганизации) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Эксперт Из ОценивающиеЭксперты Цикл
		НайденныеСтроки = СотрудникиОрганизации.НайтиСтроки(Новый Структура("ФизическоеЛицо", Эксперт.ОценивающийЭксперт));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		НайденнаяСтрока = НайденныеСтроки[0];
		Если НайденнаяСтрока.Состояние = Перечисления.СостоянияСотрудника.Увольнение Тогда
			Эксперт.СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Не работает с %1'"),
				Формат(НайденнаяСтрока.СостояниеПериодРегистрации, "ДЛФ=D"));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПользовательскиеНастройкиОтчетаЭкспертнойОценки(УстанавливаемыйОтбор)
	
	ОтчетОбъект = Отчеты.РезультатыОпросовПоКомпетенциям.Создать();
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(
		ОтчетОбъект.СхемаКомпоновкиДанных.ВариантыНастроек.Найти(УстанавливаемыйОтбор.КлючВарианта).Настройки);
		
	ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОпросПоКомпетенциям", УстанавливаемыйОтбор.ОпросПоКомпетенциям);	
	
	Для Каждого ЭлементОтбора Из ОтчетОбъект.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ФизическоеЛицо") Тогда
			ЭлементОтбора.ПравоеЗначение = УстанавливаемыйОтбор.ФизическоеЛицо;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьВидыКонтактнойИнформации()
	ЗаполнитьВидКонтактнойИнформации("ОценивающиеЭксперты");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВидКонтактнойИнформации(ИмяПоля)

	ПредлагаемоеЗначение = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователя",
		"ИспользуемыйВидКонтактнойИнформации" + ИмяПоля,
		ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыКонтактнойИнформации.EMailФизическиеЛица"));
		
	ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПредлагаемоеЗначение, "Используется, ПометкаУдаления");
	
	Если ВидыEmail.НайтиПоЗначению(ПредлагаемоеЗначение) = Неопределено Тогда //вид из настроек уже не используется
		Если ВидыEmail.Количество() > 0 Тогда
			Объект["ВидКонтактнойИнформации" + ИмяПоля] = ВидыEmail[0].Значение;
		КонецЕсли;
	Иначе
		Объект["ВидКонтактнойИнформации" + ИмяПоля] = ПредлагаемоеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИнформациюОбОтправкеСообщений(Адресаты)
	
	ДатаВремяОтправки = ТекущаяДатаСеанса();
	
	Для Каждого Адресат Из Адресаты Цикл
		МенеджерЗаписи = РегистрыСведений.ПротоколыОтправкиСообщенийОпросовПоКомпетенциям.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Опрос = Объект.Ссылка;
		МенеджерЗаписи.Адресат = Адресат;
		МенеджерЗаписи.ДатаОтправки = ДатаВремяОтправки;
		СтрокаЭксперт = ОценивающиеЭксперты.НайтиСтроки(Новый Структура("ОценивающийЭксперт", Адресат));
		Если СтрокаЭксперт.Количество() > 0 Тогда
			МенеджерЗаписи.АдресЭлектроннойПочты = СтрокаЭксперт[0].АдресЭП;
		КонецЕсли;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнформациюОбОтправке()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПротоколыОтправкиСообщенийОпросовПоКомпетенциям.Адресат КАК Адресат,
		|	ПротоколыОтправкиСообщенийОпросовПоКомпетенциям.ДатаОтправки КАК ДатаОтправки,
		|	ПротоколыОтправкиСообщенийОпросовПоКомпетенциям.АдресЭлектроннойПочты
		|ИЗ
		|	РегистрСведений.ПротоколыОтправкиСообщенийОпросовПоКомпетенциям КАК ПротоколыОтправкиСообщенийОпросовПоКомпетенциям
		|ГДЕ
		|	ПротоколыОтправкиСообщенийОпросовПоКомпетенциям.Опрос = &Опрос";
	
	Запрос.УстановитьПараметр("Опрос", Объект.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Строки = ОценивающиеЭксперты.НайтиСтроки(Новый Структура("ОценивающийЭксперт",ВыборкаДетальныеЗаписи.Адресат));
		Для каждого СтрокаЭксперта Из Строки Цикл
			СтрокаЭксперта.ДатаОтправки = ВыборкаДетальныеЗаписи.ДатаОтправки;
			СтрокаЭксперта.АдресЭПОтправлено = ВыборкаДетальныеЗаписи.АдресЭлектроннойПочты;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВопросПоШкале(Характеристика, ВопросыШаблонаАнкеты)
	
	ШкалаЗначений = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Характеристика, "ШкалаЗначений");
	НаименованиеШкалы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШкалаЗначений, "Наименование");
	
	ЭлементарныйВопрос = ПланыВидовХарактеристик.ВопросыДляАнкетирования.СоздатьЭлемент();
	ЭлементарныйВопрос.Наименование = НаименованиеШкалы;
	ЭлементарныйВопрос.Формулировка = НаименованиеШкалы;
	ЭлементарныйВопрос.ТипОтвета = Перечисления.ТипыОтветовНаВопрос.ОдинВариантИз;
	ЭлементарныйВопрос.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ВариантыОтветовАнкет");
	ЭлементарныйВопрос.ВидПереключателя = Перечисления.ВидыПереключателяВАнкетах.Переключатель;
	ЭлементарныйВопрос.ТребуетсяКомментарий = Истина;
	ЭлементарныйВопрос.ПояснениеКомментария = НСтр("ru = 'Комментарий к оценке'");
	ЭлементарныйВопрос.Записать();
	
	ЗначенияШкалы = ЗначенияШкалы(ШкалаЗначений);
	
	Для Каждого ЗначениеШкалы Из ЗначенияШкалы Цикл
		Ответ = Справочники.ВариантыОтветовАнкет.СоздатьЭлемент();
		Ответ.Наименование = ЗначениеШкалы.Наименование;
		Ответ.Владелец = ЭлементарныйВопрос.Ссылка;
		Ответ.Подсказка = ЗначениеШкалы.Подсказка;
		Ответ.Записать();
	КонецЦикла;
	
	Возврат ЭлементарныйВопрос.Ссылка;
	
КонецФункции

&НаСервере
Функция ВопросПоТочномуЗначению(Характеристика)
	
	ШкалаЗначений = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Характеристика, "ШкалаЗначений");
	НаименованиеШкалы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШкалаЗначений, "Наименование");
	
	ЗначенияШкалы = ЗначенияШкалы(ШкалаЗначений);
	КоличествоЗначений = ЗначенияШкалы.Количество();
	
	ЭлементарныйВопрос = ПланыВидовХарактеристик.ВопросыДляАнкетирования.СоздатьЭлемент();
	ЭлементарныйВопрос.Наименование = НаименованиеШкалы;
	ЭлементарныйВопрос.Формулировка = НаименованиеШкалы;
	ЭлементарныйВопрос.Длина = 5;
	ЭлементарныйВопрос.Точность = 2;
	ЭлементарныйВопрос.ТипОтвета = Перечисления.ТипыОтветовНаВопрос.Число;
	ЭлементарныйВопрос.ИспользоватьМинимальноеЗначение = Истина;
	ЭлементарныйВопрос.ИспользоватьМаксимальноеЗначение = Истина;
	ЭлементарныйВопрос.МинимальноеЗначение = ЗначенияШкалы[0].ЧисловоеЗначение;
	ЭлементарныйВопрос.МаксимальноеЗначение = ЗначенияШкалы[КоличествоЗначений - 1].ЧисловоеЗначение;
	ЭлементарныйВопрос.ПоказыватьПолосуРегулирования = Истина;
	ЭлементарныйВопрос.ШагПолосыРегулирования = 0.5;
	ЭлементарныйВопрос.ТребуетсяКомментарий = Истина;
	ЭлементарныйВопрос.ПояснениеКомментария = НСтр("ru = 'Комментарий к оценке'");
	ЭлементарныйВопрос.ВыводитьПодсказкуУЧисловыхВопросов = Истина;
	
	Для Каждого ЗначениеШкалы Из ЗначенияШкалы Цикл
		НоваяСтрока = ЭлементарныйВопрос.ДиапазонПодсказокЧисловогоВопроса.Добавить();
		НоваяСтрока.ЗначениеДо = ЗначениеШкалы.ЧисловоеЗначение;
		НоваяСтрока.Подсказка = ЗначениеШкалы.Подсказка;
	КонецЦикла;
	
	ЭлементарныйВопрос.Записать();
	
	Возврат ЭлементарныйВопрос.Ссылка;
	
КонецФункции

&НаСервере
Функция КатегорииХарактеристикВОпросе()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХарактеристикиПерсонала.Категория КАК Категория
		|ИЗ
		|	ПланВидовХарактеристик.ХарактеристикиПерсонала КАК ХарактеристикиПерсонала
		|ГДЕ
		|	ХарактеристикиПерсонала.Ссылка В(&МассивХарактеристик)
		|	И ХарактеристикиПерсонала.Категория <> ЗНАЧЕНИЕ(Справочник.КатегорииХарактеристикПерсонала.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ХарактеристикиПерсонала.Категория";
	Запрос.УстановитьПараметр("МассивХарактеристик", 
		Объект.Характеристики.Выгрузить( , "Характеристика").ВыгрузитьКолонку("Характеристика"));
		
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Категория");
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОчисткеОцениваемых(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Объект.Подразделение = ПрежнееПодразделение;
		Возврат;
	КонецЕсли;
	
	Объект.Оцениваемые.Очистить();
	Объект.ОценивающиеЭксперты.Очистить();
	ПрежнееПодразделение = Объект.Подразделение;
	ПереформироватьСотрудников = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДатеНачала(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаПоДатеНачала = Ложь;
	УстановитьВидимостьПредупрежденияДатаНачалаНеНаступила();
	УстановитьДоступностьКомандАнкетирования();
КонецПроцедуры

&НаКлиенте
Процедура ПродлитьОпросЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПродлениеОпроса();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если ЗаписатьОпросНаКлиенте() Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродлениеОпроса()
	
	ОчиститьСообщения();
	
	ЗаполнитьСтатусОпроса();
	
	ПроверитьЗаполнениеНаСервере();
	
	Если ОпросЗаполненВерно(ЭтотОбъект) Тогда
		// Открываем форму продления
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьПродлениеОпроса",ЭтотОбъект);
		ПараметрыФормы = Новый Структура("ДатаНачала,ДатаОкончания", Объект.ДатаНачала,Объект.ДатаОкончания);
		ОткрытьФорму("Справочник.ОпросыПоКомпетенциям.Форма.ФормаПродленияОпроса",
			ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПродлениеОпроса(НоваяДатаОкончания, ДополнительныеПараметры) Экспорт

	Если Не НоваяДатаОкончания = Неопределено Тогда
		Объект.ДатаОкончания = НоваяДатаОкончания;
		Если ЗаписатьОпросНаКлиенте() Тогда
			ПеренестиДатуОкончанияОпросов(Объект.Ссылка, НоваяДатаОкончания);
			ЗаполнитьСтатусОпроса();
			УстановитьСвойстваЭлементовФормы();
			ОбновитьОписаниеСостоянияМероприятия();
			ПриПолученииДанныхНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПеренестиДатуОкончанияОпросов(Опрос, ДатаОкончания)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НазначениеОпросов.Ссылка КАК Опрос
		|ИЗ
		|	Справочник.ОпросыПоКомпетенциям.Оцениваемые КАК ОпросыПоКомпетенциямОцениваемые
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НазначениеОпросов КАК НазначениеОпросов
		|		ПО ОпросыПоКомпетенциямОцениваемые.НазначениеОпроса = НазначениеОпросов.Ссылка
		|			И (ОпросыПоКомпетенциямОцениваемые.Ссылка = &Опрос)";
	
	Запрос.УстановитьПараметр("Опрос", Опрос);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НазначениеОпросовОбъект = Выборка.Опрос.ПолучитьОбъект();
		НазначениеОпросовОбъект.ДатаОкончания = ДатаОкончания;
		Попытка
			НазначениеОпросовОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось перенести опрос %1 по причине %2'"),Выборка.Опрос,ИнформацияОбОшибке().Описание));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьПользователейЭкспертов()
	
	ЭкспертыБезПользователей = Новый Массив;
	ЭкспертыСПользователями = Новый Массив;
	
	Для Каждого Эксперт Из ОценивающиеЭксперты Цикл
		Если НЕ ЗначениеЗаполнено(Эксперт.ИмяПользователяИБ) Тогда
			Эксперт.ИмяПользователяИБ = ФизическиеЛицаЗарплатаКадры.ПользовательФизическогоЛица(Эксперт.ОценивающийЭксперт);
		КонецЕсли;
		Если ЗначениеЗаполнено(Эксперт.ИмяПользователяИБ) Тогда
			ЭкспертыСПользователями.Добавить(Эксперт.ИмяПользователяИБ);
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Эксперт.АдресЭП) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'У эксперта %1 не заполнен адрес электронной почты'"),
			Эксперт.ОценивающийЭксперт);
		КонецЕсли;
		ДанныеЭксперта = Новый Структура("ФизическоеЛицо, АдресЭлектроннойПочты");
		ДанныеЭксперта.Вставить("ФизическоеЛицо", Эксперт.ОценивающийЭксперт);
		ДанныеЭксперта.Вставить("АдресЭлектроннойПочты", Эксперт.АдресЭП);
		ЭкспертыБезПользователей.Добавить(ДанныеЭксперта);
	КонецЦикла;

	// если пользователя нет - создаем и отправляем письмо с логином и паролем
	ЭкспертнаяОценкаПерсонала.СозданиеПользователейЭкспертов(ЭкспертыБезПользователей);
	// если пользователь есть, проверяем на вхождение в группу доступа "Эксперты" и по необходимости включаем в неё
	ЭкспертнаяОценкаПерсонала.ВключитьПользователейВГруппуДоступаЭксперты(ЭкспертыСПользователями);
	// если пользователь есть, но нейдествителен - отключаем флажок
	ЭкспертнаяОценкаПерсонала.УстановитьАутентификациюПользователей(ЭкспертыСПользователями);
	
	ЗаполнитьТЧЭкспертыПользователями();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаполненияЭкспертов()

	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗаполненияОценивающиеИндивидуальные",ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВключатьРольСамооценка", Ложь);
	ПараметрыФормы.Вставить("АдресСотрудниковВХранилище", АдресСотрудниковВХранилище());
	
	ОткрытьФорму("Справочник.МероприятияОценкиПерсонала.Форма.ФормаЗаполненияРеспондентов",
		ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОценивающиеИндивидуальные(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПослеЗаполненияОценивающиеИндивидуальныеНаСервере(РезультатЗакрытия);
	АктивироватьСтрокуОцениваемых();
	
	Модифицированность = Истина;
	ПереформироватьЭкспертов = Истина;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаполненияОценивающиеИндивидуальныеНаСервере(АдресХранилища)
	
	ЗагрузитьЭкспертовИзХранилища(АдресХранилища);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЭкспертовИзХранилища(РезультатЗакрытия)

	ТаблицаЭкспертов = ПолучитьИзВременногоХранилища(РезультатЗакрытия);
	ТаблицаЭкспертов.Колонки.Респондент.Имя = "ОценивающийЭксперт";
	ТаблицаЭкспертов.Колонки.РольРеспондента.Имя = "РольЭксперта";
	Объект.ОценивающиеЭксперты.Загрузить(ТаблицаЭкспертов);

КонецПроцедуры

&НаСервере
Функция АдресСотрудниковВХранилище()
	
	Возврат ПоместитьВоВременноеХранилище(Объект.Оцениваемые.Выгрузить(), УникальныйИдентификатор);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтборИзПодразделения(Подразделение)

	ОтборИзПодразделения = Новый Структура;
	Источник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "Источник");
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Организации") Тогда
		ОтборИзПодразделения.Вставить("Организация", Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		ОтборИзПодразделения.Вставить("Подразделение", Источник);
		ОтборИзПодразделения.Вставить("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ГоловнаяОрганизация"));
	КонецЕсли;
	
	Возврат ОтборИзПодразделения

КонецФункции

&НаКлиенте
Процедура ОтправитьПриглашенияПриСтартеОпроса()
	
	МассивСтруктурЭкспертов = Новый Массив;
	
	Для Каждого Эксперт Из ОценивающиеЭксперты Цикл
		
		СтруктураЭксперта = Новый Структура;
		СтруктураЭксперта.Вставить("ФизическоеЛицо", Эксперт.ОценивающийЭксперт);
		СтруктураЭксперта.Вставить("Адрес", Эксперт.АдресЭП);
		СтруктураЭксперта.Вставить("ИмяПользователяИБ", Эксперт.ИмяПользователяИБ);
		СтруктураЭксперта.Вставить("ОтправкаУспешно", Истина);
		МассивСтруктурЭкспертов.Добавить(СтруктураЭксперта);
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ШаблонСообщения) Тогда
		// Создаем новый шаблон.
		ШаблонСообщения = НовыйШаблонПриглашения();
	КонецЕсли;
	
	ОтправитьПриглашения(МассивСтруктурЭкспертов);
	
КонецПроцедуры

&НаКлиенте
Функция ЗаписатьОпросНаКлиенте(НачалоАнкетирования = Ложь)
	
	НовыйЭлемент = Не ЗначениеЗаполнено(Объект.Ссылка);
	
	ОпросЗаписан = ЗаписатьОпросНаСервере(НачалоАнкетирования);
	Если ОпросЗаписан Тогда
		Если НовыйЭлемент Тогда
			ОповеститьОЗаписиНового(Объект.Ссылка);
		Иначе
			ОповеститьОбИзменении(Объект.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОпросЗаписан;
	
КонецФункции

&НаСервере
Функция ТребуетсяАктуализроватьВопросыВАнкете()
	
	ПерезаполнитьВопросыВАнкете = Ложь;
	
	Для Каждого СтрокаХарактеристика Из Объект.Характеристики Цикл
		Вопрос = ВопросХарактеристики(СтрокаХарактеристика.Характеристика);
		Если ЗначениеЗаполнено(Вопрос) И ВопросХарактеристикиИзменился(СтрокаХарактеристика.Характеристика, Вопрос) Тогда
			ПерезаполнитьВопросыВАнкете = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПерезаполнитьВопросыВАнкете;
	
КонецФункции

&НаСервере
Функция ЕстьАнкетыВОпросе()
	
	Опросы = Объект.Оцениваемые.Выгрузить().ВыгрузитьКолонку("НазначениеОпроса");
	
	Если Опросы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Анкета.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Анкета КАК Анкета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НазначениеОпросов КАК НазначениеОпросов
		|		ПО Анкета.Опрос = НазначениеОпросов.Ссылка
		|ГДЕ
		|	НазначениеОпросов.Ссылка В (&Опросы)";
	Запрос.УстановитьПараметр("Опросы", Опросы);
	Результат = Запрос.Выполнить();
	
	Возврат Не Результат.Пустой();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьУчастников()
	
	ОцениваемыеПриЧтении.Очистить();
	ЭкспертыПриЧтении.Очистить();
	ЭкспертыЕдиныйНаборПриЧтении.Очистить();
	ОценивающиеЭкспертыПриЧтении.Очистить();
	
	Если СведенияОбОпросе.АнкетированиеНачато Тогда
		ОцениваемыеПриЧтении.Загрузить(Объект.Оцениваемые.Выгрузить());
		Если Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех Тогда
			ЭкспертыЕдиныйНаборПриЧтении.Загрузить(Объект.ОценивающиеЭкспертыЕдиныйНабор.Выгрузить());
		Иначе
			ЭкспертыПриЧтении.Загрузить(Объект.ОценивающиеЭксперты.Выгрузить());
		КонецЕсли;
		ОценивающиеЭкспертыПриЧтении.Загрузить(ОценивающиеЭксперты.Выгрузить());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИзменениеУчастников(НачалоАнкетирования)
	
	Если НачалоАнкетирования Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СведенияОбОпросе.АнкетированиеНачато Тогда
		Возврат;
	КонецЕсли;
	
	ВключенныеОцениваемые = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		Объект.Оцениваемые.Выгрузить(, "ФизическоеЛицо").ВыгрузитьКолонку("ФизическоеЛицо"),
		ОцениваемыеПриЧтении.Выгрузить().ВыгрузитьКолонку("ФизическоеЛицо"));
	ИсключенныеОцениваемые = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		ОцениваемыеПриЧтении.Выгрузить().ВыгрузитьКолонку("ФизическоеЛицо"),
		Объект.Оцениваемые.Выгрузить(, "ФизическоеЛицо").ВыгрузитьКолонку("ФизическоеЛицо"));
	Если ВключенныеОцениваемые.Количество() > 0 Тогда
		ОбработатьВключениеОцениваемых(ВключенныеОцениваемые);
	КонецЕсли;
	Если ИсключенныеОцениваемые.Количество() > 0 Тогда
		ОбработатьИсключениеОцениваемых(ИсключенныеОцениваемые);
	КонецЕсли;
	
	Если Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех Тогда
		ВключенныеЭксперты = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
			Объект.ОценивающиеЭкспертыЕдиныйНабор.Выгрузить(, "ОценивающийЭксперт").ВыгрузитьКолонку("ОценивающийЭксперт"),
			ЭкспертыЕдиныйНаборПриЧтении.Выгрузить().ВыгрузитьКолонку("ОценивающийЭксперт"));
		ИсключенныеЭксперты = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
			ЭкспертыЕдиныйНаборПриЧтении.Выгрузить().ВыгрузитьКолонку("ОценивающийЭксперт"),
			Объект.ОценивающиеЭкспертыЕдиныйНабор.Выгрузить(, "ОценивающийЭксперт").ВыгрузитьКолонку("ОценивающийЭксперт"));
	Иначе
		ТЗЭксперты = Объект.ОценивающиеЭксперты.Выгрузить(, "ОценивающийЭксперт");
		ТЗЭксперты.Свернуть("ОценивающийЭксперт");
		ТЗЭкспертыПриЧтении = ЭкспертыПриЧтении.Выгрузить(, "ОценивающийЭксперт");
		ТЗЭкспертыПриЧтении.Свернуть("ОценивающийЭксперт");
		ВключенныеЭксперты = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
			ТЗЭксперты.ВыгрузитьКолонку("ОценивающийЭксперт"), ТЗЭкспертыПриЧтении.ВыгрузитьКолонку("ОценивающийЭксперт"));
		ИсключенныеЭксперты = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
			ТЗЭкспертыПриЧтении.ВыгрузитьКолонку("ОценивающийЭксперт"), ТЗЭксперты.ВыгрузитьКолонку("ОценивающийЭксперт"));
	КонецЕсли;
	Если ВключенныеЭксперты.Количество() > 0 Тогда
		ОбработатьВключениеЭкспертов(ВключенныеЭксперты);
	КонецЕсли;
	Если ИсключенныеЭксперты.Количество() > 0 Тогда
		ОбработатьИсключениеЭкспертов(ИсключенныеЭксперты);
	КонецЕсли;
	
	Если Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.Индивидуальное Тогда
		ОбработатьИзмененияЭкспертовОцениваемых();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВключениеОцениваемых(Оцениваемые)
	
	ЗаполнитьТЧОцениваемые();
	
	Для Каждого Оцениваемый Из Оцениваемые Цикл
		НайденныеОцениваемые = Объект.Оцениваемые.НайтиСтроки(
			Новый Структура("ФизическоеЛицо", Оцениваемый));
		Если НайденныеОцениваемые.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		НайденныйОцениваемый = НайденныеОцениваемые[0];
		ОпросНайден = Ложь;
		НаименованиеНазначенияОпроса = СтрШаблон(
			НСтр("ru = '%1 для сотрудника %2'"),
			Объект.Наименование,
			НайденныйОцениваемый.ФизическоеЛицо);
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	НазначениеОпросов.Ссылка КАК НазначениеОпроса
			|ИЗ
			|	Документ.НазначениеОпросов КАК НазначениеОпросов
			|ГДЕ
			|	НазначениеОпросов.Наименование = &Наименование
			|	И НазначениеОпросов.ШаблонАнкеты = &ШаблонАнкеты
			|	И НазначениеОпросов.ПометкаУдаления = ИСТИНА";
		Запрос.УстановитьПараметр("Наименование", НаименованиеНазначенияОпроса);
		Запрос.УстановитьПараметр("ШаблонАнкеты", Объект.ШаблонАнкеты);
		Результат = Запрос.Выполнить().Выгрузить();
		Если Результат.Количество() = 1 Тогда
			ОпросНайден = Истина;
			НазначениеОпросаОбъект = Результат[0].НазначениеОпроса.ПолучитьОбъект();
			НазначениеОпросаОбъект.УстановитьПометкуУдаления(Ложь);
		Иначе
			НазначениеОпросаОбъект = Документы.НазначениеОпросов.СоздатьДокумент();
			НазначениеОпросаОбъект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
			НазначениеОпросаОбъект.ПоказыватьВАрхивеАнкет = Истина;
			НазначениеОпросаОбъект.ШаблонАнкеты = Объект.ШаблонАнкеты;
			НазначениеОпросаОбъект.ТипРеспондентов = Справочники.Пользователи.ПустаяСсылка();
			НазначениеОпросаОбъект.ДатаНачала = Объект.ДатаНачала;
			НазначениеОпросаОбъект.ДатаОкончания = Объект.ДатаОкончания;
			НазначениеОпросаОбъект.ВозможностьПредварительногоСохранения = Истина;
			НазначениеОпросаОбъект.СвободныйОпрос = Ложь;
			НазначениеОпросаОбъект.Наименование = НаименованиеНазначенияОпроса;
		КонецЕсли;
		ОценивающиеЭкспертыСотрудника = ОценивающиеЭкспертыСотрудника(НайденныйОцениваемый.ФизическоеЛицо);
		Для Каждого СтрокаЭксперт Из ОценивающиеЭкспертыСотрудника Цикл
			СтрокаРеспондент = НазначениеОпросаОбъект.Респонденты.Добавить();
			СтрокаЭксперт = ОценивающиеЭксперты.НайтиСтроки(Новый Структура("ОценивающийЭксперт", СтрокаЭксперт.ОценивающийЭксперт));
			СтрокаРеспондент.Респондент = СтрокаЭксперт[0].ИмяПользователяИБ;
			
			Если ОпросНайден Тогда
				АктивироватьАнкетуЭксперта(НазначениеОпросаОбъект.Ссылка, СтрокаЭксперт[0].ИмяПользователяИБ);
			КонецЕсли;
			
		КонецЦикла;
		
		НазначениеОпросаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		НайденныйОцениваемый.НазначениеОпроса = НазначениеОпросаОбъект.Ссылка;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИсключениеОцениваемых(Оцениваемые)
	
	НайденныеОцениваемые = Новый Массив;
	
	Для Каждого Оцениваемый Из Оцениваемые Цикл
		НайденныеСтроки = ОцениваемыеПриЧтении.НайтиСтроки(
			Новый Структура("ФизическоеЛицо", Оцениваемый));
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеОцениваемые.Добавить(НайденныеСтроки[0]);
		КонецЕсли;
	КонецЦикла;
		
	НазначенияОпросов = Новый Массив;
	ЭкспертыНазначенияОпроса = Новый Массив;
		
	Для Каждого НайденныйОцениваемый Из НайденныеОцениваемые Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЭкспертыНазначенияОпроса,
			НайденныйОцениваемый.НазначениеОпроса.Респонденты.Выгрузить().ВыгрузитьКолонку("Респондент"));
		НазначенияОпросов.Добавить(НайденныйОцениваемый.НазначениеОпроса);
		
		НазначениеОпросаОбъект = НайденныйОцениваемый.НазначениеОпроса.ПолучитьОбъект();
		НазначениеОпросаОбъект.Респонденты.Очистить();
		НазначениеОпросаОбъект.Записать();
		НазначениеОпросаОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Анкета.Ссылка КАК Анкета
		|ИЗ
		|	Документ.Анкета КАК Анкета
		|ГДЕ
		|	Анкета.Проведен = ИСТИНА
		|	И Анкета.Опрос В (&Опросы)
		|	И Анкета.Респондент В(&Эксперты)";
	Запрос.УстановитьПараметр("Опросы", НазначенияОпросов);
	Запрос.УстановитьПараметр("Эксперты", ЭкспертыНазначенияОпроса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		АнкетаОбъект = Выборка.Анкета.ПолучитьОбъект();
		АнкетаОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВключениеЭкспертов(Эксперты)
	
	ЗаполнитьТЧЭксперты();
	СоздатьПользователейЭкспертов();
	ЗаполнитьИнформациюОбОтправке();
	ЗаполнитьВторичныеРеквизитыФормы();
	
	Для Каждого Эксперт Из Эксперты Цикл
		Если Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех Тогда
			Для Каждого Строка Из Объект.Оцениваемые Цикл
				ВключитьЭкспертаВОпрос(Эксперт, Строка.НазначениеОпроса);
			КонецЦикла;
		Иначе
			НайденныеЭксперты = Объект.ОценивающиеЭксперты.НайтиСтроки(
				Новый Структура("ОценивающийЭксперт", Эксперт));
			Для Каждого НайденныеЭксперт Из НайденныеЭксперты Цикл
				НайденныеОцениваемые = Объект.Оцениваемые.НайтиСтроки(
					Новый Структура("ФизическоеЛицо", НайденныеЭксперт.ФизическоеЛицо));
				Для Каждого НайденныйОцениваемый Из НайденныеОцениваемые Цикл
					ВключитьЭкспертаВОпрос(Эксперт, НайденныйОцениваемый.НазначениеОпроса);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВключитьЭкспертаВОпрос(Эксперт, НазначениеОпроса)
	
	Если Не ЗначениеЗаполнено(НазначениеОпроса) Тогда
		Возврат;
	КонецЕсли;
	
	НазначениеОпросаОбъект = НазначениеОпроса.ПолучитьОбъект();
	СтрокаРеспондент = НазначениеОпросаОбъект.Респонденты.Добавить();
	СтрокаЭксперт = ОценивающиеЭксперты.НайтиСтроки(
		Новый Структура("ОценивающийЭксперт", Эксперт));
	СтрокаРеспондент.Респондент = СтрокаЭксперт[0].ИмяПользователяИБ;
	НазначениеОпросаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	АктивироватьАнкетуЭксперта(НазначениеОпроса, СтрокаЭксперт[0].ИмяПользователяИБ);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИсключениеЭкспертов(Эксперты)
	
	Для Каждого Эксперт Из Эксперты Цикл
		Если Объект.СпособЗаполненияЭкспертов = Перечисления.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех Тогда
			Для Каждого Строка Из Объект.Оцениваемые Цикл
				ИсключитьЭкспертаИзОпроса(Эксперт, Строка.НазначениеОпроса);
			КонецЦикла;
		Иначе
			НайденныеЭксперты = ЭкспертыПриЧтении.НайтиСтроки(
				Новый Структура("ОценивающийЭксперт", Эксперт));
			Для Каждого НайденныеЭксперт Из НайденныеЭксперты Цикл
				НайденныеОцениваемые = Объект.Оцениваемые.НайтиСтроки(
					Новый Структура("ФизическоеЛицо", НайденныеЭксперт.ФизическоеЛицо));
				Для Каждого НайденныйОцениваемый Из НайденныеОцениваемые Цикл
					ИсключитьЭкспертаИзОпроса(Эксперт, НайденныйОцениваемый.НазначениеОпроса);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИсключитьЭкспертаИзОпроса(Эксперт, НазначениеОпроса)
	
	Если Не ЗначениеЗаполнено(НазначениеОпроса) Тогда
		Возврат;
	КонецЕсли;
	
	НазначениеОпросаОбъект = НазначениеОпроса.ПолучитьОбъект();
	СтрокаЭксперт = ОценивающиеЭкспертыПриЧтении.НайтиСтроки(
		Новый Структура("ОценивающийЭксперт", Эксперт));
	РеспондентОпроса = СтрокаЭксперт[0].ИмяПользователяИБ;
	СтрокиОпроса = НазначениеОпросаОбъект.Респонденты.НайтиСтроки(
		Новый Структура("Респондент", РеспондентОпроса));
	Для Каждого СтрокаОпроса Из СтрокиОпроса Цикл
		НазначениеОпросаОбъект.Респонденты.Удалить(СтрокаОпроса);
	КонецЦикла;
	НазначениеОпросаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	ДеактивироватьАнкетуЭксперта(НазначениеОпроса, РеспондентОпроса);
	
КонецПроцедуры

&НаСервере
Процедура АктивироватьАнкетуЭксперта(НазначениеОпроса, Эксперт)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Анкета.Ссылка КАК Анкета
		|ИЗ
		|	Документ.Анкета КАК Анкета
		|ГДЕ
		|	Анкета.ПометкаУдаления = ИСТИНА
		|	И Анкета.Опрос = &Опрос
		|	И Анкета.Респондент = &Эксперт";
	Запрос.УстановитьПараметр("Опрос", НазначениеОпроса);
	Запрос.УстановитьПараметр("Эксперт", Эксперт);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Строка = АнкетыКАктивации.Добавить();
		Строка.Анкета = Выборка.Анкета;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДеактивироватьАнкетуЭксперта(НазначениеОпроса, Эксперт)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Анкета.Ссылка КАК Анкета
		|ИЗ
		|	Документ.Анкета КАК Анкета
		|ГДЕ
		|	Анкета.Проведен = ИСТИНА
		|	И Анкета.Опрос = &Опрос
		|	И Анкета.Респондент = &Эксперт";
	Запрос.УстановитьПараметр("Опрос", НазначениеОпроса);
	Запрос.УстановитьПараметр("Эксперт", Эксперт);
	Выборка = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Истина);
	Пока Выборка.Следующий() Цикл
		АнкетаОбъект = Выборка.Анкета.ПолучитьОбъект();
		АнкетаОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура АктивироватьАнкетыЭкспертов()
	
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Строка Из АнкетыКАктивации Цикл
		АнкетаОбъект = Строка.Анкета.ПолучитьОбъект();
		АнкетаОбъект.УстановитьПометкуУдаления(Ложь);
		АнкетаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
	АнкетыКАктивации.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзмененияЭкспертовОцениваемых()

	Для Каждого Оцениваемый Из Объект.Оцениваемые Цикл
		ЭкспертыОпроса = Новый Массив;
		НайденныеЭксперты = Объект.ОценивающиеЭксперты.НайтиСтроки(
			Новый Структура("ФизическоеЛицо", Оцениваемый.ФизическоеЛицо));
		Для Каждого НайденныйЭксперт Из НайденныеЭксперты Цикл
			НайденныеПользователиЭкспертов = ОценивающиеЭксперты.НайтиСтроки(
				Новый Структура("ОценивающийЭксперт", НайденныйЭксперт.ОценивающийЭксперт));
			ЭкспертыОпроса.Добавить(НайденныеПользователиЭкспертов[0].ИмяПользователяИБ);
		КонецЦикла;
		ЭкспертыНазначения = Оцениваемый.НазначениеОпроса.Респонденты.Выгрузить().ВыгрузитьКолонку("Респондент");
		
		ВключенныеЭксперты = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ЭкспертыОпроса, ЭкспертыНазначения);
		ИсключенныеЭксперты = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ЭкспертыНазначения, ЭкспертыОпроса);
		
		Если ВключенныеЭксперты.Количество() = 0 И ИсключенныеЭксперты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НазначениеОпросаОбъект = Оцениваемый.НазначениеОпроса.ПолучитьОбъект();
		
		Для Каждого ВключенныйЭксперт Из ВключенныеЭксперты Цикл
			СтрокаЭксперт = НазначениеОпросаОбъект.Респонденты.Добавить();
			СтрокаЭксперт.Респондент = ВключенныйЭксперт;
			АктивироватьАнкетуЭксперта(Оцениваемый.НазначениеОпроса, ВключенныйЭксперт);
		КонецЦикла;
		
		Для Каждого ИсключенныйЭксперт Из ИсключенныеЭксперты Цикл
			СтрокиОпроса = НазначениеОпросаОбъект.Респонденты.НайтиСтроки(
				Новый Структура("Респондент", ИсключенныйЭксперт));
			Для Каждого СтрокаОпроса Из СтрокиОпроса Цикл
				НазначениеОпросаОбъект.Респонденты.Удалить(СтрокаОпроса);
			КонецЦикла;
			ДеактивироватьАнкетуЭксперта(Оцениваемый.НазначениеОпроса, ИсключенныйЭксперт);
		КонецЦикла;
		
		НазначениеОпросаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
КонецПроцедуры



#КонецОбласти
