	СУММА(ВЫБОР 
		КОГДА ОпросыПоКомпетенциям.НазначениеОпроса = ЗНАЧЕНИЕ(Документ.НазначениеОпросов.ПустаяССылка)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ) КАК ПустыхНазначенийОпросов,
	СУММА(1) КАК Оцениваемые
ПОМЕСТИТЬ ВТНеНачатые
ИЗ
	Справочник.ОпросыПоКомпетенциям.Оцениваемые КАК ОпросыПоКомпетенциям
СГРУППИРОВАТЬ ПО
ОпросыПоКомпетенциям.Ссылка
;
ВЫБРАТЬ
	СправочникОпросыПоКомпетенциям.Ссылка,
	ЕСТЬNULL(СправочникОпросыПоКомпетенциям.ДатаОкончания &lt; &amp;ДатаАктуальности, ЛОЖЬ) КАК МероприятиеЗавершено,
	НЕ (ЕСТЬNULL(НеНачатые.ПустыхНазначенийОпросов, 0) = ЕСТЬNULL(НеНачатые.Оцениваемые, 0)) КАК АнкетированиеНачато,
	СправочникОпросыПоКомпетенциям.ПометкаУдаления,
	СправочникОпросыПоКомпетенциям.Родитель,
