#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Проверка уникальности начисления по категории.
	Если РедактируетсяВОтдельныхПолях
		И (КатегорияНачисленияИлиНеоплаченногоВремени = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.РайонныйКоэффициент
			Или КатегорияНачисленияИлиНеоплаченногоВремени = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.СевернаяНадбавка
			Или КатегорияНачисленияИлиНеоплаченногоВремени = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.НадбавкаЗаВредность)
		Или КатегорияНачисленияИлиНеоплаченногоВремени = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаПредыдущимиДокументами Тогда
		
		Отбор = Новый Структура("КатегорияНачисленияИлиНеоплаченногоВремени, КатегорияДохода, ОсновнойВидРасчета, РедактируетсяВОтдельныхПолях",
			КатегорияНачисленияИлиНеоплаченногоВремени, КатегорияДохода, ОсновнойВидРасчета, Истина);
		Начисления = ПланыВидовРасчета.Начисления.НачисленияПоОтбору(Отбор);
		Если Начисления.Количество() > 0 И Начисления.Найти(Ссылка) = Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Начисление с назначением ""%1"" уже существует'"),
				КатегорияНачисленияИлиНеоплаченногоВремени);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения, , "Объект.КатегорияНачисленияИлиНеоплаченногоВремени", , Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗарплатаКадры.БазовыйРежим() Тогда
		ПланВидовРасчетаНачисленияБазовый.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	Иначе
		МодульПланВидовРасчетаНачисленияРасширенный = ОбщегоНазначения.ОбщийМодуль("ПланВидовРасчетаНачисленияРасширенный");
		МодульПланВидовРасчетаНачисленияРасширенный.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ЗарплатаКадры.БазовыйРежим() Тогда
		ПланВидовРасчетаНачисленияБазовый.ПередЗаписью(ЭтотОбъект, Отказ);
	Иначе
		МодульПланВидовРасчетаНачисленияРасширенный = ОбщегоНазначения.ОбщийМодуль("ПланВидовРасчетаНачисленияРасширенный");
		МодульПланВидовРасчетаНачисленияРасширенный.ПередЗаписью(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ЗарплатаКадры.РасширенныйРежим() Тогда
		МодульПланВидовРасчетаНачисленияРасширенный = ОбщегоНазначения.ОбщийМодуль("ПланВидовРасчетаНачисленияРасширенный");
		МодульПланВидовРасчетаНачисленияРасширенный.ПередУдалением(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ЗарплатаКадры.БазовыйРежим() Тогда
		ПланВидовРасчетаНачисленияБазовый.ПриЗаписи(ЭтотОбъект, Отказ);
	Иначе
		МодульПланВидовРасчетаНачисленияРасширенный = ОбщегоНазначения.ОбщийМодуль("ПланВидовРасчетаНачисленияРасширенный");
		МодульПланВидовРасчетаНачисленияРасширенный.ПриЗаписи(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	РедактируетсяВОтдельныхПолях = Ложь;
	Если ЗарплатаКадры.БазовыйРежим() Тогда
		ПланВидовРасчетаНачисленияБазовый.ПриКопировании(ЭтотОбъект, ОбъектКопирования);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли