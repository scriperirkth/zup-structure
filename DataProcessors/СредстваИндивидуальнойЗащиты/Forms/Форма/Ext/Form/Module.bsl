#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ФизическиеЛицаРабочиеМеста(ПоОтмеченнымСИЗ, ВидДокумента, ДополнительнаяКолонка)
	
	ДанныеСИЗ = Новый Массив;
	
	Если ПоОтмеченнымСИЗ Тогда
		ДанныеСтроки = Элементы.ВыдачиСИЗ.ТекущиеДанные;
		Описание = ОписаниеСтрокиВыдачиСИЗ();
		ЗаполнитьЗначенияСвойств(Описание, ДанныеСтроки);
		Для Каждого ВыделеннаяСтрока Из СостоянияВыдачиСИЗСотрудника.НайтиСтроки(Новый Структура("Флажок", Истина)) Цикл
			Если ВидДокумента = ВидДокумента().ЗаказНаВыдачу Тогда
				КоличествоОжидаетВыдачи = ВыделеннаяСтрока.КоличествоОжидаетВыдачи;
				Если ДополнительнаяКолонка = ИменаКолонокКоличества().ДоВыдачиМеньшеМесяца Тогда
					КоличествоОжидаетВыдачи = КоличествоОжидаетВыдачи + ВыделеннаяСтрока.КоличествоДоВыдачиМеньшеМесяца;
				КонецЕсли;
				Если КоличествоОжидаетВыдачи > 0 Тогда
					Описание.ОтмеченныеСИЗ.Добавить(ВыделеннаяСтрока.СИЗ);
				КонецЕсли;
			ИначеЕсли ВыделеннаяСтрока.КоличествоЗаказано > 0 И ВидДокумента = ВидДокумента().Выдача Тогда
				Описание.ОтмеченныеСИЗ.Добавить(ВыделеннаяСтрока.СИЗ);
			ИначеЕсли (ВидДокумента = ВидДокумента().Продление Или ВидДокумента = ВидДокумента().Списание)
				И ?(ДополнительнаяКолонка = ИменаКолонокКоличества().НаРуках, ВыделеннаяСтрока.КоличествоНаРуках > 0, ВыделеннаяСтрока.КоличествоНужноОбновить > 0) Тогда
				Описание.ОтмеченныеСИЗ.Добавить(ВыделеннаяСтрока.СИЗ);
			ИначеЕсли ВыделеннаяСтрока.КоличествоТребуетсяСписание > 0 И ВидДокумента = ВидДокумента().Списание Тогда
				Описание.ОтмеченныеСИЗ.Добавить(ВыделеннаяСтрока.СИЗ);
			КонецЕсли;
		КонецЦикла;
		ДанныеСИЗ.Добавить(Описание);
	Иначе
		Для Каждого ВыделеннаяСтрока Из Элементы.ВыдачиСИЗ.ВыделенныеСтроки Цикл
			ДанныеСтроки = Элементы.ВыдачиСИЗ.ДанныеСтроки(ВыделеннаяСтрока);
			Описание = ОписаниеСтрокиВыдачиСИЗ();
			ЗаполнитьЗначенияСвойств(Описание, ДанныеСтроки);
			ДанныеСИЗ.Добавить(Описание);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ДанныеСИЗ;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеСтрокиВыдачиСИЗ()
	
	Описание = Новый Структура;
	Описание.Вставить("ФизическоеЛицо");
	Описание.Вставить("РабочееМесто");
	Описание.Вставить("ЗаказНаВыдачу");
	Описание.Вставить("ВыдачаСИЗ");
	Описание.Вставить("ОтмеченныеСИЗ", Новый Массив);
	
	Возврат Описание;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидДокумента()
	
	ВидыДокументов = Новый Структура;
	ВидыДокументов.Вставить("ЗаказНаВыдачу", НСтр("ru = 'Заказ на выдачу'"));
	ВидыДокументов.Вставить("Выдача", НСтр("ru = 'Выдача СИЗ'"));
	ВидыДокументов.Вставить("Продление", НСтр("ru = 'Продление сроков носки'"));
	ВидыДокументов.Вставить("Списание", НСтр("ru = 'Списание СИЗ из эксплуатации'"));
	
	Возврат ВидыДокументов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИменаКолонокКоличества()
	
	ИменаКолонокКоличества = Новый Структура;
	ИменаКолонокКоличества.Вставить("ДоВыдачиМеньшеМесяца", "КоличествоДоВыдачиМеньшеМесяца");
	ИменаКолонокКоличества.Вставить("НаРуках", "КоличествоНаРуках");
	
	Возврат ИменаКолонокКоличества;
	
КонецФункции

#Область ФормированиеЗаказаНаВыдачу

&НаКлиенте
Процедура НачатьФормированиеЗаказаНаВыдачу(ПоОтмеченнымСИЗ)
	
	Если Элементы.ВыдачиСИЗ.ВыделенныеСтроки.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрано ни одного сотрудника'");
	КонецЕсли;
	
	Если ПоОтмеченнымСИЗ Тогда
		ОтмеченныеСтроки = СостоянияВыдачиСИЗСотрудника.НайтиСтроки(Новый Структура("Флажок", Истина));
		Если ОтмеченныеСтроки.Количество() = 0  Тогда
			ВызватьИсключение НСтр("ru = 'Не отмечено ни одного СИЗ'");
		КонецЕсли;
		ОтмеченыГотовыеКЗаказуСтроки = Ложь;
		Для Каждого ОтмеченнаяСтрока Из ОтмеченныеСтроки Цикл
			Если ОтмеченнаяСтрока.КоличествоОжидаетВыдачи > 0 Или ОтмеченнаяСтрока.КоличествоДоВыдачиМеньшеМесяца > 0 Тогда
				ОтмеченыГотовыеКЗаказуСтроки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ОтмеченыГотовыеКЗаказуСтроки Тогда
			ВызватьИсключение НСтр("ru = 'Не отмечено ни одного СИЗ подходящего к заказу на выдачу'");
		КонецЕсли;
	КонецЕсли;
	
	НачатьВводЗаказаНаВыдачу(ПоОтмеченнымСИЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьВводЗаказаНаВыдачу(ПоОтмеченнымСИЗ)
	
	Если ПоОтмеченнымСИЗ Тогда
		Для Каждого Строка Из СостоянияВыдачиСИЗСотрудника Цикл
			Если Строка.Флажок И ЗначениеЗаполнено(Строка.ПоследнийЗаказНаВыдачу) И Строка.КоличествоЗаказано > 0 Тогда
				ПоказатьВопросЗаказНаВыдачуСуществует(Строка.ПоследнийЗаказНаВыдачу, ПоОтмеченнымСИЗ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого ВыделеннаяСтрока Из Элементы.ВыдачиСИЗ.ВыделенныеСтроки Цикл
			ДанныеСтроки = Элементы.ВыдачиСИЗ.ДанныеСтроки(ВыделеннаяСтрока);
			Если ЗначениеЗаполнено(ДанныеСтроки.ЗаказНаВыдачу) И Не ДанныеСтроки.ВыданыСИЗ Тогда
				ПоказатьВопросЗаказНаВыдачуСуществует(ДанныеСтроки.ЗаказНаВыдачу, ПоОтмеченнымСИЗ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ВвестиНовыйЗаказНаВыдачу(ПоОтмеченнымСИЗ);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПоказатьВопросЗаказНаВыдачуСуществует(ЗаказНаВыдачу, ПоОтмеченнымСИЗ)
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Для сотрудника уже введен документ %1, выдача по которому пока не проведена.'"), ЗаказНаВыдачу);
		
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Прервать, НСтр("ru = 'Открыть существующий'"));
	Кнопки.Добавить(КодВозвратаДиалога.Пропустить, НСтр("ru = 'Создать новый'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЗаказНаВыдачу", ЗаказНаВыдачу);
	ДополнительныеПараметры.Вставить("ПоОтмеченнымСИЗ", ПоОтмеченнымСИЗ);
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ВвестиНовыйЗаказНаВыдачуПослеВопросаЗаказНаВыдачуСуществует", ЭтотОбъект,
		ДополнительныеПараметры);
	ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, Кнопки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросЕстьИстекающиеВТечениеМесяца(ПоОтмеченным)
	
	ТекстВопроса = НСтр("ru = 'Найдены СИЗ, у которых срок носки еще не истек, но истечет в течение следующего месяца.'");
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Добавить в заказ'"));
	Кнопки.Добавить(КодВозвратаДиалога.Пропустить, НСтр("ru = 'Не добавлять'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ВвестиНовыйЗаказНаВыдачуПослеВопросаЕстьИстекающиеВТечениеМесяца",
		ЭтотОбъект, Новый Структура("ПоОтмеченным", ПоОтмеченным));
	ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, Кнопки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиНовыйЗаказНаВыдачуПослеВопросаЗаказНаВыдачуСуществует(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Прервать Тогда
		ПоказатьЗначение(, ДополнительныеПараметры.ЗаказНаВыдачу);
		Возврат;
	КонецЕсли;
	
	ВвестиНовыйЗаказНаВыдачу(ДополнительныеПараметры.ПоОтмеченнымСИЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиНовыйЗаказНаВыдачуПослеВопросаЕстьИстекающиеВТечениеМесяца(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительнаяКолонка = Неопределено;
	Если Результат = КодВозвратаДиалога.ОК Тогда
		ДополнительнаяКолонка = ИменаКолонокКоличества().ДоВыдачиМеньшеМесяца;
	КонецЕсли;
	
	ПараметрыФормы = ПараметрыФормыНовогоДокумента(
		ДополнительныеПараметры.ПоОтмеченным, ВидДокумента().ЗаказНаВыдачу, ДополнительнаяКолонка);
	Если ДополнительнаяКолонка = ИменаКолонокКоличества().ДоВыдачиМеньшеМесяца Тогда
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("ВключатьСИЗИстекающиеВТечениеМесяца", Истина);
	КонецЕсли;
	
	ОткрытьФорму("Документ.ЗаказНаВыдачуСИЗ.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиНовыйЗаказНаВыдачу(ПоОтмеченнымСИЗ)
	
	Если ПоОтмеченнымСИЗ Тогда
		Для Каждого Строка Из СостоянияВыдачиСИЗСотрудника Цикл
			Если Строка.Флажок И Строка.КоличествоДоВыдачиМеньшеМесяца > 0 Тогда
				ПоказатьВопросЕстьИстекающиеВТечениеМесяца(ПоОтмеченнымСИЗ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ДатаАктуальности = ДатаАктуальности();
		ДатаАктуальностиМесяцВперед = ДобавитьМесяц(ДатаАктуальности, 1);
		Для Каждого ВыделеннаяСтрока Из Элементы.ВыдачиСИЗ.ВыделенныеСтроки Цикл
			ДанныеСтроки = Элементы.ВыдачиСИЗ.ДанныеСтроки(ВыделеннаяСтрока);
			Если ДанныеСтроки.ДатаСледующейВыдачи > ДатаАктуальности
			 И ДанныеСтроки.ДатаСледующейВыдачи <= ДатаАктуальностиМесяцВперед Тогда
				ПоказатьВопросЕстьИстекающиеВТечениеМесяца(ПоОтмеченнымСИЗ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОткрытьФорму("Документ.ЗаказНаВыдачуСИЗ.ФормаОбъекта",
		ПараметрыФормыНовогоДокумента(ПоОтмеченнымСИЗ, ВидДокумента().ЗаказНаВыдачу), ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДатаАктуальности()
	Возврат НачалоДня(ОбщегоНазначения.ТекущаяДатаПользователя());
КонецФункции

#КонецОбласти

#Область ФормированиеВыдачи

&НаКлиенте
Процедура НачатьФормированиеВыдачиСИЗ(ПоОтмеченнымСИЗ)
	
	Если Элементы.ВыдачиСИЗ.ВыделенныеСтроки.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрано ни одного сотрудника'");
	КонецЕсли;
	
	Если ПоОтмеченнымСИЗ Тогда
		ОтмеченныеСтроки = СостоянияВыдачиСИЗСотрудника.НайтиСтроки(Новый Структура("Флажок", Истина));
		Если ОтмеченныеСтроки.Количество() = 0  Тогда
			ВызватьИсключение НСтр("ru = 'Не отмечено ни одного СИЗ'");
		КонецЕсли;
		ОтмеченыГотовыеКВыдачеСтроки = Ложь;
		Для Каждого ОтмеченнаяСтрока Из ОтмеченныеСтроки Цикл
			Если ОтмеченнаяСтрока.КоличествоЗаказано > 0 Тогда
				ОтмеченыГотовыеКВыдачеСтроки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ОтмеченыГотовыеКВыдачеСтроки Тогда
			ВызватьИсключение НСтр("ru = 'Не отмечено ни одного СИЗ подходящего для выдачи'");
		КонецЕсли;
	КонецЕсли;
	
	НачатьВводВыдачиСИЗ(ПоОтмеченнымСИЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьВводВыдачиСИЗ(ПоОтмеченнымСИЗ)
	
	Если Не ПоОтмеченнымСИЗ Тогда
		Для Каждого ВыделеннаяСтрока Из Элементы.ВыдачиСИЗ.ВыделенныеСтроки Цикл
			ДанныеСтроки = Элементы.ВыдачиСИЗ.ДанныеСтроки(ВыделеннаяСтрока);
			Если Не ЗначениеЗаполнено(ДанныеСтроки.ЗаказНаВыдачу) Тогда
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для %1 отсутствует заказ на выдачу.
					|Выдачу можно ввести только при наличии заказа.'"), ДанныеСтроки.ФизическоеЛицо);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеСтроки.ВыдачаСИЗ) Тогда
				Если Не ДанныеСтроки.ВыданыСИЗ Тогда
					ПоказатьВопросВыдачаСИЗСуществует(ДанныеСтроки, ПоОтмеченнымСИЗ);
					Возврат;
				КонецЕсли;
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для %1 СИЗ уже выданы.
					|Выдачу можно ввести только при наличии заказа, по которому нет выдачи.'"), ДанныеСтроки.ФизическоеЛицо);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ВвестиНовуюВыдачуСИЗ(ПоОтмеченнымСИЗ);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПоказатьВопросВыдачаСИЗСуществует(ТекущиеДанные, ПоОтмеченнымСИЗ)
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Для %1 уже введен документ %2, который пока не проведен.'"),
		ТекущиеДанные.ФизическоеЛицо, ТекущиеДанные.ВыдачаСИЗ);
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Прервать, НСтр("ru = 'Открыть существующий'"));
	Кнопки.Добавить(КодВозвратаДиалога.Пропустить, НСтр("ru = 'Создать новый'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыдачаСИЗ", ТекущиеДанные.ВыдачаСИЗ);
	ДополнительныеПараметры.Вставить("ПоОтмеченнымСИЗ", ПоОтмеченнымСИЗ);
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ВвестиНовуюВыдачуПослеВопросаВыдачаСуществует", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, Кнопки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиНовуюВыдачуПослеВопросаВыдачаСуществует(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Прервать Тогда
		ПоказатьЗначение(, ДополнительныеПараметры.ВыдачаСИЗ);
		Возврат;
	КонецЕсли;
	
	ВвестиНовуюВыдачуСИЗ(ДополнительныеПараметры.ПоОтмеченнымСИЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиНовуюВыдачуСИЗ(ПоОтмеченнымСИЗ)
	
	ОткрытьФорму("Документ.ВыдачаСИЗ.ФормаОбъекта", 
		ПараметрыФормыНовогоДокумента(ПоОтмеченнымСИЗ, ВидДокумента().Выдача), ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеПродления

&НаКлиенте
Процедура НачатьФормированиеПродления(ПоОтмеченнымСИЗ, УчитыватьИстекшийСрокНоски)
	
	Если Элементы.ВыдачиСИЗ.ВыделенныеСтроки.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрано ни одного сотрудника'");
	КонецЕсли;
	
	Если ПоОтмеченнымСИЗ Тогда
		ОтмеченныеСтроки = СостоянияВыдачиСИЗСотрудника.НайтиСтроки(Новый Структура("Флажок", Истина));
		Если ОтмеченныеСтроки.Количество() = 0  Тогда
			ВызватьИсключение НСтр("ru = 'Не отмечено ни одного СИЗ'");
		КонецЕсли;
		ОтмеченыГотовыеКПродлениюСтроки = Ложь;
		Для Каждого ОтмеченнаяСтрока Из ОтмеченныеСтроки Цикл
			Если ОтмеченнаяСтрока.КоличествоНужноОбновить > 0
			 Или ?(УчитыватьИстекшийСрокНоски, Ложь, ОтмеченнаяСтрока.КоличествоНаРуках > 0) Тогда
				ОтмеченыГотовыеКПродлениюСтроки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ОтмеченыГотовыеКПродлениюСтроки Тогда
			ВызватьИсключение НСтр("ru = 'Не отмечено ни одного СИЗ подходящего для продления'");
		КонецЕсли;
	КонецЕсли;
	
	ВвестиНовоеПродление(ПоОтмеченнымСИЗ, УчитыватьИстекшийСрокНоски);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиНовоеПродление(ПоОтмеченнымСИЗ, УчитыватьИстекшийСрокНоски)
	
	ДополнительнаяКолонка = Неопределено;
	Если Не УчитыватьИстекшийСрокНоски Тогда
		ДополнительнаяКолонка = ИменаКолонокКоличества().НаРуках;
	КонецЕсли;
	
	ОткрытьФорму("Документ.ПродлениеСроковНоскиСИЗ.ФормаОбъекта", 
		ПараметрыФормыНовогоДокумента(ПоОтмеченнымСИЗ, ВидДокумента().Продление, ДополнительнаяКолонка), ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеСписания

&НаКлиенте
Процедура НачатьФормированиеСписания(ПоОтмеченнымСИЗ, УчитыватьИстекшийСрокНоски)
	
	Если Элементы.ВыдачиСИЗ.ВыделенныеСтроки.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрано ни одного сотрудника'");
	КонецЕсли;
	
	Если ПоОтмеченнымСИЗ Тогда
		ОтмеченныеСтроки = СостоянияВыдачиСИЗСотрудника.НайтиСтроки(Новый Структура("Флажок", Истина));
		Если ОтмеченныеСтроки.Количество() = 0  Тогда
			ВызватьИсключение НСтр("ru = 'Не отмечено ни одного СИЗ'");
		КонецЕсли;
		ОтмеченыГотовыеКСписаниюСтроки = Ложь;
		Для Каждого ОтмеченнаяСтрока Из ОтмеченныеСтроки Цикл
			Если ОтмеченнаяСтрока.КоличествоТребуетсяСписание > 0 Или ОтмеченнаяСтрока.КоличествоНужноОбновить > 0
			 Или ?(УчитыватьИстекшийСрокНоски, Ложь, ОтмеченнаяСтрока.КоличествоНаРуках > 0) Тогда
				ОтмеченыГотовыеКСписаниюСтроки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ОтмеченыГотовыеКСписаниюСтроки Тогда
			ВызватьИсключение НСтр("ru = 'Не отмечено ни одного СИЗ подходящего для списания'");
		КонецЕсли;
	КонецЕсли;
	
	ВвестиНовоеСписание(ПоОтмеченнымСИЗ, УчитыватьИстекшийСрокНоски);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиНовоеСписание(ПоОтмеченнымСИЗ, УчитыватьИстекшийСрокНоски)
	
	ДополнительнаяКолонка = Неопределено;
	Если Не УчитыватьИстекшийСрокНоски Тогда
		ДополнительнаяКолонка = ИменаКолонокКоличества().НаРуках;
	КонецЕсли;
	
	ОткрытьФорму("Документ.СписаниеСИЗИзЭксплуатации.ФормаОбъекта", 
		ПараметрыФормыНовогоДокумента(ПоОтмеченнымСИЗ, ВидДокумента().Списание, ДополнительнаяКолонка), ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьСписокВыдачиСИЗ()
	
	Элементы.ВыдачиСИЗ.Обновить();
	
	ВыбранноеРабочееМесто = Неопределено;
	ВыбранноеФизическоеЛицо = Неопределено;
	ПодключитьОбработчикОжидания("ПриАктивизацииСтрокиВыдачиСИЗНаКлиенте", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеНеактуальныхЗаписейВыдачиСИЗ()
	
	БылиНеАктуальныеЗаписи = Элементы.ОбновлениеДанныхГруппа.Видимость;
	
	ЕстьНеактуальныеЗаписи = ЕстьНеактуальныеЗаписиВыдачиСИЗ(Организация);
	УстановитьНадписьОбновитьВыдачиСИЗ(ЭтотОбъект, ЕстьНеактуальныеЗаписи);
	
	ВсеПозицииБезСИЗ = ВсеПозицииБезСИЗ(Организация);
	УстановитьНадписьПояснениеПустогоСпискаВыдачСИЗ(ЭтотОбъект, ВсеПозицииБезСИЗ);
	
	Если БылиНеАктуальныеЗаписи И Не ЕстьНеактуальныеЗаписи Тогда
		Элементы.ВыдачиСИЗ.Обновить();
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьСотрудника(ТекущиеДанные, Поле)
	
	Если Поле <> Элементы.ФизическоеЛицо Тогда
		Возврат;
	КонецЕсли;
	
	Сотрудник = СотрудникПоФизическомуЛицу(ТекущиеДанные["ФизическоеЛицо"], ТекущиеДанные["РабочееМесто"], Организация);
	
	ПоказатьЗначение(, Сотрудник);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРабочееМесто(ТекущиеДанные, Поле)
	
	Если Поле <> Элементы.РабочееМесто Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ");
	ПараметрыФормы.Ключ = ТекущиеДанные["РабочееМесто"];
	
	Если Не ЗначениеЗаполнено(ПараметрыФормы.Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.РабочиеМестаОхраныТруда.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаказНаВыдачу(ТекущиеДанные, Поле)
	
	Если Поле <> Элементы.ЗаказНаВыдачу Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ТекущиеДанные["ЗаказНаВыдачу"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВыдачу(ТекущиеДанные, Поле)
	
	Если Поле <> Элементы.ВыдачаСИЗ Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ТекущиеДанные["ВыдачаСИЗ"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасшифровкуРезультатаВыдачи(ТекущиеДанные, Поле)
	
	Если Поле <> Элементы.РезультатВыдачи Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные["ФизическоеЛицо"]) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ФизическоеЛицо", ТекущиеДанные["ФизическоеЛицо"]);
	ПараметрыОткрытия.Вставить("РабочееМесто", ТекущиеДанные["РабочееМесто"]);
	ПараметрыОткрытия.Вставить("Организация", Организация);
	
	ОткрытьФорму("Обработка.СредстваИндивидуальнойЗащиты.Форма.РезультатыВыдачи", ПараметрыОткрытия,, Новый УникальныйИдентификатор());
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СотрудникПоФизическомуЛицу(ФизическоеЛицо, РабочееМесто, Организация)
	
	Возврат ОхранаТруда.СотрудникПоФизическомуЛицу(ФизическоеЛицо, РабочееМесто, Организация);
	
КонецФункции

&НаКлиенте
Процедура НачатьОбновлениеВыдачиСИЗ()
	
	ДлительнаяОперация = ОбновитьВыдачиСИЗНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Обновление сведений о выданных СИЗ'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновлениеВыдачиСИЗЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеВыдачиСИЗЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ПроверитьНаличиеНеактуальныхЗаписейВыдачиСИЗ();
	
КонецПроцедуры 

&НаСервере
Функция ОбновитьВыдачиСИЗНаСервере()
	
	ПараметрыПроцедуры = Новый Структура("Организация");
	ПараметрыПроцедуры.Организация = Организация;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обновление сведений о выданных СИЗ'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"СредстваИндивидуальнойЗащиты.ОбновитьВыдачиСИЗОрганизацииДлительнаяОперация", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНачальныеЗначения()
	
	ЗначенияДляЗаполнения = Новый Структура;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ЗначенияДляЗаполнения.Вставить("Организация", "Организация");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Подразделение) Тогда
		ЗначенияДляЗаполнения.Вставить("Подразделение", "Подразделение");
	КонецЕсли;
	ЗарплатаКадры.ЗаполнитьПервоначальныеЗначенияВФорме(ЭтотОбъект, ЗначенияДляЗаполнения);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрТекущаяДата(Форма, ТекущаяДата)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.ВыдачиСИЗ, "ТекущаяДата", ТекущаяДата);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.РабочиеМеста, "ТекущаяДата", ТекущаяДата);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПоОрганизации(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.РабочиеМеста, "Организация", Форма.Организация);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.ВыдачиСИЗ, "Организация", Форма.Организация);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПоПодразделению(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.РабочиеМеста, "Подразделение", Форма.Подразделение,
