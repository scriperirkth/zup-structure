	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.ВыдачиСИЗ, "Подразделение", Форма.Подразделение,
		ВидСравненияКомпоновкиДанных.ВИерархии, , ЗначениеЗаполнено(Форма.Подразделение));
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	
	// Просрочена выдача.
	ЭлементОформления = ВыдачиСИЗ.УсловноеОформление.Элементы.Добавить();
	ГруппаОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "ДатаСледующейВыдачи", Сегодня, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "РезультатВыдачи", Перечисления.РезультатыВыдачиСИЗ.ЧастичноВыдано);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаКритичногоСостоянияОхраныТруда);
	
	// Выдача до износа.
	ЭлементОформления = ВыдачиСИЗ.УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "СпособВыдачи", Перечисления.СпособыВыдачиСИЗ.ДоИзноса);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '< До износа >'"));
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДатаСледующейВыдачи");
	
	// Нет результата.
	ЭлементОформления = ВыдачиСИЗ.УсловноеОформление.Элементы.Добавить();
	ГруппаОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "РезультатВыдачи", Перечисления.РезультатыВыдачиСИЗ.НеВыдано);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "РезультатВыдачи", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ВажнаяНадписьШрифт);
	
	// Не выданы.
	ЭлементОформления = ВыдачиСИЗ.УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "РезультатВыдачи", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не выдано'"));
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("РезультатВыдачи");
	
	// Срок носки истек.
	ЭлементОформления = ВыдачиСИЗ.УсловноеОформление.Элементы.Добавить();
	ГруппаОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "ДатаСледующейВыдачи", Сегодня, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "РезультатВыдачи", Перечисления.РезультатыВыдачиСИЗ.Выдано);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Выдано, но срок носки истек'"));
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("РезультатВыдачи");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОформитьСтрокиВыдачСИЗ(ИмяЭлемента, Настройки, Строки)
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	
	Для Каждого СтрокаСписка Из Строки Цикл
		ДанныеСтроки = СтрокаСписка.Значение.Данные;
		ОформлениеСтроки = СтрокаСписка.Значение.Оформление;
		ОтображатьКартинкуПредупреждение = Ложь;
		ТекстСостояния = Неопределено;
		Если ДанныеСтроки.ДатаСледующейВыдачи > Сегодня И ДанныеСтроки.ДатаСледующейВыдачи < ДобавитьМесяц(Сегодня, 1) Тогда
			// До выдачи меньше месяца.
			ТекстСостояния = НСтр("ru = 'До выдачи меньше месяца'");
		ИначеЕсли ДанныеСтроки.ДатаСледующейВыдачи <= Сегодня Тогда
			// Выдача просрочена или не СИЗ не выдавались.
			ТекстСостояния = НСтр("ru = 'Выдать СИЗ немедленно'");
			ОтображатьКартинкуПредупреждение = Истина;
		ИначеЕсли ДанныеСтроки.РезультатВыдачи = Перечисления.РезультатыВыдачиСИЗ.НеВыдано Тогда
			// Спецодежда не выдана.
			ТекстСостояния = НСтр("ru = 'Спецодежда не выдана, требуется отстранение от работы'");
			ОтображатьКартинкуПредупреждение = Истина;
		КонецЕсли;
		// В процессе выдачи.
		Если ЗначениеЗаполнено(ДанныеСтроки.ЗаказНаВыдачу) И Не ЗначениеЗаполнено(ДанныеСтроки.РезультатВыдачи) Тогда
			ОтображатьКартинкуПредупреждение = Ложь;
			Если ЗначениеЗаполнено(ДанныеСтроки.ВыдачаСИЗ) Тогда
				ТекстСостояния = НСтр("ru = 'Выдача подготовлена, но документ не проведен'");
			Иначе
				ТекстСостояния = НСтр("ru = 'Сформирован заказ на выдачу, выдачи пока нет'");
			КонецЕсли;
		КонецЕсли;
		Если Не ОтображатьКартинкуПредупреждение Тогда
			УстановитьЗначениеПараметраОформленияПоля(ОформлениеСтроки, "ПредупреждениеКартинка", "Отображать", Ложь);
		КонецЕсли;
		УстановитьЗначениеПараметраОформленияПоля(ОформлениеСтроки, "СостояниеВыдачи", "Текст", ТекстСостояния);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьЗначениеПараметраОформленияПоля(ОформлениеСтроки, ИмяПоля, Параметр, Значение)
	
	ОформлениеЯчейки = ОформлениеСтроки.Получить(ИмяПоля);
	
	Если ОформлениеЯчейки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОформлениеЯчейки.УстановитьЗначениеПараметра(Параметр, Значение);
	
КонецПроцедуры

&НаСервере
Процедура ДоработатьПользовательскиеНастройкиСпискаРабочихМест()
	
	Элементы.РабочиеМеста.СоздатьЭлементыФормыПользовательскихНастроек(Элементы.ПользовательскиеНастройкиРабочихМестГруппа);
	Для Каждого ЭлементНастроек Из Элементы.ПользовательскиеНастройкиРабочихМестГруппа.ПодчиненныеЭлементы Цикл
		Если ЭлементНастроек.Вид = ВидПоляФормы.ПолеФлажка Тогда
			ЭлементНастроек.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборТолькоБлижайшиеВыдачи(Форма, ТекущаяДата, Использование)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.ВыдачиСИЗ, 
		"ДатаСледующейВыдачи", 
		ДобавитьМесяц(НачалоДня(ТекущаяДата), 1), 
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, , 
		Использование);
		
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ВсеПозицииБезСИЗ = ВсеПозицииБезСИЗ(Организация);
	УстановитьНадписьПояснениеПустогоСпискаВыдачСИЗ(ЭтотОбъект, ВсеПозицииБезСИЗ);
	
	ЕстьНеактуальныеЗаписи = ЕстьНеактуальныеЗаписиВыдачиСИЗ(Организация);
	УстановитьНадписьОбновитьВыдачиСИЗ(ЭтотОбъект, ЕстьНеактуальныеЗаписи);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНадписьПояснениеПустогоСпискаВыдачСИЗ(Форма, ВсеПозицииБезСИЗ)
	
	Форма.Элементы.ПояснениеИспользованияГруппа.Видимость = ВсеПозицииБезСИЗ;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНадписьОбновитьВыдачиСИЗ(Форма, ЕстьНеактуальныеЗаписи)
	
	Форма.Элементы.ОбновлениеДанныхГруппа.Видимость = ЕстьНеактуальныеЗаписи;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьНеактуальныеЗаписиВыдачиСИЗ(Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", ЗарплатаКадры.ГоловнаяОрганизация(Организация));
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Поле1
		|ИЗ
		|	РегистрСведений.ОбновлениеВыдачСИЗ КАК ОбновлениеВыдачСИЗ
		|ГДЕ
		|	ОбновлениеВыдачСИЗ.ГоловнаяОрганизация = &ГоловнаяОрганизация";
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

&НаСервереБезКонтекста
Функция ВсеПозицииБезСИЗ(Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПериодичностьВыдачиСИЗРабочихМест КАК ПериодичностьРабочихМест
		|		ПО (РабочиеМестаОхраныТруда.Ссылка = ПериодичностьРабочихМест.РабочееМесто)
		|		И (РабочиеМестаОхраныТруда.Владелец = &Организация)";
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатЗапроса.Пустой();
	
КонецФункции

&НаКлиенте
Функция ПараметрыФормыНовогоДокумента(ПоОтмеченнымСИЗ, ВидДокумента, ДополнительнаяКолонка = Неопределено)
	
	ЗначенияЗаполнения = Новый Структура("Организация, ФизическиеЛицаРабочиеМеста");
	ЗначенияЗаполнения.Организация = Организация;
	ЗначенияЗаполнения.ФизическиеЛицаРабочиеМеста =
		ФизическиеЛицаРабочиеМеста(ПоОтмеченнымСИЗ, ВидДокумента, ДополнительнаяКолонка);
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ЗначенияЗаполнения.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения");
	ПараметрыФормы.ЗначенияЗаполнения = ЗначенияЗаполнения;
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ПриАктивизацииСтрокиВыдачиСИЗНаКлиенте()
	
	Если Элементы.ВыдачиСИЗ.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РабочееМесто = Элементы.ВыдачиСИЗ.ТекущиеДанные.РабочееМесто;
	ФизическоеЛицо = Элементы.ВыдачиСИЗ.ТекущиеДанные.ФизическоеЛицо;
	
	Если РабочееМесто = ВыбранноеРабочееМесто И ФизическоеЛицо = ВыбранноеФизическоеЛицо Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеРабочееМесто = РабочееМесто;
	ВыбранноеФизическоеЛицо = ФизическоеЛицо;
	
	ЗаполнитьТаблицуСостоянийСИЗСотрудника();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСостоянийСИЗСотрудника()
	
	СостоянияВыдачиСИЗСотрудника.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочееМесто", ВыбранноеРабочееМесто);
	Запрос.УстановитьПараметр("ФизическоеЛицо", ВыбранноеФизическоеЛицо);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ДатаСледующегоМесяца", ДобавитьМесяц(Запрос.Параметры.ТекущаяДата, 1));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОбъединенныйЗапрос.СИЗ,
		|	ИСТИНА КАК Флажок,
		|	ОбъединенныйЗапрос.ЕдиницаИзмерения,
		|	СУММА(ОбъединенныйЗапрос.Количество) КАК Количество,
		|	СУММА(ОбъединенныйЗапрос.КоличествоНаРуках) КАК КоличествоНаРуках,
		|	СУММА(ОбъединенныйЗапрос.КоличествоЗаказано) КАК КоличествоЗаказано,
		|	СУММА(ОбъединенныйЗапрос.КоличествоНужноОбновить) КАК КоличествоНужноОбновить,
		|	СУММА(ОбъединенныйЗапрос.КоличествоДоВыдачиМеньшеМесяца) КАК КоличествоДоВыдачиМеньшеМесяца,
		|	ОбъединенныйЗапрос.НормаВыдачи,
		|	ОбъединенныйЗапрос.НаРуках,
		|	ОбъединенныйЗапрос.ОжидаетВыдачи,
		|	ОбъединенныйЗапрос.НужноОбновить,
		|	ОбъединенныйЗапрос.ДоВыдачиМеньшеМесяца,
		|	ОбъединенныйЗапрос.ТребуетсяСписание,
		|	ОбъединенныйЗапрос.Заказано,
		|	ОбъединенныйЗапрос.Выдано,
		|	МАКСИМУМ(ОбъединенныйЗапрос.ЗаказНаВыдачу) КАК ПоследнийЗаказНаВыдачу,
		|	МАКСИМУМ(ОбъединенныйЗапрос.ВыдачаСИЗ) КАК ПоследняяВыдачаСИЗ
		|ИЗ
		|	(ВЫБРАТЬ
		|		СИЗРабочегоМеста.СИЗ,
		|		СИЗРабочегоМеста.ЕдиницаИзмерения,
		|		СИЗРабочегоМеста.Количество,
		|		0 КАК КоличествоНаРуках,
		|		0 КАК КоличествоЗаказано,
		|		0 КАК КоличествоНужноОбновить,
		|		0 КАК КоличествоДоВыдачиМеньшеМесяца,
		|		"""" КАК НормаВыдачи,
		|		"""" КАК НаРуках,
		|		"""" КАК ОжидаетВыдачи,
		|		"""" КАК НужноОбновить,
		|		"""" КАК ДоВыдачиМеньшеМесяца,
		|		"""" КАК ТребуетсяСписание,
		|		"""" КАК Заказано,
		|		"""" КАК Выдано,
		|		NULL КАК ЗаказНаВыдачу,
		|		NULL КАК ВыдачаСИЗ
		|	ИЗ
		|		РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
		|	ГДЕ
		|		СИЗРабочегоМеста.РабочееМесто = &РабочееМесто
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ВыданныеСИЗОстатки.СИЗ,
		|		ВыданныеСИЗОстатки.ЕдиницаИзмерения,
		|		0,
		|		ВыданныеСИЗОстатки.КоличествоОстаток,
		|		0,
		|		0,
		|		0,
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		ВыданныеСИЗОстатки.ОснованиеВыдачи,
		|		ВыданныеСИЗОстатки.ДокументВыдачи
		|	ИЗ
		|		РегистрНакопления.ВыданныеСИЗ.Остатки(&ТекущаяДата, ФизическоеЛицо = &ФизическоеЛицо) КАК ВыданныеСИЗОстатки
		|	ГДЕ
		|		ВыданныеСИЗОстатки.КоличествоОстаток > 0
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		СформированныеЗаказыНаВыдачуСИЗОстатки.СИЗ,
		|		СформированныеЗаказыНаВыдачуСИЗОстатки.ЕдиницаИзмерения,
		|		0,
		|		0,
		|		СформированныеЗаказыНаВыдачуСИЗОстатки.КоличествоОстаток,
		|		0,
		|		0,
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		СформированныеЗаказыНаВыдачуСИЗОстатки.ЗаказНаВыдачуСИЗ,
		|		NULL
		|	ИЗ
		|		РегистрНакопления.СформированныеЗаказыНаВыдачуСИЗ.Остатки(&ТекущаяДата, ФизическоеЛицо = &ФизическоеЛицо) КАК
		|			СформированныеЗаказыНаВыдачуСИЗОстатки
		|	ГДЕ
		|		СформированныеЗаказыНаВыдачуСИЗОстатки.КоличествоОстаток > 0
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ВыданныеСИЗОстатки.СИЗ,
		|		ВыданныеСИЗОстатки.ЕдиницаИзмерения,
		|		0,
		|		0,
		|		0,
		|		ВыданныеСИЗОстатки.КоличествоОстаток,
		|		0,
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		ВыданныеСИЗОстатки.ОснованиеВыдачи,
		|		ВыданныеСИЗОстатки.ДокументВыдачи
		|	ИЗ
		|		РегистрНакопления.ВыданныеСИЗ.Остатки(&ТекущаяДата, ФизическоеЛицо = &ФизическоеЛицо) КАК ВыданныеСИЗОстатки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВыдачиСИЗПоНоменклатуре.СрезПоследних(&ТекущаяДата) КАК ВыдачиСИЗПоНоменклатуре
		|			ПО ВыданныеСИЗОстатки.ФизическоеЛицо = ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо
		|			И ВыданныеСИЗОстатки.СИЗ = ВыдачиСИЗПоНоменклатуре.СИЗ
		|			И ВыданныеСИЗОстатки.ОснованиеВыдачи = ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи
		|			И ВыданныеСИЗОстатки.ДокументВыдачи = ВыдачиСИЗПоНоменклатуре.ДокументВыдачи
		|			И ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи <= &ТекущаяДата
		|	ГДЕ
		|		ВыданныеСИЗОстатки.КоличествоОстаток > 0
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ВыданныеСИЗОстатки.СИЗ,
		|		ВыданныеСИЗОстатки.ЕдиницаИзмерения,
		|		0,
		|		0,
		|		0,
		|		0,
		|		ВыданныеСИЗОстатки.КоличествоОстаток,
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		ВыданныеСИЗОстатки.ОснованиеВыдачи,
		|		ВыданныеСИЗОстатки.ДокументВыдачи
		|	ИЗ
		|		РегистрНакопления.ВыданныеСИЗ.Остатки(&ТекущаяДата, ФизическоеЛицо = &ФизическоеЛицо) КАК ВыданныеСИЗОстатки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВыдачиСИЗПоНоменклатуре.СрезПоследних(&ТекущаяДата) КАК ВыдачиСИЗПоНоменклатуре
		|			ПО ВыданныеСИЗОстатки.ФизическоеЛицо = ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо
		|			И ВыданныеСИЗОстатки.СИЗ = ВыдачиСИЗПоНоменклатуре.СИЗ
		|			И ВыданныеСИЗОстатки.ОснованиеВыдачи = ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи
		|			И ВыданныеСИЗОстатки.ДокументВыдачи = ВыдачиСИЗПоНоменклатуре.ДокументВыдачи
		|			И ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи > &ТекущаяДата
		|			И ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи <= &ДатаСледующегоМесяца
		|	ГДЕ
		|		ВыданныеСИЗОстатки.КоличествоОстаток > 0) КАК ОбъединенныйЗапрос
		|СГРУППИРОВАТЬ ПО
		|	ОбъединенныйЗапрос.СИЗ,
		|	ОбъединенныйЗапрос.НормаВыдачи,
		|	ОбъединенныйЗапрос.НаРуках,
		|	ОбъединенныйЗапрос.ОжидаетВыдачи,
		|	ОбъединенныйЗапрос.НужноОбновить,
		|	ОбъединенныйЗапрос.ДоВыдачиМеньшеМесяца,
		|	ОбъединенныйЗапрос.ТребуетсяСписание,
		|	ОбъединенныйЗапрос.Заказано,
		|	ОбъединенныйЗапрос.Выдано,
		|	ОбъединенныйЗапрос.ЕдиницаИзмерения";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СостоянияВыдачиСИЗСотрудника.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		УстановитьСостояниеВыдачиНоменклатурыСИЗ(НоваяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьСостояниеВыдачиНоменклатурыСИЗ(СтрокаСостояний)
	
	ШаблонСтроки = НСтр("ru = '%1 %2'");
	Если СтрокаСостояний.Количество > 0 Тогда
		СтрокаСостояний.НормаВыдачи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, СтрокаСостояний.Количество, СтрокаСостояний.ЕдиницаИзмерения);
	КонецЕсли;
	Если СтрокаСостояний.КоличествоНаРуках > 0 Тогда
		СтрокаСостояний.НаРуках = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, СтрокаСостояний.КоличествоНаРуках, СтрокаСостояний.ЕдиницаИзмерения);
	КонецЕсли;
	Если СтрокаСостояний.КоличествоЗаказано > 0 Тогда
		СтрокаСостояний.Заказано = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, СтрокаСостояний.КоличествоЗаказано, СтрокаСостояний.ЕдиницаИзмерения);
	КонецЕсли;
	
	СтрокаСостояний.КоличествоОжидаетВыдачи = СтрокаСостояний.Количество - СтрокаСостояний.КоличествоНаРуках;
	СтрокаСостояний.КоличествоТребуетсяСписание = СтрокаСостояний.КоличествоНаРуках - СтрокаСостояний.Количество;
	
	Если СтрокаСостояний.КоличествоТребуетсяСписание > 0 Тогда
		СтрокаСостояний.КоличествоНужноОбновить = СтрокаСостояний.КоличествоНужноОбновить - СтрокаСостояний.КоличествоТребуетсяСписание;
		СтрокаСостояний.ТребуетсяСписание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, СтрокаСостояний.КоличествоТребуетсяСписание, СтрокаСостояний.ЕдиницаИзмерения);
	КонецЕсли;
	Если СтрокаСостояний.КоличествоНужноОбновить > 0 Тогда
		СтрокаСостояний.НужноОбновить = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, СтрокаСостояний.КоличествоНужноОбновить, СтрокаСостояний.ЕдиницаИзмерения);
	КонецЕсли;
	Если СтрокаСостояний.КоличествоОжидаетВыдачи > 0 Тогда
		СтрокаСостояний.ОжидаетВыдачи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, СтрокаСостояний.КоличествоОжидаетВыдачи, СтрокаСостояний.ЕдиницаИзмерения);
	КонецЕсли;
	Если СтрокаСостояний.КоличествоДоВыдачиМеньшеМесяца > 0 Тогда
		СтрокаСостояний.ДоВыдачиМеньшеМесяца = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, СтрокаСостояний.КоличествоДоВыдачиМеньшеМесяца, СтрокаСостояний.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
