
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ФизическоеЛицо", ФизическоеЛицо);
	Параметры.Свойство("РабочееМесто", РабочееМесто);
	Параметры.Свойство("Организация", Организация);
	
	СформироватьРезультатыВыдачи();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	
	ИмяОбласти = "Документ_1";
	
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечати.Добавить(ФизическоеЛицо, ИмяОбласти);
	
	НомерСтрокиОкончание = ТабличныйДокументРезультатВыдачи.ВысотаТаблицы;
	ТабличныйДокументРезультатВыдачи.Область(1, , НомерСтрокиОкончание, ).Имя = ИмяОбласти;
	
	ТабличныеДокументы = Новый СписокЗначений;
	ТабличныеДокументы.Добавить(ТабличныйДокументРезультатВыдачи);
	
	УправлениеПечатьюКлиент.РаспечататьТабличныеДокументы(ТабличныеДокументы, ОбъектыПечати, Ложь, 1);
	
КонецПроцедуры
 
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьРезультатыВыдачи()
	
	ТабличныйДокументРезультатВыдачи.Очистить();
	ТабличныйДокументРезультатВыдачи.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СИЗ_РезультатыВыдачи";
	ТабличныйДокументРезультатВыдачи.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ТабДокумент = РезультатыВыдачи(Организация, ФизическоеЛицо, РабочееМесто);
	ТабличныйДокументРезультатВыдачи.Вывести(ТабДокумент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РезультатыВыдачи(Организация, ФизическоеЛицо, РабочееМесто)
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = Обработки.СредстваИндивидуальнойЗащиты.ПолучитьМакет("РезультатыВыдачи");
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.ФизическоеЛицо = ФизическоеЛицо;
	Шапка.Параметры.Организация = Организация;
	Шапка.Параметры.РабочееМесто = РабочееМесто;
	ТабДокумент.Вывести(Шапка);
	
	НормыВыдачиСИЗФизическогоЛица = СредстваИндивидуальнойЗащиты.НормыВыдачиСИЗФизическогоЛица(ФизическоеЛицо, РабочееМесто);
	НормыВыдачиСИЗФизическогоЛица.Сортировать("Требуется Убыв, СледующаяВыдача Убыв");
	
	ТаблицаВыдачи = ТаблицаВыдачи(ФизическоеЛицо);
	
	Для Каждого СтрокаТаблицы Из НормыВыдачиСИЗФизическогоЛица Цикл
		Если СтрокаТаблицы.СледующаяВыдача <= Сегодня Тогда
			ШапкаСИЗ = Макет.ПолучитьОбласть("ШапкаСИЗПросроченная");
		Иначе
			ШапкаСИЗ = Макет.ПолучитьОбласть("ШапкаСИЗ");
		КонецЕсли;
		ШапкаСИЗ.Параметры.Заполнить(СтрокаТаблицы);
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СледующаяВыдача) Тогда
			ШапкаСИЗ.Параметры.СледующаяВыдача = НСтр("ru = 'Немедленно'");
		ИначеЕсли СтрокаТаблицы.Периодичность.СпособВыдачи = Перечисления.СпособыВыдачиСИЗ.ДоИзноса Тогда
			ШапкаСИЗ.Параметры.СледующаяВыдача = НСтр("ru = 'Бессрочно'");
		КонецЕсли;
		ШапкаСИЗ.Параметры.НормаВыдачи = СтрокаТаблицы.Периодичность.Представление;
		
		НайденныеВыдачи = ТаблицаВыдачи.НайтиСтроки(Новый Структура("СИЗ", СтрокаТаблицы.СИЗ));
		БылиВыдачи = НайденныеВыдачи.Количество() > 0;
		ОсталосьВыдать = СтрокаТаблицы.Периодичность.Количество;
		Если БылиВыдачи Тогда
			Для Каждого СтрокаВыдачи Из НайденныеВыдачи Цикл
				Если СтрокаВыдачи.ДатаСледующейВыдачи >= Сегодня Тогда
					ОсталосьВыдать = ОсталосьВыдать - СтрокаВыдачи.Выдано;
				КонецЕсли;
				Если ОсталосьВыдать <= 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ОсталосьВыдать > 0 Тогда
			ШапкаСИЗ.Параметры.ОсталосьВыдать =
				СтрШаблон(НСтр("ru = '%1 %2'"), ОсталосьВыдать, СтрокаТаблицы.Периодичность.ЕдиницаИзмерения);
		КонецЕсли;
		ТабДокумент.Вывести(ШапкаСИЗ);
		
		Если БылиВыдачи Тогда
			ТабДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
			ОбластьСтрокаВыдачи = Макет.ПолучитьОбласть("СтрокаВыдачи");
			Для Каждого СтрокаВыдачи Из НайденныеВыдачи Цикл
				ОбластьСтрокаВыдачи.Параметры.Заполнить(СтрокаВыдачи);
				ТабДокумент.Вывести(ОбластьСтрокаВыдачи);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаВыдачи(ФизическоеЛицо)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	МИНИМУМ(ВыдачиСИЗПоНоменклатуре.Период) КАК ДатаВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи КАК ЗаказНаВыдачу,
		|	ВыдачиСИЗПоНоменклатуре.ДокументВыдачи КАК ВыдачаСИЗ,
		|	МАКСИМУМ(ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи) КАК ДатаСледующейВыдачи,
		|	ЕСТЬNULL(ВыданныеСИЗОстатки.КоличествоОстаток, 0) КАК Выдано
		|ИЗ
		|	РегистрСведений.ВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыданныеСИЗ.Остатки КАК ВыданныеСИЗОстатки
		|		ПО ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо = ВыданныеСИЗОстатки.ФизическоеЛицо
		|			И ВыдачиСИЗПоНоменклатуре.ДокументВыдачи = ВыданныеСИЗОстатки.ДокументВыдачи
		|			И ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи = ВыданныеСИЗОстатки.ОснованиеВыдачи
		|			И ВыдачиСИЗПоНоменклатуре.СИЗ = ВыданныеСИЗОстатки.СИЗ
		|ГДЕ
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо = &ФизическоеЛицо
		|	И ЕСТЬNULL(ВыданныеСИЗОстатки.КоличествоОстаток, 0) > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыдачиСИЗПоНоменклатуре.СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДокументВыдачи,
		|	ЕСТЬNULL(ВыданныеСИЗОстатки.КоличествоОстаток, 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СИЗ,
		|	ДатаВыдачи";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти
