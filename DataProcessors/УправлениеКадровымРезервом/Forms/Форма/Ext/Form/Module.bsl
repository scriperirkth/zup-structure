			Новый УникальныйИдентификатор);
	ИначеЕсли Расшифровка.Действие = "ВключитьВКандидаты" Тогда
		ПараметрыФормы = Новый Структура("УчастникКадровогоРезерва, ПозицияРезерва, Подразделение",
			Расшифровка.ФизическоеЛицо, Расшифровка.ПозицияКадровогоРезерва, Расшифровка.Подразделение);
		ОткрытьФорму("Документ.ЗаявкаНаВключениеВКадровыйРезерв.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,
			Новый УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументПрошлыеРезервистыОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка,
	ДополнительныеПараметры)
	
	Если Не ЗначениеЗаполнено(Расшифровка) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Расшифровка.Действие = "ОткрытьКарточкуСотрудника" Тогда
		ОткрытьКарточкуРезервиста(Расшифровка.ФизическоеЛицо);
	ИначеЕсли Расшифровка.Действие = "СоздатьПозициюКадровогоРезерва" Тогда
		ОткрытьФорму("Справочник.КадровыйРезерв.ФормаОбъекта", Новый Структура("ПозицияШтатногоРасписания",
			Расшифровка.ПозицияШтатногоРасписания));
	ИначеЕсли Расшифровка.Действие = "ПричинаИсключения" Тогда
		Если ЗначениеЗаполнено(Расшифровка.ДокументыСсылка) Тогда
			ПоказатьЗначение( , Расшифровка.ДокументыСсылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

