
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.Грейды") Тогда
		МодульГрейды = ОбщегоНазначения.ОбщийМодуль("Грейды");
		МодульГрейды.НастроитьОтображениеГрейдаВФормеСписка(ЭтотОбъект, "ВТКадровыйРезерв", "КлючевыеДолжности",
			"ПозицияШтатногоРасписания");
	КонецЕсли;
	
	ИспользуетсяКадровыйРезервПоВидам = ПолучитьФункциональнуюОпцию("ИспользоватьКадровыйРезервПоВидам");
	ИспользуютсяЗаявкиНаВключениеВРезерв = ПолучитьФункциональнуюОпцию("ИспользоватьЗаявкиНаВключениеВКадровыйРезерв");
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.КадровыйРезерв.КадровыйРезервГосслужащих") Тогда
		МодульКадровыйРезервГосслужащих = ОбщегоНазначения.ОбщийМодуль("КадровыйРезервГосслужащих");
		МодульКадровыйРезервГосслужащих.ПриСозданииФормыУправлениеКадровымРезервом(ЭтотОбъект);
	КонецЕсли;
	
	УстановитьВидимостьДинамическихСписков();
	УстановитьВидимостьСтраниц();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ТекущиеДанные = Элементы.КлючевыеДолжности.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяСобытия = "ЗаписанаПозицияКадровогоРезерва"
		Или ИмяСобытия = "ЗаписаноИсключениеИзКадровогоРезерва"
		Или ИмяСобытия = "ЗаписанаЗаявкаНаВключениеВКадровыйРезерв"
		Или ИмяСобытия = "ЗаписаноВключениеВКадровыйРезерв"
		Или ИмяСобытия = "ЗаписаноИзменениеСтатусаГотовностиРезервистов" Тогда
		Элементы.КлючевыеДолжности.Обновить();
		ВывестиИнформациюОКадровомРезерве();
	ИначеЕсли ИмяСобытия = "ИспользоватьЗаявкиНаВключениеВКадровыйРезервИзменение" Тогда
		УстановитьВидимостьСтраниц();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТабличныйДокументРезервистыОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка,
	ДополнительныеПараметры)
	
	Если Не ЗначениеЗаполнено(Расшифровка) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Расшифровка.Действие = "ОткрытьКарточкуСотрудника" Тогда
		ОткрытьКарточкуРезервиста(Расшифровка.ФизическоеЛицо);
	ИначеЕсли Расшифровка.Действие = "ИсключитьИзРезерва" Тогда
		ПараметрыФормы = Новый Структура("УчастникКадровогоРезерва, Подразделение", Расшифровка.ФизическоеЛицо,
			Расшифровка.Подразделение);
		ОткрытьФорму("Документ.ИсключениеИзКадровогоРезерва.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,
			Новый УникальныйИдентификатор);
	ИначеЕсли Расшифровка.Действие = "ОткрытьПозициюКадровогоРезерва" Тогда
		ОткрытьФорму("Справочник.КадровыйРезерв.ФормаОбъекта", Новый Структура("Ключ",
			Расшифровка.ПозицияКадровогоРезерва));
	ИначеЕсли Расшифровка.Действие = "СоздатьПозициюКадровогоРезерва" Тогда
		ОткрытьФорму("Справочник.КадровыйРезерв.ФормаОбъекта", Новый Структура("ПозицияШтатногоРасписания",
			Расшифровка.ПозицияШтатногоРасписания));
	ИначеЕсли Расшифровка.Действие = "ВключитьВРезерв" Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПозицияРезерва", Расшифровка.ПозицияКадровогоРезерва);
		ПараметрыФормы.Вставить("Подразделение", Расшифровка.Подразделение);
		Если Расшифровка.Свойство("ВидРезерва") Тогда
			ПараметрыФормы.Вставить("ВидРезерва", Расшифровка.ВидРезерва);
		КонецЕсли;
		ОткрытьФорму("Документ.ВключениеВКадровыйРезерв.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,
			Новый УникальныйИдентификатор);
	ИначеЕсли Расшифровка.Действие = "ОткрытьРезультатыЭкспертнойОценки" Тогда
		ВариантОтчета = "ИндивидуальнаяОценка";
		ПользовательскиеНастройкиОтчета = ПользовательскиеНастройкиОтчетаЭкспертнойОценки(
			Новый Структура("ОпросПоКомпетенциям,ФизическоеЛицо,КлючВарианта", Расшифровка.ОпросПоКомпетенциям,
			Расшифровка.ФизическоеЛицо, ВариантОтчета));
		ПараметрыОтчета = Новый Структура("СформироватьПриОткрытии, КлючВарианта, ПользовательскиеНастройки",
			Истина, ВариантОтчета, ПользовательскиеНастройкиОтчета);
		ОткрытьФорму("Отчет.РезультатыОпросовПоКомпетенциям.Форма", ПараметрыОтчета);
	ИначеЕсли Расшифровка.Действие = "СоздатьИПР" Тогда
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура());
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("Владелец", Расшифровка.УчастникКадровогоРезерва);
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("Основание", Расшифровка.ПозицияКадровогоРезерва);
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("Подразделение", Расшифровка.Подразделение);
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("Наставник", Расшифровка.Наставник);
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("Куратор", Расшифровка.Куратор);
		ОткрытьФорму("Справочник.ИндивидуальныйПланРазвития.ФормаОбъекта",
			ПараметрыФормы, ЭтотОбъект, Расшифровка.УчастникКадровогоРезерва);
	ИначеЕсли Расшифровка.Действие = "ОткрытьИПР" Тогда
		ПараметрыФормы = Новый Структура("Ключ", Расшифровка.ИндивидуальныйПланРазвития);
		ОткрытьФорму("Справочник.ИндивидуальныйПланРазвития.ФормаОбъекта", ПараметрыФормы);
	ИначеЕсли Расшифровка.Действие = "ИзменитьСтатус" Тогда
		ПараметрыФормы = Новый Структура("УчастникКадровогоРезерва, Подразделение", Расшифровка.ФизическоеЛицо,
			Расшифровка.Подразделение);
		ОткрытьФорму("Документ.ИзменениеСтатусаГотовностиРезервистов.Форма.ФормаДокумента", ПараметрыФормы, ЭтотОбъект,
			Новый УникальныйИдентификатор);
	ИначеЕсли Расшифровка.Действие = "УстановитьРейтингОднаЗвезда" Тогда
		ПоставитьРейтингНаСервере(Расшифровка.ПозицияКадровогоРезерва, Расшифровка.ФизическоеЛицо, 1);
		ПодключитьОбработчикОжидания("ВывестиИнформациюОКадровомРезерве", 0.1, Истина);
	ИначеЕсли Расшифровка.Действие = "УстановитьРейтингДвеЗвезды" Тогда
		ПоставитьРейтингНаСервере(Расшифровка.ПозицияКадровогоРезерва, Расшифровка.ФизическоеЛицо, 2);
		ПодключитьОбработчикОжидания("ВывестиИнформациюОКадровомРезерве", 0.1, Истина);
	ИначеЕсли Расшифровка.Действие = "УстановитьРейтингТриЗвезды" Тогда
		ПоставитьРейтингНаСервере(Расшифровка.ПозицияКадровогоРезерва, Расшифровка.ФизическоеЛицо, 3);
		ПодключитьОбработчикОжидания("ВывестиИнформациюОКадровомРезерве", 0.1, Истина);
	ИначеЕсли Расшифровка.Действие = "УстановитьРейтингЧетыреЗвезды" Тогда
		ПоставитьРейтингНаСервере(Расшифровка.ПозицияКадровогоРезерва, Расшифровка.ФизическоеЛицо, 4);
		ПодключитьОбработчикОжидания("ВывестиИнформациюОКадровомРезерве", 0.1, Истина);
	ИначеЕсли Расшифровка.Действие = "УстановитьРейтингПятьЗвезд" Тогда
		ПоставитьРейтингНаСервере(Расшифровка.ПозицияКадровогоРезерва, Расшифровка.ФизическоеЛицо, 5);
		ПодключитьОбработчикОжидания("ВывестиИнформациюОКадровомРезерве", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументСотрудникиОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
