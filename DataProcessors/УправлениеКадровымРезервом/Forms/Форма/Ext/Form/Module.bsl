&НаКлиенте
Процедура ВывестиИнформациюОКадровомРезерве()
	
	ТекущиеДанные = ТекущиеДанныеСписка();
	Если ТекущиеДанные = Неопределено Тогда
		ОчиститьТабличныеДокументы();
		Возврат;
	КонецЕсли;
	
	Если Не ИспользуетсяКадровыйРезервГосслужащих
		И (Не ТекущиеДанные.Свойство("Должность") Или Не ТекущиеДанные.Свойство("ПозицияШтатногоРасписания")) Тогда
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ЗаполнениеКадровогоРезерваДлительнаяОперацияНаСервере(ТекущиеДанные);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершитьВыводИнформацииОКадровомРезерве", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Функция ТекущиеДанныеСписка()
	
	Если ИспользуетсяКадровыйРезервГосслужащих Тогда
		МодульКадровыйРезервГосслужащихКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("КадровыйРезервГосслужащихКлиент");
		ТекущиеДанные = МодульКадровыйРезервГосслужащихКлиент.УправлениеКадровымРезервомТекущиеДанныеСписка(ЭтотОбъект);
	Иначе
		ТекущиеДанные = Элементы.КлючевыеДолжности.ТекущиеДанные;
	КонецЕсли;
	
	Возврат ТекущиеДанные;
	
КонецФункции

&НаСервере
Функция ЗаполнениеКадровогоРезерваДлительнаяОперацияНаСервере(ТекущиеДанные)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Если ИспользуетсяКадровыйРезервГосслужащих Тогда
		МодульКадровыйРезервГосслужащих = ОбщегоНазначения.ОбщийМодуль("КадровыйРезервГосслужащих");
		ДлительнаяОперация = МодульКадровыйРезервГосслужащих.ДлительнаяОперацияЗаполнениеКадровогоРезерва(ЭтотОбъект,
			ПараметрыВыполнения, ТекущиеДанные);
	Иначе
		ДлительнаяОперация = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"Обработки.УправлениеКадровымРезервом.ИнформацияОКадровомРезерве", ТекущиеДанные.Должность,
			ТекущиеДанные.ПозицияШтатногоРасписания, ИспользуютсяЗаявкиНаВключениеВРезерв,
			ИспользуетсяКадровыйРезервПоВидам);
	КонецЕсли;

	Возврат ДлительнаяОперация;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьВыводИнформацииОКадровомРезерве(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВывестиИнформациюОКадровомРезервеНаСервере(Результат.АдресРезультата, ДополнительныеПараметры);  
	
КонецПроцедуры

&НаСервере
Процедура ВывестиИнформациюОКадровомРезервеНаСервере(АдресРезультата, ДополнительныеПараметры)
	
	Если АдресРезультата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокументРезервисты = Результат.Резервисты;
	ТабличныйДокументСотрудники = Результат.Сотрудники;
	Если ИспользуютсяЗаявкиНаВключениеВРезерв Тогда
		ТабличныйДокументКандидаты = Результат.Кандидаты;
	КонецЕсли;
	ТабличныйДокументПотенциальныеРезервисты = Результат.ПотенциальныеРезервисты;
	ТабличныйДокументПрошлыеРезервисты = Результат.ПрошлыеРезервисты;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьТабличныеДокументы()
	
	ТабличныйДокументРезервисты.Очистить();
	ТабличныйДокументСотрудники.Очистить();
	ТабличныйДокументКандидаты.Очистить();
	ТабличныйДокументПотенциальныеРезервисты.Очистить();
	ТабличныйДокументПрошлыеРезервисты.Очистить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПользовательскиеНастройкиОтчетаЭкспертнойОценки(УстанавливаемыйОтбор)
	
	ОтчетОбъект = Отчеты.РезультатыОпросовПоКомпетенциям.Создать();
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(
		ОтчетОбъект.СхемаКомпоновкиДанных.ВариантыНастроек.Найти(УстанавливаемыйОтбор.КлючВарианта).Настройки);
		
	ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОпросПоКомпетенциям",
		УстанавливаемыйОтбор.ОпросПоКомпетенциям);
	
	Для Каждого ЭлементОтбора Из ОтчетОбъект.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ФизическоеЛицо") Тогда
			ЭлементОтбора.ПравоеЗначение = УстанавливаемыйОтбор.ФизическоеЛицо;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки;
	
КонецФункции

&НаКлиенте
Процедура УстановитьОтборыСпискаКлючевыеДолжности()
	
	МассивИндикаторов = Новый Массив;
	Если ИндикаторЕстьРезерв Тогда
		МассивИндикаторов.Добавить(2);
	КонецЕсли;
	Если ИндикаторРезервНеНазначен Тогда
		МассивИндикаторов.Добавить(3);
	КонецЕсли;
	Если ИндикаторРезервЗакончился Тогда
		МассивИндикаторов.Добавить(1);
	КонецЕсли;
	
	Если МассивИндикаторов.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			КлючевыеДолжности, "КартинкаВида", МассивИндикаторов, , , Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			КлючевыеДолжности, "КартинкаВида", МассивИндикаторов, , ,Ложь);
	КонецЕсли;
КонецПроцедуры

