	ИначеЕсли Расшифровка.Действие = "ДобавитьКандидата" Тогда
		ПараметрыФормы = Новый Структура("ПозицияРезерва, ВидРезерва", Расшифровка.ПозицияКадровогоРезерва,
			Расшифровка.ВидРезерва);
		ОткрытьФорму("Документ.ЗаявкаНаВключениеВКадровыйРезерв.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,
			Новый УникальныйИдентификатор);
	ИначеЕсли Расшифровка.Действие = "ИсключитьКандидата" Тогда
		ПараметрыФормы = Новый Структура("УчастникКадровогоРезерва, Подразделение", Расшифровка.ФизическоеЛицо,
			Расшифровка.Подразделение);
		ОткрытьФорму("Документ.ИсключениеИзКадровогоРезерва.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,
			Новый УникальныйИдентификатор);
	ИначеЕсли Расшифровка.Действие = "ВключитьКандидата" Тогда
		ПараметрыФормы = Новый Структура("Подразделение, ПозицияРезерва, УчастникКадровогоРезерва");
		ПараметрыФормы.Подразделение = Расшифровка.Подразделение;
		ПараметрыФормы.ПозицияРезерва = Расшифровка.ПозицияКадровогоРезерва;
		ПараметрыФормы.УчастникКадровогоРезерва = Расшифровка.ФизическоеЛицо;
		Если Расшифровка.Свойство("ВидРезерва") Тогда
			ПараметрыФормы.Вставить("ВидРезерва", Расшифровка.ВидРезерва);
		КонецЕсли;
		ОткрытьФорму("Документ.ВключениеВКадровыйРезерв.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,
			Новый УникальныйИдентификатор);
	ИначеЕсли Расшифровка.Действие = "ОткрытьРезультатыЭкспертнойОценки" Тогда
