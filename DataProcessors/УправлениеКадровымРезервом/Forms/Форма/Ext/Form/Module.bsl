		ПодключитьОбработчикОжидания("ВывестиИнформациюОКадровомРезерве", 0.1, Истина);
	ИначеЕсли Расшифровка.Действие = "УстановитьРейтингДвеЗвезды" Тогда
		ПоставитьРейтингНаСервере(Расшифровка.ПозицияКадровогоРезерва, Расшифровка.ФизическоеЛицо, 2);
		ПодключитьОбработчикОжидания("ВывестиИнформациюОКадровомРезерве", 0.1, Истина);
	ИначеЕсли Расшифровка.Действие = "УстановитьРейтингТриЗвезды" Тогда
		ПоставитьРейтингНаСервере(Расшифровка.ПозицияКадровогоРезерва, Расшифровка.ФизическоеЛицо, 3);
		ПодключитьОбработчикОжидания("ВывестиИнформациюОКадровомРезерве", 0.1, Истина);
	ИначеЕсли Расшифровка.Действие = "УстановитьРейтингЧетыреЗвезды" Тогда
		ПоставитьРейтингНаСервере(Расшифровка.ПозицияКадровогоРезерва, Расшифровка.ФизическоеЛицо, 4);
