Процедура ПКО_ПоследовательностьПолейПоиска_НачисленияТолькоСсылка(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	СтрокаИменСвойствПоиска = ПараметрыОбъекта["СтрокаИменСвойствПоиска"];
	
	
	
	Если ПараметрыОбъекта["КатегорияОсновногоВидРасчета"] <> Неопределено Тогда
	
		
	
		ВидОтпуска = Неопределено;
	
		Если ПараметрыОбъекта["ВидОтпуска"] <> Неопределено Тогда
	
			Попытка
	
				ВидОтпуска = Справочники.ВидыОтпусков[ПараметрыОбъекта["ВидОтпуска"]];
	
			Исключение
	
			КонецПопытки;
	
		КонецЕсли;
	
		
	
		КатегорияОсновногоВидРасчета = Перечисления.КатегорииНачисленийИНеоплаченногоВремени[ПараметрыОбъекта["КатегорияОсновногоВидРасчета"]];
	
		КатегорияНачисления = Перечисления.КатегорииНачисленийИНеоплаченногоВремени[ПараметрыОбъекта["КатегорияНачисления"]];
	
		Запрос = Новый Запрос;
	
		Запрос.УстановитьПараметр("КатегорияНачисления", КатегорияНачисления);
	
		Запрос.УстановитьПараметр("КатегорияОсновногоВидРасчета", КатегорияОсновногоВидРасчета);
	
		Запрос.УстановитьПараметр("ВидОтпуска", ВидОтпуска);
	
		
	
		Запрос.Текст = 
	
		"ВЫБРАТЬ
	
		|	Таблица1.Ссылка КАК Ссылка
	
		|ИЗ
	
		|	ПланВидовРасчета.Начисления КАК Таблица1
	
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовРасчета.Начисления КАК Таблица2
	
		|		ПО Таблица1.ОсновнойВидРасчета = Таблица2.Ссылка
	
		|			И (Таблица2.КатегорияНачисленияИлиНеоплаченногоВремени = &КатегорияОсновногоВидРасчета
	
		|				И Таблица2.ВидОтпуска = &ВидОтпуска)
	
		|ГДЕ
	
		|	НЕ Таблица1.ПометкаУдаления
	
		|	И Таблица1.КатегорияНачисленияИлиНеоплаченногоВремени = &КатегорияНачисления";
	
		Если Не ЗначениеЗаполнено(ВидОтпуска) Тогда
	
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Таблица2.ВидОтпуска = &ВидОтпуска", "");
	
		КонецЕсли;
	
		ОсновныеНачисления = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
		Если ЗначениеЗаполнено(ОсновныеНачисления) Тогда
	
			СсылкаНаОбъект = ОсновныеНачисления[0];
	
		КонецЕсли;
	
		
	
	КонецЕсли;

КонецПроцедуры

