&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	Организация = ОрганизацияПоУмолчанию();
	Если ЗначениеЗаполнено(Организация) Тогда
		ИННОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ИНН");
	КонецЕсли;
	
	РазрешенаРаботаСНовостями = ПолучитьФункциональнуюОпцию("РазрешенаРаботаСНовостями")
		И ПравоДоступа("Просмотр", Метаданные.ОбщиеФормы.ОписаниеИзмененийПрограммы);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.КонфигурацииЗарплатаКадрыРасширенная") Тогда
		Модуль = ОбщегоНазначения.ОбщийМодуль("КонфигурацииЗарплатаКадрыРасширенный");
	Иначе
		Модуль = ОбщегоНазначения.ОбщийМодуль("КонфигурацииЗарплатаКадры");
	КонецЕсли;
	СведенияОКонфигурации = Модуль.СведенияОКонфигурации();
	
	ОтборПоПродукту1С = "ЗУП";
	ИдентификаторСтраницыДокументации = "HRM";
	ИдентификаторСтраницыПолезныеМатериалы = "HRM";
	Если СведенияОКонфигурации.Хозрасчетная Тогда
		Если СведенияОКонфигурации.Корпоративная Тогда
			ИдентификаторСтраницыДокументации = "ZUPCorp";
			ИдентификаторСтраницыПолезныеМатериалы = "HRMCorp";
		КонецЕсли;
	ИначеЕсли СведенияОКонфигурации.Бюджетная Тогда
		ЭтоЗКГУ = Истина;
		ОтборПоПродукту1С = "ЗКГУ";
		ИдентификаторСтраницыПолезныеМатериалы = "StateHRM";
		Если СведенияОКонфигурации.Корпоративная Тогда
			ИдентификаторСтраницыДокументации = "StateHRMCorp";
		Иначе
			ИдентификаторСтраницыДокументации = "StateHRM";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Элементы.ГруппаЧтоНового.Видимость = Форма.РазрешенаРаботаСНовостями;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискОтветаНаВопрос()
	
	ПодключитьОбработчикОжидания("Подключаемый_ОбработкаОжиданияПоискаОтветаНаВопрос", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработкаОжиданияПоискаОтветаНаВопрос()
	
	Если ПустаяСтрока(СтрокаПоискаНаИТС) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПоискаНаИТСURL = КодироватьСсылку(СтрокаПоискаНаИТС);
	ОтборПоПродукту1СURL = КодироватьСсылку(ОтборПоПродукту1С);
	
	СсылкаПоискаИнформации = "http://its.1c.ru/db/alldb#search:";
	СсылкаОтбораПоПродуктам1С = "?attributes[dbnick]=&attributes[conf][]=" + ОтборПоПродукту1СURL + "%203&attribute=conf";
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.БазоваяФункциональностьБИП") Тогда
		МодульИнтернетПоддержкаПользователейКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтернетПоддержкаПользователейКлиент");
		МодульИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуИнтегрированногоСайта(СсылкаПоискаИнформации 
			+ СтрокаПоискаНаИТСURL 
			+ СсылкаОтбораПоПродуктам1С);
	Иначе
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(СсылкаПоискаИнформации 
			+ СтрокаПоискаНаИТСURL 
			+ СсылкаОтбораПоПродуктам1С);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
