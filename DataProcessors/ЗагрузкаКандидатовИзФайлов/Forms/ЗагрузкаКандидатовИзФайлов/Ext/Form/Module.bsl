#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	УстановитьШрифтыПолейТаблицыФайлов();
	
	УстановитьВидимость();
	
	Параметры.Свойство("ЗакрытьФормуПослеЗагрузкиКандидатов", ЗакрытьФормуПослеЗагрузкиКандидатов);
	Параметры.Свойство("Вакансия", Вакансия);
	Если ЗначениеЗаполнено(Вакансия) Тогда
		СтруктураДанныхВакансии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Вакансия, "Подразделение");
		СтруктураДанныхВакансии.Свойство("Подразделение", Подразделение);
	КонецЕсли;
	
	Параметры.Свойство("АдресЗагруженныхДанных", АдресЗагруженныхДанных);
	Если ЗначениеЗаполнено(АдресЗагруженныхДанных) Тогда
		ЗагрузитьКандидатовНаСервере(АдресЗагруженныхДанных);
	КонецЕсли;
	
	ЗначениеФильтра = 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(АдресЗагруженныхДанных) И ДанныеКандидатов.Количество() > 0 Тогда
		ОбработатьДанныеТаблицыКандидатов();
		Возврат;
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьДанныеКандидатов" Тогда
		ДанныеКандидатов.ЗагрузитьЗначения(Параметр);
		Если ДанныеКандидатов.Количество() > 0 Тогда
			ОбработатьДанныеКандидатов();
		КонецЕсли;
	КонецЕсли;
	
	ОбработатьОповещениеЗаписиКандидата(ИмяСобытия, Параметр, Источник);
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ВсеРавноЗакрытьФорму Или Не ЕстьНеЗаписанныеИзменения() Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Отказ = Истина;
	ТекстПредупреждения = НСтр("ru = 'В списке файлов, есть необработанные резюме.
								|Вернуться к работе со списком файлов?'");

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(
		"ОбработатьРезультатВопросаОЗакрытииФормы", ЭтотОбъект);

	Кнопки = РежимДиалогаВопрос.ДаНет;
	ТекстЗаголовка = НСтр("ru = 'Закрытие обработки загрузки кондидатов'");
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстПредупреждения, Кнопки, , КодВозвратаДиалога.Да, ТекстЗаголовка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФильтрыПриИзменении(Элемент)
	УстановитьОтбор();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаКандидатов

&НаКлиенте
Процедура ТаблицаФайловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = ТаблицаКандидатов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ИмяКолонки = Поле.Имя;
	
	Если ТекущаяСтрока.Обработан = Истина Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуКандидата(ТекущаяСтрока);
	ИначеЕсли ИмяКолонки = "ТаблицаФайловЛичныеДанныеКандидата" Тогда 
		ОткрытьФормуПроверкиОднофамильцев(ТекущаяСтрока);
	ИначеЕсли ИмяКолонки = "ТаблицаФайловФИО" Или ИмяКолонки = "ТаблицаФайловПутьКФайлу" Тогда
		СоздатьОбновитьКандидата(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловПриАктивизацииСтроки(Элемент)
	
	СтрокаТаблицы =  Элементы.ТаблицаКандидатов.ТекущиеДанные;
	
	Если СтрокаТаблицы = Неопределено Тогда
		ТекстРезюме = "";
		ТекстРезюмеHTML.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(ТекстРезюме));
		ПолеТекстРезюмеЗаголовок = "";
		ПолеТекстРезюмеПодвал = "";
		ПутьКВыбранномуФайлу = "";
		Возврат;
	КонецЕсли;
	
	// Защищаемся от случая, когда СтруктураРезюме еще не заполнена или не содержит
	// свойства ТекстРезюме (например, для строк, добавленных до завершения разбора).
	СтруктураРезюме = СтрокаТаблицы.СтруктураРезюме;
	Если ТипЗнч(СтруктураРезюме) = Тип("Структура") И СтруктураРезюме.Свойство("ТекстРезюме") Тогда
		ТекстРезюме = СтруктураРезюме.ТекстРезюме;
	Иначе
		ТекстРезюме = "";
	КонецЕсли;
	ТекстРезюмеHTML.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(ТекстРезюме));
	Если ПутьКВыбранномуФайлу <> СтрокаТаблицы.ПутьКФайлу Тогда
		ПутьКВыбранномуФайлу = СтрокаТаблицы.ПутьКФайлу;
		ПолеТекстРезюмеЗаголовок = СтрокаТаблицы.ИмяФайла;
		ПолеТекстРезюмеПодвал = СтрШаблон(
			НСтр("ru = 'Изменен - %1 - %2 Кб'"), СтрокаТаблицы.ДатаИзмененияФайла, СтрокаТаблицы.РазмерФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловПередУдалением(Элемент, Отказ)

	ПутьКВыбранномуФайлу = "";

	Для Каждого ИдентификаторСтроки Из Элементы.ТаблицаКандидатов.ВыделенныеСтроки Цикл
		ТекСтрока = ТаблицаКандидатов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекСтрока.АдресКартинки <> "" Тогда
			УдалитьИзВременногоХранилища(ТекСтрока.АдресКартинки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловПослеУдаления(Элемент)
	
	ПроверитьНаДубли();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловКандидатПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ТаблицаКандидатов.ТекущиеДанные;
	ОбработатьРезультатВыбораКандидата(ТекущиеДанные.Кандидат);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловВакансияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаКандидатов.ТекущиеДанные;
	ОбработатьСтрокуПриИзмененииВакансии(ТекущиеДанные, Истина);
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловПодразделениеПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ТаблицаКандидатов.ТекущиеДанные;
	ОбработатьСтрокуПриИзмененииПодразделения(ТекущиеДанные, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловГруппаДоступаПриИзменении(Элемент)
	
	ТекущаяСтрока = ТаблицаКандидатов.НайтиПоИдентификатору(Элементы.ТаблицаКандидатов.ТекущаяСтрока);
	
	ТекущаяСтрока.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(ТекущаяСтрока);
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьФайлыРезюме(Команда)
	
	РазборРезюмеКлиент.СоздатьКандидатовПоФайлам(УникальныйИдентификатор, Вакансия,, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлыРезюмеИзКаталога(Команда)
	
	ФайловаяСистемаКлиент.ВыбратьКаталог(
		Новый ОписаниеОповещения("ЗавершитьВыборКаталога", ЭтотОбъект),
		НСтр("ru = 'Выберите каталог'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьРезюмеВБазу(Команда)

	Если ТаблицаКандидатов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();

	// Собираем со строк таблицы всё, что нужно серверу для записи кандидатов.
	// Серверной записи (ЗаписатьКандидата) двоичные данные файлов не нужны.
	ДанныеДляЗагрузки = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаКандидатов Цикл
		Если Не СтрокаТаблицы.ДоступноДляЗагрузки Или СтрокаТаблицы.Обработан Тогда
			Продолжить;
		КонецЕсли;

		ДанныеКандидата = СтрокаТаблицы.СтруктураРезюме;
		ДанныеКандидата.Вакансия = СтрокаТаблицы.Вакансия;
		ДанныеКандидата.Подразделение = СтрокаТаблицы.Подразделение;
		ДанныеКандидата.ЛичныеДанныеКандидата = СтрокаТаблицы.ЛичныеДанныеКандидата;
		ДанныеКандидата.ГруппаДоступаКандидата = СтрокаТаблицы.ГруппаДоступа;

		Элемент = Новый Структура;
		Элемент.Вставить("ИндексВТаблице", ТаблицаКандидатов.Индекс(СтрокаТаблицы));
		Элемент.Вставить("Кандидат", СтрокаТаблицы.Кандидат);
		// Признаки нового нужны для счётчиков статистики.
		Элемент.Вставить("ЭтоНовыйКандидат", СтрокаТаблицы.ЭтоНовыйКандидат);
		Элемент.Вставить("ЭтоНовыеЛичныеДанныеКандидата", СтрокаТаблицы.ЭтоНовыеЛичныеДанныеКандидата);
		Элемент.Вставить("ДанныеКандидата", ДанныеКандидата);
		ДанныеДляЗагрузки.Добавить(Элемент);
	КонецЦикла;

	Если ДанныеДляЗагрузки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет строк, доступных для загрузки.'"));
		Возврат;
	КонецЕсли;

	// Передаём подготовленные данные напрямую параметром в фоновую операцию
	// (через временное хранилище фон не получает данные из-за другого контекста).
	ДлительнаяОперация = ДлительнаяОперацияЗагрузки(УникальныйИдентификатор, ДанныеДляЗагрузки);

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Идет загрузка кандидатов из файлов'");
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;

	// Привязка к форме обеспечивает отмену фонового задания при закрытии формы
	// или нажатии "Отмена" в окне ожидания: БСП сигнализирует заданию, а очередной
	// вызов ДлительныеОперации.СообщитьПрогресс в фоне выбросит исключение.
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершитьЗагрузкуКандидатовВБазу", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура СброситьВакансию(Команда)

	Для Каждого ИдентификаторСтроки Из Элементы.ТаблицаКандидатов.ВыделенныеСтроки Цикл
		ТекущиеДанные = ТаблицаКандидатов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекущиеДанные.Обработан Или ТекущиеДанные.Вакансия.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		ТекущиеДанные.Вакансия = Неопределено;
		СброситьКандидатаВСтроке(ТекущиеДанные);
	КонецЦикла;

	ПроверитьНаДубли();
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();

КонецПроцедуры

&НаКлиенте
Процедура СброситьПодразделение(Команда)

	Для Каждого ИдентификаторСтроки Из Элементы.ТаблицаКандидатов.ВыделенныеСтроки Цикл
		ТекущиеДанные = ТаблицаКандидатов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекущиеДанные.Обработан Или ТекущиеДанные.Подразделение.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		ТекущиеДанные.Подразделение = Неопределено;
		ТекущиеДанные.Вакансия = Неопределено;
		СброситьКандидатаВСтроке(ТекущиеДанные);
	КонецЦикла;

	ПроверитьНаДубли();
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();

КонецПроцедуры

&НаКлиенте
Процедура СброситьГруппуДоступа(Команда)

	Для Каждого ИдентификаторСтроки Из Элементы.ТаблицаКандидатов.ВыделенныеСтроки Цикл
		ТекущиеДанные = ТаблицаКандидатов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекущиеДанные.Обработан Тогда
			Продолжить;
		КонецЕсли;
		ТекущиеДанные.ГруппаДоступа = Неопределено;
		ТекущиеДанные.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(ТекущиеДанные);
	КонецЦикла;

	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВакансию(Команда)
	
	ПараметрыФормыВыбора = Новый Структура();
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);

	ОткрытьФорму("Справочник.Вакансии.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект, ЭтотОбъект, , , 
		Новый ОписаниеОповещения("ЗаполнитьВакансиюПродолжение", ЭтотОбъект), 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодразделение(Команда)
	
	ПараметрыФормыВыбора = Новый Структура();
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормыВыбора.Вставить("ТекущаяСтрока");

	Если СтруктураПредприятияНеСоответствуетСтруктуреЮридическихЛиц() Тогда
		ПараметрыФормыВыбора.Вставить("ТолькоИсточникНеЗаполнен", Истина);
	КонецЕсли;

	ОткрытьФорму("Справочник.СтруктураПредприятия.ФормаСписка", ПараметрыФормыВыбора, ЭтотОбъект, ЭтотОбъект, , , 
		Новый ОписаниеОповещения("ЗаполнитьПодразделениеПродолжение", ЭтотОбъект), 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГруппуДоступа(Команда)
	
	ПараметрыФормыВыбора = Новый Структура();
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормыВыбора.Вставить("ТекущаяСтрока");

	ОткрытьФорму("Справочник.ГруппыДоступаКандидатов.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект, ЭтотОбъект, , , 
		Новый ОписаниеОповещения("ЗаполнитьГруппуДоступаПродолжение", ЭтотОбъект), 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТабличныйФайл(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьЗагрузкуКандидатов", ЭтотОбъект);
	ПодборПерсоналаКлиент.ПоказатьФормуЗагрузкиКандидатов(Оповещение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция СтруктураПредприятияНеСоответствуетСтруктуреЮридическихЛиц()
	Возврат ПолучитьФункциональнуюОпцию("СтруктураПредприятияНеСоответствуетСтруктуреЮридическихЛиц");
КонецФункции

&НаКлиенте
Процедура ОбработатьОповещениеЗаписиКандидата(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия <> "Запись_Кандидаты" Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметр) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ФайлРезюмеДляЗагрузки = "";
	Параметр.Свойство("ФайлРезюмеДляЗагрузки", ФайлРезюмеДляЗагрузки);
	Если Не ЗначениеЗаполнено(ФайлРезюмеДляЗагрузки) Тогда
		Возврат;
	КонецЕсли;

	НайденныеСтроки = ТаблицаКандидатов.НайтиСтроки(Новый Структура("ПутьКФайлу", ФайлРезюмеДляЗагрузки));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ДанныеКандидата = ДанныеКандидата(Источник);
	
	ДанныеРезюме = НайденныеСтроки[0];
	
	ДанныеРезюме.ФИО = ДанныеКандидата.Наименование;
	ДанныеРезюме.Вакансия = ДанныеКандидата.Вакансия;
	ДанныеРезюме.Подразделение = ДанныеКандидата.Подразделение;
	ДанныеРезюме.ЛичныеДанныеКандидата = ДанныеКандидата.ЛичныеДанныеКандидата;
	ДанныеРезюме.Кандидат = Источник;
	ДанныеРезюме.ЭтоНовыеЛичныеДанныеКандидата = Ложь;
	ДанныеРезюме.ЭтоНовыйКандидат = Ложь;
	ДанныеРезюме.ДоступноДляЗагрузки = Истина;
	ДанныеРезюме.Обработан = Истина;
	
	Если ЗначениеЗаполнено(ДанныеРезюме.ЛичныеДанныеКандидата) Тогда
		ДанныеРезюме.ГруппаДоступа = ГруппаДоступаКандидата(ДанныеРезюме.ЛичныеДанныеКандидата);
	КонецЕсли;
	
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()

	Если УправлениеДоступом.ОграничиватьДоступНаУровнеЗаписей()
	 	И УправлениеДоступомСлужебный.ВидДоступаИспользуется("ГруппыКандидатов") Тогда
	 	ИспользоватьГруппыДоступа = Истина;
	КонецЕсли;
	
	Элементы.ТаблицаФайловГруппаДоступа.Видимость = ИспользоватьГруппыДоступа;
	Элементы.ТаблицаФайловЗаполнитьГруппуДоступа.Видимость = ИспользоватьГруппыДоступа;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
 
	УсловноеОформление.Элементы.Очистить();
	
	// Оформление поля ФИО в случае дублей.
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаФайловФИО.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.ЕстьДубль");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПросроченныеДанныеЦвет);

	// Оформление поля Личные данные кандидата в случае, если это не новые личные данные кандидата.
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаФайловЛичныеДанныеКандидата.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.ЭтоНовыеЛичныеДанныеКандидата");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.ЛичныеДанныеКандидата");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Оформление поля Личные данные кандидата в случае, если это новые личные данные кандидата.
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаФайловЛичныеДанныеКандидата.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.ЭтоНовыеЛичныеДанныеКандидата");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.ЛичныеДанныеКандидата");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<Новые личные данные>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	
	// Оформление поля Кандидат в случае, если это не новый кандидат.
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаФайловКандидат.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.ЭтоНовыйКандидат");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.Кандидат");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Оформление поля Кандидат в случае, если это новый кандидат.
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаФайловКандидат.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.ЭтоНовыйКандидат");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКандидатов.Кандидат");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<Новый кандидат>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьШрифтыПолейТаблицыФайлов()

	ШрифтПолей = ШрифтыСтиля.ВажнаяНадписьШрифт;
	Элементы.ТаблицаФайловФИО.Шрифт = ШрифтПолей;
	Элементы.ТаблицаФайловПутьКФайлу.Шрифт = ШрифтПолей;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	ДоступностьКнопок = ТаблицаКандидатов.Количество();
	Элементы.ТаблицаФайловКонтекстноеМенюЗаполнитьВакансию.Доступность = ДоступностьКнопок;
	Элементы.ТаблицаФайловКонтекстноеМенюСброситьВакансию.Доступность = ДоступностьКнопок;
	Элементы.ТаблицаФайловКонтекстноеМенюЗаполнитьПодразделение.Доступность = ДоступностьКнопок;
	Элементы.ТаблицаФайловКонтекстноеМенюСброситьПодразделение.Доступность = ДоступностьКнопок;
	
	Элементы.ТаблицаФайловЗаполнитьВакансию.Доступность = ДоступностьКнопок;
	Элементы.ТаблицаФайловЗаполнитьПодразделение.Доступность = ДоступностьКнопок;
	Элементы.ТаблицаФайловЗаполнитьГруппуДоступа.Доступность = ДоступностьКнопок;
	
	УстановитьДоступностьКнопкиЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопкиЗагрузки()
	
	КнопкаДоступна = ТаблицаКандидатов.Количество();
	
	Для Каждого ТекСтрока Из ТаблицаКандидатов Цикл
		Если Не ТекСтрока.ДоступноДляЗагрузки Тогда
			КнопкаДоступна = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ЗагрузитьКандидатовВБазу.Доступность = КнопкаДоступна;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтбор()
	
	СтруктураОтбора = Новый Структура();
	
	Если ЗначениеФильтра = 2 Тогда
		СтруктураОтбора.Вставить("ЭтоНовыеЛичныеДанныеКандидата", Истина);
		СтруктураОтбора.Вставить("ЭтоНовыйКандидат", Истина);
	ИначеЕсли ЗначениеФильтра = 3 Тогда
		СтруктураОтбора.Вставить("ЭтоНовыеЛичныеДанныеКандидата", Ложь);
	ИначеЕсли ЗначениеФильтра = 4 Тогда
		СтруктураОтбора.Вставить("ДоступноДляЗагрузки", Ложь);
	КонецЕсли;
	
	Элементы.ТаблицаКандидатов.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборКаталога(ПутьККаталогу, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ПутьККаталогу) Или ПутьККаталогу = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачатьПоискФайлов(Новый ОписаниеОповещения("ЗавершитьПоискФайлов", ЭтотОбъект),
		ПутьККаталогу, ПолучитьМаскуВсеФайлы(), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПоискФайлов(НайденныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если НайденныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Файлы = Новый Массив;
	Для Каждого Файл Из НайденныеФайлы Цикл
		Если Не ЗначениеЗаполнено(Файл.Расширение) Тогда
			Продолжить;
		КонецЕсли;
		Если РазборРезюмеКлиент.ЭтоФайлСДоступнымРасширением(Файл.Имя) Тогда
			Файлы.Добавить(Новый ОписаниеПередаваемогоФайла(Файл.ПолноеИмя));
		КонецЕсли;
	КонецЦикла;
	
	РазборРезюмеКлиент.СоздатьКандидатовПоФайлам(УникальныйИдентификатор, Вакансия, Файлы, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДанныеКандидатов()
	
	КоличествоДанныхКандидатов = ДанныеКандидатов.Количество();
	
	Счетчик = 0;
	Для Каждого ДанныеКандидата Из ДанныеКандидатов Цикл
		
		ЗначениеДанных = ДанныеКандидата.Значение;
		Путь = ЗначениеДанных.ФайлРезюме.ПолноеИмя;
		АдресФайла = ЗначениеДанных.ФайлРезюме.Хранение;
		
		Состояние(НСтр("ru = 'Подготовка файлов для обработки...'"), Счетчик / КоличествоДанныхКандидатов * 100, Путь);
		
		Если СтрНайти(Путь, "~$") > 0 Тогда // Пропускаем файлы владельца MS Word
			Продолжить;
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаКандидатов.НайтиСтроки(Новый Структура("ПутьКФайлу", Путь));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
			
		ФайлРезюме = Новый Файл(Путь);
		
		// Обращаемся к файловой системе в попытке: файл может быть недоступен
		// (удалён, заблокирован, нет прав) - тогда пропускаем строку, чтобы не
		// прерывать обработку остальных файлов.
		Попытка
			ИмяФайла = ФайлРезюме.Имя;
			РасширениеФайла = ФайлРезюме.Расширение;
			НоваяСтрока = ТаблицаКандидатов.Добавить();
			НоваяСтрока.Представление = ФайлРезюме.ИмяБезРасширения;
			НоваяСтрока.ПутьКФайлу = Путь;
			НоваяСтрока.АдресФайла = АдресФайла;
			НоваяСтрока.ИмяФайла = ИмяФайла;
			Если Не РазборРезюмеКлиент.ЭтоВебКлиент() Тогда
				НоваяСтрока.РазмерФайла = ФайлРезюме.Размер()/1024;
				НоваяСтрока.ДатаИзмененияФайла = ФайлРезюме.ПолучитьВремяИзменения();
			КонецЕсли;
			ЗаполнитьСтрокуТаблицыОсновнымиДанными(НоваяСтрока, ЗначениеДанных, РасширениеФайла);
			ПроверитьНаличиеПохожихКандидатов(НоваяСтрока, ЗначениеДанных);
		Исключение
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось прочитать файл ""%1"": %2. Строка пропущена.'"),
				Путь, ТекстОшибки);
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = ТекстСообщения;
			СообщениеПользователю.Сообщить();
			Продолжить;
		КонецПопытки;
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	ПроверитьНаДубли();
	ТаблицаКандидатов.Сортировать("ФИО Возр");
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДанныеТаблицыКандидатов()
	
	КоличествоДанныхКандидатов = ДанныеКандидатов.Количество();
	
	Счетчик = 0;
	Для Каждого ДанныеКандидата Из ДанныеКандидатов Цикл
		ЗначениеДанных = ДанныеКандидата.Значение;
		Состояние(НСтр("ru = 'Подготовка данных для обработки...'"), Счетчик / КоличествоДанныхКандидатов * 100);
		НоваяСтрока = ТаблицаКандидатов.Добавить();
		ЗаполнитьСтрокуТаблицыОсновнымиДанными(НоваяСтрока, ЗначениеДанных, "xls");
		ПроверитьНаличиеПохожихКандидатов(НоваяСтрока, ЗначениеДанных);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	ПроверитьНаДубли();
	ТаблицаКандидатов.Сортировать("ФИО Возр");
	ДанныеКандидатов.Очистить();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтрокуТаблицыОсновнымиДанными(НоваяСтрока, ЗначениеДанных, РасширениеФайла)
	
	НоваяСтрока.ИндексКартинки = РаботаСФайламиСлужебныйКлиентСервер.ИндексПиктограммыФайла(РасширениеФайла);
	НоваяСтрока.ЭтоНовыеЛичныеДанныеКандидата = Истина;
	НоваяСтрока.ЭтоНовыйКандидат = Истина;
	НоваяСтрока.ДоступноДляЗагрузки = Истина;
	НоваяСтрока.Вакансия = ?(ЗначениеЗаполнено(Вакансия), Вакансия, ЗначениеДанных.Вакансия);
	НоваяСтрока.Подразделение = ?(ЗначениеЗаполнено(Подразделение), Подразделение, ЗначениеДанных.Подразделение);
	НоваяСтрока.СтруктураРезюме = ЗначениеДанных;
	
	НоваяСтрока.Фамилия		= СОКРЛП(ЗначениеДанных.Фамилия);
	НоваяСтрока.Имя			= СОКРЛП(ЗначениеДанных.Имя);
	НоваяСтрока.Отчество	= СОКРЛП(ЗначениеДанных.Отчество);
	
	НоваяСтрока.ФИО = СтрШаблон("%1 %2 %3",
		НоваяСтрока.Фамилия,
		НоваяСтрока.Имя,
		НоваяСтрока.Отчество);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеПохожихКандидатов(НоваяСтрока, ЗначениеДанных)
	
	РезультатПоиска = РезультатПоискаПохожихКандидатов(НоваяСтрока, ЗначениеДанных);
	НоваяСтрока.ЭтоНовыеЛичныеДанныеКандидата = РезультатПоиска.КандидатУникален;
	
	Если Не РезультатПоиска.КандидатУникален Тогда
		Если РезультатПоиска.ДанныеКандидатовДоступны Тогда
			СовпадающиеКандидаты = Новый Массив; 
			Для Каждого ПараметрыПроверкиДанныеКандидата Из РезультатПоиска.ДанныеКандидатов Цикл
				Если СтрНайти(ПараметрыПроверкиДанныеКандидата.СовпадающиеДанные, "E-mail") > 0
					Или СтрНайти(ПараметрыПроверкиДанныеКандидата.СовпадающиеДанные, "Телефон") > 0 Тогда
					// Если нашли по телефону или электронной почте, то будем считать что это тот же человек.
					СовпадающиеКандидаты.Добавить(ПараметрыПроверкиДанныеКандидата.ЛичныеДанныеКандидата);
				ИначеЕсли ЗначениеЗаполнено(ЗначениеДанных.ДатаРождения) 
					И ПараметрыПроверкиДанныеКандидата.ДатаРождения = ЗначениеДанных.ДатаРождения Тогда
					// Будем считать, что кандидаты с одинаковым ФИО и датами рождения, являются одним человеком.
					СовпадающиеКандидаты.Добавить(ПараметрыПроверкиДанныеКандидата.ЛичныеДанныеКандидата);
				КонецЕсли;
			КонецЦикла;
			Если СовпадающиеКандидаты.Количество() = 1 Тогда
				НоваяСтрока.ЛичныеДанныеКандидата = СовпадающиеКандидаты[0];
				НоваяСтрока.ГруппаДоступа = ГруппаДоступаКандидата(НоваяСтрока.ЛичныеДанныеКандидата);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(НоваяСтрока.ЛичныеДанныеКандидата) Тогда
			ЗаполнитьКандидата(НоваяСтрока);
		КонецЕсли;
		НоваяСтрока.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(НоваяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция РезультатПоискаПохожихКандидатов(СтрокаТаблицыФайлов, ДанныеКандидата)
	
	ПараметрыПоиска = ПодборПерсоналаВызовСервера.ПараметрыПоискаПохожихКандидатов();
	ЗаполнитьЗначенияСвойств(ПараметрыПоиска, СтрокаТаблицыФайлов, "Фамилия,Имя,Отчество");
	
	Для Каждого КлючЗначение Из ДанныеКандидата Цикл
		Если КлючЗначение.Ключ <> "КонтактнаяИнформация" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ЭлементКИ Из КлючЗначение.Значение Цикл
			Если ЭлементКИ.Вид = ПредопределенноеЗначение(
				"Справочник.ВидыКонтактнойИнформации.EMailЛичныеДанныеКандидатов") Тогда
				ПараметрыПоиска.Email = ЭлементКИ.Представление;
			ИначеЕсли ЭлементКИ.Вид = ПредопределенноеЗначение(
				"Справочник.ВидыКонтактнойИнформации.ТелефонЛичныеДанныеКандидатов") Тогда
				ПараметрыПоиска.Телефон = ЭлементКИ.Представление;
			КонецЕсли;
		КонецЦикла;
		Прервать;
	КонецЦикла;
	
	РезультатПоиска = ПодборПерсоналаВызовСервера.ПохожиеКандидаты(ПараметрыПоиска);
		
	Возврат РезультатПоиска;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьОповещениеОЗавершении(Результат)

	ТекстСообщения = "";
	Если Результат.СозданоКандидатов > 0 Тогда
		ДобавитьТекстСообщения(ТекстСообщения,
			СообщениеСЧислом(
				НСтр("ru = ';Создан %1 кандидат;;Создано %1 кандидата;Создано %1 кандидатов;Создано %1 кандидата'"),
				Результат.СозданоКандидатов));
	КонецЕсли;
	Если Результат.ОбновленоКандидатов > 0 Тогда
		ДобавитьТекстСообщения(ТекстСообщения,
			СообщениеСЧислом(
				НСтр("ru = ';Обновлен %1 кандидат;;Обновлено %1 кандидата;Обновлено %1 кандидатов;Обновлено %1 кандидата'"),
				Результат.ОбновленоКандидатов));
	КонецЕсли;

	Кнопки = Новый СписокЗначений();
	Кнопки.Добавить(КодВозвратаДиалога.ОК);

	ПараметрыПредупреждения = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыПредупреждения.Заголовок = НСтр("ru = 'Загрузка резюме завершена'");
	ПараметрыПредупреждения.Картинка = БиблиотекаКартинок.Информация32;
	ПараметрыПредупреждения.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;

	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(, ТекстСообщения, Кнопки, ПараметрыПредупреждения);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗагрузкуКандидатовВБазу(Результат, ДополнительныеПараметры) Экспорт

	// Пользователь отменил задание ("Отмена" в окне ожидания или закрытие формы):
	// фон прервал работу через СообщитьПрогресс, транзакция откатилась,
	// ни один кандидат не записан. Просто обновим форму.
	Если Результат = Неопределено Тогда
		ОбновитьЭлементыФормы();
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		ОбновитьЭлементыФормы();
		Возврат;
	КонецЕсли;

	// Успех: применяем загруженные строки и обновляем форму.
	АдресРезультата = Результат.АдресРезультата;
	Если ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		РезультатЗагрузки = ПолучитьИзВременногоХранилища(АдресРезультата);
		УдалитьИзВременногоХранилища(АдресРезультата);
		ПрименитьРезультатЗагрузки(РезультатЗагрузки);
	КонецЕсли;

	ОбновитьЭлементыФормы();

	Если ТаблицаКандидатов.Количество() = 0 И ЗакрытьФормуПослеЗагрузкиКандидатов Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьРезультатЗагрузки(РезультатЗагрузки)

	Если РезультатЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИндексСтроки Из РезультатЗагрузки.ИндексыСтрок Цикл
		Если ИндексСтроки < ТаблицаКандидатов.Количество() Тогда
			ТекСтрока = ТаблицаКандидатов[ИндексСтроки];
			Если ТекСтрока.АдресКартинки <> "" Тогда
				УдалитьИзВременногоХранилища(ТекСтрока.АдресКартинки);
			КонецЕсли;
			ТаблицаКандидатов.Удалить(ИндексСтроки);
		КонецЕсли;
	КонецЦикла;

	ПроверитьНаДубли();
	УстановитьОтбор();

	ПоказатьОповещениеОЗавершении(РезультатЗагрузки);

	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("Вакансии", РезультатЗагрузки.Вакансии);
	ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъектов(
		РезультатЗагрузки.Кандидаты, ПараметрыОповещения);

	// Очищаем исходные данные, чтобы при повторном добавлении файлов
	// (или повторном оповещении) в ТаблицаКандидатов не попали уже загруженные кандидаты.
	ДанныеКандидатов.Очистить();
	АдресЗагруженныхДанных = "";

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекстСообщения(ТекстСообщения, Добавить)
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС;
	КонецЕсли;
	ТекстСообщения = ТекстСообщения + Добавить;
КонецПроцедуры

&НаКлиенте
Функция СообщениеСЧислом(Шаблон, Число)
	Возврат СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(Шаблон, Число);
КонецФункции

&НаКлиенте
Функция РезюмеДоступноДляАвтоматическойЗагрузки(ДанныеРезюме)
	
	Результат = Истина;
	
	Результат = (Результат И (ДанныеРезюме.ЭтоНовыеЛичныеДанныеКандидата
		ИЛИ ЗначениеЗаполнено(ДанныеРезюме.ЛичныеДанныеКандидата)));
	Результат = (Результат И (ДанныеРезюме.ЭтоНовыйКандидат Или ЗначениеЗаполнено(ДанныеРезюме.Кандидат)));
	Результат = (Результат И (Не ДанныеРезюме.ЕстьДубль));
	Результат = (Результат И ЗначениеЗаполнено(ДанныеРезюме.Подразделение));
	
	Если ИспользоватьГруппыДоступа Тогда
		Результат = (Результат И ЗначениеЗаполнено(ДанныеРезюме.ГруппаДоступа));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДлительнаяОперацияЗагрузки(ИдентификаторФормы, ДанныеКандидатов)

	// Серверная обёртка над менеджером обработки: с клиента напрямую
	// Обработки недоступны, поэтому запуск длительной операции делаем здесь.
	Возврат Обработки.ЗагрузкаКандидатовИзФайлов.ДлительнаяОперацияЗагрузки(
		ИдентификаторФормы, ДанныеКандидатов);

КонецФункции

&НаСервереБезКонтекста
Функция КандидатыПоЛичнымДаннымКандидата(ЛичныеДанныеКандидата, Вакансия, Подразделение)
	
	Отбор = Новый Структура("ЛичныеДанные", ЛичныеДанныеКандидата);
	
	Если ЗначениеЗаполнено(Вакансия) Тогда
		Отбор.Вставить("Вакансия", Вакансия);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Отбор.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	
	Кандидаты = Справочники.Кандидаты.КандидатыПоОтбору(Отбор);
	
	Возврат Кандидаты;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеВакансии(Вакансия)
	
	Если Не ЗначениеЗаполнено(Вакансия) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Справочники.Вакансии.ДанныеВакансии(Вакансия);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеКандидата(Кандидат) 
	Возврат Справочники.Кандидаты.ДанныеКандидата(Кандидат);
КонецФункции

&НаСервереБезКонтекста
Функция СовпадаютКлючевыеДанные(РезультатПоиска)
	
	НовыйРезультатПоиска = ПоискФизическихЛиц.НовыйРезультатПоискаПохожихЛюдей();
	НовыйРезультатПоиска.РезультатПоискаКандидатов = РезультатПоиска;
	НовыйРезультатПоиска.КоличествоПохожихЧеловек = РезультатПоиска.ДанныеКандидатов.Количество();
	СовпадающиеДанные = ПоискФизическихЛиц.СовпадающиеДанные(НовыйРезультатПоиска);
	
	Если СовпадающиеДанные.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИменаКлючевыхДанных = Новый Массив;
	ИменаКлючевыхДанных.Добавить("Телефон");
	ИменаКлючевыхДанных.Добавить("E-mail");
	
	Для Каждого Имя Из ИменаКлючевыхДанных Цикл
		Если СовпадающиеДанные.Найти(Имя) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуПроверкиОднофамильцев(ТекущаяСтрока)
	
	РезультатПоиска = РезультатПоискаПохожихКандидатов(ТекущаяСтрока, ТекущаяСтрока.СтруктураРезюме);
	Если РезультатПоиска.КандидатУникален Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = СотрудникиКлиент.ПараметрыОткрытияФормыФизическиеЛицаСПохожимиДанными(РезультатПоиска);
	ПараметрыОткрытия.УчитыватьОтрицательныйВыбор = Истина;
	ПараметрыОткрытия.СкрытьКомандуДругойЧеловек = СовпадаютКлючевыеДанные(РезультатПоиска);
	
	ОткрытьФорму("Справочник.ФизическиеЛица.Форма.ФизическиеЛицаСПохожимиДанными", ПараметрыОткрытия, ЭтотОбъект, , , , 
		Новый ОписаниеОповещения("ПроверкаОднофамильцевЗавершение", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаОднофамильцевЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = ТаблицаКандидатов.НайтиПоИдентификатору(Элементы.ТаблицаКандидатов.ТекущаяСтрока);
	
	Если ТипЗнч(РезультатВыбора) = Тип("Булево") Тогда
		ТекущаяСтрока.ЭтоНовыеЛичныеДанныеКандидата = Не РезультатВыбора;
		ТекущаяСтрока.ЛичныеДанныеКандидата = Неопределено;
	Иначе	
		ТекущаяСтрока.ЭтоНовыеЛичныеДанныеКандидата = РезультатВыбора.ПохожийЧеловек.Пустая();
		ТекущаяСтрока.ЛичныеДанныеКандидата = РезультатВыбора.ПохожийЧеловек;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ЛичныеДанныеКандидата) Тогда
		Если ИспользоватьГруппыДоступа Тогда
			ТекущаяСтрока.ГруппаДоступа = ГруппаДоступаКандидата(ТекущаяСтрока.ЛичныеДанныеКандидата);
		КонецЕсли;
		ЗаполнитьКандидата(ТекущаяСтрока);
	Иначе
		ТекущаяСтрока.Кандидат = Неопределено;
		ТекущаяСтрока.ЭтоНовыйКандидат = Истина;
	КонецЕсли;
	
	ПроверитьНаДубли();
	ТекущаяСтрока.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(ТекущаяСтрока);
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыбораКандидата(РезультатВыбора)
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = ТаблицаКандидатов.НайтиПоИдентификатору(Элементы.ТаблицаКандидатов.ТекущаяСтрока);
	
	Если РезультатВыбора.Пустая() Тогда
		ТекущаяСтрока.ЭтоНовыйКандидат = Истина;
	Иначе
		ТекущаяСтрока.Кандидат = РезультатВыбора;
		ДанныеКандидата = ДанныеКандидата(ТекущаяСтрока.Кандидат);
		ТекущаяСтрока.Вакансия = ДанныеКандидата.Вакансия;
		ТекущаяСтрока.Подразделение = ДанныеКандидата.Подразделение;
		ТекущаяСтрока.ЛичныеДанные = ДанныеКандидата.ЛичныеДанныеКандидата;
	КонецЕсли;
	
	ПроверитьНаДубли();
	ТекущаяСтрока.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбновитьКандидата(ТекущаяСтрока)

	// Помещает файл резюме на сервер и открывает форму нового кандидата
	// для интерактивного редактирования.
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДанныеРезюме", ТекущаяСтрока);

	МассивФайлов = Новый Массив();
	МассивФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ТекущаяСтрока.ПутьКФайлу, ТекущаяСтрока.АдресФайла));

	Если ЗначениеЗаполнено(ТекущаяСтрока.АдресФайла) Или Не ЗначениеЗаполнено(ТекущаяСтрока.ПутьКФайлу) Тогда
		ЗакончитьСозданиеКандидатаПослеПомещенияФайлов(МассивФайлов, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;

	Если Не РаботаСФайламиСлужебныйКлиент.Расширение1СПредприятияПодключено() Тогда
		// Веб-клиент без расширения для работы с файлами.
		Попытка
			НачатьПомещениеФайлаНаСервер(
				Новый ОписаниеОповещения("ЗакончитьСозданиеКандидатаПослеПомещенияФайла", ЭтотОбъект,
					ДополнительныеПараметры),
				, , , ТекущаяСтрока.ПутьКФайлу, УникальныйИдентификатор);
			Возврат;
		Исключение
			ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось загрузить файл на сервер по причине:
					|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ПоказатьПредупреждение(, ТекстПредупреждения);
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Попытка
		НачатьПомещениеФайловНаСервер(
			Новый ОписаниеОповещения("ЗакончитьСозданиеКандидатаПослеПомещенияФайла", ЭтотОбъект,
				ДополнительныеПараметры),
			, , МассивФайлов, УникальныйИдентификатор);
	Исключение
		ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось загрузить файл на сервер по причине:
				|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьСозданиеКандидатаПослеПомещенияФайла(Результат, Адрес, ПолныйПуть, Параметры) Экспорт

	ПомещенныеФайлыКандидата = Новый Массив();

	Если Результат Тогда
		ПомещенныеФайлыКандидата.Добавить(Новый ОписаниеПередаваемогоФайла(ПолныйПуть, Адрес));
	КонецЕсли;

	ЗакончитьСозданиеКандидатаПослеПомещенияФайлов(ПомещенныеФайлыКандидата, Параметры);

КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьСозданиеКандидатаПослеПомещенияФайлов(ПомещенныеФайлыКандидата, ПараметрыЗагрузки) Экспорт

	Если ПомещенныеФайлыКандидата = Неопределено Или ПомещенныеФайлыКандидата.Количество() = 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Загрузка файла ""%1"" не выполнена.'"),
			ПараметрыЗагрузки.ДанныеРезюме.ПутьКФайлу);
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
	КонецЕсли;

	ФайлРезюмеПараметры = ПомещенныеФайлыКандидата[0];

	ДанныеКандидата = ПараметрыЗагрузки.ДанныеРезюме.СтруктураРезюме;
	ДанныеКандидата.Вакансия = ПараметрыЗагрузки.ДанныеРезюме.Вакансия;
	ДанныеКандидата.Подразделение = ПараметрыЗагрузки.ДанныеРезюме.Подразделение;
	ДанныеКандидата.ЛичныеДанныеКандидата = ПараметрыЗагрузки.ДанныеРезюме.ЛичныеДанныеКандидата;
	ДанныеКандидата.ГруппаДоступаКандидата = ПараметрыЗагрузки.ДанныеРезюме.ГруппаДоступа;

	ПараметрыРезюме = Новый Структура();
	ПараметрыРезюме.Вставить("ДанныеКандидата", ДанныеКандидата);

	Если ЗначениеЗаполнено(ПараметрыЗагрузки.ДанныеРезюме.Кандидат) Тогда
		ПараметрыРезюме.Вставить("Ключ", ПараметрыЗагрузки.ДанныеРезюме.Кандидат);
	КонецЕсли;

	ПодборПерсоналаКлиент.ОткрытьФормуНовогоКандидата(, ПараметрыРезюме, ФайлРезюмеПараметры.Имя);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВопросаОЗакрытииФормы(РезультатВопроса, Параметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ВсеРавноЗакрытьФорму = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВакансиюПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторыРезюмеКОбработке = Элементы.ТаблицаКандидатов.ВыделенныеСтроки;
	Для Каждого ИдентификаторСтроки Из ИдентификаторыРезюмеКОбработке Цикл
		ТекущиеДанные = ТаблицаКандидатов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекущиеДанные.Обработан = Истина Тогда
			Продолжить;
		КонецЕсли;
		СброситьКандидата = (ТекущиеДанные.Вакансия <> Результат);
		ТекущиеДанные.Вакансия = Результат;
		ОбработатьСтрокуПриИзмененииВакансии(ТекущиеДанные, СброситьКандидата);
	КонецЦикла;
	
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();
	ПроверитьНаДубли();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодразделениеПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
		
	ИдентификаторыРезюмеКОбработке = Элементы.ТаблицаКандидатов.ВыделенныеСтроки;
	Для Каждого ИдентификаторСтроки Из ИдентификаторыРезюмеКОбработке Цикл
		ТекущиеДанные = ТаблицаКандидатов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекущиеДанные.Обработан = Истина Тогда
			Продолжить;
		КонецЕсли;
		СброситьКандидата = (ТекущиеДанные.Подразделение <> Результат);
		ТекущиеДанные.Подразделение = Результат;
		ОбработатьСтрокуПриИзмененииПодразделения(ТекущиеДанные, СброситьКандидата);
	КонецЦикла;
	
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();
	ПроверитьНаДубли();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГруппуДоступаПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
		
	ИдентификаторыРезюмеКОбработке = Элементы.ТаблицаКандидатов.ВыделенныеСтроки;
	Для Каждого ИдентификаторСтроки Из ИдентификаторыРезюмеКОбработке Цикл
		ТекущиеДанные = ТаблицаКандидатов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекущиеДанные.Обработан = Истина Тогда
			Продолжить;
		КонецЕсли;
		ТекущиеДанные.ГруппаДоступа = Результат;
		ТекущиеДанные.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(ТекущиеДанные);
	КонецЦикла;
	
	УстановитьОтбор();
	УстановитьДоступностьКнопкиЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуКандидата(ДанныеРезюме)
	
	Если Не ЗначениеЗаполнено(ДанныеРезюме.Кандидат) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыРезюме = Новый Структура();
	ПараметрыРезюме.Вставить("Ключ", ДанныеРезюме.Кандидат);
	
	ОткрытьФорму(
		"Справочник.Кандидаты.Форма.ФормаЭлемента", 
		ПараметрыРезюме, 
		ЭтотОбъект, 
		Истина, , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСтрокуПриИзмененииВакансии(ТекущиеДанные, СброситьКандидата)
	
	ДанныеВакансии = ДанныеВакансии(ТекущиеДанные.Вакансия);
	Если ДанныеВакансии <> Неопределено Тогда
		ПодразделениеРезультат = Неопределено;
	Иначе
		ПодразделениеРезультат = ДанныеВакансии.Подразделение;
	КонецЕсли;
	ПодразделениеРезультат = ДанныеВакансии.Подразделение;
	
	Если ТекущиеДанные.Подразделение <> ПодразделениеРезультат Тогда
		СброситьКандидата = Истина;
	КонецЕсли;
	
	ТекущиеДанные.Подразделение = ПодразделениеРезультат;
	
	Если СброситьКандидата Тогда
		СброситьКандидатаВСтроке(ТекущиеДанные);
	КонецЕсли;
	
	ТекущиеДанные.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСтрокуПриИзмененииПодразделения(ТекущиеДанные, СброситьКандидата)
	
	Если СброситьКандидата Тогда
		ТекущиеДанные.Вакансия = Неопределено;
		СброситьКандидатаВСтроке(ТекущиеДанные);
	КонецЕсли;
	
	ТекущиеДанные.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьНеЗаписанныеИзменения()
	
	Результат = Ложь;
	
	Для Каждого ТекСтрока Из ТаблицаКандидатов Цикл
		Если Не ТекСтрока.Обработан Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьНаДубли()
	
	Для Каждого ТекущиеДанные Из ТаблицаКандидатов Цикл
		ОтборСтрок = Новый Структура("ФИО, ЛичныеДанныеКандидата, ЭтоНовыеЛичныеДанныеКандидата");
		ОтборСтрок.ФИО = ТекущиеДанные.ФИО;
		ОтборСтрок.ЛичныеДанныеКандидата = ТекущиеДанные.ЛичныеДанныеКандидата;
		ОтборСтрок.ЭтоНовыеЛичныеДанныеКандидата = Не ЗначениеЗаполнено(ТекущиеДанные.ЛичныеДанныеКандидата);
		НайденныеСтроки = ТаблицаКандидатов.НайтиСтроки(ОтборСтрок);
		ТекущиеДанные.ЕстьДубль = (НайденныеСтроки.Количество() > 1);
		ТекущиеДанные.ДоступноДляЗагрузки = РезюмеДоступноДляАвтоматическойЗагрузки(ТекущиеДанные);
	КонецЦикла;
	
	УстановитьДоступностьКнопкиЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКандидата(СтрокаРезюме)

	НайденныеКандидаты = КандидатыПоЛичнымДаннымКандидата(СтрокаРезюме.ЛичныеДанныеКандидата, СтрокаРезюме.Вакансия,
		СтрокаРезюме.Подразделение);
	СтрокаРезюме.ЭтоНовыйКандидат = (НайденныеКандидаты.Количество() = 0);
	Если НайденныеКандидаты.Количество() = 1 Тогда
		СтрокаРезюме.Кандидат = НайденныеКандидаты[0];
		ДанныеКандидата = ДанныеКандидата(СтрокаРезюме.Кандидат);
		СтрокаРезюме.Вакансия = ДанныеКандидата.Вакансия;
		СтрокаРезюме.Подразделение = ДанныеКандидата.Подразделение;
	Иначе
		СтрокаРезюме.Кандидат = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СброситьКандидатаВСтроке(СтрокаРезюме)

	Если ЗначениеЗаполнено(СтрокаРезюме.ЛичныеДанныеКандидата) Тогда
		ЗаполнитьКандидата(СтрокаРезюме);
	Иначе
		СтрокаРезюме.Кандидат = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ГруппаДоступаКандидата(ЛичныеДанныеКандидата)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛичныеДанныеКандидата, "ГруппаДоступа");
КонецФункции

&НаКлиенте
Процедура ЗавершитьЗагрузкуКандидатов(АдресЗагруженныхДанных, ДополнительныеПараметры) Экспорт

	Если АдресЗагруженныхДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Очищаем ДанныеКандидатов перед добавлением табличных данных:
	// они могли остаться от предыдущего добавления через ДобавитьФайлыРезюме,
	// где ПрименитьРезультатЗагрузки не вызывается. ЗагрузитьКандидатовНаСервере
	// только дополняет список - без очистки в ТаблицаКандидатов попадут лишние строки.
	ДанныеКандидатов.Очистить();

	ЗагрузитьКандидатовНаСервере(АдресЗагруженныхДанных);
	Если ДанныеКандидатов.Количество() > 0 Тогда
		ОбработатьДанныеТаблицыКандидатов();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКандидатовНаСервере(АдресЗагруженныхДанных)
	
	ЗагруженныеДанные = ПолучитьИзВременногоХранилища(АдресЗагруженныхДанных);
	ИдентификаторКандидата = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	СтруктураРезюме = Новый Структура;
	Для Каждого СтрокаТаблицы Из ЗагруженныеДанные Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторКандидата) Тогда
			Продолжить;
		ИначеЕсли ИдентификаторКандидата <> СтрокаТаблицы.ИдентификаторКандидата Тогда
			Если ЗначениеЗаполнено(СтруктураРезюме) Тогда
				ЗаполнитьТекстРезюме(СтруктураРезюме);
				ДанныеКандидатов.Добавить(СтруктураРезюме);
			КонецЕсли;
			СтруктураРезюме = ПодборПерсоналаКлиентСервер.ОписаниеРезюмеКандидата();
			ЗаполнитьЗначенияСвойств(СтруктураРезюме, СтрокаТаблицы);
			СтруктураРезюме.СпособСозданияКандидата = Перечисления.СпособыСозданияКандидата.ВнешняяТаблица;
			СтруктураРезюме.Вставить("ЭтапРаботы", СтрокаТаблицы.ЭтапРаботы);
			ЧастиИмени = ФизическиеЛицаКлиентСервер.ЧастиИмени(СтрокаТаблицы.ФИО);
			СтруктураРезюме.Вставить("ФИО", СтрокаТаблицы.ФИО);
			СтруктураРезюме.Фамилия = ЧастиИмени.Фамилия;
			СтруктураРезюме.Имя = ЧастиИмени.Имя; 
			СтруктураРезюме.Отчество = ЧастиИмени.Отчество;
			ДобавитьТелефон(СтрокаТаблицы, СтруктураРезюме);
			ДобавитьEmail(СтрокаТаблицы, СтруктураРезюме);
			ДобавитьАдрес(СтрокаТаблицы, СтруктураРезюме);
			ИдентификаторКандидата = СтрокаТаблицы.ИдентификаторКандидата;
		КонецЕсли;
		ДобавитьОпытРаботы(СтрокаТаблицы, СтруктураРезюме);
		ДобавитьОбразование(СтрокаТаблицы, СтруктураРезюме);
		ДобавитьЗнаниеЯзыка(СтрокаТаблицы, СтруктураРезюме);
		ДобавитьКурс(СтрокаТаблицы, СтруктураРезюме);
		ДобавитьУченуюСтепень(СтрокаТаблицы, СтруктураРезюме);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтруктураРезюме) Тогда
		ЗаполнитьТекстРезюме(СтруктураРезюме);
		ДанныеКандидатов.Добавить(СтруктураРезюме);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьТелефон(СтрокаТаблицы, СтруктураРезюме)
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Телефон) Тогда
		СтруктураРезюме.КонтактнаяИнформация.Добавить(
			Новый Структура("Тип, Вид, Представление",
				Перечисления.ТипыКонтактнойИнформации.Телефон,
				ОбщегоНазначения.ПредопределенныйЭлемент(
					"Справочник.ВидыКонтактнойИнформации.ТелефонЛичныеДанныеКандидатов"),
				СтрокаТаблицы.Телефон));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьEmail(СтрокаТаблицы, СтруктураРезюме)
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Email) Тогда
		СтруктураРезюме.КонтактнаяИнформация.Добавить(
