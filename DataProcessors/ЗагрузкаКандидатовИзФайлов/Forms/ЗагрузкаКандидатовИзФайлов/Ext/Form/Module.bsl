&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТекстРезюме(СтруктураРезюме)
	
	Текст = "";
	Если ЗначениеЗаполнено(СтруктураРезюме.ФИО) Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = 'ФИО: %1'"), СтруктураРезюме.ФИО) + Символы.ПС;
	КонецЕсли;
	Для Каждого Контакт Из СтруктураРезюме.КонтактнаяИнформация Цикл
		Текст = Текст + СтрШаблон(НСтр("ru = '%1: %2'"), Контакт.Тип, Контакт.Представление) + Символы.ПС;
	КонецЦикла;
	Если ЗначениеЗаполнено(СтруктураРезюме.ДатаРождения) Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = 'Дата рождения: %1'"),
			Формат(СтруктураРезюме.ДатаРождения, "ДФ=dd.MM.yyyy")) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.Пол) Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = 'Пол: %1'"), СтруктураРезюме.Пол) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.Вакансия) Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = 'Вакансия: %1'"), СтруктураРезюме.Вакансия) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.Подразделение) Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = 'Подразделение: %1'"), СтруктураРезюме.Подразделение) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.ОжидаемыйДоход) Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = 'Ожидаемый доход: %1'"),
			Формат(СтруктураРезюме.ОжидаемыйДоход, "ЧДЦ=2; ЧРГ= ")) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.ЭтапРаботы) Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = 'Этап работы: %1'"), СтруктураРезюме.ЭтапРаботы) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.ОСебе) Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = 'О себе: %1'"), СтруктураРезюме.ОСебе) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.ТрудоваяДеятельность) Тогда
		Текст = Текст + НСтр("ru = 'Трудовая деятельность:'") + Символы.ПС;
		Для Каждого ЭлементТрудовойДеятельности Из СтруктураРезюме.ТрудоваяДеятельность Цикл
			Текст = Текст + СтрШаблон(НСтр("ru = '  Компания: %1'"),
				ЭлементТрудовойДеятельности.Компания) + Символы.ПС;
			Текст = Текст + СтрШаблон(НСтр("ru = '  Должность: %1'"),
				ЭлементТрудовойДеятельности.Должность) + Символы.ПС;
			Если ЗначениеЗаполнено(ЭлементТрудовойДеятельности.Обязанности) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Обязанности: %1'"),
					ЭлементТрудовойДеятельности.Обязанности) + Символы.ПС;
			КонецЕсли;
			Если ЗначениеЗаполнено(ЭлементТрудовойДеятельности.ДатаНачала) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Дата начала: %1'"),
					Формат(ЭлементТрудовойДеятельности.ДатаНачала, "ДФ=dd.MM.yyyy")) + Символы.ПС;
			КонецЕсли;
			Если ЗначениеЗаполнено(ЭлементТрудовойДеятельности.ДатаОкончания) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Дата окончания: %1'"),
					Формат(ЭлементТрудовойДеятельности.ДатаОкончания, "ДФ=dd.MM.yyyy")) + Символы.ПС;
			КонецЕсли;
			Текст = Текст + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.Образование) Тогда
		Текст = Текст + НСтр("ru = 'Образование:'") + Символы.ПС;
		Для Каждого ЭлементОбразования Из СтруктураРезюме.Образование Цикл
			Текст = Текст + СтрШаблон(НСтр("ru = '  Вид образования: %1'"),
				ЭлементОбразования.ВидОбразования) + Символы.ПС;
			Если ЗначениеЗаполнено(ЭлементОбразования.Специальность) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Специальность: %1'"),
					ЭлементОбразования.Специальность) + Символы.ПС;
			КонецЕсли;
			Если ЗначениеЗаполнено(ЭлементОбразования.УчебноеЗаведение) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Учебное заведение: %1'"),
					ЭлементОбразования.УчебноеЗаведение) + Символы.ПС;
			КонецЕсли;
			Если ЗначениеЗаполнено(ЭлементОбразования.Окончание) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Год окончания: %1'"),
					ЭлементОбразования.Окончание) + Символы.ПС;
			КонецЕсли;
			Текст = Текст + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.ЗнаниеЯзыков) Тогда
		Текст = Текст + НСтр("ru = 'Знание языков:'") + Символы.ПС;
		Для Каждого ЭлементЗнанияЯзыка Из СтруктураРезюме.ЗнаниеЯзыков Цикл
			Текст = Текст + СтрШаблон(НСтр("ru = '  Язык: %1'"), ЭлементЗнанияЯзыка.Язык) + Символы.ПС;
			Если ЗначениеЗаполнено(ЭлементЗнанияЯзыка.СтепеньЗнанияЯзыкаКандидата) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Степень знания: %1'"),
					ЭлементЗнанияЯзыка.СтепеньЗнанияЯзыкаКандидата) + Символы.ПС;
			КонецЕсли;
			Текст = Текст + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.Курсы) Тогда
		Текст = Текст + НСтр("ru = 'Курсы:'") + Символы.ПС;
		Для Каждого ЭлементКурса Из СтруктураРезюме.Курсы Цикл
			Текст = Текст + СтрШаблон(НСтр("ru = '  Наименование курса: %1'"),
				ЭлементКурса.НаименованиеКурса) + Символы.ПС;
			Если ЗначениеЗаполнено(ЭлементКурса.УчебноеЗаведение) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Учебное заведение: %1'"),
					ЭлементКурса.УчебноеЗаведение) + Символы.ПС;
			КонецЕсли;
			Если ЗначениеЗаполнено(ЭлементКурса.ГодОкончания) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Год окончания: %1'"),
					ЭлементКурса.ГодОкончания) + Символы.ПС;
			КонецЕсли;
			Текст = Текст + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРезюме.УченыеСтепени) Тогда
		Текст = Текст + НСтр("ru = 'Ученые степени:'") + Символы.ПС;
		Для Каждого ЭлементУченойСтепени Из СтруктураРезюме.УченыеСтепени Цикл
			Текст = Текст + СтрШаблон(НСтр("ru = '  Степень: %1'"), ЭлементУченойСтепени.УченаяСтепень) + Символы.ПС;
			Если ЗначениеЗаполнено(ЭлементУченойСтепени.ДатаПрисужденияУченойСтепени) Тогда
				Текст = Текст + СтрШаблон(НСтр("ru = '  Год присвоения: %1'"),
					ЭлементУченойСтепени.ДатаПрисужденияУченойСтепени) + Символы.ПС;
			КонецЕсли;
			Текст = Текст + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	СтруктураРезюме.ТекстРезюме = Текст;
	
КонецПроцедуры

#КонецОбласти