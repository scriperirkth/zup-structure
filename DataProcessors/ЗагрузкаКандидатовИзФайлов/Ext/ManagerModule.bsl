#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

// Переопределяет параметры загрузки данных из файла.
//
// Параметры:
//  Параметры - Структура:
//   * ИмяМакетаСШаблоном - Строка - наименование макета. Например, "ЗагрузкаИзФайла".
//   * ИмяТабличнойЧасти - Строка - Полное имя табличной части. Например, "Документ._ДемоСчетНаОплатуПокупателю.ТабличнаяЧасть.Товары"
//   * ОбязательныеКолонки - Массив из Строка - наименования обязательных для заполнения колонок.
//   * ТипДанныхКолонки - Соответствие из КлючИЗначение:
//      * Ключ - Строка - имя колонки;
//      * Значение - ОписаниеТипов - тип колонки загружаемых данных.
//   * ДополнительныеПараметры - Структура
//
Процедура УстановитьПараметрыЗагрузкиИзФайлаВТЧ(Параметры) Экспорт
	// Переопределяемый метод БСП. Параметры загрузки задаются в форме обработки.
КонецПроцедуры

// Производит сопоставление данных, загружаемых в табличную часть ПолноеИмяТабличнойЧасти,
// с данными в ИБ, и заполняет параметры АдресТаблицыСопоставления и СписокНеоднозначностей.
//
// Параметры:
//   АдресЗагружаемыхДанных    - Строка - Адрес временного хранилища с таблицей значений, в которой
//                                        находятся загруженные данные из файла. Состав колонок:
//     * Идентификатор - Число - Порядковый номер строки;
//                               остальные колонки соответствуют колонкам макета ЗагрузкаИзФайла.
//   АдресТаблицыСопоставления - Строка - Адрес временного хранилища с пустой таблицей значений,
//                                        являющейся копией табличной части документа, 
//                                        которую необходимо заполнить из таблицы АдресЗагружаемыхДанных.
//   СписокНеоднозначностей - ТаблицаЗначений - Список неоднозначных значений, для которых в ИБ имеется несколько
//                                              подходящих вариантов.
//   ПолноеИмяТабличнойЧасти   - Строка - Полное имя табличной части, в которую загружаются данные.
//   ДополнительныеПараметры   - Произвольный - Любые дополнительные сведения.
Процедура СопоставитьЗагружаемыеДанные(АдресЗагружаемыхДанных, АдресТаблицыСопоставления, СписокНеоднозначностей, ПолноеИмяТабличнойЧасти, ДополнительныеПараметры) Экспорт
	
	ДанныеЗагрузки			= ПолучитьИзВременногоХранилища(АдресТаблицыСопоставления);
	ЗагружаемыеДанные		= ПолучитьИзВременногоХранилища(АдресЗагружаемыхДанных);
	СловарьВакансий			= СловарьИзСправочникаПоНаименованию("Вакансии");
	СловарьПодразделений	= СловарьИзСправочникаПоНаименованию("СтруктураПредприятия");
	СловарьЭтаповРаботы 	= СловарьИзСправочникаПоНаименованию("ЭтапыРаботыСКандидатами");
	СловарьВидовОбразования = СловарьИзСправочникаПоНаименованию("ВидыОбразованияФизическихЛиц");
	СловарьУчебныхЗаведений = СловарьИзСправочникаПоНаименованию("УчебныеЗаведения");
	СловарьСпециальностей 	= СловарьИзСправочникаПоНаименованию("КлассификаторСпециальностейПоОбразованию");
	СловарьЯзыков 			= СловарьИзСправочникаПоНаименованию("ЯзыкиНародовМира");
	СловарьЗнанийЯзыка	 	= СловарьИзСправочникаПоНаименованию("СтепениЗнанияЯзыкаКандидата");
	СловарьУченыхСтепений 	= СловарьИзСправочникаПоНаименованию("УченыеСтепени");
	
	ИдентификаторКандидата = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	Для Каждого СтрокаТаблицы Из ЗагружаемыеДанные Цикл
		СтрокаЗагрузки = ДанныеЗагрузки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗагрузки, СтрокаТаблицы);
		Если ЗначениеЗаполнено(СтрокаТаблицы.ФИО) Тогда
			ИдентификаторКандидата = Новый УникальныйИдентификатор();
			СтрокаЗагрузки.ИдентификаторКандидата = ИдентификаторКандидата;
			СтрокаЗагрузки.Пол = ПолФизическогоЛица(СтрокаТаблицы.Пол);
			СтрокаЗагрузки.Вакансия = СловарьВакансий.Получить(СокрЛП(СтрокаТаблицы.Вакансия));
			СтрокаЗагрузки.Подразделение = СловарьПодразделений.Получить(СокрЛП(СтрокаТаблицы.Подразделение));
			СтрокаЗагрузки.ЭтапРаботы = СловарьЭтаповРаботы.Получить(СокрЛП(СтрокаТаблицы.ЭтапРаботы));
		Иначе
			СтрокаЗагрузки.ИдентификаторКандидата = ИдентификаторКандидата;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТаблицы.ОбразованиеВид) Тогда
			СтрокаЗагрузки.ОбразованиеВид = СловарьВидовОбразования.Получить(
				СокрЛП(СтрокаТаблицы.ОбразованиеВид));
			СтрокаЗагрузки.ОбразованиеУчебноеЗаведение = СловарьУчебныхЗаведений.Получить(
				СокрЛП(СтрокаТаблицы.ОбразованиеУчебноеЗаведение));
			СтрокаЗагрузки.ОбразованиеСпециальность = СловарьСпециальностей.Получить(
				СокрЛП(СтрокаТаблицы.ОбразованиеСпециальность));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИностранныеЯзыкиЯзык) Тогда
			СтрокаЗагрузки.ИностранныеЯзыкиЯзык = СловарьЯзыков.Получить(
				СокрЛП(СтрокаТаблицы.ИностранныеЯзыкиЯзык));
			СтрокаЗагрузки.ИностранныеЯзыкиСтепеньЗнания = СловарьЗнанийЯзыка.Получить(
				СокрЛП(СтрокаТаблицы.ИностранныеЯзыкиСтепеньЗнания));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТаблицы.КурсыУчебноеЗаведение) Тогда
			СтрокаЗагрузки.КурсыУчебноеЗаведение = СловарьУчебныхЗаведений.Получить(
				СокрЛП(СтрокаТаблицы.КурсыУчебноеЗаведение));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТаблицы.УченыеСтепениСтепень) Тогда
			СтрокаЗагрузки.УченыеСтепениСтепень = СловарьУченыхСтепений.Получить(
				СокрЛП(СтрокаТаблицы.УченыеСтепениСтепень));
		КонецЕсли;
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ДанныеЗагрузки, АдресТаблицыСопоставления);
	
КонецПроцедуры

Функция ПолФизическогоЛица(ПолСтрокой)

	Если СтрНайти(ПолСтрокой, "муж") <> 0 Тогда
		Возврат Перечисления.ПолФизическогоЛица.Мужской;
	ИначеЕсли СтрНайти(ПолСтрокой, "жен") <> 0 Тогда
		Возврат Перечисления.ПолФизическогоЛица.Женский;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СловарьИзСправочникаПоНаименованию(ИмяСправочника)

	Словарь = Новый Соответствие;
	СправочникМенеджер = Справочники[ИмяСправочника];
	Выборка = СправочникМенеджер.Выбрать();

	Пока Выборка.Следующий() Цикл
		Словарь.Вставить(СокрЛП(Выборка.Наименование), Выборка.Ссылка);
	КонецЦикла;

	Возврат Словарь;

КонецФункции

// Запускает фоновую операцию загрузки кандидатов из формы обработки.
// Используется, чтобы при большом числе резюме (например, 1000+) клиент не
// блокировался на тысячах синхронных серверных вызовах и не падал по таймауту.
// Прогресс сообщается через ДлительныеОперации.СообщитьПрогресс.
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы-владельца,
//                        к которой привязывается фоновое задание.
//  ДанныеКандидатов   - Массив из Структура - подготовленные описания кандидатов
//                        (ИндексВТаблице, Кандидат, ЭтоНовыйКандидат,
//                        ЭтоНовыеЛичныеДанныеКандидата, ДанныеКандидата).
//                        Передаётся напрямую как параметр, без временного
//                        хранилища, чтобы фон мог получить данные по сериализации.
//
// Возвращаемое значение:
//  Структура: 
//   * Статус               - Строка - "Выполняется", если задание еще не завершилось;
//                                     "Выполнено", если задание было успешно выполнено;
//                                     "Ошибка", если задание завершено с ошибкой;
//                                     "Отменено", если задание отменено пользователем или администратором.
//   * ИдентификаторЗадания - УникальныйИдентификатор - если Статус = "Выполняется", то содержит 
//                                     идентификатор запущенного фонового задания.
//                          - Неопределено - если Статус <> "Выполняется" и фоновое задание не запускалось.
//   * АдресРезультата       - Строка - адрес временного хранилища, в которое будет
//                                      помещен результат работы функции.
//   * ИнформацияОбОшибке    - ИнформацияОбОшибке - если Статус = "Ошиб//   * Сообщения - ФиксированныйМассив из СообщениеПользователю - если Статус <> "Выполняется",
//                                      то массив объектов СообщениеПользователю,
//                                      которые были сформированы в фоновом задании.                                  которые были сформированы в фоновом задании.
//   * КраткоеПредставлениеОшибки   - Строка - устарел.
//   * ПодробноеПредставлениеОшибки - Строка - устарел.
//
Функция ДлительнаяОперацияЗагрузки(ИдентификаторФормы, ДанныеКандидатов) Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Загрузка кандидатов из файлов'");

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Обработки.ЗагрузкаКандидатовИзФайлов.РезультатЗагрузкиКандидатов", ДанныеКандидатов);

КонецФункции

// Выполняется в фоне. Создаёт или обновляет кандидатов одной транзакцией.
// При отмене задания пользователем или закрытии формы - транзакция откатывается,
// ни один кандидат не записывается частично.
//
// Параметры:
//  ДанныеКандидатов - Массив из Структура - описания кандидатов для записи.
//
// Возвращаемое значение:
//  Структура - СозданоКандидатов, ОбновленоКандидатов, Кандидаты, Вакансии, ИндексыСтрок.
//
Функция РезультатЗагрузкиКандидатов(ДанныеКандидатов) Экспорт

	РезультатЗагрузки = НовыйРезультатЗагрузки();
	Всего = ДанныеКандидатов.Количество();

	Если Всего = 0 Тогда
		ДлительныеОперации.СообщитьПрогресс(100, НСтр("ru = 'Нет данных для загрузки'"));
		Возврат РезультатЗагрузки;
	КонецЕсли;

	ШагПрогресса = Макс(1, Цел(Всего / 20));

	НачатьТранзакцию();
	Попытка
		Для Сч = 0 По Всего - 1 Цикл
			Элемент = ДанныеКандидатов[Сч];

			КандидатОбъект = ?(ЗначениеЗаполнено(Элемент.Кандидат),
				Элемент.Кандидат.ПолучитьОбъект(),
				Справочники.Кандидаты.СоздатьЭлемент());

			КандидатОбъект.Заполнить(Элемент.ДанныеКандидата);
			КандидатОбъект.Записать();

			Если Элемент.ДанныеКандидата.Свойство("ЭтапРаботы")
					И ЗначениеЗаполнено(Элемент.ДанныеКандидата.ЭтапРаботы) Тогда
				РезультатУстановкиЭтапа = ПодборПерсоналаКлиентСервер.РезультатУстановкиЭтапаРаботыСКандидатом();
				РезультатУстановкиЭтапа.Кандидаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КандидатОбъект.Ссылка);
				РезультатУстановкиЭтапа.ЭтапРаботы.Этап = Элемент.ДанныеКандидата.ЭтапРаботы;
				РезультатУстановкиЭтапа.ЭтапРаботы.Состояние = Перечисления.СостоянияЭтаповРаботыСКандидатами.Запланирован;
				РезультатУстановкиЭтапа.ЭтапРаботы.Период = ТекущаяДатаСеанса();
				ПодборПерсонала.УстановитьСостояниеЭтапаРаботыКандидатов(РезультатУстановкиЭтапа);
			КонецЕсли;

			Если Элемент.ЭтоНовыйКандидат Тогда
				РезультатЗагрузки.СозданоКандидатов = РезультатЗагрузки.СозданоКандидатов + 1;
			Иначе
				РезультатЗагрузки.ОбновленоКандидатов = РезультатЗагрузки.ОбновленоКандидатов + 1;
			КонецЕсли;

			РезультатЗагрузки.Кандидаты.Добавить(КандидатОбъект.Ссылка);
			РезультатЗагрузки.Вакансии.Добавить(КандидатОбъект.Вакансия);
			РезультатЗагрузки.ИндексыСтрок.Вставить(0, Элемент.ИндексВТаблице);

			// Сообщаем прогресс не на каждой итерации (чтобы не перегружать канал).
			// При отмене задания БСП выбрасывает исключение - транзакция откатывается.
			Если Сч = 0 Или Сч = Всего - 1 Или (Сч + 1) % ШагПрогресса = 0 Тогда
				Процент = Окр((Сч + 1) / Всего * 100);
				ДлительныеОперации.СообщитьПрогресс(Процент,
					СтрШаблон(НСтр("ru = 'Обработано %1 из %2 кандидатов'"), Сч + 1, Всего));
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// Пробрасываем исключение наверх - БСП установит статус "Ошибка" или "Отменено".
		ВызватьИсключение;
	КонецПопытки;

	Возврат РезультатЗагрузки;

КонецФункции

// Возвращает пустую структуру результата загрузки.
// ИндексыСтрок накапливаются по убыванию, чтобы клиент мог удалять
// строки из таблицы без пересчёта индексов.
//
Функция НовыйРезультатЗагрузки()

	Результат = Новый Структура;
	Результат.Вставить("СозданоКандидатов", 0);
	Результат.Вставить("ОбновленоКандидатов", 0);
	Результат.Вставить("Кандидаты", Новый Массив);
	Результат.Вставить("Вакансии", Новый Массив);
	Результат.Вставить("ИндексыСтрок", Новый Массив);
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли