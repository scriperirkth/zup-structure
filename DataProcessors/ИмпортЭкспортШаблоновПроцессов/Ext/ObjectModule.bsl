		ФайлДанных.ЗаписатьКонецЭлемента(); // ЭтапСтрока
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); // Этапы
	
	ФайлДанных.ЗаписатьНачалоЭлемента("ПредшественникиЭтаповИнтервала");
	ВыборкаПредшественники = ВыборкаИнтервалы.ПредшественникиЭтапов.Выбрать();
