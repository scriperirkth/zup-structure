Процедура УстановитьИдентификаторПоддержкиРегламентныхИнтерваловПередВыгрузкой(СписокИнтервалов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегламентныеИнтервалы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РегламентныеИнтервалы КАК РегламентныеИнтервалы
	|ГДЕ
	|	РегламентныеИнтервалы.Ссылка В(&СписокИнтервалов)
	|	И РегламентныеИнтервалы.ИдентификаторПоддержки = &ПустойИД";
	
	Запрос.УстановитьПараметр("СписокИнтервалов", СписокИнтервалов);
	Запрос.УстановитьПараметр("ПустойИД", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененыИдентификаторыПоддержки = Истина;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.РегламентныеИнтервалы");
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			РегламентныйИнтервалОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			РегламентныйИнтервалОбъект.Заблокировать();
			
			РегламентныйИнтервалОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор;
			
			РегламентныйИнтервалОбъект.Записать();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Установка идентификатора поддержки для регламентных интервалов'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
								УровеньЖурналаРегистрации.Ошибка,,,
								ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьИдентификаторПоддержкиРолейИсполнителейПередВыгрузкой(СписокРолей)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РолиИсполнителей.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РолиИсполнителей КАК РолиИсполнителей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыПоддержкиРолейИсполнителей КАК ИдентификаторыПоддержки
	|		ПО РолиИсполнителей.Ссылка = ИдентификаторыПоддержки.РольИсполнителя
	|ГДЕ
	|	РолиИсполнителей.Ссылка В(&СписокРолей)
	|	И (ИдентификаторыПоддержки.ИдентификаторПоддержки ЕСТЬ NULL
	|			ИЛИ ИдентификаторыПоддержки.ИдентификаторПоддержки = &ПустойИД)";
	
	Запрос.УстановитьПараметр("СписокРолей", СписокРолей);
	Запрос.УстановитьПараметр("ПустойИД", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененыИдентификаторыПоддержки = Истина;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИдентификаторыПоддержкиРолейИсполнителей");
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("РольИсполнителя", "Ссылка");
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			МенеджерЗаписи = РегистрыСведений.ИдентификаторыПоддержкиРолейИсполнителей.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.РольИсполнителя = Выборка.Ссылка;
			МенеджерЗаписи.ИдентификаторПоддержки = Новый УникальныйИдентификатор;
			МенеджерЗаписи.Записать();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Установка идентификатора поддержки для регламентных интервалов'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
								УровеньЖурналаРегистрации.Ошибка,,,
								ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ИнициализироватьФайлДанныхДляВыгрузки(ИмяФайла = "")
	
	ФайлДанных = Новый ЗаписьXML;
	Если ИмяФайла = "" Тогда
		ФайлДанных.УстановитьСтроку();
	Иначе
		ФайлДанных.ОткрытьФайл(ИмяФайла);
	КонецЕсли;
	ФайлДанных.ЗаписатьНачалоЭлемента("ВыгрузкаШаблоновПроцессов");
	
	ЗаписатьЭлемент("ДатаВыгрузки", ТекущаяДатаСеанса());
	
КонецПроцедуры

Функция ЗавершитьВыгрузку()

	ФайлДанных.ЗаписатьКонецЭлемента();
	
	Возврат ФайлДанных.Закрыть();

