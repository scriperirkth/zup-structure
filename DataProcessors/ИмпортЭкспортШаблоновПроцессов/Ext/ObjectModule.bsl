Процедура ЗагрузитьСтатусыДокументов(Данные, СоответствияОбъектов, ОбъектыДляЗагрузки)
	
	ФайлДанных = Новый ЧтениеXML;
	ФайлДанных.УстановитьСтроку(Данные);
	
	Пока ФайлДанных.Прочитать() Цикл
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "СтатусДокумента" Тогда
				
				ИдентификаторПоддержки = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
				Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				
				ЗаписатьОбъект = ОбъектыДляЗагрузки[ИдентификаторПоддержки] <> Неопределено;
				Если Не ЗаписатьОбъект Тогда
					Продолжить;
				КонецЕсли;
				
				СтатусСсылка = СоответствияОбъектов.СоответствиеСтатусов.Получить(ИдентификаторПоддержки);
				
				Если СтатусСсылка.Пустая() Тогда
					СтатусОбъект = Справочники.СтатусыДокументов.СоздатьЭлемент();
					СтатусОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержки);
					СтатусОбъект.Наименование = Наименование;
					СтатусОбъект.Записать();
					
					СтатусСсылка = СтатусОбъект.Ссылка;
					СоответствияОбъектов.СоответствиеСтатусов.Вставить(ИдентификаторПоддержки, СтатусСсылка)
				Иначе
					СтатусОбъект = СтатусСсылка.ПолучитьОбъект();
					НадоЗаписать = Ложь;
					ПроверитьУстановитьЗначениеРеквизита(СтатусОбъект, "ИдентификаторПоддержки", Новый УникальныйИдентификатор(ИдентификаторПоддержки), НадоЗаписать);
					ПроверитьУстановитьЗначениеРеквизита(СтатусОбъект, "Наименование", Наименование, НадоЗаписать);
					Если НадоЗаписать Тогда
						СтатусОбъект.Записать();
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "СтатусыДокументов" Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьЭтапыПроцессов(Данные, СоответствияОбъектов, ОбъектыДляЗагрузки)
	
	ФайлДанных = Новый ЧтениеXML;
	ФайлДанных.УстановитьСтроку(Данные);
	
	Пока ФайлДанных.Прочитать() Цикл
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "ЭтапПроцесса" Тогда
				
				ИдентификаторПоддержки = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
				Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				
				ЗаписатьОбъект = ОбъектыДляЗагрузки[ИдентификаторПоддержки] <> Неопределено;
				Если НЕ ЗаписатьОбъект Тогда
					ЭтапОбъект = Справочники.ЭтапыПроцессов.СоздатьЭлемент();
					Продолжить;
				КонецЕсли;
				
				ЭтапСсылка = СоответствияОбъектов.СоответствиеЭтапов.Получить(ИдентификаторПоддержки);
				
				Если ЭтапСсылка.Пустая() Тогда
					
					ЭтапОбъект = Справочники.ЭтапыПроцессов.СоздатьЭлемент();
					ЭтапОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержки);
					ЭтапОбъект.Наименование = Наименование;
					
					НоваяСсылка = Справочники.ЭтапыПроцессов.ПолучитьСсылку();
					СоответствияОбъектов.СоответствиеЭтапов.Вставить(ИдентификаторПоддержки, НоваяСсылка);
					
					ЭтапОбъект.УстановитьСсылкуНового(НоваяСсылка);
					
				Иначе
					ЭтапОбъект = ЭтапСсылка.ПолучитьОбъект();
					ПроверитьУстановитьЗначениеРеквизита(ЭтапОбъект, "ИдентификаторПоддержки", Новый УникальныйИдентификатор(ИдентификаторПоддержки));
					ПроверитьУстановитьЗначениеРеквизита(ЭтапОбъект, "Наименование", Наименование);
					ЭтапОбъект.РезультатыВыполнения.Очистить();
				КонецЕсли;
				
			ИначеЕсли ФайлДанных.Имя = "ОписаниеЭтапа" Тогда
				
				ЭтапОбъект.Описание = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
				
			ИначеЕсли ФайлДанных.Имя = "КомментарийЭтапа" Тогда
				
				ЭтапОбъект.Комментарий = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
				
			ИначеЕсли ФайлДанных.Имя = "РезультатыВыполнения" Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "РезультатыВыполнения" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "РезультатВыполнения" Тогда
						НовыйРезультатВыполнения = ЭтапОбъект.РезультатыВыполнения.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ПредставлениеРезультата" Тогда
						
						НовыйРезультатВыполнения[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
					ИначеЕсли ИмяУзла = "СтатусПослеВыполнения" Тогда
						
						НовыйРезультатВыполнения[ИмяУзла] = СоответствияОбъектов.СоответствиеСтатусов.Получить(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "ОтрицательныйРезультат"
						ИЛИ ИмяУзла = "ТребуетсяЭП"
						ИЛИ ИмяУзла = "ТребуетсяПростаяЭП"
						ИЛИ ИмяУзла = "Скрытый" Тогда
						
						НовыйРезультатВыполнения[ИмяУзла] = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "ЭтапПроцесса"
			И ЗаписатьОбъект Тогда
			
			ЭтапОбъект.Записать();
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "ЭтапыПроцессов" Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьШаблоныПроцессов(Данные, СоответствияОбъектов, ОбъектыДляЗагрузки, 
	ЗагружатьИсполнителей, ЗагружатьНастройкиСвойствЭлементов = Ложь)
	
	ФайлДанных = Новый ЧтениеXML;
	ФайлДанных.УстановитьСтроку(Данные);
	
	// файл надо обойти два раза из-за возможной ошибки при обратном порядке
	// загрузки новых влияющих и зависимых шаблонов
	Пока ФайлДанных.Прочитать() Цикл
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			Если ФайлДанных.Имя = "ШаблонПроцесса" Тогда
				ИдентификаторПоддержки = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
				ШаблонСсылка = СоответствияОбъектов.СоответствиеШаблонов.Получить(ИдентификаторПоддержки);
				
				ЗаписатьОбъект = ОбъектыДляЗагрузки[ИдентификаторПоддержки] <> Неопределено;
				Если НЕ ЗаписатьОбъект Тогда
					ШаблонОбъект = Справочники.ШаблоныПроцессов.СоздатьЭлемент();
					Продолжить;
				КонецЕсли;
				
				Если ШаблонСсылка.Пустая() Тогда
					
					ИсполнителиЭтапов = Неопределено;
					ИсполнителиГрупповыхЭтапов = Неопределено;
					
					ШаблонОбъект = Справочники.ШаблоныПроцессов.СоздатьЭлемент();
					ШаблонОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержки);
					
					НоваяСсылка = Справочники.ШаблоныПроцессов.ПолучитьСсылку();
					СоответствияОбъектов.СоответствиеШаблонов.Вставить(ИдентификаторПоддержки, НоваяСсылка);
					ШаблонОбъект.УстановитьСсылкуНового(НоваяСсылка);
					
				Иначе
					// если ссылка уже есть, то требуется сразу перезаполнить таблицу влияний для корректной записи зависимых шаблонов
					ШаблонОбъект = ШаблонСсылка.ПолучитьОбъект();
					
					// Сохранение текущих исполнителей этапов в таблицу значений
					ИсполнителиЭтапов = ШаблонОбъект.Этапы.Выгрузить( ,
						"ИдентификаторЭтапа, Этап, Исполнитель, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации,"
						+ "ИмяРеквизитаОсновногоОбъектаАдресации, ИмяРеквизитаДополнительногоОбъектаАдресации");
					
					ЭтапыПоИдентификаторам = Новый Соответствие;
					Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
						ЭтапыПоИдентификаторам.Вставить(Этап.ИдентификаторЭтапа, Этап.Этап);
					КонецЦикла;
					
					ИсполнителиГрупповыхЭтапов = ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Выгрузить( ,
						"ИдентификаторЭтапа, Исполнитель, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации,"
						+ "ИмяРеквизитаОсновногоОбъектаАдресации, ИмяРеквизитаДополнительногоОбъектаАдресации");
					
					ШаблонОбъект.Этапы.Очистить();
					ШаблонОбъект.ВлияниеНаДругиеПроцессы.Очистить();
					ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Очистить();
					
				КонецЕсли;
				
			ИначеЕсли ФайлДанных.Имя = "Этапы" Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "Этапы" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "ЭтапСтрока" Тогда
						НоваяСтрока = ШаблонОбъект.Этапы.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторЭтапа" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Этап" Тогда
						
						НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеЭтапов.Получить(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Исполнитель" Тогда
						
						ИсполнительИзФайла = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
						Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИсполнительИзФайла) Тогда
							// это роль исполнителя
							НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеРолей.Получить(ИсполнительИзФайла);
						ИначеЕсли ИсполнительИзФайла = "" Тогда
							// это пользователь, не загружается
						Иначе
							// это функция либо предопределенная роль (например "Автор документа")
							НоваяСтрока[ИмяУзла] = ИсполнительИзФайла
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ФайлДанных.Имя = "ВлияниеНаДругиеПроцессы" Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "ВлияниеНаДругиеПроцессы" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "Влияние" Тогда
						НоваяСтрока = ШаблонОбъект.ВлияниеНаДругиеПроцессы.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторЭтапа"
						ИЛИ ИмяУзла = "ИдентификаторЭтапаЗависимогоШаблона" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Статус"
						ИЛИ ИмяУзла = "УстанавливаемыйСтатус" Тогда
						
						НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеСтатусов.Получить(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "ЗависимыйШаблон" Тогда
						
						НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеШаблонов.Получить(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "СвязьСОбъектом" Тогда
						
						НоваяСтрока[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ФайлДанных.Имя = "ИсполнителиГрупповыхЭтапов" И ЗагружатьИсполнителей Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "ИсполнителиГрупповыхЭтапов" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "ИсполнительГрупповогоЭтапа" Тогда
						НоваяСтрока = ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторЭтапа" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Исполнитель" Тогда
						
						ИсполнительИзФайла = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
						Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИсполнительИзФайла) Тогда
							// это роль исполнителя
							НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеРолей.Получить(ИсполнительИзФайла);
						ИначеЕсли ИсполнительИзФайла = "" Тогда
							// это пользователь, не загружается
						Иначе
							// это функция либо предопределенная роль (например "Автор документа")
							НоваяСтрока[ИмяУзла] = ИсполнительИзФайла
						КонецЕсли;
						
					ИначеЕсли ИмяУзла = "ИмяРеквизитаОсновногоОбъектаАдресации"
						ИЛИ ИмяУзла = "ИмяРеквизитаДополнительногоОбъектаАдресации" Тогда
						
						НоваяСтрока[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "ШаблонПроцесса"
			И ЗаписатьОбъект Тогда
			
			// Заполнение исполнителей этапов согласно сохраненных значений
			Если ИсполнителиЭтапов <> Неопределено Тогда
				Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
					
					Если ЗагружатьИсполнителей Тогда
						Если ТипЗнч(Этап.Исполнитель) = Тип("СправочникСсылка.РолиИсполнителей") Тогда
							// При флаге "загружать исполнителей" для ролей необходимо восстановить объекты адресации
							ПараметрыОтбора = Новый Структура;
							ПараметрыОтбора.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
							ПараметрыОтбора.Вставить("Этап", Этап.Этап);
							ПараметрыОтбора.Вставить("Исполнитель", Этап.Исполнитель);
							МассивСтрок = ИсполнителиЭтапов.НайтиСтроки(ПараметрыОтбора);
							Если МассивСтрок.Количество() > 0 Тогда
								ЗаполнитьЗначенияСвойств(Этап, МассивСтрок[0],
									"ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации");
							КонецЕсли;
						ИначеЕсли ТипЗнч(Этап.Исполнитель) = Тип("Строка") Тогда
							Продолжить;
						ИначеЕсли Этап.Исполнитель = Неопределено Тогда
							// При флаге "загружать исполнителей" для пользователей необходимо их восстановить
							ПараметрыОтбора = Новый Структура;
							ПараметрыОтбора.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
							ПараметрыОтбора.Вставить("Этап", Этап.Этап);
							МассивСтрок = ИсполнителиЭтапов.НайтиСтроки(ПараметрыОтбора);
							Если МассивСтрок.Количество() > 0 Тогда
								ЗаполнитьЗначенияСвойств(Этап, МассивСтрок[0],
									"Исполнитель");
							КонецЕсли;
						КонецЕсли;
					Иначе
						ПараметрыОтбора = Новый Структура;
						ПараметрыОтбора.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
						ПараметрыОтбора.Вставить("Этап", Этап.Этап);
						МассивСтрок = ИсполнителиЭтапов.НайтиСтроки(ПараметрыОтбора);
						Если МассивСтрок.Количество() > 0 Тогда
							ЗаполнитьЗначенияСвойств(Этап, МассивСтрок[0],
								"Исполнитель, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации"
								+ ", ИмяРеквизитаОсновногоОбъектаАдресации, ИмяРеквизитаДополнительногоОбъектаАдресации");
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			// Заполнение исполнителей групповых этапов согласно сохраненных значений
			Если ИсполнителиГрупповыхЭтапов <> Неопределено Тогда
				Если НЕ ЗагружатьИсполнителей Тогда
					
					НовыеЭтапыПоИдентификаторам = Новый Соответствие;
					Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
						НовыеЭтапыПоИдентификаторам.Вставить(Этап.ИдентификаторЭтапа, Этап.Этап);
					КонецЦикла;
					
					Для Каждого ИсполнительГрупповогоЭтапа Из ИсполнителиГрупповыхЭтапов Цикл
						// Если идентификатор этапа не найден в новых этапах, то строку не добавляем
						Если НовыеЭтапыПоИдентификаторам[ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа] = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						// Если идентификатор этапа стал указывать на другой этап, то строку не добавляем
						Если НовыеЭтапыПоИдентификаторам[ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа] <>
							ЭтапыПоИдентификаторам[ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа] Тогда
							Продолжить;
						КонецЕсли;
						
						ЗаполнитьЗначенияСвойств(ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Добавить(), ИсполнительГрупповогоЭтапа);
						
					КонецЦикла;
					
				Иначе
					
					// Если в загруженных групповых исполнителях есть пользователи,
					// то заполняем вместо них сохраненных пользователей (в рамках этапов)
					ИдентификаторыГрупповыхЭтаповСПользователями = Новый Соответствие;
					
					ПараметрыОтбора = Новый Структура("Исполнитель", Неопределено);
					МассивСтрокКУдалению = ШаблонОбъект.ИсполнителиГрупповыхЭтапов.НайтиСтроки(ПараметрыОтбора);
					Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
						ИдентификаторыГрупповыхЭтаповСПользователями.Вставить(СтрокаКУдалению.ИдентификаторЭтапа, Истина);
						ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Удалить(СтрокаКУдалению);
					КонецЦикла;
					
					Для Каждого ИсполнительГрупповогоЭтапа Из ИсполнителиГрупповыхЭтапов Цикл
						Если ИдентификаторыГрупповыхЭтаповСПользователями[ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа] <> Неопределено
							И ТипЗнч(ИсполнительГрупповогоЭтапа.Исполнитель) = Тип("СправочникСсылка.Пользователи") Тогда
							ЗаполнитьЗначенияСвойств(ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Добавить(), ИсполнительГрупповогоЭтапа);
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
			
			ШаблонОбъект.ОбменДанными.Загрузка = Истина;
			ШаблонОбъект.Записать();
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "ШаблоныПроцессов" Тогда
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	ФайлДанных.УстановитьСтроку(Данные);
	
	Пока ФайлДанных.Прочитать() Цикл
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			Если ФайлДанных.Имя = "ШаблонПроцесса" Тогда
				
				Документ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ."
					+ ФайлДанных.ПолучитьАтрибут("Документ"));
				ИдентификаторПоддержки = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
				
				ЗаписатьОбъект = ОбъектыДляЗагрузки[ИдентификаторПоддержки] <> Неопределено;
				Если НЕ ЗаписатьОбъект Тогда
					ШаблонОбъект = Справочники.ШаблоныПроцессов.СоздатьЭлемент();
					Продолжить;
				КонецЕсли;
				
				Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				НачальныйСтатус = СоответствияОбъектов.СоответствиеСтатусов.Получить(ФайлДанных.ПолучитьАтрибут("НачальныйСтатус"));
				
				ШаблонСсылка = СоответствияОбъектов.СоответствиеШаблонов.Получить(ИдентификаторПоддержки);
				Если ШаблонСсылка.Пустая() Тогда
					
					ИсполнителиЭтапов = Неопределено;
					ИсполнителиГрупповыхЭтапов = Неопределено;
					
					ШаблонОбъект = Справочники.ШаблоныПроцессов.СоздатьЭлемент();
					ШаблонОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержки);
					ШаблонОбъект.Наименование = Наименование;
					ШаблонОбъект.ИдентификаторДокумента = Документ;
					ШаблонОбъект.НачальныйСтатус = НачальныйСтатус;
					
					НоваяСсылка = Справочники.ШаблоныПроцессов.ПолучитьСсылку();
					СоответствияОбъектов.СоответствиеШаблонов.Вставить(ИдентификаторПоддержки, НоваяСсылка);
					
					ШаблонОбъект.УстановитьСсылкуНового(НоваяСсылка);
					
				Иначе
					
					ШаблонОбъект = ШаблонСсылка.ПолучитьОбъект();
					
					// Сохранение текущих исполнителей этапов в таблицу значений
					ИсполнителиЭтапов = ШаблонОбъект.Этапы.Выгрузить( ,
						"ИдентификаторЭтапа, Этап, Исполнитель, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации,"
						+ "ИмяРеквизитаОсновногоОбъектаАдресации, ИмяРеквизитаДополнительногоОбъектаАдресации");
					
					ЭтапыПоИдентификаторам = Новый Соответствие;
					Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
						ЭтапыПоИдентификаторам.Вставить(Этап.ИдентификаторЭтапа, Этап.Этап);
					КонецЦикла;
					
					ИсполнителиГрупповыхЭтапов = ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Выгрузить( ,
						"ИдентификаторЭтапа, Исполнитель, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации,"
						+ "ИмяРеквизитаОсновногоОбъектаАдресации, ИмяРеквизитаДополнительногоОбъектаАдресации");
					
					ПроверитьУстановитьЗначениеРеквизита(ШаблонОбъект, "ИдентификаторПоддержки", Новый УникальныйИдентификатор(ИдентификаторПоддержки));
					ПроверитьУстановитьЗначениеРеквизита(ШаблонОбъект, "Наименование", Наименование);
					ПроверитьУстановитьЗначениеРеквизита(ШаблонОбъект, "ИдентификаторДокумента", Документ);
					ПроверитьУстановитьЗначениеРеквизита(ШаблонОбъект, "НачальныйСтатус", НачальныйСтатус);
					
					ШаблонОбъект.Этапы.Очистить();
					ШаблонОбъект.ПредшественникиЭтапов.Очистить();
					ШаблонОбъект.ПрерываниеЭтапов.Очистить();
					ШаблонОбъект.ОтветственностьЗаРеквизиты.Очистить();
					ШаблонОбъект.ИзменениеРеквизитовЭтапов.Очистить();
					ШаблонОбъект.ОбязательныеРеквизиты.Очистить();
					ШаблонОбъект.НедоступныеРеквизиты.Очистить();
					ШаблонОбъект.ДополнительныеОбработчики.Очистить();
					ШаблонОбъект.ВлияниеНаДругиеПроцессы.Очистить();
					ШаблонОбъект.ТребованияКПроведению.Очистить();
					ШаблонОбъект.ТребованияКВыполнению.Очистить();
					ШаблонОбъект.ИнициирующиеСобытия.Очистить();
					ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Очистить();
					Если ЗагружатьНастройкиСвойствЭлементов Тогда
						ШаблонОбъект.УправлениеЭлементамиФормы.Очистить();
					КонецЕсли;	
					
				КонецЕсли;
				
			ИначеЕсли ФайлДанных.Имя = "ОписаниеШаблона" Тогда
				
				ШаблонОбъект.Описание = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);

			ИначеЕсли ФайлДанных.Имя = "РеквизитДляРасчетаСроковОбработки" Тогда

				ШаблонОбъект.РеквизитДляРасчетаСроковОбработки = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
				
			ИначеЕсли ФайлДанных.Имя = "ИспользоватьРеквизитДляРасчетаСроковОбработки" Тогда

				ШаблонОбъект.ИспользоватьРеквизитДляРасчетаСроковОбработки = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
	
			ИначеЕсли ФайлДанных.Имя = "НеИспользуется" Тогда
				
				ШаблонОбъект.НеИспользуется = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));

			ИначеЕсли ФайлДанных.Имя = "ЕстьНастройкиФормированияИПодписанияФормуляров" Тогда
				
				ШаблонОбъект.ЕстьНастройкиФормированияИПодписанияФормуляров = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));

