		ЗаписатьЭлемент("ПредставлениеРезультата", ВыборкаРезультатыВыполнения.ПредставлениеРезультата);
		ЗаписатьЭлемент("СтатусПослеВыполнения", Строка(ВыборкаРезультатыВыполнения.СтатусПослеВыполнения));
		ЗаписатьЭлемент("ОтрицательныйРезультат", ВыборкаРезультатыВыполнения.ОтрицательныйРезультат);
		ЗаписатьЭлемент("ТребуетсяЭП", ВыборкаРезультатыВыполнения.ТребуетсяЭП);
		ЗаписатьЭлемент("ТребуетсяПростаяЭП", ВыборкаРезультатыВыполнения.ТребуетсяПростаяЭП);
		ЗаписатьЭлемент("Скрытый", ВыборкаРезультатыВыполнения.Скрытый);
		
		ФайлДанных.ЗаписатьКонецЭлемента(); // РезультатВыполнения
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); // РезультатыВыполнения
	
