	ЗаписатьЭлемент("СрокЗависитОтВремениНачала", ВыборкаИнтервалы.СрокЗависитОтВремениНачала);
	ЗаписатьЭлемент("ВремяНачала", ВыборкаИнтервалы.ВремяНачала);
	ЗаписатьЭлемент("СрокВыполненияЧасы", ВыборкаИнтервалы.СрокВыполненияЧасы);
	ЗаписатьЭлемент("СрокВыполненияДни", ВыборкаИнтервалы.СрокВыполненияДни);
	ЗаписатьЭлемент("СпособУказанияВремениОкончания", ВыборкаИнтервалы.СпособУказанияВремениОкончания);
	ЗаписатьЭлемент("ВремяОкончания", ВыборкаИнтервалы.ВремяОкончания);
	ЗаписатьЭлемент("СрокВыполненияЧасыПосле", ВыборкаИнтервалы.СрокВыполненияЧасыПосле);
	ЗаписатьЭлемент("СрокВыполненияДниПосле", ВыборкаИнтервалы.СрокВыполненияДниПосле);
	ЗаписатьЭлемент("СпособУказанияВремениОкончанияПосле", ВыборкаИнтервалы.СпособУказанияВремениОкончанияПосле);
	ЗаписатьЭлемент("ВремяОкончанияПосле", ВыборкаИнтервалы.ВремяОкончанияПосле);
	
