		ЗаписатьЭлемент("ИдентификаторПредшественника", ВыборкаПредшественники.ИдентификаторПредшественника);
		
		ФайлДанных.ЗаписатьКонецЭлемента(); // ПредшественникиЭтапа
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); // ПредшественникиЭтаповИнтервала
	
	ФайлДанных.ЗаписатьКонецЭлемента(); // РегламентныйИнтервал
	
