КонецФункции

Функция ИдентификаторыРолейИсполнителей(ВыборкаРоли)
	
	ИдентификаторыРолей = Новый Соответствие;
	
	Пока ВыборкаРоли.Следующий() Цикл
		ИдентификаторыРолей.Вставить(ВыборкаРоли.Ссылка, ВыборкаРоли.ИдентификаторПоддержки);
	КонецЦикла;
	
	Возврат ИдентификаторыРолей;
	
Конецфункции

Процедура ВыгрузитьШаблонПроцесса(ВыборкаШаблоны, ИдентификаторыРолей)
	
	ФайлДанных.ЗаписатьНачалоЭлемента("ШаблонПроцесса");
	
	ФайлДанных.ЗаписатьАтрибут("ИдентификаторПоддержки", Строка(ВыборкаШаблоны.ИдентификаторПоддержки));
	ФайлДанных.ЗаписатьАтрибут("Наименование", ВыборкаШаблоны.Наименование);
	ФайлДанных.ЗаписатьАтрибут("Документ", ВыборкаШаблоны.Документ);
	ФайлДанных.ЗаписатьАтрибут("НачальныйСтатус", Строка(ВыборкаШаблоны.НачальныйСтатус)); 

	ЗаписатьЭлемент("ИспользоватьРеквизитДляРасчетаСроковОбработки", ВыборкаШаблоны.ИспользоватьРеквизитДляРасчетаСроковОбработки);
	ЗаписатьЭлемент("РеквизитДляРасчетаСроковОбработки", ВыборкаШаблоны.РеквизитДляРасчетаСроковОбработки);
	
	ЗаписатьЭлемент("НеИспользуется", ВыборкаШаблоны.НеИспользуется);
	ЗаписатьЭлемент("ЕстьНастройкиФормированияИПодписанияФормуляров", ВыборкаШаблоны.ЕстьНастройкиФормированияИПодписанияФормуляров);
	ЗаписатьЭлемент("ОписаниеШаблона", ВыборкаШаблоны.Описание);

	ЗаписатьЭлемент("РазрешенаОтправкаФормуляровКонтрагентамПоЭДО", ВыборкаШаблоны.РазрешенаОтправкаФормуляровКонтрагентамПоЭДО);
	
	ФайлДанных.ЗаписатьНачалоЭлемента("Этапы");
	ВыборкаЭтапы = ВыборкаШаблоны.Этапы.Выбрать();
	Пока ВыборкаЭтапы.Следующий() Цикл
		ФайлДанных.ЗаписатьНачалоЭлемента("ЭтапСтрока");
		
		ТипИсполнителя = ТипЗнч(ВыборкаЭтапы.Исполнитель);
		
		ЗаписатьЭлемент("ИдентификаторЭтапа", ВыборкаЭтапы.ИдентификаторЭтапа);
		ЗаписатьЭлемент("Этап", Строка(ВыборкаЭтапы.Этап));
		
		Если ТипИсполнителя = Тип("Строка") Тогда
			ЗаписатьЭлемент("Исполнитель", ВыборкаЭтапы.Исполнитель);
		ИначеЕсли ТипИсполнителя = Тип("СправочникСсылка.РолиИсполнителей") Тогда
			ЗаписатьЭлемент("Исполнитель", ИдентификаторыРолей[ВыборкаЭтапы.Исполнитель]);
		Иначе
			ЗаписатьЭлемент("Исполнитель", "")
		КонецЕсли;
		
		ЗаписатьЭлемент("ПредшественникиВариантИспользования", ВыборкаЭтапы.ПредшественникиВариантИспользования);
		ЗаписатьЭлемент("ИмяРеквизитаОсновногоОбъектаАдресации", ВыборкаЭтапы.ИмяРеквизитаОсновногоОбъектаАдресации);
		ЗаписатьЭлемент("ИмяРеквизитаДополнительногоОбъектаАдресации", ВыборкаЭтапы.ИмяРеквизитаДополнительногоОбъектаАдресации);
		ЗаписатьЭлемент("Порядок", ВыборкаЭтапы.Порядок);
		ЗаписатьЭлемент("ВключатьВШтампВизуализацииЭП", ВыборкаЭтапы.ВключатьВШтампВизуализацииЭП);
		ЗаписатьЭлемент("ЗапретитьПроведениеОтменуПроведения", ВыборкаЭтапы.ЗапретитьПроведениеОтменуПроведения);
		ЗаписатьЭлемент("ЗапретитьПерепроведение", ВыборкаЭтапы.ЗапретитьПерепроведение);
		ЗаписатьЭлемент("СрокВыполненияЧасы", ВыборкаЭтапы.СрокВыполненияЧасы); 
		ЗаписатьЭлемент("СрокиОбработкиПоРеквизитуДни", ВыборкаЭтапы.СрокиОбработкиПоРеквизитуДни);
        ЗаписатьЭлемент("СрокиОбработкиПоРеквизитуЧасы", ВыборкаЭтапы.СрокиОбработкиПоРеквизитуЧасы);
		ЗаписатьЭлемент("ЗапрещеноДобавлениеФайлов", ВыборкаЭтапы.ЗапрещеноДобавлениеФайлов);
		ЗаписатьЭлемент("ЗапрещеноИзменениеФайлов", ВыборкаЭтапы.ЗапрещеноИзменениеФайлов);
		ЗаписатьЭлемент("НаличиеФайловОбязательно", ВыборкаЭтапы.НаличиеФайловОбязательно);
		ЗаписатьЭлемент("РасшифровкаОбязательныхПрисоединенныхФайлов", ВыборкаЭтапы.РасшифровкаОбязательныхПрисоединенныхФайлов);
		ЗаписатьЭлемент("ПодписыватьФайлыЭП", ВыборкаЭтапы.ПодписыватьФайлыЭП);
		ЗаписатьЭлемент("ИдентификаторыКомандПечатиСоШтампом", ВыборкаЭтапы.ИдентификаторыКомандПечатиСоШтампом);
		ЗаписатьЭлемент("ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске", ВыборкаЭтапы.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске);
		ЗаписатьЭлемент("НеЗапрещатьОтменуВыполненияПриНаличииПрерванных", ВыборкаЭтапы.НеЗапрещатьОтменуВыполненияПриНаличииПрерванных);
		ЗаписатьЭлемент("ОбособленнаяЗонаОтветственности", ВыборкаЭтапы.ОбособленнаяЗонаОтветственности);
		ЗаписатьЭлемент("ЭтапВыполняетсяНесколькимиИсполнителями", ВыборкаЭтапы.ЭтапВыполняетсяНесколькимиИсполнителями);
		ЗаписатьЭлемент("ИдентификаторЭтапаКуратора", ВыборкаЭтапы.ИдентификаторЭтапаКуратора);
		ЗаписатьЭлемент("ЗапрещеноИсполнителюОтменятьВыполнениеЭтапа", ВыборкаЭтапы.ЗапрещеноИсполнителюОтменятьВыполнениеЭтапа);
