	Если ЗначениеЗаполнено(ВыборкаРоли.ТипыООАТипЗначения) Тогда
		Типы = Новый Массив;
		Для Каждого Тип Из ВыборкаРоли.ТипыООАТипЗначения.Типы() Цикл
			Типы.Добавить(ОбщегоНазначения.СтроковоеПредставлениеТипа(Тип));
		КонецЦикла;
		ЗаписатьЭлемент("ТипыООАТипЗначения", СтрСоединить(Типы, ","));
	Иначе
		ЗаписатьЭлемент("ТипыООАТипЗначения", "");
	КонецЕсли;
	ЗаписатьЭлемент("ТипыДОАИмяПредопределенныхДанных", ВыборкаРоли.ТипыДОАИмяПредопределенныхДанных);
	Если ЗначениеЗаполнено(ВыборкаРоли.ТипыДОАТипЗначения) Тогда
		Типы = Новый Массив;
		Для Каждого Тип Из ВыборкаРоли.ТипыДОАТипЗначения.Типы() Цикл
			Типы.Добавить(ОбщегоНазначения.СтроковоеПредставлениеТипа(Тип));
		КонецЦикла;
		ЗаписатьЭлемент("ТипыДОАТипЗначения", СтрСоединить(Типы, ","));
	Иначе
		ЗаписатьЭлемент("ТипыДОАТипЗначения", "");
	КонецЕсли;
	ЗаписатьЭлемент("Комментарий", ВыборкаРоли.Комментарий);
	
	ФайлДанных.ЗаписатьКонецЭлемента(); // РольИсполнителя
	
КонецПроцедуры

