Процедура ВыгрузитьРольИсполнителя(ВыборкаРоли)
	
	ФайлДанных.ЗаписатьНачалоЭлемента("РольИсполнителя");
	
	ФайлДанных.ЗаписатьАтрибут("ИдентификаторПоддержки", Строка(ВыборкаРоли.ИдентификаторПоддержки));
	ФайлДанных.ЗаписатьАтрибут("Наименование", ВыборкаРоли.Наименование);
	
	ЗаписатьЭлемент("КраткоеПредставление", ВыборкаРоли.КраткоеПредставление);
	ЗаписатьЭлемент("ИспользуетсяСОбъектамиАдресации", ВыборкаРоли.ИспользуетсяСОбъектамиАдресации);
	ЗаписатьЭлемент("ИспользуетсяБезОбъектовАдресации", ВыборкаРоли.ИспользуетсяБезОбъектовАдресации);
