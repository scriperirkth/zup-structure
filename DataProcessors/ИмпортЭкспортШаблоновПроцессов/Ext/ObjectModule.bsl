						И ИмяУзла = "ТребованиеКПроведению" Тогда
						НоваяСтрока = ШаблонОбъект.ТребованияКПроведению.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторЭтапа" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Статус" Тогда
						
						НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеСтатусов.Получить(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "ПризнакПроведенности" Тогда
						
						НоваяСтрока[ИмяУзла] = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ФайлДанных.Имя = "ТребованияКВыполнению" Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "ТребованияКВыполнению" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "ТребованиеКВыполнению" Тогда
						НоваяСтрока = ШаблонОбъект.ТребованияКВыполнению.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторЭтапа" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Статус" Тогда
						
						НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеСтатусов.Получить(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "УсловиеВыполнения" Тогда
						
						НоваяСтрока[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ФайлДанных.Имя = "ИнициирующиеСобытия" Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "ИнициирующиеСобытия" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "ИнициирующееСобытие" Тогда
						НоваяСтрока = ШаблонОбъект.ИнициирующиеСобытия.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторЭтапа" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Статус" Тогда
						
						НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеСтатусов.Получить(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Событие" Тогда
						
						НоваяСтрока[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ФайлДанных.Имя = "ИсполнителиГрупповыхЭтапов" И ЗагружатьИсполнителей Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "ИсполнителиГрупповыхЭтапов" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "ИсполнительГрупповогоЭтапа" Тогда
						НоваяСтрока = ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторЭтапа" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "Исполнитель" Тогда
						
						ИсполнительИзФайла = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
						Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИсполнительИзФайла) Тогда
							// это роль исполнителя
							НоваяСтрока[ИмяУзла] = СоответствияОбъектов.СоответствиеРолей.Получить(ИсполнительИзФайла);
						ИначеЕсли ИсполнительИзФайла = "" Тогда
							// это пользователь, не загружается
						Иначе
							// это функция либо предопределенная роль (например "Автор документа")
							НоваяСтрока[ИмяУзла] = ИсполнительИзФайла
						КонецЕсли;
						
					ИначеЕсли ИмяУзла = "ИмяРеквизитаОсновногоОбъектаАдресации"
						ИЛИ ИмяУзла = "ИмяРеквизитаДополнительногоОбъектаАдресации" Тогда
						
						НоваяСтрока[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "ШаблонПроцесса"
			И ЗаписатьОбъект Тогда
			
			// Заполнение исполнителей этапов согласно сохраненных значений
			Если ИсполнителиЭтапов <> Неопределено Тогда
				Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
					
					Если ЗагружатьИсполнителей Тогда
						Если ТипЗнч(Этап.Исполнитель) = Тип("СправочникСсылка.РолиИсполнителей") Тогда
							// При флаге "загружать исполнителей" для ролей необходимо восстановить объекты адресации
							ПараметрыОтбора = Новый Структура;
							ПараметрыОтбора.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
							ПараметрыОтбора.Вставить("Этап", Этап.Этап);
							ПараметрыОтбора.Вставить("Исполнитель", Этап.Исполнитель);
							МассивСтрок = ИсполнителиЭтапов.НайтиСтроки(ПараметрыОтбора);
							Если МассивСтрок.Количество() > 0 Тогда
								ЗаполнитьЗначенияСвойств(Этап, МассивСтрок[0],
									"ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации");
							КонецЕсли;
						ИначеЕсли ТипЗнч(Этап.Исполнитель) = Тип("Строка") Тогда
							Продолжить;
						ИначеЕсли Этап.Исполнитель = Неопределено Тогда
							// При флаге "загружать исполнителей" для пользователей необходимо их восстановить
							ПараметрыОтбора = Новый Структура;
							ПараметрыОтбора.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
							ПараметрыОтбора.Вставить("Этап", Этап.Этап);
							МассивСтрок = ИсполнителиЭтапов.НайтиСтроки(ПараметрыОтбора);
							Если МассивСтрок.Количество() > 0 Тогда
								ЗаполнитьЗначенияСвойств(Этап, МассивСтрок[0],
									"Исполнитель");
							КонецЕсли;
						КонецЕсли;
					Иначе
						ПараметрыОтбора = Новый Структура;
						ПараметрыОтбора.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
						ПараметрыОтбора.Вставить("Этап", Этап.Этап);
						МассивСтрок = ИсполнителиЭтапов.НайтиСтроки(ПараметрыОтбора);
						Если МассивСтрок.Количество() > 0 Тогда
							ЗаполнитьЗначенияСвойств(Этап, МассивСтрок[0],
								"Исполнитель, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации"
								+ ", ИмяРеквизитаОсновногоОбъектаАдресации, ИмяРеквизитаДополнительногоОбъектаАдресации");
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			// Заполнение исполнителей групповых этапов согласно сохраненных значений
			Если ИсполнителиГрупповыхЭтапов <> Неопределено Тогда
				Если НЕ ЗагружатьИсполнителей Тогда
					
					НовыеЭтапыПоИдентификаторам = Новый Соответствие;
					Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
						НовыеЭтапыПоИдентификаторам.Вставить(Этап.ИдентификаторЭтапа, Этап.Этап);
					КонецЦикла;
					
					Для Каждого ИсполнительГрупповогоЭтапа Из ИсполнителиГрупповыхЭтапов Цикл
						// Если идентификатор этапа не найден в новых этапах, то строку не добавляем
						Если НовыеЭтапыПоИдентификаторам[ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа] = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						// Если идентификатор этапа стал указывать на другой этап, то строку не добавляем
						Если НовыеЭтапыПоИдентификаторам[ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа] <>
							ЭтапыПоИдентификаторам[ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа] Тогда
							Продолжить;
						КонецЕсли;
						
						ЗаполнитьЗначенияСвойств(ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Добавить(), ИсполнительГрупповогоЭтапа);
						
					КонецЦикла;
					
				Иначе
					
					// Если в загруженных групповых исполнителях есть пользователи,
					// то заполняем вместо них сохраненных пользователей (в рамках этапов)
					ИдентификаторыГрупповыхЭтаповСПользователями = Новый Соответствие;
					
					ПараметрыОтбора = Новый Структура("Исполнитель", Неопределено);
					МассивСтрокКУдалению = ШаблонОбъект.ИсполнителиГрупповыхЭтапов.НайтиСтроки(ПараметрыОтбора);
					Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
						ИдентификаторыГрупповыхЭтаповСПользователями.Вставить(СтрокаКУдалению.ИдентификаторЭтапа, Истина);
						ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Удалить(СтрокаКУдалению);
					КонецЦикла;
					
					Для Каждого ИсполнительГрупповогоЭтапа Из ИсполнителиГрупповыхЭтапов Цикл
						Если ИдентификаторыГрупповыхЭтаповСПользователями[ИсполнительГрупповогоЭтапа.ИдентификаторЭтапа] <> Неопределено
							И ТипЗнч(ИсполнительГрупповогоЭтапа.Исполнитель) = Тип("СправочникСсылка.Пользователи") Тогда
							ЗаполнитьЗначенияСвойств(ШаблонОбъект.ИсполнителиГрупповыхЭтапов.Добавить(), ИсполнительГрупповогоЭтапа);
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
			
			ШаблонОбъект.Записать();
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "ШаблоныПроцессов" Тогда
			
			Возврат;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьРегламентныеИнтервалы(Данные, СоответствияОбъектов, ОбъектыДляЗагрузки)
	
	ФайлДанных = Новый ЧтениеXML;
	ФайлДанных.УстановитьСтроку(Данные);
	
	Пока ФайлДанных.Прочитать() Цикл
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "РегламентныйИнтервал" Тогда
				
				ИдентификаторПоддержки = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
				Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				Шаблон = СоответствияОбъектов.СоответствиеШаблонов.Получить(ФайлДанных.ПолучитьАтрибут("Шаблон"));
				
				ЗаписатьОбъект = ОбъектыДляЗагрузки[ИдентификаторПоддержки] <> Неопределено;
				Если НЕ ЗаписатьОбъект Тогда
					ИнтервалОбъект = Справочники.РегламентныеИнтервалы.СоздатьЭлемент();
					Продолжить;
				КонецЕсли;
				
				ИнтервалСсылка = СоответствияОбъектов.СоответствиеИнтервалов.Получить(ИдентификаторПоддержки);
				
				Если ИнтервалСсылка.Пустая() Тогда
					
					ИнтервалОбъект = Справочники.РегламентныеИнтервалы.СоздатьЭлемент();
					ИнтервалОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержки);
					ИнтервалОбъект.Наименование = Наименование;
					ИнтервалОбъект.Владелец = Шаблон;
					
					НоваяСсылка = Справочники.РегламентныеИнтервалы.ПолучитьСсылку();
					СоответствияОбъектов.СоответствиеИнтервалов.Вставить(ИдентификаторПоддержки, НоваяСсылка);
					
					ИнтервалОбъект.УстановитьСсылкуНового(НоваяСсылка);
					
				Иначе
					ИнтервалОбъект = ИнтервалСсылка.ПолучитьОбъект();
					ПроверитьУстановитьЗначениеРеквизита(ИнтервалОбъект, "ИдентификаторПоддержки", Новый УникальныйИдентификатор(ИдентификаторПоддержки));
					ПроверитьУстановитьЗначениеРеквизита(ИнтервалОбъект, "Наименование", Наименование);
					ПроверитьУстановитьЗначениеРеквизита(ИнтервалОбъект, "Владелец", Шаблон);
					ИнтервалОбъект.Этапы.Очистить();
					ИнтервалОбъект.ПредшественникиЭтапов.Очистить();
				КонецЕсли;
				
			ИначеЕсли ИнтервалОбъект = Неопределено Тогда
				
				Продолжить;
				
			ИначеЕсли ФайлДанных.Имя = "ИдентификаторНачальногоЭтапа"
				ИЛИ ФайлДанных.Имя = "ИдентификаторКонечногоЭтапа" Тогда
				
				ИнтервалОбъект[ФайлДанных.Имя] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
				
			ИначеЕсли ФайлДанных.Имя = "СрокЗависитОтВремениНачала" Тогда
				
				ИнтервалОбъект[ФайлДанных.Имя] = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
				
			ИначеЕсли ФайлДанных.Имя = "ВремяНачала"
				ИЛИ ФайлДанных.Имя = "ВремяОкончания"
				ИЛИ ФайлДанных.Имя = "ВремяОкончанияПосле" Тогда
				
				ИнтервалОбъект[ФайлДанных.Имя] = XMLЗначение(Тип("Дата"), ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
				
			ИначеЕсли ФайлДанных.Имя = "СрокВыполненияЧасы"
				ИЛИ ФайлДанных.Имя = "СрокВыполненияДни"
				ИЛИ ФайлДанных.Имя = "СпособУказанияВремениОкончания"
				ИЛИ ФайлДанных.Имя = "СрокВыполненияЧасыПосле"
				ИЛИ ФайлДанных.Имя = "СрокВыполненияДниПосле"
				ИЛИ ФайлДанных.Имя = "СпособУказанияВремениОкончанияПосле" Тогда
				
				ИнтервалОбъект[ФайлДанных.Имя] = Число(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
				
			ИначеЕсли ФайлДанных.Имя = "Этапы" Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "Этапы" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "ЭтапСтрока" Тогда
						НоваяСтрока = ИнтервалОбъект.Этапы.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторЭтапа" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					ИначеЕсли ИмяУзла = "СрокВыполненияЧасы" Тогда
						
						НоваяСтрока[ИмяУзла] = Число(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ФайлДанных.Имя = "ПредшественникиЭтаповИнтервала" Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "ПредшественникиЭтаповИнтервала" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "ПредшественникиЭтапа" Тогда
						НоваяСтрока = ИнтервалОбъект.ПредшественникиЭтапов.Добавить();
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "ИдентификаторПоследователя"
						ИЛИ ИмяУзла = "ИдентификаторПредшественника" Тогда
						
						НоваяСтрока[ИмяУзла] = Новый УникальныйИдентификатор(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "РегламентныйИнтервал"
			И ЗаписатьОбъект Тогда
			
			ИнтервалОбъект.Записать();
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "РегламентныеИнтервалы" Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьРолиИсполнителей(Данные, СоответствияОбъектов, ОбъектыДляЗагрузки)
	
	ФайлДанных = Новый ЧтениеXML;
	ФайлДанных.УстановитьСтроку(Данные);
	
	ОбъектыАдресации = Новый Структура;
	ОбъектыАдресации.Вставить("ТипыООАИмяПредопределенныхДанных");
	ОбъектыАдресации.Вставить("ТипыООАТипЗначения");
	ОбъектыАдресации.Вставить("ТипыДОАИмяПредопределенныхДанных");
	ОбъектыАдресации.Вставить("ТипыДОАТипЗначения");
	
	Пока ФайлДанных.Прочитать() Цикл
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "РольИсполнителя" Тогда
				
				ИдентификаторПоддержки = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
				Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				
				ЗаписатьОбъект = ОбъектыДляЗагрузки[ИдентификаторПоддержки] <> Неопределено;
				Если НЕ ЗаписатьОбъект Тогда
					РольОбъект = Справочники.РолиИсполнителей.СоздатьЭлемент();
					Продолжить;
				КонецЕсли;
				
				ОбъектыАдресации.Вставить("ТипыООАИмяПредопределенныхДанных");
				ОбъектыАдресации.Вставить("ТипыООАТипЗначения");
				ОбъектыАдресации.Вставить("ТипыДОАИмяПредопределенныхДанных");
				ОбъектыАдресации.Вставить("ТипыДОАТипЗначения");
				
				РольСсылка = СоответствияОбъектов.СоответствиеРолей.Получить(ИдентификаторПоддержки);
				
				Если РольСсылка.Пустая() Тогда
					
					РольОбъект = Справочники.РолиИсполнителей.СоздатьЭлемент();
					РольОбъект.Наименование = Наименование;
					
					РольСсылка = Справочники.РолиИсполнителей.ПолучитьСсылку();
					СоответствияОбъектов.СоответствиеРолей.Вставить(ИдентификаторПоддержки, РольСсылка);
					
					РольОбъект.УстановитьСсылкуНового(РольСсылка);
					
				Иначе
					РольОбъект = РольСсылка.ПолучитьОбъект();
					ПроверитьУстановитьЗначениеРеквизита(РольОбъект, "Наименование", Наименование);
				КонецЕсли;
				
				УстановитьИдентификаторПодержкиРолиИсполнителя(РольСсылка, Новый УникальныйИдентификатор(ИдентификаторПоддержки));
				
			ИначеЕсли РольОбъект = Неопределено Тогда
				
				Продолжить;
				
			ИначеЕсли ФайлДанных.Имя = "ИспользуетсяСОбъектамиАдресации"
				ИЛИ ФайлДанных.Имя = "ИспользуетсяБезОбъектовАдресации" Тогда
				
				РольОбъект[ФайлДанных.Имя] = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных));
				
			ИначеЕсли ФайлДанных.Имя = "ТипыООАИмяПредопределенныхДанных"
				ИЛИ ФайлДанных.Имя = "ТипыООАТипЗначения"
				ИЛИ ФайлДанных.Имя = "ТипыДОАИмяПредопределенныхДанных"
				ИЛИ ФайлДанных.Имя = "ТипыДОАТипЗначения" Тогда
				
				ОбъектыАдресации[ФайлДанных.Имя] = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
				
			ИначеЕсли ФайлДанных.Имя = "КраткоеПредставление"
				ИЛИ ФайлДанных.Имя = "Комментарий" Тогда
				
				РольОбъект[ФайлДанных.Имя] = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "РольИсполнителя"
			И ЗаписатьОбъект Тогда
			
			Если ЗначениеЗаполнено(ОбъектыАдресации.ТипыООАИмяПредопределенныхДанных)
				И ЗначениеЗаполнено(ОбъектыАдресации.ТипыООАТипЗначения) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	ОбъектыАдресацииЗадач.Ссылка КАК Ссылка,
				|	ОбъектыАдресацииЗадач.ТипЗначения КАК ТипЗначения,
				|	ОбъектыАдресацииЗадач.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
				|ИЗ
				|	ПланВидовХарактеристик.ОбъектыАдресацииЗадач КАК ОбъектыАдресацииЗадач";
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					Если Выборка.ИмяПредопределенныхДанных = ОбъектыАдресации.ТипыООАИмяПредопределенныхДанных Тогда
						ТипыПВХВБазе = Новый Массив;
						Для Каждого Тип Из Выборка.ТипЗначения.Типы() Цикл
							ТипыПВХВБазе.Добавить(ОбщегоНазначения.СтроковоеПредставлениеТипа(Тип));
						КонецЦикла;
						Если ОбщегоНазначенияКлиентСервер.СпискиЗначенийИдентичны(
							ТипыПВХВБазе, СтрРазделить(ОбъектыАдресации.ТипыООАТипЗначения, ",", Ложь)) Тогда
							РольОбъект.ТипыОсновногоОбъектаАдресации = Выборка.Ссылка;
						КонецЕсли;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОбъектыАдресации.ТипыДОАИмяПредопределенныхДанных)
				И ЗначениеЗаполнено(ОбъектыАдресации.ТипыДОАТипЗначения) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	ОбъектыАдресацииЗадач.Ссылка КАК Ссылка,
				|	ОбъектыАдресацииЗадач.ТипЗначения КАК ТипЗначения,
				|	ОбъектыАдресацииЗадач.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
				|ИЗ
				|	ПланВидовХарактеристик.ОбъектыАдресацииЗадач КАК ОбъектыАдресацииЗадач";
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					Если Выборка.ИмяПредопределенныхДанных = ОбъектыАдресации.ТипыДОАИмяПредопределенныхДанных Тогда
						ТипыПВХВБазе = Новый Массив;
						Для Каждого Тип Из Выборка.ТипЗначения.Типы() Цикл
							ТипыПВХВБазе.Добавить(ОбщегоНазначения.СтроковоеПредставлениеТипа(Тип));
						КонецЦикла;
						Если ОбщегоНазначенияКлиентСервер.СпискиЗначенийИдентичны(
							ТипыПВХВБазе, СтрРазделить(ОбъектыАдресации.ТипыДОАТипЗначения, ",", Ложь)) Тогда
							РольОбъект.ТипыДополнительногоОбъектаАдресации = Выборка.Ссылка;
						КонецЕсли;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			РольОбъект.Записать();
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "РолиИсполнителей" Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьНастройкиИспользования(Данные, СоответствияОбъектов, ОбъектыДляЗагрузки)
	
	ШаблоныДляОчисткиНастройки = ОбщегоНазначения.СкопироватьРекурсивно(СоответствияОбъектов.СоответствиеШаблонов);
	ДокументыДляОчисткиПустойНастройки = Новый Соответствие;
	
	ФайлДанных = Новый ЧтениеXML;
	ФайлДанных.УстановитьСтроку(Данные);
	
	Пока ФайлДанных.Прочитать() Цикл
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "НастройкаИспользования" Тогда
				
				Документ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
					"Документ." + ФайлДанных.ПолучитьАтрибут("Документ"));
				ИдентификаторПоддержки = ФайлДанных.ПолучитьАтрибут("Шаблон");
				Шаблон = СоответствияОбъектов.СоответствиеШаблонов.Получить(ИдентификаторПоддержки);
				
				ЗаписатьОбъект = ОбъектыДляЗагрузки[ИдентификаторПоддержки] <> Неопределено;
				
				МенеджерЗаписи = РегистрыСведений.НастройкаИспользованияШаблонов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.ИдентификаторДокумента = Документ;
				МенеджерЗаписи.Шаблон = Шаблон;
				
				ШаблоныДляОчисткиНастройки.Удалить(ФайлДанных.ПолучитьАтрибут("Шаблон"));
				
				Если ЗаписатьОбъект Тогда
					ДокументыДляОчисткиПустойНастройки.Вставить(Документ, Истина);
				КонецЕсли;
				
			ИначеЕсли ФайлДанных.Имя = "УсловиеИспользования" Тогда
				
				МенеджерЗаписи.УсловиеИспользования = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "НастройкаИспользования"
			И ЗаписатьОбъект Тогда
			
			МенеджерЗаписи.Записать();
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанных.Имя = "НастройкиИспользования" Тогда
			
			Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоШаблоновДляОдногоТипаДокумента")
				И ПроцессыОбработкиДокументов.ЕстьТипыДокументовСНесколькимиШаблонами() Тогда
				ТекстСообщения = НСтр("ru = 'Загрузка отменена. Не удалось загрузить настройки использования шаблонов. '")
					+ НСтр("ru = '""Необходимо включить флаг ""Использовать несколько шаблонов для одного типа документа"" '")
					+ НСтр("ru = 'в настройках процессов обработки документов'");
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Очистка настроек использования из выгрузки, настроек которых в выгрузке нет (значит их нет в базе-поставщике)
	Для Каждого КлючЗначение Из ШаблоныДляОчисткиНастройки Цикл
		// Ели шаблон не загружался, то не нужно удалять его настройку использования
		Если ОбъектыДляЗагрузки[КлючЗначение.Ключ] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МенеджерЗаписи = РегистрыСведений.НастройкаИспользованияШаблонов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			КлючЗначение.Значение, "ИдентификаторДокумента");
		МенеджерЗаписи.Шаблон = КлючЗначение.Значение;
		МенеджерЗаписи.Удалить();
	КонецЦикла;
	
	// Очистка настроек использования с пустым шаблоном, у которых в выгрузке есть заполненный шаблон,
	// чтобы не получилось ситуации, когда для одного типа документа есть записи с заполненным и незаполненным шаблоном
	Для Каждого КлючЗначение Из ДокументыДляОчисткиПустойНастройки Цикл
		МенеджерЗаписи = РегистрыСведений.НастройкаИспользованияШаблонов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторДокумента = КлючЗначение.Ключ;
		МенеджерЗаписи.Шаблон = ПредопределенноеЗначение("Справочник.ШаблоныПроцессов.ПустаяСсылка");
		МенеджерЗаписи.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьУстановитьЗначениеРеквизита(ТекущийОбъект, ИмяРеквизита, НовоеЗначениеРеквизита, ЗначениеИзменилось = Ложь)
	
	Если ТекущийОбъект[ИмяРеквизита] <> НовоеЗначениеРеквизита Тогда
		ТекущийОбъект[ИмяРеквизита] = НовоеЗначениеРеквизита;
		ЗначениеИзменилось = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция БулевоПоПредставлению(Знач Представление)
	
	Представление = ВРЕГ(Представление);
	
	Возврат Представление = "TRUE"
		ИЛИ Представление = "ИСТИНА";
	
КонецФункции

Функция ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных)

	ТекстовоеЗначение = "";
	Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
		ФайлДанных.Прочитать();
	КонецЕсли;
	Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
		Возврат "";
	КонецЕсли;
	ТекстовоеЗначение = ФайлДанных.Значение;
	ФайлДанных.Прочитать();
	
	Возврат ТекстовоеЗначение;

КонецФункции

Процедура УстановитьИдентификаторПодержкиРолиИсполнителя(Роль, ИдентификаторПоддержки)
	
	МенеджерЗаписи = РегистрыСведений.ИдентификаторыПоддержкиРолейИсполнителей.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.РольИсполнителя = Роль;
	МенеджерЗаписи.ИдентификаторПоддержки = ИдентификаторПоддержки;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

ТипСтрока                = Тип("Строка");
ТипДата                  = Тип("Дата");
ТипЧисло                 = Тип("Число");
ТипБулево                = Тип("Булево");
ТипСтандартнаяДатаНачала = Тип("СтандартнаяДатаНачала");

ТипУзлаНачалоЭлемента = ТипУзлаXML.НачалоЭлемента;
ТипУзлаКонецЭлемента  = ТипУзлаXML.КонецЭлемента;

#КонецОбласти

#КонецЕсли