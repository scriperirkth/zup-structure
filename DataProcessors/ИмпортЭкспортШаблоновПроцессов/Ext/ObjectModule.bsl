#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ФайлДанных;

Перем ТипСтрока;
Перем ТипДата;
Перем ТипЧисло;
Перем ТипБулево;
Перем ТипСтандартнаяДатаНачала;

Перем ТипУзлаНачалоЭлемента;
Перем ТипУзлаКонецЭлемента;

Перем ИзмененыИдентификаторыПоддержки;

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ВыполнитьВыгрузкуДанных(СписокШаблонов) Экспорт
	
	ДанныеШаблонов = ДанныеВыгружаемыхШаблонов(СписокШаблонов);
	
	ИзмененыИдентификаторыПоддержки = Ложь;
	
	УстановитьИдентификаторПоддержкиШаблоновПередВыгрузкой(ДанныеШаблонов[3].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	УстановитьИдентификаторПоддержкиЭтаповПередВыгрузкой(ДанныеШаблонов[4].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	УстановитьИдентификаторПоддержкиСтатусовПередВыгрузкой(ДанныеШаблонов[5].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	УстановитьИдентификаторПоддержкиРегламентныхИнтерваловПередВыгрузкой(ДанныеШаблонов[6].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	УстановитьИдентификаторПоддержкиРолейИсполнителейПередВыгрузкой(ДанныеШаблонов[7].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Если ИзмененыИдентификаторыПоддержки Тогда
		ДанныеШаблонов = ДанныеВыгружаемыхШаблонов(СписокШаблонов);
	КонецЕсли;
	
	ИдентификаторыРолей = ИдентификаторыРолейИсполнителей(ДанныеШаблонов[7].Выбрать());
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ИнициализироватьФайлДанныхДляВыгрузки(ИмяВременногоФайла);
	
	ВыборкаШаблоны = ДанныеШаблонов[3].Выбрать();
	ФайлДанных.ЗаписатьНачалоЭлемента("ШаблоныПроцессов");
	Пока ВыборкаШаблоны.Следующий() Цикл
		ВыгрузитьШаблонПроцесса(ВыборкаШаблоны, ИдентификаторыРолей);
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); //ШаблоныПроцессов
	
	ФайлДанных.ЗаписатьНачалоЭлемента("ЭтапыПроцессов");
	ТаблицаЭтапы = ДанныеШаблонов[4].Выгрузить();
	ТаблицаЭтапы.Сортировать("ИдентификаторПоддержки");
	Для Каждого ВыборкаЭтапы Из ТаблицаЭтапы Цикл
		ВыгрузитьЭтапПроцесса(ВыборкаЭтапы);
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); //ЭтапыПроцессов
	
	ФайлДанных.ЗаписатьНачалоЭлемента("СтатусыДокументов");
	ТаблицаСтатусы = ДанныеШаблонов[5].Выгрузить();
	ТаблицаСтатусы.Сортировать("ИдентификаторПоддержки");
	Для Каждого ВыборкаСтатусы Из ТаблицаСтатусы Цикл
		ВыгрузитьСтатус(ВыборкаСтатусы);
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); //СтатусыДокументов
	
	ВыборкаИнтервалы = ДанныеШаблонов[6].Выбрать();
	ФайлДанных.ЗаписатьНачалоЭлемента("РегламентныеИнтервалы");
	Пока ВыборкаИнтервалы.Следующий() Цикл
		ВыгрузитьРегламентныйИнтервал(ВыборкаИнтервалы);
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); //РегламентныеИнтервалы
	
	ВыборкаРоли = ДанныеШаблонов[7].Выбрать();
	ФайлДанных.ЗаписатьНачалоЭлемента("РолиИсполнителей");
	Пока ВыборкаРоли.Следующий() Цикл
		ВыгрузитьРольИсполнителя(ВыборкаРоли);
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); //РолиИсполнителей
	
	ВыборкаНастройкиИспользования = ДанныеШаблонов[8].Выбрать();
	ФайлДанных.ЗаписатьНачалоЭлемента("НастройкиИспользования");
	Пока ВыборкаНастройкиИспользования.Следующий() Цикл
		ВыгрузитьНастройкиИспользования(ВыборкаНастройкиИспользования);
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); //НастройкиИспользования
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриВыгрузкеШаблоновПроцессов(ФайлДанных, СписокШаблонов);
	
	ЗавершитьВыгрузку();
	
	ДанныеФайла = Новый ДвоичныеДанные(ИмяВременногоФайла);
	
	АдресФайлаВХранилище = ПоместитьВоВременноеХранилище(ДанныеФайла);
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// обработка исключения не требуется
	КонецПопытки;
	
	Возврат АдресФайлаВХранилище;
	
КонецФункции

Процедура ВыполнитьЗагрузкуДанных(ПараметрыЗагрузки) Экспорт
	
	АдресФайлаЗагрузки = ПараметрыЗагрузки.АдресФайлаЗагрузки;
	СоответствияОбъектов = ПараметрыЗагрузки.СоответствияОбъектов;
	ОбъектыДляЗагрузки = ПараметрыЗагрузки.ОбъектыДляЗагрузки;
	ЗагружатьИсполнителей = ПараметрыЗагрузки.ЗагружатьИсполнителей;
	ЗагружатьНастройкиИспользования = ПараметрыЗагрузки.ЗагружатьНастройкиИспользования;
	ЗагружатьНастройкиСвойствЭлементов = ПараметрыЗагрузки.ЗагружатьНастройкиСвойствЭлементов; 

	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаЗагрузки);
	ДанныеФайла.Записать(ИмяВременногоФайла);
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ИмяВременногоФайла);
	ТекстФайла = ТекстовыйДокумент.ПолучитьТекст();
	ТекстовыйДокумент = Неопределено;
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// обработка исключения не требуется
	КонецПопытки;
	
	НачатьТранзакцию();
	Попытка
		
		Если ЗагружатьИсполнителей Тогда
			ЗагрузитьРолиИсполнителей(ТекстФайла, СоответствияОбъектов, ОбъектыДляЗагрузки.РолиДляЗагрузки);
		КонецЕсли;
		
		ЗагрузитьСтатусыДокументов(ТекстФайла, СоответствияОбъектов, ОбъектыДляЗагрузки.СтатусыДляЗагрузки);
		
		ЗагрузитьЭтапыПроцессов(ТекстФайла, СоответствияОбъектов, ОбъектыДляЗагрузки.ЭтапыДляЗагрузки);
		
		ЗагрузитьШаблоныПроцессов(ТекстФайла, СоответствияОбъектов, ОбъектыДляЗагрузки.ШаблоныДляЗагрузки, 
			ЗагружатьИсполнителей, ЗагружатьНастройкиСвойствЭлементов);
		
		ЗагрузитьРегламентныеИнтервалы(ТекстФайла, СоответствияОбъектов, ОбъектыДляЗагрузки.ИнтервалыДляЗагрузки);
		
		Если ЗагружатьНастройкиИспользования Тогда
			ЗагрузитьНастройкиИспользования(ТекстФайла, СоответствияОбъектов, ОбъектыДляЗагрузки.ШаблоныДляЗагрузки);
		КонецЕсли;
		
		ПроцессыОбработкиДокументовПереопределяемый.ПриЗагрузкеШаблоновПроцессов(ТекстФайла, СоответствияОбъектов, ОбъектыДляЗагрузки);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение импорта шаблонов процессов'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
								УровеньЖурналаРегистрации.Ошибка,,,
								ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки
	
КонецПроцедуры

Процедура ПолучитьДанныеСвязанныхШаблонов(Шаблон, СписокШаблонов) Экспорт
	
	Для Каждого Влияние Из Шаблон.ВлияниеНаДругиеПроцессы Цикл
		Если СписокШаблонов.Найти(Влияние.ЗависимыйШаблон) = Неопределено Тогда
			СписокШаблонов.Добавить(Влияние.ЗависимыйШаблон);
			ПолучитьДанныеСвязанныхШаблонов(Влияние.ЗависимыйШаблон, СписокШаблонов);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ВлияниеНаДругиеПроцессы КАК ШаблоныПроцессовВлияниеНаДругиеПроцессы
	|ГДЕ
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.ЗависимыйШаблон = &Шаблон
	|	И НЕ ШаблоныПроцессовВлияниеНаДругиеПроцессы.Ссылка В (&СписокШаблонов)";
	Запрос.УстановитьПараметр("Шаблон",Шаблон);
	Запрос.УстановитьПараметр("СписокШаблонов",СписокШаблонов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если СписокШаблонов.Найти(Выборка.Ссылка) = Неопределено Тогда
			СписокШаблонов.Добавить(Выборка.Ссылка);
			ПолучитьДанныеСвязанныхШаблонов(Выборка.Ссылка, СписокШаблонов);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьИдентификаторПоддержкиШаблоновПередВыгрузкой(СписокШаблонов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШаблоныПроцессов КАК ШаблоныПроцессов
	|ГДЕ
	|	ШаблоныПроцессов.Ссылка В(&СписокШаблонов)
	|	И ШаблоныПроцессов.ИдентификаторПоддержки = &ПустойИД";
	
	Запрос.УстановитьПараметр("СписокШаблонов", СписокШаблонов);
	Запрос.УстановитьПараметр("ПустойИД", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененыИдентификаторыПоддержки = Истина;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.ШаблоныПроцессов");
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ШаблонОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			ШаблонОбъект.Заблокировать();
			
			ШаблонОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор;
			
			ШаблонОбъект.Записать();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Установка идентификатора поддержки для шаблонов процессов'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
								УровеньЖурналаРегистрации.Ошибка,,,
								ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьИдентификаторПоддержкиЭтаповПередВыгрузкой(СписокЭтапов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
