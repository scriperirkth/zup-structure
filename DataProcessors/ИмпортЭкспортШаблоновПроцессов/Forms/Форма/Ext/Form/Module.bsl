//#Область ОписаниеПеременных

//&НаСервере
//Перем ОбъектыИспользуемыеВШаблонах;
//Перем ШаблоныСтатусов;
//Перем ШаблоныЭтапов;
//Перем ШаблоныРегламентныхИнтервалов;
//Перем ШаблоныРолейИсполнителей;

//#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьРегламентныеИнтервалы = ПолучитьФункциональнуюОпцию("ИспользоватьРегламентныеИнтервалы");
	
	ЗаполнитьТаблицуВыгружаемыхШаблонов();
	
	УстановитьРежимРаботыВыгрузка(ЭтотОбъект);
	
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОкончаниеУстановкиРасширенияДляРаботыСФайлами", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения,
		НСтр("ru = 'Рекомендуется установить расширение для работы с файлами (не обязательное действие).'"), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеУстановкиРасширенияДляРаботыСФайлами(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	РасширениеДляРаботыСФайламиПодключено = РасширениеПодключено;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИмяФайлаВыгрузки",
		"Видимость", РасширениеПодключено);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыгрузкаБезРасширения",
		"Видимость", НЕ РасширениеПодключено);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяФайлаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.Фильтр = НСтр("ru='Файлы XML'")+"(*.xml)|*.xml";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru = 'Выберите файл для выгрузки'");
	ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("ФайлВыгрузкиОкончаниеВыбораФайла", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ РасширениеДляРаботыСФайламиПодключено Тогда
		НачатьПомещениеФайла(Новый ОписаниеОповещения("ФайлЗагрузкиОкончаниеПомещения", ЭтотОбъект),
			АдресФайлаЗагрузки, , Истина, УникальныйИдентификатор);
	Иначе
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогОткрытияФайла.Фильтр = НСтр("ru='Файлы XML'")+"(*.xml)|*.xml";
		ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
		ДиалогОткрытияФайла.Заголовок = НСтр("ru = 'Выберите файл для загрузки'");
		ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("ФайлЗагрузкиОкончаниеВыбораФайла", ЭтотОбъект));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаЗагрузкиПриИзменении(Элемент)
	Если ПустаяСтрока(ИмяФайлаЗагрузки) Тогда
		АдресФайлаЗагрузки = "";
		ДатаВыгрузкиФайла = "";
		ОчиститьТаблицыЗагружаемыхДанных();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтраницыФормыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	УстановитьРежимРаботыВыгрузка(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ЗагружатьРолиПриИзменении(Элемент)
	УстановитьВидимостьРеквизитов(ЭтотОбъект)
КонецПроцедуры

&НаКлиенте
Процедура СкрыватьНеИспользуемыеПриИзменении(Элемент)
	
	ЗаполнитьТаблицуВыгружаемыхШаблонов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ВыгружаемыеШаблоны

&НаКлиенте
Процедура ВыгружаемыеШаблоныПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ВыгружаемыеШаблоны.ТекущиеДанные;
	
	УправлениеФлагамиДерева(ВыгружаемыеШаблоны, ТекущиеДанные);
	
	Если ТекущиеДанные.Пометка = 1 Тогда
		// При отметке шаблона необходимо также отметить связанные с ним шаблоны
		СписокШаблонов = Новый Массив;
		Родитель = ТекущиеДанные.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			Для Каждого Элемент Из ТекущиеДанные.ПолучитьЭлементы() Цикл
				СписокШаблонов.Добавить(Элемент.Шаблон);
			КонецЦикла;
		Иначе
			СписокШаблонов.Добавить(ТекущиеДанные.Шаблон);
		КонецЕсли;
		
		ИсходноеКоличествоШаблонов = СписокШаблонов.Количество();
		ЗаполнитьСписокЗависимыхШаблонов(СписокШаблонов);
		
		Для Каждого ТекСтрока Из ВыгружаемыеШаблоны.ПолучитьЭлементы() Цикл
			Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
				Если СписокШаблонов.Найти(ТекПодстрока.Шаблон) <> Неопределено Тогда
					ТекПодстрока.Пометка = 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		УправлениеФлагамиДерева(ВыгружаемыеШаблоны);
		
		Если СписокШаблонов.Количество() > ИсходноеКоличествоШаблонов Тогда
			ТекстСообщения = НСтр("ru = 'Для выгрузки были отмечены связанные шаблоны'");
			ПоказатьОповещениеПользователя(,,ТекстСообщения,БиблиотекаКартинок.Информация32);
		КонецЕсли;
		
	Иначе
		// Если шаблон связан с другими, то пометку необходимо также снять у связанных шаблонов
		СписокШаблонов = Новый Массив;
		Родитель = ТекущиеДанные.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			Для Каждого Элемент Из ТекущиеДанные.ПолучитьЭлементы() Цикл
				СписокШаблонов.Добавить(Элемент.Шаблон);
			КонецЦикла;
		Иначе
			СписокШаблонов.Добавить(ТекущиеДанные.Шаблон);
		КонецЕсли;
		КоличествоШаблонов = СписокШаблонов.Количество();
		ЗаполнитьСписокЗависимыхШаблонов(СписокШаблонов);
		Если СписокШаблонов.Количество() > КоличествоШаблонов Тогда
			ТекстВопроса = НСтр("ru = 'У связанных шаблонов отметки также будут сняты. Продолжить?'");
			Обработчик = Новый ОписаниеОповещения("ПослеВопросаОСнятииПометокСвязанныхШаблонов", ЭтотОбъект, СписокШаблонов);
			ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОСнятииПометокСвязанныхШаблонов(Ответ, ПараметрыВыполнения) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Элементы.ВыгружаемыеШаблоны.ТекущиеДанные.Пометка = 1;
		УправлениеФлагамиДерева(ВыгружаемыеШаблоны, Элементы.ВыгружаемыеШаблоны.ТекущиеДанные);
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ВыгружаемыеШаблоны.ПолучитьЭлементы() Цикл
		Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			Если ПараметрыВыполнения.Найти(ТекПодстрока.Шаблон) <> Неопределено Тогда
				ТекПодстрока.Пометка = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	УправлениеФлагамиДерева(ВыгружаемыеШаблоны);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ЗагружаемыеШаблоны

&НаКлиенте
Процедура ЗагружаемыеШаблоныПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗагружаемыеШаблоны.ТекущиеДанные;
	
	УправлениеФлагамиДерева(ЗагружаемыеШаблоны, ТекущиеДанные);
	
	УстановитьПометкиЗависимыхЗагружаемыхОбъектов(ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	УстановитьПометки(ВыгружаемыеШаблоны, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсе(Команда)
	
	УстановитьПометки(ВыгружаемыеШаблоны, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеЗагрузка(Команда)
	
	УстановитьПометки(ЗагружаемыеШаблоны, Истина);
	
	УстановитьПометкиВсехЗагружаемыхОбъектов(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсеЗагрузка(Команда)
	
	УстановитьПометки(ЗагружаемыеШаблоны, Ложь);
	
	УстановитьПометкиВсехЗагружаемыхОбъектов(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьШаблоны(Команда)
	
	СписокШаблонов = Новый Массив;
	Для Каждого ТекДокумент Из ВыгружаемыеШаблоны.ПолучитьЭлементы() Цикл
		Для Каждого ТекОперация Из ТекДокумент.ПолучитьЭлементы() Цикл
			Если ТекОперация.Пометка = 1 Тогда
				СписокШаблонов.Добавить(ТекОперация.Шаблон);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если СписокШаблонов.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Выберите хотя бы один шаблон для выгрузки'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	АдресРезультата = ВыгрузитьШаблоныНаСервере(СписокШаблонов);
	
	СохранятьИнтерактивно = НЕ РасширениеДляРаботыСФайламиПодключено
		ИЛИ НЕ ЗначениеЗаполнено(ИмяФайлаВыгрузки);
	МассивФайлов = Новый Массив;
	МассивФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяФайлаВыгрузки, АдресРезультата));
	Если СохранятьИнтерактивно Тогда
		ПолучитьФайл(АдресРезультата, ИмяФайлаВыгрузки, Истина);
	Иначе
		НачатьПолучениеФайлов(Новый ОписаниеОповещения("ПослеСохраненияФайловВыгрузки", ЭтотОбъект, ИмяФайлаВыгрузки),
			МассивФайлов, ИмяФайлаВыгрузки, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьШаблоны(Команда)
	
	Если ПустаяСтрока(АдресФайлаЗагрузки) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран файл для загрузки'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ИмяФайлаЗагрузки");
		Возврат;
	КонецЕсли;
	
	ОбъектыДляЗагрузки = Новый Структура;
	ЗагрузитьШаблоныНаСервере(ОбъектыДляЗагрузки);
	
	ТекстСообщения = НСтр("ru = 'Шаблоны успешно загружены'");
	ПоказатьОповещениеПользователя(,,ТекстСообщения,БиблиотекаКартинок.Успешно32);
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.ШаблоныПроцессов"));
	ОповеститьОбИзменении(Тип("СправочникСсылка.ЭтапыПроцессов"));
	ОповеститьОбИзменении(Тип("СправочникСсылка.СтатусыДокументов"));
	Оповестить("ЗаписьНастройкиИспользованияШаблона");
	
	// Обновление таблиц с учетом только что загруженных данных
	
	ДатаВыгрузкиФайла = "";
	
	ОчиститьТаблицыЗагружаемыхДанных();
	
	ОбновитьЗагружаемыеШаблоныСервер();
	
	РазвернутьДеревоШаблонов();
	
	ЗаполнитьПометкиЗагружаемыхДанных(ОбъектыДляЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПометкиЗагружаемыхДанных(ОбъектыДляЗагрузки)
	
	Для Каждого СтрокаДокумент Из ЗагружаемыеШаблоны.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаШаблон Из СтрокаДокумент.ПолучитьЭлементы() Цикл
			Если ОбъектыДляЗагрузки.ШаблоныДляЗагрузки[СтрокаШаблон.ИдентификаторПоддержки] = Неопределено Тогда
				СтрокаШаблон.Пометка = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрокаЭтап Из ЗагружаемыеЭтапы Цикл
		Если ОбъектыДляЗагрузки.ЭтапыДляЗагрузки[СтрокаЭтап.ИдентификаторПоддержки] = Неопределено Тогда
			СтрокаЭтап.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаСтатус Из ЗагружаемыеСтатусы Цикл
		Если ОбъектыДляЗагрузки.СтатусыДляЗагрузки[СтрокаСтатус.ИдентификаторПоддержки] = Неопределено Тогда
			СтрокаСтатус.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаИнтервал Из ЗагружаемыеИнтервалы Цикл
		Если ОбъектыДляЗагрузки.ИнтервалыДляЗагрузки[СтрокаИнтервал.ИдентификаторПоддержки] = Неопределено Тогда
			СтрокаИнтервал.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаРоль Из ЗагружаемыеРоли Цикл
		Если ОбъектыДляЗагрузки.РолиДляЗагрузки[СтрокаРоль.ИдентификаторПоддержки] = Неопределено Тогда
			СтрокаРоль.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	УправлениеФлагамиДерева(ЗагружаемыеШаблоны);
	
КонецПроцедуры

&НаКлиенте
Процедура Перечитать(Команда)
	ОбновитьЗагружаемыеШаблоны();
КонецПроцедуры

&НаКлиенте
Процедура ПослеСохраненияФайловВыгрузки(МассивФайлов, ДополнительныеПараметры) Экспорт
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Файл выгрузки ""%1"" успешно сформирован'"),
					ДополнительныеПараметры);
	ПоказатьОповещениеПользователя(,,ТекстСообщения,БиблиотекаКартинок.Успешно32);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРежимРаботыВыгрузка(Форма)

	Если Форма.Элементы.СтраницыФормы.ТекущаяСтраница = Форма.Элементы.ВыгрузкаДанных Тогда
		РежимРаботыВыгрузка = Истина;
	Иначе
		РежимРаботыВыгрузка = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ВыгрузитьШаблоны",
		"Видимость", РежимРаботыВыгрузка);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЗагрузитьШаблоны",
		"Видимость", НЕ РежимРаботыВыгрузка);

КонецПроцедуры // УстановитьРежимРаботыВыгрузка()

&НаСервере
Функция ВыгрузитьШаблоныНаСервере(СписокШаблонов)
	
	Обработка = Обработки.ИмпортЭкспортШаблоновПроцессов.Создать();
	
	Возврат Обработка.ВыполнитьВыгрузкуДанных(СписокШаблонов);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьШаблоныНаСервере(ОбъектыДляЗагрузки)
	
	СоответствиеШаблонов = Новый Соответствие;
	ШаблоныДляЗагрузки = Новый Соответствие;
	Для Каждого СтрокаДокумент Из ЗагружаемыеШаблоны.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаШаблон Из СтрокаДокумент.ПолучитьЭлементы() Цикл
			СоответствиеШаблонов.Вставить(СтрокаШаблон.ИдентификаторПоддержки, СтрокаШаблон.ШаблонВБазе);
			Если СтрокаШаблон.Пометка Тогда
				ШаблоныДляЗагрузки.Вставить(СтрокаШаблон.ИдентификаторПоддержки, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	СоответствиеЭтапов = Новый Соответствие;
	ЭтапыДляЗагрузки = Новый Соответствие;
	Для Каждого СтрокаЭтап Из ЗагружаемыеЭтапы Цикл
		СоответствиеЭтапов.Вставить(СтрокаЭтап.ИдентификаторПоддержки, СтрокаЭтап.ЭтапВБазе);
		Если СтрокаЭтап.Пометка Тогда
			ЭтапыДляЗагрузки.Вставить(СтрокаЭтап.ИдентификаторПоддержки, Истина);
		КонецЕсли;
	КонецЦикла;
	
	СоответствиеСтатусов = Новый Соответствие;
	СтатусыДляЗагрузки = Новый Соответствие;
	Для Каждого СтрокаСтатус Из ЗагружаемыеСтатусы Цикл
		СоответствиеСтатусов.Вставить(СтрокаСтатус.ИдентификаторПоддержки, СтрокаСтатус.СтатусВБазе);
		Если СтрокаСтатус.Пометка Тогда
			СтатусыДляЗагрузки.Вставить(СтрокаСтатус.ИдентификаторПоддержки, Истина);
		КонецЕсли;
	КонецЦикла;
	
	СоответствиеИнтервалов = Новый Соответствие;
	ИнтервалыДляЗагрузки = Новый Соответствие;
	Для Каждого СтрокаИнтервал Из ЗагружаемыеИнтервалы Цикл
		СоответствиеИнтервалов.Вставить(СтрокаИнтервал.ИдентификаторПоддержки, СтрокаИнтервал.ИнтервалВБазе);
		Если СтрокаИнтервал.Пометка Тогда
			ИнтервалыДляЗагрузки.Вставить(СтрокаИнтервал.ИдентификаторПоддержки, Истина);
		КонецЕсли;
	КонецЦикла;
	
	СоответствиеРолей = Новый Соответствие;
	РолиДляЗагрузки = Новый Соответствие;
	Для Каждого СтрокаРоль Из ЗагружаемыеРоли Цикл
		СоответствиеРолей.Вставить(СтрокаРоль.ИдентификаторПоддержки, СтрокаРоль.РольВБазе);
		Если СтрокаРоль.Пометка Тогда
			РолиДляЗагрузки.Вставить(СтрокаРоль.ИдентификаторПоддержки, Истина);
		КонецЕсли;
	КонецЦикла;
	
	СоответствияОбъектов = Новый Структура;
	СоответствияОбъектов.Вставить("СоответствиеШаблонов", СоответствиеШаблонов);
	СоответствияОбъектов.Вставить("СоответствиеЭтапов", СоответствиеЭтапов);
	СоответствияОбъектов.Вставить("СоответствиеСтатусов", СоответствиеСтатусов);
	СоответствияОбъектов.Вставить("СоответствиеИнтервалов", СоответствиеИнтервалов);
	СоответствияОбъектов.Вставить("СоответствиеРолей", СоответствиеРолей);
	
	ОбъектыДляЗагрузки = Новый Структура;
	ОбъектыДляЗагрузки.Вставить("ШаблоныДляЗагрузки", ШаблоныДляЗагрузки);
	ОбъектыДляЗагрузки.Вставить("ЭтапыДляЗагрузки", ЭтапыДляЗагрузки);
	ОбъектыДляЗагрузки.Вставить("СтатусыДляЗагрузки", СтатусыДляЗагрузки);
	ОбъектыДляЗагрузки.Вставить("ИнтервалыДляЗагрузки", ИнтервалыДляЗагрузки);
	ОбъектыДляЗагрузки.Вставить("РолиДляЗагрузки", РолиДляЗагрузки);
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("АдресФайлаЗагрузки", АдресФайлаЗагрузки);
	ПараметрыЗагрузки.Вставить("СоответствияОбъектов", СоответствияОбъектов);
	ПараметрыЗагрузки.Вставить("ОбъектыДляЗагрузки", ОбъектыДляЗагрузки);
	ПараметрыЗагрузки.Вставить("ЗагружатьИсполнителей", ЗагружатьИсполнителей);
	ПараметрыЗагрузки.Вставить("ЗагружатьНастройкиИспользования", ЗагружатьНастройкиИспользования);
	ПараметрыЗагрузки.Вставить("ЗагружатьНастройкиСвойствЭлементов", ЗагружатьНастройкиСвойствЭлементов);

	Обработка = Обработки.ИмпортЭкспортШаблоновПроцессов.Создать();
	Обработка.ВыполнитьЗагрузкуДанных(ПараметрыЗагрузки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуВыгружаемыхШаблонов()
	
	ВыгружаемыеШаблоны.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессов.Ссылка КАК Шаблон,
	|	ШаблоныПроцессов.Описание КАК Описание,
	|	ШаблоныПроцессов.ИдентификаторДокумента.Синоним КАК Документ,
	|	ШаблоныПроцессов.НеИспользуется КАК НеИспользуется,
	|	ВЫБОР
	|		КОГДА ШаблоныПроцессов.ПометкаУдаления
	|			ТОГДА 4
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК ИндексКартинки
	|ИЗ
	|	Справочник.ШаблоныПроцессов КАК ШаблоныПроцессов
	|ГДЕ
	|	ШаблоныПроцессов.НеИспользуется В(&ЗначенияНеИспользуется)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ
	|ИТОГИ
	|	СРЕДНЕЕ(-1) КАК ИндексКартинки
	|ПО
	|	Документ";
	
	ЗначенияНеИспользуется = Новый Массив;
	Если СкрыватьНеИспользуемые Тогда
		ЗначенияНеИспользуется.Добавить(Ложь);
	Иначе	
		ЗначенияНеИспользуется.Добавить(Истина);
		ЗначенияНеИспользуется.Добавить(Ложь);
	КонецЕсли;
	
	Запрос.Параметры.Вставить("ЗначенияНеИспользуется", ЗначенияНеИспользуется);
	
	Выборка = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ОбщегоНазначения.ЗаполнитьКоллекциюЭлементовДереваДанныхФормы(ВыгружаемыеШаблоны.ПолучитьЭлементы(), Выборка);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлВыгрузкиОкончаниеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаВыгрузки = ВыбранныеФайлы[0];
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлЗагрузкиОкончаниеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаЗагрузки = ВыбранныеФайлы[0];
	АдресФайлаЗагрузки = "";
	
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ФайлЗагрузкиОкончаниеПомещения", ЭтотОбъект),
		АдресФайлаЗагрузки, ИмяФайлаЗагрузки, Ложь, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФлагамиДерева(Дерево, ТекущиеДанные = Неопределено)
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Для Каждого ТекСтрока Из Дерево.ПолучитьЭлементы() Цикл
			ЗначениеФлагаГруппы = Неопределено;
			Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
				Если ЗначениеФлагаГруппы = Неопределено Тогда
					ЗначениеФлагаГруппы = ТекПодстрока.Пометка;
				ИначеЕсли ЗначениеФлагаГруппы <> ТекПодстрока.Пометка Тогда
					ЗначениеФлагаГруппы = 2;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			ТекСтрока.Пометка = ЗначениеФлагаГруппы;
		КонецЦикла;
		
	Иначе
		
		Если ТекущиеДанные.Пометка = 2 Тогда
			ТекущиеДанные.Пометка = 0;
		КонецЕсли;
		
		ЗначениеФлага = ТекущиеДанные.Пометка;
		Родитель = ТекущиеДанные.ПолучитьРодителя();
		// Если флаг изменен у группы, то надо аналогично изменить флаг у подчиненных элементов.
		Если Родитель = Неопределено Тогда
			Для Каждого Элемент Из ТекущиеДанные.ПолучитьЭлементы() Цикл
				Элемент.Пометка = ЗначениеФлага;
			КонецЦикла;
		Иначе
			// Если изменен флаг внутри группы, и в этой группе имеются элементы с отличными флагами, то
			// группе надо установить значение флага "Не определено" (2).
			ЗначениеФлагаГруппы = ЗначениеФлага;
			Для Каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
				Если Элемент.Пометка <> ЗначениеФлага Тогда
					ЗначениеФлагаГруппы = 2;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Родитель.Пометка = ЗначениеФлагаГруппы;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(ТекДерево, ТекЗначение)
	
	Для Каждого ТекСтрока Из ТекДерево.ПолучитьЭлементы() Цикл
		ТекСтрока.Пометка = ТекЗначение;
		Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			ТекПодстрока.Пометка = ТекЗначение;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлЗагрузкиОкончаниеПомещения(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайлаЗагрузки = Адрес;
	ИмяФайлаЗагрузки = ВыбранноеИмяФайла;
	
	ПродолжитьЗагрузку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗагрузку()
	
	ДатаВыгрузкиФайла = "";
	
	ОчиститьТаблицыЗагружаемыхДанных();
	
	ОбновитьЗагружаемыеШаблоныСервер();
	
	РазвернутьДеревоШаблонов();
	
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
	
	Если ЗагружаемыеШаблоны.ПолучитьЭлементы().Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Файл не содержит шаблонов для загрузки'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗагружаемыеШаблоны()
	
	Если ПустаяСтрока(ИмяФайлаЗагрузки) ИЛИ НЕ РасширениеДляРаботыСФайламиПодключено Тогда
		НачатьПомещениеФайла(Новый ОписаниеОповещения("ФайлЗагрузкиОкончаниеПомещения", ЭтотОбъект),
			АдресФайлаЗагрузки, , Истина, УникальныйИдентификатор);
	Иначе
		НачатьПомещениеФайла(Новый ОписаниеОповещения("ФайлЗагрузкиОкончаниеПомещения", ЭтотОбъект),
			АдресФайлаЗагрузки, ИмяФайлаЗагрузки, Ложь, УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗагружаемыеШаблоныСервер()
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаЗагрузки);
	ДанныеФайла.Записать(ИмяВременногоФайла);
	
	ФайлШаблонов = Новый ЧтениеXML;
	ФайлШаблонов.ОткрытьФайл(ИмяВременногоФайла);
	ФайлШаблонов.Прочитать();
	
	ЗагрузитьСписокШаблоновИзФайла(ФайлШаблонов);
	
	ФайлШаблонов.Закрыть();
	
	ПоместитьВоВременноеХранилище(ДанныеФайла, АдресФайлаЗагрузки);
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// Обработка не требуется. Файл будет удален платформой автоматически.
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокШаблоновИзФайла(ФайлДанных)
	
	ОбъектыИспользуемыеВШаблонах = Новый Соответствие;
	ШаблоныСтатусов = Новый Соответствие;
	ШаблоныЭтапов = Новый Соответствие;
	ШаблоныРегламентныхИнтервалов = Новый Соответствие;
	ШаблоныРолейИсполнителей = Новый Соответствие;
	
	ТипУзлаНачалоЭлемента = ТипУзлаXML.НачалоЭлемента;
	ТипУзлаКонецЭлемента = ТипУзлаXML.КонецЭлемента;
	
	ТекДокумент = "";
	ПредставлениеДокумента = "";
	Пока ФайлДанных.Прочитать() Цикл
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "ДатаВыгрузки" Тогда
				
				ФайлДанных.Прочитать();
				ДатаВыгрузкиФайла = XMLЗначение(Тип("Дата"), ФайлДанных.Значение);
				
			ИначеЕсли ФайлДанных.Имя = "ШаблонПроцесса" Тогда
				
				НаимДок = ФайлДанных.ПолучитьАтрибут("Документ");
				Если НаимДок <> ТекДокумент Тогда
					ТекДокумент = НаимДок;
					ПредставлениеДокумента = СинонимДокументаПоИмени(ТекДокумент);
					ТекДокументДерева = ЗагружаемыеШаблоны.ПолучитьЭлементы().Добавить();
					ТекДокументДерева.Документ = ПредставлениеДокумента;
					ТекДокументДерева.Пометка = Истина;
				КонецЕсли;
				
				ИдентификаторПоддержкиСтрокой = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
				Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторПоддержкиСтрокой) Тогда
					ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержкиСтрокой);
				Иначе
					ВызватьИсключение НСтр("ru = 'В файле обнаружены шаблоны с незаполненным идентификатором поддержки!'");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ИдентификаторПоддержки) Тогда
					ШаблонВБазе = Справочники.ШаблоныПроцессов.НайтиПоРеквизиту("ИдентификаторПоддержки", ИдентификаторПоддержки);
				Иначе
					ШаблонВБазе = Справочники.ШаблоныПроцессов.ПустаяСсылка();
				КонецЕсли;
				
				Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				
				Если НЕ ЗначениеЗаполнено(Наименование) Тогда
					Наименование = НСтр("ru = '<Наименование не задано>'");
				КонецЕсли;
				
				ТекШаблонДерева = ТекДокументДерева.ПолучитьЭлементы().Добавить();
				ТекШаблонДерева.Документ = ПредставлениеДокумента;
				ТекШаблонДерева.Шаблон = Наименование;
				ТекШаблонДерева.ИдентификаторПоддержки = ИдентификаторПоддержкиСтрокой;
				ТекШаблонДерева.ШаблонВБазе = ШаблонВБазе;
				ТекШаблонДерева.НайденОбъектВБазе = НЕ ШаблонВБазе.Пустая();
				ТекШаблонДерева.Пометка = Истина;
				
				ОбъектыИспользуемыеВШаблоне = НайтиСоздатьСоответствиеДляОбъектовШаблона(
					ОбъектыИспользуемыеВШаблонах, ИдентификаторПоддержкиСтрокой);
				
				Элемент = ФайлДанных.ПолучитьАтрибут("НачальныйСтатус");
				ОбъектыИспользуемыеВШаблоне.СтатусыДокументов.Вставить(Элемент, Истина);
				Если ШаблоныСтатусов[Элемент] = Неопределено Тогда
					ШаблоныСтатусов.Вставить(Элемент, Новый Соответствие);
				КонецЕсли;
				ШаблоныСтатусов[Элемент].Вставить(ИдентификаторПоддержкиСтрокой, Истина);
				
			ИначеЕсли ФайлДанных.Имя = "Этапы" Тогда
				
				Пока ФайлДанных.Прочитать() Цикл
					
					ИмяУзла = ФайлДанных.Имя;
					
					Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента
						И ИмяУзла = "Этапы" Тогда
						Прервать;
					КонецЕсли;
					
					Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента
						И ИмяУзла = "ЭтапСтрока" Тогда
						Продолжить;
					КонецЕсли;
					
					Если ИмяУзла = "Этап" Тогда
						
						Элемент = ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных);
						ОбъектыИспользуемыеВШаблоне.ЭтапыПроцессов.Вставить(Элемент, Истина);
						Если ШаблоныЭтапов[Элемент] = Неопределено Тогда
							ШаблоныЭтапов.Вставить(Элемент, Новый Соответствие);
						КонецЕсли;
						ШаблоныЭтапов[Элемент].Вставить(ИдентификаторПоддержкиСтрокой, Истина);
						
					ИначеЕсли ИмяУзла = "Исполнитель" Тогда
						
