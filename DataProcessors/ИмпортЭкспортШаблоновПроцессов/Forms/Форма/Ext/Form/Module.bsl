				КонецЕсли;
				
				Если ЗначениеЗаполнено(ИдентификаторПоддержки) Тогда
					ИнтервалВБазе = Справочники.РегламентныеИнтервалы.НайтиПоРеквизиту("ИдентификаторПоддержки", ИдентификаторПоддержки);
				Иначе
					ИнтервалВБазе = Справочники.РегламентныеИнтервалы.ПустаяСсылка();
				КонецЕсли;
				
				Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				
				Если НЕ ЗначениеЗаполнено(Наименование) Тогда
					Наименование = НСтр("ru = '<Наименование не задано>'");
				КонецЕсли;
				
				ТекЭлемент = ЗагружаемыеИнтервалы.Добавить();
				ТекЭлемент.Интервал = Наименование;
				ТекЭлемент.ИдентификаторПоддержки = ИдентификаторПоддержкиСтрокой;
				ТекЭлемент.ИнтервалВБазе = ИнтервалВБазе;
				ТекЭлемент.НайденОбъектВБазе = НЕ ИнтервалВБазе.Пустая();
				ТекЭлемент.Пометка = Истина;
				
				Элемент = ФайлДанных.ПолучитьАтрибут("Шаблон");
				ОбъектыИспользуемыеВШаблонах[Элемент].РегламентныеИнтервалы.Вставить(ИдентификаторПоддержкиСтрокой, Истина);
				Если ШаблоныРегламентныхИнтервалов[ИдентификаторПоддержкиСтрокой] = Неопределено Тогда
					ШаблоныРегламентныхИнтервалов.Вставить(ИдентификаторПоддержкиСтрокой, Новый Соответствие);
				КонецЕсли;
				ШаблоныРегламентныхИнтервалов[ИдентификаторПоддержкиСтрокой].Вставить(Элемент, Истина);
				
			ИначеЕсли ФайлДанных.Имя = "РольИсполнителя" Тогда
				
				ИдентификаторПоддержкиСтрокой = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
				Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторПоддержкиСтрокой) Тогда
					ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержкиСтрокой);
				Иначе
					ВызватьИсключение НСтр("ru = 'В файле обнаружены роли исполнителей с незаполненным идентификатором поддержки!'");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ИдентификаторПоддержки) Тогда
					Запрос = Новый Запрос;
					Запрос.Текст =
					"ВЫБРАТЬ
					|	РолиИсполнителей.Ссылка КАК Ссылка
					|ИЗ
					|	РегистрСведений.ИдентификаторыПоддержкиРолейИсполнителей КАК ИдентификаторыПоддержкиРолейИсполнителей
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РолиИсполнителей КАК РолиИсполнителей
					|		ПО ИдентификаторыПоддержкиРолейИсполнителей.РольИсполнителя = РолиИсполнителей.Ссылка
					|ГДЕ
					|	ИдентификаторыПоддержкиРолейИсполнителей.ИдентификаторПоддержки = &ИдентификаторПоддержки";
					Запрос.УстановитьПараметр("ИдентификаторПоддержки", ИдентификаторПоддержки);
					Выборка = Запрос.Выполнить().Выбрать();
					Если Выборка.Следующий() Тогда
						РольВБазе = Выборка.Ссылка;
					Иначе
						РольВБазе = Справочники.РолиИсполнителей.ПустаяСсылка();
					КонецЕсли;
				Иначе
					РольВБазе = Справочники.РолиИсполнителей.ПустаяСсылка();
				КонецЕсли;
				
				Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				
				Если НЕ ЗначениеЗаполнено(Наименование) Тогда
					Наименование = НСтр("ru = '<Наименование не задано>'");
				КонецЕсли;
				
				ТекЭлемент = ЗагружаемыеРоли.Добавить();
				ТекЭлемент.Роль = Наименование;
				ТекЭлемент.ИдентификаторПоддержки = ИдентификаторПоддержкиСтрокой;
				ТекЭлемент.РольВБазе = РольВБазе;
				ТекЭлемент.НайденОбъектВБазе = НЕ РольВБазе.Пустая();
				ТекЭлемент.Пометка = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбъектыИспользуемыеВШаблонахФикс = Новый ФиксированноеСоответствие(ОбъектыИспользуемыеВШаблонах);
	ШаблоныСтатусовФикс = Новый ФиксированноеСоответствие(ШаблоныСтатусов);
	ШаблоныЭтаповФикс = Новый ФиксированноеСоответствие(ШаблоныЭтапов);
	ШаблоныРегламентныхИнтерваловФикс = Новый ФиксированноеСоответствие(ШаблоныРегламентныхИнтервалов);
	ШаблоныРолейИсполнителейФикс = Новый ФиксированноеСоответствие(ШаблоныРолейИсполнителей);
	
КонецПроцедуры

&НаСервере
Функция НайтиСоздатьСоответствиеДляОбъектовШаблона(ОбъектыИспользуемыеВШаблонах, ИдентификаторПоддержкиСтрокой)
	
	Если ОбъектыИспользуемыеВШаблонах[ИдентификаторПоддержкиСтрокой] = Неопределено Тогда
		ОбъектыИспользуемыеВШаблоне = Новый Структура;
		ОбъектыИспользуемыеВШаблоне.Вставить("ШаблоныПроцессов", Новый Соответствие);
		ОбъектыИспользуемыеВШаблоне.Вставить("СтатусыДокументов", Новый Соответствие);
		ОбъектыИспользуемыеВШаблоне.Вставить("ЭтапыПроцессов", Новый Соответствие);
		ОбъектыИспользуемыеВШаблоне.Вставить("РегламентныеИнтервалы", Новый Соответствие);
		ОбъектыИспользуемыеВШаблоне.Вставить("РолиИсполнителей", Новый Соответствие);
		ОбъектыИспользуемыеВШаблонах.Вставить(ИдентификаторПоддержкиСтрокой, ОбъектыИспользуемыеВШаблоне);
	КонецЕсли;
	
	Возврат ОбъектыИспользуемыеВШаблонах[ИдентификаторПоддержкиСтрокой];
	
КонецФункции

&НаСервере
Функция ПрочитатьТекстовоеЗначениеИзФайла(ФайлДанных)

	ТекстовоеЗначение = "";
	Если ФайлДанных.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		ФайлДанных.Прочитать();
	КонецЕсли;
	Если ФайлДанных.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		Возврат "";
	КонецЕсли;
	ТекстовоеЗначение = ФайлДанных.Значение;
	ФайлДанных.Прочитать();
	
	Возврат ТекстовоеЗначение;

КонецФункции

&НаСервереБезКонтекста
Функция СинонимДокументаПоИмени(ИмяДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИдентификаторыОбъектовМетаданных.Синоним
	|ИЗ
	|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	|ГДЕ
	|	ИдентификаторыОбъектовМетаданных.ПолноеИмя ПОДОБНО &ПолноеИмя";
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ." + ИмяДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Синоним;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции // СинонимДокументаПоИмени()

&НаСервере
Процедура ЗаполнитьСписокЗависимыхШаблонов(СписокШаблонов)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Для Каждого Шаблон Из СписокШаблонов Цикл
		ОбработкаОбъект.ПолучитьДанныеСвязанныхШаблонов(Шаблон,СписокШаблонов);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицыЗагружаемыхДанных()
	
	ЗагружаемыеШаблоны.ПолучитьЭлементы().Очистить();
	ЗагружаемыеЭтапы.Очистить();
	ЗагружаемыеСтатусы.Очистить();
	ЗагружаемыеИнтервалы.Очистить();
	ЗагружаемыеРоли.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоШаблонов()
	
	Для Каждого ТекСтрокаДокумент Из ЗагружаемыеШаблоны.ПолучитьЭлементы() Цикл
		Элементы.ЗагружаемыеШаблоны.Развернуть(ТекСтрокаДокумент.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитов(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЗагружаемыеРоли", "Видимость",
		Форма.ЗагружатьИсполнителей);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЗагружаемыеИнтервалы", "Видимость",
		Форма.ИспользоватьРегламентныеИнтервалы ИЛИ Форма.ЗагружаемыеИнтервалы.Количество() > 0);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиВсехЗагружаемыхОбъектов(ЗначениеФлага)
	
	ШаблоныСтатусов = Новый Соответствие(ШаблоныСтатусовФикс);
	ШаблоныЭтапов = Новый Соответствие(ШаблоныЭтаповФикс);
	ШаблоныРегламентныхИнтервалов = Новый Соответствие(ШаблоныРегламентныхИнтерваловФикс);
	ШаблоныРолейИсполнителей = Новый Соответствие(ШаблоныРолейИсполнителейФикс);
	
	Если ЗначениеФлага Тогда
		Для Каждого ОбъектыИспользуемыеВШаблоне Из ОбъектыИспользуемыеВШаблонахФикс Цикл
			Шаблон = ОбъектыИспользуемыеВШаблоне.Ключ;
			Для Каждого Элемент Из ОбъектыИспользуемыеВШаблоне.Значение.СтатусыДокументов Цикл
				ШаблоныСтатусов[Элемент.Ключ].Вставить(Шаблон, Истина);
			КонецЦикла;
			Для Каждого Элемент Из ОбъектыИспользуемыеВШаблоне.Значение.ЭтапыПроцессов Цикл
				ШаблоныЭтапов[Элемент.Ключ].Вставить(Шаблон, Истина);
			КонецЦикла;
			Для Каждого Элемент Из ОбъектыИспользуемыеВШаблоне.Значение.РегламентныеИнтервалы Цикл
				ШаблоныРегламентныхИнтервалов[Элемент.Ключ].Вставить(Шаблон, Истина);
			КонецЦикла;
			Для Каждого Элемент Из ОбъектыИспользуемыеВШаблоне.Значение.РолиИсполнителей Цикл
				ШаблоныРолейИсполнителей[Элемент.Ключ].Вставить(Шаблон, Истина);
			КонецЦикла;
		КонецЦикла;
	Иначе
		Для Каждого СтрокаТаблицы Из ЗагружаемыеСтатусы Цикл
			ШаблоныСтатусов[СтрокаТаблицы.ИдентификаторПоддержки].Очистить();
		КонецЦикла;
		Для Каждого СтрокаТаблицы Из ЗагружаемыеЭтапы Цикл
			ШаблоныЭтапов[СтрокаТаблицы.ИдентификаторПоддержки].Очистить();
		КонецЦикла;
		Для Каждого СтрокаТаблицы Из ЗагружаемыеИнтервалы Цикл
			ШаблоныРегламентныхИнтервалов[СтрокаТаблицы.ИдентификаторПоддержки].Очистить();
		КонецЦикла;
		Для Каждого СтрокаТаблицы Из ЗагружаемыеРоли Цикл
			ШаблоныРолейИсполнителей[СтрокаТаблицы.ИдентификаторПоддержки].Очистить();
		КонецЦикла;
	КонецЕсли;
	
	ШаблоныСтатусовФикс = Новый ФиксированноеСоответствие(ШаблоныСтатусов);
	ШаблоныЭтаповФикс = Новый ФиксированноеСоответствие(ШаблоныЭтапов);
	ШаблоныРегламентныхИнтерваловФикс = Новый ФиксированноеСоответствие(ШаблоныРегламентныхИнтервалов);
	ШаблоныРолейИсполнителейФикс = Новый ФиксированноеСоответствие(ШаблоныРолейИсполнителей);
	
	Для Каждого СтрокаТаблицы Из ЗагружаемыеСтатусы Цикл
		СтрокаТаблицы.Пометка = ЗначениеФлага;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ЗагружаемыеЭтапы Цикл
		СтрокаТаблицы.Пометка = ЗначениеФлага;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ЗагружаемыеИнтервалы Цикл
		СтрокаТаблицы.Пометка = ЗначениеФлага;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ЗагружаемыеРоли Цикл
		СтрокаТаблицы.Пометка = ЗначениеФлага;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиЗависимыхЗагружаемыхОбъектов(ТекущиеДанные)
	
	ЗначениеФлага = ТекущиеДанные.Пометка;
	
	ШаблоныСтатусов = Новый Соответствие(ШаблоныСтатусовФикс);
	ШаблоныЭтапов = Новый Соответствие(ШаблоныЭтаповФикс);
	ШаблоныРегламентныхИнтервалов = Новый Соответствие(ШаблоныРегламентныхИнтерваловФикс);
	ШаблоныРолейИсполнителей = Новый Соответствие(ШаблоныРолейИсполнителейФикс);
	
	ШаблоныСоответствие = Новый Соответствие;
	ШаблоныМассив = Новый Массив;
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Для Каждого Элемент Из ТекущиеДанные.ПолучитьЭлементы() Цикл
			ШаблоныСоответствие.Вставить(Элемент.ИдентификаторПоддержки, Истина);
			ШаблоныМассив.Добавить(Элемент.ИдентификаторПоддержки);
		КонецЦикла;
	Иначе
		ШаблоныСоответствие.Вставить(ТекущиеДанные.ИдентификаторПоддержки, Истина);
		ШаблоныМассив.Добавить(ТекущиеДанные.ИдентификаторПоддержки);
	КонецЕсли;
	
	ДобавитьЗависимыеШаблоны(ШаблоныСоответствие, ШаблоныМассив);
	
	Для Каждого ТекСтрока Из ЗагружаемыеШаблоны.ПолучитьЭлементы() Цикл
		Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			Если ШаблоныСоответствие[ТекПодстрока.ИдентификаторПоддержки] <> Неопределено Тогда
				ТекПодстрока.Пометка = ЗначениеФлага;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	УправлениеФлагамиДерева(ЗагружаемыеШаблоны);
	
	Для Каждого Шаблон Из ШаблоныМассив Цикл
		Для Каждого Элемент Из ОбъектыИспользуемыеВШаблонахФикс[Шаблон].СтатусыДокументов Цикл
			Если ЗначениеФлага Тогда
				ШаблоныСтатусов[Элемент.Ключ].Вставить(Шаблон, Истина);
			Иначе
				ШаблоныСтатусов[Элемент.Ключ].Удалить(Шаблон);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Элемент Из ОбъектыИспользуемыеВШаблонахФикс[Шаблон].ЭтапыПроцессов Цикл
			Если ЗначениеФлага Тогда
				ШаблоныЭтапов[Элемент.Ключ].Вставить(Шаблон, Истина);
			Иначе
				ШаблоныЭтапов[Элемент.Ключ].Удалить(Шаблон);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Элемент Из ОбъектыИспользуемыеВШаблонахФикс[Шаблон].РегламентныеИнтервалы Цикл
			Если ЗначениеФлага Тогда
				ШаблоныРегламентныхИнтервалов[Элемент.Ключ].Вставить(Шаблон, Истина);
			Иначе
				ШаблоныРегламентныхИнтервалов[Элемент.Ключ].Удалить(Шаблон);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Элемент Из ОбъектыИспользуемыеВШаблонахФикс[Шаблон].РолиИсполнителей Цикл
			Если ЗначениеФлага Тогда
				ШаблоныРолейИсполнителей[Элемент.Ключ].Вставить(Шаблон, Истина);
			Иначе
				ШаблоныРолейИсполнителей[Элемент.Ключ].Удалить(Шаблон);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ШаблоныСтатусовФикс = Новый ФиксированноеСоответствие(ШаблоныСтатусов);
	ШаблоныЭтаповФикс = Новый ФиксированноеСоответствие(ШаблоныЭтапов);
	ШаблоныРегламентныхИнтерваловФикс = Новый ФиксированноеСоответствие(ШаблоныРегламентныхИнтервалов);
	ШаблоныРолейИсполнителейФикс = Новый ФиксированноеСоответствие(ШаблоныРолейИсполнителей);
	
	Для Каждого СтрокаТаблицы Из ЗагружаемыеСтатусы Цикл
		СтрокаТаблицы.Пометка = ШаблоныСтатусов[СтрокаТаблицы.ИдентификаторПоддержки].Количество() > 0;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ЗагружаемыеЭтапы Цикл
		СтрокаТаблицы.Пометка = ШаблоныЭтапов[СтрокаТаблицы.ИдентификаторПоддержки].Количество() > 0;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ЗагружаемыеИнтервалы Цикл
		СтрокаТаблицы.Пометка = ШаблоныРегламентныхИнтервалов[СтрокаТаблицы.ИдентификаторПоддержки].Количество() > 0;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ЗагружаемыеРоли Цикл
		СтрокаТаблицы.Пометка = ШаблоныРолейИсполнителей[СтрокаТаблицы.ИдентификаторПоддержки].Количество() > 0;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗависимыеШаблоны(ШаблоныСоответствие, ШаблоныМассив)
	
	Индекс = 0;
	Пока Индекс <= ШаблоныМассив.ВГраница() Цикл
		Шаблон = ШаблоныМассив[Индекс];
		Для Каждого СвязанныйШаблон Из ОбъектыИспользуемыеВШаблонахФикс[Шаблон].ШаблоныПроцессов Цикл
			Если ШаблоныСоответствие[СвязанныйШаблон.Ключ] = Неопределено Тогда
				ШаблоныСоответствие.Вставить(СвязанныйШаблон.Ключ, Истина);
				ШаблоныМассив.Добавить(СвязанныйШаблон.Ключ);
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
