Функция ВыгрузитьНужныхКонтрагентов(КонтрагентыИзМЧД)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатВсе = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.КПП КАК КПП,
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В(&КонтрагентыИзМЧД)";
	
	Запрос.УстановитьПараметр("КонтрагентыИзМЧД", КонтрагентыИзМЧД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		РезультатОдин = Новый Структура;
		РезультатОдин.Вставить("УникальныйИдентификатор", GUID(Выборка.Ссылка));
		РезультатОдин.Вставить("ИНН", Выборка.ИНН);
		РезультатОдин.Вставить("КПП", Выборка.КПП);
		РезультатОдин.Вставить("Наименование", Выборка.Наименование);
		
		РезультатВсе.Добавить(РезультатОдин);
		
	КонецЦикла;
	
	Возврат РезультатВсе;
	
КонецФункции

Функция ВыгрузитьНужныхФизЛиц(ОрганизацииМассив, ФизЛица, ФизЛицаИзМЧД, ЗаписьОшибок)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для каждого ФизЛицо Из ФизЛицаИзМЧД Цикл
		ДобавитьФизЛицо(ФизЛица, ФизЛицо);
	КонецЦикла;
	
	РезультатВсе = Новый Массив;
	
	Для каждого Запись Из ФизЛица Цикл
		
		Попытка
			
			ФизЛицо = Запись.ФизЛицо;
			Организация = Запись.Организация;
			
			РезультатОдин = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДанныеИсполнителя(ФизЛицо, Организация);
			РезультатОдин.Вставить("Организация", GUID(Организация));
			РезультатОдин.Вставить("УникальныйИдентификатор", GUID(ФизЛицо)); 
			
			ИмяПредопределенныхДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РезультатОдин.ВидДокумента, "ИмяПредопределенныхДанных");
			Если ЗначениеЗаполнено(РезультатОдин.ВидДокумента) И ЗначениеЗаполнено(ИмяПредопределенныхДанных) Тогда
				РезультатОдин.Вставить("ВидДокумента", "Справочник.ВидыДокументовФизическихЛиц." + ИмяПредопределенныхДанных);
			Иначе
				РезультатОдин.Удалить("ВидДокумента");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(РезультатОдин.Пол) Тогда
				РезультатОдин.Вставить("Пол", "Перечисление.ПолФизическогоЛица." + РезультатОдин.Пол);
			КонецЕсли;
			
			РезультатОдин.Вставить("ИНН", ОбработкаЗаявленийАбонента.ИННФизЛица(ФизЛицо));
			
			Если ЗначениеЗаполнено(РезультатОдин.МестоРождения) Тогда
				МестоРожденияПредставление = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПредставлениеМестаРождения(РезультатОдин.МестоРождения);
				РезультатОдин.Вставить("МестоРожденияПредставление", МестоРожденияПредставление);
			КонецЕсли;
			
			КонтактнаяИнформация = ВыгрузитьКонтактнуюИнформациюОрганизации(ФизЛицо);
			РезультатОдин.Вставить("КонтактнаяИнформация", КонтактнаяИнформация);
			
			Если ЗначениеЗаполнено(РезультатОдин.Гражданство) Тогда
				РезультатОдин.Гражданство = GUID(РезультатОдин.Гражданство);
			КонецЕсли;
			
			РезультатОдин.Удалить("ТелефонРабочий");
			РезультатОдин.Удалить("ТелефонМобильный");
			РезультатОдин.Удалить("АдресПоПрописке_JSON");
			РезультатОдин.Удалить("АдресМестаПроживания_JSON");
			РезультатОдин.Удалить("Подразделение");
			
			СкорректироватьЗначения(РезультатОдин);
			
			РезультатВсе.Добавить(РезультатОдин);
		
		Исключение
			
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'физ.лица'"), Запись.ФизЛицо));
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат РезультатВсе;
	
КонецФункции

Функция ВыгрузитьОрганизации(ОрганизацииМассив, ФизЛица, ЗаписьОшибок)
	
	ЗапрашиваемыеРеквизиты = РеквизитыОрганизации();
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатВсе = Новый Массив;
	
	Для каждого Организация Из ОрганизацииМассив Цикл
		
		Попытка
		
			ДанныеОрганизации = ДокументооборотСКО.ПолучитьСведенияОбОрганизацииЧерезПопытку(
				Организация,
				,
				ЗапрашиваемыеРеквизиты);
				
			Если РегламентированнаяОтчетностьПереопределяемый.ЭтоЮридическоеЛицо(Организация) Тогда
				ДанныеОрганизации.Вставить("ЮридическоеФизическоеЛицо", "Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо");
			Иначе
				ДанныеОрганизации.Вставить("ЮридическоеФизическоеЛицо", "Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо");
			КонецЕсли;
			
			Если ОбработкаЗаявленийАбонента.ЭтоОбособленноеПодразделение(Организация) Тогда
				ДанныеОрганизации.Вставить("ОбособленноеПодразделение", Истина);
			Иначе
				ДанныеОрганизации.Вставить("ОбособленноеПодразделение", Ложь);
			КонецЕсли;
			
			ДанныеОрганизации.Вставить("УникальныйИдентификатор", GUID(Организация));
			
			Руководитель = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.Руководитель(Организация);
			Если ЗначениеЗаполнено(Руководитель) Тогда 
				ДанныеОрганизации.Вставить("Руководитель", GUID(Руководитель));
				ДобавитьФизЛицо(ФизЛица, Руководитель, Организация);
			КонецЕсли;
			
			ГлБухгалтер = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ГлБухгалтер(Организация);
			Если ЗначениеЗаполнено(ГлБухгалтер) Тогда 
				ДанныеОрганизации.Вставить("ГлБухгалтер", GUID(ГлБухгалтер));
				ДобавитьФизЛицо(ФизЛица, ГлБухгалтер, Организация);
			Конецесли;
			
			Если Метаданные.Справочники.Организации.Реквизиты.Найти("ИндивидуальныйПредприниматель") <> Неопределено Тогда
				ИП = Организация.ИндивидуальныйПредприниматель;
				ДанныеОрганизации.Вставить("ИндивидуальныйПредприниматель", GUID(ИП));
				ДобавитьФизЛицо(ФизЛица, ИП, Организация);
			КонецЕсли;
			
			КонтактнаяИнформация = ВыгрузитьКонтактнуюИнформациюОрганизации(Организация);
			ДанныеОрганизации.Вставить("КонтактнаяИнформация", КонтактнаяИнформация);
			
			Иностранная = ИнтерфейсыВзаимодействияБРО.ЭтоИностраннаяОрганизацияПоИНН(Организация);
			ДанныеОрганизации.Вставить("ЭтоИностраннаяОрганизация", Иностранная);
			
			Регистрация = РегистрацияВНалоговомОргане(Организация, ДанныеОрганизации);
			Если ЗначениеЗаполнено(Регистрация) Тогда
				ДанныеОрганизации.Вставить("РегистрацияВНалоговомОргане", GUID(Регистрация));
			КонецЕсли;
			
			Если ДанныеОрганизации.ПризнакНПЛКрупнейший Тогда
				РегистрацияКрупнейшего = РегистрацияВНалоговомОрганеКрупнейшего(Организация, ДанныеОрганизации);
				Если ЗначениеЗаполнено(РегистрацияКрупнейшего) Тогда
					ДанныеОрганизации.Вставить("КрупнейшийНалогоплательщикРегистрацияВНалоговомОргане", GUID(РегистрацияКрупнейшего));
				КонецЕсли;
			КонецЕсли;
			
			ДанныеОрганизации.Вставить("ГоловнаяОрганизация", GUID(РегламентированнаяОтчетность.ГоловнаяОрганизация(Организация)));
			ДанныеОрганизации.Вставить("КрупнейшийНалогоплательщик", ДокументооборотСКО.ЭтоКрупнейший(Организация));
			
			ДанныеИсполнителей = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДанныеОтветственныхЛиц(Организация, Истина);
			Если ДанныеИсполнителей <> Неопределено И ДанныеИсполнителей.Количество() > 0 Тогда
				ДанныеРук = ДанныеИсполнителей.Получить("Руководитель");
				ДанныеБух = ДанныеИсполнителей.Получить("ГлавныйБухгалтер");
				Если ДанныеРук <> Неопределено Тогда
					ДанныеОрганизации.Вставить("ДолжностьРук", ДанныеРук.Должность);
				КонецЕсли;
				Если ДанныеБух <> Неопределено Тогда
					ДанныеОрганизации.Вставить("ДолжностьБух", ДанныеБух.Должность);
				КонецЕсли;
			КонецЕсли;
			
			ДанныеОрганизации.Вставить("Органы", НаправленияОрганизации(Организация));
			ДанныеОрганизации.Вставить("НастройкиСистемыНалогообложения", НастройкиСистемыНалогообложения(Организация));
			ДанныеОрганизации.Вставить("НастройкиКалендаряОтчетности", НастройкиКалендаряОтчетности(Организация));
			
			СкорректироватьЗначения(ДанныеОрганизации);
			
			РезультатВсе.Добавить(ДанныеОрганизации);

		
		Исключение
			
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'организации'"), Организация));
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат РезультатВсе;
	
КонецФункции

Функция НаправленияОрганизации(Организация)

	Направления = ПоддерживаемыеНаправленияОрганизации(Организация);
	
	Органы = Новый Массив;
	Для каждого Направление Из Направления Цикл
		Если Направление.Доступен И Направление.Подключить Тогда
			Тип = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИмяПеречисления(Направление.Орган);
			Органы.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Органы;

КонецФункции

