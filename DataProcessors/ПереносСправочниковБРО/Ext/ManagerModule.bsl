	Настройки.Вставить("ПрименяетсяАУСН", Ложь);
	Настройки.Вставить("ПлательщикЕНП", Ложь);
	Настройки.Вставить("ПрименяетсяУСН", Ложь);
	Настройки.Вставить("ПрименяетсяУСНДоходы", Ложь);
