#Область Загрузка

Процедура НачатьЗагрузкуДанных(ФайлыВыгрузки, АдресРезультата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПутьФайлаСОшибками = ПутьФайлаЗаписиОшибок(ФайлыВыгрузки);
	
	ЗаписьОшибок = Новый ЗаписьТекста; 
	ЗаписьОшибок.Открыть(ПутьФайлаСОшибками,,,Истина);

	РезультатУнивОбменом = ЗагрузитьУниверсальнымОбменом(ФайлыВыгрузки, ЗаписьОшибок);
	ДлительныеОперации.СообщитьПрогресс(25);
		
	РезультатСправочники = ЗагрузитьСправочники(ФайлыВыгрузки, ЗаписьОшибок);
	ДлительныеОперации.СообщитьПрогресс(50);
	
	РезультатМЧДФНСиУПУП = ЗагрузитьМЧДФНСиУПУП(ФайлыВыгрузки, ЗаписьОшибок);
	ДлительныеОперации.СообщитьПрогресс(75);
	
	РезультатЧерезШину  = РазобратьПротоколПодключенияЧерезШину(ФайлыВыгрузки, ЗаписьОшибок);
	ДлительныеОперации.СообщитьПрогресс(100);
	
	УстановитьИспользоватьНесколькоОрганизаций();
	
	ЗаписьОшибок.Закрыть();
	
	Результат = Новый Структура();
	Результат.Вставить("Всего",      РезультатУнивОбменом.Всего + РезультатСправочники.Всего + РезультатМЧДФНСиУПУП.Всего);
	Результат.Вставить("Загружено",  РезультатУнивОбменом.Загружено + РезультатСправочники.Загружено + РезультатМЧДФНСиУПУП.Загружено);
	Результат.Вставить("ЕстьОшибки", ЕстьОшибки(ПутьФайлаСОшибками));
	Результат.Вставить("Ошибки",     Новый ДвоичныеДанные(ПутьФайлаСОшибками));
	
	СтатусПодключения = Новый Структура("Состояние, ТекстОшибки", "НеЗапрашивалось", "");
	Если РезультатЧерезШину.Всего Тогда
		Если РезультатЧерезШину.Загружено Тогда
			СтатусПодключения.Состояние = "Подключено";
		Иначе
			СтатусПодключения.Состояние = "Ошибка";
			СтатусПодключения.ТекстОшибки = РезультатЧерезШину.ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	Результат.Вставить("ПодключениеЧерезШину", СтатусПодключения);

	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
		
КонецПроцедуры

Функция ПутьФайлаЗаписиОшибок(ФайлыВыгрузки) Экспорт
	
	Путь = ПолучитьИмяВременногоФайла("txt");
	
	Для каждого Файл Из ФайлыВыгрузки Цикл
		Если Файл.Имя = "Ошибки.txt" Тогда
			ДвДанные = Файл.Адрес;
			ДвДанные.Записать(Путь);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Путь;
	
КонецФункции

Функция ЕстьОшибки(Путь)

	Возврат ЗначениеЗаполнено(ОшибкиИзФайла(Путь));

КонецФункции

Функция ОшибкиИзФайла(Путь)

	ЧтениеТекста = Новый ЧтениеТекста(Путь);
	// Пытаемся прочитать первую строку
	Строка = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	Возврат Строка;

КонецФункции

Функция ЗагрузитьСправочники(ФайлыВыгрузки, ЗаписьОшибок) Экспорт
	
	Результат = ШаблонРезультата();
		
	НужныйФайл = Неопределено;
	Для каждого Файл Из ФайлыВыгрузки Цикл
		Если Файл.Имя = "ВыгрузкаСправочников.txt" Тогда
			НужныйФайл = Файл;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НужныйФайл = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Путь = ПолучитьИмяВременногоФайла("txt");
	НужныйФайл.Адрес.Записать(Путь);
	
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	
	Данные = ПрочитатьJSON(Чтение);
	
	Чтение.Закрыть();
	
	Результаты = Новый Массив;
	Результаты.Добавить(СоздатьСтраныМира(Данные, ЗаписьОшибок));
	Результаты.Добавить(СоздатьКонтрагентов(Данные, ЗаписьОшибок));
	Результаты.Добавить(СоздатьФизЛиц(Данные, ЗаписьОшибок));
	Результаты.Добавить(СоздатьОрганизации(Данные, "Организации", ЗаписьОшибок));
	Результаты.Добавить(СоздатьОрганизации(Данные, "ДопОрганизации", ЗаписьОшибок));
	Результаты.Добавить(СоздатьПодразделения(Данные, ЗаписьОшибок));
	Результаты.Добавить(СоздатьСотрудников(Данные, ЗаписьОшибок));
	
	Для каждого Запись Из Результаты Цикл
		Результат.Всего = Результат.Всего + Запись.Всего;
		Результат.Загружено = Результат.Загружено + Запись.Загружено;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьСотрудников(Данные, ЗаписьОшибок)
	
	Результат = ШаблонРезультата();
		
	Если НЕ Данные.Свойство("Сотрудники") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Всего = Данные.Сотрудники.Количество();
	Результат.Загружено = 0;
	
	Для каждого Запись Из Данные.Сотрудники Цикл
		
		Попытка
		
			РезультатПолучения = ПолучитьСоздатьОбъектПоGUID("Справочники", "Сотрудники", Запись.УникальныйИдентификатор);
			Объект = РезультатПолучения.Объект;
			Ссылка = РезультатПолучения.Ссылка;
			
			Объект.ФизическоеЛицо = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "ФизическиеЛица", Запись, "ФизическоеЛицо");
			Объект.ГоловнаяОрганизация = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "Организации", Запись, "ГоловнаяОрганизация");
			Объект.ГоловнойСотрудник = Ссылка;
			
			Объект.ДополнительныеСвойства.Вставить("СсылкаНового", Ссылка);
			
			Объект.Записать();
			
			Результат.Загружено = Результат.Загружено + 1;
			
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'сотрудника '"), Объект.ФизическоеЛицо));
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
		
КонецФункции

Функция СоздатьПодразделения(Данные, ЗаписьОшибок)
	
	Результат = ШаблонРезультата();

	Если НЕ Данные.Свойство("ПодразделенияОрганизаций") Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Всего = Данные.ПодразделенияОрганизаций.Количество();
	Результат.Загружено = 0;
	
	Для каждого Запись Из Данные.ПодразделенияОрганизаций Цикл
		
		Попытка
		
			Владелец = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "Организации", Запись, "Владелец");
			Если НЕ ЗначениеЗаполнено(Владелец) Тогда
				Продолжить;
			КонецЕсли;
			
			Объект = ПолучитьСоздатьОбъектПоGUID("Справочники", "ПодразделенияОрганизаций", Запись.УникальныйИдентификатор).Объект;
			// Наименование, КодПоОКПО
			ЗаполнитьЗначенияСвойств(Объект, Запись);
			Объект.Владелец = Владелец;
			Объект.Записать();
			
			Результат.Загружено = Результат.Загружено + 1;
		
		Исключение
			
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'подразделения '"), Запись.Наименование));
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
		
КонецФункции

Функция СоздатьФизЛиц(Данные, ЗаписьОшибок)
	
	Результат = ШаблонРезультата();

	Если НЕ Данные.Свойство("ФизическиеЛица") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Всего = Данные.ФизическиеЛица.Количество();
	Результат.Загружено = 0;
	
	Для каждого Запись Из Данные.ФизическиеЛица Цикл
		
		Попытка
		
			Объект = ПолучитьСоздатьОбъектПоGUID("Справочники", "ФизическиеЛица", Запись.УникальныйИдентификатор).Объект;
			ЗаполнитьЗначенияСвойств(Объект, Запись);
			
			Объект.Пол = ПолучитьПредопределенное(Запись, "Пол");
			Объект.Фамилия = Запись.ФИО.Фамилия;
			Объект.Имя = Запись.ФИО.Имя;
			Объект.Отчество = Запись.ФИО.Отчество;
			
			ФИО = ФИОпоСтруктуре(Запись.ФИО);
			Объект.ФИО = ФИО;
			Объект.Наименование = ФИО;
			Объект.СтраховойНомерПФР = Запись.СНИЛС;
			Объект.ДатаРождения = ДатаИзJSON(Запись.ДатаРождения);
			Объект.ИНН = Запись.ИНН;
			
			СоздатьКонтактнаяИнформация(Объект, Запись);

			Объект.Записать();
			
			Результат.Загружено = Результат.Загружено + 1;
		
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'физ.лица '"), ФИО));
		КонецПопытки;
		
		СоздатьЗаписьДокументыФизическихЛиц(Запись, Объект.Ссылка, ЗаписьОшибок);
		СоздатьЗаписьФИОФизическихЛиц(Запись, Объект.Ссылка, ЗаписьОшибок);
		НайтиИлиСоздатьДолжность(Запись, "Должность");
		
		ЕстьЗагруженныеДанные = Истина;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьОрганизации(Данные, Свойство, ЗаписьОшибок)
	
	Результат = ШаблонРезультата();

	Если НЕ Данные.Свойство(Свойство) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Всего = Данные[Свойство].Количество();
	Результат.Загружено = 0;
	КэшСтран = СтраныПоКодам(Данные[Свойство]);
	КэшСчетов = БанковскиеСчетаПоЗаписям(Данные[Свойство]);
	КэшБанков = БанкиПоЗаписям(Данные[Свойство]);
	Для каждого Запись Из Данные[Свойство] Цикл

		Попытка

			РезультатПолучения = ПолучитьСоздатьОбъектПоGUID("Справочники", "Организации", Запись.УникальныйИдентификатор);
			Объект = РезультатПолучения.Объект;
			Ссылка = РезультатПолучения.Ссылка;
			
			НоваяОрганизация = Объект.ЭтоНовый();
			
			// КодОрганаПФР, РегистрационныйНомерФСС, ДополнительныйКодФСС, КодПодчиненностиФСС, КодОКОНХ, КодОрганаФСГС
			// НаименованиеРегистрирующегоОргана, НекоммерческаяОрганизация, ОбособленноеПодразделение, КрупнейшийНалогоплательщик
			ЗаполнитьЗначенияСвойств(Объект, Запись);
			
			Объект.НаименованиеСокращенное = Запись.НаимЮЛСокр;
			Объект.НаименованиеПолное = Запись.НаимЮЛПол;
			Объект.Наименование = Запись.НаимЮЛСокр;
			Объект.НаименованиеНалоговогоОргана = Запись.НаимНО;
			Объект.КодНалоговогоОргана = Запись.КодНО;
			Объект.НаименованиеОКВЭД = Запись.ОснВидДеят;
			Объект.НаименованиеОКВЭД2 = Запись.ОснВидДеят2;
			Объект.КодОКВЭД = Запись.ОКВЭД;
			Объект.КодОКВЭД2 = Запись.ОКВЭД2;
			Объект.ОГРН = Запись.ОГРН;
			Объект.РегистрационныйНомерТФОМС = Запись.РегНомТФОМС;
			Объект.ИПРегистрационныйНомерТФОМС = Запись.РегНомТФОМСЗаСебя;
			Объект.ИПРегистрационныйНомерПФР = Запись.ИПРегНомПФР;
			Объект.НаименованиеТерриториальногоОрганаПФР = Запись.НаимОргПФР;
			Объект.ИПРегистрационныйНомерПФР = Запись.РегНомПФРЗаСебя;
			Объект.КодПоОКПО = Запись.ОКПО;
			Объект.НаименованиеОКОПФ = Запись.ОргПравФорм;
			Объект.КодОКОПФ = Запись.ОКОПФ;
			Объект.НаименованиеОКФС = Запись.ФормСобств;
			Объект.КодОКФС = Запись.ОКФС;
			Объект.ИПРегистрационныйНомерФСС = Запись.РегистрационныйНомерФССДобрСтрах;
			Объект.ИПКодПодчиненностиФСС = Запись.КодПодчФССДобрСтрах;
			Объект.НаименованиеТерриториальногоОрганаФСС = Запись.НаименованиеТерриториальногоОрганаФСС;
			Объект.ДатаРегистрации = ДатаИзJSON(Запись.ДатаРегистрации);
			Объект.ДатаЗакрытия = ДатаИзJSON(Запись.ДатаЗакрытия);
			Объект.СвидетельствоСерияНомер = Запись.СвидСН;
			Объект.СвидетельствоДатаВыдачи = ДатаИзJSON(Запись.СвидДВ);
			Объект.СвидетельствоНаименованиеОргана = Запись.СвидНО;
			Объект.СвидетельствоКодОргана = Запись.СвидНОКод;
			Объект.ИНН = ?(ЗначениеЗаполнено(Запись.ИННЮЛ), Запись.ИННЮЛ, Запись.ИННФЛ);
			Объект.КПП = Запись.КППЮЛ;
			Объект.КодОсновногоВидаДеятельностиНФО = Запись.КодОснВидаДеятельностиНФО;
			Объект.КодИныхВидовДеятельностиНФО = Запись.КодыИныхВидовДеятельностиНФО;
			Объект.КодВСтранеРегистрации = Запись.КодИОСтрРег;
			Объект.КрупнейшийНалогоплательщик = Запись.ПризнакНПЛКрупнейший;
			Объект.КрупнейшийНалогоплательщикНаименованиеНалоговогоОргана = Запись.НаимНОКрупнейший;
			Объект.КрупнейшийНалогоплательщикКПП = Запись.КППЮЛКрупнейший;
			Объект.НаименованиеИнострОрганизации = Запись.НаимИОПол;
			Объект.ИностраннаяОрганизация = Запись.ЭтоИностраннаяОрганизация; 
			Объект.ИндивидуальныйПредприниматель = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "ФизическиеЛица", Запись, "ИндивидуальныйПредприниматель");
			Объект.ЮридическоеФизическоеЛицо = ПолучитьПредопределенное(Запись, "ЮридическоеФизическоеЛицо");
			Объект.РегистрацияВНалоговомОргане = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "РегистрацииВНалоговомОргане", Запись, "РегистрацияВНалоговомОргане");
			Объект.КрупнейшийНалогоплательщикРегистрацияВНалоговомОргане = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "РегистрацииВНалоговомОргане", Запись, "КрупнейшийНалогоплательщикРегистрацияВНалоговомОргане");
			Объект.СтранаРегистрации = КэшСтран.Получить(Запись.КодСтрИО);
			Объект.СтранаПостоянногоМестонахождения = КэшСтран.Получить(Запись.КодСтрПостИО);
			Объект.ГоловнаяОрганизация = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "Организации", Запись, "ГоловнаяОрганизация");
			Если Метаданные.Справочники.Организации.Реквизиты.Найти("ОсновнойБанковскийСчет") <> Неопределено Тогда
				Объект.ОсновнойБанковскийСчет = НайтиСоздатьБанковскийСчет(Запись, Ссылка, КэшСчетов, КэшБанков);
			КонецЕсли;

			СоздатьИсторияНаименований(Объект, Запись);
			СоздатьКонтактнаяИнформация(Объект, Запись);

			Объект.Записать();
			
			Результат.Загружено = Результат.Загружено + 1;
		
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'организации ИНН '"), ?(ЗначениеЗаполнено(Запись.ИННЮЛ), Запись.ИННЮЛ, Запись.ИННФЛ)));
			Продолжить;
		КонецПопытки;
		
		СоздатьОтветственныеЛицаОрганизаций(Объект.Ссылка, Запись, ЗаписьОшибок);
		
		СоздатьИсторияРегистрацийВОрганеПФР(
			Объект.Ссылка, 
			?(ЗначениеЗаполнено(Запись.РегНомПФР), Запись.РегНомПФР, Запись.РегНомПФРЗаСебя),
			?(ЗначениеЗаполнено(Запись.РегНомерСФР), Запись.РегНомерСФР, Запись.РегНомерСФРЗаСебя), 
			ЗаписьОшибок);
			
		ЗаписатьНастройкиДляКалендаря(Объект.Ссылка, Запись, НоваяОрганизация, ЗаписьОшибок);
		
		ЗаписатьНаправления(Объект.Ссылка, Запись, ЗаписьОшибок);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьНастройкиДляКалендаря(Организация, Запись, НоваяОрганизация, ЗаписьОшибок)
	
	ЗаписатьСистемуНалогообложения(Организация, Запись, ЗаписьОшибок);
	ЗаписатьНастройкиКалендаряОтчетности(Организация, Запись, ЗаписьОшибок);
	
	Попытка
	
		МодульКалендарьОтчетности = ОбщегоНазначения.ОбщийМодуль("КалендарьОтчетности");
		МодульКалендарьОтчетности.ПодключитьПравилаПоНастройкамУчета(Организация);
		МодульКалендарьОтчетности.СоздатьЗаданиеЗаполненияЗадач(Организация, НоваяОрганизация);
	
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'для календаря отчетности по организации '"), Организация));
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьНаправления(Организация, Запись, ЗаписьОшибок)
	
	Попытка
	
		МодульРегламентированнаяОтчетностьОблачная1СО = ОбщегоНазначения.ОбщийМодуль("РегламентированнаяОтчетностьОблачная1СО");
		Направления = МодульРегламентированнаяОтчетностьОблачная1СО.НовыеНаправленияСдачиОтчетности();
		
		Для каждого Орган Из Запись.Органы Цикл
			
			Если Орган = "ФНС" Тогда
				Направления.ЕстьОбменФНС = Истина;
			КонецЕсли;
			
			Если Орган = "ПФР" ИЛИ Орган = "ФСС" Тогда
				Направления.ЕстьОбменСФР = Истина;
			КонецЕсли;
			
			Если Орган = "ФСРАР" Тогда
				Направления.ЕстьОбменРосстат = Истина;
			КонецЕсли;
			
			Если Орган = "РПН" Тогда
				Направления.ЕстьОбменПриродНадзор = Истина;
			КонецЕсли;
			
			Если Орган = "ФСРАР" Тогда
				Направления.ЕстьОбменРосАлкогольТабакКонтроль = Истина;
			КонецЕсли;
			
			Если Орган = "ФТС" Тогда
				Направления.ЕстьОбменФТС = Истина;
			КонецЕсли;
			
			Если Орган = "ЦБ" Тогда
				Направления.ЕстьОбменБанкРоссии = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Направления.ЕстьОбменМинОбороны = Ложь;
		Направления.ЕстьОбменФАС = Ложь;
		Направления.ЕстьОбменМВД = Ложь;
		Направления.ЕстьОбменМинюст = Ложь;
		Направления.ЕстьОбменРоскомНадзор = Ложь;
		Направления.ЕстьОбменРоструд = Ложь;
		
		МодульРегламентированнаяОтчетностьОблачная1СО.ЗаписатьНаправленияСдачиОтчетностиПоОрганизации(Организация, Направления);
	
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'для направлений сдачи отчетности по организации '"), Организация));
	
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьСистемуНалогообложения(Организация, Запись, ЗаписьОшибок)
	
	Попытка
	
		Настройки = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Запись.НастройкиСистемыНалогообложения);
		Настройки.Вставить("Организация", Организация);
		Настройки.Вставить("Период", НачалоВремен());
		Настройки.Вставить("ДатаИзменения", ТекущаяДатаСеанса());
		Настройки.Вставить("ДатаПереходаНаУСН", ДатаИзJSON(Запись.НастройкиСистемыНалогообложения.ДатаПереходаНаУСН));
		
		ПеревестиСтрокуВПеречисление(Настройки, "СистемаНалогообложения", "СистемыНалогообложения");
		ПеревестиСтрокуВПеречисление(Настройки, "ОбъектНалогообложенияУСН", "ОбъектыНалогообложенияПоУСН");
		ПеревестиСтрокуВПеречисление(Настройки, "ВариантыБухгалтерскойОтчетности", "ВариантыБухгалтерскойОтчетности");
		
		СоздатьЗаписьРегистра("НастройкиСистемыНалогообложения", Настройки);
	
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'настроек системы налогообложения по организации '"), Организация));
		
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьНастройкиКалендаряОтчетности(Организация, Запись, ЗаписьОшибок)
	
	Попытка
		
		НастройкиКалендаряОтчетности = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Запись.НастройкиКалендаряОтчетности);
		НастройкиКалендаряОтчетности.Вставить("Организация", Организация);
		НастройкиКалендаряОтчетности.Вставить("Период", НачалоВремен());
		
		СоздатьЗаписьРегистра("НастройкиКалендаряОтчетности", НастройкиКалендаряОтчетности);
	
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'для календаря отчетности по организации '"), Организация));
		
	КонецПопытки;

КонецПроцедуры

Процедура ПеревестиСтрокуВПеречисление(Настройки, Свойство, ИмяМетаданных)

	Если Настройки[Свойство] <> Неопределено Тогда
		Настройки[Свойство] = Перечисления[ИмяМетаданных][Настройки[Свойство]];
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьЗаписьРегистра(ИмяРегистра, Значения)
	
	// Удаляем предыдущие записи
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Значения.Организация);
	НаборЗаписей.Записать(); 
	
	// Добавляем новую запись
	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Значения);
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура СоздатьИсторияРегистрацийВОрганеПФР(
		ОрганизацияСсылка, 
		РегНомерПФР,
		РегНомерСФР, 
		ЗаписьОшибок)
		
	Если Не ЗначениеЗаполнено(РегНомерПФР) И Не ЗначениеЗаполнено(РегНомерСФР) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
	
		Регистр = "ИсторияРегистрацийВОрганеПФР";
			
		МенеджерЗаписи = РегистрыСведений[Регистр].СоздатьМенеджерЗаписи();

		МенеджерЗаписи.Организация = ОрганизацияСсылка;
		МенеджерЗаписи.РегистрационныйНомерПФР = РегНомерПФР;
		МенеджерЗаписи.РегистрационныйНомерСФР = РегНомерСФР;
		МенеджерЗаписи.Период = НачалоВремен();

		МенеджерЗаписи.Записать();
	
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'СФР организации '"), ОрганизацияСсылка));
		
	КонецПопытки;

КонецПроцедуры

// Находит или создает банковский счет организации, поиск идет по заранее собранным кэшам
//
// Параметры:
//  Запись - Структура - выгруженные реквизиты организации
//  ОрганизацияСсылка - СправочникСсылка.Организации
//  КэшСчетов - Соответствие из КлючИЗначение:
//    * Ключ - Строка - БИК и номер счета через разделитель
//    * Значение - СправочникСсылка.БанковскиеСчета
//  КэшБанков - Соответствие из КлючИЗначение:
//    * Ключ - Строка - БИК
//    * Значение - СправочникСсылка.Банки
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета - найденный или созданный счет
//  Неопределено - если реквизиты счета не заполнены
//
Функция НайтиСоздатьБанковскийСчет(Запись, ОрганизацияСсылка, КэшСчетов, КэшБанков)

	Если Метаданные.Справочники.Найти("БанковскиеСчета") = Неопределено
		ИЛИ Метаданные.Справочники.Найти("Банки") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Запись.БанкСчетБИКБанка) ИЛИ НЕ ЗначениеЗаполнено(Запись.БанкСчетНомер) Тогда
		Возврат Неопределено;
	КонецЕсли;

	СправочникСчет = "БанковскиеСчета";
	СправочникБанк = "Банки";

	КлючСчета = КлючБанковскогоСчета(Запись.БанкСчетБИКБанка, Запись.БанкСчетНомер);

	Счет = КэшСчетов.Получить(КлючСчета);
	Если ЗначениеЗаполнено(Счет) Тогда
		Возврат Счет;
	КонецЕсли;

	СчетОбъект = Справочники[СправочникСчет].СоздатьЭлемент();

	Банк = КэшБанков.Получить(Запись.БанкСчетБИКБанка);
	Если НЕ ЗначениеЗаполнено(Банк) Тогда
		БанкОбъект = Справочники[СправочникБанк].СоздатьЭлемент();
		БанкОбъект.КоррСчет = Запись.БанкСчетКоррСчетБанка;
		БанкОбъект.Код = Запись.БанкСчетБИКБанка;
		БанкОбъект.Наименование = Запись.БанкСчетНаимБанка;
		БанкОбъект.Записать();
		Банк = БанкОбъект.Ссылка;
		КэшБанков.Вставить(Запись.БанкСчетБИКБанка, Банк);
	КонецЕсли;

	СчетОбъект.НомерСчета = Запись.БанкСчетНомер;
	СчетОбъект.Банк = Банк;
	СчетОбъект.Наименование = Запись.БанкСчетНомер;
	СчетОбъект.Владелец = ОрганизацияСсылка;

	СчетОбъект.Записать();

	КэшСчетов.Вставить(КлючСчета, СчетОбъект.Ссылка);

	Возврат СчетОбъект.Ссылка;

КонецФункции

// Ключ банковского счета для кэша
//
// Параметры:
//  БИК - Строка
//  НомерСчета - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция КлючБанковскогоСчета(БИК, НомерСчета)

	Возврат СокрЛП(БИК) + "|" + СокрЛП(НомерСчета);

КонецФункции

// Подбирает существующие банковские счета сразу по всем реквизитам из записей
//
// Параметры:
//  Записи - Массив из Структура - записи организаций
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//    * Ключ - Строка - БИК и номер счета через разделитель
//    * Значение - СправочникСсылка.БанковскиеСчета
//
Функция БанковскиеСчетаПоЗаписям(Записи)

	Результат = Новый Соответствие;

	Если Метаданные.Справочники.Найти("БанковскиеСчета") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Номера = Новый Массив;
	Для каждого Запись Из Записи Цикл
		Если ЗначениеЗаполнено(Запись.БанкСчетБИКБанка) И ЗначениеЗаполнено(Запись.БанкСчетНомер) Тогда
			Номера.Добавить(Запись.БанкСчетНомер);
		КонецЕсли;
	КонецЦикла;

	Если Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ТипСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(70);
	ПриведенныеНомера = Новый Массив;
	Для каждого Номер Из Номера Цикл
		ПриведенныеНомера.Добавить(ТипСтрока.ПривестиЗначение(Номер));
	КонецЦикла;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК Ссылка,
	|	БанковскиеСчета.Банк.Код КАК БИК,
	|	БанковскиеСчета.НомерСчета КАК НомерСчета
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.НомерСчета В (&Номера)
	|
	|УПОРЯДОЧИТЬ ПО
	|	БанковскиеСчета.ПометкаУдаления УБЫВ,
	|	БанковскиеСчета.Ссылка УБЫВ");

	Запрос.УстановитьПараметр("Номера", ПриведенныеНомера);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(КлючБанковскогоСчета(Выборка.БИК, Выборка.НомерСчета), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подбирает банки сразу по всем БИК из записей
//
// Параметры:
//  Записи - Массив из Структура - записи организаций
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//    * Ключ - Строка - БИК
//    * Значение - СправочникСсылка.Банки
//
Функция БанкиПоЗаписям(Записи)

	Результат = Новый Соответствие;

	Если Метаданные.Справочники.Найти("Банки") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Коды = Новый Массив;
	Для каждого Запись Из Записи Цикл
		Если ЗначениеЗаполнено(Запись.БанкСчетБИКБанка) Тогда
			Коды.Добавить(Запись.БанкСчетБИКБанка);
		КонецЕсли;
	КонецЦикла;

	Если Коды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Банки.Ссылка КАК Ссылка,
	|	Банки.Код КАК Код
	|ИЗ
	|	Справочник.Банки КАК Банки
	|ГДЕ
	|	Банки.Код В (&Коды)
	|	И НЕ Банки.ПометкаУдаления");

	Запрос.УстановитьПараметр("Коды", Коды);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Код, Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БанковскийСчетПоРеквизитам(БИК, НомерСчета) Экспорт

	Если Метаданные.Справочники.Найти("БанковскиеСчета") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Справочник = "БанковскиеСчета";
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БанковскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + Справочник + " КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Банк.Код = &БИК
	|	И БанковскиеСчета.НомерСчета = &НомерСчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	БанковскиеСчета.ПометкаУдаления,
	|	БанковскиеСчета.Ссылка");
	
	Запрос.УстановитьПараметр("БИК", БИК);
	
	ТипСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(70);
	ПриведенныйНомерСчета = ТипСтрока.ПривестиЗначение(НомерСчета);
	Запрос.УстановитьПараметр("НомерСчета", ПриведенныйНомерСчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник." + Справочник).ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Процедура СоздатьОтветственныеЛицаОрганизаций(Организация, Запись, ЗаписьОшибок)

	МетаданныеПеречисления = ОбщегоНазначения.ОбъектМетаданныхПоПолномуИмени("Перечисление.ОтветственныеЛицаОрганизаций");
	МетаданныеРегистра = ОбщегоНазначения.ОбъектМетаданныхПоПолномуИмени("РегистрСведений.ОтветственныеЛицаОрганизаций");
	Если МетаданныеПеречисления = Неопределено
		ИЛИ МетаданныеРегистра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		
		МенеджерПеречисления = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Перечисление.ОтветственныеЛицаОрганизаций");
		
		// Руководитель
		Руководитель = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "ФизическиеЛица", Запись, "Руководитель");
		ДолжностьРук = НайтиИлиСоздатьДолжность(Запись, "ДолжностьРук");

		СоздатьЗаписьОтветственныеЛицаОрганизаций(Организация, Руководитель, ДолжностьРук,
			МенеджерПеречисления.Руководитель);
		
		// ГлБухгалтер
		ГлБухгалтер  = ПолучитьСсылкуПоGUIDиЗаписи("Справочники", "ФизическиеЛица", Запись, "ГлБухгалтер");
		ДолжностьБух = НайтиИлиСоздатьДолжность(Запись, "ДолжностьБух");
		
		СоздатьЗаписьОтветственныеЛицаОрганизаций(Организация, ГлБухгалтер, ДолжностьБух,
			МенеджерПеречисления.ГлавныйБухгалтер);
		
	Исключение
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'ответственных лиц организации '"), Организация));
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьЗаписьОтветственныеЛицаОрганизаций(Организация, ФизЛицо, Должность, Вид)
	
	Если НЕ ЗначениеЗаполнено(ФизЛицо) ИЛИ НЕ ЗначениеЗаполнено(Должность) Тогда
		Возврат;
	КонецЕсли;

	ИмяРегистра = "ОтветственныеЛицаОрганизаций";

	// Удаляем предыдущие записи
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СтруктурнаяЕдиница.Установить(Организация);
	НаборЗаписей.Отбор.ОтветственноеЛицо.Установить(Вид);
	НаборЗаписей.Записать(); 
	
	// Добавляем новую запись
	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.СтруктурнаяЕдиница = Организация;
	МенеджерЗаписи.ОтветственноеЛицо = Вид;
	МенеджерЗаписи.ФизическоеЛицо = ФизЛицо;
	МенеджерЗаписи.Должность = Должность;
	МенеджерЗаписи.Период = НачалоВремен();
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Подбирает страны сразу по всем кодам из выгружаемых записей одним запросом
//
// Параметры:
//  Записи - Массив из Структура - записи организаций с полями КодСтрИО и КодСтрПостИО
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//    * Ключ - Строка - код альфа2
//    * Значение - СправочникСсылка.СтраныМира
//
Функция СтраныПоКодам(Записи)

	Результат = Новый Соответствие;

	Коды = Новый Массив;
	Для каждого Запись Из Записи Цикл
		Если ЗначениеЗаполнено(Запись.КодСтрИО) Тогда
			Коды.Добавить(Запись.КодСтрИО);
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.КодСтрПостИО) Тогда
			Коды.Добавить(Запись.КодСтрПостИО);
		КонецЕсли;
	КонецЦикла;

	Если Коды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтраныМира.КодАльфа2 КАК КодАльфа2,
	               |	СтраныМира.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.СтраныМира КАК СтраныМира
	               |ГДЕ
	               |	СтраныМира.КодАльфа2 В (&Коды)";

	Запрос.УстановитьПараметр("Коды", Коды);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.КодАльфа2, Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

