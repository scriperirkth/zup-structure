Функция ПолучитьНужныеМЧД(ОрганизацииМассив) Экспорт
	
	НужныеМЧД = ВыбратьМЧДПоОписаниям(ОрганизацииВМЧД(), ОрганизацииМассив);

	Возврат ОставитьТолькоСданыеМЧД(НужныеМЧД);
	
КонецФункции

Функция ОставитьТолькоСданыеМЧД(МЧД) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЖурналОтправокВКонтролирующиеОрганы.Ссылка КАК Ссылка
		|ИЗ
		|	РегистрСведений.ЖурналОтправокВКонтролирующиеОрганы КАК ЖурналОтправокВКонтролирующиеОрганы
		|ГДЕ
		|	ЖурналОтправокВКонтролирующиеОрганы.СостояниеСдачиОтчетности = ЗНАЧЕНИЕ(Перечисление.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота)
		|	И ЖурналОтправокВКонтролирующиеОрганы.Ссылка В(&МЧД)";
	
	Запрос.УстановитьПараметр("МЧД", МЧД);
	
	НужныеМЧД = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат НужныеМЧД;
	
КонецФункции

Функция ВыгрузитьСправочники(ОрганизацииМассив, НужныеМЧД, ФизЛицаИзМЧД, КонтрагентыИзМЧД, ЗаписьОшибок) Экспорт
	
	ФайлВыгрузки = ПолучитьИмяВременногоФайла("txt");
	
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(,Символы.Таб,,,,,,,Истина);
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ФайлВыгрузки, , , ПараметрыJSON);
	
	Данные = Новый Структура;
	
	Попытка
		
		ФизЛица = ИнициализироватьТаблицуФизЛиц();
		
		Попытка
			Данные.Вставить("Организации", ВыгрузитьОрганизации(ОрганизацииМассив, ФизЛица, ЗаписьОшибок));
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'организаций'")));
		КонецПопытки;

		Попытка
			ВсеОрганизации = ОрганизацииИзМЧД(НужныеМЧД);
			Дельта = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ВсеОрганизации, ОрганизацииМассив);
			Данные.Вставить("ДопОрганизации", ВыгрузитьОрганизации(Дельта, Неопределено, ЗаписьОшибок));
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'организаций из МЧД'")));
		КонецПопытки;
		
		Данные.Вставить("Сотрудники", ВыгрузитьНужныхСотрудников(ОрганизацииМассив, ФизЛица, ЗаписьОшибок));
		
		Попытка
			Данные.Вставить("ФизическиеЛица", ВыгрузитьНужныхФизЛиц(ОрганизацииМассив, ФизЛица, ФизЛицаИзМЧД, ЗаписьОшибок));
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'физ.лиц'")));
		КонецПопытки;
		
		Попытка
			Данные.Вставить("СтраныМира", ВыгрузитьСтраныМира());
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'стран мира'")));
		КонецПопытки;
		
		Попытка
			Данные.Вставить("Контрагенты", ВыгрузитьНужныхКонтрагентов(КонтрагентыИзМЧД));
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'контрагентов'")));
		КонецПопытки;
		
		Попытка
			Данные.Вставить("ПодразделенияОрганизаций", ВыгрузитьНужныеПодразделенияОрганизаций(ОрганизацииМассив));
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'подразделений'")));
		КонецПопытки;
		
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'справочников в целом'")));
				
	КонецПопытки;

	ЗаписатьJSON(Запись, Данные, Новый НастройкиСериализацииJSON);
	Запись.Закрыть();
	
	ДвДанные = Новый ДвоичныеДанные(ФайлВыгрузки);
	
	Возврат ДвДанные;
	
КонецФункции

Процедура ДобавитьОшибку(ЗаписьОшибок, Ошибка)
	
	ЗаписьОшибок.ЗаписатьСтроку(Ошибка);
	ЗаписьОшибок.ЗаписатьСтроку(Символы.ПС);
	ЗаписьОшибок.ЗаписатьСтроку(Символы.ПС);
	
КонецПроцедуры

Функция ВыгрузитьНужныеПодразделенияОрганизаций(ОрганизацииМассив)
	
	ИмяСправочника = РегламентированнаяОтчетностьПереопределяемый.ИмяСправочникаОбособленныхПодразделений();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Объект.Ссылка КАК Ссылка,
		|	Объект.Наименование КАК Наименование,
		|	Объект.Владелец КАК Владелец,
		|	""              "" КАК КодПоОКПО
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Объект
		|ГДЕ
		|	НЕ Объект.ПометкаУдаления
		|	И Объект.Владелец В(&Владелец)";
	
	Запрос.УстановитьПараметр("Владелец", ОрганизацииМассив);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	РезультатВсе = ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
	Для каждого РезультатОдин Из РезультатВсе Цикл
		
		КодПоОКПО = "";
		РегламентированнаяОтчетностьПереопределяемый.ПолучитьКодОКПОПодразделения(РезультатОдин.Ссылка, КодПоОКПО);
		
		РезультатОдин.КодПоОКПО = КодПоОКПО;
		
		РезультатОдин.Вставить("УникальныйИдентификатор", GUID(РезультатОдин.Ссылка));
		РезультатОдин.Вставить("Владелец", GUID(РезультатОдин.Владелец));
		РезультатОдин.Удалить("Ссылка");
	
	КонецЦикла;
	
	Возврат РезультатВсе;
	
КонецФункции

Функция ВыгрузитьМЧДФНСиУПУП(ОрганизацииМассив, ЗаписьОшибок) Экспорт
	
	Каталог = КаталогВременныхФайлов();
	
	РезультатВсе = Новый Массив;
	
	Попытка
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЖурналОтправокВКонтролирующиеОрганы.Ссылка КАК Ссылка
			|ИЗ
			|	РегистрСведений.ЖурналОтправокВКонтролирующиеОрганы КАК ЖурналОтправокВКонтролирующиеОрганы
			|ГДЕ
			|	(ТИПЗНАЧЕНИЯ(ЖурналОтправокВКонтролирующиеОрганы.Ссылка) = ТИП(Справочник.МашиночитаемыеДоверенностиФНС)
			|			ИЛИ ТИПЗНАЧЕНИЯ(ЖурналОтправокВКонтролирующиеОрганы.Ссылка) = ТИП(Документ.УведомлениеОПредоставленииПолномочийПредставителю))
			|	И ЖурналОтправокВКонтролирующиеОрганы.СтатусОтправки = ""Зарегистрировано"" 
			|	И НЕ ЖурналОтправокВКонтролирующиеОрганы.Скрыт
			|	И ЖурналОтправокВКонтролирующиеОрганы.Организация В (&Организации)";
		
		Запрос.УстановитьПараметр("Организации", ОрганизацииМассив);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Номер = 0;
		
		Пока Выборка.Следующий() Цикл
			
			ОпределятьКодНалоговогоОрганаПолучателя = Истина;
			ФорматДоверенностиПоПриказуФНС 			= Истина;
			
			ПараметрыВозврата = Новый Структура;
			ПараметрыВозврата.Вставить("ВозвращатьАдресВоВременномХранилище", 	Истина);
			ПараметрыВозврата.Вставить("ВозвращатьИмяФайлаСРасширением", 		Истина);
			ПараметрыВозврата.Вставить("ВозвращатьПриложеннуюПодпись", 			Истина);
			ПараметрыВозврата.Вставить("ПроверитьЧтоУведомлениеОтправлено", 	Ложь);
			
			// У МЧД ФНС:
			// Массив структур Имя, Адрес или просто Структура. У подписи в имени есть _SGN_
			// "ON_DOVEL_9999_9999_9665822247999999991_20250328_0f0f58b6-d4e6-4393-a417-793afd81cdab.xml"
			// "ON_DOVEL_9999_9999_9665822247999999991_20250328_0f0f58b6-d4e6-4393-a417-793afd81cdab_SGN_b05771d7-49ec-46fa-b9e2-bac541980db2.sgn"
			// У УПУП: Структура Имя, Адрес
			
			Попытка
			
				РезультатВыгрузки = ДокументооборотСКОВызовСервера.ВыгрузитьМЧД(
					Выборка.Ссылка,,,
					ОпределятьКодНалоговогоОрганаПолучателя,
					ФорматДоверенностиПоПриказуФНС,
					Ложь,
					ПараметрыВозврата);
			
			Исключение
				
				ТекстОшибки = Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'документа'"),Выборка.Ссылка);
				ДобавитьОшибку(ЗаписьОшибок, ТекстОшибки);
		
				Продолжить;
				
			КонецПопытки;
				
			Если РезультатВыгрузки = Неопределено Тогда
				
				Продолжить;
				
			ИначеЕсли ТипЗнч(РезультатВыгрузки) = Тип("Массив") Тогда
				
				ФайлАрхива = ПолучитьИмяВременногоФайла("zip");
				ЗаписьZIP  = Новый ЗаписьZipФайла(ФайлАрхива,,,, УровеньСжатияZIP.Максимальный);

				Для каждого Файл Из РезультатВыгрузки Цикл
					ДобавитьФайлМЧДвZIP(Каталог, ЗаписьZIP, Файл);
				КонецЦикла;
				
				ЗаписьZIP.Записать();
				
				ДобавитьМЧДZIPвРезультат(РезультатВсе, Выборка.Ссылка, ФайлАрхива);
				
			ИначеЕсли ТипЗнч(РезультатВыгрузки) = Тип("Структура") Тогда
				
				ФайлАрхива = ПолучитьИмяВременногоФайла("zip");
				ЗаписьZIP  = Новый ЗаписьZipФайла(ФайлАрхива,,,, УровеньСжатияZIP.Максимальный);

				ДобавитьФайлМЧДвZIP(Каталог, ЗаписьZIP, РезультатВыгрузки);
				
				ЗаписьZIP.Записать();
				
				ДобавитьМЧДZIPвРезультат(РезультатВсе, Выборка.Ссылка, ФайлАрхива);
				
			КонецЕсли;
				
		КонецЦикла;
		
	Исключение
		
		ТекстОшибки = Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'УПУП и МЧД ФНС'"));
		ДобавитьОшибку(ЗаписьОшибок, ТекстОшибки);
	
	КонецПопытки;
	
	Возврат РезультатВсе;
	
КонецФункции

Функция ДобавитьМЧДZIPвРезультат(РезультатВсе, Ссылка, ПутьКZIP) Экспорт
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС") Тогда
		Имя = "МЧДФНС_" + Ссылка.УникальныйИдентификатор() + ".zip";
	Иначе
		Имя = "УПУП_" + Ссылка.УникальныйИдентификатор() + ".zip";
	КонецЕсли;

	ДвДанные = Новый ДвоичныеДанные(ПутьКZIP);
	
	Результат = Новый Структура("Имя, ДвДанные", Имя, ДвДанные);
	
	РезультатВсе.Добавить(Результат);
	
КонецФункции

Функция ДобавитьФайлМЧДвZIP(Каталог, ЗаписьZIP, Файл) Экспорт
	
	Путь     = Каталог + ПолучитьРазделительПути() + Файл.Имя;
	ДвДанные = ПолучитьИзВременногоХранилища(Файл.Адрес);
	ДвДанные.Записать(Путь);
	
	ЗаписьZIP.Добавить(Путь);
					
КонецФункции

Функция ВыгрузитьДанныеУниверсальнымОбменом(ОрганизацииМассив, НужныеМЧД, ФизЛицаИзМЧД, КонтрагентыИзМЧД, ВерсияБРО, ВерсияБСП, ЗаписьОшибок) Экспорт
	
	ПутьФайлаПравил = ПолучитьФайлПравил(ВерсияБРО, ВерсияБСП);
	
	Если НЕ ЗначениеЗаполнено(ПутьФайлаПравил) Тогда
		
		ДобавитьОшибку(ЗаписьОшибок, НСтр("ru = 'Выгрузка справочников универсальным обменом из данной конфигурации не предусмотрена'"));
		Возврат Неопределено;
		
	КонецЕсли;
	
	Попытка
		
		ИмяОбработки = "УниверсальныйОбменДаннымиXML";
		
		Обработка = Обработки[ИмяОбработки].Создать();
		Обработка.РежимОбмена = "Выгрузка";
		Обработка.ИмяФайлаПравилОбмена = ПутьФайлаПравил;//ФайлПравилОбмена;
		Обработка.ЗаписыватьРегистрыНаборамиЗаписей = Истина;
		
		ФайлВыгрузки = ПолучитьИмяВременногоФайла("xml");
		ИмяФайлаПротоколаОбмена = ПолучитьИмяВременногоФайла("txt");
		
		Обработка.ИмяФайлаОбмена = ФайлВыгрузки;
		Обработка.ИмяФайлаПротоколаОбмена = ИмяФайлаПротоколаОбмена;
		Обработка.КодировкаФайлаПротоколаОбмена = "КодировкаТекста.UTF8";
		Обработка.НеВыводитьНикакихИнформационныхСообщенийПользователю = Истина;
		Обработка.ЗагрузитьПравилаОбмена();
		Обработка.Параметры.Вставить("Организации", ОрганизацииМассив);
		Обработка.Параметры.Вставить("МЧД", НужныеМЧД);
		Обработка.Параметры.Вставить("ФизЛица", ФизЛицаИзМЧД);
		Обработка.Параметры.Вставить("Контрагенты", КонтрагентыИзМЧД);
		Обработка.ТаблицаНастройкиПараметров.Очистить();
		Обработка.ВыполнитьВыгрузку();
		
		ДописатьВФайлКоличествоВыгруженных(ФайлВыгрузки, Обработка.мСчетчикВыгруженныхОбъектов);
		
		ДвДанные = Новый ДвоичныеДанные(ФайлВыгрузки);
		
		Ошибки = ОшибкиИзПротоколаУниверсальногоОбмена(ИмяФайлаПротоколаОбмена);
		Если ЗначениеЗаполнено(Ошибки) Тогда
			ДобавитьОшибку(ЗаписьОшибок, Ошибки);
		КонецЕсли;
			
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'универсальным обменом'")));
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат ДвДанные;
		
КонецФункции

Процедура ДописатьВФайлКоличествоВыгруженных(Путь, КоличествоВыгруженных)

	Запись = Новый ЗаписьТекста; 
	Запись.Открыть(Путь,,,Истина);
	Запись.ЗаписатьСтроку(НСтр("ru = 'Выгружено: '") + КоличествоВыгруженных);
	Запись.Закрыть();

КонецПроцедуры

Функция ОшибкиИзПротоколаУниверсальногоОбмена(ИмяФайлаПротоколаОбмена)
	
	ФайлПротокола = Новый ТекстовыйДокумент;
	ФайлПротокола.Прочитать(ИмяФайлаПротоколаОбмена, КодировкаТекста.UTF8);
	
	ТекстОшибок = "";
	
	Для Номер = 1 По ФайлПротокола.КоличествоСтрок() Цикл
		
		СтрокаРезультата = ФайлПротокола.ПолучитьСтроку(Номер);
		
		Если СтрНайти(СтрокаРезультата, "Начало") = 1
			Или СтрНайти(СтрокаРезультата, "Окончание") = 1
			Или СтрНайти(СтрокаРезультата, "Ошибка.") = 1
			ИЛИ СтрНайти(СтрокаРезультата, "Выгружено объектов") = 1
			ИЛИ СтрНайти(СтрокаРезультата, "Загружено объектов") = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстОшибок) Тогда
			ТекстОшибок = ТекстОшибок + Символы.ПС;
		КонецЕсли;
		ТекстОшибок = ТекстОшибок + СтрокаРезультата;
	КонецЦикла;
	
	Возврат СокрЛП(ТекстОшибок);
	
КонецФункции

Функция ПолучитьФайлПравил(ВерсияБРО, ВерсияБСП) Экспорт
	
	Макет = ПодобратьПравилоПоВерсиям(ВерсияБРО, ВерсияБСП);
	Если Макет = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		// Удаляем __1, добавленный для упорядочивания
		СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(Макет, 3);
	КонецЕсли;
	
	Правила = Обработки.ПереносСправочниковБРО.ПолучитьМакет(Макет);
	
	ПутьФайлаПравил = ПолучитьИмяВременногоФайла("xml");
	Правила.Записать(ПутьФайлаПравил, "UTF-8");
	
	Если НЕ ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует() Тогда
		
		УдалитьМЧДЦБизПравил(ПутьФайлаПравил);
	
	КонецЕсли;
	
	Возврат ПутьФайлаПравил;
	
КонецФункции

Функция ПодобратьПравилоПоВерсиям(Знач ВерсияБРО_О1СО, Знач ВерсияБСП_О1СО)
	
	ВерсияБРО_О1СО = НормализоватьВерсию(ВерсияБРО_О1СО);
	ВерсияБСП_О1СО = НормализоватьВерсию(ВерсияБСП_О1СО);
	
	ВерсияБРО_Типовой = "БРО" + НормализоватьВерсию(ВерсияБРО());
	ВерсияБСП_Типовой = "БСП" + НормализоватьВерсию(ВерсияБСП());
	
	МинВерсияБРО = Мин(ВерсияБРО_О1СО, ВерсияБРО_Типовой);
	МинВерсияБСП = Мин(ВерсияБСП_О1СО, ВерсияБСП_Типовой);
	
	Макеты = Метаданные.Обработки.ПереносСправочниковБРО.Макеты;
	
	ПоследнийМакет = "";
	Версии = Новый СписокЗначений;
	Для каждого Макет Из Макеты Цикл
		ПоследнийМакет = Макет.Имя + "__1";
		// __1 добавляется для упорядочивания
		Версии.Добавить(ПоследнийМакет, "Из макета");
	КонецЦикла;
	
	// __2 добавляется для упорядочивания
	Версии.Добавить(МинВерсияБСП + "__" + МинВерсияБРО + "__2", "Искомая");
	
	Версии.СортироватьПоЗначению();
	
	АктуальныйМакет = Неопределено;
	Для каждого Версия Из Версии Цикл
		Если Версия.Представление = "Из макета" Тогда
			АктуальныйМакет = Версия.Значение;
		КонецЕсли;
		
		Если Версия.Представление = "Искомая" Тогда
			Прервать;
		КонецЕсли;
			
	КонецЦикла;
	
	Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() И АктуальныйМакет = Неопределено Тогда
		АктуальныйМакет = ПоследнийМакет;
	КонецЕсли;
	
	Возврат АктуальныйМакет;

КонецФункции

Функция НормализоватьВерсию(Знач Версия)
	
	Части = СтрРазделить(Версия, ".");
	
	Части[2] = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Части[2], 2);
	
	Результат = СтрСоединить(Части, "_");
	
	Возврат Результат;

КонецФункции

Процедура УдалитьМЧДЦБизПравил(Путь)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(Путь);
	ПостроительДОМ = Новый ПостроительDOM;
	ДокументДОМ = ПостроительДОМ.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	УзлыПравилаКонвертации = ДокументДОМ.ПолучитьЭлементыПоИмени("ПравилаКонвертацииОбъектов");
	УзелПравилаКонвертации = УзлыПравилаКонвертации[0];
	
	Для каждого Группа Из УзелПравилаКонвертации.ДочерниеУзлы Цикл
		Если Группа.ПервыйДочерний.ТекстовоеСодержимое = "Справочники" Тогда
			
			МассивПравил = Группа.ПолучитьЭлементыПоИмени("Правило");
			
			Для каждого Правило Из МассивПравил Цикл
				
				Если Правило.ПервыйДочерний.ТекстовоеСодержимое = "МашиночитаемыеДоверенностиЦБ" Тогда
					Группа.УдалитьДочерний(Правило);
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	УзлыПравилаВыгрузки = ДокументДОМ.ПолучитьЭлементыПоИмени("ПравилаВыгрузкиДанных");
	УзелПравилаВыгрузки = УзлыПравилаВыгрузки[0];
	
	Правила = УзелПравилаВыгрузки.ПолучитьЭлементыПоИмени("Правило");
	Для каждого Группа Из Правила Цикл
		Если Группа.ПервыйДочерний.ТекстовоеСодержимое = "МашиночитаемыеДоверенностиЦБ" Тогда
			Группа.РодительскийУзел.УдалитьДочерний(Группа);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(Путь,"UTF-8");
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументДОМ, ЗаписьXML);
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

Функция ОрганизацииМассивом(СписокОрганизаций) Экспорт
	
	Организации = Новый Массив;
	Для каждого Запись Из СписокОрганизаций Цикл
