Функция СоздатьЭлементыСправочника(Данные, Имя, ЗаписьОшибок) Экспорт
	
	Результат = ШаблонРезультата();

	Если НЕ Данные.Свойство(Имя) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Всего = Данные[Имя].Количество();
	Результат.Загружено = 0;
	Для каждого Запись Из Данные[Имя] Цикл
		
		Попытка
		
			Объект   = ПолучитьСоздатьОбъектПоGUID("Справочники", Имя, Запись.УникальныйИдентификатор).Объект;
			ЭтоНовый = Объект.ЭтоНовый();
		
			Если Объект.Предопределенный ИЛИ Запись.Свойство("Предопределенный") И Запись.Предопределенный ИЛИ НЕ ЭтоНовый Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(Объект, Запись);
			Объект.Записать();
			
			Результат.Загружено = Результат.Загружено + 1;
		
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'справочника '") + Имя));
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуПоGUID(Источник, ИмяМетаданных, GUID) Экспорт
	
	Если НЕ ЗначениеЗаполнено(GUID) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Источник = "Справочники" Тогда
		Менеджер = Справочники;
	Иначе
		Менеджер = Документы;
	КонецЕсли;
	
	Ссылка = Менеджер[ИмяМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(GUID));
	Если СтрНайти(Строка(Ссылка), "<Объект не найден>") Тогда
		Возврат Неопределено;
	Иначе
		Возврат Ссылка;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСоздатьОбъектПоGUID(Источник, ИмяМетаданных, GUID) Экспорт
	
	Результат = Новый Структура("Ссылка, Объект");
	
	Если Источник = "Справочники" Тогда
		Менеджер = Справочники;
	Иначе
		Менеджер = Документы;
	КонецЕсли;
	
	Ссылка = ПолучитьСсылкуПоGUID(Источник, ИмяМетаданных, GUID);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Объект = Ссылка.ПолучитьОбъект();
		
	ИначеЕсли ЗначениеЗаполнено(GUID) Тогда
		
		НовыйGUID = Новый УникальныйИдентификатор(GUID);
		Объект = Менеджер[ИмяМетаданных].СоздатьЭлемент();
		Ссылка = Менеджер[ИмяМетаданных].ПолучитьСсылку(НовыйGUID);
		Объект.УстановитьСсылкуНового(Ссылка);
		
	Иначе
		
		Объект = Менеджер[ИмяМетаданных].СоздатьЭлемент();
		Ссылка = Менеджер[ИмяМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор);
		Объект.УстановитьСсылкуНового(Ссылка);
		
	КонецЕсли;
	
	Результат.Объект = Объект;
	Результат.Ссылка = Ссылка;
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьМЧДФНСиУПУП(ФайлыВыгрузки, ЗаписьОшибок) Экспорт
	
	Результат = ШаблонРезультата();
	
	Корень = ПолучитьИмяВременногоФайла();
	
	Для каждого Файл Из ФайлыВыгрузки Цикл
		
		ЭтоМЧДФНС = СтрНайти(Файл.Имя, "МЧДФНС");
		ЭтоУПУП   = СтрНайти(Файл.Имя, "УПУП");
		
		Если НЕ ЭтоМЧДФНС И НЕ ЭтоУПУП Тогда
			Продолжить;
		Иначе
			Результат.Всего = Результат.Всего + 1;
		КонецЕсли;
		
		ПутьПапки   = ДобавитьРазделитель(Корень) + СтрЗаменить(Файл.Имя, ".zip", "");
		ПутьКАрхиву = ДобавитьРазделитель(Корень) + Файл.Имя;
		Файл.Адрес.Записать(ПутьКАрхиву);
		
		ЧтениеZip = Новый ЧтениеZipФайла(ПутьКАрхиву);
		
		ФайлПодписи = "";
		ФайлМЧД = "";
		ИмяФайлаМЧД = "";
		
		Для Каждого Элемент Из ЧтениеZip.Элементы Цикл
			ЧтениеZip.Извлечь(Элемент, ПутьПапки, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
			
			Путь = ДобавитьРазделитель(ПутьПапки) + Элемент.Имя;
			Если СтрНайти(Путь, "_SGN_") Тогда
				ФайлПодписи = Путь;
			Иначе
				ФайлМЧД = Путь;
				ИмяФайлаМЧД = Элемент.Имя;
			КонецЕсли;
			
		КонецЦикла;
		
		АдресФайла = АдресПоФайлу(ФайлМЧД);
		АдресПодписи = АдресПоФайлу(ФайлПодписи);
		
		Попытка
		
			Если ЭтоМЧДФНС Тогда 
				РезультатЗагрузки = ДокументооборотСКОВызовСервера.ЗагрузитьМЧД(
					АдресФайла,
					Истина,
					АдресПодписи);
			ИначеЕсли ЭтоУПУП Тогда
				РезультатЗагрузки = Документы.УведомлениеОПредоставленииПолномочийПредставителю.ЗагрузитьДокументИзФайлаОбмена(
					АдресФайла,
					Истина);
			КонецЕсли;
				
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'архива'"), Файл.Имя));
			Продолжить;
		КонецПопытки;
		
		Если НЕ РезультатЗагрузки.Выполнено И ЗначениеЗаполнено(РезультатЗагрузки.Ошибка) Тогда
			Ошибка = НСтр("ru = 'Не удалось загрузить МЧД из файла '") + ИмяФайлаМЧД + НСтр("ru = ' по причине: '") + РезультатЗагрузки.Ошибка;
			ДобавитьОшибку(ЗаписьОшибок, Ошибка);
			Продолжить;
		Иначе
			МЧД = РезультатЗагрузки.Ссылка;
			Результат.Загружено = Результат.Загружено + 1;
		КонецЕсли;
		
		Попытка
			Орган     = ?(ЭтоМЧДФНС, Перечисления.ТипыКонтролирующихОрганов.ФНС, Перечисления.ТипыКонтролирующихОрганов.ПФР);
			НовСтатус = ?(ЭтоМЧДФНС, "Зарегистрировано", "Сдано");
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Организация", МЧД.Организация);
			ДополнительныеПараметры.Вставить("КонтролирующийОрган", Орган);
			ДополнительныеПараметры.Вставить("СсылкаНаОбъект", МЧД);
			ДополнительныеПараметры.Вставить("ЭтоОтчет", Ложь);
			ДополнительныеПараметры.Вставить("НовСтатус", НовСтатус);
			
			РегламентированнаяОтчетностьВызовСервера.СохранитьСтатусОтправки(ДополнительныеПараметры, Неопределено);
			
		Исключение
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка", , ИмяФайлаМЧД));
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция АдресПоФайлу(Путь)
	
	Если ЗначениеЗаполнено(Путь) Тогда
		ДвДанные = Новый ДвоичныеДанные(Путь);
		Возврат ПоместитьВоВременноеХранилище(ДвДанные, Новый УникальныйИдентификатор);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции	
	
Функция ДобавитьРазделитель(Папка)

	Возврат ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(Папка);
	
КонецФункции

Функция ШаблонРезультата()
	
	Результат = Новый Структура();
	Результат.Вставить("Всего", 0);
	Результат.Вставить("Загружено", 0);

	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьУниверсальнымОбменом(ФайлыВыгрузки, ЗаписьОшибок) Экспорт
	
	Результат = ШаблонРезультата();
	
	ДвДанныеФайлаВыгрузки = Неопределено;
	Для каждого Файл Из ФайлыВыгрузки Цикл
		Если Файл.Имя = "ВыгрузкаУниверсальнымОбменом.xml" Тогда
			ДвДанныеФайлаВыгрузки = Файл.Адрес;
		КонецЕсли;
	КонецЦикла;

	Если ДвДанныеФайлаВыгрузки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяФайлаПротоколаОбмена = ПолучитьИмяВременногоФайла("txt");
	
	ИмяФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	ДвДанныеФайлаВыгрузки.Записать(ИмяФайлаОбмена);
	
	КоличествоВыгруженных = КоличествоВыгруженныхУниверсальнымОбменом(ИмяФайлаОбмена);
	Результат.Всего = КоличествоВыгруженных;
	
	ИмяОбработки = "УниверсальныйОбменДаннымиXML";
		
	Обработка = Обработки[ИмяОбработки].Создать();
	Обработка.РежимОбмена = "Загрузка";
	Обработка.НеВыводитьНикакихИнформационныхСообщенийПользователю = Истина;
	Обработка.ИмяФайлаОбмена = ИмяФайлаОбмена;  
	Обработка.ИмяФайлаПротоколаОбмена = ИмяФайлаПротоколаОбмена;
	
	Попытка
		
		Обработка.ОткрытьФайлЗагрузки(Истина);
		
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'универсальным обменом'")));
		Возврат Результат;
		
	КонецПопытки;
	
	Попытка
		
		Обработка.ВыполнитьЗагрузку();
		
		Результат.Загружено = Обработка.мСчетчикЗагруженныхОбъектов;
		
		Если Обработка.ФлагОшибки Тогда

			Ошибки = ОшибкиИзПротоколаУниверсальногоОбмена(ИмяФайлаПротоколаОбмена);
			Если ЗначениеЗаполнено(Ошибки) Тогда
				ДобавитьОшибку(ЗаписьОшибок, Ошибки);
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Загрузка",  НСтр("ru = 'универсальным обменом'")));
		Возврат Результат;
		
	КонецПопытки;

	Возврат Результат;
	
КонецФункции

Функция КоличествоВыгруженныхУниверсальнымОбменом(ИмяФайла)
	
	// Удаляем последнюю строчку с количеством выгруженных
	ВременныйФайл = ИмяФайла + ".tmp";
	
	Чтение = Новый ЧтениеТекста(ИмяФайла);
	Запись = Новый ЗаписьТекста(ВременныйФайл);
	
	ПредыдущаяСтрока = "";
	ТекущаяСтрока = Чтение.ПрочитатьСтроку();
	
	Пока ТекущаяСтрока <> Неопределено Цикл
		Если ПредыдущаяСтрока <> "" Тогда
			Запись.ЗаписатьСтроку(ПредыдущаяСтрока);
		КонецЕсли;
		ПредыдущаяСтрока = ТекущаяСтрока;
		ТекущаяСтрока = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	
	Чтение.Закрыть();
	Запись.Закрыть();
	
	// Заменяем оригинальный файл
	УдалитьФайлы(ИмяФайла);
	КопироватьФайл(ВременныйФайл, ИмяФайла);
	
	Части = СтрРазделить(ПредыдущаяСтрока, " ");
	Количество = Число(Части[1]);
	
	Возврат Количество;
	
КонецФункции

Функция РазобратьПротоколПодключенияЧерезШину(ФайлыВыгрузки, ЗаписьОшибок) Экспорт

	Результат = ШаблонРезультата();
	Результат.Вставить("ТекстОшибки", "");

	Для каждого Файл Из ФайлыВыгрузки Цикл
		Если Файл.Имя = "PIN_ERROR.txt" Тогда

			Путь = ПолучитьИмяВременногоФайла("txt");
			ДвДанные = Файл.Адрес;
			ДвДанные.Записать(Путь);

			Ошибки = ОшибкиИзФайла(Путь);
			Результат.ТекстОшибки = НСтр("ru = 'Не удалось настроить постоянное подключение с базой для автоматического заполнения регламентированных отчетов в будущем по причине:'")
				+ Символы.ПС
				+ Ошибки;

			Результат.Всего = 1;

			Прервать;

		ИначеЕсли Файл.Имя = "PIN_READY.txt" Тогда

			Результат.Всего = 1;
			Результат.Загружено = 1;

			Прервать;

		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура УстановитьИспользоватьНесколькоОрганизаций()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Количество = РезультатЗапроса.Выбрать().Количество();
	
	Константа = "ИспользоватьНесколькоОрганизаций";
	Если Количество > 1 И Константы[Константа].Получить() = Ложь Тогда
		Константы[Константа].Установить(Истина);
	КонецЕсли;

КонецПроцедуры

