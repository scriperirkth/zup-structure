Функция ВыгрузитьНужныхСотрудников(ОрганизацииМассив, ФизЛица, ЗаписьОшибок)
	
	РезультатВсе = Новый Массив;

	ДанныеВсехСотрудников = Неопределено;
	Попытка
		ПолучитьСотрудниковОрганизаций(ОрганизацииМассив, ДанныеВсехСотрудников);
	Исключение
		ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка", НСтр("ru = 'сотрудников организаций'")));
		Возврат РезультатВсе;
	КонецПопытки;

	Если ДанныеВсехСотрудников = Неопределено Тогда
		Возврат РезультатВсе;
	КонецЕсли;

	Для каждого Организация Из ОрганизацииМассив Цикл

		Попытка

			ДанныеСотрудников = ДанныеВсехСотрудников.НайтиСтроки(Новый Структура("ТекущаяОрганизация", Организация));

			Если ДанныеСотрудников <> Неопределено Тогда
				Для каждого ДанныеСотрудника Из ДанныеСотрудников Цикл

					Попытка

						ДобавитьФизЛицо(ФизЛица, ДанныеСотрудника.ФизическоеЛицо, Организация);

						РезультатОдин = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеСотрудника);
						РезультатОдин.Удалить("ТекущаяОрганизация");
						РезультатОдин.ГоловнаяОрганизация = GUID(РезультатОдин.ГоловнаяОрганизация);
						РезультатОдин.ФизическоеЛицо = GUID(РезультатОдин.ФизическоеЛицо);
						
						РезультатОдин.Вставить("УникальныйИдентификатор", GUID(РезультатОдин.Сотрудник));
						РезультатОдин.Удалить("Сотрудник");
						
						СкорректироватьЗначения(РезультатОдин);
						РезультатВсе.Добавить(РезультатОдин);

					
					Исключение
						
						ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'сотрудника'"), ДанныеСотрудника.ФизическоеЛицо));
					
					КонецПопытки;
					
				КонецЦикла;
			КонецЕсли;
		
		Исключение
			
			ДобавитьОшибку(ЗаписьОшибок, Ошибка(ИнформацияОбОшибке(), "Выгрузка",  НСтр("ru = 'сотрудников организации'"), Организация));
		
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат РезультатВсе;
	
КонецФункции

Функция GUID(Ссылка)
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	Иначе
		Возврат ""
	КонецЕсли;
	
КонецФункции

Функция ДобавитьФизЛицо(ФизЛица = Неопределено, ФизЛицо = Неопределено, Организация = Неопределено)
	
	Если ФизЛица <> Неопределено И ЗначениеЗаполнено(ФизЛицо) И ФизЛица.Найти(ФизЛицо, "ФизЛицо") = Неопределено Тогда
		НоваяСтрока = ФизЛица.Добавить();
		НоваяСтрока.ФизЛицо = ФизЛицо;
		НоваяСтрока.Организация = Организация;
	КонецЕсли;
	
КонецФункции

Функция ВыгрузитьСтраныМира()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	*
		|ИЗ
		|	Справочник.СтраныМира КАК СтраныМира";
		
	Таблица = Запрос.Выполнить().Выгрузить();
	РезультатВсе = ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
	Для каждого РезультатОдин Из РезультатВсе Цикл
		
		РезультатОдин.Вставить("УникальныйИдентификатор", GUID(РезультатОдин.Ссылка));
		РезультатОдин.Удалить("Ссылка");
		РезультатОдин.Удалить("ВерсияДанных");
		
		СкорректироватьЗначения(РезультатОдин);
	
	КонецЦикла;
	
	Возврат РезультатВсе;
	
КонецФункции

