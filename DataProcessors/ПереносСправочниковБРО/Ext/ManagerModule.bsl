#Область Выгрузка

Процедура НачатьВыгрузкуДанных(ВходящийКонтекст, АдресРезультата) Экспорт
	
	СписокОрганизаций = ВходящийКонтекст.СписокОрганизаций;
	ВерсияБРО = ВходящийКонтекст.ВерсияБРО;
	ВерсияБСП = ВходящийКонтекст.ВерсияБСП;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОрганизацииМассив = ОрганизацииМассивом(СписокОрганизаций);
	
	НужныеМЧД        = ПолучитьНужныеМЧД(ОрганизацииМассив);
	ФизЛицаИзМЧД     = ФизЛицаИзМЧД(НужныеМЧД);
	КонтрагентыИзМЧД = КонтрагентыИзМЧД(НужныеМЧД);
	
	ПутьФайлаОшибок = ПолучитьИмяВременногоФайла("txt");
	ЗаписьОшибок = Новый ЗаписьТекста; 
	ЗаписьОшибок.Открыть(ПутьФайлаОшибок,,,Истина);
	
	Результат = Новый Структура();
	Результат.Вставить("ВыгрузкаСправочников", ВыгрузитьСправочники(ОрганизацииМассив, НужныеМЧД, ФизЛицаИзМЧД, КонтрагентыИзМЧД, ЗаписьОшибок));
	Результат.Вставить("ВыгрузкаМЧДФНСиУПУП", ВыгрузитьМЧДФНСиУПУП(ОрганизацииМассив, ЗаписьОшибок));
	Результат.Вставить("ВыгрузкаУниверсальнымОбменом", ВыгрузитьДанныеУниверсальнымОбменом(ОрганизацииМассив, НужныеМЧД, ФизЛицаИзМЧД, КонтрагентыИзМЧД, ВерсияБРО, ВерсияБСП, ЗаписьОшибок));
	
	ЗаписьОшибок.Закрыть();
	Результат.Вставить("Ошибки", Новый ДвоичныеДанные(ПутьФайлаОшибок));
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
		
КонецПроцедуры

Функция ИнициализироватьТаблицуФизЛиц() Экспорт
	
	ФизЛица = Новый ТаблицаЗначений;
	ФизЛица.Колонки.Добавить("ФизЛицо");
	ФизЛица.Колонки.Добавить("Организация");
	
	Возврат ФизЛица;
		
КонецФункции

// Шаблон запроса выборки по описанию поля МЧД
//
// Возвращаемое значение:
//  Строка
//
Функция ШаблонЗапросаПоМЧД()

	Возврат
		"ВЫБРАТЬ
		|	&ВыбираемоеПоле КАК Результат
		|ИЗ
		|	&ИмяТаблицы КАК Источник
		|ГДЕ
		|	НЕ &ПометкаУдаления
		|	И &УсловиеОтбора";

КонецФункции

// Собирает часть текста запроса по одному описанию поля МЧД
//
// Параметры:
//  Описание - См. ШаблонПолейМЧД
//  ВыбираемоеПоле - Строка - выражение для списка выборки
//  УсловиеОтбора - Строка - условие отбора без ведущего И
//
// Возвращаемое значение:
//  Строка
//
Функция ЧастьЗапросаПоМЧД(Описание, ВыбираемоеПоле, УсловиеОтбора)

	ИмяТаблицы = Описание.Вид + "." + Описание.Источник
		+ ?(ЗначениеЗаполнено(Описание.ТЧ), "." + Описание.ТЧ, "");
	ПометкаУдаления = "Источник." + ?(ЗначениеЗаполнено(Описание.ТЧ), "Ссылка.", "") + "ПометкаУдаления";

	Часть = СтрЗаменить(ШаблонЗапросаПоМЧД(), "&ВыбираемоеПоле", ВыбираемоеПоле);
	Часть = СтрЗаменить(Часть, "&ИмяТаблицы", ИмяТаблицы);
	Часть = СтрЗаменить(Часть, "&ПометкаУдаления", ПометкаУдаления);

	Возврат СтрЗаменить(Часть, "&УсловиеОтбора", УсловиеОтбора);

КонецФункции

// Выбирает МЧД по всем описаниям полей одним запросом
//
// Параметры:
//  Описания - См. ШаблонПолейМЧД
//  ОрганизацииМассив - Массив из СправочникСсылка.Организации
//
// Возвращаемое значение:
//  Массив из ЛюбаяСсылка - найденные МЧД
//
Функция ВыбратьМЧДПоОписаниям(Описания, ОрганизацииМассив)

	Если Описания.Количество() = 0 ИЛИ ОрганизацииМассив.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Части = Новый Массив;
	Для каждого Описание Из Описания Цикл
		Условие = СтрЗаменить("&ИмяПоля В (&Организации)", "&ИмяПоля", "Источник." + Описание.Поле);
		Части.Добавить(ЧастьЗапросаПоМЧД(Описание, "Источник.Ссылка", Условие));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС);
	Запрос.УстановитьПараметр("Организации", ОрганизацииМассив);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Результат");

КонецФункции

// Выбирает значения полей нужного типа по всем описаниям одним запросом
//
// Параметры:
//  Описания - См. ШаблонПолейМЧД
//  Ссылки - Массив из ЛюбаяСсылка - отобранные МЧД
//  Тип - Строка - имя справочника, значения которого нужны
//
// Возвращаемое значение:
//  Массив из ЛюбаяСсылка - значения найденного типа
//
Функция ВыбратьПоляПоОписаниям(Описания, Ссылки, Тип)

	Если Описания.Количество() = 0 ИЛИ Ссылки.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Части = Новый Массив;
	Для каждого Описание Из Описания Цикл
		ИмяПоля = "Источник." + Описание.Поле;
		Условие = СтрЗаменить(
			"ТИПЗНАЧЕНИЯ(&ИмяПоля) = &ТипЗначения
			|	И Источник.Ссылка В (&Ссылки)", "&ИмяПоля", ИмяПоля);
		Условие = СтрЗаменить(Условие, "&ТипЗначения", "ТИП(Справочник." + Тип + ")");
		Части.Добавить(ЧастьЗапросаПоМЧД(Описание, ИмяПоля, Условие));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Результат");

КонецФункции

Процедура ДобавитьСвойствоМЧД(ТЗ, Вид, Источник, ТЧ, Поле) Экспорт
	
	НоваяСтрока = ТЗ.Добавить();
	НоваяСтрока.Вид = Вид;
	НоваяСтрока.Источник = Источник;
	НоваяСтрока.ТЧ = ТЧ;
	НоваяСтрока.Поле = Поле;
	
КонецПроцедуры

// Шаблон таблицы описаний полей МЧД
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//    * Вид - Строка - вид объекта метаданных, Справочник или Документ
//    * Источник - Строка - имя объекта метаданных
//    * ТЧ - Строка - имя табличной части, пустая строка если поле в самом объекте
//    * Поле - Строка - имя реквизита или колонки табличной части
//
Функция ШаблонПолейМЧД()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Свойства = Новый ТаблицаЗначений;
	Свойства.Колонки.Добавить("Вид", ТипСтрока);
	Свойства.Колонки.Добавить("Источник", ТипСтрока);
	Свойства.Колонки.Добавить("ТЧ", ТипСтрока);
	Свойства.Колонки.Добавить("Поле", ТипСтрока);

	Возврат Свойства;

КонецФункции

Функция ОрганизацииВМЧД() Экспорт
	
	ТЗ = ШаблонПолейМЧД();
	
	// МЧД ФНС
