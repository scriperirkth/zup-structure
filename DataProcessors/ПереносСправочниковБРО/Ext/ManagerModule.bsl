#КонецОбласти

#Область ПодключениеУчетнойБазы

// Выполняет подключение учетной базы в фоне.
// 
// Параметры:
//  ПараметрЗапуска - Строка - 
// 
// Возвращаемое значение:
//  Строка
Функция ПодключитьУчетнуюБазуВФоне(ПараметрЗапуска) Экспорт

	МассивПараметров = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПараметрЗапуска, ";");

	ПинКод = "";
	ИндексПин = МассивПараметров.Найти("УстановитьПинКодИнтеграцииСОтчетностью");
	Если ИндексПин <> Неопределено Тогда
		ПинКод = МассивПараметров[ИндексПин + 1];
	КонецЕсли;

	Ошибка = "";
	Попытка
		РезультатПодключения = ИнтеграцияСОтчетность24ВызовСервера.ПодключитьсяИСохранитьНастройки(ПинКод, Ошибка);
		Если Не ЗначениеЗаполнено(Ошибка) И Не ПодключениеУспешно(РезультатПодключения) Тогда
			Ошибка = ТекстСостоянияПодключения(РезультатПодключения);
		КонецЕсли;
	Исключение
		Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Ошибка;

КонецФункции

Функция ПодключениеУспешно(РезультатПодключения)

	Если ТипЗнч(РезультатПодключения) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Состояние = 0;
	Если Не РезультатПодключения.Свойство("Состояние", Состояние) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Состояние = 1 Или Состояние = 3;

КонецФункции

Функция ТекстСостоянияПодключения(РезультатПодключения)

	ТекстСостояния = "";
	Если ТипЗнч(РезультатПодключения) = Тип("Структура") Тогда
		РезультатПодключения.Свойство("ТекстСостояния", ТекстСостояния);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстСостояния) Тогда
		ТекстСостояния = НСтр("ru = 'Не удалось подключить базу к приложению 1С-Отчетность'");
	КонецЕсли;

	Возврат ТекстСостояния;

КонецФункции

#КонецОбласти

#КонецЕсли