КонецПроцедуры

Функция ПоддерживаемыеНаправленияОрганизации(Организация) Экспорт
	
	Направления = Новый Массив;
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФНС);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ПФР);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФСГС);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФСС);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФСРАР);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.РПН);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);

	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФТС);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	Если ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует() Тогда
		ПараметрыНаправления = Новый Структура;
		ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ЦБ);
		ПараметрыНаправления.Вставить("Доступен", 	Истина);
		ПараметрыНаправления.Вставить("Подключить", Истина);
		Направления.Добавить(ПараметрыНаправления);
	КонецЕсли;
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиПереопределяемый.ОпределитьПодключаемыеНаправленияСдачиОтчетности(Организация, Направления);
	
	Возврат Направления;
	
КонецФункции

Функция Ошибка(ИнформацияОбОшибке, Действие, Знач Предмет = "", Ссылка = "")
	
	Предмет = СокрЛП(Предмет);
	
	Если Действие = "Выгрузка" Тогда
		Ошибка = СокрЛП(НСтр("ru = 'Не удалось выгрузить данные '") + Предмет + " " + Строка(Ссылка));
		ИмяСобытия = СокрЛП(НСтр("ru = 'Электронный документооборот с контролирующими органами.Выгрузка данных '") + Предмет);
	Иначе
		Ошибка = СокрЛП(НСтр("ru = 'Не удалось загрузить данные '") + Предмет + " " + Строка(Ссылка));
		ИмяСобытия = СокрЛП(НСтр("ru = 'Электронный документооборот с контролирующими органами.Загрузка данных '") + Предмет);
	КонецЕсли;

	ДокументооборотСКО.ОбработатьИсключениеУниверсальное(
		ИнформацияОбОшибке, 
		ИмяСобытия, 
		Ошибка);
		
	ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	
	ПолнаяОшибка = Ошибка + Символы.ПС + ПредставлениеОшибки;
	
	Возврат ПолнаяОшибка;

КонецФункции

Функция РегистрацияВНалоговомОргане(Организация, СвойстваОрганизации)
	
	ЭтоЮридическоеЛицо = РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Организация);
	
	Если ЭтоЮридическоеЛицо Тогда
		КПП = СокрЛП(СвойстваОрганизации.КППЮЛ);
	Иначе
		КПП = "";
	КонецЕсли;
	
	КодНалоговогоОргана = СокрЛП(СвойстваОрганизации.КодНО);
	Регистрация = КонтекстЭДОСервер().РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана, КПП);
	
	Возврат Регистрация;
	
КонецФункции

Функция РегистрацияВНалоговомОрганеКрупнейшего(Организация, СвойстваОрганизации)
	
	ЭтоЮридическоеЛицо = РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Организация);
	
	Если ЭтоЮридическоеЛицо Тогда
		КПП = СокрЛП(СвойстваОрганизации.КППЮЛКрупнейший);
	Иначе
		КПП = "";
	КонецЕсли;
	
	КодНОКрупнейший = СокрЛП(СвойстваОрганизации.КодНОКрупнейший);
	РегистрацияКрупнейшего = КонтекстЭДОСервер().РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНОКрупнейший, КПП);
	
	Возврат РегистрацияКрупнейшего;
	
КонецФункции

Функция ВыгрузитьКонтактнуюИнформациюОрганизации(Ссылка)
	
	Результат = Новый Массив;
	
	ТЗ = Ссылка.КонтактнаяИнформация.Выгрузить();
	Массив = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗ);
	
	Для каждого Строка Из Массив Цикл
		
		ИмяПредопределенныхДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Вид, "ИмяПредопределенныхДанных");
		Если НЕ ЗначениеЗаполнено(ИмяПредопределенныхДанных) Тогда
			Продолжить;
		КонецЕсли;
		
		Тип = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИмяПеречисления(Строка.Тип);
		Строка.Тип = "Перечисление.ТипыКонтактнойИнформации." + Тип;
		Строка.Вид = "Справочник.ВидыКонтактнойИнформации." + ИмяПредопределенныхДанных;
		
		СкорректироватьЗначения(Строка);
		
		Результат.Добавить(Строка);
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура СкорректироватьЗначения(Записи)
	
	Для каждого Запись Из Записи Цикл
		
		Тип = ТипЗнч(Запись.Значение);
		
		Если Тип <> Тип("Строка")
			И Тип <> Тип("Число")
			И Тип <> Тип("Булево")
			И Тип <> Тип("Массив")
			И Тип <> Тип("ФиксированныйМассив")
			И Тип <> Тип("Структура")
			И Тип <> Тип("ФиксированнаяСтруктура")
			И Тип <> Тип("Соответствие")
			И Тип <> Тип("Дата") Тогда
			
			Записи.Вставить(Запись.Ключ, Строка(Запись.Значение));
	
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

// Получает данные сотрудников по организациям одним запросом
//
// Параметры:
//  ОрганизацииМассив - Массив из СправочникСсылка.Организации
//  ДанныеСотрудников - Неопределено - на входе
//                    - ТаблицаЗначений - на выходе данные из регистра ТекущиеКадровыеДанныеСотрудников:
//                        * Сотрудник - СправочникСсылка.Сотрудники
//                        * ГоловнаяОрганизация - СправочникСсылка.Организации
//                        * ФизическоеЛицо - СправочникСсылка.ФизическиеЛица
//                        * ТекущаяОрганизация - СправочникСсылка.Организации
//
Процедура ПолучитьСотрудниковОрганизаций(ОрганизацииМассив, ДанныеСотрудников)

	Если Метаданные.РегистрыСведений.Найти("ТекущиеКадровыеДанныеСотрудников") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТекущиеКадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
		|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация КАК ТекущаяОрганизация
		|ИЗ
		|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		|ГДЕ
		|	ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация В (&Организации)";

	Запрос.УстановитьПараметр("Организации", ОрганизацииМассив);

	ДанныеСотрудников = Запрос.Выполнить().Выгрузить();

КонецПроцедуры

