	Попытка
	
		ВидДокумента = ПолучитьПредопределенное(Запись, "ВидДокумента");
	
		Если НЕ ЗначениеЗаполнено(ФизЛицо) ИЛИ НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
			Возврат;
		КонецЕсли;
		
		ИмяРегистра = "ДокументыФизическихЛиц";
		
