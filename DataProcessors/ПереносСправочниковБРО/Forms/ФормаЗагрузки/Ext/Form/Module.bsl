&НаКлиенте
Процедура НазадКВыборуБаз(Команда)
	
	АктивизироватьСтраницу(
		Элементы.СтраницыПомощника, 
		Элементы.СтраницаБазы);
	
КонецПроцедуры
	
&НаКлиенте
Процедура НазадКИнтро(Команда)
	
	АктивизироватьСтраницу(
		Элементы.СтраницыПомощника, 
		Элементы.СтраницаИнтро);
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьБыстрыйСтарт(Команда)

	// Этап 2: если на странице успеха отмечена галочка, Далее запускает тихое подключение,
	// а не закрывает мастер.
	Если СостояниеУспеха = "Загрузка" И ЗаполнятьРегОтчеты Тогда
		НачатьПодключениеУчетнойБазы();
		Возврат;
	КонецЕсли;

	ПрограммноеЗакрытие = Истина;

	Если НужноПоказатьБС Тогда

		Если ПомощникОткрытПервымЗапуском() Тогда
			ДокументооборотСКОВызовСервера.УбратьПанельРазделов();
			ОбновитьИнтерфейс();
		КонецЕсли;
		
		ПоказатьБС();

		ПодключитьОбработчикОжидания("Подключаемый_Закрыть", 1, Истина);

	Иначе

		// Для режима независимого запуска
		Закрыть();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКВыборуБазы(Команда)
	
	ТаблицаПути.Очистить();
	
	ТекстСообщения = НСтр("ru = 'Для получения списка баз данных требуется установить расширение.'");
	Обработчик = Новый ОписаниеОповещения("ЗаполнениеСпискаИБПослеПодключенияРасширения", ЭтотОбъект);
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(Обработчик, ТекстСообщения, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьБазу(Команда)
	
	Если Элементы.ТаблицаПути.ТекущиеДанные = Неопределено И НЕ ЯРаботаюИзБраузера Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Выберите базу в списке.
				|Если нужной базы там нет, отметьте ""Я работаю из браузера и моей базы нет в этом списке"" и укажите путь к ней.'"),
			, "ТаблицаПути");
		Возврат;
	КонецЕсли;
	
	Если ЯРаботаюИзБраузера И Не ЗначениеЗаполнено(ПутьКБазеИзБраузера) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите путь к базе'"),,"ПутьКБазеИзБраузера");
		Возврат;
	КонецЕсли;
	
	Если ЯРаботаюИзБраузера Тогда
		ИмяИБ     = "";
		ПутьКБазе = ПутьКБазеИзБраузера;
		Платформа = "";
	Иначе
		ИмяИБ     = Элементы.ТаблицаПути.ТекущиеДанные.Имя;
		ПутьКБазе = Элементы.ТаблицаПути.ТекущиеДанные.Путь;
		Платформа = Элементы.ТаблицаПути.ТекущиеДанные.ВерсияПлатформы;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьБазу_ПослеПредупреждения", 
		ЭтотОбъект);
		
	Текст = НСтр("ru = 'Сейчас будет открыта выбранная база для выгрузки данных из нее. Следуйте инструкциям в базе. Когда выгрузка закончится, база будет закрыта автоматически'");
	
	ПоказатьПредупреждение(ОписаниеОповещения, Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьИТС(Команда)
	
	Если Не ЗначениеЗаполнено(ЛогинИнтернетПоддержки) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Введите логин'"),, "ЛогинИнтернетПоддержки");
		
		Возврат;
		
	ИначеЕсли Не ЗначениеЗаполнено(ПарольИнтернетПоддержки) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Введите пароль'"),, "ПарольИнтернетПоддержки");
		
		Возврат;
		
	КонецЕсли;
	
	ПодключитьИнтернетПоддержку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьИТСПозже(Команда)
	
	СохранитьНеПредлагатьПодключитьИТС();
	
КонецПроцедуры

&НаКлиенте
Процедура НазадКБыстромуСтарту(Команда)
	
	ПрограммноеЗакрытие = Истина;
	
	ПоказатьБС();
	
	ПодключитьОбработчикОжидания("Подключаемый_Закрыть", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытием_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	Если БольшеНеПоказыватьПеренос Тогда
		СохранитьБольшеНеПоказывать();
	КонецЕсли;
	
	УдалитьВременныеФайлыИзКаталога(ПапкаОбмена);

	// Чтобы обновился календарь отчетности
	ОбновитьИнтерфейс();
	
	Если НужноПоказатьБС Тогда
		Оповещение = Новый ОписаниеОповещения("ПоказатьБС", ЭтотОбъект);
		ВыполнитьОбработкуОповещения(Оповещение);
	КонецЕсли;
	
	// После завершения этого метода закрытие произойдет автоматически
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьБС(Результат = Неопределено, ВходящийКонтекст = Неопределено) Экспорт
	
	ОбновитьСписокЗагруженныхОрганизаций();
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПараметрыФормыБыстрыйСтарт", "");
	Если ЗначениеЗаполнено(СписокОрганизаций) Тогда
		ДополнительныеПараметры.Вставить("ОрганизацииЗагруженныеИзДругихБаз", СписокОрганизаций.ВыгрузитьЗначения());
		Облачная1СОСлужебныйКлиентПереопределяемый.ОткрытьФормуУспешнойЗагрузкиОрганизацийИзБазы(ДополнительныеПараметры);
	Иначе
		Если ЗначениеЗаполнено(СостояниеУспеха) Тогда
			ДополнительныеПараметры.Вставить("НовыхОрганизацийИзБазыНеПоявилось", Истина);
		КонецЕсли;
		Облачная1СОСлужебныйКлиентПереопределяемый.ОткрытьФормуБыстрогоСтартаСВыборомСпособаДобавленияОрганизации(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьБольшеНеПоказывать()
	
	ДокументооборотСКОВызовСервера.СохранитьНастройку("Облачная1СО_ЗаблокироватьПереносСправочников", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Закрыть()
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Функция НужноПоказатьБыстрыйСтартО1СО()

	Возврат ЗначениеЗаполнено(ПараметрыФормыБыстрыйСтарт);

КонецФункции

// Возвращает признак того, что помощник открыт автоматически при первом запуске.
&НаКлиенте
Функция ПомощникОткрытПервымЗапуском()
	
	Возврат СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиента().ДокументооборотСКонтролирующимиОрганами_ПоказатьБыстрыйСтартО1СО;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьБазу_ПослеПредупреждения(ВходящийКонтекст) Экспорт
	
	ЭтоБазаВВебе = СтрНайти(ВРег(ПутьКБазе), "HTTP") ИЛИ ЯРаботаюИзБраузера;
	
	Если ЭтоБазаВВебе Тогда
		НачатьОткрытиеБазыПользователя(, Истина);
	Иначе
		ВыполнитьКомандуПолученияПутиДоПрофиляAllUsers();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьОшибкуВыгрузки(Форма, ЭтоЧастичныйУспех, ТекстОшибки = "", ВыгрузкаБылаПрервана = Ложь, Результат = Неопределено)
	
	Элементы = Форма.Элементы;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ЗаписатьОшибку(ТекстОшибки);
	КонецЕсли;
	
	Элементы.СтраницаОшибки_ПояснениеЧастичныйУспех.Видимость = ЭтоЧастичныйУспех И НЕ ВыгрузкаБылаПрервана;
	Элементы.СтраницаОшибки_ПояснениеНеудача.Видимость = НЕ ЭтоЧастичныйУспех И НЕ ВыгрузкаБылаПрервана;
	Элементы.СтраницаОшибки_ВыгрузкаБылаПрервана.Видимость = ВыгрузкаБылаПрервана;
	
	Если ЭтоЧастичныйУспех И НЕ ВыгрузкаБылаПрервана Тогда
		Если Форма.НужноПоказатьБС Тогда
			Элементы.СтраницаОшибки_Прервать.Заголовок = НСтр("ru = 'Далее'");
		Иначе
			Элементы.СтраницаОшибки_Прервать.Заголовок = НСтр("ru = 'Закрыть'");
		КонецЕсли;
		Элементы.СтраницаОшибки_Прервать.ЦветФона = ЦветКнопкиБРО();
		Элементы.СтраницаОшибки_Прервать.Шрифт = Новый Шрифт(ОбычныйШрифтТекста(), , 12, Истина);
	Иначе
		Элементы.СтраницаОшибки_Прервать.Заголовок = НСтр("ru = 'Прервать'");
	КонецЕсли;
	
	Элементы.СтраницаОшибки_Количество.Видимость = Результат <> Неопределено;

	СтатусПодключения = Неопределено;
	ЕстьОшибкаПодключения = Результат <> Неопределено
		И Результат.Свойство("ПодключениеЧерезШину", СтатусПодключения)
		И ТипЗнч(СтатусПодключения) = Тип("Структура")
		И СтатусПодключения.Состояние = "Ошибка";

	Форма.СтатусПодключенияБазы = ?(ЕстьОшибкаПодключения, СтатусПодключения.ТекстОшибки, "");

	Элементы.СтраницаОшибки_Соединение.Видимость =
		ЕстьОшибкаПодключения ИЛИ Форма.ЕстьОшибкаПолученияПинКода;
	Элементы.СтраницаОшибки_ТекстОшибкиСоединения.Видимость = ЗначениеЗаполнено(Форма.СтатусПодключенияБазы);
	
	Если Результат <> Неопределено Тогда
		
		Процент = ?(Результат.Всего = 0, 0, Цел(100*(Результат.Загружено/Результат.Всего)));
		
		Текст = НСтр("ru = 'Загружено объектов: %1 из %2 (%3)'");
		Текст = СтрШаблон(Текст, Результат.Загружено, Результат.Всего, Строка(Процент) + "%");
		
		Элементы.СтраницаОшибки_Количество.Заголовок = Текст;
		
	КонецЕсли;
	
	Элементы.СтраницаОшибки_Треугольник.Картинка = БиблиотекаКартинок.ТреугольникВниманиеОранжевыйАнимированный;
	
	АктивизироватьСтраницу(
		Элементы.СтраницыПомощника, 
		Элементы.СтраницаОшибки);
		
	Форма.ПодключитьОбработчикОжидания("ЗаменитьТреугольникНаСтатику", 2, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаписатьОшибку(Ошибка)

	ЗаписьЖурналаРегистрации(
		СокрЛП(НСтр("ru = 'Электронный документооборот с контролирующими органами.Не удалось загрузить справочники'")), 
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Ошибка);

КонецФункции
	
&НаКлиенте
Процедура ВыполнитьКомандуПолученияПутиДоПрофиляAllUsers()
	
	ИмяФайлаВывода = КаталогДанныхПользователяКэш + Строка(Новый УникальныйИдентификатор) + ".txt";
	
	ОповещениеОЗапуске = Новый ОписаниеОповещения("ПрочитатьФайлПутиДоПрофиляAllUsers", ЭтотОбъект, ИмяФайлаВывода);
	
	Если ЭтоЛинукс Или ЭтоМак Тогда
		ТекстКоманды = "echo ~/ > '" + ИмяФайлаВывода + "'";
	Иначе
		ТекстКоманды = "cmd /S /C ""echo %ALLUSERSPROFILE% > " + ИмяФайлаВывода + """";
	КонецЕсли;
	
	НачатьЗапускПриложения(ОповещениеОЗапуске, ТекстКоманды, , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайлПутиДоПрофиляAllUsers(Результат, ИмяФайлаВывода) Экспорт
	
	Если Результат = 0 Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ТекстовыйДокумент", ТекстовыйДокумент);
		ДополнительныеПараметры.Вставить("ИмяФайла", ИмяФайлаВывода);
		ТекстовыйДокумент.НачатьЧтение(Новый ОписаниеОповещения("ПослеЧтенияФайлаПутиДоПрофиляAllUsers", ЭтотОбъект, ДополнительныеПараметры), ИмяФайлаВывода);
	Иначе
		ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь, НСтр("ru='Не удалось получить список установленных платформ 1С:Предприятие'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЧтенияФайлаПутиДоПрофиляAllUsers(ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.ТекстовыйДокумент.КоличествоСтрок() > 0 Тогда
		
		ПутьДоПрофиляAllUsers = СокрЛП(ДополнительныеПараметры.ТекстовыйДокумент.ПолучитьСтроку(1)); // C:\ProgramData
		УдалитьВременныеФайлыИзКаталога(ДополнительныеПараметры.ИмяФайла);
		
		// C:\ProgramData\1C\1CEStart\1cestart.cfg
		Если ЭтоЛинукс Или ЭтоМак Тогда
			ПутьККонфигурационномуФайлу = ПутьДоПрофиляAllUsers + "/.1C/1cestart/1cestart.cfg";
		Иначе
			ПутьККонфигурационномуФайлу = ПутьДоПрофиляAllUsers + "\1C\1CEStart\1cestart.cfg";
		КонецЕсли;
		
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеНачалаЧтенияКонфигурационногоФайла", ЭтотОбъект, ТекстовыйДокумент);
		
		ТекстовыйДокумент.НачатьЧтение(ОписаниеОповещения, ПутьККонфигурационномуФайлу);

	Иначе
		
		ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь, НСтр("ru='Не удалось прочитать список установленных платформ 1С:Предприятие'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеНачалаЧтенияКонфигурационногоФайла(ТекстовыйДокумент) Экспорт
	
	ПутиСтартеров = Новый Массив;
	Для НомерСтроки = 1 По ТекстовыйДокумент.КоличествоСтрок() Цикл
		ТекущаяСтрока = ТекстовыйДокумент.ПолучитьСтроку(НомерСтроки);
		Если СтрНачинаетсяС(ТекущаяСтрока, "InstalledLocation=") Тогда
			Если ЭтоЛинукс Или ЭтоМак Тогда
				ОкончаниеПути = "/common/1cestart";
			Иначе
				ОкончаниеПути = "\common\1cestart.exe";
			КонецЕсли;
			ПутиСтартеров.Добавить(Сред(ТекущаяСтрока, СтрДлина("InstalledLocation=") + 1) + ОкончаниеПути);
		КонецЕсли;
	КонецЦикла;
	
	ПутиНеНайдены = ПутиСтартеров.Количество() = 0;
	Если ПутиНеНайдены Тогда
		// https://its.1c.ru/db/v8313doc#bookmark:adm:TI000000072
		Если ЭтоМак Тогда
			ПутиСтартеров.Добавить("/opt/1cv8/common/1cestart");
			// Для 64-разрядной версии ОС: /opt/1cv8/A.B.C.D Здесь A.B.C.D ‑ полный номер используемой версии клиентского приложения. 
			// Для «1С:Предприятия» версии 8.3.7.1000, каталог расположения файла 1cestart будет следующим: /opt/1cv8/8.3.7.1000.
			Если ЗначениеЗаполнено(Платформа) Тогда
				ПутиСтартеров.Добавить("/opt/1cv8/" + Платформа + "/1cestart");
			КонецЕсли;
			ПутиСтартеров.Добавить("/opt/1cv8/" + ВерсияПриложения() + "/1cestart");
		ИначеЕсли ЭтоЛинукс Тогда
			// Добавим варианты позже
		Иначе
			// 32-разрядная система в 64-разрядной ОС: %PROGRAMFILES(x86)%\1cv8\common.
			ПутиСтартеров.Добавить("C:\Program Files (x86)\1cv8\common\1cestart.exe");
			// В остальных случаях: %PROGRAMFILES%\1cv8\common.
			ПутиСтартеров.Добавить("C:\Program Files\1cv8\common\1cestart.exe");
		КонецЕсли;
	КонецЕсли;
	
	Если ПутиНеНайдены И (ЭтоМак ИЛИ ЭтоЛинукс) Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ПутиСтартеров", ПутиСтартеров);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПослеПоискаПлатформНаМакОс", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
			
		Если ЭтоМак Тогда
			НачатьПоискФайлов(ОписаниеОповещения, "/opt/1cv8/", "1cestart", Истина);
		ИначеЕсли ЭтоЛинукс Тогда
			// При попытке запуска в Линукс файла 1cestart можем получить ошибку:
			// 1cestart: error while loading shared libraries: libwebkit2gtk-4.0.so.37: cannot open shared object file: No such file or directory
			// Поэтому пробуем сразу платформу запускать
			НачатьПоискФайлов(ОписаниеОповещения, "/opt/1cv8/", "1cv8", Истина);
		КонецЕсли;
	Иначе
		НачатьПроверкуСуществованияПутейСтартеров(ПутиСтартеров);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПоискаПлатформНаМакОс(НайденныеФайлы, ВходящийКонтекст) Экспорт
	
	ПутиСтартеров = ВходящийКонтекст.ПутиСтартеров;
	
	ПутиСтартеровНовые = Новый Массив;
	Для каждого Файл Из НайденныеФайлы Цикл
		ПутиСтартеровНовые.Добавить(Файл.ПолноеИмя);
	КонецЦикла;
	
	СортироватьМассив(ПутиСтартеровНовые);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПутиСтартеров, ПутиСтартеровНовые, Истина);
	
	Если ЭтоЛинукс Тогда
		// Будем пробовать в самом конце, потому что может возникнуть ошибка
		// 1cestart: error while loading shared libraries: libwebkit2gtk-4.0.so.37: cannot open shared object file: No such file or directory
		ПутиСтартеров.Добавить("/opt/1cv8/common/1cestart");
		// Для 32-разрядной версии ОС: /opt/1C/v8.3/i386.
		ПутиСтартеров.Добавить("/opt/1C/v8.3/i386/1cestart");
		// Для 64-разрядной версии ОС: /opt/1C/v8.3/x86_64.
		ПутиСтартеров.Добавить("/opt/1C/v8.3/x86_64/1cestart");
	КонецЕсли;
	
	НачатьПроверкуСуществованияПутейСтартеров(ПутиСтартеров);

КонецПроцедуры

&НаКлиенте
Процедура СортироватьМассив(Массив)

	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(Массив);
	СписокЗначений.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Массив = СписокЗначений.ВыгрузитьЗначения(); 

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВерсияПриложения()

	АктуальнаяСистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат АктуальнаяСистемнаяИнформация.ВерсияПриложения;

КонецФункции

&НаКлиенте
Процедура НачатьПроверкуСуществованияПутейСтартеров(ПутиСтартеров) Экспорт
	
	Если ПутиСтартеров.Количество() > 0 Тогда
		
		ПроверяемыйПуть = ПутиСтартеров[0];
		ФайлСтартера    = Новый Файл(ПроверяемыйПуть);
		ПутиСтартеров.Удалить(0);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПутиСтартеров", ПутиСтартеров);
		ДополнительныеПараметры.Вставить("ПроверяемыйПуть", ПроверяемыйПуть);
	
		Оповещение = Новый ОписаниеОповещения("ВыгрузкаЗагрузкаПакетныйРежимПроверкаПутиПлатформы", ЭтотОбъект, ДополнительныеПараметры);
		ФайлСтартера.НачатьПроверкуСуществования(Оповещение);
		
	Иначе
		ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь, НСтр("ru='Не найдена установленная платформа 1С:Предприятие'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаЗагрузкаПакетныйРежимПроверкаПутиПлатформы(ФайлСуществует, ДополнительныеПараметры) Экспорт
	
	Если Не ФайлСуществует Тогда
		НачатьПроверкуСуществованияПутейСтартеров(ДополнительныеПараметры.ПутиСтартеров)
	Иначе
		НачатьОткрытиеБазыПользователя(ДополнительныеПараметры.ПроверяемыйПуть);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОткрытиеБазыПользователя(ПутьФайлаЗапуска = "", ЭтоВеб = Ложь, ТолькоПодключение = Ложь)

	ЭтоБазаВВебе = ЭтоВеб;
	РежимТолькоПодключение = ТолькоПодключение;
	Если Не ЭтоВеб И ЗначениеЗаполнено(ПутьФайлаЗапуска) Тогда
		ПутьФайлаЗапускаПлатформы = ПутьФайлаЗапуска;
	КонецЕсли;

	ИмяПользователя = Пользователь;
	Если СтрНайти(ИмяПользователя, """") Тогда
		ИмяПользователя = СтрЗаменить(ИмяПользователя, """", """""");
	КонецЕсли;
	
	ПарольПользователя = Пароль;
	Если СтрНайти(ПарольПользователя, """") Тогда
		ПарольПользователя = СтрЗаменить(ПарольПользователя, """", """""");
	КонецЕсли;
	
	МассивЧастейКоманды = Новый Массив;
	
	Если ЭтоБазаВВебе Тогда
		Если Лев(ПутьКБазе, 3) = "ws=" Тогда
			ПутьКБазе = СтрЗаменить(ПутьКБазе, "ws=""", "");
			ПутьКБазе = СтрЗаменить(ПутьКБазе, """;", "");
		КонецЕсли;
		
		Если НЕ СтрНайти(ПутьКБазе, "http") Тогда
			ПутьКБазе = "http://" + ПутьКБазе;
		КонецЕсли;
			
		МассивЧастейКоманды.Добавить(ПутьКБазе);
	Иначе
		Если НЕ ЭтоЛинукс Тогда
			ПутьФайлаЗапуска = """" + ПутьФайлаЗапуска + """";
		КонецЕсли;
		
		МассивЧастейКоманды.Добавить(ПутьФайлаЗапуска);
		
		СтрокаСоединения = "ENTERPRISE /IBName&ИмяБазы";
		ИмяБазы = ИмяИБ;
		Если ЭтоЛинукс Тогда
			ИмяБазы = "'""" + ИмяБазы + """'";
		Иначе
			ИмяБазы = """" + ИмяБазы + """";
		КонецЕсли;
		СтрокаСоединения = СтрЗаменить(СтрокаСоединения, "&ИмяБазы", ИмяБазы);
		МассивЧастейКоманды.Добавить(СтрокаСоединения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяПользователя) Тогда
		Параметр = НормализованныйПараметр("N", ИмяПользователя, ЭтоБазаВВебе, Истина);
		МассивЧастейКоманды.Добавить(Параметр);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ПарольПользователя) Тогда
		Параметр = НормализованныйПараметр("P", ПарольПользователя, ЭтоБазаВВебе, НЕ ЗначениеЗаполнено(ИмяПользователя));
		МассивЧастейКоманды.Добавить(Параметр);
	КонецЕсли;
	
	Если РежимТолькоПодключение И НЕ ЭтоБазаВВебе Тогда
		МассивЧастейКоманды.Добавить("/DisableSplash");
		МассивЧастейКоманды.Добавить("/DisableStartupDialogs");
		МассивЧастейКоманды.Добавить("/DisableStartupMessages");
	КонецЕсли;

	ЭтоПервый = НЕ ЗначениеЗаполнено(ИмяПользователя) И НЕ ЗначениеЗаполнено(ПарольПользователя);
	ДобавитьПараметрыЗапускаС(МассивЧастейКоманды, ЭтоБазаВВебе, ЭтоПервый);
		
	ТекстКоманды = СтрСоединить(МассивЧастейКоманды, ?(ЭтоБазаВВебе,""," "));
	
	Если ЭтоБазаВВебе Тогда
		ТекстКомандыЗапуска = ПерекодироватьСтрокуЗапуска(ТекстКоманды);
	Иначе
		ТекстКомандыЗапуска = ТекстКоманды;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеОчисткиПапкиОбмена", 
		ЭтотОбъект,
		ТекстКомандыЗапуска);
	
	НачатьОчисткуКаталога(ОписаниеОповещения, ПапкаОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПараметрыЗапускаС(МассивЧастейКоманды, ЭтоБазаВВебе, ЭтоПервый)
	
	// ПереносСправочниковБРО;E:\1С\РАБОТЫ\2025\2025.03.10 CO-153 Загрузка справочников в обл. 1С-Отчетность\КаталогОбмена;БРО1.2.1.263;БСП3.1.11.142
	// ПереносСправочниковБРО;УстановитьПинКодИнтеграцииСОтчетностью;123456;E:\1С\РАБОТЫ\2025\2025.03.10 CO-153 Загрузка справочников в обл. 1С-Отчетность\КаталогОбмена;БРО1.2.1.263;БСП3.1.11.142
	
	МассивПараметрыЗапуска = Новый Массив;
	МассивПараметрыЗапуска.Добавить("ПереносСправочниковБРО");

	Если РежимТолькоПодключение Тогда
		МассивПараметрыЗапуска.Добавить("ТолькоПодключение");
	КонецЕсли;

	ДобавитьПараметрПинКод(МассивПараметрыЗапуска);

	МассивПараметрыЗапуска.Добавить(ПапкаОбмена);
	МассивПараметрыЗапуска.Добавить("БРО" + ВерсияБРО());
	МассивПараметрыЗапуска.Добавить("БСП" + ВерсияБСП());
	
	Значение = СтрСоединить(МассивПараметрыЗапуска, ";");
	Параметр = НормализованныйПараметр("C", Значение, ЭтоБазаВВебе, ЭтоПервый);
	
	МассивЧастейКоманды.Добавить(Параметр);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПараметрПинКод(МассивПараметрыЗапуска)
	
	ЕстьОшибкаПолученияПинКода = Ложь;

	// Пин выдается только на этапе подключения (этап 2). На этапе загрузки (этап 1) база
	// переносится без пина, решение о подключении принимается позже на странице успеха.
	Если РежимТолькоПодключение Тогда

		ПинКод = ПолучитьПинКод();
		Если ЗначениеЗаполнено(ПинКод) Тогда
			МассивПараметрыЗапуска.Добавить("УстановитьПинКодИнтеграцииСОтчетностью");
			МассивПараметрыЗапуска.Добавить(ПинКод);
		Иначе
			ЕстьОшибкаПолученияПинКода = Истина;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция НормализованныйПараметр(ИмяПараметра, Значение, ЭтоБазаВВебе, ЭтоПервый = Ложь)

	Если ЭтоБазаВВебе Тогда
		Результат = ?(ЭтоПервый, "?", "&") + "&ИмяПараметра=&Значение";
	ИначеЕсли ЭтоЛинукс Тогда
		Результат = ?(ЭтоПервый, "", " ") + "/&ИмяПараметра'""&Значение""'";
	Иначе
		Результат = ?(ЭтоПервый, "", " ") + "/&ИмяПараметра""&Значение""";
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&ИмяПараметра", ИмяПараметра);
	Результат = СтрЗаменить(Результат, "&Значение", Значение);

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеОчисткиПапкиОбмена(Результат, ТекстКомандыЗапуска) Экспорт
	
	ОповещениеОЗапуске = Новый ОписаниеОповещения(
		"ПослеОткрытияБазыПользователя", 
		ЭтотОбъект);

	НачатьЗапускПриложения(ОповещениеОЗапуске, ТекстКомандыЗапуска, , Ложь);

КонецПроцедуры

&НаСервере
Функция ПерекодироватьСтрокуЗапуска(ТекстКоманды)
	
	Возврат КодироватьСтроку(ТекстКоманды, СпособКодированияСтроки.URLВКодировкеURL);

КонецФункции

&НаСервере
Функция ПолучитьПинКод()

	// Подключаем именно загруженные в этой сессии организации, а не все.
	// На этом шаге СписокОрганизаций еще хранит снимок до загрузки (штатный пересчет позже),
	// поэтому разница со списком после загрузки дает загруженные организации.
	// Пустой список трактуется шиной как все.
	СписокПодключаемыхОрганизаций = Новый СписокЗначений;
	Для Каждого Организация Из ПолучитьСписокОрганизаций() Цикл
		Если СписокОрганизаций.НайтиПоЗначению(Организация) = Неопределено Тогда
			СписокПодключаемыхОрганизаций.Добавить(Организация, , Истина);
		КонецЕсли;
	КонецЦикла;

	МодульСервисИнтеграцииСУчетнымиСистемамиВызовСервера = ОбщегоНазначения.ОбщийМодуль("СервисИнтеграцииСУчетнымиСистемамиВызовСервера");

	Результат = МодульСервисИнтеграцииСУчетнымиСистемамиВызовСервера.ИнициироватьПодключение(СписокПодключаемыхОрганизаций);
	Если Результат.Свойство("КодовоеСлово") Тогда
		Возврат Результат.КодовоеСлово;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ПослеОткрытияБазыПользователя(РезультатЗапуска, ДополнительныеПараметры) Экспорт

	// Этап 2: учетная база запущена только для подключения, выгрузки не будет,
	// ждем результат обмена пин-кодом (страница успеха уже показывает индикатор ожидания).
	Если РежимТолькоПодключение Тогда
		ПопыткиОжиданияПодключения = 300;
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьЗавершениеПодключения", 3, Истина);
		Возврат;
	КонецЕсли;

	Текст = НСтр("ru = 'Выполняется получение данных из базы ""%1""'");

	Если ЭтоБазаВВебе И НЕ ЗначениеЗаполнено(ИмяИБ) Тогда
		Текст = СтрШаблон(Текст, ПутьКБазе);
	Иначе
		Текст = СтрШаблон(Текст, ИмяИБ);
	КонецЕсли;

	Элементы.СтраницаЗагрузки_Действие.Заголовок = Текст;

	ВывестиПроцентЗагрузки(1);

	АктивизироватьСтраницу(
		Элементы.СтраницыПомощника,
		Элементы.СтраницаЗагрузки);

	ПопыткиОжиданияВыгрузки = 1800;

	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьЗавершениеВыгрузки", 5, Истина);
	ПодключитьОбработчикОжидания("Подключаемый_СообщитьОДолгойВыгрузке", 120, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СообщитьОДолгойВыгрузке()

	Если НЕ Элементы.СтраницыПомощника.ТекущаяСтраница = Элементы.СтраницаЗагрузки Тогда
		Возврат;
	КонецЕсли;

	Элементы.СтраницаЗагрузки_Действие.Заголовок = Элементы.СтраницаЗагрузки_Действие.Заголовок
		+ Символы.ПС
		+ НСтр("ru = 'Получение данных идет дольше обычного. Проверьте окно программы, из которой выгружаются данные: возможно, там ожидается подтверждение.'");

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьЗавершениеВыгрузки()
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеПоискаФайловВПапкеОбмена", 
		ЭтотОбъект);
	
	НачатьПоискФайловВКаталоге(ОписаниеОповещения, ПапкаОбмена, "*.*");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПоискаФайловВПапкеОбмена(НайденныеФайлы, ВходящийКонтекст) Экспорт
	
	ВыгрузкаЗавершена = Ложь;
	Для каждого Файл Из НайденныеФайлы Цикл
		
		Если Файл.Имя = "READY.txt" Тогда
			
			ВыгрузкаЗавершена = Истина;
			Прервать;
			
		ИначеЕсли Файл.Имя = "BREAK.txt" Тогда
			
			ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь, , Истина);
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыгрузкаЗавершена Тогда

		ОтключитьОбработчикОжидания("Подключаемый_СообщитьОДолгойВыгрузке");
		ВывестиПроцентЗагрузки(50);
		НачатьПереносФайловВыгрузкиНаСервер(НайденныеФайлы);

	Иначе

		Если ПопыткиОжиданияВыгрузки = Неопределено Тогда
			ПопыткиОжиданияВыгрузки = 0;
		Иначе
			ПопыткиОжиданияВыгрузки = ПопыткиОжиданияВыгрузки - 1;
		КонецЕсли;

		Если ПопыткиОжиданияВыгрузки <= 0 Тогда
			ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь,
				НСтр("ru = 'Учетная база не ответила: данные так и не были выгружены.
					|Проверьте, что она запустилась и в ней не ожидается подтверждение, и повторите перенос.'"));
		Иначе
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьЗавершениеВыгрузки", 1, Истина);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПереносФайловВыгрузкиНаСервер(НайденныеФайлы)
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеПереносаФайловВыгрузкиНаСервер", 
		ЭтотОбъект);

	ПередаваемыеФайлы = Новый Массив;
	Для каждого Файл Из НайденныеФайлы Цикл
		ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(Файл.ПолноеИмя));
	КонецЦикла;
	
	НачатьПомещениеФайловНаСервер(ОписаниеОповещения, ,, ПередаваемыеФайлы, Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПереносаФайловВыгрузкиНаСервер(ПомещенныеФайлы, ВходящийКонтекст) Экспорт
	
	ФайлыВыгрузки = Новый Массив;
	Для каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
		
		Файл = Новый Структура("Имя, Адрес", ПомещенныйФайл.СсылкаНаФайл.Имя, ПомещенныйФайл.Адрес);
		ФайлыВыгрузки.Добавить(Файл);
	
	КонецЦикла;
	
	ОчиститьПапкуОбмена(ФайлыВыгрузки);
	
	ПодключитьОбработчикОжидания("Подключаемый_ПрочитатьПрогрессЗагрузки", 1, Ложь);
	
КонецПроцедуры

&НаСервере
Функция НачатьЗагрузкуДанных(ФайлыВыгрузки)
	
	Для каждого Файл Из ФайлыВыгрузки Цикл
		Файл.Адрес = ПолучитьИзВременногоХранилища(Файл.Адрес);
	КонецЦикла;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Выгрузка справочников'");
	ПараметрыВыполнения.ОжидатьЗавершение = Истина;
	
	РезультатЗапуска = ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ПереносСправочниковБРО.НачатьЗагрузкуДанных", 
		ФайлыВыгрузки, 
		ПараметрыВыполнения);
		
	ИдентификаторЗадания = РезультатЗапуска.ИдентификаторЗадания;
		
	Возврат РезультатЗапуска;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ПрочитатьПрогрессЗагрузки()
	
	Прогресс = ПрочитатьПрогресс(ИдентификаторЗадания);
	Если Прогресс <> Неопределено Тогда
		// 50% - это на выгрузку
		Процент = 50 + Цел(Прогресс.Процент)/2;
		ВывестиПроцентЗагрузки(Процент);
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервереБезКонтекста
Функция ПрочитатьПрогресс(ИдентификаторЗадания)
	Возврат ДлительныеОперации.ПрочитатьПрогресс(ИдентификаторЗадания);
КонецФункции

&НаКлиенте
Процедура ПроверитьСостояниеЗагрузкиДанных(ДлительнаяОперация, ВходящийКонтекст) Экспорт
	
	Если ДлительнаяОперация = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не обнаружено фоновое задание по выгрузке справочников'");
		ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь, ТекстОшибки);
		ОтключитьОбработчикОжидания("Подключаемый_ПрочитатьПрогрессЗагрузки");
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		
		ОтключитьОбработчикОжидания("Подключаемый_ПрочитатьПрогрессЗагрузки");
		
		Результат  = РазобратьРезультатЗагрузкиНаСервере(ДлительнаяОперация.АдресРезультата);
		ЕстьОшибки = Результат.ЕстьОшибки;

		Если ЕстьОшибки И Результат.Загружено Тогда
			ПоказатьОшибкуВыгрузки(ЭтотОбъект, Истина,,,Результат);
		ИначеЕсли ЕстьОшибки И НЕ Результат.Загружено Тогда
			ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь,,,Результат);
		ИначеЕсли Результат.Всего = 0 Тогда
			ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь,
				НСтр("ru = 'Из учетной базы не получено ни одной записи.
					|Повторите перенос, а если данных снова не будет, проверьте учетную программу или обратитесь к ее администратору.'"),
				Ложь, Результат);
		Иначе
			ПоказатьСтраницуУспех();
		КонецЕсли;
		
	ИначеЕсли ДлительнаяОперация.Статус = "Ошибка" Тогда
		
		ОтключитьОбработчикОжидания("Подключаемый_ПрочитатьПрогрессЗагрузки");
		
		ПоказатьОшибкуВыгрузки(ЭтотОбъект, Ложь, ДлительнаяОперация.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПроцентЗагрузки(Процент)
	
	Текст = НСтр("ru = 'Завершено %1'");
	Текст = СтрШаблон(Текст, Строка(Процент) + "%");
	
	Элементы.СтраницаЗагрузки_Процент.Заголовок = Текст;
	
КонецПроцедуры

&НаСервере
Функция РазобратьРезультатЗагрузкиНаСервере(АдресРезультата) Экспорт
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если Результат.ЕстьОшибки Тогда
		АдресФайлаОшибок = ПоместитьВоВременноеХранилище(Результат.Ошибки, УникальныйИдентификатор);
		Результат.Удалить("Ошибки");
	Иначе
		АдресФайлаОшибок = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВерсияБРО()
	
	Возврат Обработки.ПереносСправочниковБРО.ВерсияБРО();
		
КонецФункции

&НаСервере
Функция ВерсияБСП() Экспорт
	
	Возврат Обработки.ПереносСправочниковБРО.ВерсияБСП();
	
КонецФункции

&НаСервере
Процедура Инициализация(Параметры)
	
	ЕстьБИП =
		ЭлектронныйДокументооборотСКонтролирующимиОрганами.МодульИнтернетПоддержкаПользователей() <> Неопределено;
	
	Параметры.Свойство("ПараметрыФормыБыстрыйСтарт", ПараметрыФормыБыстрыйСтарт);
	
	НужноПоказатьБС = НужноПоказатьБыстрыйСтартО1СО();
	
	Если НужноПоказатьБС Тогда
		Заголовок = "Первый запуск";
	КонецЕсли;
	
	ЕстьСервисПолученияПинКода = ЕстьИнтеграцияСУчетнымиСистемами();

	ЗаполнятьРегОтчеты = Истина;

КонецПроцедуры
	
&НаКлиенте
Процедура ПодключитьИнтернетПоддержку()
	
	УстановитьДоступностьЭлементовОжиданияПодключения(Истина);
	
	Элементы.ГруппаОшибкаПодключения.Видимость = Ложь;
	
	ПодключитсяКИнтернетПоддержкеНаСервере();
	Результат = ОбработкаЗаявленийАбонентаВызовСервера.ТикетАутентификацииНаПорталеПоддержки();
	
	Если Результат = Неопределено Тогда 
		УстановитьДоступностьЭлементовОжиданияПодключения(Ложь);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.СообщениеОбОшибке) Тогда
		УстановитьДоступностьЭлементовОжиданияПодключения(Ложь);
		Элементы.ГруппаОшибкаПодключения.Видимость = Истина;
		Элементы.ТекстОшибкиПодключения.Заголовок = Результат.СообщениеОбОшибке;
		Возврат;;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодключитсяКИнтернетПоддержкеНаСервере()
	
	Если ЕстьБИП Тогда
		
		МодульИнтернетПоддержкаПользователей = 
			ОбщегоНазначения.ОбщийМодуль("ИнтернетПоддержкаПользователей");
		
		ДанныеАутентификации = Новый Структура("Логин, Пароль", ЛогинИнтернетПоддержки, ПарольИнтернетПоддержки);
		УстановитьПривилегированныйРежим(Истина);
		МодульИнтернетПоддержкаПользователей.СохранитьДанныеАутентификации(ДанныеАутентификации);
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьЭлементовОжиданияПодключения(Ожидание)
	
	Элементы.ГруппаПодключиться.Доступность         = НЕ Ожидание;
	Элементы.Подключиться.Видимость                 = НЕ Ожидание;
	Элементы.ПодключитьИТСПозже.Видимость           = НЕ Ожидание;
	Элементы.ГруппаОжиданиеПодключения.Видимость    = Ожидание;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНеПредлагатьПодключитьИТС()
	
	ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_НеПредлагатьПодключитьИТС", , Истина);
	
КонецПроцедуры

&НаСервере
Функция НеПредлагатьПодключитьИТС()
	
	Результат = ХранилищеОбщихНастроек.Загрузить("ДокументооборотСКонтролирующимиОрганами_НеПредлагатьПодключитьИТС");
	Возврат Результат = Истина;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии_ПослеПолученияКонтекста(Результат, ДополнительныеПараметры) Экспорт

	КонтекстЭДОКлиент = Результат.КонтекстЭДО;
	
	Если НужноПоказатьСтраницуИТС() Тогда
		
		АктивизироватьСтраницу(
			Элементы.СтраницыПомощника, 
			Элементы.СтраницаИТС);
			
	Иначе
			
		АктивизироватьСтраницу(
			Элементы.СтраницыПомощника, 
			Элементы.СтраницаИнтро);
		
	КонецЕсли;
	
	Активизировать();

КонецПроцедуры

&НаСервере
Функция НужноПоказатьСтраницуИТС() 
	
	Результат = ОбработкаЗаявленийАбонентаВызовСервера.ТикетАутентификацииНаПорталеПоддержки();
	
	ПропуститьСтраницуИТС = 
		Результат = Неопределено 
		ИЛИ ЗначениеЗаполнено(Результат.Тикет) 
		ИЛИ Результат.КодОшибки = "ОшибкаПодключения"
		ИЛИ ОбщегоНазначения.РазделениеВключено()
		ИЛИ НеПредлагатьПодключитьИТС();
		
	НужноПоказать = НЕ ПропуститьСтраницуИТС;
	
	Возврат НужноПоказать;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура АктивизироватьСтраницу(МногостраничныйЭлемент, ТекущаяСтраница, МенятьВидимость = Ложь) Экспорт
	
	ДокументооборотСКОКлиентСервер.АктивизироватьСтраницу(
		МногостраничныйЭлемент, 
		ТекущаяСтраница, 
		МенятьВидимость);
		
КонецПроцедуры

 &НаКлиенте
Процедура ЗаполнениеСпискаИБПослеПодключенияРасширения(Подключено, ДополнительныеПараметры) Экспорт
	
	РасширениеПодключено = Подключено;
	
	Если РасширениеПодключено Тогда
		ЗаполнитьСписокИБ();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Без расширения для работы с файлами получить список баз нельзя.
				|Установите расширение и повторите, либо отметьте ""Я работаю из браузера и моей базы нет в этом списке"" и укажите путь к базе.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокИБ()
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗаполнитьСписокИБПослеПолученияКаталога", 
		ЭтотОбъект);
		
	НачатьПолучениеРабочегоКаталогаДанныхПользователя(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокИБПослеПолученияКаталога(КаталогДанныхПользователя, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КаталогДанныхПользователя) Тогда
		
		ТекстСообщения = НСтр("ru = 'Не удалось получить рабочий каталог пользователя'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
		
	КонецЕсли;
	
	КаталогДанныхПользователяКэш = КаталогДанныхПользователя;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗаполнитьСписокИБПослеСозданияПапкиОбмена", 
		ЭтотОбъект);
		
	ПапкаОбмена = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогДанныхПользователяКэш) + Строка(Новый УникальныйИдентификатор);
		
	НачатьСозданиеКаталога(ОписаниеОповещения, ПапкаОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокИБПослеСозданияПапкиОбмена(Результат, ДополнительныеПараметры) Экспорт	
	
	РазделительПути = ПолучитьРазделительПутиКлиента();
	
	Если ЭтоЛинукс ИЛИ ЭтоМак Тогда
		КаталогДанныхПользователяКорень = Сред(КаталогДанныхПользователяКэш, 1, СтрНайти(КаталогДанныхПользователяКэш, ".1cv8") - 1)
			+ РазделительПути
			+ ".1C"
			+ РазделительПути
			+ "1cestart"
			+ РазделительПути;
	Иначе
		КаталогДанныхПользователяКорень = Сред(КаталогДанныхПользователяКэш, 1, СтрНайти(КаталогДанныхПользователяКэш, "Roaming") + 6)
			+ РазделительПути
			+ "1C"
			+ РазделительПути
			+ "1CEStart"
			+ РазделительПути;
	КонецЕсли;
	
	ЛокальныеИБ = КаталогДанныхПользователяКорень + "ibases.v8i";
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ПослеПолученияСпискаБаз", 
		ЭтотОбъект);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Путь", ЛокальныеИБ);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьСписокИБПослеПроверкиСуществованияФайла", ЭтотОбъект, ДополнительныеПараметры);
	
	Файл = Новый Файл(ЛокальныеИБ);
	Файл.НачатьПроверкуСуществования(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияСпискаБаз(Результат, ВходящийКонтекст) Экспорт
	
	ДобавитьБазыФреша();
	
	ТаблицаПути.Сортировать("Имя");
	
	ПередОткрытиемСтраницыБазыНаСервере();
	ИзменитьОформлениеСтраницаБазы();
	
	АктивизироватьСтраницу(
		Элементы.СтраницыПомощника, 
		Элементы.СтраницаБазы);

КонецПроцедуры

&НаСервере
Процедура ДобавитьБазыФреша()
	
	Если ОбщегоНазначения.РазделениеВключено() И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		
		ПараметрыПолученияПриложений = ПрограммныйИнтерфейсСервиса.НовыйПараметрыПолученияПриложений();
		Приложения  = ПрограммныйИнтерфейсСервиса.СписокПриложений(ПараметрыПолученияПриложений);
		
		Для каждого Приложение Из Приложения Цикл
		
			НоваяСтрока = ТаблицаПути.Добавить();
			НоваяСтрока.Имя		= Приложение.Наименование;
			НоваяСтрока.Путь	= Приложение.АдресПриложения;
		
		КонецЦикла;
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОформлениеСтраницаБазы()

	Элементы.ПутьКБазеИзБраузера.Видимость = ЯРаботаюИзБраузера;
	// Выбор подключения перенесен на страницу успеха: этап 1 - только загрузка справочников.
	Элементы.ГруппаЗаполненияОтчетов.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокИБПослеПроверкиСуществованияФайла(Существует, ВходящийКонтекст) Экспорт
	
	Если Существует = Истина Тогда
		ПрочитатьСписокБаз(ВходящийКонтекст);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьСписокБаз(ВходящийКонтекст)
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	
	ВходящийКонтекст.Вставить("ТекстовыйДокумент", ТекстовыйДокумент);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрочитатьСписокБазПослеЧтенияФайла", ЭтотОбъект, ВходящийКонтекст);
	
	ТекстовыйДокумент.НачатьЧтение(ОписаниеОповещения, ВходящийКонтекст.Путь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьСписокБазПослеЧтенияФайла(ВходящийКонтекст) Экспорт
	
	ТекстовыйДокумент = ВходящийКонтекст.ТекстовыйДокумент;
	
	КоличествоСтрок = ТекстовыйДокумент.КоличествоСтрок();
	НоваяСтрока = Неопределено;
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		ТекущаяСтрока = ТекстовыйДокумент.ПолучитьСтроку(НомерСтроки);
		Если Лев(ТекущаяСтрока,1) = "[" И Прав(ТекущаяСтрока,1) = "]" Тогда
			ИмяИБ = Сред(ТекущаяСтрока,2,СтрДлина(ТекущаяСтрока)-2);
			НомерСтроки = НомерСтроки + 1;
			ТекущаяСтрока = ТекстовыйДокумент.ПолучитьСтроку(НомерСтроки);
			Если СтрНайти(ТекущаяСтрока, "Connect=File=") <> 0 Тогда
				ПутьИБ = Сред(ТекущаяСтрока, 9, СтрДлина(ТекущаяСтрока)- 9);
				
				НоваяСтрока = ТаблицаПути.Добавить();
				НоваяСтрока.Имя		= ИмяИБ;
				НоваяСтрока.Путь	= ПутьИБ;
				
			ИначеЕсли СтрНайти(ТекущаяСтрока, "Connect=Srvr=") <> 0 Тогда
				ПутьИБ = Сред(ТекущаяСтрока, 9, СтрДлина(ТекущаяСтрока)- 9);
				
				НоваяСтрока = ТаблицаПути.Добавить();
				НоваяСтрока.Имя		= ИмяИБ;
				НоваяСтрока.Путь	= ПутьИБ;
			ИначеЕсли Не СтрНачинаетсяС(ТекущаяСтрока, "ID=") Тогда
				ПутьИБ = Сред(ТекущаяСтрока, 9);
				
				НоваяСтрока = ТаблицаПути.Добавить();
				НоваяСтрока.Имя		= ИмяИБ;
				НоваяСтрока.Путь	= ПутьИБ;
			КонецЕсли;
			
			Если НомерСтроки >= КоличествоСтрок Тогда
				Прервать;
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(ТекущаяСтрока, "DefaultVersion=") 
			И НоваяСтрока <> Неопределено И ИмяИБ = НоваяСтрока.Имя Тогда
			НоваяСтрока.ВерсияПлатформы = СтрЗаменить(ТекущаяСтрока, "DefaultVersion=", "");
		КонецЕсли;
	КонецЦикла;
		
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
	
КонецПроцедуры

&НаСервере
Процедура ПередОткрытиемСтраницыБазыНаСервере()
	
	ТаблицаПути.Сортировать("Имя");

КонецПроцедуры

&НаСервере
Процедура ОпределитьПользователя()

	Если ЗначениеЗаполнено(Пользователь) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторПользователяИБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Пользователи.ТекущийПользователь(),"ИдентификаторПользователяИБ");
	Свойства = Пользователи.СвойстваПользователяИБ(ИдентификаторПользователяИБ);

	Если Свойства <> Неопределено Тогда
		Пользователь = Свойства.Имя;
	КонецЕсли;

КонецПроцедуры

// Удаляет выгрузку с диска пользователя и продолжает загрузку данных
//
&НаКлиенте
Процедура ОчиститьПапкуОбмена(ФайлыВыгрузки)
	
	Если Не ЗначениеЗаполнено(ПапкаОбмена) Тогда
		ЗагрузитьДанныеПослеОчисткиПапкиОбмена(ФайлыВыгрузки);
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеОчисткиВыгрузкиПередЗагрузкой",
		ЭтотОбъект,
		ФайлыВыгрузки);
	
	НачатьОчисткуКаталога(ОписаниеОповещения, ПапкаОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОчисткиВыгрузкиПередЗагрузкой(Результат, ФайлыВыгрузки) Экспорт
	
	ЗагрузитьДанныеПослеОчисткиПапкиОбмена(ФайлыВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеПослеОчисткиПапкиОбмена(ФайлыВыгрузки)
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПроверитьСостояниеЗагрузкиДанных",
		ЭтотОбъект);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.Интервал = 1;
	
	ДлительнаяОперация = НачатьЗагрузкуДанных(ФайлыВыгрузки);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВременныеФайлыИзКаталога(КаталогСФайлами)
	
	Если Не ЗначениеЗаполнено(КаталогСФайлами) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьОчисткуКаталога(Неопределено, КаталогСФайлами, Истина);
	
КонецПроцедуры

// Ищет файлы в каталоге и при отказе платформы по маске повторяет поиск с маской звездочка
//
&НаКлиенте
Процедура НачатьПоискФайловВКаталоге(ОповещениеПоЗавершении, Каталог, Маска, ЗаписыватьОшибкиПоиска = Истина)
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("ОповещениеПоЗавершении", ОповещениеПоЗавершении);
	ПараметрыПоиска.Вставить("Каталог", Каталог);
	ПараметрыПоиска.Вставить("Маска", Маска);
	ПараметрыПоиска.Вставить("ЗапаснойВариант", Ложь);
	ПараметрыПоиска.Вставить("ЗаписыватьОшибкиПоиска", ЗаписыватьОшибкиПоиска);
	
	ВыполнитьПоискФайловВКаталоге(ПараметрыПоиска);
	
КонецПроцедуры

// Удаляет файлы каталога по одному по полному имени и при необходимости сам каталог
//
&НаКлиенте
Процедура НачатьОчисткуКаталога(ОповещениеПоЗавершении, Каталог, УдалятьКаталог = Ложь)
	
	ПараметрыОчистки = Новый Структура;
	ПараметрыОчистки.Вставить("ОповещениеПоЗавершении", ОповещениеПоЗавершении);
	ПараметрыОчистки.Вставить("Каталог", Каталог);
	ПараметрыОчистки.Вставить("УдалятьКаталог", УдалятьКаталог);
	ПараметрыОчистки.Вставить("ИменаФайлов", Новый Массив);
	ПараметрыОчистки.Вставить("Индекс", 0);
	
	Оповещение = Новый ОписаниеОповещения("ПослеПоискаФайловДляОчистки", ЭтотОбъект, ПараметрыОчистки);
	НачатьПоискФайловВКаталоге(Оповещение, Каталог, "*", Не УдалятьКаталог);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоискФайловВКаталоге(ПараметрыПоиска)
	
	Оповещение = Новый ОписаниеОповещения("ПослеПоискаФайловВКаталоге", ЭтотОбъект, ПараметрыПоиска,
		"ПриОшибкеПоискаФайловВКаталоге", ЭтотОбъект);
	
	Маска = ?(ПараметрыПоиска.ЗапаснойВариант, "*", ПараметрыПоиска.Маска);
	НачатьПоискФайлов(Оповещение, ПараметрыПоиска.Каталог, Маска, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПоискаФайловВКаталоге(НайденныеФайлы, ПараметрыПоиска) Экспорт
	
	ВыполнитьОбработкуОповещения(ПараметрыПоиска.ОповещениеПоЗавершении, НайденныеФайлы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеПоискаФайловВКаталоге(ИнформацияОбОшибке, СтандартнаяОбработка, ПараметрыПоиска) Экспорт
	
	СтандартнаяОбработка = Ложь;
	Если ПараметрыПоиска.ЗаписыватьОшибкиПоиска Тогда
		ЗаписатьОшибкуФайловойОперации(
			"Поиск файлов по маске " + ?(ПараметрыПоиска.ЗапаснойВариант, "*", ПараметрыПоиска.Маска),
			ПараметрыПоиска.Каталог,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецЕсли;
	
	Если Не ПараметрыПоиска.ЗапаснойВариант И ПараметрыПоиска.Маска <> "*" Тогда
		ПараметрыПоиска.ЗапаснойВариант = Истина;
		ВыполнитьПоискФайловВКаталоге(ПараметрыПоиска);
	Иначе
		ВыполнитьОбработкуОповещения(ПараметрыПоиска.ОповещениеПоЗавершении, Новый Массив);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПоискаФайловДляОчистки(НайденныеФайлы, ПараметрыОчистки) Экспорт
	
	Для каждого Файл Из НайденныеФайлы Цикл
		ПараметрыОчистки.ИменаФайлов.Добавить(Файл.ПолноеИмя);
	КонецЦикла;
	
	УдалитьСледующийФайлКаталога(ПараметрыОчистки);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСледующийФайлКаталога(ПараметрыОчистки)
	
	Если ПараметрыОчистки.Индекс >= ПараметрыОчистки.ИменаФайлов.Количество() Тогда
		Если ПараметрыОчистки.УдалятьКаталог Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеУдаленияКаталога", ЭтотОбъект, ПараметрыОчистки,
				"ПриОшибкеУдаленияКаталога", ЭтотОбъект);
			НачатьУдалениеФайлов(Оповещение, ПараметрыОчистки.Каталог);
		Иначе
			ЗавершитьОчисткуКаталога(ПараметрыОчистки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПолноеИмя = ПараметрыОчистки.ИменаФайлов[ПараметрыОчистки.Индекс];
	ПараметрыОчистки.Индекс = ПараметрыОчистки.Индекс + 1;
	
	Оповещение = Новый ОписаниеОповещения("ПослеУдаленияФайлаКаталога", ЭтотОбъект, ПараметрыОчистки,
		"ПриОшибкеУдаленияФайлаКаталога", ЭтотОбъект);
	НачатьУдалениеФайлов(Оповещение, ПолноеИмя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУдаленияФайлаКаталога(ПараметрыОчистки) Экспорт
	
	УдалитьСледующийФайлКаталога(ПараметрыОчистки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеУдаленияФайлаКаталога(ИнформацияОбОшибке, СтандартнаяОбработка, ПараметрыОчистки) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ЗаписатьОшибкуФайловойОперации(
		"Удаление файла",
		ПараметрыОчистки.ИменаФайлов[ПараметрыОчистки.Индекс - 1],
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	
	УдалитьСледующийФайлКаталога(ПараметрыОчистки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУдаленияКаталога(ПараметрыОчистки) Экспорт
	
	ЗавершитьОчисткуКаталога(ПараметрыОчистки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеУдаленияКаталога(ИнформацияОбОшибке, СтандартнаяОбработка, ПараметрыОчистки) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ЗаписатьОшибкуФайловойОперации(
		"Удаление каталога",
		ПараметрыОчистки.Каталог,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	
	ЗавершитьОчисткуКаталога(ПараметрыОчистки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОчисткуКаталога(ПараметрыОчистки)
	
	Если ПараметрыОчистки.ОповещениеПоЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ПараметрыОчистки.ОповещениеПоЗавершении, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьОшибкуФайловойОперации(Знач Операция, Знач Путь, Знач ТекстОшибки)
	
	ЗаписьЖурналаРегистрации(
		СокрЛП(НСтр("ru = 'Электронный документооборот с контролирующими органами.Файловая операция'")),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		СтрШаблон("%1: %2%3%4", Операция, Путь, Символы.ПС, ТекстОшибки));
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДополнительнаяАктивизация()
	
	КоличествоПроверокАктивизации = КоличествоПроверокАктивизации + 1;
	Если КоличествоПроверокАктивизации > 10 Тогда
		ОтключитьОбработчикОжидания("Подключаемый_ДополнительнаяАктивизация");
	КонецЕсли;
	
	АктивноеОкно = АктивноеОкно();
	Если АктивноеОкно = Неопределено ИЛИ АктивноеОкно.Заголовок <> Заголовок Тогда
		Активизировать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтраницуУспех()
	
	Если НужноПоказатьБС Тогда
		Элементы.Закрыть.Заголовок = НСтр("ru = 'Далее'");
	Иначе
		Элементы.Закрыть.Заголовок = НСтр("ru = 'Завершить'");
	КонецЕсли;

	УстановитьСостояниеСтраницыУспех("Загрузка", "");

	АктивизироватьСтраницу(
	Элементы.СтраницыПомощника,
	Элементы.СтраницаУспех);

КонецПроцедуры

// Начинает этап 2 - тихое подключение учетной базы к шине по нажатию Далее с галочкой
// Учетная база уже загружена и закрыта, поднимаем ее второй раз только для обмена пин-кодом
//
&НаКлиенте
Процедура НачатьПодключениеУчетнойБазы()

	УстановитьСостояниеСтраницыУспех("Подключение", "");

	Если ЭтоБазаВВебе Тогда
		НачатьОткрытиеБазыПользователя(, Истина, Истина);
	Иначе
		Если Не ЗначениеЗаполнено(ПутьФайлаЗапускаПлатформы) Тогда
			УстановитьСостояниеСтраницыУспех("РезультатОшибка",
				НСтр("ru = 'Не найден путь запуска учетной базы для подключения.'"));
			Возврат;
		КонецЕсли;
		НачатьОткрытиеБазыПользователя(ПутьФайлаЗапускаПлатформы, Ложь, Истина);
	КонецЕсли;

КонецПроцедуры

// Опрашивает папку обмена в ожидании результата обмена пин-кодом от учетной базы
//
&НаКлиенте
Процедура Подключаемый_ПроверитьЗавершениеПодключения()

	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПоискаФайловПодключения", ЭтотОбъект);
	НачатьПоискФайловВКаталоге(ОписаниеОповещения, ПапкаОбмена, "*.*");

КонецПроцедуры

&НаКлиенте
Процедура ПослеПоискаФайловПодключения(НайденныеФайлы, ВходящийКонтекст) Экспорт

	ПинГотов = Ложь;
	ПинОшибка = Ложь;
	Для Каждого Файл Из НайденныеФайлы Цикл
		Если Файл.Имя = "PIN_READY.txt" Тогда
			ПинГотов = Истина;
			Прервать;
		ИначеЕсли Файл.Имя = "PIN_ERROR.txt" Тогда
			ПинОшибка = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПинОшибка Тогда
		ЭтотОбъект.ОтключитьОбработчикОжидания("Подключаемый_ПроверитьЗавершениеПодключения");
		УстановитьСостояниеСтраницыУспех("РезультатОшибка",
			НСтр("ru = 'Учетной базе не удалось подключиться для заполнения регламентированных отчетов.'"));
	ИначеЕсли ПинГотов Тогда
		ЭтотОбъект.ОтключитьОбработчикОжидания("Подключаемый_ПроверитьЗавершениеПодключения");
		НачатьЗавершениеПодключения();
	Иначе
		Если ПопыткиОжиданияПодключения = Неопределено Тогда
			ПопыткиОжиданияПодключения = 0;
		Иначе
			ПопыткиОжиданияПодключения = ПопыткиОжиданияПодключения - 1;
		КонецЕсли;
		
		Если ПопыткиОжиданияПодключения <= 0 Тогда
			УстановитьСостояниеСтраницыУспех("РезультатОшибка",
				НСтр("ru = 'Учетная база не ответила на подключение.
					|Проверьте, что она запустилась, и подключите ее в настройках подключения.'"));
		Иначе
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьЗавершениеПодключения", 1, Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Забирает с шины сообщение о подключении, которым заполняется регистр настроек интеграции
// Учетная база предъявила пин-код, но настройки в этой программе приходят с задержкой
//
&НаКлиенте
Процедура НачатьЗавершениеПодключения()

	ПопыткиЗавершенияПодключения = 15;

	Если ЗавершитьПодключениеБазыНаСервере() Тогда
		УстановитьСостояниеСтраницыУспех("РезультатУспех", "");
		Возврат;
	КонецЕсли;

	ЭтотОбъект.ПодключитьОбработчикОжидания("Подключаемый_ЗавершитьПодключение", 2);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗавершитьПодключение()

	ПопыткиЗавершенияПодключения = ПопыткиЗавершенияПодключения - 1;

	Если ЗавершитьПодключениеБазыНаСервере() Тогда
		ЭтотОбъект.ОтключитьОбработчикОжидания("Подключаемый_ЗавершитьПодключение");
		УстановитьСостояниеСтраницыУспех("РезультатУспех", "");
	ИначеЕсли ПопыткиЗавершенияПодключения <= 0 Тогда
		ЭтотОбъект.ОтключитьОбработчикОжидания("Подключаемый_ЗавершитьПодключение");
		УстановитьСостояниеСтраницыУспех("РезультатОшибка",
			НСтр("ru = 'Учетная база ответила на подключение, но настройки интеграции еще не получены.
				|Откройте настройки подключения позже.'"));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьИнтеграцияСУчетнымиСистемами()

	МодульИнтеграции = МодульИнтеграцииСУчетнымиСистемами();
	Если МодульИнтеграции = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	//@skip-check dynamic-access-method-not-found
	Возврат МодульИнтеграции.ЕстьИнтеграцияСУчетнымиСистемами();

КонецФункции

&НаСервереБезКонтекста
Функция ЗавершитьПодключениеБазыНаСервере()

	МодульИнтеграции = МодульИнтеграцииСУчетнымиСистемами();
	Если МодульИнтеграции = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	//@skip-check dynamic-access-method-not-found
	Возврат МодульИнтеграции.ЗавершитьПодключениеУчетнойБазы();

КонецФункции

// Возвращает модуль приемной стороны или Неопределено если его нет в конфигурации
//
// Возвращаемое значение:
//  ОбщийМодуль, Неопределено
//
&НаСервереБезКонтекста
Функция МодульИнтеграцииСУчетнымиСистемами()

	Если Метаданные.ОбщиеМодули.Найти("СервисИнтеграцииСУчетнымиСистемами") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщегоНазначения.ОбщийМодуль("СервисИнтеграцииСУчетнымиСистемами");

КонецФункции

// Управляет отображением страницы успеха для двух этапов подключения учетной базы
//
// Параметры:
//  Состояние - Строка - Загрузка, Подключение, РезультатУспех или РезультатОшибка
//  ТекстРезультата - Строка - описание результата подключения
//
&НаКлиенте
Процедура УстановитьСостояниеСтраницыУспех(Состояние, ТекстРезультата)

	СостояниеУспеха = Состояние;

	ПоказатьГалочку = (Состояние = "Загрузка") И ЕстьСервисПолученияПинКода;
	Элементы.СтраницаУспех_ЗаполнятьРегОтчеты.Видимость = ПоказатьГалочку;

	ПоказатьРезультат = (Состояние = "РезультатУспех") Или (Состояние = "РезультатОшибка");
	Элементы.СтраницаУспех_ПодключениеБазы.Видимость = ПоказатьРезультат;
	Элементы.СтраницаУспех_ПодключениеНастроить.Видимость = ПоказатьРезультат;

	Элементы.СтраницаУспех_Панель.Видимость = (Состояние <> "Подключение");
	Элементы.НазадКВыборуБаз.Видимость = (Состояние = "РезультатУспех");

	Если Состояние = "Загрузка" Тогда
		Элементы.СтраницаУспех_Галка.Картинка = БиблиотекаКартинок.ГалкаУспешноЗеленаяАнимированная;
		Элементы.СтраницаУспех_Заголовок.Заголовок = НСтр("ru = 'Завершена загрузка данных'");
	ИначеЕсли Состояние = "Подключение" Тогда
		Элементы.СтраницаУспех_Галка.Картинка = БиблиотекаКартинок.ДлительнаяОперация48;
		Элементы.СтраницаУспех_Заголовок.Заголовок = НСтр("ru = 'Идет подключение учетной базы...'");
	ИначеЕсли Состояние = "РезультатУспех" Тогда
		Элементы.СтраницаУспех_Галка.Картинка = БиблиотекаКартинок.ГалкаУспешноЗеленаяАнимированная;
		Элементы.СтраницаУспех_Заголовок.Заголовок = НСтр("ru = 'Учетная база подключена'");
		Элементы.СтраницаУспех_ПодключениеНадпись.Заголовок =
			НСтр("ru = 'Регламентированные отчеты можно заполнять по данным этой базы.'");
	ИначеЕсли Состояние = "РезультатОшибка" Тогда
		Элементы.СтраницаУспех_Галка.Картинка = БиблиотекаКартинок.ТреугольникВниманиеОранжевыйАнимированный;
		Элементы.СтраницаУспех_Заголовок.Заголовок = НСтр("ru = 'База загружена, но не подключена'");
		Текст = ?(ЗначениеЗаполнено(ТекстРезультата), ТекстРезультата,
			НСтр("ru = 'Не удалось подключить учетную базу для заполнения регламентированных отчетов.'"));
		Элементы.СтраницаУспех_ПодключениеНадпись.Заголовок = Текст;
	КонецЕсли;

	// Анимированная иконка отыгрывает и заменяется статичной, кроме активного ожидания подключения.
	Если Состояние <> "Подключение" Тогда
		ЭтотОбъект.ПодключитьОбработчикОжидания("Подключаемый_ЗаменитьКартинкуУспехаНаСтатику", 2, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗаменитьКартинкуУспехаНаСтатику()

	Если СостояниеУспеха = "РезультатОшибка" Тогда
		Элементы.СтраницаУспех_Галка.Картинка = БиблиотекаКартинок.ТреугольникВниманиеОранжевыйСтатичный;
	Иначе
		Элементы.СтраницаУспех_Галка.Картинка = БиблиотекаКартинок.ГалкаУспешноЗеленаяСтатичная;
	КонецЕсли;

КонецПроцедуры

// Обрабатывает нажатие ссылки Открыть в надписи о подключенной учетной базе
//
// Параметры:
//  Элемент - ДекорацияФормы - надпись с форматированной строкой
//  Ссылка - Строка - имя навигационной ссылки
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаКлиенте
Процедура СтраницаУспех_ПодключениеНастроитьОбработкаНавигационнойСсылки(Элемент, Ссылка, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Ссылка = "Открыть" ИЛИ Ссылка = "Подробнее" Тогда
		ОткрытьНастройкиПодключенияУчетнойБазы();
	КонецЕсли;

КонецПроцедуры

// Открывает подключения к учетным приложениям
//
&НаКлиенте
Процедура ОткрытьНастройкиПодключенияУчетнойБазы()
	
	ПолноеИмяРегистра = ПолноеИмяРегистраНастроекПодключения();
	Если Не ЗначениеЗаполнено(ПолноеИмяРегистра) Тогда
		Возврат;
	КонецЕсли;
	
	КлючЗаписи = ?(СостояниеУспеха = "РезультатОшибка", Неопределено, КлючПоследнегоПодключенияНаСервере());
	Если КлючЗаписи = Неопределено Тогда
		ОткрытьФорму(ПолноеИмяРегистра + ".Форма.ФормаСписка");
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму(ПолноеИмяРегистра + ".Форма.ФормаЗаписи",
		Новый Структура("Ключ", КлючЗаписи));
	
КонецПроцедуры

// Полное имя регистра настроек подключения учетной базы или пустая строка если регистра нет
//
&НаСервереБезКонтекста
Функция ПолноеИмяРегистраНастроекПодключения()
	
	Если Метаданные.РегистрыСведений.Найти("НастройкиИнтеграцииСУчетнымиСистемами") = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "РегистрСведений.НастройкиИнтеграцииСУчетнымиСистемами";
	
КонецФункции

// Ключ записи только что подключенной учетной базы (для открытия ее настроек)
//
// Возвращаемое значение:
//  РегистрСведенийКлючЗаписи.НастройкиИнтеграцииСУчетнымиСистемами, Неопределено
//
&НаСервереБезКонтекста
Функция КлючПоследнегоПодключенияНаСервере()

	Если Метаданные.РегистрыСведений.Найти("НастройкиИнтеграцииСУчетнымиСистемами") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкиИнтеграцииСУчетнымиСистемами.Получатель КАК Получатель
	|ИЗ
	|	РегистрСведений.НастройкиИнтеграцииСУчетнымиСистемами КАК НастройкиИнтеграцииСУчетнымиСистемами
	|ГДЕ
	|	НастройкиИнтеграцииСУчетнымиСистемами.Получатель <> """"
	|	И НастройкиИнтеграцииСУчетнымиСистемами.Отправитель <> """"
	|	И НастройкиИнтеграцииСУчетнымиСистемами.Ошибка = """"
	|УПОРЯДОЧИТЬ ПО
	|	НастройкиИнтеграцииСУчетнымиСистемами.ДатаИнтеграции УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(
		"РегистрСведений.НастройкиИнтеграцииСУчетнымиСистемами").СоздатьКлючЗаписи(
		Новый Структура("Получатель", Выборка.Получатель));

КонецФункции

&НаСервере
Функция ПолучитьСписокОрганизаций() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Организация");
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокЗагруженныхОрганизаций()
	
	СписокЗагруженныхОрганизаций = Новый СписокЗначений;
	
	СписокОрганизацийПослеЗагрузки = ПолучитьСписокОрганизаций();
	
	Для Каждого Организация Из СписокОрганизацийПослеЗагрузки Цикл
		
		ИскЭлемент = СписокОрганизаций.НайтиПоЗначению(Организация);
		Если ИскЭлемент = Неопределено Тогда
			СписокЗагруженныхОрганизаций.Добавить(Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	СписокОрганизаций = СписокЗагруженныхОрганизаций;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦветКнопкиБРО()
	
	Возврат ЦветаСтиля.ЦветКнопкиБРО;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОбычныйШрифтТекста()
	
	Возврат ШрифтыСтиля.ОбычныйШрифтТекста;

КонецФункции

&НаКлиенте
Процедура ЗаменитьТреугольникНаСтатику()
	
	Элементы.СтраницаОшибки_Треугольник.Картинка = БиблиотекаКартинок.ТреугольникВниманиеОранжевыйСтатичный;
	
КонецПроцедуры

#КонецОбласти



