#Область ОписаниеПеременных

&НаКлиенте
Перем КоличествоПроверокАктивизации;

&НаКлиенте
Перем ПопыткиОжиданияПодключения;

&НаКлиенте
Перем ПопыткиОжиданияВыгрузки;

#КонецОбласти

#Область ОбработчикиСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Инициализация(Параметры);
	СписокОрганизаций.ЗагрузитьЗначения(ПолучитьСписокОрганизаций());

	ОпределитьПользователя();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Оповестить("ЗакрытьРодителя",,ЭтотОбъект);
	
	ЭтоЛинукс = ОбщегоНазначенияКлиент.ЭтоLinuxКлиент();
	ЭтоМак = ОбщегоНазначенияКлиент.ЭтоMacOSКлиент() Или ОбщегоНазначенияКлиент.ЭтоOSXКлиент();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриОткрытии_ПослеПолученияКонтекста", ЭтотОбъект);
	ДокументооборотСКОКлиент.ПолучитьКонтекстЭДО(ОписаниеОповещения);
	
	КоличествоПроверокАктивизации = 0;
	ПодключитьОбработчикОжидания("Подключаемый_ДополнительнаяАктивизация", 1, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ПрограммноеЗакрытие Тогда
		БольшеНеПоказыватьПеренос = Истина;
	КонецЕсли;	
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПередЗакрытием_Завершение", 
		ЭтотОбъект);
		
	ТекстПредупреждения = НСтр("ru = 'Прервать работу помощника?'");
	
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияПроизвольнойФормы(
		ЭтотОбъект, 
		Отказ, 
		ЗавершениеРаботы,
		ТекстПредупреждения, 
		"ПрограммноеЗакрытие",
		ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтраницаОшибки_СоединениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьСтатьюДокументации("https://its.1c.ru/bmk/repdoc/nastroyka_podklyucheniya_k_uchetnym_bazam_v_prilozjenii");
	
КонецПроцедуры

// Открывает статью документации на портале информационно технологического сопровождения
//
&НаКлиенте
Процедура ОткрытьСтатьюДокументации(АдресСтатьи)
	
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(АдресСтатьи);
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницаОшибки_ПояснениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Если ЗначениеЗаполнено(АдресФайлаОшибок) Тогда
		
		ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(АдресФайлаОшибок, "Ошибки.txt");
		
	Иначе

		Отбор = Новый Структура();
		Отбор.Вставить("Уровень", "Ошибка");

		ЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(Отбор);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЯРаботаюИзБраузераПриИзменении(Элемент)
	
	ИзменитьОформлениеСтраницаБазы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборОрганизаций_ВопросОбработкаНавигационнойСсылки(Элемент, Ссылка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Ссылка = "данные" Тогда
		ОткрытьФорму("Обработка.ПереносСправочниковБРО.Форма.КакиеДанныеМожноПеренести");
	ИначеЕсли Ссылка = "Подробнее" Тогда
		ОткрытьСтатьюДокументации("https://its.1c.ru/bmk/repdoc/dobavlenie_organizatsii_po_svedeniyam_iz_uchetnoy_bazy_master");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаВосстановлениеПароляНажатие(Элемент)

	Если ЕстьБИП Тогда
		
		МодульИнтернетПоддержкаПользователейКлиент = 
			ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтернетПоддержкаПользователейКлиент");
			
		МодульИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуВосстановленияПароля();
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаРегистрацияНажатие(Элемент)
	
	Если ЕстьБИП Тогда
		
		МодульИнтернетПоддержкаПользователейКлиент = 
			ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтернетПоддержкаПользователейКлиент");
			
		МодульИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуРегистрацииНовогоПользователя();
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

