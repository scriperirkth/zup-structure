Процедура ЗагрузитьКомментарииКандидата(Кандидат, ДанныеРезюме) Экспорт

	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("МестоПубликации", Сайт);
	ОтборСтрок.Вставить("ИмяПоля", "id");

	НайденныеСтроки = ДанныеРезюме.НайтиСтроки(ОтборСтрок);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторРезюме = НайденныеСтроки[0].СодержимоеПоля;

	Комментарии = КомментарииКандидата(ИдентификаторРезюме, Кандидат);

	РекрутинговыеСайтыСлужебный.ЗаписатьТаблицуКомментариевКандидата(Комментарии, Кандидат, Сайт);

КонецПроцедуры

// Параметры:
//  ДанныеДляОтправки - См. РекрутинговыеСайтыСлужебный.ДанныеДляОтправкиОбратнойСвязи
// 
// Возвращаемое значение:
//  Булево - Отправка прошла успешно
Функция ОтправитьОбратнуюСвязьПоОтклику(ДанныеДляОтправки) Экспорт

	Результат = Ложь;

	ИдентификаторыВакансии = РекрутинговыеСайтыСлужебный.ИдентификаторыПубликацийВакансии(ДанныеДляОтправки.Вакансия, Сайт);
	
	Если Не ЗначениеЗаполнено(ИдентификаторыВакансии) Тогда
		ТекстОшибки = НСтр("ru = 'Вакансия не опубликована.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;

	Если Не ПроверитьПодключение().Подключен Тогда
		ТекстОшибки = НСтр("ru = 'Не настроен доступ к сайту.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;

	Если Не УстановитьСоединение() Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось установить соединение с сайтом.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ИдентификаторВакансии Из ИдентификаторыВакансии Цикл
		ОткликиСсайта = ОткликиСсайта(ИдентификаторВакансии);

		Действие = "invite";
		Если ДанныеДляОтправки.Отклонить Тогда
			Действие = ?(ЗначениеЗаполнено(ДанныеДляОтправки.Сообщение), "reject", "reject_without_message");
		КонецЕсли;
		
		Для Каждого Отклик Из ОткликиСсайта Цикл
			Если Не ЗначениеЗаполнено(ЗначениеСвойстваУзла(Отклик, "resume")) Тогда
				Продолжить;
			КонецЕсли;

			ИдентификаторРезюме = Формат(ЗначениеСвойстваУзла(Отклик, "resume", "id"), "ЧГ=");
			Если СтрНайти(ДанныеДляОтправки.АдресРезюме, ИдентификаторРезюме) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = НовыйHTTPЗапрос("v5/me/response/invite_reject.json");
			Тело = Новый Структура();
			Тело.Вставить("response_ids", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗначениеСвойстваУзла(Отклик, "id")));
			Тело.Вставить("action", Действие);
			Тело.Вставить("message", ДанныеДляОтправки.Сообщение);
			РезультатЗапроса = ОтправитьЗапросСТелом(Запрос, Тело);
			
			Если РезультатЗапроса.КодСостояния = 200 Тогда
				Результат = Истина;
			Иначе
				ТекстОшибки = НСтр("ru = 'Не удалось отправить обратную связь.'");
				РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
					Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки, РезультатЗапроса);
			КонецЕсли;
			
			Прервать;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УточнитьОписаниеОшибки(КодСостояния, ОписаниеОшибки) Экспорт

	УточненноеОписаниеОшибки = "";
	
	Если КодСостояния = 400 Тогда
		Ошибка = РекрутинговыеСайтыСлужебный.ПарсерJSON(ОписаниеОшибки)["errors"][0];
		
		Если СтрНайти(ОписаниеОшибки, "STRING_TOO_SHORT") <> 0 Тогда
			УточненноеОписаниеОшибки = УточненноеОписаниеОшибки + НСтр("ru = 'Слишком короткая строка.'");
		ИначеЕсли СтрНайти(ОписаниеОшибки, "EMAIL_INVALID_MX_RECORD") <> 0 Тогда
			УточненноеОписаниеОшибки = УточненноеОписаниеОшибки + НСтр("ru = 'Некорректный email.'");
		ИначеЕсли СтрНайти(ОписаниеОшибки, "RESUME_NOT_FOUND") <> 0 Тогда
			УточненноеОписаниеОшибки = УточненноеОписаниеОшибки + НСтр("ru = 'Резюме не найдено.'");
		КонецЕсли;
		
		Если Ошибка["code"] = "ENTITY_NOT_FOUND" Тогда
			ЧастиПоля = СтрРазделить(Ошибка["field"], ".");
			Поле = РекрутинговыеСайтыСлужебный.ПредставлениеПоля(Сайт, ЭтотОбъект, ЧастиПоля[ЧастиПоля.ВГраница()]);
			УточненноеОписаниеОшибки =
				УточненноеОписаниеОшибки + РекрутинговыеСайтыСлужебный.ОписаниеНезаполненногоПоля(Поле);
		Иначе
			УточненноеОписаниеОшибки = УточненноеОписаниеОшибки + Символы.ПС + Ошибка["user_message"];
		КонецЕсли;
	ИначеЕсли КодСостояния = 401 Тогда
		Если СтрНайти(ОписаниеОшибки, "Не авторизован") <> 0 Тогда
			УточненноеОписаниеОшибки = УточненноеОписаниеОшибки + НСтр("ru = 'Пользователь не авторизован.'");
		КонецЕсли;
	ИначеЕсли КодСостояния = 200 Тогда
		Если СтрНайти(ОписаниеОшибки, "TARIFF_NOT_FOUND") <> 0 Тогда
			УточненноеОписаниеОшибки = УточненноеОписаниеОшибки + НСтр("ru = 'Тариф не найден.'");
		КонецЕсли;
	КонецЕсли;
	
	Возврат УточненноеОписаниеОшибки;

КонецФункции

#КонецОбласти

