// Параметры:
//  Отбор - Неопределено, Структура -
//  Поля - Строка
// 
// Возвращаемое значение:
//  Структура -  Тело запроса объект:
// * limit - Число - 
// * filter - Структура, Неопределено -
// * fields - Массив из Строка
// * offset - Число - 
Функция ТелоЗапросаОбъект(Отбор = Неопределено, Поля = Неопределено)

	Результат = Новый Структура;

	Результат.Вставить("limit", 1000);
	Результат.Вставить("filter", ?(Отбор = Неопределено, Новый Структура, Отбор));
	Результат.Вставить("fields", ?(Поля = Неопределено, Новый Массив, СтрРазделить(Поля, ",")));
	Результат.Вставить("offset", 0);

	Возврат Результат;

КонецФункции

// Параметры:
//  Запрос - См. НовыйHTTPЗапрос
//  Тело - См. ТелоЗапросаОбъект
//  ИмяПоляРезультата - Строка
//  ТекстОшибки - Строка
// 
// Возвращаемое значение:
//  Массив из См. ЗначениеСвойстваУзла
Функция ВсеРезультатыЗапроса(Запрос, Тело, ИмяПоляРезультата)

	Результат = Новый Массив;
	Итерация = 0;
	КоличествоРезультатов = Тело.limit + 1;

	Пока КоличествоРезультатов > Тело.limit Цикл
		Тело.offset = Тело.limit * Итерация;
		РезультатЗапроса = ОтправитьЗапросСТелом(Запрос, Тело);

		Если РезультатЗапроса.КодСостояния <> 200 Тогда
			ВызватьИсключение РекрутинговыеСайтыСлужебный.ТекстОшибкиПоОписанию(Сайт, ЭтотОбъект, РезультатЗапроса);
		Иначе
			РекрутинговыеСайтыСлужебный.ПрочитатьHTTPОтвет(РезультатЗапроса);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, ЗначениеСвойстваУзла(РезультатЗапроса.ОтветОбъект,
				"response", ИмяПоляРезультата));
			КоличествоРезультатов =
				ЗначениеСвойстваУзла(РезультатЗапроса.ОтветОбъект, "response", "total") - (Тело.limit * Итерация);
		КонецЕсли;

		Итерация = Итерация + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗагрузитьКлассификаторРегионов(НовыеКлассификаторы)

	Регионы = Новый Массив;

	Для Каждого ИдентификаторСтраны Из ИдентификаторыСтран() Цикл
		Отборы = Новый Массив;

		Отбор = Новый Структура;
		Отбор.Вставить("country_ids", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторСтраны));
		Отбор.Вставить("level", 1);
		Отборы.Добавить(Отбор);

		Отбор = Новый Структура;
		Отбор.Вставить("country_ids", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторСтраны));
		Отбор.Вставить("type_ids", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(2));
		Отборы.Добавить(Отбор);

		Для Каждого Отбор Из Отборы Цикл
			Запрос = НовыйHTTPЗапрос("v5/regions/suggest.json");
			Тело = ТелоЗапросаОбъект(Отбор, "id,name,tree_path_ids");

			Попытка
				Классификатор = ВсеРезультатыЗапроса(Запрос, Тело, "regions");
			Исключение
				РекрутинговыеСайтыСлужебный.СообщитьОбОшибке(ОписаниеОшибки(), Сайт, ЭтотОбъект);
				Продолжить;
			КонецПопытки;

			Для Каждого Регион Из Классификатор Цикл
				Регион.Вставить("countryId", ИдентификаторСтраны);
			КонецЦикла;

			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Регионы, Классификатор);
		КонецЦикла;
	КонецЦикла;

	НовыеКлассификаторы.Вставить("regions", ОбщегоНазначения.ФиксированныеДанные(Регионы));

КонецПроцедуры

Функция ИдентификаторыСтран()

	ИдентификаторыСтран = Новый Массив;
	ИдентификаторыСтран.Добавить(1);
	ИдентификаторыСтран.Добавить(5);
	ИдентификаторыСтран.Добавить(6);

	Возврат ИдентификаторыСтран;

