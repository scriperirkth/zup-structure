Функция СписокВыбораПоКлассификатору(Путь) Экспорт

	СписокВыбора = Новый СписокЗначений;

	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат СписокВыбора;
	КонецЕсли;

	Классификаторы = КлассификаторыСайта();
	Если Классификаторы = Неопределено Или Не Классификаторы.Свойство(Путь) Тогда
		Возврат СписокВыбора;
	КонецЕсли;

	Для Каждого Элемент Из Классификаторы[Путь] Цикл
		СписокВыбора.Добавить(ЗначениеСвойстваУзла(Элемент, "id"), ЗначениеСвойстваУзла(Элемент, "name"));
	КонецЦикла;
	
	Если Путь = "skills" Или Путь = "specializations" Тогда
		СписокВыбора.СортироватьПоПредставлению();
	КонецЕсли;
	
	Возврат СписокВыбора;

КонецФункции

Функция ОпубликоватьВакансию(Дерево) Экспорт

	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();

	ОписаниеВакансии = ОписаниеВакансии(Дерево);

	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойСозданияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;

	Запрос = НовыйHTTPЗапрос("v6/me/vacancy/create.json");
	РезультатЗапроса = ОтправитьЗапросСТелом(Запрос, ОписаниеВакансии);

	Если РезультатЗапроса.КодСостояния = 200 Тогда
		Публикации = ПрочитатьОтветПубликацияВакансии(РезультатЗапроса);

		Для Каждого Публикация Из Публикации Цикл
			Если Не ЗначениеСвойстваУзла(Публикация, "is_succeed") Тогда
				Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойСозданияВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
			КонецЕсли;

			Результат.ИдентификаторВакансии = ЗначениеСвойстваУзла(Публикация, "id");
		КонецЦикла;

		ЗаполнитьТарифы(Результат);
	Иначе
		Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойСозданияВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПрименитьТарифКВакансии(Идентификатор, Тариф) Экспорт

	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();

	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойСозданияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;

	Тело = Новый Структура("vacancies",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
			Новый Структура("id, order_item_id", Число(Идентификатор), Тариф)));

	Запрос = НовыйHTTPЗапрос("v6/me/vacancies/publish.json");
	РезультатЗапроса = ОтправитьЗапросСТелом(Запрос, Тело);

	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
		
		Если РезультатЗапроса.КодСостояния = 500 Тогда
			Результат.ТекстОшибки = НСтр("ru = 'Возможно, выбранный тариф не активирован.'");
		КонецЕсли;
	Иначе
		Вакансии = ПрочитатьОтветПубликация(РезультатЗапроса);
		
		Для Каждого Вакансия Из Вакансии Цикл
			Если Не Вакансия.is_succeed Тогда
				Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Результат.ИдентификаторВакансии = Идентификатор;

	Возврат Результат;

КонецФункции

Функция СнятьПубликациюВакансии(ИдентификаторВакансии) Экспорт

	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();

	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойСнятияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;

	Тело = Новый Структура("vacancy_ids", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Число(ИдентификаторВакансии)));
	Запрос = НовыйHTTPЗапрос("v5/me/vacancies/unpublish.json");
	РезультатЗапроса = ОтправитьЗапросСТелом(Запрос, Тело);
	
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойСнятияВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ОбновитьПубликациюВакансии(Дерево, ИдентификаторВакансии) Экспорт

	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();

	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойОбновленияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;

	ОписаниеВакансии = ОписаниеВакансии(Дерево, Истина);
	ОписаниеВакансии.vacancy.Вставить("id", Число(ИдентификаторВакансии));

	Запрос = НовыйHTTPЗапрос("v6/me/vacancy/edit.json");
	РезультатЗапроса = ОтправитьЗапросСТелом(Запрос, ОписаниеВакансии);

	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойОбновленияВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	Иначе
		Результат.ИдентификаторВакансии = ИдентификаторВакансии;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПовторноОпубликоватьВакансию(Дерево, Вакансия, ИдентификаторВакансии) Экспорт
	
	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();
	
	Результат = ОбновитьПубликациюВакансии(Дерево, ИдентификаторВакансии);
	ЗаполнитьТарифы(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СвойстваПубликацииВакансииНаСайте(ИдентификаторВакансии) Экспорт

	СвойстваПубликации = РекрутинговыеСайтыСлужебный.НовыеСвойстваПубликацииВакансии();

	Если Не УстановитьСоединение() Тогда
		Возврат СвойстваПубликации;
	КонецЕсли;
	
	Описание = ОписаниеПубликацииВакансии(ИдентификаторВакансии, "published_at,modified_date,last_modified_at,status");
	Если ЗначениеЗаполнено(Описание) Тогда
		СвойстваПубликации.Опубликована = ЗначениеСвойстваУзла(Описание, "status") = "publish";

		Если СвойстваПубликации.Опубликована Тогда
			СвойстваПубликации.ДатаПубликации =
				РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Описание, "published_at"));
			СвойстваПубликации.ДатаОбновления =
				РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Описание, "modified_date"));
		Иначе
			СвойстваПубликации.ДатаСнятияСПубликации =
				РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Описание, "last_modified_at"));
			СвойстваПубликации.ДатаСнятияСПубликации = ?(СвойстваПубликации.ДатаСнятияСПубликации > ТекущаяДатаСеанса(),
				Дата(1,1,1), СвойстваПубликации.ДатаСнятияСПубликации);
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Возврат СвойстваПубликации;

КонецФункции

Процедура ПолучитьОтклики(Вакансия) Экспорт

	ИдентификаторыВакансии = РекрутинговыеСайтыСлужебный.ИдентификаторыПубликацийВакансии(Вакансия, Сайт);
	
	Если Не ЗначениеЗаполнено(ИдентификаторыВакансии) Тогда
		РекрутинговыеСайтыСлужебный.СообщитьОбОтсутствииПубликации(Сайт);
		Возврат;
	КонецЕсли;
	
	ЗагруженныеОткликиВакансии = РекрутинговыеСайтыСлужебный.ЗагруженныеОткликиВакансии(Вакансия);
	Отклики = РекрутинговыеСайтыСлужебный.НоваяТаблицаОткликов();
	
	Для Каждого ИдентификаторВакансии Из ИдентификаторыВакансии Цикл
		
		ОткликиСсайта = ОткликиСсайта(ИдентификаторВакансии);
		
		Если Не ЗначениеЗаполнено(ОткликиСсайта) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Отклик Из ОткликиСсайта Цикл
			ОписаниеРезюме = ЗначениеСвойстваУзла(Отклик, "resume");
			
			Если Не ЗначениеЗаполнено(ОписаниеРезюме) Тогда
				Продолжить;
			КонецЕсли;
		
			ИдентификаторРезюме = Формат(ЗначениеСвойстваУзла(ОписаниеРезюме, "id"), "ЧГ=");
			
			Если ЗагруженныеОткликиВакансии.Найти(ИдентификаторРезюме) = Неопределено Тогда
				НоваяЗапись = Отклики.Добавить();
				НоваяЗапись.Источник = Сайт;
				НоваяЗапись.Вакансия = Вакансия;
				НоваяЗапись.ИдентификаторРезюме = ИдентификаторРезюме;
				НоваяЗапись.Имя = ЗначениеСвойстваУзла(ОписаниеРезюме, "first_name");
				НоваяЗапись.Фамилия = ЗначениеСвойстваУзла(ОписаниеРезюме, "last_name");
				НоваяЗапись.Отчество = ЗначениеСвойстваУзла(ОписаниеРезюме, "middle_name");
				НоваяЗапись.АдресРезюме = СтрШаблон(ДанныеСайта.ГлавнаяСтраница + "resume%1.html", ИдентификаторРезюме);
				НоваяЗапись.ДатаОтклика =
					РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Отклик, "created_at"));

				Если ЗначениеЗаполнено(ЗначениеСвойстваУзла(ОписаниеРезюме, "birth_at")) Тогда
					НоваяЗапись.ДатаРождения =
						РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(ОписаниеРезюме, "birth_at"));
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЗначениеСвойстваУзла(ОписаниеРезюме, "email")) Тогда
					НоваяЗапись.EMail = ЗначениеСвойстваУзла(ОписаниеРезюме, "email");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЗначениеСвойстваУзла(ОписаниеРезюме, "phone")) Тогда
					НоваяЗапись.Телефон = ЗначениеСвойстваУзла(ОписаниеРезюме, "phone");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЗначениеСвойстваУзла(ОписаниеРезюме, "region")) Тогда
					НоваяЗапись.Адрес = ЗначениеСвойстваУзла(ОписаниеРезюме, "region", "name");
				КонецЕсли;
				
				// Получим текст сопроводительного письма
				Запрос = НовыйHTTPЗапрос("v5/me/response/messages.json");
				Тело = ТелоЗапросаОбъект();
				Тело.Вставить("response_id", ЗначениеСвойстваУзла(Отклик, "id"));

				Попытка
					СообщенияПоОтклику = ВсеРезультатыЗапроса(Запрос, Тело, "messages");
				Исключение
					Сообщение = НСтр("ru = 'Не удалось получить сопроводительное письмо по отклику.'") + Символы.ПС + ОписаниеОшибки();
					РекрутинговыеСайтыСлужебный.СообщитьОбОшибке(Сообщение, Сайт, ЭтотОбъект);
					Продолжить;
				КонецПопытки;

				Если ЗначениеЗаполнено(СообщенияПоОтклику) Тогда
					Для Каждого СообщениеПоОтклику Из СообщенияПоОтклику Цикл
						Если СообщениеПоОтклику.is_employer_message Тогда
							Продолжить;
						КонецЕсли;
						
						НоваяЗапись.Сообщение = СообщениеПоОтклику.text;
						НоваяЗапись.ДатаОтклика = РекрутинговыеСайтыСлужебный.ДатаПоСтроке(СообщениеПоОтклику.sent_at);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	РекрутинговыеСайтыСлужебный.ЗаписатьОтклики(Отклики, Пользователь);

КонецПроцедуры

