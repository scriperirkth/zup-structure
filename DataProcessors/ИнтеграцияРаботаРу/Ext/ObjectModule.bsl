#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем Соединение; // HTTPСоединение

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция Подключить(Код) Экспорт

	Результат = РекрутинговыеСайтыСлужебный.НовыеРеквизитыСайта();

	КодАвторизации = Код;

	СтруктураМаркеров = СтруктураМаркеров();

	Если ЗначениеЗаполнено(СтруктураМаркеров.МаркерДоступа) Тогда
		Результат.Подключен = Истина;

		ИнформацияОПользователе = ИнформацияОПользователе();

		Результат.МаркерДоступа = СтруктураМаркеров.МаркерДоступа;
		Результат.МаркерОбновления = СтруктураМаркеров.МаркерОбновления;
		Результат.ДатаОкончанияДействияМаркераДоступа = СтруктураМаркеров.ДатаОкончанияДействияМаркераДоступа;

		Результат.ИмяПользователя = ИнформацияОПользователе.ИмяПользователя;
		Результат.ИдентификаторПользователя = ИнформацияОПользователе.ИдентификаторПользователя;
		Результат.КодАвторизации = КодАвторизации;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ИнформацияОПользователе() Экспорт

	ИнформацияОПользователе = РекрутинговыеСайтыСлужебный.НоваяИнформацияОПользователе();

	Если Не УстановитьСоединение() Тогда
		Возврат ИнформацияОПользователе;
	КонецЕсли;

	Запрос = НовыйHTTPЗапрос("v6/me.json");

	РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().ОтправитьДляОбработки, Запрос);

	Если РезультатЗапроса.КодСостояния = 200 Тогда
		ИнформацияОПользователеРаботаРу = ПрочитатьОтветИнформацияОПользователе(РезультатЗапроса);
	Иначе
		РекрутинговыеСайтыСлужебный.СообщитьОбОшибкеИнформацияОПользователе(Сайт, ЭтотОбъект, РезультатЗапроса);
		Возврат ИнформацияОПользователе;
	КонецЕсли;

	ИнформацияОПользователе.ИмяПользователя = ИнформацияОПользователеРаботаРу.email.value;
	ИнформацияОПользователе.ИдентификаторПользователя = ИнформацияОПользователеРаботаРу.id;

	Возврат ИнформацияОПользователе;

КонецФункции

// Возвращаемое значение:
//  Структура: см. РекрутинговыеСайтыСлужебный.НовыеРеквизитыСайта
// 
// Параметры:
//  Показыватьпредупреждение - Булево -
Функция ПроверитьПодключение(Показыватьпредупреждение = Истина) Экспорт

	Результат = РекрутинговыеСайтыСлужебный.НовыеРеквизитыСайта();

	РеквизитыСайта = РекрутинговыеСайтыСлужебный.РеквизитыСайта(Сайт, Пользователь);

	Если ЗначениеЗаполнено(РеквизитыСайта) Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыСайта);
		Результат.Подключен = МаркерАктивен(Показыватьпредупреждение);
		Результат.ИмяПользователя = РеквизитыСайта.ИмяПользователя;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЗагрузитьКлассификаторы() Экспорт

	Классификаторы = ПараметрыСеанса.ПараметрыКлиентаНаСервере.Получить("КлассификаторыRabota");

	Если Классификаторы <> Неопределено Тогда
		Возврат Классификаторы;
	КонецЕсли;

	Если Не УстановитьСоединение() Тогда
		Возврат Классификаторы;
	КонецЕсли;

	НовыеКлассификаторы = Новый Структура;
	
	ИменаКлассификаторов = Новый Соответствие;
	ИменаКлассификаторов.Вставить("skills", "v5/skills");
	ИменаКлассификаторов.Вставить("specializations", "v5/specializations");
	ИменаКлассификаторов.Вставить("countries", "v5/countries");
	ИменаКлассификаторов.Вставить("educations", "v5/educations");
	ИменаКлассификаторов.Вставить("experiences", "v5/experiences");
	ИменаКлассификаторов.Вставить("workplaces", "v5/me/company/workplaces");
	ИменаКлассификаторов.Вставить("professional_areas", "v5/professional_areas");
	ИменаКлассификаторов.Вставить("employments", "v6/employment");
	ИменаКлассификаторов.Вставить("work_hours", "v6/work_hours");
	ИменаКлассификаторов.Вставить("work_schedules", "v6/work_schedule");

	Для Каждого КлючИЗначение Из ИменаКлассификаторов Цикл
		Запрос = НовыйHTTPЗапрос(СтрШаблон("%1.json", КлючИЗначение.Значение));
		Тело = ТелоЗапросаОбъект();

		Попытка
			Классификатор = ВсеРезультатыЗапроса(Запрос, Тело, КлючИЗначение.Ключ);
			НовыеКлассификаторы.Вставить(КлючИЗначение.Ключ, ОбщегоНазначения.ФиксированныеДанные(Классификатор));
		Исключение
			РекрутинговыеСайтыСлужебный.СообщитьОбОшибке(ОписаниеОшибки(), Сайт, ЭтотОбъект);
		КонецПопытки;
	КонецЦикла;

	ЗагрузитьКлассификаторРегионов(НовыеКлассификаторы);

	Классификаторы = Новый ФиксированнаяСтруктура(НовыеКлассификаторы);

	ТекущиеПараметры = РекрутинговыеСайтыСлужебный.СоответствиеПоФиксированномуСоответствию(
		ПараметрыСеанса.ПараметрыКлиентаНаСервере);
	ТекущиеПараметры.Вставить("КлассификаторыRabota", Классификаторы);

	УстановитьПривилегированныйРежим(Истина);
	ПараметрыСеанса.ПараметрыКлиентаНаСервере = Новый ФиксированноеСоответствие(ТекущиеПараметры);
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Классификаторы;

КонецФункции

Функция ЗаполнитьДеревоКлассификатора(Классификатор, Дерево) Экспорт

	Результат = Ложь;

	Если Классификатор = "professional_areas" Тогда
		Результат = ЗаполнитьДеревоРубрик(Дерево);
	ИначеЕсли Классификатор = "regions" Или Классификатор = "areas_towns" Тогда
		Результат = ЗаполнитьДеревоРегионов(Дерево);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЭлементКлассификатора(ИмяСписка, Значение) Экспорт

	Возврат Неопределено;

КонецФункции

Функция ИдентификаторРезюмеПоАдресу(АдресРезюме) Экспорт

	Разделитель = "resume";

	ИдентификаторРезюме = СтрЗаменить(АдресРезюме, ".html", "");

	Пока РекрутинговыеСайтыКлиентСервер.НайтиВСтроке(ИдентификаторРезюме, Разделитель) > 0 Цикл
		НомерВхожденияРазделителя = РекрутинговыеСайтыКлиентСервер.НайтиВСтроке(ИдентификаторРезюме, Разделитель);
		ИдентификаторРезюме = Сред(ИдентификаторРезюме, НомерВхожденияРазделителя + СтрДлина(Разделитель), СтрДлина(
			ИдентификаторРезюме) - НомерВхожденияРазделителя);
	КонецЦикла;

	Возврат ИдентификаторРезюме;

КонецФункции

Функция ДанныеКандидатаПоРезюмеССайта(ИдентификаторРезюме) Экспорт

	ДанныеКандидата = Справочники.Кандидаты.СтруктураДанныхКандидата();

	СтруктураРезюме = СтруктураРезюмеССайта(ИдентификаторРезюме);

	Если ЗначениеЗаполнено(СтруктураРезюме) Тогда
		ДанныеКандидата = ДанныеКандидатаПоРезюме(СтруктураРезюме);

		ДанныеКандидата.Комментарии = ЗначениеСвойстваУзла(СтруктураРезюме, "Комментарии");
		ДанныеКандидата.ДанныеПубликации = СтруктураРезюме;
	Иначе
		ВызватьИсключение РекрутинговыеСайтыСлужебный.ТекстИсключенияПриОшибкеЗагрузкиРезюмеПоСсылке(Сайт);
	КонецЕсли;

	Возврат ДанныеКандидата;

КонецФункции

Функция ВакансииССайта(БылиОшибки = Ложь) Экспорт
	
	Вакансии = Новый Массив;
	
	Если Не УстановитьСоединение() Тогда
		БылиОшибки = Истина;
		Возврат Вакансии;
	КонецЕсли;
	
	ЗагрузитьКлассификаторы();
	
	Запрос = НовыйHTTPЗапрос("v5/me/vacancies.json");
	
	Попытка
		Вакансии = ВсеРезультатыЗапроса(Запрос, ТелоЗапросаОбъект(), "vacancies");
	Исключение
		БылиОшибки = Истина;
		РекрутинговыеСайтыСлужебный.СообщитьОбОшибке(ОписаниеОшибки(), Сайт, ЭтотОбъект);
		Возврат Вакансии;
	КонецПопытки;
	
	Для Каждого Вакансия Из Вакансии Цикл
		Вакансия.Вставить("link", АдресВакансии(Формат(ЗначениеСвойстваУзла(Вакансия, "id"), "ЧГ=;")));
	КонецЦикла;
	
	Возврат Вакансии;
	
КонецФункции

Функция ЗначениеРеквизитаПубликацииПоУмолчанию(Вакансия, Реквизит) Экспорт
	
	Результат = Неопределено;
	
	Если Реквизит = "Наименование" Тогда
		Результат = ЗначениеСвойстваУзла(Вакансия, "title");
	ИначеЕсли Реквизит = "ПредполагаемыйДоход" Тогда
		Результат = ЗначениеСвойстваУзла(Вакансия, "salary", "to", , 0);
		Результат = ?(ЗначениеЗаполнено(Результат), Результат, ЗначениеСвойстваУзла(Вакансия, "salary", "from", , 0));
	ИначеЕсли Реквизит = "ДатаОткрытия" Тогда
		Дата = ЗначениеСвойстваУзла(Вакансия, "publish_start_at");
		Результат = ?(ЗначениеЗаполнено(Дата), РекрутинговыеСайтыСлужебный.ДатаПоСтроке(Дата), Неопределено);
	ИначеЕсли Реквизит = "ПланируемаяДатаЗакрытия" Тогда
		Дата = ЗначениеСвойстваУзла(Вакансия, "publish_end_at");
		Результат = ?(ЗначениеЗаполнено(Дата), РекрутинговыеСайтыСлужебный.ДатаПоСтроке(Дата), Неопределено);
	ИначеЕсли Реквизит = "Требования" Тогда
		Результат = РекрутинговыеСайтыСлужебный.ОписаниеТребованийОбязанностейУсловий(
			ЗначениеСвойстваУзла(Вакансия, "description")).Требования;
	ИначеЕсли Реквизит = "Обязанности" Тогда
		Результат = РекрутинговыеСайтыСлужебный.ОписаниеТребованийОбязанностейУсловий(
			ЗначениеСвойстваУзла(Вакансия, "description")).Обязанности;
	ИначеЕсли Реквизит = "Условия" Тогда
		Результат = РекрутинговыеСайтыСлужебный.ОписаниеТребованийОбязанностейУсловий(
			ЗначениеСвойстваУзла(Вакансия, "description")).Условия;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьДеревоВакансии(Вакансия, Дерево, СтруктураВакансииССайта) Экспорт
	
	НоваяСтрока = Дерево.Строки.Добавить();
	НоваяСтрока.Показатель = Вакансия;
	
	// Заголовок
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "title";
	НовоеПоле.ПубликацияВакансии = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "title");
	
	// Зарплата
	Если ЗначениеЗаполнено(ЗначениеСвойстваУзла(СтруктураВакансииССайта, "salary")) Тогда
		НовоеПоле = НоваяСтрока.Строки.Добавить();
		НовоеПоле.Путь = "salary.from";
		НовоеПоле.ПубликацияВакансии = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "salary", "from");

		НовоеПоле = НоваяСтрока.Строки.Добавить();
		НовоеПоле.Путь = "salary.to";
		НовоеПоле.ПубликацияВакансии = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "salary", "to");
	КонецЕсли;
	
	// Описание
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "description";
	НовоеПоле.ПубликацияВакансии = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "description");
	
	// Регионы
	Регионы = Новый СписокЗначений;
	Для Каждого Регион Из ЗначениеСвойстваУзла(СтруктураВакансииССайта, "regions") Цикл
		Регионы.Добавить(Регион.id, Регион.name);
	КонецЦикла;

	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "regions";
	НовоеПоле.ПубликацияВакансии = Регионы;
	
	// Адреса
	Адреса = Новый СписокЗначений;
	Для Каждого Адрес Из ЗначениеСвойстваУзла(СтруктураВакансииССайта, "places") Цикл
		Адреса.Добавить(
			ЗначениеСвойстваУзла(Адрес, "id"), ЗначениеСвойстваУзла(Адрес, "name"));
	КонецЦикла;

	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "places";
	НовоеПоле.ПубликацияВакансии = Адреса;
	
	// Контактное лицо
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "contact_person.name";
	НовоеПоле.ПубликацияВакансии = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "contact_person", "name");

	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "contact_person.email";
	НовоеПоле.ПубликацияВакансии = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "contact_person", "email");
	
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "contact_person.phones";
	Телефоны = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "contact_person", "phones");
	Если ЗначениеЗаполнено(Телефоны) Тогда
		НовоеПоле.ПубликацияВакансии = Телефоны[0].number_international;
	КонецЕсли;
	
	// Опыт работы
	ОпытРаботы = Новый СписокЗначений;
	ОпытРаботы.Добавить(
		ЗначениеСвойстваУзла(СтруктураВакансииССайта, "experience", "id"),
		ЗначениеСвойстваУзла(СтруктураВакансииССайта, "experience", "name"));
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "experience";
	НовоеПоле.ПубликацияВакансии = ОпытРаботы;
		
	// Специализация
	Специализации = Новый СписокЗначений;
	Для Каждого Специализация Из ЗначениеСвойстваУзла(СтруктураВакансииССайта, "specializations") Цикл
		Специализации.Добавить(ЗначениеСвойстваУзла(Специализация, "id"), ЗначениеСвойстваУзла(Специализация, "name"));
	КонецЦикла;
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "specializations";
	НовоеПоле.ПубликацияВакансии = Специализации;
	
	// Ключевые навыки
	Навыки = Новый СписокЗначений;
	Для Каждого Навык Из ЗначениеСвойстваУзла(СтруктураВакансииССайта, "skills") Цикл
		Навыки.Добавить(ЗначениеСвойстваУзла(Навык, "id"), ЗначениеСвойстваУзла(Навык, "name"));
	КонецЦикла;
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "skills";
	НовоеПоле.ПубликацияВакансии = Навыки;
	
	// Тип занятости
	ТипыЗанятости = Новый СписокЗначений;
	ИдентификаторТипаЗанятости = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "employment_id");
	Для Каждого ЭлементСправочника Из КлассификаторыСайта().employments Цикл
		Если ЭлементСправочника.id = ИдентификаторТипаЗанятости Тогда
			ТипыЗанятости.Добавить(ИдентификаторТипаЗанятости, ЭлементСправочника.name);
		КонецЕсли;
	КонецЦикла;
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "employment_id";
	НовоеПоле.ПубликацияВакансии = ТипыЗанятости;
	
	// Режим работы
	РежимыРаботы = Новый СписокЗначений;
	ИдентификаторРежимаРаботы = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "work_hour_id");
	Для Каждого ЭлементСправочника Из КлассификаторыСайта().work_hours Цикл
		Если ЭлементСправочника.id = ИдентификаторРежимаРаботы Тогда
			РежимыРаботы.Добавить(ИдентификаторРежимаРаботы, ЭлементСправочника.name);
		КонецЕсли;
	КонецЦикла;
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "work_hour_id";
	НовоеПоле.ПубликацияВакансии = РежимыРаботы;
	
	// График работы
	ИдентификаторыГрафиковРаботы = Новый СписокЗначений;
	ИдентификаторГрафикаРаботы = ЗначениеСвойстваУзла(СтруктураВакансииССайта, "work_schedule_id");
	Для Каждого ЭлементСправочника Из КлассификаторыСайта().work_schedules Цикл
		Если ЭлементСправочника.id = ИдентификаторГрафикаРаботы Тогда
			ИдентификаторыГрафиковРаботы.Добавить(ИдентификаторГрафикаРаботы, ЭлементСправочника.name);
		КонецЕсли;
	КонецЦикла;
	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "work_schedule_id";
	НовоеПоле.ПубликацияВакансии = ИдентификаторыГрафиковРаботы;
	
	// Образование
	Образование = Новый СписокЗначений;
	Образование.Добавить(
		ЗначениеСвойстваУзла(СтруктураВакансииССайта, "education", "id"), ЗначениеСвойстваУзла(СтруктураВакансииССайта,
		"education", "name"));

	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "education";
	НовоеПоле.ПубликацияВакансии = Образование;
	
	// Профессиональные области
	Профессии = Новый СписокЗначений;
	Для Каждого Профессия Из ЗначениеСвойстваУзла(СтруктураВакансииССайта, "professional_areas") Цикл
		Профессии.Добавить(ЗначениеСвойстваУзла(Профессия, "id"), ЗначениеСвойстваУзла(Профессия, "name"));
	КонецЦикла;

	НовоеПоле = НоваяСтрока.Строки.Добавить();
	НовоеПоле.Путь = "professional_areas";
	НовоеПоле.ПубликацияВакансии = Профессии;
	
	// Дополнительная информация
	Если ЗначениеЗаполнено(ЗначениеСвойстваУзла(СтруктураВакансииССайта, "additional_settings")) Тогда
		НовоеПоле = НоваяСтрока.Строки.Добавить();
		НовоеПоле.Путь = "additional_settings.is_work_for_students";
		НовоеПоле.ПубликацияВакансии =
			ЗначениеСвойстваУзла(СтруктураВакансииССайта, "additional_settings", "is_work_for_students");
		
		НовоеПоле = НоваяСтрока.Строки.Добавить();
		НовоеПоле.Путь = "additional_settings.can_invite_foreign_person";
		НовоеПоле.ПубликацияВакансии =
			ЗначениеСвойстваУзла(СтруктураВакансииССайта, "additional_settings", "can_invite_foreign_person");
	КонецЕсли;
	
КонецПроцедуры

