Функция ОтправитьЗапросСТелом(Запрос, Тело)

	Запрос.УстановитьТелоИзСтроки(ЗаписьJSON(Новый Структура("request", Тело)));

	Возврат ВыполнитьHTTPЗапрос(МетодыЗапросов().ОтправитьДляОбработки, Запрос);

КонецФункции

Функция Подпись(ИдентификаторПриложения, МеткаВремени, КодАвторизации = "")

	Если КодАвторизации = "" Тогда
		ШаблонПодписи = "{""app_id"":""%1"",""time"":""%2"",""token"":""%3""}%4";

		Подпись = СтрШаблон(ШаблонПодписи, ИдентификаторПриложения.client_id, МеткаВремени, МаркерДоступа,
			ИдентификаторПриложения.client_secret);
	Иначе
		ШаблонПодписи = "{""app_id"":""%1"",""code"":""%2"",""time"":""%3""}%4";

		Подпись = СтрШаблон(ШаблонПодписи, ИдентификаторПриложения.client_id, КодАвторизации, МеткаВремени,
			ИдентификаторПриложения.client_secret);
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Подпись);

	Возврат НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));

КонецФункции

