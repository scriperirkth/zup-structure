Функция ЗначениеСвойстваУзла(Узел, ИмяСвойства, ИмяСвойстваВторогоУровня = Неопределено,
	ИмяСвойстваТретьегоУровня = Неопределено, ЗначениеПоУмолчанию = "")

	Возврат РекрутинговыеСайтыСлужебный.ЗначениеСвойстваУзла(
				Узел, ИмяСвойства, ИмяСвойстваВторогоУровня, ИмяСвойстваТретьегоУровня, ЗначениеПоУмолчанию);

КонецФункции

Функция ЗаполнитьДеревоРубрик(Дерево)

	Результат = Ложь;

	Классификаторы = КлассификаторыСайта();

	Если Классификаторы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Рубрики = ЗначениеСвойстваУзла(Классификаторы, "professional_areas");
	СтрокиСПутями = Новый Соответствие;

	Для Каждого Рубрика Из Рубрики Цикл
		Путь = ЗначениеСвойстваУзла(Рубрика, "tree");
		СтрокаРодителя = СтрокаРодителяРубрики(СтрокиСПутями, Путь);

		Если СтрокаРодителя <> Неопределено Тогда
			НоваяСтрока = СтрокаРодителя.Строки.Добавить();
		Иначе
			НоваяСтрока = Дерево.Строки.Добавить();
		КонецЕсли;

		НоваяСтрока.Идентификатор = ЗначениеСвойстваУзла(Рубрика, "id");
		НоваяСтрока.Значение = ЗначениеСвойстваУзла(Рубрика, "name");

		СтрокиСПутями.Вставить(Путь, НоваяСтрока);
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СтрокаРодителяРубрики(СтрокиСПутями, Путь, Уровень = 2)

	ЧастиПутиКлассификатора = СтрРазделить(Путь, ".");
	Если Уровень > ЧастиПутиКлассификатора.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиПути = Новый Массив;
	Для Индекс = 0 По ЧастиПутиКлассификатора.Количество() - Уровень Цикл
		ЧастиПути.Добавить(ЧастиПутиКлассификатора[Индекс]);
	КонецЦикла;

	ПутьДоРодителя = СтрСоединить(ЧастиПути, ".");

	СтрокаРодителя = СтрокиСПутями.Получить(ПутьДоРодителя);

	Если СтрокаРодителя = Неопределено Тогда
		СтрокаРодителя = СтрокаРодителяРубрики(СтрокиСПутями, Путь, Уровень + 1);
	КонецЕсли;

	Возврат СтрокаРодителя;

КонецФункции

Функция ЗаполнитьДеревоРегионов(Дерево)

	Результат = Ложь;

	КлассификаторыRabota = ПараметрыСеанса.ПараметрыКлиентаНаСервере.Получить("КлассификаторыRabota");

	Если КлассификаторыRabota = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Страны = ЗначениеСвойстваУзла(КлассификаторыRabota, "countries");

	ИдентификаторыДоступныхСтран = ИдентификаторыСтран();

	ИдентификаторыСтрокСтран = Новый Соответствие;

	Для Каждого СтрокаСтраны Из Страны Цикл
		Если ИдентификаторыДоступныхСтран.Найти(ЗначениеСвойстваУзла(СтрокаСтраны, "id")) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Дерево.Строки.Добавить();
		НоваяСтрока.Идентификатор = ЗначениеСвойстваУзла(СтрокаСтраны, "id");
		НоваяСтрока.Значение = ЗначениеСвойстваУзла(СтрокаСтраны, "name");

		ИдентификаторыСтрокСтран.Вставить(ЗначениеСвойстваУзла(СтрокаСтраны, "id"), НоваяСтрока);
	КонецЦикла;

	Регионы = ЗначениеСвойстваУзла(КлассификаторыRabota, "regions");
	ИдентификаторыРегионов = Новый Соответствие;
	ИдентификаторыСтрокРодителей = Новый Соответствие;

	Для Каждого Регион Из Регионы Цикл
		ИдентификаторыРегионов.Вставить(ЗначениеСвойстваУзла(Регион, "id"), Регион);
	КонецЦикла;

	Для Каждого КлючИЗначение Из ИдентификаторыРегионов Цикл
		Регион = КлючИЗначение.Значение;
		СтрокаСтраны = ИдентификаторыСтрокСтран.Получить(ЗначениеСвойстваУзла(Регион, "countryId"));
		Если СтрокаСтраны = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Путь = ЗначениеСвойстваУзла(Регион, "tree_path_ids");

		Если Путь.Количество() = 1 Тогда
			Если ИдентификаторыСтрокРодителей[ЗначениеСвойстваУзла(Регион, "id")] = Неопределено Тогда
				НоваяСтрока = СтрокаСтраны.Строки.Добавить();
				НоваяСтрока.Идентификатор = ЗначениеСвойстваУзла(Регион, "id");
				НоваяСтрока.Значение = ЗначениеСвойстваУзла(Регион, "name");

				ИдентификаторыСтрокРодителей.Вставить(ЗначениеСвойстваУзла(Регион, "id"), НоваяСтрока);
			КонецЕсли;
		Иначе
			ИдентификаторРодителя = Путь[0];
			Родитель = ИдентификаторыРегионов[ИдентификаторРодителя];
			СтрокаРодителя = ИдентификаторыСтрокРодителей[ЗначениеСвойстваУзла(Родитель, "id")];

			Если СтрокаРодителя = Неопределено Тогда
				СтрокаРодителя = СтрокаСтраны.Строки.Добавить();
				СтрокаРодителя.Идентификатор = ЗначениеСвойстваУзла(Родитель, "id");
				СтрокаРодителя.Значение = ЗначениеСвойстваУзла(Родитель, "name");

				ИдентификаторыСтрокРодителей.Вставить(ЗначениеСвойстваУзла(Родитель, "id"), СтрокаРодителя);
			КонецЕсли;

			НоваяСтрока = СтрокаРодителя.Строки.Добавить();
			НоваяСтрока.Идентификатор = ЗначениеСвойстваУзла(Регион, "id");
			НоваяСтрока.Значение = ЗначениеСвойстваУзла(Регион, "name");
		КонецЕсли;
	КонецЦикла;

	Для Каждого Строка Из Дерево.Строки Цикл
		Строка.Строки.Сортировать("Значение", Истина);
	КонецЦикла;

	Результат = Истина;

	Возврат Результат;

КонецФункции

Функция ДанныеКандидатаПоРезюме(СтруктураРезюме)

	ДанныеКандидата = Справочники.Кандидаты.СтруктураДанныхКандидата();
	
	ДанныеКандидата.ИсточникИнформации = Сайт;
	ДанныеКандидата.Фамилия = ЗначениеСвойстваУзла(СтруктураРезюме, "last_name");
	ДанныеКандидата.Имя = ЗначениеСвойстваУзла(СтруктураРезюме, "first_name");
	ДанныеКандидата.Отчество = ЗначениеСвойстваУзла(СтруктураРезюме, "middle_name");
	ДатаРождениея = ЗначениеСвойстваУзла(СтруктураРезюме, "birth_at");
	ДанныеКандидата.ДатаРождения =
		?(ЗначениеЗаполнено(ДатаРождениея), ПрочитатьДатуJSON(ДатаРождениея, ФорматДатыJSON.ISO), Дата(1,1,1));
	ДанныеКандидата.ОСебе = ЗначениеСвойстваУзла(СтруктураРезюме, "additional_information");
	ДанныеКандидата.Комментарии = ЗначениеСвойстваУзла(СтруктураРезюме, "Комментарии");
	ДанныеКандидата.Фото = ЗначениеСвойстваУзла(СтруктураРезюме, "Фото");
	ДанныеКандидата.ОжидаемыйДоход = ЗначениеСвойстваУзла(СтруктураРезюме, "salary", "to");
	ДанныеКандидата.ВалютаДохода = ПодборПерсонала.ВалютаПоСправочнику(ЗначениеСвойстваУзла(СтруктураРезюме, "salary",
		"currency"));
	ДанныеКандидата.АдресРезюме =
		СтрШаблон("https://www.rabota.ru/resume%1.html", Формат(ЗначениеСвойстваУзла(СтруктураРезюме, "id"), "ЧГ=;"));
	ДанныеКандидата.Гражданство.Добавить(
		Новый Структура("Страна, Дата", ЗначениеСвойстваУзла(СтруктураРезюме, "citizenship", "country", "name")));
	ДанныеКандидата.СостояниеВБраке.Добавить(
		Новый Структура("СостояниеВБраке, Дата", ?(ЗначениеСвойстваУзла(СтруктураРезюме, "is_married"), НСтр(
		"ru = 'Женат'"), НСтр("ru = 'Не женат'"))));
	ДанныеКандидата.Пол = ?(ЗначениеСвойстваУзла(СтруктураРезюме, "gender") = "male",
		РекрутинговыеСайтыСлужебный.МужскойПол(), РекрутинговыеСайтыСлужебный.ЖенскийПол());
	ЗаполнитьКонтактнуюИнформацию(СтруктураРезюме, ДанныеКандидата.КонтактнаяИнформация);
	ЗаполнитьОбразование(СтруктураРезюме, ДанныеКандидата.Образование);
	ЗаполнитьТрудовуюДеятельность(СтруктураРезюме, ДанныеКандидата.ТрудоваяДеятельность);

	Для Каждого ЗнаниеЯзыка Из ЗначениеСвойстваУзла(СтруктураРезюме, "languages") Цикл
		ЗнаниеЯзыков = РекрутинговыеСайтыСлужебный.НовоеЗнаниеЯзыка();
		ЗнаниеЯзыков.Язык = ЗначениеСвойстваУзла(ЗнаниеЯзыка, "name");
		ЗнаниеЯзыков.СтепеньЗнанияЯзыкаКандидата = СтепеньЗнанияЯзыкаПоИдентификатору(ЗначениеСвойстваУзла(ЗнаниеЯзыка,
			"level"));
		ДанныеКандидата.ЗнаниеЯзыков.Добавить(ЗнаниеЯзыков);
	КонецЦикла;
	
	ФайлРезюме = ЗначениеСвойстваУзла(СтруктураРезюме, "ФайлРезюме");
	Если ЗначениеЗаполнено(ФайлРезюме) И ЭтоАдресВременногоХранилища(ФайлРезюме.Хранение) Тогда
		ДвоичныеДанныеФайлаРезюме = ПолучитьИзВременногоХранилища(ФайлРезюме.Хранение);
		Если ДвоичныеДанныеФайлаРезюме <> Неопределено Тогда
			ФайлРезюме.ИмяФайла = СтрШаблон(
				НСтр("ru = 'Резюме %1 Работа.ру %2.pdf'"),
				ФизическиеЛицаКлиентСервер.ФамилияИнициалы(
					СтрШаблон("%1 %2 %3", ДанныеКандидата.Фамилия, ДанныеКандидата.Имя, ДанныеКандидата.Отчество)),
				Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yy;"));

			ВременноеИмяФайла = СтрШаблон("%1%2", КаталогВременныхФайлов(), ФайлРезюме.ИмяФайла);
			ДвоичныеДанныеФайлаРезюме.Записать(ВременноеИмяФайла);
			ФайлРезюме.ПолноеИмя = ВременноеИмяФайла;
			
			ДанныеКандидата.ФайлРезюме = ФайлРезюме;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЗначениеСвойстваУзла(СтруктураРезюме, "ТекстОшибки")) Тогда
		РекрутинговыеСайтыСлужебный.СообщитьПользователю(ЗначениеСвойстваУзла(СтруктураРезюме, "ТекстОшибки"));
	КонецЕсли;

	Возврат ДанныеКандидата;

КонецФункции

Функция СтруктураРезюмеССайта(ИдентификаторРезюме)

	Резюме = Неопределено;

	Если Не УстановитьСоединение() Тогда
		Возврат Резюме;
	КонецЕсли;

	Запрос = НовыйHTTPЗапрос("v5/me/resume.json");
	Тело = ТелоЗапросаОбъект();
	Тело.Вставить("id", ИдентификаторРезюме);

	РезультатЗапроса = ОтправитьЗапросСТелом(Запрос, Тело);

	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		ВызватьИсключение РекрутинговыеСайтыСлужебный.ТекстОшибкиПоОписанию(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;

	Резюме = ПрочитатьОтветСтруктураРезюме(РезультатЗапроса);

	КомментарииКандидата = МассивКомментариевКандидата(ИдентификаторРезюме);
	Резюме.Вставить("Комментарии", КомментарииКандидата);

	ДанныеФото = ЗначениеСвойстваУзла(Резюме, "photo");
	Если ЗначениеЗаполнено(ДанныеФото) Тогда
		Резюме.Вставить("Фото", РекрутинговыеСайтыСлужебный.КартинкаПоАдресу(ЗначениеСвойстваУзла(ДанныеФото,
			"url_original")));
	КонецЕсли;
	
	// Файл резюме
	Запрос = НовыйHTTPЗапрос(СтрШаблон("api/v1/private/resumes/%1.pdf", ИдентификаторРезюме));
	
	Запрос.Заголовки.Вставить("accept", "application/pdf");
	Запрос.Заголовки.Вставить(
		"application-id", ЗарплатаКадрыРасширенный.ИдентификацияПриложенияДляРаботаРу().client_id);
		
	Адрес = РекрутинговыеСайтыСлужебный.СкачатьФайл(
		РекрутинговыеСайтыСлужебный.НовоеHTTPСоединение(
			СтрЗаменить(АдресСервера(), "api.rabota", "resume-search.rabota")),
		Запрос);
	
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ФайлРезюме = ПодборПерсоналаКлиентСервер.ОписаниеФайлаРезюме();
		ФайлРезюме.Хранение = Адрес;
		
		Резюме.Вставить("ФайлРезюме", ФайлРезюме);
	КонецЕсли;
	
	Возврат Резюме;

КонецФункции

Функция ОткликиСсайта(ИдентификаторВакансии)
	
	Результат = Новый Массив();
	
	Если Не ЗначениеЗаполнено(ИдентификаторВакансии) Тогда
		РекрутинговыеСайтыСлужебный.СообщитьОбОтсутствииПубликации(Сайт);
		Возврат Результат;
	КонецЕсли;

	Если Не ПроверитьПодключение().Подключен Тогда
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуПолученияОткликов(Сайт, Пользователь);
		Возврат Результат;
	КонецЕсли;

	Если Не УстановитьСоединение() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = НовыйHTTPЗапрос("v5/me/company/responses.json");
	Отбор = Новый Структура();
	Отбор.Вставить("vacancy_ids", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторВакансии));
	
	Попытка
		Результат = ВсеРезультатыЗапроса(Запрос, ТелоЗапросаОбъект(Отбор), "responses");
	Исключение
		Сообщение = НСтр("ru = 'Ошибка получения откликов.'") + Символы.ПС + ОписаниеОшибки();
		РекрутинговыеСайтыСлужебный.СообщитьОбОшибке(Сообщение, Сайт, ЭтотОбъект);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьКонтактнуюИнформацию(СтруктураРезюме, Результат)

	АдресПочты = ЗначениеСвойстваУзла(СтруктураРезюме, "email");
	Если ЗначениеЗаполнено(АдресПочты) Тогда
		СтруктураКИ = РекрутинговыеСайтыСлужебный.СтруктураКонтактнойИнформации();
		СтруктураКИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		СтруктураКИ.Вид = ОбщегоНазначения.ПредопределенныйЭлемент(
			"Справочник.ВидыКонтактнойИнформации.EMailЛичныеДанныеКандидатов");
		СтруктураКИ.Представление = АдресПочты;
		Результат.Добавить(СтруктураКИ);
	КонецЕсли;

	Телефон = ЗначениеСвойстваУзла(СтруктураРезюме, "phone");
	Если ЗначениеЗаполнено(Телефон) Тогда
		СтруктураКИ = РекрутинговыеСайтыСлужебный.СтруктураКонтактнойИнформации();
		СтруктураКИ.Вид = ОбщегоНазначения.ПредопределенныйЭлемент(
			"Справочник.ВидыКонтактнойИнформации.ТелефонЛичныеДанныеКандидатов");
		СтруктураКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		СтруктураКИ.Представление = Телефон;
		Результат.Добавить(СтруктураКИ);
	КонецЕсли;

	Регион = ЗначениеСвойстваУзла(СтруктураРезюме, "region", "name");
	Если ЗначениеЗаполнено(Регион) Тогда
		СтруктураКИ = РекрутинговыеСайтыСлужебный.СтруктураКонтактнойИнформации();
		СтруктураКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		СтруктураКИ.Вид = ОбщегоНазначения.ПредопределенныйЭлемент(
			"Справочник.ВидыКонтактнойИнформации.АдресЛичныеДанныеКандидатов");
		СтруктураКИ.Представление = Регион;
		Результат.Добавить(СтруктураКИ);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьОбразование(СтруктураРезюме, Результат)

	Для Каждого Образование Из ЗначениеСвойстваУзла(СтруктураРезюме, "educations") Цикл
		ДанныеУровняОбразования = ВидОбразованияПоИдентификатору(ЗначениеСвойстваУзла(Образование, "level", "id"));

		СтруктураОбразование = Справочники.ЛичныеДанныеКандидатов.НовоеОбразованиеДляФизическогоЛица();
		СтруктураОбразование.УчебноеЗаведение = ЗначениеСвойстваУзла(Образование, "name");
		СтруктураОбразование.Специальность = ЗначениеСвойстваУзла(Образование, "speciality");
		СтруктураОбразование.Окончание = ЗначениеСвойстваУзла(Образование, "finished_at");

		ЗаполнитьЗначенияСвойств(СтруктураОбразование, ДанныеУровняОбразования);

		Результат.Добавить(СтруктураОбразование);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТрудовуюДеятельность(СтруктураРезюме, Результат)

	Для Каждого ТрудоваяДеятельность Из ЗначениеСвойстваУзла(СтруктураРезюме, "experiences") Цикл
		ДатаНачала = ЗначениеСвойстваУзла(ТрудоваяДеятельность, "started_at");
		ДатаНачала = ?(ЗначениеЗаполнено(ДатаНачала), ПрочитатьДатуJSON(ДатаНачала, ФорматДатыJSON.ISO), Дата(1, 1, 1));
		ДатаОкончания = ЗначениеСвойстваУзла(ТрудоваяДеятельность, "finished_at");
		ДатаОкончания = ?(ЗначениеЗаполнено(ДатаОкончания), ПрочитатьДатуJSON(ДатаОкончания, ФорматДатыJSON.ISO), Дата(
			1, 1, 1));

		СтруктураТрудоваяДеятельность = РекрутинговыеСайтыСлужебный.НовыйОпытРаботы();
		СтруктураТрудоваяДеятельность.Компания = ЗначениеСвойстваУзла(ТрудоваяДеятельность, "company_name");
		СтруктураТрудоваяДеятельность.ДатаНачала = ДатаНачала;
		СтруктураТрудоваяДеятельность.ДатаОкончания = ДатаОкончания;
		СтруктураТрудоваяДеятельность.Должность = ЗначениеСвойстваУзла(ТрудоваяДеятельность, "position");
		СтруктураТрудоваяДеятельность.Обязанности = ЗначениеСвойстваУзла(ТрудоваяДеятельность, "comment");
		Результат.Добавить(СтруктураТрудоваяДеятельность);
	КонецЦикла;

КонецПроцедуры

Функция СтепеньЗнанияЯзыкаПоИдентификатору(Идентификатор)

	Если Идентификатор = 1 Тогда // начальный
		УровеньВладенияЯзыком = Перечисления.УровниВладенияЯзыком.A1;
	ИначеЕсли Идентификатор = 2 Тогда // средний
		УровеньВладенияЯзыком = Перечисления.УровниВладенияЯзыком.B1;
	ИначеЕсли Идентификатор = 3 Тогда // продвинутый
		УровеньВладенияЯзыком = Перечисления.УровниВладенияЯзыком.B2;
	Иначе // свободное владение
		УровеньВладенияЯзыком = Перечисления.УровниВладенияЯзыком.C2;
	КонецЕсли;

	Возврат Справочники.СтепениЗнанияЯзыкаКандидата.СтепеньЗнанияЯзыкаПоУровнюВладения(УровеньВладенияЯзыком);

КонецФункции

Функция МассивКомментариевКандидата(ИдентификаторРезюме, Кандидат = Неопределено)

	КомментарииТаблица = КомментарииКандидата(ИдентификаторРезюме, Кандидат);
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(КомментарииТаблица);

КонецФункции

Функция КомментарииКандидата(ИдентификаторРезюме, Кандидат = Неопределено)

	Комментарии = РекрутинговыеСайтыСлужебный.ТаблицаКомментарииКандидатов();

	Если Не УстановитьСоединение() Тогда
		Возврат Комментарии;
	КонецЕсли;

	Запрос = НовыйHTTPЗапрос("v5/me/resume/comments.json");
	Тело = ТелоЗапросаОбъект();
	Тело.Вставить("resume_id", ИдентификаторРезюме);

	Попытка
		КоллекцияКомментариев = ВсеРезультатыЗапроса(Запрос, Тело, "resumecomments");
	Исключение
		РекрутинговыеСайтыСлужебный.СообщитьОбОшибке(ОписаниеОшибки(), Сайт, ЭтотОбъект);
		Возврат Комментарии;
	КонецПопытки;

	Для Каждого ОписаниеКомментария Из КоллекцияКомментариев Цикл
		НоваяСтрока = Комментарии.Добавить();
		НоваяСтрока.Период = РекрутинговыеСайтыСлужебный.СекундыВДату(ЗначениеСвойстваУзла(ОписаниеКомментария, "created_at"));
		НоваяСтрока.Идентификатор = Формат(ЗначениеСвойстваУзла(ОписаниеКомментария, "id"), "ЧГ=");

		НоваяСтрока.Комментарий = ЗначениеСвойстваУзла(ОписаниеКомментария, "text");
		НоваяСтрока.Автор = СокрП(СтрШаблон("%1 %2",
			ЗначениеСвойстваУзла(ОписаниеКомментария, "author_surname"),
			ЗначениеСвойстваУзла(ОписаниеКомментария, "author_name")));
		НоваяСтрока.ТолькоДляАвтора = Не ЗначениеСвойстваУзла(ОписаниеКомментария, "is_show_other");
		НоваяСтрока.МестоПубликации = Сайт;
	КонецЦикла;

	ПочтаАвторов = Новый Соответствие;
	ПодобратьПользователейПоАвторамКомментариев(Комментарии, ПочтаАвторов);
	
	Возврат Комментарии;

КонецФункции

Процедура ПодобратьПользователейПоАвторамКомментариев(Комментарии, ПочтаАвторов)

	Пользователь = Пользователи.АвторизованныйПользователь();

	НайденныеСтроки = Комментарии.НайтиСтроки(Новый Структура("ПринадлежитАвторизованномуПользователю", Ложь));
	Если НайденныеСтроки.Количество() = 0 Тогда
		// Все комментарии принадлежат текущему пользователю.
		Комментарии.ЗаполнитьЗначения(Пользователь, "Пользователь");
		Возврат;
	КонецЕсли;

	АдресаАвторов = РекрутинговыеСайтыСлужебный.НоваяТаблицаАдресаАвторов();
	Для Каждого АвторИПочта Из ПочтаАвторов Цикл
		НоваяСтрока = АдресаАвторов.Добавить();
		НоваяСтрока.ИмяАвтора = АвторИПочта.Ключ;
		НоваяСтрока.АдресПочты = АвторИПочта.Значение;
	КонецЦикла;

	ПользователиПоАвторам = РекрутинговыеСайтыСлужебный.ПользователиПоАвторам(АдресаАвторов);

	Для Каждого Строка Из Комментарии Цикл
		Если Строка.ПринадлежитАвторизованномуПользователю Тогда
			Строка.Пользователь = Пользователь;
		ИначеЕсли ПользователиПоАвторам[Строка.Автор] = Неопределено Тогда
			Строка.Комментарий = СтрШаблон("%1:", Строка.Автор) + Символы.ПС + Символы.ПС + Строка.Комментарий;
			Строка.Пользователь = Пользователь;
			Строка.ТолькоДляАвтора = Ложь;
		Иначе
			Строка.Пользователь = ПользователиПоАвторам[Строка.Автор];
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТарифы(Результат)
	
	Запрос = НовыйHTTPЗапрос("v5/me/company/tariffs.json");
	РезультатЗапроса = ОтправитьЗапросСТелом(Запрос, ТелоЗапросаОбъект());

	Если РезультатЗапроса.КодСостояния = 200 Тогда
		Тарифы = ПрочитатьОтветТарифы(РезультатЗапроса);

		Для Каждого Тариф Из Тарифы Цикл
			ДатаОкончания = ЗначениеСвойстваУзла(Тариф, "expire_at");
			
			ОписаниеТарифа = СтрШаблон(НСтр("ru = '%1, (%2) размещений до %3'"),
				ЗначениеСвойстваУзла(Тариф, "name"),
				ЗначениеСвойстваУзла(Тариф, "vacancies_limit"),
				?(ЗначениеЗаполнено(ДатаОкончания),
					Формат(РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ДатаОкончания, Ложь), "ДФ=dd.MM.yyyy;"),
					НСтр("ru = '(бессрочно)'")));
				
			Результат.Тарифы.Вставить(ОписаниеТарифа, ЗначениеСвойстваУзла(Тариф, "order_item_id"));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

