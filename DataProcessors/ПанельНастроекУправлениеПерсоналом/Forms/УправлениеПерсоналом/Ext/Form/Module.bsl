
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДобавитьРеквизиты();
	ДополнитьФорму();
	
	ПрочитатьНастройки();
	ОбновитьФормуПоНастройкам();
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОбщаяКомандаНастройкиЭлектронногоОбучения", "Видимость", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьПредупреждения(НастройкиПодбораПерсонала.ПутьККаталогуMuPDF);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененыНастройкиУчетныхЗаписейВидеоконференций" Тогда
		ИспользоватьВидеоконференцииПриИзмененииНаСервере(Параметр);
		ОбновитьФормуПоНастройкеИспользоватьВидеоконференции(ЭтотОбъект);
	ИначеЕсли ИмяСобытия = "ОбсужденияПодключены" Или ИмяСобытия = "ИзмененыНастройкиУведомлений" Тогда
		ОтправительДоИзменения = КонстантыНабор.ПользовательДляУведомлений;
		ПрочитатьНастройки();
		ОбновитьФормуПоНастройкеИспользоватьУведомленияВОбсуждениях(ЭтотОбъект, ОбсужденияКлиент.ОбсужденияДоступны());
		Если ОтправительДоИзменения <> КонстантыНабор.ПользовательДляУведомлений Тогда
			РассылкиПоОтправителю = РассылкиПоОтправителю(ОтправительДоИзменения);
			Если РассылкиПоОтправителю.Количество() > 0 Тогда
				ТекстВопроса = НСтр(
					"ru = 'Изменился пользователь для отправки уведомлений.
					|Обновить отправителя в подготовленных рассылках с видом транспорта ""Обсуждения""?'");
				Оповещение = Новый ОписаниеОповещения("ИзменениеОтправителяЗавершение", ЭтотОбъект, РассылкиПоОтправителю);
				ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Оповестить("ЗавершитьНастройкуПользователя");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтруктураПредприятияСоответствуетСтруктуреЮридическихЛицЧислоПриИзменении(Элемент)
	НачатьИзменениеИспользованияСтруктурыПредприятия();
КонецПроцедуры

