&НаСервереБезКонтекста
Функция ПользовательДляУведомлений()

	ПользовательДляУведомлений = ОбсужденияБЗК.Ассистент(
		НСтр("ru = 'Уведомления'"),
		БиблиотекаКартинок.ЧатБотУведомленияОбсуждения,
		Ложь);
	
	Если ПользовательДляУведомлений <> Неопределено Тогда
		Константы.ПользовательДляУведомлений.Установить(ПользовательДляУведомлений.Ссылка);
		Возврат ПользовательДляУведомлений.Ссылка;
	Иначе
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

&НаКлиенте 
Процедура ИзменениеОтправителяЗавершение(Результат, Рассылки) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ДлительнаяОперация = ОбновитьОтправителяНаСервере(Рассылки);
		ОжидатьЗавершениеДлительнойОперации(ДлительнаяОперация, "Рассылки уведомлений", "Отправитель обновлен");
	КонецЕсли;
	
	Оповестить("ЗавершитьНастройкуПользователя");
	
КонецПроцедуры

