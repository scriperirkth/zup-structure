	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборКаталога", ЭтотОбъект);
	ФайловаяСистемаКлиент.ВыбратьКаталог(Оповещение, НСтр("ru = 'Выберите каталог MuPDF'"));
	
