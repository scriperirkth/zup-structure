КонецПроцедуры

&НаСервере
Процедура ИспользоватьВидеоконференцииПриИзмененииНаСервере(Использование)
	
	КонстантыНабор.ИспользоватьВидеоконференции = Использование;
	Константы.ИспользоватьВидеоконференции.Установить(Использование);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала.Видеособеседования") Тогда 
		МодульВидеособеседования = ОбщегоНазначения.ОбщийМодуль("Видеособеседования");
		МодульВидеособеседования.ПриИзмененииИспользованияПодсистемы(Использование);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИспользоватьБронированиеКомандировокПриИзмененииНаСервере(Использование)
	
	Константы.ИспользоватьБронированиеКомандировок.Установить(Использование);
	Если Не Константы.ИспользоватьБронированиеКомандировок.Получить() Тогда
		Константы.ИспользоватьАвтоматическуюОтправкуСотрудниковБронированияКомандировок.Установить(Использование);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИспользоватьОбучениеРазвитиеСотрудниковПриИзмененииНаСервере(Использование)
	
	Если Не Использование И Константы.ИспользоватьЭлектронноеОбучение.Получить() Тогда
		Константы.ИспользоватьЭлектронноеОбучение.Установить(Использование);
		КонстантыНабор.ИспользоватьЭлектронноеОбучение = Использование;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьИзменениеИспользованияУведомленийВОбсуждениях()
	
	Если КонстантыНабор.ИспользоватьУведомленияВОбсуждениях Тогда
		Если Не ЗначениеЗаполнено(КонстантыНабор.ПользовательДляУведомлений) Тогда
			КонстантыНабор.ПользовательДляУведомлений = ПользовательДляУведомлений();
		КонецЕсли;
		ВыполнитьИзменениеИспользованияУведомленийВОбсуждениях();
		Возврат;
	Иначе
		Рассылки = ПолучитьРассылкиДляОбсуждений();
		Если Рассылки.Количество() > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ЗавершитьИзменениеИспользованияУведомленийВОбсуждениях", ЭтотОбъект, Рассылки);
			ТекстВопроса = НСтр(
				"ru = 'Отключение уведомлений пользователей в обсуждениях приведет к деактивации рассылок
				|и замене вида транспорта ""Обсуждения"" на ""Email"". Продолжить?'");
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			ВыполнитьИзменениеИспользованияУведомленийВОбсуждениях();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьИзменениеИспользованияУведомленийВОбсуждениях(Результат, Рассылки) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ДлительнаяОперация = ОтменитьРассылкиНаСервере(Рассылки);
		ОжидатьЗавершениеДлительнойОперации(ДлительнаяОперация, "Рассылки уведомлений в ""Обсуждения""", "Отключены");
		ВыполнитьИзменениеИспользованияУведомленийВОбсуждениях();
	Иначе
		КонстантыНабор.ИспользоватьУведомленияВОбсуждениях = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОжидатьЗавершениеДлительнойОперации(ДлительнаяОперация, ТекстОповещения, ПояснениеОповещения)
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ОповещениеПользователя.Текст = НСтр("ru = '" + ТекстОповещения + "'");
	ПараметрыОжидания.ОповещениеПользователя.Пояснение = НСтр("ru = '" + ПояснениеОповещения + "'");
	ПараметрыОжидания.ОповещениеПользователя.Показать = Истина;
	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиРассылок", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИзменениеИспользованияУведомленийВОбсуждениях()
	
	ИспользоватьУведомленияВОбсужденияхПриИзмененииНаСервере(КонстантыНабор.ИспользоватьУведомленияВОбсуждениях);
	ОбновитьФормуПоНастройкеИспользоватьУведомленияВОбсуждениях(ЭтотОбъект, ОбсужденияКлиент.ОбсужденияДоступны());
	ПодключитьОбработчикОжиданияОбновленияИнтерфейса();
	
	Оповестить("ИспользоватьУведомленияВОбсуждениях");
	
КонецПроцедуры

