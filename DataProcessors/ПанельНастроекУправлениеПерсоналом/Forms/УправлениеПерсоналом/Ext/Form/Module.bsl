Процедура ИспользоватьСозданиеПользователейРегламентнымЗаданиемПриИзменении(Элемент)
	
	Если КонстантыНабор.СоздаватьПользователейДляПринятыхНаРаботуСотрудниковАвтоматически = Истина Тогда
		ТекстВопроса = 
			НСтр("ru = 'Вы включаете настройку, которая будет создавать пользователей для сотрудников регламентным заданием. 
				 |Убедитесь, что вы настроили группы доступа для новых пользователей, которые создадутся автоматически.
				 |См. ниже - Настройки учетных записей сотрудников.
				 |Иначе пользователи начнут создаваться без групп доступа.'");

		ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
		ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
		ПараметрыВопроса.Заголовок = НСтр("ru = 'Убедитесь в том, что вы настроили группы доступа для новых пользователей'");
		ПараметрыВопроса.Картинка = БиблиотекаКартинок.Предупреждение32;
		
		КнопкиОтвета = Новый СписокЗначений;
		КнопкиОтвета.Добавить(Истина, НСтр("ru = 'Понятно'"));
		
		ОбработчикОтвета = Новый ОписаниеОповещения("ЗавершитьИспользоватьСозданиеПользователейРегламентнымЗаданиемПриИзменении", ЭтотОбъект);
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
			ОбработчикОтвета, ТекстВопроса, КнопкиОтвета, ПараметрыВопроса);
	Иначе
		СоздаватьПользователейДляПринятыхНаРаботуСотрудниковАвтоматическиПриИзмененииНаСервере(КонстантыНабор.СоздаватьПользователейДляПринятыхНаРаботуСотрудниковАвтоматически);
		ПодключитьОбработчикОжиданияОбновленияИнтерфейса();		
	КонецЕсли;	
	
