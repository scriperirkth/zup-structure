#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Назад(Команда)
	
	ОтобразитьОсновнуюСтраницу();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПанельПомощьВыполнитьКоманду(Команда)
	
	Если КешФормы.КомандыКарточки.Найти(Команда.Имя) = Неопределено Тогда
		ПанельПомощьКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда);
	Иначе
		Подключаемый_НажатиеЭлементаОбщий(Команда);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Общие

&НаКлиенте
Процедура ВыполнитьПереходНаИТС(СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаПерехода = ПанельПомощьКлиент.ПолучитьСтрокуПоискаНаИТС(ЭтотОбъект);
	ИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуИнтегрированногоСайта(СтрокаПерехода);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьОсновнуюСтраницу()
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновная;
	Элементы.СтраницаРезультатПоиска.Видимость = Ложь;
	Элементы.ДекорацияОтступПодвалЛевоЛоготип.Видимость = Истина;
	Элементы.ГруппаПодвал.Видимость = ВидимостьПодвал;
	Элементы.ГруппаСтраницыРезультатаПоиска.Видимость = Ложь;
	
	ВключитьВыключитьАвтолистаниеКарусели();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КопироватьТекстВБуфер(Текст, СообщениеУспех)
	
	УдалосьПоместить = Ждать ИнтернетПоддержкаПользователейКлиент.ПоместитьСтрокуВБуферОбмена(
		Строка(Текст));
	
	Если УдалосьПоместить Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Успешно'"),
			,
			СообщениеУспех);
	Иначе
		ПоказатьПредупреждение(
			Неопределено,
			НСтр("ru = 'Не удалось скопировать информацию.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНавигационныхСсылок(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "НеНайденоПереходНаИТС" Тогда
		ВыполнитьПереходНаИТС(СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыЭлементов()

	КоличествоКолонок = ПанельПомощьСлужебный.КоличествоКолонокПоРазрешению();
	КешФормы.ПараметрыЭлементов.Вставить("КоличествоКолонок", КоличествоКолонок);
	
	РазмерыЭлементов = ПанельПомощьСлужебный.РазмерыЭлементов(КоличествоКолонок);
	
	Если ЭтоИнтерфейс85 Тогда
		ОбщаяШирина = РазмерыЭлементов.ОбщаяШирина;
		КешФормы.ПараметрыЭлементов.Вставить("ШиринаКартинкаКарусель", ОбщаяШирина - 7);
	Иначе
		ОбщаяШирина = РазмерыЭлементов.ОбщаяШиринаТакси;
		Элементы.АдресЛоготип.Высота = 3;
		Элементы.ДекорацияЛоготип.Высота = 3;
		КешФормы.ПараметрыЭлементов.Вставить("ШиринаКартинкаКарусель", ОбщаяШирина - 5);
	КонецЕсли;
	
	Элементы.ГруппаКарусель.Ширина = ОбщаяШирина;
	
	КешФормы.ПараметрыЭлементов.Вставить("ШиринаТекстКарусель", ОбщаяШирина - 9);
	КешФормы.ПараметрыЭлементов.Вставить("ШиринаРезультатПоиска", ОбщаяШирина + 15);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеЭлементаОбщий(Элемент, СтандартнаяОбработка = Ложь)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеЭлемента = КешФормы.ПрикладныеОбъекты.Получить(Элемент.Имя);
	Если ОписаниеЭлемента = Неопределено Тогда
		ПанельПомощьКлиент.КарточкаНажатие(ЭтотОбъект, Элемент);
		Возврат;
	КонецЕсли;
	
	Если ОписаниеЭлемента.Тип = ТипСоцСети() Тогда
		
		ПанельПомощьКлиент.ОткрытьНавигационнуюСсылкуСПереопределением(
			ОписаниеЭлемента.Параметры,
			"СоцСети");
	
	ИначеЕсли ОписаниеЭлемента.Тип = ТипКарточка() Тогда
		
		Обработано = Ложь;
		ПанельПомощьКлиент.КарточкаНажатие(
			ЭтотОбъект,
			Элемент,
			Обработано);
		
		Если Обработано Тогда
			Возврат;
		КонецЕсли;
		
		ПанельПомощьКлиент.ОткрытьНавигационнуюСсылкуСПереопределением(
			ОписаниеЭлемента.Параметры,
			"Карточка");
	
	КонецЕсли;
	
КонецПроцедуры

// Подготавливает данные картинки для вывода на форму.
//
// Параметры:
//  Значение - Произвольный - значение, которое необходимо обработать.
//
// Возвращаемое значение:
//  Структура - результат обработки значения:
//   * Значение - Неопределено - если передано недопустимое значение.
//              - Картинка, Строка - картинка для вывода, либо адрес картинки во временном хранилище.
//   * Тип - Строка - тип значения. Доступные значения определяются методами ТипКартинкиКартинка
//         и ТипКартинкиАдресВХранилище.
//   * Пустая - Булево - Истина, если в значении содержится пустая картинка
// 
&НаСервере
Функция ДанныеКартинкиДляВывода(Значение)
	
	Результат = Новый Структура(
		"Значение, Тип, Пустая",
		Неопределено,
		"",
		Ложь);
	
	Если ТипЗнч(Значение) = Тип("Картинка") Тогда
		Результат.Значение = Значение;
		Результат.Тип = ТипКартинкиКартинка();
		Результат.Пустая = Значение.Вид = ВидКартинки.Пустая;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		// Имена картинок из библиотеки преобразовываются в тип Картинка в ПанельПомощьСлужебный.ПараметрыРаздела,
		// поэтому сюда должны дойти только адреса во временном хранилище.
		// Остальные варианты - ошибка, не обрабатываем.
		Если ЭтоАдресВременногоХранилища(Значение) Тогда
			Результат.Значение = Значение;
			Результат.Тип = ТипКартинкиАдресВХранилище();
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Результат.Значение = ПоместитьВоВременноеХранилище(Значение, УникальныйИдентификатор);
		Результат.Тип = ТипКартинкиАдресВХранилище();
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТипКартинкиКартинка()
	
	Возврат "Картинка";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТипКартинкиАдресВХранилище()
	
	Возврат "АдресВХранилище";
	
КонецФункции

&НаСервере
Процедура УстановитьНастройкиФормы()
	
	Если ЕстьЭлементыНаОсновной Тогда
		Элементы.ДекорацияЗаглушкаПустаяСтраница.Видимость = Ложь;
	КонецЕсли;
	
	ВидимостьПодвал = ВидимостьПодвал И (Не ЭтоМобильныйКлиент);
	Элементы.ГруппаПодвал.Видимость = ВидимостьПодвал;
	
	Если ЭтоМобильныйКлиент Тогда
		
		Элементы.КнопкиПерехода.РастягиватьПоГоризонтали = Истина;
		Элементы.КнопкиПерехода.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
		Элементы.КнопкиПерехода.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
		Элементы.КнопкиПерехода.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Авто;
		Элементы.ГруппаСтраницыРезультатаПоиска.РастягиватьПоГоризонтали = Истина;
		
		Элементы.ДекорацияОтступПодвалЛевоЛоготип.Видимость = Ложь;
		Элементы.ДекорацияОтступПодвалЛево.Видимость = Ложь;
		Элементы.ГруппаСоцСети.Видимость = Ложь;
		Элементы.ДекорацияОтступПодвалаПраво.Видимость = Ложь;
		Элементы.АдресЛоготип.Видимость = Ложь;
		Элементы.ДекорацияЛоготип.Видимость = Ложь;
		
		Элементы.ГруппаКарусель.ЦветФона = Новый Цвет();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

