#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КешФормы = Новый Структура;
	КешФормы.Вставить("РезультатПоискаСсылки", Новый Соответствие);
	КешФормы.Вставить("РезультатПоискаНомераСтраницПерехода", ОбнулитьНомераПерехода());
	КешФормы.Вставить("РезультатПоискаВсегоСтраниц", 0);
	КешФормы.Вставить("РезультатПоискаТекущаяСтраница", 0);
	КешФормы.Вставить("ПрикладныеОбъекты", Новый Соответствие);
	КешФормы.Вставить("ИдентификаторыКарусели", Новый Соответствие);
	КешФормы.Вставить("ПараметрыЭлементов", Новый Соответствие);
	КешФормы.Вставить("КомандыКарточки", Новый Массив);
	// для корректной передачи между клиентом и сервером при изменении:
	КешФормы.Вставить("ВремяОбновления", ТекущаяУниверсальнаяДатаВМиллисекундах());
	
	ЭтоИнтерфейс85 = ИнтернетПоддержкаПользователейКлиентСервер.ЭтоИнтерфейс85();
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();
	
	Если ЭтоИнтерфейс85 Тогда
		ПанельПомощьСлужебный.ПриСозданииНаСервереСлужебный(
			ЭтотОбъект,
			,
			,
			Истина);
	Иначе
		ПанельПомощьСлужебный.ПриСозданииНаСервереСлужебный(
			ЭтотОбъект,
			Элементы.КоманднаяПанельТехПоддержкаТакси,
			Элементы.ГруппаПоискТакси,
			Истина);
	КонецЕсли;
	
	ИнтернетПоддержкаПользователей.НастроитьКоманднуюПанельМастера(
		Неопределено,
		Элементы.Назад);
	
	УстановитьПараметрыЭлементов();
	
	Эталон = Новый Структура("БИП_ПанельПомощьПараметры", Неопределено);
	ЗаполнитьЗначенияСвойств(Эталон, ЭтотОбъект);
	Если Эталон.БИП_ПанельПомощьПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВывестиЛоготип(Эталон.БИП_ПанельПомощьПараметры.ПараметрыРаздела.Логотип);
	ВывестиСоцСети(Эталон.БИП_ПанельПомощьПараметры.ПараметрыРаздела.ПрикладныеПараметры.ДанныеСоцСети);
	ВывестиКарусель(Эталон.БИП_ПанельПомощьПараметры.ПараметрыРаздела.ПрикладныеПараметры.Карусель);
	ВывестиКарточки(
		Эталон.БИП_ПанельПомощьПараметры.ПараметрыРаздела.ПрикладныеПараметры.ДанныеКарточек,
		Эталон.БИП_ПанельПомощьПараметры.ПараметрыРаздела.Документация,
		Эталон.БИП_ПанельПомощьПараметры.ПараметрыРаздела.ОтветыНаВопросы);
	
	УстановитьНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если СредстваБуфераОбмена.ИспользованиеДоступно()
		И СредстваБуфераОбмена.ПоддерживаетсяФорматДанных(СтандартныйФорматДанныхБуфераОбмена.Текст) Тогда
		БуферОбменаДоступен = Истина;
	Иначе
		БуферОбменаДоступен = Ложь;
	КонецЕсли;
	
	ВключитьВыключитьАвтолистаниеКарусели();
	
КонецПроцедуры

#КонецОбласти

