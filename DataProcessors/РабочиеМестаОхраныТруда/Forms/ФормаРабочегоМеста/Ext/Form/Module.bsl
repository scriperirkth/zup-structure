&НаКлиенте
Процедура СкопироватьВредныеФакторыВидыРаботМедицинские(Команда)
	
	ПараметрыФормы = Новый Структура("ИсключаяРабочееМесто, ВидОсмотра, ОтображатьВредныеФакторы");
	ПараметрыФормы.ИсключаяРабочееМесто = Параметры.Ключ;
	ПараметрыФормы.ВидОсмотра = ВидМедицинскийОсмотр;
	ПараметрыФормы.ОтображатьВредныеФакторы = Истина;
	
	ПараметрыОповещения = Новый Структура("ВидОсмотра, КопироватьВредныеФакторы");
