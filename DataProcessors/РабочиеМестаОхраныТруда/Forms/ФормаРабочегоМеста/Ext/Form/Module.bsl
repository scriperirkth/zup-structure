КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтображениеНомера(Форма)
	
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Номер",
		"ТолькоПросмотр",
		Не Объект.НомерВручную);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Номер",
		"АвтоОтметкаНезаполненного",
		Объект.НомерВручную);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Номер",
		"ОтметкаНезаполненного",
		Объект.НомерВручную И ЗначениеЗаполнено(Объект.Номер));
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьЗаполнениеПоДаннымУсловийТруда()
	
	ЗаголовокВопроса = НСтр("ru = 'Заполнение по данным условий труда'");
	
	ТекстВопроса = НСтр("ru = 'Данные о досрочной пенсии, надбавке за вредность и страховых взносах - можно заменить аналогичными сведениями из условий труда.
						|Заменить?'");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьЗаполнениеПоДаннымУсловийТруда", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаполнениеПоДаннымУсловийТруда()
	
	ЗаголовокВопроса = НСтр("ru = 'Заполнение по данным условий труда'");
	
	ТекстВопроса = НСтр("ru = 'Данные о досрочной пенсии, надбавке за вредность и страховых взносах - будут заменены аналогичными сведениями из условий труда.
						|Продолжить?'");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьЗаполнениеПоДаннымУсловийТруда", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗаполнениеПоДаннымУсловийТруда(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Нет Тогда
		// Пользователь отказался от замены реквизитов из условий труда.
		СоответствуетУсловиямТруда = 0;
		УстановитьДоступностьРеквизитовУсловийТруда(ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРеквизитыУсловийТруда();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьТумблераСоответствия(Форма)
	
	ТумблерДоступен = Форма.РабочееМестоДоступноДляРедактирования И ЗначениеЗаполнено(Форма.Объект.УсловияТруда);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"СоответствуетУсловиямТруда",
		"Доступность",
		ТумблерДоступен);
	
	Если Не ТумблерДоступен Тогда 
		Форма.СоответствуетУсловиямТруда = 0;
		УстановитьДоступностьРеквизитовУсловийТруда(Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРеквизитовУсловийТруда(Форма)
	
	ДоступностьСведений = Форма.СоответствуетУсловиямТруда = 0;
	
	Форма.Элементы.ВредностьГруппа.ТолькоПросмотр = Не ДоступностьСведений;
	Форма.Элементы.ДосрочнаяПенсияГруппа.ТолькоПросмотр = Не ДоступностьСведений;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокСвернутогоОтображенияСтраховыхВзносов(Форма)
	
	ЗаголовокСвернутогоОтображения = "";
	
	КлассУсловийТруда = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(
		Форма, "КлассыУсловийТрудаПоДолжностям.КлассУсловийТруда");
	Период = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(
		Форма, "КлассыУсловийТрудаПоДолжностям.Период");
		
	Если ЗначениеЗаполнено(КлассУсловийТруда) Тогда
		ЗаголовокСвернутогоОтображения = СтрШаблон(НСтр("ru = '%1 установлен с %2'"),
			Строка(КлассУсловийТруда), Формат(Период, "ДЛФ=DD"));
	КонецЕсли; 

	Форма.Элементы.ГруппаОсобенностиИсчисленияСтраховыхВзносов.ЗаголовокСвернутогоОтображения =
		?(ПустаяСтрока(ЗаголовокСвернутогоОтображения),
		  Форма.Элементы.ГруппаОсобенностиИсчисленияСтраховыхВзносов.Заголовок,
		  ЗаголовокСвернутогоОтображения);

КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокСвернутогоОтображенияДосрочнойПенсииВредности()
	
	ЗаголовокСвернутогоОтображения = РабочиеМестаОхраныТруда.ЗаголовокНаОснованииНабораДанных(
		РабочиеМестаОхраныТруда.ЗначенияВзносовВредностиПФР(Объект));
	
	Элементы.ДосрочнаяПенсияВредностьВзносы.ЗаголовокСвернутогоОтображения =
		?(ПустаяСтрока(ЗаголовокСвернутогоОтображения),
		  Элементы.ДосрочнаяПенсияВредностьВзносы.Заголовок,
		  ЗаголовокСвернутогоОтображения);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьЗаголовокСвернутогоОтображенияМедосмотров(Форма)
	
	ЗаголовокСвернутогоОтображения = СтрШаблон(НСтр("ru = 'Осмотры по приказу № 29н: %1'"), Форма.ПериодичностьМедицинскихОсмотров);
	
	Если Форма.ИспользоватьПсихиатрическиеОсвидетельствования Тогда
		ЗаголовокСвернутогоОтображения = СтрШаблон(НСтр("ru = '%1
														|Психиатрические осмотры: %2'"),
		ЗаголовокСвернутогоОтображения, Форма.ПериодичностьПсихиатрическихОсвидетельствований);
	КонецЕсли;

	Форма.Элементы.ГруппаМедицинскиеОсмотры.ЗаголовокСвернутогоОтображения = ЗаголовокСвернутогоОтображения;

КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждениеОРазличияхСУсловиямиТруда()
	
	Элементы.РазличияСУсловиямиТрудаГруппа.Видимость = Ложь;
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьНадбавкуЗаВредность")
		И Не ПолучитьФункциональнуюОпцию("ИспользуютсяРаботыСДосрочнойПенсией") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.УсловияТруда) Тогда
		Возврат;
	КонецЕсли;
	
	УсловияТруда = РабочиеМестаОхраныТруда.ЗначенияВзносовВредностиПФР(Объект.УсловияТруда);
	
	Если Не Справочники.РабочиеМестаОхраныТруда.РеквизитыРабочегоМестаСоответствуютУсловиямТруда(Объект, УсловияТруда) Тогда
		Элементы.РазличияСУсловиямиТрудаГруппа.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыУсловийТруда()

	Если Не ЗначениеЗаполнено(Объект.УсловияТруда) Тогда
		Возврат;
	КонецЕсли;
	
	РабочееМестоОбъект = РеквизитФормыВЗначение("Объект");
	РабочееМестоОбъект.ЗаполнитьПоУсловиямТруда(Объект.УсловияТруда);
	ЗначениеВРеквизитФормы(РабочееМестоОбъект, "Объект");
	
	ВзимаютсяВзносыЗаЗанятыхНаРаботахСДосрочнойПенсией = ЗначениеЗаполнено(Объект.ВзимаютсяВзносыЗаЗанятыхНаРаботахСДосрочнойПенсией);
	СоответствуетУсловиямТруда = Объект.СоответствуетУсловиямТруда;
	
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	УстановитьПредупреждениеОРазличияхСУсловиямиТруда();
	УстановитьЗаголовокСвернутогоОтображенияДосрочнойПенсииВредности();
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьВредныеФакторыВидыРаботНаСервере(ДругоеРабочееМесто, ВидОсмотра)
	ПрочитатьВредныеФакторыВидыРабот(ДругоеРабочееМесто, ВидОсмотра, Истина);
	Модифицированность = Истина;
КонецПроцедуры

#Область СредстваИндивидуальнойЗащиты

&НаСервере
Процедура ИнициализироватьСредстваИндивидуальнойЗащиты(ТекущийОбъект)
	СредстваИндивидуальнойЗащитыФормы.ПрочитатьДополнительныеДанныеОбъекта(ЭтотОбъект, ТекущийОбъект.Ссылка, Истина);
КонецПроцедуры

&НаСервере
Процедура ОбновитьПериодичностьВыдачиСИЗРабочихМест()
	СредстваИндивидуальнойЗащитыФормы.ОбновитьПериодичностьВыдачиСИЗОбъекта(ЭтотОбъект, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УстановитьСИЗПослеЗакрытия(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатЗакрытия) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСИЗПослеЗакрытияНаСервере(РезультатЗакрытия, ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСИЗПослеЗакрытияНаСервере(РезультатЗакрытия, ДополнительныеПараметры)
	СредстваИндивидуальнойЗащитыФормы.УстановитьСИЗПослеЗакрытияНаСервере(ЭтотОбъект, РезультатЗакрытия, ДополнительныеПараметры, Истина);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьНормыВыдачиСИЗ(Форма, Отказ, ТекущийОбъект)
	СредстваИндивидуальнойЗащитыФормы.ЗаписатьДополнительныеДанныеОбъекта(Форма, ТекущийОбъект.Ссылка);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьУсловноеОформление(Форма)
	
	Элементы = Форма.Элементы;
	УсловноеОформление = Форма.УсловноеОформление;
	
	// СИЗ
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НормыВыдачиСИЗТипНоменклатуры.Имя);
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НормыВыдачиСИЗКомандаСИЗ.Имя);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементУсловногоОформления.Отбор, "НормыВыдачиСИЗ.Пометка", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НормыВыдачиСИЗКомандаСИЗ.Имя);
	ГруппаОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "НормыВыдачиСИЗ.Пометка", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "НормыВыдачиСИЗ.КомандаСИЗ", НСтр("ru = '< Не установлены >'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Инструктажи
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ИнструктажиПоРабочимМестамИспользуется");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементУсловногоОформления.Отбор, "ИнструктажиПоРабочимМестам.ИспользуетсяДляВсехРабочихМест", Истина);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Обучение
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ОбучениеПоРабочимМестамПояснение");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементУсловногоОформления.Отбор, "ОбучениеПоРабочимМестам.ИспользуетсяДляВсехРабочихМест", Истина);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра(
		"Текст", НСтр("ru = '< обязательна для всех рабочих мест >'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНормыСИЗДолжности()
	
	Если Не ПолучитьФункциональнуюОпциюФормы("ИспользоватьСредстваИндивидуальнойЗащиты") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не НормыСИЗДоступныДляЧтения Тогда
		Возврат;
	КонецЕсли;
	
	Если НормыСИЗСоответствуютДолжности = 1 Тогда
		ЗаполнитьНормыСИЗПоДолжности();
	Иначе
		ПредложитьЗаполнениеНормСИЗПоДаннымДолжности();
		УстановитьПредупреждениеОРазличияхНормВыдачиСИЗСДолжностью();
	КонецЕсли;
	
	УстановитьДоступностьТумблераСоответствияСИЗ(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНормыСИЗПоДолжности()

	Если Не ЗначениеЗаполнено(Объект.Должность) Тогда
		Возврат;
	КонецЕсли;
	
	СредстваИндивидуальнойЗащитыФормы.ПрочитатьДополнительныеДанныеОбъекта(ЭтотОбъект, Объект.Должность, Истина);
	
	НормыСИЗСоответствуютДолжности = Истина;
	
	УстановитьДоступностьЭлементовНормСИЗПоДолжности(ЭтотОбъект);
	УстановитьПредупреждениеОРазличияхНормВыдачиСИЗСДолжностью();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьЗаполнениеНормСИЗПоДаннымДолжности()
	
	ЗаголовокВопроса = НСтр("ru = 'Заполнение норм выдачи по данным должности'");
	
	ТекстВопроса = НСтр("ru = 'Нормы выдачи средств индивидуальной защиты можно заменить аналогичными сведениями из должности.
						|Заменить?'");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьЗаполнениеНормСИЗПоДаннымДолжности", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаполнениеНормСИЗПоДаннымДолжности()
	
	ЗаголовокВопроса = НСтр("ru = 'Заполнение норм выдачи по данным должности'");
	
	ТекстВопроса = НСтр("ru = 'Нормы выдачи средств индивидуальной защиты будут заменены аналогичными сведениями из должности.
						|Продолжить?'");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьЗаполнениеНормСИЗПоДаннымДолжности", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗаполнениеНормСИЗПоДаннымДолжности(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Нет Тогда
		// Пользователь отказался от замены реквизитов из должности.
		НормыСИЗСоответствуютДолжности = 0;
		УстановитьДоступностьЭлементовНормСИЗПоДолжности(ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНормыСИЗПоДолжности();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементовНормСИЗПоДолжности(Форма)
	
	ДоступностьСведений = Форма.НормыСИЗСоответствуютДолжности = 0 И Форма.РабочееМестоДоступноДляРедактирования;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "НормыВыдачиСИЗ", "ТолькоПросмотр", Не ДоступностьСведений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СкопироватьНормыВыдачи", "Доступность", ДоступностьСведений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "УстановитьФлажки", "Доступность", ДоступностьСведений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СнятьФлажки", "Доступность", ДоступностьСведений);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждениеОРазличияхНормВыдачиСИЗСДолжностью()
	
	Элементы.РазличияСДолжностьюГруппа.Видимость = Ложь;
	Если Не СредстваИндивидуальнойЗащиты.СредстваИндивидуальнойЗащитыИспользуются(Объект.Владелец) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не НормыСИЗДоступныДляЧтения Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Должность) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СредстваИндивидуальнойЗащиты.НормыВыдачиСИЗРабочегоМестаСоответствуютДолжности(
		НормыВыдачиСИЗНаборЗаписей.Выгрузить(), Объект.Должность) Тогда
		
		Элементы.РазличияСДолжностьюГруппа.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьТумблераСоответствияСИЗ(Форма)
	
	ТумблерДоступен = Форма.РабочееМестоДоступноДляРедактирования И ЗначениеЗаполнено(Форма.Объект.Должность);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"НормыСИЗСоответствуютДолжности",
		"Доступность",
		ТумблерДоступен);
	
	Если Не ТумблерДоступен Тогда 
		Форма.НормыСИЗСоответствуютДолжности = 0;
		УстановитьДоступностьЭлементовНормСИЗПоДолжности(Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьСИЗНаСервере(ДругоеРабочееМесто)
	
	СредстваИндивидуальнойЗащитыФормы.ПрочитатьСИЗ(ЭтотОбъект, ДругоеРабочееМесто);
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область Инструктажи

&НаСервере
Процедура ИнициализироватьИнструктажи(ТекущийОбъект)
	
	ОбучениеПоОхранеТрудаФормы.ПрочитатьИнструктажиРабочегоМестаОхраныТруда(ЭтотОбъект, ТекущийОбъект.Ссылка);
	УстановитьЗаголовокСвернутогоОтображенияИнструктажей(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокСвернутогоОтображенияИнструктажей(Форма)
	
	ИспользуемыеИнструктажи = Форма.ИнструктажиПоРабочимМестам.НайтиСтроки(Новый Структура("Используется", Истина));
	КоличествоИспользуемыхИнструктажей = ИспользуемыеИнструктажи.Количество();
	
	Если КоличествоИспользуемыхИнструктажей = 0 Тогда
		ТекстИнструктажей = НСтр("ru = '< Не проводятся >'");
	ИначеЕсли КоличествоИспользуемыхИнструктажей = 1 Тогда
		ТекстИнструктажей = СтрШаблон(НСтр("ru = '%1'"), НРег(ИспользуемыеИнструктажи[0].Инструктаж));
	ИначеЕсли КоличествоИспользуемыхИнструктажей = 2 Тогда
		ТекстИнструктажей = СтрШаблон(НСтр("ru = '%1 и %2'"),
			НРег(ИспользуемыеИнструктажи[0].Инструктаж), НРег(ИспользуемыеИнструктажи[1].Инструктаж));
	Иначе
		ТекстЕщеИнструктажей = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 инструктаж;;%1 инструктажа;%1 инструктажей;%1 инструктажа'"), КоличествоИспользуемыхИнструктажей - 2);
		ТекстИнструктажей = СтрШаблон(НСтр("ru = '%1, %2 и еще %3'"),
			НРег(ИспользуемыеИнструктажи[0].Инструктаж), НРег(ИспользуемыеИнструктажи[1].Инструктаж), ТекстЕщеИнструктажей);
	КонецЕсли;
	
	Форма.Элементы.ГруппаИнструктажиПоОхранеТруда.ЗаголовокСвернутогоОтображения =
		СтрШаблон(НСтр("ru = '%1: %2'"), Форма.Элементы.ГруппаИнструктажиПоОхранеТруда.Заголовок, ТекстИнструктажей);

КонецПроцедуры

#КонецОбласти

#Область ОбучениеПоОхранеТруда

&НаСервере
Процедура ИнициализироватьОбучениеПоОхранеТруда(ТекущийОбъект)
	
	ОбучениеПоОхранеТрудаФормы.ПрочитатьОбучениеРабочегоМестаОхраныТруда(ЭтотОбъект, ТекущийОбъект.Ссылка);
	УстановитьЗаголовокСвернутогоОтображенияОбученияПоОхранеТруда(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокСвернутогоОтображенияОбученияПоОхранеТруда(Форма)
	
	КоличествоИспользуемогоОбучения = Форма.ОбучениеПоРабочимМестам.Количество();
	
	Если КоличествоИспользуемогоОбучения = 0 Тогда
		ТекстОбучения = НСтр("ru = '< Не проводятся >'");
	Иначе
		ТекстОбучения = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 программа;;%1 программы;%1 программ;%1 программы'"),
			КоличествоИспользуемогоОбучения);
	КонецЕсли;
	
	Форма.Элементы.ГруппаОбучениеПоОхранеТруда.ЗаголовокСвернутогоОтображения =
		СтрШаблон(НСтр("ru = '%1: %2'"), Форма.Элементы.ГруппаОбучениеПоОхранеТруда.Заголовок, ТекстОбучения);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПрограммуОбучения(ТекущиеДанные, Поле)
	
	Если Поле <> Элементы.ОбучениеПоРабочимМестамОбучение Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ");
	ПараметрыФормы.Ключ = ТекущиеДанные.Обучение;
	
	Если Не ЗначениеЗаполнено(ПараметрыФормы.Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещенияПрограммыОбученияЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьОтображениеПрограммыОбучения(ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеПрограммыОбучения(ДополнительныеПараметры)
	
	ПрограммыОбучения = ОбучениеПоРабочимМестам.НайтиСтроки(Новый Структура("Обучение", ДополнительныеПараметры.ПрограммаОбучения));
	РабочееМестоЕстьВОбучении = ДополнительныеПараметры.РабочиеМеста.Найти(СсылкаНаОбъект) <> Неопределено;
	Если ПрограммыОбучения.Количество() = 0 Тогда
		Если РабочееМестоЕстьВОбучении Тогда
			СтрокаОбучения = ОбучениеПоРабочимМестам.Добавить();
			СтрокаОбучения.Обучение = ДополнительныеПараметры.ПрограммаОбучения;
			СтрокаОбучения.Период = ДополнительныеПараметры.ПредставлениеПериода;
			СтрокаОбучения.ИспользуетсяДляВсехРабочихМест = ДополнительныеПараметры.ИспользоватьДляВсехРабочихМест;
			УстановитьЗаголовокСвернутогоОтображенияОбученияПоОхранеТруда(ЭтотОбъект);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СтрокаОбучения = ПрограммыОбучения[0];
	СтрокаОбучения.Период = ДополнительныеПараметры.ПредставлениеПериода;
	СтрокаОбучения.ИспользуетсяДляВсехРабочихМест = ДополнительныеПараметры.ИспользоватьДляВсехРабочихМест;
	
	Если ДополнительныеПараметры.ИспользоватьДляВсехРабочихМест Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РабочееМестоЕстьВОбучении Тогда
		ОбучениеПоРабочимМестам.Удалить(СтрокаОбучения.ПолучитьИдентификатор());
		УстановитьЗаголовокСвернутогоОтображенияОбученияПоОхранеТруда(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает адрес во временном хранилище массива уже подобранных программ обучения.
&НаСервере
Функция АдресСпискаПодобранныхПрограммОбучения()
	
	ПодобранныеПрограммыОбучения = Новый Массив;
	Для Каждого СтрокаОбучения Из ОбучениеПоРабочимМестам Цикл
		Если СтрокаОбучения.ИспользуетсяДляВсехРабочихМест Тогда
			Продолжить;
		КонецЕсли;
		ПодобранныеПрограммыОбучения.Добавить(СтрокаОбучения.Обучение);
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ПодобранныеПрограммыОбучения, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ДобавитьПодобранныеПрограммыОбучения(ПрограммыОбучения)
	
	РеквизитыПрограммОбучения = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ПрограммыОбучения, "Ссылка, ПредставлениеПериода, ИспользоватьДляВсехРабочихМест");
	Для Каждого ПрограммаОбучения Из ПрограммыОбучения Цикл
		СтрокаОбучения = ОбучениеПоРабочимМестам.Добавить();
		СтрокаОбучения.Обучение = ПрограммаОбучения;
		ЗначенияРеквизитов = РеквизитыПрограммОбучения.Получить(ПрограммаОбучения);
		СтрокаОбучения.Период = ЗначенияРеквизитов.ПредставлениеПериода;
		СтрокаОбучения.ИспользуетсяДляВсехРабочихМест = ЗначенияРеквизитов.ИспользоватьДляВсехРабочихМест;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
