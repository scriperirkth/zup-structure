
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЦветСтиляПоясняющийОшибкуТекст 	= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветСтиляПоясняющийТекст 		= ЦветаСтиля.ПоясняющийТекст;
	ЦветСтиляИнформационнойНадписи  = ЦветаСтиля.ТекстИнформационнойНадписи;
	
	Приложение = Параметры.Приложение;
	
	Настройки = ИнтеграцияУправлениеПерсоналом.НастройкиПодключения(Приложение);
	АдресРесурсовAPI = Настройки.АдресРесурсовAPI;
	АдресРесурсовAPIПрежнееЗначение = АдресРесурсовAPI;
	Если ЗначениеЗаполнено(АдресРесурсовAPI) Тогда
		ИспользоватьАдресПриложения = 0;
		ИспользоватьАдресРесурсовAPI = 1;
	Иначе
		ИспользоватьАдресПриложения = 1;
		ИспользоватьАдресРесурсовAPI = 0;
	КонецЕсли;
	
	Заголовок = НСтр("ru = 'Адрес ресурсов API'");
	СообщениеПроверкаНеВыполнялась = НСтр("ru = 'Требуется проверить адрес ресурсов API.'");
	
	ОбновитьЭУВыборАдреса(ЭтотОбъект);
	ОбновитьСообщениеОПроверке(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользоватьАдресПриложенияПриИзменении(Элемент)
	
	Если ИспользоватьАдресПриложения = 1 Тогда
		ИспользоватьАдресРесурсовAPI = 0;
		АдресРесурсовAPIПрежнееЗначение = АдресРесурсовAPI;
		АдресРесурсовAPI = "";
	КонецЕсли;
	
	СброситьНастройкиПроверки();
	ОбновитьЭУВыборАдреса(ЭтотОбъект);
	ОбновитьСообщениеОПроверке(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьАдресРесурсовAPIПриИзменении(Элемент)
	
	Если ИспользоватьАдресРесурсовAPI = 1 Тогда
		ИспользоватьАдресПриложения = 0;
		АдресРесурсовAPI = АдресРесурсовAPIПрежнееЗначение;
	КонецЕсли;
	
	СброситьНастройкиПроверки();
	ОбновитьЭУВыборАдреса(ЭтотОбъект);
	ОбновитьСообщениеОПроверке(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресРесурсовAPIПриИзменении(Элемент)
	
	СброситьНастройкиПроверки();
	ОбновитьСообщениеОПроверке(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	
	Если ИспользоватьАдресПриложения = 1 Или НастройкиПравильные Или Модифицированность = Ложь Тогда
		СохранитьНастройкиНаСервер();
		Закрыть();
	Иначе
		Если Не ПроверкаВыполнялась Тогда
			ТекстПредупреждения = НСтр("ru = 'Необходимо проверить адрес ресурсов API.'");
		Иначе
			ТекстПредупреждения = НСтр("ru = 'Новый адрес ресурсов API не прошел проверку.'");
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройки(Команда)
	
	Если Не ЗначениеЗаполнено(АдресРесурсовAPI) Тогда
		ТекстПредупреждения = НСтр("ru = 'Укажите адрес ресурсов API'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	НачатьПроверкуНастроек();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроверкаНовыйНастроек

&НаКлиенте
Процедура НачатьПроверкуНастроек()
	
	ПроверкаВыполнялась = Истина;
	НастройкиПравильные = Ложь;
	СообщениеПроверки 	= "";
	
	ДлительнаяОперация = ПроверкаНастроекПодключенияНаСервере();
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ОповещениеПользователя.Показать = Истина;
	ПараметрыОжидания.ОповещениеПользователя.Текст = НСтр("ru = 'Проверка ресурсов API.'");
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПроверкаНастроекЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ПроверкаНастроекПодключенияНаСервере()
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("Приложение", Приложение);
	ПараметрыПроверки.Вставить("АдресРесурсовAPI", АдресРесурсовAPI);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"ИнтеграцияУправлениеПерсоналомОбмен.ПроверкаАдресаРесурсовAPI",
		ПараметрыПроверки);
	
КонецФункции

&НаКлиенте
Процедура ПроверкаНастроекЗавершение(ДлительнаяОперация, ДополнительныеПараметры) Экспорт
	
	Если ДлительнаяОперация = Неопределено Тогда
		СообщениеПроверки = НСтр("ru = 'Не удалось выполнить проверку.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеПроверки);
		Возврат;
	ИначеЕсли ДлительнаяОперация.Статус = "Ошибка" Тогда
		СообщениеПроверки = НСтр("ru = 'При выполнении фонового задания возникла ошибка'");
		ТекстСообщения = СтрШаблон("%1: %2%3",СообщениеПроверки, Символы.ПС, ДлительнаяОперация.КраткоеПредставлениеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Результат = ПолучитьИзВременногоХранилища(ДлительнаяОперация.АдресРезультата);
	Если Не ЗначениеЗаполнено(Результат.СообщениеОбОшибке) Тогда
		НастройкиПравильные = Истина;
		СообщениеПроверки = НСтр("ru = 'Адрес ресурсов API проверен.'");
	Иначе
		СообщениеПроверки = Результат.СообщениеОбОшибке;
	КонецЕсли;
	
	ОбновитьСообщениеОПроверке(ЭтотОбъект, Истина);
	
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЭУВыборАдреса(Форма)
	
	ИспользуетсяАдресРесурсовAPI = Форма.ИспользоватьАдресРесурсовAPI = 1;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "АдресРесурсовAPI",
		"Доступность", ИспользуетсяАдресРесурсовAPI);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "АдресРесурсовAPI",
		"АвтоОтметкаНезаполненного", ИспользуетсяАдресРесурсовAPI);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "АдресРесурсовAPI",
		"ОтметкаНезаполненного", ИспользуетсяАдресРесурсовAPI И Не ЗначениеЗаполнено(Форма.АдресРесурсовAPI));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСообщениеОПроверке(Форма, ОбработкаРезультатаПроверки = Ложь)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ФормаПроверитьНастройки",
		"Доступность", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СостояниеПроверкиКартинка",
		"Видимость", Истина);
	Если Форма.ИспользоватьАдресПриложения = 1 Тогда
		Форма.СостояниеПроверкиОписание = "";
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СостояниеПроверкиКартинка",
			"Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ФормаПроверитьНастройки",
			"Доступность", Ложь);
	Иначе
		Если Не ОбработкаРезультатаПроверки И Форма.Модифицированность = Ложь Тогда
			Форма.СостояниеПроверкиОписание = "";
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СостояниеПроверкиКартинка",
				"Видимость", Ложь);
		ИначеЕсли Не Форма.ПроверкаВыполнялась Тогда
			Форма.СостояниеПроверкиКартинка = 1;
			Форма.СостояниеПроверкиОписание = Форма.СообщениеПроверкаНеВыполнялась;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СостояниеПроверкиОписание",
				"ЦветТекста", Форма.ЦветСтиляПоясняющийТекст);
		ИначеЕсли Форма.НастройкиПравильные Тогда
			Форма.СостояниеПроверкиКартинка = 0;
			Форма.СостояниеПроверкиОписание = Форма.СообщениеПроверки;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СостояниеПроверкиОписание",
				"ЦветТекста", Форма.ЦветСтиляИнформационнойНадписи);
		Иначе
			Форма.СостояниеПроверкиКартинка = 2;
			Форма.СостояниеПроверкиОписание = Форма.СообщениеПроверки;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СостояниеПроверкиОписание",
				"ЦветТекста", Форма.ЦветСтиляПоясняющийОшибкуТекст);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройкиПроверки()
	
	ПроверкаВыполнялась = Ложь;
	НастройкиПравильные = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервер()
	
	ИнтеграцияУправлениеПерсоналом.СохранитьНовыйАдресРесурсовAPI(Приложение, АдресРесурсовAPI);
	Модифицированность = Ложь;
	
КонецПроцедуры

#КонецОбласти