Функция ВидыПолей(ОбновлениеПубликации) Экспорт
	
	ВидыПолей = РекрутинговыеСайтыСлужебный.НовыеВидыПолей();
	
	ВидыПолей.СОдиночнымВыборомИзДерева = ПоляВакансииСОдиночнымВыборомИзДерева();
	ВидыПолей.СМножественнымВыборомИзДерева = ПоляВакансииСМножественнымВыборомИзДерева();
	ВидыПолей.СОдиночнымВыборомИзСписка = ПоляВакансииСОдиночнымВыборомИзСписка();
	ВидыПолей.СМножественнымВыборомИзСписка = ПоляВакансииСМножественнымВыборомИзСписка();
	ВидыПолей.НедоступныеДляРедактирования = ПоляВакансииНедоступныеДляРедактирования();
	ВидыПолей.СоСпискомБезКлассификатора = ПоляВакансииСоСпискомБезКлассификатора();
	ВидыПолей.СоСпециальнойФормойРедактированияСписка = ПоляВакансииСоСпециальнойФормойРедактированияСписка();
	ВидыПолей.СТекстомВHTML = ПоляВакансииСТекстомВHTML();
	
	Возврат ВидыПолей;
	
КонецФункции

// Параметры:
//  Путь - Строка
// 
// Возвращаемое значение:
//  СписокЗначений
Функция СписокВыбораПоКлассификатору(Путь) Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат СписокВыбора;
	КонецЕсли;
	
	Классификаторы = КлассификаторыСайта();
	Если Классификаторы = Неопределено Или Не Классификаторы.Свойство(Путь) Тогда
		Возврат СписокВыбора;
	КонецЕсли;
	
	МассивДанных = Классификаторы[Путь]; // Массив
	Если Путь = "currency" Тогда
		Для Каждого ЭлементМассива Из МассивДанных Цикл
			Если Не ЭлементМассива.in_use Тогда
				Продолжить;
			КонецЕсли;
			СписокВыбора.Добавить(ЭлементМассива.code, ЭлементМассива.abbr);
		КонецЦикла;
	Иначе
		Для Каждого ЭлементМассива Из МассивДанных Цикл
			СписокВыбора.Добавить(
				ЭлементМассива.id,
				?(ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЭлементМассива, "name")),
					ЭлементМассива.name, ЭлементМассива.id));
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

// Параметры:
//  Дерево - ДеревоЗначений
// 
// Возвращаемое значение:
//  Структура: см. РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией
Функция ОпубликоватьВакансию(Дерево) Экспорт
	
	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();
	
	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;
	
	JSONОписаниеВакансии = JSONОписаниеВакансии(Дерево);
	
	Запрос = НовыйHTTPЗапрос("/vacancies?with_professional_roles=true");
	Запрос.УстановитьТелоИзСтроки(JSONОписаниеВакансии, , ИспользованиеByteOrderMark.НеИспользовать);
	
	РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().ОтправитьДляОбработки, Запрос);
	
	Если РезультатЗапроса.КодСостояния = 201 Тогда
		АдресВакансии = РезультатЗапроса.Ответ.Заголовки.Получить("Location");
		
		НомерВхожденияРазделителя = РекрутинговыеСайтыКлиентСервер.НайтиВСтроке(АдресВакансии, "/", 2);
		ИдентификаторВакансии = Сред(АдресВакансии, НомерВхожденияРазделителя + 1, СтрДлина(АдресВакансии) - НомерВхожденияРазделителя);
		
		Результат.ИдентификаторВакансии = ИдентификаторВакансии;
	Иначе
		Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Дерево - ДеревоЗначений
//  ИдентификаторВакансии - Строка
// 
// Возвращаемое значение:
//  Структура - см. РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией
Функция ОбновитьПубликациюВакансии(Дерево, ИдентификаторВакансии) Экспорт
	
	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();
	
	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойОбновленияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;
	
	JSONОписаниеВакансии = JSONОписаниеВакансии(Дерево, Истина);
	
	Если Не ЗначениеЗаполнено(JSONОписаниеВакансии) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка чтения данных публикации на сайте %1.'"), Сайт);
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкой(ТекстСообщения, Сайт, ЭтотОбъект);
	КонецЕсли;
	
	ОписаниеВакансии = ПарсерJSON(JSONОписаниеВакансии);
	
	ОписаниеВакансии_vacancy_properties = Неопределено;
	ОписаниеВакансии_manager = Неопределено;
	Если ОписаниеВакансии.Свойство("vacancy_properties") Тогда
		ОписаниеВакансии_vacancy_properties =
			Новый Структура("vacancy_properties", Новый Структура("properties", Новый Массив()));
		Для Каждого Свойство Из ОписаниеВакансии.vacancy_properties.properties Цикл
			ОписаниеВакансии_vacancy_properties.vacancy_properties.properties.Добавить(
				Новый Структура("property_type", Свойство.property_type));
		КонецЦикла;
		ОписаниеВакансии.Удалить("vacancy_properties");
	КонецЕсли;
	
	Если ОписаниеВакансии.Свойство("manager") Тогда
		ОписаниеВакансии_manager = Новый Структура("manager", ОписаниеВакансии.manager);
		ОписаниеВакансии.Удалить("manager");
	КонецЕсли;
	
	JSONОписаниеВакансии = РекрутинговыеСайтыСлужебный.ЗаписьJSON(ОписаниеВакансии);
	
	ТекстЗапроса = СтрШаблон("/vacancies/%1?with_professional_roles=true", ИдентификаторВакансии);
	
	Запрос = НовыйHTTPЗапрос(ТекстЗапроса);
	Запрос.УстановитьТелоИзСтроки(JSONОписаниеВакансии, , ИспользованиеByteOrderMark.НеИспользовать);
	
	РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Записать, Запрос);
	
	Если РезультатЗапроса.КодСостояния <> 204 Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойОбновленияВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;
	
	Если ОписаниеВакансии_vacancy_properties <> Неопределено Тогда
		JSONОписаниеВакансии = РекрутинговыеСайтыСлужебный.ЗаписьJSON(ОписаниеВакансии_vacancy_properties);
		Запрос.УстановитьТелоИзСтроки(JSONОписаниеВакансии, , ИспользованиеByteOrderMark.НеИспользовать);
		
		РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Записать, Запрос);
		
		Если РезультатЗапроса.КодСостояния <> 204 Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка обновления биллингового типа вакансии на сайте %1.'"), Сайт);
			Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкой(ТекстСообщения, Сайт, ЭтотОбъект, РезультатЗапроса);
		КонецЕсли;
	КонецЕсли;
	
	Если ОписаниеВакансии_manager <> Неопределено Тогда
		JSONОписаниеВакансии = РекрутинговыеСайтыСлужебный.ЗаписьJSON(ОписаниеВакансии_manager);
		Запрос.УстановитьТелоИзСтроки(JSONОписаниеВакансии, , ИспользованиеByteOrderMark.НеИспользовать);
		
		РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Записать, Запрос);
		
		Если РезультатЗапроса.КодСостояния <> 204 Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка обновления менеджера вакансии на сайте %1.'"), Сайт);
			Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкой(ТекстСообщения, Сайт, ЭтотОбъект, РезультатЗапроса);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ИдентификаторВакансии - Строка
// 
// Возвращаемое значение:
//  Структура: см. РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией
Функция СнятьПубликациюВакансии(ИдентификаторВакансии) Экспорт
	
	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();
	
	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойСнятияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;
	
	ИнформацияОПользователе = ИнформацияОПользователе();
	
	ИдентификаторКомпании = ИнформацияОПользователе.ИдентификаторКомпании;
	ИдентификаторПользователя = ИнформацияОПользователе.ИдентификаторПользователя;
	
	Если Не ЗначениеЗаполнено(ИдентификаторКомпании) 
		Или Не ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойСнятияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;
	
	Запрос = НовыйHTTPЗапрос(СтрШаблон("/employers/%1/vacancies/archived/%2", ИдентификаторКомпании, ИдентификаторВакансии));
	
	РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Записать, Запрос);
	
	Если РезультатЗапроса.КодСостояния <> 204 Тогда
		Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойСнятияВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ИдентификаторВакансии - Строка
// 
// Возвращаемое значение:
// - Неопределено
// - Структура: См. РекрутинговыеСайтыСлужебный.НовыеСвойстваПубликацииВакансии
Функция СвойстваПубликацииВакансииНаСайте(ИдентификаторВакансии) Экспорт
	
	СвойстваПубликации = РекрутинговыеСайтыСлужебный.НовыеСвойстваПубликацииВакансии();
	
	Если Не УстановитьСоединение() Тогда
		Возврат СвойстваПубликации;
	КонецЕсли;
	
	Описание = ОписаниеПубликацииВакансии(ИдентификаторВакансии, Ложь);
	Если ЗначениеЗаполнено(Описание) Тогда
		СвойстваПубликации.Опубликована = Не ЗначениеСвойстваУзла(Описание, "archived");
		
		Если СвойстваПубликации.Опубликована Тогда
			СвойстваПубликации.ДатаПубликации = РекрутинговыеСайтыСлужебный.СтрокаВДату(ЗначениеСвойстваУзла(Описание, "published_at"));
			СвойстваПубликации.ДатаОбновления = РекрутинговыеСайтыСлужебный.СтрокаВДату(ЗначениеСвойстваУзла(Описание, "published_at"));
		Иначе
			Истекает = ЗначениеСвойстваУзла(Описание, "expires_at");
			Если ЗначениеЗаполнено(Истекает) Тогда
				СвойстваПубликации.ДатаСнятияСПубликации = 
					Мин(РекрутинговыеСайтыСлужебный.СтрокаВДату(ЗначениеСвойстваУзла(Описание, "expires_at")), ТекущаяДатаСеанса());
			Иначе
				СвойстваПубликации.ДатаСнятияСПубликации = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СвойстваПубликации;
	
КонецФункции

// Параметры:
//  Вакансия - СправочникСсылка.Вакансии
Процедура ПолучитьОтклики(Вакансия) Экспорт
	
	ИдентификаторыВакансии = РекрутинговыеСайтыСлужебный.ИдентификаторыПубликацийВакансии(Вакансия, Сайт);
	
	Если Не ЗначениеЗаполнено(ИдентификаторыВакансии) Тогда
		РекрутинговыеСайтыСлужебный.СообщитьОбОтсутствииПубликации(Сайт);
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьПодключение().Подключен Тогда
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуПолученияОткликов(Сайт, Пользователь);
		Возврат;
	КонецЕсли;
	
	Если Не УстановитьСоединение() Тогда
		Возврат;
	КонецЕсли;
	
	ЗагруженныеОткликиВакансии = РекрутинговыеСайтыСлужебный.ЗагруженныеОткликиВакансии(Вакансия);
	Отклики = РекрутинговыеСайтыСлужебный.НоваяТаблицаОткликов();
	
	Для Каждого ИдентификаторВакансии Из ИдентификаторыВакансии Цикл
		Запрос = НовыйHTTPЗапрос("negotiations?vacancy_id=" + ИдентификаторВакансии);
		РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Получить, Запрос);
		
		Если РезультатЗапроса.КодСостояния <> 200 Тогда
			РекрутинговыеСайтыСлужебный.СообщитьОбОшибкеПолученияОткликов(Сайт, ЭтотОбъект, РезультатЗапроса);
			Возврат;
		Иначе
			КоллекцииОткликов = ПрочитатьОтветКоллекцияОткликов(РезультатЗапроса);
		КонецЕсли;
		
		Для Каждого КоллекцияОткликов Из КоллекцииОткликов.collections Цикл
			Для каждого РезультатЗапроса Из
				ВсеРезультатыЗапроса("negotiations/" + КоллекцияОткликов.id + "?vacancy_id=" + ИдентификаторВакансии) Цикл
				
				Если РезультатЗапроса.КодСостояния <> 200 Тогда
					РекрутинговыеСайтыСлужебный.СообщитьОбОшибкеПолученияРезюме(Сайт, ЭтотОбъект, РезультатЗапроса);
					Возврат;
				Иначе
					ОткликиССайта = ПрочитатьОтветОтклики(РезультатЗапроса);
					
					Для Каждого Отклик Из ЗначениеСвойстваУзла(ОткликиССайта, "items") Цикл
						Если Отклик = Неопределено 
							Или Отклик = "null" Тогда
							Продолжить;
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(ЗначениеСвойстваУзла(Отклик, "resume")) Тогда
							Продолжить;
						КонецЕсли;
						
						ИдентификаторРезюме = ЗначениеСвойстваУзла(Отклик, "resume", "id");
						Если ЗагруженныеОткликиВакансии.Найти(ИдентификаторРезюме) = Неопределено Тогда
							НоваяЗапись = Отклики.Добавить();
							НоваяЗапись.Вакансия = Вакансия;
							НоваяЗапись.Фамилия = ЗначениеСвойстваУзла(Отклик, "resume", "last_name");
							НоваяЗапись.Имя = ЗначениеСвойстваУзла(Отклик, "resume", "first_name");
							НоваяЗапись.Отчество = ЗначениеСвойстваУзла(Отклик, "resume", "middle_name");
							НоваяЗапись.Источник = Сайт;
							НоваяЗапись.ДатаОтклика = РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Отклик, "updated_at"));
							НоваяЗапись.ИдентификаторРезюме = ИдентификаторРезюме;
							НоваяЗапись.Адрес = ЗначениеСвойстваУзла(Отклик, "resume", "area", "name");
							НоваяЗапись.АдресРезюме = ЗначениеСвойстваУзла(Отклик, "resume", "alternate_url");
							
							Если ЗначениеСвойстваУзла(Отклик, "resume", "can_view_full_info") = Истина Тогда
								Запрос = НовыйHTTPЗапрос("/resumes/" + ИдентификаторРезюме);
								
								РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Получить, Запрос);
							
								Если РезультатЗапроса.КодСостояния = 200 Тогда
									
									Резюме = ПрочитатьОтветРезюмеССайта(РезультатЗапроса);
									
									КонтактнаяИнформация = КонтактнаяИнформацияРезюме(Резюме);
									
									Для Каждого КонтактнаяИнформацияСтрока Из КонтактнаяИнформация Цикл
									
										Если КонтактнаяИнформацияСтрока.Вид = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыКонтактнойИнформации.ТелефонЛичныеДанныеКандидатов") Тогда
											НоваяЗапись.Телефон = КонтактнаяИнформацияСтрока.Представление;
										КонецЕсли;
										
										Если КонтактнаяИнформацияСтрока.Вид = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыКонтактнойИнформации.EMailЛичныеДанныеКандидатов") Тогда
											НоваяЗапись.EMail = КонтактнаяИнформацияСтрока.Представление;
										КонецЕсли;
										
									КонецЦикла;
									
								КонецЕсли;
							КонецЕсли;
							
							Запрос = НовыйHTTPЗапрос("/negotiations/" + ЗначениеСвойстваУзла(Отклик, "id") + "/messages?with_text_only=true");
							
							РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Получить, Запрос);
							
							Если РезультатЗапроса.КодСостояния = 200 Тогда
								
								Сообщения = ПрочитатьОтветСообщения(РезультатЗапроса);
								
								Для Каждого Сообщение Из Сообщения.Получить("items") Цикл
									
									Если ЗначениеСвойстваУзла(Сообщение, "author", "participant_type") = "applicant" Тогда
										
										НоваяЗапись.Сообщение = РекрутинговыеСайтыСлужебный.УдалитьЛишнееИзСтроки(ЗначениеСвойстваУзла(Сообщение, "text"));
										Прервать;
										
									КонецЕсли;
									
								КонецЦикла;
								
							КонецЕсли;
							
							ЗагруженныеОткликиВакансии.Добавить(ИдентификаторРезюме);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	РекрутинговыеСайтыСлужебный.ЗаписатьОтклики(Отклики, Пользователь);
	
КонецПроцедуры

// Параметры:
//  Кандидат - СправочникСсылка.Кандидаты
//  ДанныеРезюме - ТаблицаЗначений: см. РекрутинговыеСайтыСлужебный.ДанныеРезюме
Процедура ЗагрузитьКомментарииКандидата(Кандидат, ДанныеРезюме) Экспорт
	
	ОтборСтрок = Новый Структура();
	ОтборСтрок.Вставить("МестоПубликации", Сайт);
	ОтборСтрок.Вставить("ИмяПоля", "owner");
	
	НайденныеСтроки = ДанныеРезюме.НайтиСтроки(ОтборСтрок);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СодержимоеПоляOwner = НайденныеСтроки[0].СодержимоеПоля;
	ИдентификаторКомпании = НайденныеСтроки[0].ИдентификаторПользователя;
	
	ПакетOwner = ПрочитатьПолеOwner(СодержимоеПоляOwner);
	АдресКомментариев = ПакетOwner.comments.url;
	
	Комментарии = КомментарииКандидата(АдресКомментариев, ИдентификаторКомпании, Кандидат);
	
	Если Комментарии <> Неопределено Тогда
		РекрутинговыеСайтыСлужебный.ЗаписатьТаблицуКомментариевКандидата(Комментарии, Кандидат, Сайт);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Классификатор - Строка
//  Дерево - ДеревоЗначений
// 
// Возвращаемое значение:
//  Булево
Функция ЗаполнитьДеревоКлассификатора(Классификатор, Дерево) Экспорт
	
	Результат = Ложь;
	
	Если Классификатор = "professional_roles" Тогда
		Результат = ЗаполнитьДеревоПрофессиональныхРолей(Дерево);
	ИначеЕсли Классификатор = "areas" Или Классификатор = "areas_towns" Тогда
		Результат = ЗаполнитьДеревоРегионов(Дерево);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  АдресРезюме - Строка
// 
// Возвращаемое значение:
//  Структура: см. ПодборПерсоналаКлиентСервер.ДоступностьКонтактовВРезюме
Функция ДоступныеДляПолученияКонтакты(АдресРезюме) Экспорт
	
	ДоступностьКонтактов = ПодборПерсоналаКлиентСервер.ДоступностьКонтактовВРезюме();
	
	ИдентификаторРезюме = ИдентификаторРезюмеПоАдресу(АдресРезюме);
	
	Попытка
		СтруктураРезюме = СтруктураРезюмеССайта(ИдентификаторРезюме);
		ЗаполнитьДоступностьКонтактов(ДоступностьКонтактов, СтруктураРезюме);
	Исключение
		ДоступностьКонтактов.КонтактыОткрыты = Ложь;
	КонецПопытки;
	
	Возврат ДоступностьКонтактов;
	
КонецФункции

// Параметры:
//  АдресРезюме - Строка
// 
// Возвращаемое значение:
//  Структура: см. РекрутинговыеСайтыСлужебный.НовыеКонтактыРезюме
Функция КонтактыРезюме(АдресРезюме) Экспорт
	
	КонтактыРезюме = РекрутинговыеСайтыСлужебный.НовыеКонтактыРезюме();
	
	Резюме = РезюмеСКонтактами(АдресРезюме);
	Если Не ЗначениеЗаполнено(Резюме) Тогда
		Возврат КонтактыРезюме;
	КонецЕсли;
	
	КонтактыРезюме.Фамилия	= ЗначениеСвойстваУзла(Резюме, "last_name");
	КонтактыРезюме.Имя		= ЗначениеСвойстваУзла(Резюме, "first_name");
	КонтактыРезюме.Отчество	= ЗначениеСвойстваУзла(Резюме, "middle_name");
	
	КонтактнаяИнформация = ЗначениеСвойстваУзла(Резюме, "contact");
	
	Если Не ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
		Возврат КонтактыРезюме;
	КонецЕсли;
	
	Для Каждого ЭлементКИ Из КонтактнаяИнформация Цикл
		ТипКИ = ЗначениеСвойстваУзла(ЭлементКИ, "type", "id");
		
		Если ТипКИ = "cell" Тогда
			КонтактыРезюме.Телефон = ЗначениеСвойстваУзла(ЭлементКИ, "value", "formatted");
		ИначеЕсли ТипКИ = "email" Тогда
			КонтактыРезюме.ЭлектроннаяПочта = ЗначениеСвойстваУзла(ЭлементКИ, "value");
		КонецЕсли;
	КонецЦикла;
	
	Возврат КонтактыРезюме;
	
КонецФункции

// Параметры:
//  ДанныеДляОтправки - См. РекрутинговыеСайтыСлужебный.ДанныеДляОтправкиОбратнойСвязи
// 
// Возвращаемое значение:
//  Булево - Отправка прошла успешно
Функция ОтправитьОбратнуюСвязьПоОтклику(ДанныеДляОтправки) Экспорт
	
	Результат = Ложь;
	
	ИдентификаторыВакансии =
		РекрутинговыеСайтыСлужебный.ИдентификаторыПубликацийВакансии(ДанныеДляОтправки.Вакансия, Сайт);
		
	Если Не ЗначениеЗаполнено(ИдентификаторыВакансии) Тогда
		ТекстОшибки = НСтр("ru = 'Вакансия не опубликована.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Если Не ПроверитьПодключение().Подключен Тогда
		ТекстОшибки = НСтр("ru = 'Не настроен доступ к сайту.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Если Не УстановитьСоединение() Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось установить соединение с сайтом.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ИдентификаторВакансии Из ИдентификаторыВакансии Цикл
		Запрос = НовыйHTTPЗапрос("negotiations?vacancy_id=" + ИдентификаторВакансии);
		
		РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Получить, Запрос);
		
		Если РезультатЗапроса.КодСостояния <> 200 Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось получить отклики.'");
			РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
				Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки, РезультатЗапроса);
			Возврат Результат;
		Иначе
			КоллекцииОткликов = ПрочитатьОтветКоллекцияОткликов(РезультатЗапроса);
		КонецЕсли;
		
		Действие = ?(ДанныеДляОтправки.Отклонить, "discard_by_employer", "interview");
		
		Для Каждого КоллекцияОткликов Из КоллекцииОткликов.states Цикл
			Для каждого РезультатЗапроса Из
				ВсеРезультатыЗапроса("negotiations/" + КоллекцияОткликов.id + "?vacancy_id=" + ИдентификаторВакансии) Цикл

				Если РезультатЗапроса.КодСостояния <> 200 Тогда
					ТекстОшибки = НСтр("ru = 'Не удалось получить отклики.'");
					РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
						Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки, РезультатЗапроса);
					Возврат Результат;
				Иначе
					ОткликиССайта = ПрочитатьОтветОтклики(РезультатЗапроса);
					
					Для Каждого Отклик Из ЗначениеСвойстваУзла(ОткликиССайта, "items") Цикл
						Если Отклик = Неопределено 
							Или Отклик = "null" Тогда
							Продолжить;
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(ЗначениеСвойстваУзла(Отклик, "resume")) Тогда
							Продолжить;
						КонецЕсли;
						
						ИдентификаторРезюме = ЗначениеСвойстваУзла(Отклик, "resume", "id");
						
						Если СтрНайти(ДанныеДляОтправки.АдресРезюме, ИдентификаторРезюме) = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						Адрес = "";
						Метод = "";
						ДоступнаОтправкаСообщения = Ложь;
						Для каждого ДоступноеДействие Из ЗначениеСвойстваУзла(Отклик, "actions") Цикл
							Если ЗначениеСвойстваУзла(ДоступноеДействие, "id") = Действие Тогда
								Адрес = ЗначениеСвойстваУзла(ДоступноеДействие, "url");
								Метод = ЗначениеСвойстваУзла(ДоступноеДействие, "method");
								
								Для каждого Аргумент Из ЗначениеСвойстваУзла(ДоступноеДействие, "arguments") Цикл
									Если ЗначениеСвойстваУзла(Аргумент, "id") = "message" Тогда
										ДоступнаОтправкаСообщения = Истина;
										Прервать;
									КонецЕсли;
								КонецЦикла;
								
								Прервать;
							КонецЕсли;
						КонецЦикла;
						
						Если ЗначениеЗаполнено(Адрес) Тогда
							Запрос = НовыйHTTPЗапрос(СтрЗаменить(Адрес, СтрШаблон("https://%1/", ДанныеСайта.АдресЗапроса), ""));
							Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
							
							Сообщение = ДанныеДляОтправки.Сообщение;
							Тело = "";
							Если ДоступнаОтправкаСообщения Тогда
								Тело = СтрШаблон("message=%1", КодироватьСтроку(Сообщение, СпособКодированияСтроки.КодировкаURL));
							КонецЕсли;
							
							Запрос.УстановитьТелоИзСтроки(Тело);
							
							РезультатЗапроса = ВыполнитьHTTPЗапрос(Метод, Запрос);
							
							Если РезультатЗапроса.КодСостояния = 204 Тогда
								Результат = Истина;
								Прервать;
							Иначе
								ТекстОшибки = НСтр("ru = 'Не удалось отправить обратную связь.'");
								РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
									Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки, РезультатЗапроса);
								Возврат Результат;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если Результат Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Результат Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УстановитьСоединение()
	
	Результат = Истина;
	
	Если Не ЗначениеЗаполнено(МаркерДоступа) Тогда
		Результат = Инициализировать();
	КонецЕсли;
	
	Если Соединение = Неопределено Тогда
		Соединение = РекрутинговыеСайтыСлужебный.НовоеHTTPСоединение(АдресСервера());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Инициализировать()
	
	РеквизитыСайта = РекрутинговыеСайтыСлужебный.РеквизитыСайта(Сайт, Пользователь);
	
	Если РеквизитыСайта = Неопределено Или Не ЗначениеЗаполнено(РеквизитыСайта.МаркерДоступа) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не настроена интеграция с %1.'"), АдресСайта());
	КонецЕсли; 
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыСайта);
	
	Возврат МаркерАктивен();
	
КонецФункции

Функция МетодыЗапросов()
	
	Возврат РекрутинговыеСайтыСлужебный.МетодыЗапросов();
	
КонецФункции

Функция ВыполнитьHTTPЗапрос(Метод, Запрос, ВызыватьИсключение = Истина) Экспорт
	
	Возврат РекрутинговыеСайтыСлужебный.ВыполнитьHTTPЗапрос(Соединение, Метод, Запрос, ВызыватьИсключение);
	
КонецФункции

Функция ВсеРезультатыЗапроса(Адрес, НаСтранице = 50)
	
	Результат = Новый Массив();
	НомерСтраницы = 0;
	КоличествоРезультатов = НаСтранице + 1;
	
	Пока КоличествоРезультатов > НаСтранице Цикл
		АдресЗапроса = СтрШаблон("%1%2page=%3&per_page=%4",
			Адрес,
			?(СтрНайти(Адрес, "?") = 0, "?", "&"),
			НомерСтраницы,
			НаСтранице);
		
		РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Получить, НовыйHTTPЗапрос(АдресЗапроса));
		Результат.Добавить(РезультатЗапроса);
		
		СтраницаОтвета = ПрочитатьМногостраничныйОтвет(РезультатЗапроса);
		
		КоличествоРезультатов = СтраницаОтвета["found"] - (НомерСтраницы * НаСтранице);
		НомерСтраницы = НомерСтраницы + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Обновление - Булево
//  Показыватьпредупреждение- Булево
// 
// Возвращаемое значение:
// Структура: см. РекрутинговыеСайтыСлужебный.НоваяСтруктураМаркеров
Функция СтруктураМаркеров(Обновление = Ложь, Показыватьпредупреждение = Истина)
	
	СтруктураМаркеров = РекрутинговыеСайтыСлужебный.НоваяСтруктураМаркеров();
	
	ИдентификаторПриложения = ЗарплатаКадрыРасширенный.ИдентификацияПриложенияДляЗарплатаРу();
	Структура_token_uri = ОбщегоНазначенияКлиентСервер.СтруктураURI(ИдентификаторПриложения.token_uri);
	АдресАутентификации = Структура_token_uri.Хост;
	РесурсНаСервере = Структура_token_uri.ПутьНаСервере;
	Если Обновление Тогда
		СтрокаЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					"grant_type=refresh_token&refresh_token=%1",
					МаркерОбновления);
	Иначе
		СтрокаЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					"grant_type=authorization_code&client_id=%1&client_secret=%2&redirect_uri=%3&code=%4",
					ИдентификаторПриложения.client_id,
					ИдентификаторПриложения.client_secret,
					ИдентификаторПриложения.redirect_uri,
					КодАвторизации); 
	КонецЕсли;
	
	СоединениеАутентификации = РекрутинговыеСайтыСлужебный.НовоеHTTPСоединение(АдресАутентификации, Истина);
	
	// Формируем общие заголовки.
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("User-Agent", ЗарплатаКадры.ИмяКлиентскогоПриложения());
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	Запрос = Новый HTTPЗапрос(РесурсНаСервере, Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаЗапроса);
	
	РезультатЗапроса = РекрутинговыеСайтыСлужебный.ВыполнитьHTTPЗапрос(
		СоединениеАутентификации, МетодыЗапросов().ОтправитьДляОбработки, Запрос);
	
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		Если Показыватьпредупреждение Тогда
			РекрутинговыеСайтыСлужебный.СообщитьОбОшибкеАвторизации(Сайт, ЭтотОбъект, РезультатЗапроса);
		КонецЕсли;
		
		Возврат СтруктураМаркеров;
	КонецЕсли;
	
	ОтветОбъект = ПрочитатьОтветМаркерыДоступа(РезультатЗапроса);
	
	СтруктураМаркеров.МаркерДоступа = ОтветОбъект.access_token;
	СтруктураМаркеров.МаркерОбновления = ОтветОбъект.refresh_token;
	СтруктураМаркеров.ДатаОкончанияДействияМаркераДоступа = ТекущаяДатаСеанса() + ОтветОбъект.expires_in;
	
	МаркерДоступа = СтруктураМаркеров.МаркерДоступа;
	МаркерОбновления = СтруктураМаркеров.МаркерОбновления;
	ДатаОкончанияДействияМаркераДоступа = СтруктураМаркеров.ДатаОкончанияДействияМаркераДоступа;
	
	Возврат СтруктураМаркеров;
	
КонецФункции

Функция МаркерАктивен(Показыватьпредупреждение = Истина)
	
	МаркерДействителен = ЗначениеЗаполнено(МаркерДоступа)
			И ДатаОкончанияДействияМаркераДоступа > ТекущаяДатаСеанса();
		
	МаркерАктивен = Ложь;
		
	Если МаркерДействителен Тогда
		МаркерАктивен = СайтДоступен(Показыватьпредупреждение);
	КонецЕсли;
		
	Если Не МаркерАктивен И ЗначениеЗаполнено(МаркерОбновления) Тогда
		РезультатОбновления = ОбновитьМаркеры(Показыватьпредупреждение);
		МаркерДоступа = РезультатОбновления.МаркерДоступа;
		Если ЗначениеЗаполнено(РезультатОбновления.МаркерДоступа) Тогда
			МаркерАктивен = Истина;
			РезультатОбновления.Пользователь = Пользователь;
			РекрутинговыеСайтыСлужебный.СохранитьНастройкиАвторизации(РезультатОбновления);
		КонецЕсли;
	КонецЕсли;
	
	Возврат МаркерАктивен;
	
КонецФункции

Функция СайтДоступен(Показыватьпредупреждение = Истина)
	
	Возврат ЗначениеЗаполнено(ИнформацияОПользователе(Показыватьпредупреждение).ИмяПользователя);
	
КонецФункции

Функция ОбновитьМаркеры(Показыватьпредупреждение = Истина)
	
	Результат = РекрутинговыеСайтыСлужебный.НовыеРеквизитыСайта();
	Результат.Сайт = Сайт;
	Результат.Пользователь = Пользователь;
	
	СтруктураМаркеров = СтруктураМаркеров(Истина, Показыватьпредупреждение);
	
	Если ЗначениеЗаполнено(СтруктураМаркеров.МаркерДоступа) Тогда
		Результат.Подключен = Истина;
		
		ИнформацияОПользователе= ИнформацияОПользователе();
		
		Результат.МаркерДоступа = СтруктураМаркеров.МаркерДоступа;
		Результат.МаркерОбновления = СтруктураМаркеров.МаркерОбновления;
		Результат.ДатаОкончанияДействияМаркераДоступа = СтруктураМаркеров.ДатаОкончанияДействияМаркераДоступа;
		
		Результат.ИмяПользователя = ИнформацияОПользователе.ИмяПользователя;
		Результат.ИдентификаторПользователя = ИнформацияОПользователе.ИдентификаторКомпании;
		Результат.КодАвторизации = КодАвторизации;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйHTTPЗапрос(ТекстЗапроса)
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("User-Agent", ЗарплатаКадры.ИмяКлиентскогоПриложения());
	
	Если ЗначениеЗаполнено(МаркерДоступа) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + МаркерДоступа);
	КонецЕсли;
	
	Запрос = Новый HTTPЗапрос(ТекстЗапроса, Заголовки);
	
	Возврат Запрос;
	
КонецФункции

