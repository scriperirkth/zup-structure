// Параметры:
//  АдресРезюме - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ИдентификаторРезюмеПоАдресу(АдресРезюме) Экспорт
	
	ИдентификаторРезюме = АдресРезюме;
	
	Разделитель = "/";
	ПозицияРазделителя =
		РекрутинговыеСайтыКлиентСервер.НайтиВСтроке(ИдентификаторРезюме, Разделитель);
	
	Пока ПозицияРазделителя > 0 Цикл
		ИдентификаторРезюме =
			Сред(ИдентификаторРезюме,
				ПозицияРазделителя + СтрДлина(Разделитель),
				СтрДлина(ИдентификаторРезюме) - ПозицияРазделителя);
		
		ПозицияРазделителя =
			РекрутинговыеСайтыКлиентСервер.НайтиВСтроке(ИдентификаторРезюме, Разделитель);
	КонецЦикла;
	
	Разделитель = "?";
	ПозицияРазделителя =
		РекрутинговыеСайтыКлиентСервер.НайтиВСтроке(ИдентификаторРезюме, Разделитель);
	Если ПозицияРазделителя <> 0 Тогда
		ИдентификаторРезюме = Лев(ИдентификаторРезюме, ПозицияРазделителя - СтрДлина(Разделитель));
	КонецЕсли;
	
	Возврат ИдентификаторРезюме;

КонецФункции

// Параметры:
