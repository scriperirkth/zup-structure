&НаКлиенте
Перем КонтекстЭДОКлиент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	ВызовПриОтправке = Параметры.ВызовПриОтправке;
	Организации = Параметры.Организации;
	Организация = Организации[0].Организация;
	Отпечаток = Организации[0].Отпечаток;
	
	ДатаСеанса = ТекущаяДатаСеанса();
	СрокНаступил = ДокументооборотСКОКлиентСервер.СФРИспользованиеКлючаСоответствуетТребованиям("НеПроверять",
		ДатаСеанса) = Истина;
	
	Если Параметры.СкрытьНастройкуНапоминаний Тогда
		Элементы.ОтступВерхний.Видимость = Ложь;
		Элементы.ОтступЧерта.Видимость = Ложь;
		Элементы.ОтступНижний.Видимость = Ложь;
		Элементы.Напоминания.Видимость = Ложь;
	КонецЕсли;
	
	Если СрокНаступил Тогда
		Элементы.Информация.Видимость = Ложь;
		Элементы.ИнформацияСрокНаступил.Видимость = Истина;
		Элементы.ИнформацияПоВсейШирине.Видимость = Ложь;
		Элементы.ИнформацияПоВсейШиринеСрокНаступил.Видимость = Истина;
	КонецЕсли;
	
	Если ВызовПриОтправке Тогда
		Элементы.ОтменаДействий.Видимость = Истина;
		Элементы.ОтправкаОтступ.Видимость = Истина;
		Элементы.ГруппаКнопки.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Право;
		Элементы.ГруппаКнопки.РастягиватьПоГоризонтали = Истина;
		
		Если НЕ СрокНаступил Тогда
			Элементы.ПодготовитьЗаявление.КнопкаПоУмолчанию = Ложь;
			Элементы.ПродолжитьОтправку.Видимость = Истина;
			Элементы.ПродолжитьОтправку.КнопкаПоУмолчанию = Истина;
			Элементы.ПодтверждениеОтправкиОтступ.Видимость = Истина;
			Элементы.ПодтверждениеОтправки.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Заявление = КонтекстЭДОСервер.ЗаявлениеИСтатусПоОтпечатку(Отпечаток).Заявление;
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Инициализируем контекст формы - контейнера клиентских методов
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриОткрытииЗавершение", ЭтотОбъект);
	ДокументооборотСКОКлиент.ПолучитьКонтекстЭДО(ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПодтверждениеОтправкиПриИзменении(Элемент)
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отложить(Команда)
	
	КонтекстЭДОКлиент.ОтложитьПоказПредупрежденияСФРИспользованиеКлюча(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьЗаявление(Команда)
	
	Если ВызовПриОтправке Тогда
		Если ЗначениеЗаполнено(Заявление) Тогда
			ПоказатьЗначение(, Заявление);
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения("ПодготовитьЗаявлениеПослеСозданияЗаявления", ЭтотОбъект);
			КонтекстЭДОКлиент.ОткрытьНовоеЗаявлениеСФРИспользованиеКлюча(ЭтотОбъект, Организация, ОписаниеОповещения);
		КонецЕсли;
		
	Иначе
		Если ЗначениеЗаполнено(Заявление) Тогда
			Закрыть(Заявление);
		Иначе
			Закрыть("ПодготовитьЗаявление");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОтправку(Команда)
	
	Закрыть("ПродолжитьОтправку");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Форма.Элементы.ПродолжитьОтправку.Доступность = Форма.ПодтверждениеОтправки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КонтекстЭДОКлиент = Результат.КонтекстЭДО;
	Если КонтекстЭДОКлиент = Неопределено Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьЗаявлениеПослеСозданияЗаявления(Результат, ДополнительныеПараметры) Экспорт
	
	Заявление = ЗаявлениеИСтатусПоОтпечатку(Отпечаток).Заявление;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаявлениеИСтатусПоОтпечатку(Отпечаток)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЗаявлениеИСтатусПоОтпечатку(Отпечаток);
	
КонецФункции

#КонецОбласти
