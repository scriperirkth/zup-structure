&НаКлиенте
Процедура ПометитьПрочитанным(Команда)
	
	Результат = ПометитьПрочтенными();
	
	Если Результат.СтавшиеПрочтенными.Количество() + Результат.СтавшиеНепрочтенными.Количество() = 1 Тогда
		Если Результат.СтавшиеПрочтенными.Количество() = 1 Тогда
			Оповестить("Пометка прочтенным",, Результат.СтавшиеПрочтенными[0]);
		ИначеЕсли Результат.СтавшиеНепрочтенными.Количество() = 1 Тогда
			Оповестить("Пометка непрочтенным",, Результат.СтавшиеНепрочтенными[0]);
		КонецЕсли;
		
	Иначе
		Если Результат.СтавшиеПрочтенными.Количество() <> 0 Тогда
			ИсточникСобытия = Результат.СтавшиеПрочтенными[0];
		ИначеЕсли Результат.СтавшиеНепрочтенными.Количество() <> 0 Тогда
			ИсточникСобытия = Результат.СтавшиеНепрочтенными[0];
		Иначе
			ИсточникСобытия = Неопределено;
		КонецЕсли;
		
		Оповестить("Групповая пометка прочтенными/непрочтенными", Результат, ИсточникСобытия);
	КонецЕсли;
	
	// Обновление динамического списка.
	Элементы.Новое.Обновить();
	
КонецПроцедуры

