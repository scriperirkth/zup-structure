
&НаКлиенте
Перем КонтекстЭДОКлиент;

&НаКлиенте
Перем ВыбранныеОрганизации; // для обмена.

&НаКлиенте
Перем НомерОбъекта; // для обмена.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоРежимОблачной1СО = ДокументооборотСКОПовтИсп.ЭтоРежимОблачной1СО();
	НовыеСобытияПоСтраницамЖурнала =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.НовыеСобытияПоСтраницамЖурнала();
	ЭтоАвтообмен = НЕ ЭтоРежимОблачной1СО ИЛИ НЕ НовыеСобытияПоСтраницамЖурнала
		ИЛИ НЕ Параметры.Свойство("ПереданныйРежимОткрытияОкна")
		ИЛИ НЕ ЗначениеЗаполнено(Параметры.ПереданныйРежимОткрытияОкна);
	
	ФонНевыделенного = ЦветаСтиля.БазовыйЦветФонаЭтапаОтправки;
	ЦветГиперссылки = ЦветаСтиля.ГиперссылкаЦвет;
	
	Параметры.Свойство("АдресСведенийПоОшибкам", АдресСведенийПоОшибкам);
	Если НЕ ЗначениеЗаполнено(АдресСведенийПоОшибкам) И НЕ ЭтоАвтообмен Тогда
		ОшибкиПоследнегоОбмена = ДлительнаяОтправкаВызовСервера.ПолучитьОшибкиПоследнегоОбмена();
		Если ОшибкиПоследнегоОбмена <> Неопределено Тогда
			АдресСведенийПоОшибкам = ПоместитьВоВременноеХранилище(ОшибкиПоследнегоОбмена, Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	УстановитьВидимостьПанелиОшибокОбновления(ЭтаФорма);
	
	ОткрыватьВЛюбомСлучае = Параметры.Свойство("АдресДереваНовых") И ЗначениеЗаполнено(Параметры.АдресДереваНовых);
	
	Если НовыеСобытияПоСтраницамЖурнала Тогда
		МассивИнформацииЭкранов = ПолучитьИнформациюЭкрановКлиента();
		Если МассивИнформацииЭкранов <> Неопределено И МассивИнформацииЭкранов.Количество() <> 0 Тогда
			ШиринаЭкрана = МассивИнформацииЭкранов[0].Ширина + 0;
		КонецЕсли;
	КонецЕсли;
	ОтборВидСообщения = Ложь;
	АдресДереваНовых = "";
	Параметры.Свойство("АдресДереваНовых", АдресДереваНовых);
	УправлениеФормой(ЭтотОбъект);
	ЗаполнитьДеревоНовое();
	Если НовыеСобытияПоСтраницамЖурнала Тогда
		Элементы.Новое.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
		Если ШиринаЭкрана <> 0 И ШиринаЭкрана <= 1440 ИЛИ ЭтоАвтообмен Тогда
			Элементы.ГруппаОтборОрганизацияНовое.Ширина = ?(ШиринаЭкрана <> 0 И ШиринаЭкрана <= 1280, 27, 28);
			Элементы.ГруппаОтборГосорганНовое.Ширина = ?(ШиринаЭкрана <> 0 И ШиринаЭкрана <= 1280, 27, 28);
			Элементы.ГруппаОтборПериодНовое.Ширина = ?(ШиринаЭкрана <> 0 И ШиринаЭкрана <= 1280, 27, 28);
			Элементы.БлокиНовогоВсе.Ширина = 0;
			Элементы.БлокиНовогоТребования.Ширина = 0;
			Элементы.БлокиНовогоОтчеты.Ширина = 0;
			Элементы.БлокиНовогоУведомления.Ширина = 0;
			Элементы.БлокиНовогоСверки.Ширина = 0;
			Элементы.БлокиНовогоПисьма.Ширина = 0;
			Элементы.БлокиНовогоВходящие.Ширина = 0;
			Элементы.БлокиНовогоВыплатыИПособия.Ширина = 0;
		КонецЕсли;
	КонецЕсли;
	Элементы.ГруппаОтборовНовое.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.ГруппаНовоеОбмен.Видимость = ЭтоРежимОблачной1СО;
	Элементы.ОткрытьВПолномРазмере.Видимость = ЭтоАвтообмен;
	Элементы.ОшибкиОбновленияСлева.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.ОшибкиОбновленияСправа.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.ОшибкиОбновленияСверху.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.ОшибкиОбновленияСнизу.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.БлокиНовогоОбщая.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.НовоеСлева.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.НовоеСправа.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.НовоеСверху.Видимость = НовыеСобытияПоСтраницамЖурнала;
	Элементы.НовоеСнизу.Видимость = НовыеСобытияПоСтраницамЖурнала;
	ПоказыватьНеобходимоРасшифровать = НовыеСобытияПоСтраницамЖурнала И НЕ ЭтоАвтообмен
		И ?(Параметры.Свойство("ПереданныйРежимОткрытияОкна"), Параметры.ПереданныйРежимОткрытияОкна,
			РежимОткрытияОкнаФормы.Независимый) = РежимОткрытияОкнаФормы.Независимый;
	ЗаполнитьНеобходимоРасшифровать();
	Если ЭтоРежимОблачной1СО И НовыеСобытияПоСтраницамЖурнала Тогда
		МассивПодключенныхОрганизаций = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПодключенныеОрганизации();
		ПодключенныеОрганизации.ЗагрузитьЗначения(МассивПодключенныхОрганизаций);
	КонецЕсли;
	
	Если ЭтоАвтообмен Тогда
		Заголовок = СтрШаблон(
			НСтр("ru = 'Обмен с контролирующими органами %1'"),
			Формат(ДатаПоследнегоОбновления, "ДФ='дд.ММ.гггг Ч:мм'"));
		
	Иначе
		Заголовок = НСтр("ru = 'Новые сообщения'");
	КонецЕсли;
	
	Если ЭтоАвтообмен И КоличествоНовых = 0 И НЕ ОткрыватьВЛюбомСлучае Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Попытка
		МодульСверкаСФНС = ОбщегоНазначения.ОбщийМодуль("СверкаСФНС");
	Исключение
	    МодульСверкаСФНС = Неопределено;
	КонецПопытки;
	
	Если МодульСверкаСФНС <> Неопределено Тогда
		МодульСверкаСФНС.ФормаНовыхСобытий_ПриСозданииНаСервере(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Завершение обновления"
		ИЛИ ИмяСобытия = "Завершение расшифровки"
		ИЛИ ИмяСобытия = "Завершение групповой отправки"
		ИЛИ ИмяСобытия = "Закрытие формы ошибок отправки 1С-Отчетности" Тогда
		
		ЗаполнитьНеобходимоРасшифроватьВФоне();
		
	ИначеЕсли ИмяСобытия = "Пометка прочтенным"
		ИЛИ ИмяСобытия = "Пометка непрочтенным"
		ИЛИ ИмяСобытия = "Скрытие/восстановление объекта"
		ИЛИ ИмяСобытия = "Групповая пометка прочтенными/непрочтенными" Тогда
		
		Если ЭтоРежимОблачной1СО Тогда
			МодульКалендарьОтчетностиВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("КалендарьОтчетностиВызовСервера");
			Если ИмяСобытия = "Групповая пометка прочтенными/непрочтенными" Тогда
				Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("СтавшиеНепрочтенными") Тогда
					Для каждого СсылкаВКлюче Из Параметр.СтавшиеНепрочтенными Цикл
						МодульКалендарьОтчетностиВызовСервера.СнятьУстановитьПометкуНовогоДляДокументаСЭДО(СсылкаВКлюче,
							"Пометка непрочтенным");
					КонецЦикла;
				КонецЕсли;
				
				Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("СтавшиеПрочтенными") Тогда
					Для каждого СсылкаВКлюче Из Параметр.СтавшиеПрочтенными Цикл
						МодульКалендарьОтчетностиВызовСервера.СнятьУстановитьПометкуНовогоДляДокументаСЭДО(СсылкаВКлюче,
							"Пометка прочтенным");
					КонецЦикла;
				КонецЕсли;
				
			Иначе
				СсылкаВКлюче = Неопределено;
				Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("Организация") И Параметр.Свойство("Ссылка") Тогда
					СсылкаВКлюче = Параметр.Ссылка;
				ИначеЕсли Параметр = Неопределено Тогда
					СсылкаВКлюче = Источник;
				ИначеЕсли Источник <> Неопределено И ОбщегоНазначенияЭДКОКлиент.ЭтоЗначениеТипаСОтображениемНаСервере(Источник) Тогда
					СсылкаВКлюче = Источник;
				КонецЕсли;
				
				МодульКалендарьОтчетностиВызовСервера.СнятьУстановитьПометкуНовогоДляДокументаСЭДО(СсылкаВКлюче, ИмяСобытия);
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяСобытия = "Пометка непрочтенным" ИЛИ ИмяСобытия = "Скрытие/восстановление объекта"
			ИЛИ ИмяСобытия = "Групповая пометка прочтенными/непрочтенными"
				И ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("СтавшиеНепрочтенными")
				И Параметр.СтавшиеНепрочтенными.Количество() <> 0 Тогда
			
			ЗаполнитьДеревоНовое();
			ОбновитьКнопкуНовыеСообщения();
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.СвернутьНезначимоеНовое(ЭтотОбъект);
			
		Иначе
			МассивГрупп = Новый Массив;
			СтрокиДерева = Новое.ПолучитьЭлементы();
			Если НовыеСобытияПоСтраницамЖурнала И ОтборГруппа = Неопределено Тогда
				СтрокиДерева = ОбщегоНазначенияЭДКОКлиентСервер.СтрокиДереваСПодчиненными(СтрокиДерева);
			КонецЕсли;
			Для Каждого СтрокаДерева Из СтрокиДерева Цикл
				Если СтрокаДерева.ИсходнаяГруппа = ПредопределенноеЗначение("Перечисление.ГруппыНовыхСобытийДокументооборотаСКонтролирующимиОрганами.НезавершенныеОтправки") Тогда
					Прервать;
				КонецЕсли;
				
				Если СтрокаДерева.Ссылка = Источник
					ИЛИ ИмяСобытия = "Групповая пометка прочтенными/непрочтенными"
						И ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("СтавшиеПрочтенными")
						И Параметр.СтавшиеПрочтенными.Найти(СтрокаДерева.Ссылка) <> Неопределено Тогда
					
					СтрокаДерева.НеПрочитано = Ложь;
					Если МассивГрупп.Найти(СтрокаДерева.Группа) = Неопределено Тогда
						МассивГрупп.Добавить(СтрокаДерева.Группа);
					КонецЕсли;
					Если ИмяСобытия <> "Групповая пометка прочтенными/непрочтенными" Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Для каждого ГруппаОбновленияКоличества Из МассивГрупп Цикл
				ОбновитьКоличествоНовых(ЭтотОбъект,, ГруппаОбновленияКоличества);
			КонецЦикла;
			ОбновитьКнопкуНовыеСообщения();
		КонецЕсли;
		
	ИначеЕсли (ИмяСобытия = "Получены новые сообщения 1С-Отчетности"
		ИЛИ ИмяСобытия = "Получены новые сообщения 1С-Отчетности без смены страницы") И Источник <> ЭтотОбъект Тогда
		
		Оповестить("Закрыть форму новых сообщений 1С-Отчетности",, ЭтотОбъект);
		
		ОтборГруппа = Неопределено;
		ОтборОрганизацияНовое = ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка");
		ОтборГосорганНовое = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ПустаяСсылка");
		ОтборПериодНовое = Новый СтандартныйПериод();
		НачалоПериодаНовое = Дата(1, 1, 1);
		КонецПериодаНовое = Дата(1, 1, 1);
		ТолькоУказанныйПериодНовое = Ложь;
		ОтборВидСообщения = Ложь;
		
		Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("АдресСведенийПоОшибкам")
			ИЛИ ЭтоАдресВременногоХранилища(Параметр) Тогда
			
			Если ТипЗнч(Параметр) = Тип("Структура") Тогда
				АдресСведенийПоОшибкам = Параметр.АдресСведенийПоОшибкам;
			ИначеЕсли ЭтоАдресВременногоХранилища(Параметр) Тогда
				АдресСведенийПоОшибкам = Параметр;
			КонецЕсли;
			УстановитьВидимостьПанелиОшибокОбновления(ЭтаФорма);
		КонецЕсли;
		
		ЗаполнитьДеревоНовое();
		ОбновитьКнопкуНовыеСообщения();
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.СвернутьНезначимоеНовое(ЭтотОбъект);
		ЗаполнитьНеобходимоРасшифроватьВФоне();
		
		Активизировать();
		
	ИначеЕсли ИмяСобытия = "Завершение автообмена с сервером ФСС" ИЛИ ИмяСобытия = "Завершение автообмена с сервером ФСРАР"
		ИЛИ ИмяСобытия = "Завершение автообмена с сервером РПН" ИЛИ ИмяСобытия = "Завершение автообмена с сервером ФТС"
		Или ИмяСобытия = РегламентированнаяОтчетностьКлиент.ИмяСобытияЗавершениеОтправкиВКонтролирующийОрган()
		ИЛИ ИмяСобытия = РегламентированнаяОтчетностьКлиент.ИмяСобытияЗавершениеОтправки()  Тогда
		
		ЗаполнитьДеревоНовое();
		ОбновитьКнопкуНовыеСообщения();
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.СвернутьНезначимоеНовое(ЭтотОбъект);
	
	ИначеЕсли ИмяСобытия = "Закрыть форму новых сообщений 1С-Отчетности" И Источник <> ЭтаФорма
		И ЭтоАвтообмен Тогда
		
		ОтключитьОбработчикОжидания("ИнициализацияКонтекстЭДО");
		Если Открыта() Тогда
			Закрыть();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ЗаполнитьНеобходимоРасшифровать" Тогда
		Если Параметр.Статус <> Неопределено И Параметр.Статус = "Выполнено" Тогда
			НеобходимоРасшифровать = ПолучитьИзВременногоХранилища(Параметр.АдресРезультата);
			ЗаполнитьНеобходимоРасшифровать(НеобходимоРасшифровать);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаУведомленияПолученияСообщения(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЗаполнитьНеобходимоРасшифроватьВФоне();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Оповещение в форму 1С-Отчетности для того, чтобы вместо формы новых открыть закладку Новые.
	Оповестить("Получены новые сообщения 1С-Отчетности", АдресСведенийПоОшибкам, ЭтаФорма);
	
	ИщемФорму = ?(ЭтоРежимОблачной1СО
		И ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.Облачная1СОИспользоватьФормуНовыхСобытий(),
		"Форма.ФормаНовыхСобытий", "ОбщаяФорма.РегламентированнаяОтчетность");
	Если ЭтоАвтообмен
		И ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ФормаОткрыта(ИщемФорму) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	#Если НЕ ВебКлиент Тогда
		Если НовыеСобытияПоСтраницамЖурнала Тогда
			СистемнаяИнформация = Новый СистемнаяИнформация;
			Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии("8.3.26.0", СистемнаяИнформация.ВерсияПриложения) <= 0 Тогда
				ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаУведомленияПолученияСообщения", ЭтотОбъект);
				Выполнить("УведомленияКлиента.ПодключитьОбработчик(""ДокументооборотСКО_ПолученыСообщения"", ОписаниеОповещения)");
				Выполнить("УведомленияКлиента.ПодключитьОбработчик(""ЭлектронныйДокументооборотСФСС_ПолученыСообщенияСЭДО"", ОписаниеОповещения)");
			КонецЕсли;
		КонецЕсли;
	#КонецЕсли
	
	ОбновитьКнопкуНовыеСообщения();
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.СвернутьНезначимоеНовое(ЭтотОбъект);
	
	Если НовыеСобытияПоСтраницамЖурнала Тогда
		// переход на первый элемент с данными и раскрыть его
		ПерейтиНаБлокНовогоИРаскрыть();
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИнициализацияКонтекстЭДОЗавершение", ЭтотОбъект);
	ДокументооборотСКОКлиент.ПолучитьКонтекстЭДО(ОписаниеОповещения);
	
