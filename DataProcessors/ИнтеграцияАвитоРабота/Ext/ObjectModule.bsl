// Параметры:
//  Дерево - ДеревоЗначений
// 
// Возвращаемое значение:
//  Структура: см. РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией
Функция ОпубликоватьВакансию(Дерево) Экспорт
	
	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();
	
	JSONОписаниеВакансии = JSONОписаниеВакансии(Дерево);
	
	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;
	
	Запрос = НовыйHTTPЗапрос("job/v2/vacancies");
	Запрос.УстановитьТелоИзСтроки(JSONОписаниеВакансии, , ИспользованиеByteOrderMark.НеИспользовать);
	
	РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().ОтправитьДляОбработки, Запрос);
	
	Если РезультатЗапроса.КодСостояния = 202 Тогда
		Опубликовано = Ложь;
		ИдентификаторПубликации = ЗначениеСвойстваУзла(ПрочитатьОтветПубликацияВакансии(РезультатЗапроса), "id");
		
		Пока Не Опубликовано Цикл
			Запрос = НовыйHTTPЗапрос("job/v2/vacancies/statuses");
			Запрос.УстановитьТелоИзСтроки(
				РекрутинговыеСайтыСлужебный.ЗаписьJSON(
					Новый Структура("ids", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторПубликации))) , ,
				ИспользованиеByteOrderMark.НеИспользовать);
				
			РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().ОтправитьДляОбработки, Запрос);
			
			Если РезультатЗапроса.КодСостояния = 200 Тогда
				ДанныеПубликации = ПрочитатьОтветСтатусПубликацииВакансии(РезультатЗапроса);
				
				Если ЗначениеСвойстваУзла(ДанныеПубликации, "last_action", "status") = "success" Тогда
					Опубликовано = Истина;
					Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией(
						ЗначениеСвойстваУзла(ДанныеПубликации, "vacancy", "id"));
				ИначеЕсли ЗначениеСвойстваУзла(ДанныеПубликации, "last_action", "status") = "error" Тогда
					Опубликовано = Истина;
					Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
				КонецЕсли;
			Иначе
				Опубликовано = Истина;
				Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Дерево - ДеревоЗначений
//  Вакансия - СправочникСсылка.Вакансии
//  ИдентификаторВакансии - Строка
// 
// Возвращаемое значение:
//  Структура: см. РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией
Функция ПовторноОпубликоватьВакансию(Дерево, Вакансия, ИдентификаторВакансии) Экспорт
	
	Результат = РеактивироватьВакансию(ИдентификаторВакансии, Дерево);
	
	Если Не Результат.Успешно Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ОбновитьПубликациюВакансии(Дерево, ИдентификаторВакансии);
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Дерево - ДеревоЗначений
//  Вакансия - СправочникСсылка.Вакансии
//  ИдентификаторВакансии - Строка
// 
// Возвращаемое значение:
//  Структура - см. РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией
Функция ОбновитьПубликациюВакансии(Дерево, ИдентификаторВакансии) Экспорт
	
	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();
	
	JSONОписаниеВакансии = JSONОписаниеВакансии(Дерево, Истина);
	
	Если Не ЗначениеЗаполнено(JSONОписаниеВакансии) Или Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойОбновленияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;
	
	ДанныеПубликации = ОписаниеПубликацииВакансии(ИдентификаторВакансии, Ложь);
	
	Запрос = НовыйHTTPЗапрос(СтрШаблон("job/v2/vacancies/update/%1", ЗначениеСвойстваУзла(ДанныеПубликации, "uuid")));
	Запрос.УстановитьТелоИзСтроки(JSONОписаниеВакансии);
	
	РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().ОтправитьДляОбработки, Запрос);
	
	Если РезультатЗапроса.КодСостояния = 202 Тогда
		Успешно = Ложь;
		ИдентификаторПубликации = ЗначениеСвойстваУзла(ПрочитатьОтветПубликацияВакансии(РезультатЗапроса), "id");
		
		Пока Не Успешно Цикл
			Запрос = НовыйHTTPЗапрос("job/v2/vacancies/statuses");
			Запрос.УстановитьТелоИзСтроки(
				РекрутинговыеСайтыСлужебный.ЗаписьJSON(
					Новый Структура("ids", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторПубликации))) , ,
				ИспользованиеByteOrderMark.НеИспользовать);
				
			РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().ОтправитьДляОбработки, Запрос);
			
			Если РезультатЗапроса.КодСостояния = 200 Тогда
				ДанныеПубликации = ПрочитатьОтветСтатусПубликацииВакансии(РезультатЗапроса);
				
				Если ЗначениеСвойстваУзла(ДанныеПубликации, "last_action", "status") = "success" Тогда
					Успешно = Истина;
					Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией(
						ЗначениеСвойстваУзла(ДанныеПубликации, "vacancy", "id"));
				ИначеЕсли ЗначениеСвойстваУзла(ДанныеПубликации, "last_action", "status") = "error" Тогда
					Успешно = Истина;
					Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
				КонецЕсли;
			Иначе
				Успешно = Истина;
				Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойПубликацииВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойОбновленияВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ИдентификаторВакансии - Строка
// 
// Возвращаемое значение:
//  Структура: см. РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией
Функция СнятьПубликациюВакансии(ИдентификаторВакансии) Экспорт
	
	Результат = РекрутинговыеСайтыСлужебный.НовыйРезультатДействияСВакансией();
	
	Если Не УстановитьСоединение() Тогда
		Возврат РекрутинговыеСайтыСлужебный.РезультатСОшибкойСнятияВакансии(Сайт, ЭтотОбъект);
	КонецЕсли;
	
	Запрос = НовыйHTTPЗапрос(СтрШаблон("job/v1/vacancies/archived/%1", ИдентификаторВакансии));
	
	РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Записать, Запрос);
	
	Если РезультатЗапроса.КодСостояния <> 204 Тогда
		Результат = РекрутинговыеСайтыСлужебный.РезультатСОшибкойСнятияВакансии(Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ИдентификаторВакансии - Строка
// 
// Возвращаемое значение:
// - Неопределено
// - Структура: см. РекрутинговыеСайтыСлужебный.НовыеСвойстваПубликацииВакансии
Функция СвойстваПубликацииВакансииНаСайте(ИдентификаторВакансии) Экспорт
	
	СвойстваПубликации = РекрутинговыеСайтыСлужебный.НовыеСвойстваПубликацииВакансии();
	
	Если Не УстановитьСоединение() Тогда
		Возврат СвойстваПубликации;
	КонецЕсли;
	
	Описание = ОписаниеПубликацииВакансии(ИдентификаторВакансии, Ложь);
	Если ЗначениеЗаполнено(Описание) Тогда
		СвойстваПубликации.Опубликована = ЗначениеСвойстваУзла(Описание, "is_active");
		
		Если СвойстваПубликации.Опубликована Тогда
			СвойстваПубликации.ДатаПубликации = РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Описание, "start_time"));
			СвойстваПубликации.ДатаОбновления = РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Описание, "update_time"));
		Иначе
			Если ЗначениеЗаполнено(СвойстваПубликации.ДатаПубликации) Тогда
				СвойстваПубликации.ДатаСнятияСПубликации =
					Мин(ДобавитьМесяц(СвойстваПубликации.ДатаПубликации, 1), ТекущаяДатаСеанса());
			Иначе
				СвойстваПубликации.ДатаСнятияСПубликации = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СвойстваПубликации;
	
КонецФункции

Функция ЗначениеРеквизитаПубликацииПоУмолчанию(Вакансия, Реквизит) Экспорт
	
	Результат = Неопределено;
	
	Если Реквизит = "Наименование" Тогда
		ЗначениеСвойства = ЗначениеСвойстваУзла(Вакансия, "title");
		Результат = ?(ЗначениеЗаполнено(ЗначениеСвойства), ЗначениеСвойства, "");
	ИначеЕсли Реквизит = "ПредполагаемыйДоход" Тогда
		ЗначениеСвойства = ЗначениеСвойстваУзла(Вакансия, "params", "salary", "to");
		Результат = ?(ЗначениеЗаполнено(ЗначениеСвойства), ЗначениеСвойства, 0);
	ИначеЕсли Реквизит = "ДатаОткрытия" Тогда
		Результат = РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Вакансия, "start_time"));
	ИначеЕсли Реквизит = "ПланируемаяДатаЗакрытия" Тогда
		Результат = ДобавитьМесяц(РекрутинговыеСайтыСлужебный.ДатаПоСтроке(ЗначениеСвойстваУзла(Вакансия, "start_time")), 1);
	ИначеЕсли Реквизит = "Требования" Тогда
		Результат = РекрутинговыеСайтыСлужебный.ОписаниеТребованийОбязанностейУсловий(
			ЗначениеСвойстваУзла(Вакансия, "description")).Требования;
	ИначеЕсли Реквизит = "Обязанности" Тогда
		Результат = РекрутинговыеСайтыСлужебный.ОписаниеТребованийОбязанностейУсловий(
			ЗначениеСвойстваУзла(Вакансия, "description")).Обязанности;
	ИначеЕсли Реквизит = "Условия" Тогда
		Результат = РекрутинговыеСайтыСлужебный.ОписаниеТребованийОбязанностейУсловий(
			ЗначениеСвойстваУзла(Вакансия, "description")).Условия;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВакансииССайта(БылиОшибки = Ложь) Экспорт
	
	МассивВакансий = Новый Массив;
	
	Если Не УстановитьСоединение() Тогда
		БылиОшибки = Истина;
		Возврат МассивВакансий;
	КонецЕсли;
	
	Вакансии = Новый Массив();
	ПолучитьВсеСтраницыРесурса("core/v1/items?category=111", "resources", Вакансии);
	
	Для Каждого Вакансия Из Вакансии Цикл
		Описание = ОписаниеПубликацииВакансии(Формат(ЗначениеСвойстваУзла(Вакансия, "id"), "ЧГ=0"));
		Если ЗначениеЗаполнено(Описание) Тогда
			МассивВакансий.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивВакансий;
	
КонецФункции

// Параметры:
//  Вакансия - СправочникСсылка.Вакансии
Процедура ПолучитьОтклики(Вакансия) Экспорт
	
	ИдентификаторыВакансии = РекрутинговыеСайтыСлужебный.ИдентификаторыПубликацийВакансии(Вакансия, Сайт);
	
	Если Не ЗначениеЗаполнено(ИдентификаторыВакансии) Тогда
		РекрутинговыеСайтыСлужебный.СообщитьОбОтсутствииПубликации(Сайт);
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьПодключение().Подключен Тогда
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуПолученияОткликов(Сайт, Пользователь);
		Возврат;
	КонецЕсли;
	
	Если Не УстановитьСоединение() Тогда
		Возврат;
	КонецЕсли;
	
	ЗагруженныеОткликиВакансии = РекрутинговыеСайтыСлужебный.ЗагруженныеОткликиВакансии(Вакансия);
	Отклики = РекрутинговыеСайтыСлужебный.НоваяТаблицаОткликов();
	Для Каждого ИдентификаторВакансии Из ИдентификаторыВакансии Цикл
		ОткликиССайта = ОткликиССайта(ИдентификаторВакансии);
		
		Для Каждого Отклик Из ОткликиССайта Цикл
			ИдентификаторРезюме = ЗначениеСвойстваУзла(Отклик, "applicant", "resume_id");
			ЕстьРезюме = ЗначениеЗаполнено(ИдентификаторРезюме);
			
			Если Не ЕстьРезюме Тогда
				ИдентификаторРезюме = СтрШаблон("%1/profile/messenger/channel/%2",
					ДанныеСайта.ГлавнаяСтраница, ЗначениеСвойстваУзла(Отклик, "contacts", "chat", "value"));
			КонецЕсли;
			
			Если Не ЗагруженныеОткликиВакансии.Найти(ИдентификаторРезюме) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(
				ЗначениеСвойстваУзла(Отклик, "applicant", "data", "name"));
			
			НоваяЗапись = Отклики.Добавить();
			НоваяЗапись.Источник = Сайт;
			НоваяЗапись.Вакансия = Вакансия;
			НоваяЗапись.Имя = СтруктураФИО.Имя;
			НоваяЗапись.Фамилия = СтруктураФИО.Фамилия;
			НоваяЗапись.Отчество = СтруктураФИО.Отчество;
			НоваяЗапись.ДатаОтклика = РекрутинговыеСайтыСлужебный.ДатаПоСтроке(
				ЗначениеСвойстваУзла(Отклик, "created_at"));
			НоваяЗапись.ДатаРождения = РекрутинговыеСайтыСлужебный.ДатаПоСтроке(
				ЗначениеСвойстваУзла(Отклик, "applicant", "data", "birthday"));
			НоваяЗапись.ИдентификаторРезюме = ИдентификаторРезюме;
			
			Телефоны = ЗначениеСвойстваУзла(Отклик, "contacts", "phones");
			Если ЗначениеЗаполнено(Телефоны) Тогда
				Для Каждого Телефон Из Телефоны Цикл
					НоваяЗапись.Телефон = ЗначениеСвойстваУзла(Телефон, "value");
				КонецЦикла;
			КонецЕсли;
			
			Если ЕстьРезюме Тогда
				НоваяЗапись.АдресРезюме = СтрШаблон("%1/%2", ДанныеСайта.ГлавнаяСтраница, ИдентификаторРезюме);
			Иначе
				НоваяЗапись.АдресРезюме = ИдентификаторРезюме;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	РекрутинговыеСайтыСлужебный.ЗаписатьОтклики(Отклики, Пользователь);
	
КонецПроцедуры

// Параметры:
//  Классификатор - Строка
//  Дерево - ДеревоЗначений
// 
// Возвращаемое значение:
//  Булево
Функция ЗаполнитьДеревоКлассификатора(Классификатор, Дерево) Экспорт
	
	Результат = Ложь;
	
	Если Классификатор = "areas_towns" Тогда
		Дерево = ДеревоРегионов();
		Результат = Истина;
	ИначеЕсли Классификатор = "location" Тогда
		Дерево = ДеревоРегионов(Истина);
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  АдресРезюме - Строка
// 
// Возвращаемое значение:
//  Структура: см. ПодборПерсоналаКлиентСервер.ДоступностьКонтактовВРезюме
Функция ДоступныеДляПолученияКонтакты(АдресРезюме) Экспорт
	
	ДоступностьКонтактов = ПодборПерсоналаКлиентСервер.ДоступностьКонтактовВРезюме();
	
	ИдентификаторРезюме = ИдентификаторРезюмеПоАдресу(АдресРезюме);
	
	СтруктураРезюме = СтруктураРезюмеССайта(ИдентификаторРезюме);
	
	ЗаполнитьДоступностьКонтактов(ДоступностьКонтактов, СтруктураРезюме);
	
	Возврат ДоступностьКонтактов;
	
КонецФункции

// Параметры:
//  АдресРезюме - Строка
// 
// Возвращаемое значение:
//  Структура: см. РекрутинговыеСайтыСлужебный.НовыеКонтактыРезюме
Функция КонтактыРезюме(АдресРезюме) Экспорт
	
	Результат = РекрутинговыеСайтыСлужебный.НовыеКонтактыРезюме();
	
	ИдентификаторРезюме = ИдентификаторРезюмеПоАдресу(АдресРезюме);
	
	Если Не УстановитьСоединение() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = НовыйHTTPЗапрос("job/v1/resumes/" + ИдентификаторРезюме + "/contacts");
	
	РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().Получить, Запрос);
	
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		ВызватьИсключение РекрутинговыеСайтыСлужебный.ТекстОшибки(
			НСтр("ru = 'Не удалось получить контакты резюме.'"), Сайт, ЭтотОбъект, РезультатЗапроса);
	КонецЕсли;
	
	Контакты = ПрочитатьОтветКонтактыРезюме(РезультатЗапроса);
	
	ЗаполнитьЗначенияСвойств(Результат, ФизическиеЛицаКлиентСервер.ЧастиИмени(ЗначениеСвойстваУзла(Контакты, "name")));
	
	Для Каждого Контакт Из ЗначениеСвойстваУзла(Контакты, "contacts") Цикл
		Если ЗначениеСвойстваУзла(Контакт, "type") = "e-mail" Тогда
			Результат.ЭлектроннаяПочта = ЗначениеСвойстваУзла(Контакт, "value");
		ИначеЕсли ЗначениеСвойстваУзла(Контакт, "type") = "phone" Тогда
			Результат.Телефон = ЗначениеСвойстваУзла(Контакт, "value");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УточнитьОписаниеОшибки(КодСостояния, ОписаниеОшибки) Экспорт
	
	УточненноеОписаниеОшибки = "";
	
	Если СтрНайти(ОписаниеОшибки, "Payment required") <> 0 Тогда
		УточненноеОписаниеОшибки = НСтр("ru = 'Требуется оплата.'");
	ИначеЕсли СтрНайти(ОписаниеОшибки, "invalid_grant") <> 0 Или
		СтрНайти(ОписаниеОшибки, "Missing scope") <> 0 Тогда
		УточненноеОписаниеОшибки = РекрутинговыеСайтыСлужебный.ОписаниеОшибкиАвторизации();
	ИначеЕсли СтрНайти(ОписаниеОшибки, "not_enough_purchased_services") <> 0 Тогда
		УточненноеОписаниеОшибки = РекрутинговыеСайтыСлужебный.ОписаниеНеоплаченныхУслуг();
	ИначеЕсли СтрНайти(ОписаниеОшибки, """code"":100") <> 0 Тогда
		УточненноеОписаниеОшибки = НСтр("ru = 'Проверьте корректность номера телефона.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(УточненноеОписаниеОшибки) Тогда
		ИменаПолей = Новый Соответствие();
		Для каждого Поле Из ПоляВакансии() Цикл
			ИменаПолей.Вставить(Поле.Путь, Поле.Описание);
		КонецЦикла;
		
		Если СтрНайти(ОписаниеОшибки, "errors") <> 0 Тогда
			Описание = ПарсерJSON(ОписаниеОшибки);
			Если ТипЗнч(Описание) = Тип("Структура") Тогда
				Для каждого Ошибка Из Описание.errors Цикл
					ТекстОшибки = Ошибка;
					ИмяПоля = Неопределено;
					Для каждого КлючИЗначение Из ИменаПолей Цикл
						Если СтрНайти(Ошибка, КлючИЗначение.Ключ) <> 0 Тогда
							ИмяПоля = КлючИЗначение.Ключ;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если ИмяПоля <> Неопределено Тогда
						ТекстОшибки = СтрЗаменить(ТекстОшибки, ИмяПоля, ИменаПолей[ИмяПоля]);
					КонецЕсли;
					
					УточненноеОписаниеОшибки = УточненноеОписаниеОшибки + Символы.ПС + ТекстОшибки;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли СтрНайти(ОписаниеОшибки, "error") <> 0 Тогда
			ИмяПоля = Неопределено;
			Для каждого КлючИЗначение Из ИменаПолей Цикл
				Если СтрНайти(ОписаниеОшибки, КлючИЗначение.Ключ) <> 0 Тогда
					ИмяПоля = КлючИЗначение.Ключ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ИмяПоля <> Неопределено Тогда
				ТекстОшибки = "Некорректно заполнено поле " + ИменаПолей[ИмяПоля];
			КонецЕсли;
			
			УточненноеОписаниеОшибки =
				УточненноеОписаниеОшибки + Символы.ПС + ТекстОшибки + Символы.ПС + ОписаниеОшибки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат УточненноеОписаниеОшибки;
	
КонецФункции

// Параметры:
//  ДанныеДляОтправки - См. РекрутинговыеСайтыСлужебный.ДанныеДляОтправкиОбратнойСвязи
// 
// Возвращаемое значение:
//  Булево - Отправка прошла успешно
Функция ОтправитьОбратнуюСвязьПоОтклику(ДанныеДляОтправки) Экспорт
	
	Результат = Ложь;
	
	ИдентификаторыВакансии = РекрутинговыеСайтыСлужебный.ИдентификаторыПубликацийВакансии(ДанныеДляОтправки.Вакансия, Сайт);
	
	Если Не ЗначениеЗаполнено(ИдентификаторыВакансии) Тогда
		ТекстОшибки = НСтр("ru = 'Вакансия не опубликована.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Если Не ПроверитьПодключение().Подключен Тогда
		ТекстОшибки = НСтр("ru = 'Не настроен доступ к сайту.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Если Не УстановитьСоединение() Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось установить соединение с сайтом.'");
		РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
			Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ИдентификаторВакансии Из ИдентификаторыВакансии Цикл
		ОткликиССайта = ОткликиССайта(ИдентификаторВакансии);
		
		Для Каждого Отклик Из ОткликиССайта Цикл
			ИдентификаторРезюме = ЗначениеСвойстваУзла(Отклик, "applicant", "resume_id");
			ЕстьРезюме = ЗначениеЗаполнено(ИдентификаторРезюме);
			
			Если Не ЕстьРезюме Тогда
				ИдентификаторРезюме = СтрШаблон("%1/profile/messenger/channel/%2",
					ДанныеСайта.ГлавнаяСтраница, ЗначениеСвойстваУзла(Отклик, "contacts", "chat", "value"));
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ИдентификаторРезюме) Или СтрНайти(ДанныеДляОтправки.АдресРезюме, ИдентификаторРезюме) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = НовыйHTTPЗапрос(
				СтрШаблон("/messenger/v1/accounts/%1/chats/%2/messages",
					ИдентификаторПользователя, ЗначениеСвойстваУзла(Отклик, "contacts", "chat", "value")));
			
			Тело = Новый Структура();
			Тело.Вставить("type", "text");
			Тело.Вставить("message", Новый Структура("text", ДанныеДляОтправки.Сообщение));
			
			Запрос.УстановитьТелоИзСтроки(РекрутинговыеСайтыСлужебный.ЗаписьJSON(Тело));
			
			РезультатЗапроса = ВыполнитьHTTPЗапрос(МетодыЗапросов().ОтправитьДляОбработки, Запрос);
			
			Если РезультатЗапроса.КодСостояния = 200 Тогда
				Результат = Истина;
				Прервать;
			Иначе
				ТекстОшибки = НСтр("ru = 'Не удалось отправить обратную связь.'");
				РекрутинговыеСайтыСлужебный.ЗаписатьОшибкуОтправкиОбратнойСвязи(
					Сайт, ЭтотОбъект, ДанныеДляОтправки.Кандидат, ТекстОшибки, РезультатЗапроса);
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УстановитьСоединение()
	
	Результат = Истина;
	
	Если Не ЗначениеЗаполнено(МаркерДоступа) Тогда
		Результат = Инициализировать();
	КонецЕсли;
	
	Если Соединение = Неопределено Тогда
		Соединение = РекрутинговыеСайтыСлужебный.НовоеHTTPСоединение(АдресСервера());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Инициализировать()
	
	РеквизитыСайта = РекрутинговыеСайтыСлужебный.РеквизитыСайта(Сайт, Пользователь);
	
	Если РеквизитыСайта = Неопределено Или Не ЗначениеЗаполнено(РеквизитыСайта.МаркерДоступа) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не настроена интеграция с %1.'"), АдресСайта());
	КонецЕсли; 
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыСайта);
	
	Возврат МаркерАктивен();
	
КонецФункции

Функция МетодыЗапросов()
	
	Возврат РекрутинговыеСайтыСлужебный.МетодыЗапросов();
	
КонецФункции

Функция ВыполнитьHTTPЗапрос(Метод, Запрос, ВызыватьИсключение = Истина) Экспорт
	
	Возврат РекрутинговыеСайтыСлужебный.ВыполнитьHTTPЗапрос(Соединение, Метод, Запрос, ВызыватьИсключение);
	
КонецФункции

// Параметры:
//  Обновление - Булево
//  Показыватьпредупреждение- Булево
// 
// Возвращаемое значение:
// Структура: см. РекрутинговыеСайтыСлужебный.НоваяСтруктураМаркеров
Функция СтруктураМаркеров(Обновление = Ложь, Показыватьпредупреждение = Истина)
	
	СтруктураМаркеров = РекрутинговыеСайтыСлужебный.НоваяСтруктураМаркеров();
	
	ИдентификаторПриложения = ЗарплатаКадрыРасширенный.ИдентификацияПриложенияДляАвитоРабота();
	Структура_token_uri = ОбщегоНазначенияКлиентСервер.СтруктураURI(ИдентификаторПриложения.token_uri);
	АдресАутентификации = Структура_token_uri.Хост;
	
	Если Обновление Тогда
		СтрокаЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					"%1?grant_type=refresh_token&client_id=%2&client_secret=%3&refresh_token=%4",
					Структура_token_uri.ПутьНаСервере,
					ИдентификаторПриложения.client_id,
					ИдентификаторПриложения.client_secret,
					МаркерОбновления);
	Иначе
		СтрокаЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					"%1?grant_type=authorization_code&client_id=%2&client_secret=%3&code=%4",
					Структура_token_uri.ПутьНаСервере,
					ИдентификаторПриложения.client_id,
					ИдентификаторПриложения.client_secret,
					КодАвторизации);
	КонецЕсли;

	СоединениеАутентификации = РекрутинговыеСайтыСлужебный.НовоеHTTPСоединение(АдресАутентификации, Истина);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("User-Agent", ЗарплатаКадры.ИмяКлиентскогоПриложения());
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, Заголовки);
	
	РезультатЗапроса = РекрутинговыеСайтыСлужебный.ВыполнитьHTTPЗапрос(
		СоединениеАутентификации, МетодыЗапросов().ОтправитьДляОбработки, Запрос);
	
	// Авито при ошибках возвращает 200
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		РекрутинговыеСайтыСлужебный.СообщитьОбОшибкеАвторизации(Сайт, ЭтотОбъект, РезультатЗапроса);
		Возврат СтруктураМаркеров;
	КонецЕсли;
	
	ОтветОбъект = ПрочитатьОтветМаркерыДоступа(РезультатЗапроса);
	
	Если ОтветОбъект.Свойство("error") Тогда
		Если Показыватьпредупреждение Тогда
			РекрутинговыеСайтыСлужебный.СообщитьОбОшибкеАвторизации(Сайт, ЭтотОбъект, РезультатЗапроса);
		КонецЕсли;
		
		Возврат СтруктураМаркеров;
	КонецЕсли;
	
	СтруктураМаркеров.МаркерДоступа = ОтветОбъект.access_token;
	СтруктураМаркеров.МаркерОбновления = ОтветОбъект.refresh_token;
	СтруктураМаркеров.ДатаОкончанияДействияМаркераДоступа = ТекущаяДатаСеанса() + ОтветОбъект.expires_in;
	
	МаркерДоступа = СтруктураМаркеров.МаркерДоступа;
	МаркерОбновления = СтруктураМаркеров.МаркерОбновления;
	ДатаОкончанияДействияМаркераДоступа = СтруктураМаркеров.ДатаОкончанияДействияМаркераДоступа;
	
	Возврат СтруктураМаркеров;
	
КонецФункции

Функция МаркерАктивен(Показыватьпредупреждение = Истина)
	
	МаркерДействителен = ЗначениеЗаполнено(МаркерДоступа) 
			И ДатаОкончанияДействияМаркераДоступа > ТекущаяДатаСеанса();
		
	МаркерАктивен = Ложь;
		
	Если МаркерДействителен Тогда
		МаркерАктивен = СайтДоступен(Показыватьпредупреждение);
	КонецЕсли;
		
	Если Не МаркерАктивен И ЗначениеЗаполнено(МаркерОбновления) Тогда
		РезультатОбновления = ОбновитьМаркеры(Показыватьпредупреждение);
		Если ЗначениеЗаполнено(РезультатОбновления.МаркерДоступа) Тогда
			МаркерАктивен = Истина;
			РезультатОбновления.Пользователь = Пользователь;
			РекрутинговыеСайтыСлужебный.СохранитьНастройкиАвторизацииСОдинаковымИдентификатором(РезультатОбновления);
		КонецЕсли;
	КонецЕсли;
	
	Возврат МаркерАктивен;
	
КонецФункции

Функция СайтДоступен(Показыватьпредупреждение = Истина)
	
	Возврат ЗначениеЗаполнено(ИнформацияОПользователе(Показыватьпредупреждение).ИмяПользователя);
	
КонецФункции

Функция ОбновитьМаркеры(Показыватьпредупреждение = Истина)
	
	Результат = РекрутинговыеСайтыСлужебный.НовыеРеквизитыСайта();
	Результат.Сайт = Сайт;
	Результат.Пользователь = Пользователь;
	
	СтруктураМаркеров = СтруктураМаркеров(Истина, Показыватьпредупреждение);
	
	Если ЗначениеЗаполнено(СтруктураМаркеров.МаркерДоступа) Тогда
		Результат.Подключен = Истина;
		
		ИнформацияОПользователе= ИнформацияОПользователе();
		
		Результат.МаркерДоступа = СтруктураМаркеров.МаркерДоступа;
		Результат.МаркерОбновления = СтруктураМаркеров.МаркерОбновления;
		Результат.ДатаОкончанияДействияМаркераДоступа = СтруктураМаркеров.ДатаОкончанияДействияМаркераДоступа;
		
		Результат.ИмяПользователя = ИнформацияОПользователе.ИмяПользователя;
		Результат.ИдентификаторПользователя = ИнформацияОПользователе.ИдентификаторПользователя;
		Результат.КодАвторизации = КодАвторизации;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйHTTPЗапрос(ТекстЗапроса)
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("User-Agent", ЗарплатаКадры.ИмяКлиентскогоПриложения());
	Заголовки.Вставить("Content-Type", "application/json");
	
	Если ЗначениеЗаполнено(МаркерДоступа) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + МаркерДоступа);
	КонецЕсли;
	
	Запрос = Новый HTTPЗапрос(ТекстЗапроса, Заголовки);
	
	Возврат Запрос;
	
КонецФункции

