	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ЖурналДокументовДокументыНаграждения.Ссылка КАК Ссылка,
	ЖурналДокументовДокументыНаграждения.Дата КАК Дата,
	ЖурналДокументовДокументыНаграждения.ПометкаУдаления КАК ПометкаУдаления,
	ЖурналДокументовДокументыНаграждения.Номер КАК Номер,
	ЖурналДокументовДокументыНаграждения.Проведен КАК Проведен,
	ЖурналДокументовДокументыНаграждения.Организация КАК Организация,
	ЖурналДокументовДокументыНаграждения.Претендент КАК Претендент,
	ЖурналДокументовДокументыНаграждения.Ответственный КАК Ответственный,
	ЖурналДокументовДокументыНаграждения.Комментарий КАК Комментарий,
	ЖурналДокументовДокументыНаграждения.Тип КАК Тип,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы
ИЗ
	ЖурналДокументов.ДокументыНаграждения КАК ЖурналДокументовДокументыНаграждения
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО ЖурналДокументовДокументыНаграждения.Ссылка = НаличиеФайлов.ОбъектСФайлами
{ГДЕ
	(ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА
			ИЗ
				РегистрСведений.СоставДокументовЗарплатаКадры КАК СоставДокументовЗарплатаКадры
			ГДЕ
				СоставДокументовЗарплатаКадры.ФизическоеЛицо = &amp;ФизическоеЛицо
				И ЖурналДокументовДокументыНаграждения.Ссылка = СоставДокументовЗарплатаКадры.ДокументФизическогоЛица)),
	(ЖурналДокументовДокументыНаграждения.Ссылка В
			(ВЫБРАТЬ
				НаграждениеПретендентыКНаграждению.Ссылка КАК Ссылка
			ИЗ
				Документ.Награждение.ПретендентыКНаграждению КАК НаграждениеПретендентыКНаграждению
			ГДЕ
				НаграждениеПретендентыКНаграждению.Претендент = &amp;Сотрудник
		
			ОБЪЕДИНИТЬ ВСЕ
		
			ВЫБРАТЬ
				ПредставлениеКНаградеПретендентыКНаграждению.Ссылка
			ИЗ
				Документ.ПредставлениеКНаграде.ПретендентыКНаграждению КАК ПредставлениеКНаградеПретендентыКНаграждению
			ГДЕ
				ПредставлениеКНаградеПретендентыКНаграждению.Претендент = &amp;Сотрудник)),
	(ЖурналДокументовДокументыНаграждения.Ссылка В
			(ВЫБРАТЬ
				НаграждениеПретендентыКНаграждению.Ссылка КАК Ссылка
			ИЗ
				Документ.Награждение.ПретендентыКНаграждению КАК НаграждениеПретендентыКНаграждению
			ГДЕ
				НаграждениеПретендентыКНаграждению.Награда = &amp;Награда
		
			ОБЪЕДИНИТЬ ВСЕ
		
			ВЫБРАТЬ
				ПредставлениеКНаградеПретендентыКНаграждению.Ссылка
			ИЗ
				Документ.ПредставлениеКНаграде.ПретендентыКНаграждению КАК ПредставлениеКНаградеПретендентыКНаграждению
			ГДЕ
				ПредставлениеКНаградеПретендентыКНаграждению.Награда = &amp;Награда)),
	(ЖурналДокументовДокументыНаграждения.Ссылка В
			(ВЫБРАТЬ
				НаграждениеПретендентыКНаграждению.Ссылка КАК Ссылка
			ИЗ
				Документ.Награждение.ПретендентыКНаграждению КАК НаграждениеПретендентыКНаграждению
			ГДЕ
				ВЫРАЗИТЬ(НаграждениеПретендентыКНаграждению.Награда КАК Справочник.Награды).КатегорияНаграды = &amp;КатегорияНаграды
		
			ОБЪЕДИНИТЬ ВСЕ
		
			ВЫБРАТЬ
				ПредставлениеКНаградеПретендентыКНаграждению.Ссылка
			ИЗ
				Документ.ПредставлениеКНаграде.ПретендентыКНаграждению КАК ПредставлениеКНаградеПретендентыКНаграждению
			ГДЕ
				ВЫРАЗИТЬ(ПредставлениеКНаградеПретендентыКНаграждению.Награда КАК Справочник.Награды).КатегорияНаграды = &amp;КатегорияНаграды))}</QueryText>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Организация</dcssch:dataPath>
					<dcssch:field>Организация</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Ссылка</dcssch:dataPath>
					<dcssch:field>Ссылка</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Проведен</dcssch:dataPath>
					<dcssch:field>Проведен</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Дата</dcssch:dataPath>
					<dcssch:field>Дата</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Комментарий</dcssch:dataPath>
					<dcssch:field>Комментарий</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Ответственный</dcssch:dataPath>
					<dcssch:field>Ответственный</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ПометкаУдаления</dcssch:dataPath>
					<dcssch:field>ПометкаУдаления</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Претендент</dcssch:dataPath>
					<dcssch:field>Претендент</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Номер</dcssch:dataPath>
					<dcssch:field>Номер</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Тип</dcssch:dataPath>
					<dcssch:field>Тип</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ЕстьФайлы</dcssch:dataPath>
					<dcssch:field>ЕстьФайлы</dcssch:field>
					<dcssch:title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Есть файлы</v8:content>
						</v8:item>
					</dcssch:title>
				</Field>
				<Parameter>
					<dcssch:name>ФизическоеЛицо</dcssch:name>
					<dcssch:title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Физическое лицо</v8:content>
						</v8:item>
					</dcssch:title>
					<dcssch:valueType>
