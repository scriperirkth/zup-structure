
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Наименование КАК Задача,
	|	ЗадачаПоОбработкеДокумента.ОписаниеОшибки КАК ОписаниеОшибки
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Ссылка В(&Ссылка)
	|	И ЗадачаПоОбработкеДокумента.НеВыполненаИзЗаОшибки";
	Запрос.УстановитьПараметр("Ссылка", Параметры.Задачи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДатаПопытки = "";
		ОписаниеОшибки = Выборка.ОписаниеОшибки;
		ПозицияПС = СтрНайти(Выборка.ОписаниеОшибки, Символы.ПС);
		Если ПозицияПС > 0 Тогда
			ДатаПопыткиСтрокой = Лев(Выборка.ОписаниеОшибки, ПозицияПС - 1);
			Попытка
				ДатаПопытки = Дата(ДатаПопыткиСтрокой);
				ОписаниеОшибки = Сред(Выборка.ОписаниеОшибки, ПозицияПС + 1);
			Исключение
				// обработка исключения не требуется
			КонецПопытки;
		КонецЕсли;
		НоваяСтрока = ТаблицаОшибок.Добавить();
		НоваяСтрока.Задача = Выборка.Задача;
		НоваяСтрока.ДатаПопытки = ДатаПопытки;
		НоваяСтрока.ОписаниеОшибки = ОписаниеОшибки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОшибокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ТаблицаОшибокОписаниеОшибки" Тогда
		ПоказатьЗначение(, Элемент.ТекущиеДанные.ОписаниеОшибки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
