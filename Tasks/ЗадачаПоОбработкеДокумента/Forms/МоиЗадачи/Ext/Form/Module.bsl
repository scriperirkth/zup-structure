&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ПроцессыОбработкиДокументов.УстановитьОформлениеЗадач(Список);
	
КонецПроцедуры

&НаКлиенте
Процедура СгруппироватьПоКолонке(Знач ИмяКолонкиРеквизита)
	
	Для Каждого ЭлементНастроек Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастроек) = Тип("СтруктураНастроекКомпоновкиДанных") И ЭлементНастроек.Структура.Количество() > 0 Тогда
			ТекстВопроса = НСтр("ru = 'Пользовательская настройки группировки будет удалена. Продолжить?'");
			Обработчик = Новый ОписаниеОповещения("ПродолжитьГруппировкуПоКолонкеПослеВопроса", ЭтотОбъект, ИмяКолонкиРеквизита);
			ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ПродолжитьГруппировкуПоКолонке(ИмяКолонкиРеквизита);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьГруппировкуПоКолонкеПослеВопроса(Результат, ИмяКолонкиРеквизита) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементНастроек Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастроек) = Тип("СтруктураНастроекКомпоновкиДанных") Тогда
			ЭлементНастроек.Структура.Очистить();
		КонецЕсли;
	КонецЦикла;
	
	ПродолжитьГруппировкуПоКолонке(ИмяКолонкиРеквизита);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьГруппировкуПоКолонке(ИмяКолонкиРеквизита)
	
	РежимГруппировки = ИмяКолонкиРеквизита;
	Список.Группировка.Элементы.Очистить();
	Если НЕ ПустаяСтрока(ИмяКолонкиРеквизита) Тогда
		ПолеГруппировки = Список.Группировка.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонкиРеквизита);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СгруппироватьПоКолонкеНаСервере(Знач ИмяКолонкиРеквизита)
	РежимГруппировки = ИмяКолонкиРеквизита;
	Список.Группировка.Элементы.Очистить();
	Если НЕ ПустаяСтрока(ИмяКолонкиРеквизита) Тогда
		ПолеГруппировки = Список.Группировка.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонкиРеквизита);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЗадачНаСервере()
	
	ПриОбновленииСпискаЗадач();
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ПриОбновленииСпискаЗадач()
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ТекущаяДата", ТекущаяДатаСеанса());
	
	ПроцессыОбработкиДокументов.ПроверитьСостояниеВыполняемыхЗадач();
	
	УправлениеВидимостьюОбщихКоманд();
	
	АктивныеФоновыеЗаданияПользователя = Новый ФиксированноеСоответствие(
		ПроцессыОбработкиДокументов.ИдентификаторыАктивныхФоновыхЗаданий());
	
	ПерезаполнитьКнопкиСКомандамиРезультатовВыполнения();
	
	ПроцессыОбработкиДокументов.ЗаполнитьСлужебныеТаблицы(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтбор(ПараметрыОтбора)
	
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Выполнена");
	Если НЕ ПараметрыОтбора["ПоказыватьВыполненные"] Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список, "Выполнена", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьКнопкиСКомандамиРезультатовВыполнения()
	ПроцессыОбработкиДокументов.УдалитьКнопкиСКомандамиРезультатовВыполнения(ЭтотОбъект);
	ПроцессыОбработкиДокументов.СоздатьКнопкиСКомандамиРезультатовВыполнения(ЭтотОбъект, "Этапы");
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюКомандПринятияКИсполнению(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		ДоступностьПринятьКИсполнению = Ложь;
		ДоступностьОтменитьПринятиеКИсполнению = Ложь;
	ИначеЕсли НЕ ТекущиеДанные.Свойство("ПринятаКИсполнению") Тогда
		ДоступностьПринятьКИсполнению = Ложь;
		ДоступностьОтменитьПринятиеКИсполнению = Ложь;
	ИначеЕсли ТекущиеДанные.Свойство("Выполнена")
		И ТекущиеДанные.Выполнена Тогда
		ДоступностьПринятьКИсполнению = Ложь;
		ДоступностьОтменитьПринятиеКИсполнению = Ложь;
	ИначеЕсли НЕ ТекущиеДанные.ПринятаКИсполнению Тогда
		ДоступностьПринятьКИсполнению = Истина;
		ДоступностьОтменитьПринятиеКИсполнению = Ложь;
	ИначеЕсли ТекущиеДанные.Свойство("ИсполнительНазначенПринудительно")
		И ТекущиеДанные.ИсполнительНазначенПринудительно Тогда
		ДоступностьПринятьКИсполнению = Ложь;
		ДоступностьОтменитьПринятиеКИсполнению = Ложь;
	Иначе
		ДоступностьПринятьКИсполнению = Ложь;
		ДоступностьОтменитьПринятиеКИсполнению = Истина;
	КонецЕсли;
	
	Элементы.ПринятьКИсполнению.Доступность = ДоступностьПринятьКИсполнению;
	Элементы.СписокКонтекстноеМенюПринятьКИсполнению.Доступность = ДоступностьПринятьКИсполнению;
	Элементы.ОтменитьПринятиеКИсполнению.Доступность = ДоступностьОтменитьПринятиеКИсполнению;
	Элементы.СписокКонтекстноеМенюОтменитьПринятиеКИсполнению.Доступность = ДоступностьОтменитьПринятиеКИсполнению;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюКомандВернутьНаРольИсполнителя(ТекущиеДанные)
	
	Если ТекущиеДанные <> Неопределено
		И ТекущиеДанные.Свойство("ПринятаКИсполнению")
		И ТекущиеДанные.Свойство("Исполнитель")
		И ТекущиеДанные.Свойство("РольИсполнителя")
		И НЕ ТекущиеДанные.ПринятаКИсполнению
		И ЗначениеЗаполнено(ТекущиеДанные.Исполнитель)
		И ЗначениеЗаполнено(ТекущиеДанные.РольИсполнителя) Тогда
		Элементы.СписокКонтекстноеМенюВернутьНаРольИсполнителя.Доступность = Истина;
	Иначе
		Элементы.СписокКонтекстноеМенюВернутьНаРольИсполнителя.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюКомандОтменитьВыполнение(ТекущиеДанные)
	
	Если ТекущиеДанные <> Неопределено
		И ТекущиеДанные.Свойство("Выполнена")
		И ТекущиеДанные.Свойство("Прервана")
		И ТекущиеДанные.Выполнена
		И НЕ ТекущиеДанные.Прервана Тогда
		Элементы.ОтменитьВыполнение.Доступность = Истина;
		Элементы.СписокКонтекстноеМенюОтменитьВыполнение.Доступность = Истина;
	Иначе
		Элементы.ОтменитьВыполнение.Доступность = Ложь;
		Элементы.СписокКонтекстноеМенюОтменитьВыполнение.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюКомандИнформацияОбОшибке(ТекущиеДанные)
	
	Если ТекущиеДанные <> Неопределено
		И ТекущиеДанные.Свойство("НеВыполненаИзЗаОшибки")
		И ТекущиеДанные.НеВыполненаИзЗаОшибки Тогда
		Элементы.ИнформацияОбОшибке.Доступность = Истина;
		Элементы.СписокКонтекстноеМенюИнформацияОбОшибке.Доступность = Истина;
	Иначе
		Элементы.ИнформацияОбОшибке.Доступность = Ложь;
		Элементы.СписокКонтекстноеМенюИнформацияОбОшибке.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюКомандПрерватьВыполнение(ТекущиеДанные)
	
	Если ТекущиеДанные <> Неопределено
		И ТекущиеДанные.Свойство("ИдентификаторПачкиЗадач")
		И АктивныеФоновыеЗаданияПользователя.Получить(Строка(ТекущиеДанные.ИдентификаторПачкиЗадач)) <> Неопределено Тогда
		Элементы.ПрерватьВыполнение.Доступность = Истина;
		Элементы.СписокКонтекстноеМенюПрерватьВыполнение.Доступность = Истина;
	Иначе
		Элементы.ПрерватьВыполнение.Доступность = Ложь;
		Элементы.СписокКонтекстноеМенюПрерватьВыполнение.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеДоступностьюЭлементовПриВыполненииВФоне(ЗапущеноФоновоеЗадание)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОсновнаяКоманднаяПанель", "Доступность", НЕ ЗапущеноФоновоеЗадание);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Список", "Доступность", НЕ ЗапущеноФоновоеЗадание);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииВыполненияЗадач(ДосрочноеЗавершение = Ложь)
	
	УправлениеДоступностьюЭлементовПриВыполненииВФоне(Ложь);
	
	Элементы.СтраницыЭтапыДО.ТекущаяСтраница = Элементы.Этапы;
	
	ИдентификаторЗадания = Неопределено;
	СостояниеДлительнойОперации = "";
	
	Если ДосрочноеЗавершение Тогда
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ИдентификаторПачки);
		ОбновитьСписокЗадачНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеДлительнойОперации(ИдентификаторЗадания)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюОбщихКоманд()
	
	Информация = ПроцессыОбработкиДокументов.ИнформацияОПереданныхПравахИсполнителю(Пользователи.ТекущийПользователь());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЗадачиСПереданнымиПравами", "Видимость", Информация.ИсполнителюПереданыПрава);
	
	ЗаголовокКнопки = НСтр("ru = 'Задачи с переданными правами'");
	Если Информация.КоличествоНевыполненныхЗадач > 0 Тогда
		ЗаголовокКнопки = ЗаголовокКнопки + " (" + Строка(Информация.КоличествоНевыполненныхЗадач) + ")";
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЗадачиСПереданнымиПравами", "Заголовок", ЗаголовокКнопки);
	
КонецПроцедуры

#КонецОбласти
