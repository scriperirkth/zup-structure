
#Область ОписаниеПеременных

&НаКлиенте
Перем ИдентификаторЗадания, ЗакрытиеПослеОтветаНаВопрос;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	УстановитьОтбор(Новый Структура("ПоказыватьВыполненные", ПоказыватьВыполненные));
	
	НеЗаполнятьКомментарийПриОтрицательномРезультате = ЗначениеКонстанты_НеЗаполнятьКомментарийПриОтрицательномРезультате();
	ПроверятьИмеющиесяЭППриОчередномПодписании = ЗначениеКонстанты_ПроверятьИмеющиесяЭППриОчередномПодписании();
	ПроверятьПодписанныеДанныеПриОчередномПодписании = ЗначениеКонстанты_ПроверятьПодписанныеДанныеПриОчередномПодписании();
	ПроверятьНаличиеКлючаПЭПВРеестре = ЗначениеКонстанты_ПроверятьНаличиеКлючаПЭПВРеестре();
	ИспользоватьМногопоточнуюПроверку = ЗначениеКонстанты_ИспользоватьПроверкуПодписываемыхДанныхЧерезХэш();
	
	ПриОбновленииСпискаЗадач();
	
	Элементы.СтраницыЭтапыДО.ТекущаяСтраница = Элементы.Этапы; 
	
	Список.Параметры.УстановитьЗначениеПараметра("Исполнитель", Пользователи.АвторизованныйПользователь());
	
	// Установка отбора динамического списка.
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "ПометкаУдаления", Ложь, ВидСравненияКомпоновкиДанных.Равно, , ,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный);
	
	ПроцессыОбработкиДокументов.УстановитьОграничениеИспользованияПоляДинамическогоСписка(
		Список, "ТипДокумента", , Истина);
	ПроцессыОбработкиДокументов.УстановитьОграничениеИспользованияПоляДинамическогоСписка(
		Список, "Предмет", , , Истина, Истина);
	ПроцессыОбработкиДокументов.УстановитьОграничениеИспользованияПоляДинамическогоСписка(
		Список, "Ссылка.Предмет", Истина, Истина, Истина, Истина, Истина, Истина, Истина, Истина);
	ПроцессыОбработкиДокументов.УстановитьОграничениеИспользованияПоляДинамическогоСписка(
		Список, "ИдентификаторПачкиЗадач", , Истина, Истина, Истина);
	
	ПроцессыОбработкиДокументов.ДобавитьДополнительныеКолонкиСпискаЗадач(ЭтотОбъект, "Список");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ИдентификаторЗадания = Неопределено
		ИЛИ ЗакрытиеПослеОтветаНаВопрос = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru='Задачи по обработке документов еще выполняются. При завершении работы их выполнение будет продолжено в фоновом режиме.'");
		Возврат;
	КонецЕсли;
	
	ЗакрытиеПослеОтветаНаВопрос = Неопределено;
	
	ПараметрыОповещения = Новый Структура("ЗакрытьФорму", Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьОперациюПослеОтветаНаВопрос", ЭтотОбъект, ПараметрыОповещения);
	
	ТекстВопроса = НСтр("ru = 'Задачи еще выполняются. Прервать их выполнение при закрытии формы?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	СгруппироватьПоКолонкеНаСервере(Настройки["РежимГруппировки"]);
	УстановитьОтбор(Настройки);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Запись_ЗадачаПоОбработкеДокумента"
		ИЛИ ИмяСобытия = "Запись_ШаблонПроцесса" Тогда
		ОбновитьСписокЗадачНаСервере();
	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант"
		И Источник = "НеЗаполнятьКомментарийПриОтрицательномРезультате" Тогда
		НеЗаполнятьКомментарийПриОтрицательномРезультате = ЗначениеКонстанты_НеЗаполнятьКомментарийПриОтрицательномРезультате();
	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант"
		И Источник = "ПроверятьИмеющиесяЭППриОчередномПодписании" Тогда
		ПроверятьИмеющиесяЭППриОчередномПодписании = ЗначениеКонстанты_ПроверятьИмеющиесяЭППриОчередномПодписании();
	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант"
		И Источник = "ПроверятьПодписанныеДанныеПриОчередномПодписании" Тогда
		ПроверятьПодписанныеДанныеПриОчередномПодписании = ЗначениеКонстанты_ПроверятьПодписанныеДанныеПриОчередномПодписании();
	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант"
		И Источник = "ПроверятьНаличиеКлючаПЭПВРеестре" Тогда
		ПроверятьНаличиеКлючаПЭПВРеестре = ЗначениеКонстанты_ПроверятьНаличиеКлючаПЭПВРеестре();
	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант"
		И (Источник = "ИспользоватьЭППриВыполненииЭтапов"
			ИЛИ Источник = "ИспользоватьПростыеЭППриВыполненииЭтапов") Тогда
		ПерезаполнитьКнопкиСКомандамиРезультатовВыполнения();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказыватьВыполненныеПриИзменении(Элемент)
	УстановитьОтбор(Новый Структура("ПоказыватьВыполненные", ПоказыватьВыполненные));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	УправлениеВидимостьюКомандПринятияКИсполнению(Элемент.ТекущиеДанные);
	УправлениеВидимостьюКомандОтменитьВыполнение(Элемент.ТекущиеДанные);
	УправлениеВидимостьюКомандВернутьНаРольИсполнителя(Элемент.ТекущиеДанные);
	УправлениеВидимостьюКомандИнформацияОбОшибке(Элемент.ТекущиеДанные);
	УправлениеВидимостьюКомандПрерватьВыполнение(Элемент.ТекущиеДанные);
	
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьКомандыРезультатовВыполнения");
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьКомандыРезультатовВыполнения", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "Предмет") Тогда
		ПоказатьЗначение(,ТекущиеДанные.Предмет);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СгруппироватьПоБезГруппировки(Команда)
	СгруппироватьПоКолонке("");
КонецПроцедуры

&НаКлиенте
Процедура СгруппироватьПоАвтору(Команда)
	СгруппироватьПоКолонке("Автор");
КонецПроцедуры

&НаКлиенте
Процедура СгруппироватьПоПредмету(Команда)
	СгруппироватьПоКолонке("ТипДокумента");
КонецПроцедуры

&НаКлиенте
Процедура СгруппироватьПоЭтапу(Команда)
	СгруппироватьПоКолонке("Этап");
КонецПроцедуры

&НаКлиенте
Процедура ПринятьКИсполнению(Команда)
	
	ПроцессыОбработкиДокументовКлиент.ПринятьЗадачиКИсполнению(Элементы.Список.ВыделенныеСтроки);
	
	УправлениеВидимостьюКомандПринятияКИсполнению(Элементы.Список.ТекущиеДанные);
	УправлениеВидимостьюКомандВернутьНаРольИсполнителя(Элементы.Список.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПринятиеКИсполнению(Команда)
	
	ПроцессыОбработкиДокументовКлиент.ОтменитьПринятиеЗадачКИсполнению(Элементы.Список.ВыделенныеСтроки);
	
	УправлениеВидимостьюКомандПринятияКИсполнению(Элементы.Список.ТекущиеДанные);
	УправлениеВидимостьюКомандВернутьНаРольИсполнителя(Элементы.Список.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаРольИсполнителя(Команда)
	
	ПроцессыОбработкиДокументовКлиент.ВернутьНаРольИсполнителя(Элементы.Список.ВыделенныеСтроки);
	
	УправлениеВидимостьюКомандВернутьНаРольИсполнителя(Элементы.Список.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИнформацияОбОшибке(Команда)
	ПроцессыОбработкиДокументовКлиент.ПоказатьИнформациюОбОшибках(Элементы.Список.ВыделенныеСтроки);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыполнение(Команда)
	
	ПроцессыОбработкиДокументовКлиент.ОтменитьВыполнениеЗадач(Элементы.Список.ВыделенныеСтроки);
	
	УправлениеВидимостьюКомандОтменитьВыполнение(Элементы.Список.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокЗадач(Команда)
	
	ОбновитьСписокЗадачНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКомандыРезультатовВыполнения()
	
	ПустойИдентификатор = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	
	ОбщийЭтап = Неопределено;
	
	Для Каждого Задача Из Элементы.Список.ВыделенныеСтроки Цикл
		Если ТипЗнч(Задача) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Продолжить;
		КонецЕсли;
		ДанныеЗадачи = Элементы.Список.ДанныеСтроки(Задача);
		Если ДанныеЗадачи.Выполнена Тогда
			ОбщийЭтап = Неопределено;
			Прервать;
		КонецЕсли;
		Если ДанныеЗадачи.ИдентификаторПачкиЗадач <> ПустойИдентификатор Тогда
			ОбщийЭтап = Неопределено;
			Прервать;
		ИначеЕсли НЕ ЗначениеЗаполнено(ОбщийЭтап) Тогда
			ОбщийЭтап = ДанныеЗадачи.Этап;
		ИначеЕсли ОбщийЭтап <> ДанныеЗадачи.Этап Тогда
			ОбщийЭтап = Неопределено;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Команда Из ТаблицаКоманд Цикл
		ВидимостьКоманды = Команда.Этап = ОбщийЭтап;
		Если Элементы[Команда.ИмяКнопки].Видимость <> ВидимостьКоманды Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Команда.ИмяКнопки, "Видимость", ВидимостьКоманды);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ПроцессыОбработкиДокументовКлиент.ВыполнитьЗадачи(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = ПроцессыОбработкиДокументовВызовСервера.НачатьВыполнениеЗадач(Контекст, УникальныйИдентификатор);
	
	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
		
	Иначе
		
		ИдентификаторПачки = Контекст.ИдентификаторПачки;
		ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
		
		СостояниеДлительнойОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
										НСтр("ru = 'Выполнено 0 из %1 задач'"),
										Контекст.ДанныеДокументов.Количество());
		
		УправлениеДоступностьюЭлементовПриВыполненииВФоне(Истина);
		
		Элементы.СтраницыЭтапыДО.ТекущаяСтраница = Элементы.ДлительнаяОперация;
		
		ПроцессыОбработкиДокументовКлиент.ОжидатьЗавершениеВыполненияЗадач(ЭтотОбъект, ДлительнаяОперация, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнениеЗадачПоОбработкеДокументовПрогресс(Прогресс, ДополнительныеПараметры) Экспорт
	
	Если Прогресс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Прогресс.Прогресс <> Неопределено Тогда
		
		СостояниеДлительнойОперации = Прогресс.Прогресс.Текст;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииВыполненияДлительнойОперации(Результат, ДополнительныеПараметры) Экспорт
	
	ПриЗавершенииВыполненияЗадач();
	
	Если Результат = Неопределено Тогда // Пользователь отменил задание.
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(,Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, ПолучитьИзВременногоХранилища(Результат.АдресРезультата));
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьДлительнуюОперацию(Команда)
	
	ПараметрыОповещения = Новый Структура("ЗакрытьФорму", Ложь);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьОперациюПослеОтветаНаВопрос", ЭтотОбъект, ПараметрыОповещения);
	
	ТекстВопроса = НСтр("ru = 'Задачи еще выполняются. При прерывании операции часть задач останется невыполненной.
					|Прервать?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьОперациюПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Да
		И ИдентификаторЗадания <> Неопределено Тогда
		ОтменитьВыполнениеДлительнойОперации(ИдентификаторЗадания);
		ПриЗавершенииВыполненияЗадач(Истина);
	КонецЕсли;
	
	Если Параметры.ЗакрытьФорму Тогда
		ЗакрытиеПослеОтветаНаВопрос = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьВыполнение(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьВыполнениеПослеОтветаНаВопрос", ЭтотОбъект);
	
	ТекстВопроса = НСтр("ru = 'Прервать выполнение задач?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьВыполнениеПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПроцессыОбработкиДокументовКлиент.ПрерватьПроцессВыполненияЗадач(Элементы.Список.ВыделенныеСтроки);
	
	УправлениеВидимостьюКомандПрерватьВыполнение(Элементы.Список.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиСПереданнымиПравами(Команда)
	ОткрытьФорму("Задача.ЗадачаПоОбработкеДокумента.Форма.ЗадачиСПереданнымиПравами");
КонецПроцедуры

&НаКлиенте
Процедура НастройкиИсполнителяЗадач(Команда)
	
