#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ Ссылка.Пустая() Тогда
		ИсходныеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
			"Выполнена, ПринятаКИсполнению, ДатаПринятияКИсполнению, Исполнитель, ИсполнительНазначенПринудительно");
	Иначе
		ИсходныеРеквизиты = Новый Структура;
		ИсходныеРеквизиты.Вставить("Выполнена", Ложь);
		ИсходныеРеквизиты.Вставить("ПринятаКИсполнению", Ложь);
		ИсходныеРеквизиты.Вставить("ДатаПринятияКИсполнению", Дата(1, 1, 1));
		ИсходныеРеквизиты.Вставить("Исполнитель", Справочники.Пользователи.ПустаяСсылка());
		ИсходныеРеквизиты.Вставить("ИсполнительНазначенПринудительно", Ложь);
	КонецЕсли;
	
	ТекущаяДатаСеанса = ТекущаяДатаСеанса();
	
	// Переменные для исключения двойного расчета даты последней отмены выполнения задачи и расписания работы
	ДатаПоследнейОтменыВыполнения = Неопределено;
	ИнтервалыРабочегоВремени = Неопределено;
	
	Если НЕ ИсходныеРеквизиты.Выполнена И Выполнена И НЕ Прервана Тогда
		
		// Если задача выполнена, то запишем в реквизит Исполнитель того
		// пользователя, который фактически выполнил задачу. Это нам потом
		// потребуется для отчетов. Такую запись делаем только в том
		// случае, если в базе было не выполнено, а в объекте стало выполнено.
		Если НЕ ЗначениеЗаполнено(Исполнитель) Тогда
			Исполнитель = Пользователи.АвторизованныйПользователь();
		КонецЕсли;
		Если ДатаИсполнения = Дата(1, 1, 1) Тогда
			ДатаИсполнения = ТекущаяДатаСеанса;
		КонецЕсли;
		
		ВремяВыполненияФакт = ВремяВыполненияФакт + ПроцессыОбработкиДокументов.ВремяВыполненияЗадачи(
			ЭтотОбъект, ДатаИсполнения, ДатаПоследнейОтменыВыполнения, ИнтервалыРабочегоВремени);
		
	КонецЕсли;
	
	ПроцессыОбработкиДокументовПереопределяемый.ПередЗаписьюЗадачи(ЭтотОбъект, ИсходныеРеквизиты,
		ТекущаяДатаСеанса, ДатаПоследнейОтменыВыполнения, ИнтервалыРабочегоВремени, Отказ);
	
	Если Выполнена И НЕ Прервана И Не ПринятаКИсполнению Тогда
		ПринятаКИсполнению = Истина;
		ДатаПринятияКИсполнению = ТекущаяДатаСеанса;
	КонецЕсли;
	
	// Если ранее задача была не выполнена из-за ошибки, то теперь этот флаг надо сбросить
	Если Выполнена И НеВыполненаИзЗаОшибки Тогда
		НеВыполненаИзЗаОшибки = Ложь;
		ОписаниеОшибки = "";
	КонецЕсли;
	
	ТипПредметаСтрокой = Предмет.Метаданные().Синоним;
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УстановитьПривилегированныйРежим(Истина);
	ГруппаИсполнителейЗадач = БизнесПроцессыИЗадачиСервер.ГруппаИсполнителейЗадач(РольИсполнителя, 
		ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации);
	УстановитьПривилегированныйРежим(Ложь);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Заполнение реквизита ДатаПринятияКИсполнению.
	Если ПринятаКИсполнению И ДатаПринятияКИсполнению = Дата('00010101') Тогда
		ДатаПринятияКИсполнению = ТекущаяДатаСеанса;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли