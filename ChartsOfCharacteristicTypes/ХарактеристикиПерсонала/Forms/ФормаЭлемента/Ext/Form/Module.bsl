				НоваяХарактеристика = ХарактеристикиФункции.Добавить();
				НоваяХарактеристика.Характеристика = ТекущийОбъект.Ссылка;
				НоваяХарактеристика.Вес = 1;
				НоваяХарактеристика.Значение = Значение;
			КонецЦикла;
		КонецЕсли;
		ОбъектФункция.Записать();
	КонецЦикла;
	
	Для Каждого УдаленнаяФункция Из УдаленныеФункции Цикл
		ОбъектФункция = УдаленнаяФункция.ПолучитьОбъект();
		ХарактеристикиФункции = ОбъектФункция.ХарактеристикиПерсонала;
		НайденныеСтроки = ХарактеристикиФункции.НайтиСтроки(Новый Структура("Характеристика",ТекущийОбъект.Ссылка));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ХарактеристикиФункции.Удалить(НайденнаяСтрока);
