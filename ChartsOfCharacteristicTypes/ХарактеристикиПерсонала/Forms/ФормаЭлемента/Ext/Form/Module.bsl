&НаКлиенте
Процедура УстановитьВидимостьПоИсточнику()
	
	ИсточникВызова = ИсточникВызоваФормы(ВладелецФормы, 0);
	Если ИсточникВызова <> Неопределено Тогда
		ТипИсточника = ТипЗнч(ИсточникВызова);
		Если ТипИсточника = Тип("СправочникСсылка.КомпетенцииПерсонала") Тогда
			Элементы.КомпетенцииГруппа.Видимость = Ложь;
		ИначеЕсли ТипИсточника = Тип("СправочникСсылка.ДействияСотрудников") Тогда
			Элементы.ФункцииГруппа.Видимость = Ложь;
		ИначеЕсли ТипИсточника = Тип("СправочникСсылка.ГруппыХарактеристикПерсонала") Тогда
			Элементы.ГруппыХарактеристик.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ИсточникВызоваФормы(РодительскаяФорма, Вложенность)
	
	Если Вложенность > 3 Тогда
		Возврат Неопределено;
	Иначе
		Вложенность = Вложенность + 1;
	КонецЕсли;
	
	ТипФормы = ТипЗнч(РодительскаяФорма);
	Если ТипФормы = Тип("ТаблицаФормы") Тогда
		ОбъектФормы = ИсточникВызоваФормы(РодительскаяФорма.Родитель, Вложенность);
	ИначеЕсли ТипФормы = Тип("ФормаКлиентскогоПриложения") Тогда
		Если РодительскаяФорма.Параметры.Свойство("Ключ") Тогда
			ОбъектФормы = РодительскаяФорма.Параметры.Ключ;
		ИначеЕсли СтрНачинаетсяС(РодительскаяФорма.ИмяФормы, "ПланВидовХарактеристик.ХарактеристикиПерсонала.") Тогда
			ОбъектФормы = ИсточникВызоваФормы(РодительскаяФорма.ВладелецФормы, Вложенность);
		Иначе
			ОбъектФормы = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОбъектФормы;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьДоступностьЦелейРазвития(ТекущийОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	НастройкиОбученияРазвития = РегистрыСведений.НастройкиОбученияРазвития.ЗначенияНастроек();
	ВидимостьЦелейРазвития = НастройкиОбученияРазвития.ИспользоватьЦелиРазвитияСотрудников;
	УстановитьПривилегированныйРежим(Ложь);
	
	ЧтениеЦелейРазвития = ПравоДоступа("Чтение", Метаданные.Справочники.ЦелиРазвития);
	ИзменениеЦелейРазвития = ПравоДоступа("Изменение", Метаданные.Справочники.ЦелиРазвития);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЦелиРазвитияГруппа", "Видимость", ВидимостьЦелейРазвития И ЧтениеЦелейРазвития);
	
	Если ВидимостьЦелейРазвития И ЧтениеЦелейРазвития Тогда
		ЗаполнитьЦелиРазвития(ТекущийОбъект);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЦелиРазвития", "ТолькоПросмотр", Не ИзменениеЦелейРазвития);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЦелиРазвитияПодборЦелей", "Доступность", ИзменениеЦелейРазвития);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокСпискаМероприятий()
	
	ЗначениеХарактеристики = СписокМероприятий.Параметры.Элементы.Найти("Характеристика");
	Если ЗначениеХарактеристики = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СписокМероприятий.ТекстЗапроса;
	Запрос.УстановитьПараметр("Характеристика", ЗначениеХарактеристики.Значение);
	Для Каждого ПараметрЗапроса Из СписокМероприятий.Параметры.Элементы Цикл
		ИмяПараметра = СписокМероприятий.Параметры.ДоступныеПараметры.НайтиПараметр(ПараметрЗапроса.Параметр);
		Запрос.УстановитьПараметр(ИмяПараметра, ПараметрЗапроса.Значение);
	КонецЦикла;
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		КоличествоМероприятий = Результат.Выгрузить().Количество();
	Иначе
		КоличествоМероприятий = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
