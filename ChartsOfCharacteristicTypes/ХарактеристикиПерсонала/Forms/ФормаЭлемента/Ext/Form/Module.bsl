&НаСервере
Процедура ЗаписатьЦелиРазвития(ТекущийОбъект)
	
	ДобавленныеЦели = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		ЦелиРазвития.Выгрузить().ВыгрузитьКолонку("Цель"),
		ЦелиРазвитияПриЧтении.Выгрузить().ВыгрузитьКолонку("Цель"));
	УдаленныеЦели = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		ЦелиРазвитияПриЧтении.Выгрузить().ВыгрузитьКолонку("Цель"),
		ЦелиРазвития.Выгрузить().ВыгрузитьКолонку("Цель"));
		
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Справочник.ЦелиРазвития");
		Блокировка.Заблокировать();
		Для Каждого ДобавленнаяЦель Из ДобавленныеЦели Цикл
			ОбъектЦель = ДобавленнаяЦель.ПолучитьОбъект();
			ХарактеристикиЦели = ОбъектЦель.Характеристики;
			НоваяХарактеристика = ХарактеристикиЦели.Добавить();
			НоваяХарактеристика.Характеристика = ТекущийОбъект.Ссылка;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектЦель);
		КонецЦикла;
		
		Для Каждого УдаленнаяЦель Из УдаленныеЦели Цикл
			ОбъектЦель = УдаленнаяЦель.ПолучитьОбъект();
			ХарактеристикиЦели = ОбъектЦель.Характеристики;
			НайденныеСтроки = ХарактеристикиЦели.НайтиСтроки(Новый Структура("Характеристика", ТекущийОбъект.Ссылка));
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				ХарактеристикиЦели.Удалить(НайденнаяСтрока);
			КонецЦикла;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектЦель);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Запись целей развития'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ЗначенияШкалы(ШкалаЗначений)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияХарактеристик.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗначенияХарактеристик КАК ЗначенияХарактеристик
		|ГДЕ
		|	ЗначенияХарактеристик.ПометкаУдаления = ЛОЖЬ
		|	И ЗначенияХарактеристик.Владелец = &ШкалаЗначений
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗначенияХарактеристик.РеквизитДопУпорядочивания";
	Запрос.УстановитьПараметр("ШкалаЗначений", ШкалаЗначений);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

