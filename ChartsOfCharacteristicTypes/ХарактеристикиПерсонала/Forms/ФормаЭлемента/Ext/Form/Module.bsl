&НаСервере
Процедура ЗаполнитьНадписьЗначенияШкалы()
	
	Если Не ЗначениеЗаполнено(Объект.ШкалаЗначений) Тогда
		Элементы.ЗначенияШкалы.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ЗначенияШкалы = ЗначенияШкалы(Объект.ШкалаЗначений);
	КоличествоЗначений = ЗначенияШкалы.Количество();
	
	Если КоличествоЗначений = 0 Тогда
		Элементы.ЗначенияШкалы.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.ЗначенияШкалы.Видимость = Истина;
	Если КоличествоЗначений > 3 Тогда
		Надпись = СтрШаблон(НСтр("ru = 'Значения с %1 по %2'"),
			ЗначенияШкалы.Получить(0),
			ЗначенияШкалы.Получить(КоличествоЗначений - 1));
	Иначе
		Надпись = НСтр("ru = 'Значения:'") + Символы.НПП;
		Для Каждого ЗначениеШкалы Из ЗначенияШкалы Цикл
			Если ЗначенияШкалы.Найти(ЗначениеШкалы) + 1 = КоличествоЗначений Тогда
				Надпись = СтрШаблон(НСтр("ru = '%1%2'"), Надпись, ЗначениеШкалы);
			Иначе
				Надпись = СтрШаблон(НСтр("ru = '%1%2,%3'"), Надпись, ЗначениеШкалы, Символы.НПП);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Элементы.ЗначенияШкалы.Заголовок = Надпись;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФункции(ТекущийОбъект)
	
	Если Не ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		Возврат;
	КонецЕсли; 
	
	Функции.Очистить();
	ФункцииПриЧтении.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДействияСотрудниковХарактеристикиПерсонала.Ссылка КАК Функция
		|ИЗ
		|	Справочник.ДействияСотрудников.ХарактеристикиПерсонала КАК ДействияСотрудниковХарактеристикиПерсонала
		|ГДЕ
		|	ДействияСотрудниковХарактеристикиПерсонала.Характеристика = &Характеристика
		|
		|СГРУППИРОВАТЬ ПО
		|	ДействияСотрудниковХарактеристикиПерсонала.Ссылка";
	
	Запрос.УстановитьПараметр("Характеристика", ТекущийОбъект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Функции.Добавить(), ВыборкаДетальныеЗаписи);
		Если ТекущийОбъект.Ссылка = Объект.Ссылка Тогда
			ЗаполнитьЗначенияСвойств(ФункцииПриЧтении.Добавить(), ВыборкаДетальныеЗаписи);
		КонецЕсли;
	КонецЦикла;
	
