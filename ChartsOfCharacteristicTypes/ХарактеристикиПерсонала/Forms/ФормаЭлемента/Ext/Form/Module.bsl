		ФункцииПриЧтении.Выгрузить().ВыгрузитьКолонку("Функция"),
		Функции.Выгрузить().ВыгрузитьКолонку("Функция"));
	
	Для Каждого ДобавленнаяФункция Из ДобавленныеФункции Цикл
		ОбъектФункция = ДобавленнаяФункция.ПолучитьОбъект();
		ХарактеристикиФункции = ОбъектФункция.ХарактеристикиПерсонала;
		Если ЗначенияШкалы.Количество() = 0 Тогда
			НоваяХарактеристика = ХарактеристикиФункции.Добавить();
