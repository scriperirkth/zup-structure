
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияХарактеристикПерсонала");
		ПриПолученииДанныхНаСервере(Параметры.ЗначениеКопирования);
	КонецЕсли;
	
	СписокМероприятий.Параметры.УстановитьЗначениеПараметра("Характеристика", Объект.Ссылка);
	УстановитьЗаголовокСпискаМероприятий();
	
	ОбновитьСоставЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриПолученииДанныхНаСервере(ТекущийОбъект);
	ПрежнееПолноеНаименование = Объект.ПолноеНаименование;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьВопросыОценкиХарактеристик(ТекущийОбъект);
	ЗначенияШкалы = ЗначенияШкалы(ТекущийОбъект.ШкалаЗначений);
	ЗаписатьФункции(ТекущийОбъект, ЗначенияШкалы);
	ЗаписатьКомпетенции(ТекущийОбъект, ЗначенияШкалы);
	ЗаписатьГруппы(ТекущийОбъект, ЗначенияШкалы);
	
	Если ИзменениеЦелейРазвития Тогда
		ЗаписатьЦелиРазвития(ТекущийОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПриПолученииДанныхНаСервере(ТекущийОбъект);
	
	ОбновитьСоставЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Для Каждого ТекущееЗначение Из ИзмененныеЗначения Цикл
		ОтобразитьИзменениеДанных(ТекущееЗначение.Значение, ВидИзмененияДанных.Изменение);
	КонецЦикла;
	ИзмененныеЗначения.Очистить();
	
	Оповестить("ЗаписьХарактеристикиПерсонала",,Объект.Ссылка);
	
	Если ПараметрыЗаписи.Свойство("ЗаписатьИЗакрыть") Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьПоИсточнику();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ШкалаЗначенийПриИзменении(Элемент)
	
	ЗаполнитьНадписьЗначенияШкалы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОценку360ПриИзменении(Элемент)
	
	УстановитьДоступностьПоведенческихИндикаторов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьЭкспертнуюОценкуПриИзменении(Элемент)
	
	УстановитьДоступностьСпособаВыбораОтвета(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолноеНаименованиеПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Наименование) Или НаименованиеСоответствуетПрежнему() Тогда
		Объект.Наименование = НаименованиеПоПолномуНаименованию(Объект.ПолноеНаименование);
	КонецЕсли;
	
	ПрежнееПолноеНаименование = Объект.ПолноеНаименование;
	
	НастроитьЭлементыФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	НастроитьЭлементыФормы(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗначения

&НаКлиенте
Процедура ЗначенияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Значения.ТекущиеДанные;
	ТекущиеДанные.ПометкаУдаления = Ложь;
	ТекущиеДанные.ИндексКартинки = ИндексКартинкиЭлемента();
	
	Если Копирование Тогда
		ТекущиеДанные.Ссылка = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.Значения.ТекущиеДанные;
	ТекущиеДанные.ПометкаУдаления = НЕ ТекущиеДанные.ПометкаУдаления;	
	ТекущиеДанные.ИндексКартинки = ?(ТекущиеДанные.ПометкаУдаления,
		ИндексКартинкиЭлементаПометкаУдаления(), ИндексКартинкиЭлемента());
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВопросы

&НаКлиенте
Процедура ВопросыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Вопросы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ВопросОкончаниеВыбора", ЭтотОбъект);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Вопрос);
	ПараметрыФормы.Вставить("ХарактеристикаПерсонала", Объект.Ссылка);
	
	ОткрытьФорму("Справочник.МероприятияОценкиПерсонала.Форма.НастройкаВопросовДляАнкетирования",
		ПараметрыФормы, ЭтотОбъект,,,,Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицуИзМассива(
		Вопросы, ВыбранноеЗначение, "Вопрос");
	
	УстановитьЗаголовокГруппы(Вопросы, КоличествоПоведенческихИндикаторов);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	НачатьПодборВопросов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросыПриИзменении(Элемент)
