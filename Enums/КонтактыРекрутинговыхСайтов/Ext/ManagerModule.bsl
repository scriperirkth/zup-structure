// @strict-types


#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Параметры:
//  Контакт - ПеречислениеСсылка.КонтактыРекрутинговыхСайтов
// 
// Возвращаемое значение:
//  СправочникСсылка.ВидыКонтактнойИнформации - Вид контактной информации
Функция ВидКонтактнойИнформацииПоУмолчанию(Контакт) Экспорт
	Результат = Справочники.ВидыКонтактнойИнформации.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(Контакт) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Идентификатор = Идентификатор(Контакт);
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НайденныйВид =
		Справочники.ВидыКонтактнойИнформации.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		
	Если ОбщегоНазначения.СсылкаСуществует(НайденныйВид) Тогда
		Результат = НайденныйВид;
	Иначе
		НачатьТранзакцию();
		Попытка
			Результат = СоздатьПоУмолчанию(Контакт, НайденныйВид);
			РегистрыСведений.НастройкаВидовКонтактнойИнформацииКандидатов.ДобавитьНастройку(
				Результат, Справочники.ВидыКонтактнойИнформации.ПустаяСсылка());
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Параметры:
//  Контакт - ПеречислениеСсылка.КонтактыРекрутинговыхСайтов
// 
// Возвращаемое значение:
//  СправочникСсылка.ВидыКонтактнойИнформации - Вид контактной информации
Функция ВидКонтактнойИнформации(Контакт) Экспорт
	Возврат РегистрыСведений.ВидыКонтактнойИнформацииКонтактовРекрутинговыхСайтов.ТекущийВидКонтактнойИнформации(Контакт);
КонецФункции

// Возвращаемое значение:
//  Структура - Идентификаторы:
// * Telegram - Строка - 
// * Whatsapp - Строка - 
// * Max - Строка - 
// * Прочее - Строка - 
Функция Идентификаторы() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Telegram", 
		Строка(Справочники.ВидыКонтактнойИнформации.TelegramЛичныеДанныеКандидатов.УникальныйИдентификатор()));
	Результат.Вставить("Max",
		Строка(Справочники.ВидыКонтактнойИнформации.MAXЛичныеДанныеКандидатов.УникальныйИдентификатор()));
	Результат.Вставить("Whatsapp", 		"e2e18a78-7c80-4bfa-8f2d-a8810abc75ab");
	Результат.Вставить("Прочее", 		"89123084-ba00-40fb-9711-80e598b0930e");
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  Контакт - ПеречислениеСсылка.КонтактыРекрутинговыхСайтов
// 
// Возвращаемое значение:
//  Строка - Идентификатор
Функция Идентификатор(Контакт)
	Результат = "";
	Идентификаторы = Идентификаторы();
	
	Если Контакт = Telegram Тогда
		Результат = Идентификаторы.Telegram;
	ИначеЕсли Контакт = Whatsapp Тогда
		Результат = Идентификаторы.Whatsapp;
	ИначеЕсли Контакт = Max Тогда
		Результат = Идентификаторы.Max;
	ИначеЕсли Контакт = Прочее Тогда
		Результат = Идентификаторы.Прочее;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Параметры:
//  Контакт - ПеречислениеСсылка.КонтактыРекрутинговыхСайтов
//  Ссылка - СправочникСсылка.ВидыКонтактнойИнформации
// 
// Возвращаемое значение:
//  СправочникСсылка.ВидыКонтактнойИнформации
Функция СоздатьПоУмолчанию(Контакт, Ссылка)
	НовыйВид = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
	НовыйВид.ВидРедактирования = "ПолеВвода";
	НовыйВид.Тип = Перечисления.ТипыКонтактнойИнформации.Другое;
	НовыйВид.Используется = Истина;
	НовыйВид.ВидПоляДругое = "ОднострочноеУзкое";
	НовыйВид.Родитель = Справочники.ВидыКонтактнойИнформации.СправочникЛичныеДанныеКандидатов;
	НовыйВид.ИмяГруппы = "СправочникЛичныеДанныеКандидатов";
	НовыйВид.Наименование = Строка(Контакт);
	НовыйВид.РазрешитьВводНесколькихЗначений = Истина;
	НовыйВид.ИдентификаторДляФормул = Справочники.ВидыКонтактнойИнформации.УникальныйИдентификаторДляФормул(
		НовыйВид.Наименование, НовыйВид.Ссылка, НовыйВид.Родитель);

	НовыйВид.УстановитьСсылкуНового(Ссылка);
	НовыйВид.Записать();
	
	Возврат НовыйВид.Ссылка;
КонецФункции

#КонецОбласти

#КонецЕсли
