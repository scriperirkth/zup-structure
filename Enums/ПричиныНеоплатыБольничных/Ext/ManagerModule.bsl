#Область СлужебныеПроцедурыИФункции

Функция ЗначениеЧислом(Значение, ДляЕЦП = Ложь) Экспорт
	Если ДляЕЦП Тогда
		Возврат ЗначениеЧисломДляЕЦП(Значение);
	КонецЕсли;
	Если Значение = ОтстранениеОтРаботы Тогда
		Возврат 1;
	ИначеЕсли Значение = ОтпускБезСохраненияОплаты Тогда
		Возврат 2;
	ИначеЕсли Значение = УчебныйОтпуск Тогда
		Возврат 3;
	ИначеЕсли Значение = Отпуск Тогда
		Возврат 4;
	ИначеЕсли Значение = Работа Тогда
		Возврат 4;
	ИначеЕсли Значение = Иное Тогда
		Возврат 4;
	ИначеЕсли Значение = ПределОплаты5МесяцевДляИнвалидов Тогда
		Возврат 4;
	ИначеЕсли Значение = ЗаключениеПодСтражу Тогда
		Возврат 4;
	ИначеЕсли Значение = АдминистративныйАрест Тогда
		Возврат 4;
	ИначеЕсли Значение = СМЭ Тогда
		Возврат 4;
	ИначеЕсли Значение = ОплатаЗаСчетРаботодателя Тогда
		Возврат Неопределено;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ЗначениеЧисломДляЕЦП(Значение) Экспорт
	Если Значение = ОтстранениеОтРаботы Тогда
		Возврат 1;
	ИначеЕсли Значение = Отпуск Тогда
		Возврат 4;
	ИначеЕсли Значение = Иное Тогда
		Возврат 4;
	ИначеЕсли Значение = ПределОплаты5МесяцевДляИнвалидов Тогда
		Возврат 4;
	ИначеЕсли Значение = ОтпускБезСохраненияОплаты Тогда
		Возврат 5;
	ИначеЕсли Значение = УчебныйОтпуск Тогда
		Возврат 5;
	ИначеЕсли Значение = ЗаключениеПодСтражу Тогда
		Возврат 6;
	ИначеЕсли Значение = АдминистративныйАрест Тогда
		Возврат 7;
	ИначеЕсли Значение = СМЭ Тогда
		Возврат 8;
	ИначеЕсли Значение = Работа Тогда
		Возврат 9;
	ИначеЕсли Значение = ОплатаЗаСчетРаботодателя Тогда
		Возврат 10;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ЭтоОтпуск(Значение) Экспорт
	Возврат Значение = Отпуск Или Значение = ОтпускБезСохраненияОплаты Или Значение = УчебныйОтпуск;
КонецФункции

Функция СписокВыбора(ДляЕЦП, Результат = Неопределено) Экспорт
	Если Результат = Неопределено Тогда
		Результат = Новый СписокЗначений;
	Иначе
		Результат.Очистить();
	КонецЕсли;
	Результат.Добавить(ОтстранениеОтРаботы);
	Результат.Добавить(ОтпускБезСохраненияОплаты);
	Результат.Добавить(УчебныйОтпуск);
	Результат.Добавить(Отпуск);
	Результат.Добавить(Работа);
	Результат.Добавить(ЗаключениеПодСтражу);
	Результат.Добавить(АдминистративныйАрест);
	Результат.Добавить(СМЭ);
	Результат.Добавить(ОплатаЗаСчетРаботодателя);
	Результат.Добавить(Иное);
	Для Каждого Элемент Из Результат Цикл
		Элемент.Представление = "(" + Строка(ЗначениеЧислом(Элемент.Значение, ДляЕЦП)) + ") " + Строка(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

