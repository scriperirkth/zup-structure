&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПодключаемыеКоманды(УправляемаяФорма)
	
	ЭДОБЗККлиентСервер.ОбновитьКоманды(УправляемаяФорма, УправляемаяФорма.Объект, Истина);
	
КонецПроцедуры
// Конец ЭДОБЗК

&НаКлиенте
Процедура ДобавитьИзмененныеДанныеПерерасчета(ТекущиеДанные) Экспорт
	
	РасчетЗарплатыРасширенныйКлиент.ДобавитьИзмененныеДанные(
		ИзмененныеДанные,
		"Начисления",
		Объект.ФизическоеЛицо,
		ТекущиеДанные.Сотрудник,
		ТекущиеДанные.Начисление);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУдаленияПерерасчета() Экспорт
	РассчитатьДанныеФормы(Объект.Сотрудник, ОписаниеДокумента.ОписанияТаблицДляРаспределенияРезультата.НачисленияПерерасчет);
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзмененииНаКлиенте(ИмяЭлемента)
	ИнформацияПоДням = Неопределено;
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
			Если ИмяЭлемента = "ДатаНачала" Тогда
				Объект.ДатаОкончания = Объект.ДатаНачала;
			Иначе
				Объект.ДатаНачала = Объект.ДатаОкончания;
			КонецЕсли;
		КонецЕсли;
		ВыбранныеДаты = ОбщегоНазначенияБЗККлиентСервер.МассивДатИзПериода(Объект.ДатаНачала, Объект.ДатаОкончания);
		ЗаполнитьВыбранныеДниУхода(ВыбранныеДаты);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПолучитьЗаявлениеВСФР(ОбновитьБлокировку = Ложь)
	ЗаявлениеВСФР = Документы.ЗаявлениеВФССОВозмещенииВыплатРодителямДетейИнвалидов.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявлениеВФССООплаты.Ссылка КАК ЗаявлениеВСФР,
		|	ЗаявлениеВФССО.СтатусДокумента КАК СтатусДокумента,
		|	ЗаявлениеВФССО.ОтправлятьЧерезСЭДО КАК ОтправлятьЧерезСЭДО,
		|	ЕСТЬNULL(Регистрации.РегистрацияУспех, ЛОЖЬ) КАК РегистрацияУспех,
		|	ЕСТЬNULL(Регистрации.Состояние, НЕОПРЕДЕЛЕНО) КАК Состояние,
		|	ЗаявлениеВФССО.Проведен КАК Проведен
		|ИЗ
		|	Документ.ЗаявлениеВФССОВозмещенииВыплатРодителямДетейИнвалидов.Оплаты КАК ЗаявлениеВФССООплаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявлениеВФССОВозмещенииВыплатРодителямДетейИнвалидов КАК ЗаявлениеВФССО
		|		ПО ЗаявлениеВФССООплаты.Ссылка = ЗаявлениеВФССО.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрацииЗаявленийОВозмещенииВыплатРодителямДетейИнвалидов КАК Регистрации
		|		ПО (ЗаявлениеВФССО.ИдентификаторСообщения = Регистрации.ИдентификаторСообщения)
		|ГДЕ
		|	ЗаявлениеВФССО.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЗаявлениеВФССООплаты.ДокументОснование = &ДокументОснование
		|	И ЗаявлениеВФССО.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаявлениеВФССО.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоГода(Объект.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", ДобавитьМесяц(КонецГода(Объект.ДатаОкончания), 12));
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗаявлениеВСФР.Пустая() Тогда
			// Выберем последнее, если нет ранее принятых
			ЗаявлениеВСФР = Выборка.ЗаявлениеВСФР;
		КонецЕсли;
		ЗаявлениеОтправленоВСФР = Выборка.СтатусДокумента = Перечисления.СтатусыЗаявленийИРеестровНаВыплатуПособий.ПринятФСС
			Или Выборка.ОтправлятьЧерезСЭДО
			И (Выборка.РегистрацияУспех
				Или Выборка.Состояние = Перечисления.СостоянияДокументаСЭДОФСС.ОтправленОператору
				Или Выборка.Состояние = Перечисления.СостоянияДокументаСЭДОФСС.Отправлен
				Или Выборка.Состояние = Перечисления.СостоянияДокументаСЭДОФСС.Принят
				Или Выборка.Состояние = Перечисления.СостоянияДокументаСЭДОФСС.ПринятСЗамечаниями
		Или Выборка.Состояние = Перечисления.СостоянияДокументаСЭДОФСС.ЧастичноПринят);
		Если ЗаявлениеОтправленоВСФР Тогда
			ЗаявлениеВСФР = Выборка.ЗаявлениеВСФР;
			ТолькоПросмотр = Истина;
			КоллекцияБлокировок = ОбщегоНазначения.СкопироватьРекурсивно(ЭтотОбъект["ПараметрыБлокировкиИзмененияОбъекта"], Ложь);
			МассивСтрок = Новый Массив;
			МассивСтрок.Добавить(НСтр("ru = 'Документ '"));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Строка(Выборка.ЗаявлениеВСФР), , , , ПолучитьНавигационнуюСсылку(Выборка.ЗаявлениеВСФР)));
			МассивСтрок.Добавить(НСтр("ru = ' отправлен в СФР, редактирование запрещено'"));
			БлокировкаИзмененияОбъекта = БлокировкаИзмененияОбъектов.ОписаниеБлокировкиИзмененияОбъекта(
				"ОтправленоЗаявлениеВСФР", Новый ФорматированнаяСтрока(МассивСтрок), Истина);
			КоллекцияБлокировок.Добавить(БлокировкаИзмененияОбъекта);
			ЭтотОбъект["ПараметрыБлокировкиИзмененияОбъекта"] = Новый ФиксированныйМассив(КоллекцияБлокировок);
			БлокировкаИзмененияОбъектовКлиентСервер.ОбновитьГруппуБлокировкиИзмененияОбъекта(ЭтотОбъект, Ложь, Ложь);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбновитьБлокировку И Не ЗаявлениеОтправленоВСФР Тогда
		БлокировкаИзмененияОбъектовКлиентСервер.ОбновитьГруппуБлокировкиИзмененияОбъекта(ЭтотОбъект, ОбновитьБлокировку);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписаниеДокумента()
	ОписаниеДокумента = Новый ФиксированнаяСтруктура(Документы.ОплатаДнейУходаЗаДетьмиИнвалидами.ОписаниеДокумента(
		Объект, РегистрацияНачисленийДоступна));
КонецПроцедуры

