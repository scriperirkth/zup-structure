	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ДанныеДокументов = Новый Массив;
	
	БазовыеДанныеДокументов = ДанныеДокументовДляПечатиРасчетаСреднегоЗаработка(МассивСсылок, Истина);
	
	Отбор = Новый Структура("Ссылка");
	
	Для каждого БазовыеДанныеДокумента Из БазовыеДанныеДокументов Цикл
		
		Выборка.Сбросить();		
		
		ДанныеДокумента = Обработки.ПечатьРасчетаСреднегоЗаработка.ПустаяСтруктураДанныхДляПечатиСреднегоЗаработка0504425(); 
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, БазовыеДанныеДокумента, , "РеквизитыДокумента");   
		
		// Т.к. структура реквизитов документа в базовых и расширенных данных различается их надо обработать отдельно.
		ЗаполнитьЗначенияСвойств(ДанныеДокумента.РеквизитыДокумента, БазовыеДанныеДокумента.РеквизитыДокумента);		
		Отбор.Ссылка = БазовыеДанныеДокумента.РеквизитыДокумента.Ссылка;
		Если Выборка.НайтиСледующий(Отбор) Тогда
			ЗаполнитьЗначенияСвойств(ДанныеДокумента.РеквизитыДокумента, Выборка); 
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДанныеДокумента.РеквизитыДокумента, 
			ОрганизацииИСведенияОНих.Получить(БазовыеДанныеДокумента.РеквизитыДокумента.Организация),
			"ИНН, КПП"); 
		
		ДанныеДокумента.РеквизитыДокумента.НаименованиеСобытия = НСтр("ru = 'Дополнительные выходные дни по уходу за детьми-инвалидами'");
		ДанныеДокументов.Добавить(ДанныеДокумента);
		
	КонецЦикла;
	
	Возврат ДанныеДокументов;
	
КонецФункции

#КонецОбласти

#Область ПечатьПодробногоРасчетаНачислений

// Заполняет структуру - описание документа для формирования печатной формы подробного расчета начислений.
//
// Параметры:
//   ОписаниеДокумента - структура, определяется в Обработки.ПечатьРасчетаНачислений.ОписаниеДокументаРасчетаНачислений.
//
Процедура ЗаполнитьОписаниеДокументаРасчетаНачислений(ОписаниеДокумента) Экспорт
	КатегорииСпециализированногоНачисления = КатегорииСпециализированногоНачисления();
	
	МетаданныеДокумента = ПустаяСсылка().Метаданные();
	
	ОписаниеДокумента.Вставить("ИмяДокумента", 								МетаданныеДокумента.Имя);
	ОписаниеДокумента.Вставить("СинонимДокумента", 							МетаданныеДокумента.Синоним);
	ОписаниеДокумента.Вставить("ЕстьРасчетСреднегоЗаработка", 				Истина);
	ОписаниеДокумента.Вставить("ЕстьРасчетСпециализированныхНачислений",	Истина);
	ОписаниеДокумента.Вставить("ЕстьРасчетЗарплаты", 						Ложь);
	ОписаниеДокумента.Вставить("КатегорииСпециализированногоНачисления", 	КатегорииСпециализированногоНачисления);
	ОписаниеДокумента.Вставить("НазваниеСпециализированногоНачисления", 	НСтр("ru = 'Оплата дополнительных выходных дней по уходу за детьми-инвалидами'"));
КонецПроцедуры 

// Заполняет таблицу значений - параметры формирования печатной формы подробного расчета начислений.
//
// Параметры:
//	 МассивСсылок 		- массив, печатаемые документы.
//   ДанныеДокумента 	- таблица значений, определяется в
//                      Обработки.ПечатьРасчетаНачислений.ДанныеДокументовДляПодробногоРасчетаНачислений.
//
Процедура ЗаполнитьДанныеДокументовДляПодробногоРасчетаНачислений(МассивСсылок, ДанныеДокументов) Экспорт
	РасчетЗарплатыРасширенный.ЗаполнитьДанныеДокументовДляПодробногоРасчетаНачислений(МассивСсылок, ПустаяСсылка().Метаданные().Имя, ДанныеДокументов);	
КонецПроцедуры

// Возвращает структуру с двумя таблицами "Начисления" и "Показатели".
// Данные в таблицах представлены в разрезе ссылки на документ.
// 	Параметры:
//		МассивСсылок - массив ссылок на документы у которых есть табличные части "Начисления" и "Показатели".
//		ИмяДокумента - Имя объекта метаданных (документа) для формирования запроса.
//
Функция НачисленияПоказателиДокументов(МассивСсылок) Экспорт 
	Возврат РасчетЗарплатыРасширенный.НачисленияПоказателиДокументов(МассивСсылок, ПустаяСсылка().Метаданные().Имя);	
КонецФункции

#КонецОбласти

#Область ИнформацияПоПоДнямУхода

// Возвращает структуру с результатами проверок по документу ОплатаДнейУходаЗаДетьмиИнвалидами.
//
// Параметры:
//   Документ - ДокументСсылка.ОплатаДнейУходаЗаДетьмиИнвалидами, ДокументОбъект.ОплатаДнейУходаЗаДетьмиИнвалидами - Ссылка или документ объект.
//   Отказ - Булево - Признак отказа от выполнения проведения.
//
// Возвращаемое значение:
//   Структура - Структура содержащая сведения в разрезе физического лица.
//       * КоличествоРабочихДней - Число - количество рабочих дней по физическому лицу в периоде.
//       * КоличествоКалендарныхДней - Число - количество календарных дней по физическому лицу в периоде.
//       * КоличествоРабочихДнейПоДокументу - Число - количество рабочих дней по документу.
//       * КоличествоКалендарныхДнейПоДокументу - Число - количество календарных дней по документу.
//       * ИспользоватьОстатокДнейЗаГод - Булево - флаг использования остатка дней за год.
//
Функция СводнаяИнформацияПоДнямУхода(Документ, Отказ = Ложь) Экспорт
	Перем ТекущаяСсылка, КонецМесяца, НачалоГода, ИспользоватьОстатокДнейЗаГод;
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("КоличествоРабочихДней", 0);
	СтруктураРезультат.Вставить("КоличествоКалендарныхДней", 0);
	СтруктураРезультат.Вставить("КоличествоРабочихДнейПоДокументу", 0);
	СтруктураРезультат.Вставить("КоличествоКалендарныхДнейПоДокументу", 0);
	СтруктураРезультат.Вставить("ИспользоватьОстатокДнейЗаГод", Ложь);
	СтруктураРезультат.Вставить("ВыходныеДни", Новый Массив);
	СтруктураРезультат.Вставить("ПериодБезРазрыва", Ложь);
	СтруктураРезультат.Вставить("ТекстПересечнияОстатка", "");
	СтруктураРезультат.Вставить("СообщенияОбОшибках", Новый Массив);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЭтоОбъект = Ложь;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ОплатаДнейУходаЗаДетьмиИнвалидами") Тогда
		ТекущаяСсылка = Документ;
		КлючДанных = Документ;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ОплатаДнейУходаЗаДетьмиИнвалидамиДниУхода.Дата КАК Дата,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.Ссылка КАК ДокументОплаты,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.ФизическоеЛицо КАК ФизическоеЛицо,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.Сотрудник КАК Сотрудник,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.ДатаНачала КАК ДатаНачала,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.ДатаОкончания КАК ДатаОкончания,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.ИсправленныйДокумент КАК ИсправленныйДокумент,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.НомерПервичногоДокумента КАК НомерПервичногоДокумента
			|ПОМЕСТИТЬ ДниДокумента
			|ИЗ
			|	Документ.ОплатаДнейУходаЗаДетьмиИнвалидами.ДниУхода КАК ОплатаДнейУходаЗаДетьмиИнвалидамиДниУхода
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОплатаДнейУходаЗаДетьмиИнвалидами КАК ОплатаДнейУходаЗаДетьмиИнвалидами
			|		ПО ОплатаДнейУходаЗаДетьмиИнвалидамиДниУхода.Ссылка = ОплатаДнейУходаЗаДетьмиИнвалидами.Ссылка
			|ГДЕ
			|	ОплатаДнейУходаЗаДетьмиИнвалидами.Ссылка = &Ссылка
			|	И ОплатаДнейУходаЗаДетьмиИнвалидами.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|	И ОплатаДнейУходаЗаДетьмиИнвалидами.ФизическоеЛицо <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДниДокумента.ФизическоеЛицо КАК ФизическоеЛицо,
			|	ДниДокумента.Сотрудник КАК Сотрудник,
			|	ДниДокумента.ДатаНачала КАК ДатаНачала,
			|	ДниДокумента.ДатаОкончания КАК ДатаОкончания,
			|	ДниДокумента.ИсправленныйДокумент КАК ИсправленныйДокумент,
			|	ДниДокумента.ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод
			|ИЗ
			|	ДниДокумента КАК ДниДокумента";
		Запрос.УстановитьПараметр("Ссылка", Документ);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат СтруктураРезультат;
		КонецЕсли;
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			КонецМесяца = КонецМесяца(Выборка.ДатаОкончания);
			НачалоГода = НачалоГода(Выборка.ДатаНачала);
			Запрос.УстановитьПараметр("ФизическоеЛицо", Выборка.ФизическоеЛицо);
			Запрос.УстановитьПараметр("Сотрудник",		Выборка.Сотрудник);
			Запрос.УстановитьПараметр("НачалоГода",		НачалоГода);
			Запрос.УстановитьПараметр("НачалоМесяца",	НачалоМесяца(Выборка.ДатаНачала));
			Запрос.УстановитьПараметр("КонецМесяца",	КонецМесяца);
			Запрос.УстановитьПараметр("ДатаНачала",		Выборка.ДатаНачала);
			Запрос.УстановитьПараметр("ДатаОкончания",	Выборка.ДатаОкончания);
			Запрос.УстановитьПараметр("Исправление",	Выборка.ИсправленныйДокумент);
			
			СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = Выборка.ИспользоватьОстатокДнейЗаГод;
		КонецЕсли;
	Иначе
		ЭтоОбъект = ТипЗнч(Документ) = Тип("ДокументОбъект.ОплатаДнейУходаЗаДетьмиИнвалидами");
		Если ЭтоОбъект Тогда
			КлючДанных = Документ;
		Иначе
			КлючДанных = Документ.Ссылка;
		КонецЕсли;
		КоличествоРабочихДней = Документ.ДниУхода.Количество();
		Если Не ЗначениеЗаполнено(Документ.Сотрудник) Или Не ЗначениеЗаполнено(Документ.ФизическоеЛицо)
			Или Документ.ДниУхода.Количество() = 0 Тогда
			Возврат СтруктураРезультат;
		КонецЕсли;
		ТекущаяСсылка = Документ.Ссылка;
		КонецМесяца = КонецМесяца(Документ.ДатаОкончания);
		НачалоГода = НачалоГода(Документ.ДатаНачала);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ДниДокумента.Дата КАК Дата,
			|	&Ссылка КАК ДокументОплаты,
			|	&ФизическоеЛицо КАК ФизическоеЛицо,
			|	&Сотрудник КАК Сотрудник,
			|	&ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод,
			|	&ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
			|	&НомерПервичногоДокумента КАК НомерПервичногоДокумента,
			|	&ДатаНачала КАК ДатаНачала,
			|	&ДатаОкончания КАК ДатаОкончания
			|ПОМЕСТИТЬ ДниДокумента
			|ИЗ
			|	&ДниДокумента КАК ДниДокумента
			|;";
		Запрос.УстановитьПараметр("Ссылка",			Документ.Ссылка);
		Запрос.УстановитьПараметр("ФизическоеЛицо", Документ.ФизическоеЛицо);
		Запрос.УстановитьПараметр("Сотрудник",		Документ.Сотрудник);
		Запрос.УстановитьПараметр("НачалоГода",		НачалоГода(Документ.ДатаНачала));
		Запрос.УстановитьПараметр("НачалоМесяца",	НачалоМесяца(Документ.ДатаНачала));
		Запрос.УстановитьПараметр("КонецМесяца",	КонецМесяца);
		Запрос.УстановитьПараметр("ДатаНачала",		Документ.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",	Документ.ДатаОкончания);
		Запрос.УстановитьПараметр("ДниДокумента",	Документ.ДниУхода.Выгрузить());
		Запрос.УстановитьПараметр("Исправление",	Документ.ИсправленныйДокумент);
		Запрос.УстановитьПараметр("ДатаПервичногоДокумента",	Документ.ДатаПервичногоДокумента);
		Запрос.УстановитьПараметр("НомерПервичногоДокумента",	Документ.НомерПервичногоДокумента);
		Запрос.УстановитьПараметр("ИспользоватьОстатокДнейЗаГод",	Документ.ИспользоватьОстатокДнейЗаГод);
		Запрос.Выполнить();
		
		СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = Документ.ИспользоватьОстатокДнейЗаГод;
	КонецЕсли;
	
	ЗарплатаКадрыОбщиеНаборыДанных.СоздатьВТПериоды(Запрос.МенеджерВременныхТаблиц, НачалоГода, КонецМесяца);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаДней.Дата КАК Дата,
		|	Шапка.Ссылка КАК Ссылка,
		|	Шапка.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Шапка.Сотрудник КАК Сотрудник,
		|	Шапка.ДатаНачала КАК ДатаНачала,
		|	Шапка.ДатаОкончания КАК ДатаОкончания,
		|	Шапка.ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод,
		|	Шапка.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	Шапка.НомерПервичногоДокумента КАК НомерПервичногоДокумента
		|ПОМЕСТИТЬ ДниЗаГод
		|ИЗ
		|	Документ.ОплатаДнейУходаЗаДетьмиИнвалидами КАК Шапка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОплатаДнейУходаЗаДетьмиИнвалидами.ДниУхода КАК ТаблицаДней
		|		ПО Шапка.Ссылка = ТаблицаДней.Ссылка
		|			И (ТаблицаДней.Дата МЕЖДУ &НачалоГода И &КонецМесяца)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОплатаДнейУходаЗаДетьмиИнвалидами КАК Шапка2
		|		ПО Шапка.Ссылка = Шапка2.ИсправленныйДокумент
		|			И (Шапка2.Проведен
		|				ИЛИ Шапка2.Ссылка = &Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СторнированиеНачислений КАК Сторнирование
		|		ПО Шапка.Ссылка = Сторнирование.СторнируемыйДокумент
		|			И (Сторнирование.Проведен)
		|ГДЕ
		|	Шапка.ФизическоеЛицо = &ФизическоеЛицо
		|	И Шапка.Проведен
		|	И Шапка.Ссылка <> &Ссылка
		|	И Шапка.Ссылка <> &Исправление
		|	И Шапка2.Ссылка ЕСТЬ NULL
		|	И Сторнирование.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДниДокумента.Дата,
		|	ДниДокумента.ДокументОплаты,
		|	ДниДокумента.ФизическоеЛицо,
		|	ДниДокумента.Сотрудник,
		|	ДниДокумента.ДатаНачала,
		|	ДниДокумента.ДатаОкончания,
		|	ДниДокумента.ИспользоватьОстатокДнейЗаГод,
		|	ДниДокумента.ДатаПервичногоДокумента,
		|	ДниДокумента.НомерПервичногоДокумента
		|ИЗ
		|	ДниДокумента КАК ДниДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДниЗаГод.Дата КАК Дата,
		|	ДниЗаГод.Ссылка КАК Ссылка,
		|	ДниЗаГод.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДниЗаГод.Сотрудник КАК Сотрудник,
		|	ДниЗаГод.ДатаНачала КАК ДатаНачала,
		|	ДниЗаГод.ДатаОкончания КАК ДатаОкончания,
		|	ДниЗаГод.ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод
		|ПОМЕСТИТЬ ВсеДни
		|ИЗ
		|	ДниЗаГод КАК ДниЗаГод
		|ГДЕ
		|	ДниЗаГод.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДниЗаГодОстаток.Дата,
		|	ДниЗаГодОстаток.Ссылка,
		|	ДниЗаГодОстаток.ФизическоеЛицо,
		|	ДниЗаГодОстаток.Сотрудник,
		|	ДниЗаГодОстаток.ДатаНачала,
		|	ДниЗаГодОстаток.ДатаОкончания,
		|	ДниЗаГодОстаток.ИспользоватьОстатокДнейЗаГод
		|ИЗ
		|	ДниЗаГод КАК ДниЗаГодОстаток
		|ГДЕ
		|	ДниЗаГодОстаток.ДатаНачала <= &КонецМесяца
		|	И ДниЗаГодОстаток.ДатаОкончания >= &НачалоМесяца
		|	И ДниЗаГодОстаток.ИспользоватьОстатокДнейЗаГод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СотрудникиДокументов.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СотрудникиДокументов.Сотрудник КАК Сотрудник,
		|	МАКСИМУМ(СотрудникиДокументов.ДатаОкончания) КАК ДатаОкончания
		|ПОМЕСТИТЬ ВсеСотрудники
		|ИЗ
		|	ДниЗаГод КАК СотрудникиДокументов
		|
		|СГРУППИРОВАТЬ ПО
		|	СотрудникиДокументов.ФизическоеЛицо,
		|	СотрудникиДокументов.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВсеСотрудники.Сотрудник КАК Сотрудник,
		|	&НачалоГода КАК ДатаНачала,
		|	ВсеСотрудники.ДатаОкончания КАК ДатаОкончания,
		|	ВТПериоды.Период КАК Месяц,
		|	НАЧАЛОПЕРИОДА(&ДатаОкончания, МЕСЯЦ) КАК ДатаАктуальности
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	ВТПериоды КАК ВТПериоды,
		|	ВсеСотрудники КАК ВсеСотрудники";
	Запрос.Выполнить();
	
	ПараметрыПолученияДанных = УчетРабочегоВремениРасширенный.ПараметрыДляСоздатьВТПлановоеВремяСотрудников();
	УчетРабочегоВремениРасширенный.СоздатьВТПлановоеВремя(Запрос.МенеджерВременныхТаблиц, Ложь, ПараметрыПолученияДанных);
	
	ВидыВремени = Новый Массив;
	ВидыВремени.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.Явка"));
	ВидыВремени.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РаботаНочныеЧасы"));
	Запрос.УстановитьПараметр("ВидыВремени", ВидыВремени);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПлановоеВремя.Дата КАК Дата,
	|	ВсеДни.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВсеДни.Ссылка КАК Ссылка,
	|	ВсеДни.ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод
	|ПОМЕСТИТЬ ДниПоДокументам
	|ИЗ
	|	ВсеДни КАК ВсеДни
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПлановоеВремя КАК ВТПлановоеВремя
	|		ПО ВсеДни.Дата = ВТПлановоеВремя.Дата
	|			И ВсеДни.Сотрудник = ВТПлановоеВремя.Сотрудник
	|ГДЕ
	|	ВТПлановоеВремя.ЧасыНорма > 0
	|	И ВТПлановоеВремя.ВидУчетаВремени В(&ВидыВремени)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ДниПоДокументам.Дата) КАК ДатаНачала,
	|	МАКСИМУМ(ДниПоДокументам.Дата) КАК ДатаОкончания
	|ПОМЕСТИТЬ ИнтервалПоФизическомуЛицу
	|ИЗ
	|	ДниПоДокументам КАК ДниПоДокументам
	|ГДЕ
	|	ДниПоДокументам.ИспользоватьОстатокДнейЗаГод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДниЗаГод.Дата КАК Дата,
	|	ДниЗаГод.Сотрудник КАК Сотрудник,
	|	ДниЗаГод.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ДатыУходаЗаГод
	|ИЗ
	|	ДниЗаГод КАК ДниЗаГод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДниЗаГод.Ссылка КАК Ссылка,
	|	ДниЗаГод.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ДниЗаГод.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ДниЗаГод.ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод,
	|	ДниДокумента.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ДниЗаГод.Дата КАК Дата
	|ИЗ
	|	ДниЗаГод КАК ДниЗаГод
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДниДокумента КАК ДниДокумента
	|		ПО ДниЗаГод.ФизическоеЛицо = ДниДокумента.ФизическоеЛицо
	|			И ДниЗаГод.ДатаПервичногоДокумента = ДниДокумента.ДатаПервичногоДокумента
	|			И ДниЗаГод.НомерПервичногоДокумента = ДниДокумента.НомерПервичногоДокумента
	|			И (ДниДокумента.НомерПервичногоДокумента <> """")
	|ИТОГИ
	|	МАКСИМУМ(НомерПервичногоДокумента),
	|	МАКСИМУМ(ИспользоватьОстатокДнейЗаГод),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Дата)
	|ПО
	|	ФизическоеЛицо,
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ВсеДни.Дата, МЕСЯЦ) КАК Месяц,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВсеДни.Дата) КАК ЕжемесечноеКоличествоДней
	|ИЗ
	|	ВсеДни КАК ВсеДни
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДниДокумента КАК ДниДокумента
	|		ПО ВсеДни.ФизическоеЛицо = ДниДокумента.ФизическоеЛицо
	|			И ВсеДни.Дата = ДниДокумента.Дата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДниДокумента КАК ДниДокументаМесяц
	|		ПО (НАЧАЛОПЕРИОДА(ВсеДни.Дата, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ДниДокументаМесяц.Дата, МЕСЯЦ))
	|ГДЕ
	|	НЕ ВсеДни.ИспользоватьОстатокДнейЗаГод
	|	И ДниДокумента.Дата ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ВсеДни.Дата, МЕСЯЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДниДокумента.Дата КАК Дата,
	|	ВсеДни.Ссылка КАК Ссылка,
	|	ВсеДни.ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод
	|ИЗ
	|	ДниДокумента КАК ДниДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеДни КАК ВсеДни
	|		ПО ДниДокумента.Дата = ВсеДни.Дата
	|			И ДниДокумента.ДокументОплаты <> ВсеДни.Ссылка
	|ИТОГИ
	|	МАКСИМУМ(ИспользоватьОстатокДнейЗаГод)
	|ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДниДокумента.Дата) КАК КоличествоДней
	|ИЗ
	|	ДниДокумента КАК ДниДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДатыУходаЗаГод КАК ДатыУходаЗаГод
	|		ПО ДниДокумента.Дата = ДатыУходаЗаГод.Дата
	|			И (ДатыУходаЗаГод.Ссылка <> &Ссылка)
	|ГДЕ
	|	ДатыУходаЗаГод.Дата ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПлановоеВремя.Дата КАК Дата
	|ИЗ
	|	ВТПлановоеВремя КАК ВТПлановоеВремя
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДниДокумента КАК ДниДокумента
	|		ПО ВТПлановоеВремя.Дата >= ДниДокумента.ДатаНачала
	|			И ВТПлановоеВремя.Дата <= ДниДокумента.ДатаОкончания
	|			И ВТПлановоеВремя.Сотрудник = ДниДокумента.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДниДокумента КАК ДниДокументаДата
	|		ПО ВТПлановоеВремя.Дата = ДниДокументаДата.Дата
	|			И ВТПлановоеВремя.Сотрудник = ДниДокументаДата.Сотрудник
	|ГДЕ
	|	ВТПлановоеВремя.ЧасыНорма > 0
	|	И ВТПлановоеВремя.ВидУчетаВремени В(&ВидыВремени)
	|	И ДниДокументаДата.Дата ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеДниДокумента.Дата КАК Дата
	|ИЗ
	|	ДниДокумента КАК ВсеДниДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДниДокумента КАК ДниДокумента
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПлановоеВремя КАК ВТПлановоеВремя
	|			ПО ДниДокумента.Дата = ВТПлановоеВремя.Дата
	|				И ДниДокумента.Сотрудник = ВТПлановоеВремя.Сотрудник
	|				И (ВТПлановоеВремя.ЧасыНорма > 0)
	|				И (ВТПлановоеВремя.ВидУчетаВремени В (&ВидыВремени))
	|		ПО ВсеДниДокумента.Дата = ДниДокумента.Дата
	|ГДЕ
	|	ДниДокумента.Дата ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВсеДни.Дата) КАК КоличествоКалендарныхДней,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДниПоДокументам.Дата) КАК КоличествоРабочихДней
	|ИЗ
	|	ВсеДни КАК ВсеДни
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДниПоДокументам КАК ДниПоДокументам
	|		ПО ВсеДни.ФизическоеЛицо = ДниПоДокументам.ФизическоеЛицо
	|			И ВсеДни.Дата = ДниПоДокументам.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДниДокумента.Дата) КАК КоличествоКалендарныхДней,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДниПоДокументам.Дата) КАК КоличествоРабочихДней
	|ИЗ
	|	ВсеДни КАК ВсеДни
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДниПоДокументам КАК ДниПоДокументам
	|		ПО ВсеДни.ФизическоеЛицо = ДниПоДокументам.ФизическоеЛицо
	|			И ВсеДни.Дата = ДниПоДокументам.Дата
	|			И (ВсеДни.Ссылка = &Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДниДокумента КАК ДниДокумента
	|		ПО ВсеДни.Дата = ДниДокумента.Дата
	|			И ВсеДни.ФизическоеЛицо = ДниДокумента.ФизическоеЛицо
	|			И ВсеДни.Ссылка = ДниДокумента.ДокументОплаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВсеДни.Дата) КАК НакопленныеДни,
	|	МаксимальнаяДатаДокумента.Месяц КАК Месяц
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(ДниДокумента.Дата) КАК Дата,
	|		НАЧАЛОПЕРИОДА(ДниДокумента.Дата, МЕСЯЦ) КАК Месяц
	|	ИЗ
	|		ДниДокумента КАК ДниДокумента
	|	
	|	СГРУППИРОВАТЬ ПО
	|		НАЧАЛОПЕРИОДА(ДниДокумента.Дата, МЕСЯЦ)) КАК МаксимальнаяДатаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеДни КАК ВсеДни
	|		ПО МаксимальнаяДатаДокумента.Дата >= ВсеДни.Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	МаксимальнаяДатаДокумента.Месяц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДатыУходаЗаГод.Дата) КАК КоличествоДней
	|ИЗ
	|	ДатыУходаЗаГод КАК ДатыУходаЗаГод
	|ГДЕ
	|	ДатыУходаЗаГод.Ссылка <> &Ссылка";
	Пакет = Запрос.ВыполнитьПакет();
	ВсегоПакетов = Пакет.Количество();
	
	ДниЗаБезОстаткаЗаГод = Пакет[ВсегоПакетов - 9].Выгрузить();
	СтруктураРезультат.ПериодБезРазрыва = Пакет[ВсегоПакетов - 6].Выгрузить().Количество() = 0;
	СтруктураРезультат.ВыходныеДни = Пакет[ВсегоПакетов - 5].Выгрузить().ВыгрузитьКолонку("Дата");
	ДниПоФизическомуЛицу = Пакет[ВсегоПакетов - 4].Выгрузить();
	ДниПоТекущемуДокументу = Пакет[ВсегоПакетов - 3].Выгрузить();
	
	СтруктураРезультат.КоличествоРабочихДней = ДниПоФизическомуЛицу.Итог("КоличествоРабочихДней");
	СтруктураРезультат.КоличествоКалендарныхДней = ДниПоФизическомуЛицу.Итог("КоличествоКалендарныхДней");
	СтруктураРезультат.КоличествоРабочихДнейПоДокументу = ДниПоТекущемуДокументу.Итог("КоличествоРабочихДней");
	СтруктураРезультат.КоличествоКалендарныхДнейПоДокументу = ДниПоТекущемуДокументу.Итог("КоличествоКалендарныхДней");
	
	ИспользоватьОстатокДнейЗаГод = СтруктураРезультат.ИспользоватьОстатокДнейЗаГод; // Флаг документа до изменения
	ЕжемесячныеДни = ДниЗаБезОстаткаЗаГод.Итог("ЕжемесечноеКоличествоДней");
	ВсегоЕжемесячныхДней = ЕжемесячныеДни;
	
	ВыборкаПоФизлицу = Пакет[ВсегоПакетов - 10].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДнейПоПриказу = 0;
	МассивПоПриказу = Новый Массив;
	Пока ВыборкаПоФизлицу.Следующий() Цикл
		ВыборкаДокументовПоПиказу = ВыборкаПоФизлицу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДокументовПоПиказу.СледующийПоЗначениюПоля("Ссылка") Цикл
			Если ВыборкаДокументовПоПиказу.Ссылка <> ТекущаяСсылка
				И ВыборкаДокументовПоПиказу.ИспользоватьОстатокДнейЗаГод <> ИспользоватьОстатокДнейЗаГод Тогда
				ДнейПоПриказу = ВыборкаПоФизлицу.Дата;
				НомерПриказа = ВыборкаПоФизлицу.НомерПервичногоДокумента;
				Если ДнейПоПриказу > 4 И ИспользоватьОстатокДнейЗаГод Тогда
					МассивПоПриказу.Добавить(Новый Структура("Текст,Ссылка,ИспользоватьОстатокДнейЗаГод",
						СтрШаблон(НСтр("ru = 'Найден документ %1 с номером приказа %2, и не взведенным флагом ""Использовать остаток дней за год"", значение флага должено совпадать во всех документах по одному приказу.'"),
							ВыборкаДокументовПоПиказу.Ссылка, НомерПриказа),
						ВыборкаДокументовПоПиказу.Ссылка, ВыборкаДокументовПоПиказу.ИспользоватьОстатокДнейЗаГод));
				ИначеЕсли ДнейПоПриказу > 4 И Не ИспользоватьОстатокДнейЗаГод Тогда
					СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = Истина;
				ИначеЕсли ДнейПоПриказу <= 4 И ИспользоватьОстатокДнейЗаГод Тогда
					СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = Ложь;
				Иначе
					МассивПоПриказу.Добавить(Новый Структура("Текст,Ссылка,ИспользоватьОстатокДнейЗаГод",
						СтрШаблон(НСтр("ru = 'Найден документ %1 с номером приказа %2, и взведенным флагом ""Использовать остаток дней за год"", значение флага должено совпадать во всех документах по одному приказу.'"),
							ВыборкаДокументовПоПиказу.Ссылка, НомерПриказа),
						ВыборкаДокументовПоПиказу.Ссылка, ВыборкаДокументовПоПиказу.ИспользоватьОстатокДнейЗаГод));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ДнейПоПриказу = 0 Тогда
		Если (ЕжемесячныеДни + СтруктураРезультат.КоличествоКалендарныхДнейПоДокументу) > 4 Тогда
			СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = Истина;
		Иначе
			СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = Ложь;
			ВсегоЕжемесячныхДней = ЕжемесячныеДни + ?(ИспользоватьОстатокДнейЗаГод, 0, СтруктураРезультат.КоличествоКалендарныхДнейПоДокументу);
		КонецЕсли;
		
		Если СтруктураРезультат.КоличествоКалендарныхДней <= 4
			Или (Не ИспользоватьОстатокДнейЗаГод И ВсегоЕжемесячныхДней <= 4
				И СтруктураРезультат.КоличествоКалендарныхДнейПоДокументу <= 4) Тогда
			// Проверка на излишне взведенный флаг в других документах при пересечении дат с текущим.
			ВыборкаСсылка = Пакет[ВсегоПакетов - 8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаСсылка.Следующий() Цикл
				Если ВыборкаСсылка.ИспользоватьОстатокДнейЗаГод Тогда
					Текст = СтрШаблон(НСтр("ru = 'В документе %1 необходимо снять флаг ""Использовать остаток дней за год"".'"),
						ВыборкаСсылка.Ссылка);
					ДобавитьСообщение(СтруктураРезультат.СообщенияОбОшибках, Текст, ВыборкаСсылка.Ссылка);
				КонецЕсли;
			КонецЦикла;
			Возврат СтруктураРезультат;
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураРезультат.КоличествоКалендарныхДней - ВсегоЕжемесячныхДней > 24 Тогда
		Текст = СтрШаблон(НСтр("ru = 'Использованно более 24 дней по физическому лицу - (%1).'"),
			ПредставлениеКоличестваДней(СтруктураРезультат.КоличествоКалендарныхДней - ВсегоЕжемесячныхДней));
		ДобавитьСообщение(СтруктураРезультат.СообщенияОбОшибках, Текст, КлючДанных, "Объект.ДатаОкончания", ЭтоОбъект, Отказ);
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	// Проверка лимита в 4 дня по месяцам
	ЕстьПревышение = Ложь;
	ДнейПоМесяцам = Пакет[ВсегоПакетов - 2].Выгрузить();
	Для Каждого СтрокаМесяца Из ДнейПоМесяцам Цикл
		Если СтрокаМесяца.НакопленныеДни > 4 Тогда
			ЕстьПревышение = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = ЕстьПревышение Или ДнейПоПриказу > 4;
	
	// Пересечение дат документов без взведенного флага с остатком за год.
	ВыборкаСсылка = Пакет[ВсегоПакетов - 8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСсылка.Следующий() Цикл
		Если СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = ВыборкаСсылка.ИспользоватьОстатокДнейЗаГод Тогда
			Продолжить;
		ИначеЕсли Не СтруктураРезультат.ИспользоватьОстатокДнейЗаГод И ВыборкаСсылка.ИспользоватьОстатокДнейЗаГод Тогда
			СтруктураРезультат.ТекстПересечнияОстатка = 
				НСтр("ru = 'Найдено пересечение дат (%1) с документом %2 , необходимо взвести флаг ""Использовать остаток дней за год"".'")
		КонецЕсли;
		Выборка = ВыборкаСсылка.Выбрать();
		ДниПересечения = "";
		Пока Выборка.Следующий() Цикл
			ДниПересечения = ДниПересечения + Формат(Выборка.Дата, "ДФ=dd.MM") + ", ";
		КонецЦикла;
		ДниПересечения = Лев(ДниПересечения, СтрДлина(ДниПересечения) - 2);
		Если ПустаяСтрока(СтруктураРезультат.ТекстПересечнияОстатка) Тогда
			Текст = СтрШаблон(НСтр("ru = 'Найдено пересечение дат (%1) с документом %2, необходимо взвести флаг ""Использовать остаток дней за год"" во всех документах.'"),
				ДниПересечения, ВыборкаСсылка.Ссылка);
			ДобавитьСообщение(СтруктураРезультат.СообщенияОбОшибках, Текст, ВыборкаСсылка.Ссылка);
		Иначе
			СтруктураРезультат.ТекстПересечнияОстатка = СтрШаблон(
				СтруктураРезультат.ТекстПересечнияОстатка, ДниПересечения, ВыборкаСсылка.Ссылка);
			СтруктураРезультат.ИспользоватьОстатокДнейЗаГод = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтруктураЗначения Из МассивПоПриказу Цикл
		Если СтруктураЗначения.ИспользоватьОстатокДнейЗаГод <> СтруктураРезультат.ИспользоватьОстатокДнейЗаГод Тогда
			ДобавитьСообщение(СтруктураРезультат.СообщенияОбОшибках, СтруктураЗначения.Текст, СтруктураЗначения.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если Не СтруктураРезультат.ИспользоватьОстатокДнейЗаГод Тогда
		// Интервалы по месяцам не прывышают 4 дней
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	// Проверка остатка дней за год
	ИспользованоРанее = Пакет[ВсегоПакетов - 1].Выгрузить().Итог("КоличествоДней");
	НеУчтенныеДниДокумента = Пакет[ВсегоПакетов - 7].Выгрузить().Итог("КоличествоДней");
	
	Доступно = Месяц(КонецМесяца) * 4;
	Остаток = Доступно - ИспользованоРанее;
	Если Остаток < НеУчтенныеДниДокумента Тогда
		Дополнение = "";
		Если НеУчтенныеДниДокумента <> СтруктураРезультат.КоличествоКалендарныхДнейПоДокументу Тогда
			Дополнение = НСтр("ru = ', с учетом всех мест работы'");
		КонецЕсли;
		Текст = СтрШаблон(
			НСтр("ru = 'Превышен остаток дней в год. По состоянию на %1 доступно %2, использовано ранее %3, остаток (%4) меньше требуемого количества: %5%6.'"),
				Формат(КонецМесяца, "ДЛФ=D"), ПредставлениеКоличестваДней(Доступно),
				ПредставлениеКоличестваДней(ИспользованоРанее),
				ПредставлениеКоличестваДней(Остаток),
				ПредставлениеКоличестваДней(НеУчтенныеДниДокумента),
				Дополнение);
		ДобавитьСообщение(СтруктураРезультат.СообщенияОбОшибках, Текст, КлючДанных, "Объект.ДатаОкончания", ЭтоОбъект, Отказ);
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	Возврат СтруктураРезультат;
Конецфункции

Функция ПредставлениеКоличестваДней(КоличествоДнейЧислом) Экспорт
	Если КоличествоДнейЧислом = 0 Тогда
		Возврат НСтр("ru = '0 дней'");
	Иначе
		Возврат СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru = ';%1 день;;%1 дня;%1 дней;'"),
			КоличествоДнейЧислом);
	КонецЕсли;
КонецФункции

Процедура ДобавитьСообщение(МассивСообщений, ТекстСообщения, КлючДанных, Поле = "", ЭтоОбъект = Ложь, Отказ = Ложь, ПутьКДанным = "")
	МассивСообщений.Добавить(ОбщегоНазначенияСлужебныйКлиентСервер.СообщениеПользователю(ТекстСообщения,
		КлючДанных, Поле, ПутьКДанным, Отказ, ЭтоОбъект));
КонецПроцедуры

#КонецОбласти

#Область Заполнение

Функция ПараметрыЗаполнения() Экспорт
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ДниУхода", Новый Массив);
	ПараметрыЗаполнения.Вставить("ЗаполнитьУчитыватьМРОТПриОплатеПоСреднемуЗаработку", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПланируемуюДатуВыплаты", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьОтветственныхЛиц", Истина);
	ПараметрыЗаполнения.Вставить("ВыводитьСообщения", Истина);
	ПараметрыЗаполнения.Вставить("Результат", ПустойРезультатЗаполнения());
	Возврат ПараметрыЗаполнения;
КонецФункции

Функция ПолучитьРебенка(ФизическоеЛицо, ДатаСобытия) Экспорт
	КодыРодства = Новый Массив;
	КодыРодства.Добавить("05"); // Сын
	КодыРодства.Добавить("06"); // Дочь
	КодыРодства.Добавить("09"); // Внук
	КодыРодства.Добавить("10"); // Внучка
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЕСТЬNULL(РодственникиФизическихЛиц.Ссылка, ЗНАЧЕНИЕ(Справочник.РодственникиФизическихЛиц.ПустаяССылка)) КАК Ребенок,
		|	ЕСТЬNULL(СведенияОбИнвалидностиФизическихЛиц.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК Период,
		|	ФизическиеЛица.Ссылка КАК Владелец
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РодственникиФизическихЛиц КАК РодственникиФизическихЛиц
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическоеЛицоРебенка
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОбИнвалидностиФизическихЛиц КАК СведенияОбИнвалидностиФизическихЛиц
		|				ПО ФизическоеЛицоРебенка.Ссылка = СведенияОбИнвалидностиФизическихЛиц.ФизическоеЛицо
		|					И (&ДатаСобытия МЕЖДУ СведенияОбИнвалидностиФизическихЛиц.Период И СведенияОбИнвалидностиФизическихЛиц.ДействуетДо)
		|			ПО РодственникиФизическихЛиц.СНИЛС = ФизическоеЛицоРебенка.СтраховойНомерПФР
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтепениРодстваФизическихЛиц КАК СтепениРодстваФизическихЛиц
		|			ПО РодственникиФизическихЛиц.СтепеньРодства = СтепениРодстваФизическихЛиц.Ссылка
		|				И (СтепениРодстваФизическихЛиц.Код В (&КодыРодства))
		|		ПО ФизическиеЛица.Ссылка = РодственникиФизическихЛиц.Владелец
		|ГДЕ
		|	ФизическиеЛица.Ссылка = &Владелец
		|	И РодственникиФизическихЛиц.ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И ДОБАВИТЬКДАТЕ(&ДатаСобытия, ГОД, -18) < ЕСТЬNULL(РодственникиФизическихЛиц.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Владелец", ФизическоеЛицо);
	Запрос.УстановитьПараметр("ДатаСобытия", ДатаСобытия);
	Запрос.УстановитьПараметр("КодыРодства", КодыРодства);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ребенок;
	КонецЕсли;
КонецФункции

Функция ПустойРезультатЗаполнения()
	РезультатЗаполнения = Новый Структура;
	РезультатЗаполнения.Вставить("Успех", Ложь);
	РезультатЗаполнения.Вставить("ПричинаОтказа", Неопределено);
	РезультатЗаполнения.Вставить("ОшибкиЗаполнения", Неопределено);
	Возврат РезультатЗаполнения;
КонецФункции

#КонецОбласти

#Область Расчет

// Формирует структуру параметров для расчета документа.
//
// Параметры:
//  Документ - ДокументОбъект - заполненный и готовый к расчету документ объект.
//  Форма - Форма - указывается если вызов идет из формы документа, иначе значения параметров заполняется по умолчанию.
//  РегистрацияНачисленийДоступна - Булево - указывается доступность расчета начислений по правам, если указана форма - значение будет полученно из формы.
// 
// Возвращаемое значение:
//  Структура - структура параметров для расчета документа.
//
Функция ПараметрыРасчета(Документ, Форма = Неопределено) Экспорт
	ИменаПолей = "ИспользуетсяРасчетЗарплаты,ОбязательныйРасчетНДФЛ,ОтложитьРасчетНалогаДоРасчетаЗарплатыВКонцеМесяца,
		|ОписаниеДокумента,ПерезаполнятьСреднийЗаработок,ОбновитьРасчетДенежногоСодержания,ЗаполнениеВыполнено,
		|НазначенияРасчетаДенежногоСодержания,РегистрацияНачисленийДоступна, ЗначениеФлажкаЭтоСреднечасовойЗаработокПолучено,
		|ОкончательныйРасчетНДФЛ,УникальныйИдентификатор";
	
	ПараметрыРасчета = Новый Структура(ИменаПолей);
	ПараметрыРасчета.Вставить("ВыводитьСообщения", Ложь);
	ПараметрыРасчета.Вставить("СохранятьИсправления", Истина);
	
	Если Форма = Неопределено Тогда
		РегистрацияНачисленийДоступна = ЗарплатаКадрыРасширенный.ПраваНаДокумент(Документ).ОграниченияНаУровнеЗаписей.ИзменениеБезОграничений;
		ПараметрыРасчета.ЗаполнениеВыполнено = Ложь;
		ПараметрыРасчета.ОкончательныйРасчетНДФЛ = Ложь;
		ПараметрыРасчета.ПерезаполнятьСреднийЗаработок = Ложь;
		ПараметрыРасчета.РегистрацияНачисленийДоступна = РегистрацияНачисленийДоступна;
		ПараметрыРасчета.ИспользуетсяРасчетЗарплаты = ПолучитьФункциональнуюОпцию("ИспользоватьРасчетЗарплатыРасширенная");
		ПараметрыРасчета.ЗначениеФлажкаЭтоСреднечасовойЗаработокПолучено = Ложь;
		ПараметрыРасчета.ОбязательныйРасчетНДФЛ = УчетНДФЛ.ДоходыУчитываютсяТолькоПоДатеВыплаты(Документ.ПланируемаяДатаВыплаты)
			Или УчетНДФЛРасширенный.ДоходыВУчетеНДФЛРегистрируютсяПоДатеВыплаты(Документ.ВидРасчета);
		ПараметрыРасчета.ОтложитьРасчетНалогаДоРасчетаЗарплатыВКонцеМесяца = Документ.ИсчислятьНалогПриОкончательномРасчете;
		ПараметрыРасчета.ОписаниеДокумента = ОписаниеДокумента(Документ, РегистрацияНачисленийДоступна);
		Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба") Тогда 
			Модуль = ОбщегоНазначения.ОбщийМодуль("РасчетДенежногоСодержания");
			Модуль.НазначенияРасчетаДенежногоСодержания(Документ.Ссылка);
			ПараметрыРасчета.ОбновитьРасчетДенежногоСодержания = Истина;
		Иначе
			ПараметрыРасчета.ОбновитьРасчетДенежногоСодержания = Ложь;
		КонецЕсли;
	Иначе
		ЗаполнитьЗначенияСвойств(ПараметрыРасчета, Форма, ИменаПолей);
	КонецЕсли;
	
	ПараметрыРасчета.Вставить("Результат", ПустойРезультатЗаполнения());
	
	Возврат ПараметрыРасчета;
КонецФункции

Процедура ОчиститьРассчитанныеДанные(Документ, ПерезаполнитьНачисления = Истина) Экспорт
	Если ПерезаполнитьНачисления Тогда
		Документ.Начисления.Очистить();
		Документ.НачисленияПерерасчет.Очистить();
		Документ.НачисленияПерерасчетНулевыеСторно.Очистить();
		Документ.РаспределениеПоТерриториямУсловиямТруда.Очистить();
		Документ.Показатели.Очистить();
	КонецЕсли;
	
	Документ.Удержания.Очистить();
	Документ.НДФЛ.Очистить();
	Документ.КорректировкиВыплаты.Очистить();
	Документ.ПримененныеВычетыНаДетейИИмущественные.Очистить();
	Документ.РаспределениеРезультатовУдержаний.Очистить();
КонецПроцедуры

Функция СтруктураРасчетаДенежногоСодержания(Документ, НазначенияРасчетаДенежногоСодержания, УникальныйИдентификатор = "") Экспорт
	ОбъектСтруктура = Новый Структура;
	ОбъектСтруктура.Вставить("Ссылка", Документ.Ссылка);
	ОбъектСтруктура.Вставить("Сотрудник", Документ.Сотрудник);
	ОбъектСтруктура.Вставить("Организация", Документ.Организация);
	ОбъектСтруктура.Вставить("ПериодРегистрации", Документ.ПериодРегистрации);
	ОбъектСтруктура.Вставить("ДатаНачалаСобытия", Документ.ДатаНачалаСобытия);
	ОбъектСтруктура.Вставить("ДенежноеСодержание", Документ.ДенежноеСодержание);
	ОбъектСтруктура.Вставить("ДенежноеСодержаниеФактическиеНачисления", Документ.ДенежноеСодержаниеФактическиеНачисления);
	ОбъектСтруктура.Вставить("КоэффициентыРаспределенияДенежногоСодержания", 
		Документ.КоэффициентыРаспределенияДенежногоСодержания);
	ОбъектСтруктура.Вставить("Показатели", Документ.Показатели);
	ОбъектСтруктура.Вставить("ПериодРасчетаСохраняемогоСодержанияНачало",
		Документ.ПериодРасчетаСреднегоЗаработкаНачало);
	ОбъектСтруктура.Вставить("ПериодРасчетаСохраняемогоСодержанияОкончание",
		Документ.ПериодРасчетаСреднегоЗаработкаОкончание);
	ОбъектСтруктура.Вставить("ФиксПериодРасчетаСохраняемогоСодержания", Документ.ФиксПериодРасчетаСреднегоЗаработка);
	ОбъектСтруктура.Вставить("СохраняемоеДенежноеСодержание", Документ.СохраняемоеДенежноеСодержание);
	ОбъектСтруктура.Вставить("НазначенияРасчетаДенежногоСодержания", НазначенияРасчетаДенежногоСодержания);
	ОбъектСтруктура.Вставить("ПериодРасчета", Документ.ПериодРегистрации);
	ОбъектСтруктура.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	Возврат ОбъектСтруктура;
КонецФункции

Функция Рассчитать(Документ, ПараметрыРасчета) Экспорт

	Если Не ЗначениеЗаполнено(Документ.ПериодРасчетаСреднегоЗаработкаНачало)
		Или Не ЗначениеЗаполнено(Документ.ПериодРасчетаСреднегоЗаработкаОкончание) Тогда
		ЗаполнитьПериодРасчетаСреднегоЗаработка(Документ, ПараметрыРасчета);
	Иначе
		Если Документ.РасчетДенежногоСодержания Тогда
			ОбновитьДанныеДляРасчетаСохраняемогоДенежногоСодержания(Документ, ПараметрыРасчета);
		Иначе
			Если ПараметрыРасчета.ПерезаполнятьСреднийЗаработок Тогда
				ОбновитьДанныеДляРасчетаСреднего(Документ, ПараметрыРасчета);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	МенеджерРасчета = РасчетЗарплатыРасширенный.СоздатьМенеджерРасчета(Документ.ПериодРегистрации, Документ.Организация);
	ЗаполнитьНастройкиМенеджераРасчета(Документ, МенеджерРасчета, ПараметрыРасчета);
	ЗаполнитьНачисления(Документ, МенеджерРасчета);
	ЗаполнитьПерерасчеты(Документ, МенеджерРасчета, ПараметрыРасчета);
	
	МенеджерРасчета.НастройкиБухучета.КоэффициентыСреднегоЗаработкаДокумента = 
		УчетСреднегоЗаработка.КоэффициентыРаспределенияСреднегоЗаработкаДокумента(Документ, ПараметрыРасчета.ОписаниеДокумента);
	МенеджерРасчета.НастройкиБухучета.КоэффициентыРаспределенияДенежногоСодержания =
		Документ.КоэффициентыРаспределенияДенежногоСодержания.Выгрузить();
	
	// Удержания (рассчитываем, если выплата в межрасчетный период).
	Если РасчетЗарплатыРасширенный.ЭтоМежрасчетнаяВыплата(Документ.ПорядокВыплаты) Тогда
		МенеджерРасчета.ЗаполнитьУдержанияСотрудникаЗаПериод(
			Документ.Сотрудник, Документ.ПериодРегистрации, КонецМесяца(Документ.ПериодРегистрации));
	КонецЕсли;
	
	// Выполняем пересчет коллекций документа.
	МенеджерРасчета.РассчитатьЗарплату();
	РасчетЗарплатыВДанныeОбъекта(Документ, МенеджерРасчета.Зарплата, ПараметрыРасчета);
	ПараметрыРасчета.Результат.Успех = Истина;
	
	Если ПараметрыРасчета.РегистрацияНачисленийДоступна Тогда
		Документ.Рассчитал = Пользователи.ТекущийПользователь();
		Документ.ДокументРассчитан = Истина;
	КонецЕсли;

	Возврат ПараметрыРасчета.Результат;
КонецФункции

Процедура РасчетЗарплатыВДанныeОбъекта(Документ, ДанныеМенеджераРасчета, ПараметрыРасчета)
	
	Описание = ПараметрыРасчета.ОписаниеДокумента.ОписанияТаблицДляРаспределенияРезультата;
	
	ТаблицыНачислений = РасчетДокументовБЗК.ТаблицыНачисленийДокумента();
	ТаблицыНачислений.Начисления = Документ.Начисления;
	ТаблицыНачислений.НачисленияПерерасчет = Документ.НачисленияПерерасчет;
	ТаблицыНачислений.НачисленияПерерасчетНулевыеСторно = Документ.НачисленияПерерасчетНулевыеСторно;
	ТаблицыНачислений.Показатели = Документ.Показатели;
	ТаблицыНачислений.РаспределениеПоСтатьям = Документ.РаспределениеРезультатовНачислений;
	ТаблицыНачислений.РаспределениеПоТерриториямУсловиямТруда = Документ.РаспределениеПоТерриториямУсловиямТруда;
	
	ОписаниеТаблиц = РасчетДокументовБЗК.ОписаниеТаблицНачисленийДокумента();
	ОписаниеТаблиц.Начисления = Описание.Начисления;
	ОписаниеТаблиц.НачисленияПерерасчет = Описание.НачисленияПерерасчет;
	ОписаниеТаблиц.НачисленияПерерасчетНулевыеСторно = ПараметрыРасчета.ОписаниеДокумента.ОписаниеТаблицыПерерасчетовНулевыеСторно;
	
	РасчетДокументовБЗК.РасчетЗарплатыНачисленияВДанныеОбъекта(
		ТаблицыНачислений, ДанныеМенеджераРасчета.Начисления, Документ.Организация, ОписаниеТаблиц);
	
	РасчетЗарплатыРасширенныйФормы.СортироватьПерерасчеты(Документ.НачисленияПерерасчет);
	
	ТаблицыУдержаний = РасчетДокументовБЗК.ТаблицыУдержанийДокумента();
	ТаблицыУдержаний.Удержания = Документ.Удержания;
	ТаблицыУдержаний.РаспределениеПоСтатьям = Документ.РаспределениеРезультатовУдержаний;
	ТаблицыУдержаний.Показатели = Документ.Показатели;
	
	ОписаниеТаблицУдержаний = РасчетДокументовБЗК.ОписаниеТаблицУдержанийДокумента();
	ОписаниеТаблицУдержаний.Удержания = Описание.Удержания;
	
	РасчетДокументовБЗК.РасчетЗарплатыУдержанияВДанныеОбъекта(
		ТаблицыУдержаний, ДанныеМенеджераРасчета.Удержания, ОписаниеТаблицУдержаний);
	
	ТаблицыНДФЛ = РасчетДокументовБЗК.ТаблицыНДФЛДокумента();
	ТаблицыНДФЛ.НДФЛ = Документ.НДФЛ;
	ТаблицыНДФЛ.Вычеты = Документ.ПримененныеВычетыНаДетейИИмущественные;
	ТаблицыНДФЛ.РаспределениеПоСтатьям = Документ.РаспределениеРезультатовУдержаний;
	ОписаниеТаблицыНДФЛ = Описание.НДФЛ;
	
	РасчетДокументовБЗК.РасчетЗарплатыНДФЛВДанныеОбъекта(ТаблицыНДФЛ, ДанныеМенеджераРасчета.НДФЛ, ОписаниеТаблицыНДФЛ);
	
	РасчетДокументовБЗК.РасчетЗарплатыКорректировкиВыплатыВДанныеОбъекта(
		Документ.КорректировкиВыплаты, ДанныеМенеджераРасчета.КорректировкиВыплаты, Документ.РаспределениеРезультатовУдержаний, Описание.КорректировкиВыплаты);
КонецПроцедуры

Процедура ОбновитьДанныеДляРасчетаСохраняемогоДенежногоСодержания(Документ, ПараметрыРасчета)
	Если НЕ ПараметрыРасчета.ОбновитьРасчетДенежногоСодержания Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба.РасчетДенежногоСодержания") Тогда
		СтруктураОбъекта = СтруктураРасчетаДенежногоСодержания(
			Документ, ПараметрыРасчета.НазначенияРасчетаДенежногоСодержания, ПараметрыРасчета.УникальныйИдентификатор);
		Модуль = ОбщегоНазначения.ОбщийМодуль("РасчетДенежногоСодержания");
		Модуль.ОбновитьДанныеСохраняемогоДенежногоСодержанияДокумента(СтруктураОбъекта,,, Документ);
	КонецЕсли;
	
	РассчитатьСреднийЗаработок(Документ, ПараметрыРасчета);
КонецПроцедуры

Процедура ЗаполнитьНастройкиМенеджераРасчета(Документ, МенеджерРасчета, ПараметрыРасчета)
	
	Если ЗначениеЗаполнено(Документ.ИсправленныйДокумент) Тогда
		ПараметрыИсправляемого = ИсправлениеДокументовЗарплатаКадры.ПараметрыИсправляемогоДокумента(
			Документ.Ссылка, СвойстваИсправляемогоДокумента(Документ.Ссылка));
		ИсправлениеРасчетовБЗК.НастроитьМенеджерРасчета(МенеджерРасчета, Документ.ИсправленныйДокумент,
			ПараметрыРасчета.ОписаниеДокумента, ПараметрыИсправляемого);
	КонецЕсли;
	
	МенеджерРасчета.ИсключаемыйРегистратор = Документ.Ссылка;
	МенеджерРасчета.НастройкиРасчета.РассчитыватьНачисления = Истина;
	МенеджерРасчета.НастройкиРасчета.РассчитыватьУдержания = 
		РасчетЗарплатыРасширенный.ЭтоМежрасчетнаяВыплата(Документ.ПорядокВыплаты);
	МенеджерРасчета.НастройкиРасчета.РассчитыватьНДФЛ = УчетНДФЛРасширенный.МежрасчетныйДокументИсчисляетНДФЛ(
		Документ.Организация, ПараметрыРасчета.ОтложитьРасчетНалогаДоРасчетаЗарплатыВКонцеМесяца, Документ.ПорядокВыплаты,
		ПараметрыРасчета.ОбязательныйРасчетНДФЛ, Документ.ПланируемаяДатаВыплаты);
	МенеджерРасчета.НастройкиРасчета.РассчитыватьКорректировкиВыплаты = Истина;
	МенеджерРасчета.НастройкиРасчета.СохранятьИсправления = ПараметрыРасчета.СохранятьИсправления;
	МенеджерРасчета.НастройкиРасчета.Сотрудники = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ.Сотрудник);
	
	МенеджерРасчета.НастройкиУдержаний.РассчитыватьТолькоПоТекущемуДокументу = Истина;
	
	МенеджерРасчета.НастройкиНДФЛ.Сотрудники = Документ.ФизическоеЛицо;
	МенеджерРасчета.НастройкиНДФЛ.ДатаВыплаты = Документ.ПланируемаяДатаВыплаты;
	МенеджерРасчета.НастройкиНДФЛ.ОкончательныйРасчет = ПараметрыРасчета.ОкончательныйРасчетНДФЛ;
	
	МенеджерРасчета.ДобавитьДатуНачалаСобытия(Документ.Сотрудник, Документ.ДатаНачалаСобытия);
	
КонецПроцедуры

Процедура ЗаполнитьНачисления(Документ, МенеджерРасчета)
	
	ТаблицаНачислений = МенеджерРасчета.ТаблицаИсходныеДанныеНачисленияЗарплатыПоНачислениям();
	ТаблицаИнтервалов = ТаблицаИнтерваловОтсутствия(Документ.ДниУхода);
	
	// Показатели среднего заработка.
	Если Документ.РасчетДенежногоСодержания Тогда
		Показатель = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.СохраняемоеДенежноеСодержание");
		ЗначениеПоказателя = Документ.СохраняемоеДенежноеСодержание;
	Иначе
		Показатель = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.СреднийЗаработокОбщий");
		ЗначениеПоказателя = Документ.СреднийЗаработок;
	КонецЕсли;
	
	ЗначениеПоказателяУчитыватьМРОТ = ?(Документ.УчитыватьМРОТПриОплатеПоСреднемуЗаработку, 1, 0);
	ПоказательУчитыватьМРОТ = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.УчитыватьМРОТ");
	
	Для Каждого СтрокаИнтервалов Из ТаблицаИнтервалов Цикл
		
		НоваяСтрока = ТаблицаНачислений.Добавить();
		НоваяСтрока.Сотрудник = Документ.Сотрудник;
		НоваяСтрока.Начисление = Документ.ВидРасчета;
		НоваяСтрока.ДатаНачала = СтрокаИнтервалов.ДатаНачала;
		НоваяСтрока.ДатаОкончания = КонецДня(СтрокаИнтервалов.ДатаОкончания);
		МенеджерРасчета.ДобавитьИзвестноеЗначениеПоказателя(НоваяСтрока, Показатель, ЗначениеПоказателя);
		МенеджерРасчета.ДобавитьИзвестноеЗначениеПоказателя(НоваяСтрока, ПоказательУчитыватьМРОТ, ЗначениеПоказателяУчитыватьМРОТ);
		УчетСреднегоЗаработка.ДобавитьЗначенияПоказателейЧастичнойИндексации(Документ, МенеджерРасчета, НоваяСтрока);
		
	КонецЦикла;
	
	МенеджерРасчета.ЗаполнитьНачисленияСотрудникаЗаПериод(Документ.Сотрудник, ТаблицаНачислений);
	
КонецПроцедуры

Процедура ЗаполнитьПерерасчеты(Документ, МенеджерРасчета, ПараметрыРасчета)
	Если Не ИсправлениеДокументовРасчетЗарплаты.ДоначисленияРазрешены(МенеджерРасчета) Тогда
		Возврат;
	КонецЕсли;
	
	ИсходныеДанныеДляПерерасчета = ИсправлениеРасчетовБЗК.ИсходныеДанныеДляПерерасчетаИзРезультатаРасчета(
		МенеджерРасчета.Зарплата.Начисления);
	
	Если ЗначениеЗаполнено(Документ.ИсправленныйДокумент) Тогда
		ОписаниеТаблиц = Новый Массив;
		ОписаниеТаблиц.Добавить(ПараметрыРасчета.ОписаниеДокумента.ОписанияТаблицДляРаспределенияРезультата.Начисления);
		РезультатПерерасчета = ИсправлениеРасчетовБЗК.ДанныеПерерасчетаДляИсправления(
			Документ.Организация, Документ.ПериодРегистрации, ИсходныеДанныеДляПерерасчета, Документ.ИсправленныйДокумент,
			Документ.Ссылка, ПараметрыРасчета.ОписаниеДокумента, ОписаниеТаблиц, , Документ.ДоначислитьЗарплатуПриНеобходимости);
	Иначе
		РезультатПерерасчета = ИсправлениеРасчетовБЗК.ДанныеПерерасчета(
			Документ,
			ИсходныеДанныеДляПерерасчета,
			ПараметрыРасчета.ОписаниеДокумента);
	КонецЕсли;
	
	Если РезультатПерерасчета <> Неопределено Тогда
		ИсправлениеРасчетовБЗК.ДанныеПерерасчетаВМенеджерРасчета(РезультатПерерасчета, МенеджерРасчета);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РасчетаСреднегоЗаработка

Процедура ЗаполнитьПериодРасчетаСреднегоЗаработка(Документ, ПараметрыРасчета) Экспорт
	
	Если Не ПараметрыРасчета.ИспользуетсяРасчетЗарплаты Или Документ.ФиксПериодРасчетаСреднегоЗаработка
		Или Не ЗначениеЗаполнено(Документ.ДатаНачалаСобытия) Или Не ЗначениеЗаполнено(Документ.Сотрудник) Тогда
		// Период расчета среднего заработка установлен принудительно.
		Возврат;
	КонецЕсли;
	
	ПериодРасчетаСреднего = УчетСреднегоЗаработка.ПериодРасчетаОбщегоСреднегоЗаработкаСотрудника(
		Документ.ДатаНачалаСобытия, Документ.Сотрудник, Документ.ВидРасчета);
	
	Если НачалоМесяца(Документ.ПериодРасчетаСреднегоЗаработкаНачало) <> НачалоМесяца(ПериодРасчетаСреднего.ДатаНачала) 
		Или НачалоМесяца(Документ.ПериодРасчетаСреднегоЗаработкаОкончание) <> НачалоМесяца(ПериодРасчетаСреднего.ДатаОкончания) Тогда
		Документ.ПериодРасчетаСреднегоЗаработкаНачало = ПериодРасчетаСреднего.ДатаНачала;
		Документ.ПериодРасчетаСреднегоЗаработкаОкончание = ПериодРасчетаСреднего.ДатаОкончания;
		Если Документ.РасчетДенежногоСодержания Тогда
			ОбновитьДанныеДляРасчетаСохраняемогоДенежногоСодержания(Документ, ПараметрыРасчета);
		Иначе
			ОбновитьДанныеДляРасчетаСреднего(Документ, ПараметрыРасчета);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьДанныеДляРасчетаСреднего(Документ, ПараметрыРасчета)
	
	УстановитьПривилегированныйРежим(Истина);
	УчетСреднегоЗаработка.ОбновитьДанныеОбщегоСреднегоЗаработка(
		Новый Структура("ДанныеОНачислениях, ДанныеОВремени, ДанныеОбИндексации", 
			Документ.СреднийЗаработокОбщий, Документ.ОтработанноеВремяДляСреднегоОбщий, Документ.ДанныеОбИндексации),
		Документ.ДатаНачалаСобытия,
		Документ.ПериодРасчетаСреднегоЗаработкаНачало,
		Документ.ПериодРасчетаСреднегоЗаработкаОкончание,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ.Сотрудник), ,
		Документ.Ссылка);
	УстановитьПривилегированныйРежим(Ложь);
	
	РассчитатьСреднийЗаработок(Документ, ПараметрыРасчета);
	
КонецПроцедуры

Процедура РассчитатьСреднийЗаработок(Документ, ПараметрыРасчета)
	УстановитьПривилегированныйРежим(Истина);
	
	Если Документ.РасчетДенежногоСодержания Тогда
		Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба.РасчетДенежногоСодержания") Тогда
			Модуль = ОбщегоНазначения.ОбщийМодуль("РасчетДенежногоСодержания");
			Если ТипЗнч(Документ) = Тип("ДокументОбъект.ОплатаДнейУходаЗаДетьмиИнвалидами") Тогда
				Модуль.РассчитатьСохраняемоеДенежноеСодержаниеПоОбъекту(Документ, ПараметрыРасчета.ОписаниеДокумента);
			Иначе
				Модуль.РассчитатьСохраняемоеДенежноеСодержаниеДокумента(ПараметрыРасчета, ПараметрыРасчета.ОписаниеДокумента);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ДополнительныеПараметры = УчетСреднегоЗаработкаКлиентСервер.ДополнительныеПараметрыРасчетаСреднегоЗаработка();
		ДополнительныеПараметры.Индексации = Документ.ДанныеОбИндексации;
		ДополнительныеПараметры.ДатаНачалаСобытия = Документ.ДатаНачалаСобытия;
		ДополнительныеПараметры.НачалоПериода = Документ.ПериодРасчетаСреднегоЗаработкаНачало;
		ДополнительныеПараметры.ОкончаниеПериода = Документ.ПериодРасчетаСреднегоЗаработкаОкончание;
		ДополнительныеПараметры.ПоЧасам = ЭтоСреднечасовойЗаработок(Документ, ПараметрыРасчета);
		
		ЗначенияПоказателей = УчетСреднегоЗаработкаКлиентСервер.ЗначенияПоказателейСреднегоЗаработкаОбщего(
			Документ.СреднийЗаработокОбщий, Документ.ОтработанноеВремяДляСреднегоОбщий, ДополнительныеПараметры);
		Документ.СреднийЗаработок = ЗначенияПоказателей.СреднийЗаработокОбщий;
		
		Если ПолучитьФункциональнуюОпцию("ИндексироватьСреднийЗаработокЧастично") Тогда
			Документ.СреднийЗаработокИндексируемый = ЗначенияПоказателей.СреднийЗаработокИндексируемый;
			Документ.СреднийЗаработокНеиндексируемый = ЗначенияПоказателей.СреднийЗаработокНеиндексируемый;
		КонецЕсли;
		ОбновитьСреднедневнойЗаработок(Документ, ПараметрыРасчета);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ПараметрыРасчета.ЗаполнениеВыполнено = Истина;
КонецПроцедуры

Процедура ОбновитьСреднедневнойЗаработок(Документ, ПараметрыРасчета) Экспорт
	Если ЭтоСреднечасовойЗаработок(Документ, ПараметрыРасчета) Тогда
		ДополнительныеПараметры = УчетСреднегоЗаработкаКлиентСервер.ДополнительныеПараметрыРасчетаСреднегоЗаработка();
		ДополнительныеПараметры.Индексации = Документ.ДанныеОбИндексации;
		ДополнительныеПараметры.ДатаНачалаСобытия = Документ.ДатаНачалаСобытия;
		ДополнительныеПараметры.НачалоПериода = Документ.ПериодРасчетаСреднегоЗаработкаНачало;
		ДополнительныеПараметры.ОкончаниеПериода = Документ.ПериодРасчетаСреднегоЗаработкаОкончание;
		ДополнительныеПараметры.ПоЧасам = Ложь;
		Документ.СреднедневнойЗаработок = УчетСреднегоЗаработкаКлиентСервер.СреднийЗаработокОбщий(
			Документ.СреднийЗаработокОбщий,
			Документ.ОтработанноеВремяДляСреднегоОбщий,
			ДополнительныеПараметры);
	Иначе
		Документ.СреднедневнойЗаработок = Документ.СреднийЗаработок;
	КонецЕсли;
КонецПроцедуры

Функция ЭтоСреднечасовойЗаработок(Документ, ПараметрыРасчета) Экспорт
	Если Не ПараметрыРасчета.ЗначениеФлажкаЭтоСреднечасовойЗаработокПолучено Тогда
		ПараметрыРасчета.ЗначениеФлажкаЭтоСреднечасовойЗаработокПолучено = Истина;
		Документ.ЭтоСреднечасовойЗаработок = Ложь;
		Если ПараметрыРасчета.ИспользуетсяРасчетЗарплаты Тогда
			УстановитьПривилегированныйРежим(Истина);
			Документ.ЭтоСреднечасовойЗаработок = 
				УчетРабочегоВремениРасширенный.СотрудникуПрименяетсяСуммированныйУчетРабочегоВремени(
					Документ.Сотрудник,
					Документ.ДатаНачалаСобытия)
				Или УчетСреднегоЗаработка.НачислениеИспользуетСреднечасовойЗаработок(
					Документ.ВидРасчета);
		КонецЕсли;
	КонецЕсли;
	Если ПараметрыРасчета.ОписаниеДокумента.ЭтоСреднечасовойЗаработок <> Документ.ЭтоСреднечасовойЗаработок Тогда
		ПараметрыРасчета.ОписаниеДокумента = Новый ФиксированнаяСтруктура(
			ОписаниеДокумента(Документ, ПараметрыРасчета.РегистрацияНачисленийДоступна));
	КонецЕсли;
	Возврат Документ.ЭтоСреднечасовойЗаработок;
КонецФункции

#КонецОбласти

#Область ОписаниеДокумента

Функция ОписаниеДокумента(Документ, РегистрацияНачисленийДоступна = Истина) Экспорт
	
	Описание = РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеРасчетногоДокумента();
	Описание.НачисленияИмя = "Начисления";
	Описание.НачисленияПерерасчетИмя = "НачисленияПерерасчет";
	Описание.УдержанияИмя = "Удержания";
	Описание.НДФЛИмя = "НДФЛ";
	Описание.КорректировкиВыплатыИмя = "КорректировкиВыплаты";
	Описание.ПримененныеВычетыИмя = "ПримененныеВычетыНаДетейИИмущественные";
	Описание.МесяцНачисленияИмя = "ПериодРегистрации";
	Описание.ИменаПолейНачисления = "ВидРасчета,НачисленияНачисление";
	Описание.РегистрацияНачисленийДоступна = РегистрацияНачисленийДоступна;
	Описание.ЕстьОплатаПоСреднему = Истина;
	Описание.ЭтоСреднечасовойЗаработок = Документ.ЭтоСреднечасовойЗаработок;
	
	Описание.ОбязательныеПоля.Добавить(РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеОбязательногоПоляДокумента(НСтр("ru = 'Месяц'"), "МесяцНачисленияСтрокой"));
	Описание.ОбязательныеПоля.Добавить(РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеОбязательногоПоляДокумента(НСтр("ru = 'Сотрудник'"), "Объект.Сотрудник"));
	
	ОписанияТаблиц = Новый Структура;
	
	// Начисления.
	ОписаниеТаблицы = РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеТаблицыРасчета();
	ОписаниеТаблицы.ИмяТаблицы = "Начисления";
	ОписаниеТаблицы.ПутьКДанным = "Объект.Начисления";
	ОписаниеТаблицы.ИмяПоляДляВставкиПоказателей = "Месяц";
	ОписаниеТаблицы.ОтображатьПоляОписанияВремени = РегистрацияНачисленийДоступна;
	ОписаниеТаблицы.ИмяПоляДляВставкиРаспределенияРезультатов = "НачисленияРезультат";
	ОписаниеТаблицы.ВставлятьПослеПоля = Истина;
	ОписаниеТаблицы.ОтображатьПоляРаспределенияРезультатов = РегистрацияНачисленийДоступна;
	ОписаниеТаблицы.РаспределениеРезультатовЗависимыеТаблицы = "Начисления,Удержания,НДФЛ,КорректировкиВыплаты";
	ОписаниеТаблицы.ИмяРеквизитаПериод = "ПериодРегистрации";
	ОписаниеТаблицы.СодержитПолеКодВычета = Истина;
	ОписаниеТаблицы.СодержитПолеМестоПолученияДохода = Истина;
	ОписаниеТаблицы.СодержитПолеИсходныйДокумент = Истина;
	ОписанияТаблиц.Вставить("Начисления", ОписаниеТаблицы);
	
	// НачисленияПерерасчет.
	ОписаниеТаблицы = РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеТаблицыРасчета();
	ОписаниеТаблицы.ИмяТаблицы = "НачисленияПерерасчет";
	ОписаниеТаблицы.ПутьКДанным = "Объект.НачисленияПерерасчет";
	ОписаниеТаблицы.ИмяПоляДляВставкиПоказателей = "ДатыНачисленияПерерасчет";
	ОписаниеТаблицы.НомерТаблицы = 1;
	ОписаниеТаблицы.ОтображатьПоляОписанияВремени = РегистрацияНачисленийДоступна;
	ОписаниеТаблицы.ОтображатьПоляНормыВремени = РегистрацияНачисленийДоступна;
	ОписаниеТаблицы.ЭтоПерерасчеты = Истина;
	ОписаниеТаблицы.ИмяРеквизитаФиксСторно = "ФиксСторно";	
	ОписаниеТаблицы.ИмяПоляДляВставкиРаспределенияРезультатов = "НачисленияПерерасчетРезультат";
	ОписаниеТаблицы.ВставлятьПослеПоля = Истина;
	ОписаниеТаблицы.ОтображатьПоляРаспределенияРезультатов = РегистрацияНачисленийДоступна;
	ОписаниеТаблицы.РаспределениеРезультатовЗависимыеТаблицы = "НачисленияПерерасчет,Удержания,НДФЛ,КорректировкиВыплаты";
	ОписаниеТаблицы.ИмяРеквизитаПериод= "ПериодРегистрации";
	ОписаниеТаблицы.ИмяРеквизитаДокументОснование = "ДокументОснование";
	ОписаниеТаблицы.СодержитПолеМестоПолученияДохода = Истина;
	ОписаниеТаблицы.СодержитРегистраторРазовогоНачисления = Истина;
	ОписаниеТаблицы.СодержитПолеИсходныйДокумент = Истина;
	ОписанияТаблиц.Вставить("НачисленияПерерасчет", ОписаниеТаблицы);
	
	// Удержания.
	ОписаниеТаблицы = РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеТаблицыРасчета();
	ОписаниеТаблицы.ИмяТаблицы = "Удержания";
	ОписаниеТаблицы.ПутьКДанным = "Объект.Удержания";
	ОписаниеТаблицы.ИмяРеквизитаВидРасчета = "Удержание";
	ОписаниеТаблицы.ИмяРеквизитаСотрудник = "ФизическоеЛицо";
	ОписаниеТаблицы.НомерТаблицы = 2;
	ОписаниеТаблицы.ПутьКДаннымРаспределениеРезультатов = "Объект.РаспределениеРезультатовУдержаний";
	ОписаниеТаблицы.ОтображатьПоляРаспределенияРезультатов = Ложь;
	ОписанияТаблиц.Вставить("Удержания", ОписаниеТаблицы);
	
	// НДФЛ
	ОписаниеТаблицы = РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеТаблицыРасчета();
	ОписаниеТаблицы.ИмяТаблицы = "НДФЛ";
	ОписаниеТаблицы.ПутьКДанным = "Объект.НДФЛ";
	ОписаниеТаблицы.ИмяПоляРезультат = "Налог";
	ОписаниеТаблицы.НомерТаблицы = 3;
	ОписаниеТаблицы.СодержитПолеВидРасчета = Ложь;
	ОписаниеТаблицы.СодержитПолеСотрудник = Истина;
	ОписаниеТаблицы.ИмяРеквизитаСотрудник = "ФизическоеЛицо";
	ОписаниеТаблицы.ПутьКДаннымРаспределениеРезультатов = "Объект.РаспределениеРезультатовУдержаний";
	ОписаниеТаблицы.ИмяРеквизитаИдентификаторСтроки = "ИдентификаторСтрокиНДФЛ";
	ОписаниеТаблицы.ОтображатьПоляРаспределенияРезультатов = Ложь;
	ОписаниеТаблицы.ОтменятьВсеИсправления	= Истина;
	ОписанияТаблиц.Вставить("НДФЛ", ОписаниеТаблицы);
	
	// КорректировкиВыплаты.
	ОписанияТаблиц.Вставить("КорректировкиВыплаты", РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеТаблицыКорректировкиВыплаты());
	
	// ОписаниеТаблицыПерерасчетовНулевыеСторно.
	ОписаниеТаблицы = РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеТаблицыРасчета();
	ОписаниеТаблицы.ИмяТаблицы = "НачисленияПерерасчетНулевыеСторно";
	ОписаниеТаблицы.ПутьКДанным = "Объект.НачисленияПерерасчетНулевыеСторно";
	ОписаниеТаблицы.НомерТаблицы = 1.1;
	ОписаниеТаблицы.ЭтоПерерасчеты 	= Истина;
	ОписаниеТаблицы.ИмяРеквизитаФиксСторно = "ФиксСторно";
	ОписаниеТаблицы.ИмяРеквизитаПериод = "ПериодРегистрации";
	ОписаниеТаблицы.ИмяРеквизитаДокументОснование = "ДокументОснование";
	Описание.Вставить("ОписаниеТаблицыПерерасчетовНулевыеСторно", ОписаниеТаблицы);
	
	Описание.ОписанияТаблицДляРаспределенияРезультата = ОписанияТаблиц;
	
	Возврат Описание;
	
КонецФункции

Функция ПолучитьКонтролируемыеПоля() Экспорт
	
	НачисленияФиксРасчет = Новый Массив;
	НачисленияФиксРасчет.Добавить("Результат");
	
	НачисленияФиксРасчетВремени = Новый Массив;
	НачисленияФиксРасчетВремени.Добавить("ОплаченоДней");
	НачисленияФиксРасчетВремени.Добавить("ОплаченоЧасов");
	НачисленияФиксРасчетВремени.Добавить("НормаДней");
	НачисленияФиксРасчетВремени.Добавить("НормаЧасов");
	
	НачисленияФиксСтрока = Новый Массив;
	НачисленияФиксСтрока.Добавить("Сотрудник");
	НачисленияФиксСтрока.Добавить("Подразделение");
	НачисленияФиксСтрока.Добавить("Начисление");
	НачисленияФиксСтрока.Добавить("ДатаНачала");
	НачисленияФиксСтрока.Добавить("ДатаОкончания");
	
	НачисленияФиксЗаполнение = Новый Массив;
	НачисленияФиксЗаполнение.Добавить("МестоПолученияДохода");
	
	НачисленияПоля = Новый Структура("ФиксРасчет, ФиксЗаполнение, ФиксСтрока, ФиксРасчетВремени",
		НачисленияФиксРасчет,
		НачисленияФиксЗаполнение,
		НачисленияФиксСтрока,
		НачисленияФиксРасчетВремени);
	
	НачисленияПерерасчетПоля = Новый Структура("ФиксРасчет, ФиксЗаполнение, ФиксСтрока, ФиксРасчетВремени",
		НачисленияФиксРасчет,
		НачисленияФиксЗаполнение,
		НачисленияФиксСтрока,
		НачисленияФиксРасчетВремени);
			
	Возврат Новый Структура("Начисления, НачисленияПерерасчет, НДФЛ",
		НачисленияПоля,
		НачисленияПерерасчетПоля,
		УчетНДФЛРасширенный.КонтролируемыеПоляДляФиксацииРезультатов());
	
КонецФункции

#КонецОбласти

#Область ПодписиДокументов

Функция ОписаниеПодписейДокумента() Экспорт 
	ОписаниеПодписей = ПодписиДокументов.ОписаниеТаблицыПодписей();
	
	ОписаниеРеквизитов = ПодписиДокументов.ОписаниеРеквизитовПодписанта();
	ОписаниеРеквизитов.ФизическоеЛицо   = "Руководитель";
	ОписаниеРеквизитов.Должность        = "ДолжностьРуководителя";
	ОписаниеРеквизитов.ОснованиеПодписи = "ОснованиеПодписиРуководителя";
	ПереопределяемыеИмена = Новый Соответствие;
	ПереопределяемыеИмена.Вставить("Руководитель", ОписаниеРеквизитов);
	ПодписиДокументов.ДобавитьОписаниеПодписейОрганизации(ОписаниеПодписей, "Руководитель", ПереопределяемыеИмена);
	
	ОписаниеРеквизитов = ПодписиДокументов.ОписаниеРеквизитовПодписанта();
	ОписаниеРеквизитов.ФизическоеЛицо   = "ГлавныйБухгалтер";
	ОписаниеРеквизитов.Должность        = "ДолжностьГлавногоБухгалтера";
	ОписаниеРеквизитов.ОснованиеПодписи = "ОснованиеПодписиГлавногоБухгалтера";
	ПереопределяемыеИмена = Новый Соответствие;
	ПереопределяемыеИмена.Вставить("ГлавныйБухгалтер", ОписаниеРеквизитов);
