Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт

КонецПроцедуры

// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.МенеджерПечати = "Документ.ПродлениеСроковНоскиСИЗ";
	КомандаПечати.Идентификатор = "ПФ_MXL_АктОсмотраСИЗ";
	КомандаПечати.Представление = НСтр("ru = 'Акт осмотра СИЗ'");
	КомандаПечати.Порядок = 10;
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.МенеджерПечати = "Документ.ПродлениеСроковНоскиСИЗ";
	КомандаПечати.Идентификатор = "ПФ_MXL_ПриказОСозданииКомиссии";
	КомандаПечати.Представление = НСтр("ru = 'Приказ о создании комиссии'");
	КомандаПечати.Порядок = 20;
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

// Формирует печатные формы
//
// Параметры:
//  (входные)
//    МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//    ПараметрыПечати - Структура - дополнительные настройки печати;
//  (выходные)
//   КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы
//   ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                             представление - имя области в которой был выведен объект;
//   ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_АктОсмотраСИЗ") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"ПФ_MXL_АктОсмотраСИЗ",
			НСтр("ru = 'Акт осмотра СИЗ'"), ПечатьАктаОсмотраСИЗ(МассивОбъектов, ОбъектыПечати), ,
			"Документ.ПродлениеСроковНоскиСИЗ.ПФ_MXL_АктОсмотраСИЗ");
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ПриказОСозданииКомиссии") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"ПФ_MXL_ПриказОСозданииКомиссии",
			НСтр("ru = 'Приказ о создании комиссии'"), ПечатьПриказаОСозданииКомиссии(МассивОбъектов, ОбъектыПечати), ,
			"Документ.ПродлениеСроковНоскиСИЗ.ПФ_MXL_ПриказОСозданииКомиссии");
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьАктаОсмотраСИЗ(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПродлениеСроковНоскиСИЗ_РабочиеМеста";
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПродлениеСроковНоскиСИЗ.ПФ_MXL_АктОсмотраСИЗ");
	
	ДанныеДляПечати = ДанныеПечатиДокументов(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	Для Каждого ДанныеПечати Из ДанныеДляПечати Цикл
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();	
		КонецЕсли;
		
		ОписаниеДокумента = ДанныеПечати.Значение;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		// Формируем печатную форму продления.
		Результат = Новый ТабличныйДокумент;
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Заполнить(ОписаниеДокумента);
		ОбластьШапка.Параметры.Город = ?(ПустаяСтрока(ОписаниеДокумента.Город), "____________", ОписаниеДокумента.Город);
		
		ЧленыКомиссии = "";
		Для каждого ДанныеЧленаКомиссии Из ОписаниеДокумента.ЧленыКомиссии Цикл
			Если ПустаяСтрока(ЧленыКомиссии) Тогда
				ЧленыКомиссии = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 - %2'"),
					Строка(ДанныеЧленаКомиссии.ЧленКомиссии), Строка(ДанныеЧленаКомиссии.ДолжностьЧленаКомиссии));
			Иначе
				ЧленыКомиссии = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, %2 - %3'"),
					ЧленыКомиссии, Строка(ДанныеЧленаКомиссии.ЧленКомиссии), Строка(ДанныеЧленаКомиссии.ДолжностьЧленаКомиссии));
			КонецЕсли;
		КонецЦикла;
		ОбластьШапка.Параметры.ЧленыКомиссии = ЧленыКомиссии;
		Результат.Вывести(ОбластьШапка);
		
		ТаблицаСИЗ = ОписаниеДокумента.ТаблицаСИЗ;
		СотрудникСИЗ = Неопределено;
		Для Каждого СтрокаСИЗ Из ТаблицаСИЗ Цикл
			Если СтрокаСИЗ.ФизическоеЛицо <> СотрудникСИЗ Тогда
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			Иначе
				ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаОбъединенная");
			КонецЕсли;
			СотрудникСИЗ = СтрокаСИЗ.ФизическоеЛицо;
			ОбластьСтрока.Параметры.Заполнить(ОписаниеДокумента);
			ОбластьСтрока.Параметры.Заполнить(СтрокаСИЗ);
			Результат.Вывести(ОбластьСтрока);
		КонецЦикла;
		
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.Заполнить(ОписаниеДокумента);
		Результат.Вывести(ОбластьПодвал);
		
		ОбластьПодвалСтрока = Макет.ПолучитьОбласть("ПодвалСтрока");
		Для каждого ДанныеЧленаКомиссии Из ОписаниеДокумента.ЧленыКомиссии Цикл
			ОбластьПодвалСтрока.Параметры.ФИОЧленКомиссии = ДанныеЧленаКомиссии.ФИОЧленКомиссии;
			ОбластьПодвалСтрока.Параметры.Должность = ДанныеЧленаКомиссии.ДолжностьЧленаКомиссии;
			Результат.Вывести(ОбластьПодвалСтрока);
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(Результат);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ОписаниеДокумента.ДокументСсылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьПриказаОСозданииКомиссии(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПродлениеСроковНоскиСИЗ_ПриказОСозданииКомиссии";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПродлениеСроковНоскиСИЗ.ПФ_MXL_ПриказОСозданииКомиссии");
	
	ДанныеПечатиОбъектов = ДанныеПечатиДокументов(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеПечати Из ДанныеПечатиОбъектов Цикл
		
		// Документы нужно выводить на разных страницах.
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		Иначе
			ПервыйДокумент = Ложь;
		КонецЕсли;
		
		ДанныеДокумента = ДанныеПечати.Значение;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Заполнить(ДанныеДокумента);
		ОбластьШапка.Параметры.Город = ?(ПустаяСтрока(ДанныеДокумента.Город), "____________", ДанныеДокумента.Город);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ОбластьПредседатель = Макет.ПолучитьОбласть("Председатель");
		ОбластьПредседатель.Параметры.Заполнить(ДанныеДокумента);
		ТабличныйДокумент.Вывести(ОбластьПредседатель);
		
		ОбластьПервыйЧленКомиссии = Макет.ПолучитьОбласть("ПервыйЧленКомиссии");
		ОбластьЧленыКомиссии = Макет.ПолучитьОбласть("ЧленыКомиссии");
		ПервыйЧленКомиссии = Истина;
		Для каждого ДанныеЧленаКомиссии Из ДанныеДокумента.ЧленыКомиссии Цикл
			Если ПервыйЧленКомиссии Тогда
				ПервыйЧленКомиссии = Ложь;
				ОбластьПервыйЧленКомиссии.Параметры.ЧленКомиссии = ДанныеЧленаКомиссии.ЧленКомиссии;
				ОбластьПервыйЧленКомиссии.Параметры.Должность = ДанныеЧленаКомиссии.ДолжностьЧленаКомиссии;
				ТабличныйДокумент.Вывести(ОбластьПервыйЧленКомиссии);
			Иначе
				ОбластьЧленыКомиссии.Параметры.ЧленКомиссии = ДанныеЧленаКомиссии.ЧленКомиссии;
				ОбластьЧленыКомиссии.Параметры.Должность = ДанныеЧленаКомиссии.ДолжностьЧленаКомиссии;
				ТабличныйДокумент.Вывести(ОбластьЧленыКомиссии);
			КонецЕсли;
		КонецЦикла;
		
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.Заполнить(ДанныеДокумента);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		ОбластьПодвалСтрока = Макет.ПолучитьОбласть("ПодвалСтрока");
		Для каждого ДанныеЧленаКомиссии Из ДанныеДокумента.ЧленыКомиссии Цикл
			ОбластьПодвалСтрока.Параметры.ФИОЧленКомиссии = ДанныеЧленаКомиссии.ФИОЧленКомиссии;
			ОбластьПодвалСтрока.Параметры.Должность = ДанныеЧленаКомиссии.ДолжностьЧленаКомиссии;
			ТабличныйДокумент.Вывести(ОбластьПодвалСтрока);
		КонецЦикла;
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ключ);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ДанныеПечатиДокументов(МассивОбъектов)
	
	ДанныеПечатиОбъектов = Новый Соответствие;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПродлениеСроковНоскиСИЗ.Ссылка КАК ДокументСсылка,
		|	ПродлениеСроковНоскиСИЗКомиссия.ЧленКомиссии КАК ЧленКомиссии,
		|	ПродлениеСроковНоскиСИЗКомиссия.Должность КАК ДолжностьЧленаКомиссии,
		|	ПродлениеСроковНоскиСИЗКомиссия.РольВКомиссии КАК РольВКомиссии
		|ИЗ
		|	Документ.ПродлениеСроковНоскиСИЗ КАК ПродлениеСроковНоскиСИЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПродлениеСроковНоскиСИЗ.Комиссия КАК ПродлениеСроковНоскиСИЗКомиссия
		|		ПО ПродлениеСроковНоскиСИЗ.Ссылка = ПродлениеСроковНоскиСИЗКомиссия.Ссылка
		|ГДЕ
		|	ПродлениеСроковНоскиСИЗ.Ссылка В (&МассивОбъектов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Продление.Ссылка КАК ДокументСсылка,
		|	Продление.Номер,
		|	Продление.Дата,
		|	Продление.ДатаПриказа,
		|	Продление.НомерПриказа,
		|	Продление.Организация,
		|	Продление.Подразделение,
		|	Организации.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	Продление.Руководитель КАК Руководитель,
		|	Продление.ДолжностьРуководителя КАК ДолжностьРуководителя,
		|	Продление.Ответственный КАК Ответственный,
		|	ВЫБОР
		|		КОГДА ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА
		|			ИЗ
		|				Документ.ПродлениеСроковНоскиСИЗ.НоменклатураСИЗ КАК ПереченьСИЗ
		|			ГДЕ
		|				ПереченьСИЗ.Ссылка = Продление.Ссылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьСИЗ
		|ИЗ
		|	Документ.ПродлениеСроковНоскиСИЗ КАК Продление
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО Продление.Организация = Организации.Ссылка
		|ГДЕ
		|	Продление.Ссылка В (&МассивОбъектов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродлениеРабочиеМеста.Ссылка КАК ДокументСсылка,
		|	ПродлениеРабочиеМеста.РабочееМесто КАК РабочееМесто,
		|	ПродлениеРабочиеМеста.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПродлениеСроковНоскиСИЗ.СИЗ КАК СИЗ,
		|	ПродлениеСроковНоскиСИЗ.Номенклатура КАК Номенклатура,
		|	ПродлениеСроковНоскиСИЗ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ПродлениеСроковНоскиСИЗ.Количество КАК Количество,
		|	ПродлениеСроковНоскиСИЗ.НомерСтроки КАК НомерСтрокиСИЗ,
		|	ПродлениеСроковНоскиСИЗ.ПроцентИзноса КАК ПроцентИзноса,
		|	ПродлениеСроковНоскиСИЗ.Заключение КАК Заключение,
		|	ПродлениеРабочиеМеста.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Документ.ПродлениеСроковНоскиСИЗ.РабочиеМеста КАК ПродлениеРабочиеМеста
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПродлениеСроковНоскиСИЗ.НоменклатураСИЗ КАК ПродлениеСроковНоскиСИЗ
		|		ПО ПродлениеРабочиеМеста.Ссылка В (&МассивОбъектов)
		|		И ПродлениеРабочиеМеста.Ссылка = ПродлениеСроковНоскиСИЗ.Ссылка
		|		И ПродлениеРабочиеМеста.ИдентификаторСтрокиРабочегоМеста = ПродлениеСроковНоскиСИЗ.ИдентификаторСтрокиРабочегоМеста
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументСсылка,
		|	НомерСтроки,
		|	НомерСтрокиСИЗ";
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	МаксимальныйИндекс = РезультатыЗапроса.ВГраница();
	
	ВыборкаСИЗ = РезультатыЗапроса[МаксимальныйИндекс].Выбрать();
	ВыборкаДокументов = РезультатыЗапроса[МаксимальныйИндекс - 1].Выбрать();
	ВыборкаКомиссия = РезультатыЗапроса[МаксимальныйИндекс - 2].Выбрать();
	Пока ВыборкаДокументов.Следующий() Цикл
		Описание = ОписаниеДляПечати();
		ЗаполнитьОписаниеСИЗ(Описание, ВыборкаДокументов, ВыборкаСИЗ);
		ЗаполнитьОписаниеЧленамиКомиссии(Описание, ВыборкаДокументов, ВыборкаКомиссия);
		
		// Заполнение соответствия
		ДанныеПечатиОбъектов.Вставить(ВыборкаДокументов.ДокументСсылка, Описание);
	КонецЦикла;
	
	Возврат ДанныеПечатиОбъектов;
	
КонецФункции

Функция ОписаниеДляПечати()
	
	Описание = Новый Структура;
	Описание.Вставить("ДокументСсылка");
	Описание.Вставить("Дата");
	Описание.Вставить("Номер");
	Описание.Вставить("ДатаПриказа");
	Описание.Вставить("НомерПриказа");
	Описание.Вставить("ОрганизацияНаименованиеПолное");
	Описание.Вставить("ПодразделениеПредставление");
	Описание.Вставить("ФИОРуководителя");
	Описание.Вставить("ПолРуководителя");
	Описание.Вставить("ФамилияРуководителя");
	Описание.Вставить("ТаблицаСИЗ");
	Описание.Вставить("Ответственный");
	
	ТаблицаСИЗ = Новый ТаблицаЗначений;
	ТаблицаСИЗ.Колонки.Добавить("ДокументСсылка", Новый ОписаниеТипов("ДокументСсылка.ПродлениеСроковНоскиСИЗ"));
	ТаблицаСИЗ.Колонки.Добавить("НомерСтрокиСИЗ", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТаблицаСИЗ.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	ТаблицаСИЗ.Колонки.Добавить("СИЗ", Новый ОписаниеТипов("СправочникСсылка.СредстваИндивидуальнойЗащиты"));
	ТаблицаСИЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСИЗ.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаСИЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ПроцентИзноса", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("Заключение", Новый ОписаниеТипов("Строка"));
	
	Описание.ТаблицаСИЗ = ТаблицаСИЗ;
	
	Возврат Описание;
	
КонецФункции

Процедура ЗаполнитьОписаниеСИЗ(Описание, ВыборкаДокументов, ВыборкаСИЗ)
	
	ЗаполнитьЗначенияСвойств(Описание, ВыборкаДокументов);
	
	Описание.Дата = Формат(ВыборкаДокументов.Дата, "ДЛФ=D");
	Описание.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ВыборкаДокументов.Номер);
	Описание.ДатаПриказа = Формат(ВыборкаДокументов.ДатаПриказа, "ДЛФ=ДД");
	Если Не ЗначениеЗаполнено(Описание.НомерПриказа) Тогда
		Описание.НомерПриказа = Описание.Номер;
	КонецЕсли;
	
	Описание.ПодразделениеПредставление = Строка(ВыборкаДокументов.Подразделение);
	
	Если ВыборкаДокументов.ЕстьСИЗ Тогда
		Пока ВыборкаСИЗ.НайтиСледующий(ВыборкаДокументов.ДокументСсылка, "ДокументСсылка") Цикл
			ЗаполнитьЗначенияСвойств(Описание.ТаблицаСИЗ.Добавить(), ВыборкаСИЗ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОписаниеЧленамиКомиссии(Описание, ВыборкаДокументов, ВыборкаКомиссия)
	
	// ФИОРуководителя
	КадровыеДанные = КадровыйУчет.КадровыеДанныеФизическихЛиц(
		Истина, ВыборкаДокументов.Руководитель, "ФамилияИО, Пол, Фамилия", ОбщегоНазначения.ТекущаяДатаПользователя());
	Для каждого СтрокаКадровыхДанных Из КадровыеДанные Цикл
		Описание.ФИОРуководителя = СтрокаКадровыхДанных.ФамилияИО;
		Описание.ПолРуководителя = СтрокаКадровыхДанных.Пол;
		Описание.ФамилияРуководителя = СтрокаКадровыхДанных.Фамилия;
	КонецЦикла;
	
	// Сведения об организации
	ИменаПолей =
	"ОргСубъект,
	|ОргНПункт,
	|ОргГород";
	
	УстановитьПривилегированныйРежим(Истина);
	СведенияОбОрганизации = ЗарплатаКадры.СведенияОбОрганизации(ВыборкаДокументов.Организация, ИменаПолей);
	УстановитьПривилегированныйРежим(Ложь);
	
	Описание.Вставить("Город", ОхранаТруда.ГородИзСведенийОбОрганизации(СведенияОбОрганизации));
	
	МассивЧленовКомиссии = Новый Массив;
	Пока ВыборкаКомиссия.НайтиСледующий(ВыборкаДокументов.ДокументСсылка, "ДокументСсылка") Цикл
		Если ВыборкаКомиссия.РольВКомиссии = Перечисления.РолиЧленовКомиссииОхраныТруда.Председатель Тогда
			Описание.Вставить("ПредседательКомиссии", ВыборкаКомиссия.ЧленКомиссии);
			// ФИОПредседателяКомиссии
			Описание.Вставить("ФИОПредседателяКомиссии", "");
			Описание.Вставить("ПолПредседателяКомиссии", "");
			Описание.Вставить("ФамилияПредседателяКомиссии", "");
			КадровыеДанные = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина, ВыборкаКомиссия.ЧленКомиссии, "ФамилияИО, Пол, Фамилия", ОбщегоНазначения.ТекущаяДатаПользователя());
			Для каждого СтрокаКадровыхДанных Из КадровыеДанные Цикл
				Описание.Вставить("ФИОПредседателяКомиссии", СтрокаКадровыхДанных.ФамилияИО);
				Описание.Вставить("ПолПредседателяКомиссии", СтрокаКадровыхДанных.Пол);
				Описание.Вставить("ФамилияПредседателяКомиссии", СтрокаКадровыхДанных.Фамилия);
			КонецЦикла;
			Описание.Вставить("ДолжностьПредседателяКомиссии", ВыборкаКомиссия.ДолжностьЧленаКомиссии);
		Иначе
			КадровыеДанные = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина, ВыборкаКомиссия.ЧленКомиссии, "ФамилияИО, Пол, Фамилия", ОбщегоНазначения.ТекущаяДатаПользователя());
			Для каждого СтрокаКадровыхДанных Из КадровыеДанные Цикл
				МассивЧленовКомиссии.Добавить(Новый Структура("ЧленКомиссии, ФИОЧленКомиссии, ДолжностьЧленаКомиссии",
					ВыборкаКомиссия.ЧленКомиссии, СтрокаКадровыхДанных.ФамилияИО, ВыборкаКомиссия.ДолжностьЧленаКомиссии));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Описание.Вставить("ЧленыКомиссии", МассивЧленовКомиссии);
	
КонецПроцедуры

#КонецОбласти

Функция ОписаниеПодписейДокумента() Экспорт 
	
	ОписаниеПодписей = ПодписиДокументов.ОписаниеТаблицыПодписей();
	
	ПодписиДокументов.ДобавитьОписаниеПодписейОрганизации(ОписаниеПодписей, "Руководитель, ОтветственныйЗаОхрануТруда");
	
	Возврат ОписаниеПодписей;
		
КонецФункции

#КонецОбласти

#КонецЕсли