Процедура ЗагрузитьДокументыОРождении10010(Документ, ЭлементDOM, Необработанные)
	ИменаУзлов = "birthReferenceDocs, birthCertificateDocs, birthRecord, birthDocOtherCountry";
	УзлыDOM = УзлыЭлементаDOM(ЭлементDOM, ИменаУзлов, Необработанные);
	
	СправкаОРожденииDOM = Неопределено; // birthReferenceType.
	СвидетельствоОРожденииDOM = Неопределено; // birthCertificateType.
	АктоваяЗаписьОРожденииDOM = Неопределено; // birthRecordType.
	ИнойДокументОРожденииDOM = Неопределено; // birthDocOtherCountryType.
	
	Если УзлыDOM.birthReferenceDocs <> Неопределено Тогда
		// Справка о рождении и актовая запись.
		ВложенныеУзлыDOM = УзлыЭлементаDOM(УзлыDOM.birthReferenceDocs, "birthReference, birthRecord");
		СправкаОРожденииDOM = ВложенныеУзлыDOM.birthReference;
		АктоваяЗаписьОРожденииDOM = ВложенныеУзлыDOM.birthRecord;
	ИначеЕсли УзлыDOM.birthCertificateDocs <> Неопределено Тогда
		// Свидетельство о рождении и актовая запись.
		ВложенныеУзлыDOM = УзлыЭлементаDOM(УзлыDOM.birthCertificateDocs, "birthCertificate, birthRecord");
		СвидетельствоОРожденииDOM = ВложенныеУзлыDOM.birthCertificate;
		АктоваяЗаписьОРожденииDOM = ВложенныеУзлыDOM.birthRecord;
	ИначеЕсли УзлыDOM.birthRecord <> Неопределено Тогда
		// Актовая запись (реестровая запись) о рождении.
		АктоваяЗаписьОРожденииDOM = УзлыDOM.birthRecord;
	ИначеЕсли УзлыDOM.birthDocOtherCountry <> Неопределено Тогда
		// Иной документ, подтверждающий рождение ребёнка. Для детей, рождённых за рубежом.
		ИнойДокументОРожденииDOM = УзлыDOM.birthDocOtherCountry;
	КонецЕсли;
	
	// Справка о рождении.
	Если СправкаОРожденииDOM <> Неопределено Тогда
		Справка = УзлыЭлементаDOM(СправкаОРожденииDOM, "number, issueDate, refType", Необработанные);
		Документ.Вставить("СправкаОРожденииНомер", СериализацияБЗК.СтрокаИзXML(Справка.number));
		Документ.Вставить("СправкаОРожденииДатаВыдачи", СериализацияБЗК.ДатаИзXML(Справка.issueDate));
		Документ.Вставить("СправкаОРожденииФорма", Перечисления.ФормыСправкиОРожденииРебенка.ЗначениеПоКоду(
			СериализацияБЗК.СтрокаИзXML(Справка.refType)));
	КонецЕсли;
	
	// Свидетельство о рождении.
	Если СвидетельствоОРожденииDOM <> Неопределено Тогда
		Свидетельство = УзлыЭлементаDOM(СвидетельствоОРожденииDOM, "series, number, issueDate", Необработанные);
		Документ.Вставить("СвидетельствоОРожденииСерия", СериализацияБЗК.СтрокаИзXML(Свидетельство.series));
		Документ.Вставить("СвидетельствоОРожденииНомер", СериализацияБЗК.СтрокаИзXML(Свидетельство.number));
		Документ.Вставить("СвидетельствоОРожденииДатаВыдачи", СериализацияБЗК.ДатаИзXML(Свидетельство.issueDate));
	КонецЕсли;
	
	// Актовая запись ЗАГС.
	Если АктоваяЗаписьОРожденииDOM <> Неопределено Тогда
		Акт = УзлыЭлементаDOM(АктоваяЗаписьОРожденииDOM, "number, issueDate", Необработанные);
		Документ.Вставить("АктоваяЗаписьОРожденииНомер", СериализацияБЗК.СтрокаИзXML(Акт.number));
		Документ.Вставить("АктоваяЗаписьОРожденииДата", СериализацияБЗК.ДатаИзXML(Акт.issueDate));
	КонецЕсли;
	
	// Иной документ подтверждающий рождение ребенка.
	Если ИнойДокументОРожденииDOM <> Неопределено Тогда
		ИнойДокумент = УзлыЭлементаDOM(ИнойДокументОРожденииDOM, "series, number, issueDate, country", Необработанные);
		Документ.Вставить("ИнойДокументОРожденииСерия", СериализацияБЗК.СтрокаИзXML(ИнойДокумент.series));
		Документ.Вставить("ИнойДокументОРожденииНомер", СериализацияБЗК.СтрокаИзXML(ИнойДокумент.number));
		Документ.Вставить("ИнойДокументОРожденииДатаВыдачи", СериализацияБЗК.ДатаИзXML(ИнойДокумент.issueDate));
		Документ.Вставить("ИнойДокументОРожденииКодСтраны", СериализацияБЗК.СтрокаИзXML(ИнойДокумент.country));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеОбОпеке10010(Документ, ЭлементDOM, Необработанные)
	ИменаУзлов = "guardianshipDoc, refFamilyInfo";
	УзлыDOM = УзлыЭлементаDOM(ЭлементDOM, ИменаУзлов, Необработанные);
	// Документ об установлении опеки.
	Если УзлыDOM.guardianshipDoc <> Неопределено Тогда
		Опека = УзлыЭлементаDOM(УзлыDOM.guardianshipDoc, "num, issueDate", Необработанные);
		Документ.Вставить("УсыновлениеОпекаНомер", СериализацияБЗК.СтрокаИзXML(Опека.num));
		Документ.Вставить("УсыновлениеОпекаДата", СериализацияБЗК.ДатаИзXML(Опека.issueDate));
		Если ЗначениеЗаполнено(Документ.УсыновлениеОпекаНомер)
			Или ЗначениеЗаполнено(Документ.УсыновлениеОпекаДата) Тогда
			Документ.Вставить("УсыновлениеОпекаТип", "1");
		КонецЕсли;
	КонецЕсли;
	// Договор о передаче в приемную семью.
	Если УзлыDOM.refFamilyInfo <> Неопределено Тогда
		ПередачаНаВоспитание = УзлыЭлементаDOM(УзлыDOM.refFamilyInfo, "num, issueDate", Необработанные);
		Документ.Вставить("ПередачаНаВоспитаниеНомер", СериализацияБЗК.СтрокаИзXML(ПередачаНаВоспитание.num));
		Документ.Вставить("ПередачаНаВоспитаниеДата", СериализацияБЗК.ДатаИзXML(ПередачаНаВоспитание.issueDate));
		Если ЗначениеЗаполнено(Документ.ПередачаНаВоспитаниеНомер)
			Или ЗначениеЗаполнено(Документ.ПередачаНаВоспитаниеДата) Тогда
			Документ.Вставить("УсыновлениеОпекаТип", "1");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ЗагрузитьДанныеОбУсыновлении10010(Документ, ЭлементDOM, Необработанные)
	УзлыDOM = УзлыЭлементаDOM(ЭлементDOM, "adoptionDoc", Необработанные);
