Процедура ЗагрузитьСведенияОСотруднике10010(Документ, ЭлементDOM, Необработанные)
	ИменаУзлов = "fullName, snils, classification, category, residenceDocument, taxpayer, personPhone, birthDate,
	|childRelType";
	СотрудникDOM = УзлыЭлементаDOM(ЭлементDOM, ИменаУзлов, Необработанные);
	
	// ФИО.
	Если СотрудникDOM.fullName <> Неопределено Тогда
		ФИО = СЭДОФСС.ФИОИзXML(СотрудникDOM.fullName, Необработанные);
		Документ.Вставить("СотрудникФамилия", ФИО.Фамилия);
		Документ.Вставить("СотрудникИмя", ФИО.Имя);
		Документ.Вставить("СотрудникОтчество", ФИО.Отчество);
	КонецЕсли;
	
	// Категория застрахованного лица, СНИЛС, ИНН.
	Если СотрудникDOM.snils <> Неопределено Тогда
		Документ.Вставить("СотрудникСНИЛС", СЭДОФСС.СНИЛСИзXML(СотрудникDOM.snils));
	КонецЕсли;
	Если СотрудникDOM.classification <> Неопределено Тогда
		Документ.Вставить("СотрудникВидСтрахованияЕЦП", СериализацияБЗК.СтрокаИзXML(СотрудникDOM.classification));
	КонецЕсли;
	Если СотрудникDOM.category <> Неопределено Тогда
		Документ.Вставить("СотрудникКатегория", СериализацияБЗК.СтрокаИзXML(СотрудникDOM.category));
	КонецЕсли;
	
	// Разрешение на проживание.
	Если ТипЗнч(СотрудникDOM.residenceDocument) = Тип("ЭлементDOM") Тогда
		ЗагрузитьРазрешениеНаПроживание10010(Документ, СотрудникDOM.residenceDocument);
	КонецЕсли;
	
	// Код статуса налогоплательщика, код страны гражданства, адрес регистрации.
	Если ТипЗнч(СотрудникDOM.taxpayer) = Тип("ЭлементDOM") Тогда
		ИменаПолей = "taxpayerStatus, inn";
		НалогоплательщикDOM = УзлыЭлементаDOM(СотрудникDOM.taxpayer, ИменаПолей);
		Если НалогоплательщикDOM.taxpayerStatus <> Неопределено Тогда
			Документ.Вставить("КодСтатусаНалогоплательщика", СериализацияБЗК.СтрокаИзXML(НалогоплательщикDOM.taxpayerStatus));
		КонецЕсли;
		Если НалогоплательщикDOM.inn <> Неопределено Тогда
			Документ.Вставить("СотрудникИНН", СериализацияБЗК.СтрокаИзXML(НалогоплательщикDOM.inn));
		КонецЕсли;
	КонецЕсли;
	
	// Номер телефона застрахованного.
	Если СотрудникDOM.personPhone <> Неопределено Тогда
		Документ.Вставить("СотрудникТелефонПредставление", СериализацияБЗК.СтрокаИзXML(СотрудникDOM.personPhone));
	КонецЕсли;
	
	// Дата рождения.
	Если СотрудникDOM.birthDate <> Неопределено Тогда
		Документ.Вставить("СотрудникДатаРождения", СериализацияБЗК.ДатаИзXML(СотрудникDOM.birthDate));
	КонецЕсли;
	
	// Код родственной связи с ребенком.
	// Тип связи застрахованного лица с ребенком - мать, отец, опекун, усыновитель.
	Если СотрудникDOM.childRelType <> Неопределено Тогда
		Документ.Вставить("РебенокКодСвязи", СериализацияБЗК.СтрокаИзXML(СотрудникDOM.childRelType));
	КонецЕсли;
	
КонецПроцедуры

