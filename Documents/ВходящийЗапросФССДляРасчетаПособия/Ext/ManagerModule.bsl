	// Флажки, обозначающие отсутствие или наличие определенных тегов:
	Документ.Вставить("Перерасчет", Ложь);
	// Версия спецификации.
	Документ.Вставить("ВерсияСпецификации", "");
	Документ.Вставить("ВерсияСпецификацииЧислом", 0);
	// Приостановления ТД.
	Документ.Вставить("ПриостановлениеТДОснованиеНПА", Неопределено);
	Документ.Вставить("ПриостановлениеТДКалендарныхДней", 0);
	
	Возврат Документ;
КонецФункции

Функция НайтиДокументПоСообщению(ИдентификаторСообщения)
	ВыбираемыеПоля = "Ссылка";
	НастройкиЗапроса = ЗапросыБЗК.НастройкиЗапросаКТаблице();
	НастройкиЗапроса.Количество = 1;
	НастройкиЗапроса.Порядок = "ПометкаУдаления, Дата УБЫВ";
	ЗапросыБЗК.ДобавитьОтбор(НастройкиЗапроса.Отбор, "ИдентификаторСообщения", , ИдентификаторСообщения);
	Запрос = ЗапросыБЗК.ЗапросКТаблице(Метаданные(), ВыбираемыеПоля, НастройкиЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиАдресПоСведенияОЗастрахованномЛицеФСС(Документ, Префикс, Идентификатор, ЭтоИдентификаторДома) Экспорт
	Если Не ЗначениеЗаполнено(Документ.СотрудникСНИЛС) Или Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СведенияОЗастрахованномЛицеФСС.Дата КАК Дата,
	|	СведенияОЗастрахованномЛицеФСС.АдресПроживания КАК ЗначениеАдреса,
	|	СведенияОЗастрахованномЛицеФСС.АдресПроживанияИндекс КАК Индекс,
	|	СведенияОЗастрахованномЛицеФСС.АдресПроживанияДом КАК Дом,
	|	СведенияОЗастрахованномЛицеФСС.АдресПроживанияКорпус КАК Корпус,
	|	СведенияОЗастрахованномЛицеФСС.АдресПроживанияКвартира КАК Квартира
	|ИЗ
	|	Документ.СведенияОЗастрахованномЛицеФСС КАК СведенияОЗастрахованномЛицеФСС
	|ГДЕ
	|	СведенияОЗастрахованномЛицеФСС.СНИЛС = &СНИЛС
	|	И СведенияОЗастрахованномЛицеФСС.АдресПроживанияФИАСДом = &Идентификатор
	|	И НЕ СведенияОЗастрахованномЛицеФСС.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СведенияОЗастрахованномЛицеФСС.Дата,
	|	СведенияОЗастрахованномЛицеФСС.АдресРегистрации,
	|	СведенияОЗастрахованномЛицеФСС.АдресРегистрацииИндекс,
	|	СведенияОЗастрахованномЛицеФСС.АдресРегистрацииДом,
	|	СведенияОЗастрахованномЛицеФСС.АдресРегистрацииКорпус,
	|	СведенияОЗастрахованномЛицеФСС.АдресРегистрацииКвартира
	|ИЗ
	|	Документ.СведенияОЗастрахованномЛицеФСС КАК СведенияОЗастрахованномЛицеФСС
	|ГДЕ
	|	СведенияОЗастрахованномЛицеФСС.СНИЛС = &СНИЛС
	|	И СведенияОЗастрахованномЛицеФСС.АдресРегистрацииФИАСДом = &Идентификатор
	|	И НЕ СведенияОЗастрахованномЛицеФСС.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("СНИЛС",         Документ.СотрудникСНИЛС);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Если Не ЭтоИдентификаторДома Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФИАСДом", "ФИАСРО");
	КонецЕсли;
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.Индекс = Документ[Префикс + "Индекс"]
			И НРег(СокрЛП(СтрокаТаблицы.Дом)) = НРег(СокрЛП(Документ[Префикс + "Дом"]))
			И НРег(СокрЛП(СтрокаТаблицы.Корпус)) = НРег(СокрЛП(Документ[Префикс + "Корпус"]))
			И НРег(СокрЛП(СтрокаТаблицы.Квартира)) = НРег(СокрЛП(Документ[Префикс + "Квартира"])) Тогда
			Возврат СтрокаТаблицы.ЗначениеАдреса;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Функция УзлыЭлементаDOM(ЭлементDOM, ИменаРеквизитов = "", НеобработанныеУзлы = Неопределено, ТребуетсяАдаптацияИмен = Ложь)
	Возврат СериализацияБЗК.УзлыЭлементаDOM(ЭлементDOM, ИменаРеквизитов, НеобработанныеУзлы, ТребуетсяАдаптацияИмен);
КонецФункции

Процедура ЗаполнитьСвойстваРеквизитов(Документ, СтруктураDOM)
	СвойстваРеквизитов = Новый ТаблицаЗначений;
	СвойстваРеквизитов.Колонки.Добавить("ТипРеквизита", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыРеквизитовДляРасчетаПособияФСС"));
	СвойстваРеквизитов.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
	СвойстваРеквизитов.Колонки.Добавить("ИмяТаблицы", Новый ОписаниеТипов("Строка"));
	СвойстваРеквизитов.Колонки.Добавить("Изменяемый", Новый ОписаниеТипов("Булево, Число"));
	СвойстваРеквизитов.Колонки.Добавить("Обязательный", Новый ОписаниеТипов("Булево, Число"));
	ВыражениеXPath = СериализацияБЗК.ВычислитьВыражениеXPath(СтруктураDOM, "//*/@*");
	БыстрыйПоиск = Перечисления.ТипыРеквизитовДляРасчетаПособияФСС.СоответствиеДляПоискаПоИменам();
	Пока Истина Цикл
		АтрибутDOM = ВыражениеXPath.ПолучитьСледующий();
		Если АтрибутDOM = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если НРег(АтрибутDOM.ЛокальноеИмя) = "editable" Тогда
			ИмяСвойства = "Изменяемый";
		ИначеЕсли НРег(АтрибутDOM.ЛокальноеИмя) = "required" Тогда
			ИмяСвойства = "Обязательный";
		Иначе
			Продолжить;
		КонецЕсли;
		ЗначениеСвойства = СериализацияБЗК.ЗначениеXML(АтрибутDOM.ТекстовоеСодержимое, Тип("Булево"));
		// Определение имени реквизита.
		ЭлементDOM = АтрибутDOM.ЭлементВладелец;
		ИмяРеквизита = НРег(ЭлементDOM.ЛокальноеИмя);
		// Определение пути к реквизиту.
		МассивИмен = Новый Массив;
		ЭлементDOM = ЭлементDOM.РодительскийУзел;
		ЛокальноеИмя = НРег(ЭлементDOM.ЛокальноеИмя);
		Пока ЛокальноеИмя <> "socialassistnum"
			И ЛокальноеИмя <> "benefit1approve"
			И ЛокальноеИмя <> "benefit2approve"
			И ЛокальноеИмя <> "benefit4approve"
			И ЗначениеЗаполнено(ЛокальноеИмя) Цикл
			МассивИмен.Вставить(0, ЛокальноеИмя);
			ЭлементDOM = ЭлементDOM.РодительскийУзел;
			ЛокальноеИмя = НРег(ЭлементDOM.ЛокальноеИмя);
		КонецЦикла;
		ИмяТаблицы = СтрСоединить(МассивИмен, ".");
		// Поиск и добавление строки результата.
		Фильтр = Новый Структура("ИмяРеквизита, ИмяТаблицы", ИмяРеквизита, ИмяТаблицы);
		Фильтр.Вставить(ИмяСвойства, Неопределено);
		Найденные = СвойстваРеквизитов.НайтиСтроки(Фильтр);
		Если Найденные.Количество() > 0 Тогда
			СтрокаТаблицы = Найденные[0];
		Иначе
			ПолноеИмя = ?(ИмяТаблицы = "", "", ИмяТаблицы + ".") + ИмяРеквизита;
			СтрокаТаблицы = СвойстваРеквизитов.Добавить();
			СтрокаТаблицы.ИмяРеквизита = ИмяРеквизита;
			СтрокаТаблицы.ИмяТаблицы   = ИмяТаблицы;
			СтрокаТаблицы.ТипРеквизита = БыстрыйПоиск[ПолноеИмя];
		КонецЕсли;
		СтрокаТаблицы[ИмяСвойства] = ЗначениеСвойства;
	КонецЦикла;
	Документ.Вставить("СвойстваРеквизитов", СвойстваРеквизитов);
КонецПроцедуры

Процедура ПоднятьВерсиюСпецификации(Документ, ВерсияСпецификации)
	ВерсияСпецификацииЧислом = СЭДОФСС.ВерсияЧислом(ВерсияСпецификации);
	Если Документ.ВерсияСпецификацииЧислом < ВерсияСпецификацииЧислом Тогда
		Документ.ВерсияСпецификации       = ВерсияСпецификации;
		Документ.ВерсияСпецификацииЧислом = ВерсияСпецификацииЧислом;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СтруктураСообщения10010

Функция СтруктураСообщения10010(ТекстXML) Экспорт
	СтруктураDOM = СериализацияБЗК.СтруктураDOM(ТекстXML);
	КореньDOM = СериализацияБЗК.НайтиУзелDOMПоИмени(СтруктураDOM, "benefitRequest");
	Если КореньDOM = Неопределено Тогда
		КореньDOM = СтруктураDOM.ДокументDOM.ЭлементДокумента;
	КонецЕсли;
	Необработанные = Новый Массив;
	
	// Подготовка структуры документа.
	Документ = ПустаяСтруктураСообщенияXML();
	
	// Чтение атрибутов XML.
	АтрибутыКорня = СериализацияБЗК.АтрибутыЭлементаDOM(КореньDOM, "specVersion, messageUuid10910, messageDateTime");
	Документ.Вставить("ВерсияСпецификацииСФР", СериализацияБЗК.СтрокаИзXML(АтрибутыКорня.specVersion));
	Документ.Вставить("ИдентификаторОснования", СериализацияБЗК.СтрокаИзXML(АтрибутыКорня.messageUuid10910));
	Документ.Вставить("ДатаСообщения", СериализацияБЗК.ДатаИзXML(АтрибутыКорня.messageDateTime));
	
	// Чтение реквизитов XML.
	ИменаУзлов = "processInfo, benefit1, benefit2, benefit4, benefit5, benefit6, recalculation, notice";
	УзлыКорня = УзлыЭлементаDOM(КореньDOM, ИменаУзлов, Необработанные);
	
	// Информация о проактивном процессе.
	Если ТипЗнч(УзлыКорня.processInfo) = Тип("ЭлементDOM") Тогда
		ИменаУзлов = "processNum, parentProcessNum, subProcessReasonCode, subProcessReasonDetails";
		УзлыПроцесса = УзлыЭлементаDOM(УзлыКорня.processInfo, ИменаУзлов, Необработанные);
		Документ.Вставить("НомерПроцесса", СериализацияБЗК.ЧислоИзXML(УзлыПроцесса.processNum));
		Документ.Вставить("ИсправлениеНомерПроцесса", СериализацияБЗК.ЧислоИзXML(УзлыПроцесса.parentProcessNum));
		Документ.Вставить("ИсправлениеКодПричины", СериализацияБЗК.СтрокаИзXML(УзлыПроцесса.subProcessReasonCode));
		Документ.Вставить("ИсправлениеТекстПричины", СериализацияБЗК.СтрокаИзXML(УзлыПроцесса.subProcessReasonDetails));
	КонецЕсли;
	
	// Информация о пособии.
	Если ТипЗнч(УзлыКорня.benefit1) = Тип("ЭлементDOM") Тогда
		Документ.ВидПособия = Перечисления.ПособияНазначаемыеФСС.ПособиеПоВременнойНетрудоспособности;
		ЗаполнитьРеквизитыСообщения10010(Документ, УзлыКорня.benefit1, Необработанные);
	ИначеЕсли ТипЗнч(УзлыКорня.benefit2) = Тип("ЭлементDOM") Тогда
		Документ.ВидПособия = Перечисления.ПособияНазначаемыеФСС.ПособиеПоБеременностиИРодам;
		ЗаполнитьРеквизитыСообщения10010(Документ, УзлыКорня.benefit2, Необработанные);
	ИначеЕсли ТипЗнч(УзлыКорня.benefit4) = Тип("ЭлементDOM") Тогда
		Документ.ВидПособия = Перечисления.ПособияНазначаемыеФСС.ЕдиновременноеПособиеПриРожденииРебенка;
		ЗаполнитьРеквизитыСообщения10010(Документ, УзлыКорня.benefit4, Необработанные);
	ИначеЕсли ТипЗнч(УзлыКорня.benefit5) = Тип("ЭлементDOM") Тогда
		Документ.ВидПособия = Перечисления.ПособияНазначаемыеФСС.ЕжемесячноеПособиеПоУходуЗаРебенком;
		ЗаполнитьРеквизитыСообщения10010(Документ, УзлыКорня.benefit5, Необработанные);
	ИначеЕсли ТипЗнч(УзлыКорня.benefit6) = Тип("ЭлементDOM") Тогда
		Документ.ВидПособия = Перечисления.ПособияНазначаемыеФСС.ПособиеВСвязиСНесчастнымСлучаемНаПроизводстве;
		ЗаполнитьРеквизитыСообщения10010(Документ, УзлыКорня.benefit6, Необработанные);
	КонецЕсли;
	
	// Перерасчет.
	Если ТипЗнч(УзлыКорня.recalculation) = Тип("ЭлементDOM") Тогда
		Документ.Перерасчет = Истина;
		УзлыПерерасчета = УзлыЭлементаDOM(УзлыКорня.recalculation, "batchNo", Необработанные);
		Документ.Вставить("ПерерасчетИдентификаторСтрокиРеестра", СериализацияБЗК.СтрокаИзXML(УзлыПерерасчета.batchNo));
	КонецЕсли;
	
	// Извещение о представлении недостающих сведений.
	Если ТипЗнч(УзлыКорня.notice) = Тип("ЭлементDOM") Тогда
		УзлыИзвещения = УзлыЭлементаDOM(УзлыКорня.notice, "number, date", Необработанные);
		Документ.Вставить("ИзвещениеФССНомер", СериализацияБЗК.СтрокаИзXML(УзлыИзвещения.number));
		Документ.Вставить("ИзвещениеФССДата", СериализацияБЗК.ДатаИзXML(УзлыИзвещения.date));
	КонецЕсли;
	
	Попытка
		ЗаполнитьСвойстваРеквизитов(Документ, СтруктураDOM);
	Исключение
		ТекстОшибки = НСтр("ru = 'Ошибка при заполнении свойств реквизитов:'")
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Документ.ТекстОшибки = СокрЛ(Документ.ТекстОшибки + Символы.ПС + Символы.ПС + ТекстОшибки);
	КонецПопытки;
	
	Документ.Вставить("НеобработанныеУзлы", СЭДОФСС.ТаблицаЭлементовDOM(Необработанные));
	
	Возврат Документ;
КонецФункции

Процедура ЗаполнитьРеквизитыСообщения10010(Документ, ЭлементDOM, Необработанные)
	ВидПособия = СЭДОФСС.СведенияОВидеПособия(Документ.ВидПособия);
	ИменаУзлов = "elnInfo, insurerInfo, receivePayment, assignmentParams, calculationData,
	|birthInfo, childInfo, baseDocuments, guardianship, adoption, period, insuranceCase, insuredInfo,
	|otherChild, childSer, expirationDate";
	УзлыПособия = УзлыЭлементаDOM(ЭлементDOM, ИменаУзлов, Необработанные);
	
	// Информация об ЭЛН.
	Если ТипЗнч(УзлыПособия.elnInfo) = Тип("ЭлементDOM") Тогда
		ЗагрузитьСведенияОбЭЛН10010(Документ, УзлыПособия.elnInfo, Необработанные);
	КонецЕсли;
	
	// Сведения о страхователе.
	Если ТипЗнч(УзлыПособия.insurerInfo) = Тип("ЭлементDOM") Тогда
		ЗагрузитьСведенияОСтрахователе10010(Документ, УзлыПособия.insurerInfo, Необработанные);
	КонецЕсли;
	
	// Сведения о способе получения выплаты.
	Если ТипЗнч(УзлыПособия.receivePayment) = Тип("ЭлементDOM") Тогда
		ЗагрузитьСпособВыплаты10010(Документ, УзлыПособия.receivePayment, Необработанные);
	КонецЕсли;
	
	// Параметры назначения и выплаты пособия.
	Если ТипЗнч(УзлыПособия.assignmentParams) = Тип("ЭлементDOM") Тогда
		ЗагрузитьПараметрыНазначения10010(Документ, УзлыПособия.assignmentParams, Необработанные);
	КонецЕсли;
	
	// Данные для расчета.
	Если ТипЗнч(УзлыПособия.calculationData) = Тип("ЭлементDOM") Тогда
		ЗагрузитьДанныеДляРасчета10010(Документ, УзлыПособия.calculationData, Необработанные);
	КонецЕсли;
	
	// Информация о рождении ребенка. benefit4.
	Если ТипЗнч(УзлыПособия.birthInfo) = Тип("ЭлементDOM") Тогда
		УзлыDOM = УзлыЭлементаDOM(УзлыПособия.birthInfo, "childInfo, baseDocuments", Необработанные);
		// Данные ребенка.
		Если ТипЗнч(УзлыDOM.childInfo) = Тип("ЭлементDOM") Тогда
			ЗагрузитьСведенияОРебенке10010(Документ, УзлыDOM.childInfo, Необработанные);
		КонецЕсли;
		// Основания для назначения пособия.
		Если ТипЗнч(УзлыDOM.baseDocuments) = Тип("ЭлементDOM") Тогда
			ЗагрузитьДокументыОРождении10010(Документ, УзлыDOM.baseDocuments, Необработанные)
		КонецЕсли;
	КонецЕсли;
	
	// Данные о ребенке. benefit5.
	Если ТипЗнч(УзлыПособия.childInfo) = Тип("ЭлементDOM") Тогда
		ЗагрузитьСведенияОРебенке10010(Документ, УзлыПособия.childInfo, Необработанные);
	КонецЕсли;
	
	// Основания для назначения пособия. benefit5.
	Если ТипЗнч(УзлыПособия.baseDocuments) = Тип("ЭлементDOM") Тогда
		УзлыDOM = УзлыЭлементаDOM(УзлыПособия.baseDocuments, "period, identifyDocument");
		// Для ТД - период отпуска по БиР, для ГПХ - период назначения и выплаты пособия в пределах действия ГПХ.
		Если ТипЗнч(УзлыDOM.period) = Тип("ЭлементDOM") Тогда
			ЗагрузитьОтпускПоУходу10010(Документ, УзлыDOM.period, Необработанные);
		КонецЕсли;
		// Документы о рождении.
		Если ТипЗнч(УзлыDOM.identifyDocument) = Тип("ЭлементDOM") Тогда
			ЗагрузитьДокументыОРождении10010(Документ, УзлыDOM.identifyDocument, Необработанные);
		КонецЕсли;
	КонецЕсли;
	
	// Данные об опеке. benefit4, benefit5.
	Если ТипЗнч(УзлыПособия.guardianship) = Тип("ЭлементDOM") Тогда
		ЗагрузитьДанныеОбОпеке10010(Документ, УзлыПособия.guardianship, Необработанные);
	КонецЕсли;
	
	// Данные об усыновлении. benefit4, benefit5.
	Если ТипЗнч(УзлыПособия.adoption) = Тип("ЭлементDOM") Тогда
		ЗагрузитьДанныеОбУсыновлении10010(Документ, УзлыПособия.adoption, Необработанные);
	КонецЕсли;
	
	// Наличие документа о другом ребенке. benefit5.
	Если ТипЗнч(УзлыПособия.otherChild) = Тип("ЭлементDOM") Тогда
		УзлыDOM = УзлыЭлементаDOM(УзлыПособия.otherChild, "otherChildFlagBirth, otherChildFlagDeath", Необработанные);
		Если УзлыDOM.otherChildFlagBirth <> Неопределено Тогда
			Флаг = СериализацияБЗК.ЧислоИзXML(УзлыDOM.otherChildFlagBirth);
			Документ.Вставить("НаличиеДокументовОРожденииПредыдущихДетей", ?(Флаг = 1, Истина, Ложь));
		КонецЕсли;
		Если УзлыDOM.otherChildFlagDeath <> Неопределено Тогда
			Флаг = СериализацияБЗК.ЧислоИзXML(УзлыDOM.otherChildFlagDeath);
			Документ.Вставить("НаличиеСвидетельстваОСмертиПредыдущихДетей", ?(Флаг = 1, Истина, Ложь));
		КонецЕсли;
	КонецЕсли;
	
	// Очередность рождения (начиная с 1). benefit5.
	Если УзлыПособия.childSer <> Неопределено Тогда
		Документ.Вставить("РебенокОчередность", СериализацияБЗК.ЧислоИзXML(УзлыПособия.childSer));
	КонецЕсли;
	
	// Срок ответа на 10010 сообщение. Не заполняется для перерасчетных процессов. benefit5.
	Если УзлыПособия.expirationDate <> Неопределено Тогда
		Документ.Вставить("ВходящийСрокОтвета", СериализацияБЗК.ДатаИзXML(УзлыПособия.expirationDate));
	КонецЕсли;
	
	// Для ТД - период отпуска по БиР, для ГПХ - период назначения и выплаты пособия в пределах действия ГПХ.
	Если ТипЗнч(УзлыПособия.period) = Тип("ЭлементDOM") Тогда
		ИменаПолей = "num, issueDate, beginDate, endDate";
		ОтпускПоУходуDOM = УзлыЭлементаDOM(УзлыПособия.period, ИменаПолей, Необработанные);
		ЗагрузитьОтпускПоБиР(Документ, ОтпускПоУходуDOM);
	КонецЕсли;
	
	// Сведения о страховом случае НС/ПЗ. benefit6.
	Если ТипЗнч(УзлыПособия.insuranceCase) = Тип("ЭлементDOM") Тогда
		ЗагрузитьДанныеНСПЗ10010(Документ, УзлыПособия.insuranceCase, Необработанные);
	КонецЕсли;
	
	// Данные о застрахованном лице.
	Если ТипЗнч(УзлыПособия.insuredInfo) = Тип("ЭлементDOM") Тогда
		ЗагрузитьСведенияОСотруднике10010(Документ, УзлыПособия.insuredInfo, Необработанные);
	КонецЕсли;
	
КонецПроцедуры

