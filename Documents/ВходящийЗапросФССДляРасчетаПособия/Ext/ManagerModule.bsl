Процедура ЗагрузитьСпособВыплаты10010(Документ, СпособВыплатыDOM, Необработанные)
	ИменаУзлов = "bankInfo, cardMir, otherOrg, postalAddress";
	СпособВыплаты = УзлыЭлементаDOM(СпособВыплатыDOM, ИменаУзлов, Необработанные);
	
	Если ТипЗнч(СпособВыплаты.bankInfo) = Тип("ЭлементDOM") Тогда
		ИменаПолей = "bik, accountNum";
		Узлы = УзлыЭлементаDOM(СпособВыплаты.bankInfo, ИменаПолей, Необработанные);
		Документ.Вставить("БанкБИК", СериализацияБЗК.СтрокаИзXML(Узлы.bik));
		Документ.Вставить("НомерСчета", СериализацияБЗК.СтрокаИзXML(Узлы.accountNum));
		Документ.Вставить("Банк", СЭДОФСС.НайтиБанкПоБИК(Документ.БанкБИК));
	КонецЕсли;
	
	Если СпособВыплаты.cardMir <> Неопределено Тогда
		Документ.Вставить("НомерКартыМИР", СериализацияБЗК.СтрокаИзXML(СпособВыплаты.cardMir));
	КонецЕсли;
	
	Если ТипЗнч(СпособВыплаты.otherOrg) = Тип("ЭлементDOM") Тогда
		ИменаПолей =
		"orgName, bik, accountNum, personalOrgAccount, personalInsuredAccount, kbk, regNumSFRCorrectionalFacility";
		Узлы = УзлыЭлементаDOM(СпособВыплаты.otherOrg, ИменаПолей, Необработанные);
		Документ.Вставить("ИнаяОрганизацияНаименование", СериализацияБЗК.СтрокаИзXML(Узлы.orgName));
		Документ.Вставить("ИнаяОрганизацияБИК", СериализацияБЗК.СтрокаИзXML(Узлы.bik));
		Документ.Вставить("ИнаяОрганизацияНомерСчетаСтрахователя", СериализацияБЗК.СтрокаИзXML(Узлы.accountNum));
		Документ.Вставить("ИнаяОрганизацияЛицевойСчетОрганизации", СериализацияБЗК.СтрокаИзXML(Узлы.personalOrgAccount));
		Документ.Вставить("ИнаяОрганизацияЛицевойСчетСотрудника", СериализацияБЗК.СтрокаИзXML(Узлы.personalInsuredAccount));
		Документ.Вставить("ИнаяОрганизацияКБК", СериализацияБЗК.СтрокаИзXML(Узлы.kbk));
		Документ.Вставить("ИнаяОрганизацияРегистрационныйНомерСФР", СериализацияБЗК.СтрокаИзXML(Узлы.regNumSFRCorrectionalFacility));
	КонецЕсли;
	
	Если ТипЗнч(СпособВыплаты.postalAddress) = Тип("ЭлементDOM") Тогда
		ИменаПолей = "addressGar, postalCode, foreignAddress";
		Узлы = УзлыЭлементаDOM(СпособВыплаты.otherOrg, ИменаПолей, Необработанные);
		Префикс = "АдресПроживания";
		
		ИменаПолей = "houseGuid, guid, house, stroenie, building, flat";
		УзлыАдреса = УзлыЭлементаDOM(Узлы.addressGar, ИменаПолей, Необработанные);
		Документ.Вставить(Префикс + "ФИАСДом", СериализацияБЗК.СтрокаИзXML(УзлыАдреса.houseGuid));
		Документ.Вставить(Префикс + "ФИАСРО", СериализацияБЗК.СтрокаИзXML(УзлыАдреса.guid));
		Документ.Вставить(Префикс + "Дом", СериализацияБЗК.СтрокаИзXML(УзлыАдреса.house));
		Документ.Вставить(Префикс + "Строение", СериализацияБЗК.СтрокаИзXML(УзлыАдреса.stroenie));
		Документ.Вставить(Префикс + "Корпус", СериализацияБЗК.СтрокаИзXML(УзлыАдреса.building));
		Документ.Вставить(Префикс + "Квартира", СериализацияБЗК.СтрокаИзXML(УзлыАдреса.flat));
		
		Документ.Вставить(Префикс + "Индекс", СериализацияБЗК.СтрокаИзXML(Узлы.postalCode));
		Документ.Вставить(Префикс + "ЗаПределамиРФ", СериализацияБЗК.СтрокаИзXML(Узлы.foreignAddress));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьПричинуЛьгот10010(Документ, ПричинаЛьготDOM)
	ЗагрузитьПричинуЛьгот(Документ, ПричинаЛьготDOM);
