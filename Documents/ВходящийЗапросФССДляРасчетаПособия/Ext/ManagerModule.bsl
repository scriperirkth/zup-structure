Процедура ЗагрузитьДанныеДляРасчета10010(Документ, ДанныеДляРасчетаDOM, Необработанные)
	ИменаУзлов = "calcYears, mobilDays, kfReg, kfShortDays, calcConditionList, multipart, causeRadiation,
	|excludePeriodList, downPeriodList, experience, baseCalcDays, absenceFromWork";
	Расчет = УзлыЭлементаDOM(ДанныеДляРасчетаDOM, ИменаУзлов, Необработанные);
	
	// Наличие заявления о замене лет, Годы для расчета, Сумма заработка за год.
	Если ТипЗнч(Расчет.calcYears) = Тип("ЭлементDOM") Тогда
		ИменаУзлов = "twoPrevYears, changeYears";
		Годы = УзлыЭлементаDOM(Расчет.calcYears, ИменаУзлов, Необработанные);
		Если ТипЗнч(Годы.twoPrevYears) = Тип("ЭлементDOM") Тогда
			Документ.Вставить("ЗаменаЛетРасчетногоПериода", Ложь);
			ВложенныеУзлы = СериализацияБЗК.СписокDOM(Годы.twoPrevYears, "yearInfo", Необработанные);
		ИначеЕсли ТипЗнч(Годы.changeYears) = Тип("ЭлементDOM") Тогда
			Документ.Вставить("ЗаменаЛетРасчетногоПериода", Истина);
			ВложенныеУзлы = СериализацияБЗК.СписокDOM(Годы.changeYears, "yearInfo", Необработанные);
		Иначе
			ВложенныеУзлы = Новый Массив;
		КонецЕсли;
		НомерГода = 0;
		Для Каждого ГодDOM Из ВложенныеУзлы Цикл
			ИменаУзлов = "year, sum, insurersCalcType";
			Год = УзлыЭлементаDOM(ГодDOM, ИменаУзлов, Необработанные);
			НомерГода = НомерГода + 1;
			Если НомерГода = 1 Тогда
				Документ.Вставить("ПервыйРасчетныйГод", СериализацияБЗК.ЧислоИзXML(Год.year));
				Документ.Вставить("ПервыйРасчетныйГодЗаработок", СериализацияБЗК.ЧислоИзXML(Год.sum));
				Документ.Вставить("ПервыйРасчетныйГодВидЗаработка", Перечисления.СпособыУчетаГодовогоЗаработкаСФР.ЗначениеИзXML(
					СериализацияБЗК.СтрокаИзXML(Год.insurersCalcType)));
			ИначеЕсли НомерГода = 2 Тогда
				Документ.Вставить("ВторойРасчетныйГод", СериализацияБЗК.ЧислоИзXML(Год.year));
				Документ.Вставить("ВторойРасчетныйГодЗаработок", СериализацияБЗК.ЧислоИзXML(Год.sum));
				Документ.Вставить("ВторойРасчетныйГодВидЗаработка", Перечисления.СпособыУчетаГодовогоЗаработкаСФР.ЗначениеИзXML(
					СериализацияБЗК.СтрокаИзXML(Год.insurersCalcType)));
			Иначе
				Необработанные.Добавить(ГодDOM);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Приостановления трудовых договоров.
	Если Расчет.mobilDays <> Неопределено Тогда
		Документ.Вставить("ПриостановлениеТДКалендарныхДней", СериализацияБЗК.ЧислоИзXML(Расчет.mobilDays));
	КонецЕсли;
	
	// Районный коэффициент.
	Если Расчет.kfReg <> Неопределено Тогда
		Документ.Вставить("РайонныйКоэффициент", СериализацияБЗК.ЧислоИзXML(Расчет.kfReg));
	КонецЕсли;
	
	// Количество ставок при неполном рабочем времени (от 0 до 1).
	Если Расчет.kfShortDays <> Неопределено Тогда
		Документ.Вставить("ДоляВремени", СериализацияБЗК.ЧислоИзXML(Расчет.kfShortDays));
	КонецЕсли;
	
	// Условия исчисления.
	Если ТипЗнч(Расчет.calcConditionList) = Тип("ЭлементDOM") Тогда
		ВложенныеУзлы = СериализацияБЗК.СписокDOM(Расчет.calcConditionList, "calcCondition", Необработанные);
		Номер = 0;
		Для Каждого УсловиеИсчисленияDOM Из ВложенныеУзлы Цикл
			Номер = Номер + 1;
			Если Номер < 6 Тогда
				Документ.Вставить("УсловияИсчисленияКод" + Номер, СериализацияБЗК.СтрокаИзXML(УсловиеИсчисленияDOM));
			Иначе
				Необработанные.Добавить(УсловиеИсчисленияDOM);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Одновременный уход за несколькими детьми: Среднемесячный заработок.
	Если ТипЗнч(Расчет.multipart) = Тип("ЭлементDOM") Тогда
		Если СериализацияБЗК.ЭтоЭлементТипаНеопределено(Расчет.multipart) Тогда
			Документ.Вставить("УходЗаНесколькимиДетьми", Ложь);
		Иначе
			Документ.Вставить("УходЗаНесколькимиДетьми", Истина);
			Уход = УзлыЭлементаDOM(Расчет.multipart, "avgSal");
			Если Уход.avgSal <> Неопределено Тогда
				Документ.Вставить("СреднемесячныйЗаработок", СериализацияБЗК.ЧислоИзXML(Уход.avgSal));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Льготы: Причина воздействия радиации.
	Если Расчет.causeRadiation <> Неопределено Тогда
		ЗагрузитьПричинуЛьгот10010(Документ, Расчет.causeRadiation);
	КонецЕсли;
	
	// Периоды за которые не начисляется пособие за счет ФСС.
	ЗагрузитьИсключаемыеПериоды(Документ, Расчет);
	
	// Периоды простоя.
	ЗагрузитьПериодыПростоя(Документ, Расчет);
	
	// Страховой стаж, Нестраховой период.
	Если ТипЗнч(Расчет.experience) = Тип("ЭлементDOM") Тогда
		ИменаПолей = "insurYY, insurMM, notInsurYY, notInsurMM";
		СтажDOM = УзлыЭлементаDOM(Расчет.experience, ИменаПолей);
		Документ.Вставить("СтраховойСтажЛет", СериализацияБЗК.ЧислоИзXML(СтажDOM.insurYY));
		Документ.Вставить("СтраховойСтажМесяцев", СериализацияБЗК.ЧислоИзXML(СтажDOM.insurMM));
		Документ.Вставить("НестраховойСтажЛет", СериализацияБЗК.ЧислоИзXML(СтажDOM.notInsurYY));
		Документ.Вставить("НестраховойСтажМесяцев", СериализацияБЗК.ЧислоИзXML(СтажDOM.notInsurMM));
	КонецЕсли;
	
	// Число календарных дней, учитываемых в расчетном периоде.
	Если Расчет.baseCalcDays <> Неопределено Тогда
		Документ.Вставить("КалендарныхДнейРасчетногоПериода", СериализацияБЗК.ЧислоИзXML(Расчет.baseCalcDays));
	КонецЕсли;
	
	// Период освобождения от работы.
	Если Расчет.Свойство("absenceFromWork") Тогда
		ПериодDOM = УзлыЭлементаDOM(Расчет.absenceFromWork, "begin, end");
		Документ.Вставить("ОтпускПоУходуДатаНачала", СериализацияБЗК.ДатаИзXML(ПериодDOM.begin));
		Документ.Вставить("ОтпускПоУходуДатаОкончания", СериализацияБЗК.ДатаИзXML(ПериодDOM.end));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьПараметрыНазначения10010(Документ, НазначениеDOM, Необработанные)
	ИменаУзлов = "insurancePaymentObligation, assignmentMethod, insuredWorksSeveralInsurers, contractsInfo";
	Назначение = УзлыЭлементаDOM(НазначениеDOM, ИменаУзлов, Необработанные);
	
	Если Назначение.insurancePaymentObligation <> Неопределено Тогда
		Документ.Вставить("ДоговорГПХОблагаетсяВзносамиНС",
			СериализацияБЗК.БулевоИзXML(Назначение.insurancePaymentObligation));
	КонецЕсли;
	
	Если Назначение.assignmentMethod <> Неопределено Тогда
		Документ.Вставить("МетодНазначенияИВыплатыПособия",
			Перечисления.МетодыНазначенияИВыплатыПособийСФР.ЗначениеИзXML(
				СериализацияБЗК.СтрокаИзXML(Назначение.assignmentMethod)));
	КонецЕсли;
	
	Если Назначение.insuredWorksSeveralInsurers <> Неопределено Тогда
		Документ.Вставить("ЧислитсяУНесколькихСтрахователей",
			СериализацияБЗК.БулевоИзXML(Назначение.insuredWorksSeveralInsurers));
	КонецЕсли;
	
	Если ТипЗнч(Назначение.contractsInfo) = Тип("ЭлементDOM") Тогда
		ИменаУзлов = "workerContract, GPHcontract, workerAndGPHcontract";
		Договоры = УзлыЭлементаDOM(Назначение.contractsInfo, ИменаУзлов, Необработанные);
		Если Договоры.workerContract <> Неопределено Тогда
			Документ.Вставить("ВидДоговораТрудовой", Истина);
			Документ.Вставить("ВидДоговораГПХ", Ложь);
			Договор = УзлыЭлементаDOM(Договоры.workerContract, "period", Необработанные);
			Если Договор.period <> Неопределено Тогда
				Период = УзлыЭлементаDOM(Договор.period, "begin, end", Необработанные);
				Документ.Вставить("ТрудовойДоговорДатаНачала", СериализацияБЗК.ДатаИзXML(Период.begin));
				Документ.Вставить("ТрудовойДоговорДатаОкончания", СериализацияБЗК.ДатаИзXML(Период.end));
			КонецЕсли;
		ИначеЕсли Договоры.GPHcontract <> Неопределено Тогда
			Документ.Вставить("ВидДоговораТрудовой", Ложь);
			Документ.Вставить("ВидДоговораГПХ", Истина);
			Договор = УзлыЭлементаDOM(Договоры.GPHcontract, "period", Необработанные);
			Если Договор.period <> Неопределено Тогда
				Период = УзлыЭлементаDOM(Договор.period, "begin, end", Необработанные);
				Документ.Вставить("ТрудовойДоговорДатаНачала", СериализацияБЗК.ДатаИзXML(Период.begin));
				Документ.Вставить("ТрудовойДоговорДатаОкончания", СериализацияБЗК.ДатаИзXML(Период.end));
			КонецЕсли;
		ИначеЕсли Договоры.workerAndGPHcontract <> Неопределено Тогда
			Документ.Вставить("ВидДоговораТрудовой", Истина);
			Документ.Вставить("ВидДоговораГПХ", Истина);
			Договоры2 = УзлыЭлементаDOM(Договоры.workerAndGPHcontract, "workerContract", Необработанные);
			Если Договоры2.workerContract <> Неопределено Тогда
				Договор = УзлыЭлементаDOM(Договоры2.workerContract, "period", Необработанные);
				Если Договор.period <> Неопределено Тогда
					Период = УзлыЭлементаDOM(Договор.period, "begin, end", Необработанные);
					Документ.Вставить("ТрудовойДоговорДатаНачала", СериализацияБЗК.ДатаИзXML(Период.begin));
					Документ.Вставить("ТрудовойДоговорДатаОкончания", СериализацияБЗК.ДатаИзXML(Период.end));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеНСПЗ10010(Документ, ЭлементDOM, Необработанные)
	ИменаПолей = "insuranceCaseState, n1, profIllnessAct, freeFormAct, courtDecision";
	УзлыНСПЗ = УзлыЭлементаDOM(ЭлементDOM, ИменаПолей, Необработанные);
	
	// insuranceCaseState - boolean - Статус страхового случая:
	// Ложь - если случай не признается НС и ПЗ; Истина - если случай считается НС и ПЗ.
	Если УзлыНСПЗ.insuranceCaseState <> Неопределено Тогда
		Признан = СериализацияБЗК.БулевоИзXML(УзлыНСПЗ.insuranceCaseState);
		Если Признан = Истина Тогда
			Документ.Вставить("ПризнаниеСлучаяСтраховым", Перечисления.ПризнаниеСлучаяСтраховым.Признан);
		ИначеЕсли Признан = Ложь Тогда
			Документ.Вставить("ПризнаниеСлучаяСтраховым", Перечисления.ПризнаниеСлучаяСтраховым.НеПризнан);
		КонецЕсли;
	КонецЕсли;
	
	// n1 - Номер акта Н1, Дата акта Н1.
	Если УзлыНСПЗ.n1 <> Неопределено Тогда
		УзелАкт = УзлыЭлементаDOM(УзлыНСПЗ.n1, "num, issueDate", Необработанные);
		Документ.Вставить("АктН1Номер",      СериализацияБЗК.СтрокаИзXML(УзелАкт.num));
		Документ.Вставить("АктН1ДатаВыдачи", СериализацияБЗК.ДатаИзXML(УзелАкт.issueDate));
	КонецЕсли;
	
	// profIllnessAct - Дата акта о профессиональном заболевании.
	Если УзлыНСПЗ.profIllnessAct <> Неопределено Тогда
		УзелАкт = УзлыЭлементаDOM(УзлыНСПЗ.profIllnessAct, "issueDate", Необработанные);
		Документ.Вставить("АктПЗДатаВыдачи", СериализацияБЗК.ДатаИзXML(УзелАкт.issueDate));
	КонецЕсли;
	
	// freeFormAct - Номер акта в произвольной форме, Дата акта в произвольной форме.
	Если УзлыНСПЗ.freeFormAct <> Неопределено Тогда
		УзелАкт = УзлыЭлементаDOM(УзлыНСПЗ.freeFormAct, "num, issueDate", Необработанные);
		Документ.Вставить("АктВПроизвольнойФормеНомер",      СериализацияБЗК.СтрокаИзXML(УзелАкт.num));
		Документ.Вставить("АктВПроизвольнойФормеДатаВыдачи", СериализацияБЗК.ДатаИзXML(УзелАкт.issueDate));
	КонецЕсли;
	
	// courtDecision - Номер решения суда, Дата решения суда.
	Если УзлыНСПЗ.courtDecision <> Неопределено Тогда
		УзелАкт = УзлыЭлементаDOM(УзлыНСПЗ.courtDecision, "num, issueDate", Необработанные);
		Документ.Вставить("РешениеСудаНомер",      СериализацияБЗК.СтрокаИзXML(УзелАкт.num));
		Документ.Вставить("РешениеСудаДатаВыдачи", СериализацияБЗК.ДатаИзXML(УзелАкт.issueDate));
	КонецЕсли;
КонецПроцедуры

Процедура ЗагрузитьСведенияОРебенке10010(Документ, ЭлементDOM, Необработанные)
	ИменаПолей = "birthDate, fullName, snils, gender";
	ИнформацияDOM = УзлыЭлементаDOM(ЭлементDOM, ИменаПолей, Необработанные);
	
	Документ.Вставить("РебенокДатаРождения", СериализацияБЗК.ДатаИзXML(ИнформацияDOM.birthDate));
	
	ФИО = СЭДОФСС.ФИОИзXML(ИнформацияDOM.fullName);
	Документ.Вставить("РебенокФамилия",  ФИО.Фамилия);
	Документ.Вставить("РебенокИмя",      ФИО.Имя);
	Документ.Вставить("РебенокОтчество", ФИО.Отчество);
	
	Документ.Вставить("РебенокСНИЛС", СЭДОФСС.СНИЛСИзXML(ИнформацияDOM.snils));
	
	Пол = ВРег(СокрЛП(СериализацияБЗК.СтрокаИзXML(ИнформацияDOM.gender)));
	Если Пол = "MALE" Тогда
		Документ.Вставить("РебенокПол", Перечисления.ПолФизическогоЛица.Мужской);
	ИначеЕсли Пол = "FEMALE" Тогда
		Документ.Вставить("РебенокПол", Перечисления.ПолФизическогоЛица.Женский);
	Иначе
		Документ.Вставить("РебенокПол", Перечисления.ПолФизическогоЛица.ПустаяСсылка());
	КонецЕсли;
КонецПроцедуры

