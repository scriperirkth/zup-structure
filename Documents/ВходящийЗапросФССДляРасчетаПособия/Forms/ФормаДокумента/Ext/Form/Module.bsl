#КонецОбласти

#Область ПриостановленияТрудовыхДоговоров

Процедура ОбновитьЭлементыГруппыПриостановленияТрудовыхДоговоров(НастройкиГруппы)
	НастройкиГруппы.Видимость = ЭтоОбычныйБольничный Или ЭтоНСПЗ;
	Если Не НастройкиГруппы.Видимость Тогда
		Возврат;
	КонецЕсли;
	НастройкиГруппы.Заполнена = Объект.ПриостановленияТрудовыхДоговоров.Количество() > 0;
	ВидимостьОтдельныхПолейШапки = Особенности.Версия_2_45
		И Объект.ПриостановленияТрудовыхДоговоров.Количество() < 2;
	Если НастройкиГруппы.Развернута Тогда
		ВидимостьТаблицы = Не ВидимостьОтдельныхПолейШапки;
		Элементы.ПриостановлениеТДОснованиеНПА.Видимость = ВидимостьОтдельныхПолейШапки И (
			ЗначениеЗаполнено(Объект.ПриостановлениеТДОснованиеНПА) Или РежимРедактирования);
		Элементы.ПриостановлениеТДКалендарныхДней.Видимость = ВидимостьОтдельныхПолейШапки;
		Элементы.ПриостановленияТрудовыхДоговоров.Видимость = ВидимостьТаблицы;
		Если ВидимостьТаблицы Тогда
			ЕстьДаты = Ложь;
			ЕстьДни  = Ложь;
			Для Каждого Период Из Объект.ПриостановленияТрудовыхДоговоров Цикл
				Если ЗначениеЗаполнено(Период.ДатаНачала) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
					ЕстьДаты = Истина;
				КонецЕсли;
				Если ЗначениеЗаполнено(Период.КалендарныхДней) Тогда
					ЕстьДни = Истина;
				КонецЕсли;
			КонецЦикла;
			Элементы.ПриостановленияТрудовыхДоговоровДатаНачала.Видимость = ЕстьДаты Или РежимРедактирования;
			Элементы.ПриостановленияТрудовыхДоговоровДатаОкончания.Видимость = ЕстьДаты Или РежимРедактирования;
			Элементы.ПриостановленияТрудовыхДоговоровКалендарныхДней.Видимость = ЕстьДни Или РежимРедактирования;
		КонецЕсли;
	ИначеЕсли НастройкиГруппы.Заполнена Тогда
		Если ВидимостьОтдельныхПолейШапки Тогда
			НаименованиеПериода = ЗарплатаКадрыКлиентСервер.ПредставлениеДней(Объект.ПриостановлениеТДКалендарныхДней);
			НастройкиГруппы.Представление = НаименованиеПериода + " - " + Строка(Объект.ПриостановлениеТДОснованиеНПА);
		Иначе
			Представления = Новый Массив;
			Для Каждого Период Из Объект.ПриостановленияТрудовыхДоговоров Цикл
				Если ЗначениеЗаполнено(Период.ДатаНачала) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
					НаименованиеПериода = ОбщегоНазначенияБЗК.НаименованиеПериода(Период.ДатаНачала, Период.ДатаОкончания);
				ИначеЕсли ЗначениеЗаполнено(Период.КалендарныхДней) Тогда
					НаименованиеПериода = ЗарплатаКадрыКлиентСервер.ПредставлениеДней(Период.КалендарныхДней);
				Иначе
					Продолжить;
				КонецЕсли;
				Представления.Добавить(НаименованиеПериода + " - " + Строка(Период.ОснованиеНПА));
			КонецЦикла;
			НастройкиГруппы.Представление = СтрСоединить(Представления, ", ");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СпособВыплаты

&НаСервере
Процедура ОбновитьЭлементыГруппыСпособВыплаты(НастройкиГруппы)
	// Страница способа выплаты.
	Если НастройкиГруппы.Развернута Тогда
		// Список выбора.
		СпособВыплаты = Объект.СпособВыплатыПособия;
		СЭДОФСС.СписокВыбораСпособовВыплаты(Элементы.СпособВыплатыПособия.СписокВыбора, СпособВыплаты, Объект.СотрудникКатегория);
		Если СпособВыплаты = Перечисления.СпособыВыплатыПособия.НаКартуМИР Тогда
			УстановитьСтраницу(Элементы.СтраницыСпособовВыплатыПособия, Элементы.СтраницаВыплатитьНаКартуМИР);
		ИначеЕсли СпособВыплаты = Перечисления.СпособыВыплатыПособия.ЧерезБанк Тогда
			УстановитьСтраницу(Элементы.СтраницыСпособовВыплатыПособия, Элементы.СтраницаВыплатитьЧерезБанк);
			Элементы.БанкКоррСчет.Видимость = Не Особенности.Версия_3;
			Элементы.БанкНаименование.Видимость = Не Особенности.Версия_3;
			// Результат проверки номера счета.
			Элементы.РезультатПроверкиНомераСчета.Видимость = Не Особенности.Версия_3;
			Если Элементы.РезультатПроверкиНомераСчета.Видимость Тогда
				РезультатПроверки = ПроверкиБЗК.РезультатПроверкиНомераСчета(
					Объект.НомерСчета,
					Объект.БанкБИК,
					Объект.БанкКоррСчет);
				Элементы.РезультатПроверкиНомераСчета.Заголовок = РезультатПроверки.Пояснение;
				Если РезультатПроверки.Успех Тогда
					Элементы.РезультатПроверкиНомераСчета.ЦветФона = ЦветаСтиля.ЦветФонаУспешнойОперацииБЗК;
				Иначе
					Элементы.РезультатПроверкиНомераСчета.ЦветФона = ЦветаСтиля.ЦветФонаПредупрежденияБЗК;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СпособВыплаты = Перечисления.СпособыВыплатыПособия.ПочтовымПереводом Тогда
			УстановитьСтраницу(Элементы.СтраницыСпособовВыплатыПособия, Элементы.СтраницаВыплатитьПочтовымПереводом);
			Элементы.АдресПроживанияСтроение.Видимость = Особенности.Версия_3;
			Элементы.АдресПроживанияЗаПределамиРФ.Видимость = Особенности.Версия_3;
		ИначеЕсли СпособВыплаты = Перечисления.СпособыВыплатыПособия.ИнаяОрганизация Тогда
			УстановитьСтраницу(Элементы.СтраницыСпособовВыплатыПособия, Элементы.СтраницаВыплатитьИнаяОрганизация);
			ЕстьРегномерФСС = ЗначениеЗаполнено(Объект.ИнаяОрганизацияРегистрационныйНомер);
			ЕстьРегномерСФР = ЗначениеЗаполнено(Объект.ИнаяОрганизацияРегистрационныйНомерСФР);
			Элементы.ИнаяОрганизацияРегистрационныйНомер.Видимость = ЕстьРегномерФСС Или РежимРедактирования;
			Элементы.ИнаяОрганизацияРегистрационныйНомерСФР.Видимость = ЕстьРегномерСФР Или РежимРедактирования;
			Элементы.ИнаяОрганизацияИНН.Видимость = Не Особенности.Версия_3;
			Элементы.ИнаяОрганизацияКПП.Видимость = Не Особенности.Версия_3;
		Иначе
			УстановитьСтраницу(Элементы.СтраницыСпособовВыплатыПособия, Неопределено);
		КонецЕсли;
	Иначе
		Если Объект.СпособВыплатыПособия = Перечисления.СпособыВыплатыПособия.ПочтовымПереводом Тогда
			НастройкиГруппы.Представление = ПредставлениеАдреса("АдресПроживания", Ложь);
		Иначе
			НастройкиГруппы.Представление = СЭДОФСС.ПредставлениеСпособаВыплаты(Объект);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ИзвещениеФСС

&НаСервере
Процедура ОбновитьЭлементыГруппыИзвещениеФСС(НастройкиГруппы)
	НастройкиГруппы.Представление = ПредставлениеНомераИДаты(Объект.ИзвещениеФССНомер, Объект.ИзвещениеФССДата);
КонецПроцедуры

#КонецОбласти

#Область ДокументыНСПЗ

&НаСервере
Процедура ОбновитьЭлементыГруппыДокументыНСПЗ(НастройкиГруппы)
	НастройкиГруппы.Видимость = (ЭтоОбычныйБольничный Или ЭтоНСПЗ);
	Если Не НастройкиГруппы.Видимость Тогда
		Возврат;
	КонецЕсли;
	Представления = Новый Массив;
	Если ЗначениеЗаполнено(Объект.ПризнаниеСлучаяСтраховым) Тогда
		ПредставлениеЗначения = Строка(Объект.ПризнаниеСлучаяСтраховым);
		Представления.Добавить(НСтр("ru = 'Страховой случай'"));
		Представления.Добавить(НРег(Лев(ПредставлениеЗначения, 1)) + Сред(ПредставлениеЗначения, 2));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АктН1ДатаВыдачи) Или ЗначениеЗаполнено(Объект.АктН1Номер) Тогда
		Представления.Добавить(НСтр("ru = 'Акт формы Н-1'"));
		Представления.Добавить(ПредставлениеНомераИДаты(Объект.АктН1Номер, Объект.АктН1ДатаВыдачи));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АктПЗДатаВыдачи) Тогда
		Представления.Добавить(Элементы.АктПЗДатаВыдачи.Заголовок);
		Представления.Добавить(Формат(Объект.АктПЗДатаВыдачи, "ДЛФ=D"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АктВПроизвольнойФормеДатаВыдачи) Или ЗначениеЗаполнено(Объект.АктВПроизвольнойФормеНомер) Тогда
		Представления.Добавить(НСтр("ru = 'Акт в произвольной форме'"));
		Представления.Добавить(ПредставлениеНомераИДаты(Объект.АктВПроизвольнойФормеНомер, Объект.АктВПроизвольнойФормеДатаВыдачи));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.РешениеСудаДатаВыдачи) Или ЗначениеЗаполнено(Объект.РешениеСудаНомер) Тогда
		Представления.Добавить(НСтр("ru = 'Решение суда'"));
		Представления.Добавить(ПредставлениеНомераИДаты(Объект.РешениеСудаНомер, Объект.РешениеСудаДатаВыдачи));
	КонецЕсли;
	УтратаТрудоспобностиВидимость = Не Особенности.Версия_3 И (ЭтоОбычныйБольничный Или ЭтоНСПЗ Или РежимРедактирования);
	Элементы.УстановленаУтратаТрудоспобности.Видимость = УтратаТрудоспобностиВидимость;
	Если УтратаТрудоспобностиВидимость Тогда
		УстановленаУтратаТрудоспобности = ЗначениеЗаполнено(Объект.УтратаТрудоспобности);
		Если УстановленаУтратаТрудоспобности Тогда
			Представление = СтрШаблон(НСтр("ru = 'Утрата трудоспобности (код %1)'"), Объект.УтратаТрудоспобности);
			Представления.Добавить(Представление);
			Элементы.УстановленаУтратаТрудоспобности.Заголовок = ?(Объект.УтратаТрудоспобности = "29", "", Представление);
		КонецЕсли;
	КонецЕсли;
	НастройкиГруппы.Представление = СтрСоединить(Представления, " ");
КонецПроцедуры

#КонецОбласти

#Область Перерасчет

&НаКлиенте
Процедура ПерерасчетПриИзменении(Элемент)
	Элементы.ПерерасчетИдентификаторСтрокиРеестра.Видимость = Объект.Перерасчет;
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаСервере
Функция ПредставлениеПерерасчета()
	Элементы.ПерерасчетИдентификаторСтрокиРеестра.Видимость = Объект.Перерасчет;
	Если Не Объект.Перерасчет Тогда
		Возврат "";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ПерерасчетИдентификаторСтрокиРеестра) Тогда
		Возврат НСтр("ru = 'Да, но не заполнен идентификатор строки реестра'");
	КонецЕсли;
	МассивСтрок = СтрРазделить(Объект.ПерерасчетИдентификаторСтрокиРеестра, "_:", Ложь);
	Если МассивСтрок.Количество() >= 7 Тогда
		ОписаниеТиповЧисло = Новый ОписаниеТипов("Число");
		Год          = ОписаниеТиповЧисло.ПривестиЗначение(МассивСтрок[2]);
		Месяц        = ОписаниеТиповЧисло.ПривестиЗначение(МассивСтрок[3]);
		День         = ОписаниеТиповЧисло.ПривестиЗначение(МассивСтрок[4]);
		НомерРеестра = ОписаниеТиповЧисло.ПривестиЗначение(МассивСтрок[5]);
		НомерСтроки  = ОписаниеТиповЧисло.ПривестиЗначение(МассивСтрок[6]);
		Если Год > 2000 И Месяц > 0 И День > 0 И НомерРеестра > 0 И НомерСтроки > 0 Тогда
			Возврат СтрШаблон(
				НСтр("ru = 'Да, по реестру от %1 № %2, строка № %3'"),
				Формат(Дата(Год, Месяц, День), "ДЛФ=D"),
				Формат(НомерРеестра, "ЧГ="),
				Формат(НомерСтроки, "ЧГ="));
		КонецЕсли;
	КонецЕсли;
	Возврат СтрШаблон(
		НСтр("ru = 'Да, по идентификатору строки реестра %1'"),
		Объект.ПерерасчетИдентификаторСтрокиРеестра);
КонецФункции

#КонецОбласти

#Область НеобработанныеУзлы

&НаСервере
Процедура ОбновитьЭлементыГруппыНеобработанныеУзлы(НастройкиГруппы)
	Количество = Объект.НеобработанныеУзлы.Количество();
	НастройкиГруппы.Видимость = Объект.Загружен И (Количество > 0 Или РежимРедактирования);
	Если Не НастройкиГруппы.Видимость Тогда
		Возврат;
	КонецЕсли;
	НастройкиГруппы.Заполнена = Количество > 0;
	Если НастройкиГруппы.Развернута Тогда
		// В группе нет элементов для которых требуется обновлять видимость или доступность.
	Иначе
		НастройкиГруппы.Представление = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 узел;;%1 узла;%1 узлов;'"),
			Количество);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Основания

&НаСервере
Процедура ОбновитьЭлементыГруппыОснования(НастройкиГруппы)
	ЕстьОснование = ЗначениеЗаполнено(Объект.ИдентификаторОснования);
	ЕстьИсправление = ЗначениеЗаполнено(Объект.ИсправлениеНомерПроцесса);
	ЕстьПричина = ЗначениеЗаполнено(Объект.ИсправлениеКодПричины);
	НастройкиГруппы.Видимость = ЕстьОснование Или ЕстьИсправление Или ЕстьПричина;
	Если Не НастройкиГруппы.Видимость Тогда
		Возврат;
	КонецЕсли;
	НастройкиГруппы.Заполнена = Истина;
	Если НастройкиГруппы.Развернута Тогда
		Элементы.ИсходящееСообщениеОСтраховомСлучаеГруппа.Видимость = ЕстьОснование;
		Элементы.ИсправлениеНомерПроцессаГруппа.Видимость = ЕстьИсправление;
		Элементы.ИсправлениеКодПричины.Видимость = ЕстьПричина;
		Элементы.ИсправлениеТекстПричины.Видимость = ЕстьПричина;
		Если ЕстьПричина И Элементы.ИсправлениеКодПричины.СписокВыбора.Количество() = 0 Тогда
			ЭлементСписка = Элементы.ИсправлениеКодПричины.СписокВыбора.Добавить();
			ЭлементСписка.Значение = "1";
			ЭлементСписка.Представление = НСтр("ru = '1 - Подпроцесс по замене лет'");
			ЭлементСписка = Элементы.ИсправлениеКодПричины.СписокВыбора.Добавить();
			ЭлементСписка.Значение = "2";
			ЭлементСписка.Представление = НСтр("ru = '2 - Подпроцесс по уточнению/коррекции данных по предыдущему проактивному процессу.
			|Заполняется в случае появления новых данных по проактивному процессу на стороне СФР.'");
			Если Элементы.ИсправлениеКодПричины.СписокВыбора.НайтиПоЗначению(Объект.ИсправлениеКодПричины) = Неопределено Тогда
				ЭлементСписка = Элементы.ИсправлениеКодПричины.СписокВыбора.Добавить();
				ЭлементСписка.Значение = Объект.ИсправлениеКодПричины;
				ЭлементСписка.Представление = Объект.ИсправлениеКодПричины + " - " + НСтр("ru = 'неизвестная причина'");
			КонецЕсли;
		КонецЕсли;
	Иначе
		Представления = Новый Массив;
		Если ЕстьОснование Тогда
			Если ЗначениеЗаполнено(ИсходящееСообщениеОСтраховомСлучае) Тогда
				Представления.Добавить(ИсходящееСообщениеОСтраховомСлучае);
			Иначе
				Представления.Добавить(Объект.ИдентификаторОснования);
			КонецЕсли;
		КонецЕсли;
		Если ЕстьИсправление Тогда
			Представления.Добавить(СтрШаблон(НСтр("ru = 'Исправляемый процесс: %1'"), Формат(Объект.ИсправлениеНомерПроцесса, "ЧГ=")));
		КонецЕсли;
		Если ЕстьПричина Тогда
			Если Объект.ИсправлениеКодПричины = "1" Тогда
				Представление = НСтр("ru = '1 - Замена лет'");
			ИначеЕсли Объект.ИсправлениеКодПричины = "2" Тогда
				Представление = НСтр("ru = '2 - Новые данные СФР'");
			Иначе
				Представление = Объект.ИсправлениеКодПричины;
			КонецЕсли;
			Представления.Добавить(СтрШаблон(НСтр("ru = 'Причина подпроцесса: %1'"), Представление));
		КонецЕсли;
		НастройкиГруппы.Представление = СтрСоединить(Представления, ", ");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Результат

&НаСервере
Процедура ОбновитьЭлементыГруппыРезультат(НастройкиГруппы)
	НастройкиГруппы.Заполнена = Истина;
	Если Не НастройкиГруппы.Развернута Тогда
		Представления = Новый Массив;
		Если Объект.Обработан Тогда
			Представления.Добавить(НСтр("ru = 'Обработан'"));
		Иначе
			Представления.Добавить(НСтр("ru = 'Не обработан'"));
			Если ЗначениеЗаполнено(УведомлениеОбИзменении) Тогда
				Представления.Добавить(УведомлениеОбИзменении);
			ИначеЕсли ЗначениеЗаполнено(Объект.ОтветНаЗапрос) Тогда
				Представления.Добавить(Объект.ОтветНаЗапрос);
			КонецЕсли;
			Если ЗначениеЗаполнено(Объект.ПервичныйДокумент) Тогда
				Представления.Добавить(Объект.ПервичныйДокумент);
			КонецЕсли;
		КонецЕсли;
		НастройкиГруппы.Представление = СтрСоединить(Представления, ", ");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбщегоНазначения

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСтраницу(Страницы, ТекущаяСтраница)
	Для Каждого Страница Из Страницы.ПодчиненныеЭлементы Цикл
		Страница.Видимость = (Страница = ТекущаяСтраница);
	КонецЦикла;
	Если ТекущаяСтраница <> Неопределено Тогда
		Страницы.ТекущаяСтраница = ТекущаяСтраница;
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеНомераИДаты(Номер, Дата)
	Если ЗначениеЗаполнено(Номер) Или ЗначениеЗаполнено(Дата) Тогда
		Возврат СтрШаблон(НСтр("ru = '№ %1 от %2'"), Номер, Формат(Дата, "ДЛФ=D"));
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти

#Область Команды

&НаСервере
Процедура ВключитьВозможностьРедактированияНаСервере()
	РежимРедактирования = Истина;
	Элементы.СведенияВЗапросеГруппа.ТолькоПросмотр = Ложь;
	Элементы.СлужебныеПоляГруппа.ТолькоПросмотр = Ложь;
	Элементы.Страхователь.ТолькоПросмотр = Ложь;
	Элементы.Дата.ТолькоПросмотр = Ложь;
	Элементы.Номер.ТолькоПросмотр = Ложь;
	Элементы.ВидПособия.ТолькоПросмотр = Ложь;
	Элементы.ВходящийСрокОтвета.ТолькоПросмотр = Ложь;
	Элементы.ВерсияСпецификации.ТолькоПросмотр = Ложь;
	Элементы.ИсключаемыеПериоды.ИзменятьСоставСтрок      = Истина;
	Элементы.ИсключаемыеПериоды.ИзменятьПорядокСтрок     = Истина;
	Элементы.ИсключаемыеПериоды.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Авто;
	Элементы.ПериодыПростоя.ИзменятьСоставСтрок      = Истина;
	Элементы.ПериодыПростоя.ИзменятьПорядокСтрок     = Истина;
	Элементы.ПериодыПростоя.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Авто;
	ОбновитьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

#Область Поддержка

&НаСервере
Функция ПодготовитьВопросВПоддержку()
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	Вложения = Новый Массив;
	Возврат СЭДОФСС.ПодготовитьВопросВПоддержку(ДокументОбъект, Вложения);
КонецФункции

#КонецОбласти

#Область СвязанныеДокументы

&НаСервере
Процедура ЗаполнитьСвязанныеДокументы()
	
	// Формирование запроса.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.ВидУведомления КАК ВидУведомления
	|ИЗ
	|	Документ.УведомлениеОбИзмененииРасчетаПособия КАК Шапка
	|ГДЕ
	|	НЕ Шапка.ПометкаУдаления
	|	И Шапка.ВходящийЗапрос = &ВходящийЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	Шапка.ДатаСоздания УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Шапка.ТекстУведомления КАК СТРОКА(1000)) КАК ТекстУведомления
	|ИЗ
	|	Документ.УведомлениеОбОтсутствииОтветаСЭДО КАК Шапка
	|ГДЕ
	|	НЕ Шапка.ПометкаУдаления
	|	И Шапка.ВходящийЗапрос = &ВходящийЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	Шапка.ДатаСоздания УБЫВ";
	
	Запрос.УстановитьПараметр("ВходящийЗапрос", Объект.Ссылка);
	ЕстьИдентификаторОснования = ЗначениеЗаполнено(Объект.ИдентификаторОснования);
	Если ЕстьИдентификаторОснования Тогда
		Запрос.Текст = Запрос.Текст + ЗарплатаКадрыОбщиеНаборыДанных.РазделительЗапросов() +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Шапка.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ИсходящееСообщениеОСтраховомСлучаеФСС КАК Шапка
			|ГДЕ
			|	Шапка.ИдентификаторСообщения = &ИдентификаторОснования";
		Запрос.УстановитьПараметр("ИдентификаторОснования", Объект.ИдентификаторОснования);
	КонецЕсли;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	// Получение данных.
	УведомлениеОбИзменении = Неопределено;
	УведомлениеОбОтсутствииОтвета = Неопределено;
	ВидыУведомленийОбИзменении = Новый Массив;
	ТекстыУведомленийОбОтсутствииОтвета = Новый Массив;
	
	Таблица1 = РезультатыЗапроса[0].Выгрузить();
	Для Каждого СтрокаТаблицы1 Из Таблица1 Цикл
		УведомлениеОбИзменении = СтрокаТаблицы1.Ссылка;
		ВидыУведомленийОбИзменении.Добавить(Перечисления.ВидыУведомленийОбИзмененииРасчетаПособия.ОписаниеВидаУведомления(
			СтрокаТаблицы1.ВидУведомления));
	КонецЦикла;
	
	Таблица2 = РезультатыЗапроса[1].Выгрузить();
	Для Каждого СтрокаТаблицы2 Из Таблица2 Цикл
		УведомлениеОбОтсутствииОтвета = СтрокаТаблицы2.Ссылка;
		Если ЗначениеЗаполнено(СтрокаТаблицы2.ТекстУведомления) Тогда
			ТекстыУведомленийОбОтсутствииОтвета.Добавить(СтрокаТаблицы2.ТекстУведомления);
		КонецЕсли;
	КонецЦикла;
	
	ИсходящееСообщениеОСтраховомСлучае = Неопределено;
	Если ЕстьИдентификаторОснования Тогда
		Таблица3 = РезультатыЗапроса[2].Выгрузить();
		Для Каждого СтрокаТаблицы3 Из Таблица3 Цикл
			ИсходящееСообщениеОСтраховомСлучае = СтрокаТаблицы3.Ссылка;
		КонецЦикла;
	КонецЕсли;
	
	// Изменение элементов формы.
	Если ЗначениеЗаполнено(УведомлениеОбИзменении) Тогда
		Элементы.УведомлениеОбИзменении.Видимость = Истина;
		Элементы.УведомлениеОбИзмененииВидГруппа.Видимость = Истина;
		Элементы.УведомлениеОбИзмененииВид.Заголовок = СтрСоединить(ВидыУведомленийОбИзменении, Символы.ПС);
	Иначе
		Элементы.УведомлениеОбИзменении.Видимость = Ложь;
		Элементы.УведомлениеОбИзмененииВидГруппа.Видимость = Ложь;
	КонецЕсли;
	Элементы.УведомлениеОбОтсутствииОтвета.Видимость = ЗначениеЗаполнено(УведомлениеОбОтсутствииОтвета);
	Если ТекстыУведомленийОбОтсутствииОтвета.Количество() > 0 Тогда
		Элементы.УведомлениеОбОтсутствииОтветаТекстГруппа.Видимость = Истина;
		Элементы.УведомлениеОбОтсутствииОтветаТекст.Заголовок = СтрСоединить(ТекстыУведомленийОбОтсутствииОтвета, Символы.ПС);
	Иначе
		Элементы.УведомлениеОбОтсутствииОтветаТекстГруппа.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
