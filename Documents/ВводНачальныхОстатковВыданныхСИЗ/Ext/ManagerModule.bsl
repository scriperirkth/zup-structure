#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ДляВсехСтрок( ЗначениеРазрешено(ФизическиеЛица.ФизическоеЛицо, NULL КАК ИСТИНА)
	|	) И ЗначениеРазрешено(Организация)";
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// СтандартныеПодсистемы.ЗагрузкаДанныхИзФайла

// Переопределяет параметры загрузки данных из файла.
//
// Параметры:
//  Параметры - Структура:
//   * ИмяМакетаСШаблоном - Строка - наименование макета. Например, "ЗагрузкаИзФайла".
//   * ИмяТабличнойЧасти - Строка - Полное имя табличной части. Например, "Документ._ДемоСчетНаОплатуПокупателю.ТабличнаяЧасть.Товары"
//   * ОбязательныеКолонки - Массив из Строка - наименования обязательных для заполнения колонок.
//   * ТипДанныхКолонки - Соответствие из КлючИЗначение:
//      * Ключ - Строка - имя колонки;
//      * Значение - ОписаниеТипов - тип колонки загружаемых данных.
//   * ДополнительныеПараметры - Структура
//
Процедура УстановитьПараметрыЗагрузкиИзФайлаВТЧ(Параметры) Экспорт

КонецПроцедуры

// Производит сопоставление данных, загружаемых в табличную часть ПолноеИмяТабличнойЧасти,
// с данными в ИБ, и заполняет параметры АдресТаблицыСопоставления и СписокНеоднозначностей.
//
// Параметры:
//   АдресЗагружаемыхДанных    - Строка - адрес временного хранилища с таблицей значений, в которой
//                               находятся загруженные данные из файла. Состав колонок:
//     * Идентификатор - Число - порядковый номер строки;
//     * остальные колонки соответствуют колонкам макета ЗагрузкаИзФайла.
//   АдресТаблицыСопоставления - Строка - адрес временного хранилища с пустой таблицей значений,
//                               являющейся копией табличной части документа, 
//                                        которую необходимо заполнить из таблицы АдресЗагружаемыхДанных.
//   СписокНеоднозначностей - ТаблицаЗначений - список неоднозначных значений, для которых в ИБ имеется несколько подходящих вариантов.
//       * Колонка       - Строка - имя колонки, в которой была обнаружена неоднозначность;
//       * Идентификатор - Число  - идентификатор строки, в которой была обнаружена неоднозначность.
//   ПолноеИмяТабличнойЧасти   - Строка - полное имя табличной части, в которую загружаются данные.
//   ДополнительныеПараметры   - ЛюбойТип - Любые дополнительные сведения.
//
Процедура СопоставитьЗагружаемыеДанные(АдресЗагружаемыхДанных, АдресТаблицыСопоставления, СписокНеоднозначностей,
		ПолноеИмяТабличнойЧасти, ДополнительныеПараметры) Экспорт
	
	ТаблицаСопоставления = ПолучитьИзВременногоХранилища(АдресТаблицыСопоставления);
	ЗагружаемыеДанные = ПолучитьИзВременногоХранилища(АдресЗагружаемыхДанных);
	
	Запрос = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КадровыйУчет.СоздатьВТФизическиеЛицаРаботавшиеВОрганизации(МенеджерВременныхТаблиц, Истина, ДополнительныеПараметры.Организация,
		ДополнительныеПараметры.ДатаДокумента, ДополнительныеПараметры.ДатаДокумента, ДополнительныеПараметры.Подразделение);
	
	Запрос.УстановитьПараметр("МассивФизическихЛиц", ВыгрузитьКолонку(ЗагружаемыеДанные, "ФизическоеЛицо"));
	Запрос.УстановитьПараметр("МассивКодовПодразделений", ВыгрузитьКолонку(ЗагружаемыеДанные, "КодПодразделения"));
	Запрос.УстановитьПараметр("МассивСИЗ", ВыгрузитьКолонку(ЗагружаемыеДанные, "СИЗ"));
	Запрос.УстановитьПараметр("МассивНоменклатуры", ВыгрузитьКолонку(ЗагружаемыеДанные, "Номенклатура"));
	Запрос.УстановитьПараметр("МассивДолжностей", ВыгрузитьКолонку(ЗагружаемыеДанные, "Должность"));
	Запрос.УстановитьПараметр("МассивЕдиницИзмерения", ВыгрузитьКолонку(ЗагружаемыеДанные, "ЕдиницаИзмерения"));
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛица.ФизическоеЛицо КАК Ссылка,
		|	ФизическиеЛица.ФизическоеЛицо.Код КАК КодФизическогоЛица,
		|	ФизическиеЛица.ФизическоеЛицо.Наименование КАК ФизическоеЛицо
		|ИЗ
		|	ВТФизическиеЛицаРаботавшиеВОрганизации КАК ФизическиеЛица
		|ГДЕ
		|	ФизическиеЛица.ФизическоеЛицо.Наименование В (&МассивФизическихЛиц)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СИЗ.Ссылка КАК Ссылка,
		|	СИЗ.Наименование КАК СИЗ,
		|	СИЗ.ВидНоменклатуры КАК ВидНоменклатуры
		|ИЗ
		|	Справочник.СредстваИндивидуальнойЗащиты КАК СИЗ
		|ГДЕ
		|	СИЗ.Наименование В (&МассивСИЗ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СправочникНоменклатура.Ссылка КАК Ссылка,
		|	СправочникНоменклатура.Наименование КАК Номенклатура,
		|	СправочникНоменклатура.ВидНоменклатуры КАК ВидНоменклатуры
		|ИЗ
		|	Справочник.Номенклатура КАК СправочникНоменклатура
		|ГДЕ
		|	СправочникНоменклатура.Наименование В (&МассивНоменклатуры)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодразделенияОрганизаций.Ссылка КАК Ссылка,
		|	ПодразделенияОрганизаций.Код КАК КодПодразделения,
		|	ПодразделенияОрганизаций.Наименование КАК Подразделение,
		|	ПодразделенияОрганизаций.Владелец.Наименование КАК Организация
		|ИЗ
		|	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
		|ГДЕ
		|	ПодразделенияОрганизаций.Код В (&МассивКодовПодразделений)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Должности.Ссылка КАК Ссылка,
		|	Должности.Наименование КАК Должность
		|ИЗ
		|	Справочник.Должности КАК Должности
		|ГДЕ
		|	Должности.Наименование В (&МассивДолжностей);
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕдиницыИзмерения.Ссылка КАК Ссылка,
		|	ЕдиницыИзмерения.Наименование КАК ЕдиницаИзмерения
		|ИЗ
		|	Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Наименование В (&МассивЕдиницИзмерения)";
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	
	РезультатЗагрузки = Новый Структура;
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатыЗапросов[0].Выгрузить(), "ТаблицаФизическиеЛица", "ФизическоеЛицо");
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатыЗапросов[1].Выгрузить(), "ТаблицаСИЗ", "СИЗ");
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатыЗапросов[2].Выгрузить(), "ТаблицаНоменклатура", "Номенклатура");
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатыЗапросов[3].Выгрузить(), "ТаблицаКодыПодразделений", "КодПодразделения");
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатыЗапросов[4].Выгрузить(), "ТаблицаДолжности", "Должность");
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатыЗапросов[5].Выгрузить(), "ТаблицаЕдиницИзмерения", "ЕдиницаИзмерения");
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатЗагрузки.ТаблицаФизическиеЛица.Скопировать(), "ТаблицаФизическиеЛицаКодыФизическихЛиц", "ФизическоеЛицо, КодФизическогоЛица");
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатЗагрузки.ТаблицаСИЗ.Скопировать(), "ТаблицаСИЗВидНоменклатуры", "СИЗ, ВидНоменклатуры");
	СохранитьПроиндексированныйРезультат(РезультатЗагрузки, РезультатЗагрузки.ТаблицаКодыПодразделений.Скопировать(), "ТаблицаОрганизацийКодыПодразделений", "Организация, КодПодразделения");
	
	КэшДанныхЗагрузки = Новый Структура;
	КэшДанныхЗагрузки.Вставить("СоответствиеСтрокДатам", Новый Соответствие);
	КэшДанныхЗагрузки.Вставить("СоответствиеФизическихЛицПоОтбору", Новый Соответствие);
	КэшДанныхЗагрузки.Вставить("СоответствиеФизическихЛиц", Новый Соответствие);
	КэшДанныхЗагрузки.Вставить("СоответствиеКодовПодразделений", Новый Соответствие);
	КэшДанныхЗагрузки.Вставить("СоответствиеСИЗ", Новый Соответствие);
	КэшДанныхЗагрузки.Вставить("СоответствиеНоменклатуры", Новый Соответствие);
	КэшДанныхЗагрузки.Вставить("СоответствиеДолжностей", Новый Соответствие);
	КэшДанныхЗагрузки.Вставить("СоответствиеЕдиницИзмерения", Новый Соответствие);
	КэшДанныхЗагрузки.Вставить("СоответствиеПодразделенийПоОтбору", Новый Соответствие);
	
	ПустаяДата = Дата(1,1,1);
	Для Каждого СтрокаТаблицы Из ЗагружаемыеДанные Цикл
		НоваяСтрока = ТаблицаСопоставления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		Если НоваяСтрока.ДатаВыдачи = ПустаяДата Тогда
			ЗаполнитьПериодИзСтрокиВДату(
				НоваяСтрока, КэшДанныхЗагрузки.СоответствиеСтрокДатам, СтрокаТаблицы.ДатаВыдачи, "ДатаВыдачи");
		КонецЕсли;
		Если НоваяСтрока.ДатаСледующейВыдачи = ПустаяДата Тогда
			ЗаполнитьПериодИзСтрокиВДату(
				НоваяСтрока, КэшДанныхЗагрузки.СоответствиеСтрокДатам, СтрокаТаблицы.ДатаСледующейВыдачи, "ДатаСледующейВыдачи");
		КонецЕсли;
		ПроверитьНеоднозначностьФизическогоЛица(НоваяСтрока, СтрокаТаблицы, КэшДанныхЗагрузки, СписокНеоднозначностей, РезультатЗагрузки);
		ПроверитьНеоднозначностьПодразделения(НоваяСтрока, СтрокаТаблицы, КэшДанныхЗагрузки, СписокНеоднозначностей, РезультатЗагрузки);
		ПроверитьНеоднозначностьСИЗ(НоваяСтрока, СтрокаТаблицы, КэшДанныхЗагрузки, СписокНеоднозначностей, РезультатЗагрузки);
		ПроверитьНеоднозначностьНоменклатуры(НоваяСтрока, СтрокаТаблицы, КэшДанныхЗагрузки, СписокНеоднозначностей, РезультатЗагрузки);
		ПроверитьНеоднозначностьДолжностей(НоваяСтрока, СтрокаТаблицы, КэшДанныхЗагрузки, СписокНеоднозначностей, РезультатЗагрузки);
		ПроверитьНеоднозначностьЕдиницИзмерения(НоваяСтрока, СтрокаТаблицы, КэшДанныхЗагрузки, СписокНеоднозначностей, РезультатЗагрузки);
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ТаблицаСопоставления, АдресТаблицыСопоставления);
	
КонецПроцедуры

// Возвращает список подходящих объектов ИБ для неоднозначного значения ячейки.
// 
// Параметры:
//    ПолноеИмяТабличнойЧасти  - Строка - Полное имя табличной части, в которую загружаются данные.
//    ИмяКолонки               - Строка - Имя колонки, в который возникла неоднозначность. 
//    СписокНеоднозначностей    - Массив  - Массив для заполнения с неоднозначными данными.
//    ЗагружаемыеЗначенияСтрока - Строка  - Загружаемые данные, на основании которых возникла неоднозначность.
//    ДополнительныеПараметры   - ЛюбойТип - Любые дополнительные сведения
//
Процедура ЗаполнитьСписокНеоднозначностей(ПолноеИмяТабличнойЧасти, СписокНеоднозначностей, ИмяКолонки, ЗагружаемыеЗначенияСтрока, ДополнительныеПараметры) Экспорт
	
	Если ИмяКолонки = "ФизическоеЛицо" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|ГДЕ
		|	ФизическиеЛица.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", ЗагружаемыеЗначенияСтрока.ФизическоеЛицо);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокНеоднозначностей.Добавить(Выборка.Ссылка);  
		КонецЦикла;
	КонецЕсли;
	
	Если ИмяКолонки = "СИЗ" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СИЗ.Ссылка
			|ИЗ
			|	Справочник.СредстваИндивидуальнойЗащиты КАК СИЗ
			|ГДЕ
			|	СИЗ.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", ЗагружаемыеЗначенияСтрока.СИЗ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокНеоднозначностей.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Если ИмяКолонки = "Номенклатура" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", ЗагружаемыеЗначенияСтрока.Номенклатура);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокНеоднозначностей.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Если ИмяКолонки = "Должность" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Должности.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Должности КАК Должности
			|ГДЕ
			|	Должности.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", ЗагружаемыеЗначенияСтрока.Должность);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокНеоднозначностей.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Если ИмяКолонки = "Подразделение" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Подразделения.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ПодразделенияОрганизаций КАК Подразделения
			|ГДЕ
			|	Подразделения.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", ЗагружаемыеЗначенияСтрока.Подразделение);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокНеоднозначностей.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Если ИмяКолонки = "ЕдиницаИзмерения" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЕдиницыИзмерения.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения
			|ГДЕ
			|	ЕдиницыИзмерения.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", ЗагружаемыеЗначенияСтрока.ЕдиницаИзмерения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокНеоднозначностей.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

