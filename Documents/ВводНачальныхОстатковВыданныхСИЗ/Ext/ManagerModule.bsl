Процедура ЗаполнитьПериодИзСтрокиВДату(НоваяСтрока, СоответствиеСтрокДатам, СтрокаПериод, ИмяПоля)
	
	Период = СоответствиеСтрокДатам.Получить(СтрокаПериод);
	
	Если Период = Неопределено Тогда
		Период = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаПериод);
		СоответствиеСтрокДатам.Вставить(СтрокаПериод, Период);
	КонецЕсли;
	
	НоваяСтрока[ИмяПоля] = Период;
	
	Если ИмяПоля <> "ДатаСледующейВыдачи" И ЗначениеЗаполнено(Период) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеПериодичности = СредстваИндивидуальнойЗащиты.ОписаниеПериодичностиВыдачи();
	ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, НоваяСтрока);
	ОписаниеПериодичности.Кратность = НоваяСтрока.КратностьВыдачи;
	ОписаниеПериодичности.Периодичность = НоваяСтрока.ПериодичностьВыдачи;
	ОписаниеПериодичности.ЕдиницаПериодичности = НоваяСтрока.ЕдиницаПериодичностиВыдачи;
	НоваяСтрока.ДатаСледующейВыдачи =
		СредстваИндивидуальнойЗащиты.ДатаСледующейВыдачи(НоваяСтрока.ДатаВыдачи, ОписаниеПериодичности);
	
КонецПроцедуры

Процедура ПроверитьНеоднозначностьФизическогоЛица(НоваяСтрока, СтрокаТаблицы, КэшДанныхЗагрузки, СписокНеоднозначностей, РезультатЗагрузки)
	
	Если Не ПустаяСтрока(СтрокаТаблицы.ФизическоеЛицо) Тогда
		НоваяСтрока.ФизическоеЛицо = КэшДанныхЗагрузки.СоответствиеФизическихЛиц.Получить(СтрокаТаблицы.ФизическоеЛицо);
		Если Не ЗначениеЗаполнено(НоваяСтрока.ФизическоеЛицо) Тогда
			Отбор = Новый Структура("ФизическоеЛицо", СтрокаТаблицы.ФизическоеЛицо);
			Строки = РезультатЗагрузки.ТаблицаФизическиеЛица.НайтиСтроки(Отбор);
			Если Строки.Количество() = 1 Тогда 
				НоваяСтрока.ФизическоеЛицо = Строки[0].Ссылка;
				КэшДанныхЗагрузки.СоответствиеФизическихЛиц.Вставить(СтрокаТаблицы.ФизическоеЛицо, НоваяСтрока.ФизическоеЛицо);
				Возврат;
			ИначеЕсли Строки.Количество() > 1 Тогда
				ЗаписьОНеоднозначности = СписокНеоднозначностей.Добавить();
				ЗаписьОНеоднозначности.Идентификатор = СтрокаТаблицы.Идентификатор; 
				ЗаписьОНеоднозначности.Колонка = "ФизическоеЛицо";
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьНеоднозначностьПодразделения(НоваяСтрока, СтрокаТаблицы, КэшДанныхЗагрузки, СписокНеоднозначностей, РезультатЗагрузки)
	
	Если ПустаяСтрока(СтрокаТаблицы.КодПодразделения) Тогда
		Возврат;
	КонецЕсли;
	Если Не ПустаяСтрока(СтрокаТаблицы.Организация) Тогда
		Отбор = Новый Структура("Организация, КодПодразделения", СтрокаТаблицы.Организация, СтрокаТаблицы.КодПодразделения);
		НоваяСтрока.Подразделение = КэшДанныхЗагрузки.СоответствиеПодразделенийПоОтбору.Получить(Отбор);
		Если ЗначениеЗаполнено(НоваяСтрока.Подразделение) Тогда
			Возврат;
		КонецЕсли;
		Строки = РезультатЗагрузки.ТаблицаОрганизацийКодыПодразделений.НайтиСтроки(Отбор);
		Если Строки.Количество() = 1 Тогда 
			НоваяСтрока.Подразделение = Строки[0].Ссылка;
			КэшДанныхЗагрузки.СоответствиеПодразделенийПоОтбору.Вставить(Отбор, НоваяСтрока.Подразделение);
			КэшДанныхЗагрузки.СоответствиеКодовПодразделений.Вставить(СтрокаТаблицы.КодПодразделения, НоваяСтрока.Подразделение);
		ИначеЕсли Строки.Количество() > 1 Тогда
			ЗаписьОНеоднозначности = СписокНеоднозначностей.Добавить();
			ЗаписьОНеоднозначности.Идентификатор = СтрокаТаблицы.Идентификатор; 
			ЗаписьОНеоднозначности.Колонка = "Подразделение";
		КонецЕсли;
	Иначе
		НоваяСтрока.Подразделение = КэшДанныхЗагрузки.СоответствиеКодовПодразделений.Получить(СтрокаТаблицы.КодПодразделения);
		Если ЗначениеЗаполнено(НоваяСтрока.Подразделение) Тогда
			Возврат;
		КонецЕсли;
		Отбор = Новый Структура("КодПодразделения", СтрокаТаблицы.КодПодразделения);
		Строки = РезультатЗагрузки.ТаблицаКодыПодразделений.НайтиСтроки(Отбор);
		Если Строки.Количество() = 1 Тогда 
			НоваяСтрока.Подразделение = Строки[0].Ссылка;
			КэшДанныхЗагрузки.СоответствиеКодовПодразделений.Вставить(СтрокаТаблицы.КодПодразделения, НоваяСтрока.Подразделение);
		ИначеЕсли Строки.Количество() > 1 Тогда
			ЗаписьОНеоднозначности = СписокНеоднозначностей.Добавить();
			ЗаписьОНеоднозначности.Идентификатор = СтрокаТаблицы.Идентификатор; 
			ЗаписьОНеоднозначности.Колонка = "Подразделение";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

