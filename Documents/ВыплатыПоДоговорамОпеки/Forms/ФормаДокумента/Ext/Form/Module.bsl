// Функция возвращает массив реквизитов формы подключенных к механизму ключевых реквизитов формы.
&НаСервере
Функция КлючевыеРеквизитыЗаполненияФормыОписаниеКлючевыхРеквизитов() Экспорт
	Массив = Новый Массив;
	Массив.Добавить(Новый Структура("ЭлементФормы, Представление", "Организация", НСтр("ru = 'организации'")));
	Массив.Добавить(Новый Структура("ЭлементФормы, Представление", "Сотрудник", НСтр("ru = 'сотрудника'")));
	Возврат Массив
КонецФункции

#КонецОбласти
// Конец ЗарплатаКадрыПодсистемы.ПодписиДокументов

&НаСервере
Процедура ДобавитьРеквизитыТерриториальныхНадбавок()
	
	ДобавляемыеРеквизиты = Новый Массив;

	РеквизитИменаЭлементовНачисленийРедактируемыхВОтдельныхПолях = Новый РеквизитФормы("ИменаЭлементовНачисленийРедактируемыхВОтдельныхПолях", Новый ОписаниеТипов());
	ДобавляемыеРеквизиты.Добавить(РеквизитИменаЭлементовНачисленийРедактируемыхВОтдельныхПолях);
	
	// Районный коэффициент
	РеквизитПредставлениеНачислениеРайонныйКоэффициент = Новый РеквизитФормы("ПредставлениеРайонныйКоэффициент", Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(РеквизитПредставлениеНачислениеРайонныйКоэффициент);
	
	РеквизитПрименяетсяНачислениеРайонныйКоэффициент = Новый РеквизитФормы("ПрименяетсяРайонныйКоэффициент", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(РеквизитПрименяетсяНачислениеРайонныйКоэффициент);
	
	РеквизитЗначениеРайонныйКоэффициент = Новый РеквизитФормы("ЗначениеРайонныйКоэффициент", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 3)));
	ДобавляемыеРеквизиты.Добавить(РеквизитЗначениеРайонныйКоэффициент);
	
	РеквизитРазмерРайонныйКоэффициент = Новый РеквизитФормы("РазмерРайонныйКоэффициент", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)), , , Истина);
	ДобавляемыеРеквизиты.Добавить(РеквизитРазмерРайонныйКоэффициент);
	
	// Северная надбавка
	РеквизитПредставлениеНачислениеСевернаяНадбавка = Новый РеквизитФормы("ПредставлениеСевернаяНадбавка", Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(РеквизитПредставлениеНачислениеСевернаяНадбавка);
	
	РеквизитПрименяетсяНачислениеСевернаяНадбавка = Новый РеквизитФормы("ПрименяетсяСевернаяНадбавка", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(РеквизитПрименяетсяНачислениеСевернаяНадбавка);
	
	РеквизитЗначениеСевернаяНадбавка = Новый РеквизитФормы("ЗначениеСевернаяНадбавка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 2)));
	ДобавляемыеРеквизиты.Добавить(РеквизитЗначениеСевернаяНадбавка);
	
	РеквизитРазмерСевернаяНадбавка = Новый РеквизитФормы("РазмерСевернаяНадбавка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)), , , Истина);
	ДобавляемыеРеквизиты.Добавить(РеквизитРазмерСевернаяНадбавка);

	СуществующиеРеквизиты = Новый Массив;
	ЗарплатаКадры.ЗаполнитьМассивИменРеквизитовФормы(ЭтотОбъект, СуществующиеРеквизиты); 
	ЗарплатаКадры.ИзменитьРеквизитыФормы(ЭтотОбъект, ДобавляемыеРеквизиты, СуществующиеРеквизиты);

	ВариантыВыделенияРКиСН.Добавить(НСтр("ru='Не выделять'"));
	ВариантыВыделенияРКиСН.Добавить(НСтр("ru='Выделять процентом, начислять сверх указанного размера выплат'"));
	ВариантыВыделенияРКиСН.Добавить(НСтр("ru='Выделять процентом внутри указанного размера выплат'"));
	ВариантыВыделенияРКиСН.Добавить(НСтр("ru='Выделять суммой, начислять сверх указанного размера выплат'"));
	ВариантыВыделенияРКиСН.Добавить(НСтр("ru='Выделять суммой внутри указанного размера выплат'"));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияТерриториальныхНадбавок(УстановитьЗначенияНадбавок = Истина)
	
	РеквизитыФормыВДанные();
	
	ПрименятьРайонныйКоэффициент = ПолучитьФункциональнуюОпциюФормы("ПрименятьРайонныйКоэффициент");
	ПрименятьСевернуюНадбавку = ПолучитьФункциональнуюОпциюФормы("ПрименятьСевернуюНадбавку");
	
	РайонныйКоэффициент = 1;
	ПроцентСевернойНадбавки = 0;
	
	Если ПрименятьРайонныйКоэффициент Тогда
		
		СтруктурнаяЕдиница = Неопределено;
		ИменаКадровыхДанных = "Подразделение,Территория";
		
		Если ЗначениеЗаполнено(ИменаКадровыхДанных) Тогда
			
			КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудников(Истина, Объект.Сотрудник, ИменаКадровыхДанных, Объект.Дата, , Ложь);
			Если КадровыеДанные.Количество() > 0 Тогда
				
				Если Не ЗначениеЗаполнено(СтруктурнаяЕдиница) Тогда
					Если ЗначениеЗаполнено(КадровыеДанные[0].Территория) Тогда
						СтруктурнаяЕдиница = КадровыеДанные[0].Территория;
					Иначе
						СтруктурнаяЕдиница = КадровыеДанные[0].Подразделение;
					КонецЕсли;
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(СтруктурнаяЕдиница) Тогда
			СтруктурнаяЕдиница = Объект.Организация;
		КонецЕсли; 
		
		Если ПрименятьСевернуюНадбавку Тогда
			
			ПрименятьСевернуюНадбавку = ЗарплатаКадрыРасширенный.ПрименятьНадбавкуЗаОсобыеКлиматическиеУсловия(
			СтруктурнаяЕдиница, ОбщегоНазначения.ТекущаяДатаПользователя());
			
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктурнаяЕдиница, "РайонныйКоэффициент");
		РайонныйКоэффициент = ЗначенияРеквизитов.РайонныйКоэффициент;
		ПрименятьРайонныйКоэффициент = РайонныйКоэффициент > 1;
		
		Если ПрименятьСевернуюНадбавку Тогда
			ПроцентСевернойНадбавки = КадровыйУчетРасширенный.ПроцентСевернойНадбавки(Объект.Сотрудник, Объект.Дата);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ПрименяетсяРайонныйКоэффициент", ПрименятьРайонныйКоэффициент);
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ПрименяетсяСевернаяНадбавка", ПрименятьСевернуюНадбавку);
	
	Если УстановитьЗначенияНадбавок Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеРайонныйКоэффициент", 
			?(Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0, 1, РайонныйКоэффициент));
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеСевернаяНадбавка",
			?(Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0, 0, ПроцентСевернойНадбавки));
		
		РассчитатьРазмерТерриториальныхНадбавок();
		
	КонецЕсли;

	УстановитьОтображениеТерриториальныхНадбавок();

КонецПроцедуры

&НаСервере
Функция ВедетсяРасчетТерриториальныхНадбавокВнутриРазмераВыплат()
	Если Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 2 Или
		Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 4 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция ВедетсяУчетТерриториальныхНадбавокСуммой()
	Если Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 3 Или
		Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 4 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура РассчитатьИтоговыйРазмерВознаграждения()

	РеквизитыФормыВДанные();
	ИтоговыйРазмерВознаграждения = Объект.Выплаты.Итог("Сумма");

	РазмерРайонныйКоэффициент = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерРайонныйКоэффициент");
	РазмерСевернаяНадбавка = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерСевернаяНадбавка");
	
	Если Не ВедетсяРасчетТерриториальныхНадбавокВнутриРазмераВыплат() Тогда
		ИтоговыйРазмерВознаграждения = ИтоговыйРазмерВознаграждения + РазмерРайонныйКоэффициент + РазмерСевернаяНадбавка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьРазмерТерриториальныхНадбавок(ИмяЭлемента = Неопределено)
	
	РеквизитыФормыВДанные();
	ИменаЭлементовРедактирования = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ИменаЭлементовНачисленийРедактируемыхВОтдельныхПолях");
	
	ВыплатыИтог = Объект.Выплаты.Итог("Сумма");
	РасчетВнутриРазмераВыплат = ВедетсяРасчетТерриториальныхНадбавокВнутриРазмераВыплат();
	
	РазмерРайонныйКоэффициент = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерРайонныйКоэффициент");
	РазмерСевернаяНадбавка = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерСевернаяНадбавка");
	
	ЗначениеРайонныйКоэффициент = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеРайонныйКоэффициент");
	ЗначениеСевернаяНадбавка = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеСевернаяНадбавка");

	Если ИмяЭлемента = ИменаЭлементовРедактирования["РазмерРайонныйКоэффициент"] 
		Или ИмяЭлемента = ИменаЭлементовРедактирования["РазмерСевернаяНадбавка"] Тогда

		ЗначениеРайонныйКоэффициент = 1;
		ЗначениеСевернаяНадбавка = 0;
		
		Если РасчетВнутриРазмераВыплат И ВыплатыИтог > 0 Тогда
			
			ВыплатыБезУчетаРКиСН = ВыплатыИтог - РазмерРайонныйКоэффициент - РазмерСевернаяНадбавка;
			
			Если ВыплатыБезУчетаРКиСН > 0 Тогда
				
				ЗначениеРайонныйКоэффициент = 1 + РазмерРайонныйКоэффициент / ВыплатыБезУчетаРКиСН;
				ЗначениеСевернаяНадбавка = РазмерСевернаяНадбавка / ВыплатыБезУчетаРКиСН * 100;
				
			Иначе
				
				ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерРайонныйКоэффициент", 0); 
				ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерСевернаяНадбавка", 0);
				
			КонецЕсли;
			
		ИначеЕсли ВыплатыИтог > 0 Тогда
			
			ЗначениеРайонныйКоэффициент = 1 + РазмерРайонныйКоэффициент / ВыплатыИтог;
			ЗначениеСевернаяНадбавка = РазмерСевернаяНадбавка / ВыплатыИтог * 100;
			
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеРайонныйКоэффициент", 
			?(Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0, 1, ЗначениеРайонныйКоэффициент));
			
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеСевернаяНадбавка", 
			?(Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0, 0, ЗначениеСевернаяНадбавка));

	КонецЕсли;
			
	Если ИмяЭлемента = ИменаЭлементовРедактирования["ЗначениеРайонныйКоэффициент"]
		Или ИмяЭлемента = ИменаЭлементовРедактирования["ЗначениеСевернаяНадбавка"]
		Или ИмяЭлемента = Неопределено Тогда
		
		РазмерРайонныйКоэффициент = 0;
		РазмерСевернаяНадбавка = 0;
		
		Если РасчетВнутриРазмераВыплат И ЗначениеРайонныйКоэффициент > 1 Тогда
			
			ОбщийКоэффициентРКиСН = ЗначениеРайонныйКоэффициент + ЗначениеСевернаяНадбавка/100;
			ОбщаяСуммаРКиСН = ВыплатыИтог - ВыплатыИтог / ОбщийКоэффициентРКиСН;
			
			ОбщийПроцентРКиСН = ОбщийКоэффициентРКиСН - 1;
			
			РазмерРайонныйКоэффициент = ОбщаяСуммаРКиСН / ОбщийПроцентРКиСН * (ЗначениеРайонныйКоэффициент - 1);
			РазмерСевернаяНадбавка = ОбщаяСуммаРКиСН - РазмерРайонныйКоэффициент;
			
		ИначеЕсли ЗначениеРайонныйКоэффициент > 1 Тогда
			РазмерРайонныйКоэффициент = ВыплатыИтог * (ЗначениеРайонныйКоэффициент - 1);;
			РазмерСевернаяНадбавка = ВыплатыИтог * ЗначениеСевернаяНадбавка / 100;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерРайонныйКоэффициент", 
			?(Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0, 0, РазмерРайонныйКоэффициент));
		
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерСевернаяНадбавка", 
			?(Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0, 0, РазмерСевернаяНадбавка));
			
	КонецЕсли;
		
	РассчитатьИтоговыйРазмерВознаграждения();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыТерриториальныхНадбавок()
	
	Форма = ЭтотОбъект;
	
	ГруппаОтдельныеПоля = Элементы.Найти("ГруппаРКиСН");
	Если ГруппаОтдельныеПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаЭлементовРедактирования = Новый Структура;
	
	ИменаЭлементовРедактирования.Вставить("НаименованиеРайонныйКоэффициент", "");
	ИменаЭлементовРедактирования.Вставить("РазмерРайонныйКоэффициент", "");
	ИменаЭлементовРедактирования.Вставить("ЗначениеРайонныйКоэффициент", "");
	ИменаЭлементовРедактирования.Вставить("РасшифровкиРайонныйКоэффициент", "");
	
	ИменаЭлементовРедактирования.Вставить("НаименованиеСевернаяНадбавка", "");
	ИменаЭлементовРедактирования.Вставить("РазмерСевернаяНадбавка", "");
	ИменаЭлементовРедактирования.Вставить("ЗначениеСевернаяНадбавка", "");
	ИменаЭлементовРедактирования.Вставить("РасшифровкиСевернаяНадбавка", "");
	ИменаЭлементовРедактирования.Вставить("КомандаИзменитьЗначениеСевернаяНадбавка", "");
	
	ГруппаОтдельныеПоляНаименования = Форма.Элементы.Добавить(ГруппаОтдельныеПоля.Имя + "Наименования", Тип("ГруппаФормы"), ГруппаОтдельныеПоля);
	ГруппаОтдельныеПоляНаименования.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтдельныеПоляНаименования.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаОтдельныеПоляНаименования.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаОтдельныеПоляНаименования.Объединенная = Ложь;
	ГруппаОтдельныеПоляНаименования.ОтображатьЗаголовок = Ложь;
	
	ГруппаОтдельныеПоляРазмеры = Форма.Элементы.Добавить(ГруппаОтдельныеПоля.Имя + "Размеры", Тип("ГруппаФормы"), ГруппаОтдельныеПоля);
	ГруппаОтдельныеПоляРазмеры.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтдельныеПоляРазмеры.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаОтдельныеПоляРазмеры.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаОтдельныеПоляРазмеры.Объединенная = Ложь;
	ГруппаОтдельныеПоляРазмеры.ОтображатьЗаголовок = Ложь;
	
	ГруппаОтдельныеПоляЗначения = Форма.Элементы.Добавить(ГруппаОтдельныеПоля.Имя + "Значения", Тип("ГруппаФормы"), ГруппаОтдельныеПоля);
	ГруппаОтдельныеПоляЗначения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтдельныеПоляЗначения.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаОтдельныеПоляЗначения.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаОтдельныеПоляЗначения.Объединенная = Ложь;
	ГруппаОтдельныеПоляЗначения.ОтображатьЗаголовок = Ложь;
	
	ГруппаОтдельныеПоляРасшифровки = Форма.Элементы.Добавить(ГруппаОтдельныеПоля.Имя + "Расшифровки", Тип("ГруппаФормы"), ГруппаОтдельныеПоля);
	ГруппаОтдельныеПоляРасшифровки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтдельныеПоляРасшифровки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаОтдельныеПоляРасшифровки.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаОтдельныеПоляРасшифровки.Объединенная = Ложь;
	ГруппаОтдельныеПоляРасшифровки.ОтображатьЗаголовок = Ложь;
	
	// Районный коэффициент
	ПолеНадписи = Форма.Элементы.Добавить(ГруппаОтдельныеПоляНаименования.Имя + "НаименованиеРайонныйКоэффициент", Тип("ПолеФормы"), ГруппаОтдельныеПоляНаименования);
	ПолеНадписи.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеНадписи.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеНадписи.РастягиватьПоГоризонтали = Ложь;
	ПолеНадписи.МаксимальнаяШирина = 43;
	ПолеНадписи.ПутьКДанным = "ПредставлениеРайонныйКоэффициент";
	ПолеНадписи.АвтоМаксимальнаяШирина = Ложь;
	ИменаЭлементовРедактирования.Вставить("НаименованиеРайонныйКоэффициент", ПолеНадписи.Имя);

	ПолеФОТ = Форма.Элементы.Добавить(ГруппаОтдельныеПоляРазмеры.Имя + "РазмерРайонныйКоэффициент", Тип("ПолеФормы"), ГруппаОтдельныеПоляРазмеры);
	ПолеФОТ.Вид = ВидПоляФормы.ПолеВвода;
	ПолеФОТ.ТолькоПросмотр = Форма.ТолькоПросмотр;
	ПолеФОТ.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеФОТ.Ширина = 10;
	ПолеФОТ.ПутьКДанным = "РазмерРайонныйКоэффициент";
	ПолеФОТ.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТерриториальнойНадбавки");
	ИменаЭлементовРедактирования.Вставить("РазмерРайонныйКоэффициент", ПолеФОТ.Имя);
	
	ПолеПоказателя = Форма.Элементы.Добавить(ГруппаОтдельныеПоляЗначения.Имя + "ЗначениеРайонныйКоэффициент", Тип("ПолеФормы"), ГруппаОтдельныеПоляЗначения);
	ПолеПоказателя.Вид = ВидПоляФормы.ПолеВвода;
	ПолеПоказателя.ТолькоПросмотр = Форма.ТолькоПросмотр;
	ПолеПоказателя.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеПоказателя.Ширина = 4;
	ПолеПоказателя.КнопкаВыбора = Ложь;
	ПолеПоказателя.МинимальноеЗначение = 1;
	ПолеПоказателя.МаксимальноеЗначение = 3;
	ПолеПоказателя.ФорматРедактирования = "ЧЦ=4; ЧДЦ=3";
	ПолеПоказателя.ПутьКДанным = "ЗначениеРайонныйКоэффициент";
	ПолеПоказателя.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТерриториальнойНадбавки");
	ИменаЭлементовРедактирования.Вставить("ЗначениеРайонныйКоэффициент", ПолеПоказателя.Имя);
	
	ГруппаОтдельныеПоляРасшифровкиРК = Форма.Элементы.Добавить(ГруппаОтдельныеПоляРасшифровки.Имя + "РасшифровкиРайонныйКоэффициент", Тип("ГруппаФормы"), ГруппаОтдельныеПоляРасшифровки);
	ГруппаОтдельныеПоляРасшифровкиРК.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтдельныеПоляРасшифровкиРК.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаОтдельныеПоляРасшифровкиРК.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаОтдельныеПоляРасшифровкиРК.ОтображатьЗаголовок = Ложь;
	ИменаЭлементовРедактирования.Вставить("РасшифровкиРайонныйКоэффициент", ГруппаОтдельныеПоляРасшифровкиРК.Имя);
	
	ПолеДекорации = Форма.Элементы.Добавить(ГруппаОтдельныеПоляРасшифровкиРК.Имя + "ЗаглушкаРайонныйКоэффициент", Тип("ДекорацияФормы"), ГруппаОтдельныеПоляРасшифровкиРК);
	ПолеДекорации.Вид = ВидДекорацииФормы.Надпись;
	
	// Северная надбавка
	ПолеНадписи = Форма.Элементы.Добавить(ГруппаОтдельныеПоляНаименования.Имя + "НаименованиеСевернаяНадбавка", Тип("ПолеФормы"), ГруппаОтдельныеПоляНаименования);
	ПолеНадписи.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеНадписи.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеНадписи.РастягиватьПоГоризонтали = Ложь;
	ПолеНадписи.МаксимальнаяШирина = 43;
	ПолеНадписи.ПутьКДанным = "ПредставлениеСевернаяНадбавка";
	ПолеНадписи.АвтоМаксимальнаяШирина = Ложь;
	ИменаЭлементовРедактирования.Вставить("НаименованиеСевернаяНадбавка", ПолеНадписи.Имя);
	
	ПолеФОТ = Форма.Элементы.Добавить(ГруппаОтдельныеПоляРазмеры.Имя + "РазмерСевернаяНадбавка", Тип("ПолеФормы"), ГруппаОтдельныеПоляРазмеры);
	ПолеФОТ.Вид = ВидПоляФормы.ПолеВвода;
	ПолеФОТ.ТолькоПросмотр = Форма.ТолькоПросмотр;
	ПолеФОТ.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеФОТ.Ширина = 10;
	ПолеФОТ.ПутьКДанным = "РазмерСевернаяНадбавка";
	ПолеФОТ.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТерриториальнойНадбавки");
	ИменаЭлементовРедактирования.Вставить("РазмерСевернаяНадбавка", ПолеФОТ.Имя);
	
	ПолеПоказателя = Форма.Элементы.Добавить(ГруппаОтдельныеПоляЗначения.Имя + "ЗначениеСевернаяНадбавка", Тип("ПолеФормы"), ГруппаОтдельныеПоляЗначения);
	ПолеПоказателя.Вид = ВидПоляФормы.ПолеВвода;
	ПолеПоказателя.ТолькоПросмотр = Истина;
	ПолеПоказателя.КнопкаВыбора = Ложь;
	ПолеПоказателя.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеПоказателя.Ширина = 4;
	ПолеПоказателя.РастягиватьПоГоризонтали = Ложь;
	ПолеПоказателя.ФорматРедактирования = "ЧЦ=5; ЧДЦ=2";
	ПолеПоказателя.ПутьКДанным = "ЗначениеСевернаяНадбавка";
	ПолеПоказателя.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТерриториальнойНадбавки");
	ИменаЭлементовРедактирования.Вставить("ЗначениеСевернаяНадбавка", ПолеПоказателя.Имя);
	
	ГруппаОтдельныеПоляРасшифровкиСН = Форма.Элементы.Добавить(ГруппаОтдельныеПоляРасшифровки.Имя + "РасшифровкиСевернаяНадбавка", Тип("ГруппаФормы"), ГруппаОтдельныеПоляРасшифровки);
	ГруппаОтдельныеПоляРасшифровкиСН.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтдельныеПоляРасшифровкиСН.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаОтдельныеПоляРасшифровкиСН.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаОтдельныеПоляРасшифровкиСН.ОтображатьЗаголовок = Ложь;
	ИменаЭлементовРедактирования.Вставить("РасшифровкиСевернаяНадбавка", ГруппаОтдельныеПоляРасшифровкиСН.Имя);
	
	ПолеДекорации = Форма.Элементы.Добавить(ГруппаОтдельныеПоляРасшифровкиСН.Имя + "ПроцентСевернаяНадбавка", Тип("ДекорацияФормы"), ГруппаОтдельныеПоляРасшифровкиСН);
	ПолеДекорации.Вид = ВидДекорацииФормы.Надпись;
	ПолеДекорации.Заголовок = "%";
	ПолеДекорации.Высота = 1;
	ПолеДекорации.Ширина = 2;
	ПолеДекорации.РастягиватьПоВертикали = Ложь;
	ПолеДекорации.РастягиватьПоГоризонтали = Ложь;
	
	Если РольДоступна(Метаданные.Роли.ПолныеПрава) Или РольДоступна(Метаданные.Роли.ДобавлениеИзменениеДанныхФизическихЛицЗарплатаКадрыРасширенная) Тогда
		
		КомандаИзменитьЗначениеСевернаяНадбавка = Форма.Команды.Найти("ИзменитьЗначениеПоказателяСевернаяНадбавка");
		Если КомандаИзменитьЗначениеСевернаяНадбавка = Неопределено И ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СтажиФизическихЛиц) Тогда
			КомандаИзменитьЗначениеСевернаяНадбавка = Форма.Команды.Добавить("ИзменитьЗначениеПоказателяСевернаяНадбавка");
			КомандаИзменитьЗначениеСевернаяНадбавка.Заголовок = НСтр("ru='Изменить'");
			КомандаИзменитьЗначениеСевернаяНадбавка.ИзменяетСохраняемыеДанные = Истина;
			КомандаИзменитьЗначениеСевернаяНадбавка.Действие = "Подключаемый_ИзменитьЗначениеСевернаяНадбавка";
		КонецЕсли;
		
		КнопкаИзменить = Форма.Элементы.Добавить(ГруппаОтдельныеПоляРасшифровкиСН.Имя + КомандаИзменитьЗначениеСевернаяНадбавка.Имя, Тип("КнопкаФормы"), ГруппаОтдельныеПоляРасшифровкиСН);
		КнопкаИзменить.Вид = ВидКнопкиФормы.Гиперссылка;
		КнопкаИзменить.Доступность  = НЕ Форма.ТолькоПросмотр;
		КнопкаИзменить.ИмяКоманды = КомандаИзменитьЗначениеСевернаяНадбавка.Имя;
		ИменаЭлементовРедактирования.Вставить("КомандаИзменитьЗначениеСевернаяНадбавка", КнопкаИзменить.Имя);
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "ИменаЭлементовНачисленийРедактируемыхВОтдельныхПолях", Новый ФиксированнаяСтруктура(ИменаЭлементовРедактирования));
	
	Элементы.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки.СписокВыбора.ЗагрузитьЗначения(ВариантыВыделенияРКиСН.ВыгрузитьЗначения());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтображениеТерриториальныхНадбавок()
	
	ИменаЭлементовРедактирования = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ИменаЭлементовНачисленийРедактируемыхВОтдельныхПолях");

	ПрименятьРайонныйКоэффициент = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ПрименяетсяРайонныйКоэффициент");
	ПрименятьСевернуюНадбавку = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ПрименяетсяСевернаяНадбавка");

	НаименованиеСвойства = "Доступность";
	Если Не ПрименятьРайонныйКоэффициент Тогда
		НаименованиеСвойства = "Видимость";
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки", НаименованиеСвойства, ПрименятьРайонныйКоэффициент);
	КонецЕсли;
	
	ПрименятьРайонныйКоэффициент = ПрименятьРайонныйКоэффициент И Не Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0;
	ПрименятьСевернуюНадбавку = ПрименятьСевернуюНадбавку И Не Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["НаименованиеРайонныйКоэффициент"], НаименованиеСвойства, ПрименятьРайонныйКоэффициент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["РазмерРайонныйКоэффициент"], НаименованиеСвойства, ПрименятьРайонныйКоэффициент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["ЗначениеРайонныйКоэффициент"], НаименованиеСвойства, ПрименятьРайонныйКоэффициент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["РасшифровкиРайонныйКоэффициент"], НаименованиеСвойства, ПрименятьРайонныйКоэффициент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["НаименованиеСевернаяНадбавка"], НаименованиеСвойства, ПрименятьРайонныйКоэффициент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["РазмерСевернаяНадбавка"], НаименованиеСвойства, ПрименятьСевернуюНадбавку);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["ЗначениеСевернаяНадбавка"], НаименованиеСвойства, ПрименятьСевернуюНадбавку);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["РасшифровкиСевернаяНадбавка"], НаименованиеСвойства, ПрименятьСевернуюНадбавку);
	
	УчетТерриториальныхНадбавокСуммой =  ВедетсяУчетТерриториальныхНадбавокСуммой();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["ЗначениеРайонныйКоэффициент"], "Доступность", ПрименятьРайонныйКоэффициент И Не УчетТерриториальныхНадбавокСуммой);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["ЗначениеСевернаяНадбавка"], "Доступность", ПрименятьСевернуюНадбавку И Не УчетТерриториальныхНадбавокСуммой);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["РазмерРайонныйКоэффициент"], "Доступность", ПрименятьРайонныйКоэффициент И УчетТерриториальныхНадбавокСуммой);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["РазмерСевернаяНадбавка"], "Доступность", ПрименятьСевернуюНадбавку И УчетТерриториальныхНадбавокСуммой);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементовРедактирования["КомандаИзменитьЗначениеСевернаяНадбавка"], 
		"Доступность", ПрименятьСевернуюНадбавку И Не УчетТерриториальныхНадбавокСуммой И Не Объект.Сотрудник.Пустая());
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ИзменитьЗначениеСевернаяНадбавка(Команда)
	
	ЗарплатаКадрыРасширенныйКлиент.ОткрытьФормуРедактированияПроцентаСевернойНадбавки(ЭтотОбъект, Объект.Сотрудник, Объект.Дата);
	
	РассчитатьРазмерТерриториальныхНадбавок("ЗначениеСевернаяНадбавка");
	
КонецПроцедуры

&НаСервере
Процедура РеквизитыФормыВДанные()
	
	Объект.РайонныйКоэффициент = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеРайонныйКоэффициент");
	Объект.РайонныйКоэффициентРазмер = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерРайонныйКоэффициент");
	Объект.СевернаяНадбавкаРазмер = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерСевернаяНадбавка");
	
	ЗначениеВариантаВыделенияРКиСН = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавкиСтрокой");
	ВариантВыделенияРКиСН = ВариантыВыделенияРКиСН.НайтиПоЗначению(ЗначениеВариантаВыделенияРКиСН);
	
	Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0;
	Если Не ВариантВыделенияРКиСН = Неопределено Тогда
		Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = ВариантыВыделенияРКиСН.Индекс(ВариантВыделенияРКиСН);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДанныеВРеквизитыФормы()
	
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеРайонныйКоэффициент", 
			?(Объект.РайонныйКоэффициент = 0, 1, Объект.РайонныйКоэффициент));
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерРайонныйКоэффициент", Объект.РайонныйКоэффициентРазмер);
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "РазмерСевернаяНадбавка", Объект.СевернаяНадбавкаРазмер);
	
	ВариантВыделенияРКиСН = Неопределено;
	Если ВариантыВыделенияРКиСН.Количество() > Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки Тогда
		ВариантВыделенияРКиСН = ВариантыВыделенияРКиСН[Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки];
	ИначеЕсли ВариантыВыделенияРКиСН.Количество() > 1 Тогда
		ВариантВыделенияРКиСН = ВариантыВыделенияРКиСН[0];
	КонецЕсли;
	
	Если Не ВариантВыделенияРКиСН = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавкиСтрокой", ВариантВыделенияРКиСН.Значение);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ПредставлениеРайонныйКоэффициент", ПланыВидовРасчета.Начисления.НачислениеРайонныйКоэффициент(Ложь));
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ПредставлениеСевернаяНадбавка", ПланыВидовРасчета.Начисления.НачислениеСевернаяНадбавка(Ложь));
	
	//установим процент северной надбавки, поскольку он не сохраняется в реквизитах документа
	ИменаЭлементовРедактирования = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "ИменаЭлементовНачисленийРедактируемыхВОтдельныхПолях");
	Если ВедетсяУчетТерриториальныхНадбавокСуммой() Тогда
		РассчитатьРазмерТерриториальныхНадбавок(ИменаЭлементовРедактирования["РазмерСевернаяНадбавка"]);
	Иначе
		ПроцентСевернойНадбавки = КадровыйУчетРасширенный.ПроцентСевернойНадбавки(Объект.Сотрудник, Объект.Дата);
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеСевернаяНадбавка",
			?(Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0, 0, ПроцентСевернойНадбавки));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПроцентаСевернойНадбавки()
	ПроцентСевернойНадбавки = КадровыйУчетРасширенный.ПроцентСевернойНадбавки(Объект.Сотрудник, Объект.Дата);
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(ЭтотОбъект, "ЗначениеСевернаяНадбавка",
		?(Объект.ПорядокВыделенияРайонногоКоэффициентаСевернойНадбавки = 0, 0, ПроцентСевернойНадбавки));
	РассчитатьРазмерТерриториальныхНадбавок();
КонецПроцедуры

#КонецОбласти
