	//	<n1:insurerInfo>
	//		<n1:regNumSFR>1000865343</n1:regNumSFR>
	//	</n1:insurerInfo>
	//	<n1:insuredInfo>
	//		<n1:snils>00122615672</n1:snils>
	//		<n1:fullName>
	//			<p:lastName>МУКАШЕВА</p:lastName>
	//			<p:firstName>СВЕТЛАНА</p:firstName>
	//			<p:middleName>ПЕТРОВНА</p:middleName>
	//		</n1:fullName>
	//		<n1:birthDate>1985-08-13</n1:birthDate>
	//	</n1:insuredInfo>
	//	<n1:insuredWorksSeveralInsurers>true</n1:insuredWorksSeveralInsurers>
	//	<n1:paymentMethod>severalInsurersAssignment</n1:paymentMethod>
	//	<n1:salaryInfo>
	//		<n1:yearSum>
	//			<n1:year>2025</n1:year>
	//			<n1:salaryByCurrentInsurer>
	//				<sumOPS>1917000</sumOPS>
	//				<sumGPH>0</sumGPH>
	//			</n1:salaryByCurrentInsurer>
	//			<n1:salaryByAllInsurers>
	//				<sumOPS>1917000</sumOPS>
	//				<sumGPH>0</sumGPH>
	//			</n1:salaryByAllInsurers>
	//		</n1:yearSum>
	//		<n1:yearSum>
	//			<n1:year>2024</n1:year>
	//			<n1:salaryByCurrentInsurer>
	//				<sumOPS>2225000</sumOPS>
	//				<sumGPH>0</sumGPH>
