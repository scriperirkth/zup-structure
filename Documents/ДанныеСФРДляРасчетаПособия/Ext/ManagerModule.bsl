	КонецЕсли;
	Если ТипЗнч(УзлыКорня.insurerInfo) = Тип("ЭлементDOM") Тогда
		СтраховательDOM = УзлыЭлементаDOM(УзлыКорня.insurerInfo, "regNum, regNumSFR", Необработанные);
