	//			<n1:salaryByAllInsurers>
	//				<sumOPS>2225000</sumOPS>
	//				<sumGPH>0</sumGPH>
	//			</n1:salaryByAllInsurers>
	//		</n1:yearSum>
	//	</n1:salaryInfo>
	//</n1:insuredPersonSalaryProactive>
	#КонецОбласти
	
	СтруктураDOM = СериализацияБЗК.СтруктураDOM(ТекстXML);
	Если ТипСообщения = 322 Тогда
		КореньDOM = СериализацияБЗК.НайтиУзелDOMПоИмени(СтруктураDOM, "proactiveSalaryNotification");
	ИначеЕсли ТипСообщения = 32210 Тогда
		КореньDOM = СериализацияБЗК.НайтиУзелDOMПоИмени(СтруктураDOM, "insuredPersonSalaryProactive");
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неподдерживаемый тип сообщения: %1'"), ТипСообщения);
	КонецЕсли;
	Если КореньDOM = Неопределено Тогда
		КореньDOM = СтруктураDOM.ДокументDOM.ЭлементДокумента;
	КонецЕсли;
	Необработанные = Новый Массив;
	ТекстыОшибок = Новый Массив;
	
	// Подготовка структуры документа.
	Документ = Новый Структура;
