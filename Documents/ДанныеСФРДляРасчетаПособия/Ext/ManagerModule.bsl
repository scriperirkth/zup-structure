	#КонецОбласти
	#Область Пример_Сообщения_32210
	//<n1:insuredPersonSalaryProactive xmlns:p="urn:ru:ecp:integration:types:person:v3.0"
	//	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	//	xmlns:n1="urn:ru:ecp:integration:proactive:salary:proactive:v3.0"
	//	specVersion="3.0"
	//	messageDateTime="2026-05-17T09:30:47Z"
	//	xsi:schemaLocation="urn:ru:ecp:integration:proactive:salary:proactive:v3.0 InsuredPersonSalaryProactive.xsd">
	//	<n1:elnInfo>
	//		<n1:lnNumber>920000206738</n1:lnNumber>
