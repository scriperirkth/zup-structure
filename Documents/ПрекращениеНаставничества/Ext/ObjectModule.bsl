#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ОбъектОснование = ДанныеЗаполнения;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("Сотрудник") И ЗначениеЗаполнено(ДанныеЗаполнения.Сотрудник) Тогда
			ОбъектОснование = ДанныеЗаполнения.Сотрудник;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ОбъектОснование) = Тип("СправочникСсылка.Сотрудники")
		ИЛИ ТипЗнч(ОбъектОснование) = Тип("ДокументСсылка.НазначениеНаставника") Тогда
		
		ЗарплатаКадры.ЗаполнитьПоОснованиюСотрудником(ЭтотОбъект, ОбъектОснование, , Истина);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Сотрудник", ОбъектОснование);
		Запрос.УстановитьПараметр("Ссылка", ОбъектОснование);
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НазначениеНаставника.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.НазначениеНаставника КАК НазначениеНаставника
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрекращениеНаставничества КАК ПрекращениеНаставничества
			|		ПО НазначениеНаставника.Ссылка = ПрекращениеНаставничества.ДокументОснование
			|			И (ПрекращениеНаставничества.Проведен)
			|ГДЕ
			|	(НазначениеНаставника.Наставник = &Сотрудник
			|			ИЛИ НазначениеНаставника.Ссылка = &Ссылка)
			|	И НазначениеНаставника.Проведен
			|	И ПрекращениеНаставничества.Ссылка ЕСТЬ NULL";
			
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Если Выборка.Количество() = 1 Тогда
				
				Выборка.Следующий();
				ОбъектОснование = Выборка.Ссылка
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ОбъектОснование) = Тип("ДокументСсылка.НазначениеНаставника") Тогда
		Документы.ПрекращениеНаставничества.ЗаполнитьОбъектПоНазначениюНаставника(ЭтотОбъект, ОбъектОснование);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Проведение документа
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ЗарплатаКадрыРасширенный.ИнициализироватьОтложеннуюРегистрациюВторичныхДанныхПоДвижениямДокумента(Движения);
	
	ДанныеДляПроведения = ПолучитьДанныеДляПроведения();
	
	Если Утверждено И ОтменитьДоплату Тогда
		
		ЗарплатаКадрыРасширенный.УстановитьВремяРегистрацииДокумента(Движения, ДанныеДляПроведения.СотрудникиДаты, Ссылка);
		
		СтруктураПлановыхНачислений = Новый Структура;
		СтруктураПлановыхНачислений.Вставить("ДанныеОПлановыхНачислениях", ДанныеДляПроведения.ПлановыеНачисления);
		СтруктураПлановыхНачислений.Вставить("ЗначенияПоказателей", ДанныеДляПроведения.ЗначенияПоказателей);
		
		РасчетЗарплаты.СформироватьДвиженияПлановыхНачислений(ЭтотОбъект, Движения, СтруктураПлановыхНачислений);
		
		ОтражениеЗарплатыВБухучетеРасширенный.СформироватьПрекращениеБухучетаНачисленийСотрудников(ЭтотОбъект, Движения, Движения.ПлановыеНачисления);
		
	КонецЕсли;
	
	Наставничество.СформироватьДвиженияНаставничества(Движения, ДанныеДляПроведения);
		
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Перем ТекстСообщения;
	
	ЗарплатаКадры.ПроверитьКорректностьДаты(Ссылка, ДатаОкончания, "Объект.ДатаОкончания", Отказ, НСтр("ru='Дата окончания'"), , , Ложь);

	Если ОтменитьДоплату И Начисление.ПоддерживаетНесколькоПлановыхНачислений Тогда
		ПроверяемыеРеквизиты.Добавить("ДокументОснование");
	КонецЕсли;
	
	Если Не Наставничество.ДублиОтсутствуют(ЭтотОбъект, ТекстСообщения) Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "ДокументОснование", , Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
		
	ПроведениеСервер.ПодготовитьНаборыЗаписейКУдалениюПроведения(ЭтотОбъект);
		
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Документы.ПрекращениеНаставничества.ЗаполнитьДатуЗапретаРедактирования(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДанныеДляПроведения()
	
	ДанныеДляПроведения = Новый Структура; 
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Если Утверждено И ОтменитьДоплату Тогда
		
		// Подготовка данных для проведения.
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрекращениеНаставничества.ДатаОкончания КАК ДатаСобытия,
		|	ПрекращениеНаставничества.Наставник КАК Сотрудник,
		|	ПрекращениеНаставничества.Начисление КАК Начисление,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ПрекращениеНаставничества.Ссылка.Начисление КАК ПланВидовРасчета.Начисления).ПоддерживаетНесколькоПлановыхНачислений = ИСТИНА
		|			ТОГДА ПрекращениеНаставничества.Ссылка.ДокументОснование
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ДокументОснование,
		|	ЛОЖЬ КАК Используется,
		|	0 КАК Размер,
		|	ПрекращениеНаставничества.Наставник.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ПрекращениеНаставничества.Ссылка.Организация КАК ОрганизацияДокумента
		|ПОМЕСТИТЬ ВТДанныеОПлановыхНачислениях
		|ИЗ
		|	Документ.ПрекращениеНаставничества КАК ПрекращениеНаставничества
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|		ПО ПрекращениеНаставничества.Наставник = Сотрудники.Ссылка
		|ГДЕ
		|	ПрекращениеНаставничества.Ссылка = &Ссылка
		|	И ПрекращениеНаставничества.ОтменитьДоплату
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеОПлановыхНачислениях.ДатаСобытия КАК ДатаСобытия,
		|	ДанныеОПлановыхНачислениях.Сотрудник КАК Сотрудник,
		|	ДанныеОПлановыхНачислениях.Начисление КАК Начисление,
		|	ДанныеОПлановыхНачислениях.ДокументОснование КАК ДокументОснование,
		|	ДанныеОПлановыхНачислениях.Используется КАК Используется,
		|	ДанныеОПлановыхНачислениях.Размер КАК Размер,
		|	ДанныеОПлановыхНачислениях.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеОПлановыхНачислениях.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДействуетДо
		|ИЗ
		|	ВТДанныеОПлановыхНачислениях КАК ДанныеОПлановыхНачислениях
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеОПлановыхНачислениях.ОрганизацияДокумента КАК Организация,
		|	ДанныеОПлановыхНачислениях.Сотрудник КАК Сотрудник,
		|	ДанныеОПлановыхНачислениях.ДатаСобытия КАК ДатаСобытия,
		|	ДанныеОПлановыхНачислениях.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПоказателиНачислений.Показатель КАК Показатель,
		|	0 КАК Значение,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДействуетДо
		|ИЗ
		|	ВТДанныеОПлановыхНачислениях КАК ДанныеОПлановыхНачислениях
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовРасчета.Начисления.Показатели КАК ПоказателиНачислений
		|		ПО (ПоказателиНачислений.Ссылка = ДанныеОПлановыхНачислениях.Начисление)
		|			И (ПоказателиНачислений.ОтменяемыйПоказатель = ИСТИНА)
		|ГДЕ
		|	ПоказателиНачислений.Показатель ЕСТЬ НЕ NULL 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрекращениеНаставничества.Наставник КАК Сотрудник,
		|	ПрекращениеНаставничества.ДатаОкончания КАК ДатаСобытия,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДействуетДо,
		|	ПрекращениеНаставничества.СовокупнаяТарифнаяСтавка КАК Значение,
		|	ВЫБОР
		|		КОГДА ПрекращениеНаставничества.СовокупнаяТарифнаяСтавка = 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыТарифныхСтавок.ПустаяСсылка)
		|		ИНАЧЕ ПрекращениеНаставничества.ВидТарифнойСтавки
		|	КОНЕЦ КАК ВидТарифнойСтавки,
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	Документ.ПрекращениеНаставничества КАК ПрекращениеНаставничества
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|		ПО ПрекращениеНаставничества.Наставник = Сотрудники.Ссылка
		|ГДЕ
		|	ПрекращениеНаставничества.Ссылка = &Ссылка
		|	И ПрекращениеНаставничества.ОтменитьДоплату
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПрекращениеНаставничестваСотрудники.ДатаОкончания КАК ДатаСобытия,
		|	ПрекращениеНаставничестваСотрудники.Наставник КАК Сотрудник
		|ИЗ
		|	Документ.ПрекращениеНаставничества КАК ПрекращениеНаставничестваСотрудники
		|ГДЕ
		|	ПрекращениеНаставничестваСотрудники.Ссылка = &Ссылка
		|	И ПрекращениеНаставничестваСотрудники.ОтменитьДоплату";
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		// Таблица для формирования плановых начислений.
		ДанныеДляПроведения.Вставить("ПлановыеНачисления", РезультатыЗапроса[1].Выгрузить());
		
		// Таблица для формирования значений показателей.
		ДанныеДляПроведения.Вставить("ЗначенияПоказателей", РезультатыЗапроса[2].Выгрузить());
		
		// Таблица для формирования значений совокупных тарифных ставок.
		ДанныеДляПроведения.Вставить("ДанныеСовокупныхТарифныхСтавок", РезультатыЗапроса[3].Выгрузить());
		
		// Таблица для формирования времени регистрации документа.
		ДанныеДляПроведения.Вставить("СотрудникиДаты", РезультатыЗапроса[4].Выгрузить());
		
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОНЕЦПЕРИОДА(ПрекращениеНаставничества.ДатаОкончания, ДЕНЬ) КАК Период,
	|	ПрекращениеНаставничества.Организация КАК Организация,
	|	ПрекращениеНаставничества.Наставник КАК Наставник,
	|	ПрекращениеНаставничества.Наставляемый КАК Наставляемый,
	|	ПрекращениеНаставничества.ДокументОснование КАК ДокументОснование,
	|	ЛОЖЬ КАК Назначен,
	|	ПрекращениеНаставничества.ДатаОкончания КАК ДатаОкончания,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПрекращениеНаставничества.Наставник) = ТИП(Справочник.ФизическиеЛица)
	|			ТОГДА ПрекращениеНаставничества.Наставник
	|		ИНАЧЕ ВЫРАЗИТЬ(ПрекращениеНаставничества.Наставник КАК Справочник.Сотрудники).ФизическоеЛицо
	|	КОНЕЦ КАК ФизическоеЛицо
	|ИЗ
	|	Документ.ПрекращениеНаставничества КАК ПрекращениеНаставничества
	|ГДЕ
	|	ПрекращениеНаставничества.Ссылка = &Ссылка";
	
	ДанныеДляПроведения.Вставить("Наставничество", Запрос.Выполнить().Выгрузить());

	Возврат ДанныеДляПроведения;
	
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли