Функция ПолучитьДанныеДляПроведения(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СнятиеДисциплинарногоВзыскания.ДатаСнятия КАК Период,
		|	СнятиеДисциплинарногоВзыскания.ДатаНачала КАК ДатаНачала,
		|	СнятиеДисциплинарногоВзыскания.ДатаСнятия КАК ДатаОкончания,
		|	СнятиеДисциплинарногоВзыскания.Сотрудник КАК Сотрудник,
		|	СнятиеДисциплинарногоВзыскания.Взыскание КАК Взыскание,
		|	СнятиеДисциплинарногоВзыскания.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДокументСнятияДисциплинарногоВзыскания.Организация КАК Организация
		|ИЗ
		|	Документ.СнятиеДисциплинарногоВзыскания.Сотрудники КАК СнятиеДисциплинарногоВзыскания
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СнятиеДисциплинарногоВзыскания КАК ДокументСнятияДисциплинарногоВзыскания
		|		ПО СнятиеДисциплинарногоВзыскания.Ссылка = ДокументСнятияДисциплинарногоВзыскания.Ссылка
		|ГДЕ
		|	ДокументСнятияДисциплинарногоВзыскания.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	ДанныеДляПроведения = Новый Структура("ДвиженияДисциплинарногоВзыскания", Запрос.Выполнить().Выгрузить());
	
	Возврат ДанныеДляПроведения;
	
КонецФункции

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.МенеджерПечати = "Документ.СнятиеДисциплинарногоВзыскания";
	КомандаПечати.Идентификатор = Метаданные.Документы.СнятиеДисциплинарногоВзыскания.Макеты.ПФ_MXL_СнятиеДисциплинарныхВзысканий.Имя;
	КомандаПечати.Представление = Метаданные.Документы.СнятиеДисциплинарногоВзыскания.Макеты.ПФ_MXL_СнятиеДисциплинарныхВзысканий.Представление();
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.МенеджерПечати = "Документ.СнятиеДисциплинарногоВзыскания";
	КомандаПечати.Идентификатор = Метаданные.Документы.СнятиеДисциплинарногоВзыскания.Макеты.ПФ_MXL_СнятиеДисциплинарногоВзыскания.Имя;
	КомандаПечати.ДополнительныеПараметры.Вставить("ПечатьВсехПриказов", Истина);
	КомандаПечати.Представление = НСтр("ru = 'Приказы на каждого сотрудника в отдельности'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

// Формирует печатные формы
//
// Параметры:
//  Для чтения:
//    МассивОбъектов  - Массив    - Ссылки на объекты, которые нужно распечатать;
//    ПараметрыПечати - Структура - Настройки печати;
//  Для изменения:
//    КоллекцияПечатныхФорм - ТаблицаЗначений - Табличные документы.
//    ОбъектыПечати         - СписокЗначений  - Разбивка областей табличного документа по напечатанным объектам.
//        * Значение            - Ссылка объекта;
//        * Представление       - Имя области в которой был выведен объект;
//    ПараметрыВывода       - Структура       - Параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	УправлениеПечатьюБЗК.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, Документы.СнятиеДисциплинарногоВзыскания);
	
КонецПроцедуры

// Формирует печатную форму. Вызывается из УправлениеПечатьюБЗК.Печать.
//
// Параметры:
//   КонтекстПечати - Структура - См. УправлениеПечатьюБЗК.КонтекстПечати.
//
Процедура ПриФормированииПечатнойФормы(КонтекстПечати) Экспорт
	
	Если КонтекстПечати.МетаданныеМакета = Метаданные.Документы.СнятиеДисциплинарногоВзыскания.Макеты.ПФ_MXL_СнятиеДисциплинарныхВзысканий Тогда
		ПриПечатиСнятияДисциплинарныхВзысканий(КонтекстПечати);
	ИначеЕсли КонтекстПечати.МетаданныеМакета = Метаданные.Документы.СнятиеДисциплинарногоВзыскания.Макеты.ПФ_MXL_СнятиеДисциплинарногоВзыскания Тогда
		ПриПечатиСнятияДисциплинарногоВзыскания(КонтекстПечати);
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляПечатиСнятияДисциплинарныхВзысканий(МассивСсылок)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДокументСнятияДисциплинарногоВзыскания.Ссылка КАК Ссылка,
		|	ДокументСнятияДисциплинарногоВзыскания.Номер КАК НомерДок,
		|	ДокументСнятияДисциплинарногоВзыскания.Дата КАК Дата,
		|	ДокументСнятияДисциплинарногоВзыскания.Дата КАК Период,
		|	ДокументСнятияДисциплинарногоВзыскания.Дата КАК ДатаДок,
		|	ДокументДисциплинарноеВзыскание.Номер КАК НомерДокОснование,
		|	ДокументДисциплинарноеВзыскание.Дата КАК ДатаДокОснование,
		|	ДокументСнятияДисциплинарногоВзыскания.Организация КАК Организация,
		|	ДокументСнятияДисциплинарногоВзыскания.Руководитель КАК Руководитель,
		|	ДокументСнятияДисциплинарногоВзыскания.ДолжностьРуководителя КАК ДолжностьРуководителя,
		|	ДокументСнятияДисциплинарногоВзыскания.РаботникКадровойСлужбы КАК РаботникКадровойСлужбы,
		|	ДокументСнятияДисциплинарногоВзыскания.ДолжностьРаботникаКадровойСлужбы КАК ДолжностьРаботникаКадровойСлужбы,
		|	СнятиеДисциплинарногоВзыскания.Сотрудник КАК Сотрудник,
		|	СнятиеДисциплинарногоВзыскания.ДатаСнятия КАК ДатаСнятияВзыскания
		|ПОМЕСТИТЬ ВТДанныеДокументов
		|ИЗ
		|	Документ.СнятиеДисциплинарногоВзыскания.Сотрудники КАК СнятиеДисциплинарногоВзыскания
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СнятиеДисциплинарногоВзыскания КАК ДокументСнятияДисциплинарногоВзыскания
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ДисциплинарноеВзыскание КАК ДокументДисциплинарноеВзыскание
		|			ПО ДокументСнятияДисциплинарногоВзыскания.ДокументОснование = ДокументДисциплинарноеВзыскание.Ссылка
		|		ПО СнятиеДисциплинарногоВзыскания.Ссылка = ДокументСнятияДисциплинарногоВзыскания.Ссылка
		|ГДЕ
		|	ДокументСнятияДисциплинарногоВзыскания.Ссылка В(&МассивСсылок)";
	
	Запрос.Выполнить();
	
	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(Запрос.МенеджерВременныхТаблиц, "ВТДанныеДокументов");
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВременныхТаблиц, Истина, "ФИОПолные,Должность");
	
	ЗарплатаКадры.СоздатьВТФИООтветственныхЛиц(Запрос.МенеджерВременныхТаблиц, Истина, "Руководитель,РаботникКадровойСлужбы", "ВТДанныеДокументов");
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеДокументов.Ссылка КАК Ссылка,
		|	ДанныеДокументов.НомерДок КАК НомерДок,
		|	ДанныеДокументов.ДатаДок КАК ДатаДок,
		|	ДанныеДокументов.НомерДокОснование КАК НомерДокОснование,
		|	ДанныеДокументов.ДатаДокОснование КАК ДатаДокОснование,
		|	ДанныеДокументов.ДатаСнятияВзыскания КАК ДатаСнятияВзыскания,
		|	СправочникОрганизации.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	СправочникОрганизации.НаименованиеСокращенное КАК ОрганизацияНаименованиеСокращенное,
		|	КадровыеДанныеСотрудников.ФИОПолные КАК ФИОРаботника,
		|	СправочникДолжности.Наименование КАК ДолжностьРаботника,
		|	ДанныеДокументов.Руководитель КАК Руководитель,
		|	ДанныеДокументов.ДолжностьРуководителя КАК ДолжностьРуководителя,
		|	ФИОРуководителя.РасшифровкаПодписи КАК РуководительРасшифровкаПодписи,
		|	ФИОИсполнителя.ФИОПолные КАК ФИОИсполнителя,
		|	ДанныеДокументов.РаботникКадровойСлужбы КАК РаботникКадровойСлужбы,
		|	ДанныеДокументов.ДолжностьРаботникаКадровойСлужбы КАК ДолжностьИсполнителя,
		|	ВЫРАЗИТЬ(ДанныеДокументов.РаботникКадровойСлужбы КАК Справочник.ФизическиеЛица).Пол КАК ПолИсполнителя
		|ИЗ
		|	ВТДанныеДокументов КАК ДанныеДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Должности КАК СправочникДолжности
		|			ПО КадровыеДанныеСотрудников.Должность = СправочникДолжности.Ссылка
		|		ПО ДанныеДокументов.Сотрудник = КадровыеДанныеСотрудников.Сотрудник
		|			И ДанныеДокументов.Период = КадровыеДанныеСотрудников.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТФИООтветственныхЛиц КАК ФИОРуководителя
		|		ПО ДанныеДокументов.Ссылка = ФИОРуководителя.Ссылка
		|			И ДанныеДокументов.Руководитель = ФИОРуководителя.ФизическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТФИООтветственныхЛиц КАК ФИОИсполнителя
		|		ПО ДанныеДокументов.Ссылка = ФИОИсполнителя.Ссылка
		|			И ДанныеДокументов.РаботникКадровойСлужбы = ФИОИсполнителя.ФизическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК СправочникОрганизации
		|		ПО ДанныеДокументов.Организация = СправочникОрганизации.Ссылка";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ПриПечатиСнятияДисциплинарныхВзысканий(КонтекстПечати)
	
	ТабличныйДокумент = КонтекстПечати.ТабличныйДокумент;
	МассивОбъектов    = КонтекстПечати.МассивОбъектов;
	ОбъектыПечати     = КонтекстПечати.ОбъектыПечати;
	
	ДанныеДляПечати = ДанныеДляПечатиСнятияДисциплинарныхВзысканий(МассивОбъектов);
	Пока ДанныеДляПечати.СледующийПоЗначениюПоля("Ссылка") Цикл
		
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НачалоФормы = ТабличныйДокумент.ВысотаТаблицы - 1;
		НомерПункта = 1;
		
		ВывестиШапкуСнятияДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати);
		
		Пока ДанныеДляПечати.Следующий() Цикл
			
			ВывестиПунктСнятияДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати, НомерПункта);
			
			НомерПункта = НомерПункта + 1;
			
		КонецЦикла;
		
		ВывестиПодвалСнятияДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати, НомерПункта);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НачалоФормы, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВывестиШапкуСнятияДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати)
	
	НастройкиПечатныхФорм = ЗарплатаКадры.НастройкиПечатныхФорм();
	
	ТабличныйДокумент       = КонтекстПечати.ТабличныйДокумент;
	Макет                   = КонтекстПечати.Макет;
	ИменаПараметровОбластей = КонтекстПечати.ИменаПараметровОбластей;
	
	ПараметрыШапки = Новый Структура(ИменаПараметровОбластей.Шапка);
	ЗаполнитьЗначенияСвойств(ПараметрыШапки, ДанныеДляПечати);
	
	Если НастройкиПечатныхФорм.УдалятьПрефиксыОрганизацииИИБИзНомеровКадровыхПриказов Тогда
		ПараметрыШапки.НомерДок = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ПараметрыШапки.НомерДок, Истина, Истина);
		ПараметрыШапки.НомерДокОснование = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ПараметрыШапки.НомерДокОснование, Истина, Истина);
	КонецЕсли;
	
	ПараметрыШапки.ДатаДок = Формат(ПараметрыШапки.ДатаДок, "ДЛФ=DD");
	ПараметрыШапки.ДатаДокОснование = Формат(ПараметрыШапки.ДатаДокОснование, "ДЛФ=DD");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
КонецФункции

