Функция КадровыеДанныеСотрудника(Сотрудник, Организация, ДатаНачалаСобытия, Кэш = Неопределено) Экспорт
	Если Кэш = Неопределено Тогда
		Кэш = Новый Структура;
	ИначеЕсли ТипЗнч(Кэш) = Тип("Структура") И Кэш.Свойство("КадровыеДанные") И Кэш.КадровыеДанные <> Неопределено Тогда
		Возврат Кэш.КадровыеДанные;
	ИначеЕсли ТипЗнч(Кэш) = Тип("Соответствие") И Кэш["КадровыеДанные"] <> Неопределено Тогда
		Возврат Кэш["КадровыеДанные"];
	КонецЕсли;
	
	ИменаКадровыхДанных = 
	"Организация,
	|Подразделение,
	|ДатаУвольнения,
	|Территория,
	|Сотрудник,
	|ФизическоеЛицо,
	|РайонныйКоэффициентРФ,
	|Инвалидность,
	|ЛьготаПриНачисленииПособий,
	|ВидЗанятости,
	|ВидДоговора,
	|ДатаНачала,
	|ДатаОкончания,
	|ДоляНеполногоРабочегоВремени";
	ДанныеСотрудника = КадровыйУчет.КадровыеДанныеСотрудника(
		Истина,
		Сотрудник,
		ИменаКадровыхДанных,
		ДатаНачалаСобытия);
	Если ДанныеСотрудника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Получение кадровых данных основного сотрудника и подмена ссылки при необходимости.
	Если ДанныеСотрудника.ВидЗанятости <> Перечисления.ВидыЗанятости.ОсновноеМестоРаботы
		И ДанныеСотрудника.ВидЗанятости <> Перечисления.ВидыЗанятости.Совместительство Тогда
		ДанныеОсновногоСотрудника = КадровыйУчет.КадровыеДанныеОсновногоСотрудникаФизическогоЛица(
			Организация,
			ДанныеСотрудника.ФизическоеЛицо,
			ИменаКадровыхДанных,
			ДатаНачалаСобытия,
			Истина);
		Если ДанныеОсновногоСотрудника <> Неопределено И Сотрудник <> ДанныеОсновногоСотрудника.Сотрудник Тогда
			Если Не ЗначениеЗаполнено(ДанныеОсновногоСотрудника.ДатаУвольнения)
				Или ДанныеОсновногоСотрудника.ДатаУвольнения >= ДатаНачалаСобытия Тогда
				ДанныеСотрудника = ДанныеОсновногоСотрудника;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЕстьДоговорыГПХ = КадровыйУчет.ЕстьДоговорыГПХ(ДанныеСотрудника.ФизическоеЛицо, Организация, ДатаНачалаСобытия);
	
	Результат = Новый Структура(ИменаКадровыхДанных);
	ЗаполнитьЗначенияСвойств(Результат, ДанныеСотрудника);
	Результат.Вставить("ЕстьДоговорыГПХ", ЕстьДоговорыГПХ);
	Кэш.Вставить("КадровыеДанные", Результат);
	
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьУсловияИсчисления(Документ, КадровыеДанные) Экспорт
	
	Если ЗначениеЗаполнено(КадровыеДанные.ВидЗанятости)
		И ЗначениеЗаполнено(КадровыеДанные.ДатаУвольнения)
		И Документ.ДатаНачалаСобытия > КадровыеДанные.ДатаУвольнения
		И Не КадровыеДанные.ЕстьДоговорыГПХ Тогда
		УчетПособийСоциальногоСтрахования.УстановитьУсловиеИсчисления(Документ, "47");
	ИначеЕсли Не ЗначениеЗаполнено(КадровыеДанные.ВидЗанятости)
		И Не КадровыеДанные.ЕстьДоговорыГПХ Тогда 
		УчетПособийСоциальногоСтрахования.УстановитьУсловиеИсчисления(Документ, "47");
	Иначе
		УчетПособийСоциальногоСтрахования.УдалитьУсловиеИсчисления(Документ, "47");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КадровыеДанные.Инвалидность)
		И КадровыеДанные.Инвалидность Тогда
		УчетПособийСоциальногоСтрахования.УстановитьУсловиеИсчисления(Документ, "45");
	Иначе
		УчетПособийСоциальногоСтрахования.УдалитьУсловиеИсчисления(Документ, "45");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПорядокВыплатыУволенному(Документ) Экспорт
	
	Если УчетПособийСоциальногоСтрахования.ИспользуетсяУсловиеИсчисления(Документ, "47") Тогда
