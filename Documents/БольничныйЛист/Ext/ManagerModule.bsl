Функция ПараметрыРасчетаСреднегоДневногоЗаработкаФСС(Документ) Экспорт
	ПараметрыРасчета = УчетПособийСоциальногоСтрахования.ПараметрыРасчетаСреднегоДневногоЗаработкаФССПоДокументу(Документ);
	ПараметрыРасчета.ИспользоватьДниБолезниУходаЗаДетьми = ИспользоватьДниБолезниУходаЗаДетьми(Документ);
	ПараметрыРасчета.УчитыватьДниПриостановленияТД       = УчитыватьДниПриостановленияТД(Документ);
	ПараметрыРасчета.РайонныйКоэффициентРФ               = Документ.РайонныйКоэффициентРФНаНачалоСобытия;
	ПараметрыРасчета.ПорядокРасчета                      = ПорядокРасчетаСреднегоЗаработкаФСС(Документ);
	ПараметрыРасчета.ПрименятьПредельнуюВеличину         = Не ЭтоНСПЗ(Документ);
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.БольничныйЛист") Тогда
		// При вызове из модуля объекта данные должны быть сериализуемые, поэтому табличные части выгружаются.
		ПараметрыРасчета.ДанныеНачислений                 = Документ.СреднийЗаработокФСС.Выгрузить();
		ПараметрыРасчета.ДанныеВремени                    = Документ.ОтработанноеВремяДляСреднегоФСС.Выгрузить();
		ПараметрыРасчета.ДанныеСтрахователей              = Документ.СреднийЗаработокДанныеСтрахователей.Выгрузить();
		ПараметрыРасчета.ПриостановленияТрудовыхДоговоров = Документ.ПриостановленияТрудовыхДоговоров.Выгрузить();
		ПараметрыРасчета.СреднийЗаработокСЭДО             = Документ.СреднийЗаработокСЭДО.Выгрузить();
	Иначе
		// При вызове из модуля формы данные должны быть передаваемые с клиента на сервер (ДанныеФормыКоллекция).
		ПараметрыРасчета.ДанныеНачислений                 = Документ.СреднийЗаработокФСС;
		ПараметрыРасчета.ДанныеВремени                    = Документ.ОтработанноеВремяДляСреднегоФСС;
		ПараметрыРасчета.ДанныеСтрахователей              = Документ.СреднийЗаработокДанныеСтрахователей;
		ПараметрыРасчета.ПриостановленияТрудовыхДоговоров = Документ.ПриостановленияТрудовыхДоговоров;
		ПараметрыРасчета.СреднийЗаработокСЭДО             = Документ.СреднийЗаработокСЭДО;
	КонецЕсли;
	
	Возврат ПараметрыРасчета;
КонецФункции

Функция ИнформацияОВыбранномСреднемЗаработкеСЭДО(Документ, ПараметрыРасчета) Экспорт
	// По сути - данные для печати.
	Результат = Новый Структура;
	Результат.Вставить("ПервыйРасчетныйГодЗаработок", 0);
	Результат.Вставить("ПервыйРасчетныйГодОснование", Неопределено);
	Результат.Вставить("ВторойРасчетныйГодЗаработок", 0);
	Результат.Вставить("ВторойРасчетныйГодОснование", Неопределено);
	
	ДанныеПоГоду = ПараметрыРасчета.ДанныеПоГодам[Документ.ПериодРасчетаСреднегоЗаработкаПервыйГод];
	Если ДанныеПоГоду <> Неопределено Тогда
		Результат.ПервыйРасчетныйГодЗаработок = ДанныеПоГоду.УчтенныйЗаработок;
		Результат.ПервыйРасчетныйГодОснование = ДанныеПоГоду.Основание;
	КонецЕсли;
	ДанныеПоГоду = ПараметрыРасчета.ДанныеПоГодам[Документ.ПериодРасчетаСреднегоЗаработкаВторойГод];
	Если ДанныеПоГоду <> Неопределено Тогда
		Результат.ВторойРасчетныйГодЗаработок = ДанныеПоГоду.УчтенныйЗаработок;
		Результат.ВторойРасчетныйГодОснование = ДанныеПоГоду.Основание;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция СтруктураРасчетаДенежногоСодержания(Документ, УникальныйИдентификаторФормы, НазначенияРасчетаДС) Экспорт
	
	ОбъектСтруктура = Новый Структура;
	ОбъектСтруктура.Вставить("Ссылка", Документ.Ссылка);
	ОбъектСтруктура.Вставить("Сотрудник", Документ.Сотрудник);
	ОбъектСтруктура.Вставить("Организация", Документ.Организация);
	ОбъектСтруктура.Вставить("ПериодРегистрации", Документ.ПериодРегистрации);
	ОбъектСтруктура.Вставить("ДатаНачалаСобытия", Документ.ДатаНачалаСобытия);
	ОбъектСтруктура.Вставить("ДенежноеСодержание", Документ.ДенежноеСодержание);
	ОбъектСтруктура.Вставить("ДенежноеСодержаниеФактическиеНачисления", Документ.ДенежноеСодержаниеФактическиеНачисления);
	ОбъектСтруктура.Вставить("КоэффициентыРаспределенияДенежногоСодержания", Документ.КоэффициентыРаспределенияДенежногоСодержания);
	ОбъектСтруктура.Вставить("ПериодРасчетаСохраняемогоСодержанияНачало",
		Документ.ПериодРасчетаСреднегоЗаработкаНачало);
	ОбъектСтруктура.Вставить("ПериодРасчетаСохраняемогоСодержанияОкончание",
		Документ.ПериодРасчетаСреднегоЗаработкаОкончание);
	ОбъектСтруктура.Вставить("ФиксПериодРасчетаСохраняемогоСодержания", Документ.ФиксПериодРасчетаСреднегоЗаработка);
	ОбъектСтруктура.Вставить("СохраняемоеДенежноеСодержание", Документ.СохраняемоеДенежноеСодержание);
	ОбъектСтруктура.Вставить("НазначенияРасчетаДенежногоСодержания", НазначенияРасчетаДС);
	ОбъектСтруктура.Вставить("УникальныйИдентификатор", УникальныйИдентификаторФормы);
	ОбъектСтруктура.Вставить("ПериодРасчета", Документ.ПериодРегистрации);   
	ОбъектСтруктура.Вставить("Показатели", Документ.Показатели);   
	
	Возврат ОбъектСтруктура; 
	
КонецФункции

Функция ВариантДоплаты(Документ) Экспорт
	
	Если ЗарплатаКадры.РасширенныйРежим() Тогда
		Возврат МодульКонтракта().ВариантДоплаты(Документ);
	КонецЕсли;
	
КонецФункции

Процедура ОтключитьНеприменимыеВариантыДоплаты(Документ, ВариантДоплаты = Неопределено) Экспорт
	Если ВариантДоплаты = Неопределено Тогда
		ВариантДоплаты = ВариантДоплаты(Документ);
	КонецЕсли;
	Если ВариантДоплаты <> 1 Тогда
		Документ.ДоплачиватьДоСреднегоЗаработка = Ложь;
		Документ.ПроцентДоплатыЗаДниНетрудоспособности = 0;
	КонецЕсли;
	Если ВариантДоплаты <> 2 Тогда
		Документ.ДоплачиватьДоДенежногоСодержания = Ложь;
	КонецЕсли;
КонецПроцедуры

Процедура ОтключитьФлажкиПриНеобходимости(Документ) Экспорт
	
	Если ЗарплатаКадры.РасширенныйРежим() Тогда
		МодульКонтракта().ОтключитьФлажкиПриНеобходимости(Документ);
	КонецЕсли;
	
КонецПроцедуры

