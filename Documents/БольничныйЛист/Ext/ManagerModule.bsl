Функция ПараметрыЗаполнения(ЗаполнитьВсе = Ложь) Экспорт
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Действие", Неопределено);
	ПараметрыЗаполнения.Вставить("Кэш", Неопределено);
	ПараметрыЗаполнения.Вставить("Форма", Неопределено);
	ПараметрыЗаполнения.Вставить("ПервичнаяИнициализацияФормы", Ложь);
	
	ПараметрыЗаполнения.Вставить("ОчиститьПараметрыСреднего", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПоКадровымДаннымСотрудника", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСтаж", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПланируемуюДатуВыплаты", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПериодыУхода", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьДатуНачалаПоловиннойОплаты", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПроцентОплатыИОграничениеПособия", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПараметрыОплаты", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСсылкиНачислений", ЗаполнитьВсе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПриостановленияТД", ЗаполнитьВсе);
	
	ПараметрыЗаполнения.Вставить("ВыводитьСообщения", Ложь);
	ПараметрыЗаполнения.Вставить("Результат", ПустойРезультатЗаполнения());
	Возврат ПараметрыЗаполнения;
КонецФункции

Функция ПустойРезультатЗаполнения() Экспорт
