Функция ПараметрыРасчета() Экспорт
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ВыводитьСообщения", Ложь);
	ПараметрыРасчета.Вставить("ИспользуетсяРасчетЗарплаты", Неопределено);
	ПараметрыРасчета.Вставить("Кэш", Неопределено);
	ПараметрыРасчета.Вставить("ИдентификаторФормы", Неопределено);
	ПараметрыРасчета.Вставить("НазначенияРасчетаДенежногоСодержания", Неопределено);
	ПараметрыРасчета.Вставить("ОчиститьСреднийЗаработок", Ложь);
	ПараметрыРасчета.Вставить("ЗаполнитьСреднийЗаработок", Истина);
	ПараметрыРасчета.Вставить("ЗаполнитьФлажокУчитыватьЗаработокПредыдущихСтрахователей", Истина);
	ПараметрыРасчета.Вставить("РасчетУтвержден", Неопределено);
	ПараметрыРасчета.Вставить("ОчищатьДенежноеСодержание", Истина);
	Возврат ПараметрыРасчета;
КонецФункции

Функция РезультатРасчета() Экспорт
	РезультатРасчета = Новый Структура;
	РезультатРасчета.Вставить("Кэш", Неопределено);
	РезультатРасчета.Вставить("Успех", Ложь);
	РезультатРасчета.Вставить("ПричинаОтказа", "");
	РезультатРасчета.Вставить("ОшибкиЗаполнения", Новый Массив);
	
	РезультатРасчета.Вставить("ПересекающиесяОтпуска", Неопределено);
	РезультатРасчета.Вставить("СреднийЗаработокИзменен", Ложь);
	
	РезультатРасчета.Вставить("ДоступенФлажокРассчитатьЗарплату", Неопределено);
	РезультатРасчета.Вставить("РассчитатьЗарплатуИзменен", Ложь);
	РезультатРасчета.Вставить("ФлажокУчитыватьЗаработокПредыдущихСтрахователейЗаполнен", Истина);
	РезультатРасчета.Вставить("НазначенияРасчетаДенежногоСодержания", Неопределено);
	
	Возврат РезультатРасчета;
КонецФункции

Процедура ОчиститьРассчитанныеДанные(Документ, ПерезаполнитьНачисления = Истина, ОчищатьДенежноеСодержание = Истина) Экспорт
	
	Если ПерезаполнитьНачисления Тогда
		Документ.Начисления.Очистить();
		Документ.НачисленияПерерасчет.Очистить();
		Документ.НачисленияПерерасчетНулевыеСторно.Очистить();
		Документ.УправленческиеНачисления.Очистить();
		Документ.РаспределениеПоТерриториямУсловиямТруда.Очистить();
		Если ОчищатьДенежноеСодержание Тогда
			Документ.Показатели.Очистить();
		Иначе
			Показателей = Документ.Показатели.Количество();
			Для Сч = 1 По Показателей Цикл
				СтрокаПоказателя = Документ.Показатели[Показателей-Сч];
				Если Документ.ДенежноеСодержание.Найти(СтрокаПоказателя.ИдентификаторСтрокиВидаРасчета,"ИдентификаторСтрокиВидаРасчета") = Неопределено Тогда
					Документ.Показатели.Удалить(СтрокаПоказателя);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Документ.ПогашениеЗаймов.Очистить();
	КонецЕсли;
	
	Документ.Удержания.Очистить();
	Документ.НДФЛ.Очистить();
	Документ.КорректировкиВыплаты.Очистить();
	Документ.ПримененныеВычетыНаДетейИИмущественные.Очистить();
	
КонецПроцедуры

