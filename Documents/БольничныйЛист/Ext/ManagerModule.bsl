Процедура ОчиститьСреднийЗаработок(Документ) Экспорт
	
	Документ.СреднийЗаработокСЭДО.Очистить();
	Документ.СреднийЗаработокФСС.Очистить();
	Документ.ОтработанноеВремяДляСреднегоФСС.Очистить();
	Документ.СреднийЗаработокДанныеСтрахователей.Очистить();
	Документ.ДенежноеСодержание.Очистить();
	Документ.ДенежноеСодержаниеФактическиеНачисления.Очистить();
	
	Документ.СреднийДневнойЗаработок                        = 0;
	Документ.СреднийДневнойЗаработокРК                      = 0;
	Документ.СреднийДневнойЗаработокСН                      = 0;
	Документ.СреднийЗаработокБольничныйЗаСчетРаботодателя   = 0;
	Документ.СреднийЗаработокБольничныйЗаСчетРаботодателяРК = 0;
	Документ.СреднийЗаработокБольничныйЗаСчетРаботодателяСН = 0;
	Документ.СреднийПоДаннымОрганизации                     = 0;
	Документ.СреднийПоДаннымОрганизацииРК                   = 0;
	Документ.СреднийПоДаннымОрганизацииСН                   = 0;
	Документ.СреднийПоДаннымУчетаФонда                      = Неопределено;
	Документ.СреднийИзВходящегоЗапросаФонда                 = Неопределено;
	Документ.СреднийДоплатыПоДаннымОрганизации              = Неопределено;
	Документ.ПервыйРасчетныйГодЗаработок                    = Неопределено;
	Документ.ПервыйРасчетныйГодОснование                    = Неопределено;
	Документ.ВторойРасчетныйГодЗаработок                    = Неопределено;
	Документ.ВторойРасчетныйГодОснование                    = Неопределено;
	
КонецПроцедуры

Функция СреднийЗаполнен(Документ) Экспорт
	Возврат Документ.СреднийЗаработокСЭДО.Количество() > 0
		Или Документ.СреднийЗаработокФСС.Количество() > 0
		Или Документ.ОтработанноеВремяДляСреднегоФСС.Количество() > 0
		Или Документ.СреднийЗаработокДанныеСтрахователей.Количество() > 0
		Или Документ.ДенежноеСодержание.Количество() > 0
		Или Документ.ДенежноеСодержаниеФактическиеНачисления.Количество() > 0
		Или ЗначениеЗаполнено(Документ.СреднийДневнойЗаработок)
		Или ЗначениеЗаполнено(Документ.СреднийЗаработокБольничныйЗаСчетРаботодателя)
		Или ЗначениеЗаполнено(Документ.СреднийПоДаннымОрганизации)
		Или ЗначениеЗаполнено(Документ.СреднийПоДаннымУчетаФонда)
		Или ЗначениеЗаполнено(Документ.СреднийИзВходящегоЗапросаФонда)
		Или ЗначениеЗаполнено(Документ.СреднийДоплатыПоДаннымОрганизации)
		Или ЗначениеЗаполнено(Документ.ПервыйРасчетныйГодЗаработок)
		Или ЗначениеЗаполнено(Документ.ВторойРасчетныйГодЗаработок);
КонецФункции

