	РезультатЗаполнения.Вставить("ДляСотрудникаВведенСтраховойСтаж", Неопределено);
	РезультатЗаполнения.Вставить("ПериодыУходаЗаполнены", Ложь);
	РезультатЗаполнения.Вставить("ПараметрыОплатыЗаполнены", Ложь);
	РезультатЗаполнения.Вставить("ИзмененПериодРасчетаСреднего", Ложь);
	РезультатЗаполнения.Вставить("ПриостановленияТДЗаполнены", Ложь);
	РезультатЗаполнения.Вставить("РезультатыПроверкиПриостановленийТД", Неопределено);
	Возврат РезультатЗаполнения;
