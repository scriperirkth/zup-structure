#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если Метаданные.ОпределяемыеТипы.ОснованиеНаправленияНаМедицинскийОсмотр.Тип.СодержитТип(ТипДанныхЗаполнения) Тогда
		ДанныеЗаполнения = Документы.НаправлениеНаМедицинскийОсмотр.ДанныеЗаполненияПоОснованию(ДанныеЗаполнения);
	ИначеЕсли ТипДанныхЗаполнения <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоОписаниюДляЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(Ссылка) И МедицинскиеОсмотры.ЕстьЗаключениеПоНаправлению(Ссылка) Тогда
		ТекстСообщения = НСтр("ru = 'По данному направлению уже введено заключение медицинского осмотра'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецЕсли;
	
	ДатаНаправления = ДатаОсмотра;
	Если Не ЗначениеЗаполнено(ДатаНаправления) Тогда
		ДатаНаправления = Дата;
	КонецЕсли;
	
	Если ДатаНаправления >= МедицинскиеОсмотры.ДатаПриказа29н() Или ВредныеФакторыИВидыРабот.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "ВидыРабот");
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "ВредныеФакторы");
	Иначе	
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "ВредныеФакторыИВидыРабот");
		Если ВредныеФакторы.Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "ВидыРабот");
		КонецЕсли;
		
		Если ВидыРабот.Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "ВредныеФакторы");
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) И МедицинскиеОсмотры.ЕстьЗаключениеПоНаправлению(Ссылка) Тогда
		ТекстСообщения = НСтр("ru = 'По данному направлению уже введено заключение медицинского осмотра'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ОхранаТруда.ОбработатьДублиСтрокВТабличнойЧасти(ЭтотОбъект, "ВредныеФакторыИВидыРабот", "ВредныйФактор");
	ОхранаТруда.ОбработатьДублиСтрокВТабличнойЧасти(ЭтотОбъект, "ВредныеФакторы", "ВредныйФактор");
	ОхранаТруда.ОбработатьДублиСтрокВТабличнойЧасти(ЭтотОбъект, "ВидыРабот", "ВидРабот");
	
	ДанныеРабочегоМеста = Справочники.РабочиеМестаОхраныТруда.ДанныеРабочегоМеста(РабочееМесто);
	Если ДанныеРабочегоМеста = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Подразделение = ДанныеРабочегоМеста.Подразделение;
	Должность = ДанныеРабочегоМеста.Должность;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьВыданноеНаправление();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьВредныеФакторыВидыРабот() Экспорт
	
	Если Не ЗначениеЗаполнено(РабочееМесто) Или Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		ВредныеФакторыИВидыРабот.Очистить();
		ВредныеФакторы.Очистить();
		ВидыРабот.Очистить();
		Возврат;
	КонецЕсли;
	
	ДатаАктуальности = МедицинскиеОсмотры.ДатаАктуальностиДляЗаполненияНаправленияНаМедицинскийОсмотр(Дата, Организация);
	ЗаполнятьТолькоАктуальными = ТипОсмотра = Перечисления.ТипыМедицинскогоОсмотра.Периодический;
	
	ВредныеФакторыИВидыРаботТаблица = МедицинскиеОсмотры.ВредныеФакторыИВидыРаботТребующиеОсмотра(
		ФизическоеЛицо, ВидОсмотра, РабочееМесто, ДатаАктуальности, ЗаполнятьТолькоАктуальными);
	ВредныеФакторыИВидыРабот.Загрузить(ВредныеФакторыИВидыРаботТаблица);
	
	ВредныеФакторыТаблица = МедицинскиеОсмотры.ВредныеФакторыТребующиеОсмотра(
		ФизическоеЛицо, ВидОсмотра, РабочееМесто, ДатаАктуальности, ЗаполнятьТолькоАктуальными);
	ВредныеФакторы.Загрузить(ВредныеФакторыТаблица);
	
	ВидыРаботТаблица = МедицинскиеОсмотры.ВидыРаботТребующиеОсмотра(
		ФизическоеЛицо, ВидОсмотра, РабочееМесто, ДатаАктуальности, ЗаполнятьТолькоАктуальными);
	ВидыРабот.Загрузить(ВидыРаботТаблица);
	
КонецПроцедуры

Процедура ЗаполнитьДатуРожденияФизическогоЛица() Экспорт
	
	ДатаРождения = Неопределено;
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Возврат;
	КонецЕсли;
	
	ФизическиеЛица = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическоеЛицо);
	КадровыеДанные = КадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, ФизическиеЛица, "ДатаРождения");
	
	Если КадровыеДанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДатаРождения = КадровыеДанные[0]["ДатаРождения"];
	
КонецПроцедуры

Процедура ЗаполнитьРабочееМесто() Экспорт
	
	РабочееМесто = Неопределено;
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапроса = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыЗапроса.КадровыеДанные = "РабочееМестоОхраныТруда";
	ПараметрыЗапроса.Организация = Организация;
	ПараметрыЗапроса.СписокФизическихЛиц = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическоеЛицо);
	
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы, "ОформленПоТрудовомуДоговору", "=", Истина);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы, "ДатаУвольнения", "=", "ДАТАВРЕМЯ(1, 1, 1)");
	
	КадровыеДанные = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыЗапроса);
	Если КадровыеДанные.Количество() = 0 Тогда
		РабочееМесто = Неопределено;
		Возврат;
	КонецЕсли;
	
	РабочееМесто = КадровыеДанные[0].РабочееМестоОхраныТруда;
	
	ЗаполнитьВредныеФакторыВидыРабот();
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияПоУмолчанию()
	
	ЗначенияПоУмолчанию = Новый Структура("Ответственный");
	ЗарплатаКадры.ПолучитьЗначенияПоУмолчанию(ЗначенияПоУмолчанию);
	Ответственный = ЗначенияПоУмолчанию.Ответственный;
	
	Если Не ЗначениеЗаполнено(ВидОсмотра) Тогда
		ВидОсмотра = Перечисления.ВидыОбследований.МедицинскийОсмотр;
	КонецЕсли; 
	
КонецПроцедуры

Процедура ЗаписатьВыданноеНаправление()
	
	// Определим предыдущее состояние регистра по этому направлению.
	ДанныеНаправления = РегистрыСведений.ВыданныеНаправленияНаМедицинскийОсмотр.ДанныеВыданногоНаправления(Ссылка);
	
	// Удаляем прежние данные.
	Для Каждого Выборка Из ДанныеНаправления Цикл
		НаборЗаписей = РегистрыСведений.ВыданныеНаправленияНаМедицинскийОсмотр.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(Выборка.ФизическоеЛицо);
		НаборЗаписей.Отбор.РабочееМесто.Установить(Выборка.РабочееМесто);
		НаборЗаписей.Отбор.ВидОсмотра.Установить(Выборка.ВидОсмотра);
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		Если ПометкаУдаления Или Выборка.ФизическоеЛицо <> ФизическоеЛицо Тогда
			НаборЗаписей.ДополнительныеСвойства.Вставить("ПрежнийНабор", ДанныеНаправления);
		КонецЕсли;
		НаборЗаписей.Записать();
	КонецЦикла;
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем новую запись о выданном направлении.
	ДатаЗаписи = ДатаОсмотра;
	Если Не ЗначениеЗаполнено(ДатаЗаписи) Тогда
		ДатаЗаписи = Дата;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) 
		Или Не ЗначениеЗаполнено(РабочееМесто) 
		Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ВыданныеНаправленияНаМедицинскийОсмотр.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ФизическоеЛицо.Установить(ФизическоеЛицо);
	НаборЗаписей.Отбор.РабочееМесто.Установить(РабочееМесто);
	НаборЗаписей.Отбор.ВидОсмотра.Установить(ВидОсмотра);
	НаборЗаписей.Отбор.Период.Установить(ДатаЗаписи);
	
	СтрокаНабора = НаборЗаписей.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаНабора, ЭтотОбъект);
	СтрокаНабора.ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Организация);
	СтрокаНабора.Период = ДатаЗаписи;
	СтрокаНабора.Направление = Ссылка;
	СтрокаНабора.Заключение = МедицинскиеОсмотры.ЗаключениеПоНаправлению(Ссылка);
	НаборЗаписей.ДополнительныеСвойства.Вставить("ПрежнийНабор", ДанныеНаправления);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьПоОписаниюДляЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	
	ЗаполнитьДатуРожденияФизическогоЛица();
	ЗаполнитьЗначенияПоУмолчанию();
	
	РабочееМесто = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "РабочееМесто");
	Если Не ЗначениеЗаполнено(РабочееМесто) Тогда
		ЗаполнитьРабочееМесто();
	Иначе
		ЗаполнитьВредныеФакторыВидыРабот();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли