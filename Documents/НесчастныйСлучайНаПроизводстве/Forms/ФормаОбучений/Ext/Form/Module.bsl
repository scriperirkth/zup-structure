
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Пострадавший = Параметры.Пострадавший;
	Организация = Параметры.Организация;
	ФИОПострадавшийСклоняемое = Строка(Пострадавший);
	ФизическиеЛицаЗарплатаКадры.Просклонять(Строка(ФИОПострадавшийСклоняемое), 2, ФИОПострадавшийСклоняемое, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пострадавший, "Пол"));
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Пройденные обучения: %1'"), ФИОПострадавшийСклоняемое);
	
	Обучения.Очистить();
	Для каждого СтрокаОбучения Из Параметры.Обучения Цикл
		НоваяСтрока = Обучения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбучения);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)

	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("Пострадавший", Пострадавший);
	
	МассивОбучений = Новый Массив;
	Для каждого СтрокаТаблицы Из Обучения Цикл
		СтрокаОбучения = Новый Структура;
		СтрокаОбучения.Вставить("ПрограммаОбучения", СтрокаТаблицы.ПрограммаОбучения);
		СтрокаОбучения.Вставить("НачалоОбучения", СтрокаТаблицы.НачалоОбучения);
		СтрокаОбучения.Вставить("ОкончаниеОбучения", СтрокаТаблицы.ОкончаниеОбучения);
		СтрокаОбучения.Вставить("ДатаПроверкиЗнания", СтрокаТаблицы.ДатаПроверкиЗнания);
		СтрокаОбучения.Вставить("НомерПротокола", СтрокаТаблицы.НомерПротокола);
		СтрокаОбучения.Вставить("РезультатПроверки", СтрокаТаблицы.РезультатПроверки);
		МассивОбучений.Добавить(СтрокаОбучения);
	КонецЦикла;
	
	ПараметрыЗакрытия.Вставить("Обучения", МассивОбучений);
	
	Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОбучениеПоОхранеТруда", Новый Структура("Организация", Организация)) Тогда
		Возврат;
	КонецЕсли;
	
	Обучения.Очистить();
	МассивФизическихЛиц = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Пострадавший);
	ОбученияПоОхранеТруда = ОбучениеПоОхранеТруда.ОбученияСотрудниковПоОхранеТруда(МассивФизическихЛиц);
	Для Каждого ОбучениеСотрудника Из ОбученияПоОхранеТруда Цикл
		НоваяСтрока = Обучения.Добавить();
		НоваяСтрока.ПрограммаОбучения = ОбучениеСотрудника.ПрограммаОбучения;
		НоваяСтрока.НачалоОбучения = ОбучениеСотрудника.ДатаНачалаОбучения;
		НоваяСтрока.ОкончаниеОбучения = ОбучениеСотрудника.ДатаОкончанияОбучения;
		НоваяСтрока.НомерПротокола = ОбучениеСотрудника.НомерПротокола;
		НоваяСтрока.РезультатПроверки = ОбучениеСотрудника.РезультатПроверки;
		НоваяСтрока.ДатаПроверкиЗнания = ОбучениеСотрудника.ДатаПроверкиЗнания;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
