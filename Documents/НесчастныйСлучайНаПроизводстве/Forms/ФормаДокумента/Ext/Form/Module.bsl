		СтрокаОбучения.Вставить("ПрограммаОбучения", НайденнаяСтрока.ПрограммаОбучения);
		СтрокаОбучения.Вставить("ДатаПроверкиЗнания", НайденнаяСтрока.ДатаПроверкиЗнания);
		СтрокаОбучения.Вставить("НачалоОбучения", НайденнаяСтрока.НачалоОбучения);
		СтрокаОбучения.Вставить("ОкончаниеОбучения", НайденнаяСтрока.ОкончаниеОбучения);
		СтрокаОбучения.Вставить("НомерПротокола", НайденнаяСтрока.НомерПротокола);
		СтрокаОбучения.Вставить("РезультатПроверки", НайденнаяСтрока.РезультатПроверки);
