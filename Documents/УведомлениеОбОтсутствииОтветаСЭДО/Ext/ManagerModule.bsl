Функция АктуальныеТребования()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ВЫБОР
	|			КОГДА НЕ Уведомление.Загружен
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ТребуетсяЗагрузить,
	|	СУММА(ВЫБОР
	|			КОГДА Уведомление.Загружен
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ТребуетсяОбработать
	|ИЗ
	|	Документ.УведомлениеОбОтсутствииОтветаСЭДО КАК Уведомление
	|ГДЕ
	|	Уведомление.ДатаСообщения >= &ДатаАктуальности
	|	И НЕ Уведомление.Обработан
	|	И НЕ Уведомление.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДатаАктуальности", НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -12)));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// См. ТекущиеДелаПереопределяемый.ПриОпределенииОбработчиковТекущихДел.
Процедура ПриЗаполненииСпискаТекущихДел(ТекущиеДела) Экспорт
	
	МетаданныеДокумента = Метаданные();
	Если Не СЭДОФСС.ДоступенОбменЧерезСЭДО()
		Или Не ПравоДоступа("Изменение", МетаданныеДокумента) Тогда
		Возврат; // Нет прав.
	КонецЕсли;
	
	МодульТекущиеДелаСервер = ОбщегоНазначения.ОбщийМодуль("ТекущиеДелаСервер");
	Разделы = МодульТекущиеДелаСервер.РазделыДляОбъекта(МетаданныеДокумента.ПолноеИмя());
	Если Разделы.Количество() = 0 Тогда
		Возврат; // Некорректное внедрение.
	КонецЕсли;
	
	Требования = АктуальныеТребования();
	ТребуетсяЗагрузить = Требования.Итог("ТребуетсяЗагрузить");
	ТребуетсяОбработать = Требования.Итог("ТребуетсяОбработать");
	Всего = ТребуетсяЗагрузить + ТребуетсяОбработать;
	ИмяДокумента = МетаданныеДокумента.Имя;
	ПредставлениеСписка = МетаданныеДокумента.ПредставлениеСписка;
	
	Для Каждого Раздел Из Разделы Цикл
		
		ПолноеИмяРаздела = СтрЗаменить(Раздел.ПолноеИмя(), ".", "_");
		
		Дело = ТекущиеДела.Добавить();
		Дело.Идентификатор  = ИмяДокумента + "_ВРаботе_" + ПолноеИмяРаздела;
		Дело.ЕстьДела       = (Всего > 0);
		Дело.Важное         = Истина;
		Дело.Владелец       = Раздел;
		Дело.Представление  = ПредставлениеСписка;
		Дело.Количество     = Всего;
		Дело.ПараметрыФормы = Новый Структура("ТолькоВРаботе", Истина);
		Дело.Форма          = "Документ.УведомлениеОбОтсутствииОтветаСЭДО.ФормаСписка";
		
		ИдентификаторРодителя = Дело.Идентификатор;
		
		Дело = ТекущиеДела.Добавить();
		Дело.Идентификатор  = ИмяДокумента + "_Загрузить_" + ПолноеИмяРаздела;
		Дело.ЕстьДела       = (ТребуетсяЗагрузить > 0);
		Дело.Важное         = Ложь;
		Дело.Владелец       = ИдентификаторРодителя;
		Дело.Представление  = НСтр("ru = 'Получить новые'");
		Дело.Количество     = ТребуетсяЗагрузить;
		
		Дело = ТекущиеДела.Добавить();
		Дело.Идентификатор  = ИмяДокумента + "_Ответить_" + ПолноеИмяРаздела;
		Дело.ЕстьДела       = (ТребуетсяОбработать > 0);
		Дело.Важное         = Ложь;
		Дело.Владелец       = ИдентификаторРодителя;
		Дело.Представление  = НСтр("ru = 'Ответить на запрос'");
		Дело.Количество     = ТребуетсяОбработать;
		
	КонецЦикла;
	
КонецПроцедуры

