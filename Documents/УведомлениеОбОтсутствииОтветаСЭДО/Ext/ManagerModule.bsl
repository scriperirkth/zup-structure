Процедура ЗагрузитьУведомлениеОНаличииСообщения(ТипСообщения, Страхователь, Уведомление, ЕстьИзменения) Экспорт
	ИдентификаторСообщения = Уведомление.Идентификатор;
	
	Объект = СоздатьДокументПоСообщению(Страхователь, ИдентификаторСообщения, Истина);
	Объект.ТипСообщения = ТипСообщения;
	Объект.ДатаСообщения = СЭДОФСС.ДатаСообщения(ИдентификаторСообщения);
	Объект.ТребуетсяПодтверждение = Уведомление.ТребуетсяПодтверждение;
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = Страхователь;
	КонецЕсли;
	СЭДОФСС.ЗаписатьДокумент(Объект, Истина, "БЗК", РежимЗаписиДокумента.Запись);
	
	ЕстьИзменения = Истина;
КонецПроцедуры

// Загружает информацию о несоответствии сведений о застрахованном лице в базу данных.
Процедура ЗагрузитьСообщение(ТипСообщения, Страхователь, ИдентификаторСообщения, ТекстXML, ТребуетсяПодтверждение, Результат, Кэш) Экспорт
	Объект = СоздатьДокументПоСообщению(Страхователь, ИдентификаторСообщения, Ложь);
	Объект.ТипСообщения = ТипСообщения;
	Объект.ДатаСообщения = СЭДОФСС.ДатаСообщения(ИдентификаторСообщения, Кэш);
	Объект.ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Страхователь);
	
	Если Не Объект.Загружен Тогда
		Объект.Дата = ТекущаяДатаСеанса();
		Объект.Загружен = Истина;
	КонецЕсли;
	
	Если ТипСообщения = 124 Тогда
		ЗаполнитьДокументПоСообщению124(Объект, ТекстXML);
	ИначеЕсли ТипСообщения = 12410 Тогда
		ЗаполнитьДокументПоСообщению12410(Объект, ТекстXML);
	Иначе
		Объект = Неопределено;
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неподдерживаемый тип сообщения: %1'"), ТипСообщения);
	КонецЕсли;
	
	Объект.ОбновитьВторичныеДанные();
	
	СЭДОФСС.ЗаписатьДокумент(Объект, Истина, "БЗК", РежимЗаписиДокумента.Проведение);
	
	Результат.Обработано = Истина;
КонецПроцедуры

Процедура ЗаполнитьДокументПоСообщению124(Объект, ТекстXML)
	// Пример:
	//<proactiveExpireNotice xmlns="urn:ru:fss:integration:types:proactive:notifications:v01">
	//	<socialAssistNum>5177644</socialAssistNum>
	//	<missingResponseToRequest>Информируем, что Страхователю по СНИЛС 37535959432 направлен запрос о представлении недостающих сведений и документов (сообщение № 100 СЭДО). Идентификатор запроса: "17674919-823f-4af7-8d54-093691d5398e", дата и время направления запроса: 2024-06-20 19:56:34.167. В установленный срок ответ от Страхователя в Социальный фонд России не поступил</missingResponseToRequest>
	//</proactiveExpireNotice>
	
	// Поиск корневого узла.
	СтруктураDOM = СериализацияБЗК.СтруктураDOM(ТекстXML);
	КореньDOM = СериализацияБЗК.НайтиУзелDOMПоИмени(СтруктураDOM, "proactiveExpireNotice");
	Если КореньDOM = Неопределено Тогда
		КореньDOM = СтруктураDOM.ДокументDOM.ЭлементДокумента;
	КонецЕсли;
	
	// Чтение реквизитов.
	РеквизитыКорня = СериализацияБЗК.УзлыЭлементаDOM(КореньDOM, "socialAssistNum, missingResponseToRequest");
	Объект.НомерПроцесса = СериализацияБЗК.ЧислоИзXML(РеквизитыКорня.socialAssistNum);
	Объект.ТекстУведомления = СериализацияБЗК.СтрокаИзXML(РеквизитыКорня.missingResponseToRequest);
КонецПроцедуры

Процедура ЗаполнитьДокументПоСообщению12410(Объект, ТекстXML)
	// Пример:
	//<n1:proactiveExpireNotice xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	//	xmlns:n1="urn:ru:ecp:integration:proactive:notice:proactiveExpireNotice:v3.0"
	//	specVersion="3.0"
	//	xsi:schemaLocation="urn:ru:ecp:integration:proactive:notice:proactiveExpireNotice:v3.0 ProactiveExpireNotice.xsd">
	//	<n1:socialAssistNum>395444620</n1:socialAssistNum>
	//	<n1:snils>27977360648</n1:snils>
	//	<n1:UUID>ef674865-23b0-41e7-bdfe-1c27a05ce9cd</n1:UUID>
	//	<n1:date>2026-04-01 00:44:03.548</n1:date>
	//</n1:proactiveExpireNotice>
	
	// Поиск корневого узла.
	СтруктураDOM = СериализацияБЗК.СтруктураDOM(ТекстXML);
	КореньDOM = СериализацияБЗК.НайтиУзелDOMПоИмени(СтруктураDOM, "proactiveExpireNotice");
	Если КореньDOM = Неопределено Тогда
		КореньDOM = СтруктураDOM.ДокументDOM.ЭлементДокумента;
	КонецЕсли;
	
	// Чтение атрибутов.
	АтрибутыКорня = СериализацияБЗК.АтрибутыЭлементаDOM(КореньDOM, "specVersion");
	Объект.ВерсияСпецификации = СериализацияБЗК.СтрокаИзXML(АтрибутыКорня.specVersion);
	
	// Чтение реквизитов.
	РеквизитыКорня = СериализацияБЗК.УзлыЭлементаDOM(КореньDOM, "socialAssistNum, snils, UUID, date");
	Объект.НомерПроцесса = СериализацияБЗК.ЧислоИзXML(РеквизитыКорня.socialAssistNum);
	Объект.СотрудникСНИЛС = СЭДОФСС.СНИЛСИзXML(РеквизитыКорня.snils);
	Объект.ВходящийЗапросИдентификатор = СериализацияБЗК.СтрокаИзXML(РеквизитыКорня.UUID);
	Объект.ВходящийЗапросДата = СериализацияБЗК.ДатаИзXML(РеквизитыКорня.date);
КонецПроцедуры

Процедура ЗагрузитьОтветНаПодтверждениеПолученияСообщения(Страхователь, ИсходноеСообщение, Результат, ЕстьИзменения) Экспорт
	// Вызывается при получении сообщения с типом 11 в ответ на подтверждение о прочтении входящего сообщения.
	//   Страхователь - СправочникСсылка.Организации - организация, получатель сообщения.
	//   ИсходноеСообщение - Структура:
	//     * ИдентификаторСообщения - Строка - идентификатор исходного сообщения СЭДО, по которому отправлялось подтверждение.
	//     * Тип                    - Число  - тип исходного сообщения СЭДО, по которому отправлялось подтверждение.
	//     * ТекстОшибки            - Строка - ошибка приема подтверждения.
	//     * ТекстПредупреждения    - Строка - предупреждение приема подтверждения.
	//   Результат - Структура - результат обработки сообщения:
	//     * Обработано      - Булево - признак того, что сообщение было успешно обработано.
	//     * ОшибкаОбработки - Булево - признак того, что при обработке сообщения возникла ошибка.
	//     * ОписаниеОшибки  - Строка - описание ошибки обработки.
	
	// Поиск документа по идентификатору сообщения.
	СтрокаТаблицы = НайтиДокументПоСообщению(Страхователь, ИсходноеСообщение.ИдентификаторСообщения);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заполнение подтверждения получения.
	ДокументОбъект = СтрокаТаблицы.Ссылка.ПолучитьОбъект();
	Если ДокументОбъект.ЗаполнитьПодтверждениеПолучения(Неопределено) Тогда
		СЭДОФСС.ЗаписатьДокумент(ДокументОбъект, Истина, "БЗК", РежимЗаписиДокумента.Проведение);
		ЕстьИзменения = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьДокументПоСообщению(Страхователь, ИдентификаторСообщения, СнятьПометкуУдаления)
	СтрокаТаблицы = НайтиДокументПоСообщению(Страхователь, ИдентификаторСообщения);
	Если СтрокаТаблицы = Неопределено Тогда
		Объект = СоздатьДокумент();
		Объект.Страхователь = Страхователь;
		Объект.ИдентификаторСообщения = ИдентификаторСообщения;
		Объект.ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Страхователь);
	Иначе
		Объект = СтрокаТаблицы.Ссылка.ПолучитьОбъект();
		Если СнятьПометкуУдаления И Объект.ПометкаУдаления Тогда
			Объект.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
	КонецЕсли;
	Возврат Объект;
КонецФункции

Функция НайтиДокументПоСообщению(Страхователь, ИдентификаторСообщения)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Дата КАК Дата,
	|	Шапка.Страхователь КАК Страхователь,
	|	Шапка.ПометкаУдаления КАК ПометкаУдаления,
	|	Шапка.ТребуетсяПодтверждение КАК ТребуетсяПодтверждение
	|ИЗ
	|	Документ.УведомлениеОбОтсутствииОтветаСЭДО КАК Шапка
	|ГДЕ
	|	Шапка.ИдентификаторСообщения = &ИдентификаторСообщения
	|	И Шапка.Страхователь = &Страхователь
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПометкаУдаления,
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	Запрос.УстановитьПараметр("Страхователь", Страхователь);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() > 0 Тогда
		Возврат Таблица[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область ФиксацияВторичныхДанныхВДокументах

Функция ФиксируемыеРеквизиты()
	ФиксируемыеРеквизиты = Новый Соответствие;
	
	Шаблон = ФиксацияВторичныхДанныхВДокументах.ОписаниеФиксируемогоРеквизита();
	Шаблон.ИмяГруппы = "ПодтверждениеПолучения";
	Шаблон.ОснованиеЗаполнения = "ИдентификаторСообщения";
	ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(ФиксируемыеРеквизиты, Шаблон, "ТребуетсяПодтверждение");
	ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(ФиксируемыеРеквизиты, Шаблон, "ДатаОтправкиПодтверждения");
	ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(ФиксируемыеРеквизиты, Шаблон, "ПодтверждениеПолученоСФР");
	
	Шаблон = ФиксацияВторичныхДанныхВДокументах.ОписаниеФиксируемогоРеквизита();
	Шаблон.ИмяГруппы = "НомерПроцесса";
	Шаблон.ОснованиеЗаполнения = "НомерПроцесса";
	ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(ФиксируемыеРеквизиты, Шаблон, "Страхователь");
	ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(ФиксируемыеРеквизиты, Шаблон, "ВходящийЗапрос");
	
	Шаблон = ФиксацияВторичныхДанныхВДокументах.ОписаниеФиксируемогоРеквизита();
	Шаблон.ИмяГруппы = "ВходящийЗапрос";
	Шаблон.ОснованиеЗаполнения = "ВходящийЗапрос";
	ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(ФиксируемыеРеквизиты, Шаблон, "ФизическоеЛицо");
	
	Шаблон = ФиксацияВторичныхДанныхВДокументах.ОписаниеФиксируемогоРеквизита();
	Шаблон.ИмяГруппы = "МаксимальнаяДатаПодтверждения";
	Шаблон.ОснованиеЗаполнения = "ДатаСообщения";
	ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(ФиксируемыеРеквизиты, Шаблон, "МаксимальнаяДатаПодтверждения");
	
	// Добавление всех оставшихся реквизитов одной группой "по умолчанию".
	РеквизитыРучногоЗаполнения = "Ответственный, Комментарий";
	РеквизитыРучногоЗаполнения = Новый Структура(РеквизитыРучногоЗаполнения);
	Группа = ФиксацияВторичныхДанныхВДокументах.ОписаниеФиксируемогоРеквизита();
	Группа.ИмяГруппы                = "СлужебныеРеквизиты";
	Группа.ОтображатьПредупреждение = Ложь;
	Для Каждого Реквизит Из Метаданные().Реквизиты Цикл
		Если Не РеквизитыРучногоЗаполнения.Свойство(Реквизит.Имя)
			И ФиксируемыеРеквизиты[Реквизит.Имя] = Неопределено Тогда
			ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(ФиксируемыеРеквизиты, Группа, Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(ФиксируемыеРеквизиты);
КонецФункции

#КонецОбласти

#Область ВнешниеСобытия

Процедура ПриИзмененииСНИЛСФизическогоЛица(ФизическоеЛицо, СтарыйСНИЛС, НовыйСНИЛС) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Шапка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УведомлениеОбОтсутствииОтветаСЭДО КАК Шапка
	|ГДЕ
	|	Шапка.СотрудникСНИЛС = &НовыйСНИЛС
	|	И Шапка.ФизическоеЛицо <> &ФизическоеЛицо
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Шапка.Ссылка
	|ИЗ
	|	Документ.УведомлениеОбОтсутствииОтветаСЭДО КАК Шапка
	|ГДЕ
	|	Шапка.ФизическоеЛицо = &ФизическоеЛицо
	|	И Шапка.СотрудникСНИЛС <> &НовыйСНИЛС";
	Если ЗначениеЗаполнено(НовыйСНИЛС) Тогда
		Запрос.УстановитьПараметр("НовыйСНИЛС", НовыйСНИЛС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Шапка.СотрудникСНИЛС = &НовыйСНИЛС", "ЛОЖЬ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Шапка.СотрудникСНИЛС <> &НовыйСНИЛС", "ИСТИНА");
	КонецЕсли;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаВыборки Из Таблица Цикл
		Если Не ЗначениеЗаполнено(СтрокаВыборки.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		ДокументОбъект = СтрокаВыборки.Ссылка.ПолучитьОбъект();
		Если ДокументОбъект.СотрудникСНИЛС = НовыйСНИЛС И ЗначениеЗаполнено(НовыйСНИЛС) Тогда
			ДокументОбъект.ФизическоеЛицо = ФизическоеЛицо;
		Иначе
			ДокументОбъект.ФизическоеЛицо = Неопределено;
		КонецЕсли;
		ДокументОбъект.ОбновитьВторичныеДанные();
		СЭДОФСС.ЗаписатьДокумент(ДокументОбъект, Истина, "БЗК", РежимЗаписиДокумента.Проведение);
	КонецЦикла;
КонецПроцедуры

Процедура ПриЗаписиВходящегоЗапроса(ВходящийЗапрос) Экспорт
	// Искать уведомления имеет смысл только для входящих запросов которые могут быть просрочены.
	Если Не ВходящийЗапрос.Загружен Тогда
		Возврат; // Входящий запрос не загружен.
	КонецЕсли;
	Если ВходящийЗапрос.МаксимальнаяДатаОтвета >= НачалоДня(ТекущаяДатаСеанса()) Тогда
		Возврат; // Входящий запрос не просрочен.
	КонецЕсли;
	ЗначенияДоЗаписи = ВходящийЗапрос.ДополнительныеСвойства.ЗначенияРеквизитовДоЗаписи;
	Если Не ЗначенияДоЗаписи.ЭтоНовый
		И ЗначенияДоЗаписи.ОтветНаЗапрос = ВходящийЗапрос.ОтветНаЗапрос
		И ЗначенияДоЗаписи.Обработан = ВходящийЗапрос.Обработан
		И ЗначенияДоЗаписи.ФизическоеЛицо = ВходящийЗапрос.ФизическоеЛицо Тогда
		Возврат; // Ключевые значения не изменились.
	КонецЕсли;
	НомераПроцессов = Новый Массив;
	КоллекцииБЗК.ДобавитьНеПустоеЗначениеВМассив(НомераПроцессов, ВходящийЗапрос.НомерПроцесса);
	КоллекцииБЗК.ДобавитьНеПустоеЗначениеВМассив(НомераПроцессов, ЗначенияДоЗаписи.НомерПроцесса);
	Если НомераПроцессов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОбновитьВторичныеДанныеПоНомерамПроцессов(НомераПроцессов);
КонецПроцедуры

Процедура ПриЗаписиОтветаНаЗапрос(ОтветНаЗапрос, НаборРегистраций) Экспорт
	// Прочие проверки для оптимизации.
	ЗначенияДоЗаписи = ОтветНаЗапрос.ДополнительныеСвойства.ЗначенияРеквизитовДоЗаписи;
	НомераПроцессов = Новый Массив;
	КоллекцииБЗК.ДобавитьНеПустоеЗначениеВМассив(НомераПроцессов, ОтветНаЗапрос.НомерПроцесса);
	КоллекцииБЗК.ДобавитьНеПустоеЗначениеВМассив(НомераПроцессов, ЗначенияДоЗаписи.НомерПроцесса);
	Если НомераПроцессов.Количество() = 0 Тогда
		Возврат; // Документ не заполнен (и не был заполнен до записи).
	КонецЕсли;
	Если Не ЗначенияДоЗаписи.ЭтоНовый
		И ЗначенияДоЗаписи.ВходящийЗапрос = ОтветНаЗапрос.ВходящийЗапрос
		И ЗначенияДоЗаписи.ДатаОтправки = ОтветНаЗапрос.ДатаОтправки
		И ЗначенияДоЗаписи.ФизическоеЛицо = ОтветНаЗапрос.ФизическоеЛицо
		И Не ЕстьИзмененияКлючевыхЗначенийВНабореРегистраций(НаборРегистраций) Тогда
		Возврат;
	КонецЕсли;
	// Поиск и обновление вторичных данных.
	ОбновитьВторичныеДанныеПоНомерамПроцессов(НомераПроцессов);
КонецПроцедуры

Процедура ПриЗаписиРегистрацииОтветаНаЗапрос(НаборРегистраций) Экспорт
	// Оптимизация - исключение повторного вызова.
	Если Не ЕстьИзмененияКлючевыхЗначенийВНабореРегистраций(НаборРегистраций) Тогда
		Возврат;
	КонецЕсли;
	НомераПроцессов = КоллекцииБЗК.УникальныеЗначенияКолонки(НаборРегистраций.Выгрузить(), "РегистрацияНомерПроцесса");
	Если НомераПроцессов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Поиск и обновление вторичных данных.
	ОбновитьВторичныеДанныеПоНомерамПроцессов(НомераПроцессов);
КонецПроцедуры

Процедура ОбновитьВторичныеДанныеПоНомерамПроцессов(НомераПроцессов)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УведомлениеОбОтсутствииОтветаСЭДО.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УведомлениеОбОтсутствииОтветаСЭДО КАК УведомлениеОбОтсутствииОтветаСЭДО
	|ГДЕ
	|	УведомлениеОбОтсутствииОтветаСЭДО.НомерПроцесса В(&НомераПроцессов)";
	Запрос.УстановитьПараметр("НомераПроцессов", НомераПроцессов);
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Объект = СтрокаТаблицы.Ссылка.ПолучитьОбъект();
		Если Объект.ОбновитьВторичныеДанные() Тогда
			СЭДОФСС.ЗаписатьДокумент(Объект, Истина, "БЗК", РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Определяет наличие изменений в наборе записей регистре РегистрацииОтветовНаЗапросыФССДляРасчетаПособий
//   важных для этого документа.
Функция ЕстьИзмененияКлючевыхЗначенийВНабореРегистраций(НаборРегистраций)
	// Оптимизация - исключение повторного вызова.
	Если НаборРегистраций.ДополнительныеСвойства.Свойство("УведомлениеОбОтсутствииОтветаОбновлено") Тогда
		Возврат Ложь;
	КонецЕсли;
	НаборРегистраций.ДополнительныеСвойства.Вставить("УведомлениеОбОтсутствииОтветаОбновлено", Истина);
	// Получение значений "до записи".
	ТаблицаДоЗаписи = ОбщегоНазначенияБЗК.ЗначениеСвойства(НаборРегистраций.ДополнительныеСвойства, "ЗначенияДоЗаписи");
	Если ТаблицаДоЗаписи = Неопределено Или ТаблицаДоЗаписи.Количество() = 0 Тогда
		Возврат Истина; // Новые записи.
	КонецЕсли;
	// Проверка наличия изменений.
	Для Каждого Запись Из НаборРегистраций Цикл
		СтрокаДоЗаписи = ТаблицаДоЗаписи.Найти(Запись.ИсходящийДокумент, "ИсходящийДокумент");
		Если СтрокаДоЗаписи = Неопределено
			Или СтрокаДоЗаписи.РегистрацияДата <> Запись.РегистрацияДата
			Или СтрокаДоЗаписи.Состояние <> Запись.Состояние Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти

