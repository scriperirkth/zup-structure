&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	ТипыУчастниковКадровогоРезерва = КадровыйРезерв.ТипыУчастниковКадровогоРезерваДоступныхПоФункциональнымОпциям();
	НесколькоТиповУчастников = ТипыУчастниковКадровогоРезерва.Количество() > 1;
	Если НесколькоТиповУчастников Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СотрудникиПодбор", "Видимость",
			Ложь);
		КадровыйРезервФормы.ДополнитьКомандыИКнопкиПодбора(ЭтотОбъект, "СотрудникиКоманднаяПанель", "Сотрудники");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУчастникуКадровогоРезерва(Параметры)

	// Сначала заполним из пула кандидатов, если таковые имеются.
	ЗаполнитьКандидатамиНаСервере(Параметры.УчастникКадровогоРезерва);
	
	// Затем добавим строку на основании переданных параметров.
	ДополнитьТЧСотрудникиСтрокойПоПараметрам(Параметры);

	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Данные = КадровыйРезерв.ДанныеУчастникаКадровогоРезерва(Параметры.УчастникКадровогоРезерва);
		Если ЗначениеЗаполнено(Данные) Тогда
			Объект.Подразделение = Данные.МестоВСтруктуреПредприятия;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДополнитьТЧСотрудникиСтрокойПоПараметрам(СтруктураПараметры)
	
	СтруктураПоиска = Новый Структура;
	Если СтруктураПараметры.Свойство("УчастникКадровогоРезерва") Тогда
		СтруктураПоиска.Вставить("УчастникКадровогоРезерва", СтруктураПараметры.УчастникКадровогоРезерва);
	КонецЕсли;
	Если СтруктураПараметры.Свойство("ПозицияРезерва") Тогда
		СтруктураПоиска.Вставить("ПозицияРезерва", СтруктураПараметры.ПозицияРезерва);
	КонецЕсли;
	
	НайденныеСтроки = Объект.Сотрудники.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяПозиция = Объект.Сотрудники.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяПозиция, СтруктураПараметры);
		НоваяПозиция.ДатаОкончания = КонецМесяца(ДобавитьМесяц(Объект.ДатаРассмотрения, 60))-1;
		НоваяПозиция.Действие = ПредопределенноеЗначение("Перечисление.ДействияСКадровымиРезервистами.Утвердить");
		КадровыйРезервКлиентСервер.ЗаполнитьОписаниеДействия(НоваяПозиция, Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва, Неопределено - 
&НаСервере
Процедура ЗаполнитьКандидатамиНаСервере(УчастникКадровогоРезерва = Неопределено)

	ИспользоватьКадровыйРезервПоВидам = ПолучитьФункциональнуюОпцию("ИспользоватьКадровыйРезервПоВидам");
	Если ИспользоватьКадровыйРезервПоВидам И Не ЗначениеЗаполнено(Объект.ВидРезерва) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнятьПоРезервисту = УчастникКадровогоРезерва <> Неопределено;
	
	Объект.Сотрудники.Очистить();
	
	Отбор = КадровыйРезерв.НовыйОтборКадровогоРезерваНаДату();
	Если ЗаполнятьПоРезервисту Тогда
		Отбор.УчастникиКадровогоРезерва = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УчастникКадровогоРезерва);
	КонецЕсли;
	Если ИспользоватьКадровыйРезервПоВидам И ЗначениеЗаполнено(Объект.ВидРезерва) Тогда
		Отбор.ВидРезерва = Объект.ВидРезерва;
	КонецЕсли;
	Отбор.Статусы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Рассматривается"));
	Отбор.ИсключаемыйРегистратор = Объект.Ссылка;
	
	ТаблицаРезервистов = КадровыйРезерв.КадровыйРезервНаДату(Объект.ДатаРассмотрения, Отбор);
	Для каждого Резервист Из ТаблицаРезервистов Цикл
		НоваяСтрока = Объект.Сотрудники.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Резервист);
		НоваяСтрока.ДатаОкончания = КонецМесяца(ДобавитьМесяц(Объект.ДатаРассмотрения, 60))-1;
		НоваяСтрока.Действие = ПредопределенноеЗначение("Перечисление.ДействияСКадровымиРезервистами.Утвердить");
		КадровыйРезервКлиентСервер.ЗаполнитьОписаниеДействия(НоваяСтрока, Ложь);
	КонецЦикла; 
	
	Если Не ЗаполнятьПоРезервисту Тогда
		ЗаполнитьДанныеУчастниковКадровогоРезерва();
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКоманд(Форма, ТекущиеДанные)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"СотрудникиВключить",
		"Доступность",
		ТекущиеДанные.Действие = ПредопределенноеЗначение("Перечисление.ДействияСКадровымиРезервистами.Отклонить"));

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"СотрудникиОтклонить",
		"Доступность",
		ТекущиеДанные.Действие = ПредопределенноеЗначение("Перечисление.ДействияСКадровымиРезервистами.Утвердить"));
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписанияДействия()
	
	Для каждого СтрокаСотрудник Из Объект.Сотрудники Цикл
		КадровыйРезервКлиентСервер.ЗаполнитьОписаниеДействия(СтрокаСотрудник, Ложь);
	КонецЦикла; 
	
КонецПроцедуры

// Параметры:
//  УчастникиКадровогоРезерва - Неопределено,Массив из ОпределяемыйТип.УчастникКадровогоРезерва
&НаСервере
Процедура ЗаполнитьДанныеУчастниковКадровогоРезерва(УчастникиКадровогоРезерва = Неопределено)

	Если УчастникиКадровогоРезерва = Неопределено Тогда
		УчастникиКадровогоРезерва = ОбщегоНазначения.ВыгрузитьКолонку(Объект.Сотрудники, "УчастникКадровогоРезерва",
			Истина);
		ДанныеУчастниковКадровогоРезерва.Очистить();
	Иначе
		Для Каждого УчастникКадровогоРезерва Из УчастникиКадровогоРезерва Цикл
			УдалитьДанныеУчастникаКадровогоРезерва(УчастникКадровогоРезерва);
		КонецЦикла;
	КонецЕсли;
	
	ДанныеСотрудников = ДанныеСотрудников(УчастникиКадровогоРезерва);
	ДобавитьДанныеУчастниковКадровогоРезерва(ДанныеСотрудников);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		ДанныеКандидатов = МодульПодборПерсонала.ДанныеКандидатовДляВключенияВКадровыйРезерв(УчастникиКадровогоРезерва);
		ДобавитьДанныеУчастниковКадровогоРезерва(ДанныеКандидатов);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
&НаСервере
Процедура ЗаполнитьДанныеУчастникаКадровогоРезерва(УчастникКадровогоРезерва)
	
	УчастникиКадровогоРезерва = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УчастникКадровогоРезерва);
	ЗаполнитьДанныеУчастниковКадровогоРезерва(УчастникиКадровогоРезерва);
	
КонецПроцедуры

// Параметры:
//  УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
&НаСервере
Процедура УдалитьДанныеУчастникаКадровогоРезерва(УчастникКадровогоРезерва)
	
	Отбор = Новый Структура("УчастникКадровогоРезерва", УчастникКадровогоРезерва);
	УдаляемыеСтроки = ДанныеУчастниковКадровогоРезерва.НайтиСтроки(Отбор);
	Для каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		ДанныеУчастниковКадровогоРезерва.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  ДанныеСотрудников - см. НоваяТаблицаДанныхУчастниковКадровогоРезерва
&НаСервере
Процедура ДобавитьДанныеУчастниковКадровогоРезерва(ДанныеСотрудников)
	
	Для Каждого ТекущаяСтрока Из ДанныеСотрудников Цикл
		НоваяСтрока = ДанныеУчастниковКадровогоРезерва.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДанныеСотрудников(Знач СписокФизическихЛиц)

	// Готовим ВТ фильтров
	ТаблицаСотрудников = КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(СписокФизическихЛиц, Истина, Неопределено,
		ТекущаяДатаСеанса());
	Запрос = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСотрудников.Сотрудник,
	|	ТаблицаСотрудников.ФизическоеЛицо,
	|	&ДатаСреза КАК Период
	|ПОМЕСТИТЬ ВТСотрудники
	|ИЗ
	|	&ТаблицаСотрудников КАК ТаблицаСотрудников
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо,
	|	ФизическиеЛица.ДатаРождения,
	|	&ДатаСреза КАК Период
	|ПОМЕСТИТЬ ВТФизическиеЛица
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.Ссылка В(&СписокФизическихЛиц)";
	
	Запрос.УстановитьПараметр("ТаблицаСотрудников", ТаблицаСотрудников);
	Запрос.УстановитьПараметр("СписокФизическихЛиц", СписокФизическихЛиц);
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДатаСеанса());
	Запрос.Выполнить();
	
	// Запрос по местам работы сотрудника.
	ПараметрыПолученияРабочихМест = КадровыйУчет.ПараметрыДляЗапросВТРабочиеМестаСотрудниковПоСпискуСотрудников();
	ПараметрыПолученияРабочихМест.НачалоПериода		= '00010101';
	ПараметрыПолученияРабочихМест.ОкончаниеПериода  = ТекущаяДатаСеанса();
	ПараметрыПолученияРабочихМест.СписокСотрудников = ТаблицаСотрудников.ВыгрузитьКолонку("Сотрудник");
	КадровыйУчет.СоздатьВТРабочиеМестаСотрудников(МенеджерВременныхТаблиц, Истина, ПараметрыПолученияРабочихМест);
	Описатель = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(Запрос.МенеджерВременныхТаблиц, "ВТСотрудники");
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(Описатель, Ложь, "ДатаПриема");
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТРабочиеМестаСотрудников.Сотрудник КАК Сотрудник,
		|	ВТРабочиеМестаСотрудников.Должность КАК Должность,
		|	ВТРабочиеМестаСотрудников.Подразделение КАК Подразделение,
		|	ВЫБОР
		|		КОГДА ВТРабочиеМестаСотрудников.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.НачальныеДанные)
		|			ТОГДА ВТКадровыеДанныеСотрудников.ДатаПриема
		|		ИНАЧЕ ВТРабочиеМестаСотрудников.ПериодЗаписи
		|	КОНЕЦ КАК ПериодЗаписи
		|ИЗ
		|	ВТРабочиеМестаСотрудников КАК ВТРабочиеМестаСотрудников
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК ВТКадровыеДанныеСотрудников
		|		ПО ВТРабочиеМестаСотрудников.Сотрудник = ВТКадровыеДанныеСотрудников.Сотрудник
		|ГДЕ
		|	ВТРабочиеМестаСотрудников.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.НеподтвержденныеДанные)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПериодЗаписи УБЫВ
		|ИТОГИ ПО
		|	Сотрудник";
	РабочиеМестаСотрудников = Новый Соответствие;
	ВыборкаСотрудники = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСотрудники.Следующий() Цикл
		МассивРабочихМест = Новый Массив;
		ВыборкаДетальныеЗаписи = ВыборкаСотрудники.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() И МассивРабочихМест.Количество() < 3 Цикл
			МассивРабочихМест.Добавить(Новый Структура("Должность, Подразделение, ПериодЗаписи",
				ВыборкаДетальныеЗаписи.Должность, ВыборкаДетальныеЗаписи.Подразделение,
				ВыборкаДетальныеЗаписи.ПериодЗаписи));
		КонецЦикла;
		РабочиеМестаСотрудников.Вставить(ВыборкаСотрудники.Сотрудник, МассивРабочихМест);
	КонецЦикла;
	
	// Получаем данные физических лиц.
	Описание = КадровыйУчет.ОписаниеВременнойТаблицыОтборовФизическихЛиц("ВТФизическиеЛица");
	КадровыеДанные = "ПолученныеОбразования,ЗнанияЯзыков,Профессии,Специальности,ТрудоваяДеятельность";
	
	ИтоговыйЗапрос = КадровыйУчет.ЗапросВТПостоянныеКадровыеДанныеФизическихЛиц(Истина, Описание, КадровыеДанные, ,
		"ВТПостоянныеКДФизическихЛиц"); 
	ИтоговыйЗапрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ИтоговыйЗапрос.Выполнить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТФизическиеЛица.ФизическоеЛицо КАК УчастникКадровогоРезерва,
	|	ВТФизическиеЛица.ДатаРождения,
	|	ВТСотрудники.Сотрудник,
	|	ЕСТЬNULL(ВТПостоянныеКДФизическихЛиц.ПолученныеОбразования, """") КАК ПолученныеОбразования,
	|	ЕСТЬNULL(ВТПостоянныеКДФизическихЛиц.ЗнанияЯзыков, """") КАК ЗнанияЯзыков,
	|	ЕСТЬNULL(ВТПостоянныеКДФизическихЛиц.Профессии, """") КАК Профессии,
	|	ЕСТЬNULL(ВТПостоянныеКДФизическихЛиц.Специальности, """") КАК Специальности,
	|	ЕСТЬNULL(ВТПостоянныеКДФизическихЛиц.ТрудоваяДеятельность, """") КАК ТрудоваяДеятельность
	|ИЗ
	|	ВТФизическиеЛица КАК ВТФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСотрудники КАК ВТСотрудники
	|		ПО ВТФизическиеЛица.ФизическоеЛицо = ВТСотрудники.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПостоянныеКДФизическихЛиц КАК ВТПостоянныеКДФизическихЛиц
	|		ПО ВТФизическиеЛица.ФизическоеЛицо = ВТПостоянныеКДФизическихЛиц.ФизическоеЛицо";
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	ДанныеСотрудников = КадровыйРезервФормы.НоваяТаблицаДанныхУчастниковКадровогоРезерва();
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		ОписаниеДанных = КадровыйРезервФормы.НовоеОписаниеУчастникаКадровогоРезерва();
		
		Если ЗначениеЗаполнено(ВыборкаЗапроса.ДатаРождения) Тогда
			ДанныеСтажа = ЗарплатаКадрыРасширенныйКлиентСервер.СведенияОСтаже();
			ДанныеСтажа.ДатаОтсчета = ВыборкаЗапроса.ДатаРождения;
			Возраст = ЗарплатаКадрыРасширенныйКлиентСервер.ПродолжительностьСтажа(ДанныеСтажа, ТекущаяДатаСеанса());
			ПредставлениеСтажа = ЗарплатаКадрыРасширенныйКлиентСервер.ПредставлениеСтажа(Возраст.Лет, 0, 0);
			ТекстВозраста = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 (%2)",
				Формат(ВыборкаЗапроса.ДатаРождения, "ДЛФ=D"), ПредставлениеСтажа);
		Иначе
			ТекстВозраста = НСтр("ru ='<не заполнена>'");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОписаниеДанных, ВыборкаЗапроса);
		
		ОписаниеДанных.МассивРабочихМест = РабочиеМестаСотрудников.Получить(ВыборкаЗапроса.Сотрудник);
		ОписаниеДанных.ТекстВозраста = ТекстВозраста;
		
		НоваяСтрока = ДанныеСотрудников.Добавить();
		НоваяСтрока.УчастникКадровогоРезерва = ВыборкаЗапроса.УчастникКадровогоРезерва;
		НоваяСтрока.СтруктураДанных = ОписаниеДанных;
		
	КонецЦикла;
	
	Возврат ДанныеСотрудников;
	
КонецФункции

// Возвращает адрес во временном хранилище массива уже подобранных сотрудников.
//
&НаСервере
Функция АдресСпискаПодобранныхСотрудников()
	
	// Найдем сотрудников по физлицам
	СписокСотрудниковПоФизическимЛицам = ТаблицаСотрудниковИФизлиц(
		Объект.Сотрудники.Выгрузить(,"УчастникКадровогоРезерва").ВыгрузитьКолонку("УчастникКадровогоРезерва"));
	
	Возврат ПоместитьВоВременноеХранилище(СписокСотрудниковПоФизическимЛицам.ВыгрузитьКолонку("Сотрудник"),
		УникальныйИдентификатор);
	
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаСотрудниковИФизлиц(СписокФизическихЛиц)
	
	ПараметрыСотрудников = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыСотрудников.СписокФизическихЛиц = СписокФизическихЛиц;
	
	Возврат КадровыйУчет.СотрудникиОрганизации(Истина,ПараметрыСотрудников);
	
КонецФункции

// См. КадровыйРезервФормы.ОтборИзПодразделения
&НаСервереБезКонтекста
Функция ОтборИзПодразделения(Знач Подразделение)

	Возврат КадровыйРезервФормы.ОтборИзПодразделения(Подразделение);

КонецФункции

&НаКлиенте
Процедура УстановитьФорматированнуюНадписьСотрудники(УчастникКадровогоРезерва)

	ДанныеУчастникаКадровогоРезерва = СтрокаДанныхУчастникаКадровогоРезерва(ЭтотОбъект, УчастникКадровогоРезерва);
	Если ДанныеУчастникаКадровогоРезерва = Неопределено Тогда
		ФорматированнаяНадписьСотрудники = "";
		Возврат;
	КонецЕсли;
	
	// Заполняем форматированную строку результатами.
	ФорматированнаяНадписьСотрудники = "";
	МассивСтрок = Новый Массив;
	
	ЖирныйШрифт = Новый Шрифт(,,Истина);
	
	// Возраст
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Дата рождения'") + " - ", ЖирныйШрифт));
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока(ДанныеУчастникаКадровогоРезерва.ТекстВозраста));
	МассивСтрок.Добавить(Символы.ПС);
	
	// Образование
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Образование:'") + " ", ЖирныйШрифт));
	Если ЗначениеЗаполнено(ДанныеУчастникаКадровогоРезерва.ПолученныеОбразования) Тогда
		Для СчСтрок = 1 По СтрЧислоСтрок(ДанныеУчастникаКадровогоРезерва.ПолученныеОбразования) Цикл
			СтрокаОбразования = СтрПолучитьСтроку(ДанныеУчастникаКадровогоРезерва.ПолученныеОбразования, СчСтрок);
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(СтрокаОбразования,,,,"Образование"));
			Суффикс = ?(СтрЧислоСтрок(ДанныеУчастникаКадровогоРезерва.ПолученныеОбразования) = СчСтрок, "", ", ");
			МассивСтрок.Добавить(Суффикс);
		КонецЦикла;
	Иначе
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = '<не заполнено>'")));
	КонецЕсли;
	МассивСтрок.Добавить(Символы.ПС);
	
	// Работа
	МассивТекстовРаботы = Новый Массив;
	Если ЗначениеЗаполнено(ДанныеУчастникаКадровогоРезерва.МассивРабочихМест) Тогда
		Для каждого РабочееМесто Из ДанныеУчастникаКадровогоРезерва.МассивРабочихМест Цикл
			ТекстРаботы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 в %2 с %3'"),
			РабочееМесто.Должность,
			РабочееМесто.Подразделение,
			Формат(РабочееМесто.ПериодЗаписи, "ДЛФ=D"));
			Суффикс = ?(ДанныеУчастникаКадровогоРезерва.МассивРабочихМест.Найти(РабочееМесто) + 1 = ДанныеУчастникаКадровогоРезерва.МассивРабочихМест.Количество(),
				"", ", ");
			МассивТекстовРаботы.Добавить(Новый ФорматированнаяСтрока(ТекстРаботы, Суффикс));
		КонецЦикла; 
	КонецЕсли;

	Если МассивТекстовРаботы.Количество() > 0 Тогда
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Работа в компании:'") + " ", ЖирныйШрифт));
		МассивСтрок.Добавить(МассивТекстовРаботы);
	Иначе
		Если ТипЗнч(УчастникКадровогоРезерва) = Тип("СправочникСсылка.ЛичныеДанныеКандидатов") Тогда
			Текст = НСтр("ru = 'Кандидат'");
		Иначе
			Текст = НСтр("ru = 'Внешний сотрудник'");
		КонецЕсли;
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Текст, ЖирныйШрифт));
	КонецЕсли;
	МассивСтрок.Добавить(Символы.ПС);
		
	Если ЗначениеЗаполнено(ДанныеУчастникаКадровогоРезерва.ТрудоваяДеятельность) Тогда
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Предыдущие места работы:'") + " ",
			ДанныеУчастникаКадровогоРезерва.ТрудоваяДеятельность));
		МассивСтрок.Добавить(Символы.ПС);
	КонецЕсли;
	
	// Профессии, специальность, языки
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока(ДанныеУчастникаКадровогоРезерва.Профессии));
	МассивСтрок.Добавить(Символы.ПС);
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока(ДанныеУчастникаКадровогоРезерва.Специальности));
	МассивСтрок.Добавить(Символы.ПС);
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока(ДанныеУчастникаКадровогоРезерва.ЗнанияЯзыков));
	МассивСтрок.Добавить(Символы.ПС);
	
	ФорматированнаяНадписьСотрудники = Новый ФорматированнаяСтрока(МассивСтрок);
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаДанныхУчастникаКадровогоРезерва(Форма, УчастникКадровогоРезерва)

	НайденноеСоответствие = Форма.ДанныеУчастниковКадровогоРезерва.НайтиСтроки(
		Новый Структура("УчастникКадровогоРезерва", УчастникКадровогоРезерва));
	Если НайденноеСоответствие.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат НайденноеСоответствие[0].СтруктураДанных;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура УстановитьРезервистаИзПодбора(Знач РезультатЗакрытия, Знач ДополнительныеПараметры) Экспорт

	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		ТекущиеДанные.УчастникКадровогоРезерва = РезультатЗакрытия;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Элемент.Отбор,
		"Объект.Сотрудники.Действие",
		Перечисления.ДействияСКадровымиРезервистами.Отклонить,
		ВидСравненияКомпоновкиДанных.Равно);
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("СотрудникиДатаОкончания");
		
	Элемент = УсловноеОформление.Элементы.Добавить();
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор,
		Неопределено, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора,
		"Объект.Сотрудники.Действие",
		Перечисления.ДействияСКадровымиРезервистами.Утвердить,
		ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора,
		"Объект.Сотрудники.СтатусГотовности",,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("СотрудникиСтатусРезервиста");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеРезерва()
	
	Если Не ВыводитьУведомлениеПослеЗаписи() Тогда
		Возврат;
	КонецЕсли;
	
	АктуальныйРезерв = НаличиеРезерва();
	Если АктуальныйРезерв.Количество() > 0 Тогда
		КадровыйРезервКлиент.ВывестиУведомлениеОНаличииРезерва(АктуальныйРезерв, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НаличиеРезерва()
	
	МассивРезервов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
		|	КадровыйРезерв.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	КадровыйРезерв.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.КадровыйРезерв КАК КадровыйРезерв
		|ГДЕ
		|	КадровыйРезерв.ДатаВключения < &ТекущаяДата
		|	И (КадровыйРезерв.ДатаИсключения > &ТекущаяДата
		|			ИЛИ КадровыйРезерв.ДатаИсключения = ДАТАВРЕМЯ(1, 1, 1))
		|	И КадровыйРезерв.УчастникКадровогоРезерва В(&УчастникиКадровогоРезерва)
		|ИТОГИ ПО
		|	УчастникКадровогоРезерва";
		
	Запрос.УстановитьПараметр("УчастникиКадровогоРезерва",
		Объект.Сотрудники.Выгрузить().ВыгрузитьКолонку("УчастникКадровогоРезерва"));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		ВыборкаСтрок = Выборка.Выбрать();
		СтруктураРезерва = Новый Структура("УчастникКадровогоРезерва, ПозицииРезерва, ПозицииКандидатаВРезерв");
		СтруктураРезерва.УчастникКадровогоРезерва = Выборка.УчастникКадровогоРезерва;
		ПозицииРезерва = Новый Массив;
		ПозицииКандидатаВРезерв = Новый Массив;
		Пока ВыборкаСтрок.Следующий() Цикл
			Если ВыборкаСтрок.Статус = Перечисления.СостоянияСогласования.Согласовано Тогда
				СтрокиРезерва = Объект.Сотрудники.НайтиСтроки(
					Новый Структура("УчастникКадровогоРезерва, ПозицияРезерва", Выборка.УчастникКадровогоРезерва, 
						ВыборкаСтрок.ПозицияРезерва));
				Если СтрокиРезерва.Количество() = 0 Тогда
					ПозицииРезерва.Добавить(ВыборкаСтрок.ПозицияРезерва);
				КонецЕсли;
			Иначе
				ПозицииКандидатаВРезерв.Добавить(ВыборкаСтрок.ПозицияРезерва);
			КонецЕсли;
		КонецЦикла;
		Если ПозицииРезерва.Количество() > 0 Или ПозицииКандидатаВРезерв.Количество() > 0 Тогда
			СтруктураРезерва.ПозицииРезерва = ПозицииРезерва;
			СтруктураРезерва.ПозицииКандидатаВРезерв = ПозицииКандидатаВРезерв;
			МассивРезервов.Добавить(СтруктураРезерва);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивРезервов;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытьПослеПроведения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	Если Результат.БольшеНеЗадаватьЭтотВопрос Тогда
		СохранитьВыводитьУведомлениеПослеЗаписи(Ложь);
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыводитьУведомлениеПослеЗаписи()
	
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		Метаданные.Документы.ВключениеВКадровыйРезерв.Формы.ФормаДокумента.ПолноеИмя(), "ВыводитьУведомлениеПослеЗаписи",
		Истина);
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьВыводитьУведомлениеПослеЗаписи(ВыводитьУведомление)

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		Метаданные.Документы.ВключениеВКадровыйРезерв.Формы.ФормаДокумента.ПолноеИмя(), "ВыводитьУведомлениеПослеЗаписи",
		ВыводитьУведомление);

КонецПроцедуры

&НаСервере
Функция ФизическоеЛицоСотрудника(Сотрудник)
	
	Возврат ЗарплатаКадрыРасширенныйПовтИсп.ФизическоеЛицоСотрудника(Сотрудник);
	
КонецФункции

&НаСервере
Процедура СотрудникиОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	ВыбранныеСотрудники = ОбщегоНазначения.СкопироватьРекурсивно(ВыбранноеЗначение);
	ОбщегоНазначенияБЗККлиентСервер.УдалитьВсеВхожденияКромеТипаИзМассива(ВыбранныеСотрудники,
		Тип("СправочникСсылка.Сотрудники"));
	ФизическиеЛица = КадровыйУчет.ФизическиеЛицаСотрудников(ВыбранныеСотрудники);
	ДобавитьУчастниковКадровогоРезерва(ФизическиеЛица);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		ЛичныеДанныеКандидатов = МодульПодборПерсонала.СсылкиНаЛичныеДанныеКандидатов(ВыбранноеЗначение);
		ДобавитьУчастниковКадровогоРезерва(ЛичныеДанныеКандидатов);
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.Сотрудники Цикл
		УстановитьДоступностьКоманд(ЭтотОбъект, ТекущаяСтрока);
	КонецЦикла;
	ЗаполнитьОписанияДействия();
	ЗаполнитьДанныеУчастниковКадровогоРезерва();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУчастниковКадровогоРезерва(УчастникиКадровогоРезерва)
	
	Для каждого УчастникКадровогоРезерва Из УчастникиКадровогоРезерва Цикл
		НайденныеСтроки = Объект.Сотрудники.НайтиСтроки(Новый Структура("УчастникКадровогоРезерва",
			УчастникКадровогоРезерва));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Объект.Сотрудники.Добавить();
		НоваяСтрока.УчастникКадровогоРезерва = УчастникКадровогоРезерва;
		НоваяСтрока.Действие = ПредопределенноеЗначение("Перечисление.ДействияСКадровымиРезервистами.Утвердить");
		НоваяСтрока.ДатаОкончания = КонецМесяца(ДобавитьМесяц(Объект.ДатаРассмотрения, 60)) - 1;
		НоваяСтрока.Основание = Справочники.ОснованияКадровогоРезерва.ПустаяСсылка();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СотрудникиУчастникКадровогоРезерваОбработкаВыбораНаСервере(ВыбранноеЗначение, ТекущаяСтрока)
	
	ТекущиеДанные = Объект.Сотрудники.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		ТекущиеДанные.УчастникКадровогоРезерва = ФизическоеЛицоСотрудника(ВыбранноеЗначение);
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Кандидаты") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		ТекущиеДанные.УчастникКадровогоРезерва = МодульПодборПерсонала.ЛичныеДанныеКандидатов(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранноеЗначение)).Получить(ВыбранноеЗначение);
	Иначе
		ТекущиеДанные.УчастникКадровогоРезерва = ВыбранноеЗначение;
	КонецЕсли;
	
	ЗаполнитьДанныеУчастникаКадровогоРезерва(ТекущиеДанные.УчастникКадровогоРезерва);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьРезервистов(ВладелецФормыВыбора, МножественныйВыбор)
	
	ОтборИзПодразделения = ОтборИзПодразделения(Объект.Подразделение);
	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОтборИзПодразделения, "Организация");
	Подразделение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОтборИзПодразделения, "Подразделение");
	
	ПараметрыОткрытия = Неопределено;
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба") Тогда
		ПараметрыОткрытия = Новый Структура("ВключатьВедомственныхВоенных", Истина);
		Модуль = ОбщегоНазначенияКлиент.ОбщийМодуль("ГосударственнаяСлужбаКлиент");
		Модуль.УточнитьПараметрыОткрытияФормыВыбораСотрудников(ПараметрыОткрытия);
	КонецЕсли; 
		
	КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(
		ВладелецФормыВыбора, Организация, Подразделение, Объект.ДатаРассмотрения, МножественныйВыбор,
		АдресСпискаПодобранныхСотрудников(), ПараметрыОткрытия);
	
КонецПроцедуры

#КонецОбласти