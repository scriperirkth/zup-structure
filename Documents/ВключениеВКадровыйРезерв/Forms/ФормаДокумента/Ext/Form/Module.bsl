&НаКлиенте
Процедура Подключаемый_ПодобратьКандидатов(Команда)
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала") Тогда
		МодульПодборПерсоналаКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодборПерсоналаКлиент");
		Отбор = Новый Структура;
		Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
			Отбор.Вставить("Подразделение", Объект.Подразделение);
		КонецЕсли;
		МодульПодборПерсоналаКлиент.ПодобратьКандидатов(Элементы.Сотрудники, Отбор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьИПР(Команда)
	
	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УчастникКадровогоРезерва = ТекущиеДанные.УчастникКадровогоРезерва;
	Если Не ЗначениеЗаполнено(УчастникКадровогоРезерва)
		Или ТипЗнч(УчастникКадровогоРезерва) <> Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура());
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("Подразделение", Объект.Подразделение);
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("Владелец", УчастникКадровогоРезерва);
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("Основание", ТекущиеДанные.ПозицияРезерва);
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("Наставник", ТекущиеДанные.Наставник);
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("Куратор", ТекущиеДанные.Куратор);
	
	ОткрытьФорму("Справочник.ИндивидуальныйПланРазвития.ФормаОбъекта",
		ПараметрыФормы, ЭтотОбъект, УчастникКадровогоРезерва);
	
КонецПроцедуры

