	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		ТекущиеДанные.Куратор = ФизическоеЛицоСотрудника(ВыбранноеЗначение);
	Иначе
		ТекущиеДанные.Куратор = ВыбранноеЗначение;
	КонецЕсли;
	
