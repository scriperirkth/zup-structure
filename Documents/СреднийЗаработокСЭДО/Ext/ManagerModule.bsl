// Загружает ошибку логического контроля регистрации сведений о застрахованном лице.
Процедура ЗаполнитьПоСообщению(ЗаписьРегистра, ДанныеСообщения, РезультатБРО) Экспорт
	Если ЗначениеЗаполнено(ЗаписьРегистра.РегистрацияДокумент) Тогда
		ДокументОбъект = ЗаписьРегистра.РегистрацияДокумент.ПолучитьОбъект();
	Иначе
		ДокументОбъект = СоздатьДокумент();
	КонецЕсли;
	
	ДокументОбъект.ФиксацияИзменений.Очистить();
	ДокументОбъект.ДанныеОЗаработке.Очистить();
	ДокументОбъект.РасчетныйГод1          = 0;
	ДокументОбъект.РасчетныйГод2          = 0;
	ДокументОбъект.ДополнительныйГод1     = 0;
	ДокументОбъект.ДополнительныйГод2     = 0;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗаписьРегистра); // ГоловнаяОрганизация, Страхователь, ФизическоеЛицо.
	ДокументОбъект.ТипСообщения = ЗаписьРегистра.РегистрацияТипСообщения;
	ДокументОбъект.СНИЛС                  = ЗаписьРегистра.РегистрацияСНИЛС;
	ДокументОбъект.Дата                   = ЗаписьРегистра.РегистрацияДата;
	ДокументОбъект.ИдентификаторСообщения = ЗаписьРегистра.РегистрацияИдентификатор;
	ДокументОбъект.ЗапросСреднего         = ЗаписьРегистра.ИсходящийДокумент;
	
	ТекстыОшибок = Новый Массив;
	Если ЗначениеЗаполнено(ЗаписьРегистра.РегистрацияПротокол) Тогда
		ТекстыОшибок.Добавить(ЗаписьРегистра.РегистрацияПротокол);
	КонецЕсли;
	
	ДокументОбъект.ЕстьНеобработанныеУзлы = ЗначениеЗаполнено(ДанныеСообщения.НеобработанныеУзлы);
	Если ДокументОбъект.ЕстьНеобработанныеУзлы Тогда
		ТекстыОшибок.Добавить(НСтр("ru = 'Необработанные узлы:'") + Символы.ПС + ДанныеСообщения.НеобработанныеУзлы);
	КонецЕсли;
	
	НомерГода = 0;
	Для Каждого СтрокаДанных Из ДанныеСообщения.ДанныеОЗаработке Цикл
		СтрокаТаблицы = ДокументОбъект.ДанныеОЗаработке.Найти(СтрокаДанных.РасчетныйГод, "РасчетныйГод");
		Если СтрокаТаблицы = Неопределено Тогда
			СтрокаТаблицы = ДокументОбъект.ДанныеОЗаработке.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДанных);
			НомерГода = НомерГода + 1;
			Если НомерГода = 1 Тогда
				ДокументОбъект.РасчетныйГод1 = СтрокаДанных.РасчетныйГод;
			ИначеЕсли НомерГода = 2 Тогда
				ДокументОбъект.РасчетныйГод2 = СтрокаДанных.РасчетныйГод;
			ИначеЕсли НомерГода = 3 Тогда
				ДокументОбъект.ДополнительныйГод1 = СтрокаДанных.РасчетныйГод;
			ИначеЕсли НомерГода = 4 Тогда
				ДокументОбъект.ДополнительныйГод2 = СтрокаДанных.РасчетныйГод;
			КонецЕсли;
		ИначеЕсли СтрокаТаблицы.ЗаработокПоВсем <> СтрокаДанных.ЗаработокПоВсем
			Или СтрокаТаблицы.ЗаработокПоВсемГПХ <> СтрокаДанных.ЗаработокПоВсемГПХ
			Или СтрокаТаблицы.ЗаработокПоТекущему <> СтрокаДанных.ЗаработокПоТекущему
			Или СтрокаТаблицы.ЗаработокПоТекущемуГПХ <> СтрокаДанных.ЗаработокПоТекущемуГПХ Тогда
			
			ЗаголовокОшибкиБезСумм = СтрШаблон(
				НСтр("ru = 'В XML СФР обнаружено две строки по году %1 с различающимися суммами'"),
				Формат(СтрокаДанных.РасчетныйГод, "ЧГ="));
			ТекстОшибкиССуммами = НСтр("ru = '
				|Заработок по всем страхователям:        (строка 1) %1  (строка 2) %2
				|Заработок по всем страхователям ГПХ:    (строка 1) %3  (строка 2) %4
				|Заработок по текущему страхователю:     (строка 1) %5  (строка 2) %6
				|Заработок по текущему страхователю ГПХ: (строка 1) %7  (строка 2) %8'");
			ТекстОшибкиССуммами = СтрШаблон(
				ТекстОшибкиССуммами,
				Формат(СтрокаТаблицы.ЗаработокПоВсем, "ЧН=; ЧГ="),
				Формат(СтрокаДанных.ЗаработокПоВсем, "ЧН=; ЧГ="),
				Формат(СтрокаТаблицы.ЗаработокПоВсемГПХ, "ЧН=; ЧГ="),
				Формат(СтрокаДанных.ЗаработокПоВсемГПХ, "ЧН=; ЧГ="),
				Формат(СтрокаТаблицы.ЗаработокПоТекущему, "ЧН=; ЧГ="),
				Формат(СтрокаДанных.ЗаработокПоТекущему, "ЧН=; ЧГ="),
				Формат(СтрокаТаблицы.ЗаработокПоТекущемуГПХ, "ЧН=; ЧГ="),
				Формат(СтрокаДанных.ЗаработокПоТекущемуГПХ, "ЧН=; ЧГ="));
			ТекстыОшибок.Добавить(ЗаголовокОшибкиБезСумм + ТекстОшибкиССуммами);
			СЭДОФСС.ОшибкаОбработки(РезультатБРО, ЗаголовокОшибкиБезСумм);
			
			Если СтрокаТаблицы.ЗаработокПоВсем = 0
				И СтрокаТаблицы.ЗаработокПоВсемГПХ = 0
				И СтрокаТаблицы.ЗаработокПоТекущему = 0
				И СтрокаТаблицы.ЗаработокПоТекущемуГПХ = 0 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДанных);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДокументОбъект.ТекстОшибки = СтрСоединить(ТекстыОшибок, Символы.ПС + Символы.ПС);
	
	РежимЗаписи = ?(ДокументОбъект.ПометкаУдаления, РежимЗаписиДокумента.Запись, РежимЗаписиДокумента.Проведение);
	СЭДОФСС.ЗаписатьДокумент(ДокументОбъект, Истина, "БЗК", РежимЗаписи);
	
	ЗаписьРегистра.РегистрацияДокумент = ДокументОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти

#Область ФизическиеЛица

Процедура ПриИзмененииСНИЛСФизическогоЛица(ФизическоеЛицо, СтарыйСНИЛС, НовыйСНИЛС) Экспорт
	// В сообщениях 321 Фонд явно указывает СНИЛС, поэтому в них требуется актуализировать ссылки физлиц.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СреднийЗаработокСЭДО.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СреднийЗаработокСЭДО КАК СреднийЗаработокСЭДО
	|ГДЕ
	|	СреднийЗаработокСЭДО.СНИЛС = &НовыйСНИЛС
	|	И СреднийЗаработокСЭДО.ФизическоеЛицо <> &ФизическоеЛицо
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СреднийЗаработокСЭДО.Ссылка
	|ИЗ
	|	Документ.СреднийЗаработокСЭДО КАК СреднийЗаработокСЭДО
	|ГДЕ
	|	СреднийЗаработокСЭДО.ФизическоеЛицо = &ФизическоеЛицо
	|	И СреднийЗаработокСЭДО.СНИЛС <> &НовыйСНИЛС";
	Если ЗначениеЗаполнено(НовыйСНИЛС) Тогда
		Запрос.УстановитьПараметр("НовыйСНИЛС", НовыйСНИЛС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СреднийЗаработокСЭДО.СНИЛС = &НовыйСНИЛС", "ЛОЖЬ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СреднийЗаработокСЭДО.СНИЛС <> &НовыйСНИЛС", "ИСТИНА");
	КонецЕсли;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаВыборки Из Таблица Цикл
		Если Не ЗначениеЗаполнено(СтрокаВыборки.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		ДокументОбъект = СтрокаВыборки.Ссылка.ПолучитьОбъект();
		Если ДокументОбъект.СНИЛС = НовыйСНИЛС И ЗначениеЗаполнено(НовыйСНИЛС) Тогда
			ДокументОбъект.ФизическоеЛицо = ФизическоеЛицо;
		Иначе
			ДокументОбъект.ФизическоеЛицо = Неопределено;
		КонецЕсли;
		РежимЗаписи = ?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
		СЭДОФСС.ЗаписатьДокумент(ДокументОбъект, Истина, Истина, РежимЗаписи);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ФиксацияВторичныхДанныхВДокументах

Функция ФиксируемыеРеквизиты()
	ФиксируемыеРеквизиты = Новый Соответствие;
	
	МетаданныеДокумента = Метаданные.Документы.СреднийЗаработокСЭДО;
	
	Шаблон = ФиксацияВторичныхДанныхВДокументах.ОписаниеФиксируемогоРеквизита();
	Шаблон.ОснованиеЗаполнения = "ЭтотОбъект";
	Шаблон.ИмяГруппы           = "ЭтотОбъект";
	
	Для Каждого МетаданныеРеквизита Из МетаданныеДокумента.Реквизиты Цикл
		ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(
			ФиксируемыеРеквизиты,
			Шаблон,
			МетаданныеРеквизита.Имя);
	КонецЦикла;
	
	Шаблон = ФиксацияВторичныхДанныхВДокументах.ОписаниеФиксируемогоРеквизита();
	Шаблон.ОснованиеЗаполнения = "ЭтотОбъект";
	Шаблон.ИмяГруппы           = "ЭтотОбъект";
	Шаблон.Путь                = "ДанныеОЗаработке";
	Шаблон.РеквизитСтроки      = Истина;
	
	Для Каждого МетаданныеРеквизита Из МетаданныеДокумента.ТабличныеЧасти.ДанныеОЗаработке.Реквизиты Цикл
		Если МетаданныеРеквизита.Имя <> "ИдентификаторСтрокиФикс" Тогда
			ФиксацияВторичныхДанныхВДокументах.ДобавитьФиксируемыйРеквизит(
				ФиксируемыеРеквизиты,
				Шаблон,
				МетаданныеРеквизита.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(ФиксируемыеРеквизиты);
КонецФункции

Функция ФиксируемыеТЧ()
	Возврат Новый Структура("ДанныеОЗаработке", СтрРазделить("РасчетныйГод", ",", Ложь));
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
