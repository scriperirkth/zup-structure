&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСотрудников(Форма)

	Форма.Объект.Сотрудники.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВозможностьОчисткиТабличнойЧасти(ИзменяемыйРеквизит)

	Оповещение = Новый ОписаниеОповещения("РеквизитыПриИзмененииЗавершение", ЭтотОбъект);
	КлючевыеПоказателиЭффективностиКлиент.ПроверитьВозможностьОчисткиТабличнойЧасти(
		Объект,
		"Сотрудники",
		Тип("ДокументСсылка.ФактПоказателяЭффективностиСотрудников"),
		ИзменяемыйРеквизит,
		СохраненныеЗначенияРеквизитов,
		Оповещение);

КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#Область ЗагрузкаДанныхИзФайла

&НаКлиенте
Процедура ЗагрузитьСотрудниковИзФайлаЗавершение(АдресЗагруженныхДанных, ДополнительныеПараметры) Экспорт
	
	Если АдресЗагруженныхДанных = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЗагрузитьСотрудниковИзФайлаНаСервере(АдресЗагруженныхДанных);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСотрудниковИзФайлаНаСервере(АдресЗагруженныхДанных)
	
	ДобавленыСтроки = Ложь;
	
	ЗагруженныеДанные = ПолучитьИзВременногоХранилища(АдресЗагруженныхДанных);
	Для Каждого СтрокаДанных Из ЗагруженныеДанные Цикл 
		
		Если Не ЗначениеЗаполнено(СтрокаДанных.Сотрудник) Тогда 
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Объект.Сотрудники.Добавить(), СтрокаДанных);
		
		ДобавленыСтроки = Истина;
	КонецЦикла;
	
	Модифицированность = Модифицированность ИЛИ ДобавленыСтроки;
	
	Если Не ДобавленыСтроки Тогда
		Возврат;
	КонецЕсли;
	
	КлючевыеПоказателиЭффективностиФормы.ЗаполнитьТаблицуРабочихМестСотрудников(
		ТаблицаРабочихМест,
		Объект.Сотрудники.Выгрузить(),
		СтруктураРеквизитовДокумента());
	
	Для Каждого СтрокаСотрудники Из Объект.Сотрудники Цикл 
		Если ЗначениеЗаполнено(СтрокаСотрудники.Позиция) Тогда 
			Продолжить;
		КонецЕсли;
		УстановитьПозициюСотрудника(ЭтотОбъект, СтрокаСотрудники);
		ЗаполнитьОписаниеПериодаРаботыСотрудника(ЭтотОбъект, СтрокаСотрудники);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриПолученииДанныхНаСервере()

	ЗаполнитьВторичныеРеквизитыФормы();
	СохранитьЗначенияРеквизитов(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СохранитьЗначенияРеквизитов(Форма)
	
	НовыеЗначения = Новый Структура;
	НовыеЗначения.Вставить("Показатель", Форма.Объект.Показатель);
	НовыеЗначения.Вставить("Подразделение", Форма.Объект.Подразделение);
	
	Форма.СохраненныеЗначенияРеквизитов = Новый ФиксированнаяСтруктура(НовыеЗначения);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыФормы()
	
	КлючевыеПоказателиЭффективностиКлиентСервер.УстановитьПредставлениеПериодаПоДате(ЭтотОбъект);
	
	КлючевыеПоказателиЭффективностиФормы.ЗаполнитьТаблицуРабочихМестСотрудников(
		ТаблицаРабочихМест,
		Объект.Сотрудники.Выгрузить(),
		СтруктураРеквизитовДокумента());
	
	ЗаполнитьВторичныеРеквизитыТаблицыСотрудники();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыТаблицыСотрудники()

	Для каждого СтрокаСотрудники Из Объект.Сотрудники Цикл
		ЗаполнитьОписаниеПериодаРаботыСотрудника(ЭтотОбъект, СтрокаСотрудники);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОписаниеПериодаРаботыСотрудника(Форма, СтрокаСотрудника)

	МестаРаботыСотрудника = Форма.ТаблицаРабочихМест.НайтиСтроки(Новый Структура("Сотрудник", СтрокаСотрудника.Сотрудник));
	
	СтрокаСотрудника.КоличествоПериодовРаботы = МестаРаботыСотрудника.Количество();
	СтрокаСотрудника.ПозицииНетВТаблицеРабочихМест = Истина;
	
	Если МестаРаботыСотрудника.Количество() = 0 Тогда
		СтрокаПериода = НСтр("ru = '<нет периодов работы>'");
	Иначе
		МассивСтрок = Новый Массив;
		Для каждого МестоРаботы Из МестаРаботыСотрудника Цикл
			Если МестоРаботы.Позиция = СтрокаСотрудника.Позиция Тогда
				ТекстПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								"%1 - %2",
								Формат(МестоРаботы.ДатаНачала,"ДЛФ=D"),
								Формат(МестоРаботы.ДатаОкончания,"ДЛФ=D"));
				МассивСтрок.Добавить(ТекстПериода);
				
				СтрокаСотрудника.ПозицииНетВТаблицеРабочихМест = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаСотрудника.КоличествоПериодовРаботы > 1 Тогда
			СтрокаПериода = СтрСоединить(МассивСтрок, ", ");
		КонецЕсли;
		
	КонецЕсли;
	
	ОписаниеПериодаРаботы = Строка(СтрокаСотрудника.Позиция);
	Если ЗначениеЗаполнено(СтрокаПериода) Тогда
		ОписаниеПериодаРаботы = ОписаниеПериодаРаботы + " (" + СтрокаПериода + ")";
	КонецЕсли;
	
	СтрокаСотрудника.ОписаниеПериодаРаботы = ОписаниеПериодаРаботы;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСотрудниковПоОтветственномуНаСервере()

	ЗаполнитьСотрудников();
	
	ЗаполнитьВторичныеРеквизитыТаблицыСотрудники();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСотрудников()

	УдалитьВТ = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// Получаем список позиций, на которые назначен этот показатель.
	КоллекцияОтборов = КоллекцияОтборов(,Истина);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
		КоллекцияОтборов, "ОтветственныйЗаВводФакта", "=", Объект.Ответственный);
		
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Показатель КАК Показатель
	|ПОМЕСТИТЬ ВТФильтрИзмерений";
	
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("Показатель", Объект.Показатель);
	
	Запрос.Выполнить();
	УдалитьВТ.Добавить("ВТФильтрИзмерений");
	
	КлючевыеПоказателиЭффективности.СоздатьВТСотрудникиВводаЗначенийПоказателей(
		Запрос.МенеджерВременныхТаблиц,
		"ВТФильтрИзмерений",
		"Показатель",
		КоллекцияОтборов);
	УдалитьВТ.Добавить("ВТСотрудникиВводаЗначенийПоказателей");
	
	СтруктураДат = КлючевыеПоказателиЭффективностиКлиентСервер.ДатыПериодаГоризонта(Объект.Период, Объект.Горизонт);
	
	Запрос.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц; 
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&НачалоПериода КАК НачалоПериода,
	|	&ОкончаниеПериода КАК ОкончаниеПериода,
	|	Сотрудники.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ ВТСотрудники
	|ИЗ
	|	ВТСотрудникиВводаЗначенийПоказателей КАК Сотрудники";
	Запрос.УстановитьПараметр("НачалоПериода", СтруктураДат.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", СтруктураДат.ДатаОкончания);
	Запрос.Выполнить();
	
	ПараметрыПоВременнойТаблице = КадровыйУчет.ПараметрыДляЗапросВТРабочиеМестаСотрудниковПоВременнойТаблице(
		"ВТСотрудники", "Сотрудник", "НачалоПериода", "ОкончаниеПериода");
	ПараметрыПоВременнойТаблице.РаботникиПоДоговорамГПХ = Истина;
	ПараметрыПоВременнойТаблице.РаботникиПоТрудовымДоговорам = Истина; 
	
	Источник = ПодразделениеОрганизации(Объект.Подразделение);
		
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Организации") Тогда
		ПараметрыПоВременнойТаблице.Организация = Источник;
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		ПараметрыПоВременнойТаблице.Подразделение = Источник;
	КонецЕсли;

	УдалитьВТ.Добавить("ВТСотрудники");
	КадровыйУчет.СоздатьВТРабочиеМестаСотрудниковПоВременнойТаблице(Запрос.МенеджерВременныхТаблиц, Ложь,
		ПараметрыПоВременнойТаблице, "ВТРабочиеМестаПоСотрудникам");
	
	УдалитьВТ.Добавить("ВТРабочиеМестаПоСотрудникам");
	КоллекцияОтборов = КоллекцияОтборов( , , СтруктураДат.ДатаОкончания);
	КлючевыеПоказателиЭффективности.СоздатьВТПозицииВводаЗначенийПоказателей(
		Запрос.МенеджерВременныхТаблиц,
		"ВТФильтрИзмерений",
		"Показатель",
		КоллекцияОтборов);
		
	УдалитьВТ.Добавить("ВТПозицииВводаЗначенийПоказателей");
	
	КоллекцияОтборов = КоллекцияОтборов(Истина);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
		КоллекцияОтборов, "ОтветственныйЗаВводФакта", "=", Объект.Ответственный);

	КлючевыеПоказателиЭффективности.СоздатьВТПодразделенияВводаЗначенийПоказателей(
		Запрос.МенеджерВременныхТаблиц,
		"ВТФильтрИзмерений",
		"Показатель",
		КоллекцияОтборов);
		
	УдалитьВТ.Добавить("ВТПодразделенияВводаЗначенийПоказателей");
	
	ОрганизационнаяСтруктура.СоздатьВТПозицииПодразделений(Запрос.МенеджерВременныхТаблиц, "ВТПодразделенияВводаЗначенийПоказателей");
	УдалитьВТ.Добавить("ВТПозицииПодразделений");
	
	// Объединяем списки позиций.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПозицииВводаЗначенийПоказателей.Позиция КАК Позиция
	|ПОМЕСТИТЬ ВТПозицииОтбор
	|ИЗ
	|	ВТПозицииВводаЗначенийПоказателей КАК ПозицииВводаЗначенийПоказателей
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПозицииПодразделений.Позиция
	|ИЗ
	|	ВТПозицииПодразделений КАК ПозицииПодразделений";
	
	Запрос.Выполнить();
	УдалитьВТ.Добавить("ВТПозицииОтбор");
	
	// Получаем список сотрудников, когда-либо работавших на этих позициях в периоде.
	КлючевыеПоказателиЭффективности.СоздатьВТПериодыРаботыСотрудниковПоСпискуПозиций(Запрос.МенеджерВременныхТаблиц, "ВТПозицииОтбор", СтруктураРеквизитовДокумента());
	УдалитьВТ.Добавить("ВТПериодыРаботыСотрудников");
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПериодыРаботыСотрудников.Сотрудник КАК Сотрудник,
	|	ВТПериодыРаботыСотрудников.Позиция КАК Позиция,
	|	МИНИМУМ(ВТПериодыРаботыСотрудников.ДатаНачала) КАК ДатаНачала
	|ПОМЕСТИТЬ УказателиСотрудников
	|ИЗ
	|	ВТПериодыРаботыСотрудников КАК ВТПериодыРаботыСотрудников
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПериодыРаботыСотрудников.Сотрудник,
	|	ВТПериодыРаботыСотрудников.Позиция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПериодыРаботыСотрудников.Сотрудник КАК Сотрудник,
	|	ВТПериодыРаботыСотрудников.Позиция КАК Позиция
	|ИЗ
	|	ВТПериодыРаботыСотрудников КАК ВТПериодыРаботыСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УказателиСотрудников КАК УказателиСотрудников
	|		ПО ВТПериодыРаботыСотрудников.Сотрудник = УказателиСотрудников.Сотрудник
	|			И ВТПериодыРаботыСотрудников.Позиция = УказателиСотрудников.Позиция
	|			И ВТПериодыРаботыСотрудников.ДатаНачала = УказателиСотрудников.ДатаНачала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПериодыРаботыСотрудников.Сотрудник КАК Сотрудник,
	|	ВТПериодыРаботыСотрудников.Позиция КАК Позиция,
	|	ВТПериодыРаботыСотрудников.ДатаНачала КАК ДатаНачала,
	|	ВТПериодыРаботыСотрудников.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	ВТПериодыРаботыСотрудников КАК ВТПериодыРаботыСотрудников
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРабочиеМестаПоСотрудникам.Сотрудник КАК Сотрудник,
	|	ВТРабочиеМестаПоСотрудникам.Период КАК ДатаНачала,
	|	ВТРабочиеМестаПоСотрудникам.ДолжностьПоШтатномуРасписанию КАК Позиция,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОкончания
	|ИЗ
	|	ВТРабочиеМестаПоСотрудникам КАК ВТРабочиеМестаПоСотрудникам";
	
	УдалитьВТ.Добавить("УказателиСотрудников");
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Объект.Сотрудники.Загрузить(РезультатыЗапроса[РезультатыЗапроса.Количество() - 3].Выгрузить());
	ТаблицаРабочихМест.Загрузить(РезультатыЗапроса[РезультатыЗапроса.Количество() - 2].Выгрузить());
	
	РабочиеМеста = РезультатыЗапроса[РезультатыЗапроса.Количество() - 1].Выгрузить();

	Для Сч = 1 По РабочиеМеста.Количество() Цикл
		Если Сч < РабочиеМеста.Количество() И РабочиеМеста[Сч-1].Сотрудник = РабочиеМеста[Сч].Сотрудник Тогда
			РабочиеМеста[Сч-1].ДатаОкончания = РабочиеМеста[Сч].ДатаНачала - 86400;
		Иначе
			РабочиеМеста[Сч-1].ДатаОкончания = СтруктураДат.ДатаОкончания;
		КонецЕсли;
		НайденнаяСтрока = Объект.Сотрудники.НайтиСтроки(Новый Структура("Сотрудник,Позиция", РабочиеМеста[Сч-1].Сотрудник, РабочиеМеста[Сч-1].Позиция));
		Если НайденнаяСтрока.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаРабочихМест.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РабочиеМеста[Сч-1]);
			НоваяСтрока = Объект.Сотрудники.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РабочиеМеста[Сч-1]);
		КонецЕсли;
	КонецЦикла;
	
	ЗарплатаКадры.УничтожитьВТ(Запрос.МенеджерВременныхТаблиц, УдалитьВТ);
	
КонецПроцедуры

&НаСервере
Функция КоллекцияОтборов(ПоПодразделению = Ложь, ПоСотруднику = Ложь, ДатаПолученияДанных = '00010101')
	
	КоллекцияОтборов = Новый Массив;
	
	Если Не ПоСотруднику Тогда
		ПодчиненныеПодразделения = ОрганизационнаяСтруктура.ПодчиненныеПодразделения(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Подразделение));
		
		Если ПоПодразделению Тогда
			Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
				ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
				КоллекцияОтборов, "Подразделение", "В", ПодчиненныеПодразделения);
			КонецЕсли;
		Иначе
			ПозицииПодразделения = ОрганизационнаяСтруктура.ПозицииПодразделений(ПодчиненныеПодразделения,
				ДатаПолученияДанных).ВыгрузитьКолонку("Позиция");
			ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
			КоллекцияОтборов, "Позиция", "В", ПозицииПодразделения);
		КонецЕсли;
	Иначе
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
			КоллекцияОтборов, "Горизонт", "В", Объект.Горизонт);
	КонецЕсли;
	
	Возврат КоллекцияОтборов;
	
КонецФункции

&НаСервере
Функция СтруктураРеквизитовДокумента()
	
	СтруктураРеквизитов = Новый Структура;
	
	СтруктураРеквизитов.Вставить("Период", Объект.Период);
	СтруктураРеквизитов.Вставить("Горизонт", Объект.Горизонт);
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаСервере
Процедура ДополнитьТаблицуРабочихМестСотрудниковНаСервере(Сотрудник)

	КлючевыеПоказателиЭффективностиФормы.ДополнитьТаблицуРабочихМестСотрудников(
		ТаблицаРабочихМест,
		Сотрудник,
		СтруктураРеквизитовДокумента());

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПозициюСотрудника(Форма, ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокиСотрудника = Форма.ТаблицаРабочихМест.НайтиСтроки(Новый Структура("Сотрудник", ТекущиеДанные.Сотрудник));
	Если СтрокиСотрудника.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Позиция = СтрокиСотрудника[0].Позиция;

КонецПроцедуры

&НаСервере
Функция СотрудникиПоПоказателю()
	
	МассивПозиций = КлючевыеПоказателиЭффективности.ТаблицаПозицийПоПоказателю(Объект.Период, Объект.Показатель).ВыгрузитьКолонку("Позиция");
	СтруктураДат = КлючевыеПоказателиЭффективностиКлиентСервер.ДатыПериодаГоризонта(Объект.Период, Объект.Горизонт);
	
	ПараметрыПолученияСотрудников = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолученияСотрудников.НачалоПериода = СтруктураДат.ДатаНачала;
	ПараметрыПолученияСотрудников.ОкончаниеПериода = СтруктураДат.ДатаОкончания;
		
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
		ПараметрыПолученияСотрудников.Отборы, "ДолжностьПоШтатномуРасписанию", "В", МассивПозиций);
		
	Источник = ПодразделениеОрганизации(Объект.Подразделение);
		
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Организации") Тогда
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
			ПараметрыПолученияСотрудников.Отборы, "Организация", "=", Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
			ПараметрыПолученияСотрудников.Отборы, "Подразделение", "В ИЕРАРХИИ", Источник);
	КонецЕсли;
	
	МассивСотрудниковПоПозициям = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыПолученияСотрудников).ВыгрузитьКолонку("Сотрудник");
	
	КоллекцияОтборов = КоллекцияОтборов(,Истина);
	ТаблицаСотрудников = КлючевыеПоказателиЭффективности.ТаблицаСотрудниковПоПоказателю(
		Объект.Период, Объект.Показатель, Источник,КоллекцияОтборов);
	МассивСотрудников = ТаблицаСотрудников.ВыгрузитьКолонку("Сотрудник");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСотрудников, МассивСотрудниковПоПозициям);
	МассивСотрудников = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСотрудников);
	
	Возврат МассивСотрудников;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодразделениеОрганизации(Подразделение)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "Источник");
	
КонецФункции

#КонецОбласти
