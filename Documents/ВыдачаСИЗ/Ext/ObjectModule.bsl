#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	ЗаполнитьНаОснованииЗаказаНаВыдачуСИЗ(ДанныеЗаполнения, СтандартнаяОбработка);
	ЗаполнитьПоОписаниюДляЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Организация);
	
	ИдентификаторыСтрокРабочихМест = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из РабочиеМеста Цикл
		ИдентификаторыСтрокРабочихМест.Вставить(СтрокаТаблицы.ИдентификаторСтрокиРабочегоМеста, СтрокаТаблицы);
	КонецЦикла;
	ЗаполнитьВыдачиСИЗПоНоменклатуре(ГоловнаяОрганизация, ИдентификаторыСтрокРабочихМест);
	ЗаполнитьСформированныеЗаказыНаВыдачуСИЗ(ГоловнаяОрганизация, ИдентификаторыСтрокРабочихМест);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
		
	Для Индекс = 0 По РабочиеМеста.Количество()-1 Цикл
		СтрокаРабочееМесто = РабочиеМеста.Получить(Индекс);
		СтрокиНоменклатурыРабочегоМеста = НоменклатураСИЗ.НайтиСтроки(
			Новый Структура("ИдентификаторСтрокиРабочегоМеста", СтрокаРабочееМесто.ИдентификаторСтрокиРабочегоМеста));
		
		Для Каждого СтрокаНоменклатураСИЗ Из СтрокиНоменклатурыРабочегоМеста Цикл
			Если Не ЗначениеЗаполнено(СтрокаНоменклатураСИЗ.Номенклатура)
				И СтрокаНоменклатураСИЗ.РезультатВыдачи <> Перечисления.РезультатыВыдачиСИЗ.СрокНоскиПродлен Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Сотруднику ""%1"" не установлена номенклатура для выдачи по СИЗ ""%2""'"),
					СтрокаРабочееМесто.ФизическоеЛицо, СтрокаНоменклатураСИЗ.СИЗ);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					"РабочиеМеста", СтрокаРабочееМесто.НомерСтроки, "ФизическоеЛицо");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, Поле, "Объект", Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьВыдачиСИЗПоНоменклатуре(ГоловнаяОрганизация, ИдентификаторыСтрокРабочихМест)
	
	Для Каждого СтрокаТаблицы Из НоменклатураСИЗ Цикл
		Если СтрокаТаблицы.ДействиеСРанееВыданнымСИЗ = Перечисления.ДействияСИстекающимиСИЗ.ПродлитьСрокНоски Тогда
			Продолжить;
		КонецЕсли;
		ЗаписьНабора = Движения.ВыданныеСИЗ.Добавить();
		ЗаписьНабора.ВидДвижения = ВидДвиженияНакопления.Приход;
		ЗаписьНабора.Период = Дата;
		СтрокаРабочееМесто = ИдентификаторыСтрокРабочихМест.Получить(СтрокаТаблицы.ИдентификаторСтрокиРабочегоМеста);
		ЗаписьНабора.ФизическоеЛицо = СтрокаРабочееМесто.ФизическоеЛицо;
		ЗаписьНабора.ГоловнаяОрганизация = ГоловнаяОрганизация;
		ЗаписьНабора.СИЗ = СтрокаТаблицы.СИЗ;
		ЗаписьНабора.Номенклатура = СтрокаТаблицы.Номенклатура;
		ЗаписьНабора.ХарактеристикаНоменклатуры = СтрокаТаблицы.ХарактеристикаНоменклатуры;
		ЗаписьНабора.ЕдиницаИзмерения = СтрокаТаблицы.ЕдиницаИзмерения;
		ЗаписьНабора.ДокументВыдачи = Ссылка;
		ЗаписьНабора.ОснованиеВыдачи = СтрокаТаблицы.ОснованиеВыдачи;
		ЗаписьНабора.Количество = СтрокаТаблицы.Количество;
		ЗаписьНабора.Дежурное = СтрокаТаблицы.Дежурное;
		Движения.ВыданныеСИЗ.Записывать = Истина;
		
		ЗаписьНабора = Движения.ВыдачиСИЗПоНоменклатуре.Добавить();
		ЗаписьНабора.Период = Дата;
		СтрокаРабочееМесто = ИдентификаторыСтрокРабочихМест.Получить(СтрокаТаблицы.ИдентификаторСтрокиРабочегоМеста);
		ЗаписьНабора.ФизическоеЛицо = СтрокаРабочееМесто.ФизическоеЛицо;
		ЗаписьНабора.РабочееМесто = СтрокаРабочееМесто.РабочееМесто;
		ЗаписьНабора.ГоловнаяОрганизация = ГоловнаяОрганизация;
		ЗаписьНабора.СИЗ = СтрокаТаблицы.СИЗ;
		ЗаписьНабора.Номенклатура = СтрокаТаблицы.Номенклатура;
		ЗаписьНабора.ХарактеристикаНоменклатуры = СтрокаТаблицы.ХарактеристикаНоменклатуры;
		ЗаписьНабора.РезультатВыдачи = СтрокаТаблицы.РезультатВыдачи;
		ЗаписьНабора.ОснованиеВыдачи = СтрокаТаблицы.ОснованиеВыдачи;
		ЗаписьНабора.ДокументВыдачи = Ссылка;
		ОписаниеПериодичности = СредстваИндивидуальнойЗащиты.ОписаниеПериодичностиВыдачи();
		ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, СтрокаТаблицы);
		ОписаниеПериодичности.Кратность = СтрокаТаблицы.КратностьВыдачи;
		ОписаниеПериодичности.Периодичность = СтрокаТаблицы.ПериодичностьВыдачи;
		ОписаниеПериодичности.ЕдиницаПериодичности = СтрокаТаблицы.ЕдиницаПериодичностиВыдачи;
		ЗаписьНабора.ДатаСледующейВыдачи = СредстваИндивидуальнойЗащиты.ДатаСледующейВыдачи(Дата, ОписаниеПериодичности);
		Движения.ВыдачиСИЗПоНоменклатуре.Записывать = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСформированныеЗаказыНаВыдачуСИЗ(ГоловнаяОрганизация, ИдентификаторыСтрокРабочихМест)
	
	Для Каждого СтрокаТаблицы Из НоменклатураСИЗ Цикл
		ЗаписьНабора = Движения.СформированныеЗаказыНаВыдачуСИЗ.Добавить();
		ЗаписьНабора.ВидДвижения = ВидДвиженияНакопления.Расход;
		ЗаписьНабора.Период = Дата;
		СтрокаРабочееМесто = ИдентификаторыСтрокРабочихМест.Получить(СтрокаТаблицы.ИдентификаторСтрокиРабочегоМеста);
		ЗаписьНабора.ФизическоеЛицо = СтрокаРабочееМесто.ФизическоеЛицо;
		ЗаписьНабора.РабочееМесто = СтрокаРабочееМесто.РабочееМесто;
		ЗаписьНабора.ГоловнаяОрганизация = ГоловнаяОрганизация;
		ЗаписьНабора.ЗаказНаВыдачуСИЗ = СтрокаТаблицы.ОснованиеВыдачи;
		ЗаполнитьЗначенияСвойств(ЗаписьНабора, СтрокаТаблицы);
		Движения.СформированныеЗаказыНаВыдачуСИЗ.Записывать = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииЗаказаНаВыдачуСИЗ(ЗаказСсылка, СтандартнаяОбработка)
	
	Если ТипЗнч(ЗаказСсылка) <> Тип("ДокументСсылка.ЗаказНаВыдачуСИЗ") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	Организация = ЗаказОбъект.Организация;
	Подразделение = ЗаказОбъект.Подразделение;
	
	ЗаполнитьЗначенияПоУмолчанию();
	ЗаполнитьСИЗТребующиеВыдачи(ЗаказОбъект.РабочиеМеста.Выгрузить(), "РабочееМесто", , Истина, ЗаказСсылка);
	
КонецПроцедуры

Процедура ЗаполнитьПоОписаниюДляЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	
	ЗаполнитьЗначенияПоУмолчанию();
	
	Если ДанныеЗаполнения.Свойство("ФизическиеЛицаРабочиеМеста") Тогда
		ЗаполнитьСИЗТребующиеВыдачи(ДанныеЗаполнения.ФизическиеЛицаРабочиеМеста, "РабочееМесто");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияПоУмолчанию()
	
	ЗначенияПоУмолчанию = Новый Структура("Ответственный");
	ЗарплатаКадры.ПолучитьЗначенияПоУмолчанию(ЗначенияПоУмолчанию);
	Ответственный = ЗначенияПоУмолчанию.Ответственный;
	
КонецПроцедуры

Процедура ЗаполнитьСИЗ(ИдентификаторыСИЗ) Экспорт
	
	НоменклатураСИЗ.Очистить();
	
	Для Каждого СтрокаРабочегоМеста Из РабочиеМеста Цикл
		МассивСИЗ = ИдентификаторыСИЗ.Получить(СтрокаРабочегоМеста.ИдентификаторСтрокиРабочегоМеста);
		Если МассивСИЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ДанныеСИЗ Из МассивСИЗ Цикл
			НоваяСтрока = НоменклатураСИЗ.Добавить();
			НоваяСтрока.ИдентификаторСтрокиРабочегоМеста = СтрокаРабочегоМеста.ИдентификаторСтрокиРабочегоМеста;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСИЗ);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСИЗТребующиеВыдачи(ФизическиеЛицаРабочиеМеста, ИмяРабочегоМеста, Сч = 1, ДобавлятьБезСИЗ = Ложь, ЗаказОснование = Неопределено) Экспорт
	
	ОтмеченныеСИЗ = Неопределено;
	ТаблицаФизическиеЛицаРабочиеМеста = СредстваИндивидуальнойЗащиты.ТаблицаФизическиеЛицаРабочиеМеста(
		ФизическиеЛицаРабочиеМеста, ИмяРабочегоМеста, ОтмеченныеСИЗ);
	
	Если ТаблицаФизическиеЛицаРабочиеМеста.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ФизическиеЛицаСотрудников = ТаблицаФизическиеЛицаРабочиеМеста.ВыгрузитьКолонку("ФизическоеЛицо");
	АнтропометрияФизическихЛиц = СредстваИндивидуальнойЗащиты.АнтропометрияФизическихЛиц(ФизическиеЛицаСотрудников);
	ДатаАктуальности = ?(ЗначениеЗаполнено(Дата), КонецДня(Дата), КонецДня(ТекущаяДатаСеанса()));
	
	СИЗТребующиеВыдачи = СИЗТребующиеВыдачи(ТаблицаФизическиеЛицаРабочиеМеста, ДатаАктуальности, ЗаказОснование, ОтмеченныеСИЗ);
	ТипыНоменклатурыСИЗ = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(
		СИЗТребующиеВыдачи.ВыгрузитьКолонку("СИЗ"), "ТипНоменклатуры");
	РабочиеМестаСотрудников = ТаблицаФизическиеЛицаРабочиеМеста.ВыгрузитьКолонку("РабочееМесто");
	РеквизитыРабочихМест = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(РабочиеМестаСотрудников, "Подразделение,Должность");
	Для Каждого ДанныеСИЗ Из ТаблицаФизическиеЛицаРабочиеМеста Цикл
		СИЗРабочихМест = СИЗТребующиеВыдачи.НайтиСтроки(
			Новый Структура("РабочееМесто, ФизическоеЛицо", ДанныеСИЗ.РабочееМесто, ДанныеСИЗ.ФизическоеЛицо));
		КоличествоСИЗ = СИЗРабочихМест.Количество();
		Если КоличествоСИЗ = 0 И Не ДобавлятьБезСИЗ Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = РабочиеМеста.Добавить();
		НоваяСтрока.ИдентификаторСтрокиРабочегоМеста = Сч;
		Сч = Сч + 1;
		НоваяСтрока.ФизическоеЛицо = ДанныеСИЗ.ФизическоеЛицо;
		НоваяСтрока.РабочееМесто = ДанныеСИЗ.РабочееМесто;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыРабочихМест.Получить(НоваяСтрока.РабочееМесто));
		Если КоличествоСИЗ = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПоследниеВыдачиСИЗ = СредстваИндивидуальнойЗащиты.ПоследниеВыдачиСИЗПоНоменклатуре(
			НоваяСтрока.ФизическоеЛицо, Организация, ДатаАктуальности);
		Для Каждого НайденныйСИЗ Из СИЗРабочихМест Цикл
			НоваяСтрокаСИЗ = НоменклатураСИЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСИЗ, НайденныйСИЗ);
			НоваяСтрокаСИЗ.РезультатВыдачи = Перечисления.РезультатыВыдачиСИЗ.НеВыдано;
			АнтропометрияСотрудника = АнтропометрияФизическихЛиц.Получить(НоваяСтрока.ФизическоеЛицо);
			Если АнтропометрияСотрудника <> Неопределено Тогда
				НоваяСтрокаСИЗ.Размер = СредстваИндивидуальнойЗащиты.РазмерСотрудника(
					ТипыНоменклатурыСИЗ.Получить(НоваяСтрокаСИЗ.СИЗ), АнтропометрияСотрудника);
			КонецЕсли;
			Если ПоследниеВыдачиСИЗ <> Неопределено Тогда
				ПоследняяВыдачаСИЗ = ПоследниеВыдачиСИЗ.Получить(НоваяСтрокаСИЗ.СИЗ);
				Если ПоследняяВыдачаСИЗ <> Неопределено Тогда
					НоваяСтрокаСИЗ.ПоследняяВыдача = ПоследняяВыдачаСИЗ.Период;
				КонецЕсли;
			КонецЕсли;
			НоваяСтрокаСИЗ.ИдентификаторСтрокиРабочегоМеста = НоваяСтрока.ИдентификаторСтрокиРабочегоМеста;
		КонецЦикла;
	КонецЦикла;
	
	СредстваИндивидуальнойЗащиты.ПодобратьПодходящуюНоменклатуру(НоменклатураСИЗ);
	
КонецПроцедуры

Функция СИЗТребующиеВыдачи(ТаблицаФизическиеЛицаРабочиеМеста, ДатаАктуальности, ЗаказОснование, ОтмеченныеСИЗ = Неопределено)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗарплатаКадры.СоздатьВТПоТаблицеЗначений(МенеджерВременныхТаблиц, ТаблицаФизическиеЛицаРабочиеМеста, "ВТФизическиеЛицаРабочиеМеста");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	Запрос.УстановитьПараметр("ЕстьОтмеченныеСИЗ", ЗначениеЗаполнено(ОтмеченныеСИЗ));
	Запрос.УстановитьПараметр("ОтмеченныеСИЗ", ОтмеченныеСИЗ);
	Запрос.УстановитьПараметр("ЕстьЗаказОснование", ЗначениеЗаполнено(ЗаказОснование));
	Запрос.УстановитьПараметр("ЗаказОснование", ЗаказОснование);
	Запрос.УстановитьПараметр("ТекущийРегистратор", Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СформированныеЗаказы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СформированныеЗаказы.РабочееМесто КАК РабочееМесто,
		|	СформированныеЗаказы.ЗаказНаВыдачуСИЗ КАК ОснованиеВыдачи,
		|	СформированныеЗаказы.СИЗ КАК СИЗ,
		|	СформированныеЗаказы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СформированныеЗаказы.СпособВыдачи КАК СпособВыдачи,
		|	СформированныеЗаказы.Дежурное КАК Дежурное,
		|	СформированныеЗаказы.КратностьВыдачи КАК КратностьВыдачи,
		|	СформированныеЗаказы.ПериодичностьВыдачи КАК ПериодичностьВыдачи,
		|	СформированныеЗаказы.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичностиВыдачи,
