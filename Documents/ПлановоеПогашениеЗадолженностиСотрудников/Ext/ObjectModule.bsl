#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	Для Каждого Задолженность Из Задолженности Цикл
		
		УсловияВозвратаЗадолженности = Движения.УсловияВозвратаЗадолженности.Добавить();
		ЗаполнитьЗначенияСвойств(УсловияВозвратаЗадолженности, Задолженность);
		УсловияВозвратаЗадолженности.Период = ПериодРегистрации;
		
	КонецЦикла;
	
	Движения.УсловияВозвратаЗадолженности.Записывать = Истина;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	СотрудникиПериоды = Задолженности.Выгрузить(, "НомерСтроки, Сотрудник, ДокументОснование");
	СотрудникиПериоды.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));		
	СотрудникиПериоды.ЗаполнитьЗначения(ПериодРегистрации, "Период");
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("СотрудникиПериоды", СотрудникиПериоды);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СотрудникиПериоды.НомерСтроки КАК НомерСтроки,
		|	СотрудникиПериоды.Период КАК Период,
		|	СотрудникиПериоды.Сотрудник КАК Сотрудник,
		|	СотрудникиПериоды.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ ВТСотрудникиПериоды
		|ИЗ
		|	&СотрудникиПериоды КАК СотрудникиПериоды
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСотрудникиПериоды.НомерСтроки КАК НомерСтроки,
		|	ВТСотрудникиПериоды.Период КАК Период,
		|	ПРЕДСТАВЛЕНИЕ(ВТСотрудникиПериоды.Сотрудник) КАК СотрудникПредставление,
		|	ПРЕДСТАВЛЕНИЕ(ВТСотрудникиПериоды.ДокументОснование) КАК ДокументОснованиеПредставление,
		|	ПРЕДСТАВЛЕНИЕ(УсловияВозвратаЗадолженности.Регистратор) КАК РегистраторПредставление
		|ИЗ
		|	ВТСотрудникиПериоды КАК ВТСотрудникиПериоды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияВозвратаЗадолженности КАК УсловияВозвратаЗадолженности
		|		ПО ВТСотрудникиПериоды.Период = УсловияВозвратаЗадолженности.Период
		|			И ВТСотрудникиПериоды.Сотрудник = УсловияВозвратаЗадолженности.Сотрудник
		|			И ВТСотрудникиПериоды.ДокументОснование = УсловияВозвратаЗадолженности.ДокументОснование
		|			И (УсловияВозвратаЗадолженности.Регистратор <> &Регистратор)";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			                                                                 
			ТекстСообщения = НСтр("ru='Сотруднику %1 по документу-основанию ""%2"" в текущем периоде уже назначено плановое погашение документом %3.'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Выборка.СотрудникПредставление, Выборка.ДокументОснованиеПредставление, Выборка.РегистраторПредставление);
			
			ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			Ссылка,
			"Сотрудники[" + Формат(Выборка.НомерСтроки - 1, "ЧГ=") + "].Сотрудник",
			"Объект",
			Отказ);
			
		КонецЦикла;
		
	КонецЕсли;
	                                                                                                              
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Автозаполнение() Экспорт

	ПравилаПроверки = Новый Структура;
	ПравилаПроверки.Вставить("ПериодРегистрации",	НСтр("ru='Не указан период регистрации'"));
	ПравилаПроверки.Вставить("Организация",			НСтр("ru='Не выбрана организация'"));

	Если ЗарплатаКадры.СвойстваЗаполнены(ЭтотОбъект, ПравилаПроверки) Тогда
		
		ЗадолженностиСотрудников = Документы.ПлановоеПогашениеЗадолженностиСотрудников.ЗадолженностиСотрудников(ЭтотОбъект.Ссылка, Организация, КонецМесяца(ПериодРегистрации));
		Задолженности.Загрузить(ЗадолженностиСотрудников);
		
		Если Задолженности.Количество() = 0 Тогда
			
			ТекстСообщения = НСтр("ru = 'Не найдены сотрудники с задолженностью.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект);	
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов   объекта на клиенте.'");
#КонецЕсли