// Возвращает описание состава документа
//
// Возвращаемое значение:
//  Структура - см. ЗарплатаКадрыСоставДокументов.НовоеОписаниеСоставаОбъекта.
Функция ОписаниеСоставаОбъекта() Экспорт
	
	МетаданныеДокумента = Метаданные.Документы.ДисциплинарноеВзыскание;
	Возврат ЗарплатаКадрыСоставДокументов.ОписаниеСоставаОбъектаПоМетаданнымФизическиеЛицаВТабличныхЧастях(МетаданныеДокумента);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДанныеДляПроведения(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДисциплинарноеВзыскание.ДатаНачала КАК Период,
		|	ДисциплинарноеВзыскание.ДатаНачала КАК ДатаНачала,
		|	ДисциплинарноеВзыскание.Сотрудник КАК Сотрудник,
		|	ДисциплинарноеВзыскание.Взыскание КАК Взыскание,
		|	ДисциплинарноеВзыскание.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДокументДисциплинарноеВзыскание.Организация КАК Организация,
		|	ДисциплинарноеВзыскание.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Документ.ДисциплинарноеВзыскание.Сотрудники КАК ДисциплинарноеВзыскание
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ДисциплинарноеВзыскание КАК ДокументДисциплинарноеВзыскание
		|		ПО ДисциплинарноеВзыскание.Ссылка = ДокументДисциплинарноеВзыскание.Ссылка
		|ГДЕ
		|	ДисциплинарноеВзыскание.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ДвиженияДисциплинарногоВзыскания = РезультатЗапроса.Выгрузить();
	
	ДанныеДляПроведения = Новый Структура;
	ДанныеДляПроведения.Вставить("ДвиженияДисциплинарногоВзыскания", ДвиженияДисциплинарногоВзыскания);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.Наставничество") Тогда
		МодульНаставничество = ОбщегоНазначения.ОбщийМодуль("Наставничество");
		МодульНаставничество.ДополнитьДанныеДляПроведенияДисциплинарногоВзыскания(Ссылка, ДанныеДляПроведения);
	КонецЕсли;
	
	Возврат ДанныеДляПроведения;
	
КонецФункции

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.МенеджерПечати = "Документ.ДисциплинарноеВзыскание";
	КомандаПечати.Идентификатор = Метаданные.Документы.ДисциплинарноеВзыскание.Макеты.ПФ_MXL_ДисциплинарныеВзыскания.Имя;
	КомандаПечати.Представление = Метаданные.Документы.ДисциплинарноеВзыскание.Макеты.ПФ_MXL_ДисциплинарныеВзыскания.Представление();
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.МенеджерПечати = "Документ.ДисциплинарноеВзыскание";
	КомандаПечати.Идентификатор = Метаданные.Документы.ДисциплинарноеВзыскание.Макеты.ПФ_MXL_ДисциплинарноеВзыскание.Имя;
	КомандаПечати.ДополнительныеПараметры.Вставить("ПечатьВсехПриказов", Истина);
	КомандаПечати.Представление = НСтр("ru = 'Приказы на каждого сотрудника в отдельности'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.Наставничество") Тогда
		МодульНаставничество = ОбщегоНазначения.ОбщийМодуль("Наставничество");
		МодульНаставничество.ДобавитьКомандыПечатиПоОтменеНаставничества(КомандыПечати);
	КонецЕсли;
	
КонецПроцедуры

// Формирует печатные формы
//
// Параметры:
//  Для чтения:
//    МассивОбъектов  - Массив    - Ссылки на объекты, которые нужно распечатать;
//    ПараметрыПечати - Структура - Настройки печати;
//  Для изменения:
//    КоллекцияПечатныхФорм - ТаблицаЗначений - Табличные документы.
//    ОбъектыПечати         - СписокЗначений  - Разбивка областей табличного документа по напечатанным объектам.
//        * Значение            - Ссылка объекта;
//        * Представление       - Имя области в которой был выведен объект;
//    ПараметрыВывода       - Структура       - Параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	УправлениеПечатьюБЗК.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, Документы.ДисциплинарноеВзыскание);
	
КонецПроцедуры

// Формирует печатную форму. Вызывается из УправлениеПечатьюБЗК.Печать.
//
// Параметры:
//   КонтекстПечати - Структура - См. УправлениеПечатьюБЗК.КонтекстПечати.
//
Процедура ПриФормированииПечатнойФормы(КонтекстПечати) Экспорт
	
	Если КонтекстПечати.МетаданныеМакета = Метаданные.Документы.ДисциплинарноеВзыскание.Макеты.ПФ_MXL_ДисциплинарныеВзыскания Тогда
		ПриПечатиДисциплинарныхВзысканий(КонтекстПечати);
	ИначеЕсли КонтекстПечати.МетаданныеМакета = Метаданные.Документы.ДисциплинарноеВзыскание.Макеты.ПФ_MXL_ДисциплинарноеВзыскание Тогда
		ПриПечатиДисциплинарногоВзыскания(КонтекстПечати);
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляПечатиДисциплинарныхВзысканий(МассивСсылок)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДокументДисциплинарноеВзыскание.Ссылка КАК Ссылка,
		|	ДокументДисциплинарноеВзыскание.Номер КАК НомерДок,
		|	ДокументДисциплинарноеВзыскание.Дата,
		|	ДокументДисциплинарноеВзыскание.Дата КАК Период,
		|	ДокументДисциплинарноеВзыскание.Дата КАК ДатаДок,
		|	ДокументДисциплинарноеВзыскание.Организация КАК Организация,
		|	ДокументДисциплинарноеВзыскание.Руководитель КАК Руководитель,
		|	ДокументДисциплинарноеВзыскание.ДолжностьРуководителя КАК ДолжностьРуководителя,
		|	ДокументДисциплинарноеВзыскание.РаботникКадровойСлужбы КАК РаботникКадровойСлужбы,
		|	ДокументДисциплинарноеВзыскание.ДолжностьРаботникаКадровойСлужбы КАК ДолжностьРаботникаКадровойСлужбы,
		|	ДисциплинарноеВзыскание.Сотрудник КАК Сотрудник,
		|	ДисциплинарноеВзыскание.Взыскание КАК Взыскание
		|ПОМЕСТИТЬ ВТДанныеДокументов
		|ИЗ
		|	Документ.ДисциплинарноеВзыскание.Сотрудники КАК ДисциплинарноеВзыскание
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ДисциплинарноеВзыскание КАК ДокументДисциплинарноеВзыскание
		|		ПО ДисциплинарноеВзыскание.Ссылка = ДокументДисциплинарноеВзыскание.Ссылка
		|ГДЕ
		|	ДисциплинарноеВзыскание.Ссылка В(&МассивСсылок)";
	
	Запрос.Выполнить();
	
	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(Запрос.МенеджерВременныхТаблиц, "ВТДанныеДокументов");
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВременныхТаблиц, Истина, "ФИОПолные,Должность");
	
	ЗарплатаКадры.СоздатьВТФИООтветственныхЛиц(Запрос.МенеджерВременныхТаблиц, Истина, "Руководитель,РаботникКадровойСлужбы", "ВТДанныеДокументов");
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеДокументов.Ссылка КАК Ссылка,
		|	ДанныеДокументов.НомерДок КАК НомерДок,
		|	ДанныеДокументов.ДатаДок КАК ДатаДок,
		|	СправочникОрганизации.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	СправочникОрганизации.НаименованиеСокращенное КАК ОрганизацияНаименованиеСокращенное,
		|	СправочникВзыскания.Наименование КАК НаименованиеВзыскания,
		|	КадровыеДанныеСотрудников.ФИОПолные КАК ФИОРаботника,
		|	СправочникДолжности.Наименование КАК ДолжностьРаботника,
		|	ПРЕДСТАВЛЕНИЕ(СправочникВзыскания.ВидВзыскания) КАК ВидВзыскания,
		|	ДанныеДокументов.Руководитель КАК Руководитель,
		|	ДанныеДокументов.ДолжностьРуководителя КАК ДолжностьРуководителя,
		|	ФИОРуководителя.РасшифровкаПодписи КАК РуководительРасшифровкаПодписи,
		|	ФИОИсполнителя.ФИОПолные КАК ФИОИсполнителя,
		|	ДанныеДокументов.РаботникКадровойСлужбы КАК РаботникКадровойСлужбы,
		|	ДанныеДокументов.ДолжностьРаботникаКадровойСлужбы КАК ДолжностьИсполнителя,
		|	ВЫРАЗИТЬ(ДанныеДокументов.РаботникКадровойСлужбы КАК Справочник.ФизическиеЛица).Пол КАК ПолИсполнителя
		|ИЗ
		|	ВТДанныеДокументов КАК ДанныеДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Должности КАК СправочникДолжности
		|			ПО КадровыеДанныеСотрудников.Должность = СправочникДолжности.Ссылка
		|		ПО ДанныеДокументов.Сотрудник = КадровыеДанныеСотрудников.Сотрудник
		|			И ДанныеДокументов.Период = КадровыеДанныеСотрудников.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТФИООтветственныхЛиц КАК ФИОРуководителя
		|		ПО ДанныеДокументов.Ссылка = ФИОРуководителя.Ссылка
		|			И ДанныеДокументов.Руководитель = ФИОРуководителя.ФизическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТФИООтветственныхЛиц КАК ФИОИсполнителя
		|		ПО ДанныеДокументов.Ссылка = ФИОИсполнителя.Ссылка
		|			И ДанныеДокументов.РаботникКадровойСлужбы = ФИОИсполнителя.ФизическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК СправочникОрганизации
		|		ПО ДанныеДокументов.Организация = СправочникОрганизации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Взыскания КАК СправочникВзыскания
		|		ПО ДанныеДокументов.Взыскание = СправочникВзыскания.Ссылка";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ПриПечатиДисциплинарныхВзысканий(КонтекстПечати)
	
	ТабличныйДокумент = КонтекстПечати.ТабличныйДокумент;
	МассивОбъектов    = КонтекстПечати.МассивОбъектов;
	ОбъектыПечати     = КонтекстПечати.ОбъектыПечати;
	
	ДанныеДляПечати = ДанныеДляПечатиДисциплинарныхВзысканий(МассивОбъектов);
	Пока ДанныеДляПечати.СледующийПоЗначениюПоля("Ссылка") Цикл
		
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НачалоФормы = ТабличныйДокумент.ВысотаТаблицы - 1;
		НомерПункта = 1;
		
		ВывестиШапкуДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати);
		
		Пока ДанныеДляПечати.Следующий() Цикл
			
			ВывестиПунктДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати, НомерПункта);
			
			НомерПункта = НомерПункта + 1;
			
		КонецЦикла;
		
		ВывестиПодвалДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати, НомерПункта);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НачалоФормы, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВывестиШапкуДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати)
	
	НастройкиПечатныхФорм = ЗарплатаКадры.НастройкиПечатныхФорм();
	
	ТабличныйДокумент       = КонтекстПечати.ТабличныйДокумент;
	Макет                   = КонтекстПечати.Макет;
	ИменаПараметровОбластей = КонтекстПечати.ИменаПараметровОбластей;
	
	ПараметрыШапки = Новый Структура(ИменаПараметровОбластей.Шапка);
	ЗаполнитьЗначенияСвойств(ПараметрыШапки, ДанныеДляПечати);
	
	Если НастройкиПечатныхФорм.УдалятьПрефиксыОрганизацииИИБИзНомеровКадровыхПриказов Тогда
		ПараметрыШапки.НомерДок = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ПараметрыШапки.НомерДок, Истина, Истина);
	КонецЕсли;
	
	ПараметрыШапки.ДатаДок = Формат(ПараметрыШапки.ДатаДок, "ДЛФ=DD");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
КонецФункции

Функция ВывестиПунктДисциплинарныхВзысканий(КонтекстПечати, ДанныеДляПечати, НомерПункта)
	
	ТабличныйДокумент       = КонтекстПечати.ТабличныйДокумент;
	Макет                   = КонтекстПечати.Макет;
	ИменаПараметровОбластей = КонтекстПечати.ИменаПараметровОбластей;
	
	ПараметрыПункта = Новый Структура(ИменаПараметровОбластей.Взыскание);
