	МассивСобытий.Добавить("Запись_ОплатаПоСреднемуЗаработкуСписком");
	МассивСобытий.Добавить("Закрытие_ОтпускаСотрудников");
	МассивСобытий.Добавить("Закрытие_Отпуск");
	МассивСобытий.Добавить("Закрытие_Командировка");
	МассивСобытий.Добавить("Закрытие_КомандировкиСотрудников");
