// Конец СтандартныеПодсистемы.Свойства

&НаСервере
Процедура ПриПолученииДанныхНаСервере()

	ХарактеристикиПерсоналаФормы.ЗагрузитьРежимОтображенияПоКомпетенциям("ОтображениеПоКомпетенциямОбучениеРазвитиеСотрудников", Элементы.ПоКомпетенциям);
	
	УстановитьВторичныеРеквизитыФормыПоМероприятию();
	ЗаполнитьДополнительныеРеквизитыФормы();
	
	УстановитьСвойстваЭлементовФормы(ЭтотОбъект);
	УстановитьСвойстваЭлементовКоманд(ЭтотОбъект);
	ОбучениеРазвитиеФормы.УстановитьВидимостьКомандСозданияДокументов(ЭтотОбъект);
	
	УстановитьРасшифровкуСуммыРасходов(ЭтотОбъект);
	
	ЧтениеПрогрессаОбученияСотрудников = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ПрогрессОбученияСотрудников);
	ДобавлениеИзменениеПрогрессаОбученияСотрудников = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ПрогрессОбученияСотрудников);
	Если Не Пользователи.ЭтоПолноправныйПользователь()
		И Не ЧтениеПрогрессаОбученияСотрудников 
		И Не ДобавлениеИзменениеПрогрессаОбученияСотрудников Тогда
		Возврат;
	КонецЕсли;
	
	Если ЧтениеПрогрессаОбученияСотрудников И Не ДобавлениеИзменениеПрогрессаОбученияСотрудников Тогда
		Элементы.СотрудникиПрогрессОбученияГруппа.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ИспользоватьОценкуПрохожденияИПР = ПолучитьФункциональнуюОпцию("ИспользоватьПрогрессОбучения");
	Если Не ИспользоватьОценкуПрохожденияИПР Тогда
		Объект.ПрогрессОбучения = Ложь;
	Иначе
		НастройкиОбученияРазвития = РегистрыСведений.НастройкиОбученияРазвития.ЗначенияНастроек();
		Если НастройкиОбученияРазвития.ИспользоватьПрогрессОбучения Тогда
			Объект.ПрогрессОбучения = НастройкиОбученияРазвития.ИспользоватьПрогрессОбучения;
			Объект.ПродолжительностьПрогрессаОбучения = НастройкиОбученияРазвития.ПродолжительностьПрогрессаОбучения;
			Объект.РазмерностьПродолжительностиПрогрессаОбучения =
				НастройкиОбученияРазвития.РазмерностьПродолжительностиПрогрессаОбучения;
		КонецЕсли;
		СоздатьИЗаполнитьРеквизитыПрогрессаОбучения();
	КонецЕсли;
	
	УстановитьВидимостьДокументаОтсутствия(ЭтотОбъект);
	
	ЗаполнитьДокументОтсутствия(ЭтотОбъект);
	СохранитьЗначенияРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СохранитьЗначенияРеквизитов(Форма)
	
	НовыеЗначения = Новый Структура;
	НовыеЗначения.Вставить("ДатаНачала", Форма.Объект.ДатаНачала);
	НовыеЗначения.Вставить("ДатаОкончания", Форма.Объект.ДатаОкончания);
	
	Форма.СохраненныеЗначенияРеквизитов = Новый ФиксированнаяСтруктура(НовыеЗначения);

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СотрудникиСтрокаСвидетельства.Имя);
	ПолеЭлемента.Использование = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Сотрудники.Свидетельство");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ОтборЭлемента.Использование = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЗакрытыйДокумент);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Ввести результаты'"));
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СотрудникиДокументОтсутствия.Имя);
	ПолеЭлемента.Использование = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Сотрудники.ДокументОтсутствия");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ОтборЭлемента.Использование = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЗакрытыйДокумент);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Документ отсутствия не введен'"));
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СотрудникиСотрудник.Имя);
	ПолеЭлемента.Использование = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Сотрудники.Сотрудник");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборЭлемента.Использование = Истина;

	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ГруппаОтбора.Использование = Истина;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Сотрудники.ДокументОтсутствия");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборЭлемента.Использование = Истина;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Сотрудники.Свидетельство");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборЭлемента.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыФормыПоПервичномуМероприятию()
	
	Если РеквизитыКЗаполнениюЗаняты("ВыборМногоэтапногоОбучения") Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("МногоэтапноеОбучениеВыборЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения,
			НСтр("ru = 'Заполнить документ на основании данных выбранного этапа? Существующие данные будут утеряны.'"),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		МногоэтапноеОбучениеВыборЗавершение(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПервичныйЭтапОбучения()
	
	Объект.ПервичныйЭтапОбучения = Объект.Ссылка;
	ЗаполнитьРеквизитЭтоСледующийЭтапОбучения(ЭтотОбъект);
	
	УстановитьНадписьПервичныйЭтапОбучения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура МногоэтапноеОбучениеВыборЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		// Заполняем весь документ на основании выбранного этапа.
		ЗаполнитьПоОснованиюНаСервере(Объект.ПервичныйЭтапОбучения);
	Иначе
		// Заполняем только некоторые реквизиты.
		ЗаполнитьПодразделениеМероприятиеПоОснованиюНаСервере();
	КонецЕсли;
	
	Модифицированность = Истина;
	
	УстановитьВторичныеРеквизитыФормыПоМероприятию();
	
	УстановитьСвойстваЭлементовФормы(ЭтотОбъект);
	УстановитьСвойстваЭлементовКоманд(ЭтотОбъект);
	 
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзПубликацииЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьИзПубликацииНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзПубликацииНаКлиенте()

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("ПоказыватьЗакрытыеПубликации", Истина);
	ПараметрыФормы.Вставить("НаДату", Объект.Дата);
	
	Если ЗначениеЗаполнено(Объект.Мероприятие) Тогда
		ПараметрыФормы.Вставить("Мероприятие", Объект.Мероприятие);
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораПубликации", ЭтотОбъект);
	ОткрытьФорму("Документ.ПубликацияМероприятияОбученияРазвития.ФормаСписка", ПараметрыФормы, ЭтотОбъект, , , ,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

&НаКлиенте
Процедура МероприятиеПриИзмененииЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	
	МероприятиеПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВвестиСвидетельствоКлиент()
	
	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Свидетельство) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДокументаОбучения = ДанныеМероприятия(Объект.Мероприятие);
	ДанныеДокументаОбучения.Вставить("ФизическоеЛицо", Элементы.Сотрудники.ТекущиеДанные.ФизическоеЛицо);
	ДанныеДокументаОбучения.Вставить("НаименованиеКурса", Объект.Мероприятие);
	
	Если ЭтоСледующийЭтапОбучения Тогда
		ДанныеДокументаОбучения.Вставить("Начало", ДатаНачалаПервичногоОбучения(Объект.ПервичныйЭтапОбучения));
	Иначе	
		ДанныеДокументаОбучения.Вставить("Начало", Объект.ДатаНачала);
	КонецЕсли;
	
	ДанныеДокументаОбучения.Вставить("Окончание", Объект.ДатаОкончания);
	ДанныеДокументаОбучения.Вставить("КоличествоЧасов", Объект.КоличествоУчебныхЧасов);
	ТекстОснования = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Пр. № %1 от %2'"), ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Объект.Номер), Формат(Объект.Дата,"ДЛФ=D"));
	ДанныеДокументаОбучения.Вставить("Основание", ТекстОснования);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДанныеДокументаОбучения", ДанныеДокументаОбучения);
	
	Если Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Данные еще не записаны.
				|Ввести свидетельство возможно только после записи данных.
				|Данные будут записаны.'");
				
		Оповещение = Новый ОписаниеОповещения("ВвестиСвидетельствоКлиентЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВвестиСвидетельствоКлиентЗавершение(Неопределено, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиСвидетельствоКлиентЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Попытка
		Записать();
		Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
			Возврат;
		КонецЕсли;
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru='Не удалось записать свидетельство.'") + ИнформацияОбОшибке().Описание);
			Возврат;
		КонецПопытки;
	ИначеЕсли Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДокументаОбучения = ДополнительныеПараметры.ДанныеДокументаОбучения;
	
	Основание = Новый Структура;
	Основание.Вставить("Ссылка", Объект.Ссылка);
	Основание.Вставить("Действие", "ЗаполнитьИзОбучения");
	Основание.Вставить("ДанныеДокументаОбучения", ДанныеДокументаОбучения);
	
	ПараметрыФормы = Новый Структура("Основание", Основание);
	
	ОткрытьФорму("Справочник.ОбразованиеФизическихЛиц.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#Область УстановкаСвойствЭлементовФормы

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваЭлементовФормы(Форма)

	ЗаполнятьКонтрагента = Ложь;
	Если Форма.ВнешнееОбучение Тогда
		ЗаполнятьКонтрагента = Истина;
	КонецЕсли;
	
	ЗаполнятьПреподавателя = Ложь;
	Если Не Форма.ВнешнееОбучение И Не Форма.ЭлектронныйКурс Тогда
		ЗаполнятьПреподавателя = Истина;
	КонецЕсли;
	
	ЗаполнятьМестоПроведения = Ложь;
	Если Не Форма.ЭлектронныйКурс Тогда
		ЗаполнятьМестоПроведения = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Контрагент",
		"Видимость",
		ЗаполнятьКонтрагента);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Преподаватель",
		"Видимость",
		ЗаполнятьПреподавателя);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"МестоПроведения",
		"Видимость",
		ЗаполнятьМестоПроведения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Контрагент",
		"Доступность",
		Форма.ВнешнееОбучение);
		
	// Многоэтапное обучение.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Подразделение",
		"Доступность",
		Не Форма.ПродолжениеОбучения);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Мероприятие",
		"Доступность",
		Не Форма.ПродолжениеОбучения);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"НадписьПервичныйЭтапОбучения",
		"Видимость",
		Форма.ПродолжениеОбучения);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		"Преподаватель",
		"Заголовок",
