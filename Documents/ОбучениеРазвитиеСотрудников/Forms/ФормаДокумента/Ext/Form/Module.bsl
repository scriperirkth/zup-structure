		И (Форма.Объект.ПервичныйЭтапОбучения <> Форма.Объект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыТаблицыСотрудники()

	ЗаполнитьТаблицуСвидетельств();
	
	Для Каждого СтрокаСотрудника Из Объект.Сотрудники Цикл
		СтрокаСотрудника.ФизическоеЛицо = ФизическоеЛицоСотрудника(СтрокаСотрудника.Сотрудник);
		ЗаполнитьСвидетельствоВСтрокеСотрудника(ЭтотОбъект, СтрокаСотрудника);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументОтсутствия(Параметр)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОбучениеРазвитиеСотрудниковСотрудники.Сотрудник КАК Сотрудник,
		|	ОтсутствияНаОснованииОбучения.ДокументОтсутствия КАК ДокументОтсутствия
		|ИЗ
		|	Документ.ОбучениеРазвитиеСотрудников.Сотрудники КАК ОбучениеРазвитиеСотрудниковСотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтсутствияНаОснованииОбучения КАК ОтсутствияНаОснованииОбучения
		|		ПО ОбучениеРазвитиеСотрудниковСотрудники.Сотрудник = ОтсутствияНаОснованииОбучения.Сотрудник
		|			И (ОтсутствияНаОснованииОбучения.ДокументОснование = &Ссылка)
		|ГДЕ
		|	ОбучениеРазвитиеСотрудниковСотрудники.Ссылка = &Ссылка
		|	И НЕ ОтсутствияНаОснованииОбучения.ДокументОтсутствия.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

	ТаблицаОтсутствий = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаСотрудник Из Объект.Сотрудники Цикл
		Отбор = Новый Структура("Сотрудник", СтрокаСотрудник.Сотрудник);
		НайденныеСтроки = ТаблицаОтсутствий.НайтиСтроки(Отбор);
		СтрокаСотрудник.ДокументОтсутствия =
			?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].ДокументОтсутствия, Неопределено);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВозможностьУдаленияСтрокиСотрудника(ТекущиеДанные, Отказ)
	
	ПроверитьУдалениеСтрокиПоРеквизиту(
		ТекущиеДанные,
		"ДокументОтсутствия",
		НСтр("ru = 'Сотруднику %1 уже оформлен документ %2.
		|Для удаления этой строки необходимо удалить сотрудника из документа отсутствия или отменить отсутствие.'"),
		Отказ);
		
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
		
	ПроверитьУдалениеСтрокиПоРеквизиту(
		ТекущиеДанные,
		"Свидетельство",
		НСтр("ru = 'Сотруднику %1 уже оформлено свидетельство %2.
		|Для удаления этой строки необходимо удалить свидетельство.'"),
		Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУдалениеСтрокиПоРеквизиту(ТекущиеДанные, ИмяРеквизита, ШаблонСообщения, Отказ)
	
	ЗначениеРеквизита = ТекущиеДанные[ИмяРеквизита];
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Если Не ЕстьДругиеСтрокиССотрудником(
				ТекущиеДанные.Сотрудник,
				ИмяРеквизита,
				ЗначениеРеквизита) Тогда
			
			ТекстСообщения = СтрШаблон(ШаблонСообщения, ТекущиеДанные.Сотрудник, ЗначениеРеквизита);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьДругиеСтрокиССотрудником(Сотрудник, ИмяРеквизита, ЗначениеРеквизита)
	
	Отбор = Новый Структура("Сотрудник, " + ИмяРеквизита, Сотрудник, ЗначениеРеквизита);
	НайденныеСтроки = Объект.Сотрудники.НайтиСтроки(Отбор); 
	
	Если НайденныеСтроки.Количество() > 1 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура УдалитьЗаписиПоДокументамОтсутствияСПроверкой(ТекущиеДанные)
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументОтсутствия) Тогда
		Если Не ЕстьДругиеСтрокиССотрудником(
				ТекущиеДанные.Сотрудник,
				"ДокументОтсутствия",
				ТекущиеДанные.ДокументОтсутствия) Тогда
			УдалитьЗаписиПоДокументамОтсутствия(Объект.Ссылка, ТекущиеДанные.Сотрудник);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЗаписиПоДокументамОтсутствия(Документ, Сотрудник)
	
	РегистрыСведений.ОтсутствияНаОснованииОбучения.УдалитьЗаписиПоОтсутствиямСотрудника(Документ, Сотрудник);
	
КонецПроцедуры

