	Возврат МассивСобытий;

КонецФункции

&НаСервере
Процедура СоздатьИЗаполнитьРеквизитыПрогрессаОбучения()
	
	ПараметрыПрогрессаОбучения = ОбучениеРазвитиеФормы.ПараметрыПрогрессаОбучения();
	ПараметрыПрогрессаОбучения.Группа = "СотрудникиПрогрессОбученияГруппа";
	ПараметрыПрогрессаОбучения.ЧислоКолонок = Объект.ПродолжительностьПрогрессаОбучения;
	ПараметрыПрогрессаОбучения.РасположениеРеквизитов = "Объект.Сотрудники";
	ПараметрыПрогрессаОбучения.Источник = "Обучение";
	ПараметрыПрогрессаОбучения.Размерность = Объект.РазмерностьПродолжительностиПрогрессаОбучения;
	
	ОбучениеРазвитиеФормы.СоздатьРеквизитыПрогрессаОбучения(ЭтотОбъект, ПараметрыПрогрессаОбучения);
	
	УстановитьЗначенияПериодовПрогрессаОбучения();
	ЗаполнитьПроцентВыполненияПланаРазвития();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияПериодовПрогрессаОбучения()
	
	ПрогрессОбучения = РегистрыСведений.ПрогрессОбученияСотрудников.ПрогрессОбучения(
		Объект.Сотрудники.Выгрузить().ВыгрузитьКолонку("ФизическоеЛицо"),
		Объект.Ссылка);
	
	Для Каждого Сотрудник Из Объект.Сотрудники Цикл
		Отборы = Новый Структура;
		Отборы.Вставить("Сотрудник", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник.Сотрудник, "ФизическоеЛицо"));
		ПрогрессОбученияПоСотруднику = ПрогрессОбучения.НайтиСтроки(Отборы);
		Если ПрогрессОбученияПоСотруднику.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Сч = 1 По ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "Объект.ПродолжительностьПрогрессаОбучения") Цикл
			Отборы = Новый Структура;
			Отборы.Вставить("Сотрудник", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник.Сотрудник, "ФизическоеЛицо"));
			Отборы.Вставить("НомерПериода", Сч);
			Прогресс = ПрогрессОбучения.НайтиСтроки(Отборы);
			Если Прогресс.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Сотрудник["Прогресс" + Строка(Сч)] = Прогресс[0].Прогресс;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроцентВыполненияПланаРазвития()
	
	ЧислоКолонок = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ЭтотОбъект, "Объект.ПродолжительностьПрогрессаОбучения");
	Для Сч = 1 По ЧислоКолонок Цикл
		ОбщийПрогресс = Новый Массив;
		Для Каждого Сотрудник Из Объект.Сотрудники Цикл
			ОбщийПрогресс.Добавить(Сотрудник["Прогресс" + Строка(Сч)]);
		КонецЦикла;
		
		КоличествоМероприятий = 0;
		СуммаПрогресса = 0;
		ВыполнениеПланаРазвития = Истина;
		Для Каждого ЗначениеПрогресса Из ОбщийПрогресс Цикл
			Если ЗначениеПрогресса = ПредопределенноеЗначение("Справочник.ЗначенияПрогрессаОбучения.ПустаяСсылка") Тогда
				ВыполнениеПланаРазвития = Ложь;
				Прервать;
			ИначеЕсли Не ЗначениеЗаполнено(ЗначениеПрогресса) Тогда
				Прогресс = 0;
			Иначе
				Прогресс = ЗначениеПрогресса.Прогресс;
			КонецЕсли;
			СуммаПрогресса = СуммаПрогресса + Прогресс;
			КоличествоМероприятий = КоличествоМероприятий + 1;
		КонецЦикла;
		Если ВыполнениеПланаРазвития И КоличествоМероприятий <> 0 Тогда
			ИтогПрогресса = СуммаПрогресса / КоличествоМероприятий;
			ЭтотОбъект["ИтогПрогресса" + Строка(Сч)] = Формат(ИтогПрогресса, "ЧДЦ=0;") + "%";
		Иначе
			ЭтотОбъект["ИтогПрогресса" + Строка(Сч)] = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПрогрессПриИзменении(Элемент)
	
	Если Параметры.Ключ.Пустая() Тогда
		Элементы.Сотрудники.ТекущиеДанные[Элемент.Имя] = ПредопределенноеЗначение("Справочник.ЗначенияПрогрессаОбучения.ПустаяСсылка");
		ВызватьИсключение НСтр("ru = 'Внесение прогресса обучения возможно только после записи документа.'");
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные[Элемент.Имя]) Тогда
		ТаблицаЗначенийПрогресса = ТаблицаЗначенийПрогресса();
		Для Номер = 1 По Объект.ПродолжительностьПрогрессаОбучения Цикл
			ИмяПрогресса = "Прогресс" + Номер;
			ЗначениеПрогресса = ТекущиеДанные[ИмяПрогресса];
			Если ЗначениеПрогресса = ПредопределенноеЗначение("Справочник.ЗначенияПрогрессаОбучения.ПустаяСсылка") Тогда
				Продолжить;
			КонецЕсли;
			Если Элемент.Имя = ИмяПрогресса  Тогда
				Если Номер = Объект.ПродолжительностьПрогрессаОбучения Тогда
					Прервать;
				КонецЕсли;
				ИмяПрогресса = "Прогресс" + (Номер + 1);
				ЗначениеПрогресса = ТекущиеДанные[ИмяПрогресса];
				Если ЗначениеПрогресса <> ПредопределенноеЗначение("Справочник.ЗначенияПрогрессаОбучения.ПустаяСсылка")
					И ТаблицаЗначенийПрогресса.Получить(ТекущиеДанные[Элемент.Имя])
						> ТаблицаЗначенийПрогресса.Получить(ЗначениеПрогресса) Тогда
					ТекущиеДанные[Элемент.Имя] = ЗначениеПрогресса;
				КонецЕсли;
				Прервать;
			КонецЕсли;
			ПоследнийПрогрессМероприятия = ЗначениеПрогресса;
		КонецЦикла;
		Если ЗначениеЗаполнено(ПоследнийПрогрессМероприятия)
			И ТаблицаЗначенийПрогресса.Получить(ТекущиеДанные[Элемент.Имя])
			< ТаблицаЗначенийПрогресса.Получить(ПоследнийПрогрессМероприятия) Тогда
			ТекущиеДанные[Элемент.Имя] = ПоследнийПрогрессМероприятия;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьПроцентВыполненияПланаРазвития();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПрогрессНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Элемент.СписокВыбора.Очистить();
	ЗначенияПрогрессаОбучения = ЗначенияПрогрессаОбученияНаСервере();
	Для Каждого Значение Из ЗначенияПрогрессаОбучения Цикл
		Элемент.СписокВыбора.Добавить(Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТаблицаЗначенийПрогресса()
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияПрогрессаОбучения.Ссылка КАК Сслыка,
		|	ЗначенияПрогрессаОбучения.Прогресс КАК Прогресс
		|ИЗ
		|	Справочник.ЗначенияПрогрессаОбучения КАК ЗначенияПрогрессаОбучения";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ТаблицаЗначенийПрогресса = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ТаблицаЗначенийПрогресса.Вставить(Выборка.Сслыка, Выборка.Прогресс);
	КонецЦикла;
	
	Возврат ТаблицаЗначенийПрогресса;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначенияПрогрессаОбученияНаСервере()
	
	Возврат Справочники.ЗначенияПрогрессаОбучения.ЗначенияПрогрессаОбучения();
	
КонецФункции

#КонецОбласти 