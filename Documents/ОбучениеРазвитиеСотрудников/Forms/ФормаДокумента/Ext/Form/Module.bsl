&НаКлиенте
Процедура СотрудникиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДобавленыСотрудники = Ложь;
	Для Каждого ВыбранныйСотрудник Из ВыбранноеЗначение Цикл
		Если Объект.Сотрудники.НайтиСтроки(Новый Структура("Сотрудник", ВыбранныйСотрудник)).Количество() = 0 Тогда
			НовыйСотрудник = Объект.Сотрудники.Добавить();
			НовыйСотрудник.Сотрудник = ВыбранныйСотрудник;
			ДобавленыСотрудники = Истина;
		КонецЕсли;
	КонецЦикла; 

	Если ДобавленыСотрудники Тогда
		ЗаполнитьВторичныеРеквизитыТаблицыСотрудники();
		РассчитатьСуммуРасходов();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.СотрудникиСтрокаСвидетельства Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(ТекущиеДанные.Свидетельство) Тогда
			ПараметрыФормы = Новый Структура("Ключ", ТекущиеДанные.Свидетельство);
			ОткрытьФорму("Справочник.ОбразованиеФизическихЛиц.ФормаОбъекта",ПараметрыФормы);
		Иначе
			ВвестиСвидетельствоКлиент();
		КонецЕсли;
	ИначеЕсли Поле = Элементы.СотрудникиДокументОтсутствия Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументОтсутствия) Тогда
			ПараметрыФормы = Новый Структура("Ключ", ТекущиеДанные.ДокументОтсутствия);
			Имя = ПолучитьИмяДокумента(ТекущиеДанные.ДокументОтсутствия);
			ОткрытьФорму(СтрШаблон("Документ.%1.ФормаОбъекта", Имя), ПараметрыФормы);
		КонецЕсли;
	ИначеЕсли Поле = Элементы.СотрудникиСотрудник Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.Сотрудник) И (ЗначениеЗаполнено(ТекущиеДанные.ДокументОтсутствия) 
			Или ЗначениеЗаполнено(ТекущиеДанные.Свидетельство)) Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура("Ключ", ТекущиеДанные.Сотрудник);
			ОткрытьФорму("Справочник.Сотрудники.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяДокумента(ДокументСсылка)
	
	Возврат ДокументСсылка.Метаданные().Имя;

КонецФункции

