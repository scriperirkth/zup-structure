#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ЗаполнитьПоПрограммеОбучения(ДанныеЗаполнения);
	ЗаполнитьНаОснованииОбучения(ДанныеЗаполнения, СтандартнаяОбработка);
	ЗаполнитьПоДаннымЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Проверка на отсутствие одинаковых сотрудников в ТЧ РезультатыОбучения.
	ЕстьОдинаковыеСотрудники = Ложь;
	Сотрудники = Новый Массив;
	Для Каждого СтрокаОбучения Из РезультатыОбучения Цикл
		ТекущийСотрудник = Новый Структура("ФизическоеЛицо, РабочееМесто", СтрокаОбучения.ФизическоеЛицо, СтрокаОбучения.РабочееМесто);
		Если Сотрудники.Найти(ТекущийСотрудник) = Неопределено Тогда
			Сотрудники.Добавить(ТекущийСотрудник);
			Продолжить;
		КонецЕсли;
		ИндексСтроки = РезультатыОбучения.Индекс(СтрокаОбучения);
		ТекстСообщения =
			СтрШаблон(НСтр("ru = 'Информация о сотруднике %1 на рабочем месте %2 уже была введена в документе ранее'"),
				СтрокаОбучения.ФизическоеЛицо, СтрокаОбучения.РабочееМесто);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка,
			СтрШаблон("Объект.РезультатыОбучения[%1].ФизическоеЛицо", Формат(ИндексСтроки, "ЧН=0; ЧГ=0")), ,Отказ);
		ЕстьОдинаковыеСотрудники = Истина;
	КонецЦикла;

	Если ЕстьОдинаковыеСотрудники Тогда
		Возврат
	КонецЕсли;
	
	Если ФормаОбучения = Перечисления.ФормыОбученияПоОхранеТруда.Внутренняя Тогда
		ОхранаТруда.ОбработкаПроверкиЗаполненияКомиссии(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "УчебноеЗаведение");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбучениеСотрудников) Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "ДатаНачалаОбучения");
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "ДатаОкончанияОбучения");
	Иначе
		Если ДатаНачалаОбучения > ДатаОкончанияОбучения Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru='Дата окончания обучения не может быть меньше даты начала'"),
				ЭтотОбъект, "ДатаОкончания", ,Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ЗарплатаКадрыРасширенный.ИнициализироватьОтложеннуюРегистрациюВторичныхДанныхПоДвижениямДокумента(Движения);
	
	ПроверитьНаличиеПроверокПоОбучению(ОбучениеСотрудников);
	
	ДанныеДляПроведения = ДанныеДляПроведения();
	ЗарегистрироватьОбучениеПоОхранеТруда(Движения, ДанныеДляПроведения.РезультатыОбучения);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если ФормаОбучения = Перечисления.ФормыОбученияПоОхранеТруда.Внешняя Тогда
		Комиссия.Очистить();
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьСформированноеОбучение();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПроведения()
	
	ДанныеДляПроведения = Новый Структура();
	ДанныеДляПроведения.Вставить("МенеджерВременныхТаблиц",	Новый МенеджерВременныхТаблиц);
	ДанныеДляПроведения.Вставить("РезультатыОбучения",		Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ДанныеДляПроведения.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДатаПроверкиЗнания", ДатаПроверкиЗнания);
	
	ДобавитьДанныеДляПроведенияРезультатыОбучения(Запрос, ДанныеДляПроведения);
	
	Возврат ДанныеДляПроведения;
	
КонецФункции 

Процедура ДобавитьДанныеДляПроведенияРезультатыОбучения(Запрос, ДанныеДляПроведения)
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроверкаЗнания.Ссылка КАК Регистратор,
	|	ПроверкаЗнания.ДатаПроверкиЗнания КАК Период,
	|	ПроверкаЗнания.Номер КАК Номер,
	|	ПроверкаЗнания.НомерПротоколаПроверкиЗнания КАК НомерПротокола,
	|	ПроверкаЗнания.Организация КАК Организация,
	|	ПроверкаЗнания.ПрограммаОбучения КАК ПрограммаОбучения,
	|	ПроверкаЗнания.ПрограммаОбучения.ПрограммаОбученияМинтруда КАК ПрограммаОбученияМинтруда,
	|	ПроверкаЗнания.ДатаНачалаОбучения КАК ДатаНачалаОбучения,
	|	ПроверкаЗнания.ДатаОкончанияОбучения КАК ДатаОкончанияОбучения,
	|	ПроверкаЗнанияРезультатыОбучения.РабочееМесто КАК РабочееМесто,
	|	ПроверкаЗнанияРезультатыОбучения.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ПроверкаЗнанияРезультатыОбучения.Обучение КАК Обучение,
	|	ПроверкаЗнанияРезультатыОбучения.РезультатПроверкиЗнания КАК РезультатПроверки
	|ИЗ
	|	Документ.ПроверкаЗнанияТребованийОхраныТруда КАК ПроверкаЗнания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПроверкаЗнанияТребованийОхраныТруда.РезультатыОбучения КАК
	|			ПроверкаЗнанияРезультатыОбучения
	|		ПО ПроверкаЗнания.Ссылка = ПроверкаЗнанияРезультатыОбучения.Ссылка
	|ГДЕ
	|	ПроверкаЗнания.Ссылка = &Ссылка";
	
	ДанныеДляПроведенияРезультатыОбучения = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаДанных Из ДанныеДляПроведенияРезультатыОбучения Цикл
		СтрокаДанных.НомерПротокола = ЗарплатаКадрыОтчеты.НомерНаПечать(СтрокаДанных.Номер, СтрокаДанных.НомерПротокола);
	КонецЦикла;
	ДанныеДляПроведения.Вставить("РезультатыОбучения", ДанныеДляПроведенияРезультатыОбучения);
	
КонецПроцедуры

Процедура ЗарегистрироватьОбучениеПоОхранеТруда(Движения, ОбучениеПоОхранеТруда)
	
	ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Организация);
	Для Каждого Строка Из ОбучениеПоОхранеТруда Цикл
		НоваяСтрока = Движения.ПроверкиЗнанияТребованийОхраныТрудаСотрудников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ГоловнаяОрганизация = ГоловнаяОрганизация;
		Движения.ПроверкиЗнанияТребованийОхраныТрудаСотрудников.Записывать = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииОбучения(ОбучениеСсылка, СтандартнаяОбработка)
	
	Если ТипЗнч(ОбучениеСсылка) <> Тип("ДокументСсылка.ОбучениеСотрудниковОхранеТруда") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбучениеСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьНаличиеПроверокПоОбучению(ОбучениеСсылка);
	
	СтандартнаяОбработка = Ложь;
	
	ОбучениеСотрудников = ОбучениеСсылка;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбучениеСсылка,
		"Организация, Подразделение, ПрограммаОбучения, ФормаОбучения, ДатаНачалаОбучения, ДатаОкончанияОбучения,
		|КоличествоУчебныхЧасов, УчебноеЗаведение, Контрагент, Сотрудники");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияРеквизитов);
	
	Для Каждого Строка Из ЗначенияРеквизитов.Сотрудники.Выгрузить() Цикл
		НоваяСтрока = РезультатыОбучения.Добавить();
		НоваяСтрока.ФизическоеЛицо = Строка.ФизическоеЛицо;
		НоваяСтрока.РабочееМесто = Строка.РабочееМесто;
		НоваяСтрока.Обучение = ОбучениеСотрудников;
		НоваяСтрока.ДатаНачалаОбучения = ЗначенияРеквизитов.ДатаНачалаОбучения;
		НоваяСтрока.ДатаОкончанияОбучения = ЗначенияРеквизитов.ДатаОкончанияОбучения;
		НоваяСтрока.РезультатПроверкиЗнания = Перечисления.РезультатыПроверкиЗнанияПоОхранеТруда.Удовлетворительно;
	КонецЦикла;
	
	ЗаполнитьЗначенияПоУмолчанию();
	
КонецПроцедуры

Процедура ЗаполнитьПоДаннымЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ДанныеЗаполнения.Свойство("ФизическиеЛицаРабочиеМеста") Тогда
		ЗаполнитьСотрудниковПоТаблицеЗначений(ДанныеЗаполнения.ФизическиеЛицаРабочиеМеста);
	ИначеЕсли ЗначениеЗаполнено(ОбучениеСотрудников) Тогда
		ЗаполнитьНаОснованииОбучения(ОбучениеСотрудников, СтандартнаяОбработка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПрограммаОбучения) Тогда
		ЗаполнитьПоПрограммеОбучения(ПрограммаОбучения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоПрограммеОбучения(ПрограммаОбученияСсылка)
	
	Если ТипЗнч(ПрограммаОбученияСсылка) <> Тип("СправочникСсылка.ПрограммыОбученияСотрудниковПоОхранеТруда") Тогда
		Возврат;
	КонецЕсли;

	КоличествоУчебныхЧасов = Неопределено;
	Контрагент = Неопределено;
	УчебноеЗаведение = Неопределено;
	ФормаОбучения = Неопределено;
	
	ПрограммаОбучения = ПрограммаОбученияСсылка;
	Если ЗначениеЗаполнено(ПрограммаОбучения) Тогда
		ИменаРеквизитов = Новый Массив;
		ИменаРеквизитов.Добавить("КоличествоУчебныхЧасов"); 
		ИменаРеквизитов.Добавить("Контрагент");
		ИменаРеквизитов.Добавить("УчебноеЗаведение");
		ИменаРеквизитов.Добавить("ФормаОбучения");
		ДанныеПрограммы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПрограммаОбученияСсылка, ИменаРеквизитов);
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеПрограммы);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСотрудниковПоТаблицеЗначений(ФизическиеЛицаРабочиеМеста, ИмяКолонкиРабочееМесто = "РабочееМесто")
	
	Обучения = ОбщегоНазначения.ВыгрузитьКолонку(ФизическиеЛицаРабочиеМеста, "Обучение", Истина);
	ОбщегоНазначенияБЗККлиентСервер.УдалитьПустыеЗначенияИзМассива(Обучения);
	ДатыОбучений = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Обучения, "ДатаНачалаОбучения, ДатаОкончанияОбучения");
	
	Для Каждого ФизическоеЛицоРабочееМесто Из ФизическиеЛицаРабочиеМеста Цикл
		НоваяСтрока = РезультатыОбучения.Добавить();
		НоваяСтрока.ФизическоеЛицо = ФизическоеЛицоРабочееМесто.ФизическоеЛицо;
		НоваяСтрока.РабочееМесто = ФизическоеЛицоРабочееМесто[ИмяКолонкиРабочееМесто];
		НоваяСтрока.Обучение = ФизическоеЛицоРабочееМесто.Обучение;
		Если ЗарплатаКадры.ЕстьПолеВСтрокеКоллекции(ФизическоеЛицоРабочееМесто, "ДатаНачалаОбучения") Тогда
			НоваяСтрока.ДатаНачалаОбучения = ФизическоеЛицоРабочееМесто.ДатаНачалаОбучения;
		ИначеЕсли ДатыОбучений[НоваяСтрока.Обучение] <> Неопределено Тогда
			НоваяСтрока.ДатаНачалаОбучения = ДатыОбучений[НоваяСтрока.Обучение].ДатаНачалаОбучения;
		КонецЕсли;
		Если ЗарплатаКадры.ЕстьПолеВСтрокеКоллекции(ФизическоеЛицоРабочееМесто, "ДатаОкончанияОбучения") Тогда
			НоваяСтрока.ДатаОкончанияОбучения = ФизическоеЛицоРабочееМесто.ДатаОкончанияОбучения;
		ИначеЕсли ДатыОбучений[НоваяСтрока.Обучение] <> Неопределено Тогда
			НоваяСтрока.ДатаОкончанияОбучения = ДатыОбучений[НоваяСтрока.Обучение].ДатаОкончанияОбучения;
		КонецЕсли;
		НоваяСтрока.РезультатПроверкиЗнания = Перечисления.РезультатыПроверкиЗнанияПоОхранеТруда.Удовлетворительно;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСотрудниковПоПрограммеОбучения(КадровыеДанныеСотрудников = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ОбучениеПоОхранеТруда.СоздатьВТСотрудникиОжидающиеПроверку(
		Запрос.МенеджерВременныхТаблиц, ПрограммаОбучения, ДатаНачалаОбучения, ДатаОкончанияОбучения);
	Если КадровыеДанныеСотрудников = Неопределено Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СотрудникиОжидающиеПроверку.ФизическоеЛицо КАК ФизическоеЛицо,
			|	СотрудникиОжидающиеПроверку.РабочееМесто КАК РабочееМесто,
			|	СотрудникиОжидающиеПроверку.Обучение КАК Обучение,
			|	СотрудникиОжидающиеПроверку.ДатаНачалаОбучения КАК ДатаНачалаОбучения,
			|	СотрудникиОжидающиеПроверку.ДатаОкончанияОбучения КАК ДатаОкончанияОбучения
			|ИЗ
			|	ВТСотрудникиОжидающиеПроверку КАК СотрудникиОжидающиеПроверку";
	Иначе
		Запрос.УстановитьПараметр("СотрудникиОрганизации", КадровыеДанныеСотрудников);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СотрудникиОрганизации.ФизическоеЛицо КАК ФизическоеЛицо,
			|	СотрудникиОрганизации.РабочееМестоОхраныТруда КАК РабочееМестоОхраныТруда
			|ПОМЕСТИТЬ ВТСотрудникиОрганизации
			|ИЗ
			|	&СотрудникиОрганизации КАК СотрудникиОрганизации
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СотрудникиОрганизации.ФизическоеЛицо КАК ФизическоеЛицо,
			|	СотрудникиОрганизации.РабочееМестоОхраныТруда КАК РабочееМесто,
			|	СотрудникиОжидающиеПроверку.Обучение КАК Обучение,
			|	СотрудникиОжидающиеПроверку.ДатаНачалаОбучения КАК ДатаНачалаОбучения,
			|	СотрудникиОжидающиеПроверку.ДатаОкончанияОбучения КАК ДатаОкончанияОбучения
			|ИЗ
			|	ВТСотрудникиОрганизации КАК СотрудникиОрганизации
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСотрудникиОжидающиеПроверку КАК СотрудникиОжидающиеПроверку
			|		ПО СотрудникиОжидающиеПроверку.ФизическоеЛицо = СотрудникиОрганизации.ФизическоеЛицо";
	КонецЕсли;
	
	ЗаполнитьСотрудниковПоТаблицеЗначений(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияПоУмолчанию()
	
	ЗначенияПоУмолчанию = Новый Структура("Ответственный");
	ЗарплатаКадры.ПолучитьЗначенияПоУмолчанию(ЗначенияПоУмолчанию);
	Ответственный = ЗначенияПоУмолчанию.Ответственный;
	
КонецПроцедуры

Процедура ОбновитьСформированноеОбучение()
	
	// Если документ проводится, то обучение считается погашенным, запись о сформированном обучении удаляем.
	// В случае записи или отмены проведения запись нужно обновить, вписав туда обучение, или создать, если ее пока нет.
	
	Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		СоздатьЗаписиСформированногоОбучения();
		Возврат;
	КонецЕсли;
	
	ДатыОбучения = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(РезультатыОбучения.ВыгрузитьКолонку("Обучение"), "Дата");
	Для Каждого Строка Из РезультатыОбучения Цикл
		Если Не ЗначениеЗаполнено(Строка.Обучение) Тогда
			Продолжить;
		КонецЕсли;
		НаборЗаписей = РегистрыСведений.ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(Строка.ФизическоеЛицо);
		НаборЗаписей.Отбор.РабочееМесто.Установить(Строка.РабочееМесто);
		НаборЗаписей.Отбор.ПрограммаОбучения.Установить(ПрограммаОбучения);
		ДатаОбучения = НачалоДня(ДатыОбучения.Получить(Строка.Обучение));
		НаборЗаписей.Отбор.Период.Установить(ДатаОбучения);
		Если ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
			СтрокаНабора = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНабора, Строка);
			СтрокаНабора.Период = ДатаОбучения;
			СтрокаНабора.ПрограммаОбучения = ПрограммаОбучения;
			СтрокаНабора.Организация = Организация;
			СтрокаНабора.ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Организация);
			СтрокаНабора.Проверка = Ссылка;
		КонецЕсли;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЗаписиСформированногоОбучения()
	
	ДатыОбучения = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(РезультатыОбучения.ВыгрузитьКолонку("Обучение"), "Дата");
	Для Каждого СтрокаТаблицы Из РезультатыОбучения Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Обучение) Тогда
			Продолжить;
		КонецЕсли;
		НаборЗаписей = РегистрыСведений.ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(СтрокаТаблицы.ФизическоеЛицо);
		НаборЗаписей.Отбор.РабочееМесто.Установить(СтрокаТаблицы.РабочееМесто);
		НаборЗаписей.Отбор.ПрограммаОбучения.Установить(ПрограммаОбучения);
		ДатаОбучения = ДатыОбучения.Получить(СтрокаТаблицы.Обучение);
		НаборЗаписей.Отбор.Период.Установить(ДатаОбучения);
		СтрокаНабора = НаборЗаписей.Добавить();
		СтрокаНабора.ФизическоеЛицо = СтрокаТаблицы.ФизическоеЛицо;
		СтрокаНабора.РабочееМесто = СтрокаТаблицы.РабочееМесто;
		СтрокаНабора.ПрограммаОбучения = ПрограммаОбучения;
		СтрокаНабора.Организация = Организация;
		СтрокаНабора.ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Организация);
		СтрокаНабора.Период = ДатаОбучения;
		СтрокаНабора.Обучение = СтрокаТаблицы.Обучение;
		СтрокаНабора.ДатаНачалаОбучения = СтрокаТаблицы.ДатаНачалаОбучения;
		СтрокаНабора.ДатаОкончанияОбучения = СтрокаТаблицы.ДатаОкончанияОбучения;
		СтрокаНабора.Проверка = Ссылка;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеПроверокПоОбучению(ОбучениеСсылка)
	
	Если Не ЗначениеЗаполнено(ОбучениеСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Обучение", ОбучениеСсылка);
	Запрос.УстановитьПараметр("Проверка", Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПроверкиЗнания.Ссылка КАК Проверка
		|ИЗ
		|	Документ.ПроверкаЗнанияТребованийОхраныТруда КАК ПроверкиЗнания
		|ГДЕ
		|	ПроверкиЗнания.ОбучениеСотрудников = &Обучение
		|	И ПроверкиЗнания.Проведен
		|	И ПроверкиЗнания.Ссылка <> &Проверка";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	ТекстСообщения =
		СтрШаблон(НСтр("ru = 'На основании документа %1 уже проведен документ %2'"), ОбучениеСсылка, Выборка.Проверка);
	
	ВызватьИсключение ТекстСообщения;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли