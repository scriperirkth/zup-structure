#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ДанныеДляПроведения = ДанныеДляПроведения();
	
	СформироватьДвиженияКвотыДляТрудоустройстваПоДолжностям(Движения, ДанныеДляПроведения.РазмерыКвотПоДолжностям);

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПроведения()
	
	ДанныеДляПроведения = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВыделениеКвотДляТрудоустройства.АктДатаПринятия КАК Период,
	|	ВыделениеКвотДляТрудоустройства.Организация КАК Организация,
	|	ВыделениеКвотДляТрудоустройства.ВидКвоты КАК ВидКвоты,
	|	РазмерыКвот.Должность КАК Должность,
	|	ВыделениеКвотДляТрудоустройства.Ссылка КАК ДокументРегистрации,
	|	ВыделениеКвотДляТрудоустройства.АктВид КАК АктВид,
	|	ВыделениеКвотДляТрудоустройства.АктНомер КАК АктНомер,
	|	ВыделениеКвотДляТрудоустройства.АктДатаПринятия КАК АктДатаПринятия,
	|	ВыделениеКвотДляТрудоустройства.АктДатаОкончания КАК АктДатаОкончания,
	|	РазмерыКвот.РазмерКвоты КАК РазмерКвоты
	|ИЗ
	|	Документ.ВыделениеКвотДляТрудоустройства КАК ВыделениеКвотДляТрудоустройства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыделениеКвотДляТрудоустройства.РазмерыКвотПоДолжностям КАК РазмерыКвот
	|		ПО ВыделениеКвотДляТрудоустройства.Ссылка = РазмерыКвот.Ссылка
	|ГДЕ
	|	ВыделениеКвотДляТрудоустройства.Ссылка = &Ссылка"
	;
	
	ДанныеДляПроведения.Вставить("РазмерыКвотПоДолжностям", Запрос.Выполнить().Выгрузить());
	
	Возврат ДанныеДляПроведения;
	
КонецФункции

Процедура СформироватьДвиженияКвотыДляТрудоустройстваПоДолжностям(Движения, ДанныеДляПроведения)
	
	Для Каждого ДанныеПоКвоте Из ДанныеДляПроведения Цикл
		НоваяСтрока = Движения.КвотыДляТрудоустройстваПоДолжностям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеПоКвоте);
	КонецЦикла;
	
	Движения.КвотыДляТрудоустройстваПоДолжностям.Записывать = Истина;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
