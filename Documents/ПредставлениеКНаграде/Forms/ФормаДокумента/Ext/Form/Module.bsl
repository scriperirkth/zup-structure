#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПретендентыКНаграждениюНаграда");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПретендентыКНаграждению.ИзменитьНаграду");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "");
	
КонецПроцедуры

&НаСервере
Процедура ПриПолученииДанныхНаСервере()
	
	ЗарплатаКадры.КлючевыеРеквизитыЗаполненияФормыЗаполнитьПредупреждения(ЭтаФорма);
	ЗарплатаКадрыКлиентСервер.КлючевыеРеквизитыЗаполненияФормыУстановитьОтображениеПредупреждения(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВводХарактеристики(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры;
	Если Не РезультатЗакрытия = Неопределено Тогда
		ТекущиеДанные.ТекстХарактеристики = РезультатЗакрытия;
		Модифицированность = Истина;
	КонецЕсли;
	ТекущиеДанные.ТекстХарактеристикиЗаполнен = Не ТекущиеДанные.ТекстХарактеристики = Неопределено И Не СокрЛП(ТекущиеДанные.ТекстХарактеристики.ПолучитьТекст()) = "";

КонецПроцедуры

&НаСервере
Функция НаименованиеДолжностиДолжностногоЛица(ДолжностноеЛицо)
	
	ПараметрыПолученияСотрудников = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолученияСотрудников.КадровыеДанные = "Должность,ОсновноеРабочееМестоВОрганизации";
	ПараметрыПолученияСотрудников.ОтбиратьПоГоловнойОрганизации = Истина;
	ПараметрыПолученияСотрудников.Организация = Объект.Организация;
	ПараметрыПолученияСотрудников.ОкончаниеПериода = КонецДня(Объект.Дата);
	ПараметрыПолученияСотрудников.СписокФизическихЛиц = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДолжностноеЛицо);
	СотрудникиФизическихЛиц = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыПолученияСотрудников);
	Для Каждого СтрокаСотрудникиФизическихЛиц Из СотрудникиФизическихЛиц Цикл
		Если СтрокаСотрудникиФизическихЛиц.ОсновноеРабочееМестоВОрганизации Тогда
			Возврат Строка(СтрокаСотрудникиФизическихЛиц.Должность);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСогласованияПоУмолчаниюПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСогласованияПоУмолчаниюПослеПодтвержденияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСогласованияПоУмолчаниюПослеПодтвержденияНаСервере()
	
	ТекстовыйДокумент = Документы.ПредставлениеКНаграде.ПолучитьМакет("ДолжностныеЛицаСогласований");
	ТаблицаЗаполнения = ОбщегоНазначения.ПрочитатьXMLВТаблицу(ТекстовыйДокумент.ПолучитьТекст()).Данные;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДолжностныеЛица", ТаблицаЗаполнения);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ДолжностныеЛица.ДолжностноеЛицо КАК СТРОКА(500)) КАК ВидДолжностногоЛица
	|ПОМЕСТИТЬ ВТДолжностныеЛицаСогласований
	|ИЗ
	|	&ДолжностныеЛица КАК ДолжностныеЛица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ПредставлениеКНаграде.Дата) КАК Дата,
	|	ВТДолжностныеЛицаСогласований.ВидДолжностногоЛица КАК ВидДолжностногоЛица
	|ПОМЕСТИТЬ ВТДаты
	|ИЗ
	|	Документ.ПредставлениеКНаграде КАК ПредставлениеКНаграде
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПредставлениеКНаграде.Согласования КАК ПредставлениеКНаградеСогласования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДолжностныеЛицаСогласований КАК ВТДолжностныеЛицаСогласований
	|			ПО ПредставлениеКНаградеСогласования.ВидДолжностногоЛица = ВТДолжностныеЛицаСогласований.ВидДолжностногоЛица
	|		ПО ПредставлениеКНаграде.Ссылка = ПредставлениеКНаградеСогласования.Ссылка
	|ГДЕ
	|	ПредставлениеКНаграде.Организация = &Организация
	|	И ПредставлениеКНаграде.Проведен
	|	И ПредставлениеКНаграде.Ссылка <> &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДолжностныеЛицаСогласований.ВидДолжностногоЛица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ПредставлениеКНаграде.Ссылка) КАК Ссылка,
	|	ВТДаты.ВидДолжностногоЛица КАК ВидДолжностногоЛица
	|ПОМЕСТИТЬ ВТСсылки
	|ИЗ
	|	Документ.ПредставлениеКНаграде КАК ПредставлениеКНаграде
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПредставлениеКНаграде.Согласования КАК ПредставлениеКНаградеСогласования
	|		ПО ПредставлениеКНаграде.Ссылка = ПредставлениеКНаградеСогласования.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДаты КАК ВТДаты
	|		ПО ПредставлениеКНаграде.Дата = ВТДаты.Дата
	|			И (ПредставлениеКНаградеСогласования.ВидДолжностногоЛица = ВТДаты.ВидДолжностногоЛица)
	|ГДЕ
	|	ПредставлениеКНаграде.Организация = &Организация
	|	И ПредставлениеКНаграде.Проведен
	|	И ПредставлениеКНаграде.Ссылка <> &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДаты.ВидДолжностногоЛица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДолжностныеЛицаСогласований.ВидДолжностногоЛица КАК ВидДолжностногоЛица,
	|	ЕСТЬNULL(ПредставлениеКНаградеСогласования.НаименованиеДолжности, """") КАК НаименованиеДолжности,
	|	ЕСТЬNULL(ПредставлениеКНаградеСогласования.ДолжностноеЛицо, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК ДолжностноеЛицо
	|ИЗ
	|	ВТДолжностныеЛицаСогласований КАК ВТДолжностныеЛицаСогласований
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСсылки КАК ВТСсылки
	|		ПО ВТДолжностныеЛицаСогласований.ВидДолжностногоЛица = ВТСсылки.ВидДолжностногоЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПредставлениеКНаграде.Согласования КАК ПредставлениеКНаградеСогласования
	|		ПО (ВТСсылки.Ссылка = ПредставлениеКНаградеСогласования.Ссылка)
	|			И (ВТСсылки.ВидДолжностногоЛица = ПредставлениеКНаградеСогласования.ВидДолжностногоЛица)";
	
	Объект.Согласования.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияПолейХарактеристик()

	Для Каждого ТекущиеДанные Из Объект.ПретендентыКНаграждению Цикл
		
		Попытка
			ТекстХарактеристики = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекущиеДанные.Характеристика);
		Исключение
			ТекстХарактеристики = Новый ФорматированныйДокумент;
		КонецПопытки;
		
		Если ТекстХарактеристики = Неопределено Тогда
			ТекстХарактеристики = Новый ФорматированныйДокумент;
		КонецЕсли;
		
		ТекущиеДанные.ТекстХарактеристики = ТекстХарактеристики;
		ТекущиеДанные.ТекстХарактеристикиЗаполнен = Не СокрЛП(ТекстХарактеристики.ПолучитьТекст()) = "";
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияРеквизитовПриИзмененииНаграды()
	
	Для Каждого ТекущиеДанные Из Объект.ПретендентыКНаграждению Цикл
		Если Не ТекущиеДанные.ИзменитьНаграду Тогда
			ТекущиеДанные.Награда = ТекущиеДанные.ПредставитьКНаграде;
		КонецЕсли;
		ЗаполнитьКатегориюНаграды(ТекущиеДанные);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКатегориюНаграды(ТекущаяСтрока)
	ТекущаяСтрока.КатегорияНаграды = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.Награда, "КатегорияНаграды");
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияИзмененияНаграды()
	
	Для Каждого ТекущиеДанные Из Объект.ПретендентыКНаграждению Цикл
		Если Не ТекущиеДанные.Награда = ТекущиеДанные.ПредставитьКНаграде Тогда
			ТекущиеДанные.ИзменитьНаграду = Истина;
		КонецЕсли;
		ЗаполнитьКатегориюНаграды(ТекущиеДанные);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуИзмененияСтатуса(ТекущиеДанные)
	Если ТекущиеДанные.ДатаУстановкиСтатуса = Дата(1,1,1) И Не ТекущиеДанные.Статус.Пустая() Тогда
		ТекущиеДанные.ДатаУстановкиСтатуса = ОбщегоНазначенияКлиент.ДатаСеанса();
	ИначеЕсли ТекущиеДанные.Статус.Пустая() Тогда
		ТекущиеДанные.ДатаУстановкиСтатуса = Дата(1,1,1);
	КонецЕсли;
КонецПроцедуры

// СтандартныеПодсистемы.Свойства
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

