	|	КадровыеДанныеФизическихЛиц.Имя КАК Имя,
	|	КадровыеДанныеФизическихЛиц.Отчество КАК Отчество,
	|	КадровыеДанныеФизическихЛиц.ФИО КАК ФИО,
	|	КадровыеДанныеФизическихЛиц.ФамилияИО КАК ФамилияИО,
	|	КадровыеДанныеФизическихЛиц.Пол КАК Пол,
	|	КадровыеДанныеФизическихЛиц.ДатаРождения КАК ДатаРождения,
	|	КадровыеДанныеФизическихЛиц.МестоРождения КАК МестоРождения,
	|	ЕСТЬNULL(КадровыеДанныеСотрудников.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК Должность,
	|	КадровыеДанныеФизическихЛиц.УченоеЗвание КАК УченоеЗвание,
	|	КадровыеДанныеФизическихЛиц.УченаяСтепень КАК УченаяСтепень,
	|	КадровыеДанныеФизическихЛиц.ОбщийСтажЛет КАК ОбщийСтажЛет,
	|	КадровыеДанныеФизическихЛиц.АдресМестаПроживанияПредставление КАК АдресМестаПроживанияПредставление,
	|	КадровыеДанныеФизическихЛиц.АдресМестаПроживания КАК АдресМестаПроживания,
	|	ЕСТЬNULL(РабочиеМестаСотрудников.ДатаНачала, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНазначения,
	|	ЕСТЬNULL(ДанныеРуководителяКадровогоПодразделения.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК ДолжностьРуководителяКадровогоПодразделения,
	|	ЕСТЬNULL(ДанныеРуководителяКадровогоПодразделения.ФамилияИО, """") КАК ФИОРуководителяКадровогоПодразделения
	|ИЗ
	|	ВТПредставленияКНаградам КАК ПредставлениеКНаграде
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРабочиеМестаСотрудников КАК РабочиеМестаСотрудников
	|		ПО ПредставлениеКНаграде.ФизическоеЛицо = РабочиеМестаСотрудников.ФизическоеЛицо
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКадровыеДанныеФизическихЛиц КАК КадровыеДанныеФизическихЛиц
	|		ПО ПредставлениеКНаграде.ФизическоеЛицо = КадровыеДанныеФизическихЛиц.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
	|		ПО ПредставлениеКНаграде.ФизическоеЛицо = КадровыеДанныеСотрудников.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК ДанныеРуководителяКадровогоПодразделения
	|		ПО ПредставлениеКНаграде.РуководительКадровогоПодразделения = ДанныеРуководителяКадровогоПодразделения.Сотрудник";
	
	ДанныеОбъектовПечати = Запрос.Выполнить().Выгрузить();
	
	ПараметрыПечатиОбъектов = Новый Соответствие;
	
	Для Каждого ОбъектПечати Из МассивОбъектов Цикл
		
		ДанныеОбъектаПечати = ДанныеОбъектовПечати.НайтиСтроки(Новый Структура("Ссылка", ОбъектПечати));
		
		ПараметрыПечатиПретедентов = Новый Массив;
		
		Для Каждого ДанныеОбъекта Из ДанныеОбъектаПечати Цикл
			
			ДанныеОбОрганизации = ЗарплатаКадры.СведенияОбОрганизации(ДанныеОбъекта.Организация, "ОргСубъект,НаимЮЛПол,ДолжнРук,ФамилияРук,ИмяРук,ОтчествоРук");
			НаимЮЛПолРод = СклонениеПредставленийОбъектов.ПросклонятьПредставление(ДанныеОбОрганизации.НаимЮЛПол, 2);
			ТипНаградыТвор = СклонениеПредставленийОбъектов.ПросклонятьПредставление(ДанныеОбъекта.ТипНаграды, 5);
			
			ЗаполняемыеПараметры = 
			"СтажРаботыВОтрасли,
			|ФИОРуководителяКадровогоПодразделения,
			|НомерПротокола,
			|Фамилия,
			|Имя,
			|Отчество,
			|Пол,
			|ОбщийСтажЛет,
			|ФИО,
			|ФамилияИО,
			|АдресМестаПроживанияПредставление";
			
			ПараметрыПечати = ПараметрыПечатиНаградногоЛиста();
			ЗаполнитьЗначенияСвойств(ПараметрыПечати, ДанныеОбъекта, ЗаполняемыеПараметры);
			ЗаполнитьЗначенияСвойств(ПараметрыПечати, ДанныеОбОрганизации, "ОргСубъект");
			
			ПараметрыПечати.НаимЮЛПолРод = НаимЮЛПолРод;
			ПараметрыПечати.ПредседательствующийНаОбщемСобрании = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ДанныеОбъекта.ПредседательствующийНаОбщемСобрании);
			
			СутьНаграды = СокрЛП(СтрЗаменить(ДанныеОбъекта.НаименованиеНаграды, ДанныеОбъекта.ТипНаграды, ""));
			ПараметрыПечати.НаименованиеНаграды = СтрШаблон("%1%2%3", ДанныеОбъекта.ТипНаграды, Символы.ПС, СутьНаграды);
			ПараметрыПечати.ТипНаградыТвор = ТипНаградыТвор;
			ПараметрыПечати.СутьНаграды = СутьНаграды;
			
			ПараметрыПечати.ДатаРождения = Формат(ДанныеОбъекта.ДатаРождения, "ДФ=dd.MM.yyyy");
			
			Если ЗначениеЗаполнено(ДанныеОбъекта.Должность) Тогда
				ПараметрыПечати.ДолжностьМестоРаботы = СтрШаблон(НСтр("ru = '%1 %2'"), ДанныеОбъекта.Должность, НаимЮЛПолРод);
			КонецЕсли;
			
			УченаяСтепеньЗвание = Новый Массив;
			Если ЗначениеЗаполнено(ДанныеОбъекта.УченаяСтепень) Тогда
				УченаяСтепеньЗвание.Добавить(ДанныеОбъекта.УченаяСтепень);
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеОбъекта.УченоеЗвание) Тогда
				УченаяСтепеньЗвание.Добавить(ДанныеОбъекта.УченоеЗвание);
			КонецЕсли;
			
			Если Не УченаяСтепеньЗвание.Количество() = 0 Тогда
				ПараметрыПечати.УченаяСтепеньЗвание = СтрСоединить(УченаяСтепеньЗвание, НСтр("ru = ', '"));
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеОбъекта.ДатаНазначения) Тогда
				ПараметрыПечати.СтажРаботыВДолжности = Год(ДанныеОбъекта.Дата)-Год(ДанныеОбъекта.ДатаНазначения);
				Если ПараметрыПечати.СтажРаботыВДолжности > 0 И ДеньГода(ДанныеОбъекта.Дата) < ДеньГода(ДанныеОбъекта.ДатаНазначения) Тогда
					ПараметрыПечати.СтажРаботыВДолжности = ПараметрыПечати.СтажРаботыВДолжности - 1;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеОбъекта.ДолжностьРуководителяКадровогоПодразделения) Тогда
				ПараметрыПечати.ДолжностьРуководителяКадровогоПодразделения = СтрШаблон(НСтр("ru = '%1 %2'"), ДанныеОбъекта.ДолжностьРуководителяКадровогоПодразделения, НаимЮЛПолРод);
			КонецЕсли;
			
			ПараметрыПечати.ДатаДень = Формат(ДанныеОбъекта.Дата, "ДФ=dd");
			ПараметрыПечати.ДатаМесяцПрописью = Формат(ДанныеОбъекта.Дата, "ДФ='дд ММММ'");
			ПараметрыПечати.ДатаМесяцПрописью = СокрЛП(СтрЗаменить(ПараметрыПечати.ДатаМесяцПрописью,ПараметрыПечати.ДатаДень,""));
			ПараметрыПечати.ДатаГод =  Формат(ДанныеОбъекта.Дата, "ДФ=yyyy");
			
			ПараметрыПечати.ДатаПротоколаДень = Формат(ДанныеОбъекта.ДатаПротокола, "ДФ=dd");
			ПараметрыПечати.ДатаПротоколаМесяцПрописью = Формат(ДанныеОбъекта.ДатаПротокола, "ДФ='дд ММММ'");
			ПараметрыПечати.ДатаПротоколаМесяцПрописью = СокрЛП(СтрЗаменить(ПараметрыПечати.ДатаМесяцПрописью,ПараметрыПечати.ДатаДень,""));
			ПараметрыПечати.ДатаПротоколаГод =  Формат(ДанныеОбъекта.ДатаПротокола, "ДФ=yyyy");
			
			Если ЗначениеЗаполнено(ДанныеОбОрганизации.ДолжнРук) Тогда
				ПараметрыПечати.ДолжностьРуководителя = СтрШаблон(НСтр("ru = '%1 %2'"), ДанныеОбОрганизации.ДолжнРук, НаимЮЛПолРод);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СокрЛП(ДанныеОбОрганизации.ФамилияРук)) Тогда
				Инициалы = "";
				Если ЗначениеЗаполнено(ДанныеОбОрганизации.ИмяРук) Тогда
					Инициалы = СтрШаблон(НСтр("ru = '%1.'"), Лев(СокрЛП(ДанныеОбОрганизации.ИмяРук),1));
					Если ЗначениеЗаполнено(ДанныеОбОрганизации.ОтчествоРук) Тогда
						Инициалы = СтрШаблон(НСтр("ru = '%1%2.'"), Инициалы, Лев(СокрЛП(ДанныеОбОрганизации.ОтчествоРук),1));
					КонецЕсли;
				КонецЕсли;
				ПараметрыПечати.РуководительОрганизацииФамилияИнициалы = СтрШаблон(НСтр("ru = '%1 %2'"), СокрЛП(ДанныеОбОрганизации.ФамилияРук), Инициалы);
			КонецЕсли;
			
			ПараметрыПечати.ДолжностьПредседательствующего = СтрШаблон(НСтр("ru = 'Председательствующий на общем  собрании коллектива организации, ее  совета или собрании  участников %1'"), НаимЮЛПолРод);
			
			МуниципальноеПредставлениеАдреса = РаботаСАдресами.СведенияОбАдресе(ДанныеОбъекта.АдресМестаПроживания).МуниципальноеПредставление;
			Если Не МуниципальноеПредставлениеАдреса = "" Тогда
				ПараметрыПечати.АдресМестаПроживанияПредставление = МуниципальноеПредставлениеАдреса;
			КонецЕсли;
			
			ТрудоваяДеятельность = ТрудоваяДеятельностьФизическихЛиц.НайтиСтроки(Новый Структура("ФизическоеЛицо", ДанныеОбъекта.ФизическоеЛицо));
			ПараметрыПечати.ТрудоваяДеятельность = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТрудоваяДеятельностьФизическихЛиц.Скопировать(ТрудоваяДеятельность));
			
			ОбразованиеФизическогоЛица = ОбразованияФЛ.НайтиСтроки(Новый Структура("ФизическоеЛицо", ДанныеОбъекта.ФизическоеЛицо));
			ОбразованиеФизическогоЛица = ОбразованияФЛ.Скопировать(ОбразованиеФизическогоЛица, "ОбразованиеПредставление");
			ОбразованиеФизическогоЛица = ОбразованиеФизическогоЛица.ВыгрузитьКолонку("ОбразованиеПредставление");
			ПараметрыПечати.Образование = СтрСоединить(ОбразованиеФизическогоЛица,  СтрШаблон(НСтр("ru = '%1'"),Символы.ПС));
			
			НаградыФизическихЛиц = РегистрыСведений.НаградыФизическихЛиц.НаградыФизическихЛиц(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеОбъекта.ФизическоеЛицо), ОбъектПечати.Дата);
			НаградыФизическихЛиц.Колонки.Добавить("НаименованиеНаграды", Новый ОписаниеТипов("Строка"));
			Для Каждого СтрокаНаграды Из НаградыФизическихЛиц Цикл
				МассивЗначений = Новый Массив;
				МассивЗначений.Добавить(СтрокаНаграды.ПредставлениеНаграды);
				МассивЗначений.Добавить(Формат(СтрокаНаграды.ДатаПриказа, "ДФ='yyyy ""г.""'"));
				СтрокаНаграды.НаименованиеНаграды = СтрСоединить(МассивЗначений, НСтр("ru = ', '"));
			КонецЦикла;
			
			НаградыРФ = НаградыФизическихЛиц.НайтиСтроки(Новый Структура("КатегорияНаграды", Справочники.КатегорииНаград.ГосударственнаяНаградаРФ));
			НаградыРФ = НаградыФизическихЛиц.Скопировать(НаградыРФ, "НаименованиеНаграды, ДатаПриказа");
			НаградыРФ.Сортировать("ДатаПриказа");
			НаградыРФ = НаградыРФ.ВыгрузитьКолонку("НаименованиеНаграды");
			
			НаградыСССР = НаградыФизическихЛиц.НайтиСтроки(Новый Структура("КатегорияНаграды", Справочники.КатегорииНаград.ГосударственнаяНаградаСССР));
			НаградыСССР = НаградыФизическихЛиц.Скопировать(НаградыСССР, "НаименованиеНаграды, ДатаПриказа");
			НаградыСССР.Сортировать("ДатаПриказа");
			НаградыСССР = НаградыСССР.ВыгрузитьКолонку("НаименованиеНаграды");
			
			НаградыРСФСР = НаградыФизическихЛиц.НайтиСтроки(Новый Структура("КатегорияНаграды", Справочники.КатегорииНаград.ГосударственнаяНаградаРСФСР));
			НаградыРСФСР = НаградыФизическихЛиц.Скопировать(НаградыРСФСР, "НаименованиеНаграды, ДатаПриказа");
			НаградыРСФСР.Сортировать("ДатаПриказа");
			НаградыРСФСР = НаградыРСФСР.ВыгрузитьКолонку("НаименованиеНаграды");
			
			Разделитель = "#";
			Награды = СтрШаблон("%1%2%3%4%5", СтрСоединить(НаградыРФ, Разделитель), Разделитель, СтрСоединить(НаградыСССР, Разделитель), Разделитель, СтрСоединить(НаградыРСФСР, Разделитель));
			Награды = СтрРазделить(Награды, Разделитель, Ложь);
			
			Если Награды.Количество() = 0 Тогда
				ПараметрыПечати.Награды = ?(ДанныеОбъекта.Пол = Перечисления.ПолФизическогоЛица.Женский, НСтр("ru = 'Не награждалась'"), НСтр("ru = 'Не награждался'"));
			Иначе
				ПараметрыПечати.Награды = СтрСоединить(Награды, Символы.ПС);
			КонецЕсли;
			
			ВедомственныеНаграды = НаградыФизическихЛиц.НайтиСтроки(Новый Структура("КатегорияНаграды", Справочники.КатегорииНаград.ВедомственнаяНаградаРФ));
			ВедомственныеНаграды = НаградыФизическихЛиц.Скопировать(ВедомственныеНаграды, "НаименованиеНаграды");
			ВедомственныеНаграды = ВедомственныеНаграды.ВыгрузитьКолонку("НаименованиеНаграды");
			
			РегиональныеНаграды = НаградыФизическихЛиц.НайтиСтроки(Новый Структура("КатегорияНаграды", Справочники.КатегорииНаград.РегиональнаяНаграда));
			РегиональныеНаграды = НаградыФизическихЛиц.Скопировать(РегиональныеНаграды, "НаименованиеНаграды");
			РегиональныеНаграды = РегиональныеНаграды.ВыгрузитьКолонку("НаименованиеНаграды");
			
			Разделитель = "#";
			Награды = СтрШаблон("%1%2%3", СтрСоединить(ВедомственныеНаграды, Разделитель), Разделитель, СтрСоединить(РегиональныеНаграды, Разделитель));
			Награды = СтрРазделить(Награды, Разделитель, Ложь);
			
			Если Награды.Количество() = 0 Тогда
				ПараметрыПечати.ВедомственныеНаграды = ?(ДанныеОбъекта.Пол = Перечисления.ПолФизическогоЛица.Женский, НСтр("ru = 'Не награждалась'"), НСтр("ru = 'Не награждался'"));
			Иначе
				ПараметрыПечати.ВедомственныеНаграды = СтрСоединить(Награды, Символы.ПС);
			КонецЕсли;
			
			ПараметрыПечати.МестоРождения = ПерсонифицированныйУчетКлиентСервер.ПредставлениеМестаРождения(ДанныеОбъекта.МестоРождения);
			
			ТекстХарактеристики = ДанныеОбъекта.Характеристика;
			Пока Не ТекстХарактеристики = "" Цикл
				СимволовАбзаца = СтрНайти(ТекстХарактеристики, Символы.ПС);
				Если СимволовАбзаца = 0 Тогда
					СимволовАбзаца =  СтрДлина(ТекстХарактеристики);
				КонецЕсли;
				ПараметрыПечати.Характеристика.Добавить(Лев(ТекстХарактеристики, СимволовАбзаца));
				ТекстХарактеристики = Сред(ТекстХарактеристики, СимволовАбзаца+1);
			КонецЦикла;
			
			СогласованияНаградногоЛиста = СогласованияНаградныхЛистов.НайтиСтроки(Новый Структура("Ссылка", ОбъектПечати));
			СогласованияНаградногоЛиста = СогласованияНаградныхЛистов.Скопировать(СогласованияНаградногоЛиста);
			ПараметрыПечати.Согласования = ОбщегоНазначения.ТаблицаЗначенийВМассив(СогласованияНаградногоЛиста);
			
			ТекстХарактеристики = ОбщегоНазначения.ЗначениеИзСтрокиXML(ДанныеОбъекта.Характеристика);
			Если ТипЗнч(ТекстХарактеристики) = Тип("ФорматированныйДокумент") Тогда
				ПараметрыПечати.ТекстХарактеристики = ТекстХарактеристики.ПолучитьФорматированнуюСтроку();
				ПараметрыПечати.ТекстХарактеристикиФорматированныйДокумент = ТекстХарактеристики.ПолучитьТекст();
			КонецЕсли;
			
			ПараметрыПечатиПретедентов.Добавить(Новый Структура("Претендент, ПараметрыПечати", ДанныеОбъекта.Претендент, ПараметрыПечати));
			
		КонецЦикла;
		
		ПараметрыПечатиОбъектов.Вставить(ОбъектПечати, ПараметрыПечатиПретедентов);
			
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ПараметрыПечатиОбъектов;
		
КонецФункции
	
