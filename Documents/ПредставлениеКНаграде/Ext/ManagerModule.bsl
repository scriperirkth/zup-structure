// Возвращает описание состава документа
//
// Возвращаемое значение:
//  Структура - см. ЗарплатаКадрыСоставДокументов.НовоеОписаниеСоставаОбъекта.
Функция ОписаниеСоставаОбъекта() Экспорт
	
	ОписаниеСостава = ЗарплатаКадрыСоставДокументов.НовоеОписаниеСоставаОбъекта();
	
	ОписаниеХранения = ЗарплатаКадрыСоставДокументов.ОписаниеХраненияСотрудниковФизическихЛиц();
	ОписаниеХранения.ИмяТаблицы = "ПретендентыКНаграждению";
	ОписаниеХранения.ПолеСотрудник = Неопределено;
	ОписаниеХранения.ПолеФизическоеЛицо = "Претендент";
	ОписаниеСостава.ОписаниеХраненияСотрудниковФизическихЛиц.Добавить(ОписаниеХранения);

	ОписаниеХранения = ЗарплатаКадрыСоставДокументов.ОписаниеХраненияСотрудниковФизическихЛиц();
	ОписаниеХранения.ИмяТаблицы = "ПретендентыКНаграждению";
	ОписаниеХранения.ПолеСотрудник = "Претендент";
	ОписаниеХранения.ПолеФизическоеЛицо = "Претендент";
	ОписаниеСостава.ОписаниеХраненияСотрудниковФизическихЛиц.Добавить(ОписаниеХранения);

	Возврат ОписаниеСостава;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Печать

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "НаграднойЛистФорма1") Тогда
		ДанныеПечатиОбъектов = ДанныеПечатиНаградногоЛиста(МассивОбъектов);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм, "НаграднойЛистФорма1", НСтр("ru = 'Наградной лист (Форма № 1)'"), НаграднойЛист_Форма_1(МассивОбъектов, ОбъектыПечати, ДанныеПечатиОбъектов));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "НаграднойЛистФорма1(OfficeOpenXML)") Тогда
		ФормированиеНаградногоЛиста(МассивОбъектов, КоллекцияПечатныхФорм);
	КонецЕсли;

КонецПроцедуры

// Подготавливает данные объекта к выводу на печать.
// 
// Параметры:
//  МассивДокументов - Массив - ссылки на объекты, для которых запрашиваются данные для печати;
//  МассивИменМакетов - Массив - имена макетов, в которые подставляются данные для печати.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - коллекция ссылок на объекты и их данные:
//   * Ключ - ЛюбаяСсылка - ссылка на объект информационной базы;
//   * Значение - Структура:
//    ** Ключ - Строка - имя макета,
//    ** Значение - Структура - данные объекта.
//
Функция ПолучитьДанныеПечати(Знач МассивДокументов, Знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;

	ДанныеПечатиОбъектов = ДанныеПечатиНаградногоЛиста(МассивДокументов);
	
	Для Каждого ОбъектСсылка Из МассивДокументов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, ДанныеПечатиОбъектов.Получить(ОбъектСсылка));
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ДвоичныеДанныеМакетов = Новый Соответствие;
	ТипыМакетов = Новый Соответствие; // Для обратной совместимости.
	
	Для Каждого ИмяМакета Из МассивИменМакетов Цикл
		Если ИмяМакета = "НаграднойЛистФорма1(OfficeOpenXML)" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, 
				УправлениеПечатью.МакетПечатнойФормы("Документ.ПредставлениеКНаграде.ПФ_DOC_НаграднойЛист_Форма1_ru"));
		КонецЕсли;
		ОписаниеОбластей.Вставить(ИмяМакета, ПолучитьОписаниеОбластейМакетаОфисногоДокумента());
	КонецЦикла;
	
	Макеты = Новый Структура;
	Макеты.Вставить("ОписаниеОбластей", ОписаниеОбластей);
	Макеты.Вставить("ТипыМакетов", ТипыМакетов); // Для обратной совместимости.
	Макеты.Вставить("ДвоичныеДанныеМакетов", ДвоичныеДанныеМакетов);
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", ДанныеПоВсемОбъектам);
	Результат.Вставить("Макеты", Макеты);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОписаниеОбластейМакетаОфисногоДокумента()
	
	ОписаниеОбластей = Новый Структура;
	
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "УтверждениеКандидатуры",	"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Подвал",					"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "СогласованоШапка",			"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "СогласованоСтрока",		"СтрокаТаблицы");
	
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Шапка",					"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "НаименованиеНаграды",		"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "ФИО",						"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "ДолжностьМестоРаботы",		"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Пол",						"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "МестоРождения",			"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Образование",				"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "МестоРождения",			"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "УченаяСтепеньЗвание",		"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Награды",					"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "ВедомственныеНаграды",		"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "ДомашнийАдрес",			"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "СтажРаботы",				"Общая");
	
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "ДополнительнаяСтрокаНаграды",	"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "ДополнительнаяСтрока",			"Общая");
	
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "ТрудоваяДеятельностьШапка",			"Общая");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "ТрудоваяДеятельность",					"СтрокаТаблицы");
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "РуководительКадровогоПодразделения",	"Общая");
	
	УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Характеристика",			"Общая");
	
	Возврат ОписаниеОбластей;
	
КонецФункции

Процедура ФормированиеНаградногоЛиста(МассивОбъектов, КоллекцияПечатныхФорм)
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "НаграднойЛистФорма1(OfficeOpenXML)");
	Если ПечатнаяФорма <> Неопределено Тогда
		ИмяМакета = "НаграднойЛистФорма1(OfficeOpenXML)";
		МакетИДанныеОбъекта = УправлениеПечатьюВызовСервера.МакетыИДанныеОбъектовДляПечати("Документ.ПредставлениеКНаграде", ИмяМакета, МассивОбъектов);
		ОфисныеДокументы = Новый Соответствие;
		
		Шаблон = НСтр("ru = 'Наградной лист: Форма №1 [НомерДокумента] - [Претендент] - [НомерПоПорядку]'");
		
		Для Каждого ОбъектПечати Из МассивОбъектов Цикл
			
			ПараметрыПечатиПретедентов = МакетИДанныеОбъекта.Данные[ОбъектПечати][ИмяМакета];
			Если ПараметрыПечатиПретедентов = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ПараметрыПечатиПретедента Из ПараметрыПечатиПретедентов Цикл
				
				ДанныеПечати = ПараметрыПечатиПретедента.ПараметрыПечати;
				
				Имя = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон,
						Новый Структура("НомерДокумента, Претендент, НомерПоПорядку", ОбъектПечати.Номер, ПараметрыПечатиПретедента.Претендент,
						ПараметрыПечатиПретедентов.Найти(ПараметрыПечатиПретедента)));
				АдресХранилищаОфисныйДокумент = НапечататьНаграднойЛист(ДанныеПечати, МакетИДанныеОбъекта, ИмяМакета);
				ОфисныеДокументы.Вставить(АдресХранилищаОфисныйДокумент, Имя);
				
			КонецЦикла;
			
			ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Наградной лист (Форма №1) Office Open XML'");
			ПечатнаяФорма.ОфисныеДокументы = ОфисныеДокументы;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция НапечататьНаграднойЛист(ДанныеПечати, МакетИДанныеОбъекта, ИмяМакета)
	
	ТипМакета				= МакетИДанныеОбъекта.Макеты.ТипыМакетов[ИмяМакета];
	ДвоичныеДанныеМакетов	= МакетИДанныеОбъекта.Макеты.ДвоичныеДанныеМакетов;
	Области					= МакетИДанныеОбъекта.Макеты.ОписаниеОбластей;
	ДанныеОбъекта			= ДанныеПечати;
	
	Макет = УправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(ДвоичныеДанныеМакетов[ИмяМакета], ТипМакета, ИмяМакета);
	Если Макет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЗакрытьОкноПечатнойФормы = Ложь;
	Попытка
		ПечатнаяФорма = УправлениеПечатью.ИнициализироватьПечатнуюФорму(ТипМакета, Макет.НастройкиСтраницыМакета, Макет);
		АдресХранилищаПечатнойФормы = "";
		Если ПечатнаяФорма = Неопределено Тогда
			УправлениеПечатью.ОчиститьСсылки(Макет);
			Возврат "";
		КонецЕсли;
		// Вывод обычных областей с параметрами.
		Если ИмяМакета = "НаграднойЛистФорма1(OfficeOpenXML)" Тогда
			ПолучениеЗаполнениеНаградногоЛиста(Макет, ИмяМакета, Области, ПечатнаяФорма, ДанныеОбъекта);
		КонецЕсли;

		АдресХранилищаПечатнойФормы = УправлениеПечатью.СформироватьДокумент(ПечатнаяФорма);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗакрытьОкноПечатнойФормы = Истина;
		Возврат "";
	КонецПопытки;
	
	УправлениеПечатью.ОчиститьСсылки(ПечатнаяФорма, ЗакрытьОкноПечатнойФормы);
	УправлениеПечатью.ОчиститьСсылки(Макет);
	
	Возврат АдресХранилищаПечатнойФормы;
	
КонецФункции

Процедура ПолучениеЗаполнениеНаградногоЛиста(Макет, ИмяМакета, Области, ПечатнаяФорма, ДанныеОбъекта)
	
	Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["УтверждениеКандидатуры"]);
	УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
	
	Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["Подвал"]);
	УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
	
	Если ДанныеОбъекта.Согласования.Количество() > 0 Тогда
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["СогласованоШапка"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["СогласованоСтрока"]);
		УправлениеПечатью.ПрисоединитьИЗаполнитьКоллекцию(ПечатнаяФорма, Область, ДанныеОбъекта.Согласования, Ложь);
		
	КонецЕсли;
	
	ОбластиПечати = Новый Массив;
	ОбластиПечати.Добавить("Шапка");
	ОбластиПечати.Добавить("НаименованиеНаграды");
	ОбластиПечати.Добавить("ФИО");
	ОбластиПечати.Добавить("ДолжностьМестоРаботы");
	ОбластиПечати.Добавить("Пол");
	ОбластиПечати.Добавить("МестоРождения");
	ОбластиПечати.Добавить("Образование");
	ОбластиПечати.Добавить("УченаяСтепеньЗвание");
	ОбластиПечати.Добавить("Награды");
	ОбластиПечати.Добавить("ВедомственныеНаграды");
	ОбластиПечати.Добавить("ДомашнийАдрес");
	ОбластиПечати.Добавить("СтажРаботы");

	ПараметрыДополнительныхОбластей = ВыполнитьПереносПараметровПоСтрокам(ДанныеОбъекта);
	
	Для Каждого ИмяОбласти Из ОбластиПечати Цикл
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета][ИмяОбласти]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
		
		ПараметрыДополнительнойОбласти = Неопределено;
		Если ПараметрыДополнительныхОбластей.Свойство(ИмяОбласти, ПараметрыДополнительнойОбласти) И Не ПараметрыДополнительнойОбласти = Неопределено Тогда

			Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета][ПараметрыДополнительнойОбласти.ИмяДополнительнойОбласти]);
			Для Каждого Параметр Из ПараметрыДополнительнойОбласти.Параметры Цикл
				ДополнительныеПараметры = Новый Структура("ДополнительныйПараметр", Параметр);
				УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДополнительныеПараметры, Ложь);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ТрудоваяДеятельностьШапка"]);
	УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
	
	Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ТрудоваяДеятельность"]);
	УправлениеПечатью.ПрисоединитьИЗаполнитьКоллекцию(ПечатнаяФорма, Область, ДанныеОбъекта.ТрудоваяДеятельность, Ложь);
	
	Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["РуководительКадровогоПодразделения"]);
	УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
	
	Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["Характеристика"]);
	УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
	
КонецПроцедуры

Функция НаграднойЛист_Форма_1(МассивОбъектов, ОбъектыПечати, ДанныеПечатиОбъектов)
	
	Макет = Документы.ПредставлениеКНаграде.ПолучитьМакет("ПФ_MXL_НаграднойЛист_Форма1");

	ДокументРезультат = Новый ТабличныйДокумент;
	ДокументРезультат.АвтоМасштаб = Истина;
	
	ОбластиПечати = Новый Массив;
	ОбластиПечати.Добавить("Шапка");
	ОбластиПечати.Добавить("НаименованиеНаграды");
	ОбластиПечати.Добавить("ФИО");
	ОбластиПечати.Добавить("ДолжностьМестоРаботы");
	ОбластиПечати.Добавить("Пол");
	ОбластиПечати.Добавить("МестоРождения");
	ОбластиПечати.Добавить("Образование");
	ОбластиПечати.Добавить("УченаяСтепеньЗвание");
	ОбластиПечати.Добавить("Награды");
	ОбластиПечати.Добавить("ВедомственныеНаграды");
	ОбластиПечати.Добавить("ДомашнийАдрес");
	ОбластиПечати.Добавить("СтажРаботы");
	
	ПервыйДокумент = Истина;
	Для Каждого ОбъектПечати Из МассивОбъектов Цикл
		
		ПараметрыПечатиПретедентов = ДанныеПечатиОбъектов.Получить(ОбъектПечати);
		Если ПараметрыПечатиПретедентов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиНачало = ДокументРезультат.ВысотаТаблицы + 1;
		
		Для Каждого ПараметрыПечатиПретедента Из ПараметрыПечатиПретедентов Цикл
			
			ТабличныйДокумент = Новый ТабличныйДокумент;
			
			ДанныеПечати = ПараметрыПечатиПретедента.ПараметрыПечати;
			
			ПараметрыДополнительныхОбластей = ВыполнитьПереносПараметровПоСтрокам(ДанныеПечати);
			
			ВывестиОбластиПечати(ТабличныйДокумент, Макет, ДанныеПечати, ОбластиПечати, ПараметрыДополнительныхОбластей);
			
			Область = Макет.ПолучитьОбласть("ТрудоваяДеятельностьШапка");
			ТабличныйДокумент.Вывести(Область);
			Область = Макет.ПолучитьОбласть("ТрудоваяДеятельность");
			Для Каждого СтрокаТрудовойДеятельности Из ДанныеПечати.ТрудоваяДеятельность Цикл
				ЗаполнитьЗначенияСвойств(Область.Параметры, СтрокаТрудовойДеятельности);
				ТабличныйДокумент.Вывести(Область);
			КонецЦикла;
			
			ВывестиОбластиПечати(ТабличныйДокумент, Макет, ДанныеПечати, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("РуководительКадровогоПодразделения"), ПараметрыДополнительныхОбластей);
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			Область = Макет.ПолучитьОбласть("Характеристика");
			ТабличныйДокумент.Вывести(Область);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ВывестиОбластиПечати(ТабличныйДокумент, Макет, ДанныеПечати, СтрРазделить("УтверждениеКандидатуры,Подвал", ","), ПараметрыДополнительныхОбластей);
			
			Если Не ДанныеПечати.Согласования.Количество() = 0 Тогда
				Область = Макет.ПолучитьОбласть("СогласованоШапка");
				ТабличныйДокумент.Вывести(Область);
				Область = Макет.ПолучитьОбласть("СогласованоСтрока");
				Для Каждого СтрокаСогласования Из ДанныеПечати.Согласования Цикл
					ЗаполнитьЗначенияСвойств(Область.Параметры, СтрокаСогласования);
					ТабличныйДокумент.Вывести(Область);
				КонецЦикла;
			КонецЕсли;
			
			ДокументРезультат.Вывести(ТабличныйДокумент);
			
			ДокументРезультат.Рисунки[ДокументРезультат.Рисунки.Количество()-1].Текст = ДанныеПечати.ТекстХарактеристики;
			
			ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЦикла;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ДокументРезультат, НомерСтрокиНачало, ОбъектыПечати, ОбъектПечати);
		
		ПервыйДокумент = Ложь;
		
	КонецЦикла;
	
	Возврат ДокументРезультат;

КонецФункции

Процедура ВывестиОбластиПечати(ТабличныйДокумент, Макет, ДанныеПечати, ОбластиПечати, ПараметрыДополнительныхОбластей)
	
	Для Каждого ИмяОбласти Из ОбластиПечати Цикл
		
		Область = Макет.ПолучитьОбласть(ИмяОбласти);
		ЗаполнитьЗначенияСвойств(Область.Параметры, ДанныеПечати);
		ТабличныйДокумент.Вывести(Область);
		
		ПараметрыДополнительнойОбласти = Неопределено;
		Если ПараметрыДополнительныхОбластей.Свойство(ИмяОбласти, ПараметрыДополнительнойОбласти) И Не ПараметрыДополнительнойОбласти = Неопределено Тогда
			ДополнительнаяОбласть = Макет.ПолучитьОбласть(ПараметрыДополнительнойОбласти.ИмяДополнительнойОбласти);
			Для Каждого Параметр Из ПараметрыДополнительнойОбласти.Параметры Цикл
				ДополнительнаяОбласть.Параметры.ДополнительныйПараметр = Параметр;
				ТабличныйДокумент.Вывести(ДополнительнаяОбласть);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВыполнитьПереносПараметровПоСтрокам(ПараметрыПечати)
	
	СимволПробела = " ";
	ПустаяСтрока = "";
	
	СимволыРазделители = Новый Массив;
	СимволыРазделители.Добавить(СимволПробела);
	СимволыРазделители.Добавить(Символы.ПС);
	СимволыРазделители.Добавить(".");
	СимволыРазделители.Добавить(";");
	СимволыРазделители.Добавить(",");
	СимволыРазделители.Добавить("-");

	ОбластиСПереносами = "НаименованиеНаграды,ДолжностьМестоРаботы,МестоРождения,Образование,Награды,ВедомственныеНаграды,ДомашнийАдрес,УтверждениеКандидатуры";
	
	ПараметрыПереносаПоСтрокам = Новый Структура(ОбластиСПереносами);
	ПоляСтруктуры = "ИмяПараметра, КоличествоСимволовПоСтрокам";
	ПараметрыПереносаПоСтрокам.ДомашнийАдрес			= Новый Структура(ПоляСтруктуры, "АдресМестаПроживанияПредставление", СтрРазделить("51,71",","));
	ПараметрыПереносаПоСтрокам.ДолжностьМестоРаботы		= Новый Структура(ПоляСтруктуры, "ДолжностьМестоРаботы", СтрРазделить("42,71,71",","));
	ПараметрыПереносаПоСтрокам.Образование				= Новый Структура(ПоляСтруктуры, "Образование", СтрРазделить("55,71",","));
	ПараметрыПереносаПоСтрокам.Награды					= Новый Структура(ПоляСтруктуры, "Награды", СтрРазделить("71,71,71,71",","));
	ПараметрыПереносаПоСтрокам.ВедомственныеНаграды		= Новый Структура(ПоляСтруктуры, "ВедомственныеНаграды", СтрРазделить("51,71,71,71,71",","));
	ПараметрыПереносаПоСтрокам.МестоРождения 			= Новый Структура(ПоляСтруктуры, "МестоРождения", СтрРазделить("51,71",","));
	ПараметрыПереносаПоСтрокам.НаименованиеНаграды		= Новый Структура(ПоляСтруктуры, "НаименованиеНаграды", СтрРазделить("50,150",","));
	ПараметрыПереносаПоСтрокам.УтверждениеКандидатуры	= Новый Структура(ПоляСтруктуры, "НаимЮЛПолРод", СтрРазделить("71,71",","));
	
	КлючиСтруктурыДополнительныхОбластей = "ИмяДополнительнойОбласти,Параметры,КоличествоСимволов";
	ПараметрыДополнительныхОбластей = Новый Структура(ОбластиСПереносами);
	Для Каждого ИмяОбласти Из СтрРазделить(ОбластиСПереносами, ",") Цикл
		ПараметрыДополнительныхОбластей.Вставить(ИмяОбласти, Новый Структура(КлючиСтруктурыДополнительныхОбластей, "ДополнительнаяСтрока", Новый Массив, 71));
	КонецЦикла;
	ПараметрыДополнительныхОбластей.Вставить("НаименованиеНаграды", Новый Структура(КлючиСтруктурыДополнительныхОбластей, "ДополнительнаяСтрокаНаграды", Новый Массив, 35));

	Для Каждого ПараметрПереноса Из ПараметрыПереносаПоСтрокам Цикл
		
		ИмяПараметра = ПараметрПереноса.Значение.ИмяПараметра;

		Для НомерСтрокиПараметра = 1 По ПараметрПереноса.Значение.КоличествоСимволовПоСтрокам.Количество()-1 Цикл
			НаименованиеПараметра = СтрШаблон("%1%2", ИмяПараметра, Строка(НомерСтрокиПараметра));
			ПараметрыПечати.Вставить(НаименованиеПараметра, "");
		КонецЦикла;
		
		ИмяОбласти = ПараметрПереноса.Ключ;
		КоличествоСимволовПоСтрокам = ПараметрПереноса.Значение.КоличествоСимволовПоСтрокам;
		
		ЗначениеПараметра = Неопределено;
		ПараметрыПечати.Свойство(ИмяПараметра, ЗначениеПараметра);
		Если ЗначениеПараметра = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеПараметра = Строка(ЗначениеПараметра);
		
		ЗаполнениеДопПараметров = Ложь;
		НомерСтрокиПараметра = 0;
		Пока Не ЗначениеПараметра = ПустаяСтрока Цикл
			
			Если Не ЗаполнениеДопПараметров И НомерСтрокиПараметра = КоличествоСимволовПоСтрокам.Количество() Тогда
				ЗаполнениеДопПараметров = Истина;
				НомерСтрокиПараметра = 0;
			КонецЕсли;

			
			КоличествоСимволовСтроки = ?(ЗаполнениеДопПараметров, ПараметрыДополнительныхОбластей[ИмяОбласти].КоличествоСимволов, Число(КоличествоСимволовПоСтрокам[НомерСтрокиПараметра]));
			ОптимальнаяПозицияСимвола = КоличествоСимволовСтроки;
			МинимальныйРазрыв = КоличествоСимволовСтроки;
			
			Если ОптимальнаяПозицияСимвола < СтрДлина(ЗначениеПараметра) Тогда
				
				Для Каждого СимволРазделитель Из СимволыРазделители Цикл
					
					ПозицияСимвола = СтрНайти(ЗначениеПараметра, СимволРазделитель, НаправлениеПоиска.СКонца, КоличествоСимволовСтроки);
					Если ПозицияСимвола = 0 Тогда
						ПозицияСимвола = СтрНайти(ЗначениеПараметра, СимволРазделитель,,КоличествоСимволовСтроки);
					КонецЕсли;
					Если ПозицияСимвола = 0 Тогда
						ПозицияСимвола = СтрДлина(ЗначениеПараметра);
					КонецЕсли;
					
					Коэффициент = ?(ПозицияСимвола>КоличествоСимволовСтроки,-1,1);
					Если Не ПозицияСимвола = 0 И (КоличествоСимволовСтроки - ПозицияСимвола)*Коэффициент < МинимальныйРазрыв Тогда
						МинимальныйРазрыв = (КоличествоСимволовСтроки - ПозицияСимвола)*Коэффициент;
						ОптимальнаяПозицияСимвола = ПозицияСимвола;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			ПереходСтроки = СтрНайти(ЗначениеПараметра, Символы.ПС);
			Если Не ПереходСтроки = 0 И ПереходСтроки < ОптимальнаяПозицияСимвола Тогда
				ОптимальнаяПозицияСимвола = ПереходСтроки;
			КонецЕсли;
			
			Если ЗаполнениеДопПараметров Тогда
				ПараметрыДополнительныхОбластей[ИмяОбласти].Параметры.Добавить(Лев(ЗначениеПараметра, ОптимальнаяПозицияСимвола));
			Иначе
				НаименованиеПараметра = СтрШаблон("%1%2", ИмяПараметра, ?(НомерСтрокиПараметра = 0, ПустаяСтрока, Строка(НомерСтрокиПараметра)));
				ПараметрыПечати.Вставить(НаименованиеПараметра, Лев(ЗначениеПараметра, ОптимальнаяПозицияСимвола));
			КонецЕсли;
			
			ЗначениеПараметра = Сред(ЗначениеПараметра, ОптимальнаяПозицияСимвола+1);
			
			НомерСтрокиПараметра = НомерСтрокиПараметра+1;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ПараметрыДополнительныхОбластей;
	
КонецФункции

Функция ДанныеПечатиНаградногоЛиста(МассивОбъектов)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПустаяДата = Дата(1,1,1);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПредставлениеКНаграде.Ссылка КАК Ссылка,
	|	ПредставлениеКНаграде.Номер КАК Номер,
	|	ПредставлениеКНаграде.Дата КАК Дата,
	|	ПредставлениеКНаграде.Организация КАК Организация,
	|	ПретендентыКНаграде.Претендент КАК Претендент,
	|	ВЫБОР
	|		КОГДА ПретендентыКНаграде.Претендент ССЫЛКА Справочник.Сотрудники
	|			ТОГДА ПретендентыКНаграде.Претендент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	КОНЕЦ КАК Сотрудник,
	|	ВЫБОР
	|		КОГДА ПретендентыКНаграде.Претендент ССЫЛКА Справочник.ФизическиеЛица
	|			ТОГДА ПретендентыКНаграде.Претендент
	|		ИНАЧЕ ЕСТЬNULL(СправочникФизическиеЛица.Ссылка, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
	|	КОНЕЦ КАК ФизическоеЛицо,
	|	ПретендентыКНаграде.ПредставитьКНаграде КАК Награда,
	|	ПРЕДСТАВЛЕНИЕ(ПретендентыКНаграде.ПредставитьКНаграде) КАК НаименованиеНаграды,
	|	ПредставлениеКНаграде.НомерПротокола КАК НомерПротокола,
	|	ПредставлениеКНаграде.ДатаПротокола КАК ДатаПротокола,
	|	ПредставлениеКНаграде.РуководительКадровогоПодразделения КАК РуководительКадровогоПодразделения,
	|	ПредставлениеКНаграде.ПредседательствующийНаОбщемСобрании КАК ПредседательствующийНаОбщемСобрании,
