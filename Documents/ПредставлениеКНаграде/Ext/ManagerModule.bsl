// Переопределяет настройки печати для объекта.
// 
// Параметры:
//  КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Наградной лист: Форма №1.
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.Идентификатор = "НаграднойЛистФорма1";
	КомандаПечати.Представление = НСтр("ru = 'Наградной лист (Форма №1)'");
	КомандаПечати.Порядок = 1;
	
	// Наградной лист: Форма №1 в формате Microsoft Word.
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.Идентификатор = "НаграднойЛистФорма1(OfficeOpenXML)";
	КомандаПечати.Представление = НСтр("ru = 'Наградной лист (Форма №1) Office Open XML'");
	КомандаПечати.Картинка = БиблиотекаКартинок.ФорматWord2007;
	КомандаПечати.Порядок = 10;
	
КонецПроцедуры

