#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ДанныеДляПроведения = ДанныеДляПроведения();
	
	ПроцессыНаграждения.СформироватьДвиженияДокументовНаграждения(Ссылка, Движения, ДанныеДляПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроцессыНаграждения.ОчиститьНаградыФизическихЛиц(Ссылка);
		
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПредставлениеКНаграде") Тогда
		
		ДанныеНовогоДокумента = Документы.Награждение.ДанныеНовогоДокумента();
		
		РеквизитыЗаполнения = "Организация,МотивПоощрения";
		ЗаполнитьЗначенияСвойств(ДанныеНовогоДокумента, ДанныеЗаполнения, РеквизитыЗаполнения);
		ДанныеНовогоДокумента.Дата = ДанныеЗаполнения.ДатаВручения;
		
		Для Каждого СтрокаПретендента Из ДанныеЗаполнения.ПретендентыКНаграждению Цикл
			Если СтрокаПретендента.Статус = Перечисления.СтатусыПредставленияКНаградам.Согласовано Тогда
				ЗаполнитьЗначенияСвойств(ДанныеНовогоДокумента.Претенденты.Добавить(), СтрокаПретендента, "Претендент,Награда");
			КонецЕсли;
		КонецЦикла;
		
		ЗаполнитьПоДаннымЗаполнения(ДанныеНовогоДокумента);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДанныеНовогоДокумента = Документы.Награждение.ДанныеНовогоДокумента();
		ЗаполнитьЗначенияСвойств(ДанныеНовогоДокумента, ДанныеЗаполнения);
		
		Если ДанныеЗаполнения.Свойство("МассивСтрок") Тогда
			Для Каждого СтрокаПретендента Из ДанныеЗаполнения.МассивСтрок Цикл
				СтрокаДокумента = ДанныеНовогоДокумента.Претенденты.Добавить();
				СтрокаДокумента.Претендент = СтрокаПретендента.Сотрудник;
				СтрокаДокумента.Награда = СтрокаПретендента.Награда;
			КонецЦикла;
		КонецЕсли;
		
		ЗаполнитьПоДаннымЗаполнения(ДанныеНовогоДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	КонтейнерОшибок = Неопределено;

	ПретендентыКНаграждениюСвернуто = ПретендентыКНаграждению.Выгрузить();
	ПретендентыКНаграждениюСвернуто.Свернуть("Претендент,Награда");
	
	Если Не ПретендентыКНаграждению.Количество() = ПретендентыКНаграждениюСвернуто.Количество() Тогда
		
		Для Каждого УникальноеНаграждение Из ПретендентыКНаграждениюСвернуто Цикл
			
			НайденныеСтроки = ПретендентыКНаграждению.НайтиСтроки(Новый Структура("Претендент,Награда", УникальноеНаграждение.Претендент, УникальноеНаграждение.Награда));
			
			Если НайденныеСтроки.Количество() > 1 Тогда
				
				ТекстСообщения = НСтр("ru = 'Обнаружено дублирование строк по комбинации сотрудника / физического лица и награды'");
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(КонтейнерОшибок, "Объект.ПретендентыКНаграждению[%1].Претендент", ТекстСообщения, "",,, ПретендентыКНаграждению.Индекс(НайденныеСтроки[НайденныеСтроки.Количество()-1]));
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(КонтейнерОшибок, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПроведения()
	
	ДанныеДляПроведения = Новый Структура();
	ПроцессыНаграждения.ЗаполнитьДанныеДляПроведенияДокументаНаграждения(ДанныеДляПроведения, Ссылка);
	
	Возврат ДанныеДляПроведения;
	
КонецФункции 

Процедура ЗаполнитьПоДаннымЗаполнения(ДанныеЗаполнения)
	
	ДанныеЗаполнения.Свойство("Дата", Дата);
	ДанныеЗаполнения.Свойство("Организация", Организация);
	ДанныеЗаполнения.Свойство("Руководитель", Руководитель);
	ДанныеЗаполнения.Свойство("ДолжностьРуководителя", ДолжностьРуководителя);
	ДанныеЗаполнения.Свойство("ОснованиеПодписиРуководителя", ОснованиеПодписиРуководителя);
	ДанныеЗаполнения.Свойство("Ответственный", Ответственный);
	ДанныеЗаполнения.Свойство("МотивПоощрения", МотивПоощрения);
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	ЗапрашиваемыеЗначения = Новый Структура;
	
	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		ЗапрашиваемыеЗначения.Вставить("Ответственный", "Ответственный");
	КонецЕсли;
	
	ФиксированныеЗначения = Новый Массив;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		ЗапрашиваемыеЗначения.Вставить("Организация", "Организация");
		
		Если НЕ ЗначениеЗаполнено(Руководитель) Тогда
			ЗапрашиваемыеЗначения.Вставить("Руководитель", "Руководитель");
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ДолжностьРуководителя) Тогда
			ЗапрашиваемыеЗначения.Вставить("ДолжностьРуководителя", "ДолжностьРуководителя");
		КонецЕсли; 
		
		ФиксированныеЗначения.Добавить("Организация");
		
	КонецЕсли;
	
	ЗарплатаКадры.ЗаполнитьЗначенияВФорме(ЭтотОбъект, ЗапрашиваемыеЗначения, ФиксированныеЗначения);
	
	ПретендентыКНаграждению.Очистить();
	
	ДанныеЗаполненияПретенденты = Неопределено;
	
	Если ДанныеЗаполнения.Свойство("Претенденты", ДанныеЗаполненияПретенденты) И ТипЗнч(ДанныеЗаполненияПретенденты) = Тип("ТаблицаЗначений") Тогда
		Для Каждого ДанныеПретендент Из ДанныеЗаполненияПретенденты Цикл
			
			Если ЗначениеЗаполнено(ДанныеПретендент.Претендент) Тогда
				
				СтрокаПретендент = ПретендентыКНаграждению.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПретендент, ДанныеПретендент);
				
				Если ЗначениеЗаполнено(СтрокаПретендент.Претендент) И ТипЗнч(СтрокаПретендент.Претендент) = Тип("СправочникСсылка.Сотрудники") Тогда
					Если СтрокаПретендент.Подразделение.Пустая() Тогда
						КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудников(Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаПретендент.Претендент), "Подразделение", Дата);
						СтрокаПретендент.Подразделение = КадровыеДанные[0].Подразделение;
					КонецЕсли;
				Иначе
					СтрокаПретендент.Подразделение = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

