#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	СотрудникиИсходные = ОбщегоНазначения.ВыгрузитьКолонку(ОценочныеОбязательстваПоСотрудникам, "Сотрудник");
	СотрудникиСвернутые = ОбщегоНазначения.ВыгрузитьКолонку(ОценочныеОбязательстваПоСотрудникам, "Сотрудник", Истина);
	
	Если СотрудникиИсходные.Количество() <> СотрудникиСвернутые.Количество() Тогда
		Для Каждого ЗначениеМассива Из СотрудникиСвернутые Цикл
			МассивСтрок = ОценочныеОбязательстваПоСотрудникам.НайтиСтроки(Новый Структура("Сотрудник", ЗначениеМассива));
			Если МассивСтрок.Количество() > 1 Тогда
				ПереченьСтрок = "";
				Для Каждого СтрокаМассива Из МассивСтрок Цикл
					ПереченьСтрок = ПереченьСтрок + ?(ПереченьСтрок = "", "", ", ") + СтрокаМассива.НомерСтроки;
				КонецЦикла;
				Для Каждого СтрокаМассива Из МассивСтрок Цикл
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='В строках %1 дублируются значения в колонке ""Сотрудник""'"),
						ПереченьСтрок);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ОценочныеОбязательстваПоСотрудникам[" + Формат(СтрокаМассива.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сотрудник", "Объект", Отказ);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеИменКолонок = Новый Соответствие;
	СоответствиеИменКолонок.Вставить("СуммаРезерва", НСтр("ru='Обязательство (резерв)'"));
	СоответствиеИменКолонок.Вставить("СуммаРезерваНУ", НСтр("ru='Обязательство (резерв) (НУ)'"));
	СоответствиеИменКолонок.Вставить("СуммаРезерваСтраховыхВзносов", НСтр("ru='Страховые взносы'"));
	СоответствиеИменКолонок.Вставить("СуммаРезерваСтраховыхВзносовНУ", НСтр("ru='Страховые взносы (НУ)'"));
	СоответствиеИменКолонок.Вставить("СуммаРезерваФССНесчастныеСлучаи", НСтр("ru='Травматизм'"));
	СоответствиеИменКолонок.Вставить("СуммаРезерваФССНесчастныеСлучаиНУ", НСтр("ru='Травматизм (НУ)'"));
	
	МассивИменКолонок = Новый Массив;
	Для Каждого ЗаписьСоответствия Из СоответствиеИменКолонок Цикл
		МассивИменКолонок.Добавить(ЗаписьСоответствия.Ключ);
	КонецЦикла;
	
	ОписаниеДокумента = Документы.ПереносРезервовМеждуСтатьямиФинансирования.ОписаниеДокумента();
	ЗаполнитьЗначенияСвойств(ОписаниеДокумента, ЭтотОбъект);
	ОписаниеДокумента.Сотрудники = ОбщегоНазначения.ВыгрузитьКолонку(ОценочныеОбязательстваПоСотрудникам, "Сотрудник", Истина);
	ОстатокРезерваУчетный = Документы.ПереносРезервовМеждуСтатьямиФинансирования.РезервыСотрудников(ОписаниеДокумента);
	Для Каждого СтрокаДокумента Из ОценочныеОбязательстваПоСотрудникам Цикл
		СтрокаТаблицы = ОстатокРезерваУчетный.Найти(СтрокаДокумента.Сотрудник, "Сотрудник");
		Если СтрокаТаблицы = Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='По сотруднику %1 остатки в учете отсутствуют'"),
					СтрокаДокумента.Сотрудник);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ОценочныеОбязательстваПоСотрудникам", "Объект", Отказ);
		Иначе
			Для Каждого ИмяПоказателя Из МассивИменКолонок Цикл
				Если СтрокаДокумента[ИмяПоказателя] > СтрокаТаблицы[ИмяПоказателя] Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='В строке %1 по сотруднику %2 в колонке ""%3"" сумма к списанию (%4) превышает доступную сумму остатка (%5)'"),
							СтрокаДокумента.НомерСтроки, СтрокаДокумента.Сотрудник, СоответствиеИменКолонок[ИмяПоказателя],Формат(СтрокаДокумента[ИмяПоказателя], "ЧДЦ=2"), Формат(СтрокаТаблицы[ИмяПоказателя], "ЧДЦ=2"));
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ОценочныеОбязательстваПоСотрудникам[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоказателя, "Объект", Отказ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ДанныеДляОтражения = РезервыПоОплатеТруда.СтруктураДанныхДляОтраженияВУчете();
	Документы.ПереносРезервовМеждуСтатьямиФинансирования.ПодготовитьДанныеДляОтраженияВУчете(Ссылка, ДанныеДляОтражения);
	РезервыПоОплатеТруда.СформироватьДвиженияПоНачислениюОбязательств(Движения, Отказ, Организация, Дата, КонецМесяца(ПериодРегистрации), ДанныеДляОтражения);
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли