// Возвращает описание состава документа
//
// Возвращаемое значение:
//  Структура - см. ЗарплатаКадрыСоставДокументов.НовоеОписаниеСоставаОбъекта.
Функция ОписаниеСоставаОбъекта() Экспорт
	
	МетаданныеДокумента = Метаданные.Документы.ПереносРезервовМеждуСтатьямиФинансирования;
	ОписаниеСостава = ЗарплатаКадрыСоставДокументов.ОписаниеСоставаОбъектаПоМетаданнымФизическиеЛицаВТабличныхЧастях(МетаданныеДокумента);
	Для Каждого ОписаниеЗаполнения Из ОписаниеСостава.ОписаниеХраненияСотрудниковФизическихЛиц Цикл
		ОписаниеЗаполнения.ВключатьВКраткийСостав = Истина;
	КонецЦикла;
	
	Возврат ОписаниеСостава;
	
КонецФункции

// Перезаполняет (и пересчитывает) данные формы документа-начисления 
// по переданным сотрудникам.
//
// Параметры:
//	Форма
//	ОписаниеДокумента - структура, описывающая документ-начисление 
//		(см. ОписаниеДокумента).
//	Сотрудники - ссылка или массив ссылок на сотрудников.
//	ИспользоватьДлительнуюОперацию.
//
Функция ПерезаполнитьДанныеФормы(Форма, Знач Сотрудники = Неопределено, ИспользоватьДлительнуюОперацию = Ложь) Экспорт
	
	СтруктураПараметров = ОписаниеДокумента();
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, Форма.Объект);
	СтруктураПараметров.Вставить("Сотрудники", Сотрудники);
	
	Если Не ИспользоватьДлительнуюОперацию Тогда
		АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, Форма.УникальныйИдентификатор);
		ПодготовитьДанныеДляПерезаполнения(СтруктураПараметров, АдресХранилища);
		Возврат Новый Структура("ЗаданиеВыполнено, АдресХранилища", Истина, АдресХранилища);
	КонецЕсли;
	
	НаименованиеЗадания = НСтр("ru = 'Заполнение документа ""Перенос резервов между статьями финансирования""'");
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		Форма.УникальныйИдентификатор,
		"Документы.ПереносРезервовМеждуСтатьямиФинансирования.ПодготовитьДанныеДляПерезаполнения",
		СтруктураПараметров,
		НаименованиеЗадания);
	
	Возврат Результат;
	
КонецФункции

Процедура ПодготовитьДанныеДляПерезаполнения(СтруктураПараметров, АдресХранилища) Экспорт
	
	Сотрудники = СтруктураПараметров.Сотрудники;
	ПериодРегистрации = СтруктураПараметров.ПериодРегистрации;
	Организация = СтруктураПараметров.Организация;
	Подразделение = СтруктураПараметров.Подразделение;
	Резерв = СтруктураПараметров.Резерв;
	СтатьяФинансированияИсточник = СтруктураПараметров.СтатьяФинансированияИсточник;
	
	Если Сотрудники = Неопределено Тогда
		Если ЗначениеЗаполнено(Подразделение) Тогда
			Сотрудники = СотрудникиПоШапкеДокумента(СтруктураПараметров);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПараметров.Сотрудники = Сотрудники;
	ДанныеЗаполнения = РезервыСотрудников(СтруктураПараметров);
	
	РезультатЗаполнения = Новый Структура;
	РезультатЗаполнения.Вставить("ОценочныеОбязательстваПоСотрудникам", ДанныеЗаполнения);
	
	ПоместитьВоВременноеХранилище(РезультатЗаполнения, АдресХранилища);
	
КонецПроцедуры

Функция ОписаниеДокумента() Экспорт
	
	ОписаниеДокумента = Новый Структура("ПериодРегистрации, Организация, Подразделение,
		|Резерв, СтатьяФинансированияИсточник, Ссылка, Сотрудники");
	
	Возврат ОписаниеДокумента;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресПараметровВХранилище(Объект, ДополнительныеПараметры) Экспорт
	
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("СериализованныйОбъект", ЗарплатаКадры.СериализоватьОбъектВДвоичныеДанные(Объект));
	
	Возврат ПоместитьВоВременноеХранилище(ПараметрыДокумента, ДополнительныеПараметры.УникальныйИдентификатор);
	
КонецФункции

Процедура ПодготовитьДанныеДляОтраженияВУчете(ДокументСсылка, ДанныеДляОтражения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПереносРезервовМеждуСтатьямиФинансирования.Организация КАК Организация,
	|	ПереносРезервовМеждуСтатьямиФинансирования.Резерв КАК Резерв,
	|	ПереносРезервовМеждуСтатьямиФинансирования.Ссылка КАК Ссылка,
	|	ПереносРезервовМеждуСтатьямиФинансирования.СтатьяФинансированияИсточник КАК СтатьяФинансирования
	|ПОМЕСТИТЬ ВТ_ОписаниеДокумента
	|ИЗ
	|	Документ.ПереносРезервовМеждуСтатьямиФинансирования КАК ПереносРезервовМеждуСтатьямиФинансирования
	|ГДЕ
	|	ПереносРезервовМеждуСтатьямиФинансирования.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОписаниеДокумента.Организация КАК Организация,
	|	ВТ_ОписаниеДокумента.Резерв КАК Резерв,
	|	ВТ_ОписаниеДокумента.Ссылка КАК Ссылка,
	|	ВТ_ОписаниеДокумента.СтатьяФинансирования КАК СтатьяФинансирования
	|ИЗ
	|	ВТ_ОписаниеДокумента КАК ВТ_ОписаниеДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОценочныеОбязательстваПоСотрудникам.Ссылка КАК Ссылка,
	|	ОценочныеОбязательстваПоСотрудникам.НомерСтроки КАК НомерСтроки,
	|	ОценочныеОбязательстваПоСотрудникам.Сотрудник КАК Сотрудник,
	|	-ОценочныеОбязательстваПоСотрудникам.СуммаРезерва КАК СуммаРезерва,
	|	-ОценочныеОбязательстваПоСотрудникам.СуммаРезерваНУ КАК СуммаРезерваНУ,
	|	-ОценочныеОбязательстваПоСотрудникам.СуммаРезерваСтраховыхВзносов КАК СуммаРезерваСтраховыхВзносов,
	|	-ОценочныеОбязательстваПоСотрудникам.СуммаРезерваСтраховыхВзносовНУ КАК СуммаРезерваСтраховыхВзносовНУ,
	|	-ОценочныеОбязательстваПоСотрудникам.СуммаРезерваФССНесчастныеСлучаи КАК СуммаРезерваФССНесчастныеСлучаи,
	|	-ОценочныеОбязательстваПоСотрудникам.СуммаРезерваФССНесчастныеСлучаиНУ КАК СуммаРезерваФССНесчастныеСлучаиНУ,
	|	ВТ_ОписаниеДокумента.Резерв КАК Резерв,
	|	ВТ_ОписаниеДокумента.СтатьяФинансирования КАК СтатьяФинансирования
	|ИЗ
	|	Документ.ПереносРезервовМеждуСтатьямиФинансирования.ОценочныеОбязательстваПоСотрудникам КАК ОценочныеОбязательстваПоСотрудникам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОписаниеДокумента КАК ВТ_ОписаниеДокумента
	|		ПО ОценочныеОбязательстваПоСотрудникам.Ссылка = ВТ_ОписаниеДокумента.Ссылка
	|ГДЕ
	|	ОценочныеОбязательстваПоСотрудникам.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_ОписаниеДокумента.Ссылка
	|			ИЗ
	|				ВТ_ОписаниеДокумента)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОписаниеДокумента.Ссылка КАК Ссылка,
	|	СтатьиФинансирования.СтатьяФинансирования КАК СтатьяФинансирования,
	|	СтатьиФинансирования.ПроцентРаспределения КАК ПроцентРаспределения
	|ИЗ
	|	Документ.ПереносРезервовМеждуСтатьямиФинансирования.СтатьиФинансирования КАК СтатьиФинансирования
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОписаниеДокумента КАК ВТ_ОписаниеДокумента
	|		ПО СтатьиФинансирования.Ссылка = ВТ_ОписаниеДокумента.Ссылка
	|ГДЕ
	|	СтатьиФинансирования.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_ОписаниеДокумента.Ссылка
	|			ИЗ
	|				ВТ_ОписаниеДокумента)";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОписаниеДокумента = Результат[1].Выгрузить();
	ОценочныеОбязательстваПоСотрудникам = Результат[2].Выгрузить();
	СтатьиФинансирования = Результат[3].Выгрузить();
	
	СписокКолонок = "СуммаРезерва,СуммаРезерваНУ,СуммаРезерваСтраховыхВзносов,СуммаРезерваСтраховыхВзносовНУ,СуммаРезерваФССНесчастныеСлучаи,СуммаРезерваФССНесчастныеСлучаиНУ";
	МассивИменКолонок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СписокКолонок, , Истина, Истина);
	
	МассивКоэффициентов = Новый Массив;
	Для Каждого СтрокаТаблицы Из СтатьиФинансирования Цикл
		МассивКоэффициентов.Добавить(СтрокаТаблицы.ПроцентРаспределения);
	КонецЦикла;
	
	ОценочныеОбязательстваПоСотрудникамВрем = ОценочныеОбязательстваПоСотрудникам.СкопироватьКолонки();
	Для Каждого СтрокаТаблицы Из ОценочныеОбязательстваПоСотрудникам Цикл
		Для Каждого ИмяПоказателя Из МассивИменКолонок Цикл
			МассивНовыхСумм = РезервыПоОплатеТруда.РаспределитьПропорционально(СтрокаТаблицы[ИмяПоказателя], МассивКоэффициентов);
			Если МассивНовыхСумм = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИндексСтроки = 0;
			КоличествоСтрок = МассивНовыхСумм.Количество();
			Пока ИндексСтроки < КоличествоСтрок Цикл
				НоваяСтрока = ОценочныеОбязательстваПоСотрудникамВрем.Добавить();
				НоваяСтрока.Сотрудник = СтрокаТаблицы.Сотрудник;
				НоваяСтрока.Резерв = СтрокаТаблицы.Резерв;
				НоваяСтрока.СтатьяФинансирования = СтатьиФинансирования[ИндексСтроки].СтатьяФинансирования;
				НоваяСтрока[ИмяПоказателя] = - МассивНовыхСумм[ИндексСтроки];
				ИндексСтроки = ИндексСтроки + 1;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ОценочныеОбязательстваПоСотрудникамВрем.Свернуть("Резерв, Сотрудник, СтатьяФинансирования", СписокКолонок);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ОценочныеОбязательстваПоСотрудникамВрем, ОценочныеОбязательстваПоСотрудникам);
	
	ДанныеДляОтражения.ОценочныеОбязательстваПоСотрудникам = ОценочныеОбязательстваПоСотрудникам;
	ДанныеДляОтражения.ОценочныеОбязательства = ОценочныеОбязательстваПоСотрудникам;
	
КонецПроцедуры

Функция СотрудникиПоШапкеДокумента(СтруктураПараметров)
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.Организация = СтруктураПараметров.Организация;
	ПараметрыПолучения.КадровыеДанные = "Организация,Подразделение";
	Если ЗначениеЗаполнено(СтруктураПараметров.Подразделение) Тогда
		ПараметрыПолучения.Подразделение = СтруктураПараметров.Подразделение;
	КонецЕсли;
	ПараметрыПолучения.НачалоПериода = СтруктураПараметров.ПериодРегистрации;
	ПараметрыПолучения.ОкончаниеПериода = КонецМесяца(СтруктураПараметров.ПериодРегистрации);
	
	КадровыеДанные = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыПолучения);
	Если ЗначениеЗаполнено(СтруктураПараметров.Подразделение) Тогда
		КадровыеДанныеВременная = КадровыеДанные.Скопировать(Новый Структура("Подразделение", СтруктураПараметров.Подразделение));
		Для Каждого СтрокаТаблицы Из КадровыеДанные Цикл
			Если СтрокаТаблицы.Организация <> СтруктураПараметров.Организация Тогда
				ЗаполнитьЗначенияСвойств(КадровыеДанныеВременная.Добавить(), СтрокаТаблицы);
			КонецЕсли;
		КонецЦикла;
		КадровыеДанные = КадровыеДанныеВременная.Скопировать();
	КонецЕсли;
	
	Сотрудники = ОбщегоНазначения.ВыгрузитьКолонку(КадровыеДанные, "Сотрудник", Истина);
	
	Возврат Сотрудники;
	
КонецФункции

Функция РезервыСотрудников(СтруктураПараметров) Экспорт
	
	НачалоПериода = НачалоМесяца(СтруктураПараметров.ПериодРегистрации);
	КонецПериода = Новый Граница(Новый МоментВремени(КонецМесяца(СтруктураПараметров.ПериодРегистрации)),ВидГраницы.Включая);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("Резерв", СтруктураПараметров.Резерв);
	Запрос.УстановитьПараметр("СтатьяФинансированияИсточник", СтруктураПараметров.СтатьяФинансированияИсточник);
	Запрос.УстановитьПараметр("Сотрудники", СтруктураПараметров.Сотрудники);
	Запрос.УстановитьПараметр("Ссылка", СтруктураПараметров.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОценочныеОбязательстваПоСотрудникамОстатки.Сотрудник КАК Сотрудник,
	|	ОценочныеОбязательстваПоСотрудникамОстатки.СуммаРезерваОстаток КАК СуммаРезерва,
	|	ОценочныеОбязательстваПоСотрудникамОстатки.СуммаРезерваНУОстаток КАК СуммаРезерваНУ,
