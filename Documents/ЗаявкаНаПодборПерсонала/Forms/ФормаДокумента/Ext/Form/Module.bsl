&НаСервере
Процедура ПриПолученииДанныхНаСервере(ТекущийОбъект = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = Объект;
	КонецЕсли;
	
	ПрочитатьСогласованиеВакансии(ТекущийОбъект);
	УстановитьПанельСведенийСогласования(ТекущийОбъект);
	УстановитьДоступностьПозицииДолжности();
	
	ХарактеристикиПерсоналаФормы.ЗаполнитьКартинкуИВидХарактеристикиТаблицыХарактеристик(Характеристики);
	
	ПодразделениеОрганизации = ПодразделениеОрганизации(Объект.Подразделение);
	
	ДанныеПозиции = ДанныеПозицииШтатногоРасписания(Объект.Позиция);
	Если ОхранаТруда.ОхранаТрудаИспользуется() Тогда
		УстановитьВидимостьРабочегоМеста(ЭтотОбъект);
		УстановитьДоступностьРабочегоМеста(ЭтотОбъект); 
		СписокРабочихМест = СписокРабочихМестПоДаннымПозиции(ДанныеПозиции);
		Элементы.РабочееМесто.СписокВыбора.ЗагрузитьЗначения(СписокРабочихМест.ВыгрузитьЗначения());
	Иначе
		Элементы.РабочееМесто.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПодразделениеОрганизации(Подразделение)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "Источник")
	
КонецФункции

&НаСервере
Процедура УстановитьПанельСведенийСогласования(ТекущийОбъект = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = Объект;
	КонецЕсли;
	
	СостоянияСогласования = Новый Массив;
	СостоянияСогласования.Добавить(Перечисления.СостоянияСогласования.Согласовано);
	СостоянияСогласования.Добавить(Перечисления.СостоянияСогласования.Отклонено);
	
	// Работа с заявкой пока не завершена - не отображаем панель согласования.
	Если СостоянияСогласования.Найти(Согласование.СостояниеСогласования) = Неопределено Тогда
		Элементы.ГруппаСостояниеСогласования.Видимость = Ложь;
		Возврат;
	Иначе
		Элементы.ГруппаСостояниеСогласования.Видимость = Истина;
	КонецЕсли;
	
	Если Согласование.СостояниеСогласования = Перечисления.СостоянияСогласования.Отклонено Тогда
		Элементы.ГруппаСостояниеСогласования.ЦветФона = ЦветаСтиля.ЦветФонаОтрицательногоЗначения;
		Элементы.ДекорацияСогласованиеКартинка.Картинка = БиблиотекаКартинок.СостоянияРасширенийОшибка;
		Элементы.ДатаРассмотрения.Заголовок = "Отклонена";
	ИначеЕсли Согласование.СостояниеСогласования = Перечисления.СостоянияСогласования.Согласовано Тогда
		Элементы.ГруппаСостояниеСогласования.ЦветФона = ЦветаСтиля.ЦветФонаПоложительногоЗначения;
		Элементы.ДекорацияСогласованиеКартинка.Картинка = БиблиотекаКартинок.СостоянияРасширенийПодключено; 
		Элементы.ДатаРассмотрения.Заголовок = "Согласована";
	КонецЕсли;
	
	Если ПравоДоступа("Чтение", Метаданные.Справочники.Вакансии) Тогда
		// Если открыта вакансия, то показываем еще и поле с вакансией.
		ОтборПоЗаявке = Новый Структура("Основание", ТекущийОбъект.Ссылка);
		Вакансии = Справочники.Вакансии.ВакансииПоОтбору(ОтборПоЗаявке);
		Если Вакансии.Количество() > 0 Тогда
			Вакансия = Вакансии[0];
		КонецЕсли;
		Элементы.Вакансия.Видимость = ЗначениеЗаполнено(Вакансия);
	Иначе
		Элементы.Вакансия.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаполнениеПоДаннымПрофиля()
	
	ЗаголовокВопроса = НСтр("ru = 'Заявка будет заполнена по данным профиля должности'");
	ТекстВопроса = НСтр("ru = 'Обязанности, требования, условия, - будут заменены аналогичными сведениями из профиля.
                         |Продолжить?'");
	
	Если ИспользоватьЭлектронноеИнтервью Тогда
		ТекстВопроса = НСтр("ru = 'Обязанности, требования, условия, функции и требования к характеристикам, - будут заменены аналогичными сведениями из профиля.
	                         |Продолжить?'");
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьЗаполнениеПоДаннымПрофиля", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗаполнениеПоДаннымПрофиля(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписаниеИзПрофиляДолжности();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписаниеИзПрофиляДолжности()
	
	Если Не ЗначениеЗаполнено(Объект.ПрофильДолжности) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПолучения = Справочники.ПрофилиДолжностей.ПараметрыПолученияДанныхПрофиляДолжности();
	ПараметрыПолучения.ЭтапыРаботыСКандидатами = Ложь;
	
	ДанныеПрофиля = Справочники.ПрофилиДолжностей.ДанныеПрофиляДолжности(Объект.ПрофильДолжности, ПараметрыПолучения);
	
	Если ДанныеПрофиля.Свойство("ХарактеристикиПерсонала") Тогда
		Объект.ХарактеристикиПерсонала.Очистить();
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДанныеПрофиля.ХарактеристикиПерсонала, Объект.ХарактеристикиПерсонала);
		ПрочитатьХарактеристикиВТаблицы();
	КонецЕсли;
	
	Если ДанныеПрофиля.Свойство("ДействияСотрудников") Тогда
		Объект.ДействияСотрудников.Очистить();
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДанныеПрофиля.ДействияСотрудников, Объект.ДействияСотрудников);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ДанныеПрофиля,
		"Требования,
		|Обязанности,
		|Условия,
		|ИспытательныйСрок,
		|ЗарплатаОт,
		|ЗарплатаДо,
		|ВалютаЗарплаты,
		|ПериодичностьЗарплаты,
		|ТипЗанятости,
		|РежимРаботы");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеПозицииШтатногоРасписания(Позиция)
	Возврат Справочники.ШтатноеРасписание.ДанныеПозицииШтатногоРасписания(Позиция);
КонецФункции

&НаСервере
Процедура ПрочитатьХарактеристикиВТаблицы()
	
	ХарактеристикиПерсоналаФормы.ПрочитатьХарактеристикиВТаблицы(Объект.ХарактеристикиПерсонала, Характеристики, ЗначенияХарактеристики);	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПодразделения()
	
	Если Не ЗначениеЗаполнено(Объект.Позиция) Или Объект.НазначениеНабора =
		Перечисления.НазначениеНабораПерсоналаНаВакансию.ДолжностьПодразделение Тогда
		ТолькоПросмотрПодразделения = Ложь;
	Иначе
		ТолькоПросмотрПодразделения = Истина;
	КонецЕсли;
	
	ЗаполнитьПодразделение();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Подразделение", "ТолькоПросмотр", ТолькоПросмотрПодразделения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодразделение()
	
	ДанныеПозиции = Справочники.ШтатноеРасписание.ДанныеПозицииШтатногоРасписания(Объект.Позиция);
	
	Если ЗначениеЗаполнено(ДанныеПозиции.МестоВСтруктуреПредприятия) Тогда
		Объект.Подразделение = ДанныеПозиции.МестоВСтруктуреПредприятия;
	КонецЕсли;
	
	ПодразделениеОрганизации = ПодразделениеОрганизации(Объект.Подразделение);
	
КонецПроцедуры

#Область ДобавлениеХарактеристик

&НаСервере
Процедура ДобавитьХарактеристикиИзДействийНаСервере(МассивДобавленныхДействий) Экспорт
	
	ДобавляемыеХарактеристики = ХарактеристикиПерсонала.МассивСтруктурХарактеристикСоЗначениямиИзДействий(МассивДобавленныхДействий);
	ХарактеристикиПерсоналаФормы.ДобавитьХарактеристикиСоЗначениями(Характеристики, ЗначенияХарактеристики, ДобавляемыеХарактеристики);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьХарактеристикиПерсоналаНаКлиенте(НовыеХарактеристики, ДополнительныеПараметры = Неопределено) Экспорт
	ДобавитьХарактеристикиПерсоналаНаСервере(НовыеХарактеристики, ДополнительныеПараметры);
КонецПроцедуры

&НаСервере
Процедура ДобавитьХарактеристикиПерсоналаНаСервере(НовыеХарактеристики, ДополнительныеПараметры)
	ХарактеристикиПерсоналаФормы.ДобавитьХарактеристикиВТабличнуюЧасть(ЭтотОбъект, НовыеХарактеристики, ДополнительныеПараметры);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоДействийСотрудников(СписокДействий)
	
	ДеревоДействий = ЭлектронноеИнтервью.ДеревоДействийСотрудников(СписокДействий);
	
	ЗначениеВДанныеФормы(ДеревоДействий, ДействияСотрудниковДерево);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодборФункций()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ХарактеристикаПерсонала", Объект.Ссылка);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("АдресПодобранных", АдресПодобранныхФункций());
	
	ОткрытьФорму("Справочник.ДействияСотрудников.Форма.ФормаСписка", ПараметрыФормы, Элементы.ДействияСотрудников);
	
КонецПроцедуры

&НаСервере
Функция АдресПодобранныхФункций()
	Возврат ПоместитьВоВременноеХранилище(Объект.ДействияСотрудников.Выгрузить().ВыгрузитьКолонку("ДействиеСотрудника"));
КонецФункции

#КонецОбласти

#Область УстановкаСвойствЭлементовФормы

&НаСервере
Процедура УстановитьДоступностьРедактирования()
	
	Если ТолькоПросмотр Тогда
		
		Элементы.ГруппаРедактироватьОсновное.Видимость = Ложь;
		Элементы.ГруппаРедактироватьОбязанности.Видимость = Ложь;
		Элементы.ГруппаРедактироватьТребования.Видимость = Ложь;
		Элементы.ГруппаРедактироватьУсловия.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРабочегоМеста(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если ЭтоМассовыйНабор(Объект.СпособНабора) Тогда
		Элементы.РабочееМесто.Видимость = Ложь;
		Форма.РабочееМестоПредыдущееЗначение = Объект.РабочееМесто;
		Объект.РабочееМесто = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если Объект.НоваяПозиция Тогда
		Элементы.РабочееМесто.Видимость = Ложь;
		Форма.РабочееМестоПредыдущееЗначение = Объект.РабочееМесто;
		Объект.РабочееМесто = Неопределено;
		Возврат;
	КонецЕсли;
	
	Элементы.РабочееМесто.Видимость = Истина;
	Если ЗначениеЗаполнено(Форма.РабочееМестоПредыдущееЗначение) Тогда
		Объект.РабочееМесто = Форма.РабочееМестоПредыдущееЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРабочегоМеста(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Не ЗначениеЗаполнено(Объект.Позиция) Тогда
		Элементы.РабочееМесто.Доступность = Ложь;
		Объект.РабочееМесто = Неопределено;
	Иначе
		Элементы.РабочееМесто.Доступность = Истина;
	КонецЕсли
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоМассовыйНабор(СпособНабора)
	
	Если СпособНабора = ПредопределенноеЗначение("Перечисление.СпособНабораПерсоналаНаВакансию.МассовыйНабор") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область СогласованиеВакансий

&НаСервере
Процедура ПрочитатьСогласованиеВакансии(ТекущийОбъект = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = Объект;
	КонецЕсли;
	
	Если ТекущийОбъект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.СогласованиеВакансий.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Вакансия.Установить(ТекущийОбъект.Ссылка);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Согласование, НаборЗаписей[0]);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСогласованиеВакансий") Тогда
		Если Не ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СогласованиеВакансий.Команды.Согласовать) Тогда
			ТолькоПросмотр = Перечисления.СостоянияСогласования.РешениеПринято(Согласование.СостояниеСогласования);
		КонецЕсли;
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОповещениеСогласованияВакансий(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия <> "СогласованиеВакансий_Завершено" Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметр.Найти(Объект.Ссылка) = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ПрочитатьСогласованиеВакансии();
	УстановитьПанельСведенийСогласования();
	
КонецПроцедуры

#КонецОбласти

#Область РабочееМесто

&НаКлиенте
Процедура ОбработатьОповещениеРабочегоМеста(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия <> "Запись_РабочиеМестаОхраныТруда" Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПозиции = ДанныеПозицииШтатногоРасписания(Объект.Позиция);
	СписокРабочихМест = СписокРабочихМестПоДаннымПозиции(ДанныеПозиции);
	Элементы.РабочееМесто.СписокВыбора.ЗагрузитьЗначения(СписокРабочихМест.ВыгрузитьЗначения());
	
	Если СписокРабочихМест.НайтиПоЗначению(Источник) <> Неопределено Тогда
		Объект.РабочееМесто = Источник;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокРабочихМестПоДаннымПозиции(ДанныеПозиции);
	
	СписокРабочихМест = Новый СписокЗначений;
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.РабочиеМестаОхраныТруда") Тогда
		МодульРабочиеМестаОхраныТруда = ОбщегоНазначения.ОбщийМодуль("РабочиеМестаОхраныТруда");
		СписокРабочихМест = МодульРабочиеМестаОхраныТруда.РабочиеМестаПоПодразделениюИДолжности(
		ДанныеПозиции.Подразделение,
		ДанныеПозиции.Должность,
		ДанныеПозиции.Организация);
	КонецЕсли;
	
	Возврат СписокРабочихМест;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРабочееМесто(Форма, СписокРабочихМест)
	
	Если Не ЗначениеЗаполнено(СписокРабочихМест) Тогда
		Возврат;
	КонецЕсли;
	
	Если СписокРабочихМест.Количество() = 1 Тогда
		Форма.Объект.РабочееМесто = СписокРабочихМест[0].Значение;
	Иначе
		Форма.Объект.РабочееМесто = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Описание

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОписание(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЗаполнитьНазвание(Объект, Элементы);
	ЗаполнитьПриоритет(Объект.Приоритет, Элементы);
	ЗаполнитьОбязанности(Объект.Обязанности, Элементы);
	ЗаполнитьТребования(Объект.Требования, Элементы);
	ЗаполнитьУсловия(Объект.Условия, Элементы);
	
	УстановитьВидимостьИспытательногоСрока(Объект, Элементы);
	УстановитьВидимостьОплатыТруда(Объект, Элементы);
	УстановитьВидимостьРежимаРаботы(Объект, Элементы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНазвание(Заявка, Элементы)
	
	Если Заявка.НазначениеНабора =
		ПредопределенноеЗначение("Перечисление.НазначениеНабораПерсоналаНаВакансию.ПозицияШтатногоРасписания")
		И ЗначениеЗаполнено(Заявка.Позиция) Тогда
		Название = Заявка.Позиция;
	ИначеЕсли ЗначениеЗаполнено(Заявка.Должность) Тогда
		Название = Заявка.Должность;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Название) Тогда
		Название = Заявка.Подразделение;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Название) Тогда
		Название = НСтр("ru = 'Название заявки'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияНазвание", "Заголовок", Название);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПриоритет(Приоритет, Элементы)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияПриоритет", "Заголовок",
		СтрШаблон(НСтр("ru = '(%1 приоритет)'"), Приоритет));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОбязанности(Обязанности, Элементы)
	
	Если ЗначениеЗаполнено(Обязанности) Тогда
		Заголовок = Обязанности;
	Иначе
		Заголовок = НСтр("ru = 'Обязанности не указаны'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияОбязанности", "Заголовок", Заголовок);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТребования(Требования, Элементы)
	
	Если ЗначениеЗаполнено(Требования) Тогда
		Заголовок = Требования;
	Иначе
		Заголовок = НСтр("ru = 'Требования не указаны'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияТребования", "Заголовок", Заголовок);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьУсловия(Условия, Элементы)
	
	Если ЗначениеЗаполнено(Условия) Тогда
		Заголовок = Условия;
	Иначе 
		Заголовок = НСтр("ru = 'Условия не указаны'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияУсловия", "Заголовок", Заголовок);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьИспытательногоСрока(Объект, Элементы)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ИспытательныйСрокЧтение", "Видимость", ЗначениеЗаполнено(Объект.ИспытательныйСрок));
	
	УстановитьЗаголовкиИспытательныйСрок(Объект, Элементы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОплатыТруда(Объект, Элементы)
	
	ЗаполненаЗарплатаОт = ЗначениеЗаполнено(Объект.ЗарплатаОт);
	ЗаполненаЗарплатаДо = ЗначениеЗаполнено(Объект.ЗарплатаДо);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЗарплатаОтЧтение", "Видимость", ЗаполненаЗарплатаОт);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЗарплатаДоЧтение", "Видимость", ЗаполненаЗарплатаДо);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияОплатаТруда", "Видимость", ЗаполненаЗарплатаОт Или ЗаполненаЗарплатаДо);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВалютаЗарплатыЧтение", "Видимость", ЗаполненаЗарплатаОт Или ЗаполненаЗарплатаДо);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПериодичностьЗарплатыЧтение", "Видимость", ЗаполненаЗарплатаОт Или ЗаполненаЗарплатаДо);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРежимаРаботы(Объект, Элементы)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ТипЗанятостиЧтение", "Видимость", ЗначениеЗаполнено(Объект.ТипЗанятости));
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "РежимРаботыЧтение", "Видимость", ЗначениеЗаполнено(Объект.РежимРаботы));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИспытательныйСрок(Объект, Элементы)
	
	Заглловок = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru = ';месяц;;месяца;месяцев;'"), Объект.ИспытательныйСрок);
	
	Элементы.ИспытательныйСрок.Подсказка = Заглловок;
	Элементы.ИспытательныйСрокЧтение.Подсказка = Заглловок;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПозицииДолжности()
	
	Если Объект.НазначениеНабора =
		Перечисления.НазначениеНабораПерсоналаНаВакансию.ДолжностьПодразделение Тогда
		Объект.НоваяПозиция = Истина;
	Иначе
		Объект.НоваяПозиция = Ложь;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Позиция", "Доступность", Не Объект.НоваяПозиция);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Должность", "Доступность", Объект.НоваяПозиция);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПричинуОткрытия()
	
	Если Объект.НазначениеНабора =
		Перечисления.НазначениеНабораПерсоналаНаВакансию.ДолжностьПодразделение Тогда
		Объект.ПричинаОткрытия = Справочники.ПричиныОткрытияВакансий.НайтиПоНаименованию("Новая позиция", Истина);
	Иначе
		Объект.ПричинаОткрытия = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоПозиции()
	
	ДанныеПозиции = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Позиция, "Должность,КоличествоСтавок");
	Объект.Должность = ДанныеПозиции.Должность;
	ПрофилиДолжностей = ХарактеристикиПерсонала.ПрофильДолжностиПоПозицииШтатногоРасписания(Объект.Позиция);
	
	Если ПрофилиДолжностей.Количество() > 0 Тогда
		Объект.ПрофильДолжности = ПрофилиДолжностей[0];
	Иначе
		Объект.ПрофильДолжности = Неопределено;
		Объект.НеобходимоЧеловек = 1;
		Возврат;
	КонецЕсли;
	
	Позиции = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Позиция);
	СвободныеПозицииШтатногоРасписания = УправлениеШтатнымРасписанием.СвободныеПозицииШтатногоРасписания(Позиции);
	СвободноСтавокПоПричине = СвободныеПозицииШтатногоРасписания.Получить(Объект.Позиция);
	
	Если СвободноСтавокПоПричине <> Неопределено Тогда
		СвободноСтавок = СвободноСтавокПоПричине.СвободноСтавок;
		Объект.НеобходимоЧеловек = СвободноСтавок;
		Объект.ПричинаОткрытия = ПричинаОткрытия(СвободноСтавокПоПричине.Причина);
	Иначе
		Объект.НеобходимоЧеловек = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоДолжности()
	
	ПрофилиПоКадровойДолжности = Справочники.ПрофилиДолжностей.ПрофилиПоКадровойДолжности(Объект.Должность);
	Если ПрофилиПоКадровойДолжности.Количество() > 0 Тогда
		Объект.ПрофильДолжности = ПрофилиПоКадровойДолжности[0];
	Иначе
		Объект.ПрофильДолжности = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПричинаОткрытия(Основание)
	
	ТипЗнчОснования = ТипЗнч(Основание);
	Если ТипЗнчОснования = Тип("ДокументСсылка.Увольнение")
		Или ТипЗнчОснования = Тип("ДокументСсылка.УвольнениеСписком") Тогда
		ПричинаОткрытия = Справочники.ПричиныОткрытияВакансий.НайтиПоНаименованию("Увольнение", Истина);
	ИначеЕсли ТипЗнчОснования = Тип("ДокументСсылка.ОтпускПоУходуЗаРебенком") Тогда
		ПричинаОткрытия = Справочники.ПричиныОткрытияВакансий.НайтиПоНаименованию("Отпуск по уходу за ребенком", Истина);
	ИначеЕсли ТипЗнчОснования = Тип("ДокументСсылка.КадровыйПеревод")
		Или ТипЗнчОснования = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда
		ПричинаОткрытия = Справочники.ПричиныОткрытияВакансий.НайтиПоНаименованию("Внутренний перевод", Истина);
	Иначе
		ПричинаОткрытия = Неопределено;
	КонецЕсли;
	
	Возврат ПричинаОткрытия;
	
КонецФункции

#КонецОбласти

#КонецОбласти
