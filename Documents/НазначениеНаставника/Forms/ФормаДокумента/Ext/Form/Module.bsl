КонецПроцедуры

&НаСервере
Функция АдресВХранилищеНачисленийИУдержаний()
	
	ПараметрыОткрытия = ЗарплатаКадрыРасширенныйКлиентСервер.ПараметрыРедактированияСоставаНачисленийИУдержаний();
	
	ПараметрыОткрытия.ВладелецНачисленийИУдержаний = Объект.Наставник;
	ПараметрыОткрытия.ДатаРедактирования = ВремяРегистрации;
	ПараметрыОткрытия.Организация = Объект.Организация;
	ПараметрыОткрытия.РежимРаботы = 3;
	ПараметрыОткрытия.ДополнитьНедостающиеЗначенияПоказателей = Истина;
	
	ДополнитьСтруктуруНачислениямиИПоказателями(ПараметрыОткрытия);
	
	Возврат ПоместитьВоВременноеХранилище(ПараметрыОткрытия, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ДополнитьСтруктуруНачислениямиИПоказателями(ПараметрыОткрытия)
	
	МассивНачислений = Новый Массив;
	МассивПоказателей = Новый Массив;
	
	ИдентификаторСтрокиВидаРасчета = 1;
	
	// Добавление всех начислений сотрудника (кроме начисления шапки).
	Для Каждого СтрокаНачислений Из Объект.Начисления Цикл
		
		СтруктураНачисления = Новый Структура("Начисление,ДокументОснование,Действие,ИдентификаторСтрокиВидаРасчета,Размер");
		ЗаполнитьЗначенияСвойств(СтруктураНачисления, СтрокаНачислений);
		СтруктураНачисления.ИдентификаторСтрокиВидаРасчета = ИдентификаторСтрокиВидаРасчета;
		МассивНачислений.Добавить(СтруктураНачисления);
		
		// Добавление показателей доплаты за наставничество.
		Если СтрокаНачислений.Начисление = Объект.Начисление И СтрокаНачислений.ДокументОснование = Объект.Ссылка Тогда
			
			Для Каждого ОписаниеПоказателя Из Объект.Показатели Цикл
				СтруктураПоказателя = Новый Структура("Показатель,ИдентификаторСтрокиВидаРасчета,Значение");
				СтруктураПоказателя.Показатель = ОписаниеПоказателя.Показатель;
				СтруктураПоказателя.ИдентификаторСтрокиВидаРасчета = ИдентификаторСтрокиВидаРасчета;
				СтруктураПоказателя.Значение = ОписаниеПоказателя.Значение;
				МассивПоказателей.Добавить(СтруктураПоказателя);
			КонецЦикла;
			
		КонецЕсли;
		
		ИдентификаторСтрокиВидаРасчета = ИдентификаторСтрокиВидаРасчета + 1;
		
	КонецЦикла;
	
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.Используется = Истина;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.Таблица = МассивНачислений;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.ИзменятьСоставВидовРасчета = Ложь;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.ИзменятьЗначенияПоказателей = Ложь;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.НомерТаблицы = 1;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.ПоказатьФОТ = Истина;
	
	ПараметрыОткрытия.Показатели = МассивПоказателей;
	
КонецПроцедуры

&НаСервере
Процедура НазначитьДоплатуПриИзмененииНаСервере()
	ОбновитьДоступностьЭлементовФормы(ЭтотОбъект);
	Объект.Начисление = ПланыВидовРасчета.Начисления.ПустаяСсылка();
	НачислениеПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НазначитьДоплатуПриИзменении(Элемент)
	НазначитьДоплатуПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НаставникНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	НаставничествоКлиент.ВыбратьНаставника(ЭтаФорма, Элемент, Объект.Дата);
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияОРуководителе()
	
	КадровыеДанные = "РуководительСтруктурногоПодразделения";
	СписокПроверяемыхОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Наставляемый);
	ПериодКадровыхДанных = КонецДня(Объект.ДатаНачала);
	
	Если ТипЗнч(Объект.Наставляемый) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		
		ПараметрыПолученияСотрудников = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
		ПараметрыПолученияСотрудников.КадровыеДанные = КадровыеДанные;
		ПараметрыПолученияСотрудников.ОкончаниеПериода = ПериодКадровыхДанных;
		ПараметрыПолученияСотрудников.СписокФизическихЛиц = СписокПроверяемыхОбъектов;
		ДанныеСотрудников = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыПолученияСотрудников);
	
	ИначеЕсли ТипЗнч(Объект.Наставляемый) = Тип("СправочникСсылка.Сотрудники") Тогда
		
		ДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(Истина, СписокПроверяемыхОбъектов, КадровыеДанные, ПериодКадровыхДанных);
		
	Иначе
		
		ДанныеСотрудников = Новый Массив;
		
	КонецЕсли;
	
	НаставникЯвляетсяРуководителем = Ложь;
	Для Каждого СтрокаДанныхСотрудника Из ДанныеСотрудников Цикл
		Если СтрокаДанныхСотрудника.РуководительСтруктурногоПодразделения = Объект.Наставник
			ИЛИ ТипЗнч(СтрокаДанныхСотрудника.РуководительСтруктурногоПодразделения) = Тип("СправочникСсылка.Сотрудники")
				И СтрокаДанныхСотрудника.РуководительСтруктурногоПодразделения.ФизическоеЛицо = Объект.Наставник Тогда
			Сотрудник = СтрокаДанныхСотрудника.Сотрудник;
			НаставникЯвляетсяРуководителем = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НаставникЯвляетсяРуководителем Тогда
		СведенияОТекущемРуководителе = СтрШаблон(НСтр("ru='Наставник %1 является руководителем сотрудника %2'"), Объект.Наставник, Сотрудник);
	Иначе
		СведенияОТекущемРуководителе = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

