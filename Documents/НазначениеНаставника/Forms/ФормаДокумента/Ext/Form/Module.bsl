&НаСервере
Функция НастройкиОтчетаДействующиеНаставники()

	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчеты.ОтчетыПоНаставничеству.ПолучитьМакет("ДействующиеНаставники")));
	
	ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Наставник", Объект.Наставник);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПериодОтчета", Объект.ДатаНачала);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);

	ВариантОтчета = ВариантыОтчетов.ВариантОтчета(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Отчеты.ОтчетыПоНаставничеству), "ДействующиеНаставники");
	
	НастройкиОтчета = Новый Структура;
	НастройкиОтчета.Вставить("ВариантОтчета", ВариантОтчета);
	НастройкиОтчета.Вставить("ПараметрыФормы", ПараметрыФормы);
	
	Возврат НастройкиОтчета;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьКоличествоТекущихНаставляемых()
	
	Если Объект.Наставник = Неопределено Тогда
		
		КоличествоНазначенийНаставником = 0;
		
	Иначе
		
		ПараметрыПолучения = Наставничество.ПараметрыПолученияНазначенийНаставников();
		ПараметрыПолучения.Период = Объект.ДатаНачала;
		ПараметрыПолучения.СписокНаставников = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Наставник);
		ПараметрыПолучения.ИсключитьДвиженияДокумента = Объект.Ссылка;
		
		ДанныеДействующихНаставников = Наставничество.ДанныеДействующихНаставников(ПараметрыПолучения);
		
		Если ДанныеДействующихНаставников = Неопределено Тогда
			КоличествоНазначенийНаставником = 0;
		Иначе
			КоличествоНазначенийНаставником = ДанныеДействующихНаставников.Количество();
		КонецЕсли;
		
	КонецЕсли;
	
	Если КоличествоНазначенийНаставником = 0 Тогда
		ДанныеОТекущемНаставничестве = "";
	ИначеЕсли Число(Прав(Строка(КоличествоНазначенийНаставником), 1)) = 1 И Не КоличествоНазначенийНаставником = 11 Тогда
		ДанныеОТекущемНаставничестве = СтрШаблон(НСтр("ru='На %1 уже назначен наставником в %2 документе'"), Формат(Объект.ДатаНачала, "ДЛФ=D"), КоличествоНазначенийНаставником);
	Иначе
		ДанныеОТекущемНаставничестве = СтрШаблон(НСтр("ru='На %1 уже назначен наставником в %2 документах'"), Формат(Объект.ДатаНачала, "ДЛФ=D"), КоличествоНазначенийНаставником);
	КонецЕсли;
	
КонецПроцедуры

