// Возвращает описание состава документа
//
// Возвращаемое значение:
//  Структура - см. ЗарплатаКадрыСоставДокументов.НовоеОписаниеСоставаОбъекта.
Функция ОписаниеСоставаОбъекта() Экспорт
	
	ОписаниеСостава = ЗарплатаКадрыСоставДокументов.НовоеОписаниеСоставаОбъекта();
	ОписаниеСостава.ЗаполнятьФизическиеЛицаПоСотрудникам = Ложь;
	ОписаниеСостава.ИспользоватьКраткийСостав = Ложь;
	
	ЗарплатаКадрыСоставДокументов.ДобавитьОписаниеХраненияСотрудниковФизическихЛиц(
		ОписаниеСостава.ОписаниеХраненияСотрудниковФизическихЛиц,
		,
		,
		"Наставник");
	
	ЗарплатаКадрыСоставДокументов.ДобавитьОписаниеХраненияСотрудниковФизическихЛиц(
		ОписаниеСостава.ОписаниеХраненияСотрудниковФизическихЛиц,
		,
		,
		"Наставляемый");
	
	Возврат ОписаниеСостава;
	
КонецФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	Если Пользователи.РолиДоступны("ДобавлениеИзменениеДанныхДляНачисленияЗарплатыРасширенная, ЧтениеДанныхДляНачисленияЗарплатыРасширенная", , Ложь) Тогда
		// Приказ о наставничестве
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
		КомандаПечати.МенеджерПечати = "Документ.НазначениеНаставника";
		КомандаПечати.Идентификатор = "ПФ_MXL_ПриказОНаставничестве";
		КомандаПечати.Представление = НСтр("ru = 'Приказ о назначении работника наставником'");
		КомандаПечати.Порядок = 20;
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
		КомандаПечати.ДополнительныеПараметры.Вставить("ТребуетсяЧтениеБезОграничений", Истина);
		
		// Дополнительное соглашение
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
		КомандаПечати.МенеджерПечати = "Документ.НазначениеНаставника";
		КомандаПечати.Идентификатор = "ПФ_MXL_ДополнительноеСоглашениеОНаставничестве";
		КомандаПечати.Представление = НСтр("ru = 'Дополнительное соглашение об осуществлении наставничества'");
		КомандаПечати.Порядок = 20;
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
		КомандаПечати.ДополнительныеПараметры.Вставить("ТребуетсяЧтениеБезОграничений", Истина);
		
		// Предложение об установлении наставничества
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
		КомандаПечати.МенеджерПечати = "Документ.НазначениеНаставника";
		КомандаПечати.Идентификатор = "ПФ_MXL_ПредложениеОНаставничестве";
		КомандаПечати.Представление = НСтр("ru = 'Предложение об установлении наставничества'");
		КомандаПечати.Порядок = 20;
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
		КомандаПечати.ДополнительныеПараметры.Вставить("ТребуетсяЧтениеБезОграничений", Истина);
	КонецЕсли;

КонецПроцедуры

// Формирует печатные формы
//
// Параметры:
//  (входные)
//    МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//    ПараметрыПечати - Структура - дополнительные настройки печати;
//  (выходные)
//   КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы.
//   ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                             представление - имя области в которой был выведен объект;
//   ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ПриказОНаставничестве") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПриказОНаставничестве",
			НСтр("ru = 'Приказ о назначении работника наставником'"), ПечатьПриказаОНаставничестве(МассивОбъектов, ОбъектыПечати), ,
			"Документ.НазначениеНаставника.ПФ_MXL_ПриказОНаставничестве");
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ДополнительноеСоглашениеОНаставничестве") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ДополнительноеСоглашениеОНаставничестве",
			НСтр("ru = 'Дополнительное соглашение об осуществлении наставничества'"), ПечатьСоглашенияОНаставничестве(МассивОбъектов, ОбъектыПечати), ,
			"Документ.НазначениеНаставника.ПФ_MXL_ДополнительноеСоглашениеОНаставничестве");
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ПредложениеОНаставничестве") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПредложениеОНаставничестве",
			НСтр("ru = 'Предложение об установлении наставничества'"), ПечатьПредложенияОНаставничестве(МассивОбъектов, ОбъектыПечати), ,
			"Документ.НазначениеНаставника.ПФ_MXL_ПредложениеОНаставничестве");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Печать

Функция ПечатьПриказаОНаставничестве(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_НазначениеНаставника_Приказ";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.НазначениеНаставника.ПФ_MXL_ПриказОНаставничестве");
	
	ДанныеПечатиОбъектов = ДанныеПечатиДокументов(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеПечати Из ДанныеПечатиОбъектов Цикл
		
		// Документы нужно выводить на разных страницах.
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		Иначе
			ПервыйДокумент = Ложь;
		КонецЕсли;	
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Шапка = Макет.ПолучитьОбласть("Шапка");
		Шапка.Параметры.Заполнить(ДанныеПечати.Значение);
		ТабличныйДокумент.Вывести(Шапка);
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Значение.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьПредложенияОНаставничестве(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_НазначениеНаставника_Предложение";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.НазначениеНаставника.ПФ_MXL_ПредложениеОНаставничестве");
	
	ДанныеПечатиОбъектов = ДанныеПечатиДокументов(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеПечати Из ДанныеПечатиОбъектов Цикл
		
		// Документы нужно выводить на разных страницах.
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		Иначе
			ПервыйДокумент = Ложь;
		КонецЕсли;	
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Шапка = Макет.ПолучитьОбласть("Шапка");
		Шапка.Параметры.Заполнить(ДанныеПечати.Значение);
		ТабличныйДокумент.Вывести(Шапка);
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Значение.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьСоглашенияОНаставничестве(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_НазначениеНаставника_ДополнительноеСоглашение";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.НазначениеНаставника.ПФ_MXL_ДополнительноеСоглашениеОНаставничестве");
	
	ДанныеПечатиОбъектов = ДанныеПечатиДокументов(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеПечати Из ДанныеПечатиОбъектов Цикл
		
		// Документы нужно выводить на разных страницах.
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		Иначе
			ПервыйДокумент = Ложь;
		КонецЕсли;	
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Шапка = Макет.ПолучитьОбласть("Шапка");
		Шапка.Параметры.Заполнить(ДанныеПечати.Значение);
		ТабличныйДокумент.Вывести(Шапка);
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Значение.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ДанныеПечатиДокументов(МассивОбъектов)
	
	ДанныеПечатиОбъектов = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НазначениеНаставника.Ссылка КАК Ссылка,
	|	НазначениеНаставника.Номер КАК Номер,
	|	НазначениеНаставника.Дата КАК Дата,
	|	НазначениеНаставника.Организация КАК Организация,
	|	НазначениеНаставника.Организация.НаименованиеПолное КАК НазваниеОрганизации,
	|	НазначениеНаставника.Наставник КАК Наставник,
	|	НазначениеНаставника.ФизическоеЛицо КАК ФизическоеЛицо,
	|	НазначениеНаставника.Наставляемый КАК Наставляемый,
	|	НазначениеНаставника.ДатаНачала КАК ДатаНачала,
	|	НазначениеНаставника.ДатаОкончания КАК ДатаОкончания,
	|	НазначениеНаставника.Руководитель КАК Руководитель,
	|	НазначениеНаставника.ДолжностьРуководителя КАК ДолжностьРуководителя,
	|	НазначениеНаставника.Начисление КАК Начисление,
	|	НазначениеНаставника.РуководительПодразделения КАК РуководительПодразделения,
	|	НазначениеНаставника.ДолжностьРуководителяПодразделения КАК ДолжностьРуководителяПодразделения
	|ПОМЕСТИТЬ ВТДанныеПриказаОНаставничестве
	|ИЗ
	|	Документ.НазначениеНаставника КАК НазначениеНаставника
	|ГДЕ
	|	НазначениеНаставника.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДанныеПриказаОНаставничестве.Наставник КАК Сотрудник,
	|	ВТДанныеПриказаОНаставничестве.ДатаНачала КАК Период,
	|	ВТДанныеПриказаОНаставничестве.Начисление КАК Начисление,
	|	ВТДанныеПриказаОНаставничестве.Ссылка КАК ДокументОснование
	|ПОМЕСТИТЬ ВТСотрудникиПериоды
	|ИЗ
	|	ВТДанныеПриказаОНаставничестве КАК ВТДанныеПриказаОНаставничестве
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДанныеПриказаОНаставничестве.Ссылка КАК Ссылка,
	|	ВТДанныеПриказаОНаставничестве.Номер КАК Номер,
	|	ВТДанныеПриказаОНаставничестве.Дата КАК Дата,
	|	ВТДанныеПриказаОНаставничестве.Организация КАК Организация,
	|	ВТДанныеПриказаОНаставничестве.НазваниеОрганизации КАК НазваниеОрганизации,
	|	ВТДанныеПриказаОНаставничестве.Наставник КАК Сотрудник,
	|	ВТДанныеПриказаОНаставничестве.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТДанныеПриказаОНаставничестве.Наставляемый КАК Наставляемый,
	|	ВТДанныеПриказаОНаставничестве.ДатаНачала КАК ДатаНачала,
	|	ВТДанныеПриказаОНаставничестве.ДатаОкончания КАК ДатаОкончания,
	|	ВТДанныеПриказаОНаставничестве.Руководитель КАК Руководитель,
	|	ВТДанныеПриказаОНаставничестве.ДолжностьРуководителя КАК ДолжностьРуководителя,
	|	ВТДанныеПриказаОНаставничестве.Начисление КАК Начисление,
	|	ВТДанныеПриказаОНаставничестве.РуководительПодразделения КАК РуководительПодразделения,
	|	ВТДанныеПриказаОНаставничестве.ДолжностьРуководителяПодразделения КАК ДолжностьРуководителяПодразделения
	|ИЗ
	|	ВТДанныеПриказаОНаставничестве КАК ВТДанныеПриказаОНаставничестве";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	ИменаДополнительныхПолей = Новый Структура;
	ИменаДополнительныхПолей.Вставить("ИмяПоляНачисление", "Начисление");
	ИменаДополнительныхПолей.Вставить("ИмяПоляДокументОснование", "ДокументОснование");
	ТаблицаНачислений = КадровыйУчет.ТаблицаНачисленийСотрудниковПоВременнойТаблице(Запрос.МенеджерВременныхТаблиц, "ВТСотрудникиПериоды", , , , Ложь, Истина,, ИменаДополнительныхПолей);

	Для Каждого ДокументДляПечати Из РезультатЗапроса Цикл
		
		ДанныеПечати = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДокументДляПечати);
		ДанныеПечати.Вставить("РуководительПодразделенияСокращенно", Строка(ДанныеПечати.РуководительПодразделения));
		ДанныеПечати.Вставить("ФИОРуководителяСокращенное", Строка(ДанныеПечати.Руководитель));
		ДанныеПечати.Вставить("ФИОРуководителяСклоняемое", Строка(ДанныеПечати.Руководитель));
		ДанныеПечати.Вставить("ДатаНачала", Формат(ДанныеПечати.ДатаНачала, "ДЛФ=DD"));
		ДанныеПечати.Вставить("ДатаОкончания", Формат(ДанныеПечати.ДатаОкончания, "ДЛФ=DD"));
		ДанныеПечати.Дата = Формат(ДанныеПечати.Дата, "ДЛФ=D");
		
		// Подготовка номера документа.
		ДанныеПечати.Номер = КадровыйУчетРасширенный.НомерКадровогоПриказа(ДанныеПечати.Номер);
		
		Если ЗначениеЗаполнено(ДанныеПечати.Руководитель) Тогда
			
			ДанныеФизическогоЛица = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеПечати.Руководитель), 
				"Фамилия, Имя, Отчество, Пол", ДокументДляПечати.Дата);
			
			Если ДанныеФизическогоЛица.Количество() > 0 Тогда
				
				ДанныеФИО = Новый Структура("Фамилия,Имя,Отчество");
				ЗаполнитьЗначенияСвойств(ДанныеФИО, ДанныеФизическогоЛица[0]);
				
				ДанныеПечати.ФИОРуководителяСокращенное = ФизическиеЛицаЗарплатаКадры.РасшифровкаПодписи(ДанныеФИО);
				
				Если ДанныеФизическогоЛица[0].Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
					ДанныеПечати.Вставить("Действующего", НСтр("ru = 'действующего'"));
				Иначе
					ДанныеПечати.Вставить("Действующего", НСтр("ru = 'действующей'"));
				КонецЕсли;
				
				ФизическиеЛицаЗарплатаКадры.Просклонять(ДанныеПечати.ФИОРуководителяСклоняемое,
					2, ДанныеПечати.ФИОРуководителяСклоняемое, ДанныеФизическогоЛица[0].Пол, ДанныеФизическогоЛица[0].ФизическоеЛицо);
				
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеПечати.РуководительПодразделения) Тогда
			
			ДанныеФизическогоЛица = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеПечати.РуководительПодразделения), 
				"Фамилия, Имя, Отчество, Пол", ДокументДляПечати.Дата);
			
			Если ДанныеФизическогоЛица.Количество() > 0 Тогда
				
				ДанныеФИО = Новый Структура("Фамилия,Имя,Отчество");
				ЗаполнитьЗначенияСвойств(ДанныеФИО, ДанныеФизическогоЛица[0]);
				
				ДанныеПечати.РуководительПодразделенияСокращенно = ФизическиеЛицаЗарплатаКадры.РасшифровкаПодписи(ДанныеФИО);
				
			КонецЕсли;
		КонецЕсли;
		
		// Юридический адрес организации.
		ДанныеПечати.Вставить("АдресОрганизации", УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			ДанныеПечати.Организация,
			Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
			ДокументДляПечати.Дата));
		
		// Данные наставника.
		ДанныеСотрудника = КадровыйУчет.КадровыеДанныеСотрудников(
			Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументДляПечати.Сотрудник), 
			"ТрудовойДоговорНомер, ТрудовойДоговорДата, Должность", ДокументДляПечати.ДатаНачала);
			
		Если ТипЗнч(ДокументДляПечати.Сотрудник) = Тип("СправочникСсылка.Сотрудники") Тогда
				
			ДанныеФизическогоЛица = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументДляПечати.Сотрудник.ФизическоеЛицо), 
				"ФИОПолные, Пол, АдресПоПропискеПредставление, ДокументВид, ДокументСерия, ДокументНомер", ДокументДляПечати.ДатаНачала);
				
		ИначеЕсли ТипЗнч(ДокументДляПечати.Сотрудник) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
				
			ДанныеФизическогоЛица = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументДляПечати.Сотрудник), 
				"ФИОПолные, Пол, АдресПоПропискеПредставление, ДокументВид, ДокументСерия, ДокументНомер", ДокументДляПечати.ДатаНачала);
		КонецЕсли;
			
		ДанныеПечати.Вставить("ФИОСотрудникаСокращенное", ДанныеФизическогоЛица[0].ФИОПолные);

		Если ДанныеФизическогоЛица.Количество() > 0 Тогда
				
			ДанныеПечати.Вставить("ФИОСотрудника", ДанныеФизическогоЛица[0].ФИОПолные);
			ДанныеПечати.Вставить("ФИОСотрудникаСокращенное", ДанныеФизическогоЛица[0].ФИОПолные);
			ДанныеПечати.Вставить("ФИОСотрудникаРодительный", ДанныеФизическогоЛица[0].ФИОПолные);
			ДанныеПечати.Вставить("ФИОСотрудникаДательный", ДанныеФизическогоЛица[0].ФИОПолные);
			ДанныеПечати.Вставить("ФИОСотрудникаВинительный", ДанныеФизическогоЛица[0].ФИОПолные);
			ДанныеПечати.Вставить("ФИОСотрудникаТворительный", ДанныеФизическогоЛица[0].ФИОПолные);
			ДанныеПечати.Вставить("АдресСотрудника", ДанныеФизическогоЛица[0].АдресПоПропискеПредставление);
			ДанныеПечати.Вставить("ДокументВид", ДанныеФизическогоЛица[0].ДокументВид);
			ДанныеПечати.Вставить("ДокументСерия", ДанныеФизическогоЛица[0].ДокументСерия);
			ДанныеПечати.Вставить("ДокументНомер", ДанныеФизическогоЛица[0].ДокументНомер);
			
			ФизическиеЛицаЗарплатаКадры.Просклонять(Строка(ДанныеПечати.ФИОСотрудникаРодительный),
				2, ДанныеПечати.ФИОСотрудникаРодительный, ДанныеФизическогоЛица[0].Пол, ДанныеФизическогоЛица[0].ФизическоеЛицо);
			ФизическиеЛицаЗарплатаКадры.Просклонять(Строка(ДанныеПечати.ФИОСотрудникаДательный),
				3, ДанныеПечати.ФИОСотрудникаДательный, ДанныеФизическогоЛица[0].Пол, ДанныеФизическогоЛица[0].ФизическоеЛицо);
			ФизическиеЛицаЗарплатаКадры.Просклонять(Строка(ДанныеПечати.ФИОСотрудникаВинительный),
				4, ДанныеПечати.ФИОСотрудникаВинительный, ДанныеФизическогоЛица[0].Пол, ДанныеФизическогоЛица[0].ФизическоеЛицо);
			ФизическиеЛицаЗарплатаКадры.Просклонять(Строка(ДанныеПечати.ФИОСотрудникаТворительный),
				5, ДанныеПечати.ФИОСотрудникаТворительный, ДанныеФизическогоЛица[0].Пол, ДанныеФизическогоЛица[0].ФизическоеЛицо);
			
			ДанныеПечати.ФИОСотрудникаСокращенное = ФизическиеЛицаЗарплатаКадры.РасшифровкаПодписи(ДанныеПечати.ФИОСотрудникаСокращенное);
			
			Если ДанныеФизическогоЛица[0].Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				ДанныеПечати.Вставить("Именуемый", НСтр("ru = 'именуемый'"));
				ДанныеПечати.Вставить("Занимающий", НСтр("ru = 'занимающий'"));
			Иначе
				ДанныеПечати.Вставить("Именуемый", НСтр("ru = 'именуемая'"));
				ДанныеПечати.Вставить("Занимающий", НСтр("ru = 'занимающая'"));
			КонецЕсли;
			
		КонецЕсли;
		
		Если ДанныеСотрудника.Количество() > 0 Тогда
			ДанныеПечати.Вставить("НомерДоговора", ДанныеСотрудника[0].ТрудовойДоговорНомер);
			ДанныеПечати.Вставить("ДатаДоговора", Формат(ДанныеСотрудника[0].ТрудовойДоговорДата, "ДЛФ=D"));
			ДанныеПечати.Вставить("ДатаДоговораПолная", Формат(ДанныеСотрудника[0].ТрудовойДоговорДата, "ДЛФ=DD"));
			ДанныеПечати.Вставить("ДолжностьСотрудника", ДанныеСотрудника[0].Должность);
			ДанныеПечати.Вставить("ДолжностьСотрудникаРодительный",
				СклонениеПредставленийОбъектов.ПросклонятьПредставление(НРег(ДанныеПечати.ДолжностьСотрудника), 2));
			ДанныеПечати.Вставить("ДолжностьСотрудникаВинительный",
				СклонениеПредставленийОбъектов.ПросклонятьПредставление(НРег(ДанныеПечати.ДолжностьСотрудника), 4));
		КонецЕсли;
		
		// Данные наставляемого.
		ДанныеСотрудника = КадровыйУчет.КадровыеДанныеСотрудников(
			Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументДляПечати.Наставляемый), 
			"Должность", ДокументДляПечати.Дата);
		
		Если ТипЗнч(ДокументДляПечати.Наставляемый) = Тип("СправочникСсылка.Сотрудники") Тогда
				
			ДанныеФизическогоЛица = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументДляПечати.Наставляемый.ФизическоеЛицо), 
				"ФИОПолные, Пол", ДокументДляПечати.ДатаНачала);
				
			ФизическоеЛицо = ДанныеФизическогоЛица[0].ФизическоеЛицо;
				
		ИначеЕсли ТипЗнч(ДокументДляПечати.Наставляемый) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
				
			ДанныеФизическогоЛица = КадровыйУчет.КадровыеДанныеФизическихЛиц(
				Истина, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументДляПечати.Наставляемый), 
				"ФИОПолные, Пол", ДокументДляПечати.ДатаНачала);

			ФизическоеЛицо = ДанныеФизическогоЛица[0].ФизическоеЛицо;
				
		ИначеЕсли ТипЗнч(ДокументДляПечати.Наставляемый) = Тип("СправочникСсылка.Кандидаты") Тогда
			
			ДанныеФизическогоЛица = Новый Массив;
			
			ЛичныеДанныеКандидатов = Справочники.Кандидаты.ЛичныеДанныеКандидатов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументДляПечати.Наставляемый));
			ДанныеКандидата = ЛичныеДанныеКандидатов.Получить(ДокументДляПечати.Наставляемый);
			
			Если Не ДанныеКандидата= Неопределено Тогда
				ДанныеФизическогоЛица.Добавить(Новый Структура("ФИОПолные, Пол", ДанныеКандидата.ФИО, ДанныеКандидата.Пол));
			КонецЕсли;
				
			ФизическоеЛицо = Неопределено;
				
		КонецЕсли;
		
		Если ДанныеФизическогоЛица.Количество() > 0 Тогда
			ДанныеПечати.Вставить("ФИОНаставляемого", ДанныеФизическогоЛица[0].ФИОПолные);
			ДанныеПечати.Вставить("ФИОНаставляемогоРодительный", ДанныеФизическогоЛица[0].ФИОПолные);
			
			ФизическиеЛицаЗарплатаКадры.Просклонять(Строка(ДанныеПечати.ФИОНаставляемогоРодительный),
				2, ДанныеПечати.ФИОНаставляемогоРодительный, ДанныеФизическогоЛица[0].Пол, ФизическоеЛицо);
		КонецЕсли;
				
		Если ДанныеСотрудника.Количество() > 0 Тогда
			ДанныеПечати.Вставить("ДолжностьНаставляемого", ДанныеСотрудника[0].Должность);
			ДанныеПечати.Вставить("ДолжностьНаставляемогоРодительный",
				СклонениеПредставленийОбъектов.ПросклонятьПредставление(НРег(ДанныеПечати.ДолжностьНаставляемого), 2));
		КонецЕсли;
		
		// Оплата труда
		ОплатаТруда = "";
		СтрокиНачислений = ТаблицаНачислений.НайтиСтроки(Новый Структура("Сотрудник,Период", ДокументДляПечати.Сотрудник, ДокументДляПечати.ДатаНачала));
		Если СтрокиНачислений.Количество() = 0 Тогда
			
			ОплатаТруда = НСтр("ru='без доплаты'");
			
		Иначе
			
			Если ЗначениеЗаполнено(СтрокиНачислений[0].Надбавка) Тогда
				ОплатаТруда = ?(ПустаяСтрока(ОплатаТруда), "", ОплатаТруда + "; ") + СтрокиНачислений[0].Надбавка;
			КонецЕсли;
			
		КонецЕсли;
		ДанныеПечати.Вставить("ОплатаТруда", ОплатаТруда);
		
		Если Не ЗначениеЗаполнено(ДанныеПечати.ФИОРуководителяСклоняемое) Тогда
			ДанныеПечати.ФИОРуководителяСклоняемое =  "__________________________________";
		КонецЕсли;
		
		Если Не ДанныеПечати.Свойство("Именуемый") Тогда
			ДанныеПечати.Вставить("Именуемый", НСтр("ru = 'именуемый(ая)'"));
		КонецЕсли;
		Если Не ДанныеПечати.Свойство("Занимающий") Тогда
			ДанныеПечати.Вставить("Занимающий", НСтр("ru = 'занимающим(ей)'"));
		КонецЕсли;
		Если Не ДанныеПечати.Свойство("Действующего") Тогда
			ДанныеПечати.Вставить("Действующего", НСтр("ru = 'действующего(ей)'"));
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДанныеПечати.ФИОСотрудникаСокращенное) Тогда
			ДанныеПечати.ФИОСотрудникаСокращенное = "_________________";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДанныеПечати.ФИОРуководителяСокращенное) Тогда
			ДанныеПечати.ФИОРуководителяСокращенное = "_________________";
		КонецЕсли;
		ДанныеПечати.Вставить("Дата", Формат(ДокументДляПечати.Дата, "ДЛФ=DD"));
		ДанныеПечати.Вставить("НазваниеОрганизации", ДокументДляПечати.НазваниеОрганизации);
		
		// Заполнение соответствия
		ДанныеПечатиОбъектов.Вставить(ДокументДляПечати.Ссылка, ДанныеПечати);
		
	КонецЦикла;
	
	Возврат ДанныеПечатиОбъектов;
	
КонецФункции

#КонецОбласти

// Функция возвращает структуру с описанием данного вида документа.
//
Функция ОписаниеДокумента() Экспорт 

	ОписаниеДокумента = ЗарплатаКадрыРасширенныйКлиентСервер.СтруктураОписанияДокумента();
	
	ОписаниеДокумента.КраткоеНазваниеИменительныйПадеж	 = НСтр("ru = 'назначение наставника'");
	ОписаниеДокумента.КраткоеНазваниеРодительныйПадеж	 = НСтр("ru = 'назначения наставника'");
	ОписаниеДокумента.ИмяРеквизитаСотрудник				 = "Наставник";
	ОписаниеДокумента.ИмяРеквизитаДатаНачалаСобытия		 = "ДатаНачала";
	ОписаниеДокумента.ИмяРеквизитаДатаОкончанияСобытия	 = "ДатаОкончания";
	
	Возврат ОписаниеДокумента;

КонецФункции

#Область ПодписиДокументов

Функция ОписаниеПодписейДокумента() Экспорт
	
	ОписаниеПодписей = ПодписиДокументов.ОписаниеТаблицыПодписей();
	ПереопределяемыеИменаРеквизитов = Новый Соответствие;
	
	ОписаниеРеквизитовПодписанта = ПодписиДокументов.ОписаниеРеквизитовПодписанта();
	ОписаниеРеквизитовПодписанта.ФизическоеЛицо = "Руководитель";
	ОписаниеРеквизитовПодписанта.Должность = "ДолжностьРуководителя";
	ОписаниеРеквизитовПодписанта.ОснованиеПодписи = "ОснованиеПодписиРуководителя";
	ПереопределяемыеИменаРеквизитов.Вставить("Руководитель", ОписаниеРеквизитовПодписанта);
	
	ОписаниеРеквизитовПодписанта = ПодписиДокументов.ОписаниеРеквизитовПодписанта();
	ОписаниеРеквизитовПодписанта.ФизическоеЛицо = "РуководительПодразделения";
	ОписаниеРеквизитовПодписанта.Должность = "ДолжностьРуководителяПодразделения";
	ОписаниеРеквизитовПодписанта.ОснованиеПодписи = "ОснованиеПодписиРуководителяПодразделения";
	ПереопределяемыеИменаРеквизитов.Вставить("РуководительПодразделения", ОписаниеРеквизитовПодписанта);
	
	ПодписиДокументов.ДобавитьОписаниеПодписейОрганизации(
		ОписаниеПодписей,
		"Руководитель,РуководительПодразделения",
		ПереопределяемыеИменаРеквизитов);
		
	Возврат ОписаниеПодписей;
	
КонецФункции

#КонецОбласти

Процедура ЗаполнитьДатуЗапретаРедактирования(ОбъектДокумента) Экспорт
	
	ЗарплатаКадры.ЗаполнитьДатуЗапретаРедактирования(ОбъектДокумента, "ДатаНачала");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли