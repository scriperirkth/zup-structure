Процедура ВыгрузитьИнформациюОРебенке10910(Документ, МенеджерXML, УзелПособие, ВидПособия)
	// Пример: МенеджерXML.ДобавитьУзел(Родитель, Имя, Значение = Неопределено, МожетОтсутствовать = Ложь, МожетБытьНеопределено = Ложь).
	
	УзелРебенок = МенеджерXML.ДобавитьУзел(УзелПособие, "childInfo");
	
	// СНИЛС.
	МенеджерXML.ДобавитьУзел(УзелРебенок, "snils", УбратьПробелы(Документ.РебенокСНИЛС), Истина, Ложь);
	
	// ФИО.
	УзелФИО = МенеджерXML.ДобавитьУзел(УзелРебенок, "fullName");
	СЭДОФСС.ЗаписатьФИОXML(МенеджерXML, УзелФИО, Документ.РебенокФамилия, Документ.РебенокИмя, Документ.РебенокОтчество);
	
	// Дата рождения.
	МенеджерXML.ДобавитьУзел(УзелРебенок, "birthDate", Документ.РебенокДатаРождения);
	
	// Пол.
	Пол = ?(Документ.РебенокПол = Перечисления.ПолФизическогоЛица.Женский, "FEMALE", "MALE");
	МенеджерXML.ДобавитьУзел(УзелРебенок, "gender", Пол, Истина);
	
	// Код связи с ребенком: для 4го пособия - мать, отец, опекун; для 5го пособия - мать, отец, иной родственник, опекун.
	РебенокКодСвязи = Документ.РебенокКодСвязи;
	// С переездом на ЕЦП код 41 "Попечитель" заменен на 50 "Усыновитель".
	Если РебенокКодСвязи = "41" Тогда
		РебенокКодСвязи = "50";
	КонецЕсли;
	МенеджерXML.ДобавитьУзел(УзелПособие, "childRelType", РебенокКодСвязи);
КонецПроцедуры

Процедура ВыгрузитьОснованияДляНазначенияОтпускаПоУходу10910(Документ, МенеджерXML, УзелПособие, ВидПособия)
	УзелОснования = МенеджерXML.ДобавитьУзел(УзелПособие, "baseDocuments");
	
	ЕстьСвидетельство = ЗначениеЗаполнено(Документ.СвидетельствоОРожденииСерия)
		И ЗначениеЗаполнено(Документ.СвидетельствоОРожденииНомер)
		И ЗначениеЗаполнено(Документ.СвидетельствоОРожденииДатаВыдачи);
	ЕстьАктоваяЗапись = ЗначениеЗаполнено(Документ.АктоваяЗаписьОРожденииНомер)
		И ЗначениеЗаполнено(Документ.АктоваяЗаписьОРожденииДата);
	ЕстьИнойДокумент = ЗначениеЗаполнено(Документ.ИнойДокументОРожденииДатаВыдачи)
		И ЗначениеЗаполнено(Документ.ИнойДокументОРожденииНомер);
	
	Если ЕстьСвидетельство Или Не ЕстьИнойДокумент Тогда
		
		// Свидетельство о рождении.
		УзелСвидетельство = МенеджерXML.ДобавитьУзел(УзелОснования, "birthCertificate");
		МенеджерXML.ДобавитьУзел(УзелСвидетельство, "person:series", Документ.СвидетельствоОРожденииСерия);
		МенеджерXML.ДобавитьУзел(УзелСвидетельство, "person:number", Документ.СвидетельствоОРожденииНомер);
		МенеджерXML.ДобавитьУзел(УзелСвидетельство, "person:issueDate", Документ.СвидетельствоОРожденииДатаВыдачи);
		
		// Актовая запись ЗАГС.
		Если ЕстьАктоваяЗапись Тогда
			УзелЗАГС = МенеджерXML.ДобавитьУзел(УзелОснования, "birthRecord");
			МенеджерXML.ДобавитьУзел(УзелЗАГС, "person:number", Документ.АктоваяЗаписьОРожденииНомер);
			МенеджерXML.ДобавитьУзел(УзелЗАГС, "person:issueDate", Документ.АктоваяЗаписьОРожденииДата);
		КонецЕсли;
		
	Иначе
		
		// Иной документ подтверждающий рождение ребенка.
		УзелИное = МенеджерXML.ДобавитьУзел(УзелОснования, "birthDocOtherCountry");
		МенеджерXML.ДобавитьУзел(УзелИное, "person:series", Документ.ИнойДокументОРожденииСерия, Истина, Ложь);
		МенеджерXML.ДобавитьУзел(УзелИное, "person:number", Документ.ИнойДокументОРожденииНомер);
		МенеджерXML.ДобавитьУзел(УзелИное, "person:issueDate", Документ.ИнойДокументОРожденииДатаВыдачи);
		МенеджерXML.ДобавитьУзел(УзелИное, "person:country", Документ.ИнойДокументОРожденииКодСтраны);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьОснованияДляНазначенияПособияПриРождении10910(Документ, МенеджерXML, УзелПособие, ВидПособия)
	// Пример: МенеджерXML.ДобавитьУзел(Родитель, Имя, Значение = Неопределено, МожетОтсутствовать = Ложь, МожетБытьНеопределено = Ложь).
	УзелОснования = МенеджерXML.ДобавитьУзел(УзелПособие, "baseDocuments");
	
	ЕстьСправка = ЗначениеЗаполнено(Документ.СправкаОРожденииФорма)
		И ЗначениеЗаполнено(Документ.СправкаОРожденииНомер);
	ЕстьАктоваяЗапись = ЗначениеЗаполнено(Документ.АктоваяЗаписьОРожденииНомер)
		И ЗначениеЗаполнено(Документ.АктоваяЗаписьОРожденииДата);
	ЕстьИнойДокумент = ЗначениеЗаполнено(Документ.ИнойДокументОРожденииДатаВыдачи)
		И ЗначениеЗаполнено(Документ.ИнойДокументОРожденииНомер);
	
	Если ЕстьСправка Тогда
		
		// Справка о рождении и актовая запись.
		УзелОснования2 = МенеджерXML.ДобавитьУзел(УзелОснования, "birthReferenceDocs");
		
		// Справка о рождении.
		УзелИное = МенеджерXML.ДобавитьУзел(УзелОснования2, "birthReference");
		МенеджерXML.ДобавитьУзел(УзелИное, "person:number", Документ.СправкаОРожденииНомер);
		МенеджерXML.ДобавитьУзел(УзелИное, "person:issueDate", Документ.СправкаОРожденииДатаВыдачи);
		КодФормы = Перечисления.ФормыСправкиОРожденииРебенка.КодЗначения(Документ.СправкаОРожденииФорма);
		МенеджерXML.ДобавитьУзел(УзелИное, "person:refType", КодФормы);
		
		// Актовая запись (реестровая запись) о рождении.
		Если ЕстьАктоваяЗапись Тогда
			УзелЗАГС = МенеджерXML.ДобавитьУзел(УзелОснования2, "birthRecord");
			МенеджерXML.ДобавитьУзел(УзелЗАГС, "person:number", Документ.АктоваяЗаписьОРожденииНомер);
			МенеджерXML.ДобавитьУзел(УзелЗАГС, "person:issueDate", Документ.АктоваяЗаписьОРожденииДата);
		КонецЕсли;
		
	ИначеЕсли ЕстьАктоваяЗапись Тогда
		
		// Актовая запись (реестровая запись) о рождении.
		УзелЗАГС = МенеджерXML.ДобавитьУзел(УзелОснования, "birthRecord");
		МенеджерXML.ДобавитьУзел(УзелЗАГС, "person:number", Документ.АктоваяЗаписьОРожденииНомер);
		МенеджерXML.ДобавитьУзел(УзелЗАГС, "person:issueDate", Документ.АктоваяЗаписьОРожденииДата);
		
	ИначеЕсли ЕстьИнойДокумент Тогда
		
		// Иной документ, подтверждающий рождение ребёнка. Для детей, рождённых за рубежом.
		УзелИное = МенеджерXML.ДобавитьУзел(УзелОснования, "birthDocOtherCountry");
		МенеджерXML.ДобавитьУзел(УзелИное, "person:series", Документ.ИнойДокументОРожденииСерия, Истина, Ложь);
		МенеджерXML.ДобавитьУзел(УзелИное, "person:number", Документ.ИнойДокументОРожденииНомер);
		МенеджерXML.ДобавитьУзел(УзелИное, "person:issueDate", Документ.ИнойДокументОРожденииДатаВыдачи);
		МенеджерXML.ДобавитьУзел(УзелИное, "person:country", Документ.ИнойДокументОРожденииКодСтраны);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьИзвещениеСФР10910(Документ, МенеджерXML, КореньXML, ВидПособия)
	Если Не ЗначениеЗаполнено(Документ.ИзвещениеСФРНомер) Или Не ЗначениеЗаполнено(Документ.ИзвещениеСФРДата) Тогда
