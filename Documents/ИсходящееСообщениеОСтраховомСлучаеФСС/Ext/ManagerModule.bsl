Процедура ВыгрузитьВидДоговора10910(Документ, МенеджерXML, УзелПособие, ВидПособия)
	УзелДоговоры = МенеджерXML.ДобавитьУзел(УзелПособие, "contractsInfo");
	Если ВидПособия.Числом = 1 Или ВидПособия.Числом = 6 Тогда
		Если Документ.ВидДоговораТрудовой И Не Документ.ВидДоговораГПХ Тогда
			УзелТД = МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:workerContract");
			Если ЗначениеЗаполнено(Документ.СрочныйДоговорДатаНачала) Тогда
				УзелПериод = МенеджерXML.ДобавитьУзел(УзелТД, "proactive:period");
				МенеджерXML.ДобавитьУзел(УзелПериод, "common:begin", Документ.СрочныйДоговорДатаНачала);
				МенеджерXML.ДобавитьУзел(УзелПериод, "common:end", Документ.СрочныйДоговорДатаОкончания, Истина, Ложь);
			КонецЕсли;
		ИначеЕсли Не Документ.ВидДоговораТрудовой И Документ.ВидДоговораГПХ Тогда
			УзелГПХ = МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:GPHcontract");
			УзелПериод = МенеджерXML.ДобавитьУзел(УзелГПХ, "proactive:period");
			МенеджерXML.ДобавитьУзел(УзелПериод, "proactive:begin", Документ.СрочныйДоговорДатаНачала);
			МенеджерXML.ДобавитьУзел(УзелПериод, "proactive:end", Документ.СрочныйДоговорДатаОкончания, Истина, Ложь);
			Если ВидПособия.Числом = 6 И Документ.ДоговорГПХОблагаетсяВзносамиНС Тогда
				МенеджерXML.ДобавитьУзел(УзелГПХ, "proactive:GPHinsurancePaymentObligation", Истина);
			КонецЕсли;
		ИначеЕсли Документ.ВидДоговораТрудовой И Документ.ВидДоговораГПХ Тогда
			УзелТДГПХ = МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:workerAndGPHcontract");
			УзелТД = МенеджерXML.ДобавитьУзел(УзелТДГПХ, "proactive:workerContract");
			Если ЗначениеЗаполнено(Документ.СрочныйДоговорДатаНачала) Тогда
				УзелПериод = МенеджерXML.ДобавитьУзел(УзелТД, "proactive:period");
				МенеджерXML.ДобавитьУзел(УзелПериод, "common:begin", Документ.СрочныйДоговорДатаНачала);
				МенеджерXML.ДобавитьУзел(УзелПериод, "common:end", Документ.СрочныйДоговорДатаОкончания, Истина, Ложь);
			КонецЕсли;
			МенеджерXML.ДобавитьУзел(УзелТДГПХ, "proactive:GPHcontract", Истина);
		КонецЕсли;
	ИначеЕсли ВидПособия.Числом = 2 Или ВидПособия.Числом = 5 Тогда
		Если Документ.ВидДоговораТрудовой И Не Документ.ВидДоговораГПХ Тогда
			МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:workerContract", Истина);
		ИначеЕсли Не Документ.ВидДоговораТрудовой И Документ.ВидДоговораГПХ Тогда
			УзелГПХ = МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:GPHcontract");
			УзелПериод = МенеджерXML.ДобавитьУзел(УзелГПХ, "proactive:period");
			МенеджерXML.ДобавитьУзел(УзелПериод, "common:begin", Документ.СрочныйДоговорДатаНачала);
			МенеджерXML.ДобавитьУзел(УзелПериод, "common:end", Документ.СрочныйДоговорДатаОкончания, Истина, Ложь);
		ИначеЕсли Документ.ВидДоговораТрудовой И Документ.ВидДоговораГПХ Тогда
			МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:workerAndGPHcontract", Истина);
		КонецЕсли;
	ИначеЕсли ВидПособия.Числом = 4 Тогда
		Если Документ.ВидДоговораТрудовой И Не Документ.ВидДоговораГПХ Тогда
			МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:workerContract", Истина);
		ИначеЕсли Не Документ.ВидДоговораТрудовой И Документ.ВидДоговораГПХ Тогда
			МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:GPHcontract", Истина);
		ИначеЕсли Документ.ВидДоговораТрудовой И Документ.ВидДоговораГПХ Тогда
			МенеджерXML.ДобавитьУзел(УзелДоговоры, "proactive:workerAndGPHcontract", Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузитьПериодОтпуска10910(Документ, МенеджерXML, УзелПособие, ВидПособия)
	УзелПериод = МенеджерXML.ДобавитьУзел(УзелПособие, "period");
