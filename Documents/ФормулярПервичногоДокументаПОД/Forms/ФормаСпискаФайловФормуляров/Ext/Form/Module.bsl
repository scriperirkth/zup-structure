
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИдентификаторФормуляра = Параметры.ИдентификаторФормуляра;

	ФайлыПоИдентификаторуФормуляра = ПроцессыОбработкиДокументов.ФайлыПоИдентификаторуФормуляра(ИдентификаторФормуляра);
	Формуляры.Загрузить(ФайлыПоИдентификаторуФормуляра);
	
КонецПроцедуры

&НаКлиенте
Процедура ФормулярыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ФормулярыФормуляр" Тогда
		ОткрытьФормуляр(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьФормуляр(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Формуляры.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", ДанныеСтроки.Формуляр);
	
	ОткрытьФорму("Документ.ФормулярПервичногоДокументаПОД.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти
