// См. КадровыйРезервФормы.ОтборИзПодразделения
&НаСервереБезКонтекста
Функция ОтборИзПодразделения(Знач Подразделение)

	Возврат КадровыйРезервФормы.ОтборИзПодразделения(Подразделение);

КонецФункции

&НаСервере
Функция АдресСпискаПодобранныхСотрудников()
	
	СписокСотрудниковПоФизическимЛицам = ТаблицаСотрудниковИФизлиц(
		Объект.Сотрудники.Выгрузить(,"УчастникКадровогоРезерва").ВыгрузитьКолонку("УчастникКадровогоРезерва"));
	Возврат ПоместитьВоВременноеХранилище(СписокСотрудниковПоФизическимЛицам.ВыгрузитьКолонку("Сотрудник"),
		УникальныйИдентификатор);
	
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаСотрудниковИФизлиц(СписокФизическихЛиц)
	
	ПараметрыСотрудников = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыСотрудников.СписокФизическихЛиц = СписокФизическихЛиц;
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСотрудников = КадровыйУчет.СотрудникиОрганизации(Ложь, ПараметрыСотрудников);
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаСотрудников;
	
КонецФункции

&НаСервере
Процедура ДобавитьВыбранныхСотрудников(Знач ВыбранноеЗначение)
	
	ВыбранныеСотрудники = ОбщегоНазначения.СкопироватьРекурсивно(ВыбранноеЗначение);
	ОбщегоНазначенияБЗККлиентСервер.УдалитьВсеВхожденияКромеТипаИзМассива(ВыбранныеСотрудники,
		Тип("СправочникСсылка.Сотрудники"));
	ФизическиеЛица = КадровыйУчет.ФизическиеЛицаСотрудников(ВыбранныеСотрудники);
	ЗаполнитьИнформациюОКадровомРезерве(ФизическиеЛица);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		ЛичныеДанныеКандидатов = МодульПодборПерсонала.СсылкиНаЛичныеДанныеКандидатов(ВыбранноеЗначение);
		ЗаполнитьИнформациюОКадровомРезерве(ЛичныеДанныеКандидатов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнформациюОКадровомРезерве(УчастникиКадровогоРезерва)
	
	Если Не ЗначениеЗаполнено(УчастникиКадровогоРезерва) Тогда
		Возврат;
	КонецЕсли;
	
	ИнформацияОРезерве = ИнформацияОКадровомРезерве(УчастникиКадровогоРезерва);
	
	Для Каждого СтрокаРезерв Из ИнформацияОРезерве Цикл
		ОтборСтрок = Новый Структура("УчастникКадровогоРезерва, ПозицияРезерва");
		ОтборСтрок.УчастникКадровогоРезерва = СтрокаРезерв.УчастникКадровогоРезерва;
		ОтборСтрок.ПозицияРезерва = СтрокаРезерв.ПозицияРезерва;
		НайденныеСтроки = Объект.Сотрудники.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.Сотрудники.Добавить();
			НоваяСтрока.УчастникКадровогоРезерва = СтрокаРезерв.УчастникКадровогоРезерва;
			НоваяСтрока.ПозицияРезерва = СтрокаРезерв.ПозицияРезерва;
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьСтатусыРезервистов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусыРезервистов()
	
	Если Объект.Сотрудники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СотрудникиДокумента = Объект.Сотрудники.Выгрузить();
	
	СтатусыРезервистов = КадровыйРезерв.СтатусыГотовностиРезервистов(Объект.Дата,
		СотрудникиДокумента.ВыгрузитьКолонку("ПозицияРезерва"),
		СотрудникиДокумента.ВыгрузитьКолонку("УчастникКадровогоРезерва"), Объект.Ссылка);
	
	Для Каждого СтрокаСотрудник Из Объект.Сотрудники Цикл
		ОтборСтрок = Новый Структура("УчастникКадровогоРезерва, ПозицияРезерва");
		ОтборСтрок.УчастникКадровогоРезерва = СтрокаСотрудник.УчастникКадровогоРезерва;
		ОтборСтрок.ПозицияРезерва = СтрокаСотрудник.ПозицияРезерва;
		НайденныеСтроки = СтатусыРезервистов.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаСотрудник.ПредыдущийСтатус = НайденныеСтроки[0].Статус;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ИнформацияОКадровомРезерве(УчастникКадровогоРезерва)
	
	Возврат КадровыйРезерв.ПозицииРезерваПоУчастникуКадровогоРезерва(УчастникКадровогоРезерва, Объект.Дата,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Перечисления.СостоянияСогласования.Согласовано));
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	ТипыУчастниковКадровогоРезерва = КадровыйРезерв.ТипыУчастниковКадровогоРезерваДоступныхПоФункциональнымОпциям();
	НесколькоТиповУчастников = ТипыУчастниковКадровогоРезерва.Количество() > 1;
	Если НесколькоТиповУчастников Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СотрудникиПодбор", "Видимость",
			Ложь);
		КадровыйРезервФормы.ДополнитьКомандыИКнопкиПодбора(ЭтотОбъект, "СотрудникиКоманднаяПанель", "Сотрудники");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СотрудникиУчастникКадровогоРезерваОбработкаВыбораНаСервере(ВыбранноеЗначение, ТекущаяСтрока)
	
	ТекущиеДанные = Объект.Сотрудники.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		ТекущиеДанные.УчастникКадровогоРезерва = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыбранноеЗначение,
			"ФизическоеЛицо");
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Кандидаты") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		ТекущиеДанные.УчастникКадровогоРезерва = МодульПодборПерсонала.ЛичныеДанныеКандидатов(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранноеЗначение)).Получить(ВыбранноеЗначение);
	Иначе
		ТекущиеДанные.УчастникКадровогоРезерва = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьСотрудников()
	
	ОтборИзПодразделения = ОтборИзПодразделения(Объект.Подразделение);
	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОтборИзПодразделения, "Организация");
	Подразделение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОтборИзПодразделения, "Подразделение");
	
	КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(Элементы.Сотрудники,
		Организация, Подразделение, Объект.Дата, , АдресСпискаПодобранныхСотрудников());
	
КонецПроцедуры

#КонецОбласти