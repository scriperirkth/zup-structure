	ЗаполнитьПозицииНаСервере();
	
	Если Объект.Позиции.Количество() > 0 Тогда
		Элементы.Позиции.ТекущаяСтрока = Объект.Позиции[0].ПолучитьИдентификатор();
		ПозицииПриАктивизацииСтрокиНаКлиенте();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПозицииНаСервере()

	ОчиститьПозиции(ЭтотОбъект);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ДатаАктуальности = ?(ЗначениеЗаполнено(Объект.Период), Объект.Период, ТекущаяДатаСеанса());
	
	ПараметрыПостроения = УправлениеШтатнымРасписанием.ПараметрыПостроенияВТШтатноеРасписание(ДатаАктуальности);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПостроения.Отборы,
		"МестоВСтруктуреПредприятия", "В ИЕРАРХИИ", Объект.Подразделение);
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьИсториюИзмененияШтатногоРасписания") Тогда 
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПостроения.Отборы, "Закрыта", "=", Ложь);
	КонецЕсли;
	
	РезультатЗапроса = УправлениеШтатнымРасписанием.СоздатьВТШтатноеРасписание(
		МенеджерВТ, Истина, ПараметрыПостроения, "ПозицияШтатногоРасписания", "");
	
	Позиции = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ПозицияШтатногоРасписания");

	МаксимальныйИдентификаторСтрокиПозиции = 0;
	Для Каждого Позиция Из Позиции Цикл
		НоваяСтрока = Объект.Позиции.Добавить();
		НоваяСтрока.Позиция = Позиция;
		НоваяСтрока.ИдентификаторСтрокиОбъектаНазначения = МаксимальныйИдентификаторСтрокиПозиции;
		МаксимальныйИдентификаторСтрокиПозиции = МаксимальныйИдентификаторСтрокиПозиции + 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСотрудниковНаКлиенте()
	
	Если Объект.Сотрудники.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьСотрудниковНаКлиентеЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр(
			"ru = 'Списки сотрудников и их показателей будут очищены.
			|Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьСотрудниковНаКлиентеЗавершение(КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСотрудниковНаКлиентеЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено
		Или Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСотрудниковНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСотрудниковНаСервере()

	ОчиститьСотрудников(ЭтотОбъект);
	
	ПараметрыПолученияСотрудников = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	
	Источник = ПодразделениеОрганизации(Объект.Подразделение);
	
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Организации") Тогда
		ПараметрыПолученияСотрудников.Организация = Источник;
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		ПараметрыПолученияСотрудников.Подразделение = Источник;
	КонецЕсли;
	
	ПараметрыПолученияСотрудников.НачалоПериода = Объект.Период;
	
	СотрудникиОрганизации = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыПолученияСотрудников);
	
	Сотрудники = СотрудникиОрганизации.ВыгрузитьКолонку("Сотрудник");

	МаксимальныйИдентификаторСтрокиСотрудника = 0;
	
	Для Каждого Сотрудник Из Сотрудники Цикл
		НоваяСтрока = Объект.Сотрудники.Добавить();
		НоваяСтрока.Сотрудник = Сотрудник;
		НоваяСтрока.ИдентификаторСтрокиОбъектаНазначения = МаксимальныйИдентификаторСтрокиСотрудника;
		МаксимальныйИдентификаторСтрокиСотрудника = МаксимальныйИдентификаторСтрокиСотрудника + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПодразделение(Подразделение)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение,"Источник");
