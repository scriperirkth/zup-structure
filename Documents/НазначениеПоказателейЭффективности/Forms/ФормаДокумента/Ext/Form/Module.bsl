&НаКлиенте
Функция ПараметрыШкалыЗначений(ИмяТЧ, ОбратнаяШкала)
	
	ПараметрыШкалы = Новый Структура();
	ПараметрыШкалы.Вставить("ШкалаЗначений", Объект[ИмяТЧ]);
	ПараметрыШкалы.Вставить("ОбратнаяШкала", ОбратнаяШкала);
	ПараметрыШкалы.Вставить("ОтборСтрок", Элементы[ИмяТЧ].ОтборСтрок);
	ПараметрыШкалы.Вставить("ИмяПоляЗначениеДо", ИмяТЧ+"ЗначениеДо");
	ПараметрыШкалы.Вставить("ИмяТабличнойЧасти", "Объект."+ИмяТЧ);
	
	Возврат ПараметрыШкалы;

КонецФункции

&НаСервере
Функция АдресТаблицыРодителей(Показатель, Подразделение, Горизонт, ВключаяСамоПодразделение)

	ТаблицаРодителей = Новый ТаблицаЗначений;
	ТаблицаРодителей.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТаблицаРодителей.Колонки.Добавить("ОтветственныйЗаВводПлана", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ТаблицаРодителей.Колонки.Добавить("ОтветственныйЗаВводФакта", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Период", Объект.Период);
	СтруктураРеквизитов.Вставить("Подразделение", Подразделение);
	СтруктураРеквизитов.Вставить("Горизонт", Горизонт);
	
	Запрос = КлючевыеПоказателиЭффективности.ЗапросВТПоказателиЭффективностиРодителейПодразделения(СтруктураРеквизитов, ВключаяСамоПодразделение);
	
	Запрос.УстановитьПараметр("Показатель", Показатель);
	
	ИтоговыйТекст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Показатели.Подразделение КАК Подразделение,
		|	ВЫБОР
		|		КОГДА Показатели.Показатель = &Показатель
		|			ТОГДА Показатели.Показатель
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК Показатель,
		|	Показатели.Подразделение КАК МестоВводаЗначений,
		|	Показатели.ОтветственныйЗаВводПлана КАК ОтветственныйЗаВводПлана,
		|	Показатели.ОтветственныйЗаВводФакта КАК ОтветственныйЗаВводФакта
		|ИЗ
		|	ВТПоказателиЭффективностиРодителейПодразделения КАК Показатели
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТПоказателиЭффективностиРодителейПодразделения";
	
	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьТекстыЗапросов(Запрос.Текст, ИтоговыйТекст);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокиПодразделения = Объект.Подразделения.НайтиСтроки(Новый Структура("Подразделение", Выборка.Подразделение));
		Если СтрокиПодразделения.Количество() > 0  Тогда
			СтрокаПодразделения = СтрокиПодразделения[0];
			СтрокиПоказателя = Объект.ПоказателиПодразделений.НайтиСтроки(Новый Структура("ИдентификаторСтрокиОбъектаНазначения, Показатель", СтрокаПодразделения.ИдентификаторСтрокиОбъектаНазначения, Показатель));
			Если СтрокиПоказателя.Количество() > 0
				И СтрокиПоказателя[0].МестоВводаЗначений = СтрокаПодразделения.Подразделение Тогда
				
				НоваяСтрока = ТаблицаРодителей.Добавить();
				НоваяСтрока.Подразделение = СтрокаПодразделения.Подразделение;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокиПоказателя[0]);
			КонецЕсли;
		ИначеЕсли Выборка.Показатель <> Null Тогда
			ЗаполнитьЗначенияСвойств(ТаблицаРодителей.Добавить(), Выборка);
		КонецЕсли;
	КонецЦикла;

	Возврат ПоместитьВоВременноеХранилище(ТаблицаРодителей, УникальныйИдентификатор);
	
КонецФункции

