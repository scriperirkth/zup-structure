&НаСервере
Процедура ПроверитьОтветственныхПоМестамВвода(ТекущиеДанные)

	СтрокаПодразделений = СтрокаПоОтбору(ЭтотОбъект, "ПоказателиПодразделений", "Подразделения");
	
	Если СтрокаПодразделений = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиОтветственных = Объект.ПоказателиПодразделений.НайтиСтроки(Новый Структура("МестоВводаЗначений, Показатель", СтрокаПодразделений.Подразделение, ТекущиеДанные.Показатель));
	ИзменитьОтветственныхЗаВвод(СтрокиОтветственных, ТекущиеДанные);
	
	СтрокиОтветственных = Объект.ПоказателиПозиций.НайтиСтроки(Новый Структура("МестоВводаЗначений", СтрокаПодразделений.Подразделение));
	ИзменитьОтветственныхЗаВвод(СтрокиОтветственных, ТекущиеДанные);

КонецПроцедуры

&НаСервере
Процедура ИзменитьОтветственныхЗаВвод(СтрокиОтветственных, ТекущиеДанные)

	Для каждого СтрокаОтветственных Из СтрокиОтветственных Цикл
		ПерезаполнитьСтроку = Ложь;
		Если СтрокаОтветственных.ОтветственныйЗаВводПлана <> ТекущиеДанные.ОтветственныйЗаВводПлана Тогда
			СтрокаОтветственных.ОтветственныйЗаВводПлана = ТекущиеДанные.ОтветственныйЗаВводПлана;
			ПерезаполнитьСтроку = Истина;
		КонецЕсли;
		Если СтрокаОтветственных.ОтветственныйЗаВводФакта <> ТекущиеДанные.ОтветственныйЗаВводФакта Тогда
			СтрокаОтветственных.ОтветственныйЗаВводФакта = ТекущиеДанные.ОтветственныйЗаВводФакта;
			ПерезаполнитьСтроку = Истина;
		КонецЕсли;
		Если ПерезаполнитьСтроку Тогда
			ЗаполнитьСтрокуВводаЗначенийПоказателяТабЧасти(ЭтотОбъект, СтрокаОтветственных, "Подразделения", "Подразделение");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СотрудникиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Модифицированность = Истина;
	
	Если Копирование Тогда
		ПредыдущаяСтрока = Элемент.ТекущиеДанные
	КонецЕсли;
	
	НоваяСтрокаСотрудника = Объект.Сотрудники.Добавить();
	ИдентификаторТекущегоСотрудника = НоваяСтрокаСотрудника.ПолучитьИдентификатор();
	Элемент.ТекущаяСтрока = ИдентификаторТекущегоСотрудника;
	
	СотрудникиПриНачалеРедактирования(Элемент, Истина, Ложь);
	
	Если Копирование Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрокаСотрудника, ПредыдущаяСтрока, "Сотрудник");
	КонецЕсли;
	
	Если Копирование Тогда
		СкопироватьДанныеСотрудника(ИдентификаторТекущегоСотрудника, ПредыдущаяСтрока.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьДанныеСотрудника(ИдентификаторТекущегоСотрудника, ИдентификаторСотрудникаИсточника)
	
	ТекущиеДанные = Объект.Сотрудники.НайтиПоИдентификатору(ИдентификаторТекущегоСотрудника);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаИсточник = Объект.Сотрудники.НайтиПоИдентификатору(ИдентификаторСотрудникаИсточника);
	Если СтрокаИсточник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИсходныеСтроки = Объект.ПоказателиСотрудников.НайтиСтроки(Новый Структура("ИдентификаторСтрокиОбъектаНазначения", СтрокаИсточник.ИдентификаторСтрокиОбъектаНазначения));
	Для каждого ИсходнаяСтрока Из ИсходныеСтроки Цикл
		
		НоваяСтрокаПоказателя = Объект.ПоказателиСотрудников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПоказателя, ИсходнаяСтрока);
		НоваяСтрокаПоказателя.ИдентификаторСтрокиОбъектаНазначения = ТекущиеДанные.ИдентификаторСтрокиОбъектаНазначения;
		
		УстановитьМаксимальныеИдентификаторыСтрок();
		
		УстановитьИдентификаторНовойСтрокиПоказателя(
		НоваяСтрокаПоказателя, МаксимальныйИдентификаторСтрокиПоказателяСотрудника);
		
		ИсходныеСтрокиШкал = Объект.ШкалыЗначенийСотрудников.НайтиСтроки(Новый Структура("ИдентификаторСтрокиПоказателя", ИсходнаяСтрока.ИдентификаторСтрокиПоказателя));
		Для каждого ИсходнаяСтрокаШкал Из ИсходныеСтрокиШкал Цикл
			
			НоваяСтрокаШкалы = Объект.ШкалыЗначенийСотрудников.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаШкалы, ИсходнаяСтрокаШкал);
			НоваяСтрокаШкалы.ИдентификаторСтрокиПоказателя = НоваяСтрокаПоказателя.ИдентификаторСтрокиПоказателя;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодразделениеОрганизации(Подразделение)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "Источник")
	
КонецФункции

&НаКлиенте
Процедура ПодразделенияПодразделениеПриИзменении(Элемент)
	
	ПроверитьМестаВводаЗначенийНаКлиенте("Подразделения", "Подразделение" ,"ПоказателиПодразделений");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМестаВводаЗначенийНаКлиенте(ИмяТЧ,ИмяПоля, ИмяТЧПоказателей)

	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	ПроверитьМестаВводаЗначенийНаСервере(ИмяТЧПоказателей, ТекущиеДанные[ИмяПоля], ТекущиеДанные.ИдентификаторСтрокиОбъектаНазначения);

КонецПроцедуры

&НаСервере
Процедура ПроверитьМестаВводаЗначенийНаСервере(ИмяТЧПоказателей, ОбъектНазначения, ИдентификаторСтрокиОбъектаНазначения)

	СтрокиПоказателей = Объект[ИмяТЧПоказателей].НайтиСтроки(
		Новый Структура("ИдентификаторСтрокиОбъектаНазначения", ИдентификаторСтрокиОбъектаНазначения));
	Для Каждого Строка Из СтрокиПоказателей Цикл
		Если ЗначениеЗаполнено(Строка.МестоВводаЗначений) Тогда
			Если ТипЗнч(Строка.МестоВводаЗначений) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
				Строка.МестоВводаЗначений = Справочники.СтруктураПредприятия.ПустаяСсылка();
				ЗаполнитьСтрокуВводаЗначенийПоказателя(Строка, ОбъектНазначения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти