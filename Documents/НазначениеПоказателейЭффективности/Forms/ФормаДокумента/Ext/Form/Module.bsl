&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСтрокПоказателейТЧ(Форма, ТекущиеДанные, ИмяЭлементаТЧ, ИмяРеквизитаФормы)

	Если ТекущиеДанные = Неопределено Тогда
		Форма.Элементы[ИмяЭлементаТЧ].ОтборСтрок = Неопределено;
	Иначе
		УстановитьОтборСтрокПоказателей(
			Форма.Элементы[ИмяЭлементаТЧ], ТекущиеДанные.ИдентификаторСтрокиОбъектаНазначения, Форма[ИмяРеквизитаФормы]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСтрокПоказателей(ЭлементыПоказатели, ИдентификаторСтрокиОбъектаНазначения, Горизонт)
	
	СтруктураОтбор = Новый Структура("ИдентификаторСтрокиОбъектаНазначения", ИдентификаторСтрокиОбъектаНазначения);
	Если Горизонт <> ПредопределенноеЗначение("Перечисление.Периодичность.ПустаяСсылка") Тогда
		СтруктураОтбор.Вставить("Горизонт", Горизонт);
	КонецЕсли;
	
	ЭлементыПоказатели.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбор);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокШкалы(ЭлементыШкалы, ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		ЭлементыШкалы.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиПоказателя", 99999);
	Иначе
		ЭлементыШкалы.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиПоказателя", ТекущиеДанные.ИдентификаторСтрокиПоказателя);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтрокуЗаголовкаПоказателейТЧ(Параметры)

	СписокТабличныхЧастей = СписокТабличныхЧастей();
	
	Если Параметры.ИмяТЧ = СписокТабличныхЧастей.ПоказателиПодразделений Тогда
		Если Параметры.НеЗаполненнаяТЧ Тогда
			СтрокаЗаголовкаПоказателейПодразделений = НСтр("ru = 'Показатели подразделений'");
		Иначе
			СтрокаЗаголовкаПоказателейПодразделений = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Показатели подразделения ""%1""'"), Параметры.ТекущиеДанные[Параметры.ИмяПоля]);
		КонецЕсли;
	ИначеЕсли Параметры.ИмяТЧ = СписокТабличныхЧастей.ПоказателиПозиций Тогда
		Если Параметры.НеЗаполненнаяТЧ Тогда
			СтрокаЗаголовкаПоказателейПозиций = НСтр("ru = 'Показатели позиций'");
		Иначе
			СтрокаЗаголовкаПоказателейПозиций = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Показатели позиции ""%1""'"), Параметры.ТекущиеДанные[Параметры.ИмяПоля]);
		КонецЕсли;
	ИначеЕсли Параметры.ИмяТЧ = СписокТабличныхЧастей.ПоказателиСотрудников Тогда
		Если Параметры.НеЗаполненнаяТЧ Тогда
			СтрокаЗаголовкаПоказателейСотрудников = НСтр("ru = 'Показатели сотрудников'");
		Иначе
			СтрокаЗаголовкаПоказателейСотрудников = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Показатели сотрудника ""%1""'"), Параметры.ТекущиеДанные[Параметры.ИмяПоля]);
		КонецЕсли;
	ИначеЕсли Параметры.ИмяТЧ = СписокТабличныхЧастей.ШкалыЗначенийПодразделений Тогда
		Если Параметры.НеЗаполненнаяТЧ Тогда
			СтрокаЗаголовкаШкалыПодразделений = НСтр("ru = 'Шкала значений показателей'");
		Иначе
			СтрокаЗаголовкаШкалыПодразделений = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Шкала значений показателя ""%1""'"), Параметры.ТекущиеДанные[Параметры.ИмяПоля]);
		КонецЕсли;
	ИначеЕсли Параметры.ИмяТЧ = СписокТабличныхЧастей.ШкалыЗначенийСотрудников Тогда
		Если Параметры.НеЗаполненнаяТЧ Тогда
			СтрокаЗаголовкаШкалыСотрудников = НСтр("ru = 'Шкала значений показателей'");
		Иначе
			СтрокаЗаголовкаШкалыСотрудников = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Шкала значений показателя ""%1""'"), Параметры.ТекущиеДанные[Параметры.ИмяПоля]);
		КонецЕсли;
	ИначеЕсли Параметры.ИмяТЧ = СписокТабличныхЧастей.ШкалыЗначенийПозиций Тогда
		Если Параметры.НеЗаполненнаяТЧ Тогда
			СтрокаЗаголовкаШкалыПозиций = НСтр("ru = 'Шкала значений показателей'");
		Иначе
			СтрокаЗаголовкаШкалыПозиций = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Шкала значений показателя ""%1""'"), Параметры.ТекущиеДанные[Параметры.ИмяПоля]);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СписокТабличныхЧастей()

	СписокТабличныхЧастей = Новый Структура();
	СписокТабличныхЧастей.Вставить("ПоказателиПодразделений", "ПоказателиПодразделений");
	СписокТабличныхЧастей.Вставить("ПоказателиПозиций", "ПоказателиПозиций");
	СписокТабличныхЧастей.Вставить("ПоказателиСотрудников", "ПоказателиСотрудников");
	СписокТабличныхЧастей.Вставить("ШкалыЗначенийПодразделений", "ШкалыЗначенийПодразделений");
	СписокТабличныхЧастей.Вставить("ШкалыЗначенийСотрудников", "ШкалыЗначенийСотрудников");
	СписокТабличныхЧастей.Вставить("ШкалыЗначенийПозиций", "ШкалыЗначенийПозиций");
	
	Возврат СписокТабличныхЧастей;

КонецФункции

&НаКлиенте
Процедура УстановитьИдентификаторНовойСтрокиОбъектаНазначения(ТекущиеДанные, МаксимальныйИдентификаторСтроки)

	ТекущиеДанные.ИдентификаторСтрокиОбъектаНазначения = МаксимальныйИдентификаторСтроки + 1;
	МаксимальныйИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтрокиОбъектаНазначения;

