&НаСервере
Процедура ПриПолученииДанныхНаСервере()
	
	ЗаполнитьВторичныеРеквизитыФормы();
	
	УстановитьСвойстваЭлементовФормы();

КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементовФормы()

	УстановитьУсловноеОформлениеФормы();
	
	УстановитьПараметрыВыбораПодразделенийВТЧ();
	
	УстановитьДоступностьЭлементаУтвердил(ЭтотОбъект);
	
	УстановитьВидимостьГоризонтовПодразделений(ЭтотОбъект);
	УстановитьВидимостьГоризонтовПозиций(ЭтотОбъект);
	УстановитьВидимостьГоризонтовСотрудников(ЭтотОбъект);
	
	УстановитьСвойстваПереключателейГоризонтов();

КонецПроцедуры

&НаСервере
Процедура ДобавитьВыбранныхСотрудников(ВыбранныеСотрудники)

	Для каждого ВыбранныйСотрудник Из ВыбранныеСотрудники Цикл
		НайденныеСотрудники = Объект.Сотрудники.НайтиСтроки(Новый Структура("Сотрудник", ВыбранныйСотрудник));
		Если НайденныеСотрудники.Количество()= 0 Тогда
			НовыйСотрудник = Объект.Сотрудники.Добавить();
			НовыйСотрудник.Сотрудник = ВыбранныйСотрудник;
			НовыйСотрудник.ИдентификаторСтрокиОбъектаНазначения = НовыйСотрудник.НомерСтроки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция АдресСпискаПодобранныхСотрудников()
	
	СписокСотрудников = Объект.Сотрудники.Выгрузить(,"Сотрудник").ВыгрузитьКолонку("Сотрудник");
	Возврат ПоместитьВоВременноеХранилище(СписокСотрудников, УникальныйИдентификатор); 
	
КонецФункции

&НаКлиенте
Функция ПараметрыЗаголовкаСтрок()

	ПараметрыЗаголовкаСтрок = Новый Структура();
	ПараметрыЗаголовкаСтрок.Вставить("ИмяТЧ", "");
	ПараметрыЗаголовкаСтрок.Вставить("ИмяПоля", "");
	ПараметрыЗаголовкаСтрок.Вставить("НеЗаполненнаяТЧ", Ложь);
	ПараметрыЗаголовкаСтрок.Вставить("ТекущиеДанные", Неопределено);
	
	Возврат ПараметрыЗаголовкаСтрок;

КонецФункции

#Область ЗаполнениеВторичныхДанных

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыФормы()
	
	ЗарплатаКадрыКлиентСервер.ЗаполнитьМесяцПоДате(ЭтотОбъект, "Объект.Период", "МесяцСтрокой");
	
	ПодразделениеБыло = Объект.Подразделение;
	
	УстановитьРеквизитыГоризонтов();
	УстановитьЗначениеГоризонтов();
	
	УстановитьМаксимальныеИдентификаторыСтрок();
	
	ЗаполнитьСтрокиВводаЗначенийПоказателя("ПоказателиПодразделений");
	ЗаполнитьВторичныеРеквизитыПоказателей(Объект.ПоказателиПодразделений);
	
	ЗаполнитьСтрокиВводаЗначенийПоказателя("ПоказателиПозиций");
	ЗаполнитьВторичныеРеквизитыПоказателей(Объект.ПоказателиПозиций);
	
	ЗаполнитьСтрокиВводаЗначенийПоказателя("ПоказателиСотрудников");
	ЗаполнитьВторичныеРеквизитыПоказателей(Объект.ПоказателиСотрудников);
	
	ЗаполнитьВторичныеРеквизитыШкал("ПоказателиПодразделений", "ШкалыЗначенийПодразделений");
	ЗаполнитьВторичныеРеквизитыШкал("ПоказателиПозиций", "ШкалыЗначенийПозиций");
	ЗаполнитьВторичныеРеквизитыШкал("ПоказателиСотрудников", "ШкалыЗначенийСотрудников");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитыГоризонтов()

	ЕстьГоризонтКвартал = ПолучитьФункциональнуюОпцию("ИспользоватьГоризонтКварталДляПоказателейЭффективности");
	ЕстьГоризонтПолугодие = ПолучитьФункциональнуюОпцию("ИспользоватьГоризонтПолугодиеДляПоказателейЭффективности");
	ЕстьГоризонтГод = ПолучитьФункциональнуюОпцию("ИспользоватьГоризонтГодДляПоказателейЭффективности");

КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеГоризонтов()

	Если Не ЕстьГоризонтКвартал И Не ЕстьГоризонтПолугодие  И Не ЕстьГоризонтГод Тогда
		ОтображениеГоризонтаПоказателейПодразделений = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");
		ОтображениеГоризонтаПоказателейПозиций = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");
		ОтображениеГоризонтаПоказателейСотрудников = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьМаксимальныеИдентификаторыСтрок()

	МаксимальныйИдентификаторСтрокиПодразделения =
		ЗарплатаКадрыРасширенный.МаксимальныйИдентификаторСтроки(Объект.Подразделения, "ИдентификаторСтрокиОбъектаНазначения");
	МаксимальныйИдентификаторСтрокиПоказателяПодразделения =
		ЗарплатаКадрыРасширенный.МаксимальныйИдентификаторСтроки(Объект.ПоказателиПодразделений, "ИдентификаторСтрокиПоказателя");
	МаксимальныйИдентификаторСтрокиПозиции =
		ЗарплатаКадрыРасширенный.МаксимальныйИдентификаторСтроки(Объект.Позиции, "ИдентификаторСтрокиОбъектаНазначения");
	МаксимальныйИдентификаторСтрокиПоказателяПозиции =
		ЗарплатаКадрыРасширенный.МаксимальныйИдентификаторСтроки(Объект.ПоказателиПозиций, "ИдентификаторСтрокиПоказателя");
	МаксимальныйИдентификаторСтрокиСотрудника =
		ЗарплатаКадрыРасширенный.МаксимальныйИдентификаторСтроки(Объект.Сотрудники, "ИдентификаторСтрокиОбъектаНазначения");
	МаксимальныйИдентификаторСтрокиПоказателяСотрудника = 
		ЗарплатаКадрыРасширенный.МаксимальныйИдентификаторСтроки(Объект.ПоказателиСотрудников, "ИдентификаторСтрокиПоказателя");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыШкал(ПоказателиИмяТЧ,ШкалыИмяТЧ)

	Для каждого СтрокаПоказателя Из Объект[ПоказателиИмяТЧ] Цикл
		ШкалаПоказателя = Объект[ШкалыИмяТЧ].НайтиСтроки(Новый Структура("ИдентификаторСтрокиПоказателя", СтрокаПоказателя.ИдентификаторСтрокиПоказателя));
		КлючевыеПоказателиЭффективностиКлиентСервер.УстановитьПредставлениеИнтервалаПоНижнейГранице(ШкалаПоказателя, СтрокаПоказателя.ОбратнаяШкала);
	КонецЦикла;
	
	КлючевыеПоказателиЭффективностиКлиентСервер.УстановитьПредставлениеИнтервалаОценки(Объект[ШкалыИмяТЧ]);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВторичныеРеквизитыПоказателей(ТаблицаПоказателей)

	СоответствиеРеквизитов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТаблицаПоказателей.Выгрузить(, "Показатель").ВыгрузитьКолонку("Показатель"), "ОбратнаяШкала");
	Для каждого СтрокаПоказателя Из ТаблицаПоказателей Цикл
		СтрокаПоказателя.ОбратнаяШкала = СоответствиеРеквизитов[СтрокаПоказателя.Показатель];
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПризнакОбратнаяШкалаПоказателя(Показатель)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Показатель, "ОбратнаяШкала");
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокиВводаЗначенийПоказателя(ИмяТЧ)

	Для каждого СтрокаПоказателя Из Объект[ИмяТЧ] Цикл 
		Если ИмяТЧ = "ПоказателиПодразделений" Тогда
			ЗаполнитьСтрокуВводаЗначенийПоказателяТабЧасти(ЭтотОбъект, СтрокаПоказателя, "Подразделения", "Подразделение");
		ИначеЕсли ИмяТЧ = "ПоказателиПозиций" Тогда
			ЗаполнитьСтрокуВводаЗначенийПоказателяТабЧасти(ЭтотОбъект, СтрокаПоказателя, "Позиции", "Позиция");
		ИначеЕсли ИмяТЧ = "ПоказателиСотрудников" Тогда
			ЗаполнитьСтрокуВводаЗначенийПоказателяТабЧасти(ЭтотОбъект, СтрокаПоказателя, "Сотрудники", "Сотрудник");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтрокуВводаЗначенийПоказателяТабЧасти(Форма, СтрокаПоказателя, ИмяТЧ, ИмяПоля)
	
	Строка = СтрокаПоИдентификатору(
		Форма, СтрокаПоказателя.ИдентификаторСтрокиОбъектаНазначения, ИмяТЧ);
	Если Строка= Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСтрокуВводаЗначенийПоказателя(СтрокаПоказателя, Строка[ИмяПоля]);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтрокуВводаЗначенийПоказателя(ТекущиеДанные, ОбъектВладелец)
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.МестоВводаЗначений) Тогда
		ТекущиеДанные.ВводЗначенийСтрока = НСтр("ru = 'Настроить ввод значений'");
	ИначеЕсли ТекущиеДанные.МестоВводаЗначений = ОбъектВладелец Тогда
		ТекущиеДанные.ВводЗначенийСтрока = СтрокаОтветственных(ТекущиеДанные);
	Иначе
		ТекущиеДанные.ВводЗначенийСтрока = 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1, %2'"),
				ТекущиеДанные.МестоВводаЗначений,
				СтрокаОтветственных(ТекущиеДанные, Ложь));
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаОтветственных(ТекущиеДанные, Трег = Истина)

	Если ТекущиеДанные.ОтветственныйЗаВводПлана = ТекущиеДанные.ОтветственныйЗаВводФакта Тогда
		Вводит = ?(Трег, НСтр("ru = 'Вводит'"), НСтр("ru = 'вводит'"));
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 %2'"),
			Вводит,
			ТекущиеДанные.ОтветственныйЗаВводПлана);
	Иначе
		Вводят = ?(Трег, НСтр("ru = 'Вводят'"), НСтр("ru = 'вводят'"));
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 %2 и %3'"),
			Вводят,
			ТекущиеДанные.ОтветственныйЗаВводПлана,
			ТекущиеДанные.ОтветственныйЗаВводФакта);
	КонецЕсли;

КонецФункции

