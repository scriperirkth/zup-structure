&НаКлиенте
Процедура ПодборСотрудников(Команда)
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ПодборСотрудниковВФормеДокументаНазначениеПоказателейЭффективности");
	
	ПараметрыОткрытия = Новый Структура;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПоказыватьДоговорниковГПХ", Истина);
	Отбор.Вставить("ПоказыватьСотрудниковПодчиненныхПодразделений", Истина);
	ПараметрыОткрытия.Вставить("Отбор", Отбор);
	
	Источник = ПодразделениеОрганизации(Объект.Подразделение);
		
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Организации") Тогда
		Организация = Источник;
		Подразделение = Неопределено;
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		Организация = Неопределено;
		Подразделение = Источник;
	КонецЕсли;
	
	КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(
		Элементы.Сотрудники,
		Организация,
		Подразделение,
		Объект.Период,,
		АдресСпискаПодобранныхСотрудников(),
		ПараметрыОткрытия);
	
КонецПроцедуры

