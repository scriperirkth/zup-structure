КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПереченьРабочихМест()
	
	Объект.РабочиеМеста.Очистить();
	Объект.НоменклатураСИЗ.Очистить();
	
	ДатаАктуальности = ДатаАктуальности();
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.КадровыеДанные = "РабочееМестоОхраныТруда";
	
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолучения.Отборы,
		"РабочееМестоОхраныТруда", "<>", Неопределено);
	
	ПараметрыПолучения.Организация = Объект.Организация;
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		ПараметрыПолучения.Подразделение = Объект.Подразделение;
	КонецЕсли;
	ПараметрыПолучения.НачалоПериода = ДатаАктуальности;
	ПараметрыПолучения.ОкончаниеПериода = ДатаАктуальности;
	
	УстановитьПривилегированныйРежим(Истина);
	СотрудникиОрганизации = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыПолучения);
	УстановитьПривилегированныйРежим(Ложь);
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ТекущийОбъект.ЗаполнитьСИЗТребующиеВыдачи(СотрудникиОрганизации, "РабочееМестоОхраныТруда");
	ЗначениеВДанныеФормы(ТекущийОбъект, Объект);
	ПриПолученииДанныхНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ДатаАктуальности()
	
	ДатаАктуальности = ?(ЗначениеЗаполнено(Объект.ДатаЗаказа), Объект.ДатаЗаказа,
		?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));
	
	Если Объект.ВключатьСИЗИстекающиеВТечениеМесяца Тогда
		ДатаАктуальности = ДобавитьМесяц(ДатаАктуальности, 1);
	КонецЕсли;
	
	Возврат ДатаАктуальности;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьМассивыСИЗРабочихМест()
	
	ПараметрыОписанияСтрокиСИЗ = СредстваИндивидуальнойЗащитыКлиентСервер.ПараметрыОписанияСтрокиСИЗ();
	ПараметрыОписанияСтрокиСИЗ.ДополнитьДляСотрудника = Истина;
	
	ДанныеСИЗ = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		Объект.НоменклатураСИЗ.Выгрузить().ВыгрузитьКолонку("СИЗ"), "ТипНоменклатуры");
	Для Каждого СтрокаРабочегоМеста Из Объект.РабочиеМеста Цикл
		СредстваИндивидуальнойЗащитыФормы.ЗаполнитьМассивСИЗ(Объект.НоменклатураСИЗ, СтрокаРабочегоМеста,
			"ИдентификаторСтрокиРабочегоМеста", ПараметрыОписанияСтрокиСИЗ, ДанныеСИЗ);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РабочиеМестаОбработкаВыбораНаСервере(ВыбранныеСотрудники)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	КадровыеДанныеСотрудников =
		РабочиеМестаОхраныТрудаФормы.КадровыеДанныеПодобранныхСотрудников(ЭтотОбъект, ВыбранныеСотрудники, ТекущийОбъект);
	Если КадровыеДанныеСотрудников.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект.ЗаполнитьСИЗТребующиеВыдачи(
		КадровыеДанныеСотрудников,
		"РабочееМестоОхраныТруда",
		ЗарплатаКадрыРасширенный.МаксимальныйИдентификаторСтроки(Объект.РабочиеМеста, "ИдентификаторСтрокиРабочегоМеста") + 1,
		Истина);
	ЗначениеВДанныеФормы(ТекущийОбъект, Объект);
	ПриПолученииДанныхНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РабочиеМестаПоСИЗОбработкаВыбораНаСервере(ВыбранныеСИЗ)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ТекущийОбъект.ЗаполнитьСИЗ(ИдентификаторыСИЗ());
	
	ФизическиеЛицаРабочиеМеста = ФизическиеЛицаРабочиеМестаСИЗ(ВыбранныеСИЗ);
	ТекущийОбъект.ЗаполнитьСИЗТребующиеВыдачи(ФизическиеЛицаРабочиеМеста, ,
		ЗарплатаКадрыРасширенный.МаксимальныйИдентификаторСтроки(Объект.РабочиеМеста, "ИдентификаторСтрокиРабочегоМеста") + 1);
	ЗначениеВДанныеФормы(ТекущийОбъект, Объект);
	ПриПолученииДанныхНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ФизическиеЛицаРабочиеМестаСИЗ(ВыбранныеСИЗ)
	
	ТаблицаФизическиеЛицаРабочиеМеста = Новый ТаблицаЗначений;
	ТаблицаФизическиеЛицаРабочиеМеста.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТаблицаФизическиеЛицаРабочиеМеста.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	ТаблицаФизическиеЛицаРабочиеМеста.Колонки.Добавить("ОтмеченныеСИЗ", Новый ОписаниеТипов("Массив"));
	
	СоответствиеСтрокСотрудникам = Новый Соответствие;
	Для Каждого ЭлементСИЗ Из ВыбранныеСИЗ Цикл
		Для Каждого ЭлементСотрудник Из ЭлементСИЗ.СотрудникиСИЗ Цикл
			СтрокаТаблицы = СоответствиеСтрокСотрудникам.Получить(ЭлементСотрудник.Сотрудник);
			Если СтрокаТаблицы = Неопределено Тогда
				СтрокаТаблицы = ТаблицаФизическиеЛицаРабочиеМеста.Добавить();
				СтрокаТаблицы.ФизическоеЛицо = ЭлементСотрудник.Сотрудник;
				СтрокаТаблицы.РабочееМесто = ЭлементСотрудник.РабочееМесто;
				СоответствиеСтрокСотрудникам.Вставить(ЭлементСотрудник.Сотрудник, СтрокаТаблицы);
			КонецЕсли;
			СтрокаТаблицы.ОтмеченныеСИЗ.Добавить(ЭлементСИЗ.СИЗ);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаФизическиеЛицаРабочиеМеста;
	
КонецФункции

&НаСервере
Функция АдресСпискаПодобранныхСотрудников()
	
	ТаблицаСотрудников = КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(
		Объект.РабочиеМеста.Выгрузить(,"ФизическоеЛицо").ВыгрузитьКолонку("ФизическоеЛицо"),
		Истина,
		Объект.Организация,
		Объект.Дата);
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаСотрудников.ВыгрузитьКолонку("Сотрудник"), УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция АдресПодобранныхСИЗ()
	
	ТаблицаСИЗ = Новый ТаблицаЗначений;
	ТаблицаСИЗ.Колонки.Добавить("СИЗ", Новый ОписаниеТипов("СправочникСсылка.СредстваИндивидуальнойЗащиты"));
	ТаблицаСИЗ.Колонки.Добавить("СотрудникиВДокументе", Новый ОписаниеТипов("Массив"));
	
	СоответствиеСтрокСИЗ = Новый Соответствие;
	Для Каждого СтрокаРабочееМесто Из Объект.РабочиеМеста Цикл
		Для Каждого ЭлементСИЗ Из СтрокаРабочееМесто.МассивСИЗ Цикл
			СтрокаТаблицы = СоответствиеСтрокСИЗ.Получить(ЭлементСИЗ.СИЗ);
			Если СтрокаТаблицы = Неопределено Тогда
				СтрокаТаблицы = ТаблицаСИЗ.Добавить();
				СтрокаТаблицы.СИЗ = ЭлементСИЗ.СИЗ;
				СоответствиеСтрокСИЗ.Вставить(ЭлементСИЗ.СИЗ, СтрокаТаблицы);
			КонецЕсли;
			СтрокаТаблицы.СотрудникиВДокументе.Добавить(СтрокаРабочееМесто.ФизическоеЛицо);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаСИЗ, УникальныйИдентификатор);
	
КонецФункции

