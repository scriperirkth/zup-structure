&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(
		Элемент.ТекстРедактирования,
		ЭтотОбъект,
		"Объект.Комментарий");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРабочиеМеста

&НаКлиенте
Процедура РабочиеМестаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.РабочиеМестаРабочееМесто Тогда
		ПоказатьЗначение(, ТекущиеДанные.РабочееМесто);
	ИначеЕсли Поле = Элементы.РабочиеМестаСотрудник Тогда
		ПоказатьЗначение(, ТекущиеДанные.ФизическоеЛицо);
	ИначеЕсли Поле = Элементы.РабочиеМестаКомандаСИЗ Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыОткрытия = Новый Структура;
		МассивСИЗ = ТекущиеДанные.МассивСИЗ;
		ПараметрыОткрытия.Вставить("СИЗ", МассивСИЗ);
		ПараметрыОткрытия.Вставить("РабочееМесто", ТекущиеДанные.РабочееМесто);
		ПараметрыОткрытия.Вставить("ФизическоеЛицо", ТекущиеДанные.ФизическоеЛицо);
		ПараметрыОткрытия.Вставить("Заголовок", НСтр("ru = 'Состав СИЗ'"));
		ПараметрыОткрытия.Вставить("Организация", Объект.Организация);
		ПараметрыОткрытия.Вставить("ДатаАктуальности", ?(ЗначениеЗаполнено(Объект.ДатаЗаказа), Объект.ДатаЗаказа, Объект.Дата));
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("УстановитьСИЗПослеЗакрытия", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.НормыВыдачиСредствИндивидуальнойЗащиты",
			ПараметрыОткрытия, ЭтотОбъект, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		// Ничего не открываем.
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РабочиеМестаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив")
		И ВыбранноеЗначение.Количество() > 0
		И ТипЗнч(ВыбранноеЗначение[0]) = Тип("Структура") Тогда
		
		РабочиеМестаПоСИЗОбработкаВыбораНаСервере(ВыбранноеЗначение);
		Возврат;
	КонецЕсли;
	
	РабочиеМестаОбработкаВыбораНаСервере(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура РабочиеМестаПередУдалением(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	РабочиеМестаПередУдалениемНаСервере(Элемент.ТекущиеДанные.ИдентификаторСтрокиРабочегоМеста);
	
КонецПроцедуры

#КонецОбласти

