#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗарплатаКадры.РасширенныйРежим() Тогда
		Документы.НачислениеЗарплаты.МодульКонтракта().ПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонецЕсли;
	
	ЗаполнитьНачисленоУдержано();
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Если ЗарплатаКадры.РасширенныйРежим() Тогда
		Документы.НачислениеЗарплаты.МодульКонтракта().ПриКопировании(ЭтотОбъект, ОбъектКопирования);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Документы.НачислениеЗарплаты.МодульКонтракта().ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Документы.НачислениеЗарплаты.МодульКонтракта().ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если ЗарплатаКадры.РасширенныйРежим() Тогда
		Документы.НачислениеЗарплаты.МодульКонтракта().ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Вспомогательные процедуры и функции.

Процедура ЗаполнитьНачисленоУдержано() Экспорт
	
	Начислено = Начисления.Итог("Результат") + НачисленияПоДоговорам.Итог("Результат");
	
	Удержано = Удержания.Итог("Результат");
	
	КолонкиНалогов = УчетНДФЛКлиентСервер.РесурсыИсчисленногоНалогаВМассиве("Налог", Ложь, Ложь);
	Для Каждого Колонка Из КолонкиНалогов Цикл
		Удержано = Удержано + НДФЛ.Итог(Колонка)
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

