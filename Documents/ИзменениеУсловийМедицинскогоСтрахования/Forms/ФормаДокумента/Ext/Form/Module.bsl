&НаКлиенте
Процедура ОтправитьПечатныеФормыПоПочтеНастройкаУчетнойЗаписиПредложена(УчетнаяЗаписьНастроена, ДополнительныеПараметры) Экспорт
	
	Если УчетнаяЗаписьНастроена <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ИмяОткрываемойФормы = "ОбщаяФорма.ВыборФорматаВложений";
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура СотрудникиЗаполнитьНаСервере(МассивСотрудников = Неопределено, МассивЗастрахованных = Неопределено, ЭтоПодбор = Ложь)
	
	Если Не ЭтоПодбор Тогда
		ОчиститьДанныеТаблицДокумента();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДоговорСтрахования) Или Не ЗначениеЗаполнено(Объект.ДатаИзменения) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОтборПоСотрудникам = Ложь;
	МассивФизическихЛиц = Новый Массив;
	
	Если МассивСотрудников <> Неопределено Тогда
		ФизическиеЛицаСотрудников = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСотрудников, "ФизическоеЛицо", Истина);
		Для Каждого ЭлементСоответствия Из ФизическиеЛицаСотрудников Цикл
			МассивФизическихЛиц.Добавить(ЭлементСоответствия.Значение);
		КонецЦикла;
		ЕстьОтборПоСотрудникам = Истина;
		
		ОчиститьДанныеПоСотрудникам(МассивСотрудников, МассивФизическихЛиц);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаИзменения", Объект.ДатаИзменения);
	Запрос.УстановитьПараметр("ДоговорСтрахования", Объект.ДоговорСтрахования);
	Запрос.УстановитьПараметр("ЕстьОтборПоСотрудникам", ЕстьОтборПоСотрудникам);
	Запрос.УстановитьПараметр("МассивФизическихЛиц", МассивФизическихЛиц);
	Запрос.УстановитьПараметр("ИсключаемыйДокумент", Объект.Ссылка);
	Запрос.УстановитьПараметр("ЕстьДокументОснование", ЗначениеЗаполнено(Объект.Основание));
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Основание);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрограммыСотрудников.Период КАК Период,
		|	ПрограммыСотрудников.Регистратор КАК Регистратор,
		|	ПрограммыСотрудников.ПрограммаСтрахования КАК ПрограммаСтрахования,
		|	ПрограммыСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПрограммыСотрудников.Родственник КАК Родственник
		|ПОМЕСТИТЬ ВТПрограммыСотрудников
		|ИЗ
		|	РегистрСведений.ПрограммыМедицинскогоСтрахованияСотрудников.СрезПоследних(&ДатаИзменения, ДоговорСтрахования = &ДоговорСтрахования
		|	И ВЫБОР
		|		КОГДА &ЕстьДокументОснование
		|			ТОГДА Регистратор = &ДокументОснование
		|		ИНАЧЕ Регистратор <> &ИсключаемыйДокумент
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &ЕстьОтборПоСотрудникам
		|			ТОГДА ФизическоеЛицо В (&МассивФизическихЛиц)
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ) КАК ПрограммыСотрудников
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Регистратор,
		|	ФизическоеЛицо,
		|	ПрограммаСтрахования,
		|	Родственник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ПрограммыСотрудников.Период) КАК Период,
		|	ПрограммыСотрудников.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ ВТСгруппированныеПрограммыСотрудников
		|ИЗ
		|	ВТПрограммыСотрудников КАК ПрограммыСотрудников
		|СГРУППИРОВАТЬ ПО
		|	ПрограммыСотрудников.ФизическоеЛицо
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Период,
		|	ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрограммыСотрудников.Регистратор КАК Регистратор,
		|	ПрограммыСотрудников.ПрограммаСтрахования КАК ПрограммаСтрахования,
		|	ПрограммыСотрудников.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ ВТПоследниеПрограммыСотрудников
		|ИЗ
		|	ВТСгруппированныеПрограммыСотрудников КАК СгруппированныеПрограммыСотрудников
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПрограммыСотрудников КАК ПрограммыСотрудников
		|		ПО СгруппированныеПрограммыСотрудников.Период = ПрограммыСотрудников.Период
		|		И СгруппированныеПрограммыСотрудников.ФизическоеЛицо = ПрограммыСотрудников.ФизическоеЛицо
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Регистратор,
		|	ФизическоеЛицо,
		|	ПрограммаСтрахования";
	
	Запрос.Выполнить();
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(Запрос.МенеджерВременныхТаблиц, "ВТПрограммыСотрудников") Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Нет данных для заполнения.'"));
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	Запрос.УстановитьПараметр("ДействиеДобавить", Перечисления.ДействияСПрограммамиМедицинскогоСтрахования.Добавить);
	Запрос.УстановитьПараметр("ДействиеИзменить", Перечисления.ДействияСПрограммамиМедицинскогоСтрахования.Изменить);
	Запрос.УстановитьПараметр("ДействиеНеИзменять", Перечисления.ДействияСПрограммамиМедицинскогоСтрахования.НеИзменять);
	Запрос.УстановитьПараметр("БезРодственника", Справочники.РодственникиФизическихЛиц.ПустаяСсылка());
	
	СотрудникиТаблица= СотрудникиПрикрепления(Запрос);
	Для Каждого СтрокаСотрудники Из СотрудникиТаблица Цикл
		НоваяСтрока = Объект.Сотрудники.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСотрудники);
	КонецЦикла;
	ПрограммыСотрудниковТаблица = ПрограммыСтрахованияСотрудников(Запрос);
	Для Каждого СтрокаПрограммыСотрудника Из ПрограммыСотрудниковТаблица Цикл
		НоваяСтрока = Объект.ПрограммыСтрахованияСотрудников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрограммыСотрудника);
	КонецЦикла;
	РасширенияСотрудниковТаблица = РасширенияПрограммСтрахованияСотрудников(Запрос);
	Для Каждого СтрокаРасширениеСотрудника Из РасширенияСотрудниковТаблица Цикл
		НоваяСтрока = Объект.РасширенияПрограммСтрахованияСотрудников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасширениеСотрудника);
	КонецЦикла;
	ГрафикУдержанийТаблица = ГрафикУдержаний(Запрос);
	Для Каждого СтрокаГрафика Из ГрафикУдержанийТаблица Цикл
		НоваяСтрока = Объект.ГрафикУдержаний.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика);
	КонецЦикла;
	РодственникиТаблица = РодственникиПрикрепления(Запрос);
	Для Каждого СтрокаРодственника Из РодственникиТаблица Цикл
		НоваяСтрока = Объект.Родственники.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРодственника);
	КонецЦикла;
	ПрограммыРодственниковТаблица = ПрограммыСтрахованияРодственников(Запрос);
	Для Каждого СтрокаПрограммыРодственника Из ПрограммыРодственниковТаблица Цикл
		НоваяСтрока = Объект.ПрограммыСтрахованияРодственников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрограммыРодственника);
	КонецЦикла;
	РасширенияРодственниковТаблица = РасширенияПрограммСтрахованияРодственников(Запрос);
	Для Каждого СтрокаРасширениеРодственника Из РасширенияРодственниковТаблица Цикл
		НоваяСтрока = Объект.РасширенияПрограммСтрахованияРодственников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасширениеРодственника);
	КонецЦикла;
	Если РодственникиТаблица.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивФизическихЛиц,
			РодственникиТаблица.ВыгрузитьКолонку("РодственникСсылка"));
	КонецЕсли;
	ДанныеЗастрахованныхТаблица = ДанныеЗастрахованных(Запрос);
	Для Каждого СтрокаДанныеЗастрахованных Из ДанныеЗастрахованныхТаблица Цикл
		НоваяСтрока = Объект.ДанныеЗастрахованных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныеЗастрахованных);
	КонецЦикла;
	КИЗастрахованныхТаблица = КонтактнаяИнформацияЗастрахованных(Запрос);
	Для Каждого СтрокаКИЗастрахованных Из КИЗастрахованныхТаблица Цикл
		НоваяСтрока = Объект.КонтактнаяИнформацияЗастрахованных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКИЗастрахованных);
	КонецЦикла;
	Если ИспользоватьДополнительныеРеквизитыИСведения Тогда
		ДопРеквизитыИСведенияЗастрахованныхТаблица = ДополнительныеРеквизитыИСведенияЗастрахованных(Запрос);
		Для Каждого СтрокаДопРеквизиты Из ДопРеквизитыИСведенияЗастрахованныхТаблица Цикл
			НоваяСтрока = Объект.ДополнительныеРеквизитыИСведенияЗастрахованных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДопРеквизиты);
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьИзмененияПерсональныхДанных(МассивЗастрахованных);
	ДанныеВРеквизиты();
	РассчитатьСтраховуюПремиюСотрудников(МассивСотрудников);
	
	Для Каждого СтрокаСотрудники Из Объект.Сотрудники Цикл
		Если (ЕстьОтборПоСотрудникам И МассивСотрудников.Найти(СтрокаСотрудники.Сотрудник) = Неопределено)
		 Или СтрокаСотрудники.СпособУдержания <> Перечисления.СпособыУдержанияМедицинскогоСтрахованияСотрудников.ПоГрафику Тогда
			Продолжить;
		КонецЕсли;
		ПересчитатьГрафикУдержанийНаСервере(СтрокаСотрудники);
	КонецЦикла;
	
	Для Каждого СтрокаРодственника Из Объект.Родственники Цикл
		РодственникиОбработкаВыбораНаСервере(СтрокаРодственника.РодственникСсылка, СтрокаРодственника.ПолучитьИдентификатор());
	КонецЦикла;
	
	Объект.Сотрудники.Сортировать("Сотрудник");
	ЗарплатаКадрыКлиентСервер.КлючевыеРеквизитыЗаполненияФормыУстановитьОтображениеПредупреждения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДанныеПоСотрудникам(МассивСотрудников, МассивФизическихЛиц = Неопределено)

	Если МассивФизическихЛиц = Неопределено Тогда
		МассивФизическихЛиц = Новый Массив;
		ФизическиеЛицаСотрудников = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСотрудников, "ФизическоеЛицо", Истина);
		Для Каждого ЭлементСоответствия Из ФизическиеЛицаСотрудников Цикл
			МассивФизическихЛиц.Добавить(ЭлементСоответствия.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ЗаполняемыеТаблицыСотрудников = Документы.ИзменениеУсловийМедицинскогоСтрахования.ЗаполняемыеТаблицыСотрудников();
	ЗаполняемыеТаблицыФизическихЛиц	= Документы.ИзменениеУсловийМедицинскогоСтрахования.ЗаполняемыеТаблицыФизическихЛиц();
	ЗаполняемыеТаблицыЗастрахованных = Документы.ИзменениеУсловийМедицинскогоСтрахования.ЗаполняемыеТаблицыЗастрахованных();
	
	ОтборСотрудников 	= Новый Структура("Сотрудник");
	ОтборПоказателей 	= Новый Структура("ИдентификаторСтрокиВидаРасчета");
	ОтборФизическихЛиц 	= Новый Структура("ФизическоеЛицо");
	ОтборЗастрахованных	= Новый Структура("Застрахованный");
	
	Для Каждого Сотрудник Из МассивСотрудников Цикл
		
		ОтборСотрудников.Сотрудник = Сотрудник;
		Для Каждого ЗаполняемаяТаблица Из ЗаполняемыеТаблицыСотрудников Цикл
			НайденныеСтроки = Объект[ЗаполняемаяТаблица].НайтиСтроки(ОтборСотрудников);
			
			Если ЗаполняемаяТаблица = "Сотрудники" Тогда
				Для Каждого НайденнаяСтрокаСотрудника Из НайденныеСтроки Цикл
					ОтборПоказателей.ИдентификаторСтрокиВидаРасчета = НайденнаяСтрокаСотрудника.ИдентификаторСтрокиВидаРасчета;
					СтрокиПоказателей = Объект.Показатели.НайтиСтроки(ОтборПоказателей);
					Для Каждого НайденнаяСтрокаПоказателей Из СтрокиПоказателей Цикл
						Объект.Показатели.Удалить(НайденнаяСтрокаПоказателей);
					КонецЦикла;
				КонецЦикла;	
			КонецЕсли;	
			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Объект[ЗаполняемаяТаблица].Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЦикла;
		
		ОтборЗастрахованных.Застрахованный = Сотрудник;
		Для Каждого ЗаполняемаяТаблица Из ЗаполняемыеТаблицыЗастрахованных Цикл
			НайденныеСтроки = Объект[ЗаполняемаяТаблица].НайтиСтроки(ОтборЗастрахованных);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Объект[ЗаполняемаяТаблица].Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ФизическоеЛицо Из МассивФизическихЛиц Цикл
		
		ОтборФизическихЛиц.ФизическоеЛицо = ФизическоеЛицо;
		Для Каждого ЗаполняемаяТаблица Из ЗаполняемыеТаблицыФизическихЛиц Цикл
			НайденныеСтроки = Объект[ЗаполняемаяТаблица].НайтиСтроки(ОтборФизическихЛиц);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Объект[ЗаполняемаяТаблица].Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЦикла;
		
		ОтборЗастрахованных.Застрахованный = ФизическоеЛицо;
		Для Каждого ЗаполняемаяТаблица Из ЗаполняемыеТаблицыЗастрахованных Цикл
			НайденныеСтроки = Объект[ЗаполняемаяТаблица].НайтиСтроки(ОтборЗастрахованных);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Объект[ЗаполняемаяТаблица].Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;		
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДанныеТаблицДокумента()
	
	Объект.Сотрудники.Очистить();
	Объект.ПрограммыСтрахованияСотрудников.Очистить();
	Объект.РасширенияПрограммСтрахованияСотрудников.Очистить();
	Объект.Родственники.Очистить();
	Объект.ПрограммыСтрахованияРодственников.Очистить();
	Объект.РасширенияПрограммСтрахованияРодственников.Очистить();
	Объект.Показатели.Очистить();
	Объект.ГрафикУдержаний.Очистить();
	Объект.ДанныеЗастрахованных.Очистить();
	Объект.КонтактнаяИнформацияЗастрахованных.Очистить();
	Объект.ДополнительныеРеквизитыИСведенияЗастрахованных.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзмененияПерсональныхДанных(МассивЗастрахованных)
	
	Если МассивЗастрахованных = Неопределено Тогда
		МассивЗастрахованных = Новый Массив;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЗастрахованных,
			Объект.Сотрудники.Выгрузить( , "ФизическоеЛицо").ВыгрузитьКолонку("ФизическоеЛицо"));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЗастрахованных,
			Объект.Родственники.Выгрузить( , "РодственникСсылка").ВыгрузитьКолонку("РодственникСсылка"));
	КонецЕсли;
	
	Если МассивЗастрахованных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьИзмененияДанных(МассивЗастрахованных);
	ЗаполнитьИзмененияКонтактнойИнформации(МассивЗастрахованных);
	ЗаполнитьИзмененияДопРеквизитовИСведений(МассивЗастрахованных);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзмененияДанных(МассивЗастрахованных)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДоговорСтрахования КАК ДоговорСтрахования,
		|	ИзменениеОтправленныхДанныхЗастрахованных.Застрахованный КАК Застрахованный,
		|	ИзменениеОтправленныхДанныхЗастрахованных.Фамилия КАК Фамилия,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ИзмениласьФамилия КАК ИзмениласьФамилия,
		|	ИзменениеОтправленныхДанныхЗастрахованных.Имя КАК Имя,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ИзменилосьИмя КАК ИзменилосьИмя,
		|	ИзменениеОтправленныхДанныхЗастрахованных.Отчество КАК Отчество,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ИзменилосьОтчество КАК ИзменилосьОтчество,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДатаРождения КАК ДатаРождения,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ИзмениласьДатаРождения КАК ИзмениласьДатаРождения,
		|	ИзменениеОтправленныхДанныхЗастрахованных.СтраховойНомерПФР КАК СтраховойНомерПФР,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ИзменилсяСтраховойНомерПФР КАК ИзменилсяСтраховойНомерПФР,
		|	ИзменениеОтправленныхДанныхЗастрахованных.Пол КАК Пол,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ИзменилсяПол КАК ИзменилсяПол,
		|	ИзменениеОтправленныхДанныхЗастрахованных.Страна КАК Страна,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ИзмениласьСтрана КАК ИзмениласьСтрана,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДокументПредставление КАК ДокументПредставление,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДокументВид КАК ДокументВид,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДокументСерия КАК ДокументСерия,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДокументНомер КАК ДокументНомер,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДокументСрокДействия КАК ДокументСрокДействия,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДокументКемВыдан КАК ДокументКемВыдан,
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДокументКодПодразделения КАК ДокументКодПодразделения
		|ИЗ
		|	РегистрСведений.ИзменениеОтправленныхДанныхЗастрахованных КАК ИзменениеОтправленныхДанныхЗастрахованных
		|ГДЕ
		|	ИзменениеОтправленныхДанныхЗастрахованных.ДоговорСтрахования = &ДоговорСтрахования
		|	И ИзменениеОтправленныхДанныхЗастрахованных.Застрахованный В(&МассивЗастрахованных)";
	Запрос.УстановитьПараметр("ДоговорСтрахования", Объект.ДоговорСтрахования);
	Запрос.УстановитьПараметр("МассивЗастрахованных", МассивЗастрахованных);
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		ФизическоеЛицо = ?(ТипЗнч(Результат.Застрахованный) = Тип("СправочникСсылка.ФизическиеЛица"),
			Результат.Застрахованный,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.Застрахованный, "Владелец"));
		НайденныеСтрокиСотрудники = Объект.Сотрудники.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
		Если НайденныеСтрокиСотрудники.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Результат.Застрахованный) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			НайденныеСтрокиСотрудники[0].ИзменилисьОтправленныеДанныеСотрудника = Истина;
		Иначе
			НайденныеСтрокиСотрудники[0].ИзменилисьУсловияСтрахованияРодственников = Истина;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Застрахованный", Результат.Застрахованный);
		НайденныеСтроки = Объект.ДанныеЗастрахованных.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			НайденнаяСтрока = Объект.ДанныеЗастрахованных.Добавить();
			НайденнаяСтрока.Застрахованный = Результат.Застрахованный;
		Иначе
			НайденнаяСтрока = НайденныеСтроки[0];
		КонецЕсли;
		
		Если Результат.ИзмениласьФамилия Тогда
			НайденнаяСтрока.Фамилия = Результат.Фамилия;
		КонецЕсли;
		Если Результат.ИзменилосьИмя Тогда
			НайденнаяСтрока.Имя = Результат.Имя;
		КонецЕсли;
		Если Результат.ИзменилосьОтчество Тогда
			НайденнаяСтрока.Отчество = Результат.Отчество;
		КонецЕсли;
		Если Результат.ИзмениласьДатаРождения Тогда
			НайденнаяСтрока.ДатаРождения = Результат.ДатаРождения;
		КонецЕсли;
		Если Результат.ИзменилсяСтраховойНомерПФР Тогда
			НайденнаяСтрока.СтраховойНомерПФР = Результат.СтраховойНомерПФР;
		КонецЕсли;
		Если Результат.ИзменилсяПол Тогда
			НайденнаяСтрока.Пол = Результат.Пол;
		КонецЕсли;
		Если Результат.ИзмениласьСтрана Тогда
			НайденнаяСтрока.Страна = Результат.Страна;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.ДокументВид) Тогда
			НайденнаяСтрока.ДокументВид = Результат.ДокументВид;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.ДокументСерия) Тогда
			НайденнаяСтрока.ДокументСерия = Результат.ДокументСерия;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.ДокументНомер) Тогда
			НайденнаяСтрока.ДокументНомер = Результат.ДокументНомер;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.ДокументДатаВыдачи) Тогда
			НайденнаяСтрока.ДокументДатаВыдачи = Результат.ДокументДатаВыдачи;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.ДокументСрокДействия) Тогда
			НайденнаяСтрока.ДокументСрокДействия = Результат.ДокументСрокДействия;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.ДокументКемВыдан) Тогда
			НайденнаяСтрока.ДокументКемВыдан = Результат.ДокументКемВыдан;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.ДокументКодПодразделения) Тогда
			НайденнаяСтрока.ДокументКодПодразделения = Результат.ДокументКодПодразделения;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзмененияКонтактнойИнформации(МассивЗастрахованных)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных.Застрахованный КАК Застрахованный,
		|	ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных.Вид КАК Вид,
		|	ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных.Представление КАК Представление
		|ИЗ
		|	РегистрСведений.ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных КАК ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных
		|ГДЕ
		|	ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных.ДоговорСтрахования = &ДоговорСтрахования
		|	И ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных.Застрахованный В(&МассивЗастрахованных)";
	Запрос.УстановитьПараметр("ДоговорСтрахования", Объект.ДоговорСтрахования);
	Запрос.УстановитьПараметр("МассивЗастрахованных", МассивЗастрахованных);
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Если ТипЗнч(Результат.Застрахованный) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			НайденныеСтрокиСотрудники = Объект.Сотрудники.НайтиСтроки(Новый Структура("ФизическоеЛицо", Результат.Застрахованный));
			Если НайденныеСтрокиСотрудники.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			НайденныеСтрокиСотрудники[0].ИзменилисьОтправленныеДанныеСотрудника = Истина;
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Застрахованный", Результат.Застрахованный);
			СтруктураПоиска.Вставить("Вид", Результат.Вид);
			НайденныеСтрокиКИ = Объект.КонтактнаяИнформацияЗастрахованных.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтрокиКИ.Количество() = 0 Тогда
				НайденнаяСтрокаКИ = Объект.КонтактнаяИнформацияЗастрахованных.Добавить();
				НайденнаяСтрокаКИ.Застрахованный = Результат.Застрахованный;
				НайденнаяСтрокаКИ.Вид = Результат.Вид;
			Иначе
				НайденнаяСтрокаКИ = НайденныеСтрокиКИ[0];
			КонецЕсли;
			НайденнаяСтрокаКИ.Значение = Результат.Представление;
			НайденнаяСтрокаКИ.Представление = Результат.Представление;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзмененияДопРеквизитовИСведений(МассивЗастрахованных)
	
	Если Не ИспользоватьДополнительныеРеквизитыИСведения Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных.Застрахованный КАК Застрахованный,
		|	ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных.Свойство КАК Свойство,
		|	ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных КАК ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных
		|ГДЕ
		|	ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных.ДоговорСтрахования = &ДоговорСтрахования
		|	И ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных.Застрахованный В(&МассивЗастрахованных)";
	Запрос.УстановитьПараметр("ДоговорСтрахования", Объект.ДоговорСтрахования);
	Запрос.УстановитьПараметр("МассивЗастрахованных", МассивЗастрахованных);
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Если ТипЗнч(Результат.Застрахованный) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			НайденныеСтрокиСотрудники = Объект.Сотрудники.НайтиСтроки(Новый Структура("ФизическоеЛицо", Результат.Застрахованный));
			Если НайденныеСтрокиСотрудники.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			НайденныеСтрокиСотрудники[0].ИзменилисьОтправленныеДанныеСотрудника = Истина;
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Застрахованный", Результат.Застрахованный);
			СтруктураПоиска.Вставить("Свойство", Результат.Свойство);
			НайденныеСтрокиДопРеквизитыИСведения = Объект.ДополнительныеРеквизитыИСведенияЗастрахованных.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтрокиДопРеквизитыИСведения.Количество() = 0 Тогда
				НайденнаяСтрокаДопРеквизитыИСведения = Объект.ДополнительныеРеквизитыИСведенияЗастрахованных.Добавить();
				НайденнаяСтрокаДопРеквизитыИСведения.Застрахованный = Результат.Застрахованный;
				НайденнаяСтрокаДопРеквизитыИСведения.Свойство = Результат.Свойство;
			Иначе
				НайденнаяСтрокаДопРеквизитыИСведения = НайденныеСтрокиДопРеквизитыИСведения[0];
			КонецЕсли;
			НайденнаяСтрокаДопРеквизитыИСведения.Значение = Результат.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СотрудникиПрикрепления(Запрос);

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументПрикреплениеСотрудники.Сотрудник КАК Сотрудник,
		|	ДокументПрикреплениеСотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДокументПрикреплениеСотрудники.ДатаПрикрепления КАК ДатаПрикрепления,
		|	ДокументПрикреплениеСотрудники.Ссылка КАК Прикрепление,
		|	ДокументПрикреплениеСотрудники.ПрограммыСтрахования КАК ПрограммыСтрахования,
		|	ДокументПрикреплениеСотрудники.РасширенияПрограммСтрахования КАК РасширенияПрограммСтрахования,
		|	ДокументПрикреплениеСотрудники.СтраховаяПремия КАК СтраховаяПремия,
		|	ДокументПрикреплениеСотрудники.СуммаУдержания КАК СуммаУдержания,
		|	ДокументПрикреплениеСотрудники.СуммаПредела КАК СуммаПредела,
		|	ДокументПрикреплениеСотрудники.ПрограммаСтрахования КАК ПрограммаСтрахования,
		|	ДокументПрикреплениеСотрудники.РасширениеПрограммСтрахования КАК РасширениеПрограммСтрахования,
		|	ДокументПрикреплениеСотрудники.УдерживатьИзЗарплаты КАК УдерживатьИзЗарплаты,
		|	ДокументПрикреплениеСотрудники.Удержание КАК Удержание,
		|	ДокументПрикреплениеСотрудники.СпособУдержания КАК СпособУдержания,
		|	ДокументПрикреплениеСотрудники.ОбщаяСуммаУдержания КАК ОбщаяСуммаУдержания,
		|	ДокументПрикреплениеСотрудники.ЧастичноеУдержание КАК ЧастичноеУдержание,
		|	ДокументПрикреплениеСотрудники.СуммаЧастичногоУдержания КАК СуммаЧастичногоУдержания,
		|	ДокументПрикреплениеСотрудники.ПроцентЧастичногоУдержания КАК ПроцентЧастичногоУдержания
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.Сотрудники КАК ДокументПрикреплениеСотрудники
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &ЕстьОтборПоСотрудникам
		|			ТОГДА ДокументПрикреплениеСотрудники.Сотрудник В (&МассивСотрудников)
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И (ДокументПрикреплениеСотрудники.Ссылка, ДокументПрикреплениеСотрудники.ФизическоеЛицо) В
		|		(ВЫБРАТЬ
		|			ПрограммыСотрудников.Регистратор,
		|			ПрограммыСотрудников.ФизическоеЛицо
		|		ИЗ
		|			ВТПоследниеПрограммыСотрудников КАК ПрограммыСотрудников)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДокументИзменениеСотрудники.Сотрудник КАК Сотрудник,
		|	ДокументИзменениеСотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДокументИзменениеСотрудники.ДатаПрикрепления КАК ДатаПрикрепления,
		|	ВЫБОР
		|		КОГДА &ЕстьДокументОснование
		|			ТОГДА &ДокументОснование
		|		ИНАЧЕ ДокументИзменениеСотрудники.Прикрепление
		|	КОНЕЦ КАК Прикрепление,
		|	ДокументИзменениеСотрудники.ПрограммыСтрахования КАК ПрограммыСтрахования,
		|	ДокументИзменениеСотрудники.РасширенияПрограммСтрахования КАК РасширенияПрограммСтрахования,
		|	ДокументИзменениеСотрудники.СтраховаяПремия КАК СтраховаяПремия,
		|	ДокументИзменениеСотрудники.СуммаУдержания КАК СуммаУдержания,
		|	ДокументИзменениеСотрудники.СуммаПредела КАК СуммаПредела,
		|	ДокументИзменениеСотрудники.ПрограммаСтрахования КАК ПрограммаСтрахования,
		|	ДокументИзменениеСотрудники.РасширениеПрограммСтрахования КАК РасширениеПрограммСтрахования,
		|	ДокументИзменениеСотрудники.УдерживатьИзЗарплаты КАК УдерживатьИзЗарплаты,
		|	ДокументИзменениеСотрудники.Удержание КАК Удержание,
		|	ДокументИзменениеСотрудники.СпособУдержания КАК СпособУдержания,
		|	ДокументИзменениеСотрудники.ОбщаяСуммаУдержания КАК ОбщаяСуммаУдержания,
		|	ДокументИзменениеСотрудники.ЧастичноеУдержание КАК ЧастичноеУдержание,
		|	ДокументИзменениеСотрудники.СуммаЧастичногоУдержания КАК СуммаЧастичногоУдержания,
		|	ДокументИзменениеСотрудники.ПроцентЧастичногоУдержания КАК ПроцентЧастичногоУдержания
		|ИЗ
		|	Документ.ИзменениеУсловийМедицинскогоСтрахования.Сотрудники КАК ДокументИзменениеСотрудники
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &ЕстьОтборПоСотрудникам
		|			ТОГДА ДокументИзменениеСотрудники.Сотрудник В (&МассивСотрудников)
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И (ДокументИзменениеСотрудники.Ссылка, ДокументИзменениеСотрудники.ФизическоеЛицо) В
		|		(ВЫБРАТЬ
		|			ПрограммыСотрудников.Регистратор,
		|			ПрограммыСотрудников.ФизическоеЛицо
		|		ИЗ
		|			ВТПоследниеПрограммыСотрудников КАК ПрограммыСотрудников)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ПрограммыСтрахованияСотрудников(Запрос);

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументПрикреплениеПрограммыСтрахованияСотрудников.Сотрудник КАК Сотрудник,
		|	ДокументПрикреплениеПрограммыСтрахованияСотрудников.ПрограммаСтрахования КАК ПрограммаСтрахования,
		|	ДокументПрикреплениеПрограммыСтрахованияСотрудников.СтраховаяПремия КАК СтраховаяПремия,
		|	ДокументПрикреплениеПрограммыСтрахованияСотрудников.ДатаНачала КАК ДатаНачала,
		|	ДокументПрикреплениеПрограммыСтрахованияСотрудников.ДатаОкончания КАК ДатаОкончания,
		|	НЕОПРЕДЕЛЕНО КАК Действие
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ПрограммыСтрахованияСотрудников КАК
		|		ДокументПрикреплениеПрограммыСтрахованияСотрудников
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &ЕстьОтборПоСотрудникам
		|			ТОГДА ДокументПрикреплениеПрограммыСтрахованияСотрудников.Сотрудник В
		|			(&МассивСотрудников)
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И (ДокументПрикреплениеПрограммыСтрахованияСотрудников.Ссылка,
		|		ДокументПрикреплениеПрограммыСтрахованияСотрудников.Сотрудник.ФизическоеЛицо,
		|		ДокументПрикреплениеПрограммыСтрахованияСотрудников.ПрограммаСтрахования) В
		|		(ВЫБРАТЬ
		|			ПрограммыСотрудников.Регистратор,
		|			ПрограммыСотрудников.ФизическоеЛицо,
		|			ПрограммыСотрудников.ПрограммаСтрахования
		|		ИЗ
		|			ВТПрограммыСотрудников КАК ПрограммыСотрудников
		|		ГДЕ
		|			ПрограммыСотрудников.Родственник = &БезРодственника)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДокументИзменениеПрограммыСтрахованияСотрудников.Сотрудник КАК Сотрудник,
		|	ДокументИзменениеПрограммыСтрахованияСотрудников.ПрограммаСтрахования КАК ПрограммаСтрахования,
		|	ДокументИзменениеПрограммыСтрахованияСотрудников.СтраховаяПремия КАК СтраховаяПремия,
		|	ДокументИзменениеПрограммыСтрахованияСотрудников.ДатаНачала КАК ДатаНачала,
		|	ДокументИзменениеПрограммыСтрахованияСотрудников.ДатаОкончания КАК ДатаОкончания,
		|	ВЫБОР
		|		КОГДА ДокументИзменениеПрограммыСтрахованияСотрудников.Действие = &ДействиеДобавить
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		КОГДА ДокументИзменениеПрограммыСтрахованияСотрудников.Действие = &ДействиеИзменить
		|			ТОГДА &ДействиеНеИзменять
		|		ИНАЧЕ ДокументИзменениеПрограммыСтрахованияСотрудников.Действие
		|	КОНЕЦ КАК Действие
		|ИЗ
		|	Документ.ИзменениеУсловийМедицинскогоСтрахования.ПрограммыСтрахованияСотрудников КАК
		|		ДокументИзменениеПрограммыСтрахованияСотрудников
		|ГДЕ
