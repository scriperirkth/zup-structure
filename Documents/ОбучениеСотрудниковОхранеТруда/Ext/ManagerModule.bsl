// Возвращает данные обучения охраны труда.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка.ОбучениеСотрудниковОхранеТруда - 
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//    * Ссылка - ДокументСсылка.ОбучениеСотрудниковОхранеТруда
//    * Номер - Строка
//    * Дата - Дата
//    * Проведен - Булево
//    * Организация - СправочникСсылка.Организации
//    * ПрограммаОбучения - СправочникСсылка.ПрограммыОбученияСотрудниковПоОхранеТруда
//    * ФизическоеЛицо - СправочникСсылка.ФизическиеЛица
//    * РабочееМесто - СправочникСсылка.РабочиеМестаОхраныТруда
//    * ПлановаяДатаПроверкиЗнания - Дата
//    * Ответственный - СправочникСсылка.Пользователи
//    * Комментарий - Строка
//    * ДокументОтсутствия - ДокументСсылка.ОплатаПоСреднемуЗаработкуСписком - 
//
Функция ДанныеОбучения(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Обучение.Ссылка КАК Ссылка,
		|	Обучение.Номер КАК Номер,
		|	Обучение.Дата КАК Дата,
		|	Обучение.ДатаНачалаОбучения КАК ДатаНачалаОбучения,
		|	Обучение.ДатаОкончанияОбучения КАК ДатаОкончанияОбучения,
		|	Обучение.Проведен КАК Проведен,
		|	Обучение.Организация КАК Организация,
		|	Обучение.ПрограммаОбучения КАК ПрограммаОбучения,
		|	ОбученияСотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОбученияСотрудники.РабочееМесто КАК РабочееМесто,
		|	ОбученияСотрудники.ПлановаяДатаПроверкиЗнания КАК ПлановаяДатаПроверкиЗнания,
		|	Обучение.Ответственный КАК Ответственный,
		|	Обучение.Комментарий КАК Комментарий,
		|	Отсутствия.ДокументОтсутствия КАК ДокументОтсутствия
		|ИЗ
		|	Документ.ОбучениеСотрудниковОхранеТруда КАК Обучение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОбучениеСотрудниковОхранеТруда.Сотрудники КАК ОбученияСотрудники
		|		ПО Обучение.Ссылка = ОбученияСотрудники.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтсутствияССохранениемОплатыПриОбученииОхранеТруда КАК Отсутствия
		|		ПО Отсутствия.ДокументОснование = ОбученияСотрудники.Ссылка
		|		И Отсутствия.ФизическоеЛицо = ОбученияСотрудники.ФизическоеЛицо
		|		И Отсутствия.ДокументОснование.Проведен
		|ГДЕ
		|	Обучение.Ссылка = &Ссылка";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

#КонецОбласти

#КонецЕсли
