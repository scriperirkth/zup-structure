Функция ПолучитьИдентификаторЗаписиЗаработнойПлаты(ПараметрыЗаписи)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров КАК ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров
		|ГДЕ
		|	ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.УИНОрганизации = &УИНОрганизации
		|	И ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.ОтчетныйПериод = &ОтчетныйПериод
		|	И ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.ТипПериода = &ТипПериода
		|	И ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.Сотрудник = &Сотрудник
		|	И ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.Подразделение = &Подразделение
		|	И ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.Должность = &Должность
		|	И ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.МоментУдаления = &МоментУдаления";
	
	Запрос.УстановитьПараметр("Должность", ПараметрыЗаписи.Должность);
	Запрос.УстановитьПараметр("МоментУдаления", Дата('00010101'));
	Запрос.УстановитьПараметр("ОтчетныйПериод", ПараметрыЗаписи.ОтчетныйПериод);
	Запрос.УстановитьПараметр("Подразделение", ПараметрыЗаписи.Подразделение);
	Запрос.УстановитьПараметр("Сотрудник", ПараметрыЗаписи.Сотрудник);
	Запрос.УстановитьПараметр("ТипПериода", ПараметрыЗаписи.ТипПериода);
	Запрос.УстановитьПараметр("УИНОрганизации", ПараметрыЗаписи.УИНОрганизации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Идентификатор;
	Иначе 	
        Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьРезультатВыгрузки(ДатаСобытия, Идентификатор, МоментВыгрузки, РазделМедрегистра, ТипВыгрузки = 0)
	// В РС результатов выгрузки запишем сторку, где обозначим, что это выгрузка именно ШР установив 
	// в качестве измерения Объект пустую ссылку на документ утверждения ШР, а в измерение ДатаСобытия
	// запишем дату начала действия ШР. 
	// Пусная ссылка на документ изменения ШР тоже поддерживается, но пока такая возможность не задействована.
	// При выгрузке ЗП в качестве измерения Объект пустую ссылку на документ начисления ЗП, а в измерение ДатаСобытия
	// запишем дату отчетного периода. 
	Набор = РегистрыСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров.СоздатьНаборЗаписей();
	Если ТипВыгрузки=0 Тогда 
		Набор.Отбор.Объект.Установить(Документы.УтверждениеШтатногоРасписания.ПустаяСсылка());
	ИначеЕсли ТипВыгрузки=1 Тогда
		Набор.Отбор.Объект.Установить(Документы.НачислениеЗарплаты.ПустаяСсылка());
	Иначе
		Возврат;
	КонецЕсли;
	Набор.Отбор.ДатаСобытия.Установить(ДатаСобытия);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		РезультатВыгрузки = Набор.Добавить();
		Если ТипВыгрузки=0 Тогда 
			РезультатВыгрузки.Объект = Документы.УтверждениеШтатногоРасписания.ПустаяСсылка();
		ИначеЕсли ТипВыгрузки=1 Тогда 
			РезультатВыгрузки.Объект = Документы.НачислениеЗарплаты.ПустаяСсылка();
		Иначе
			Возврат;
		КонецЕсли;
		РезультатВыгрузки.ДатаСобытия = ДатаСобытия;
	Иначе
		РезультатВыгрузки = Набор[0];
	КонецЕсли;
	РезультатВыгрузки.Идентификатор = Идентификатор;
	Если МоментВыгрузки<>Неопределено Тогда 
		РезультатВыгрузки.МоментВыгрузки = МоментВыгрузки;
	КонецЕсли;
	Если РазделМедрегистра<>Неопределено Тогда 
		РезультатВыгрузки.РазделМедрегистра = РазделМедрегистра;
	КонецЕсли;
	Набор.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьРезультатВыгрузкиЗаписиЗаработнойПлаты(ПараметрыЗаписи, Идентификатор, МоментВыгрузки)
	
	Набор = РегистрыСведений.ИдентификаторыЗаписейЗаработнойПлатыДляФедеральныхМедрегистров.СоздатьНаборЗаписей();
	Набор.Отбор.УИНОрганизации.Установить(ПараметрыЗаписи.УИНОрганизации);
	Набор.Отбор.ОтчетныйПериод.Установить(ПараметрыЗаписи.ОтчетныйПериод);
	Набор.Отбор.ТипПериода.Установить(ПараметрыЗаписи.ТипПериода);
	Набор.Отбор.Сотрудник.Установить(ПараметрыЗаписи.Сотрудник);
	Набор.Отбор.Подразделение.Установить(ПараметрыЗаписи.Подразделение);
	Набор.Отбор.Должность.Установить(ПараметрыЗаписи.Должность);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		РезультатВыгрузки = Набор.Добавить();
		РезультатВыгрузки.УИНОрганизации = ПараметрыЗаписи.УИНОрганизации;
		РезультатВыгрузки.ОтчетныйПериод = ПараметрыЗаписи.ОтчетныйПериод;
		РезультатВыгрузки.ТипПериода = ПараметрыЗаписи.ТипПериода;
		РезультатВыгрузки.Сотрудник = ПараметрыЗаписи.Сотрудник;
		РезультатВыгрузки.Подразделение = ПараметрыЗаписи.Подразделение;
		РезультатВыгрузки.Должность = ПараметрыЗаписи.Должность;
	Иначе
		РезультатВыгрузки = Набор[0];
	КонецЕсли;
	РезультатВыгрузки.Идентификатор = Идентификатор;
	Если МоментВыгрузки<>Неопределено Тогда 
		РезультатВыгрузки.МоментВыгрузки = МоментВыгрузки;
	КонецЕсли;
	Набор.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаписатьНовуюДатуОкончания(ДатаНачала, НоваяДатаОкончания, Организация)
	
	ДокументИзмененУспешно = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведенияДляФРМО.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СведенияДляФРМО КАК СведенияДляФРМО
		|ГДЕ
		|	СведенияДляФРМО.Организация = &Организация
		|	И СведенияДляФРМО.ДатаНачалаДействия = &ДатаНачалаДействия";
	
	Запрос.УстановитьПараметр("ДатаНачалаДействия", ДатаНачала);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументДляЗаписи = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ДокументЗаблокирован = Истина;
		Попытка
		  ДокументДляЗаписи.Заблокировать();
		Исключение
			ДокументЗаблокирован = Ложь;
			ДокументИзмененУспешно = Ложь;
		КонецПопытки;
		
		Если ДокументЗаблокирован Тогда 
			ДокументДляЗаписи.ДатаОкончанияДействия = НоваяДатаОкончания;
			ДокументДляЗаписи.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДокументИзмененУспешно;
	
КонецФункции

