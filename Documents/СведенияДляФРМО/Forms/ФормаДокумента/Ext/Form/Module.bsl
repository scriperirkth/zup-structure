&НаСервереБезКонтекста
Функция ПолучитьИдентификаторШтатногоРасписания(ДатаШтатногоРасписания)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ИдентификаторыОбъектовДляФедеральныхМедрегистров.ДатаСобытия) КАК ДатаСобытия
		|ПОМЕСТИТЬ ВТДатаАктуальногоШтатногоРасписания
		|ИЗ
		|	РегистрСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров КАК ИдентификаторыОбъектовДляФедеральныхМедрегистров
		|ГДЕ
		|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.ДатаСобытия <= &ДатаСобытия
		|	И (ТИПЗНАЧЕНИЯ(ИдентификаторыОбъектовДляФедеральныхМедрегистров.Объект) = ТИП(Документ.ИзменениеШтатногоРасписания)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ИдентификаторыОбъектовДляФедеральныхМедрегистров.Объект) = ТИП(Документ.УтверждениеШтатногоРасписания))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров КАК ИдентификаторыОбъектовДляФедеральныхМедрегистров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДатаАктуальногоШтатногоРасписания КАК ВТДатаАктуальногоШтатногоРасписания
		|		ПО ИдентификаторыОбъектовДляФедеральныхМедрегистров.ДатаСобытия = ВТДатаАктуальногоШтатногоРасписания.ДатаСобытия
		|			И (ТИПЗНАЧЕНИЯ(ИдентификаторыОбъектовДляФедеральныхМедрегистров.Объект) = ТИП(Документ.ИзменениеШтатногоРасписания)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ИдентификаторыОбъектовДляФедеральныхМедрегистров.Объект) = ТИП(Документ.УтверждениеШтатногоРасписания))";

	Запрос.УстановитьПараметр("ДатаСобытия", ДатаШтатногоРасписания);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Идентификатор;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

