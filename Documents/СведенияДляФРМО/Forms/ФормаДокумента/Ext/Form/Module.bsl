КонецФункции 

&НаКлиенте
Процедура ЗаполнитьШтатноеРасписаниеНаКлиенте(ЗаполнятьТолькоМедицинскимиДолжностями)

	Результат = РезультатЗаполненияШтатногоРасписанияВДлительнойОперации(ЗаполнятьТолькоМедицинскимиДолжностями);
	Если Результат.ЗаданиеВыполнено Тогда
		ОповеститьОбИзменении(Объект.Ссылка);
	Иначе
		ИдентификаторЗадания = Результат.ИдентификаторЗадания;
		АдресХранилища		 = Результат.АдресХранилища;
		
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РезультатЗаполненияШтатногоРасписанияВДлительнойОперации(ЗаполнятьТолькоМедицинскимиДолжностями)
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ДанныеДляЗаполнения", Новый Структура("ШтатныеЕдиницы"));
	ПараметрыЗаполнения.Вставить("Ссылка", Объект.Ссылка);
	ПараметрыЗаполнения.Вставить("Организация", Объект.Организация);
	ПараметрыЗаполнения.Вставить("ДатаАктуальности", Объект.ДатаНачалаДействия);
	ПараметрыЗаполнения.Вставить("ЗаполнятьТолькоМедицинскимиДолжностями", ЗаполнятьТолькоМедицинскимиДолжностями);
	
	НаименованиеЗадания = НСтр("ru = 'Заполнение документа ""Сведения для ФРМО""'");
	
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор,
		"Документы.СведенияДляФРМО.ПодготовитьДанныеДляЗаполненияШтатногоРасписания",
		ПараметрыЗаполнения,
		НаименованиеЗадания);
	
	АдресХранилища = Результат.АдресХранилища;
	
	Если Результат.ЗаданиеВыполнено Тогда
		ЗаполнениеПослеВыполненияДлительнойОперации();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЗаработнуюПлатуНаКлиенте(Знач СписокРаботников = Неопределено)

	Результат = РезультатЗаполненияЗаработнойПлатыВДлительнойОперации(СписокРаботников);
	Если Результат.ЗаданиеВыполнено Тогда
		ОповеститьОбИзменении(Объект.Ссылка);
	Иначе
		ИдентификаторЗадания = Результат.ИдентификаторЗадания;
		АдресХранилища		 = Результат.АдресХранилища;
		
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РезультатЗаполненияЗаработнойПлатыВДлительнойОперации(Знач СписокРаботников = Неопределено)
	
	ПараметрыЗаполнения = Новый Структура("ДанныеДляЗаполнения,Ссылка,Организация,ДатаАктуальности,СписокРаботников");
	ПараметрыЗаполнения.ДанныеДляЗаполнения = Новый Структура("ДанныеНачислений,ДанныеУдержаний");
	ПараметрыЗаполнения.Ссылка = Объект.Ссылка;
	ПараметрыЗаполнения.Организация = Объект.Организация;
	ПараметрыЗаполнения.ДатаАктуальности = Объект.ОтчетныйПериод;
	ПараметрыЗаполнения.СписокРаботников = СписокРаботников;
	
	НаименованиеЗадания = НСтр("ru = 'Заполнение документа ""Сведения для ФРМО""'");
	
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор,
		"Документы.СведенияДляФРМО.ПодготовитьДанныеДляЗаполненияЗаработнойПлаты",
		ПараметрыЗаполнения,
		НаименованиеЗадания);
	
	АдресХранилища = Результат.АдресХранилища;
	
	Если Результат.ЗаданиеВыполнено Тогда
		ЗаполнениеПослеВыполненияДлительнойОперации();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнениеПослеВыполненияДлительнойОперации()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьИзХранилища(АдресХранилища);
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
	
	ЗарплатаКадрыКлиентСервер.КлючевыеРеквизитыЗаполненияФормыУстановитьОтображениеПредупреждения(ЭтаФорма);
	УстановитьФлагиМедицинскихДолжностей();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			
			Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
				ЗаполнениеПослеВыполненияДлительнойОперации();
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания(
					"Подключаемый_ПроверитьВыполнениеЗадания",
					ПараметрыОбработчикаОжидания.ТекущийИнтервал,
					Истина);
			КонецЕсли;
				
		КонецЕсли;
		
	Исключение
		
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		
		СообщенияПользователю = СообщенияФоновогоЗадания(ИдентификаторЗадания);
		Если СообщенияПользователю <> Неопределено Тогда
			
			Для Каждого СообщениеФоновогоЗадания Из СообщенияПользователю Цикл
				СообщениеФоновогоЗадания.Сообщить();
			КонецЦикла;
			
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	ОповеститьОбИзменении(Объект.Ссылка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаСервереБезКонтекста
Функция СообщенияФоновогоЗадания(ИдентификаторЗадания)
	
	СообщенияПользователю = Новый Массив;
	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если ФоновоеЗадание <> Неопределено Тогда
		СообщенияПользователю = ФоновоеЗадание.ПолучитьСообщенияПользователю();
	КонецЕсли;
	
	Возврат СообщенияПользователю;
	
КонецФункции

#Область ВыгрузкаВФРМО

&НаКлиенте
Процедура ВыгрузитьШтатноеРасписаниеВФРМОНаКлиенте() 
	
	Если Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Идентификатор = Неопределено;
	КонфликтующееШтатноеРасписаниеФРМО = Неопределено;
	ПараметрыСервиса = ПараметрыСервиса();
	ПараметрыВызова = GetOrgStaff(Объект.УИНОрганизации);
	ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
	ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
	Если ОтветСервиса.КодСостояния<400 Тогда 
		Если ТипЗнч(ОтветСервиса.Контент)=Тип("Массив") Тогда
			Для Каждого ШтатноеРасписаниеФРМО Из ОтветСервиса.Контент Цикл 
				ИдентификаторФРМО = ШтатноеРасписаниеФРМО.staffId;
				ДатаНачалаДействияФРМО = МедицинскиеРегистрыКлиент.ДатаИзUTC(ШтатноеРасписаниеФРМО.beginDate);
				ДатаОкончанияДействияФРМО = МедицинскиеРегистрыКлиент.ДатаИзUTC(ШтатноеРасписаниеФРМО.endDate);
				Если ДатаНачалаДействияФРМО=Объект.ДатаНачалаДействия Тогда
					Идентификатор = ИдентификаторФРМО;
					ЗаписатьРезультатВыгрузки(Объект.ДатаНачалаДействия, Идентификатор, Неопределено, Неопределено);
				ИначеЕсли ДатаНачалаДействияФРМО<Объект.ДатаНачалаДействия И Объект.ДатаНачалаДействия<=ДатаОкончанияДействияФРМО Тогда 
					КонфликтующееШтатноеРасписаниеФРМО =  ШтатноеРасписаниеФРМО;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
		СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Получение данных штатного расписания: %1%2'"), ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
	КонецЕсли;

	ДанныеШтатногоРасписания = ПолучитьДанныеШтатногоРасписания(Объект.Ссылка);

	StaffData = StaffData();
	StaffData.staffNum = НеопределеноЕслиПустаяСтрока(Объект.НомерШтатногоРасписания);
	StaffData.staffCreateDate = НеопределеноЕслиНеЗаполнено(Объект.ДатаУтверждения);
	StaffData.beginDate = НеопределеноЕслиНеЗаполнено(Объект.ДатаНачалаДействия);
	StaffData.endDate = НеопределеноЕслиНеЗаполнено(Объект.ДатаОкончанияДействия);
	StaffData.staffDetails = Новый Массив;
	
	Для Каждого Позиция Из ДанныеШтатногоРасписания Цикл  
	    staffDetails = staffDetails();
		staffDetails.nrPmuDepartId 	= НеопределеноЕслиПустаяСтрока(Позиция.ИдентификаторПодразделения);
		staffDetails.departName 	= НеопределеноЕслиПустаяСтрока(Позиция.НаименованиеПодразделения);
		staffDetails.nrPmuDepartHospitalSubdivisionId = НеопределеноЕслиПустаяСтрока(Позиция.ИдентификаторОтделенияИлиКабинета);
		staffDetails.hospitalName 	= НеопределеноЕслиПустаяСтрока(Позиция.НаименованиеОтделенияИлиКабинета);
		staffDetails.postFedCode.code = НеопределеноЕслиПустаяСтрока(Позиция.ДолжностьПоФедСправочникуКод);
		staffDetails.postFedCode.name = НеопределеноЕслиПустаяСтрока(Позиция.ДолжностьПоФедСправочникуНаименование);
		staffDetails.post.code 	= НеопределеноЕслиПустаяСтрока(Позиция.ДолжностьКод);
		staffDetails.post.name 	= НеопределеноЕслиПустаяСтрока(Позиция.ДолжностьНаименование);
		staffDetails.rate 		= Позиция.КоличествоСтавок;
		staffDetails.staffNote 	= Позиция.Описание;
		StaffData.staffDetails.Добавить(staffDetails);
	КонецЦикла;
	
	ВыгрузкаДопускается = Истина;
	Если ТипЗнч(КонфликтующееШтатноеРасписаниеФРМО)=Тип("Структура") Тогда 
		ДатаНачала = МедицинскиеРегистрыКлиент.ДатаИзUTC(КонфликтующееШтатноеРасписаниеФРМО.beginDate);
		НоваяДатаОкончания = НачалоДня(НачалоДня(Объект.ДатаНачалаДействия) - 1);
		КонфликтующееШтатноеРасписаниеФРМО.staffCreateDate = МедицинскиеРегистрыКлиент.ДатаИзUTC(КонфликтующееШтатноеРасписаниеФРМО.staffCreateDate);
		КонфликтующееШтатноеРасписаниеФРМО.beginDate = ДатаНачала;
		КонфликтующееШтатноеРасписаниеФРМО.endDate = НоваяДатаОкончания;
		Для Каждого Позиция Из КонфликтующееШтатноеРасписаниеФРМО.staffDetails Цикл
			Позиция.postFedCode.code = Формат(Позиция.postFedCode.code, "ЧГ=0; ЧН=");
			Позиция.post.code = Формат(Позиция.post.code, "ЧГ=0; ЧН=");
		КонецЦикла;
		ПараметрыВызова = PostPutOrgStaff(Объект.УИНОрганизации, КонфликтующееШтатноеРасписаниеФРМО.staffId, КонфликтующееШтатноеРасписаниеФРМО);
		ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
		ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
		Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
			СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Замена даты окончания штатного расписания: %1%2'"), ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
			ВыгрузкаДопускается = Ложь;
		Иначе 
			ВыгрузкаДопускается = ЗаписатьНовуюДатуОкончания(ДатаНачала, НоваяДатаОкончания, Объект.Организация);
			Если Не ВыгрузкаДопускается Тогда 
				СообщениеОбОшибкеПользователю = НСтр("ru = 'Не удалось сделать замену даты окончания предыдущего штатного расписания в документе выгрузки.
				|Возможно, он открыт для редактирования.'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ВыгрузкаДопускается Тогда
		
		Объект.ВыгрузкаПроведена = Истина;
		ПараметрыВызова = PostPutOrgStaff(Объект.УИНОрганизации, Идентификатор, StaffData);
		ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
		ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
		Если ОтветСервиса.КодСостояния<400 Тогда 
			Если ПараметрыВызова.Метод = "POST" И ОтветСервиса.Контент<>Неопределено Тогда 
				Идентификатор = ОтветСервиса.Контент.entityId;
				МоментВыгрузки = МоментВыгрузкиНаСервере();
				МоментВыгрузкиТекст = СтрШаблон(НСтр("ru = 'Выгрузка проведена %1'"), МоментВыгрузки);
				ЗаписатьРезультатВыгрузки(Объект.ДатаНачалаДействия, Идентификатор, МоментВыгрузки, ПараметрыВызова.РазделМедрегистра);
			ИначеЕсли ПараметрыВызова.Метод = "PUT" И ОтветСервиса.СообщениеОбОшибкеПользователю=Неопределено Тогда
				МоментВыгрузки = МоментВыгрузкиНаСервере();
				МоментВыгрузкиТекст = СтрШаблон(НСтр("ru = 'Выгрузка проведена %1'"), МоментВыгрузки);
				ЗаписатьРезультатВыгрузки(Объект.ДатаНачалаДействия, Идентификатор, МоментВыгрузки, ПараметрыВызова.РазделМедрегистра);
			Иначе 
				Объект.ВыгрузкаПроведена = Ложь;
			КонецЕсли;
		Иначе 
			Объект.ВыгрузкаПроведена = Ложь;
		КонецЕсли;
		Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
			СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Выгрузка штатного расписания: %1%2'"), ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
		КонецЕсли;
		
		Записать();
		
	КонецЕсли;
			
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗаработнуюПлатуВФРМОНаКлиенте() 
	
	Если Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ИдентификаторШтатногоРасписания = ПолучитьИдентификаторШтатногоРасписания(КонецМесяца(Объект.ОтчетныйПериод));
	
	Если ИдентификаторШтатногоРасписания = Неопределено Тогда
		СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Не удалось подобрать идентификатор штатного расписания для выбранного периода выгрузки.'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
		Возврат;
	КонецЕсли;
	
	ТипВыгрузки = 1; // Период фактических показателей.
	ИдентификаторПериода = Неопределено;
	ПараметрыСервиса = ПараметрыСервиса();
	
	Смещение = 0;
	Ограничение = 20;
	КоличествоЭлементов = 1; // Если 0, то вылетим при первой ошибке, т.к. КоличествоЭлементов будет равно ПолученоЭлементов.
	ПолученоЭлементов = 0;
	СделаноПопыток = 1;
	МаксимумПопыток = 3;
	
	Пока Истина Цикл  
		ПараметрыВызова = GetSalaryPeriod(Объект.УИНОрганизации, ТипВыгрузки, Смещение, Ограничение);
		ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
		ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
		Если ОтветСервиса.КодСостояния < 400 Тогда 
			Если ТипЗнч(ОтветСервиса.Контент) = Тип("Массив") Тогда
				Если ОтветСервиса.Контент.Количество() = 0 Тогда 
					Прервать;
				Иначе 
					СделаноПопыток = 1;
					Смещение = Смещение + Ограничение;
					КоличествоЭлементов = ОтветСервиса.Количество;
					Для Каждого ПериодЗаработнойПлатыФРМО Из ОтветСервиса.Контент Цикл 
						ПолученоЭлементов = ПолученоЭлементов + 1;
						ИдентификаторФРМО = ПериодЗаработнойПлатыФРМО.salaryPeriodId;
						ОтчетныйПериодФРМО = МедицинскиеРегистрыКлиент.ДатаИзUTC(ПериодЗаработнойПлатыФРМО.periodDate);
						Если ОтчетныйПериодФРМО = Объект.ОтчетныйПериод Тогда
							ИдентификаторПериода = ИдентификаторФРМО;
							ЗаписатьРезультатВыгрузки(Объект.ОтчетныйПериод, ИдентификаторПериода, Неопределено, Неопределено, ТипВыгрузки);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ОтветСервиса.КодСостояния > 200 И ОтветСервиса.СообщениеОбОшибкеПользователю <> Неопределено Тогда
			СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Получение периодов заработной платы: %1%2'"), ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
			СделаноПопыток = СделаноПопыток + 1;
		КонецЕсли;
		Если ИдентификаторПериода <> Неопределено Или ПолученоЭлементов >= КоличествоЭлементов Или СделаноПопыток > МаксимумПопыток Тогда 
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	
	Если ИдентификаторПериода = Неопределено Тогда // Можно только создать период заработной платы, изменение (метод PUT) не поддерживается.	
		SalaryPeriodData = SalaryPeriodData();
		SalaryPeriodData.salaryPeriodType = ТипВыгрузки;
		SalaryPeriodData.periodDate = НеопределеноЕслиНеЗаполнено(Объект.ОтчетныйПериод);
		SalaryPeriodData.staff.staffId = НеопределеноЕслиПустаяСтрока(ИдентификаторШтатногоРасписания);

		Объект.ВыгрузкаПроведена = Истина;
		ПараметрыВызова = PostPutSalaryPeriod(Объект.УИНОрганизации, ИдентификаторПериода, SalaryPeriodData);
		ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
		ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
		Если ОтветСервиса.КодСостояния < 400 Тогда 
			Если ПараметрыВызова.Метод = "POST" И ОтветСервиса.Контент<>Неопределено Тогда 
				ИдентификаторПериода = ОтветСервиса.Контент.entityId;
				МоментВыгрузки = МоментВыгрузкиНаСервере();
				МоментВыгрузкиТекст = СтрШаблон(НСтр("ru = 'Создание периода заработной платы выполнено %1'"), МоментВыгрузки);
				ЗаписатьРезультатВыгрузки(Объект.ОтчетныйПериод, ИдентификаторПериода, МоментВыгрузки, ПараметрыВызова.РазделМедрегистра, ТипВыгрузки);
			ИначеЕсли ПараметрыВызова.Метод = "PUT" И ОтветСервиса.СообщениеОбОшибкеПользователю = Неопределено Тогда
				МоментВыгрузки = МоментВыгрузкиНаСервере();
				МоментВыгрузкиТекст = СтрШаблон(НСтр("ru = 'Обновление периода заработной платы выполнено %1'"), МоментВыгрузки);
				ЗаписатьРезультатВыгрузки(Объект.ОтчетныйПериод, ИдентификаторПериода, МоментВыгрузки, ПараметрыВызова.РазделМедрегистра, ТипВыгрузки);
			Иначе 
				Объект.ВыгрузкаПроведена = Ложь;
			КонецЕсли;
		Иначе 
			Объект.ВыгрузкаПроведена = Ложь;
		КонецЕсли;
		Если ОтветСервиса.СообщениеОбОшибкеПользователю <> Неопределено Тогда
			Если ПараметрыВызова.Метод = "POST" Тогда 
				СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Создание периода заработной платы: %1'%2'"), ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
			ИначеЕсли ПараметрыВызова.Метод = "PUT" Тогда
				СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Обновление периода заработной платы: %1'%2'"), ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
			Иначе 
				СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Операция %1 с периодом заработной платы: %2%3'"), ПараметрыВызова.Метод, ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
			КонецЕсли;
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
		КонецЕсли;
	КонецЕсли;
	
	Если ИдентификаторПериода <> Неопределено Тогда
		Объект.ВыгрузкаПроведена = Истина;
		КодыИсточниковФинансирования = КодыИсточниковФинансированияДляМедрегистров();	
		ДанныеЗаработнойПлаты = ДанныеЗаработнойПлаты(Объект.Ссылка);
		ОтборНачисленийУдержаний = Новый Структура("ИдентификаторЛичногоДела", Неопределено);
		
		Для Каждого КадроваяПозиция Из ДанныеЗаработнойПлаты Цикл 
			
			ПараметрыЗаписиЗП = Новый Структура();
			ПараметрыЗаписиЗП.Вставить("УИНОрганизации", Объект.УИНОрганизации);	
			ПараметрыЗаписиЗП.Вставить("ОтчетныйПериод", Объект.ОтчетныйПериод);	
			ПараметрыЗаписиЗП.Вставить("ТипПериода", ТипВыгрузки);	
			ПараметрыЗаписиЗП.Вставить("Сотрудник", КадроваяПозиция.Сотрудник);	
			ПараметрыЗаписиЗП.Вставить("Подразделение", КадроваяПозиция.Подразделение);	
			ПараметрыЗаписиЗП.Вставить("Должность", КадроваяПозиция.Должность);
			
			ИдентификаторЗаписи = ПолучитьИдентификаторЗаписиЗаработнойПлаты(ПараметрыЗаписиЗП);
			
			SalaryPeriodRecordData = SalaryPeriodRecordData();
			SalaryPeriodRecordData.salaryPeriod.salaryPeriodId = ИдентификаторПериода;
			SalaryPeriodRecordData.salaryPeriod.salaryPeriodType = ТипВыгрузки;
			SalaryPeriodRecordData.salaryPeriod.periodDate = НеопределеноЕслиНеЗаполнено(Объект.ОтчетныйПериод);
			SalaryPeriodRecordData.departId = НеопределеноЕслиПустаяСтрока(КадроваяПозиция.ИдПодразделения);
			SalaryPeriodRecordData.subdivisionId = НеопределеноЕслиПустаяСтрока(КадроваяПозиция.ИдОтделения);
			SalaryPeriodRecordData.postFedCode.code = НеопределеноЕслиПустаяСтрока(КадроваяПозиция.ДолжностьКод);
			SalaryPeriodRecordData.personalFileNumber = НеопределеноЕслиПустаяСтрока(КадроваяПозиция.ИдЗанятости);
			SalaryPeriodRecordData.personCardId = НеопределеноЕслиПустаяСтрока(КадроваяПозиция.ИдЛичногоДела);
			
			financingSources = Новый Массив;
			Для Каждого ФинансоваяПозиция Из КадроваяПозиция.Суммы Цикл 
				FinancingSourceData = FinancingSourceData();
				Если КодыИсточниковФинансирования = Неопределено Тогда 
					FinancingSourceData.financingSource.code = 2; // Внебюджет.
				Иначе 
					FinancingSourceData.financingSource.code = КодыИсточниковФинансирования.Получить(ФинансоваяПозиция.КФО);
				КонецЕсли;
				Если ФинансоваяПозиция.ЭтоНачисление Тогда 
					FinancingSourceData.financingSourceType = 1;
					FinancingSourceData.accrualPurpose.code = НеопределеноЕслиПустаяСтрока(ФинансоваяПозиция.НазначениеКод);
					FinancingSourceData.accrual = ФинансоваяПозиция.Сумма;
				Иначе 
					FinancingSourceData.financingSourceType = 2;
					FinancingSourceData.retentionPurpose.code = НеопределеноЕслиПустаяСтрока(ФинансоваяПозиция.НазначениеКод);
					FinancingSourceData.retention = ФинансоваяПозиция.Сумма;
				КонецЕсли;
				financingSources.Добавить(FinancingSourceData);
			КонецЦикла;
			SalaryPeriodRecordData.financingSources = financingSources;
			
			ПараметрыВызова = PostPutSalaryPeriodRecord(Объект.УИНОрганизации, ИдентификаторЗаписи, SalaryPeriodRecordData);
			ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
			ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
			Если ОтветСервиса.КодСостояния<400 Тогда
				Если ПараметрыВызова.Метод = "POST" И ОтветСервиса.Контент<>Неопределено Тогда 
					ИдентификаторЗаписи = ОтветСервиса.Контент.entityId;
					МоментВыгрузки = МоментВыгрузкиНаСервере();
					МоментВыгрузкиТекст = СтрШаблон(НСтр("ru = 'Создание записи заработной платы выполнено %1'"), МоментВыгрузки);
					ЗаписатьРезультатВыгрузкиЗаписиЗаработнойПлаты(ПараметрыЗаписиЗП, ИдентификаторЗаписи, МоментВыгрузки);
					ЗаписатьРезультатВыгрузки(Объект.ОтчетныйПериод, ИдентификаторПериода, МоментВыгрузки, ПараметрыВызова.РазделМедрегистра, ТипВыгрузки);
				ИначеЕсли ПараметрыВызова.Метод = "PUT" И ОтветСервиса.СообщениеОбОшибкеПользователю=Неопределено Тогда
					МоментВыгрузки = МоментВыгрузкиНаСервере();
					МоментВыгрузкиТекст = СтрШаблон(НСтр("ru = 'Обновление записи заработной платы выполнено %1'"), МоментВыгрузки);
					ЗаписатьРезультатВыгрузкиЗаписиЗаработнойПлаты(ПараметрыЗаписиЗП, ИдентификаторЗаписи, МоментВыгрузки);
					ЗаписатьРезультатВыгрузки(Объект.ОтчетныйПериод, ИдентификаторПериода, МоментВыгрузки, ПараметрыВызова.РазделМедрегистра, ТипВыгрузки);
				Иначе 
					Объект.ВыгрузкаПроведена = Ложь;
				КонецЕсли;
			Иначе 
				Объект.ВыгрузкаПроведена = Ложь;
			КонецЕсли;
			Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
				Если ПараметрыВызова.Метод = "POST" Тогда 
					СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Создание записи заработной платы: %1%2'"), ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
				ИначеЕсли ПараметрыВызова.Метод = "PUT" Тогда
					СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Обновление записи заработной платы: %1%2'"), ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
				Иначе 
					СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Операция %1 с записью заработной платы: %2%3'"), ПараметрыВызова.Метод, ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
				КонецЕсли;
				ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
			КонецЕсли;
			
		КонецЦикла; 
	КонецЕсли;
	
	Записать();     
		
КонецПроцедуры

