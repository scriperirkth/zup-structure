	МедицинскиеРегистры1СЕГИСЗ.ОтправитьСопоставления(Организация);
КонецПроцедуры

&НаКлиенте
Процедура ЭлементКлассификатораПриИзмененииЗадатьВопрос(ОбластьРеквизита, ИмяРеквизита, ИмяРеквизитаФРМР)
	
	Если ОбластьРеквизита=Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ЗначениеРеквизита = ОбластьРеквизита[ИмяРеквизита];
	ЗначениеРеквизитаФРМР = ОбластьРеквизита[ИмяРеквизитаФРМР];
	Если ЗначениеЗаполнено(ЗначениеРеквизита) И ЗначениеЗаполнено(ЗначениеРеквизитаФРМР) Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОбъектСсылка", ЗначениеРеквизита);
		ДополнительныеПараметры.Вставить("ХарактеристикаСсылка", ЗначениеРеквизитаФРМР);
 		ДополнительныеПараметры.Вставить("ИмяРеквизита", ИмяРеквизита);
 		ДополнительныеПараметры.Вставить("ИмяРеквизитаФРМР", ИмяРеквизитаФРМР);

		ТекстВопроса = НСтр("ru = 'Сохранить сопоставление для ""%1"" глобально?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, ЗначениеРеквизита);

		Оповещение = Новый ОписаниеОповещения("ЭлементКлассификатораПриИзмененииПослеОтветаНаВопрос", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭлементКлассификатораПриИзмененииПослеОтветаНаВопрос(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОбновитьХарактеристикуОбъекта(ДополнительныеПараметры.ОбъектСсылка, 
		                              ДополнительныеПараметры.ХарактеристикаСсылка, 
									  ДополнительныеПараметры.ИмяРеквизита, 
									  ДополнительныеПараметры.ИмяРеквизитаФРМР);
									  
		ОбновитьСвязанныеХарактеристики(ДополнительныеПараметры.ОбъектСсылка, 
		                                ДополнительныеПараметры.ХарактеристикаСсылка, 
										ДополнительныеПараметры.ИмяРеквизита, 
										ДополнительныеПараметры.ИмяРеквизитаФРМР);
										
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьХарактеристикуОбъекта(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)

	МедицинскиеРегистры.СохранитьХарактеристикуОбъектаМедицинскогоРегистра(ОбъектСсылка, ХарактеристикаСсылка.Владелец, ХарактеристикаСсылка);
	ОбновитьВсеВхожденияХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеВхожденияХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)
	
	СтруктураОтбора = Новый Структура(ИмяРеквизита, ОбъектСсылка);
	ВсеСтрокиДляОбновления = Новый Массив; 
	
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Должности") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ШтатныеЕдиницы.НайтиСтроки(СтруктураОтбора));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ДанныеНачислений.НайтиСтроки(СтруктураОтбора));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ДанныеУдержаний.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("ПланВидовРасчетаСсылка.Начисления") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ДанныеНачислений.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("ПланВидовРасчетаСсылка.Удержания") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ДанныеУдержаний.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Для Каждого СтрокаДляОбновления Из ВсеСтрокиДляОбновления Цикл
		// Какого-то из реквизитов ФРМР может не быть в целевой табличной части (например, медицинской должности),
		// поэтому используется присвоение значения через ЗаполнитьЗначенияСвойств.
		ЗаполнитьЗначенияСвойств(СтрокаДляОбновления, Новый Структура(ИмяРеквизитаФРМР, ХарактеристикаСсылка));
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСвязанныеХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)
	id_181 = ХарактеристикаСсылка.ОписаниеЭлемента.Найти("id_181", "Поле");
	Если ЗначениеЗаполнено(id_181) Тогда
		Владелец = Справочники.КлассификаторыФедеральныхМедрегистров.НайтиПоКоду("1.2.643.5.1.13.13.99.2.181", Истина);
		ЭлементКлассификатора = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.НайтиПоКоду(id_181.Значение, Ложь, , Владелец);
		Если ЗначениеЗаполнено(Владелец) И ЗначениеЗаполнено(ЭлементКлассификатора) Тогда
			ОбновитьХарактеристикуОбъекта(ОбъектСсылка, ЭлементКлассификатора, "Должность", "МедицинскаяДолжностьФРМР");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьВидСведенийНаСервере()
	
	Если ЗначениеЗаполнено(Объект.ДатаНачалаДействия) Тогда 
		ЗаполнитьИсточникиИзмененийШтатногоРасписания();
		МедицинскиеРегистрыФормы.УстановитьПараметрыВыбора(ЭтаФорма, "ШтатныеЕдиницыФедеральнаяДолжностьФРМР","1.2.643.5.1.13.13.99.2.885");
		МедицинскиеРегистрыФормы.УстановитьПараметрыВыбора(ЭтаФорма, "ШтатныеЕдиницыМедицинскаяДолжностьФРМР","1.2.643.5.1.13.13.99.2.181"); 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ШтатноеРасписаниеГруппа", "Видимость", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаработнаяПлатаГруппа", "Видимость", Ложь);
	ИначеЕсли ЗначениеЗаполнено(Объект.ОтчетныйПериод) Тогда 
		МедицинскиеРегистрыФормы.УстановитьПараметрыВыбора(ЭтаФорма, "ДанныеНачисленийФедеральнаяДолжностьФРМР","1.2.643.5.1.13.13.99.2.885");
		МедицинскиеРегистрыФормы.УстановитьПараметрыВыбора(ЭтаФорма, "ДанныеУдержанийФедеральнаяДолжностьФРМР","1.2.643.5.1.13.13.99.2.885");
		МедицинскиеРегистрыФормы.УстановитьПараметрыВыбора(ЭтаФорма, "ДанныеНачисленийНазначениеНачисления","1.2.643.5.1.13.13.99.2.1106");
		МедицинскиеРегистрыФормы.УстановитьПараметрыВыбора(ЭтаФорма, "ДанныеУдержанийНазначениеУдержания","1.2.643.5.1.13.13.99.2.1107");
		ЗарплатаКадрыКлиентСервер.ЗаполнитьМесяцПоДате(ЭтотОбъект, "Объект.ОтчетныйПериод", "ОтчетныйПериодСтрокой");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ШтатноеРасписаниеГруппа", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаработнаяПлатаГруппа", "Видимость", ДоступнаВыгрузкаЗаработнойПлаты);
	Иначе
		ЗаполнитьИсточникиИзмененийШтатногоРасписания();
