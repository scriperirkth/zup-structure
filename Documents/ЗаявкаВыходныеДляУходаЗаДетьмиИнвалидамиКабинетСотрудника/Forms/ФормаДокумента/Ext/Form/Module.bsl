#КонецОбласти

&НаСервере
Процедура ИнициализацияФормы()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаДокументыПоЗаявкеГлавная", "Видимость", Объект.ВариантИсправления <> Перечисления.ВариантыИсправленияЗаявокКабинетСотрудника.Отмена);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаДанныеЗаявления", "ОтображатьЗаголовок", Объект.ВариантИсправления = Перечисления.ВариантыИсправленияЗаявокКабинетСотрудника.Перенос);
	
	Если Объект.ВариантИсправления <> Перечисления.ВариантыИсправленияЗаявокКабинетСотрудника.Отмена Тогда
		
		ЗаголовокКоманды = ПредставлениеПериодовВыходных();
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыходныеДни", "Заголовок", ЗаголовокКоманды);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ИспользоватьВсеНакопленныеДни", "Видимость", Объект.ИспользоватьВсеНакопленныеДни);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"НетСправкиВторогоРодителя", "Видимость", Объект.НетСправкиВторогоРодителя);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ПричинаОтсутствияСправкиВторогоРодителя", "Видимость", Объект.НетСправкиВторогоРодителя);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеПериодовВыходных() Экспорт
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("НачалоМесяца",  			Новый ОписаниеТипов("Дата"));
	ТаблицаРезультат.Колонки.Добавить("ПредставлениеПериодов", 	ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТаблицаРезультат.Колонки.Добавить("КоличествоДней",  		ОбщегоНазначения.ОписаниеТипаЧисло(10));
	ТаблицаРезультат.Колонки.Добавить("КоличествоПериодов", 	ОбщегоНазначения.ОписаниеТипаЧисло(10));
	
	ТаблицаДат = Объект.ВыходныеДни.Выгрузить();
	ТаблицаДат.Колонки.Добавить("НачалоМесяца", Новый ОписаниеТипов("Дата"));
	ТаблицаДат.Колонки.Добавить("КоличествоДней", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	Для Каждого СтрокаТаблицыДат Из ТаблицаДат Цикл
		СтрокаТаблицыДат.НачалоМесяца = НачалоМесяца(СтрокаТаблицыДат.Дата);
		СтрокаТаблицыДат.КоличествоДней = 1;
	КонецЦикла;
	ТаблицаПериодов = ОбщегоНазначенияБЗК.ТаблицаПериодовИзТаблицыДат(ТаблицаДат, "НачалоМесяца", "КоличествоДней");
	
	Массив = КоллекцииБЗК.УникальныеЗначенияКолонки(ТаблицаПериодов, "НачалоМесяца");
	Для Каждого НачалоМесяца Из Массив Цикл
		СтрокаРезультат = ТаблицаРезультат.Добавить();
		СтрокаРезультат.НачалоМесяца = НачалоМесяца;
		ТаблицаПериодовПоМесяцу = ТаблицаПериодов.Скопировать(Новый Структура("НачалоМесяца", НачалоМесяца));
		ТаблицаПериодовПоМесяцу.Сортировать("ДатаНачала");
		Количество = ТаблицаПериодовПоМесяцу.Количество();
		Номер = 0;
		Представления = Новый Массив;
		Для Каждого Период Из ТаблицаПериодовПоМесяцу Цикл
			Номер = Номер + 1;
			ФорматДатыОкончания = ?(Номер = Количество, "ДФ=""д ММММ""", "ДФ=""д""");
			Если Период.ДатаНачала = Период.ДатаОкончания Тогда
				Представление = Формат(Период.ДатаОкончания, ФорматДатыОкончания);
			Иначе
				Представление = Формат(Период.ДатаНачала, "ДФ=""д""") + "-" + Формат(Период.ДатаОкончания, ФорматДатыОкончания);
			КонецЕсли;
			Представления.Добавить(Представление);
			СтрокаРезультат.КоличествоДней     = СтрокаРезультат.КоличествоДней     + Период.КоличествоДней;
			СтрокаРезультат.КоличествоПериодов = СтрокаРезультат.КоличествоПериодов + 1;
		КонецЦикла;
		СтрокаРезультат.ПредставлениеПериодов = СтрСоединить(Представления, ", ");
	КонецЦикла;
	
	ПредставлениеПериодовВыходных = СтрСоединить(ТаблицаРезультат.ВыгрузитьКолонку("ПредставлениеПериодов"), ";  ");
	
	Возврат ПредставлениеПериодовВыходных;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначенияДляВыбораВидаДокумента()
	
	ЗначенияДляВыбора = Новый СписокЗначений;
	МетаданныеОбъекта = Метаданные.Документы.ОплатаДнейУходаЗаДетьмиИнвалидами;
	ЗначенияДляВыбора.Добавить(МетаданныеОбъекта.ПолноеИмя(), МетаданныеОбъекта.Синоним);
	
	Возврат ЗначенияДляВыбора;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеДокумента()

	Описание = ЗаявкиСотрудниковКлиентСервер.НовоеОписаниеДокументаЗаявки();
	Описание.ПроверятьСвязанныеЗаявки 		= Истина;
	Описание.ДоступнаОтменаЗаявки 			= Истина;
	Описание.ДокументыПоЗаявкеИмя 			= "ДокументыПоЗаявке";
	Описание.ДокументыПоЗаявкеДокументИмя 	= "ДокументСсылка";
	Описание.ВыводитьДокументыЗаявки 		= Истина;
	
	Возврат Описание;

КонецФункции

&НаСервере
Функция ПараметрыЗаполненияДокумента()
	
	ПараметрыЗаполнения = Новый Структура("Основание,ОсновнойОтпуск", ,Истина);
	
	МассивДат = Новый Массив;
	ДатаНачала = Объект.ВыходныеДни[0].Дата;
	Для Каждого СтрокаТЧ Из Объект.ВыходныеДни Цикл 
		МассивДат.Добавить(СтрокаТЧ.Дата);
		Если СтрокаТЧ.Дата < ДатаНачала Тогда
			ДатаНачала = СтрокаТЧ.Дата;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Ссылка", Неопределено);
	ДанныеЗаполнения.Вставить("Действие", "ЗаполнитьПоДаннымЗаявкиКабинетСотрудника");
	ДанныеЗаполнения.Вставить("Сотрудник", 	Объект.Сотрудник);
	ДанныеЗаполнения.Вставить("Организация",Объект.Организация);
	ДанныеЗаполнения.Вставить("ДатаНачала", ДатаНачала);
	ДанныеЗаполнения.Вставить("ДниУхода", 	МассивДат);
	ДанныеЗаполнения.Вставить("ИспользоватьОстатокДнейЗаГод", Объект.ИспользоватьВсеНакопленныеДни);
	
	ПараметрыЗаполнения = Новый Структура("Основание", ДанныеЗаполнения);
		
	Возврат ПараметрыЗаполнения;
	
КонецФункции

&НаКлиенте
Процедура ВыходныеДни(Команда)
	
	МассивДат = Новый Массив;
	Для Каждого ТекСтрока Из Объект.ВыходныеДни Цикл 
		МассивДат.Добавить(ТекСтрока.Дата);
	КонецЦикла;
		
	ТекстПодсказки = НСтр("ru = 'Даты оплачиваемых дней по уходу за детьми-инвалидами сотруднику'");
	ТекстПодсказки = СтрШаблон("%1 %2", ТекстПодсказки, Объект.Сотрудник);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МассивДат", МассивДат);
	ПараметрыФормы.Вставить("Подсказка", ТекстПодсказки);
	
	ОткрытьФорму("Документ.ЗаявкаВыходныеДляУходаЗаДетьмиИнвалидамиКабинетСотрудника.Форма.ВыбранныеДаты", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти