&НаКлиенте
Процедура ЭлементКлассификатораПриИзмененииЗадатьВопрос(ОбластьРеквизита, ИмяРеквизита, ИмяРеквизитаФРМР)
	
	// Внимание!!!
	// Обработка события изменения Медуслуги ФРМР не имеет смысла.
	// Медуслуга может быть сопоставлена и с должностью и с позицией ШР. 
	// Выяснить какое именно сопоставление сработало не представляется возможным.
	// Поэтому глобально изменять сопоставление нельзя.

	Если ОбластьРеквизита=Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ЗначениеРеквизита = ОбластьРеквизита[ИмяРеквизита];
	ЗначениеРеквизитаФРМР = ОбластьРеквизита[ИмяРеквизитаФРМР];
	Если ЗначениеЗаполнено(ЗначениеРеквизита) И ЗначениеЗаполнено(ЗначениеРеквизитаФРМР) Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОбъектСсылка", ЗначениеРеквизита);
		ДополнительныеПараметры.Вставить("ХарактеристикаСсылка", ЗначениеРеквизитаФРМР);
 		ДополнительныеПараметры.Вставить("ИмяРеквизита", ИмяРеквизита);
 		ДополнительныеПараметры.Вставить("ИмяРеквизитаФРМР", ИмяРеквизитаФРМР);

		ТекстВопроса = НСтр("ru = 'Сохранить сопоставление для ""%1"" глобально?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, ЗначениеРеквизита);

		Оповещение = Новый ОписаниеОповещения("ЭлементКлассификатораПриИзмененииПослеОтветаНаВопрос", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭлементКлассификатораПриИзмененииПослеОтветаНаВопрос(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОбновитьХарактеристикуОбъекта(ДополнительныеПараметры.ОбъектСсылка, 
		                              ДополнительныеПараметры.ХарактеристикаСсылка, 
									  ДополнительныеПараметры.ИмяРеквизита, 
									  ДополнительныеПараметры.ИмяРеквизитаФРМР);
									  
		ОбновитьСвязанныеХарактеристики(ДополнительныеПараметры.ОбъектСсылка, 
		                                ДополнительныеПараметры.ХарактеристикаСсылка, 
										ДополнительныеПараметры.ИмяРеквизита, 
										ДополнительныеПараметры.ИмяРеквизитаФРМР);
										
		Оповестить("ОбновленаХарактеристикаОбъектаДляФедеральныхМедрегистровИзСведенийДляФРМР", ДополнительныеПараметры, ВладелецФормы);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьХарактеристикуОбъекта(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)
	
	Классификатор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ХарактеристикаСсылка, "Владелец");
	МедицинскиеРегистры.СохранитьХарактеристикуОбъектаМедицинскогоРегистра(ОбъектСсылка, Классификатор, ХарактеристикаСсылка);
	ОбновитьВсеВхожденияХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеВхожденияХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)
	
	СтруктураОтбора = Новый Структура(ИмяРеквизита, ОбъектСсылка);
	ВсеСтрокиДляОбновления = Новый Массив; 
	
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ВидыДокументовФизическихЛиц") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ДокументыУдостоверяющиеЛичность.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ВидыОбразованияФизическихЛиц") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("ПеречислениеСсылка.ВидыПрофессиональнойПодготовки") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ДополнительноеПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ОбразованиеФизическихЛиц") Тогда 
		Если ИмяРеквизитаФРМР = "КвалификацияФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
		ИначеЕсли ИмяРеквизитаФРМР = "ЗаказчикЦелевогоОбученияФРМР" Или ИмяРеквизитаФРМР = "ПричинаРасторженияФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.УчебныеЗаведения") Тогда 
		Если ИмяРеквизитаФРМР = "СтранаМираФРМР" Или ИмяРеквизитаФРМР = "РеспубликаСССРФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
		ИначеЕсли ИмяРеквизитаФРМР = "УчебноеЗаведениеФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ДополнительноеПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Сертификаты.НайтиСтроки(СтруктураОтбора));
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.КлассификаторСпециальностейПоОбразованию") Тогда 
		Если ИмяРеквизитаФРМР = "СпециальностьОрдинатурыФРМР" Или ИмяРеквизитаФРМР = "СпециальностьДокторантурыФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
		ИначеЕсли ИмяРеквизитаФРМР = "СпециальностьФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ДополнительноеПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Сертификаты.НайтиСтроки(СтруктураОтбора));
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Должности") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ЛичноеДело.НайтиСтроки(СтруктураОтбора));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Квалификация.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("ПеречислениеСсылка.ВидыЗанятости") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ЛичноеДело.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("ПеречислениеСсылка.ВидыКадровыхСобытий") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ЛичноеДело.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ОснованияУвольнения") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, ЛичноеДело.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Для Каждого СтрокаДляОбновления Из ВсеСтрокиДляОбновления Цикл
		// Какого-то из реквизитов ФРМР может не быть в целевой табличной части (например, медицинской должности),
		// поэтому используется присвоение значения через ЗаполнитьЗначенияСвойств.
		ЗаполнитьЗначенияСвойств(СтрокаДляОбновления, Новый Структура(ИмяРеквизитаФРМР, ХарактеристикаСсылка));
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСвязанныеХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)
	id_181 = ХарактеристикаСсылка.ОписаниеЭлемента.Найти("id_181", "Поле");
	Если ЗначениеЗаполнено(id_181) Тогда
		Владелец = Справочники.КлассификаторыФедеральныхМедрегистров.НайтиПоКоду("1.2.643.5.1.13.13.99.2.181", Истина);
		ЭлементКлассификатора = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.НайтиПоКоду(id_181.Значение, Ложь, , Владелец);
		Если ЗначениеЗаполнено(Владелец) И ЗначениеЗаполнено(ЭлементКлассификатора) Тогда
			ОбновитьХарактеристикуОбъекта(ОбъектСсылка, ЭлементКлассификатора, "Должность", "МедицинскаяДолжностьФРМР");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#Область Заполнение

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	
	ПараметрыЗаполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
	ДанныеДляЗаполнения = ПараметрыЗаполнения.ДанныеДляЗаполнения;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДляЗаполнения.Работники[0]);
	ДокументыУдостоверяющиеЛичность.Загрузить(ДанныеДляЗаполнения.ДокументыУдостоверяющиеЛичность);
	ЛичноеДело.Загрузить(ДанныеДляЗаполнения.ЛичноеДело);
	ОбщееОбразование.Загрузить(ДанныеДляЗаполнения.ОбщееОбразование);
	ПрофессиональноеОбразование.Загрузить(ДанныеДляЗаполнения.ПрофессиональноеОбразование);
	ПослевузовскоеОбразование.Загрузить(ДанныеДляЗаполнения.ПослевузовскоеОбразование);
	ДополнительноеПрофессиональноеОбразование.Загрузить(ДанныеДляЗаполнения.ДополнительноеПрофессиональноеОбразование);
	Сертификаты.Загрузить(ДанныеДляЗаполнения.Сертификаты);
	Награды.Загрузить(ДанныеДляЗаполнения.Награды);
	Квалификация.Загрузить(ДанныеДляЗаполнения.Квалификация);
	УстановитьФлагиМедицинскихДолжностей();
	 
КонецПроцедуры

&НаСервере
Процедура УстановитьФлагиМедицинскихДолжностей() 
	МедицинскиеДолжности = МедицинскиеРегистрыФормы.МедицинскиеДолжности();
	Для Каждого ТекущаяПозиция Из ЛичноеДело Цикл 
		ТекущаяПозиция.ДолжностьЯвляетсяМедицинской = МедицинскиеДолжности.Найти(ТекущаяПозиция.Должность)<>Неопределено;
	КонецЦикла;
КонецПроцедуры

