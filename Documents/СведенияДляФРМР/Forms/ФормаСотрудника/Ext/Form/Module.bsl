#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "Ссылка,Организация,Дата,НомерСтрокиРаботника,АдресХранилища");
	
	ЗаполнитьДанныеФормы();
	
	ОписанияОбязательныхПолей = Документы.СведенияДляФРМР.ОписанияОбязательныхПолей();
	ОписанияОбязательныхПолейТаблиц = Документы.СведенияДляФРМР.ОписанияОбязательныхПолейТаблиц();
	
	УстановитьВидСведенийНаСервере();
	УстановитьСвойствоПолейАвтоОтметкаНезаполненного();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьНаКлиенте(Команда)
	Если Модифицированность Тогда
		Закрыть(ДанныеМедицинскогоРаботника());
	Иначе 
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ДанныеМедицинскогоРаботника()
	
	ДанныеМедРаботника = Новый Структура;

	ДанныеМедРаботника.Вставить("ФизическоеЛицо", ФизическоеЛицо);
	ДанныеМедРаботника.Вставить("ОтношениеКВоинскойОбязанностиФРМР", ОтношениеКВоинскойОбязанностиФРМР);
	ДанныеМедРаботника.Вставить("СтранаФРМР", СтранаФРМР);
	
	ДанныеМедРаботника.Вставить("ДокументыУдостоверяющиеЛичность", ДокументыУдостоверяющиеЛичность.Выгрузить());
	ДанныеМедРаботника.Вставить("ЛичноеДело", ЛичноеДело.Выгрузить());
	ДанныеМедРаботника.Вставить("ОбщееОбразование", ОбщееОбразование.Выгрузить());
	ДанныеМедРаботника.Вставить("ПрофессиональноеОбразование", ПрофессиональноеОбразование.Выгрузить());
	ДанныеМедРаботника.Вставить("ПослевузовскоеОбразование", ПослевузовскоеОбразование.Выгрузить());
	ДанныеМедРаботника.Вставить("ДополнительноеПрофессиональноеОбразование", ДополнительноеПрофессиональноеОбразование.Выгрузить());
	ДанныеМедРаботника.Вставить("Сертификаты", Сертификаты.Выгрузить());
	ДанныеМедРаботника.Вставить("Награды", Награды.Выгрузить());
	ДанныеМедРаботника.Вставить("Квалификация", Квалификация.Выгрузить());
	
	Возврат ПоместитьВоВременноеХранилище(ДанныеМедРаботника);

КонецФункции

#КонецОбласти

