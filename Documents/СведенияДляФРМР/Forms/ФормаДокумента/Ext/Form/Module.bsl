#Область ЗаполнениеДокумента

&НаКлиенте
Процедура ЗаполнитьНаКлиенте(Знач СписокРаботников = Неопределено)

	Результат = РезультатЗаполненияВДлительнойОперации(СписокРаботников);
	Если Результат.ЗаданиеВыполнено Тогда
		ОповеститьОбИзменении(Объект.Ссылка);
	Иначе
		ИдентификаторЗадания = Результат.ИдентификаторЗадания;
		АдресХранилища		 = Результат.АдресХранилища;
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция РезультатЗаполненияВДлительнойОперации(Знач СписокРаботников = Неопределено)
	
	ПараметрыЗаполнения = Новый Структура("ДанныеДляЗаполнения,Ссылка,Организация,ДатаАктуальности,СписокРаботников");
	ПараметрыЗаполнения.ДанныеДляЗаполнения = Новый Структура("Работники,ДокументыУдостоверяющиеЛичность,ЛичноеДело,ОбщееОбразование,ПрофессиональноеОбразование,ПослевузовскоеОбразование,ДополнительноеПрофессиональноеОбразование,Сертификаты,Награды,Квалификация");
	ПараметрыЗаполнения.Ссылка = Объект.Ссылка;
	ПараметрыЗаполнения.Организация = Объект.Организация;
	ПараметрыЗаполнения.ДатаАктуальности = Объект.Дата;
	ПараметрыЗаполнения.СписокРаботников = СписокРаботников;
	
	НаименованиеЗадания = НСтр("ru = 'Заполнение документа ""Сведения о медицинских работниках для ФРМР""'");
	
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор,
		"Документы.СведенияДляФРМР.ПодготовитьДанныеДляЗаполнения",
		ПараметрыЗаполнения,
		НаименованиеЗадания);
	
	АдресХранилища = Результат.АдресХранилища;
	
	Если Результат.ЗаданиеВыполнено Тогда
		ЗаполнениеПослеВыполненияДлительнойОперации();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			
			Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
				ЗаполнениеПослеВыполненияДлительнойОперации();
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания(
					"Подключаемый_ПроверитьВыполнениеЗадания",
					ПараметрыОбработчикаОжидания.ТекущийИнтервал,
					Истина);
			КонецЕсли;
				
		КонецЕсли;
		
	Исключение
		
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		
		СообщенияПользователю = СообщенияФоновогоЗадания(ИдентификаторЗадания);
		Если СообщенияПользователю <> Неопределено Тогда
			Для Каждого СообщениеФоновогоЗадания Из СообщенияПользователю Цикл
				СообщениеФоновогоЗадания.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	ОповеститьОбИзменении(Объект.Ссылка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаСервереБезКонтекста
Функция СообщенияФоновогоЗадания(ИдентификаторЗадания)
	
	СообщенияПользователю = Новый Массив;
	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если ФоновоеЗадание <> Неопределено Тогда
		СообщенияПользователю = ФоновоеЗадание.ПолучитьСообщенияПользователю();
	КонецЕсли;
	
	Возврат СообщенияПользователю;
	
КонецФункции

&НаСервере
Процедура ЗаполнениеПослеВыполненияДлительнойОперации()
	
	Документы.СведенияДляФРМР.ЗаполнитьИзХранилища(ЭтотОбъект.Объект, АдресХранилища);
	ЗаполнитьТекущиеПозицииРаботников();
	ЗарплатаКадрыКлиентСервер.КлючевыеРеквизитыЗаполненияФормыУстановитьОтображениеПредупреждения(ЭтаФорма);
	Модифицированность = Истина;
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СертификатПриИзмененииНаСервере(Организация, Сертификат = Неопределено)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОрганизации = МедицинскиеРегистры.СоздатьПустыеНастройкиОрганизации();
	НастройкиОрганизации.Сертификат = Сертификат;
	
	МедицинскиеРегистры.СохранитьНастройкиОрганизации(Организация, НастройкиОрганизации);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиОрганизацииНаСервере()
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		НастройкиОрганизации = ПрочитатьНастройкиОрганизации(Объект.Организация);
		Объект.УИНОрганизации = НастройкиОрганизации.ИдентификаторДляМедрегистров;
		Если ИспользоватьТокен Тогда
			Сертификат = НастройкиОрганизации.Сертификат;
			ИдентификаторИнформационнойСистемы = НастройкиОрганизации.ИдентификаторИнформационнойСистемы;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьНастройкиОрганизацииНаКлиенте()
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		НастройкиОрганизации = ПрочитатьНастройкиОрганизации(Объект.Организация);
		Объект.УИНОрганизации = НастройкиОрганизации.ИдентификаторДляМедрегистров;
		Если ИспользоватьТокен Тогда
			Сертификат = НастройкиОрганизации.Сертификат;
			ИдентификаторИнформационнойСистемы = НастройкиОрганизации.ИдентификаторИнформационнойСистемы;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПрочитатьНастройкиОрганизации(Организация)
	Возврат МедицинскиеРегистры.ПолучитьНастройкиОрганизации(Организация)
КонецФункции 

#КонецОбласти

#Область Редактирования

&НаКлиенте
Процедура УдалитьСтрокиРаботника(ИмяТабличнойЧасти, ИмяПоля, Работник)

	УдаляемыеСтроки = Объект[ИмяТабличнойЧасти].НайтиСтроки(Новый Структура(ИмяПоля, Работник));
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		Объект[ИмяТабличнойЧасти].Удалить(УдаляемаяСтрока);
	КонецЦикла;	

КонецПроцедуры 

&НаСервере
Функция АдресСпискаПодобранныхРаботников()
	
	Возврат ПоместитьВоВременноеХранилище(Объект.Работники.Выгрузить(,"ФизическоеЛицо").ВыгрузитьКолонку("ФизическоеЛицо"), УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьОтредактированныеДанныеРаботника(АдресХранилища, ФизическоеЛицо)

	Если Не ПустаяСтрока(АдресХранилища) Тогда
		Документы.СведенияДляФРМР.ОчиститьДанныеРаботника(Объект, ФизическоеЛицо, Истина);
		Документы.СведенияДляФРМР.ЗагрузитьОтредактированныеДанныеИзХранилища(Объект, АдресХранилища);
		Модифицированность = Истина;
		ОбновитьВидимостьДоступность();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущиеПозицииРаботников()

	СтатусыВыгрузкиРаботников = Документы.СведенияДляФРМР.СтатусыВыгрузкиРаботников(Объект.Ссылка, Объект.УИНОрганизации);
	
	Для Каждого Работник Из Объект.Работники Цикл 
		СтатусВыгрузки = СтатусыВыгрузкиРаботников.Получить(Работник.ФизическоеЛицо);
		Если СтатусВыгрузки=Неопределено Тогда
			Работник.СтадияВыгрузки = 0;
		Иначе  
			Работник.СтадияВыгрузки = ?(СтатусВыгрузки.ВыгрузкаНеобходима, 1, 0);
			Работник.Идентификатор = СтатусВыгрузки.Идентификатор;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ДанныеМедицинскогоРаботника(ФизическоеЛицо)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыМедРаботника = Новый Структура;
	ДанныеДляЗаполнения = Новый Структура;
	СтруктураОтбораФизЛицо = Новый Структура("ФизическоеЛицо", ФизическоеЛицо);	

	ДанныеДляЗаполнения.Вставить("Работники", ДокументОбъект.Работники.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("ДокументыУдостоверяющиеЛичность", ДокументОбъект.ДокументыУдостоверяющиеЛичность.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("ЛичноеДело", ДокументОбъект.ЛичноеДело.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("ОбщееОбразование", ДокументОбъект.ОбщееОбразование.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("ПрофессиональноеОбразование", ДокументОбъект.ПрофессиональноеОбразование.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("ПослевузовскоеОбразование", ДокументОбъект.ПослевузовскоеОбразование.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("ДополнительноеПрофессиональноеОбразование", ДокументОбъект.ДополнительноеПрофессиональноеОбразование.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("Сертификаты", ДокументОбъект.Сертификаты.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("Награды", ДокументОбъект.Награды.Выгрузить(СтруктураОтбораФизЛицо));
	ДанныеДляЗаполнения.Вставить("Квалификация", ДокументОбъект.Квалификация.Выгрузить(СтруктураОтбораФизЛицо));
	
	ПараметрыМедРаботника.Вставить("ДанныеДляЗаполнения", ДанныеДляЗаполнения); 

	Возврат ПоместитьВоВременноеХранилище(ПараметрыМедРаботника);

КонецФункции

#КонецОбласти

#Область Выгрузка

&НаКлиенте
Процедура ВыгрузитьВФРМРНаКлиенте() 
	
	Если Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	ПараметрыСервиса = ПараметрыСервиса();
	
	Для Каждого РаботникДляВыгрузки Из Объект.Работники Цикл
		
		Если Не РаботникДляВыгрузки.ЯвляетсяМедработником Тогда 
			Продолжить;
		КонецЕсли;
		
		ДанныеДляВыгрузки = ДанныеДляВыгрузки(Объект.Ссылка, Объект.УИНОрганизации, РаботникДляВыгрузки.ФизическоеЛицо);
		
		Если ДанныеДляВыгрузки.Работники.Количество() <> 1 Тогда 
			Продолжить;
		КонецЕсли;
		
		Работник = ДанныеДляВыгрузки.Работники[0];
		СНИЛС = МедицинскиеРегистрыКлиент.ТолькоЦифры(Работник.СтраховойНомерПФР);
		
#Область ПодборИдентификаторовФРМР
		
		ОбщиеДанныеВыгружены = Ложь;
		ПерваяЗаписьЛичногоДелаВыгружена = Ложь;

		PersonKey = PersonKey();
	    PersonKey.mo = Объект.УИНОрганизации;
	    PersonKey.mr = Работник.ЯвляетсяМедработником;
		PersonKey.snils = СНИЛС;
		
		РезультатПолучения = ПолучитьПолныеДанныеМедработника(PersonKey, ДанныеДляВыгрузки, ПараметрыСервиса, Работник, РаботникДляВыгрузки);

		Если РезультатПолучения.СообщениеОбОшибкеПользователю="Медицинский работник не найден" Тогда 
			// Сначала попробуем добавить МР путем отправки общих данных. Поскольку PersonKey.oid пока ещё установлен в Неопределено, сработает метод POST.
			ОбщиеДанныеВыгружены = Истина;
            ОтветСервиса = ОтправитьОбщиеДанные(PersonKey, ОбщиеДанныеВыгружены, ДанныеДляВыгрузки, ПараметрыСервиса, Работник);
			Если ОтветСервиса.СообщениеОбОшибкеПользователю="Указанный сотрудник уже существует" Тогда
				// Это значит, что МР в ФРМР уже есть, но нет ни одной записи ЛД в МО, от которой выполняется запрос.
				Если ДанныеДляВыгрузки.ЛичноеДело.Количество()>0 Тогда 
					ПерваяЗаписьЛичногоДелаВыгружена = Истина;
					ОтветСервиса = ОтправитьЗаписьЛичногоДела(PersonKey, ПерваяЗаписьЛичногоДелаВыгружена, ДанныеДляВыгрузки.ЛичноеДело[0], ПараметрыСервиса, Работник, Истина);
					Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
						// Вероятно, какие-то проблемы с первой записью ЛД МР в ИБ. Нет никакого смысла пытаться что-то делать с этим МР, пока это не будет исправлено.
						СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Неудачная попытка добавления первой записи личного дела медработника %1: %2%3'"), 
								Работник.ФизическоеЛицо, ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
						ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю, , 
								СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.Работники[%1].ФизическоеЛицо", РаботникДляВыгрузки.НомерСтроки-1));
						Продолжить;
					КонецЕсли;	
					// Пауза после добавления первой записи ЛД необходима, чтобы отработали все последующие запросы. 
					// Без паузы они завершатся с ошибкой "Медработник не найден", как и при добавлении МР, ещё не существующего в ФРМР.
					Пауза(5);
				Иначе
					// Если в ЛД пусто, то нет никакого смысла пытаться что-то делать с этим МР.
					Продолжить;
				КонецЕсли;	
			ИначеЕсли ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
				// Вероятно, какие-то проблемы с общими данными МР в ИБ. Нет никакого смысла пытаться что-то делать с этим МР, пока его данные не будут исправлены.
				СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Неудачная попытка добавления медработника %1: %2%3'"), 
						Работник.ФизическоеЛицо, ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
				ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю, , 
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.Работники[%1].ФизическоеЛицо", РаботникДляВыгрузки.НомерСтроки-1));
				Продолжить;
			КонецЕсли;	
		ИначеЕсли РезультатПолучения.СообщениеОбОшибкеПользователю<>Неопределено Тогда
			СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Получение подробных данных медработника %1: %2%3'"), 
					Работник.ФизическоеЛицо, РезультатПолучения.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю, , 
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.Работники[%1].ФизическоеЛицо", РаботникДляВыгрузки.НомерСтроки-1));
			Продолжить;
		КонецЕсли; 
		
#КонецОбласти
#Область ПроведениеВыгрузкиВФРМР

		ВыгрузкаПроизводилась = Ложь;
		ВыгрузкаВыполнена = Истина;
		
		// Основные данные работника.
		Если ОбщиеДанныеВыгружены Тогда
			ВыгрузкаПроизводилась = Истина;
		Иначе 
			Если ВыгрузкаНеобходима(Работник.МоментВыгрузки, Работник.МоментИзменения) Тогда
				ВыгрузкаПроизводилась = Истина;
	            ОтветСервиса = ОтправитьОбщиеДанные(PersonKey, ВыгрузкаВыполнена, ДанныеДляВыгрузки, ПараметрыСервиса, Работник);
				Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
					СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Выгрузка базовых данных медработника %1: %2%3'"), Работник.ФизическоеЛицо, 
							ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
					ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю, , 
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.Работники[%1].ФизическоеЛицо", РаботникДляВыгрузки.НомерСтроки-1));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Общее образование.
		Для Каждого ТекущееОбразование Из ДанныеДляВыгрузки.ОбщееОбразование Цикл
			Если ВыгрузкаНеобходима(ТекущееОбразование.МоментВыгрузки, ТекущееОбразование.МоментИзменения) Тогда
				ВыгрузкаПроизводилась = Истина;
				PersonCommonData = ПодготовитьДанныеОбщегоОбразования(ТекущееОбразование);
				ПараметрыВызова = PostPutPersonCommon(PersonKey, PersonCommonData);
				ШаблонСообщенияОбОшибке = НСтр("ru = 'Выгрузка основного (общего) образования медработника %1: %2%3'");
				ОбразованиеВыгружено = ОтправитьЗапросИОбработатьРезультатДляОбразования(ПараметрыВызова, ПараметрыСервиса, 
						Работник, ТекущееОбразование, ШаблонСообщенияОбОшибке, РаботникДляВыгрузки.НомерСтроки);
				ВыгрузкаВыполнена = ВыгрузкаВыполнена И ОбразованиеВыгружено;
			КонецЕсли;
		КонецЦикла;
		
		// Профессиональное образование.
		Для Каждого ТекущееОбразование Из ДанныеДляВыгрузки.ПрофессиональноеОбразование Цикл
			Если ВыгрузкаНеобходима(ТекущееОбразование.МоментВыгрузки, ТекущееОбразование.МоментИзменения) Тогда
				ВыгрузкаПроизводилась = Истина;
				PersonProfData = ПодготовитьДанныеПрофессиональногоОбразования(Работник, ТекущееОбразование);
				ПараметрыВызова = PostPutPersonProf(PersonKey, PersonProfData);
				ШаблонСообщенияОбОшибке = НСтр("ru = 'Выгрузка профессионального образования медработника %1: %2%3'");
				ОбразованиеВыгружено = ОтправитьЗапросИОбработатьРезультатДляОбразования(ПараметрыВызова, ПараметрыСервиса, 
						Работник, ТекущееОбразование, ШаблонСообщенияОбОшибке, РаботникДляВыгрузки.НомерСтроки);
				ВыгрузкаВыполнена = ВыгрузкаВыполнена И ОбразованиеВыгружено;
			КонецЕсли;
		КонецЦикла;
		
		// Послевузовское образование.
		Для Каждого ТекущееОбразование Из ДанныеДляВыгрузки.ПослевузовскоеОбразование Цикл
			Если ВыгрузкаНеобходима(ТекущееОбразование.МоментВыгрузки, ТекущееОбразование.МоментИзменения) Тогда
				ВыгрузкаПроизводилась = Истина;
				PersonPostgraduateData = ПодготовитьДанныеПослевузовскогоОбразования(ТекущееОбразование);
				ПараметрыВызова = PostPutPersonPostgraduate(PersonKey, PersonPostgraduateData);
				ШаблонСообщенияОбОшибке = НСтр("ru = 'Выгрузка послевузовского образования медработника %1: %2%3'");
				ОбразованиеВыгружено = ОтправитьЗапросИОбработатьРезультатДляОбразования(ПараметрыВызова, ПараметрыСервиса, 
						Работник, ТекущееОбразование, ШаблонСообщенияОбОшибке, РаботникДляВыгрузки.НомерСтроки);
				ВыгрузкаВыполнена = ВыгрузкаВыполнена И ОбразованиеВыгружено;
			КонецЕсли;
		КонецЦикла;
		
		// Дополнительное профессиональное образование.
		Для Каждого ТекущееОбразование Из ДанныеДляВыгрузки.ДополнительноеПрофессиональноеОбразование Цикл
			Если ВыгрузкаНеобходима(ТекущееОбразование.МоментВыгрузки, ТекущееОбразование.МоментИзменения) Тогда
				ВыгрузкаПроизводилась = Истина;
				PersonExtData = ПодготовитьДанныеДополнительногоПрофессиональногоОбразования(ТекущееОбразование);
				ПараметрыВызова = PostPutPersonExt(PersonKey, PersonExtData);
				ШаблонСообщенияОбОшибке = НСтр("ru = 'Выгрузка дополнительного профессионального образования медработника %1: %2%3'");
				ОбразованиеВыгружено = ОтправитьЗапросИОбработатьРезультатДляОбразования(ПараметрыВызова, ПараметрыСервиса, 
						Работник, ТекущееОбразование, ШаблонСообщенияОбОшибке, РаботникДляВыгрузки.НомерСтроки);
				ВыгрузкаВыполнена = ВыгрузкаВыполнена И ОбразованиеВыгружено;
			КонецЕсли;
		КонецЦикла;
		
		// Сертификаты.
		Для Каждого СертификатРаботника Из ДанныеДляВыгрузки.Сертификаты Цикл
			Если ВыгрузкаНеобходима(СертификатРаботника.МоментВыгрузки, СертификатРаботника.МоментИзменения) Тогда
				ВыгрузкаПроизводилась = Истина;
				PersonCertData = ПодготовитьДанныеСертификата(СертификатРаботника);
				ПараметрыВызова = PostPutPersonCert(PersonKey, PersonCertData);
				ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
				ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
				Если ОтветСервиса.КодСостояния<400 Тогда 
					Если ПараметрыВызова.Метод = "POST" И ОтветСервиса.Контент<>Неопределено Тогда 
						ПрисвоенныйИдентификатор = Неопределено;
						ОтветСервиса.Контент.Свойство("entityId", ПрисвоенныйИдентификатор);
						Если ПрисвоенныйИдентификатор<>Неопределено Тогда
							СертификатРаботника.Идентификатор = ПрисвоенныйИдентификатор;
							СертификатРаботника.МоментВыгрузки = МоментВыгрузкиНаСервере();
							ЗаписатьРезультатВыгрузкиСертификата(Работник.ФизическоеЛицо, СертификатРаботника.Специальность, 
									СертификатРаботника.ДатаПолучения, СертификатРаботника.Идентификатор, СертификатРаботника.МоментВыгрузки)
						Иначе 
							ВыгрузкаВыполнена = Ложь;
						КонецЕсли;
					ИначеЕсли ПараметрыВызова.Метод = "PUT" И ОтветСервиса.СообщениеОбОшибкеПользователю=Неопределено Тогда
						СертификатРаботника.МоментВыгрузки = МоментВыгрузкиНаСервере();
						ЗаписатьРезультатВыгрузкиСертификата(Работник.ФизическоеЛицо, СертификатРаботника.Специальность, 
								СертификатРаботника.ДатаПолучения, СертификатРаботника.Идентификатор, СертификатРаботника.МоментВыгрузки)
					Иначе 
						ВыгрузкаВыполнена = Ложь;
					КонецЕсли;
				Иначе 
					ВыгрузкаВыполнена = Ложь;
				КонецЕсли;
				Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
					СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Выгрузка сертификата медработника %1: %2%3'"), 
							Работник.ФизическоеЛицо, ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
					ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю, , 
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.Работники[%1].ФизическоеЛицо", РаботникДляВыгрузки.НомерСтроки-1));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Награды.
		Для Каждого НаградаРаботника Из ДанныеДляВыгрузки.Награды Цикл
			Если ВыгрузкаНеобходима(НаградаРаботника.МоментВыгрузки, НаградаРаботника.МоментИзменения) Тогда
				ВыгрузкаПроизводилась = Истина;
				PersonNominationData = ПодготовитьДанныеНаграды(НаградаРаботника);
				ПараметрыВызова = PostPutPersonNomination(PersonKey, PersonNominationData);
				ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
				ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
				Если ОтветСервиса.КодСостояния<400 Тогда 
					Если ПараметрыВызова.Метод = "POST" И ОтветСервиса.Контент<>Неопределено Тогда 
						ПрисвоенныйИдентификатор = Неопределено;
						ОтветСервиса.Контент.Свойство("entityId", ПрисвоенныйИдентификатор);
						Если ПрисвоенныйИдентификатор<>Неопределено Тогда
							НаградаРаботника.Идентификатор = ПрисвоенныйИдентификатор;
							НаградаРаботника.МоментВыгрузки = МоментВыгрузкиНаСервере();
							ЗаписатьРезультатВыгрузкиНаграды(Работник.ФизическоеЛицо, НаградаРаботника.Награда, НаградаРаботника.ДатаПриказа, 
									НаградаРаботника.НомерПриказа, НаградаРаботника.Идентификатор, НаградаРаботника.МоментВыгрузки)
						Иначе 
							ВыгрузкаВыполнена = Ложь;
						КонецЕсли;
					ИначеЕсли ПараметрыВызова.Метод = "PUT" И ОтветСервиса.СообщениеОбОшибкеПользователю=Неопределено Тогда
						НаградаРаботника.МоментВыгрузки = МоментВыгрузкиНаСервере();
						ЗаписатьРезультатВыгрузкиНаграды(Работник.ФизическоеЛицо, НаградаРаботника.Награда, НаградаРаботника.ДатаПриказа, 
								НаградаРаботника.НомерПриказа, НаградаРаботника.Идентификатор, НаградаРаботника.МоментВыгрузки)
					Иначе 
						ВыгрузкаВыполнена = Ложь;
					КонецЕсли;
				Иначе 
					ВыгрузкаВыполнена = Ложь;
				КонецЕсли;
				Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
					СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Выгрузка награды медработника %1: %2%3'"), 
							Работник.ФизическоеЛицо, ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
					ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю, , 
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.Работники[%1].ФизическоеЛицо", РаботникДляВыгрузки.НомерСтроки-1));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Квалификация.
		Для Каждого КвалификацияРаботника Из ДанныеДляВыгрузки.Квалификация Цикл
			Если ВыгрузкаНеобходима(КвалификацияРаботника.МоментВыгрузки, КвалификацияРаботника.МоментИзменения) Тогда
				ВыгрузкаПроизводилась = Истина;
				PersonQualificationData = ПодготовитьДанныеКвалификации(КвалификацияРаботника);
				ПараметрыВызова = PostPutPersonQualification(PersonKey, PersonQualificationData);
				ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
				ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
				Если ОтветСервиса.КодСостояния<400 Тогда 
					Если ПараметрыВызова.Метод = "POST" И ОтветСервиса.Контент<>Неопределено Тогда 
						ПрисвоенныйИдентификатор = Неопределено;
						ОтветСервиса.Контент.Свойство("entityId", ПрисвоенныйИдентификатор);
						Если ПрисвоенныйИдентификатор<>Неопределено Тогда
							КвалификацияРаботника.Идентификатор = ПрисвоенныйИдентификатор;
							КвалификацияРаботника.МоментВыгрузки = МоментВыгрузкиНаСервере();
							ЗаписатьРезультатВыгрузкиКвалификации(Работник.ФизическоеЛицо, КвалификацияРаботника.ДатаПрисвоения, КвалификацияРаботника.Специальность, 
									КвалификацияРаботника.Идентификатор, КвалификацияРаботника.МоментВыгрузки)
						Иначе 
							ВыгрузкаВыполнена = Ложь;
						КонецЕсли;
					ИначеЕсли ПараметрыВызова.Метод = "PUT" И ОтветСервиса.СообщениеОбОшибкеПользователю=Неопределено Тогда
						КвалификацияРаботника.МоментВыгрузки = МоментВыгрузкиНаСервере();
						ЗаписатьРезультатВыгрузкиКвалификации(Работник.ФизическоеЛицо, КвалификацияРаботника.ДатаПрисвоения, КвалификацияРаботника.Специальность, 
								КвалификацияРаботника.Идентификатор, КвалификацияРаботника.МоментВыгрузки)
					Иначе 
						ВыгрузкаВыполнена = Ложь;
					КонецЕсли;
				Иначе 
					ВыгрузкаВыполнена = Ложь;
				КонецЕсли;
				Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
					СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Выгрузка квалификации медработника %1: %2%3'"), 
							Работник.ФизическоеЛицо, ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
					ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю, , 
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.Работники[%1].ФизическоеЛицо", РаботникДляВыгрузки.НомерСтроки-1));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Личное дело.
		НачальнаяЗаписьЛД = 0;
		Если ПерваяЗаписьЛичногоДелаВыгружена Тогда 
			ВыгрузкаПроизводилась = Истина;
			НачальнаяЗаписьЛД = 1;
		КонецЕсли;
		Для ИндексЗаписиЛД = НачальнаяЗаписьЛД По ДанныеДляВыгрузки.ЛичноеДело.Количество() - 1 Цикл
			ЛичноеДелоРаботника = ДанныеДляВыгрузки.ЛичноеДело[ИндексЗаписиЛД];
			// Личное дело - это единственный раздел, по которому нет надежного логирования изменений,
			// поэтому нет проверки на необходимость выгрузки. Все записи выгружаются каждый раз.
			ВыгрузкаПроизводилась = Истина;
			ОтветСервиса = ОтправитьЗаписьЛичногоДела(PersonKey, ВыгрузкаВыполнена, ЛичноеДелоРаботника, ПараметрыСервиса, Работник);
			Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
				СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Выгрузка личного дела медработника %1: %2%3'"), 
						Работник.ФизическоеЛицо, ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
				ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю, , 
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.Работники[%1].ФизическоеЛицо", РаботникДляВыгрузки.НомерСтроки-1));
			КонецЕсли;
		КонецЦикла;
		
		Если ВыгрузкаПроизводилась Тогда
			РаботникДляВыгрузки.СтадияВыгрузки = ?(ВыгрузкаВыполнена, 2, 3);
		КонецЕсли;
		
#КонецОбласти
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ОтправитьЗаписьЛичногоДела(PersonKey, ВыгрузкаВыполнена, ЛичноеДелоРаботника, ПараметрыСервиса, Работник, ДляПрикрепленияРаботника = Ложь)  
	
	PersonCardData = ПодготовитьДанныеЛичногоДела(ЛичноеДелоРаботника);
	ПараметрыВызова = PostPutPersonCard(PersonKey, PersonCardData, ДляПрикрепленияРаботника);
	ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
	ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
	Если ОтветСервиса.КодСостояния<400 Тогда 
		Если ПараметрыВызова.Метод = "POST" И ОтветСервиса.Контент<>Неопределено Тогда 
			ПрисвоенныйИдентификатор = Неопределено;
			ОтветСервиса.Контент.Свойство("entityId", ПрисвоенныйИдентификатор);
			Если ПрисвоенныйИдентификатор<>Неопределено Тогда
				ЛичноеДелоРаботника.Идентификатор = ПрисвоенныйИдентификатор;
				ЛичноеДелоРаботника.МоментВыгрузки = МоментВыгрузкиНаСервере();
				ЗаписатьРезультатВыгрузкиЛичногоДела(Работник.ФизическоеЛицо, Объект.УИНОрганизации, ЛичноеДелоРаботника.ТабельныйНомер, 
						ЛичноеДелоРаботника.ДатаНачалаЗаписи, ЛичноеДелоРаботника.Идентификатор, ЛичноеДелоРаботника.МоментВыгрузки)
			Иначе 
				ВыгрузкаВыполнена = Ложь;
			КонецЕсли;
		ИначеЕсли ПараметрыВызова.Метод = "PUT" И ОтветСервиса.СообщениеОбОшибкеПользователю=Неопределено Тогда
			ЛичноеДелоРаботника.МоментВыгрузки = МоментВыгрузкиНаСервере();
			ЗаписатьРезультатВыгрузкиЛичногоДела(Работник.ФизическоеЛицо, Объект.УИНОрганизации, ЛичноеДелоРаботника.ТабельныйНомер, 
					ЛичноеДелоРаботника.ДатаНачалаЗаписи, ЛичноеДелоРаботника.Идентификатор, ЛичноеДелоРаботника.МоментВыгрузки)
		Иначе 
			ВыгрузкаВыполнена = Ложь;
		КонецЕсли;
	Иначе 
		ВыгрузкаВыполнена = Ложь;
	КонецЕсли;
	
	Возврат ОтветСервиса;

КонецФункции 
	
&НаКлиенте
Функция ОтправитьОбщиеДанные(PersonKey, ВыгрузкаВыполнена, ДанныеДляВыгрузки, ПараметрыСервиса, Работник)
	
	PersonData = ПодготовитьОбщиеДанныеРаботника(Работник, ДанныеДляВыгрузки.ДокументыУдостоверяющиеЛичность);
	ПараметрыВызова = PostPutPerson(PersonKey, PersonData);
	ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
	ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
	Если ОтветСервиса.КодСостояния<400 Тогда 
		Если ПараметрыВызова.Метод = "POST" И ОтветСервиса.Контент<>Неопределено Тогда 
			ПрисвоенныйИдентификатор = Неопределено;
			ОтветСервиса.Контент.Свойство("entityId", ПрисвоенныйИдентификатор);
			Если ПрисвоенныйИдентификатор<>Неопределено Тогда
				PersonKey.oid = ПрисвоенныйИдентификатор;
				PersonKey.snils = Неопределено;
				Работник.Идентификатор = ПрисвоенныйИдентификатор;
				Работник.МоментВыгрузки = МоментВыгрузкиНаСервере();
				ЗаписатьРезультатВыгрузки(Работник.ФизическоеЛицо, Работник.Идентификатор, Работник.МоментВыгрузки, ПараметрыВызова.РазделМедрегистра); 
				// Пауза после добавления медработника необходима, чтобы отработали все последующие запросы. 
				// Без паузы они завершатся с ошибкой "Медработник не найден".
				Пауза(5);
			Иначе 
				ВыгрузкаВыполнена = Ложь;
			КонецЕсли;
		ИначеЕсли ПараметрыВызова.Метод = "PUT" И ОтветСервиса.СообщениеОбОшибкеПользователю=Неопределено Тогда
			Работник.МоментВыгрузки = МоментВыгрузкиНаСервере();
			ЗаписатьРезультатВыгрузки(Работник.ФизическоеЛицо, Работник.Идентификатор, Работник.МоментВыгрузки, ПараметрыВызова.РазделМедрегистра);
		Иначе 
			ВыгрузкаВыполнена = Ложь;
		КонецЕсли;
	Иначе 
		ВыгрузкаВыполнена = Ложь;
	КонецЕсли; 
	
	Возврат ОтветСервиса;

КонецФункции 

&НаКлиенте
Функция ПолучитьПолныеДанныеМедработника(PersonKey, ДанныеДляВыгрузки, ПараметрыСервиса, Работник, РаботникДляВыгрузки)
	
	ПараметрыВызова = GetPersonFull(PersonKey);
	ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
	ОтветСервиса = ВызватьМетод(Объект.Организация, ТокенДоступа, ПараметрыВызова);
	Если ОтветСервиса.КодСостояния<400 Тогда 
		Если ОтветСервиса.Контент<>Неопределено Тогда
			ПрисвоенныйИдентификатор = Неопределено;
			ОтветСервиса.Контент.Свойство("oid", ПрисвоенныйИдентификатор);
			Если ПрисвоенныйИдентификатор<>Неопределено Тогда   
				Работник.Идентификатор = ПрисвоенныйИдентификатор;
				ЗаписатьРезультатВыгрузки(Работник.ФизическоеЛицо, ПрисвоенныйИдентификатор, Неопределено, Неопределено);
				PersonKey.oid = ПрисвоенныйИдентификатор;
				PersonKey.snils = Неопределено;
				// Тут заполнение идентификаторов в ТЧ.
				Если ДанныеДляВыгрузки.ЛичноеДело.Количество()>0 Тогда 
					РазделЛичноеДело = Неопределено;
					Если ОтветСервиса.Контент.Свойство("personCard", РазделЛичноеДело) Тогда
						Если РазделЛичноеДело<>Неопределено Тогда 
							// Записей личного дела может быть несколько. Нужно подбирать по табельному номеру и дате начала.
							Для Каждого ЛичноеДелоФРМР Из РазделЛичноеДело Цикл
								ОрганизацияЛичногоДелаФРМР = Неопределено;
								ИдентификаторЛичногоДелаФРМР = Неопределено;
								ТабельныйНомерЛичногоДелаФРМР = Неопределено;
								ДатаНачалаЗаписиЛичногоДелаФРМР = Неопределено;
								Если ЛичноеДелоФРМР.Свойство("oid", ОрганизацияЛичногоДелаФРМР) 
									И ЛичноеДелоФРМР.Свойство("id", ИдентификаторЛичногоДелаФРМР) 
									И ЛичноеДелоФРМР.Свойство("serviceNumber", ТабельныйНомерЛичногоДелаФРМР) 
									И ЛичноеДелоФРМР.Свойство("beginDate", ДатаНачалаЗаписиЛичногоДелаФРМР) Тогда
									Для Каждого ЛичноеДелоИБ Из ДанныеДляВыгрузки.ЛичноеДело Цикл
										Если Объект.УИНОрганизации=ОрганизацияЛичногоДелаФРМР 
											И ЛичноеДелоИБ.ТабельныйНомер=ТабельныйНомерЛичногоДелаФРМР 
											И ЛичноеДелоИБ.ДатаНачалаЗаписи=МедицинскиеРегистрыКлиент.ДатаИзUTC(ДатаНачалаЗаписиЛичногоДелаФРМР) Тогда 
											ЛичноеДелоИБ.Идентификатор = ИдентификаторЛичногоДелаФРМР;
											ЗаписатьРезультатВыгрузкиЛичногоДела(Работник.ФизическоеЛицо, Объект.УИНОрганизации, ЛичноеДелоИБ.ТабельныйНомер, 
