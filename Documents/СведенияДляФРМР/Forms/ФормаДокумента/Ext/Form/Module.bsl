&НаКлиенте
Функция ПодготовитьДанныеЛичногоДела(ЛичноеДелоРаботника)
	
	PersonCardData = PersonCardData();
	PersonCardData.id = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.Идентификатор);
	PersonCardData.lastName = НеопределеноЕслиПустаяСтрока(ЛичноеДелоРаботника.Фамилия);
	PersonCardData.oid = НеопределеноЕслиПустаяСтрока(Объект.УИНОрганизации);
	PersonCardData.organization = НеопределеноЕслиПустаяСтрока(Объект.Организация);
	PersonCardData.nrPmuDepartId = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ИдентификаторПодразделения);
	Если ЛичноеДелоРаботника.ТипПодразделенияКод="2" Тогда 
		PersonCardData.nrPmuDepartHospitalSubdivisionId = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ИдентификаторОтделенияИлиКабинета);
	ИначеЕсли ЛичноеДелоРаботника.ТипПодразделенияКод="1"
		Или ЛичноеДелоРаботника.ТипПодразделенияКод="3"
		Или ЛичноеДелоРаботника.ТипПодразделенияКод="4" Тогда
		PersonCardData.roomOid = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ИдентификаторОтделенияИлиКабинета);
	КонецЕсли;
	PersonCardData.contractNumber = ЛичноеДелоРаботника.ТрудовойДоговорНомер;
	PersonCardData.contractDate = ЛичноеДелоРаботника.ТрудовойДоговорДата;
	PersonCardData.serviceNumber = ЛичноеДелоРаботника.ТабельныйНомер;
	PersonCardData.fedPositionId = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ФедеральнаяДолжностьКод);
	PersonCardData.seniority = Неопределено;
	PersonCardData.services = Новый Массив;
	Если Не ПустаяСтрока(ЛичноеДелоРаботника.ОказываемаяМедУслугаКод) Тогда 
		НоваяМедУслуга = PersonCardServices();
		НоваяМедУслуга.code = ЛичноеДелоРаботника.ОказываемаяМедУслугаКод;
		PersonCardData.services.Добавить(НоваяМедУслуга);
	КонецЕсли;
	PersonCardData.positionTypeId = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ТипЗанятияДолжностиКод);
	PersonCardData.postId = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.МедицинскаяДолжностьКод);
	PersonCardData.rate = ЛичноеДелоРаботника.КоличествоСтавок;
	PersonCardData.beginDate = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ДатаНачалаЗаписи);
	PersonCardData.endDate = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ДатаОкончанияЗаписи);
	Если ЗначениеЗаполнено(ЛичноеДелоРаботника.ВидСобытияОкончания) Тогда 
		PersonCardData.endTypeId = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ВидСобытияОкончанияКод);
		Если ЛичноеДелоРаботника.ВидСобытияОкончания=ВидыКадровыхСобытийУвольнение Тогда 
			PersonCardData.fireReasonId = НеопределеноЕслиНеЗаполнено(ЛичноеДелоРаботника.ПричинаУвольненияКод);
		КонецЕсли;
	КонецЕсли;
	PersonCardData.targeted = ЛичноеДелоРаботника.ЦелеваяПодготовка;
	PersonCardData.temporaryDerelictions = Неопределено;
	Возврат PersonCardData;

КонецФункции

