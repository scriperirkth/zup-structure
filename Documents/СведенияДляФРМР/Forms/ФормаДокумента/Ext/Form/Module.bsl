&НаКлиенте
Функция ПодготовитьДанныеПрофессиональногоОбразования(Работник, ТекущееОбразование)
	
	PersonProfData = PersonProfData();
	PersonProfData.profId = НеопределеноЕслиНеЗаполнено(ТекущееОбразование.Идентификатор);
	PersonProfData.isStudentEducation = Ложь;
	Если Не Работник.ЯвляетсяМедработником Тогда 
		PersonProfData.hasDiploma = Истина;
	КонецЕсли;
	PersonProfData.isDuplicate = Ложь;
	PersonProfData.beginYear = ?(ЗначениеЗаполнено(ТекущееОбразование.Начало), Год(ТекущееОбразование.Начало), Неопределено);
	PersonProfData.docSerial = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.СерияДиплома);
	PersonProfData.docNumber = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.НомерДиплома);
	PersonProfData.docDate = НеопределеноЕслиНеЗаполнено(ТекущееОбразование.ДатаВыдачиДиплома);
	PersonProfData.educationTypeId.code = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.ВидОбразованияКод);
	PersonProfData.specId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.СпециальностьКод);
	PersonProfData.qualificationId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.КвалификацияКод);
	Если ТекущееОбразование.ЗаПределамиРФ Тогда
		PersonProfData.foreignInstitution = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.ОбразовательнаяОрганизация);
		Если Не ПустаяСтрока(ТекущееОбразование.РеспубликаСССРКод) И ПустаяСтрока(ТекущееОбразование.СтранаМираКод) Тогда 
			PersonProfData.educPlace = 1;
			PersonProfData.unionRepublicId = ТекущееОбразование.РеспубликаСССРКод;
		Иначе 
			PersonProfData.educPlace = 2;
			PersonProfData.oksmId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.СтранаМираКод);
			PersonProfData.hasForeignCert = 2;
		КонецЕсли;
	Иначе 
		PersonProfData.educPlace = 0;
