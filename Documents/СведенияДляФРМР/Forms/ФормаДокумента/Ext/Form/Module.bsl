Функция ПодготовитьДанныеПослевузовскогоОбразования(ТекущееОбразование)
	
	PersonPostgraduateData = PersonPostgraduateData();
	PersonPostgraduateData.postgraduateId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.Идентификатор);
	PersonPostgraduateData.isDuplicate = Ложь;
	PersonPostgraduateData.educationStageId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.ВидОбразованияКод);
	PersonPostgraduateData.isStudying = Ложь;
	PersonPostgraduateData.beginYear = ?(ЗначениеЗаполнено(ТекущееОбразование.Начало), Год(ТекущееОбразование.Начало), Неопределено);
	PersonPostgraduateData.docSerial = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.СерияДиплома);
	PersonPostgraduateData.docNumber = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.НомерДиплома);
	PersonPostgraduateData.docDate = НеопределеноЕслиНеЗаполнено(ТекущееОбразование.ДатаВыдачиДиплома);
	PersonPostgraduateData.academicDegreeId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.УченаяСтепеньКод);
	PersonPostgraduateData.scienceBranchId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.ОтрасльНаукиКод);
	Если PersonPostgraduateData.educationStageId = "1" Или PersonPostgraduateData.educationStageId = "2" Тогда 
		PersonPostgraduateData.specId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.СпециальностьОрдинатурыКод);
	КонецЕсли;
	Если PersonPostgraduateData.educationStageId = "3" Или PersonPostgraduateData.educationStageId = "4" Тогда 
		PersonPostgraduateData.doctSpecId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.СпециальностьДокторантурыКод);
	КонецЕсли;
	Если ТекущееОбразование.ЗаПределамиРФ Тогда
		PersonPostgraduateData.foreignInstitution = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.ОбразовательнаяОрганизация);
		Если Не ПустаяСтрока(ТекущееОбразование.РеспубликаСССРКод) И ПустаяСтрока(ТекущееОбразование.СтранаМираКод) Тогда 
			PersonPostgraduateData.educPlace = 1;
			PersonPostgraduateData.unionRepublicId = ТекущееОбразование.РеспубликаСССРКод;
		Иначе 
			PersonPostgraduateData.educPlace = 2;
			PersonPostgraduateData.oksmId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.СтранаМираКод);
			PersonPostgraduateData.hasForeignCert = 2;
		КонецЕсли;
	Иначе 
		PersonPostgraduateData.educPlace = 0;
		PersonPostgraduateData.institutionId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.УчебноеЗаведениеКод);
		Если PersonPostgraduateData.educationStageId <> "3" И PersonPostgraduateData.educationStageId <> "4" И PersonPostgraduateData.educationStageId <> "5" Тогда 
			PersonPostgraduateData.isTargeted = ЗначениеЗаполнено(ТекущееОбразование.ЗаказчикЦелевогоОбученияКод);
			Если PersonPostgraduateData.isTargeted Тогда
				PersonPostgraduateData.targetedRegionId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.ЗаказчикЦелевогоОбученияКод);
				PersonPostgraduateData.dutyMonthsPeriod = РазмерПериода(ТекущееОбразование.Начало, ТекущееОбразование.Окончание);
				PersonPostgraduateData.isTargetTerminated = ЗначениеЗаполнено(ТекущееОбразование.ПричинаРасторженияКод);
				Если PersonPostgraduateData.isTargetTerminated Тогда 
					PersonPostgraduateData.terminationReasonId = НеопределеноЕслиПустаяСтрока(ТекущееОбразование.ПричинаРасторженияКод);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат PersonPostgraduateData;

