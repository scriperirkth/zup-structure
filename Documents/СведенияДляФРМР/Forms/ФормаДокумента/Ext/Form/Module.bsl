#Область ОписаниеПеременных

&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем ФормаДлительнойОперации;

&НаКлиенте
Перем УдаляемыеРаботники;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидыКадровыхСобытийУвольнение = Перечисления.ВидыКадровыхСобытий.Увольнение;
	
	Если Параметры.Ключ.Пустая() Тогда
		ЗапрашиваемыеЗначения = Новый Структура;
		ЗапрашиваемыеЗначения.Вставить("Организация", "Объект.Организация");
		ЗапрашиваемыеЗначения.Вставить("Ответственный", "Объект.Ответственный");
		ЗарплатаКадры.ЗаполнитьПервоначальныеЗначенияВФорме(ЭтаФорма, ЗапрашиваемыеЗначения);
		ПриПолученииДанныхНаСервере();
	КонецЕсли;
	
	НастройкиМедрегистров = МедицинскиеРегистры.ПолучитьНастройкиВзаимодействияСФедеральнымиМедрегистрами();
	ИспользоватьТокен = (НастройкиМедрегистров.СпособПодключения = Перечисления.СпособыПодключенияКФедеральнымМедрегистрам.ИПС);
	ЗаполнитьНастройкиОрганизацииНаСервере();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Сертификат", "Видимость", ИспользоватьТокен); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Пароль", "Видимость", ИспользоватьТокен); 

	// Обработчик подсистемы "ВерсионированиеОбъектов".
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ПриПолученииДанныхНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаполнитьТекущиеПозицииРаботников();
	// Предыдущая строка меняет только несохраняемые данные, поэтому модифицированность
	// надо сбросить обратно, чтобы правильно устанавливалась доступность выгрузки.
	Модифицированность = Ложь;
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	Если ИмяСобытия="ОбновленаХарактеристикаОбъектаДляФедеральныхМедрегистровИзСведенийДляФРМР" Тогда 
		ОбновитьХарактеристикуОбъекта(Параметр.ОбъектСсылка, Параметр.ХарактеристикаСсылка, Параметр.ИмяРеквизита, Параметр.ИмяРеквизитаФРМР);
		ОбновитьСвязанныеХарактеристики(Параметр.ОбъектСсылка, Параметр.ХарактеристикаСсылка, Параметр.ИмяРеквизита, Параметр.ИмяРеквизитаФРМР);
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Процедура ОбновитьХарактеристикуОбъекта(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)

	МедицинскиеРегистры.СохранитьХарактеристикуОбъектаМедицинскогоРегистра(ОбъектСсылка, ХарактеристикаСсылка.Владелец, ХарактеристикаСсылка);
	ОбновитьВсеВхожденияХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеВхожденияХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)
	
	СтруктураОтбора = Новый Структура(ИмяРеквизита, ОбъектСсылка);
	ВсеСтрокиДляОбновления = Новый Массив; 
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.СтраныМира") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.Работники.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ВидыДокументовФизическихЛиц") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ДокументыУдостоверяющиеЛичность.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ВидыОбразованияФизическихЛиц") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("ПеречислениеСсылка.ВидыПрофессиональнойПодготовки") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ДополнительноеПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ОбразованиеФизическихЛиц") Тогда 
		Если ИмяРеквизитаФРМР = "КвалификацияФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
		ИначеЕсли ИмяРеквизитаФРМР = "ЗаказчикЦелевогоОбученияФРМР" Или ИмяРеквизитаФРМР = "ПричинаРасторженияФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.УчебныеЗаведения") Тогда 
		Если ИмяРеквизитаФРМР = "СтранаМираФРМР" Или ИмяРеквизитаФРМР = "РеспубликаСССРФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
		ИначеЕсли ИмяРеквизитаФРМР = "УчебноеЗаведениеФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ДополнительноеПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.Сертификаты.НайтиСтроки(СтруктураОтбора));
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.КлассификаторСпециальностейПоОбразованию") Тогда 
		Если ИмяРеквизитаФРМР = "СпециальностьОрдинатурыФРМР" Или ИмяРеквизитаФРМР = "СпециальностьДокторантурыФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПослевузовскоеОбразование.НайтиСтроки(СтруктураОтбора));
		ИначеЕсли ИмяРеквизитаФРМР = "СпециальностьФРМР" Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ДополнительноеПрофессиональноеОбразование.НайтиСтроки(СтруктураОтбора));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.Сертификаты.НайтиСтроки(СтруктураОтбора));
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Должности") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ЛичноеДело.НайтиСтроки(СтруктураОтбора));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.Квалификация.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("ПеречислениеСсылка.ВидыЗанятости") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ЛичноеДело.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("ПеречислениеСсылка.ВидыКадровыхСобытий") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ЛичноеДело.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ОснованияУвольнения") Тогда 
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСтрокиДляОбновления, Объект.ЛичноеДело.НайтиСтроки(СтруктураОтбора));
	КонецЕсли;

	Для Каждого СтрокаДляОбновления Из ВсеСтрокиДляОбновления Цикл
		СтрокаДляОбновления[ИмяРеквизитаФРМР] = ХарактеристикаСсылка;
		Модифицированность = Истина;
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСвязанныеХарактеристики(ОбъектСсылка, ХарактеристикаСсылка, ИмяРеквизита, ИмяРеквизитаФРМР)
	id_181 = ХарактеристикаСсылка.ОписаниеЭлемента.Найти("id_181", "Поле");
	Если ЗначениеЗаполнено(id_181) Тогда
		Владелец = Справочники.КлассификаторыФедеральныхМедрегистров.НайтиПоКоду("1.2.643.5.1.13.13.99.2.181", Истина);
		ЭлементКлассификатора = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.НайтиПоКоду(id_181.Значение, Ложь, , Владелец);
		Если ЗначениеЗаполнено(Владелец) И ЗначениеЗаполнено(ЭлементКлассификатора) Тогда
			ОбновитьХарактеристикуОбъекта(ОбъектСсылка, ЭлементКлассификатора, "Должность", "МедицинскаяДолжностьФРМР");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры
	
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры
	
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ЗарплатаКадрыКлиент.КлючевыеРеквизитыЗаполненияФормыОчиститьТаблицы(ЭтаФорма);
	ЗаполнитьНастройкиОрганизацииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ЗарплатаКадрыКлиент.КлючевыеРеквизитыЗаполненияФормыОчиститьТаблицы(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СертификатПриИзменении(Элемент)
	СертификатПриИзмененииНаСервере(Объект.Организация, Сертификат);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура РаботникиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ЗаполнитьНаКлиенте(ВыбранноеЗначение);
КонецПроцедуры

&НаКлиенте
Процедура РаботникиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РаботникиПередУдалением(Элемент, Отказ)
	
	УдаляемыеРаботники = Новый Массив;
	УдаляемыеСтроки = Элемент.ВыделенныеСтроки;
	Для Каждого ИдентификаторСтроки Из УдаляемыеСтроки Цикл
		СтрокаРаботник = Объект.Работники.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаРаботник <> Неопределено Тогда 
			УдаляемыеРаботники.Добавить(СтрокаРаботник.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РаботникиПослеУдаления(Элемент)
	
	Для Каждого ФизическоеЛицо Из УдаляемыеРаботники Цикл
		СтрокиРаботников = Объект.Работники.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
		Если СтрокиРаботников.Количество() = 0 Тогда
			УдалитьСтрокиРаботника("ДокументыУдостоверяющиеЛичность", "ФизическоеЛицо", ФизическоеЛицо);
			УдалитьСтрокиРаботника("ЛичноеДело", "ФизическоеЛицо", ФизическоеЛицо);
			УдалитьСтрокиРаботника("ОбщееОбразование", "ФизическоеЛицо", ФизическоеЛицо);
			УдалитьСтрокиРаботника("ПрофессиональноеОбразование", "ФизическоеЛицо", ФизическоеЛицо);
			УдалитьСтрокиРаботника("ПослевузовскоеОбразование", "ФизическоеЛицо", ФизическоеЛицо);
			УдалитьСтрокиРаботника("ДополнительноеПрофессиональноеОбразование", "ФизическоеЛицо", ФизическоеЛицо);
			УдалитьСтрокиРаботника("Сертификаты", "ФизическоеЛицо", ФизическоеЛицо);
			УдалитьСтрокиРаботника("Награды", "ФизическоеЛицо", ФизическоеЛицо);
			УдалитьСтрокиРаботника("Квалификация", "ФизическоеЛицо", ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;
	УдаляемыеРаботники.Очистить();
	ЗарплатаКадрыКлиентСервер.КлючевыеРеквизитыЗаполненияФормыУстановитьОтображениеПредупреждения(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботникиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя="РаботникиФизическоеЛицо" Тогда
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("Ключ", ТекущиеДанные.ФизическоеЛицо);
		ОткрытьФорму("Справочник.ФизическиеЛица.ФормаОбъекта", ПараметрыОткрытия);
		
	Иначе 
		
		СтандартнаяОбработка = Ложь;
		СведенияМедицинскогоРаботника(Команды.Найти("СведенияМедицинскогоРаботника"));
		
	КонецЕсли;
	
КонецПроцедуры

