// Заполняет документ данными из хранилища.
//  Параметры: АдресХранилища - адрес временного хранилища.
Процедура ЗаполнитьИзХранилища(Объект, АдресХранилища) Экспорт

	ПараметрыЗаполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	СписокРаботников = ПараметрыЗаполнения.СписокРаботников;
	ДанныеДляЗаполнения = ПараметрыЗаполнения.ДанныеДляЗаполнения;
	ТабличныеЧасти = ТабличныеЧастиСФизическимЛицом(Объект);
	
	// 1 Скопом весь документ
	Если СписокРаботников = Неопределено Или СписокРаботников.Количество() = 0 Тогда 
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			Объект[ТабличнаяЧасть].Очистить();
			Если ДанныеДляЗаполнения.Свойство(ТабличнаяЧасть) И ДанныеДляЗаполнения[ТабличнаяЧасть]<>Неопределено Тогда
				Объект[ТабличнаяЧасть].Загрузить(ДанныеДляЗаполнения[ТабличнаяЧасть]);
			КонецЕсли;	
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	// 2 Выбранным списком физических лиц.
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		Если ДанныеДляЗаполнения.Свойство(ТабличнаяЧасть) Тогда
			ЗагрузитьВТабличнуюЧастьДокумента(Объект, СписокРаботников, ТабличнаяЧасть, ДанныеДляЗаполнения[ТабличнаяЧасть])
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьОтредактированныеДанныеИзХранилища(Объект, АдресХранилища) Экспорт

	ОтредактированныеДанныеРаботника = ПолучитьИзВременногоХранилища(АдресХранилища);
	ФизическоеЛицо = ОтредактированныеДанныеРаботника.ФизическоеЛицо;
	Отбор = Новый Структура("ФизическоеЛицо", ФизическоеЛицо);
	СтрокиРаботника = Объект.Работники.НайтиСтроки(Отбор);
	Если СтрокиРаботника.Количество() <> 1 Тогда 
		Возврат;
	КонецЕсли;
    СтрокаРаботника = СтрокиРаботника[0];
	СтрокаРаботника.ОтношениеКВоинскойОбязанностиФРМР = ОтредактированныеДанныеРаботника.ОтношениеКВоинскойОбязанностиФРМР;
	СтрокаРаботника.СтранаФРМР = ОтредактированныеДанныеРаботника.СтранаФРМР;
	
	ТабличныеЧасти = ТабличныеЧастиСФизическимЛицом(Объект, Истина);
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		Если ОтредактированныеДанныеРаботника.Свойство(ТабличнаяЧасть) Тогда
			ЗагрузитьВТабличнуюЧастьДокумента(Объект, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическоеЛицо), ТабличнаяЧасть, ОтредактированныеДанныеРаботника[ТабличнаяЧасть])
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

// Удаляет все строки Работника во всех табличных частях документа.
Процедура ОчиститьДанныеРаботника(Объект, ФизическоеЛицо, СохранитьСтрокуРаботника = Ложь) Экспорт

	ТабличныеЧастиСФизическимЛицом = ТабличныеЧастиСФизическимЛицом(Объект, СохранитьСтрокуРаботника); 
	Отбор = Новый Структура("ФизическоеЛицо", ФизическоеЛицо);
	
	Для Каждого ИмяТабличнойЧасти Из ТабличныеЧастиСФизическимЛицом Цикл 
		УдаляемыеСтроки = Объект[ИмяТабличнойЧасти].НайтиСтроки(Отбор);
		Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
			Объект[ИмяТабличнойЧасти].Удалить(УдаляемаяСтрока);
		КонецЦикла;
    КонецЦикла;

КонецПроцедуры

