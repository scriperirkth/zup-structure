		|			И СведенияДляФРМР.Специальность = ИдентификаторыКвалификаций.Специальность
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторРазрядКатегорияФРМР
		|		ПО СведенияДляФРМР.РазрядКатегорияФРМР = КлассификаторРазрядКатегорияФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторСпециальностьФРМР
		|		ПО СведенияДляФРМР.СпециальностьФРМР = КлассификаторСпециальностьФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторМедицинскаяДолжностьФРМР
		|		ПО СведенияДляФРМР.МедицинскаяДолжностьФРМР = КлассификаторМедицинскаяДолжностьФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторФедеральнаяДолжностьФРМР
		|		ПО СведенияДляФРМР.ФедеральнаяДолжностьФРМР = КлассификаторФедеральнаяДолжностьФРМР.Ссылка
		|ГДЕ
		|	СведенияДляФРМР.Ссылка = &ДокументСсылка
		|	И СведенияДляФРМР.ФизическоеЛицо = &ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(КлассификаторТипПодразделенияФРМР.Код, """") КАК ТипПодразделенияКод,
		|	СведенияДляФРМР.ИдентификаторПодразделения КАК ИдентификаторПодразделения,
		|	СведенияДляФРМР.ИдентификаторОтделенияИлиКабинета КАК ИдентификаторОтделенияИлиКабинета,
		|	ЕСТЬNULL(КлассификаторМедицинскаяДолжностьФРМР.Код, """") КАК МедицинскаяДолжностьКод,
		|	ЕСТЬNULL(КлассификаторФедеральнаяДолжностьФРМР.Код, """") КАК ФедеральнаяДолжностьКод,
		|	ЕСТЬNULL(КлассификаторТипЗанятияДолжностиФРМР.Код, """") КАК ТипЗанятияДолжностиКод,
		|	ЕСТЬNULL(КлассификаторВидСобытияОкончанияФРМР.Код, """") КАК ВидСобытияОкончанияКод,
		|	ЕСТЬNULL(КлассификаторПричинаУвольненияФРМР.Код, """") КАК ПричинаУвольненияКод,
		|	ЕСТЬNULL(КлассификаторОказываемаяМедУслугаФРМР.Код, """") КАК ОказываемаяМедУслугаКод,
		|	СведенияДляФРМР.Фамилия КАК Фамилия,
		|	СведенияДляФРМР.ТрудовойДоговорНомер КАК ТрудовойДоговорНомер,
		|	СведенияДляФРМР.ТрудовойДоговорДата КАК ТрудовойДоговорДата,
		|	СведенияДляФРМР.ТабельныйНомер КАК ТабельныйНомер,
		|	СведенияДляФРМР.КоличествоСтавок КАК КоличествоСтавок,
		|	СведенияДляФРМР.ДатаНачалаЗаписи КАК ДатаНачалаЗаписи,
		|	СведенияДляФРМР.ДатаОкончанияЗаписи КАК ДатаОкончанияЗаписи,
		|	СведенияДляФРМР.ВидСобытияОкончания КАК ВидСобытияОкончания,
		|	СведенияДляФРМР.ЦелеваяПодготовка КАК ЦелеваяПодготовка,
		|	ЕСТЬNULL(ИдентификаторыЛичныхДел.Идентификатор, """") КАК Идентификатор,
		|	ЕСТЬNULL(ИдентификаторыЛичныхДел.ИдентификаторЗанятости, """") КАК ИдентификаторЗанятости,
		|	ЕСТЬNULL(ИдентификаторыЛичныхДел.МоментВыгрузки, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментВыгрузки,
		|	ЕСТЬNULL(ИдентификаторыЛичныхДел.МоментИзменения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментИзменения,
		|	ЕСТЬNULL(ИдентификаторыЛичныхДел.МоментУдаления, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментУдаления
		|ИЗ
		|	Документ.СведенияДляФРМР.ЛичноеДело КАК СведенияДляФРМР
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыЛичныхДелДляФедеральныхМедрегистров КАК ИдентификаторыЛичныхДел
		|		ПО (ИдентификаторыЛичныхДел.УИНОрганизации = &УИНОрганизации)
		|			И СведенияДляФРМР.ФизическоеЛицо = ИдентификаторыЛичныхДел.ФизическоеЛицо
		|			И СведенияДляФРМР.ТабельныйНомер = ИдентификаторыЛичныхДел.ТабельныйНомер
		|			И СведенияДляФРМР.ДатаНачалаЗаписи = ИдентификаторыЛичныхДел.ДатаНачалаЗаписи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторТипПодразделенияФРМР
		|		ПО СведенияДляФРМР.ТипПодразделенияФРМР = КлассификаторТипПодразделенияФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторМедицинскаяДолжностьФРМР
		|		ПО СведенияДляФРМР.МедицинскаяДолжностьФРМР = КлассификаторМедицинскаяДолжностьФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторФедеральнаяДолжностьФРМР
		|		ПО СведенияДляФРМР.ФедеральнаяДолжностьФРМР = КлассификаторФедеральнаяДолжностьФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторТипЗанятияДолжностиФРМР
		|		ПО СведенияДляФРМР.ТипЗанятияДолжностиФРМР = КлассификаторТипЗанятияДолжностиФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторВидСобытияОкончанияФРМР
		|		ПО СведенияДляФРМР.ВидСобытияОкончанияФРМР = КлассификаторВидСобытияОкончанияФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторПричинаУвольненияФРМР
		|		ПО СведенияДляФРМР.ПричинаУвольненияФРМР = КлассификаторПричинаУвольненияФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторОказываемаяМедУслугаФРМР
		|		ПО СведенияДляФРМР.ОказываемаяМедУслугаФРМР = КлассификаторОказываемаяМедУслугаФРМР.Ссылка
		|ГДЕ
		|	СведенияДляФРМР.Ссылка = &ДокументСсылка
		|	И СведенияДляФРМР.ФизическоеЛицо = &ФизическоеЛицо";
	
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументВыгрузки);
	Запрос.УстановитьПараметр("ФизическоеЛицо", Работник);
	Запрос.УстановитьПараметр("УИНОрганизации", УИНОрганизации);
	Результаты = Запрос.ВыполнитьПакет(); 
	
	ДанныеДляВыгрузки.Работники = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[0].Выгрузить());
	ДанныеДляВыгрузки.ДокументыУдостоверяющиеЛичность = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[1].Выгрузить());
	ДанныеДляВыгрузки.ОбщееОбразование = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[2].Выгрузить());
	ДанныеДляВыгрузки.ПрофессиональноеОбразование = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[3].Выгрузить());
	ДанныеДляВыгрузки.ПослевузовскоеОбразование = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[4].Выгрузить());
	ДанныеДляВыгрузки.ДополнительноеПрофессиональноеОбразование = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[5].Выгрузить());
	ДанныеДляВыгрузки.Сертификаты = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[6].Выгрузить());
	ДанныеДляВыгрузки.Награды = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[7].Выгрузить());
	ДанныеДляВыгрузки.Квалификация = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[8].Выгрузить());
	ДанныеДляВыгрузки.ЛичноеДело = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результаты[9].Выгрузить());
	
	Возврат ДанныеДляВыгрузки;

КонецФункции

