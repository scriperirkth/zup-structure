		|			И ДанныеОбъектов.ДатаПрисвоения = ИдентификаторыОбъектов.ДатаПрисвоения
		|			И ДанныеОбъектов.Специальность = ИдентификаторыОбъектов.Специальность
		|ГДЕ
		|	ДанныеОбъектов.Ссылка = &ДокументСсылка
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ДанныеОбъектов.ФизическоеЛицо,
		|	"""",
		|	ЕСТЬNULL(ИдентификаторыОбъектов.МоментВыгрузки, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|		ИЛИ ЕСТЬNULL(ИдентификаторыОбъектов.МоментВыгрузки, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) <= ЕСТЬNULL(ИдентификаторыОбъектов.МоментИзменения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|ИЗ
		|	Документ.СведенияДляФРМР.ЛичноеДело КАК ДанныеОбъектов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыЛичныхДелДляФедеральныхМедрегистров КАК ИдентификаторыОбъектов
		|		ПО (ИдентификаторыОбъектов.УИНОрганизации = &УИНОрганизации)
		|			И ДанныеОбъектов.ФизическоеЛицо = ИдентификаторыОбъектов.ФизическоеЛицо
		|			И ДанныеОбъектов.ТабельныйНомер = ИдентификаторыОбъектов.ТабельныйНомер
		|			И ДанныеОбъектов.ДатаНачалаЗаписи = ИдентификаторыОбъектов.ДатаНачалаЗаписи
		|ГДЕ
		|	ДанныеОбъектов.Ссылка = &ДокументСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НеобходимостьВыгрузки.ФизическоеЛицо КАК ФизическоеЛицо,
		|	МАКСИМУМ(НеобходимостьВыгрузки.Идентификатор) КАК Идентификатор,
		|	МАКСИМУМ(НеобходимостьВыгрузки.ВыгрузкаНеобходима) КАК ВыгрузкаНеобходима
		|ИЗ
		|	ВТНеобходимостьВыгрузкиПоОбъектамРаботников КАК НеобходимостьВыгрузки
		|
		|СГРУППИРОВАТЬ ПО
		|	НеобходимостьВыгрузки.ФизическоеЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	НеобходимостьВыгрузки.ФизическоеЛицо";
	
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Запрос.УстановитьПараметр("УИНОрганизации", УИНОрганизации);
	Выборка = Запрос.Выполнить().Выбрать();
	НеобходимостьВыгрузки = Новый Соответствие();
	Пока Выборка.Следующий() Цикл 
		НеобходимостьВыгрузки.Вставить(Выборка.ФизическоеЛицо, Новый Структура("ВыгрузкаНеобходима, Идентификатор", Выборка.ВыгрузкаНеобходима, Выборка.Идентификатор));
	КонецЦикла;                   
	
	Возврат НеобходимостьВыгрузки;

КонецФункции

Функция СтруктураСведенийДляВыгрузки() Экспорт 
	
	СведенияДляВыгрузки = Новый Структура();
	СведенияДляВыгрузки.Вставить("Работники", Неопределено);
	СведенияДляВыгрузки.Вставить("ДокументыУдостоверяющиеЛичность", Неопределено);
	СведенияДляВыгрузки.Вставить("ЛичноеДело", Неопределено);
	СведенияДляВыгрузки.Вставить("ОбщееОбразование", Неопределено);
	СведенияДляВыгрузки.Вставить("ПрофессиональноеОбразование", Неопределено);
	СведенияДляВыгрузки.Вставить("ПослевузовскоеОбразование", Неопределено);
	СведенияДляВыгрузки.Вставить("ДополнительноеПрофессиональноеОбразование", Неопределено);
	СведенияДляВыгрузки.Вставить("Сертификаты", Неопределено);
	СведенияДляВыгрузки.Вставить("Награды", Неопределено);
	СведенияДляВыгрузки.Вставить("Квалификация", Неопределено);
	
	Возврат СведенияДляВыгрузки;
	
КонецФункции

Функция ДанныеДляВыгрузки(ДокументВыгрузки, УИНОрганизации, Работник) Экспорт 
	
	ДанныеДляВыгрузки = СтруктураСведенийДляВыгрузки();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведенияДляФРМР.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СведенияДляФРМР.ЯвляетсяМедработником КАК ЯвляетсяМедработником,
		|	СведенияДляФРМР.Фамилия КАК Фамилия,
		|	СведенияДляФРМР.Имя КАК Имя,
		|	СведенияДляФРМР.Отчество КАК Отчество,
		|	СведенияДляФРМР.Пол КАК Пол,
		|	СведенияДляФРМР.ДатаРождения КАК ДатаРождения,
		|	СведенияДляФРМР.СтраховойНомерПФР КАК СтраховойНомерПФР,
		|	СведенияДляФРМР.ИНН КАК ИНН,
		|	СведенияДляФРМР.ГражданствоКод КАК ГражданствоКод,
		|	СведенияДляФРМР.ГражданствоНаименование КАК ГражданствоНаименование,
		|	СведенияДляФРМР.НомерТелефона КАК НомерТелефона,
		|	СведенияДляФРМР.НомерТелефонаПредставление КАК НомерТелефонаПредставление,
		|	СведенияДляФРМР.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты,
		|	СведенияДляФРМР.АдресЭлектроннойПочтыПредставление КАК АдресЭлектроннойПочтыПредставление,
		|	СведенияДляФРМР.АдресПостояннойРегистрацииПредставление КАК АдресПостояннойРегистрацииПредставление,
		|	ЕСТЬNULL(ХарактеристикиОтношенийКВоеннойСлужбеПоМедРегистру.Код, """") КАК ОтношениеКВоинскойОбязанностиКод,
		|	ЕСТЬNULL(ХарактеристикиОтношенийКВоеннойСлужбеПоМедРегистру.НаименованиеПолное, """") КАК ОтношениеКВоинскойОбязанностиНаименование,
		|	ЕСТЬNULL(ХарактеристикиСтранПоМедРегистру.Код, """") КАК СтранаКод,
		|	ЕСТЬNULL(ХарактеристикиСтранПоМедРегистру.НаименованиеПолное, """") КАК СтранаНаименование,
		|	СведенияДляФРМР.АдресПостояннойРегистрации КАК АдресПостояннойРегистрации,
		|	СведенияДляФРМР.ДатаРегистрации КАК ДатаРегистрации,
		|	СведенияДляФРМР.АдресМестаПроживанияПредставление КАК АдресМестаПроживанияПредставление,
		|	СведенияДляФРМР.АдресМестаПроживания КАК АдресМестаПроживания,
		|	ЕСТЬNULL(ИдентификаторыРаботников.Идентификатор, """") КАК Идентификатор,
		|	ЕСТЬNULL(ИдентификаторыРаботников.МоментВыгрузки, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментВыгрузки,
		|	ЕСТЬNULL(ИдентификаторыРаботников.МоментИзменения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментИзменения,
		|	ЕСТЬNULL(ИдентификаторыРаботников.МоментУдаления, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментУдаления
		|ИЗ
		|	Документ.СведенияДляФРМР.Работники КАК СведенияДляФРМР
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров КАК ИдентификаторыРаботников
		|		ПО СведенияДляФРМР.ФизическоеЛицо = ИдентификаторыРаботников.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК ХарактеристикиСтранПоМедРегистру
		|		ПО СведенияДляФРМР.СтранаФРМР = ХарактеристикиСтранПоМедРегистру.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК ХарактеристикиОтношенийКВоеннойСлужбеПоМедРегистру
		|		ПО СведенияДляФРМР.ОтношениеКВоинскойОбязанностиФРМР = ХарактеристикиОтношенийКВоеннойСлужбеПоМедРегистру.Ссылка
		|ГДЕ
		|	СведенияДляФРМР.Ссылка = &ДокументСсылка
		|	И СведенияДляФРМР.ФизическоеЛицо = &ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведенияДляФРМР.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ЕСТЬNULL(ХарактеристикиВидовДокументовПоМедРегистру.Код, """") КАК ВидДокументаКод,
		|	ЕСТЬNULL(ХарактеристикиВидовДокументовПоМедРегистру.НаименованиеПолное, """") КАК ВидДокументаНаименование,
		|	СведенияДляФРМР.Серия КАК Серия,
		|	СведенияДляФРМР.Номер КАК Номер,
		|	СведенияДляФРМР.ДатаВыдачи КАК ДатаВыдачи,
		|	СведенияДляФРМР.КемВыдан КАК КемВыдан,
		|	СведенияДляФРМР.КодПодразделения КАК КодПодразделения
		|ИЗ
		|	Документ.СведенияДляФРМР.ДокументыУдостоверяющиеЛичность КАК СведенияДляФРМР
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК ХарактеристикиВидовДокументовПоМедРегистру
		|		ПО СведенияДляФРМР.ВидДокументаФРМР = ХарактеристикиВидовДокументовПоМедРегистру.Ссылка
		|ГДЕ
		|	СведенияДляФРМР.Ссылка = &ДокументСсылка
		|	И СведенияДляФРМР.ФизическоеЛицо = &ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведенияДляФРМР.ОбразованиеРаботника КАК ОбразованиеРаботника,
		|	ЕСТЬNULL(УчебныеЗаведения.Наименование, """") КАК ОбразовательнаяОрганизация,
		|	СведенияДляФРМР.СерияАттестата КАК СерияАттестата,
		|	СведенияДляФРМР.НомерАттестата КАК НомерАттестата,
		|	СведенияДляФРМР.ДатаВыдачиАттестата КАК ДатаВыдачиАттестата,
		|	ЕСТЬNULL(ИдентификаторыОбщихОбразований.Идентификатор, """") КАК Идентификатор,
		|	ЕСТЬNULL(ИдентификаторыОбщихОбразований.МоментВыгрузки, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментВыгрузки,
		|	ЕСТЬNULL(ИдентификаторыОбщихОбразований.МоментИзменения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментИзменения,
		|	ЕСТЬNULL(ИдентификаторыОбщихОбразований.МоментУдаления, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментУдаления
		|ИЗ
		|	Документ.СведенияДляФРМР.ОбщееОбразование КАК СведенияДляФРМР
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров КАК ИдентификаторыОбщихОбразований
		|		ПО СведенияДляФРМР.ОбразованиеРаботника = ИдентификаторыОбщихОбразований.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчебныеЗаведения КАК УчебныеЗаведения
		|		ПО СведенияДляФРМР.УчебноеЗаведение = УчебныеЗаведения.Ссылка
		|ГДЕ
		|	СведенияДляФРМР.Ссылка = &ДокументСсылка
		|	И СведенияДляФРМР.ФизическоеЛицо = &ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведенияДляФРМР.ОбразованиеРаботника КАК ОбразованиеРаботника,
		|	ЕСТЬNULL(УчебныеЗаведения.Наименование, """") КАК ОбразовательнаяОрганизация,
		|	ЕСТЬNULL(КлассификаторВидОбразованияФРМР.Код, """") КАК ВидОбразованияКод,
		|	ЕСТЬNULL(КлассификаторУчебноеЗаведениеФРМР.Код, """") КАК УчебноеЗаведениеКод,
		|	ЕСТЬNULL(КлассификаторСтранаМираФРМР.Код, """") КАК СтранаМираКод,
		|	ЕСТЬNULL(КлассификаторРеспубликаСССРФРМР.Код, """") КАК РеспубликаСССРКод,
		|	ЕСТЬNULL(КлассификаторСпециальностьФРМР.Код, """") КАК СпециальностьКод,
		|	ЕСТЬNULL(КлассификаторКвалификацияФРМР.Код, """") КАК КвалификацияКод,
		|	ЕСТЬNULL(КлассификаторЗаказчикЦелевогоОбученияФРМР.Код, """") КАК ЗаказчикЦелевогоОбученияКод,
		|	ЕСТЬNULL(КлассификаторПричинаРасторженияФРМР.Код, """") КАК ПричинаРасторженияКод,
		|	СведенияДляФРМР.Начало КАК Начало,
		|	СведенияДляФРМР.Окончание КАК Окончание,
		|	СведенияДляФРМР.ЗаПределамиРФ КАК ЗаПределамиРФ,
		|	СведенияДляФРМР.СерияДиплома КАК СерияДиплома,
		|	СведенияДляФРМР.НомерДиплома КАК НомерДиплома,
		|	СведенияДляФРМР.ДатаВыдачиДиплома КАК ДатаВыдачиДиплома,
		|	ЕСТЬNULL(ИдентификаторыПрофессиональныхОбразований.Идентификатор, """") КАК Идентификатор,
		|	ЕСТЬNULL(ИдентификаторыПрофессиональныхОбразований.МоментВыгрузки, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментВыгрузки,
		|	ЕСТЬNULL(ИдентификаторыПрофессиональныхОбразований.МоментИзменения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментИзменения,
		|	ЕСТЬNULL(ИдентификаторыПрофессиональныхОбразований.МоментУдаления, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК МоментУдаления
		|ИЗ
		|	Документ.СведенияДляФРМР.ПрофессиональноеОбразование КАК СведенияДляФРМР
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчебныеЗаведения КАК УчебныеЗаведения
		|		ПО СведенияДляФРМР.УчебноеЗаведение = УчебныеЗаведения.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров КАК ИдентификаторыПрофессиональныхОбразований
		|		ПО СведенияДляФРМР.ОбразованиеРаботника = ИдентификаторыПрофессиональныхОбразований.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторВидОбразованияФРМР
		|		ПО СведенияДляФРМР.ВидОбразованияФРМР = КлассификаторВидОбразованияФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторУчебноеЗаведениеФРМР
		|		ПО СведенияДляФРМР.УчебноеЗаведениеФРМР = КлассификаторУчебноеЗаведениеФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторСтранаМираФРМР
		|		ПО СведенияДляФРМР.СтранаМираФРМР = КлассификаторСтранаМираФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторРеспубликаСССРФРМР
		|		ПО СведенияДляФРМР.РеспубликаСССРФРМР = КлассификаторРеспубликаСССРФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторСпециальностьФРМР
		|		ПО СведенияДляФРМР.СпециальностьФРМР = КлассификаторСпециальностьФРМР.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК КлассификаторКвалификацияФРМР
		|		ПО СведенияДляФРМР.КвалификацияФРМР = КлассификаторКвалификацияФРМР.Ссылка
