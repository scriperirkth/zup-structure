Процедура ПодготовитьДанныеДляЗаполнения(Параметры, АдресХранилища) Экспорт	
		
	Организация 		= Параметры.Организация;
	ДатаАктуальности 	= Параметры.ДатаАктуальности;
	ДанныеДляЗаполнения = Параметры.ДанныеДляЗаполнения;
	СписокРаботников 	= Параметры.СписокРаботников;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	РегистрыСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров.СоздатьВТХарактеристикиОбъектовДляФедеральныхМедрегистров(МенеджерВременныхТаблиц);
	
	// Выявляем сотрудников, для которых будет выполняться заполнение документа.
	ПараметрыПолученияСотрудниковОрганизаций = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	Если СписокРаботников=Неопределено Или СписокРаботников.Количество()=0 Тогда
		ПараметрыПолученияСотрудниковОрганизаций.СписокФизическихЛиц = Неопределено;
	Иначе 
		ПараметрыПолученияСотрудниковОрганизаций.СписокФизическихЛиц = Новый ФиксированныйМассив(СписокРаботников);
	КонецЕсли;
	ПараметрыПолученияСотрудниковОрганизаций.Организация 					= Организация;
	ПараметрыПолученияСотрудниковОрганизаций.ОтбиратьПоГоловнойОрганизации 	= Ложь;
	ПараметрыПолученияСотрудниковОрганизаций.ОкончаниеПериода				= ДатаАктуальности;
	ПараметрыПолученияСотрудниковОрганизаций.РаботникиПоТрудовымДоговорам 	= Истина;
	ПараметрыПолученияСотрудниковОрганизаций.РаботникиПоДоговорамГПХ 		= Неопределено;
	ПараметрыПолученияСотрудниковОрганизаций.КадровыеДанные = "ДатаУвольнения,Должность";
	
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(МенеджерВременныхТаблиц, Истина, ПараметрыПолученияСотрудниковОрганизаций, "ВТСотрудникиОрганизацииДляФильтра");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	// Выбираем физические лица, которые ещё не уволены на дату выгрузки или уже выгружались раньше - чтобы выгрузить факт их увольнения.
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СотрудникиОрганизацииДляФильтра.ФизическоеЛицо КАК ФизическоеЛицо,
	|	СотрудникиОрганизацииДляФильтра.Период КАК Период,
	|	МАКСИМУМ(СвойстваДолжностейМедицинскихРаботников.ЯвляетсяМедицинскойДолжностью) КАК ЯвляетсяМедработником
	|ПОМЕСТИТЬ ВТРаботникиОрганизации
	|ИЗ
	|	ВТСотрудникиОрганизацииДляФильтра КАК СотрудникиОрганизацииДляФильтра
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвойстваДолжностейМедицинскихРаботников КАК СвойстваДолжностейМедицинскихРаботников
	|		ПО СотрудникиОрганизацииДляФильтра.Должность = СвойстваДолжностейМедицинскихРаботников.Должность
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров КАК ИдентификаторыОбъектовДляФедеральныхМедрегистров
	|		ПО СотрудникиОрганизацииДляФильтра.ФизическоеЛицо = ИдентификаторыОбъектовДляФедеральныхМедрегистров.Объект
	|ГДЕ
	|	(СотрудникиОрганизацииДляФильтра.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ СотрудникиОрганизацииДляФильтра.ДатаУвольнения >= НАЧАЛОПЕРИОДА(СотрудникиОрганизацииДляФильтра.Период, МЕСЯЦ)
	|			ИЛИ ИдентификаторыОбъектовДляФедеральныхМедрегистров.МоментВыгрузки > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|
	|СГРУППИРОВАТЬ ПО
	|	СотрудникиОрганизацииДляФильтра.ФизическоеЛицо,
	|	СотрудникиОрганизацииДляФильтра.Период";
	
	Запрос.Выполнить();
	
#Область ЛичноеДело

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	// Для получения данных ЛД требуется сотрудник, а не физическое лицо. Создадим таблицу сотрудников.
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сотрудники.Сотрудник КАК Сотрудник,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаНачала,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОкончания
	|ПОМЕСТИТЬ ВТСотрудники
	|ИЗ
	|	ВТСотрудникиОрганизацииДляФильтра КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТРаботникиОрганизации КАК РаботникиОрганизации
	|		ПО Сотрудники.Сотрудник.ФизическоеЛицо = РаботникиОрганизации.ФизическоеЛицо";
	
	Запрос.Выполнить();
	
	ПараметрыРеестра = КадровыйУчетРасширенный.ПараметрыПостроенияВТРеестрКадровыхПриказовПоВременнойТаблице();
	ПараметрыРеестра.ИмяВТОтборовСотрудников = "ВТСотрудники";
	
	ПараметрыРеестра.ВключатьСобытияИзменениеОплатыТруда = Ложь;
	ПараметрыРеестра.ВключатьСобытияУвольнений = Истина;
	КадровыйУчетРасширенный.СоздатьВТРеестрКадровыхПриказов(МенеджерВременныхТаблиц, Истина, ПараметрыРеестра, "ВТДанныеИзРеестра");
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(КадроваяИсторияСотрудников.Период) КАК Период,
	|	ДанныеИзРеестра.Сотрудник КАК Сотрудник,
	|	ДанныеИзРеестра.Период КАК Дата
	|ПОМЕСТИТЬ ВТМаксимальныеПериодыКадровойИстории
	|ИЗ
	|	ВТДанныеИзРеестра КАК ДанныеИзРеестра
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников КАК КадроваяИсторияСотрудников
	|		ПО ДанныеИзРеестра.Период <= КадроваяИсторияСотрудников.Период
	|			И ДанныеИзРеестра.Сотрудник = КадроваяИсторияСотрудников.Сотрудник
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеИзРеестра.Сотрудник,
	|	ДанныеИзРеестра.Период";
	
	Запрос.Выполнить();
	
	ЗарплатаКадрыОбщиеНаборыДанных.СоздатьВТИмяРегистраСрезПоследних(
		"КадроваяИсторияСотрудников",
		МенеджерВременныхТаблиц,
		Истина,
		ЗарплатаКадрыОбщиеНаборыДанных.ОписаниеФильтраДляСоздатьВТИмяРегистра(
			"ВТМаксимальныеПериодыКадровойИстории", "Сотрудник"));
	
	ЗарплатаКадрыОбщиеНаборыДанных.СоздатьВТИмяРегистраСрезПоследних(
		"ВидыЗанятостиСотрудников",
		МенеджерВременныхТаблиц,
		Истина,
