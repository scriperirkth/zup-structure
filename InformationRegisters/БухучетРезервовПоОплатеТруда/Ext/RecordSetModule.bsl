
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект[0], ДанныеЗаполнения);
		
		ДанныеЗаполненияОрганизация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Организация");
		Если ТипЗнч(ДанныеЗаполненияОрганизация) = Тип("СписокЗначений") Тогда
			Для Каждого СтрокаСписка Из ДанныеЗаполненияОрганизация Цикл
				Если ЗначениеЗаполнено(СтрокаСписка.Значение) Тогда
					ЭтотОбъект[0].Организация = СтрокаСписка.Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ДанныеЗаполненияРезерв = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Резерв");
		Если ТипЗнч(ДанныеЗаполненияРезерв) = Тип("СписокЗначений") Тогда
			Для Каждого СтрокаСписка Из ДанныеЗаполненияРезерв Цикл
				Если ЗначениеЗаполнено(СтрокаСписка.Значение) Тогда
					ЭтотОбъект[0].Резерв = СтрокаСписка.Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСтатьиФинансированияЗарплата") Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "СтатьяФинансированияЗарплаты");
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "СтатьяФинансированияРезервовПоОплатеТруда");
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "СпособОтраженияЗарплатыВБухучете");
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "СпособОтраженияРезервовПоОплатеТрудаВБухучете");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если Количество() = 0 Или РегистрыБЗК.ЭтоУдалениеНабораЗаписей(Замещение) Тогда
		Возврат;
	КонецЕсли;
	
	Если РегистрыБЗК.ЭтоЗамещениеНабораЗаписей(Замещение) Тогда
		Если РегистрыСведений.БухучетРезервовПоОплатеТруда.НайденЗапретИзмененияДанных(Мин(ЭтотОбъект[0].Период, ЭтотОбъект[0].ДатаЗапрета)) Тогда
			Если ЗначениеЗаполнено(ЭтотОбъект[0].ДатаОкончания) Тогда
				Если РегистрыСведений.БухучетРезервовПоОплатеТруда.НайденЗапретИзмененияДанных(ЭтотОбъект[0].ДатаОкончания) Тогда
					Возврат;
				КонецЕсли;
			ИначеЕсли ЭтотОбъект[0].Период = ЭтотОбъект[0].ДатаЗапрета Тогда
				Возврат;
			КонецЕсли;
			ЭтотОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		ПараметрыВычисленияВеса = РегистрыСведений.БухучетРезервовПоОплатеТруда.ПараметрыВычисленияВеса();
		ЗаполнитьЗначенияСвойств(ПараметрыВычисленияВеса, Запись);
		Запись.Вес = РегистрыСведений.БухучетРезервовПоОплатеТруда.ВесВсехПоказателей(ПараметрыВычисленияВеса);
		Запись.Приоритет = РегистрыСведений.БухучетРезервовПоОплатеТруда.Приоритет(Запись.Вес);
		Запись.ДатаЗапрета = ?(ЗначениеЗаполнено(Запись.ДатаОкончания) И Запись.ДатаОкончания > Запись.Период, Запись.ДатаОкончания, Запись.Период);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

