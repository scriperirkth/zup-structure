Функция ПараметрыВычисленияВеса() Экспорт
	
	ПараметрыВычисленияВеса = Новый Структура;
	ПараметрыВычисленияВеса.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыВычисленияВеса.Вставить("Резерв", Справочники.Резервы.ПустаяСсылка());
	ПараметрыВычисленияВеса.Вставить("Подразделение", Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
	ПараметрыВычисленияВеса.Вставить("СпособОтраженияЗарплатыВБухучете", Справочники.СпособыОтраженияЗарплатыВБухУчете.ПустаяСсылка());
	ПараметрыВычисленияВеса.Вставить("СтатьяФинансированияЗарплаты", Справочники.СтатьиФинансированияЗарплата.ПустаяСсылка());
	
	Возврат ПараметрыВычисленияВеса;
	
КонецФункции

Функция ВесВсехПоказателей(ПараметрыВычисленияВеса) Экспорт
	
	ВесПоказателей = 
	?(ЗначениеЗаполнено(ПараметрыВычисленияВеса.Организация), ВесПоляОрганизация(), 0)
	+ ?(ЗначениеЗаполнено(ПараметрыВычисленияВеса.Резерв), ВесПоляРезерв(), 0)
	+ ?(ЗначениеЗаполнено(ПараметрыВычисленияВеса.Подразделение), ВесПоляПодразделение(), 0)
	+ ?(ЗначениеЗаполнено(ПараметрыВычисленияВеса.СпособОтраженияЗарплатыВБухучете), ВесПоляСпособОтражения(), 0)
	+ ?(ЗначениеЗаполнено(ПараметрыВычисленияВеса.СтатьяФинансированияЗарплаты), ВесПоляСтатьяФинансирования(), 0);
	
	Возврат ВесПоказателей;
	
КонецФункции

Функция ВесПоляОрганизация() Экспорт
	Возврат 5;
КонецФункции

Функция ВесПоляРезерв() Экспорт
	Возврат 7;
КонецФункции

Функция ВесПоляПодразделение() Экспорт
	Возврат 11;
КонецФункции

Функция ВесПоляСтатьяФинансирования() Экспорт
	Возврат 19;
КонецФункции

Функция ВесПоляСпособОтражения() Экспорт
	Возврат 27;
КонецФункции

Функция Приоритет(Вес) Экспорт
	
	ТаблицаКомбинаций = ТаблицаКомбинацийВесаПриоритетаПолейОтбора();
	СтрокаТаблицы = ТаблицаКомбинаций.Найти(Вес, "Вес");
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат 100;
	Иначе
		Возврат СтрокаТаблицы.Приоритет;
	КонецЕсли;
	
КонецФункции

Функция ТаблицаКомбинацийВесаПриоритетаПолейОтбора() Экспорт
	
	// Вес складывается исходя из принципа:
	//  - заполнена организация = 5
	//  - заполнен резерв = 7
	//  - заполнено подразделение = 11
	//  - заполнена статья финансирования = 19
	//  - заполнен способ отражения = 27
	// Все значения суммируются. Сумма значений уникальна и задает комбинацию заполненных полей.
	// Все поля заполнены = 69 (max), все пустые = 0 (min)
	// В подсистеме обычно организация и резервы в ТЧ опускаются, поэтому в полях отбора также опускаем.
	
	
	ТаблицаКомбинаций = Новый ТаблицаЗначений;
	ТаблицаКомбинаций.Колонки.Добавить("ПоляОтбора", Новый ОписаниеТипов("Строка"));
	ТаблицаКомбинаций.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	ТаблицаКомбинаций.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
	
	// "Организация, Резерв, Подразделение, СтатьяФинансирования, СпособОтраженияЗарплатыВБухучете"
	НоваяСтрока = ТаблицаКомбинаций.Добавить();
	НоваяСтрока.Приоритет = 1;
	НоваяСтрока.Вес = ВесПоляОрганизация() + ВесПоляРезерв() + ВесПоляПодразделение() + ВесПоляСтатьяФинансирования() + ВесПоляСпособОтражения();
	НоваяСтрока.ПоляОтбора = "Подразделение, СтатьяФинансирования, СпособОтраженияЗарплатыВБухучете";
	
	// "Организация, Резерв, Подразделение, СтатьяФинансирования"
