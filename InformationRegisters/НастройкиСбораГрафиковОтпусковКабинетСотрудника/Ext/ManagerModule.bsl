// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция Настройки() Экспорт
	
	Настройки = РегистрыСведений.НастройкиСбораГрафиковОтпусковКабинетСотрудника.СоздатьМенеджерЗаписи();
	Настройки.Прочитать();
	
	СтруктураНастроек = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(
							Настройки, Метаданные.РегистрыСведений.НастройкиСбораГрафиковОтпусковКабинетСотрудника);
							
	СтруктураНастроек.Вставить("ПланированиеОтпусковПоНорме", 		Истина);
	СтруктураНастроек.Вставить("КомпенсацияДополнительныхОтпусков", Ложь);
	СтруктураНастроек.Вставить("ПроверятьПланирование14ДнейОтпуска", Ложь);
	Если Не ЗначениеЗаполнено(СтруктураНастроек.СхемаПредставленияПодразделений) Тогда
		СтруктураНастроек.СхемаПредставленияПодразделений = Перечисления.СхемыПредставленияПодразделенийСбораГрафиковОтпусков.НепосредственныеПодчиненные;
	КонецЕсли;
	
	Возврат СтруктураНастроек;

КонецФункции

// Сохранить новые настройки.
// 
// Параметры:
//  СохраняемыеНастройки - см. ОписаниеНастроек
Процедура СохранитьНовыеНастройки(СохраняемыеНастройки, Источник = Неопределено) Экспорт

	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СохраняемыеНастройки);
	Иначе
		ЗаполнитьЗначенияСвойств(НаборЗаписей[0], СохраняемыеНастройки);
	КонецЕсли;
	НаборЗаписей.Записать();
	
	ИнтеграцияУправлениеПерсоналомСобытияРасширенный.ПриЗаписиНастроекСбораГрафиковОтпусков(Источник);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
