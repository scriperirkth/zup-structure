#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьДатыПоСостояниям(Замещение);
	
	СохранитьПрежнееСостояние(Замещение);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если Количество() = 0 Или РегистрыБЗК.ЭтоУдалениеНабораЗаписей(Замещение) Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьПовторСостояния(Замещение);
	
	ИзменитьСостояниеСогласования(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПовторСостояния(Замещение)
	
	// Не разрешаем установить состояние, если вакансия на дату установки уже находится в этом состоянии
	Вакансии = РегистрыБЗК.ЗначенияОтбораЗаписейНабора(ЭтотОбъект, Замещение, "Вакансия", Истина);
	Если Вакансии = Неопределено Или Вакансии.Количество() = 0 Тогда
		Возврат; // Не используем проверку в режиме записи набора целиком.
	КонецЕсли;
	
	// Проверка выполняется, фактически разрешая записать набор, 
	// и затем проверяет консистентность получившегося состояния в ИБ на предмет повторяющихся состояний.
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Вакансии", Вакансии);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияВакансий.Вакансия КАК Вакансия,
		|	СостоянияВакансий.Состояние КАК Состояние,
		|	СостоянияВакансий.Период КАК Период
		|ИЗ
		|	РегистрСведений.СостоянияВакансий КАК СостоянияВакансий
		|ГДЕ
		|	СостоянияВакансий.Вакансия В (&Вакансии)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СостоянияВакансий.Период";

	УстановитьПривилегированныйРежим(Истина);
	СостоянияВакансий = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);

	Для Каждого Вакансия Из Вакансии Цикл
		Состояния = СостоянияВакансий.Скопировать(Новый Структура("Вакансия", Вакансия));
		РегистрыСведений.СостоянияВакансий.ПроверитьСостояния(Состояния, Вакансия);
	КонецЦикла;
	

КонецПроцедуры

Процедура СохранитьПрежнееСостояние(Замещение)
	
	Вакансии = РегистрыБЗК.ЗначенияОтбораЗаписейНабора(ЭтотОбъект, Замещение, "Вакансия", Истина);
	Если Вакансии = Неопределено Или Вакансии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ПрежниеДанныеСостояния", 
		РегистрыСведений.СостоянияВакансий.ТекущееСостояниеВакансий(Вакансии));
	
	РегистрыСведений.СостоянияВакансий.СохранитьПрежнийНаборЗаписей(ЭтотОбъект, Замещение);
	
КонецПроцедуры

Процедура ИзменитьСостояниеСогласования(НаборЗаписей)
	
	Если Не ДополнительныеСвойства.Свойство("ПрежниеДанныеСостояния") Тогда
		Возврат;
	КонецЕсли;

	ПрежниеДанные = ДополнительныеСвойства["ПрежниеДанныеСостояния"];
	
	ВакансииМассив = Новый Массив;
	ВакансииМассив.Добавить(Отбор.Вакансия.Значение);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВакансииМассив, 
		ОбщегоНазначения.ВыгрузитьКолонку(ПрежниеДанные, "Ключ"), Истина);
	
	ТекущиеДанные = РегистрыСведений.СостоянияВакансий.ТекущееСостояниеВакансий(ВакансииМассив);
	
	// Если у каких-то вакансий состояние изменилось, появилось или исчезло, 
	// уточняем состояние согласования по текущему состоянию.
	
	ДанныеВакансий = Справочники.Вакансии.ДанныеВакансий(ВакансииМассив);
	ОбщегоНазначенияБЗК.ДобавитьИндексКоллекции(ДанныеВакансий, "Вакансия");
	
	Для Каждого Вакансия Из ВакансииМассив Цикл
		НайденныеСтроки = ДанныеВакансий.НайтиСтроки(Новый Структура("Вакансия", Вакансия));
		Если НайденныеСтроки.Количество() = 0 Или ЗначениеЗаполнено(НайденныеСтроки[0].Основание) Тогда
			// Вакансия создана на основании заявки, отдельно не согласовывается.
			Продолжить;
		КонецЕсли;
		ПрежнееСостояние = СвойствоСтруктуры(ПрежниеДанные.Получить(Вакансия), "Состояние");
		ТекущееСостояние = СвойствоСтруктуры(ТекущиеДанные.Получить(Вакансия), "Состояние");
		СостояниеСогласования = СвойствоСтруктуры(СогласованиеВакансий.ДанныеСогласования(Вакансия), "СостояниеСогласования");
		Если Перечисления.СостоянияСогласования.РешениеПринято(СостояниеСогласования) Тогда
			// Решение принято, не трогаем эту вакансию.
			Продолжить;
		КонецЕсли;
		Если ПрежнееСостояние = ТекущееСостояние Тогда
			// Состояние не изменилось.
			Продолжить;
		КонецЕсли;
		Если ПрежнееСостояние = Перечисления.СостоянияВакансии.Открыта 
			И ТекущееСостояние <> Перечисления.СостоянияВакансии.Открыта Тогда
			// Отзываем с согласования.
			Если СостояниеСогласования <> Перечисления.СостоянияСогласования.ПустаяСсылка() Тогда
				СогласованиеВакансий.УстановитьСостояниеСогласования(
					Вакансия, Перечисления.СостоянияСогласования.ПустаяСсылка());
			КонецЕсли;
		КонецЕсли;
		Если ПрежнееСостояние <> Перечисления.СостоянияВакансии.Открыта 
			И ТекущееСостояние = Перечисления.СостоянияВакансии.Открыта Тогда
			// Направляем на согласование.
			Если СостояниеСогласования <> Перечисления.СостоянияСогласования.Рассматривается Тогда
				СогласованиеВакансий.УстановитьСостояниеСогласования(
					Вакансия, Перечисления.СостоянияСогласования.Рассматривается);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СвойствоСтруктуры(Структура, Ключ)
	Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Структура, Ключ);
КонецФункции

Процедура УстановитьДатыПоСостояниям(Замещение)
	Если Количество() = 0 Или РегистрыБЗК.ЭтоУдалениеНабораЗаписей(Замещение) Тогда
		Возврат;
	КонецЕсли;
	
	Если РегистрыБЗК.ЭтоЗамещениеНабораЗаписей(Замещение) Тогда
		// В остальных режимах замещения используются все отборы.
		Если Не Отбор.Вакансия.Использование Тогда
			Текст = НСтр("ru = 'В наборе состояний вакансии не установлен отбор по вакансии.'");
			ОбщегоНазначенияКлиентСервер.Проверить(Ложь, Текст);
		КонецЕсли;
		Если Отбор.Период.Использование Тогда
			Текст = НСтр("ru = 'В наборе состояний вакансии избыточно установлен отбор по периоду.'");
			ОбщегоНазначенияКлиентСервер.Проверить(Ложь, Текст);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаСостояния Из ЭтотОбъект Цикл
		СтрокаСостояния.Период = ПодборПерсоналаКлиентСервер.ДатаВремяПоСостоянию(
			СтрокаСостояния.Период, СтрокаСостояния.Состояние);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли