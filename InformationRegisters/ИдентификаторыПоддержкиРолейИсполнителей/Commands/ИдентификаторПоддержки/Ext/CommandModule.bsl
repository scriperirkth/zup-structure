
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	КлючЗаписи = КлючЗаписиРегистра(ПараметрКоманды);
	
	Если КлючЗаписи <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("Ключ", КлючЗаписи);
	Иначе
		ПараметрыФормы = Новый Структура("РольИсполнителя", ПараметрКоманды);
	КонецЕсли;
	
	ОткрытьФорму(
		"РегистрСведений.ИдентификаторыПоддержкиРолейИсполнителей.Форма.ФормаЗаписиКонтекстная",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно);
	
КонецПроцедуры

&НаСервере
Функция КлючЗаписиРегистра(РольИсполнителя)
	
	МенеджерЗаписи = РегистрыСведений.ИдентификаторыПоддержкиРолейИсполнителей.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.РольИсполнителя = РольИсполнителя;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат РегистрыСведений.ИдентификаторыПоддержкиРолейИсполнителей.СоздатьКлючЗаписи(
			Новый Структура("РольИсполнителя", РольИсполнителя));
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

