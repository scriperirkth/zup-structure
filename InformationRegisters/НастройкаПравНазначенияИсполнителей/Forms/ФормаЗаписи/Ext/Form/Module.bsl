#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	НазначающийИсполнителейПредставление = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(Запись.НазначающийИсполнителей,
																									Запись.ОсновнойОбъектАдресацииНазначающего,
																									Запись.ДополнительныйОбъектАдресацииНазначающего);
	
	РольИсполнителяПредставление = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(Запись.РольИсполнителя,
																							Запись.ОсновнойОбъектАдресацииИсполнителя,
																							Запись.ДополнительныйОбъектАдресацииИсполнителя);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ОсновнойОбъектАдресацииНазначающего) Тогда
		ТекущийОбъект.ОсновнойОбъектАдресацииНазначающего = Неопределено;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ДополнительныйОбъектАдресацииНазначающего) Тогда
		ТекущийОбъект.ДополнительныйОбъектАдресацииНазначающего = Неопределено;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ОсновнойОбъектАдресацииИсполнителя) Тогда
		ТекущийОбъект.ОсновнойОбъектАдресацииИсполнителя = Неопределено;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ДополнительныйОбъектАдресацииИсполнителя) Тогда
		ТекущийОбъект.ДополнительныйОбъектАдресацииИсполнителя = Неопределено;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НазначающийИсполнителейНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПроцессыОбработкиДокументовКлиент.ВыбратьИсполнителя(Элемент, Запись.НазначающийИсполнителей, , Ложь, "Выбор назначающего");
	
КонецПроцедуры

&НаКлиенте
Процедура РольИсполнителяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПроцессыОбработкиДокументовКлиент.ВыбратьИсполнителя(Элемент, Запись.РольИсполнителя, Истина, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура НазначающийИсполнителейОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Модифицированность = Истина;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Запись.НазначающийИсполнителей = ВыбранноеЗначение.РольИсполнителя;
		Запись.ОсновнойОбъектАдресацииНазначающего = ВыбранноеЗначение.ОсновнойОбъектАдресации;
		Запись.ДополнительныйОбъектАдресацииНазначающего = ВыбранноеЗначение.ДополнительныйОбъектАдресации;
	Иначе
		Запись.НазначающийИсполнителей = ВыбранноеЗначение;
		Запись.ОсновнойОбъектАдресацииНазначающего = "";
		Запись.ДополнительныйОбъектАдресацииНазначающего = "";
	КонецЕсли;
	
	ВыбранноеЗначение = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(Запись.НазначающийИсполнителей,
																									Запись.ОсновнойОбъектАдресацииНазначающего,
																									Запись.ДополнительныйОбъектАдресацииНазначающего);
	
КонецПроцедуры

&НаКлиенте
Процедура РольИсполнителяОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Модифицированность = Истина;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Запись.РольИсполнителя = ВыбранноеЗначение.РольИсполнителя;
		Запись.ОсновнойОбъектАдресацииИсполнителя = ВыбранноеЗначение.ОсновнойОбъектАдресации;
		Запись.ДополнительныйОбъектАдресацииИсполнителя = ВыбранноеЗначение.ДополнительныйОбъектАдресации;
	Иначе
		Запись.НазначающийИсполнителей = ВыбранноеЗначение;
		Запись.ОсновнойОбъектАдресацииИсполнителя = "";
		Запись.ДополнительныйОбъектАдресацииИсполнителя = "";
	КонецЕсли;
	
	ВыбранноеЗначение = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(Запись.РольИсполнителя,
																							Запись.ОсновнойОбъектАдресацииИсполнителя,
																							Запись.ДополнительныйОбъектАдресацииИсполнителя);
	
КонецПроцедуры

&НаКлиенте
Процедура НазначающийИсполнителейОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, Запись.НазначающийИсполнителей);
КонецПроцедуры

&НаКлиенте
Процедура РольИсполнителяОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, Запись.РольИсполнителя);
КонецПроцедуры

&НаКлиенте
Процедура НазначающийИсполнителейОчистка(Элемент, СтандартнаяОбработка)
	
	Модифицированность = Истина;
	
	Запись.НазначающийИсполнителей = "";
	Запись.ОсновнойОбъектАдресацииНазначающего = "";
	Запись.ДополнительныйОбъектАдресацииНазначающего = "";
	
КонецПроцедуры

&НаКлиенте
Процедура РольИсполнителяОчистка(Элемент, СтандартнаяОбработка)
	
	Модифицированность = Истина;
	
	Запись.РольИсполнителя = "";
	Запись.ОсновнойОбъектАдресацииИсполнителя = "";
	Запись.ДополнительныйОбъектАдресацииИсполнителя = "";
	
КонецПроцедуры

#КонецОбласти
