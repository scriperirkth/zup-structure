#Область ПрограммныйИнтерфейс

// Добавляет указанный объект в очередь.
//
// Параметры:
//  Объект - ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА - ссылка на прикладной объект,
//    который необходимо записать в очередь.
//  ДопСведения - Строка - дополнительные сведения об операции.
//  ДатаВремя - Дата - необязательный. Используется для сортировки при обработке очереди.
//
Процедура Добавить(Объект, ДопСведения, ДатаВремя = Неопределено) Экспорт
	
	Если ДатаВремя = Неопределено Тогда
		ДатаВремя = ТекущаяДатаСеанса();
		ДатаВМиллиСекундах = ТекущаяДатаВМиллисекундах();
	Иначе
		ДатаВМиллисекундах = ДатаВМиллисекундах(ДатаВремя);
	КонецЕсли;
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Объект;
	МенеджерЗаписи.ДопСведения = ДопСведения;
	МенеджерЗаписи.Дата = ДатаВремя;
	МенеджерЗаписи.ДатаВМиллиСекундах = ДатаВМиллиСекундах;
	
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры

// Удаляет указанный объект из очереди.
//
// Параметры:
//  Объект - ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА - документ, который необходимо удалить из очереди.
//  ДопСведения - Строка - будет удалена запись с этим значением измерения ДопСведения.
//
Процедура Удалить(Объект, ДопСведения) Экспорт
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Объект);
	НаборЗаписей.Отбор.ДопСведения.Установить(ДопСведения);
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Обновляет порцию объектов из очереди.
//
// Параметры:
//  РазмерПорции - Число - количество записей, которые необходимо обработать.
//
// Возвращаемое значение:
//  Число - количество обработанных записей очереди.
//
Функция ОбработатьПорцию(РазмерПорции = 10) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ %1
		|	ОчередьОперацийСДокументамиДля1САрхива.Объект КАК Объект,
		|	ОчередьОперацийСДокументамиДля1САрхива.ДопСведения КАК ДопСведения
		|ИЗ
		|	РегистрСведений.ОчередьОперацийСДокументамиДля1САрхива КАК ОчередьОперацийСДокументамиДля1САрхива
		|ГДЕ
		|	ОчередьОперацийСДокументамиДля1САрхива.КоличествоПопытокОбработки < &ЛимитПопыток
		|	И ОчередьОперацийСДокументамиДля1САрхива.Дата < &ТекущаяДата
		|	И ОчередьОперацийСДокументамиДля1САрхива.ДатаСледующейПопытки < &ТекущаяДата
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОчередьОперацийСДокументамиДля1САрхива.Дата,
		|	ОчередьОперацийСДокументамиДля1САрхива.ДатаВМиллиСекундах,
		|	ОчередьОперацийСДокументамиДля1САрхива.Объект,
		|	ОчередьОперацийСДокументамиДля1САрхива.ДопСведения";
	
	Запрос.УстановитьПараметр("ЛимитПопыток", ЛимитПопытокОбработки());
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%1", Формат(РазмерПорции, "ЧГ=0"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Количество = Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		ОбработатьЭлементОчереди(Выборка.Объект, Выборка.ДопСведения);
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции	

// Очищает всю очередь - удаляет все записи.
// 
Процедура Очистить() Экспорт
	
	Набор = СоздатьНаборЗаписей();
	Набор.Записать();
	
КонецПроцедуры

// Возвращает размер очереди.
// 
// Возвращаемое значение:
//	Число - количество записей очереди.
//	 
Функция РазмерОчереди() Экспорт
	
	РазмерОчереди = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК ЧислоЗаписей
		|ИЗ
		|	РегистрСведений.ОчередьОперацийСДокументамиДля1САрхива КАК ОчередьОперацийСДокументамиДля1САрхива";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РазмерОчереди = Выборка.ЧислоЗаписей;
	КонецЕсли;
	
	Возврат РазмерОчереди;
	
КонецФункции

// Возвращает имя операции для удаления данных документов, принятых в 1С:Архив.
// 
// Возвращаемое значение:
//	Строка - имя операции.
//
Функция ИмяОперацииУдаленияДанныхПринятогоОбъекта() Экспорт
	
	Возврат "УдалитьДанныеОбъектаПринятогоВАрхив";	
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЛимитПопытокОбработки()
	
	Возврат 3;
	
КонецФункции

// Обрабатывает операцию по указанному элементу и удаляет его из очереди.
// 
Процедура ОбработатьЭлементОчереди(Ссылка, ДопСведения)
	
	ОписаниеОшибки = "";
	
	Попытка 
		Если ДопСведения = ИмяОперацииУдаленияДанныхПринятогоОбъекта() Тогда
			ДокументыДляОбработки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка);
			ОбменСАрхивом.УдалитьДанныеДокументовПринятыхВАрхив(ДокументыДляОбработки, Истина);		
		КонецЕсли;
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Очередь операций с документами для 1С:Архива'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Ссылка.Метаданные(),
			Ссылка,
			ОписаниеОшибки);
		ЗафиксироватьНеудачнуюПопыткуОбработки(Ссылка, ДопСведения, ОписаниеОшибки);
		Возврат;
	КонецПопытки;
	
	Удалить(Ссылка, ДопСведения);
	
КонецПроцедуры	

Процедура ЗафиксироватьНеудачнуюПопыткуОбработки(Ссылка, ДопСведения, ТекстОшибки)
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Ссылка;
	МенеджерЗаписи.ДопСведения = ДопСведения;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.КоличествоПопытокОбработки = МенеджерЗаписи.КоличествоПопытокОбработки + 1;
		Если МенеджерЗаписи.КоличествоПопытокОбработки < ЛимитПопытокОбработки() Тогда
			МенеджерЗаписи.ДатаСледующейПопытки = ТекущаяДатаСеанса() + 60;
		КонецЕсли;
		МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ТекущаяДатаВМиллисекундах()
	
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах()
		+ (ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата()) * 1000;
	
КонецФункции

Функция ДатаВМиллисекундах(ДатаВремя)
	
	ПустаяДата = Дата('00010101000000');
	Результат = (ДатаВремя - ПустаяДата) * 1000;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
