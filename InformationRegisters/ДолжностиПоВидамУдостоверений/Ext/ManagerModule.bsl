Функция СписокДолжностейПоВидуУдостоверения(ВидУдостоверения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидУдостоверения", ВидУдостоверения);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДолжностиПоВидамУдостоверений.ВидУдостоверения КАК ВидУдостоверения,
		|	ДолжностиПоВидамУдостоверений.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.ДолжностиПоВидамУдостоверений КАК ДолжностиПоВидамУдостоверений
		|ГДЕ
		|	ДолжностиПоВидамУдостоверений.ВидУдостоверения = &ВидУдостоверения";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаписатьДолжностиПоВидамУдостоверений(ВидУдостоверения, ДолжностиПоВидамУдостоверений) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидУдостоверения) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВидУдостоверения.Установить(ВидУдостоверения);
	
	НаборЗаписей.Загрузить(ДолжностиПоВидамУдостоверений);
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли