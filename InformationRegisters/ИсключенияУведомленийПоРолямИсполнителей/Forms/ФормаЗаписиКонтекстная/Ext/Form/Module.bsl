#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("РольИсполнителя") Тогда
		Запись.РольИсполнителя = Параметры.РольИсполнителя;
	КонецЕсли;
	
	Если Параметры.Свойство("ОтключитьУведомления") Тогда
		ОтключитьУведомления = Параметры.ОтключитьУведомления;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ОтключитьУведомления = Ложь Тогда
		Отказ = Истина;
		ТекущийОбъект.Удалить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтключитьУведомленияПриИзменении(Элемент)
	
	ВыполитьЗаписьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполитьЗаписьНаСервере()
	
	ЗаписьОбъект = РеквизитФормыВЗначение("Запись");
	ЗаписьОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти
