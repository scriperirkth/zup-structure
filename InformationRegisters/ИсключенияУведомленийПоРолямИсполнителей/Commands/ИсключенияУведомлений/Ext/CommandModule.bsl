
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = Новый Структура("РольИсполнителя", ПараметрКоманды);
	
	КлючЗаписи = КлючЗаписиРегистра(ПараметрКоманды);
	Если КлючЗаписи <> Неопределено Тогда
		ПараметрыФормы.Вставить("ОтключитьУведомления", Истина);
	КонецЕсли;
	
	ОткрытьФорму(
		"РегистрСведений.ИсключенияУведомленийПоРолямИсполнителей.Форма.ФормаЗаписиКонтекстная",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно);
	
КонецПроцедуры

&НаСервере
Функция КлючЗаписиРегистра(РольИсполнителя)
	
	МенеджерЗаписи = РегистрыСведений.ИсключенияУведомленийПоРолямИсполнителей.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.РольИсполнителя = РольИсполнителя;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат РегистрыСведений.ИдентификаторыПоддержкиРолейИсполнителей.СоздатьКлючЗаписи(
			Новый Структура("РольИсполнителя", РольИсполнителя));
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

