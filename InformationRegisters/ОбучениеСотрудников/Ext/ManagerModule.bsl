#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ОбновитьДанныеРегистра");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиПравилРегистрации

// См. ЗарплатаКадрыРасширенныйСинхронизацияДанных.ШаблонОбработчика
Процедура ПриЗаполненииНастроекОбработчиковПравилРегистрации(Настройки) Экспорт
	ЗарплатаКадрыРасширенныйСинхронизацияДанных.ДляРегистраПодчиненногоРегистратору(Настройки);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ОбновитьДанныеРегистра(ПараметрыОбновления = Неопределено) Экспорт
	
	Если ПараметрыОбновления.Свойство("ОбработанныеРегистраторы") Тогда
		ОбработанныеРегистраторы = ПараметрыОбновления.ОбработанныеРегистраторы;
	Иначе
		ОбработанныеРегистраторы = Новый Массив;
		ПараметрыОбновления.Вставить("ОбработанныеРегистраторы", ОбработанныеРегистраторы);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	ВЫРАЗИТЬ(ОбучениеСотрудников.Регистратор КАК Документ.ОбучениеРазвитиеСотрудников) КАК Регистратор,
	|	ВЫРАЗИТЬ(ОбучениеСотрудников.Регистратор КАК Документ.ОбучениеРазвитиеСотрудников).Преподаватель.ФизическоеЛицо КАК Преподаватель
	|ИЗ
	|	РегистрСведений.ОбучениеСотрудников КАК ОбучениеСотрудников
	|ГДЕ
	|	ОбучениеСотрудников.Преподаватель <> ВЫРАЗИТЬ(ОбучениеСотрудников.Регистратор КАК Документ.ОбучениеРазвитиеСотрудников).Преподаватель.ФизическоеЛицо
	|	И ОбучениеСотрудников.Мероприятие.СпособПроведения = &СпособПроведения
	|	И НЕ ОбучениеСотрудников.Регистратор В (&ОбработанныеРегистраторы)";
	
	Запрос.УстановитьПараметр("СпособПроведения", Перечисления.СпособыПроведенияМероприятийОбученияРазвития.ВнутреннееМероприятие);
	Запрос.УстановитьПараметр("ОбработанныеРегистраторы", ОбработанныеРегистраторы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
	
	МассивРегистраторов = Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(
			ПараметрыОбновления, "РегистрСведений.ОбучениеСотрудников.НаборЗаписей", "Регистратор", Выборка.Регистратор) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивРегистраторов.Добавить(Выборка.Регистратор);
		
		НаборЗаписей = РегистрыСведений.ОбучениеСотрудников.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись Из НаборЗаписей Цикл
			Запись.Преподаватель = Выборка.Преподаватель;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления); 
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыОбновления.ОбработанныеРегистраторы, МассивРегистраторов);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли