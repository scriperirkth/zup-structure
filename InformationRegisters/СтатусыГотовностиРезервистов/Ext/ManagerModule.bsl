Процедура ПриЗаполненииНастроекОбработчиковПравилРегистрации(Настройки) Экспорт
	ЗарплатаКадрыРасширенныйСинхронизацияДанных.ДляРегистраПодчиненногоРегистратору(Настройки);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОбновления

// Выполняет первоначальное заполнение при обновлении.
// Данные переносятся из регистра УдалитьСтатусыГотовностиРезервистов.
// Измерение УчастникКадровогоРезерва заполняется данными из измерения ФизическоеЛицо.
// 
// Параметры:
//  ПараметрыОбновления - Структура
Процедура ВыполнитьПервоначальноеЗаполнение(ПараметрыОбновления) Экспорт

	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления,
		"ОбработкаЗавершена", Ложь);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СтатусыГотовностиРезервистов.Регистратор КАК Регистратор
		|ПОМЕСТИТЬ ВТОбработанныеРегистраторы
		|ИЗ
		|	РегистрСведений.СтатусыГотовностиРезервистов КАК СтатусыГотовностиРезервистов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
		|	УдалитьСтатусыГотовностиРезервистов.Регистратор КАК Регистратор
		|ПОМЕСТИТЬ ВТРегистраторыДляОбработки
		|ИЗ
		|	РегистрСведений.УдалитьСтатусыГотовностиРезервистов КАК УдалитьСтатусыГотовностиРезервистов
		|ГДЕ
		|	НЕ ИСТИНА В
		|		(ВЫБРАТЬ ПЕРВЫЕ 1
		|			ИСТИНА
		|		ИЗ
		|			ВТОбработанныеРегистраторы КАК ВТОбработанныеРегистраторы
		|		ГДЕ
		|			ВТОбработанныеРегистраторы.Регистратор = УдалитьСтатусыГотовностиРезервистов.Регистратор)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УдалитьСтатусыГотовностиРезервистов.Период КАК Период,
		|	УдалитьСтатусыГотовностиРезервистов.Регистратор КАК Регистратор,
		|	УдалитьСтатусыГотовностиРезервистов.НомерСтроки КАК НомерСтроки,
		|	УдалитьСтатусыГотовностиРезервистов.Активность КАК Активность,
		|	УдалитьСтатусыГотовностиРезервистов.ПозицияРезерва КАК ПозицияРезерва,
		|	УдалитьСтатусыГотовностиРезервистов.ФизическоеЛицо КАК ФизическоеЛицо,
		|	УдалитьСтатусыГотовностиРезервистов.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.УдалитьСтатусыГотовностиРезервистов КАК УдалитьСтатусыГотовностиРезервистов
		|ГДЕ
		|	ИСТИНА В
		|		(ВЫБРАТЬ ПЕРВЫЕ 1
		|			ИСТИНА
		|		ИЗ
		|			ВТРегистраторыДляОбработки КАК ВТРегистраторыДляОбработки
		|		ГДЕ
		|			ВТРегистраторыДляОбработки.Регистратор = УдалитьСтатусыГотовностиРезервистов.Регистратор)
		|ИТОГИ
		|ПО
		|	Регистратор";

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений.УдалитьСтатусыГотовностиРезервистов.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений.СтатусыГотовностиРезервистов.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления,
				"ОбработкаЗавершена", Истина);
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		
		ВыборкаРегистратор = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРегистратор.Следующий() Цикл
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
			Выборка = ВыборкаРегистратор.Выбрать();
			Пока Выборка.Следующий() Цикл
				НоваяЗапись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
				НоваяЗапись.УчастникКадровогоРезерва = Выборка.ФизическоеЛицо;
			КонецЦикла;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НаборЗаписей);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли