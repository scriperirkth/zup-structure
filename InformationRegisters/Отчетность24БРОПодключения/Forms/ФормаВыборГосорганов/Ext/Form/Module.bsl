#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)     
	
	ГосорганыМассив = РегистрыСведений.Отчетность24БРОПодключения.МассивГосорганов();
	
	ГосорганыВыбранныеСтрока = "";
	Если Параметры.Свойство("Госорганы", ГосорганыВыбранныеСтрока) = Ложь Тогда
		ГосорганыВыбранныеСтрока = СтрСоединить(ГосорганыМассив, ", ");	
	КонецЕсли;
	
	МассивГосорганыВыбранные = Отчетность24БРОКлиентСервер.РазделитьСтрокуСоСложнымРазделителем(
		ГосорганыВыбранныеСтрока, ", ");

	Для Каждого Госорган Из ГосорганыМассив Цикл	
		Список.Добавить(Госорган);
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из Список Цикл
		Если МассивГосорганыВыбранные.Найти(ЭлементСписка.Значение) <> Неопределено Тогда
			ЭлементСписка.Пометка = Истина;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	ГосорганыМассив = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Если ЭлементСписка.Пометка Тогда
			ГосорганыМассив.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;   
	
	Если ГосорганыМассив.Количество() > 0 Тогда
		РезультатЗакрытия = СтрСоединить(ГосорганыМассив, ", ");
	Иначе
		РезультатЗакрытия = Неопределено;
	КонецЕсли;
	
	Закрыть(РезультатЗакрытия);
	
КонецПроцедуры

#КонецОбласти