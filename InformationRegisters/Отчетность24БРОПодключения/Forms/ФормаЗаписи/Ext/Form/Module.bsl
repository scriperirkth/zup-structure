#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.Отчетность24БРОПодключения) Тогда 
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.Получатель)
		И Не ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.Отчетность24БРОПодключения) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Параметры.Свойство("НужноЗакрытьСВозвратомРезультата", НужноЗакрытьСВозвратомРезультата);

	Если Не ЗначениеЗаполнено(Запись.Отправитель) Тогда
		// по умолчанию - для новых записей
		Запись.ТребоватьПодтверждениеПользователя = Истина;
	КонецЕсли;

	ВариантыПодтверждения = ?(Запись.ТребоватьПодтверждениеПользователя, 1, 0);
	
	ОбновитьПредставлениеГиперссылок();
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЕстьОграничениеRLS() Тогда
		ПоказатьПредупреждение(, "У вас есть ограничения доступа по организациям, 
			|настройка будет действовать только для доступных организаций", , "Обратите внимание");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запись.Имя) = Ложь Тогда
		Запись.Имя = Элементы.Имя.ПодсказкаВвода;
	КонецЕсли;
	
	Запись.Имя = Запись.Имя + ИнтеграцияСОтчетность24ВызовСервера.ИндексНаименованияНастройки(Запись.Имя, Запись.Получатель);

КонецПроцедуры   

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
    	Возврат;
    КонецЕсли; 
    
	Если НужноЗакрытьСВозвратомРезультата Тогда  
		НужноЗакрытьСВозвратомРезультата = Ложь;
        СтандартнаяОбработка = Ложь;
        Отказ = Истина;
        ПодключитьОбработчикОжидания("ЗакрытьСВозвратомРезультата", 0.1, Истина);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если Не ЗавершениеРаботы И ИнтеграцияСОтчетность24ВызовСервера.ЕстьНастроенныеИнтеграции() Тогда
		
		Отчетность24БРОКлиент.ИнициализацияШиныУведомлений();
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПользователиПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыборПользователей_Завершение = Новый ОписаниеОповещения("ВыборПользователей_Завершение", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Получатель", Запись.Получатель);
	
	ОткрытьФорму("РегистрСведений.Отчетность24БРОПодключения.Форма.ФормаВыбораПользователей",
		ПараметрыФормы,
		ЭтотОбъект,
		УникальныйИдентификатор,
		,
		,
		ВыборПользователей_Завершение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры   

&НаКлиенте
Процедура ДекорацияПодсказкаШапкаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "Инструкция" Тогда
		СтандартнаяОбработка = Ложь;
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ИнтеграцияСОтчетность24Клиент.АдресИнструкции());	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыборОрганизаций_Завершение = Новый ОписаниеОповещения("ВыборОрганизаций_Завершение", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Получатель", Запись.Получатель);
	
	ОткрытьФорму("РегистрСведений.Отчетность24БРОПодключения.Форма.ФормаВыбораОрганизаций",
		ПараметрыФормы,
		ЭтотОбъект,
		УникальныйИдентификатор,
		,
		,
		ВыборОрганизаций_Завершение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВариантыПодтвержденияПриИзменении(Элемент) 
	
	Запись.ТребоватьПодтверждениеПользователя = ВариантыПодтверждения = 1;
	Элементы.ПользователиПредставление.Видимость = Запись.ТребоватьПодтверждениеПользователя;
	Элементы.ГруппаПользователиОписание.Видимость = Не Запись.ТребоватьПодтверждениеПользователя;
	
КонецПроцедуры

&НаКлиенте
Процедура ГосорганыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыборГосорганов_Завершение = Новый ОписаниеОповещения("ВыборГосорганов_Завершение", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Госорганы", Запись.Госорганы);
	
	ОткрытьФорму("РегистрСведений.Отчетность24БРОПодключения.Форма.ФормаВыборГосорганов",
		ПараметрыФормы,
		ЭтотОбъект,
		УникальныйИдентификатор,
		,
		,
		ВыборГосорганов_Завершение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ПодключитьсяКоманда(Команда)
	
	ТикетАутентификацииНаПорталеПоддержки = ИнтеграцияСОтчетность24ВызовСервера.ТикетАутентификацииНаПорталеПоддержки();
	Если Не ЗначениеЗаполнено(ТикетАутентификацииНаПорталеПоддержки.Тикет) 
		Или ТикетАутентификацииНаПорталеПоддержки.КодОшибки = "НеверныйЛогинИлиПароль" Тогда
		
		Результат = Ждать ВопросАсинх("Не выполнено подключение к Интернет-поддержке!" 
			+ Символы.ПС + Символы.ПС + "Выполнить подключение сейчас?", РежимДиалогаВопрос.ДаНет, , , 
			"Ошибка доступа к сервису"); // КодВозвратаДиалога
		
		Если Результат = КодВозвратаДиалога.Да Тогда
			ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей();
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Подключиться();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТехническуюИнформацию(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Получатель", Запись.Получатель);
	ПараметрыФормы.Вставить("Отправитель", Запись.Отправитель);
	
	ОткрытьФорму("РегистрСведений.Отчетность24БРОПодключения.Форма.ТехническаяИнформация",
		ПараметрыФормы,
		ЭтотОбъект,
		УникальныйИдентификатор, , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВставитьПинКод(Команда)
	Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		КодовоеСлово = Ждать СредстваБуфераОбмена.ПолучитьДанныеАсинх(СтандартныйФорматДанныхБуфераОбмена.Текст);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьТекущегоПользователяВНастройкиПодтверждения(Получатель)
	
	ЗаписьНастройкиПодтверждения = РегистрыСведений.Отчетность24БРОНастройкиПодтверждения.СоздатьМенеджерЗаписи();
	ЗаписьНастройкиПодтверждения.Получатель = Получатель;
	ЗаписьНастройкиПодтверждения.Пользователь = Пользователи.ТекущийПользователь();
	ЗаписьНастройкиПодтверждения.РазрешеноПодтверждениеОтправки = Истина;
	ЗаписьНастройкиПодтверждения.Записать();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСВозвратомРезультата() 
	
	Результат = Новый Структура;
	Результат.Вставить("Получатель", Запись.Получатель);
	Результат.Вставить("Имя", Запись.Имя);
	Результат.Вставить("АдресПолучателя", Запись.АдресПолучателя);
	
    Закрыть(Результат);
    
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеГиперссылок()
	
	ВсеГосорганыСтрока = СтрСоединить(РегистрыСведений.Отчетность24БРОПодключения.МассивГосорганов(), ", ");
	Если Не ЗначениеЗаполнено(Запись.Госорганы) Тогда
		Запись.Госорганы = ВсеГосорганыСтрока;			
	КонецЕсли;                                  
	
	Если Запись.Госорганы = ВсеГосорганыСтрока Тогда
		ГосорганыПредставление = "Все госорганы";
	Иначе
		ГосорганыПредставление = Запись.Госорганы;
	КонецЕсли;         
	
	Если ЗначениеЗаполнено(Запись.Получатель) Тогда
		ОрганизацииПредставление = ИнтеграцияСОтчетность24ВызовСервера.ПредставлениеГиперссылкиОрганизацииНастроек(Запись.Получатель);	
		ПользователиПредставление = ИнтеграцияСОтчетность24ВызовСервера.ПредставлениеГиперссылкиПользователиНастроек(Запись.Получатель);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Если ЗначениеЗаполнено(Запись.Получатель) Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаИнфо;
		Элементы.СтраницаПинКод.Видимость = Ложь;
		Элементы.СтраницаИнфо.Видимость = Истина;
		
		Элементы.Подключиться.Видимость = Ложь;
		Элементы.ФормаЗаписатьИЗакрыть.Видимость = Истина;
		Элементы.ФормаЗаписатьИЗакрыть.КнопкаПоУмолчанию = Истина;
		
		Если СтрНачинаетсяС(Запись.АдресПолучателя, "http") Тогда
			АдресОблачная = Запись.АдресПолучателя; 
			Элементы.ГруппаОблачная.Видимость = Истина;
			Элементы.ГруппаФайловая.Видимость = Ложь;
			Элементы.ГруппаСерверная.Видимость = Ложь;
		Иначе
			МассивЧастей = СтрРазделить(Запись.АдресПолучателя, """");
			Если МассивЧастей.Количество() > 3 Тогда
				ИмяСервераБазы = МассивЧастей[1];
				ИмяБазы = МассивЧастей[3];  
				Элементы.ГруппаОблачная.Видимость = Ложь;
				Элементы.ГруппаФайловая.Видимость = Ложь;
				Элементы.ГруппаСерверная.Видимость = Истина;
			Иначе
				ПутьФайловойБазы = МассивЧастей[1];
				Элементы.ГруппаОблачная.Видимость = Ложь;
				Элементы.ГруппаФайловая.Видимость = Истина;
				Элементы.ГруппаСерверная.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если СостояниеВводаПинКода = 0 Тогда
			ТекстСостоянияВводаПинкода = "Введите пин-код для подключения";
		КонецЕсли;
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПинКод;
		Элементы.СтраницаИнфо.Видимость = Ложь; 
		Элементы.СтраницаПинКод.Видимость = Истина;
		
		Элементы.ФормаЗаписатьИЗакрыть.Видимость = Ложь;
		Элементы.Подключиться.Видимость = Истина;
		Элементы.Подключиться.КнопкаПоУмолчанию = Истина;
		ТекущийЭлемент = Элементы.КодовоеСлово;	
	КонецЕсли; 
	
	ВариантыПодтверждения = ?(Запись.ТребоватьПодтверждениеПользователя, 1, 0);
	Элементы.ПользователиПредставление.Видимость = Запись.ТребоватьПодтверждениеПользователя;
	Элементы.ГруппаПользователиОписание.Видимость = Не Запись.ТребоватьПодтверждениеПользователя;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключиться()
	
	Если СостояниеВводаПинКода = 1 Или СостояниеВводаПинКода = 3 Тогда
		Возврат;
	КонецЕсли;
	
	Ошибка = "";
	Результат = ИнтеграцияСОтчетность24ВызовСервера.Подключиться(КодовоеСлово, Ошибка);
	
	ТекстСостоянияВводаПинкода = Результат.ТекстСостояния;
	СостояниеВводаПинКода = Результат.Состояние;
	
	Если СостояниеВводаПинКода = 4 Тогда
		ОбновитьФормуПослеАвторизацииИТС = Новый ОписаниеОповещения("ОбновитьФормуПослеАвторизацииИТС", ЭтотОбъект);
		ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей(ОбновитьФормуПослеАвторизацииИТС, ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("Получатель") Тогда

		АктуализироватьЗаписьРегистра(Результат.Получатель);

		ЗаполнитьЗначенияСвойств(Запись, Результат);
		
		Если СостояниеВводаПинКода = 1 Тогда
			Запись.ТребоватьПодтверждениеПользователя = Истина;
			ДобавитьТекущегоПользователяВНастройкиПодтверждения(Результат.Получатель);
		КонецЕсли;
	
		Записать();

		Если ЗначениеЗаполнено(Результат.Организации) Тогда
			ЗаписатьОграничениеПоОрганизациям(Результат.Получатель, Результат.Организации);
		КонецЕсли;

		Если СостояниеВводаПинКода <> 3 Тогда
			ЗаполнитьПользователейДляПодтвержденияОтправки(Запись.Получатель);
		КонецЕсли;
		
		ПодключитьсяКШинеУведомлений();
		
	КонецЕсли;
	
	ОбновитьПредставлениеГиперссылок();
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ПодключитьсяКШинеУведомлений()

	Отчетность24БРОШинаУведомления.Подключиться();

КонецПроцедуры
	
&НаСервере
Процедура АктуализироватьЗаписьРегистра(Получатель)

	Результат = РегистрыСведений.Отчетность24БРОПодключения.СоздатьМенеджерЗаписи();
	Результат.Получатель = Получатель;
	Результат.Прочитать();
	Если Результат.Выбран() Тогда
		ЗначениеВРеквизитФормы(Результат, "Запись");
	КонецЕсли;
	 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПользователейДляПодтвержденияОтправки(Получатель)

	// Выборка пользователей документооборота с КО
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОграничениеПередачиДанныхВОблачнуюОтчетность.Организация КАК Организация
		|ПОМЕСТИТЬ ВТ_Организации
		|ИЗ
		|	РегистрСведений.Отчетность24БРООграниченияПоОрганизациям КАК ОграничениеПередачиДанныхВОблачнуюОтчетность
		|ГДЕ
		|	ОграничениеПередачиДанныхВОблачнуюОтчетность.Получатель = &Получатель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Организации.Организация) КАК Количество
		|ПОМЕСТИТЬ ВТ_ОрганизацииКоличество
		|ИЗ
		|	ВТ_Организации КАК ВТ_Организации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Организации.Организация КАК Организация,
		|	ВТ_ОрганизацииКоличество.Количество КАК Количество,
		|	ПользователиУчетныхЗаписейДокументооборота.УчетнаяЗапись КАК УчетнаяЗапись,
		|	ПользователиУчетныхЗаписейДокументооборота.Пользователь КАК Пользователь
		|ИЗ
		|	РегистрСведений.ПользователиУчетныхЗаписейДокументооборота КАК ПользователиУчетныхЗаписейДокументооборота
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Организации КАК ВТ_Организации
		|		ПО ПользователиУчетныхЗаписейДокументооборота.УчетнаяЗапись = ВТ_Организации.Организация.УчетнаяЗаписьОбмена,
		|	ВТ_ОрганизацииКоличество КАК ВТ_ОрганизацииКоличество
		|ГДЕ
		|	(ВТ_Организации.Организация ЕСТЬ NULL
		|			ИЛИ ВТ_ОрганизацииКоличество.Количество > 0)";
	
	Запрос.УстановитьПараметр("Получатель", Получатель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивПользователей = Новый Массив();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗначениеСписка = МассивПользователей.Найти(Выборка.Пользователь);
		Если ЗначениеСписка = Неопределено Тогда
			МассивПользователей.Добавить(Выборка.Пользователь);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Пользователь Из МассивПользователей Цикл  
		ЗаписьПодтверждения = РегистрыСведений.Отчетность24БРОНастройкиПодтверждения.СоздатьМенеджерЗаписи();
		ЗаписьПодтверждения.Получатель = Получатель;
		ЗаписьПодтверждения.Пользователь = Пользователь;
		ЗаписьПодтверждения.РазрешеноПодтверждениеОтправки = Истина;
		ЗаписьПодтверждения.Записать();
	КонецЦикла;        	
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьФормуПослеАвторизацииИТС(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		СостояниеВводаПинКода = 0;
		УстановитьВидимостьЭлементов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОграничениеПоОрганизациям(Получатель, Организации)  
	
	Если Не ЗначениеЗаполнено(Получатель) Или Организации = Неопределено Тогда   
		Возврат;
	КонецЕсли;
	
	МассивОрганизаций = Новый Массив();
	Для Каждого Организация Из Организации Цикл

		Если Не ЗначениеЗаполнено(Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивОрганизаций.Найти(Организация) = Неопределено Тогда
			МассивОрганизаций.Добавить(Организация);
		КонецЕсли;
	КонецЦикла;                               
	
	НаборОграничений = РегистрыСведений.Отчетность24БРООграниченияПоОрганизациям.СоздатьНаборЗаписей();
	НаборОграничений.Отбор.Получатель.Установить(Получатель);
	Для Каждого Организация Из МассивОрганизаций Цикл
		НоваяЗапись = НаборОграничений.Добавить();
		НоваяЗапись.Получатель = Получатель; 
		НоваяЗапись.Организация = Организация;
	КонецЦикла;                               
	НаборОграничений.Записать();
	
КонецПроцедуры

&НаСервере
Функция ЕстьОграничениеRLS()
	
	ПараметрыДоступа = ПараметрыДоступа("Просмотр", Метаданные.Справочники.Организации, "Наименование, Ссылка", Пользователи.ТекущийПользователь());
	
	Возврат ПараметрыДоступа.ОграничениеУсловием;
	
КонецФункции

&НаКлиенте
Процедура ВыборГосорганов_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат <> "" Тогда
		Запись.Госорганы = Результат;   
		Если Запись.Госорганы = ВсеГосорганыСтрока Тогда
			ГосорганыПредставление = "Все госорганы";
		Иначе
			ГосорганыПредставление = Запись.Госорганы;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборОрганизаций_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат <> "" Тогда
		ОрганизацииПредставление = Результат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПользователей_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат <> "" Тогда
		ПользователиПредставление = Результат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
