#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИдентификаторБД = НРег(ОбщегоНазначения.КонтрольнаяСуммаСтрокой(
		Отчетность24БРО.ИдентификаторБазы()));
		
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ТекущийПользователь", 
		Пользователи.ТекущийПользователь());
	
	УстановитьУсловноеОформление();

КонецПроцедуры
#КонецОбласти
#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокОбработкаЗапросаОбновления()
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОбновлениеСписка = Новый ОписаниеОповещения("ОбновлениеСписка", ЭтотОбъект);
	
	Если Поле = Элементы.ПредставлениеОрганизации Тогда
		СтандартнаяОбработка = Ложь;
		
		Получатель = Элементы.Список.ТекущиеДанные.Получатель;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Получатель", Получатель);
		ПараметрыФормы.Вставить("ПолучитьСписок", Ложь);
		
		ОткрытьФорму("РегистрСведений.Отчетность24БРОПодключения.Форма.ФормаВыбораОрганизаций",
			ПараметрыФормы,
			ЭтотОбъект,
			УникальныйИдентификатор, , ,
			ОбновлениеСписка,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	ИначеЕсли Поле = Элементы.ПредставлениеПользователь Тогда
		СтандартнаяОбработка = Ложь;
		
		Получатель = Элементы.Список.ТекущиеДанные.Получатель;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Получатель", Получатель);
		
		ОткрытьФорму("РегистрСведений.Отчетность24БРОПодключения.Форма.ФормаВыбораПользователей",
			ПараметрыФормы,
			ЭтотОбъект,
			УникальныйИдентификатор, , ,
			ОбновлениеСписка,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Для Каждого Строка Из Строки Цикл
		
		Данные = Строка.Значение.Данные;
		// Пользователи
		Если Данные.Свойство("ПредставлениеПользователь") Тогда
			Если Данные.ЕстьТекущийПользователь Тогда
				Если Данные.КоличествоПользователей = 1 Тогда
					Данные.ПредставлениеПользователь = НСтр("ru='Только Вы'");
				Иначе
					Данные.ПредставлениеПользователь = НСтр("ru='Вы и еще'") 
					+ " " 
					+ ПолучитьСклоненияСтрокиПоЧислу("", 
					Данные.КоличествоПользователей - 1, "пользователь", "Л=ru_RU; ЧС=Количественное", "ПД=Именительный")[0];
				КонецЕсли;
			ИначеЕсли Данные.КоличествоПользователей = 0 Тогда
				Данные.ПредставлениеПользователь = НСтр("ru='Все'");
			Иначе
				Данные.ПредставлениеПользователь = ПолучитьСклоненияСтрокиПоЧислу("", 
				Данные.КоличествоПользователей, "пользователь", "Л=ru_RU; ЧС=Количественное", "ПД=Именительный")[0];
			КонецЕсли;
		КонецЕсли;
		
		// Организации
		Если Данные.КоличествоОрганизаций = 0 Тогда
			Данные.ПредставлениеОрганизации = НСтр("ru='Все'");	
		Иначе
			Данные.ПредставлениеОрганизации = ПолучитьСклоненияСтрокиПоЧислу("", 
			Данные.КоличествоОрганизаций, "организация", "Л=ru_RU; ЧС=Количественное", "ПД=Именительный")[0];
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СписокПослеУдаления(Элемент)
	СписокПослеУдаленияНаСервере();
КонецПроцедуры

#КонецОбласти

