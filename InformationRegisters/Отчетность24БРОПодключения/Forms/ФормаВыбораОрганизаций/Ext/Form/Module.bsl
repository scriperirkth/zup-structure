#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Получатель", Получатель);
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Получатель", Получатель);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Организации.Ссылка КАК Значение,
	               |	ВЫБОР
	               |		КОГДА ОграничениеПередачиДанныхВОблачнуюОтчетность.Получатель ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК Пометка,
	               |	Организации.ПометкаУдаления КАК ПометкаУдаления,
	               |	ПРЕДСТАВЛЕНИЕ(Организации.Ссылка) КАК Представление
	               |ИЗ
	               |	Справочник.Организации КАК Организации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Отчетность24БРООграниченияПоОрганизациям КАК ОграничениеПередачиДанныхВОблачнуюОтчетность
	               |		ПО (ОграничениеПередачиДанныхВОблачнуюОтчетность.Организация = Организации.Ссылка)
	               |			И (ОграничениеПередачиДанныхВОблачнуюОтчетность.Получатель = &Получатель)";
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	ЕстьВыбранные = Ложь;
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Список.Добавить(), Выборка);
		Если Выборка.Пометка Тогда
			ЕстьВыбранные = Истина;
		КонецЕсли;
	КонецЦикла;   
	
	Если ЕстьВыбранные = Ложь Тогда
		Для Каждого СтрокаСписка Из Список Цикл
			СтрокаСписка.Пометка = Истина;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Закрыть(ЗаписатьВыбранные());
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого Строка Из Список Цикл
		Строка.Пометка = Истина;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого Строка Из Список Цикл
		Строка.Пометка = Ложь;	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьВыбранные() 
	
	ОрганизацииМассив = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл  
		Запись = РегистрыСведений.Отчетность24БРООграниченияПоОрганизациям.СоздатьМенеджерЗаписи();
		Запись.Получатель = Получатель;
		Запись.Организация = ЭлементСписка.Значение;
		Если ЭлементСписка.Пометка Тогда
			ОрганизацииМассив.Добавить(ЭлементСписка.Значение);
			Запись.Записать();
		Иначе
			Запись.Удалить();
		КонецЕсли;
	КонецЦикла;
		
	Возврат ИнтеграцияСОтчетность24ВызовСервера.ПредставлениеГиперссылкиОрганизацииНастроек(Получатель);
	
КонецФункции

#КонецОбласти

