// Возвращает наличие настроенных подключений
// 
// Возвращаемое значение:
//  Булево
Функция ЕстьНастроенныеПриложения() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Отчетность24Подключения.Получатель КАК Получатель
		|ИЗ
		|	РегистрСведений.Отчетность24БРОПодключения КАК Отчетность24Подключения";
	
	Возврат Не  Запрос.Выполнить().Пустой();
	
КонецФункции

// Возвращает массив наименований госорганов
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция МассивГосорганов() Экспорт
	
	Результат = Новый Массив; // см. МассивГосорганов
		
	Запрос = Новый Запрос;   
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ВидыОтправляемыхДокументов.ТипПолучателя КАК ТипПолучателя 
					|ИЗ 
					|	Справочник.ВидыОтправляемыхДокументов КАК ВидыОтправляемыхДокументов";

	СтруктураЗапроса = Новый Структура("ТипПолучателя", "");
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураЗапроса, Выборка);
		ЧастиИмени = СтрРазделить(СтруктураЗапроса.ТипПолучателя, "(");
		
		Если ЧастиИмени.Количество() > 0 Тогда
			
			ТипПолучателя = СокрЛП(ЧастиИмени[0]);

			Если ЗначениеЗаполнено(ТипПолучателя) И Результат.Найти(ТипПолучателя) = Неопределено Тогда
				Результат.Добавить(ТипПолучателя);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
