// @strict-types


#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнитьМессенджерыРекрутинговыхСайтов");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиПравилРегистрации

// См. ЗарплатаКадрыРасширенныйСинхронизацияДанных.ШаблонОбработчика
Процедура ПриЗаполненииНастроекОбработчиковПравилРегистрации(Настройки) Экспорт
	ЗарплатаКадрыРасширенныйСинхронизацияДанных.ДляОтбораПоРазделамДанных(
		Настройки, "ПодборПерсонала");
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Процедура заполняет предопределенные виды мессенджеров кандидата
//
// Параметры:
//  ПараметрыОбновления  - Структура - описывает текущие параметры обновления
//
Процедура ЗаполнитьМессенджерыРекрутинговыхСайтов(ПараметрыОбновления) Экспорт
	
	ДанныеСопоставления = Данные();
	Если ДанныеСопоставления.Telegram = Справочники.ВидыКонтактнойИнформации.TelegramЛичныеДанныеКандидатов
		И ДанныеСопоставления.Max = Справочники.ВидыКонтактнойИнформации.MAXЛичныеДанныеКандидатов Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(
			ПараметрыОбновления, "ОбработкаЗавершена", Истина);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(
		ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ВидыКонтактнойИнформацииКонтактовРекрутинговыхСайтов");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		ДанныеСопоставления.Telegram = Справочники.ВидыКонтактнойИнформации.TelegramЛичныеДанныеКандидатов;
		ДанныеСопоставления.Max = Справочники.ВидыКонтактнойИнформации.MAXЛичныеДанныеКандидатов;
		Сохранить(ДанныеСопоставления);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(
		ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	
КонецПроцедуры

#КонецОбласти

// Возвращаемое значение:
//  Структура - Данные:
// * Telegram - СправочникСсылка.ВидыКонтактнойИнформации - 
// * WhatsApp - СправочникСсылка.ВидыКонтактнойИнформации - 
// * Max - СправочникСсылка.ВидыКонтактнойИнформации - 
// * Прочее - СправочникСсылка.ВидыКонтактнойИнформации - 
Функция НовыеДанные() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Telegram", 		Справочники.ВидыКонтактнойИнформации.ПустаяСсылка());
	Результат.Вставить("WhatsApp", 		Справочники.ВидыКонтактнойИнформации.ПустаяСсылка());
	Результат.Вставить("Max", 			Справочники.ВидыКонтактнойИнформации.ПустаяСсылка());
	Результат.Вставить("Прочее", 		Справочники.ВидыКонтактнойИнформации.ПустаяСсылка());
	
	Возврат Результат;
КонецФункции

// Возвращаемое значение:
//  см. НовыеДанные
Функция Данные() Экспорт
	Результат = НовыеДанные();
	
	Данные = СоздатьНаборЗаписей();
	Данные.Прочитать();
	
	Для Каждого Запись Из Данные Цикл
		Если Запись.Контакт = Перечисления.КонтактыРекрутинговыхСайтов.Telegram Тогда
			Результат.Telegram = Запись.ВидКонтактнойИнформации;
		ИначеЕсли Запись.Контакт = Перечисления.КонтактыРекрутинговыхСайтов.WhatsApp Тогда
			Результат.WhatsApp = Запись.ВидКонтактнойИнформации;
		ИначеЕсли Запись.Контакт = Перечисления.КонтактыРекрутинговыхСайтов.Max Тогда
			Результат.Max = Запись.ВидКонтактнойИнформации;
		ИначеЕсли Запись.Контакт = Перечисления.КонтактыРекрутинговыхСайтов.Прочее Тогда
			Результат.Прочее = Запись.ВидКонтактнойИнформации;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Параметры:
//  Данные - см. НовыеДанные
Процедура Сохранить(Данные) Экспорт
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Очистить();
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Контакт = Перечисления.КонтактыРекрутинговыхСайтов.Telegram;
	НоваяЗапись.ВидКонтактнойИнформации = Данные.Telegram;
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Контакт = Перечисления.КонтактыРекрутинговыхСайтов.WhatsApp;
	НоваяЗапись.ВидКонтактнойИнформации = Данные.WhatsApp;
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Контакт = Перечисления.КонтактыРекрутинговыхСайтов.Max;
	НоваяЗапись.ВидКонтактнойИнформации = Данные.Max;
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Контакт = Перечисления.КонтактыРекрутинговыхСайтов.Прочее;
	НоваяЗапись.ВидКонтактнойИнформации = Данные.Прочее;
	
	НаборЗаписей.Записать();
КонецПроцедуры

// Параметры:
//  Контакт - ПеречислениеСсылка.КонтактыРекрутинговыхСайтов
// 
// Возвращаемое значение:
//  СправочникСсылка.ВидыКонтактнойИнформации - Вид контактной информации
Функция ТекущийВидКонтактнойИнформации(Контакт) Экспорт
	Результат = Справочники.ВидыКонтактнойИнформации.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(Контакт) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Контакт.Установить(Контакт);
	Набор.Прочитать();
	
	Для Каждого Запись Из Набор Цикл
		Результат = Запись.ВидКонтактнойИнформации;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецЕсли
