
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИдентификаторДокумента") Тогда
		Запись.ИдентификаторДокумента = Параметры.ИдентификаторДокумента;
	КонецЕсли;
	
	ПроцессыОбработкиДокументов.ЗаполнитьСписокДоступныхИдентификаторов(СписокДоступныхИдентификаторов);
	
	ОписаниеУсловияИспользования = ПроцессыОбработкиДокументов.ПредставлениеОтбораКомпоновщикаНастроек(Запись.УсловиеИспользования);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ЗаписьНастройкиИспользованияШаблона");
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если НЕ ЗначениеЗаполнено(Запись.Шаблон) Тогда
		ТекстСообщения = НСтр("ru = 'Поле ""Шаблон"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Запись.Шаблон",,Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УсловиеИспользованияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Запись.ИдентификаторДокумента) Тогда
		ПараметрыФормы = Новый Структура("ИдентификаторДокумента, НастройкиОтбора, ЗаголовокОкна",
			Запись.ИдентификаторДокумента,
			Запись.УсловиеИспользования,
			НСтр("ru = 'Установка условия использования'"));
		ОткрытьФорму("ОбщаяФорма.НастройкаОтбора", ПараметрыФормы, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловиеИспользованияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		Запись.УсловиеИспользования = ВыбранноеЗначение.НастройкиОтбора;
		ОписаниеУсловияИспользования = ВыбранноеЗначение.ПредставлениеОтбора;
		Модифицированность = Истина;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПроцессыОбработкиДокументовКлиент.ОткрытьФормуВыбораТипаДокумента(
		Элемент, ДанныеВыбора, СтандартнаяОбработка,
		Новый Структура("ТекущаяСтрока", Запись.ИдентификаторДокумента), СписокДоступныхИдентификаторов);
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеУсловияИспользованияОчистка(Элемент, СтандартнаяОбработка)
	
	Запись.УсловиеИспользования = "";
	
КонецПроцедуры

#КонецОбласти
