	Методы.Вставить("ВыполнитьПервоначальноеЗаполнение");
	Методы.Вставить("ИсправитьДатуОкончанияКадровогоРезерва");
КонецПроцедуры

#КонецОбласти

// Получает данные резервиста по указанной позиции резерва.
//
// Параметры:
//  ПозицияРезерва - СправочникСсылка.КадровыйРезерв - Позиция резерва, по которой необходимо получить данные резервиста.
//  Резервист - СправочникСсылка.ФизическиеЛица - Резервист, данные которого необходимо получить.
//
// Возвращаемое значение:
//  Неопределено, Структура - Данные резервиста, содержащие поля:
//             ПозицияРезерва, ФизическоеЛицо, ДатаВключения, ДатаИсключения, Статус, Рейтинг, Наставник, Куратор.
//             Если данные не найдены, возвращается Неопределено.
//
Функция ДанныеРезервистаПоПозиции(ПозицияРезерва, Резервист) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПозицияРезерва", ПозицияРезерва);
	Запрос.УстановитьПараметр("Резервист", Резервист);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
		|	КадровыйРезерв.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	КадровыйРезерв.ДатаВключения КАК ДатаВключения,
		|	КадровыйРезерв.ДатаИсключения КАК ДатаИсключения,
		|	КадровыйРезерв.Статус КАК Статус,
		|	КадровыйРезерв.Рейтинг КАК Рейтинг,
		|	КадровыйРезерв.Наставник КАК Наставник,
		|	КадровыйРезерв.Куратор КАК Куратор
		|ИЗ
		|	РегистрСведений.КадровыйРезерв КАК КадровыйРезерв
		|ГДЕ
		|	КадровыйРезерв.ПозицияРезерва = &ПозицияРезерва
		|	И КадровыйРезерв.УчастникКадровогоРезерва = &Резервист";
		
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеРезервиста = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
	
	Возврат ДанныеРезервиста;
	
КонецФункции

#КонецОбласти

