#Область ОбработчикиОбновления

// Выполняет первоначальное заполнение при обновлении.
// Данные переносятся из регистра УдалитьКадровыйРезерв.
// Измерение УчастникКадровогоРезерва заполняется данными из измерения ФизическоеЛицо.
// 
// Параметры:
//  ПараметрыОбновления - Структура
Процедура ВыполнитьПервоначальноеЗаполнение(ПараметрыОбновления) Экспорт

	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления,
		"ОбработкаЗавершена", Ложь);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	УдалитьКадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
		|	УдалитьКадровыйРезерв.ФизическоеЛицо КАК ФизическоеЛицо,
		|	УдалитьКадровыйРезерв.Статус КАК Статус,
		|	УдалитьКадровыйРезерв.ДатаВключения КАК ДатаВключения,
		|	УдалитьКадровыйРезерв.ДатаИсключения КАК ДатаИсключения,
		|	УдалитьКадровыйРезерв.Рейтинг КАК Рейтинг,
		|	УдалитьКадровыйРезерв.ВидРезерва КАК ВидРезерва,
		|	УдалитьКадровыйРезерв.Наставник КАК Наставник,
		|	УдалитьКадровыйРезерв.Куратор КАК Куратор
		|ИЗ
		|	РегистрСведений.УдалитьКадровыйРезерв КАК УдалитьКадровыйРезерв
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыйРезерв КАК КадровыйРезерв
		|		ПО УдалитьКадровыйРезерв.ПозицияРезерва = КадровыйРезерв.ПозицияРезерва
		|			И УдалитьКадровыйРезерв.ФизическоеЛицо = КадровыйРезерв.УчастникКадровогоРезерва
		|ГДЕ
		|	КадровыйРезерв.ПозицияРезерва ЕСТЬ NULL
		|	И КадровыйРезерв.УчастникКадровогоРезерва ЕСТЬ NULL";

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений.УдалитьКадровыйРезерв.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений.КадровыйРезерв.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления,
				"ОбработкаЗавершена", Истина);
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ПозицияРезерва.Установить(Выборка.ПозицияРезерва);
			НаборЗаписей.Отбор.УчастникКадровогоРезерва.Установить(Выборка.ФизическоеЛицо);
			НоваяЗапись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
			НоваяЗапись.УчастникКадровогоРезерва = Выборка.ФизическоеЛицо;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НаборЗаписей);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Исправляет реквизит ДатаОкончания при исключении из кадрового резерва
Процедура ИсправитьДатуОкончанияКадровогоРезерва(ПараметрыОбновления) Экспорт
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	КадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
	|	КадровыйРезерв.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
	|	КадровыйРезерв.Статус КАК Статус,
	|	КадровыйРезерв.ДатаВключения КАК ДатаВключения,
	|	КадровыйРезерв.ДатаИсключения КАК ДатаИсключения,
	|	КадровыйРезерв.Рейтинг КАК Рейтинг,
	|	КадровыйРезерв.ВидРезерва КАК ВидРезерва,
	|	КадровыйРезерв.Наставник КАК Наставник,
	|	КадровыйРезерв.Куратор КАК Куратор,
	|	КадровыйРезерв.ОснованиеВключенияВРезерв КАК ОснованиеВключенияВРезерв,
	|	КадровыйРезерв.ОснованиеИсключенияИзРезерва КАК ОснованиеИсключенияИзРезерва
	|ПОМЕСТИТЬ ВТНекорректныеЗаписи
	|ИЗ
	|	РегистрСведений.КадровыйРезерв КАК КадровыйРезерв
	|ГДЕ
	|	КадровыйРезерв.ДатаИсключения < КадровыйРезерв.ДатаВключения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНекорректныеЗаписи.ПозицияРезерва КАК ПозицияРезерва,
	|	ВТНекорректныеЗаписи.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
	|	ВТНекорректныеЗаписи.Статус КАК Статус,
	|	ВТНекорректныеЗаписи.ДатаВключения КАК ДатаВключения,
	|	ИсторияКадровогоРезерва.ДатаОкончания КАК ДатаИсключения,
	|	ВТНекорректныеЗаписи.Рейтинг КАК Рейтинг,
	|	ВТНекорректныеЗаписи.ВидРезерва КАК ВидРезерва,
	|	ВТНекорректныеЗаписи.Наставник КАК Наставник,
	|	ВТНекорректныеЗаписи.Куратор КАК Куратор,
	|	ВТНекорректныеЗаписи.ОснованиеВключенияВРезерв КАК ОснованиеВключенияВРезерв,
	|	ВТНекорректныеЗаписи.ОснованиеИсключенияИзРезерва КАК ОснованиеИсключенияИзРезерва
	|ИЗ
	|	ВТНекорректныеЗаписи КАК ВТНекорректныеЗаписи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияКадровогоРезерва КАК ИсторияКадровогоРезерва
	|		ПО ВТНекорректныеЗаписи.ПозицияРезерва = ИсторияКадровогоРезерва.ПозицияРезерва
	|			И ВТНекорректныеЗаписи.УчастникКадровогоРезерва = ИсторияКадровогоРезерва.УчастникКадровогоРезерва
	|			И (НАЧАЛОПЕРИОДА(ИсторияКадровогоРезерва.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(ВТНекорректныеЗаписи.ДатаВключения, ДЕНЬ))
	|			И ВТНекорректныеЗаписи.ВидРезерва = ИсторияКадровогоРезерва.ВидРезерва
	|ГДЕ
	|	(ИсторияКадровогоРезерва.Регистратор ССЫЛКА Документ.ВключениеВКадровыйРезерв
	|			ИЛИ ИсторияКадровогоРезерва.Регистратор ССЫЛКА Документ.РезультатыАттестацииСотрудников)";
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений.КадровыйРезерв.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		
		Если Не РезультатЗапроса.Пустой() Тогда 
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл 
				НоваяЗапись = РегистрыСведений.КадровыйРезерв.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
				НоваяЗапись.Записать(Истина);
			КонецЦикла;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

