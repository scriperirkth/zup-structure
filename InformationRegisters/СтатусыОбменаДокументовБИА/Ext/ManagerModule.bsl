
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает статус обмена для объекта.
//
// Параметры:
//  ОбъектСсылка - ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА, СправочникСсылка.ДокументыБИА - объект.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыОбменаС1САрхивом - статус обмена.
// 
Функция СтатусДокумента(ОбъектСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ДокументыБИА") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЕСТЬNULL(СтатусыОбменаДокументовБИА.Статус, &СтатусНеГотов) КАК Статус
			|ИЗ
			|	РегистрСведений.СтатусыОбменаДокументовБИА КАК СтатусыОбменаДокументовБИА
			|ГДЕ
			|	СтатусыОбменаДокументовБИА.ДокументБИА = &ОбъектСсылка";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЕСТЬNULL(СтатусыОбменаДокументовБИА.Статус, &СтатусНеГотов) КАК Статус
			|ИЗ
			|	РегистрСведений.СтатусыОбменаДокументовБИА КАК СтатусыОбменаДокументовБИА
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДокументыБИА КАК ДокументыБИА
			|		ПО СтатусыОбменаДокументовБИА.ДокументБИА = ДокументыБИА.Ссылка
			|ГДЕ
			|	ДокументыБИА.ОбъектОснование = &ОбъектСсылка";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
	Запрос.УстановитьПараметр("СтатусНеГотов", );
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Статус;
	
КонецФункции


#КонецОбласти

#КонецЕсли
