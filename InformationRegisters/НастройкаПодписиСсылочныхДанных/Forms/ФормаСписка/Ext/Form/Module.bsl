
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СоставЭПИзменение" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставПодписи

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТипДанных",Элементы.Список.ТекущиеДанные.ТипДанных);
	
	ОткрытьФорму("РегистрСведений.НастройкаПодписиСсылочныхДанных.Форма.ФормаЗаписи",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	ОткрытьФорму("РегистрСведений.НастройкаПодписиСсылочныхДанных.Форма.ФормаЗаписи",,ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТипДанных",Элементы.Список.ТекущиеДанные.ТипДанных);
	
	ОткрытьФорму("РегистрСведений.НастройкаПодписиСсылочныхДанных.Форма.ФормаЗаписи",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	МассивУдаляемыхТиповДанных = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		МассивУдаляемыхТиповДанных.Добавить(Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока).ТипДанных);
	КонецЦикла;
	
	Если МассивУдаляемыхТиповДанных.Количество() = 1 Тогда
		ТекстВопроса = НСтр("ru = 'Удалить запись?'");
	ИначеЕсли МассивУдаляемыхТиповДанных.Количество() > 1 Тогда
		ТекстВопроса = НСтр("ru = 'Удалить записи?'");
	Иначе
		Возврат;
	КонецЕсли;
		
	ПоказатьВопрос(Новый ОписаниеОповещения("СписокПередУдалениемЗавершение", ЭтотОбъект, МассивУдаляемыхТиповДанных),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда)
	ОткрытьФорму("РегистрСведений.НастройкаПодписиСсылочныхДанных.Форма.ФормаЗагрузки", , ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиВФайл(Команда)
	
	ДлительнаяОперация = ЗапуститьСохранениеНастроекВФайл();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииСохраненияНастроек", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКорректностьНастроек(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СтраницаОткрытия", "ПроверкаНастроекСсылочныхДанных");
	
	ОткрытьФорму("Справочник.ШаблоныПроцессов.Форма.ПроверкаКорректностиШаблонов", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СписокПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УдалитьЗаписиРегистраПоТипуДанных(ДополнительныеПараметры);
		Элементы.Список.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьЗаписиРегистраПоТипуДанных(ТипыДанных)
	Для Каждого ТипДанных Из ТипыДанных Цикл
		НаборЗаписей = РегистрыСведений.НастройкаПодписиСсылочныхДанных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ТипДанных.Установить(ТипДанных);
		НаборЗаписей.Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ЗапуститьСохранениеНастроекВФайл()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"ФоновыеЗаданияПроцессыОбработкиДокументов.ВыполнитьВыгрузкуНастроекХраненияСсылочныхДанныхВОбщемМодуле");
	
КонецФункции

&НаКлиенте
Процедура ПриЗавершенииСохраненияНастроек(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура("АдресРезультата", Результат.АдресРезультата);
	Оповещение = Новый ОписаниеОповещения("ПослеСохраненияНастроек", ЭтотОбъект, ПараметрыОповещения);
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.Фильтр = НСтр("ru='Файлы XML'")+"(*.xml)|*.xml";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите файл для сохранения настроек'");
	
	ПараметрыСохранения.Диалог = ДиалогОткрытияФайла;
	
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, Результат.АдресРезультата, "НастройкиХраненияСсылочныхДанных.xml", ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСохраненияНастроек(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	
	УдалитьИзВременногоХранилища(ДополнительныеПараметры.АдресРезультата);
	
	Если ПолученныеФайлы <> Неопределено Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Настройки хранения ссылочных данных выгружены в файл ""%1""'"),
			ПолученныеФайлы[0].ПолноеИмя);
		ПоказатьОповещениеПользователя(,,ТекстСообщения,БиблиотекаКартинок.Успешно32);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти