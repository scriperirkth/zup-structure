// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиПравилРегистрации

// См. ЗарплатаКадрыРасширенныйСинхронизацияДанных.ШаблонОбработчика
Процедура ПриЗаполненииНастроекОбработчиковПравилРегистрации(Настройки) Экспорт
	ЗарплатаКадрыРасширенныйСинхронизацияДанных.ДляОтбораПоОрганизации(Настройки);
КонецПроцедуры

#КонецОбласти

Функция СведенияОНастройкахОхраныТруда(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЕстьОрганизация", ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
		"ВЫБРАТЬ
		|" + ТекстПолейДляЗапросаСведенийОНастройках() + "
		|ИЗ
		|	РегистрСведений.НастройкиОхраныТруда КАК НастройкиОхраныТруда
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &ЕстьОрганизация
		|			ТОГДА НастройкиОхраныТруда.Организация = &Организация
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ";
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Запрос.Выполнить().Выгрузить()[0]);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстПолейДляЗапросаСведенийОНастройках()
	
	ТекстПолейЗапроса = "";
	
	ОписаниеРегистра = ЗарплатаКадрыОбщиеНаборыДанных.ОписаниеРегистра("НастройкиОхраныТруда");
	Для Каждого ИмяРесурса Из ОписаниеРегистра.Ресурсы Цикл
		Если ИмяРесурса = "СпособКонтроляУникальностиНомеровРабочихМест" Тогда
			ВыражениеЗаменыNull = "ЗНАЧЕНИЕ(Перечисление.СпособыКонтроляУникальностиНомеровРабочихМест.ПустаяСсылка)";
		ИначеЕсли ИмяРесурса = "ПорогАктуальностиВредныхФакторовВидовРабот" Тогда
			ВыражениеЗаменыNull = "0";
		ИначеЕсли ИмяРесурса = "ЕдиницаИзмеренияПорогаАктуальностиВредныхФакторовВидовРабот" Тогда
			ВыражениеЗаменыNull = "ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)";
		Иначе
			ВыражениеЗаменыNull = "ЛОЖЬ";
		КонецЕсли;
		
		ТекстПоля = СтрШаблон("
		|	ЕСТЬNULL(МАКСИМУМ(%1), %2) КАК %1", ИмяРесурса, ВыражениеЗаменыNull);
		ТекстЗапятая = ?(ПустаяСтрока(ТекстПолейЗапроса), "", ",");
		ТекстПолейЗапроса = СтрШаблон("%1%2%3", ТекстПолейЗапроса, ТекстЗапятая, ТекстПоля);
	КонецЦикла;
	
	Возврат ТекстПолейЗапроса;

КонецФункции

#КонецОбласти

#КонецЕсли