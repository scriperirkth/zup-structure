#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("Организация", Организация) Тогда 
		ЗначенияДляЗаполнения  = Новый Структура("Организация", "Организация");
		ЗарплатаКадры.ЗаполнитьПервоначальныеЗначенияВФорме(ЭтаФорма, ЗначенияДляЗаполнения);
	КонецЕсли;
	НастройкиМедрегистров = МедицинскиеРегистры.ПолучитьНастройкиВзаимодействияСФедеральнымиМедрегистрами();
	ИспользоватьТокен = (НастройкиМедрегистров.СпособПодключения = Перечисления.СпособыПодключенияКФедеральнымМедрегистрам.ИПС);
	ЗаполнитьНастройкиОрганизацииНаСервере();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Сертификат", "Видимость", ИспользоватьТокен); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Пароль", "Видимость", ИспользоватьТокен); 
	АвтоЗаголовок = Ложь;
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Идентификация по ФРМО подразделений организации %1'"), Организация);
	
	ЗаполнитьПодразделенияИБ(); 
	РежимОтображенияСпискаПодразделенийИБ = ЗагрузитьНастройкуЗагрузкиКлассификаторовМедРегистра("РежимОтображенияСпискаПодразделенийИБ");
	Если ТипЗнч(РежимОтображенияСпискаПодразделенийИБ) = Тип("ОтображениеТаблицы") И РежимОтображенияСпискаПодразделенийИБ<>Элементы.ПодразделенияИБ.Отображение Тогда  
		Элементы.ПодразделенияИБ.Отображение = РежимОтображенияСпискаПодразделенийИБ;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если Не ЗавершениеРаботы И РежимОтображенияСпискаПодразделенийИБ<>Элементы.ПодразделенияИБ.Отображение Тогда  
		СохранитьНастройкуЗагрузкиКлассификаторовМедРегистра("РежимОтображенияСпискаПодразделенийИБ", Элементы.ПодразделенияИБ.Отображение);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СертификатПриИзменении(Элемент)
	СертификатПриИзмененииНаСервере(Организация, Сертификат);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура ПодразделенияИБВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ДанныеСтрокиПодразделенияИБ = Элементы.ПодразделенияИБ.ТекущиеДанные;
	Если ДанныеСтрокиПодразделенияИБ<>Неопределено Тогда
		ДанныеПодразделенияИБ = ДанныеСтрокиПодразделенияИБ;
		ТипПодразделенияКод = ДанныеПодразделенияИБ.ТипПодразделенияКод;
		ДанныеРодительскогоПодразделенияИБ = ДанныеПодразделенияИБ.ПолучитьРодителя();
		Пока ПустаяСтрока(ТипПодразделенияКод) И (ДанныеРодительскогоПодразделенияИБ<>Неопределено) Цикл 
			ДанныеПодразделенияИБ = ДанныеРодительскогоПодразделенияИБ;
			ТипПодразделенияКод = ДанныеПодразделенияИБ.ТипПодразделенияКод;
			ДанныеРодительскогоПодразделенияИБ = ДанныеПодразделенияИБ.ПолучитьРодителя();
		КонецЦикла;
		Если ПустаяСтрока(ТипПодразделенияКод) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Подразделению организации не сопоставлен тип подразделения ФРМО.'"));
		Иначе 
			ТипПодразделения = Число(ТипПодразделенияКод);
			ОтборПоТипу = Новый Структура("Тип", ТипПодразделения);
			ОтобранныеСтроки = ПодразделенияФРМО.НайтиСтроки(ОтборПоТипу);
			Если ОтобранныеСтроки.Количество()=0 Тогда 
				ЗаполнитьПодразделенияФРМО(ТипПодразделения);
				ОтобранныеСтроки = ПодразделенияФРМО.НайтиСтроки(ОтборПоТипу);
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура("ПодразделенияФРМО,ИдентификаторПодразделенияИБ", Новый Массив, ДанныеСтрокиПодразделенияИБ.ПолучитьИдентификатор());
			Для Каждого СтрокаПодразделения Из ОтобранныеСтроки Цикл 
				СтруктураСтроки = СтрокаПодразделенияВСтруктуру(СтрокаПодразделения);
				ПараметрыФормы.ПодразделенияФРМО.Добавить(СтруктураСтроки);
			КонецЦикла;
			СтандартнаяОбработка = Ложь;
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗаписатьВыбранныеИдентификаторы", ЭтотОбъект);
			ОткрытьФорму("РегистрСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров.Форма.ВыборПодразделенияФРМО", 
					ПараметрыФормы, ЭтотОбъект,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВыбранныеИдентификаторы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтрокиПодразделенияИБ = ПодразделенияИБ.НайтиПоИдентификатору(Результат.ИдентификаторПодразделенияИБ);
	Если ДанныеСтрокиПодразделенияИБ<>Неопределено Тогда
		ДанныеСтрокиПодразделенияИБ.НовыйИдентификаторПодразделения = Результат.Идентификатор;
		ДанныеСтрокиПодразделенияИБ.НовоеНаименованиеПодразделения = Результат.Наименование;
		ДанныеСтрокиПодразделенияИБ.НовыйИдентификаторОтделенияИлиКабинета = Результат.ДополнительныйИдентификатор;
		ДанныеСтрокиПодразделенияИБ.НовоеНаименованиеОтделенияИлиКабинета = Результат.ДополнительноеНаименование;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделенияИБПриАктивизацииСтроки(Элемент)
	ПоказатьУслугиНаСервере(СписокУслугТекущегоПодразделения());
	СтандартныеПодсистемыКлиент.РазвернутьУзлыДерева(ЭтаФорма, "УслугиПодразделенияИБ", , Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	Если Модифицированность Тогда
		СохранениеИзмененийНаСервере();
		ПоказатьУслугиНаСервере(СписокУслугТекущегоПодразделения());
		СтандартныеПодсистемыКлиент.РазвернутьУзлыДерева(ЭтаФорма, "УслугиПодразделенияИБ", , Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сопоставить(Команда)
	ПодразделенияИБВыбор(Элементы.ПодразделенияИБ, Элементы.ПодразделенияИБ.ТекущаяСтрока, Неопределено, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВсеУслуги(Команда)
    ТипыПодразделений = Новый Массив;
    ЗаполнитьТипыПодразделений(ПодразделенияИБ.ПолучитьЭлементы(), ТипыПодразделений);
	Если ТипыПодразделений.Количество() > 0 Тогда 
		Для Каждого ТипПодразделения Из ТипыПодразделений Цикл
			Если ТипПодразделения < 8 Тогда // Для образовательных список услуг не нужен. А если нужен, то надо другой метод вызывать.
				ЗаполнитьПодразделенияФРМО(ТипПодразделения);
			КонецЕсли;
		КонецЦикла;
		ЗагрузитьУслугиНаСервере();
	КонецЕсли;
КонецПроцедуры 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьТипыПодразделений(Подразделения, ТипыПодразделений)
	Для Каждого Подразделение Из Подразделения Цикл 
		Если Не ПустаяСтрока(Подразделение.ТипПодразделенияКод) Тогда 
			ТипПодразделения = Число(Подразделение.ТипПодразделенияКод);
			Если ТипыПодразделений.Найти(ТипПодразделения) = Неопределено Тогда 
				ТипыПодразделений.Добавить(ТипПодразделения);
			КонецЕсли;
			ДочерниеПодразделения = Подразделение.ПолучитьЭлементы();
			Если ДочерниеПодразделения.Количество() > 0 Тогда 
				ЗаполнитьТипыПодразделений(ДочерниеПодразделения, ТипыПодразделений);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодразделенияИБ()
	
	Перем ДанныеСправочника, Запрос, КоллекцияЭлементовДерева;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПодразделенияОрганизаций.Ссылка КАК Подразделение,
	|	ПодразделенияОрганизаций.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА ПодразделенияОрганизаций.ПометкаУдаления
	|			ТОГДА 4
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК СтандартнаяКартинка,
	|	ХарактеристикиОбъектовДляФедеральныхМедрегистров.Характеристика.Код КАК ТипПодразделенияКод,
	|	ХарактеристикиОбъектовДляФедеральныхМедрегистров.Характеристика.НаименованиеПолное КАК ТипПодразделенияНаименование,
	|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.Идентификатор КАК ИдентификаторПодразделения,
	|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.Наименование КАК НаименованиеПодразделения,
	|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.ДополнительныйИдентификатор КАК ИдентификаторОтделенияИлиКабинета,
	|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.ДополнительноеНаименование КАК НаименованиеОтделенияИлиКабинета,
	|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.Идентификатор КАК НовыйИдентификаторПодразделения,
	|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.Наименование КАК НовоеНаименованиеПодразделения,
	|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.ДополнительныйИдентификатор КАК НовыйИдентификаторОтделенияИлиКабинета,
	|	ИдентификаторыОбъектовДляФедеральныхМедрегистров.ДополнительноеНаименование КАК НовоеНаименованиеОтделенияИлиКабинета
	|ИЗ
	|	Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров КАК ИдентификаторыОбъектовДляФедеральныхМедрегистров
	|		ПО (ИдентификаторыОбъектовДляФедеральныхМедрегистров.Объект = ПодразделенияОрганизаций.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров КАК ХарактеристикиОбъектовДляФедеральныхМедрегистров
	|		ПО (ХарактеристикиОбъектовДляФедеральныхМедрегистров.Объект = ПодразделенияОрганизаций.Ссылка)
	|			И (ХарактеристикиОбъектовДляФедеральныхМедрегистров.Классификатор.Код = ""1.2.643.5.1.13.13.99.2.299"")
	|ГДЕ
	|	ПодразделенияОрганизаций.Владелец = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПодразделенияОрганизаций.Ссылка ИЕРАРХИЯ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОказываемыеМедицинскиеУслуги.Объект КАК Подразделение,
	|	ОказываемыеМедицинскиеУслуги.Услуга КАК Услуга,
	|	ОказываемыеМедицинскиеУслуги.Услуга.Код КАК Идентификатор,
	|	ОказываемыеМедицинскиеУслуги.Услуга.НаименованиеПолное КАК Наименование
	|ИЗ
	|	РегистрСведений.ОказываемыеМедицинскиеУслуги КАК ОказываемыеМедицинскиеУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
	|		ПО ОказываемыеМедицинскиеУслуги.Объект = ПодразделенияОрганизаций.Ссылка
	|			И (ПодразделенияОрганизаций.Владелец = &Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеПодразделений = РезультатыЗапроса[0].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);	
	КоллекцияЭлементовДерева = ПодразделенияИБ.ПолучитьЭлементы();
	ОбщегоНазначения.ЗаполнитьКоллекциюЭлементовДереваДанныхФормы(КоллекцияЭлементовДерева, ДанныеПодразделений);
	
	УслугиИБ.Загрузить(РезультатыЗапроса[1].Выгрузить());

КонецПроцедуры

&НаСервере
Процедура СохранениеИзмененийНаСервере()
	
	ДеревоПодразделенийИБ = РеквизитФормыВЗначение("ПодразделенияИБ", Тип("ДеревоЗначений"));
	ДанныеИзменений = Новый Массив;
	ЗаполнитьПоДаннымИБ(ДеревоПодразделенийИБ, ДанныеИзменений);
	СохранитьИзменения(ДанныеИзменений);

	ДанныеУслугИБ = РеквизитФормыВЗначение("УслугиИБ", Тип("ТаблицаЗначений"));
	ДанныеПодразделенийФРМО = РеквизитФормыВЗначение("ПодразделенияФРМО", Тип("ТаблицаЗначений")); 
	СохранитьУслуги(ДеревоПодразделенийИБ, ДанныеПодразделенийФРМО, ДанныеУслугИБ);
	ДанныеУслугИБ.Сортировать("Наименование");
	ЗначениеВРеквизитФормы(ДанныеУслугИБ, "УслугиИБ"); 
	
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьУслугиНаСервере()
	
	ДеревоПодразделенийИБ = РеквизитФормыВЗначение("ПодразделенияИБ", Тип("ДеревоЗначений"));
	ДанныеУслугИБ = РеквизитФормыВЗначение("УслугиИБ", Тип("ТаблицаЗначений"));
	ДанныеПодразделенийФРМО = РеквизитФормыВЗначение("ПодразделенияФРМО", Тип("ТаблицаЗначений")); 
	СохранитьУслуги(ДеревоПодразделенийИБ, ДанныеПодразделенийФРМО, ДанныеУслугИБ); 
	ДанныеУслугИБ.Сортировать("Наименование");
	ЗначениеВРеквизитФормы(ДанныеУслугИБ, "УслугиИБ"); 

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПоДаннымИБ(ДеревоПодразделенийИБ, ДанныеИзменений)
	
	Для Каждого СтрокаДерева Из ДеревоПодразделенийИБ.Строки Цикл
		Если СтрокаДерева.НовыйИдентификаторПодразделения<>СтрокаДерева.ИдентификаторПодразделения
				Или СтрокаДерева.НовоеНаименованиеПодразделения<>СтрокаДерева.НаименованиеПодразделения
				Или СтрокаДерева.НовыйИдентификаторОтделенияИлиКабинета<>СтрокаДерева.ИдентификаторОтделенияИлиКабинета
				Или СтрокаДерева.НовоеНаименованиеОтделенияИлиКабинета<>СтрокаДерева.НаименованиеОтделенияИлиКабинета Тогда 
			НовоеИзменение = Новый Структура();
			НовоеИзменение.Вставить("Объект", СтрокаДерева.Подразделение);
			НовоеИзменение.Вставить("Идентификатор", СтрокаДерева.НовыйИдентификаторПодразделения);
			НовоеИзменение.Вставить("Наименование", СтрокаДерева.НовоеНаименованиеПодразделения);
			НовоеИзменение.Вставить("ДополнительныйИдентификатор", СтрокаДерева.НовыйИдентификаторОтделенияИлиКабинета);
			НовоеИзменение.Вставить("ДополнительноеНаименование", СтрокаДерева.НовоеНаименованиеОтделенияИлиКабинета);
			ДанныеИзменений.Добавить(НовоеИзменение);
		КонецЕсли;
		Если СтрокаДерева.Строки.Количество()>0 Тогда
			ЗаполнитьПоДаннымИБ(СтрокаДерева, ДанныеИзменений);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	
	
&НаСервереБезКонтекста
Процедура СохранитьИзменения(ДанныеИзменений)
	
	Для Каждого СтрокаИзменений Из ДанныеИзменений Цикл
		НаборДляЛогирования = РегистрыСведений.ИдентификаторыОбъектовДляФедеральныхМедрегистров.СоздатьНаборЗаписей();
		НаборДляЛогирования.Отбор.Объект.Установить(СтрокаИзменений.Объект);
		НаборДляЛогирования.Прочитать();
		Если НаборДляЛогирования.Количество() = 0 Тогда
			ЗаписьДляЛогирования = НаборДляЛогирования.Добавить();
		Иначе
			ЗаписьДляЛогирования = НаборДляЛогирования[0];
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ЗаписьДляЛогирования, СтрокаИзменений);
		НаборДляЛогирования.Записать();
	КонецЦикла;
	
КонецПроцедуры	
	
&НаСервереБезКонтекста
Процедура СохранитьУслуги(ДеревоПодразделенийИБ, ДанныеПодразделенийФРМО, ДанныеУслугИБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлементыКлассификаторовФедеральныхМедрегистров.Код КАК Код,
	|	ЭлементыКлассификаторовФедеральныхМедрегистров.НаименованиеПолное КАК НаименованиеПолное,
	|	ЭлементыКлассификаторовФедеральныхМедрегистров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров КАК ЭлементыКлассификаторовФедеральныхМедрегистров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторыФедеральныхМедрегистров КАК КлассификаторыФедеральныхМедрегистров
	|		ПО ЭлементыКлассификаторовФедеральныхМедрегистров.Владелец = КлассификаторыФедеральныхМедрегистров.Ссылка
	|ГДЕ
	|	КлассификаторыФедеральныхМедрегистров.Код = &ИдентификаторКлассификатора
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.УстановитьПараметр("ИдентификаторКлассификатора", "1.2.643.5.1.13.13.99.2.319");
	УслугиНСИ = Запрос.Выполнить().Выгрузить();
	УслугиНСИ.Индексы.Добавить("Код"); 
	
	ОтборДляОчисткиУслугИБ = Новый Структура("Подразделение", Неопределено);
	ОтборДляПоискаПодразделенияИБ = Новый Структура("НовыйИдентификаторПодразделения,НовыйИдентификаторОтделенияИлиКабинета", Неопределено, Неопределено);
	
	Для Каждого ПодразделениеФРМО Из ДанныеПодразделенийФРМО Цикл
		ОтборДляПоискаПодразделенияИБ.НовыйИдентификаторПодразделения = ПодразделениеФРМО.Идентификатор;
		ОтборДляПоискаПодразделенияИБ.НовыйИдентификаторОтделенияИлиКабинета = "";
		ПодразделенияИБ = ДеревоПодразделенийИБ.Строки.НайтиСтроки(ОтборДляПоискаПодразделенияИБ, Истина);
		Для Каждого ПодразделениеИБ Из ПодразделенияИБ Цикл  
			НаборДляОчистки = РегистрыСведений.ОказываемыеМедицинскиеУслуги.СоздатьНаборЗаписей();
			НаборДляОчистки.Отбор.Объект.Установить(ПодразделениеИБ.Подразделение);
			НаборДляОчистки.Записать();
			ОтборДляОчисткиУслугИБ.Подразделение = ПодразделениеИБ.Подразделение;
			СтрокиДляОчистки = ДанныеУслугИБ.НайтиСтроки(ОтборДляОчисткиУслугИБ);
			Для Каждого СтрокаУслугПодразделенияИБ Из СтрокиДляОчистки Цикл  
				ДанныеУслугИБ.Удалить(СтрокаУслугПодразделенияИБ);
			КонецЦикла;
			Для Каждого УслугаФРМО Из ПодразделениеФРМО.Услуги Цикл
				ЭлементНСИ = УслугиНСИ.Найти(УслугаФРМО.Идентификатор, "Код"); 
				Если ЭлементНСИ<>Неопределено Тогда
					НоваяУслуга = РегистрыСведений.ОказываемыеМедицинскиеУслуги.СоздатьМенеджерЗаписи();
					НоваяУслуга.Объект = ПодразделениеИБ.Подразделение;
					НоваяУслуга.Услуга = ЭлементНСИ.Ссылка;
					НоваяУслуга.Записать(Истина);
					НоваяУслугаИБ = ДанныеУслугИБ.Добавить();
					НоваяУслугаИБ.Подразделение = ПодразделениеИБ.Подразделение;
					НоваяУслугаИБ.Услуга = ЭлементНСИ.Ссылка;
					НоваяУслугаИБ.Идентификатор = УслугаФРМО.Идентификатор;
					НоваяУслугаИБ.Наименование = ЭлементНСИ.НаименованиеПолное;
				КонецЕсли;
			КонецЦикла; 
		КонецЦикла;
		Для Каждого ОтделениеФРМО Из ПодразделениеФРМО.СтруктураПодразделения Цикл
			ОтборДляПоискаПодразделенияИБ.НовыйИдентификаторПодразделения = ПодразделениеФРМО.Идентификатор;
			ОтборДляПоискаПодразделенияИБ.НовыйИдентификаторОтделенияИлиКабинета = ОтделениеФРМО.Идентификатор;
			ПодразделенияИБ = ДеревоПодразделенийИБ.Строки.НайтиСтроки(ОтборДляПоискаПодразделенияИБ, Истина);
			Для Каждого ПодразделениеИБ Из ПодразделенияИБ Цикл  
				НаборДляОчистки = РегистрыСведений.ОказываемыеМедицинскиеУслуги.СоздатьНаборЗаписей();
				НаборДляОчистки.Отбор.Объект.Установить(ПодразделениеИБ.Подразделение);
				НаборДляОчистки.Записать();
				ОтборДляОчисткиУслугИБ.Подразделение = ПодразделениеИБ.Подразделение;
				СтрокиДляОчистки = ДанныеУслугИБ.НайтиСтроки(ОтборДляОчисткиУслугИБ);
				Для Каждого СтрокаУслугПодразделенияИБ Из СтрокиДляОчистки Цикл  
					ДанныеУслугИБ.Удалить(СтрокаУслугПодразделенияИБ);
				КонецЦикла;
				Для Каждого УслугаФРМО Из ОтделениеФРМО.Услуги Цикл
					ЭлементНСИ = УслугиНСИ.Найти(УслугаФРМО.Идентификатор, "Код"); 
					Если ЭлементНСИ<>Неопределено Тогда
						НоваяУслуга = РегистрыСведений.ОказываемыеМедицинскиеУслуги.СоздатьМенеджерЗаписи();
						НоваяУслуга.Объект = ПодразделениеИБ.Подразделение;
						НоваяУслуга.Услуга = ЭлементНСИ.Ссылка;
						НоваяУслуга.Записать(Истина);
						НоваяУслугаИБ = ДанныеУслугИБ.Добавить();
						НоваяУслугаИБ.Подразделение = ПодразделениеИБ.Подразделение;
						НоваяУслугаИБ.Услуга = ЭлементНСИ.Ссылка;
						НоваяУслугаИБ.Идентификатор = УслугаФРМО.Идентификатор;
						НоваяУслугаИБ.Наименование = ЭлементНСИ.НаименованиеПолное;
					КонецЕсли;
				КонецЦикла; 
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры	
	
&НаКлиенте
Функция СтрокаПодразделенияВСтруктуру(СтрокаПодразделения)
	Результат = Новый Структура("Наименование,Идентификатор,Уровень,Родитель");
	ЗаполнитьЗначенияСвойств(Результат, СтрокаПодразделения);
	СтруктураПодразделения = Новый Массив;
	Для Каждого ТекущийЭлементСтруктурыПодразделения Из СтрокаПодразделения.СтруктураПодразделения Цикл
		РеквизитыЭлементаСтруктурыПодразделения = Новый Структура("Наименование,Идентификатор");
		ЗаполнитьЗначенияСвойств(РеквизитыЭлементаСтруктурыПодразделения, ТекущийЭлементСтруктурыПодразделения);
		СтруктураПодразделения.Добавить(РеквизитыЭлементаСтруктурыПодразделения);
	КонецЦикла;
	Результат.Вставить("СтруктураПодразделения", СтруктураПодразделения);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПодразделенияФРМО(ТипПодразделения)
	
	Смещение = 0;
	Ограничение = 20;
	КоличествоЭлементов = 1; // Если 0, то вылетим при первой ошибке, т.к. КоличествоЭлементов будет равно ПолученоЭлементов.
	ПолученоЭлементов = 0;
	КоличествоПопыток = 1;
	МаксимумПопыток = 3;
	ПараметрыСервиса = ПараметрыСервиса();
	
	Пока Истина Цикл  
		ТокенДоступа = ТокенДоступа(ПараметрыСервиса);
		Если ТипПодразделения = 9008 Тогда // Образовательные
			ПараметрыВызова = GetEoDepart(УИНОрганизации);
		ИначеЕсли ТипПодразделения = 7 Тогда // Фармацевтические
			ПараметрыВызова = GetFarmDepart(УИНОрганизации, Смещение, Ограничение);
		Иначе
			ПараметрыВызова = GetOrgDepart(ТипПодразделения, УИНОрганизации, Смещение, Ограничение);
		КонецЕсли;
		ОтветСервиса = ВызватьМетод(Организация, ТокенДоступа, ПараметрыВызова);
		Если ОтветСервиса.СообщениеОбОшибкеПользователю<>Неопределено Тогда
					СообщениеОбОшибкеПользователю = СтрШаблон(НСтр("ru = 'Получение списка подразделений из ФРМО: %1%2'"), 
							ОтветСервиса.СообщениеОбОшибкеПользователю, ОтветСервиса.ТекстДляТехподдержки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибкеПользователю);
			КоличествоПопыток = КоличествоПопыток + 1;
		Иначе 
			КоличествоПопыток = 1;
			Смещение = Смещение + Ограничение;
			КоличествоЭлементов = ?(ОтветСервиса.Количество = Неопределено, 1, ОтветСервиса.Количество);
			Для Каждого Подразделение Из ОтветСервиса.Контент Цикл
				ПолученоЭлементов = ПолученоЭлементов + 1;
				Если ТипПодразделения = 9008 Тогда
					НовоеПодразделениеФРМО = ПодразделенияФРМО.Добавить();
					НовоеПодразделениеФРМО.Тип = ТипПодразделения;
					НовоеПодразделениеФРМО.Наименование = Подразделение.eoDepartName;
					НовоеПодразделениеФРМО.Идентификатор = Подразделение.eoDepartOid;
					НовоеПодразделениеФРМО.Уровень = 1;
				Иначе 
					Если Не Подразделение.isPlanned Тогда 
						НовоеПодразделениеФРМО = ПодразделенияФРМО.Добавить();
						НовоеПодразделениеФРМО.Тип = ТипПодразделения;
						НовоеПодразделениеФРМО.Наименование = Подразделение.departName;
						НовоеПодразделениеФРМО.Идентификатор = Подразделение.oid;
						ПодчиненностьПодразделения = Подразделение.departStructure;
						НовоеПодразделениеФРМО.Уровень = Число(ПодчиненностьПодразделения.level);
						НовоеПодразделениеФРМО.Родитель = ПодчиненностьПодразделения.headDepart;
						Если ТипПодразделения=1 Тогда // Есть кабинеты departReg -> room[] -> oid.
							Амбулатория = Неопределено;
							Если Подразделение.Свойство("departReg", Амбулатория) Тогда 
								Для Каждого Кабинет Из Амбулатория.room Цикл 
									НовыйКабинет = НовоеПодразделениеФРМО.СтруктураПодразделения.Добавить();
									НовыйКабинет.Наименование = Кабинет.subdivisionId.subdivision;
									НовыйКабинет.Идентификатор = Кабинет.oid;
									УслугиКабинета = Неопределено;
									Если Кабинет.Свойство("services", УслугиКабинета) Тогда 
										Для Каждого Услуга Из УслугиКабинета Цикл 
											НоваяУслуга = НовыйКабинет.Услуги.Добавить();
											НоваяУслуга.Идентификатор = Формат(Услуга.code, "ЧГ=0; ЧН=");
										КонецЦикла;
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
							Услуги = Неопределено;
							Если Подразделение.Свойство("services", Услуги) Тогда 
								Для Каждого Услуга Из Услуги Цикл 
									НоваяУслуга = НовоеПодразделениеФРМО.Услуги.Добавить();
									НоваяУслуга.Идентификатор = Формат(Услуга.code, "ЧГ=0; ЧН=");
								КонецЦикла;
							КонецЕсли;
						ИначеЕсли ТипПодразделения=3 Или ТипПодразделения=4 Тогда // Есть кабинеты, но в departLabs[] -> labOid.
							Лаборатории = Неопределено;
							Если Подразделение.Свойство("departLabs", Лаборатории) Тогда 
								Для Каждого Кабинет Из Лаборатории Цикл 
									НовыйКабинет = НовоеПодразделениеФРМО.СтруктураПодразделения.Добавить();
									НовыйКабинет.Наименование = Кабинет.roomTypeId.subdivision;
									НовыйКабинет.Идентификатор = Кабинет.labOid;
									УслугиКабинета = Неопределено;
									Если Кабинет.Свойство("services", УслугиКабинета) Тогда 
										Для Каждого Услуга Из УслугиКабинета Цикл 
											НоваяУслуга = НовыйКабинет.Услуги.Добавить();
											НоваяУслуга.Идентификатор = Формат(Услуга.code, "ЧГ=0; ЧН=");
										КонецЦикла;
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
							Услуги = Неопределено;
							Если Подразделение.Свойство("services", Услуги) Тогда 
								Для Каждого Услуга Из Услуги Цикл 
									НоваяУслуга = НовоеПодразделениеФРМО.Услуги.Добавить();
									НоваяУслуга.Идентификатор = Формат(Услуга.code, "ЧГ=0; ЧН=");
								КонецЦикла;
							КонецЕсли;
						ИначеЕсли ТипПодразделения=2 Тогда // Есть отделения
							Отделения = Неопределено;
							Если Подразделение.Свойство("departHospital", Отделения) Тогда 
								Для Каждого Отделение Из Отделения.hospitalSubdivision Цикл 
									НовоеОтделение = НовоеПодразделениеФРМО.СтруктураПодразделения.Добавить();
									НовоеОтделение.Наименование = Отделение.subdivisionName;
									НовоеОтделение.Идентификатор = Отделение.oid;
									УслугиОтделения = Неопределено;
									Если Отделение.Свойство("services", УслугиОтделения) Тогда 
										Для Каждого Услуга Из УслугиОтделения Цикл 
											НоваяУслуга = НовоеОтделение.Услуги.Добавить();
											НоваяУслуга.Идентификатор = Формат(Услуга.code, "ЧГ=0; ЧН=");
										КонецЦикла;
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
							Услуги = Неопределено;
							Если Подразделение.Свойство("services", Услуги) Тогда 
								Для Каждого Услуга Из Услуги Цикл 
									НоваяУслуга = НовоеПодразделениеФРМО.Услуги.Добавить();
									НоваяУслуга.Идентификатор = Формат(Услуга.code, "ЧГ=0; ЧН=");
								КонецЦикла;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ПолученоЭлементов>=КоличествоЭлементов Или КоличествоПопыток>МаксимумПопыток Тогда 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры 

