#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиПравилРегистрации

// См. ЗарплатаКадрыРасширенныйСинхронизацияДанных.ШаблонОбработчика
Процедура ПриЗаполненииНастроекОбработчиковПравилРегистрации(Настройки) Экспорт
	ВоинскийУчет.ДляНезависимогоРегистра(Настройки, "ВидДокумента");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НачальноеЗаполнение(ПараметрыОбновления = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыДокументовВоинскогоУчета.ВидДокумента КАК ВидДокумента
		|ИЗ
		|	РегистрСведений.ВидыДокументовВоинскогоУчетаРаботников КАК ВидыДокументовВоинскогоУчета";
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
		
	ДокументыВоинскогоУчета = Новый Массив;
	ДокументыВоинскогоУчета.Добавить(Справочники.ВидыДокументовФизическихЛиц.ВоенныйБилет);
	ДокументыВоинскогоУчета.Добавить(Справочники.ВидыДокументовФизическихЛиц.ВоенныйБилетОфицераЗапаса);
	ДокументыВоинскогоУчета.Добавить(Справочники.ВидыДокументовФизическихЛиц.УдостоверениеГражданинаПодлежащегоПризыву);
	ДокументыВоинскогоУчета.Добавить(Справочники.ВидыДокументовФизическихЛиц.ВременноеУдостоверениеВзаменВоенногоБилетаОфицераЗапаса);
	ДокументыВоинскогоУчета.Добавить(Справочники.ВидыДокументовФизическихЛиц.СправкаВзаменВоенногоБилета);
	ДокументыВоинскогоУчета.Добавить(Справочники.ВидыДокументовФизическихЛиц.УдостоверениеОфицера);
	ДокументыВоинскогоУчета.Добавить(Справочники.ВидыДокументовФизическихЛиц.ВременноеУдостоверениеВзаменПриписногоУдостоверения);
	ВременноеУдостоверение = Справочники.ВидыДокументовФизическихЛиц.НайтиПоНаименованию(НСтр("ru='Временное удостоверение, выданное взамен военного билета'"));
	Если ВременноеУдостоверение <> Неопределено Тогда 
		ДокументыВоинскогоУчета.Добавить(ВременноеУдостоверение);
	КонецЕсли;
	УдостоверениеЛичностиВоеннослужащего = Справочники.ВидыДокументовФизическихЛиц.НайтиПоНаименованию(НСтр("ru='Удостоверение личности военнослужащего Российской Федерации'"));
	Если УдостоверениеЛичностиВоеннослужащего <> Неопределено Тогда 
		ДокументыВоинскогоУчета.Добавить(УдостоверениеЛичностиВоеннослужащего);
	КонецЕсли;
		
	Для Каждого ВидДокумента Из ДокументыВоинскогоУчета Цикл
		
		Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(ПараметрыОбновления, "РегистрСведений.ВидыДокументовВоинскогоУчетаРаботников", "ВидДокумента", ВидДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ВидыДокументовВоинскогоУчетаРаботников.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидДокумента.Установить(ВидДокумента);
		
		НоваяСтрока = НаборЗаписей.Добавить();
		НоваяСтрока.ВидДокумента = ВидДокумента;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли