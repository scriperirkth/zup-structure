#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из ЭтотОбъект Цикл
		ПоляДляПроверки = Новый Массив;
		
		ПроверитьЗначенияГруппыПоказателей(Стр.ВысокаяОценкаПотенциала, Стр.СредняяОценкаПотенциала, Отказ);
		ПроверитьЗначенияГруппыПоказателей(Стр.ВысокаяОценкаЭффективности, Стр.СредняяОценкаЭффективности, Отказ)
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗначенияГруппыПоказателей(ВысокаяОценка, СредняяОценка, Отказ)
	
	Если ВысокаяОценка = 0 И СредняяОценка = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ВысокаяОценка = СредняяОценка Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В шкале матрицы талантов два одинаковых значения'"));
		Отказ = Истина;
	ИначеЕсли ВысокаяОценка >99 Или СредняяОценка > 99 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В шкале матрицы талантов максимальное значение для оценки эффективности 99%'"));
		Отказ = Истина;
	ИначеЕсли СредняяОценка > ВысокаяОценка Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В шкале матрицы талантов низкий показатель больше среднего'"));
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли