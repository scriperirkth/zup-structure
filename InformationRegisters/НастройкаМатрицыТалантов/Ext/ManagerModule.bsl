#Область СлужебныеПроцедурыИФункции

Функция СоздатьТаблицуШкалы()
	
	Шкала = Новый ТаблицаЗначений;
	Шкала.Колонки.Добавить("Описание", ОбщегоНазначения.ОписаниеТипаСтрока(30));
	Шкала.Колонки.Добавить("Значение", ОбщегоНазначения.ОписаниеТипаЧисло(5, 2));
	Шкала.Колонки.Добавить("ЗначениеПредставление", ОбщегоНазначения.ОписаниеТипаСтрока(30));
	
	Возврат Шкала;
	
КонецФункции

Процедура ДобавитьСтрокуТабличнойЧасти(Таблица, Описание, ЗначениеДо, ЗначениеОт = 0)
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Описание = Описание;
	НоваяСтрока.Значение = ЗначениеДо;
	
	Если ЗначениеОт = 0 Тогда
		НоваяСтрока.ЗначениеПредставление = СтрШаблон(НСтр("ru = 'менее %1%%'"), ЗначениеДо);
	Иначе
		НоваяСтрока.ЗначениеПредставление = СтрШаблон(НСтр("ru = 'от %1%% до %2%%'"), ЗначениеОт, ЗначениеДо);
	КонецЕсли;
	
КонецПроцедуры

Функция НовыеДанныеМатрицыТалантов()
	
	ДанныеМатрицы = Новый Структура;
	ДанныеМатрицы.Вставить("ВысокаяОценкаЭффективности", 66);
	ДанныеМатрицы.Вставить("СредняяОценкаЭффективности", 33);
	ДанныеМатрицы.Вставить("ВысокаяОценкаПотенциала", 66);
	ДанныеМатрицы.Вставить("СредняяОценкаПотенциала", 33);
	
	Возврат ДанныеМатрицы;
	
КонецФункции

Функция ШкалаПотенциала(НастройкиМатрицыТалантов)
	
	ДанныеМатрицы = НовыеДанныеМатрицыТалантов();
	Если НастройкиМатрицыТалантов.ВысокаяОценкаПотенциала <> 0 Тогда
		ЗаполнитьЗначенияСвойств(ДанныеМатрицы, НастройкиМатрицыТалантов);
	КонецЕсли;
	
	Шкала = СоздатьТаблицуШкалы();
	ДобавитьСтрокуТабличнойЧасти(Шкала, НСтр("ru = 'Низкий'"), ДанныеМатрицы.СредняяОценкаПотенциала);
	ДобавитьСтрокуТабличнойЧасти(Шкала, НСтр("ru = 'Средний'"), ДанныеМатрицы.ВысокаяОценкаПотенциала, ДанныеМатрицы.СредняяОценкаПотенциала);
	ДобавитьСтрокуТабличнойЧасти(Шкала, НСтр("ru = 'Высокий'"), 100, ДанныеМатрицы.ВысокаяОценкаПотенциала);
	
	Возврат Шкала;
	
КонецФункции

Функция ШкалаЭффективности(НастройкиМатрицыТалантов)
	
	ДанныеМатрицы = НовыеДанныеМатрицыТалантов();
	Если НастройкиМатрицыТалантов.ВысокаяОценкаЭффективности <> 0 Тогда
		ЗаполнитьЗначенияСвойств(ДанныеМатрицы, НастройкиМатрицыТалантов);
	КонецЕсли;
	
	Шкала = СоздатьТаблицуШкалы();
	ДобавитьСтрокуТабличнойЧасти(Шкала, НСтр("ru = 'Низкая'"), ДанныеМатрицы.СредняяОценкаЭффективности);
	ДобавитьСтрокуТабличнойЧасти(Шкала, НСтр("ru = 'Средняя'"), ДанныеМатрицы.ВысокаяОценкаЭффективности, ДанныеМатрицы.СредняяОценкаЭффективности);
	ДобавитьСтрокуТабличнойЧасти(Шкала, НСтр("ru = 'Высокая'"), 100, ДанныеМатрицы.ВысокаяОценкаЭффективности);
	
	Возврат Шкала;
	
КонецФункции

Функция ЗаполнитьРесурсПоУмолчанию(Настройка, ИмяРесурса, Значение)
	
	Настройка[ИмяРесурса] = ?(Настройка[ИмяРесурса] = 0, Значение, Настройка[ИмяРесурса]);
	
КонецФункции

#КонецОбласти

