Функция НастройкиМатрицыТалантов() Экспорт
	
	Результат = НовыеДанныеМатрицыТалантов();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкаМатрицыТалантов.ВысокаяОценкаЭффективности КАК ВысокаяОценкаЭффективности,
		|	НастройкаМатрицыТалантов.СредняяОценкаЭффективности КАК СредняяОценкаЭффективности,
		|	НастройкаМатрицыТалантов.ВысокаяОценкаПотенциала КАК ВысокаяОценкаПотенциала,
		|	НастройкаМатрицыТалантов.СредняяОценкаПотенциала КАК СредняяОценкаПотенциала
		|ИЗ
		|	РегистрСведений.НастройкаМатрицыТалантов КАК НастройкаМатрицыТалантов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьШкалыМатрицыТалантов(Форма, Настройки) Экспорт
	
	Форма.ШкалаПотенциалаМатрицыТалантов.Загрузить(ШкалаПотенциала(Настройки));
	Форма.ШкалаЭффективностиМатрицыТалантов.Загрузить(ШкалаЭффективности(Настройки));
	УстановитьУсловноеОформлениеШкалыЗначений(Форма.УсловноеОформление, "ШкалаПотенциалаМатрицыТалантов");
	УстановитьУсловноеОформлениеШкалыЗначений(Форма.УсловноеОформление, "ШкалаЭффективностиМатрицыТалантов");
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеШкалыЗначений(УсловноеОформление, ИмяТаблицы) Экспорт
	
	ПолеПредставления = ИмяТаблицы + ".ЗначениеПредставление";
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	СвойствоЭлементОформления = ЭлементУсловногоОформления.Оформление.Элементы.Найти("Текст");
	СвойствоЭлементОформления.Значение = Новый ПолеКомпоновкиДанных(ПолеПредставления);
	СвойствоЭлементОформления.Использование = Истина;
	
	ЭлементОтбораДанных = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораДанных.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеПредставления);
	ЭлементОтбораДанных.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ЭлементОтбораДанных.Использование = Истина;
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "Значение");
	ОформляемоеПоле.Использование = Истина; 
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	СвойствоЭлементОформления = ЭлементУсловногоОформления.Оформление.Элементы.Найти("ТолькоПросмотр");
	СвойствоЭлементОформления.Значение = Истина;
	СвойствоЭлементОформления.Использование = Истина;
	
	ГруппаОтбораДанных = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбораДанных.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ЭлементОтбораДанных1 = ГруппаОтбораДанных.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораДанных1.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Значение");
	ЭлементОтбораДанных1.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбораДанных1.ПравоеЗначение = 100;
	ЭлементОтбораДанных1.Использование = Истина;
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "Значение");
	ОформляемоеПоле.Использование = Истина;
	
КонецПроцедуры

Функция ЗаполнитьРегистрПоУмолчанию(Настройка) Экспорт
	
	Если Настройка.ИспользоватьМатрицуТалантов Тогда
		ЗаполнитьРесурсПоУмолчанию(Настройка, "ВысокаяОценкаЭффективности", 66);
		ЗаполнитьРесурсПоУмолчанию(Настройка, "СредняяОценкаЭффективности", 33);
		ЗаполнитьРесурсПоУмолчанию(Настройка, "ВысокаяОценкаПотенциала", 66);
		ЗаполнитьРесурсПоУмолчанию(Настройка, "СредняяОценкаПотенциала", 33);
	КонецЕсли;
	
КонецФункции

#Область ОбработчикиПравилРегистрации

