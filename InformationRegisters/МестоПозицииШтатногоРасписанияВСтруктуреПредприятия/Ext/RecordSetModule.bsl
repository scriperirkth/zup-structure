#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьТекущиеПодразделенияПозиций(Замещение);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьВторичныеДанные(Замещение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьТекущиеПодразделенияПозиций(Замещение)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("СписокПозиций", РегистрыБЗК.ЗначенияОтбораЗаписейНабора(ЭтотОбъект, Замещение, "Позиция"));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МестоПозиции.Период КАК Период,
		|	МестоПозиции.Позиция КАК Позиция,
		|	МестоПозиции.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ ВТПодразделенияПозиций
		|ИЗ
		|	РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозиции
		|ГДЕ
		|	МестоПозиции.Позиция В (&СписокПозиций)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПодразделенияПозиций.Позиция КАК Позиция
		|ИЗ
		|	ВТПодразделенияПозиций КАК ПодразделенияПозиций";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ТекущиеПодразделенияПозиций", Запрос.МенеджерВременныхТаблиц);
	
КонецПроцедуры

Процедура ОбновитьВторичныеДанные(Замещение)
	
	ЕстьЗаписиВСтаромНаборе = ДополнительныеСвойства.Свойство("ТекущиеПодразделенияПозиций");
	
	СписокПозиций = РегистрыБЗК.ЗначенияОтбораЗаписейНабора(ЭтотОбъект, Замещение, "Позиция");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокПозиций", СписокПозиций);
	Если ЕстьЗаписиВСтаромНаборе Тогда
		Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.ТекущиеПодразделенияПозиций;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	МестоПозиции.Позиция КАК Позиция,
			|	МестоПозиции.Подразделение КАК МестоВСтруктуреПредприятия
			|ПОМЕСТИТЬ ВТМестаВСтруктуреПредприятияПозиций
			|ИЗ
			|	РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозиции
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПодразделенияПозиций КАК ПодразделенияПозиций
			|		ПО МестоПозиции.Позиция = ПодразделенияПозиций.Позиция
			|		И МестоПозиции.Период = ПодразделенияПозиций.Период
			|		И МестоПозиции.Подразделение = ПодразделенияПозиций.Подразделение
			|ГДЕ
			|	МестоПозиции.Позиция В (&СписокПозиций)
			|	И ПодразделенияПозиций.Позиция ЕСТЬ NULL
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	ПодразделенияПозиций.Позиция,
			|	ПодразделенияПозиций.Подразделение
			|ИЗ
			|	ВТПодразделенияПозиций КАК ПодразделенияПозиций
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозиции
			|		ПО МестоПозиции.Позиция = ПодразделенияПозиций.Позиция
			|		И МестоПозиции.Период = ПодразделенияПозиций.Период
			|		И МестоПозиции.Подразделение = ПодразделенияПозиций.Подразделение
			|ГДЕ
			|	ПодразделенияПозиций.Позиция В (&СписокПозиций)
			|	И МестоПозиции.Позиция ЕСТЬ NULL";
		Запрос.Выполнить();
		
		ИнтеграцияУправлениеПерсоналомСобытияРасширенный.ПриЗаписиМестаПозицииШтатногоРасписанияВСтруктуреПредприятия(
			ДополнительныеСвойства.ТекущиеПодразделенияПозиций, Неопределено, Неопределено);
	Иначе
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	МестоПозиции.Позиция КАК Позиция,
			|	МестоПозиции.Подразделение КАК МестоВСтруктуреПредприятия
			|ПОМЕСТИТЬ ВТМестаВСтруктуреПредприятияПозиций
			|ИЗ
			|	РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозиции
			|ГДЕ
			|	МестоПозиции.Позиция В (&СписокПозиций)";
		Запрос.Выполнить();
		
		ИнтеграцияУправлениеПерсоналомСобытияРасширенный.ПриЗаписиМестаПозицииШтатногоРасписанияВСтруктуреПредприятия(
			Неопределено, ЭтотОбъект, Замещение);
	КонецЕсли;
		
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПодразделенияПозиций.Позиция КАК Позиция
		|ИЗ
		|	ВТМестаВСтруктуреПредприятияПозиций КАК ПодразделенияПозиций";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьДанныеДляПодбораСотрудников(СписокПозиций);
	ОбновитьСведенияПодразделений(Запрос);
	
КонецПроцедуры

Процедура ОбновитьДанныеДляПодбораСотрудников(СписокПозиций)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДляПодбора.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.ДанныеДляПодбораСотрудников КАК ДанныеДляПодбора
	|ГДЕ
	|	ДанныеДляПодбора.ДолжностьПоШтатномуРасписанию В (&СписокПозиций)";
	
	Запрос.УстановитьПараметр("СписокПозиций", СписокПозиций);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СписокСотрудников = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СписокСотрудников.Добавить(Выборка.Сотрудник);
	КонецЦикла;

	Если СписокСотрудников.Количество() > 0 Тогда
		РегистрыСведений.ДанныеДляПодбораСотрудников.ОбновитьДанныеДляПодбораСотрудников(СписокСотрудников);
	КонецЕсли;

КонецПроцедуры

Процедура ОбновитьСведенияПодразделений(Запрос)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьИсториюИзмененияШтатногоРасписания") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МестаВСтруктуреПредприятияПозиций.МестоВСтруктуреПредприятия КАК Подразделение
		|ИЗ
		|	ВТМестаВСтруктуреПредприятияПозиций КАК МестаВСтруктуреПредприятияПозиций
		|ГДЕ
		|	МестаВСтруктуреПредприятияПозиций.МестоВСтруктуреПредприятия <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)";
	
	Подразделения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Подразделение");
	
	Если Подразделения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОрганизационнаяСтруктура.ОбновитьСведенияПодразделений(Подразделения);

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли