// Добавить сведения и двоичные данные части файла обмена.
// 
// Параметры:
//  НаправлениеОбмена - ПеречислениеСсылка.НаправленияОбмена - направление обмена.
//  СведенияОЧастиФайла - Структура - см. ОбменСАрхивом.НовыеСведенияОЧастиФайлаОбмена().
//
Процедура Добавить(НаправлениеОбмена, СведенияОЧастиФайла) Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.ИмяФайла = СведенияОЧастиФайла.ИмяФайлаОбмена;
	МенеджерЗаписи.Направление = НаправлениеОбмена;
	МенеджерЗаписи.ДатаСоздания = ТекущаяУниверсальнаяДата();
	МенеджерЗаписи.НомерЧасти = СведенияОЧастиФайла.НомерЧастиФайлаОбмена;
	МенеджерЗаписи.ВсегоЧастей = СведенияОЧастиФайла.ВсегоЧастейФайлаОбмена;
	
	МенеджерЗаписи.ДвоичныеДанные = Новый ХранилищеЗначения(СведенияОЧастиФайла.ДвоичныеДанные);
	
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры

// Добавить сведения и двоичные данные частей файла обмена.
// 
// Параметры:
//  ИмяФайла - Строка - имя файла обмена.
//  Направление - ПеречислениеСсылка.НаправленияОбмена - направление обмена.
//  СведенияОЧастяхФайла - Массив из Структур - см. ОбменСАрхивом.НовыеСведенияОЧастиФайлаОбмена().
//
Процедура ДобавитьЧастиФайлаОбмена(ИмяФайла, Направление, СведенияОЧастяхФайла) Экспорт
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИмяФайла.Установить(ИмяФайла);
	НаборЗаписей.Отбор.Направление.Установить(Направление);
	
	Для Каждого СведенияОЧастиФайла Из СведенияОЧастяхФайла Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Направление = Направление;
		Запись.ИмяФайла = СведенияОЧастиФайла.ИмяФайлаОбмена;
		Запись.ДатаСоздания = ТекущаяУниверсальнаяДата();
		Запись.НомерЧасти = СведенияОЧастиФайла.НомерЧастиФайлаОбмена;
		Запись.ВсегоЧастей = СведенияОЧастиФайла.ВсегоЧастейФайлаОбмена;
		Запись.ДвоичныеДанные = Новый ХранилищеЗначения(СведенияОЧастиФайла.ДвоичныеДанные);
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Все части файла загружены.
// 
// Параметры:
//  ИмяФайла - Строка - имя файла обмена.
//  ВсегоЧастейФайла - Число - Всего частей файла.
//   
// Возвращаемое значение:
//  Булево - Все части файла загружены.
//
Функция ВсеЧастиФайлаЗагружены(ИмяФайла, ВсегоЧастейФайла) Экспорт
	
	Результат = Ложь;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ДвоичныеДанныеФайловОбмена.НомерЧасти) КАК КоличествоЧастейФайла
		|ИЗ
		|	РегистрСведений.ДвоичныеДанныеФайловОбмена КАК ДвоичныеДанныеФайловОбмена
		|ГДЕ
		|	ДвоичныеДанныеФайловОбмена.ИмяФайла = &ИмяФайла
		|	И ДвоичныеДанныеФайловОбмена.Направление = &НаправлениеОбмена");
	Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
	Запрос.УстановитьПараметр("НаправлениеОбмена", Перечисления.НаправленияОбменаС1САрхивом.Получение);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.КоличествоЧастейФайла = ВсегоЧастейФайла Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Удалить части файла обмена.
// 
// Параметры:
//  ИмяФайла - Строка - имя файла. 
//  Направление - ПеречислениеСсылка.НаправленияОбменаС1САрхивом - направление обмена.
//
Процедура УдалитьФайлыОбмена(ИмяФайла, Направление) Экспорт
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИмяФайла.Установить(ИмяФайла);
	НаборЗаписей.Отбор.Направление.Установить(Направление);
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Отмечает часть файла как отправленный в 1С:Архив.
// 
// Параметры:
//  ИмяФайла - Строка - Имя файла обмена.
//  НомерЧасти - Число - Номер части файла обмена.
//
Процедура ОтметитьОтправку(ИмяФайла, НомерЧасти) Экспорт
	
	Запись = СоздатьМенеджерЗаписи();
	Запись.ИмяФайла = ИмяФайла;
	Запись.Направление = Перечисления.НаправленияОбменаС1САрхивом.Отправка;
	Запись.НомерЧасти = НомерЧасти;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось отметить отправку %1 части файла ""%2"": запись не найдена'"),
			НомерЧасти, ИмяФайла);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Запись.ДатаОтправки = ТекущаяДатаСеанса();
	Запись.Записать();
	
КонецПроцедуры

// Получает двоичные данные файла обмена, если их несколько, соединяет их.
// 
// Параметры:
//  ИмяФайла - Строка - имя файла обмена.
//  Направление - ПеречислениеСсылка.НаправленияОбменаС1САрхивом - направление обмена.
// 
// Возвращаемое значение:
//  ДвоичныеДанные - двоичные данные файла обмена.
//
Функция ПолучитьДвоичныеДанныеЧастейФайла(ИмяФайла, Направление) Экспорт
	
	ДвоичныеДанныеЧастейФайла = Новый Массив();
	Результат = Неопределено;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ДвоичныеДанныеФайловОбмена.ДвоичныеДанные КАК ДвоичныеДанные,
		|	ДвоичныеДанныеФайловОбмена.ИмяФайла КАК Имя,
		|	ДвоичныеДанныеФайловОбмена.НомерЧасти КАК НомерЧасти
		|ИЗ
		|	РегистрСведений.ДвоичныеДанныеФайловОбмена КАК ДвоичныеДанныеФайловОбмена
		|ГДЕ
		|	ДвоичныеДанныеФайловОбмена.Направление = &НаправлениеОбмена
		|	И ДвоичныеДанныеФайловОбмена.ИмяФайла = &ИмяФайла
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерЧасти");
	Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
	Запрос.УстановитьПараметр("НаправлениеОбмена", Направление);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДанныеСообщения = Выборка.ДвоичныеДанные.Получить();
		ДвоичныеДанныеЧастейФайла.Добавить(ДанныеСообщения);
		
	КонецЦикла;
	
	Результат = СоединитьДвоичныеДанные(ДвоичныеДанныеЧастейФайла);
	
	Возврат Результат;
	
КонецФункции

