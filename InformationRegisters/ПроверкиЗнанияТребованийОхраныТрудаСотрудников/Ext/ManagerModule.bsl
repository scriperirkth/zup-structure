#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьОбновлениеЗависимыхДанныхПриОбменеПередЗаписью(Объект, Замещение) Экспорт
	
	Объект.ДополнительныеСвойства.Вставить(
		"ТаблицаОбновлениеПериодическихОбучений", ОбучениеПоОхранеТруда.НоваяТаблицаОбновлениеПериодическихОбучений());
	Объект.ДополнительныеСвойства.Вставить(
		"ТаблицаБудущиеСобытияОбучениеПоОхранеТруда", ОбучениеПоОхранеТруда.НоваяТаблицаБудущиеСобытияОбучениеПоОхранеТруда());
	ДополнитьТаблицыОбновления(Объект, Замещение);
	
КонецПроцедуры

Процедура ПодготовитьОбновлениеЗависимыхДанныхПриОбменеПриЗаписи(Объект, Замещение) Экспорт
	ДополнитьТаблицыОбновления(Объект, Замещение);
КонецПроцедуры

Процедура ДополнитьТаблицыОбновления(Объект, Замещение) Экспорт
	
	ТекущаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
	Регистраторы = РегистрыБЗК.ЗначенияОтбораЗаписейНабора(Объект, Замещение, "Регистратор");
	Если Регистраторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеНабора.Период КАК ДатаСобытия,
		|	ДанныеНабора.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеНабора.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	РегистрСведений.ПроверкиЗнанияТребованийОхраныТрудаСотрудников КАК ДанныеНабора
		|ГДЕ
		|	ДанныеНабора.Регистратор В (&Регистраторы)";
	
	ДанныеНабора = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаНабора Из ДанныеНабора Цикл
		НоваяСтрока = Объект.ДополнительныеСвойства["ТаблицаОбновлениеПериодическихОбучений"].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНабора);
		Если ТекущаяДата >= СтрокаНабора.ДатаСобытия Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Объект.ДополнительныеСвойства["ТаблицаБудущиеСобытияОбучениеПоОхранеТруда"].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНабора);
	КонецЦикла;
	
	Объект.ДополнительныеСвойства["ТаблицаОбновлениеПериодическихОбучений"].Свернуть("ФизическоеЛицо, ГоловнаяОрганизация");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли