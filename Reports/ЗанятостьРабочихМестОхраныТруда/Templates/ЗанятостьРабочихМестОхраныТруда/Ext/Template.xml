			И (Представления_КадровыеДанныеСотрудников.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1)
				ИЛИ Представления_КадровыеДанныеСотрудников.ДатаУвольнения &gt;= &amp;Период)</query>
