			<presentationExpression>ВЫБОР 
	КОГДА ДатаСледующейПроверкиЗнания = ДатаВремя(3999, 12, 31)  ТОГДА
		НСтр("ru='&lt; Не требуется &gt;'")
	ИНАЧЕ
		ДатаСледующейПроверкиЗнания 
КОНЕЦ

</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
