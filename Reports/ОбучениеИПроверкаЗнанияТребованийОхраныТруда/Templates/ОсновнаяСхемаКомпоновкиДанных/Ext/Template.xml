				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Обучение</dataPath>
			<field>Обучение</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Обучение</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Проверка</dataPath>
			<field>Проверка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Проверка</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СледующееОбучениеВВыбранномПериоде</dataPath>
			<field>СледующееОбучениеВВыбранномПериоде</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Следующая проверка в выбранном периоде</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПредставлениеПериодичностиОбучения</dataPath>
			<field>ПредставлениеПериодичностиОбучения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Периодичность обучения</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ФизическиеЛица.Ссылка КАК ФизическоеЛицо
ПОМЕСТИТЬ ВТФизическиеЛица
ИЗ
	Справочник.ФизическиеЛица КАК ФизическиеЛица
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДАТАВРЕМЯ(1, 1, 1) КАК Период,
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Сотрудник,
	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ФизическоеЛицо,
	"" КАК Возраст,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПриема,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаУвольнения,
	ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка) КАК Должность,
	ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка) КАК РабочееМестоОхраныТруда,
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ГоловнаяОрганизация,
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка) КАК Подразделение,
	ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ПустаяСсылка) КАК ВидЗанятости
ПОМЕСТИТЬ Представления_СотрудникиОрганизации
ИЗ
	ВТФизическиеЛица КАК ФизическиеЛица
ГДЕ
	"ТолькоРазрешенные" = ИСТИНА
	И "ОтбиратьПоГоловнойОрганизации" = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ ПЕРВЫЕ 0
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка) КАК РабочееМесто
ПОМЕСТИТЬ Представления_РабочиеМестаОхраныТруда
ГДЕ
	"ТолькоРазрешенные" = ИСТИНА
	И "ЭтоОбучениеПоОхранеТруда" = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПрограммыОбученияСотрудниковПоОхранеТруда.Ссылка КАК ПрограммаОбучения,
	ПрограммыОбученияСотрудниковПоОхранеТруда.ИспользоватьДляВсехРабочихМест КАК ИспользоватьДляВсехРабочихМест,
	ПрограммыОбученияСотрудниковПоОхранеТруда.КонтролироватьСменуРабочегоМеста КАК КонтролироватьСменуРабочегоМеста,
	ПрограммыОбученияСотрудниковПоОхранеТруда.ПредставлениеПериода КАК ПредставлениеПериода
ПОМЕСТИТЬ ВТПрограммыОбучения
ИЗ
	Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда КАК ПрограммыОбученияСотрудниковПоОхранеТруда
ГДЕ
	НЕ ПрограммыОбученияСотрудниковПоОхранеТруда.ПометкаУдаления
	И ПрограммыОбученияСотрудниковПоОхранеТруда.КонтролироватьПроведение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ПериодическиеПроверкиЗнания.РабочееМесто КАК РабочееМесто,
	ПериодическиеПроверкиЗнания.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	ПериодическиеПроверкиЗнания.ФизическоеЛицо КАК ФизическоеЛицо,
	ПериодическиеПроверкиЗнания.ПрограммаОбучения КАК ПрограммаОбучения,
	ПериодическиеПроверкиЗнания.ДатаСледующейПроверкиЗнания КАК ДатаСледующейПроверкиЗнания,
	ПериодическиеПроверкиЗнания.РезультатОбучения КАК РезультатОбучения,
	ПериодическиеПроверкиЗнания.ДатаПройденнойПроверкиЗнания КАК ДатаПройденнойПроверкиЗнания,
	ПериодическиеПроверкиЗнания.Обучение КАК Обучение,
	ПериодическиеПроверкиЗнания.Проверка КАК Проверка,
	ПрограммыОбучения.ПредставлениеПериода КАК ПредставлениеПериода
ПОМЕСТИТЬ ВТРабочиеМестаСОбучением
ИЗ
	ВТПрограммыОбучения КАК ПрограммыОбучения
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда.РабочиеМеста КАК ПрограммыОбученияРабочиеМеста
		ПО ПрограммыОбучения.ПрограммаОбучения = ПрограммыОбученияРабочиеМеста.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Представления_РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
		ПО (ВЫБОР
				КОГДА ПрограммыОбучения.ИспользоватьДляВсехРабочихМест
					ТОГДА ИСТИНА
				КОГДА ПрограммыОбученияРабочиеМеста.РабочееМесто = РабочиеМестаОхраныТруда.РабочееМесто
					ТОГДА ИСТИНА
				ИНАЧЕ ЛОЖЬ
			КОНЕЦ)
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПериодическиеПроверкиЗнанияТребованийОхраныТруда КАК ПериодическиеПроверкиЗнания
		ПО (ВЫБОР
				КОГДА ПрограммыОбучения.ИспользоватьДляВсехРабочихМест
					ТОГДА ИСТИНА
				КОГДА НЕ ПрограммыОбучения.КонтролироватьСменуРабочегоМеста 
					ТОГДА ИСТИНА
				КОГДА ПрограммыОбученияРабочиеМеста.РабочееМесто = ПериодическиеПроверкиЗнания.РабочееМесто
					ТОГДА ИСТИНА
				ИНАЧЕ ЛОЖЬ
			КОНЕЦ)
			И ПрограммыОбучения.ПрограммаОбучения = ПериодическиеПроверкиЗнания.ПрограммаОбучения}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	Представления_СотрудникиОрганизации.Период КАК Период,
	Представления_СотрудникиОрганизации.Сотрудник КАК Сотрудник,
	Представления_СотрудникиОрганизации.ФизическоеЛицо КАК ФизическоеЛицо,
	Представления_СотрудникиОрганизации.Возраст КАК Возраст,
	Представления_СотрудникиОрганизации.РабочееМестоОхраныТруда КАК РабочееМесто,
	Представления_СотрудникиОрганизации.Организация КАК Организация,
	Представления_СотрудникиОрганизации.Подразделение КАК Подразделение,
	Представления_СотрудникиОрганизации.Должность КАК Должность,
	Представления_СотрудникиОрганизации.ДатаУвольнения КАК ДатаУвольнения,
	Представления_СотрудникиОрганизации.ВидЗанятости КАК ВидЗанятости,
	РабочиеМестаСОбучением.ПрограммаОбучения КАК ПрограммаОбучения,
	РабочиеМестаСОбучением.ДатаСледующейПроверкиЗнания КАК ДатаСледующейПроверкиЗнания,
	ВЫБОР
		КОГДА РабочиеМестаСОбучением.ДатаСледующейПроверкиЗнания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СледующееОбучениеВВыбранномПериоде,
	РабочиеМестаСОбучением.РезультатОбучения КАК РезультатОбучения,
	РабочиеМестаСОбучением.ДатаПройденнойПроверкиЗнания КАК ДатаПройденнойПроверкиЗнания,
	РабочиеМестаСОбучением.Обучение КАК Обучение,
	РабочиеМестаСОбучением.Проверка КАК Проверка,
	ВЫРАЗИТЬ(РабочиеМестаСОбучением.ПредставлениеПериода КАК СТРОКА(1000)) КАК ПредставлениеПериодичностиОбучения,
	ВЫБОР
		КОГДА Представления_СотрудникиОрганизации.Сотрудник ЕСТЬ НЕ NULL 
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СотрудникВыбран
ИЗ
	ВТРабочиеМестаСОбучением КАК РабочиеМестаСОбучением
		{ЛЕВОЕ СОЕДИНЕНИЕ Представления_СотрудникиОрганизации КАК Представления_СотрудникиОрганизации
		ПО (ВЫБОР
				КОГДА НЕ РабочиеМестаСОбучением.ПрограммаОбучения.КонтролироватьСменуРабочегоМеста
					ТОГДА ИСТИНА
				ИНАЧЕ РабочиеМестаСОбучением.РабочееМесто = Представления_СотрудникиОрганизации.РабочееМестоОхраныТруда
			КОНЕЦ)
			И РабочиеМестаСОбучением.ФизическоеЛицо = Представления_СотрудникиОрганизации.ФизическоеЛицо
			И РабочиеМестаСОбучением.ГоловнаяОрганизация = Представления_СотрудникиОрганизации.ГоловнаяОрганизация}</query>
	</dataSet>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">FromBeginningOfThisYear</v8:variant>
		</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
