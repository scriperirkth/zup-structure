#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "Основной");
	НастройкиВарианта.Описание =
		НСтр("ru = 'Список сотрудников которые подлежат аттестации в указанном периоде.'");
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ФормаОтчетаПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы("ХранилищеРезультатаОтчета", Новый ОписаниеТипов("Строка")); 
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Добавление команд на командную панель.
	Если ПравоДоступа("Добавление", Метаданные.Документы.ПриказОбАттестацииСотрудников)
		И ПравоДоступа("Добавление", Метаданные.Документы.НаправлениеНаВнешнююАттестацию) Тогда
		Команда = Форма.Команды.Добавить("НаправитьНаАттестацию");
		Команда.Действие  = "Подключаемый_Команда";
		Команда.Заголовок = НСтр("ru = 'Направить сотрудников на аттестацию'");
		Команда.Подсказка = НСтр("ru = 'Направить выбранных сотрудников на аттестацию'");
		Команда.Картинка  = БиблиотекаКартинок.Документ;
		Команда.Отображение = ОтображениеКнопки.КартинкаИТекст;
		Если Форма.ИмяФормы = "Отчет.СотрудникиПодлежащиеАттестации.Форма" Тогда
			ОтчетыСервер.ВывестиКоманду(Форма, Команда, "Настройки");
		Иначе
			Элемент = Форма.Элементы.Вставить("НаправитьНаАттестацию", Тип("КнопкаФормы"), Форма.Элементы.ОсновнаяКоманднаяПанель);
			Элемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			Элемент.ИмяКоманды = "НаправитьНаАттестацию"; 
		КонецЕсли;
		
		ОбновитьВидимостьДоступностьЭлементовФормы(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьВидимостьДоступностьЭлементовФормы(Форма) Экспорт
	
	Команда = Форма.Элементы.Найти("НаправитьНаАттестацию");
	Если Команда <> Неопределено Тогда
		Команда.Видимость = (Форма.КлючТекущегоВарианта = "Основной");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли