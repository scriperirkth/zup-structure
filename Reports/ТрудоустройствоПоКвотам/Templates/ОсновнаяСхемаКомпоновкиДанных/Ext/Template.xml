		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПериодыРегистрацииКвот.ВидКвоты КАК ВидКвоты,
	МАКСИМУМ(ПериодыРегистрацииКвот.Период) КАК Период
ПОМЕСТИТЬ АктуальныеКвоты
ИЗ
	РегистрСведений.КвотыДляТрудоустройстваПоДолжностям.СрезПоследних(&amp;ДатаОтчета, Организация = &amp;Организация) КАК ПериодыРегистрацииКвот
ГДЕ
	(ПериодыРегистрацииКвот.АктДатаОкончания &gt;= НАЧАЛОПЕРИОДА(&amp;ДатаОтчета, ДЕНЬ)
			ИЛИ ПериодыРегистрацииКвот.АктДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))

СГРУППИРОВАТЬ ПО
	ПериодыРегистрацииКвот.ВидКвоты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.Организация КАК Организация,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.ВидКвоты КАК ВидКвоты,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.Должность КАК Должность,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.РазмерКвоты КАК РазмерКвоты,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.ДокументРегистрации КАК ДокументРегистрации,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.АктВид КАК АктВид,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.АктНомер КАК АктНомер,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.АктДатаПринятия КАК АктДатаПринятия,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.АктДатаОкончания КАК АктДатаОкончания
ИЗ
	РегистрСведений.КвотыДляТрудоустройстваПоДолжностям.СрезПоследних(&amp;ДатаОтчета, Организация = &amp;Организация) КАК КвотыДляТрудоустройстваПоДолжностямСрезПоследних
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АктуальныеКвоты КАК АктуальныеКвоты
		ПО КвотыДляТрудоустройстваПоДолжностямСрезПоследних.Период = АктуальныеКвоты.Период
			И КвотыДляТрудоустройстваПоДолжностямСрезПоследних.ВидКвоты = АктуальныеКвоты.ВидКвоты
ГДЕ
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.РазмерКвоты &gt; 0
{ГДЕ
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.ВидКвоты.*,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.Должность.*,
	КвотыДляТрудоустройстваПоДолжностямСрезПоследних.Организация.*}</query>
