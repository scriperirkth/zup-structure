#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ТекущийКлючВарианта;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка) 
	
	Если ТекущийКлючВарианта = "ОтчетПоТрудоустройствуИнвалидов" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДокументРезультат.Очистить();
		
		НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
		ПараметрыДанных = НастройкиОтчета.ПараметрыДанных;
		
		ПараметрПериод = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодОтчета"));
		ПараметрОрганизация = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация")); 
		
		ПараметрыОтчета = Новый Структура;
		
		Если ПараметрПериод <> Неопределено Тогда
			Период = ПараметрПериод.Значение;
			ПараметрыОтчета.Вставить("НачалоПериодаОтчета", Период.ДатаНачала);
			ПараметрыОтчета.Вставить("КонецПериодаОтчета", Период.ДатаОкончания);
		КонецЕсли;
		Если ПараметрОрганизация <> Неопределено Тогда
			ПараметрыОтчета.Вставить("Организация", ПараметрОрганизация.Значение);
		КонецЕсли;
		
		СформироватьОтчетПоТрудоустройствуИнвалидов(ДокументРезультат, ПараметрыОтчета.Организация, ПараметрыОтчета.НачалоПериодаОтчета, ПараметрыОтчета.КонецПериодаОтчета);
		
		// Параметры документа
		ДокументРезультат.Автомасштаб 			= 	Истина;
		ДокументРезультат.ОриентацияСтраницы 	= 	ОриентацияСтраницы.Портрет;
		
	КонецЕсли; 
	
	Если ТекущийКлючВарианта = "АнализУчетаТрудоустройстваПоКвотам" Тогда 
		
		СтандартнаяОбработка = Ложь;
		
		ДокументРезультат.Очистить();
		
		НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
		ПараметрыДанных = НастройкиОтчета.ПараметрыДанных;
		
		ПараметрПериод = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодОтчета"));
		ПараметрОрганизация = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация")); 
		
		ТаблицаСотрудниковТрудоустроенныхПоКвотам = ТаблицаСотрудниковТрудоустроенныхПоКвотам(ПараметрОрганизация.Значение, ПараметрПериод.Значение.ДатаНачала, ПараметрПериод.Значение.ДатаОкончания); 
		ВнешнийНаборДанных = Новый Структура("ТаблицаСотрудниковТрудоустроенныхПоКвотам", ТаблицаСотрудниковТрудоустроенныхПоКвотам);
		
		ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
		
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешнийНаборДанных, ДанныеРасшифровки);

		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
	КонецЕсли;
	
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеДанных

Процедура СформироватьОтчетПоТрудоустройствуИнвалидов(ДокументРезультат, Организация, НачалоПериодаОтчета, КонецПериодаОтчета)
	
	УстановитьПривилегированныйРежим(Истина);

	Макет = УправлениеПечатью.МакетПечатнойФормы("Отчет.ТрудоустройствоПоКвотам.ОтчетПоТрудоустройствуИнвалидов");
	
	ОбластьРаздел1 = Макет.ПолучитьОбласть("Раздел1");
	ОбластьРаздел2 = Макет.ПолучитьОбласть("Раздел2");
	ОбластьТрудоустроенныеИнвалидыШапка = Макет.ПолучитьОбласть("ТрудоустроенныеИнвалидыШапка");	
	ОбластьТрудоустроенныеИнвалидыСтрока = Макет.ПолучитьОбласть("ТрудоустроенныеИнвалидыСтрока");
	ОбластьЛокальныеНормативныеАктыШапка = Макет.ПолучитьОбласть("ЛокальныеНормативныеАктыШапка");
	ОбластьЛокальныеНормативныеАктыСтрока = Макет.ПолучитьОбласть("ЛокальныеНормативныеАктыСтрока");
	ОбластьИное = Макет.ПолучитьОбласть("Иное");
	
	ОбластьРаздел1.Параметры.ДатаОтчета = ТекущаяДатаСеанса();
	
	ЗапрашиваемыеСведения = "
	|ИННЮЛ,
	|КППЮЛ,
	|ОКФС,
	|НаимЮЛПол,
	|ПолныйАдрЮР,
	|ОГРН,
	|ОКВЭД";
	СведенияОбОрганизации = ЗарплатаКадрыРасширенный.ПолучитьСведенияОбОрганизации(Организация);
		
	ЗаполнитьЗначенияСвойств(ОбластьРаздел1.Параметры, СведенияОбОрганизации); 
	
	ОбластьРаздел1.Параметры.ОКОПФ = СтрШаблон(НСтр("ru = '%1 %2'", ОбщегоНазначения.КодОсновногоЯзыка()), Организация.КодОКОПФ, Организация.НаименованиеОКОПФ);
	
	РазмерКвотыПоИнвалидамКоличество = 0;

	Если ТрудоустройствоПоКвотам.ИспользуетсяПланированиеКвотДляТрудоустройства() Тогда
		
		ДанныеОРазмерахКвот = ТрудоустройствоПоКвотам.ДанныеОРазмерахКвот(КонецПериодаОтчета, Организация);
		ДанныеОРазмерахКвотПоИнвалидам = ДанныеОРазмерахКвот.Скопировать(ДанныеОРазмерахКвот.НайтиСтроки(Новый Структура("ВидКвоты", Справочники.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов))); 
		РазмерКвотыПоИнвалидамКоличество = ДанныеОРазмерахКвотПоИнвалидам.Итог("РазмерКвоты");
		
	КонецЕсли;

	ОбластьРаздел1.Параметры.РазмерКвоты = РазмерКвотыПоИнвалидамКоличество; 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	МодульТрудоустройствоПоКвотам = ОбщегоНазначения.ОбщийМодуль("ТрудоустройствоПоКвотам"); 
	МодульТрудоустройствоПоКвотам.СоздатьВТДляЗаполненияОтчетности(Запрос, НачалоПериодаОтчета, КонецПериодаОтчета, Организация);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаОтчета);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаОтчета);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СреднесписочнаяЧисленностьДляРасчетаКвоты.ЧисленностьСотрудников - СреднесписочнаяЧисленностьДляРасчетаКвоты.ЧисленностьСотрудниковБезОпасныхВредныхУсловий КАК ЧисленностьОпасныеВредныеУсловияТруда,
	|	СреднесписочнаяЧисленностьДляРасчетаКвоты.СреднесписочнаяЧисленностьРаботниковБезОпасныхВредныхУсловий КАК СписочнаяЧисленностьДляРасчета,
	|	СреднесписочнаяЧисленностьДляРасчетаКвоты.ЧисленностьСотрудников КАК СписочнаяЧисленностьВсего,
	|	СреднесписочнаяЧисленностьДляРасчетаКвоты.Период КАК Период
	|ИЗ
	|	ВТСреднесписочнаяЧисленностьДляРасчетаКвоты КАК СреднесписочнаяЧисленностьДляРасчетаКвоты
	|ГДЕ
	|	СреднесписочнаяЧисленностьДляРасчетаКвоты.Период = &НачалоПериода";
	СреднесписочнаяЧисленность = Запрос.Выполнить().Выгрузить(); 
	Если СреднесписочнаяЧисленность.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ОбластьРаздел1.Параметры, СреднесписочнаяЧисленность[0]);
		РазмерКвотыПоИнвалидамПроцент = Цел(РазмерКвотыПоИнвалидамКоличество/СреднесписочнаяЧисленность[0].СписочнаяЧисленностьДляРасчета*100);
		ОбластьРаздел1.Параметры.РазмерКвотыПроцент = РазмерКвотыПоИнвалидамПроцент;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РаботалоВСчетКвотыИнвалидов.КоличествоСотрудников КАК РаботалоИнвалидов,
	|	РаботалоВСчетКвотыИнвалидов.Период КАК Период
	|ИЗ
	|	ВТРаботалоВСчетКвотыИнвалидов КАК РаботалоВСчетКвотыИнвалидов
	|ГДЕ
	|	РаботалоВСчетКвотыИнвалидов.Период = &НачалоПериода";
	ТрудоустройствоИнвалидов = Запрос.Выполнить().Выгрузить();
	Если ТрудоустройствоИнвалидов.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ОбластьРаздел1.Параметры, ТрудоустройствоИнвалидов[0]);
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьРаздел1); 
	ДокументРезультат.Вывести(ОбластьТрудоустроенныеИнвалидыШапка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеСотрудниковПоКвотам.Сотрудник КАК Сотрудник,
	|	ДанныеСотрудниковПоКвотам.ФИО КАК ФИО,
	|	ДанныеСотрудниковПоКвотам.СтраховойНомерПФР КАК СНИЛС,
	|	ДанныеСотрудниковПоКвотам.ДатаРождения КАК ДатаРождения,
	|	ДанныеСотрудниковПоКвотам.Должность КАК Должность,
	|	ДанныеСотрудниковПоКвотам.КатегорияКвоты КАК КатегорияКвоты,
	|	ДанныеСотрудниковПоКвотам.ИнвалидностьГруппаИнвалидности КАК ГруппаИнвалидности
	|ИЗ
	|	ВТКадровыеДанныеСотрудниковПоКвотам КАК ДанныеСотрудниковПоКвотам
	|ГДЕ
	|	ДанныеСотрудниковПоКвотам.ТрудоустроенПоКвоте
	|	И ДанныеСотрудниковПоКвотам.Период = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, 1), ДЕНЬ)
	|	И ДанныеСотрудниковПоКвотам.Организация = &Организация
	|	И ДанныеСотрудниковПоКвотам.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов)";
	;
	ДанныеСотрудниковПоКвотам = Запрос.Выполнить().Выгрузить();
	НомерПП = 0;
	Для Каждого СотрудникПоКвоте Из ДанныеСотрудниковПоКвотам Цикл 
		НомерПП = НомерПП + 1;
		ЗаполнитьЗначенияСвойств(ОбластьТрудоустроенныеИнвалидыСтрока.Параметры, СотрудникПоКвоте);
		ОбластьТрудоустроенныеИнвалидыСтрока.Параметры.НомерПоПорядку = НомерПП;
		ДокументРезультат.Вывести(ОбластьТрудоустроенныеИнвалидыСтрока);
	КонецЦикла;
	
	ТрудоустроеноИнвалидов = ДанныеСотрудниковПоКвотам.Количество(); 
	КоличествоСпециальныхРабочихМест = 0;
	ЗанятоСпециальныхРабочихМест = 0;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ОхранаТруда") Тогда
		
		МодульОхранаТруда = ОбщегоНазначения.ОбщийМодуль("ОхранаТруда");

		Если МодульОхранаТруда.ОхранаТрудаИспользуется() Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпециальныеРабочиеМестаВсего.КоличествоСпециальныхРабочихМест КАК КоличествоСпециальныхРабочихМест
			|ИЗ
			|	ВТСпециальныеРабочиеМестаВсего КАК СпециальныеРабочиеМестаВсего
			|ГДЕ
			|	СпециальныеРабочиеМестаВсего.Организация = &Организация"; 
			
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				КоличествоСпециальныхРабочихМест = РезультатЗапроса.Выгрузить()[0].КоличествоСпециальныхРабочихМест;
			КонецЕсли;
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпециальныеРабочиеМестаЗанято.ЗанятоСпециальныхРабочихМест КАК ЗанятоСпециальныхРабочихМест
			|ИЗ
			|	ВТСпециальныеРабочиеМестаЗанято КАК СпециальныеРабочиеМестаЗанято
			|ГДЕ
			|	СпециальныеРабочиеМестаЗанято.Организация = &Организация
			|	И СпециальныеРабочиеМестаЗанято.Период = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, 1), ДЕНЬ)"; 
			
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				ЗанятоСпециальныхРабочихМест = РезультатЗапроса.Выгрузить()[0].ЗанятоСпециальныхРабочихМест;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	ЗначенияПараметровРаздела2 = Новый Структура;
	ЗначенияПараметровРаздела2.Вставить("НеТрудоустроеноИнвалидов", Макс(РазмерКвотыПоИнвалидамКоличество - ТрудоустроеноИнвалидов,0));
	ЗначенияПараметровРаздела2.Вставить("КоличествоСпециальныхРабочихМест", КоличествоСпециальныхРабочихМест);
	ЗначенияПараметровРаздела2.Вставить("ЗанятоСпециальныхРабочихМест", ЗанятоСпециальныхРабочихМест);
	ЗначенияПараметровРаздела2.Вставить("СвободноСпециальныхРабочихМест", КоличествоСпециальныхРабочихМест - ЗанятоСпециальныхРабочихМест);
	ЗначенияПараметровРаздела2.Вставить("ТрудоустроеноИнвалидовСверхКвоты", Макс(ТрудоустроеноИнвалидов - РазмерКвотыПоИнвалидамКоличество,0));
	
	ЗаполнитьЗначенияСвойств(ОбластьРаздел2.Параметры, ЗначенияПараметровРаздела2); 
	
	ДокументРезультат.Вывести(ОбластьРаздел2); 
	
	ДокументРезультат.Вывести(ОбластьЛокальныеНормативныеАктыШапка);
	
	Если ТрудоустройствоПоКвотам.ИспользуетсяПланированиеКвотДляТрудоустройства() Тогда
		
		ДанныеОЛокальныхНормативныхАктах = ТрудоустройствоПоКвотам.ДанныеОЛокальныхНормативныхАктах(КонецПериодаОтчета, Организация); 
		ДанныеОЛокальныхНормативныхАктахПоИнвалидам = ДанныеОЛокальныхНормативныхАктах.Скопировать(ДанныеОЛокальныхНормативныхАктах.НайтиСтроки(Новый Структура("ВидКвоты", Справочники.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов))); 
		
		НомерПП = 0;
		Для Каждого ЛокальныйНормативныйАктПоИнвалидам Из ДанныеОЛокальныхНормативныхАктахПоИнвалидам Цикл 
			НомерПП = НомерПП + 1;
			ЗаполнитьЗначенияСвойств(ОбластьЛокальныеНормативныеАктыСтрока.Параметры, ЛокальныйНормативныйАктПоИнвалидам);
			ОбластьЛокальныеНормативныеАктыСтрока.Параметры.НомерПоПорядку = НомерПП;
			ДокументРезультат.Вывести(ОбластьЛокальныеНормативныеАктыСтрока);
		КонецЦикла; 
		
	Иначе
		
		ДокументРезультат.Вывести(ОбластьЛокальныеНормативныеАктыСтрока);
		
	КонецЕсли;	
	
	ДокументРезультат.Вывести(ОбластьИное);
	
КонецПроцедуры

Функция ТаблицаСотрудниковТрудоустроенныхПоКвотам(Организация, НачалоПериода, ОкончаниеПериода) 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ОкончаниеПериода));
	
	ПараметрыПолученияСотрудниковОрганизаций = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолученияСотрудниковОрганизаций.Организация = Организация;
	ПараметрыПолученияСотрудниковОрганизаций.НачалоПериода = НачалоПериода;
