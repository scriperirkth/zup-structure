	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОшибкаКатегорияКвоты,
	|	ВЫБОР
	|		КОГДА КадровыеДанныеСотрудников.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов)
	|			ТОГДА НЕ ЕСТЬNULL(КадровыеДанныеСотрудников.Инвалидность, ЛОЖЬ)
	|					ИЛИ ЕСТЬNULL(КадровыеДанныеСотрудников.ИнвалидностьСрокДействияСправки, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|						И КОНЕЦПЕРИОДА(ЕСТЬNULL(КадровыеДанныеСотрудников.ИнвалидностьСрокДействияСправки, ДАТАВРЕМЯ(1, 1, 1)), ДЕНЬ) <= ПериодыКадровыхДанных.ДатаОкончания
	|		КОГДА КадровыеДанныеСотрудников.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)
	|			ТОГДА ВЫБОР
	|					КОГДА КадровыеДанныеСотрудников.КатегорияКвоты = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.МолодежьСироты)
	|						ТОГДА КадровыеДанныеСотрудников.Возраст > 22
	|					КОГДА КадровыеДанныеСотрудников.КатегорияКвоты = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.МолодежьНесовершеннолетние)
	|						ТОГДА КадровыеДанныеСотрудников.Возраст > 17
	|					КОГДА КадровыеДанныеСотрудников.КатегорияКвоты = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.МолодежьВыпусникиВысшееОбразование)
	|						ТОГДА КадровыеДанныеСотрудников.Возраст > 25
	|					КОГДА КадровыеДанныеСотрудников.КатегорияКвоты = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.МолодежьВыпусникиНачальноеСреднееОбразование)
	|						ТОГДА КадровыеДанныеСотрудников.Возраст > 23
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОшибкаВидКвоты
	|ИЗ
	|	ВТКадровыеДанныеСотрудниковПоКвотам КАК КадровыеДанныеСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПериодыКадровыхДанных КАК ПериодыКадровыхДанных
	|		ПО КадровыеДанныеСотрудников.Сотрудник = ПериодыКадровыхДанных.Сотрудник
	|			И КадровыеДанныеСотрудников.Период = ПериодыКадровыхДанных.ДатаНачала
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПенсионныйВозраст КАК ПенсионныйВозраст
	|		ПО (ГОД(КадровыеДанныеСотрудников.ДатаРождения) = ПенсионныйВозраст.ГодРождения)
	|			И КадровыеДанныеСотрудников.Пол = ПенсионныйВозраст.Пол
	|ГДЕ
	|	(КадровыеДанныеСотрудников.ТрудоустроенПоКвоте
	|			ИЛИ КадровыеДанныеСотрудников.Инвалидность)"
	;

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Для общей формы "Форма отчета" подсистемы "Варианты отчетов".
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения схемы компоновки.
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	ТекущийКлючВарианта = КлючВарианта;
	
	Если ТекущийКлючВарианта = "АнализУчетаТрудоустройстваПоКвотам" Тогда
		
		ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, ПолучитьМакет("АнализУчетаТрудоустройстваПоКвотам"), КлючСхемы);
		НовыеНастройкиКД = СхемаКомпоновкиДанных.ВариантыНастроек.АнализУчетаТрудоустройстваПоКвотам.Настройки;
		
		КлючСхемы = КлючВарианта;
		
	Иначе	
		
		Если КлючСхемы <> КлючВарианта Тогда
			
			ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"), КлючСхемы);
			НовыеНастройкиКД = СхемаКомпоновкиДанных.ВариантыНастроек[ТекущийКлючВарианта].Настройки;
			
			КлючСхемы = КлючВарианта;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли


