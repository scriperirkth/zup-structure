Функция ОпределитьФормуВДеревеФормИФорматов(ДеревоФормИФорматов, Код, ДатаПриказа = '00010101', НомерПриказа = "", ИмяОбъекта = "",
			ДатаНачалаДействия = '00010101', ДатаОкончанияДействия = '00010101', Описание = "")
	
	НовСтр = ДеревоФормИФорматов.Строки.Добавить();
	НовСтр.Код = СокрЛП(Код);
	НовСтр.ДатаПриказа = ДатаПриказа;
	НовСтр.НомерПриказа = СокрЛП(НомерПриказа);
	НовСтр.ДатаНачалаДействия = ДатаНачалаДействия;
	НовСтр.ДатаОкончанияДействия = ДатаОкончанияДействия;
	НовСтр.ИмяОбъекта = СокрЛП(ИмяОбъекта);
	НовСтр.Описание = СокрЛП(Описание);
	Возврат НовСтр;
	
КонецФункции

#Область ПечатьУстаревших

Функция СформироватьСписокЛистов(Ссылка) Экспорт 
	РеквизитыКлюча = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ВыбраннаяФорма,ИсточникОтчета,Ссылка,ДанныеОтчета");
	Если РеквизитыКлюча.ВыбраннаяФорма = "ФормаОтчета2009Кв3" 
		Или РеквизитыКлюча.ВыбраннаяФорма = "ФормаОтчета2012Кв1" Тогда 
		Возврат СформироватьСписокЛистов_ФормаОтчета2009Кв3(РеквизитыКлюча);
	ИначеЕсли РеквизитыКлюча.ВыбраннаяФорма = "ФормаОтчета2013Кв3" Тогда 
		Возврат СформироватьСписокЛистов_ФормаОтчета2013Кв3(РеквизитыКлюча);
	ИначеЕсли РеквизитыКлюча.ВыбраннаяФорма = "ФормаОтчета2015Кв2"
		Или РеквизитыКлюча.ВыбраннаяФорма = "ФормаОтчета2017Кв1"
		Или РеквизитыКлюча.ВыбраннаяФорма = "ФормаОтчета2018Кв1" Тогда 
		Возврат СформироватьСписокЛистов_ФормаОтчета2015Кв2(РеквизитыКлюча);
	КонецЕсли;
КонецФункции

Функция СформироватьСписокЛистов_ФормаОтчета2009Кв3(РеквизитыКлюча)
	КонтекстПечати = РегламентированнаяОтчетность.КонтекстПечати(РеквизитыКлюча);
	МакетТабличногоДокумента = РегламентированнаяОтчетность.ПустойМакетИзСписка(
		КонтекстПечати.ИмяФормы, КонтекстПечати.СписокИспользуемыхМакетов, РеквизитыКлюча.ВыбраннаяФорма + "_ФормаОтчета");
	
	ДанныеОтчета = РеквизитыКлюча.ДанныеОтчета.Получить();
	Показатели = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаФормаОтчета;
	
	ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
	ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть1а"));
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть1б"));
	РегламентированнаяОтчетность.ПоказателиВОбласти(Показатели, ПечатнаяФорма);
	КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
	
	ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
	ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть2"));
	РегламентированнаяОтчетность.ПоказателиВОбласти(Показатели, ПечатнаяФорма);
	КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
	
	РегламентированнаяОтчетностьКлиентСервер.ПроставлениеНомеровЛистов(КонтекстПечати, , КонтекстПечати.СтруктураРеквизитовФормы.СписокПечатаемыхЛистов);
	Возврат КонтекстПечати.СтруктураРеквизитовФормы.СписокПечатаемыхЛистов;
КонецФункции 

Функция СформироватьСписокЛистов_ФормаОтчета2013Кв3(РеквизитыКлюча)
	КонтекстПечати = РегламентированнаяОтчетность.КонтекстПечати(РеквизитыКлюча);
	МакетТабличногоДокумента = РегламентированнаяОтчетность.ПустойМакетИзСписка(
		КонтекстПечати.ИмяФормы, КонтекстПечати.СписокИспользуемыхМакетов, РеквизитыКлюча.ВыбраннаяФорма + "_ФормаОтчета");
	
	ДанныеОтчета = РеквизитыКлюча.ДанныеОтчета.Получить();
	Показатели = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаФормаОтчета;
	
	ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
	ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть1а"));
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть1б"));
	РегламентированнаяОтчетность.ПоказателиВОбласти(Показатели, ПечатнаяФорма);
	КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
	
	ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
	ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть2"));
	РегламентированнаяОтчетность.ПоказателиВОбласти(Показатели, ПечатнаяФорма);
	КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
	
	Если ЗначениеЗаполнено(Показатели.ВывестиПриложениеНаПечать) Тогда 
		ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
		ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧастьПриложение1"));
		РегламентированнаяОтчетность.ПоказателиВОбласти(Показатели, ПечатнаяФорма);
		ПечатнаяФорма.Области.Приложение1Примечание1.Примечание.Текст = "";
		ПечатнаяФорма.Области.Приложение1Примечание2.Примечание.Текст = "";
		КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
	КонецЕсли;
	
	РегламентированнаяОтчетностьКлиентСервер.ПроставлениеНомеровЛистов(КонтекстПечати, , КонтекстПечати.СтруктураРеквизитовФормы.СписокПечатаемыхЛистов);
	Возврат КонтекстПечати.СтруктураРеквизитовФормы.СписокПечатаемыхЛистов;
КонецФункции 

Функция СформироватьСписокЛистов_ФормаОтчета2015Кв2(РеквизитыКлюча)
	КонтекстПечати = РегламентированнаяОтчетность.КонтекстПечати(РеквизитыКлюча);
	МакетТабличногоДокумента = РегламентированнаяОтчетность.ПустойМакетИзСписка(
		КонтекстПечати.ИмяФормы, КонтекстПечати.СписокИспользуемыхМакетов, РеквизитыКлюча.ВыбраннаяФорма + "_ФормаОтчета");
	
	ДанныеОтчета = РеквизитыКлюча.ДанныеОтчета.Получить();
	Показатели = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаФормаОтчета;
	
	ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
	ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть1а"));
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть1б"));
	РегламентированнаяОтчетность.ПоказателиВОбласти(Показатели, ПечатнаяФорма);
	КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
	
	ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
	ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть2"));
	РегламентированнаяОтчетность.ПоказателиВОбласти(Показатели, ПечатнаяФорма);
	КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
	
	ВывестиПриложениеНаПечать = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Показатели, "ВывестиПриложениеНаПечать", "V");
	Если ЗначениеЗаполнено(ВывестиПриложениеНаПечать) Тогда 
		Если МакетТабличногоДокумента.Области.Найти("ОсновнаяЧастьПриложение1") <> Неопределено Тогда 
			ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
			ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
			ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧастьПриложение1"));
			РегламентированнаяОтчетность.ПоказателиВОбласти(Показатели, ПечатнаяФорма);
			ПечатнаяФорма.Области.Приложение1Примечание1.Примечание.Текст = "";
			ПечатнаяФорма.Области.Приложение1Примечание2.Примечание.Текст = "";
			КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
		КонецЕсли;
		
		ПечатнаяФорма = РегламентированнаяОтчетность.НоваяСтраница();
		ПечатнаяФорма.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть3_1"));
		МнгСтр = МакетТабличногоДокумента.ПолучитьОбласть("МногострочнаяЧасть1").ПолучитьОбласть(1, , 1, );
		Инд = 0;
		Пока Истина Цикл 
			Инд = Инд + 1;
			Если Не Показатели.Свойство("П000102000101_" + Инд) Тогда 
				Прервать;
			КонецЕсли;
			
			МнгСтр = МакетТабличногоДокумента.ПолучитьОбласть("МногострочнаяЧасть1").ПолучитьОбласть(1, , 1, );
			Область = МнгСтр.Области.Найти("УдалитьСтрокуП000102000101_1");
			Область.Текст = "";
			Область.Гиперссылка = Ложь;
			
			Для Итер = 1 По 12 Цикл 
				ИтерСтр = Формат(Итер, "ЧЦ=2; ЧВН=");
				Область = МнгСтр.Области.Найти("П0001020001" + ИтерСтр + "_1");
				Если Область = Неопределено Тогда 
					Прервать;
				КонецЕсли;
				Показатели.Свойство("П0001020001" + ИтерСтр + "_" + Инд, Область.Значение);
			КонецЦикла;
			ПечатнаяФорма.Вывести(МнгСтр);
		КонецЦикла;
		
		ПечатнаяФорма.Вывести(МакетТабличногоДокумента.ПолучитьОбласть("ОсновнаяЧасть3_2"));
		КонтекстПечати.СтруктураРеквизитовФормы.мПечатныеФормы.Добавить(ПечатнаяФорма, "Форма 1-квотирование (Москва)");
	КонецЕсли;
	
	РегламентированнаяОтчетностьКлиентСервер.ПроставлениеНомеровЛистов(КонтекстПечати, , КонтекстПечати.СтруктураРеквизитовФормы.СписокПечатаемыхЛистов);
	Возврат КонтекстПечати.СтруктураРеквизитовФормы.СписокПечатаемыхЛистов;
КонецФункции 

