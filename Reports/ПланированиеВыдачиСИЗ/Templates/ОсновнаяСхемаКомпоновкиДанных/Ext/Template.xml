////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДАТАВРЕМЯ(1, 1, 1) КАК Период,
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Сотрудник,
	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ФизическоеЛицо,
	"" КАК Возраст,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПриема,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаУвольнения,
	ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка) КАК Должность,
	ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка) КАК РабочееМестоОхраныТруда,
	ДАТАВРЕМЯ(1, 1, 1) КАК РабочееМестоОхраныТрудаПериодРегистрации,
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ГоловнаяОрганизация,
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка) КАК Подразделение,
	ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ПустаяСсылка) КАК ВидЗанятости
ПОМЕСТИТЬ Представления_СотрудникиОрганизации
ИЗ
	ВТФизическиеЛица КАК ФизическиеЛица
ГДЕ
	"ТолькоРазрешенные" = ИСТИНА
	И "ОтбиратьПоГоловнойОрганизации" = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Представления_СотрудникиОрганизации.Период КАК Период,
	Представления_СотрудникиОрганизации.Сотрудник КАК Сотрудник,
	Представления_СотрудникиОрганизации.ФизическоеЛицо КАК ФизическоеЛицо,
	Представления_СотрудникиОрганизации.Возраст КАК Возраст,
	Представления_СотрудникиОрганизации.Организация КАК Организация,
	Представления_СотрудникиОрганизации.Подразделение КАК Подразделение,
	Представления_СотрудникиОрганизации.Должность КАК Должность,
	Представления_СотрудникиОрганизации.ДатаУвольнения КАК ДатаУвольнения,
	Представления_СотрудникиОрганизации.ВидЗанятости КАК ВидЗанятости,
	Представления_СотрудникиОрганизации.РабочееМестоОхраныТрудаПериодРегистрации КАК
		РабочееМестоОхраныТрудаПериодРегистрации,
	СИЗРабочегоМеста.РабочееМесто КАК РабочееМесто,
	СИЗРабочегоМеста.СИЗ КАК СИЗ,
	СИЗРабочегоМеста.СпособВыдачи КАК СпособВыдачи,
	СИЗРабочегоМеста.Количество КАК Количество,
	СИЗРабочегоМеста.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	СИЗРабочегоМеста.ПредставлениеПериодичностиВыдачи КАК ПредставлениеПериодичностиВыдачи,
	СИЗРабочегоМеста.КратностьВыдачи КАК КратностьВыдачи,
	СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичностиВыдачи,
	СИЗРабочегоМеста.ПериодичностьВыдачи КАК ПериодичностьВыдачи
ПОМЕСТИТЬ ВТСИЗСотрудников
ИЗ
	РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Представления_СотрудникиОрганизации КАК Представления_СотрудникиОрганизации
		ПО СИЗРабочегоМеста.РабочееМесто = Представления_СотрудникиОрганизации.РабочееМестоОхраныТруда
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОхраныТруда КАК НастройкиОхраныТруда
		ПО Представления_СотрудникиОрганизации.Организация = НастройкиОхраныТруда.Организация
		И ((НЕ НастройкиОхраныТруда.ИспользоватьРабочиеМестаОхраныТруда)
		ИЛИ (НЕ НастройкиОхраныТруда.ИспользоватьСредстваИндивидуальнойЗащиты))
ГДЕ
	НастройкиОхраныТруда.ИспользоватьРабочиеМестаОхраныТруда ЕСТЬ NULL
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо КАК ФизическоеЛицо,
	ВыдачиСИЗПоНоменклатуре.РабочееМесто КАК РабочееМесто,
	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
	МАКСИМУМ(ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи) КАК ДатаСледующейВыдачи,
	МАКСИМУМ(ВыдачиСИЗПоНоменклатуре.Период) КАК ДатаВыдачи
ПОМЕСТИТЬ ВТВыдачиСИЗПоНоменклатуре
ИЗ
	РегистрСведений.ВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
СГРУППИРОВАТЬ ПО
	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо,
	ВыдачиСИЗПоНоменклатуре.РабочееМесто,
	ВыдачиСИЗПоНоменклатуре.СИЗ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СИЗСотрудников.Период КАК Период,
	СИЗСотрудников.Сотрудник КАК Сотрудник,
	СИЗСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	СИЗСотрудников.Возраст КАК Возраст,
	СИЗСотрудников.РабочееМесто КАК РабочееМесто,
	СИЗСотрудников.Организация КАК Организация,
	СИЗСотрудников.Подразделение КАК Подразделение,
	СИЗСотрудников.Должность КАК Должность,
	СИЗСотрудников.ДатаУвольнения КАК ДатаУвольнения,
	СИЗСотрудников.ВидЗанятости КАК ВидЗанятости,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи, СИЗСотрудников.РабочееМестоОхраныТрудаПериодРегистрации) &lt; &amp;НачалоПериода
			ТОГДА &amp;НачалоПериода
		ИНАЧЕ ЕСТЬNULL(ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи, СИЗСотрудников.РабочееМестоОхраныТрудаПериодРегистрации)
	КОНЕЦ КАК ДатаСледующейВыдачи,
	ВЫБОР
		КОГДА ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ТОГДА ИСТИНА
		КОГДА ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи &lt; &amp;НачалоПериода
				И &amp;НачалоПериода &gt;= &amp;Сегодня
			ТОГДА ИСТИНА
		КОГДА ЕСТЬNULL(ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
				И СИЗСотрудников.РабочееМестоОхраныТрудаПериодРегистрации &lt;= &amp;КонецПериода
				И НЕ СИЗСотрудников.РабочееМестоОхраныТрудаПериодРегистрации = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СледующаяВыдачаВВыбранномПериоде,
	ВыдачиСИЗПоНоменклатуре.ДатаВыдачи КАК ДатаВыдачи,
	СИЗСотрудников.ПредставлениеПериодичностиВыдачи КАК ПредставлениеПериодичностиВыдачи,
	СИЗСотрудников.СИЗ КАК СИЗ,
	СИЗСотрудников.СИЗ.НоменклатураПоУмолчанию КАК НоменклатураПоУмолчанию,
	СИЗСотрудников.СпособВыдачи КАК СпособВыдачи,
	СИЗСотрудников.Количество КАК Количество,
	СИЗСотрудников.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	СИЗСотрудников.КратностьВыдачи КАК КратностьВыдачи,
	СИЗСотрудников.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичностиВыдачи,
	СИЗСотрудников.ПериодичностьВыдачи КАК ПериодичностьВыдачи,
	ВЫБОР
		КОГДА СИЗСотрудников.Сотрудник ЕСТЬ НЕ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СотрудникВыбран
ИЗ
	ВТСИЗСотрудников КАК СИЗСотрудников
		{ЛЕВОЕ СОЕДИНЕНИЕ ВТВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
