		<dataSource>Информационная база</dataSource>
		<query>ВЫБРАТЬ
	ВыданныеСИЗ.ФизическоеЛицо КАК ФизическоеЛицо,
	ВыданныеСИЗ.СИЗ КАК СИЗНоменклатуры,
	ВыданныеСИЗ.Номенклатура КАК Номенклатура,
	ВыданныеСИЗ.ДокументВыдачи КАК ДокументВыдачи,
	СУММА(ВЫБОР
			КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
				ТОГДА ВыданныеСИЗ.Количество
			ИНАЧЕ 0
		КОНЕЦ) КАК Выдано,
	СУММА(ВЫБОР
			КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				ТОГДА ВыданныеСИЗ.Количество
			ИНАЧЕ 0
		КОНЕЦ) КАК Возвращено,
	МАКСИМУМ(ВЫБОР
			КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
				ТОГДА ВыданныеСИЗ.Период
			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		КОНЕЦ) КАК ДатаВыдачи,
	МАКСИМУМ(ВЫБОР
			КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				ТОГДА ВыданныеСИЗ.Период
			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		КОНЕЦ) КАК ДатаВозврата,
	МАКСИМУМ(ВЫБОР
			КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				ТОГДА ВЫРАЗИТЬ(ВыданныеСИЗ.Регистратор КАК Документ.СписаниеСИЗИзЭксплуатации).НомерПриказа
			ИНАЧЕ ""
		КОНЕЦ) КАК НомерПриказаАктаСписания,
	МАКСИМУМ(ВЫБОР
			КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				ТОГДА ВЫРАЗИТЬ(ВыданныеСИЗ.Регистратор КАК Документ.СписаниеСИЗИзЭксплуатации).Номер
			ИНАЧЕ ""
		КОНЕЦ) КАК НомерАктаСписания,
	МАКСИМУМ(ВЫБОР
			КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
				ТОГДА ВыданныеСИЗ.Дежурное
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ) КАК ДежурноеВыдачи
ИЗ
	РегистрНакопления.ВыданныеСИЗ КАК ВыданныеСИЗ

СГРУППИРОВАТЬ ПО
	ВыданныеСИЗ.ФизическоеЛицо,
	ВыданныеСИЗ.СИЗ,
	ВыданныеСИЗ.Номенклатура,
	ВыданныеСИЗ.ДокументВыдачи</query>
