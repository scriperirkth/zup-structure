#Область ИнтеграцияСОблачнойОтчетностью

// Функция определяет отображение кнопки "Заполнить" в облачной отчетности
// 
// Параметры:
//  ИДРедакцииОтчета - Строка
// 
// Возвращаемое значение:
//  Булево - Релизована поддержка заполнения в облачной отчетности
Функция РелизованаПоддержкаЗаполненияВОблачнойОтчетности(ИДРедакцииОтчета) Экспорт
	
	МассивПоддерживаемых = Новый Массив(); // Массив Из Строка
	МассивПоддерживаемых.Добавить("ФормаОтчета2015Кв3");
	МассивПоддерживаемых.Добавить("ФормаОтчета2011Кв4");
	МассивПоддерживаемых.Добавить("ФормаОтчета2010Кв1");
	
	
	Возврат МассивПоддерживаемых.Найти(ИДРедакцииОтчета) <> Неопределено;
	
КонецФункции

// Функция определяет отображение кнопки "Расшифровать" в облачной отчетности
//
// Параметры:
