		<query>ВЫБРАТЬ
	Наставничество.Организация КАК Организация,
	Наставничество.Наставник КАК Наставник,
	Наставничество.Регистратор КАК Регистратор,
	Наставничество.Наставляемый КАК Наставляемый,
	Наставничество.ДатаОкончания КАК ДатаОкончания,
	Наставничество.ДокументОснование КАК ДокументОснование,
	Наставничество.ПозицияРезерва КАК ПозицияРезерва
ПОМЕСТИТЬ ВТЗавершениеНаставничества
ИЗ
	РегистрСведений.Наставничество КАК Наставничество
ГДЕ
	НЕ Наставничество.Назначен
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	КОНЕЦПЕРИОДА(&amp;ПериодКадровыхДанных, ДЕНЬ) КАК Период,
	Наставничество.Наставник КАК Сотрудник
ПОМЕСТИТЬ ВТСотрудники
ИЗ
	РегистрСведений.Наставничество КАК Наставничество

ОБЪЕДИНИТЬ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	КОНЕЦПЕРИОДА(&amp;ПериодКадровыхДанных, ДЕНЬ),
	Наставничество.Наставляемый
ИЗ
	РегистрСведений.Наставничество КАК Наставничество
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Сотрудник,
	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ФизическоеЛицо,
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка) КАК Подразделение,
	ЗНАЧЕНИЕ(Справочник.ШтатноеРасписание.ПустаяСсылка) КАК ДолжностьПоШтатномуРасписанию,
	ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка) КАК Должность,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаУвольнения,
	ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ПустаяСсылка) КАК ВидЗанятости,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПриема,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаРождения,
	ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.ПустаяСсылка) КАК Состояние,
	ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.ПустаяСсылка) КАК Пол,
	ЗНАЧЕНИЕ(Справочник.РазрядыКатегорииДолжностей.ПустаяСсылка) КАК РазрядКатегория,
	ЗНАЧЕНИЕ(Справочник.УченыеСтепени.ПустаяСсылка) КАК УченаяСтепень,
	ЗНАЧЕНИЕ(Справочник.УченыеЗвания.ПустаяСсылка) КАК УченоеЗвание,
	"" КАК ПолученныеОбразования,
	0 КАК ОбщийСтажЛет,
	0 КАК Возраст
ПОМЕСТИТЬ Представления_КадровыеДанныеСотрудников
ИЗ
	ВТСотрудники КАК ВТСотрудники
ГДЕ
	"ТолькоРазрешенные" = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Наставничество.Организация КАК Организация,
	Наставничество.Наставник КАК Наставник,
	Наставничество.Наставляемый КАК Наставляемый,
	Наставничество.ДокументОснование КАК ДокументНазначения,
	Наставничество.ДатаНачала КАК ДатаНачала,
	ЕСТЬNULL(ВТЗавершениеНаставничества.ДатаОкончания, Наставничество.ДатаОкончания) КАК ДатаОкончания,
	ЕСТЬNULL(ВТЗавершениеНаставничества.Регистратор, НЕОПРЕДЕЛЕНО) КАК ПрекращениеНаставничества,
	ЕСТЬNULL(КадровыеДанныеНаставников.Подразделение, ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)) КАК НаставникПодразделение,
	ЕСТЬNULL(КадровыеДанныеНаставников.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК НаставникДолжность,
	ЕСТЬNULL(КадровыеДанныеНаставляемых.Подразделение, ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)) КАК НаставляемыйПодразделение,
	ЕСТЬNULL(КадровыеДанныеНаставляемых.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК НаставляемыйДолжность,
	ЕСТЬNULL(КадровыеДанныеНаставляемых.ДатаПриема, ДАТАВРЕМЯ(1, 1, 1)) КАК НаставляемыйДатаПриема,
	ЕСТЬNULL(КадровыеДанныеНаставляемых.ДатаУвольнения, ДАТАВРЕМЯ(1, 1, 1)) КАК НаставляемыйДатаУвольнения
ИЗ
	РегистрСведений.Наставничество КАК Наставничество
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НазначениеНаставника КАК НазначениеНаставника
		ПО Наставничество.Регистратор = НазначениеНаставника.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗавершениеНаставничества КАК ВТЗавершениеНаставничества
		ПО (Наставничество.Регистратор = ВТЗавершениеНаставничества.ДокументОснование
				ИЛИ НЕ ВЫРАЗИТЬ(НазначениеНаставника.Начисление КАК ПланВидовРасчета.Начисления).ПоддерживаетНесколькоПлановыхНачислений)
			И Наставничество.Организация = ВТЗавершениеНаставничества.Организация
			И Наставничество.Наставник = ВТЗавершениеНаставничества.Наставник
			И Наставничество.Наставляемый = ВТЗавершениеНаставничества.Наставляемый
			И Наставничество.ПозицияРезерва = ВТЗавершениеНаставничества.ПозицияРезерва
		ЛЕВОЕ СОЕДИНЕНИЕ Представления_КадровыеДанныеСотрудников КАК КадровыеДанныеНаставников
		ПО Наставничество.Наставник = КадровыеДанныеНаставников.Сотрудник
		ЛЕВОЕ СОЕДИНЕНИЕ Представления_КадровыеДанныеСотрудников КАК КадровыеДанныеНаставляемых
		ПО Наставничество.Наставляемый = КадровыеДанныеНаставляемых.Сотрудник
ГДЕ
	Наставничество.Назначен
	И ВЫБОР
			КОГДА &amp;ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ Наставничество.ДатаНачала &gt;= НАЧАЛОПЕРИОДА(&amp;ДатаНачала, ДЕНЬ)
					ИЛИ ЕСТЬNULL(ВТЗавершениеНаставничества.ДатаОкончания, Наставничество.ДатаОкончания) &gt;= НАЧАЛОПЕРИОДА(&amp;ДатаНачала, ДЕНЬ)
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ Наставничество.ДатаНачала &lt;= НАЧАЛОПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
					ИЛИ ЕСТЬNULL(ВТЗавершениеНаставничества.ДатаОкончания, Наставничество.ДатаОкончания) &lt;= НАЧАЛОПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
						И НЕ ЕСТЬNULL(ВТЗавершениеНаставничества.ДатаОкончания, Наставничество.ДатаОкончания) = ДАТАВРЕМЯ(1, 1, 1)
		КОНЕЦ
{ГДЕ
	(Наставничество.Наставник = &amp;УчастникПроцессаНаставничества
			ИЛИ ВЫРАЗИТЬ(Наставничество.Наставник КАК Справочник.Сотрудники).ФизическоеЛицо = &amp;УчастникПроцессаНаставничества
			ИЛИ ВЫРАЗИТЬ(Наставничество.Наставляемый КАК Справочник.Сотрудники).ФизическоеЛицо = &amp;УчастникПроцессаНаставничества
			ИЛИ Наставничество.Наставляемый = &amp;УчастникПроцессаНаставничества)}</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<calculatedField>
		<dataPath>СтажРаботыВОрганизации</dataPath>
		<expression>Выбор Когда ДанныеНаставляемого.ДатаУвольнения = ДатаВремя(1,1,1) Тогда Наставничество.ПредставлениеРазницыДатВГодахМесяцах(ДанныеНаставляемого.ДатаПриема, ТекущаяДатаСеанса()) Иначе  Наставничество.ПредставлениеРазницыДатВГодахМесяцах(ДанныеНаставляемого.ДатаПриема, ДанныеНаставляемого.ДатаУвольнения) Конец</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Стаж работы в организации</v8:content>
			</v8:item>
		</title>
	</calculatedField>
