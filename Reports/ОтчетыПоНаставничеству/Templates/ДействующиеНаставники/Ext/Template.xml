		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	НаставничествоСрезПоследних.Организация КАК Организация,
	НаставничествоСрезПоследних.Наставник КАК Наставник,
	НаставничествоСрезПоследних.ДатаНачала КАК ДатаНачала,
	НаставничествоСрезПоследних.ДатаОкончания КАК ДатаОкончания,
	НаставничествоСрезПоследних.Регистратор КАК ДокументОснование,
	НаставничествоСрезПоследних.Наставляемый КАК Наставляемый,
	НаставничествоСрезПоследних.ПозицияРезерва КАК ПозицияРезерва,
	ЕСТЬNULL(НазначениеНаставника.НазначитьДоплату, ЛОЖЬ) КАК НазначитьДоплату,
	ЕСТЬNULL(НазначениеНаставника.Начисление, ЗНАЧЕНИЕ(ПланВидовРасчета.Начисления.ПустаяСсылка)) КАК Начисление
ПОМЕСТИТЬ ВТДействующиеНаставники
ИЗ
	РегистрСведений.Наставничество.СрезПоследних(&amp;НаДату, НЕ Регистратор = &amp;ИсключитьДвиженияДокумента) КАК НаставничествоСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НазначениеНаставника КАК НазначениеНаставника
		ПО НаставничествоСрезПоследних.Регистратор = НазначениеНаставника.Ссылка
ГДЕ
	НаставничествоСрезПоследних.Назначен
	И (НаставничествоСрезПоследних.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ КОНЕЦПЕРИОДА(НаставничествоСрезПоследних.ДатаОкончания, ДЕНЬ) &gt;= &amp;НаДату)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	&amp;ПериодОтчета КАК Период,
	ДействующиеНаставники.Наставник КАК Сотрудник
ПОМЕСТИТЬ ВТСотрудники
ИЗ
	ВТДействующиеНаставники КАК ДействующиеНаставники

ОБЪЕДИНИТЬ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	&amp;ПериодОтчета,
	ДействующиеНаставники.Наставляемый
ИЗ
	ВТДействующиеНаставники КАК ДействующиеНаставники
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Сотрудник,
	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ФизическоеЛицо,
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка) КАК Подразделение,
	ЗНАЧЕНИЕ(Справочник.ШтатноеРасписание.ПустаяСсылка) КАК ДолжностьПоШтатномуРасписанию,
	ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка) КАК Должность,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаУвольнения,
	ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ПустаяСсылка) КАК ВидЗанятости,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПриема,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаРождения,
	ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.ПустаяСсылка) КАК Состояние,
	ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.ПустаяСсылка) КАК Пол,
	ЗНАЧЕНИЕ(Справочник.РазрядыКатегорииДолжностей.ПустаяСсылка) КАК РазрядКатегория,
	ЗНАЧЕНИЕ(Справочник.УченыеСтепени.ПустаяСсылка) КАК УченаяСтепень,
	ЗНАЧЕНИЕ(Справочник.УченыеЗвания.ПустаяСсылка) КАК УченоеЗвание,
	"" КАК ПолученныеОбразования,
	0 КАК ОбщийСтажЛет,
	0 КАК Возраст
ПОМЕСТИТЬ Представления_КадровыеДанныеСотрудников
ИЗ
	ВТСотрудники КАК ВТСотрудники
ГДЕ
	"ТолькоРазрешенные" = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТДействующиеНаставники.Организация КАК Организация,
	ВТДействующиеНаставники.Наставник КАК Наставник,
	ВТДействующиеНаставники.ДатаНачала КАК ДатаНачала,
	ВТДействующиеНаставники.ДатаОкончания КАК ДатаОкончания,
	ВТДействующиеНаставники.ДокументОснование КАК ДокументОснование,
	ВТДействующиеНаставники.Наставляемый КАК Наставляемый,
	ЕСТЬNULL(КадровыеДанныеНаставников.Подразделение, ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)) КАК НаставникПодразделение,
	ЕСТЬNULL(КадровыеДанныеНаставников.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК НаставникДолжность,
	ЕСТЬNULL(КадровыеДанныеНаставляемых.ДатаПриема, ДАТАВРЕМЯ(1, 1, 1)) КАК НаставляемыйДатаПриема,
	ЕСТЬNULL(КадровыеДанныеНаставляемых.Подразделение, ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)) КАК НаставляемыйПодразделение,
	ЕСТЬNULL(КадровыеДанныеНаставляемых.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК НаставляемыйДолжность,
	ВТДействующиеНаставники.ПозицияРезерва КАК ПозицияРезерва,
	ВТДействующиеНаставники.НазначитьДоплату КАК НазначитьДоплату,
	ВТДействующиеНаставники.Начисление КАК Начисление
ИЗ
	ВТДействующиеНаставники КАК ВТДействующиеНаставники
		ЛЕВОЕ СОЕДИНЕНИЕ Представления_КадровыеДанныеСотрудников КАК КадровыеДанныеНаставников
		ПО ВТДействующиеНаставники.Наставник = КадровыеДанныеНаставников.Сотрудник
		ЛЕВОЕ СОЕДИНЕНИЕ Представления_КадровыеДанныеСотрудников КАК КадровыеДанныеНаставляемых
		ПО ВТДействующиеНаставники.Наставляемый = КадровыеДанныеНаставляемых.Сотрудник</query>
