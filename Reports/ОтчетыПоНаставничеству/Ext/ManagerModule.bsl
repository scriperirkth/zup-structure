// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ПодборНаставников");
	НастройкиВарианта.Описание = НСтр("ru = 'Подбор наставников'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ИсторияНаставничества");
	НастройкиВарианта.Описание = НСтр("ru = 'История осуществления наставничества.'");

	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ДействующиеНаставники");
	НастройкиВарианта.Описание = НСтр("ru = 'Действующие наставники.'");

КонецПроцедуры

