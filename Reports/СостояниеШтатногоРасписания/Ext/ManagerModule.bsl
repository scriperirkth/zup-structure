// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "АнализШтатногоРасписания");
	НастройкиВарианта.Описание =
		НСтр("ru = 'План-фактный анализ штатного расписания, как по ставкам, так и по ФОТ.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "СоблюдениеШтатногоРасписания");
	НастройкиВарианта.Описание =
		НСтр("ru = 'Сопоставление штатного расписания и фактически занятых позиций 
		|штатного расписания. ""Перерасход"" ставок отображается красным.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ЗаполненностьШтатногоРасписания");
	НастройкиВарианта.Описание = НСтр("ru = 'Информация о занятых и свободных ставках по штатному расписанию.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ШтатнаяРасстановка");
	НастройкиВарианта.Описание = НСтр("ru = 'Информация о занятых ставках и состоянии сотрудников.'");
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ФормаОтчетаПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт

	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы("ХранилищеРезультатаОтчета", Новый ОписаниеТипов("Строка")); 
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Добавление команд на командную панель.
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИсториюИзмененияШтатногоРасписания")
		И ПравоДоступа("Добавление", Метаданные.Документы.ИзменениеШтатногоРасписания) Тогда
		Команда = Форма.Команды.Добавить("ИзменитьПозицииШР");
		Команда.Действие  = "Подключаемый_Команда";
		Команда.Заголовок = НСтр("ru = 'Изменить позиции штатного расписания'");
		Команда.Подсказка = НСтр("ru = 'Изменить выбранные позиции штатного расписания'");
		Команда.Картинка  = БиблиотекаКартинок.Документ;
		Команда.Отображение = ОтображениеКнопки.КартинкаИТекст;
		Если Форма.ИмяФормы = "Отчет.СостояниеШтатногоРасписания.Форма" Тогда
			ОтчетыСервер.ВывестиКоманду(Форма, Команда, "Настройки");
		Иначе
			Элемент = Форма.Элементы.Вставить("ИзменитьПозицииШР", Тип("КнопкаФормы"), Форма.Элементы.ОсновнаяКоманднаяПанель);
			Элемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			Элемент.ИмяКоманды = "ИзменитьПозицииШР"; 
		КонецЕсли;
		
		ОбновитьВидимостьДоступностьЭлементовФормы(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьВидимостьДоступностьЭлементовФормы(Форма) Экспорт
	
	Команда = Форма.Элементы.Найти("ИзменитьПозицииШР");
	Если Команда <> Неопределено Тогда
		Команда.Видимость = (Форма.КлючТекущегоВарианта = "АнализШтатногоРасписания");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли