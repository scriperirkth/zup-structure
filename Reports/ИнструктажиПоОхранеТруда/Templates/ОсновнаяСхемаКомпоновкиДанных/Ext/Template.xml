		<field xsi:type="DataSetFieldField">
			<dataPath>РабочееМесто</dataPath>
			<field>РабочееМесто</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	&amp;ДатаОкончания КАК Период,
	Сотрудники.Ссылка КАК Сотрудник
ПОМЕСТИТЬ ВТСотрудники
ИЗ
	Справочник.Сотрудники КАК Сотрудники
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ГоловнаяОрганизация,
	"" КАК ТабельныйНомер,
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Сотрудник,
	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ФизическоеЛицо,
	ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка) КАК Подразделение,
	ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка) КАК Должность,
	ЗНАЧЕНИЕ(Справочник.ШтатноеРасписание.ПустаяСсылка) КАК ДолжностьПоШтатномуРасписанию,
	ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка) КАК РабочееМестоОхраныТруда,
	ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ПустаяСсылка) КАК ВидЗанятости,
	ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.ПустаяСсылка) КАК ВидСобытия
ПОМЕСТИТЬ Представления_КадровыеДанныеСотрудников
ИЗ
	ВТСотрудники КАК ВТСотрудники
ГДЕ
	"ТолькоРазрешенные" = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВидыИнструктажейПоОхранеТруда.Ссылка КАК Инструктаж,
	ВидыИнструктажейПоОхранеТруда.ИспользоватьДляВсехРабочихМест КАК ИспользоватьДляВсехРабочихМест,
	ВидыИнструктажейПоОхранеТруда.КонтролироватьСменуРабочегоМеста КАК КонтролироватьСменуРабочегоМеста,
	ВидыИнструктажейПоОхранеТруда.ПроводитсяПовторно КАК ПроводитсяПовторно
ПОМЕСТИТЬ ВТВидыИнструктажей
ИЗ
	Справочник.ВидыИнструктажейПоОхранеТруда КАК ВидыИнструктажейПоОхранеТруда
ГДЕ
	ВидыИнструктажейПоОхранеТруда.КонтролироватьПроведение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИнструктажиПоОхранеТруда.Регистратор КАК Документ,
	ИнструктажиПоОхранеТруда.Период КАК ДатаПроведения,
	ИнструктажиПоОхранеТруда.ВидИнструктажа КАК ВидИнструктажа,
	ИнструктажиПоОхранеТруда.РабочееМесто КАК РабочееМесто,
	ИнструктажиПоОхранеТруда.Сотрудник КАК Сотрудник,
	ИнструктажиПоОхранеТруда.СрокДействия КАК СрокДействия
ПОМЕСТИТЬ ВТИнструктажи
ИЗ
	РегистрСведений.ИнструктажиПоОхранеТруда.СрезПоследних({(&amp;ДатаОкончания)}, ) КАК ИнструктажиПоОхранеТруда
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВидыИнструктажей.Инструктаж КАК Инструктаж,
	ВидыИнструктажей.КонтролироватьСменуРабочегоМеста КАК КонтролироватьСменуРабочегоМеста,
	ВидыИнструктажейПоОхранеТрудаРабочиеМеста.РабочееМесто КАК РабочееМесто
ПОМЕСТИТЬ ВТРабочиеМеста
ИЗ
	ВТВидыИнструктажей КАК ВидыИнструктажей
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыИнструктажейПоОхранеТруда.РабочиеМеста КАК ВидыИнструктажейПоОхранеТрудаРабочиеМеста
		ПО ВидыИнструктажей.Инструктаж = ВидыИнструктажейПоОхранеТрудаРабочиеМеста.Ссылка

СГРУППИРОВАТЬ ПО
	ВидыИнструктажей.Инструктаж,
	ВидыИнструктажей.КонтролироватьСменуРабочегоМеста,
	ВидыИнструктажейПоОхранеТрудаРабочиеМеста.РабочееМесто

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВидыИнструктажей.Инструктаж,
	ВидыИнструктажей.КонтролироватьСменуРабочегоМеста,
	ЕСТЬNULL(КадровыеДанныеСотрудников.РабочееМестоОхраныТруда, ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка))
ИЗ
	ВТВидыИнструктажей КАК ВидыИнструктажей
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Представления_КадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
		ПО (ВидыИнструктажей.ИспользоватьДляВсехРабочихМест)

СГРУППИРОВАТЬ ПО
	ВидыИнструктажей.Инструктаж,
	ВидыИнструктажей.КонтролироватьСменуРабочегоМеста,
	ЕСТЬNULL(КадровыеДанныеСотрудников.РабочееМестоОхраныТруда, ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КадровыеДанныеСотрудников.Организация КАК Организация,
	КадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
	КадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	КадровыеДанныеСотрудников.Подразделение КАК Подразделение,
	КадровыеДанныеСотрудников.Должность КАК Должность,
	КадровыеДанныеСотрудников.ДолжностьПоШтатномуРасписанию КАК ДолжностьПоШтатномуРасписанию,
	КадровыеДанныеСотрудников.РабочееМестоОхраныТруда КАК РабочееМестоОхраныТруда,
	РабочиеМеста.Инструктаж КАК Инструктаж,
	Инструктажи.Документ КАК Документ,
	Инструктажи.ДатаПроведения КАК ДатаПроведения,
	Инструктажи.СрокДействия КАК СрокДействия,
	ВидыИнструктажей.ПроводитсяПовторно КАК ПроводитсяПовторно,
	ВЫБОР
		КОГДА ЕСТЬNULL(Инструктажи.СрокДействия, ДАТАВРЕМЯ(1, 1, 1)) &lt; &amp;ДатаОкончания
					И ВидыИнструктажей.ПроводитсяПовторно
				ИЛИ НЕ ВидыИнструктажей.ПроводитсяПовторно
					И Инструктажи.ДатаПроведения ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ИнструктажПросрочен
ИЗ
	ВТРабочиеМеста КАК РабочиеМеста
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Представления_КадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
		ПО (РабочиеМеста.РабочееМесто = ЕСТЬNULL(КадровыеДанныеСотрудников.РабочееМестоОхраныТруда, ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка)))
			И (КадровыеДанныеСотрудников.ВидСобытия &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))
		ЛЕВОЕ СОЕДИНЕНИЕ ВТИнструктажи КАК Инструктажи
		ПО (КадровыеДанныеСотрудников.Сотрудник = Инструктажи.Сотрудник)
			И РабочиеМеста.Инструктаж = Инструктажи.ВидИнструктажа
			И (ВЫБОР
				КОГДА РабочиеМеста.КонтролироватьСменуРабочегоМеста
					ТОГДА РабочиеМеста.РабочееМесто = Инструктажи.РабочееМесто
				ИНАЧЕ ИСТИНА
			КОНЕЦ)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТВидыИнструктажей КАК ВидыИнструктажей
		ПО РабочиеМеста.Инструктаж = ВидыИнструктажей.Инструктаж
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОхраныТруда КАК НастройкиОхраныТруда
		ПО (КадровыеДанныеСотрудников.Организация = НастройкиОхраныТруда.Организация)
			И (НЕ НастройкиОхраныТруда.ИспользоватьРабочиеМестаОхраныТруда
				ИЛИ НЕ НастройкиОхраныТруда.ИспользоватьИнструктажиПоОхранеТруда)
ГДЕ
	НастройкиОхраныТруда.ИспользоватьРабочиеМестаОхраныТруда ЕСТЬ NULL</query>
	</dataSet>
	<calculatedField>
		<dataPath>КоличествоПросроченныхИнструктажей</dataPath>
		<expression>Выбор Когда ИнструктажПросрочен Тогда 1 Иначе 0 Конец</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Количество просроченных инструктажей</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>КоличествоПросроченныхИнструктажей</dataPath>
		<expression>Сумма(КоличествоПросроченныхИнструктажей)</expression>
	</totalField>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>КонтролируемыеИнструктажи</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
