#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КонтрольУдостоверений");
	НастройкиВарианта.Описание = НСтр("ru = 'Контроль удостоверений.'");
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВнешниеНаборыДанных(КомпоновщикНастроек) Экспорт
	
	ТекстЗапроса = ТекстЗапросаКонтрольУдостоверений();
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	ВыражениеТребуетсяКонтроль = 
		"ВЫБОР
		|	КОГДА ТребуетсяКонтроль.ИстекСрокДействия
		|		ИЛИ ТребуетсяКонтроль.ТребуетсяУничтожениеУдостоверения
		|		ИЛИ ТребуетсяКонтроль.ТребуетсяЗаявлениеВОрганыВнутреннихДел
		|		ИЛИ ТребуетсяКонтроль.СменаФИО
		|		ИЛИ ТребуетсяКонтроль.СменаДолжности
		|	ТОГДА ИСТИНА
		|	ИНАЧЕ ЛОЖЬ
		|КОНЕЦ";
		
	ВыражениеПричина = 
		"ВЫБОР
		|		КОГДА ТребуетсяКонтроль.ИстекСрокДействия
		|			ТОГДА ""Истек срок действия""
		|		КОГДА ТребуетсяКонтроль.ТребуетсяУничтожениеУдостоверения
		|			ТОГДА ""Требуется уничтожение удостоверения""
		|		КОГДА ТребуетсяКонтроль.ТребуетсяЗаявлениеВОрганыВнутреннихДел
		|			ТОГДА ""Требуется заявление в органы внутренних дел""
		|		КОГДА ТребуетсяКонтроль.СменаФИО
		|			ТОГДА ""Смена ФИО""
		|		КОГДА ТребуетсяКонтроль.СменаДолжности
		|			ТОГДА ""Смена должности""
		|		ИНАЧЕ """"
		|	КОНЕЦ";
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба.КлассныеЧиныРанги") Тогда
		МодульКлассныеЧиныРанги = ОбщегоНазначения.ОбщийМодуль("КлассныеЧиныРанги");
		МодульКлассныеЧиныРанги.ДополнитьЗапросПолямиКонтрольУдостоверений(СхемаЗапроса, ТекстЗапроса, ВыражениеТребуетсяКонтроль, ВыражениеПричина);
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба.ВоинскиеСпециальныеЗвания") Тогда
		МодульВоинскиеСпециальныеЗвания = ОбщегоНазначения.ОбщийМодуль("ВоинскиеСпециальныеЗвания");
		МодульВоинскиеСпециальныеЗвания.ДополнитьЗапросПолямиКонтрольУдостоверений(СхемаЗапроса, ТекстЗапроса, ВыражениеТребуетсяКонтроль, ВыражениеПричина);
	КонецЕсли;
	
	Оператор = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 2].Операторы[0];
	Выражение = "ТребуетсяКонтроль.СменаДолжности";
	ИндексПоля = Оператор.ВыбираемыеПоля.Индекс(Оператор.ВыбираемыеПоля.Найти(Выражение));
	
	НовоеВыражениеТребуетсяКонтроль = Новый ВыражениеСхемыЗапроса(ВыражениеТребуетсяКонтроль);
	НовоеВыражениеПричина = Новый ВыражениеСхемыЗапроса(ВыражениеПричина);
	
	Оператор.ВыбираемыеПоля.Установить(ИндексПоля + 1, НовоеВыражениеТребуетсяКонтроль);
	Оператор.ВыбираемыеПоля.Установить(ИндексПоля + 2, НовоеВыражениеПричина);
	
	// Получение настроек отчета.
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрПериод = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	ПараметрОрганизация = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	ПараметрВидУдостоверения = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВидУдостоверения"));
	ПараметрСотрудник = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Сотрудник"));
	ПараметрТребуетсяКонтроль = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТребуетсяКонтроль"));
	
	Если ПараметрПериод <> Неопределено Тогда
		Период = КонецДня(ПараметрПериод.Значение);
	Иначе
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период); 
	Запрос.УстановитьПараметр("СтатусУдостоверенияВыдано", ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.СтатусыУдостоверений.Выдано"));
	
	// Установка отборов во внешний набор данных из настроек пользователя.
	ВТДляОтбора = Новый Структура;
	ВТДляОтбора.Вставить("ВТУдостоверения", "Удостоверения");
	ВТДляОтбора.Вставить("ВТВыдачиУдостоверений", "Удостоверения");
	
	Если ПараметрОрганизация <> Неопределено И ПараметрОрганизация.Использование Тогда
		Удостоверения.ДобавитьОтборЗапроса(СхемаЗапроса, ВТДляОтбора, "#ИмяТаблицы.Организация В (&Организация)"); 
		Запрос.УстановитьПараметр("Организация", ПараметрОрганизация.Значение);
	КонецЕсли;
	
	Если ПараметрСотрудник <> Неопределено И ПараметрСотрудник.Использование Тогда
		Удостоверения.ДобавитьОтборЗапроса(СхемаЗапроса, ВТДляОтбора, "#ИмяТаблицы.Сотрудник В (&Сотрудник)");
		Запрос.УстановитьПараметр("Сотрудник", ПараметрСотрудник.Значение);
	КонецЕсли;
	
	ВТДляОтбора.Вставить("ВТДолжностиПоВидамУдостоверений", "ДолжностиПоВидамУдостоверений");
	ВТДляОтбора.Вставить("ВТВыделеныДолжностиУВидаУдостоверения", "ВыделенныеДолжности");
	Если ПараметрВидУдостоверения <> Неопределено И ПараметрВидУдостоверения.Использование Тогда
		Удостоверения.ДобавитьОтборЗапроса(СхемаЗапроса, ВТДляОтбора, "#ИмяТаблицы.ВидУдостоверения В (&ВидУдостоверения)");
		Запрос.УстановитьПараметр("ВидУдостоверения", ПараметрВидУдостоверения.Значение);
	КонецЕсли;
	
	Если ПараметрТребуетсяКонтроль <> Неопределено И ПараметрТребуетсяКонтроль.Использование Тогда
		Удостоверения.ДобавитьОтборЗапроса(СхемаЗапроса, "", "Результат.ТребуетсяКонтроль");
		Запрос.УстановитьПараметр("ТребуетсяКонтроль", ПараметрТребуетсяКонтроль.Значение);
	КонецЕсли;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	ЗарплатаКадрыОбщиеНаборыДанных.ЗаменитьЗапросыКПредставлениямВиртуальныхТаблиц(Запрос.Текст);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("КонтрольУдостоверений", Запрос.Выполнить().Выгрузить());
	
	Возврат ВнешниеНаборыДанных;
	
КонецФункции

Функция ТекстЗапросаКонтрольУдостоверений()
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Период,
		|	Удостоверения.Период КАК ДатаСобытия,
		|	Удостоверения.Регистратор КАК Регистратор,
		|	Удостоверения.Сотрудник КАК Сотрудник,
		|	Удостоверения.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Удостоверения.Организация КАК Организация,
		|	Удостоверения.ВидУдостоверения КАК ВидУдостоверения,
		|	ВЫРАЗИТЬ(Удостоверения.ВидУдостоверения КАК Справочник.ВидыУдостоверений).СменаУдостоверенияПриСменеДолжности КАК СменаУдостоверенияПриСменеДолжности,
		|	ВЫРАЗИТЬ(Удостоверения.ВидУдостоверения КАК Справочник.ВидыУдостоверений).ПроверятьНаличиеЗаявленияВОрганыВнутреннихДел КАК ПроверятьНаличиеЗаявленияВОрганыВнутреннихДел,
		|	Удостоверения.СерияУдостоверения КАК СерияУдостоверения,
		|	Удостоверения.НомерУдостоверения КАК НомерУдостоверения,
		|	Удостоверения.СтатусУдостоверения КАК СтатусУдостоверения,
		|	Удостоверения.ДатаВыдачи КАК ДатаВыдачи,
		|	Удостоверения.СрокДействия КАК СрокДействия,
		|	Удостоверения.ДатаВозвращенияУтраты КАК ДатаВозвращенияУтраты,
		|	Удостоверения.Основание КАК Основание,
		|	Удостоверения.ВыданоПоДоверенности КАК ВыданоПоДоверенности,
		|	Удостоверения.ДоверенноеЛицо КАК ДоверенноеЛицо,
		|	Удостоверения.ПредоставленаСправкаИзОрганаВнутреннихДел КАК ПредоставленаСправкаИзОрганаВнутреннихДел
		|ПОМЕСТИТЬ ВТУдостоверения
		|ИЗ
		|	РегистрСведений.Удостоверения.СрезПоследних(&Период, ) КАК Удостоверения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Удостоверения.Период КАК Период,
		|	Удостоверения.Сотрудник КАК Сотрудник,
		|	Удостоверения.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Удостоверения.Организация КАК Организация,
		|	Удостоверения.ВидУдостоверения КАК ВидУдостоверения,
		|	Удостоверения.СерияУдостоверения КАК СерияУдостоверения,
		|	Удостоверения.НомерУдостоверения КАК НомерУдостоверения,
		|	Удостоверения.ФИО КАК ФИО,
		|	Удостоверения.Должность КАК Должность
		|ПОМЕСТИТЬ ВТВыдачиУдостоверений
		|ИЗ
		|	РегистрСведений.Удостоверения КАК Удостоверения
		|ГДЕ
		|	Удостоверения.ДатаВыдачи <= &Период
		|	И ТИПЗНАЧЕНИЯ(Удостоверения.Регистратор) = ТИП(Документ.ВыдачаУдостоверений)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Сотрудник,
		|	"""" КАК ФИО,
		|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ФизическоеЛицо,
		|	ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка) КАК Должность
		|ПОМЕСТИТЬ Представления_КадровыеДанныеСотрудников
		|ИЗ
		|	ВТУдостоверения КАК Удостоверения
		|ГДЕ
		|	""ТолькоРазрешенные"" = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДолжностиПоВидамУдостоверений.ВидУдостоверения КАК ВидУдостоверения,
		|	ДолжностиПоВидамУдостоверений.Должность КАК Должность
		|ПОМЕСТИТЬ ВТДолжностиПоВидамУдостоверений
		|ИЗ
		|	РегистрСведений.ДолжностиПоВидамУдостоверений КАК ДолжностиПоВидамУдостоверений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДолжностиПоВидамУдостоверений.ВидУдостоверения КАК ВидУдостоверения,
		|	ИСТИНА КАК ВыделеныДолжности
		|ПОМЕСТИТЬ ВТВыделенныеДолжности
		|ИЗ
		|	ВТДолжностиПоВидамУдостоверений КАК ДолжностиПоВидамУдостоверений
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВидыУдостоверений.Ссылка,
		|	ЛОЖЬ
		|ИЗ
		|	Справочник.ВидыУдостоверений КАК ВидыУдостоверений
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДолжностиПоВидамУдостоверений КАК ДолжностиПоВидамУдостоверений
		|		ПО ВидыУдостоверений.Ссылка = ДолжностиПоВидамУдостоверений.ВидУдостоверения
		|ГДЕ
		|	ДолжностиПоВидамУдостоверений.Должность ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВыделенныеДолжности.ВидУдостоверения КАК ВидУдостоверения,
		|	ВыделенныеДолжности.ВыделеныДолжности КАК ВыделеныДолжности
		|ПОМЕСТИТЬ ВТВыделеныДолжностиУВидаУдостоверения
		|ИЗ
		|	ВТВыделенныеДолжности КАК ВыделенныеДолжности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Удостоверения.ДатаСобытия КАК ДатаСобытия,
		|	Удостоверения.Регистратор КАК Регистратор,
		|	Удостоверения.Сотрудник КАК Сотрудник,
		|	Удостоверения.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Удостоверения.Организация КАК Организация,
		|	Удостоверения.ВидУдостоверения КАК ВидУдостоверения,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВыделеныДолжностиУВидаУдостоверения.ВыделеныДолжности, ЛОЖЬ)
		|			ТОГДА НЕ ДолжностиПоВидамУдостоверений.ВидУдостоверения ЕСТЬ NULL
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ТребуетсяКонтрольДолжности,
		|	Удостоверения.СменаУдостоверенияПриСменеДолжности КАК СменаУдостоверенияПриСменеДолжности,
		|	Удостоверения.СерияУдостоверения КАК СерияУдостоверения,
		|	Удостоверения.НомерУдостоверения КАК НомерУдостоверения,
		|	Удостоверения.СтатусУдостоверения КАК СтатусУдостоверения,
		|	Удостоверения.ДатаВыдачи КАК ДатаВыдачи,
		|	Удостоверения.СрокДействия КАК СрокДействия,
		|	Удостоверения.ДатаВозвращенияУтраты КАК ДатаВозвращенияУтраты,
		|	Удостоверения.Основание КАК Основание,
		|	ЕСТЬNULL(ВыдачиУдостоверений.ФИО, """") КАК ФИО,
		|	ЕСТЬNULL(КадровыеДанныеСотрудников.ФИО, """") КАК ТекущееФИО,
		|	ЕСТЬNULL(ВыдачиУдостоверений.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК Должность,
		|	ЕСТЬNULL(КадровыеДанныеСотрудников.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК ТекущаяДолжность,
		|	Удостоверения.ПроверятьНаличиеЗаявленияВОрганыВнутреннихДел КАК ПроверятьНаличиеЗаявленияВОрганыВнутреннихДел,
		|	Удостоверения.ПредоставленаСправкаИзОрганаВнутреннихДел КАК ПредоставленаСправкаИзОрганаВнутреннихДел,
		|	Удостоверения.ВыданоПоДоверенности КАК ВыданоПоДоверенности,
		|	Удостоверения.ДоверенноеЛицо КАК ДоверенноеЛицо
		|ПОМЕСТИТЬ ВТДанныеУдостоверений
		|ИЗ
		|	ВТУдостоверения КАК Удостоверения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Представления_КадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТДолжностиПоВидамУдостоверений КАК ДолжностиПоВидамУдостоверений
		|			ПО КадровыеДанныеСотрудников.Должность = ДолжностиПоВидамУдостоверений.Должность
		|		ПО Удостоверения.Сотрудник = КадровыеДанныеСотрудников.Сотрудник
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыделеныДолжностиУВидаУдостоверения КАК ВыделеныДолжностиУВидаУдостоверения
		|		ПО Удостоверения.ВидУдостоверения = ВыделеныДолжностиУВидаУдостоверения.ВидУдостоверения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыдачиУдостоверений КАК ВыдачиУдостоверений
		|		ПО Удостоверения.Организация = ВыдачиУдостоверений.Организация
		|			И Удостоверения.Сотрудник = ВыдачиУдостоверений.Сотрудник
