#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ЗначениеИзменено;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Значение = Истина И НЕ ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		ВызватьИсключение НСтр("ru = 'Запрещена установка константы при отсутствии подсистемы ""Процессы обработки документов.""'");
	КонецЕсли;
	
	ЗначениеИзменено = Значение <> Константы.ИспользоватьПроцессыОбработкиДокументов.Получить();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеИзменено Тогда
		
		ПараметрыНабора = УправлениеСвойствами.СтруктураПараметровНабораСвойств();
		ПараметрыНабора.Используется = ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов");
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_ДополнительноеЗадание", ПараметрыНабора);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
