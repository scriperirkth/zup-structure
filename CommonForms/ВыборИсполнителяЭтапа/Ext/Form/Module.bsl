
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Параметры.Заголовок) Тогда
		Заголовок = Параметры.Заголовок;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.Исполнитель) = Тип("СправочникСсылка.Пользователи") Тогда
		
		ТекущийЭлемент = Элементы.СписокПользователи;
		Элементы.СписокПользователи.ТекущаяСтрока = Параметры.Исполнитель;
		
	ИначеЕсли ТипЗнч(Параметры.Исполнитель) = Тип("СправочникСсылка.РолиИсполнителей")
		ИЛИ ТипЗнч(Параметры.Исполнитель) = Тип("Строка") Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.Роли;
		ТекущийЭлемент = Элементы.СписокРоли;
		Элементы.СписокРоли.ТекущаяСтрока = Параметры.Исполнитель;
		
	КонецЕсли;
	
	ЭтоВыборИзСпискаИсполнителей = Ложь;
	
	Если ТипЗнч(Параметры.ПараметрыВыбораИсполнителя) = Тип("Структура") Тогда
		ЭтапВыполняетсяНесколькимиИсполнителями = Параметры.ПараметрыВыбораИсполнителя.ЭтапВыполняетсяНесколькимиИсполнителями;
		Если ЭтапВыполняетсяНесколькимиИсполнителями Тогда
			Для Каждого Исполнитель Из  Параметры.ПараметрыВыбораИсполнителя.Исполнители Цикл
				СтрокаИсполнитель = Исполнители.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаИсполнитель, Исполнитель);
				СтрокаИсполнитель.ИсполнительЭтапаСтрокой = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(
					СтрокаИсполнитель.Исполнитель,
					СтрокаИсполнитель.ОсновнойОбъектАдресации,
					СтрокаИсполнитель.ДополнительныйОбъектАдресации,
					СтрокаИсполнитель.ИмяРеквизитаОсновногоОбъектаАдресации,
					СтрокаИсполнитель.ИмяРеквизитаДополнительногоОбъектаАдресации);
			КонецЦикла;
			ИдентификаторЭтапаКуратора = Параметры.ПараметрыВыбораИсполнителя.ИдентификаторЭтапаКуратора;
			Для Каждого Этап Из Параметры.ПараметрыВыбораИсполнителя.ДоступныеЭтапыКуратора Цикл
				Если Этап.ИдентификаторЭтапа = ИдентификаторЭтапаКуратора Тогда
					ПредставлениеЭтапаКуратора = Строка(Этап.НомерЭтапа)+". "+Этап.Этап;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ЭтоВыборИзСпискаИсполнителей = Параметры.ПараметрыВыбораИсполнителя.ЭтоВыборИзСпискаИсполнителей;
	КонецЕсли;
	
	Элементы.Пользователи.Видимость = НЕ Параметры.ТолькоРоли;
	Элементы.ЭтапВыполняетсяНесколькимиИсполнителями.Видимость = Параметры.ОткрытиеИзФормыШаблона И НЕ ЭтоВыборИзСпискаИсполнителей;
	
	УправлениеВидимостьюЭлементов(ЭтотОбъект, Элементы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СписокРоли, "ОткрытиеИзФормыШаблона", Параметры.ОткрытиеИзФормыШаблона);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		СписокРоли, "ЕстьПодходящиеФункции", СписокФункцийОпределенияИсполнителейЭтапа(Параметры.ИдентификаторДокумента).Количество() > 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("ОбщаяФорма.ВыборРолиИсполнителяЭтапа") Тогда
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
			ОповеститьОВыборе(ВыбранноеЗначение);
		КонецЕсли;
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ВыборЭтапаПроцесса" Тогда
		Если ВыбранноеЗначение <> Неопределено Тогда
			ИдентификаторЭтапаКуратора = ВыбранноеЗначение.ИдентификаторЭтапа;
			ПредставлениеЭтапаКуратора = Строка(ВыбранноеЗначение.НомерЭтапа)+". "+ВыбранноеЗначение.Этап;
			ОтключитьОбработчикОжидания("Подключаемый_ОбновитьПредставлениеЭтапаКуратора");
			ПодключитьОбработчикОжидания("Подключаемый_ОбновитьПредставлениеЭтапаКуратора", 0.1, Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЭтапВыполняетсяНесколькимиИсполнителямиПриИзменении(Элемент)
	
	УправлениеВидимостьюЭлементов(ЭтотОбъект, Элементы);
	
	Если ЭтапВыполняетсяНесколькимиИсполнителями Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаИсполнители;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.Роли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеЭтапаКуратораНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", 			НСтр("ru = 'Выбор этапа куратора'"));
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", 	Истина);
	ПараметрыФормы.Вставить("Этапы", 				Параметры.ПараметрыВыбораИсполнителя.ДоступныеЭтапыКуратора);
	ПараметрыФормы.Вставить("ИдентификаторЭтапа",	ИдентификаторЭтапаКуратора);
	
	ОткрытьФорму("ОбщаяФорма.ВыборЭтапаПроцесса", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеЭтапаКуратораОчистка(Элемент, СтандартнаяОбработка)
	ИдентификаторЭтапаКуратора = "";
	ПредставлениеЭтапаКуратора = "";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокРоли

&НаКлиенте
Процедура СписокПользователиВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОповеститьОВыборе(Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРолиВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ВыборРоли(Элемент.ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Исполнители

&НаКлиенте
Процедура ИсполнителиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Не НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбораИсполнителя = Новый Структура;
	ПараметрыВыбораИсполнителя.Вставить("ЭтапВыполняетсяНесколькимиИсполнителями", Ложь);
	ПараметрыВыбораИсполнителя.Вставить("ЭтоВыборИзСпискаИсполнителей", Истина);
	
	ТекущиеДанные = Элементы.Исполнители.ТекущиеДанные;
	ПроцессыОбработкиДокументовКлиент.ВыбратьИсполнителя(Элементы.ИсполнителиИсполнительЭтапаСтрокой,
		ТекущиеДанные.Исполнитель, , Истина, , Параметры.ИдентификаторДокумента, ПараметрыВыбораИсполнителя);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполнителиИсполнительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыВыбораИсполнителя = Новый Структура;
	ПараметрыВыбораИсполнителя.Вставить("ЭтапВыполняетсяНесколькимиИсполнителями", Ложь);
	ПараметрыВыбораИсполнителя.Вставить("ЭтоВыборИзСпискаИсполнителей", Истина);
	
	ТекущиеДанные = Элементы.Исполнители.ТекущиеДанные;
	ПроцессыОбработкиДокументовКлиент.ВыбратьИсполнителя(
		Элемент, ТекущиеДанные.Исполнитель, , Истина, , Параметры.ИдентификаторДокумента, ПараметрыВыбораИсполнителя);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполнителиИсполнительОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Исполнители.ТекущиеДанные;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		ТекущиеДанные.Исполнитель = ВыбранноеЗначение.РольИсполнителя;
		ТекущиеДанные.ОсновнойОбъектАдресации = ВыбранноеЗначение.ОсновнойОбъектАдресации;
		ТекущиеДанные.ДополнительныйОбъектАдресации = ВыбранноеЗначение.ДополнительныйОбъектАдресации;
		ТекущиеДанные.ИмяРеквизитаОсновногоОбъектаАдресации = ВыбранноеЗначение.ИмяРеквизитаОсновногоОбъектаАдресации;
		ТекущиеДанные.ИмяРеквизитаДополнительногоОбъектаАдресации = ВыбранноеЗначение.ИмяРеквизитаДополнительногоОбъектаАдресации;
	Иначе
		ТекущиеДанные.Исполнитель = ВыбранноеЗначение;
		ТекущиеДанные.ОсновнойОбъектАдресации = "";
		ТекущиеДанные.ДополнительныйОбъектАдресации = "";
		ТекущиеДанные.ИмяРеквизитаОсновногоОбъектаАдресации = "";
		ТекущиеДанные.ИмяРеквизитаДополнительногоОбъектаАдресации = "";
	КонецЕсли;
	
	ТекущиеДанные.ИсполнительЭтапаСтрокой = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(
		ТекущиеДанные.Исполнитель,
		ТекущиеДанные.ОсновнойОбъектАдресации,
		ТекущиеДанные.ДополнительныйОбъектАдресации,
		ТекущиеДанные.ИмяРеквизитаОсновногоОбъектаАдресации,
		ТекущиеДанные.ИмяРеквизитаДополнительногоОбъектаАдресации);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполнителиИсполнительЭтапаСтрокойОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Исполнители.ТекущиеДанные;
	
	ТекущиеДанные.Исполнитель = "";
	ТекущиеДанные.ОсновнойОбъектАдресации = "";
	ТекущиеДанные.ДополнительныйОбъектАдресации = "";
	ТекущиеДанные.ИмяРеквизитаОсновногоОбъектаАдресации = "";
	ТекущиеДанные.ИмяРеквизитаДополнительногоОбъектаАдресации = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполнителиИсполнительЭтапаСтрокойОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Исполнители.ТекущиеДанные;
	
	ПоказатьЗначение(, ТекущиеДанные.Исполнитель);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	Если ЭтапВыполняетсяНесколькимиИсполнителями Тогда
		
		Если Исполнители.Количество() = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Не выбрано ни одного исполнителя'"), , "Исполнители");
			Возврат;
		КонецЕсли;
		Для Каждого Исполнитель Из Исполнители Цикл
			Если Не ЗначениеЗаполнено(Исполнитель.Исполнитель) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					НСтр("ru = 'Есть строки с незаполненным исполнителем'"), , "Исполнители"+Исполнители.Индекс(Исполнитель));
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
		РезультатВыбора = Новый Структура;
		РезультатВыбора.Вставить("ЭтапВыполняетсяНесколькимиИсполнителями", ЭтапВыполняетсяНесколькимиИсполнителями);
		РезультатВыбора.Вставить("ИдентификаторЭтапаКуратора", ИдентификаторЭтапаКуратора);
		РезультатИсполнители = Новый Массив;
		Для Каждого Исполнитель Из Исполнители Цикл
			РезультатИсполнитель = Новый Структура;
			РезультатИсполнитель.Вставить("Исполнитель", Исполнитель.Исполнитель);
			РезультатИсполнитель.Вставить("ОсновнойОбъектАдресации", Исполнитель.ОсновнойОбъектАдресации);
			РезультатИсполнитель.Вставить("ДополнительныйОбъектАдресации", Исполнитель.ДополнительныйОбъектАдресации);
			РезультатИсполнитель.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", Исполнитель.ИмяРеквизитаОсновногоОбъектаАдресации);
			РезультатИсполнитель.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", Исполнитель.ИмяРеквизитаДополнительногоОбъектаАдресации);
			РезультатИсполнители.Добавить(РезультатИсполнитель);
		КонецЦикла;
		РезультатВыбора.Вставить("Исполнители", РезультатИсполнители);
		ОповеститьОВыборе(РезультатВыбора);
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.Пользователи Тогда
		ОповеститьОВыборе(Элементы.СписокПользователи.ТекущаяСтрока);
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.Роли Тогда
		ВыборРоли(Элементы.СписокРоли.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ВыборРоли(ТекущиеДанные)
	
	Если (ТекущиеДанные.ИспользуетсяСОбъектамиАдресации
			ИЛИ Параметры.ОбязательнаяАдресацияПоИменамРеквизитов)
		И ТипЗнч(ТекущиеДанные.Ссылка) <> Тип("Строка") Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РольИсполнителя", ТекущиеДанные.Ссылка);
		ПараметрыФормы.Вставить("ОткрытиеИзФормыШаблона", Параметры.ОткрытиеИзФормыШаблона);
		ПараметрыФормы.Вставить("ИдентификаторДокумента", Параметры.ИдентификаторДокумента);
		ПараметрыФормы.Вставить("ОбязательнаяАдресацияПоИменамРеквизитов", Параметры.ОбязательнаяАдресацияПоИменамРеквизитов);
		Если ТипЗнч(Параметры.ПараметрыВыбораИсполнителя) = Тип("Структура")
			И Параметры.ПараметрыВыбораИсполнителя.Свойство("ЭтоВыборИзСпискаИсполнителей") Тогда
			ПараметрыФормы.Вставить("ВыбиратьОбъектыАдресацииИзТабличнойЧасти",
				Параметры.ПараметрыВыбораИсполнителя.ЭтоВыборИзСпискаИсполнителей);
		Иначе
			ПараметрыФормы.Вставить("ВыбиратьОбъектыАдресацииИзТабличнойЧасти", Ложь);
		КонецЕсли;
		ОткрытьФорму("ОбщаяФорма.ВыборРолиИсполнителяЭтапа", ПараметрыФормы, ЭтотОбъект);
	ИначеЕсли ТекущиеДанные.Ссылка = "Пользователь" Тогда
		СписокПодходящихРеквизитов = СписокРеквизитовСПользователем();
		Если СписокПодходящихРеквизитов.Количество() = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'В документе нет реквизитов подходящего типа'"));
		Иначе
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораРеквизитаСПользователем", ЭтотОбъект);
			СписокПодходящихРеквизитов.ПоказатьВыборЭлемента(Оповещение, "Выбор реквизита");
		КонецЕсли;
	ИначеЕсли ТекущиеДанные.Ссылка = "Функция" Тогда
		СписокПодходящихФункций = СписокФункцийОпределенияИсполнителейЭтапа(Параметры.ИдентификаторДокумента);
		Если СписокПодходящихФункций.Количество() = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для типа документа не описаны функции определения исполнитей'"));
		Иначе
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораФункцииОпределенияИсполнителейЭтапа", ЭтотОбъект);
			СписокПодходящихФункций.ПоказатьВыборЭлемента(Оповещение, "Выбор функции");
		КонецЕсли;
	Иначе
		ВыбранноеЗначение = Новый Структура;
		ВыбранноеЗначение.Вставить("РольИсполнителя", 								ТекущиеДанные.Ссылка);
		ВыбранноеЗначение.Вставить("ОсновнойОбъектАдресации", 						Неопределено);
		ВыбранноеЗначение.Вставить("ДополнительныйОбъектАдресации", 				Неопределено);
		ВыбранноеЗначение.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", 		Неопределено);
		ВыбранноеЗначение.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", 	Неопределено);
		ОповеститьОВыборе(ВыбранноеЗначение);
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	СписокРоли.УсловноеОформление.Элементы.Очистить();
	Элемент = СписокРоли.УсловноеОформление.Элементы.Добавить();
	
	ГруппаЭлементовОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаЭлементовОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЕстьИсполнители");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВнешняяРоль");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.РольБезИсполнителей);
	
КонецПроцедуры

&НаСервере
Функция СписокРеквизитовСПользователем()
	
	ТипПользователи = Тип("СправочникСсылка.Пользователи");
	
	СписокРеквизитов = Новый СписокЗначений;
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Параметры.ИдентификаторДокумента);
	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		Если Реквизит.Тип.СодержитТип(ТипПользователи) Тогда
			Если ПустаяСтрока(Реквизит.Синоним) Тогда
				СписокРеквизитов.Добавить(Реквизит.Имя, Реквизит.Имя);
			Иначе
				СписокРеквизитов.Добавить(Реквизит.Имя, Реквизит.Синоним);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
		ВладелецСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ИдентификаторДокумента, "ЗначениеПустойСсылки");
		Если МодульУправлениеСвойствами.ИспользоватьДопРеквизиты(ВладелецСвойств) Тогда
			ДополнительныеРеквизиты = МодульУправлениеСвойствами.СвойстваОбъекта(ВладелецСвойств, Истина, Ложь);
			Для Каждого Реквизит Из ДополнительныеРеквизиты Цикл
				Если Реквизит.ТипЗначения.СодержитТип(ТипПользователи) Тогда
					СписокРеквизитов.Добавить("*"+Реквизит.ИдентификаторДляФормул, Реквизит.Заголовок + НСтр("ru = ' (доп. реквизит)'"));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СписокРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораРеквизитаСПользователем(ВыбранныйЭлемент, СписокПараметров) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Новый Структура;
	ВыбранноеЗначение.Вставить("РольИсполнителя", 								"Пользователь");
	ВыбранноеЗначение.Вставить("ОсновнойОбъектАдресации", 						Неопределено);
	ВыбранноеЗначение.Вставить("ДополнительныйОбъектАдресации", 				Неопределено);
	ВыбранноеЗначение.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", 		ВыбранныйЭлемент.Значение);
	ВыбранноеЗначение.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", 	Неопределено);
	ОповеститьОВыборе(ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокФункцийОпределенияИсполнителейЭтапа(ИдентификаторДокумента)
	
	СписокРеквизитов = Новый СписокЗначений;
	
	ИмяИдентификатораДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "ПолноеИмя");
	
	ОписаниеФункций = ПроцессыОбработкиДокументов.ОписаниеФункцийОпределенияИсполнителейЭтапа();
	
	Для Каждого ОписаниеФункции Из ОписаниеФункций Цикл
		
		ДобавитьВСписокВыбора = Ложь;
		
		ИменаВлияющихОбъектовМетаданных = СтрРазделить(ОписаниеФункции.ОбъектыМетаданных, "," + Символы.ПС, Ложь);
		Если ИменаВлияющихОбъектовМетаданных.Количество() > 0 Тогда
			Для Каждого ИмяОбъектаМетаданных Из ИменаВлияющихОбъектовМетаданных Цикл
				Если ИмяОбъектаМетаданных = ИмяИдентификатораДокумента Тогда
					ДобавитьВСписокВыбора = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ДобавитьВСписокВыбора Тогда
			СписокРеквизитов.Добавить(ОписаниеФункции.Идентификатор, ОписаниеФункции.Представление)
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораФункцииОпределенияИсполнителейЭтапа(ВыбранныйЭлемент, СписокПараметров) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Новый Структура;
	ВыбранноеЗначение.Вставить("РольИсполнителя", 								"(функция)");
	ВыбранноеЗначение.Вставить("ОсновнойОбъектАдресации", 						Неопределено);
	ВыбранноеЗначение.Вставить("ДополнительныйОбъектАдресации", 				Неопределено);
	ВыбранноеЗначение.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", 		ВыбранныйЭлемент.Значение);
	ВыбранноеЗначение.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", 	Неопределено);
	ОповеститьОВыборе(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюЭлементов(Форма, Элементы)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Пользователи", "Видимость", НЕ Форма.ЭтапВыполняетсяНесколькимиИсполнителями);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Роли", "Видимость", НЕ Форма.ЭтапВыполняетсяНесколькимиИсполнителями);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Исполнители", "Видимость", Форма.ЭтапВыполняетсяНесколькимиИсполнителями);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПредставлениеЭтапаКуратора", "Видимость", Форма.ЭтапВыполняетсяНесколькимиИсполнителями);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьПредставлениеЭтапаКуратора()
	
	Элементы.ПредставлениеЭтапаКуратора.ОбновитьТекстРедактирования();
	
КонецПроцедуры

#КонецОбласти
