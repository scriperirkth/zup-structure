
#Область ОбработчикиСобытийЭлементовТаблицыФормыПачкиВыполняемыхЗадач

&НаКлиенте
Процедура ПачкиВыполняемыхЗадачПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборДляСпискаЗадач();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПачкиВыполняемыхЗадачПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Для Каждого Строка Из Строки Цикл
		Отбор = Новый Структура("Ключ", Строка(Строка.Ключ.ИдентификаторПачки));
		НайденныеФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		Если НайденныеФоновыеЗадания.Количество() > 0 Тогда
			Состояние = Строка(НайденныеФоновыеЗадания[0].Состояние);
		Иначе
			Состояние = НСтр("ru = 'Не найдено'");
		КонецЕсли;
		Строка.Значение.Данные["СостояниеФоновогоЗадания"] = Состояние;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	Элементы.ПачкиВыполняемыхЗадач.Обновить();
	Элементы.СоставПачекВыполняемыхЗадач.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьВыполнение(Команда)
	
	Если Элементы.ПачкиВыполняемыхЗадач.ТекущиеДанные = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана пачка задач для прерывания'");
		ПоказатьОповещениеПользователя(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьВыполнениеПослеОтветаНаВопрос", ЭтотОбъект);
	
	ТекстВопроса = НСтр("ru = 'Прервать выполнение задач пачки?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьВыполнениеПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПрерватьВыполнениеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоСтроке(Команда)
	
	Элементы.ПачкиВыполняемыхЗадачОтборПоСтроке.Пометка = НЕ Элементы.ПачкиВыполняемыхЗадачОтборПоСтроке.Пометка;
	
	УстановитьОтборДляСпискаЗадач();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборДляСпискаЗадач()
	
	ТекущиеДанные = Элементы.ПачкиВыполняемыхЗадач.ТекущиеДанные;
	
	Если НЕ Элементы.ПачкиВыполняемыхЗадачОтборПоСтроке.Пометка
		ИЛИ ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(СоставПачекВыполняемыхЗадач, "ИдентификаторПачки");
		Возврат;
	КонецЕсли;
	
	// Установка отбора динамического списка.
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СоставПачекВыполняемыхЗадач, "ИдентификаторПачки",
		ТекущиеДанные.ИдентификаторПачки, ВидСравненияКомпоновкиДанных.Равно, , ,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры

&НаСервере
Процедура ПрерватьВыполнениеНаСервере()
	
	Для Каждого ПачкаЗадач Из Элементы.ПачкиВыполняемыхЗадач.ВыделенныеСтроки Цикл
		
		Если ТипЗнч(ПачкаЗадач) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Продолжить;
		КонецЕсли;
		
		// Отмена выполнения фоновых заданий
		Отбор = Новый Структура;
		Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
		Отбор.Вставить("Ключ", Строка(ПачкаЗадач.ИдентификаторПачки));
		НайденныеФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		Если НайденныеФоновыеЗадания.Количество() > 0 Тогда
			НайденныеФоновыеЗадания[0].Отменить();
		КонецЕсли;
		
		ПроцессыОбработкиДокументов.ОтметитьЗадачиВПачкеКакНевыполняемые(ПачкаЗадач.ИдентификаторПачки);
		
	КонецЦикла;
	
	Элементы.ПачкиВыполняемыхЗадач.Обновить();
	Элементы.СоставПачекВыполняемыхЗадач.Обновить();
	
КонецПроцедуры

#КонецОбласти
