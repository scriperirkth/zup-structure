&НаКлиенте
Перем СобытиеИзменениеФлага;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ТипДокумента",
		Тип("Неопределено"),,, Ложь, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Статус",
		, ВидСравненияКомпоновкиДанных.ВСписке,, Ложь, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ОбработкаЗавершена",
		,,, Ложь, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	
	ПроцессыОбработкиДокументов.ДобавитьДополнительныеКолонкиСпискаЗадач(ЭтотОбъект, "Список");
	
	СтарыйКомпоновщикНастроекКД.ЗагрузитьПользовательскиеНастройки(Список.КомпоновщикНастроек.ПользовательскиеНастройки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.Флаг Тогда
		
		СобытиеИзменениеФлага = Истина;
		
		ИзменитьПометкуДокумента(ТекущиеДанные.Предмет);
		ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
		
	Иначе
		
		ПоказатьЗначение(,ТекущиеДанные.Предмет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Если Не Настройки.ДополнительныеСвойства.Свойство("ВыбранныеДокументы") Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеДляПоиска = Новый Соответствие;
	Для Каждого ВыбранныйДокумент Из Настройки.ДополнительныеСвойства.ВыбранныеДокументы Цикл
		СоответствиеДляПоиска.Вставить(ВыбранныйДокумент, Истина);
	КонецЦикла;
	
	Для Каждого Строка Из Строки Цикл
		ДанныеСтроки = Строка.Значение.Данные;
		ДанныеСтроки.Флаг = СоответствиеДляПоиска[ДанныеСтроки.Предмет] = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	Если СобытиеИзменениеФлага = Истина Тогда
		СобытиеИзменениеФлага = Ложь;
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьПользовательскиеНастройкиКД");
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьПользовательскиеНастройкиКД", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Процедура СписокПриСохраненииПользовательскихНастроекНаСервере(Элемент, Настройки)
	
	ОбновитьПользовательскиеНастройкиКДНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажкиДокументов(Команда)
	
	СобытиеИзменениеФлага = Истина;
	
	ЭлектронныеДокументы = ЭлектронныеДокументыСписка();
	ВыбранныеДокументы.ЗагрузитьЗначения(ЭлектронныеДокументы);
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиДокументов(Команда)
	
	СобытиеИзменениеФлага = Истина;
	
	ВыбранныеДокументы.Очистить();
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьРеестра(Команда)
	
	Если ВыбранныеДокументы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать хотя бы один документ.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыбранныеДокументы", ВыбранныеДокументы.ВыгрузитьЗначения());
	
	ОткрытьФорму("ОбщаяФорма.ПечатьРеестраДокументовПОД", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДанныеСПодписьюВсе(Команда)
	
	Если ВыбранныеДокументы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать хотя бы один документ.'"));
		Возврат;
	КонецЕсли;
	
	ФайлВыгрузки = ФайлВыгрузкиПодписаныхДанныхИПодписей(ВыбранныеДокументы.ВыгрузитьЗначения());
	
	ПродолжитьВыгрузку(ФайлВыгрузки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьПометкуДокумента(Документ)
	
	НайденныйИндекс = ВыбранныеДокументы.НайтиПоЗначению(Документ);
	Если НайденныйИндекс = Неопределено Тогда
		ВыбранныеДокументы.Добавить(Документ);
	Иначе
		ВыбранныеДокументы.Удалить(НайденныйИндекс);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтображениеВыбранныхДокументов(Форма)
	
	Форма.Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыбранныеДокументы",
		Форма.ВыбранныеДокументы.ВыгрузитьЗначения());
	
	ШаблонЗаголовка = НСтр("ru = 'Выбрано: %1'");
	Форма.Элементы.ДекорацияВыбранныеДокументы.Заголовок = СтрШаблон(ШаблонЗаголовка, Форма.ВыбранныеДокументы.Количество());
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьПользовательскиеНастройкиКД()
	
	ОбновитьПользовательскиеНастройкиКД();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПользовательскиеНастройкиКД()
	
	Если ИзменилисьПользовательскиеНастройки(ЭтотОбъект) Тогда
		СтарыйКомпоновщикНастроекКД.ЗагрузитьПользовательскиеНастройки(Список.КомпоновщикНастроек.ПользовательскиеНастройки);
		Если АктуализироватьВыбранныеДокументы() Тогда
			ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПользовательскиеНастройкиКДНаСервере()
	
	Если ИзменилисьПользовательскиеНастройки(ЭтотОбъект) Тогда
		СтарыйКомпоновщикНастроекКД.ЗагрузитьПользовательскиеНастройки(Список.КомпоновщикНастроек.ПользовательскиеНастройки);
		Если АктуализироватьВыбранныеДокументы() Тогда
			ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция АктуализироватьВыбранныеДокументы()
	
	Если ВыбранныеДокументы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеОтбора = Новый Структура;
	ОписаниеОтбора.Вставить("ЛевоеЗначение", Новый ПолеКомпоновкиДанных("Предмет"));
	ОписаниеОтбора.Вставить("ВидСравнения", ВидСравненияКомпоновкиДанных.ВСписке);
	ОписаниеОтбора.Вставить("ПравоеЗначение", ВыбранныеДокументы.ВыгрузитьЗначения());
	Отборы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеОтбора);
	
	АктуальныеВыбранныеДокументы = ЭлектронныеДокументыСписка(Отборы);
	
	Если ВыбранныеДокументы.Количество() <> АктуальныеВыбранныеДокументы.Количество() Тогда
		ВыбранныеДокументы.ЗагрузитьЗначения(АктуальныеВыбранныеДокументы);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЭлектронныеДокументыСписка(Знач Отборы = Неопределено)
	
	СписокДанных = Элементы["Список"];
	
	Настройки = СписокДанных.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	ВыбранныеПоля = Настройки.Структура[0].Выбор.Элементы;
	ВыбранныеПоля.Очистить();
	
	ВыбранноеПоле = ВыбранныеПоля.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Предмет");
	
	Если Отборы <> Неопределено Тогда
		Для Каждого ОписаниеОтбора Из Отборы Цикл
			НовыйОтбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйОтбор, ОписаниеОтбора);
		КонецЦикла;
	КонецЕсли;
	
	Схема = СписокДанных.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	ТипГенератораМакета = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки,,, ТипГенератораМакета);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат Результат.ВыгрузитьКолонку("Предмет");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИзменилисьПользовательскиеНастройки(Форма)
	
	НастройкиИзменены = Ложь;
	
	НовыеПользовательскиеНастройкиЭлементы = Форма.Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	СтарыеПользовательскиеНастройкиЭлементы = Форма.СтарыйКомпоновщикНастроекКД.ПользовательскиеНастройки.Элементы;
	
	Если НовыеПользовательскиеНастройкиЭлементы.Количество() <> СтарыеПользовательскиеНастройкиЭлементы.Количество() Тогда
		НастройкиИзменены = Истина;
	КонецЕсли;
	
	Если Не НастройкиИзменены Тогда
		Для Каждого НоваяНастройка Из НовыеПользовательскиеНастройкиЭлементы Цикл
			СтараяНастройка = СтарыеПользовательскиеНастройкиЭлементы.Найти(НоваяНастройка.ИдентификаторПользовательскойНастройки);
			Если СтараяНастройка = Неопределено Тогда
				НастройкиИзменены = Истина;
				Прервать;
			ИначеЕсли ТипЗнч(СтараяНастройка) = Тип("ЭлементОтбораКомпоновкиДанных")
				И (СтараяНастройка.Использование <> НоваяНастройка.Использование
					ИЛИ СтараяНастройка.ВидСравнения <> НоваяНастройка.ВидСравнения
					ИЛИ СтараяНастройка.ПравоеЗначение <> НоваяНастройка.ПравоеЗначение) Тогда
				НастройкиИзменены = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не НастройкиИзменены Тогда
		Для Каждого СтараяНастройка Из СтарыеПользовательскиеНастройкиЭлементы Цикл
			НоваяНастройка = НовыеПользовательскиеНастройкиЭлементы.Найти(СтараяНастройка.ИдентификаторПользовательскойНастройки);
			Если НоваяНастройка = Неопределено Тогда
				НастройкиИзменены = Истина;
				Прервать;
			ИначеЕсли ТипЗнч(СтараяНастройка) = Тип("ЭлементОтбораКомпоновкиДанных")
				И (СтараяНастройка.Использование <> НоваяНастройка.Использование
					ИЛИ СтараяНастройка.ВидСравнения <> НоваяНастройка.ВидСравнения
					ИЛИ СтараяНастройка.ПравоеЗначение <> НоваяНастройка.ПравоеЗначение) Тогда
				НастройкиИзменены = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НастройкиИзменены;
	
КонецФункции

&НаСервереБезКонтекста
Функция ФайлВыгрузкиПодписаныхДанныхИПодписей(Документы)
	
	ПерсональныеНастройки = ЭлектроннаяПодпись.ПерсональныеНастройки();
	СохранятьСертификатВместеСПодписью = ПерсональныеНастройки.СохранятьСертификатВместеСПодписью;
	
	ДанныеДокументов = ДанныеДокументовДляВыгрузки(Документы);
	
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяАрхива = СтрШаблон(НСтр("ru = 'Выгрузка от %1'"), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy;")) + ".zip";
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	
	Для Каждого Документ Из Документы Цикл
		
		ПредставлениеДокумента = ПроцессыОбработкиДокументов.ПредставлениеДокументаДляИмениФайла(Документ);
		
		ИмяПодкаталога = ИмяВременногоКаталога
			+ ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ПредставлениеДокумента);
		ИмяПодкаталога = ПроцессыОбработкиДокументовКлиентСервер.УникальноеИмяФайла(ИмяПодкаталога, Истина) + ПолучитьРазделительПути();
		
		Для Каждого ТекущиеДанные Из ДанныеДокументов[Документ] Цикл
			
			ИмяФайлаДанных = ИмяПодкаталога
				+ ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаДанныхПоУмолчанию(ТекущиеДанные, ПредставлениеДокумента);
				
			Если ТекущиеДанные.ПодписанныеДанные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущиеДанные.ПодписанныеДанные.Записать(ИмяФайлаДанных);
			
			Если ТекущиеДанные.ПростаяПодпись = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяФайлаПодписи = ИмяПодкаталога
				+ ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ТекущиеДанные, ПерсональныеНастройки);
			ИмяФайлаПодписи = ПроцессыОбработкиДокументовКлиентСервер.УникальноеИмяФайла(ИмяФайлаПодписи);
			ТекущиеДанные.Подпись.Записать(ИмяФайлаПодписи);
			
			Если СохранятьСертификатВместеСПодписью Тогда
				ИмяФайлаСертификата = ИмяПодкаталога
					+ ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаСертификатаПоУмолчанию(ТекущиеДанные);
				ИмяФайлаСертификата = ПроцессыОбработкиДокументовКлиентСервер.УникальноеИмяФайла(ИмяФайлаСертификата);
				ТекущиеДанные.Сертификат.Записать(ИмяФайлаСертификата);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДанныеДокументов[Документ].Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не выгружены данные документа %1. Нет подписанных данных'"), ПредставлениеДокумента));
			Продолжить;
		КонецЕсли;
		
		ЗаписьZipФайла.Добавить(ИмяПодкаталога,
			РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
			РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		
	КонецЦикла;
	
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	
	ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", ИмяАрхива);
	Результат.Вставить("АдресФайла", ПоместитьВоВременноеХранилище(ДвоичныеДанные));
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеДокументовДляВыгрузки(Документы)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Предмет КАК Предмет,
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Задача,
	|	ЗадачаПоОбработкеДокумента.Этап КАК Этап,
	|	ЗадачаПоОбработкеДокумента.Этап.Наименование КАК НаименованиеЭтапа,
	|	РегистрСведенийПодписанныеДанные.СоставПодписи КАК СоставПодписи,
	|	РегистрСведенийПодписанныеДанные.ПодписанныеДанные КАК ПодписанныеДанные
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодписанныеДанные КАК РегистрСведенийПодписанныеДанные
	|		ПО (РегистрСведенийПодписанныеДанные.Задача = ЗадачаПоОбработкеДокумента.Ссылка)
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.ПодписанЭП
	|	И ЗадачаПоОбработкеДокумента.Предмет В(&Документы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗадачаПоОбработкеДокумента.Дата
	|ИТОГИ ПО
	|	Предмет";
	
	Запрос.УстановитьПараметр("Документы", Документы);
	
	УстановитьПривилегированныйРежим(Истина);
	ВыборкаПоДокументам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДанныеДокументов = Новый Соответствие;
	
	Пока ВыборкаПоДокументам.Следующий() Цикл
		
		МассивЭлектронныхПодписей = Новый Массив;
		
		Выборка = ВыборкаПоДокументам.Выбрать();
		
		НомерСтроки = 0;
		
		Пока Выборка.Следующий() Цикл
			
			ПодписиВОбъекте = ПроцессыОбработкиДокументов.УстановленныеПодписи(Выборка.Задача);
			
			Если ПодписиВОбъекте.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОтпечатокСтруктура = Новый Структура(
				"ПростаяПодпись, КомуВыданСертификат, Подпись, Сертификат, НаименованиеЭтапа, ПодписанныеДанные");
			
			ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, ПодписиВОбъекте[0]);
			ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, Выборка);
			
			Если ОтпечатокСтруктура.ПростаяПодпись = Неопределено Тогда
				ОтпечатокСтруктура.Сертификат = ОтпечатокСтруктура.Сертификат.Получить();
			КонецЕсли;
			ОтпечатокСтруктура.ПодписанныеДанные = ОтпечатокСтруктура.ПодписанныеДанные.Получить();
			
			НомерСтроки = НомерСтроки + 1;
			ОтпечатокСтруктура.Вставить("НомерСтроки", НомерСтроки);
			
			МассивЭлектронныхПодписей.Добавить(ОтпечатокСтруктура);
			
		КонецЦикла;
		
		ДанныеДокументов.Вставить(ВыборкаПоДокументам.Предмет, МассивЭлектронныхПодписей);
		
	КонецЦикла;
	
	Для Каждого Документ Из Документы Цикл
		Если ДанныеДокументов[Документ] = Неопределено Тогда
			ДанныеДокументов.Вставить(Документ, Новый Массив);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеДокументов;
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьВыгрузку(ФайлВыгрузки)
	
	Оповещение = Новый ОписаниеОповещения("СохранитьДокументПослеПолученияФайла", ЭтотОбъект, Неопределено);
	
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы %1 (*.%1)|*.%1|Все файлы (*.*)|*.*'"),
		"zip");
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения данных'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(
		Оповещение, ФайлВыгрузки.АдресФайла, ФайлВыгрузки.ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокументПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Документы сохранены в файл:'"), , ПолученныеФайлы[0].Имя);
	
КонецПроцедуры

#КонецОбласти
