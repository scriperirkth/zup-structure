
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "СотрудникСсылка, ФизическоеЛицоСсылка");
	
	СотрудникиФормы.ПрочитатьДанныеИзХранилищаВФорму(
		ЭтотОбъект,
		СотрудникиКлиентСервер.ОписаниеДополнительнойФормы(ИмяФормы),
		Параметры.АдресВХранилище);
	
	ПроинициализироватьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если (ИмяСобытия = "Запись_ИнструктажПоОхранеТруда"
			Или ИмяСобытия = "Запись_ПроверкаЗнанияТребованийОхраныТруда"
			Или ИмяСобытия = "Запись_НазначениеРабочихМестСотрудникам")
		И Параметр.Свойство("ВладелецФормы") И Параметр.ВладелецФормы = ЭтотОбъект Тогда
		
		ПроинициализироватьФорму();
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_РабочиеМестаОхраныТруда" И Источник = РабочееМесто Тогда
		НачатьОбновлениеПериодическихОсмотров();
		НачатьОбновлениеНормВыдачиСИЗ();
	КонецЕсли;
	
	ОбработатьОповещениеМедицинскихОсмотров(ИмяСобытия, Параметр, Источник);
	ОбработатьОповещениеСИЗ(ИмяСобытия, Параметр, Источник);
	ОбработатьОповещениеОбученияПоОхранеТруда(ИмяСобытия, Параметр, Источник);
	ОбработатьОповещениеИнструктажи(ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "ИзменениеАнтропометрииФизическогоЛица" Тогда 
		Если Источник = ФизическоеЛицоСсылка Тогда
			Элементы.ДекорацияАнтропометрия.Заголовок = ПредставлениеАнтропометрииФизическогоЛица();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	ОбработатьНавигационнуюСсылкуНаправлениеНаМедицинскийОсмотрСоздать(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	ОбработатьНавигационнуюСсылкуЗаказНаВыдачуСИЗСоздать(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	ОбработатьНавигационнуюСсылкуНазначениеРабочегоМестаСоздать(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияАнтропометрияНажатие(Элемент)
	
	ОткрытьФорму("РегистрСведений.АнтропометрияФизическихЛиц.ФормаЗаписи",
		Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка), ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИнструктажиПоОхранеТруда

&НаКлиенте
Процедура ИнструктажиПоОхранеТрудаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ИнструктажиПоОхранеТрудаДействие Тогда
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Организация", Организация);
		ЗначенияЗаполнения.Вставить("Подразделение", Подразделение);
		ЗначенияЗаполнения.Вставить("ВидИнструктажа", ТекущиеДанные.Инструктаж);
		ЗначенияЗаполнения.Вставить("ДатаПроведения", ОбщегоНазначенияКлиент.ДатаСеанса());
		СотрудникРабочееМесто = Новый Структура;
		СотрудникРабочееМесто.Вставить("Сотрудник", СотрудникСсылка);
		СотрудникРабочееМесто.Вставить("РабочееМесто", РабочееМесто);
		ЗначенияЗаполнения.Вставить("СписокСотрудников", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СотрудникРабочееМесто));
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		ОткрытьФорму("Документ.ИнструктажПоОхранеТруда.ФормаОбъекта", ПараметрыОткрытия, ЭтотОбъект);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Регистратор) Тогда
		ПоказатьЗначение(,ТекущиеДанные.Регистратор);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбучениеПоОхранеТруда

&НаКлиенте
Процедура ОбучениеПоОхранеТрудаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ОбучениеПоОхранеТрудаДействие Тогда
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Организация", Организация);
		ЗначенияЗаполнения.Вставить("Подразделение", Подразделение);
		ЗначенияЗаполнения.Вставить("ПрограммаОбучения", ТекущиеДанные.ПрограммаОбучения);
		
		ОписаниеОбучения = Новый Структура;
		ОписаниеОбучения.Вставить("ФизическоеЛицо", ФизическоеЛицоСсылка);
		ОписаниеОбучения.Вставить("РабочееМесто", РабочееМесто);
		ОписаниеОбучения.Вставить("Обучение", ТекущиеДанные.Обучение);
		ОписаниеОбучения.Вставить("Проверка", ТекущиеДанные.Проверка);
		Если ТекущиеДанные.СрокДействия < Дата(3999, 12, 31) Тогда
			ОписаниеОбучения.Вставить("ДатаСледующейПроверкиЗнания",
				?(ЗначениеЗаполнено(ТекущиеДанные.СрокДействия), ТекущиеДанные.СрокДействия, ДатаРегистрацииРабочегоМеста));
		КонецЕсли;
		ЗначенияЗаполнения.Вставить(
			"ФизическиеЛицаРабочиеМеста", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеОбучения));
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.Проверка) И ЗначениеЗаполнено(ТекущиеДанные.Обучение) Тогда
			ЗначенияЗаполнения.Вставить("ОбучениеСотрудников", ТекущиеДанные.Обучение);
			ОткрытьФорму("Документ.ПроверкаЗнанияТребованийОхраныТруда.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтотОбъект);
		Иначе
			ОткрытьФорму("Документ.ОбучениеСотрудниковОхранеТруда.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтотОбъект);
		КонецЕсли;
	ИначеЕсли Поле = Элементы.ОбучениеПоОхранеТрудаПрограммаОбучения Тогда
		ПоказатьЗначение(,ТекущиеДанные.ПрограммаОбучения);
	ИначеЕсли Поле = Элементы.ОбучениеПоОхранеТрудаОбучение И ЗначениеЗаполнено(ТекущиеДанные.Обучение) Тогда
		ПоказатьЗначение(,ТекущиеДанные.Обучение);
	ИначеЕсли Поле = Элементы.ОбучениеПоОхранеТрудаПроверка И ЗначениеЗаполнено(ТекущиеДанные.Проверка) Тогда
		ПоказатьЗначение(,ТекущиеДанные.Проверка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРезультатыСпециальнойОценкиУсловийТруда

&НаКлиенте
Процедура РезультатыСпециальнойОценкиУсловийТрудаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.РезультатыСпециальнойОценкиУсловийТрудаСрокДействия И ЗначениеЗаполнено(ТекущиеДанные.РегистраторСрокДействия) Тогда
		ПоказатьЗначение(,ТекущиеДанные.РегистраторСрокДействия);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Регистратор) Тогда
		ПоказатьЗначение(,ТекущиеДанные.Регистратор);
	КонецЕсли;
	
КонецПроцедуры

