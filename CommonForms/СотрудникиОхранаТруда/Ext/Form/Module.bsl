#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроинициализироватьФорму()
	
	ТекущаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
	
	Если СотрудникСсылка.Пустая() Тогда
		СотрудникСсылка = КадровыйУчет.ОсновнойСотрудникФизическогоЛица(ФизическоеЛицоСсылка, Неопределено, ТекущаяДата);
	КонецЕсли;
	
	Заголовок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СотрудникСсылка, "Наименование");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Сотрудник", СотрудникСсылка);
	Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДата);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&Сотрудник КАК Сотрудник,
		|	&ДатаАктуальности КАК Период
		|ПОМЕСТИТЬ ВТСотрудники";
	Запрос.Выполнить();
	
	ОписательВТКадровыеДанные = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(
		Запрос.МенеджерВременныхТаблиц, "ВТСотрудники");
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВТКадровыеДанные, Истина,
		"Организация, Подразделение, РабочееМестоОхраныТруда, РабочееМестоОхраныТрудаПериодРегистрации");
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КадровыеДанныеСотрудников.РабочееМестоОхраныТруда КАК РабочееМесто,
		|	КадровыеДанныеСотрудников.РабочееМестоОхраныТрудаПериодРегистрации КАК ДатаРегистрацииРабочегоМеста,
		|	КадровыеДанныеСотрудников.Подразделение,
		|	КадровыеДанныеСотрудников.Организация
		|ИЗ
		|	ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	КонецЕсли;
	
	УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("Организация", Организация));
	
	ЗаполнитьТекущиеДанныеСотрудника(ЭтотОбъект);
	ЗаполнитьСпециальнуюОценкуУсловийТруда();
	ЗаполнитьИнструктажи();
	ИнициализироватьОбучение();
	ИнициализироватьМедицинскиеОсмотры();
	ИнициализироватьСредстваИндивидуальнойЗащиты();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНавигационнуюСсылкуНазначениеРабочегоМестаСоздать(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)

	ПустаяСсылка = ПредопределенноеЗначение("Документ.НазначениеРабочихМестСотрудникам.ПустаяСсылка");
	Если ПолучитьНавигационнуюСсылку(ПустаяСсылка) <> НавигационнаяСсылкаФорматированнойСтроки Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения");
	ПараметрыФормы.ЗначенияЗаполнения = Новый Структура;
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("Организация", Организация);
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("Подразделение", Подразделение);
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("НачалоПериода", ОбщегоНазначенияКлиент.ДатаСеанса());
	ПараметрыФормы.Вставить("Сотрудники", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СотрудникСсылка));

	ОткрытьФорму("Документ.НазначениеРабочихМестСотрудникам.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#Область СпециальнаяОценкаУсловийТруда

&НаСервере
Процедура ЗаполнитьСпециальнуюОценкуУсловийТруда()
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ПлановыеДатыСпециальнойОценкиУсловийТруда)
	 Или Не ОхранаТруда.СпециальнаяОценкаУсловийТрудаИспользуется(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РабочееМесто, "Владелец")) Тогда
		Элементы.ГруппаСпецоценка.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДата);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезультатыСпециальнойОценкиУсловийТруда.РабочееМесто КАК РабочееМесто,
		|	РезультатыСпециальнойОценкиУсловийТруда.КлассУсловийТруда КАК КлассУсловийТруда,
		|	РезультатыСпециальнойОценкиУсловийТруда.ВыявленыВредныеОпасныеФакторы КАК ВыявленыВредныеОпасныеФакторы,
		|	РезультатыСпециальнойОценкиУсловийТруда.Период КАК ДатаПроведения,
		|	РезультатыСпециальнойОценкиУсловийТруда.Регистратор КАК Регистратор,
		|	ПлановыеДатыСпециальнойОценкиУсловийТруда.ДатаБлижайшейОценки КАК СрокДействия,
		|	ПлановыеДатыСпециальнойОценкиУсловийТруда.Регистратор КАК РегистраторСрокДействия
		|ИЗ
		|	РегистрСведений.РезультатыСпециальнойОценкиУсловийТруда.СрезПоследних(&ДатаАктуальности, РабочееМесто = &РабочееМесто) КАК РезультатыСпециальнойОценкиУсловийТруда
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыСпециальнойОценкиУсловийТруда.СрезПоследних(&ДатаАктуальности, РабочееМесто = &РабочееМесто) КАК ПлановыеДатыСпециальнойОценкиУсловийТруда
		|		ПО РезультатыСпециальнойОценкиУсловийТруда.РабочееМесто = ПлановыеДатыСпециальнойОценкиУсловийТруда.РабочееМесто";
	
	РезультатыСпециальнойОценкиУсловийТруда.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = РезультатыСпециальнойОценкиУсловийТруда.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Инструктажи

&НаКлиенте
Процедура ОбработатьОповещениеИнструктажи(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ВидыИнструктажейПоОхранеТруда" Тогда
		ЗаполнитьИнструктажи();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнструктажи()
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ИнструктажиПоОхранеТруда)
	 Или Не ПолучитьФункциональнуюОпцию("ИспользоватьИнструктажиПоОхранеТруда", Новый Структура("Организация", Организация)) Тогда
		Элементы.ГруппаИнструктажиПоОхранеТруда.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", СотрудникСсылка);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДата);
	Запрос.УстановитьПараметр("ОформитьЗаголовокКоманды", НСтр("ru = 'Оформить'"));
	Запрос.УстановитьПараметр("ПродлитьЗаголовокКоманды", НСтр("ru = 'Продлить'"));
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыИнструктажейПоОхранеТруда.Ссылка КАК Инструктаж,
		|	ВидыИнструктажейПоОхранеТруда.КонтролироватьСменуРабочегоМеста КАК КонтролироватьСменуРабочегоМеста,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА НЕ ВидыИнструктажейПоОхранеТруда.КонтролироватьПроведение
		|				ТОГДА ЛОЖЬ
		|			КОГДА ВидыИнструктажейПоОхранеТруда.ИспользоватьДляВсехРабочихМест
		|					ИЛИ ВидыИнструктажейПоОхранеТрудаРабочиеМеста.РабочееМесто = &РабочееМесто
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК Используется
		|ПОМЕСТИТЬ ВТВсеИнструктажи
		|ИЗ
		|	Справочник.ВидыИнструктажейПоОхранеТруда КАК ВидыИнструктажейПоОхранеТруда
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыИнструктажейПоОхранеТруда.РабочиеМеста КАК ВидыИнструктажейПоОхранеТрудаРабочиеМеста
		|		ПО ВидыИнструктажейПоОхранеТруда.Ссылка = ВидыИнструктажейПоОхранеТрудаРабочиеМеста.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВидыИнструктажейПоОхранеТруда.Ссылка,
		|	ВидыИнструктажейПоОхранеТруда.КонтролироватьСменуРабочегоМеста
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВсеИнструктажи.Инструктаж КАК Инструктаж,
		|	ИнструктажиПоОхранеТруда.Период КАК ДатаПолучения,
		|	ИнструктажиПоОхранеТруда.Регистратор КАК Регистратор,
		|	ИнструктажиПоОхранеТруда.СрокДействия КАК СрокДействия,
		|	ВЫБОР
		|		КОГДА ИнструктажиПоОхранеТруда.ВидИнструктажа = ЗНАЧЕНИЕ(Справочник.ВидыИнструктажейПоОхранеТруда.Вводный)
		|			ТОГДА """"
		|		КОГДА ИнструктажиПоОхранеТруда.ВидИнструктажа ЕСТЬ NULL
		|			ТОГДА &ОформитьЗаголовокКоманды
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ВидыИнструктажейПоОхранеТруда.ПроводитсяПовторно
		|					ТОГДА &ПродлитьЗаголовокКоманды
		|				ИНАЧЕ """"
		|			КОНЕЦ
		|	КОНЕЦ КАК Действие
		|ИЗ
		|	ВТВсеИнструктажи КАК ВсеИнструктажи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыИнструктажейПоОхранеТруда КАК ВидыИнструктажейПоОхранеТруда
		|		ПО ВсеИнструктажи.Инструктаж = ВидыИнструктажейПоОхранеТруда.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнструктажиПоОхранеТруда.СрезПоследних(&ДатаАктуальности, Сотрудник = &Сотрудник) КАК ИнструктажиПоОхранеТруда
		|		ПО ВсеИнструктажи.Инструктаж = ИнструктажиПоОхранеТруда.ВидИнструктажа
		|			И (ВЫБОР
		|				КОГДА ВсеИнструктажи.КонтролироватьСменуРабочегоМеста
		|					ТОГДА ИнструктажиПоОхранеТруда.РабочееМесто = &РабочееМесто
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|ГДЕ
		|	ВсеИнструктажи.Используется";
	
	ИнструктажиПоОхранеТруда.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ИнструктажиПоОхранеТруда.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Обучение

&НаКлиенте
Процедура ОбработатьОповещениеОбученияПоОхранеТруда(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ОбучениеСотрудниковОхранеТруда"
	 Или ИмяСобытия = "Запись_ПроверкаЗнанияТребованийОхраныТруда" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ФизическиеЛица") И Параметр["ФизическиеЛица"].Найти(ФизическоеЛицоСсылка) <> Неопределено Тогда
				ЗаполнитьОбучение();
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "Запись_ПрограммыОбученияСотрудниковПоОхранеТруда" Тогда
		ИнициализироватьОбучение();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОбучение()
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ПроверкиЗнанияТребованийОхраныТрудаСотрудников)
	 Или Не ПолучитьФункциональнуюОпцию("ИспользоватьОбучениеПоОхранеТруда", Новый Структура("Организация", Организация)) Тогда
		Элементы.ГруппаОбучениеПоОхранеТруда.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ДобавитьУсловноеОформлениеОбученияПоОхранеТруда();
	
	ЗаполнитьОбучение();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеОбученияПоОхранеТруда()
	
	// Обучение по программе не требуется:
	// - серым цветом текст,
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "ОбученияПоОхранеТруда.Требуется", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступногоТекста);
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОбучениеПоОхранеТруда");
	// - подпись "Не требуется" в поле "Следующая проверка".
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "ОбученияПоОхранеТруда.Требуется", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не требуется'"));
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОбучениеПоОхранеТрудаСрокДействия");
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "ОбученияПоОхранеТруда.СрокДействия",
		НачалоДня(ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата()));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не требуется'"));
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОбучениеПоОхранеТрудаСрокДействия");
	// - подпись "Неудовлетворительно" в поле "Следующая проверка".
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "ОбученияПоОхранеТруда.Требуется", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "ОбученияПоОхранеТруда.Результат",
		Перечисления.РезультатыПроверкиЗнанияПоОхранеТруда.Неудовлетворительно);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Неудовлетворительно'"));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаКритичногоСостоянияОхраныТруда);
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОбучениеПоОхранеТрудаСрокДействия");
	// Состояние критичное.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "ОбученияПоОхранеТруда.Требуется", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементОформления.Отбор, "ОбученияПоОхранеТруда.СрокДействия", ДобавитьМесяц(ТекущаяДата, 1),
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаКритичногоСостоянияОхраныТруда);
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОбучениеПоОхранеТруда");
	// Подпись последней проверки "Не проводилась".
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементОформления.Отбор, "ОбученияПоОхранеТруда.ДатаПолучения", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не проводилась'"));
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОбучениеПоОхранеТрудаДатаПолучения");
	// Нет прав на создание документов
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Видимость",
		ПравоДоступа("Изменение", Метаданные.Документы.ОбучениеСотрудниковОхранеТруда));
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОбучениеПоОхранеТрудаДействие");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбучение()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОбучениеПоОхранеТруда.СоздатьВТПройденныеОбучения(Запрос.МенеджерВременныхТаблиц, ТекущаяДата, , ФизическоеЛицоСсылка);
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицоСсылка);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДата);
	Запрос.УстановитьПараметр("ПустоеОбучение", Документы.ОбучениеСотрудниковОхранеТруда.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяПроверка", Документы.ПроверкаЗнанияТребованийОхраныТруда.ПустаяСсылка());
	Запрос.УстановитьПараметр("ОформитьЗаголовокКомандыОбучение", НСтр("ru = 'Оформить обучение'"));
	Запрос.УстановитьПараметр("ОформитьЗаголовокКомандыПроверка", НСтр("ru = 'Оформить проверку'"));
	Запрос.УстановитьПараметр("ПовторитьЗаголовокКоманды", НСтр("ru = 'Повторить'"));
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбученияОжидающиеПроверки.Период КАК Период,
		|	ОбученияОжидающиеПроверки.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОбученияОжидающиеПроверки.ПрограммаОбучения КАК ПрограммаОбучения,
		|	ОбученияОжидающиеПроверки.РабочееМесто КАК РабочееМесто,
		|	ОбученияОжидающиеПроверки.Обучение КАК Обучение,
		|	ОбученияОжидающиеПроверки.Проверка КАК Проверка
		|ПОМЕСТИТЬ ВТОбученияОжидающиеПроверки
		|ИЗ
		|	РегистрСведений.ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.СрезПоследних(, ФизическоеЛицо = &ФизическоеЛицо) КАК ОбученияОжидающиеПроверки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ФизическоеЛицо,
		|	ПрограммаОбучения,
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ОбученияОжидающиеПроверки.ПрограммаОбучения, ПройденныеОбучения.ПрограммаОбучения) КАК ПрограммаОбучения,
		|	ЕСТЬNULL(ОбученияОжидающиеПроверки.РабочееМесто, ПройденныеОбучения.РабочееМесто) КАК РабочееМесто,
		|	ПройденныеОбучения.ДатаПроверки КАК ДатаПолучения,
		|	ПройденныеОбучения.РезультатПроверки КАК РезультатПроверки,
		|	ЕСТЬNULL(ОбученияОжидающиеПроверки.Обучение, ПройденныеОбучения.Обучение) КАК Обучение,
		|	ЕСТЬNULL(ОбученияОжидающиеПроверки.Проверка, ПройденныеОбучения.Проверка) КАК Проверка
		|ПОМЕСТИТЬ ВТОбученияФизическогоЛица
		|ИЗ
		|	ВТПройденныеОбучения КАК ПройденныеОбучения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОбученияОжидающиеПроверки КАК ОбученияОжидающиеПроверки
		|		ПО (ОбученияОжидающиеПроверки.ФизическоеЛицо = ПройденныеОбучения.ФизическоеЛицо)
		|			И (ОбученияОжидающиеПроверки.ПрограммаОбучения = ПройденныеОбучения.ПрограммаОбучения)
		|			И (ОбученияОжидающиеПроверки.Период >= ПройденныеОбучения.ДатаПроверки)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОбученияОжидающиеПроверки.ПрограммаОбучения,
		|	ОбученияОжидающиеПроверки.РабочееМесто,
		|	NULL,
		|	NULL,
		|	ОбученияОжидающиеПроверки.Обучение,
		|	ОбученияОжидающиеПроверки.Проверка
		|ИЗ
		|	ВТОбученияОжидающиеПроверки КАК ОбученияОжидающиеПроверки
		|ГДЕ
		|	НЕ (ОбученияОжидающиеПроверки.ФизическоеЛицо, ОбученияОжидающиеПроверки.ПрограммаОбучения) В
		|				(ВЫБРАТЬ
		|					ВТПройденныеОбучения.ФизическоеЛицо,
		|					ВТПройденныеОбучения.ПрограммаОбучения
		|				ИЗ
		|					ВТПройденныеОбучения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрограммыОбучения.Ссылка КАК ПрограммаОбучения,
		|	ПрограммыОбучения.КонтролироватьСменуРабочегоМеста КАК КонтролироватьСменуРабочегоМеста,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА НЕ ПрограммыОбучения.КонтролироватьПроведение
		|				ТОГДА ЛОЖЬ
		|			КОГДА ПрограммыОбучения.ИспользоватьДляВсехРабочихМест
		|				ТОГДА ИСТИНА
		|			КОГДА ЕСТЬNULL(ПрограммыОбученияРабочиеМеста.РабочееМесто, НЕОПРЕДЕЛЕНО) = &РабочееМесто
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК Используется
		|ПОМЕСТИТЬ ВТВсеПрограммыОбученияПредварительно
		|ИЗ
		|	Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда КАК ПрограммыОбучения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда.РабочиеМеста КАК ПрограммыОбученияРабочиеМеста
		|		ПО ПрограммыОбучения.Ссылка = ПрограммыОбученияРабочиеМеста.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрограммыОбучения.Ссылка,
		|	ПрограммыОбучения.КонтролироватьСменуРабочегоМеста
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПрограммыОбучения.ПрограммаОбучения В
		|				(ВЫБРАТЬ
		|					ОбученияФизическогоЛица.ПрограммаОбучения
		|				ИЗ
		|					ВТОбученияФизическогоЛица КАК ОбученияФизическогоЛица)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьПроверка,
		|	ПрограммыОбучения.ПрограммаОбучения КАК ПрограммаОбучения,
		|	ПрограммыОбучения.КонтролироватьСменуРабочегоМеста КАК КонтролироватьСменуРабочегоМеста,
		|	ПрограммыОбучения.Используется КАК Используется
		|ПОМЕСТИТЬ ВТВсеПрограммыОбучения
		|ИЗ
		|	ВТВсеПрограммыОбученияПредварительно КАК ПрограммыОбучения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВсеПрограммыОбучения.Используется КАК Требуется,
		|	ВсеПрограммыОбучения.ПрограммаОбучения КАК ПрограммаОбучения,
		|	ОбученияФизическогоЛица.ДатаПолучения КАК ДатаПолучения,
		|	ОбученияФизическогоЛица.Обучение КАК Обучение,
		|	ОбученияФизическогоЛица.Проверка КАК Проверка,
		|	ВЫБОР
		|		КОГДА ОбученияФизическогоЛица.ПрограммаОбучения ЕСТЬ NULL
		|			ТОГДА &ОформитьЗаголовокКомандыОбучение
		|		КОГДА ОбученияФизическогоЛица.Обучение = &ПустоеОбучение
		|			ТОГДА &ОформитьЗаголовокКомандыОбучение
		|		КОГДА ОбученияФизическогоЛица.Проверка = &ПустаяПроверка
		|			ТОГДА &ОформитьЗаголовокКомандыПроверка
		|		КОГДА НЕ ВсеПрограммыОбучения.Используется
		|			ТОГДА """"
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ПрограммыОбучения.ПроводитсяПовторно
		|					ТОГДА &ПовторитьЗаголовокКоманды
		|				ИНАЧЕ """"
		|			КОНЕЦ
		|	КОНЕЦ КАК Действие,
		|	ОбученияФизическогоЛица.РезультатПроверки КАК Результат,
		|	ПрограммыОбучения.ПроводитсяПовторно КАК ПроводитсяПовторно,
		|	ПрограммыОбучения.КоличествоРаз КАК КоличествоРаз,
		|	ПрограммыОбучения.КоличествоПериодов КАК КоличествоПериодов,
		|	ПрограммыОбучения.Периодичность КАК Периодичность,
		|	ПрограммыОбучения.ПредставлениеПериода КАК Представление
		|ИЗ
		|	ВТВсеПрограммыОбучения КАК ВсеПрограммыОбучения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда КАК ПрограммыОбучения
		|		ПО (ВЫБОР
		|				КОГДА ВсеПрограммыОбучения.Используется
		|					ТОГДА ИСТИНА
		|				КОГДА ВсеПрограммыОбучения.ЕстьПроверка
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|			И ВсеПрограммыОбучения.ПрограммаОбучения = ПрограммыОбучения.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОбученияФизическогоЛица КАК ОбученияФизическогоЛица
		|		ПО (ПрограммыОбучения.Ссылка = ОбученияФизическогоЛица.ПрограммаОбучения)
		|			И (ВЫБОР
		|				КОГДА ПрограммыОбучения.КонтролироватьСменуРабочегоМеста
		|					ТОГДА ОбученияФизическогоЛица.РабочееМесто = &РабочееМесто
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)";
	
	ОбученияПоОхранеТруда.Очистить();
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОбученияПоОхранеТруда.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если Выборка.Результат = Перечисления.РезультатыПроверкиЗнанияПоОхранеТруда.Неудовлетворительно Тогда
			НоваяСтрока.СрокДействия = Выборка.ДатаПолучения;
			Продолжить;
		КонецЕсли;
		Если Не Выборка.Требуется Тогда
			НоваяСтрока.СрокДействия = ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата();
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.ДатаПолучения) Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеПериодичности = ОбучениеПоОхранеТруда.ОписаниеПериодичностиОбучений();
		ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Выборка);
		// Обучение проводилось, проверяем его актуальность.
		НоваяСтрока.СрокДействия = ОбучениеПоОхранеТруда.ДатаСледующейПроверкиЗнания(Выборка.ДатаПолучения, ОписаниеПериодичности);
	КонецЦикла;
	
	ОбученияПоОхранеТруда.Сортировать("СрокДействия");
	
КонецПроцедуры

#КонецОбласти

#Область МедицинскиеОсмотры

&НаКлиенте
Процедура ОбработатьОповещениеМедицинскихОсмотров(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_НаправлениеНаМедицинскийОсмотр" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ФизическоеЛицо") И Параметр["ФизическоеЛицо"] = ФизическоеЛицоСсылка Тогда
				ДанныеМедицинскогоСостояния = ДанныеСостояния(ФизическоеЛицоСсылка, РабочееМесто,
					ПредопределенноеЗначение("Перечисление.ВидыОбследований.МедицинскийОсмотр"));
				ЗаполнитьСостояниеОсмотраНаКлиенте(ДанныеМедицинскогоСостояния);
				Если ИспользоватьПсихиатрическиеОсвидетельствования Тогда
					ДанныеПсихиатрическогоСостояния = ДанныеСостояния(ФизическоеЛицоСсылка, РабочееМесто,
						ПредопределенноеЗначение("Перечисление.ВидыОбследований.ПсихиатрическоеОсвидетельствование"));
					ЗаполнитьСостояниеОсмотраНаКлиенте(
						ДанныеПсихиатрическогоСостояния,
						(Не ДанныеМедицинскогоСостояния.Периодичность.Кратность = 0
						Или ДанныеМедицинскогоСостояния.Периодичность.Однократно));
				Иначе
					Элементы.ПоследнийПсихиатрическоеОсвидетельствование.Видимость = Ложь;
					Элементы.СледующийПсихиатрическоеОсвидетельствование.Видимость = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_ЗаключениеМедицинскогоОсмотра" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ФизическоеЛицо") И Параметр["ФизическоеЛицо"] = ФизическоеЛицоСсылка Тогда
				НачатьОбновлениеПериодическихОсмотров();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьМедицинскиеОсмотры()
	
	Если Не МедицинскиеОсмотры.МедицинскиеОсмотрыИспользуются(Организация) Тогда
		Элементы.ГруппаМедицинскиеОсмотры.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ПериодичностьМедицинскихОсмотровРабочихМест) Тогда
		Элементы.ГруппаМедицинскиеОсмотры.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ДобавитьУсловноеОформлениеМедицинскихОсмотров();
	
	ИспользоватьПсихиатрическиеОсвидетельствования = ПолучитьФункциональнуюОпцию(
		"ИспользоватьПсихиатрическиеОсвидетельствования", Новый Структура("Организация", Организация));
	
	ЗаполнитьМедицинскиеОсмотры();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеМедицинскихОсмотров()
	
	ИменаТаблиц = Новый Массив;
	ИменаТаблиц.Добавить("ВредныеФакторы");
	ИменаТаблиц.Добавить("ВидыРабот");
	ИменаТаблиц.Добавить("ВредныеФакторыИВидыРабот");
	
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		// Осмотр фактора не требуется:
		// - серым цветом текст,
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".Требуется", Ложь);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступногоТекста);
		ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы);
		// - подпись "Не требуется" в поле "Следующий осмотр".
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".Требуется", Ложь);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не требуется'"));
		ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "СледующийОсмотр");
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".СледующийОсмотр", НачалоДня(ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата()));
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не требуется'"));
		ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "СледующийОсмотр");
		// - подпись "Есть противопоказания" в поле "Следующий осмотр".
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".Требуется", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".Результат", Перечисления.РезультатыМедицинскогоОсмотра.ИмеетПротивопоказания);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Есть противопоказания'"));
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаКритичногоСостоянияОхраныТруда);
		ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "СледующийОсмотр");
		// Благоприятное состояние.
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".Требуется", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".СледующийОсмотр", ДобавитьМесяц(ТекущаяДата, 1), ВидСравненияКомпоновкиДанных.Больше);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаБлагоприятногоСостоянияОхраныТруда);
		ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "Состояние");
		// Состояние критичное.
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".Требуется", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".СледующийОсмотр", ДобавитьМесяц(ТекущаяДата, 1), ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаКритичногоСостоянияОхраныТруда);
		ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "");
		// Подпись последнего осмотра "Не проводился".
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, ИмяТаблицы + ".ПоследнийОсмотр", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не проводился'"));
		ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "ПоследнийОсмотр");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСостояниеОсмотраНаКлиенте(ДанныеСостояния, ТребуетсяМедОсмотр = Истина)
	
	ЗаполнитьСостояниеОсмотра(
		ЭтотОбъект,
		ОбщегоНазначенияКлиент.ОбщийМодуль("СтроковыеФункцииКлиент"),
		ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияКлиент"),
		ДанныеСостояния,
		ТребуетсяМедОсмотр);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостояниеОсмотраНаСервере(ДанныеСостояния, ТребуетсяМедОсмотр = Истина)
	
	ЗаполнитьСостояниеОсмотра(
		ЭтотОбъект,
		ОбщегоНазначения.ОбщийМодуль("СтроковыеФункции"),
		ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначения"),
		ДанныеСостояния,
		ТребуетсяМедОсмотр);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСостояниеОсмотра(Форма, МодульСтроковыеФункции, МодульОбщегоНазначения, ДанныеСостояния, ТребуетсяМедОсмотр)
	
	ЗаполнитьИнформациюПоследнегоОсмотра(Форма, МодульСтроковыеФункции, МодульОбщегоНазначения, ДанныеСостояния);
	ЗаполнитьИнформациюСледующегоОсмотра(Форма, МодульСтроковыеФункции, ДанныеСостояния, ТребуетсяМедОсмотр);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеСостояния(ФизическоеЛицо, РабочееМесто, ВидОбследования)
	
	ДанныеСостояния = Новый Структура(
		"ПоследнийОсмотр,
		|Периодичность,
		|СледующийОсмотр,
		|ВыданноеНаправление,
		|ВидОбследования,
		|ЭтоМедицинскийОсмотр,
		|ЭтоПсихиатрическийОсмотр,
		|ИмяВидаОбследования");
	
	ДанныеСостояния.ПоследнийОсмотр = МедицинскиеОсмотры.ПоследнийОсмотр(ФизическоеЛицо, РабочееМесто, ВидОбследования);
	ДанныеСостояния.Периодичность = МедицинскиеОсмотры.ПериодичностьМедицинскихОсмотров(РабочееМесто, ВидОбследования);
	ДанныеСостояния.СледующийОсмотр = МедицинскиеОсмотры.СледующийОсмотр(ФизическоеЛицо, РабочееМесто, ВидОбследования);
	ДанныеСостояния.ВыданноеНаправление = МедицинскиеОсмотры.ВыданноеНаправление(ФизическоеЛицо, РабочееМесто, ВидОбследования);
	ДанныеСостояния.ЭтоМедицинскийОсмотр = ВидОбследования = Перечисления.ВидыОбследований.МедицинскийОсмотр;
	ДанныеСостояния.ЭтоПсихиатрическийОсмотр = ВидОбследования = Перечисления.ВидыОбследований.ПсихиатрическоеОсвидетельствование;
	ДанныеСостояния.ИмяВидаОбследования = ОбщегоНазначения.ИмяЗначенияПеречисления(ВидОбследования);
	
	Возврат ДанныеСостояния;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьТекущиеДанныеСотрудника(Форма)
	
	Элементы = Форма.Элементы;
	ТекущиеДанныеСотрудника = Элементы.ТекущиеДанныеСотрудника;

	Если ЗначениеЗаполнено(Форма.РабочееМесто) Тогда
		ТекущиеДанныеСотрудника.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = 'Текущее рабочее место <a href=""%1"">%2</a>'"),
			ПолучитьНавигационнуюСсылку(Форма.РабочееМесто), Строка(Форма.РабочееМесто));
		Возврат;
	КонецЕсли;

	ТекущиеДанныеСотрудника.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = 'Текущее рабочее место не назначено. <a href=""%1"">Назначить рабочее место</a>'"),
		ПолучитьНавигационнуюСсылку(ПредопределенноеЗначение("Документ.НазначениеРабочихМестСотрудникам.ПустаяСсылка")));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьИнформациюПоследнегоОсмотра(Форма, МодульСтроковыеФункции, МодульОбщегоНазначения, ДанныеСостояния)
		
	Сегодня = Форма.ТекущаяДата;
	Элементы = Форма.Элементы;
	ПоследнийОсмотр = ДанныеСостояния.ПоследнийОсмотр;
	ЭлементПоследнийОсмотр = Элементы["Последний" + ДанныеСостояния.ИмяВидаОбследования];
	
	ЭлементПоследнийОсмотр.Заголовок = Неопределено;
	
	Если ПоследнийОсмотр = Неопределено Тогда
		ЭлементПоследнийОсмотр.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекстТипаОсмотра = Строка(ПоследнийОсмотр.ТипОсмотра);
	Если ДанныеСостояния.ЭтоМедицинскийОсмотр Тогда
		ТекстНадписи = НСтр("ru = '%1 медицинский осмотр <a href=""%2"">пройден %3</a>'");
	ИначеЕсли ДанныеСостояния.ЭтоПсихиатрическийОсмотр Тогда
		ТекстНадписи = НСтр("ru = '%1 психиатрическое освидетельствование <a href=""%2"">пройдено %3</a>'");
		Если ПоследнийОсмотр.ТипОсмотра = МодульОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ТипыМедицинскогоОсмотра.Предварительный") Тогда
			ТекстТипаОсмотра = НСтр("ru = 'Предварительное'");
		ИначеЕсли ПоследнийОсмотр.ТипОсмотра = МодульОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ТипыМедицинскогоОсмотра.Периодический") Тогда
			ТекстТипаОсмотра = НСтр("ru = 'Периодическое'");
		ИначеЕсли ПоследнийОсмотр.ТипОсмотра = МодульОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ТипыМедицинскогоОсмотра.Внеплановый") Тогда
			ТекстТипаОсмотра = НСтр("ru = 'Внеплановое'");
		КонецЕсли;
	Иначе
		
	КонецЕсли;
	
	ТекстНадписи = СтрШаблон(ТекстНадписи, ТекстТипаОсмотра,
		ПолучитьНавигационнуюСсылку(ПоследнийОсмотр.Регистратор), Формат(ПоследнийОсмотр.Период, "ДЛФ=D"));
	
	Если ПоследнийОсмотр.РезультатОсмотра = ПредопределенноеЗначение(
		"Перечисление.РезультатыМедицинскогоОсмотра.ИмеетПротивопоказания") Тогда
		ТекстКартинки	= "<img src=""Предупреждение"">";
		ТекстКритичный	= НСтр("ru = 'Имеются противопоказания, требуется отстранение от работы'");
		ТекстНадписи	= СтрШаблон(
			НСтр("ru = '%1 %2 <span style=""color: ЦветТекстаКритичногоСостоянияОхраныТруда"">%3</span>'"),
			ТекстНадписи, ТекстКартинки, ТекстКритичный);
	КонецЕсли;
	
	ЭлементПоследнийОсмотр.Заголовок = МодульСтроковыеФункции.ФорматированнаяСтрока(ТекстНадписи);
	ЭлементПоследнийОсмотр.Видимость = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьИнформациюСледующегоОсмотра(Форма, МодульСтроковыеФункции, ДанныеСостояния, ТребуетсяМедОсмотр)
	
	Сегодня = Форма.ТекущаяДата;
	Элементы = Форма.Элементы;
	Периодичность = ДанныеСостояния.Периодичность;
	СледующийОсмотр = ДанныеСостояния.СледующийОсмотр;
	ВыданноеНаправление = ДанныеСостояния.ВыданноеНаправление;
	ЭлементСледующийОсмотр = Элементы["Следующий" + ДанныеСостояния.ИмяВидаОбследования];
	
	ЭлементСледующийОсмотр.Заголовок = Неопределено;
	
	Если Периодичность.Кратность = 0 И Не Периодичность.Однократно Тогда
		Если Не ТребуетсяМедОсмотр Тогда
			ЭлементСледующийОсмотр.Заголовок =
				НСтр("ru = 'Текущее рабочее место не требует прохождения обязательных медицинских осмотров и психиатрических освидетельствований'");
			Элементы.СледующийМедицинскийОсмотр.Видимость = Ложь;
		ИначеЕсли ДанныеСостояния.ЭтоМедицинскийОсмотр Тогда
			ЭлементСледующийОсмотр.Заголовок =
				НСтр("ru = 'Текущее рабочее место не требует прохождения обязательных медицинских осмотров'");
		ИначеЕсли ДанныеСостояния.ЭтоПсихиатрическийОсмотр Тогда
			ЭлементСледующийОсмотр.Заголовок =
				НСтр("ru = 'Текущее рабочее место не требует прохождения обязательных психиатрических освидетельствований'");
		Иначе
			ЭлементСледующийОсмотр.Заголовок = "";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СледующийОсмотр = Неопределено Тогда
		ЭлементСледующийОсмотр.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекстНадписи = "";
	ДатаСледующегоОсмотраПросрочена = СледующийОсмотр.ДатаСледующегоОсмотра < Сегодня;
	ОднократныйОсмотр = ДанныеСостояния.Периодичность.Однократно;
	Если ДатаСледующегоОсмотраПросрочена Тогда
		Если ДанныеСостояния.ЭтоМедицинскийОсмотр Тогда
			ТекстНадписи = СтрШаблон(
				НСтр("ru = 'Следующий осмотр должен был пройти %1, требуется пройти осмотр немедленно.'"),
				Формат(СледующийОсмотр.ДатаСледующегоОсмотра, "ДЛФ=D"));
		ИначеЕсли ДанныеСостояния.ЭтоПсихиатрическийОсмотр Тогда
			ТекстНадписи = СтрШаблон(
				НСтр("ru = 'Следующее освидетельствование должно было пройти %1, требуется пройти освидетельствование немедленно.'"),
				Формат(СледующийОсмотр.ДатаСледующегоОсмотра, "ДЛФ=D"));
		КонецЕсли;
		ТекстНадписи = СтрШаблон(
			НСтр("ru = '<img src=""Предупреждение""> <span style=""color: ЦветТекстаКритичногоСостоянияОхраныТруда"">%1</span>'"),
			ТекстНадписи);
	ИначеЕсли СледующийОсмотр.ДатаСледующегоОсмотра < ДобавитьМесяц(Сегодня, 1) И Не ОднократныйОсмотр Тогда
		Если ДанныеСостояния.ЭтоМедицинскийОсмотр Тогда
			ТекстНадписи = СтрШаблон(
				НСтр("ru = 'Следующий осмотр должен пройти не позднее %1, осталось меньше месяца.'"),
				Формат(СледующийОсмотр.ДатаСледующегоОсмотра, "ДЛФ=D"));
		ИначеЕсли ДанныеСостояния.ЭтоПсихиатрическийОсмотр Тогда
			ТекстНадписи = СтрШаблон(
				НСтр("ru = 'Следующее освидетельствование должно пройти не позднее %1, осталось меньше месяца.'"),
				Формат(СледующийОсмотр.ДатаСледующегоОсмотра, "ДЛФ=D"));
		КонецЕсли;
		ТекстНадписи = СтрШаблон(
			НСтр("ru = '<span style=""color: ЦветТекстаКритичногоСостоянияОхраныТруда"">%1</span>'"), ТекстНадписи);
	ИначеЕсли Не ОднократныйОсмотр Тогда
		Если ДанныеСостояния.ЭтоМедицинскийОсмотр Тогда
			ТекстНадписи = СтрШаблон(
				НСтр("ru = 'Следующий осмотр должен пройти не позднее %1, осталось %2.'"),
				Формат(СледующийОсмотр.ДатаСледующегоОсмотра, "ДЛФ=D"),
				РазностьДатСтрокой(Сегодня, СледующийОсмотр.ДатаСледующегоОсмотра));
		ИначеЕсли ДанныеСостояния.ЭтоПсихиатрическийОсмотр Тогда
			ТекстНадписи = СтрШаблон(
				НСтр("ru = 'Следующее освидетельствование должно пройти не позднее %1, осталось %2.'"),
				Формат(СледующийОсмотр.ДатаСледующегоОсмотра, "ДЛФ=D"),
				РазностьДатСтрокой(Сегодня, СледующийОсмотр.ДатаСледующегоОсмотра));
		КонецЕсли;
	КонецЕсли;
	
	Если ВыданноеНаправление = Неопределено Тогда
		Если Не ОднократныйОсмотр Тогда
			ТекстНадписи = СтрШаблон(
				НСтр("ru = '%1 <a href=""%2"">Направить сейчас</a>'"),
				ТекстНадписи,
				ПолучитьНавигационнуюСсылку(ПредопределенноеЗначение("Документ.НаправлениеНаМедицинскийОсмотр.ПустаяСсылка")));
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ВыданноеНаправление.Направление) Тогда
			Если Не ЗначениеЗаполнено(ВыданноеНаправление.Заключение) Тогда
				Если ДанныеСостояния.ЭтоМедицинскийОсмотр Тогда
					ТекстНадписи = СтрШаблон(
						НСтр("ru = '%1 <a href=""%2"">Направлен на медицинский осмотр</a>, заключения пока нет.'"),
						ТекстНадписи,
						ПолучитьНавигационнуюСсылку(ВыданноеНаправление.Направление));
				ИначеЕсли ДанныеСостояния.ЭтоПсихиатрическийОсмотр Тогда
					ТекстНадписи = СтрШаблон(
						НСтр("ru = '%1 <a href=""%2"">Направлен на психиатрическое освидетельствование</a>, заключения пока нет.'"),
						ТекстНадписи,
						ПолучитьНавигационнуюСсылку(ВыданноеНаправление.Направление));
				КонецЕсли;
			Иначе
				ТекстНадписи = СтрШаблон(
					НСтр("ru = '%1 <a href=""%2"">Заключение получено</a>, но документ не проведен.'"),
					ТекстНадписи,
					ПолучитьНавигационнуюСсылку(ВыданноеНаправление.Заключение));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СледующийОсмотр <> Неопределено И ЗначениеЗаполнено(СледующийОсмотр.ДатаУвольнения) Тогда
		ТекстНадписи = СтрШаблон(НСтр("ru = '%1 Сотрудник увольняется %2'"),
			ТекстНадписи,
			Формат(СледующийОсмотр.ДатаУвольнения, "ДФ='dd.MM.yyyy''г.'''"));
	КонецЕсли;
	
	ЭлементСледующийОсмотр.Заголовок = МодульСтроковыеФункции.ФорматированнаяСтрока(ТекстНадписи);
	ЭлементСледующийОсмотр.Видимость = ЗначениеЗаполнено(ТекстНадписи);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФакторыМедицинскогоОсмотра()
	
	ВредныеФакторыИВидыРабот.Очистить();
	ОсмотрыПоВреднымФакторамИВидамРабот =
		МедицинскиеОсмотры.ОсмотрыПоВреднымФакторамИВидамРаботФизическогоЛица(
			ФизическоеЛицоСсылка, РабочееМесто, ИспользоватьПсихиатрическиеОсвидетельствования);
	Для Каждого СтрокаТаблицы Из ОсмотрыПоВреднымФакторамИВидамРабот Цикл
		НоваяСтрока = ВредныеФакторыИВидыРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.Периодичность = СтрокаТаблицы.Периодичность.Представление;
		НоваяСтрока.Состояние = ПредставлениеСостояния(СтрокаТаблицы.СостояниеПроцент);
	КонецЦикла;
	ВредныеФакторыИВидыРабот.Сортировать("Требуется Убыв, СледующийОсмотр Убыв");
	
	ВредныеФакторы.Очистить();
	ОсмотрыПоВреднымФакторам = МедицинскиеОсмотры.ОсмотрыПоВреднымФакторамФизическогоЛица(
		ФизическоеЛицоСсылка, РабочееМесто, ИспользоватьПсихиатрическиеОсвидетельствования);
	Для Каждого СтрокаТаблицы Из ОсмотрыПоВреднымФакторам Цикл
		НоваяСтрока = ВредныеФакторы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.Периодичность = СтрокаТаблицы.Периодичность.Представление;
		НоваяСтрока.Состояние = ПредставлениеСостояния(СтрокаТаблицы.СостояниеПроцент);
	КонецЦикла;
	ВредныеФакторы.Сортировать("Требуется Убыв, СледующийОсмотр Убыв");
	
	ВидыРабот.Очистить();
	ОсмотрыПоВидамРабот = МедицинскиеОсмотры.ОсмотрыПоВидамРаботФизическогоЛица(
		ФизическоеЛицоСсылка, РабочееМесто, ИспользоватьПсихиатрическиеОсвидетельствования);
	Для Каждого СтрокаТаблицы Из ОсмотрыПоВидамРабот Цикл
		НоваяСтрока = ВидыРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.Периодичность = СтрокаТаблицы.Периодичность.Представление;
		НоваяСтрока.Состояние = ПредставлениеСостояния(СтрокаТаблицы.СостояниеПроцент);
	КонецЦикла;
	ВидыРабот.Сортировать("Требуется Убыв, СледующийОсмотр Убыв");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНавигационнуюСсылкуНаправлениеНаМедицинскийОсмотрСоздать(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)

	ПустаяСсылка = ПредопределенноеЗначение("Документ.НаправлениеНаМедицинскийОсмотр.ПустаяСсылка");
	Если ПолучитьНавигационнуюСсылку(ПустаяСсылка) <> НавигационнаяСсылкаФорматированнойСтроки Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения");
	ПараметрыФормы.ЗначенияЗаполнения = Новый Структура(
		"ФизическоеЛицо,
		|Организация,
		|ВидОсмотра,
		|ТипОсмотра,
		|РабочееМесто");
	ПараметрыФормы.ЗначенияЗаполнения.ФизическоеЛицо = ФизическоеЛицоСсылка;
	ПараметрыФормы.ЗначенияЗаполнения.Организация = Организация;
	ПараметрыФормы.ЗначенияЗаполнения.ТипОсмотра = ПредопределенноеЗначение(
		"Перечисление.ТипыМедицинскогоОсмотра.Периодический");
	ПараметрыФормы.ЗначенияЗаполнения.РабочееМесто = РабочееМесто;

	Если ТекущийЭлемент.Имя = "СледующийМедицинскийОсмотр" Тогда
		ПараметрыФормы.ЗначенияЗаполнения.ВидОсмотра = ПредопределенноеЗначение(
			"Перечисление.ВидыОбследований.МедицинскийОсмотр");
	ИначеЕсли ТекущийЭлемент.Имя = "СледующийПсихиатрическоеОсвидетельствование" Тогда
		ПараметрыФормы.ЗначенияЗаполнения.ВидОсмотра = ПредопределенноеЗначение(
			"Перечисление.ВидыОбследований.ПсихиатрическоеОсвидетельствование");
	КонецЕсли;
	
	ОткрытьФорму("Документ.НаправлениеНаМедицинскийОсмотр.Форма.ФормаДокумента", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазностьДатСтрокой(Знач ДатаНачала, Знач ДатаОкончания)
	
	Возврат ЗарплатаКадрыКлиентСервер.ПредставлениеВременногоИнтервала(ДатаНачала, ДатаОкончания);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеСостояния(СостояниеПроцент)
	
	Представление = "";
	
	МаркерЗаполнен = "●";
	МаркерНеЗаполнен = "○";
	
	ВсегоМаркеров = 5;
	Значение = Окр(СостояниеПроцент * ВсегоМаркеров / 100);
	
	Для НомерМаркера = 1 По ВсегоМаркеров Цикл
		Маркер = МаркерНеЗаполнен;
		Если НомерМаркера <= Значение Тогда
			Маркер = МаркерЗаполнен;
		КонецЕсли;
		Представление = Представление + Маркер;
	КонецЦикла;
	
	Возврат Представление;
	
КонецФункции

&НаКлиенте
Процедура НачатьОбновлениеПериодическихОсмотров(ПоказыватьСообщения = Ложь)
	
	ДлительнаяОперация = ОбновитьПериодическиеОсмотрыНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	Если ПоказыватьСообщения Тогда
		ПараметрыОжидания.ВыводитьСообщения = Истина;
	Иначе
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновлениеПериодическихОсмотровЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеПериодическихОсмотровЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЗаполнитьМедицинскиеОсмотры();
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьМедицинскиеОсмотры()
	
	ДанныеМедицинскогоСостояния = ДанныеСостояния(
		ФизическоеЛицоСсылка,
		РабочееМесто,
		Перечисления.ВидыОбследований.МедицинскийОсмотр);
	ЗаполнитьСостояниеОсмотраНаСервере(ДанныеМедицинскогоСостояния);
	
	Если ИспользоватьПсихиатрическиеОсвидетельствования Тогда
		ДанныеПсихиатрическогоСостояния = ДанныеСостояния(
			ФизическоеЛицоСсылка,
			РабочееМесто,
			Перечисления.ВидыОбследований.ПсихиатрическоеОсвидетельствование);
		ЗаполнитьСостояниеОсмотраНаСервере(
			ДанныеПсихиатрическогоСостояния,
			(Не ДанныеМедицинскогоСостояния.Периодичность.Кратность = 0
			Или ДанныеМедицинскогоСостояния.Периодичность.Однократно));
	Иначе
		Элементы.ПоследнийПсихиатрическоеОсвидетельствование.Видимость = Ложь;
		Элементы.СледующийПсихиатрическоеОсвидетельствование.Видимость = Ложь;
	КонецЕсли;
	
	ЗаполнитьФакторыМедицинскогоОсмотра();
	
КонецПроцедуры 

&НаСервере
Функция ОбновитьПериодическиеОсмотрыНаСервере()
	
	ПараметрыПроцедуры = Новый Структура("ФизическиеЛица");
	ПараметрыПроцедуры.ФизическиеЛица = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическоеЛицоСсылка);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обновление сведений о периодических медицинских осмотрах физического лица'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("МедицинскиеОсмотры.ОбновитьПериодическиеОсмотрыФизическихЛицДлительнаяОперация", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

#КонецОбласти

#Область СредстваИндивидуальнойЗащиты

&НаКлиенте
Процедура ОбработатьОповещениеСИЗ(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ЗаказНаВыдачуСИЗ" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ФизическиеЛица") И Параметр["ФизическиеЛица"].Найти(ФизическоеЛицоСсылка) <> Неопределено Тогда
				ЗаполнитьСИЗ();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_ВыдачаСИЗ"
	 Или ИмяСобытия = "Запись_ПродлениеСроковНоскиСИЗ"
	 Или ИмяСобытия = "Запись_СписаниеСИЗИзЭксплуатации" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("ФизическиеЛица") И Параметр["ФизическиеЛица"].Найти(ФизическоеЛицоСсылка) <> Неопределено Тогда
				НачатьОбновлениеНормВыдачиСИЗ();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСредстваИндивидуальнойЗащиты()
	
	Если Не СредстваИндивидуальнойЗащиты.СредстваИндивидуальнойЗащитыИспользуются(Организация) Тогда
		Элементы.ГруппаСИЗ.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	УстановитьЗначенияПравДоступаСИЗ();
	
	Если Не ДоступенПросмотрАнтропометрияФизическихЛиц Тогда
		Элементы.ГруппаСИЗ.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ДобавитьУсловноеОформлениеСИЗ();
	ЗаполнитьСИЗ();
	
	Элементы.ДекорацияАнтропометрия.Заголовок = ПредставлениеАнтропометрииФизическогоЛица();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияПравДоступаСИЗ()
	
	ДоступенПросмотрАнтропометрияФизическихЛиц = ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.АнтропометрияФизическихЛиц);
	ДоступноРедактированиеАнтропометрияФизическихЛиц = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.АнтропометрияФизическихЛиц);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСИЗ()
	
	ДанныеВыдачи = Новый Структура(
		"ПоследняяВыдача,
		|Периодичность,
		|СледующаяВыдача,
		|СформированныйЗаказНаВыдачу");
	
	ДанныеВыдачи.ПоследняяВыдача = СредстваИндивидуальнойЗащиты.ПоследняяВыдача(ФизическоеЛицоСсылка, РабочееМесто);
	ДанныеВыдачи.Периодичность = СредстваИндивидуальнойЗащиты.ПериодичностьВыдачиСИЗ(РабочееМесто);
	ДанныеВыдачи.СледующаяВыдача = СредстваИндивидуальнойЗащиты.СледующаяВыдача(ФизическоеЛицоСсылка, РабочееМесто);
	ДанныеВыдачи.СформированныйЗаказНаВыдачу = СредстваИндивидуальнойЗащиты.СформированныйЗаказНаВыдачу(ФизическоеЛицоСсылка, РабочееМесто);
	
	МодульСтроковыеФункции = ОбщегоНазначения.ОбщийМодуль("СтроковыеФункции");
	ДатаАктуальности = НачалоДня(ТекущаяДатаСеанса());
	ЗаполнитьИнформациюПоследнейВыдачи(ЭтотОбъект, МодульСтроковыеФункции, ДатаАктуальности, ДанныеВыдачи);
	ЗаполнитьИнформациюСледующейВыдачи(ЭтотОбъект, МодульСтроковыеФункции, ДатаАктуальности, ДанныеВыдачи);
	
	ЗаполнитьНормыВыдачиСИЗ();
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьНормыВыдачиСИЗ()
	
	НормыВыдачиСИЗ.Очистить();
	НормыВыдачиСИЗФизическогоЛица = СредстваИндивидуальнойЗащиты.НормыВыдачиСИЗФизическогоЛица(ФизическоеЛицоСсылка, РабочееМесто);
	Для Каждого СтрокаТаблицы Из НормыВыдачиСИЗФизическогоЛица Цикл
		НоваяСтрока = НормыВыдачиСИЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.Периодичность = СтрокаТаблицы.Периодичность.Представление;
		НоваяСтрока.СпособВыдачи = СтрокаТаблицы.Периодичность.СпособВыдачи;
		НоваяСтрока.Состояние = ПредставлениеСостояния(СтрокаТаблицы.СостояниеПроцент);
	КонецЦикла;
	НормыВыдачиСИЗ.Сортировать("Требуется Убыв, СледующаяВыдача Убыв");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеСИЗ()
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ИмяТаблицы = "НормыВыдачиСИЗ";
	
	// Осмотр фактора не требуется:
	// - серым цветом текст,
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "НормыВыдачиСИЗ.Требуется", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступногоТекста);
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы);
	// - подпись "Не требуется" в поле "Следующая выдача".
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "НормыВыдачиСИЗ.Требуется", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не требуется'"));
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("НормыВыдачиСИЗСледующаяВыдача");
	// - подпись "Не выдано" в поле "Следующая выдача".
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "НормыВыдачиСИЗ.Требуется", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "НормыВыдачиСИЗ.Результат", Перечисления.РезультатыМедицинскогоОсмотра.ИмеетПротивопоказания);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не выдано'"));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаКритичногоСостоянияОхраныТруда);
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("НормыВыдачиСИЗСледующаяВыдача");
	// - подпись "До износа" в поле "Следующая выдача".
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "НормыВыдачиСИЗ.СпособВыдачи", Перечисления.СпособыВыдачиСИЗ.ДоИзноса);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'До износа'"));
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("НормыВыдачиСИЗСледующаяВыдача");
	// Благоприятное состояние.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "НормыВыдачиСИЗ.Требуется", Истина);
	ГруппаОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "НормыВыдачиСИЗ.СледующаяВыдача", ДобавитьМесяц(Сегодня, 1), ВидСравненияКомпоновкиДанных.Больше);
	ГруппаОтбораМесяц = ГруппаОтбора.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбораМесяц.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	НачалоСледующейНедели = Сегодня + 7*24*60*60 ;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораМесяц, "НормыВыдачиСИЗ.СледующаяВыдача", НачалоСледующейНедели, ВидСравненияКомпоновкиДанных.Больше);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораМесяц, "НормыВыдачиСИЗ.Периодичность", НСтр("ru = '1 раз в месяц'"), ВидСравненияКомпоновкиДанных.Содержит);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаБлагоприятногоСостоянияОхраныТруда);
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("НормыВыдачиСИЗСостояние");
	// Состояние критичное.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "НормыВыдачиСИЗ.Требуется", Истина);
	ГруппаОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "НормыВыдачиСИЗ.СледующаяВыдача", ДобавитьМесяц(Сегодня, 1), ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "НормыВыдачиСИЗ.Периодичность", НСтр("ru = '1 раз в месяц'"), ВидСравненияКомпоновкиДанных.НеСодержит);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаКритичногоСостоянияОхраныТруда);
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("НормыВыдачиСИЗ");
	// Подпись последней выдачи "Не выдавалось".
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, "НормыВыдачиСИЗ.ПоследняяВыдача", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не выдавалось'"));
	ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("НормыВыдачиСИЗПоследняяВыдача");
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеАнтропометрииФизическогоЛица()
	Возврат ОхранаТруда.ПредставлениеАнтропометрииФизическогоЛица(ФизическоеЛицоСсылка);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьИнформациюПоследнейВыдачи(Форма, МодульСтроковыеФункции, Сегодня, ДанныеВыдачи)
	
	Элементы = Форма.Элементы;
	ПоследняяВыдача = ДанныеВыдачи.ПоследняяВыдача;
	
	Элементы.ПоследняяВыдача.Заголовок = Неопределено;
	
	Если ПоследняяВыдача = Неопределено Тогда
		Элементы.ПоследняяВыдача.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекстНадписи = СтрШаблон(НСтр("ru = 'Средства индивидуальной защиты <a href=""%1"">выданы %2</a>'"),
		ПолучитьНавигационнуюСсылку(ПоследняяВыдача.Регистратор), Формат(ПоследняяВыдача.Период, "ДЛФ=D"));
	
	Если ПоследняяВыдача.РезультатВыдачи = ПредопределенноеЗначение("Перечисление.РезультатыВыдачиСИЗ.НеВыдано") Тогда
		ТекстКартинки	= "<img src=""Предупреждение"">";
		ТекстКритичный	= НСтр("ru = 'Спецодежда не выдана, требуется отстранение от работы'");
		ТекстНадписи	= СтрШаблон(
			НСтр("ru = '%1 %2 <span style=""color: ЦветТекстаКритичногоСостоянияОхраныТруда"">%3</span>'"),
			ТекстНадписи, ТекстКартинки, ТекстКритичный);
	КонецЕсли;
	
	Элементы.ПоследняяВыдача.Заголовок = МодульСтроковыеФункции.ФорматированнаяСтрока(ТекстНадписи);
	Элементы.ПоследняяВыдача.Видимость = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьИнформациюСледующейВыдачи(Форма, МодульСтроковыеФункции, Сегодня, ДанныеВыдачи)

	Элементы = Форма.Элементы;
	Периодичность = ДанныеВыдачи.Периодичность;
	СледующаяВыдача = ДанныеВыдачи.СледующаяВыдача;
	СформированныйЗаказНаВыдачу = ДанныеВыдачи.СформированныйЗаказНаВыдачу;
	
	Элементы.СледующаяВыдача.Заголовок = Неопределено;
	
	Если Периодичность.Кратность = 0 Тогда
		Элементы.СледующаяВыдача.Заголовок = НСтр("ru = 'Для текущего рабочего места не установлены нормы выдачи СИЗ'");
		Возврат;
	КонецЕсли;
	
	Если СледующаяВыдача = Неопределено Тогда
		Элементы.СледующаяВыдача.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекстНадписи = "";
	ДатаСледующейВыдачиПросрочена = СледующаяВыдача.ДатаСледующейВыдачи < Сегодня;
	Если ДатаСледующейВыдачиПросрочена Тогда
		ТекстНадписи = СтрШаблон(
			НСтр("ru = 'СИЗ должны были быть выданы %1, требуется выдать СИЗ немедленно.'"),
			Формат(СледующаяВыдача.ДатаСледующейВыдачи, "ДЛФ=D"));
		ТекстНадписи = СтрШаблон(
			НСтр("ru = '<img src=""Предупреждение""> <span style=""color: ЦветТекстаКритичногоСостоянияОхраныТруда"">%1</span>'"),
			ТекстНадписи);
	ИначеЕсли СледующаяВыдача.ДатаСледующейВыдачи < ДобавитьМесяц(Сегодня, 1)
			И Не (Периодичность.Кратность = 1
				И Периодичность.Периодичность = 1
				И Периодичность.ЕдиницаПериодичности = Перечисления.Периодичность.Месяц) Тогда
		
		ТекстНадписи = СтрШаблон(
			НСтр("ru = 'СИЗ должны быть выданы не позднее %1, осталось меньше месяца.'"),
			Формат(СледующаяВыдача.ДатаСледующейВыдачи, "ДЛФ=D"));
		ТекстНадписи = СтрШаблон(
			НСтр("ru = '<span style=""color: ЦветТекстаКритичногоСостоянияОхраныТруда"">%1</span>'"), ТекстНадписи);
	Иначе
		ТекстНадписи = СтрШаблон(
			НСтр("ru = 'СИЗ должны быть выданы не позднее %1, осталось %2.'"),
			Формат(СледующаяВыдача.ДатаСледующейВыдачи, "ДЛФ=D"),
			РазностьДатСтрокой(Сегодня, СледующаяВыдача.ДатаСледующейВыдачи));
	КонецЕсли;
	
	Если СформированныйЗаказНаВыдачу = Неопределено Тогда
		ТекстНадписи = СтрШаблон(
			НСтр("ru = '%1 <a href=""%2"">Сформировать заказ на выдачу сейчас</a>'"),
			ТекстНадписи,
			ПолучитьНавигационнуюСсылку(ПредопределенноеЗначение("Документ.ЗаказНаВыдачуСИЗ.ПустаяСсылка")));
	Иначе
		Если ЗначениеЗаполнено(СформированныйЗаказНаВыдачу.ЗаказНаВыдачуСИЗ) Тогда
			ТекстНадписи = СтрШаблон(
				НСтр("ru = '%1 <a href=""%2"">Сформирован заказ на выдачу</a>, СИЗ пока не выданы.'"),
				ТекстНадписи,
				ПолучитьНавигационнуюСсылку(СформированныйЗаказНаВыдачу.ЗаказНаВыдачуСИЗ));
		КонецЕсли;
	КонецЕсли;
	
	Элементы.СледующаяВыдача.Заголовок = МодульСтроковыеФункции.ФорматированнаяСтрока(ТекстНадписи);
	Элементы.СледующаяВыдача.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОбновлениеНормВыдачиСИЗ(ПоказыватьСообщения = Ложь)
	
	ДлительнаяОперация = ОбновитьНормыВыдачиСИЗНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	Если ПоказыватьСообщения Тогда
		ПараметрыОжидания.ВыводитьСообщения = Истина;
	Иначе
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновлениеНормВыдачиСИЗЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеНормВыдачиСИЗЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСИЗ();
	
КонецПроцедуры 

&НаСервере
Функция ОбновитьНормыВыдачиСИЗНаСервере()
	
	ПараметрыПроцедуры = Новый Структура("ФизическиеЛица");
	ПараметрыПроцедуры.ФизическиеЛица = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическоеЛицоСсылка);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обновление сведений о средствах индивидуальной защиты физического лица'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("СредстваИндивидуальнойЗащиты.ОбновитьНормыВыдачиСИЗФизическихЛицДлительнаяОперация", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьНавигационнуюСсылкуЗаказНаВыдачуСИЗСоздать(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	ПустаяСсылка = ПредопределенноеЗначение("Документ.ЗаказНаВыдачуСИЗ.ПустаяСсылка");
	Если ПолучитьНавигационнуюСсылку(ПустаяСсылка) <> НавигационнаяСсылкаФорматированнойСтроки Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЗначенияЗаполнения = Новый Структура("Организация, Подразделение, ФизическиеЛицаРабочиеМеста");
	ЗначенияЗаполнения.Организация = Организация;
	ЗначенияЗаполнения.Подразделение = ПодразделениеРабочегоМеста(РабочееМесто);
	ЗначенияЗаполнения.ФизическиеЛицаРабочиеМеста = ФизическиеЛицаРабочиеМеста();
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения");
	ПараметрыФормы.ЗначенияЗаполнения = ЗначенияЗаполнения;
	
	ОткрытьФорму("Документ.ЗаказНаВыдачуСИЗ.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Функция ФизическиеЛицаРабочиеМеста()
	
	ДанныеСИЗ = Новый Массив;
	Описание = Новый Структура("ФизическоеЛицо, РабочееМесто");
	Описание.ФизическоеЛицо = ФизическоеЛицоСсылка;
	Описание.РабочееМесто = РабочееМесто;
	ДанныеСИЗ.Добавить(Описание);
	
	Возврат ДанныеСИЗ;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодразделениеРабочегоМеста(РабочееМесто)

	ДанныеРабочегоМеста = Справочники.РабочиеМестаОхраныТруда.ДанныеРабочегоМеста(РабочееМесто);
	Если ДанныеРабочегоМеста = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеРабочегоМеста.Подразделение;
	
КонецФункции

#КонецОбласти

#КонецОбласти
