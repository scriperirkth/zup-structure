#КонецОбласти

#Область СводныеДанныеДляТехПоддержки

&НаСервере
Процедура ВывестиСводДанныеДляТехПоддержки(ДанныеДляТехПоддержки)
	
	Результат = Новый Массив;
	
	Для Каждого КлючЗначение Из ДанныеДляТехПоддержки Цикл
		
		Результат.Добавить(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1: %2'"),
				КлючЗначение.Ключ,
				ЗначениеТехИнфо(КлючЗначение.Значение, "")));
		
	КонецЦикла;
	
	СводнаяДляТехПоддержки.УстановитьТекст(
		СтрСоединить(Результат, Символы.ПС));
	
КонецПроцедуры

&НаСервере
Функция ЗначениеТехИнфо(Значение, Отступ)
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Результат.Добавить(Отступ);
		Индекс = 0;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2%3: %4'"),
					Отступ,
					Символы.Таб,
					Формат(Индекс, "ЧН=0; ЧГ="),
					ЗначениеТехИнфо(Элемент, Отступ + Символы.Таб)));
			Индекс = Индекс + 1;
		КонецЦикла;
		Возврат СтрСоединить(Результат, Символы.ПС);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура")
		Или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		Или ТипЗнч(Значение) = Тип("Соответствие")
		Или ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		
		Результат = Новый Массив;
		Результат.Добавить(Отступ);
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Добавить(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1%2%3: %4'"),
					Отступ,
					Символы.Таб,
					КлючЗначение.Ключ,
					ЗначениеТехИнфо(КлючЗначение.Значение, Отступ + Символы.Таб)));
		КонецЦикла;
		Возврат СтрСоединить(Результат, Символы.ПС);
		
	Иначе
		Возврат Строка(Значение);
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ПроверкаОбновлений

&НаКлиенте
Процедура ПроверитьНаличиеОбновленийКонфигурации()
	
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ПолучениеОбновленийПрограммы") Тогда
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ПроверитьНаличиеОбновленийЗапускЗадания(УникальныйИдентификатор);
	Если ДлительнаяОперация.Статус = "Выполнено"
		Или ДлительнаяОперация.Статус = "Ошибка" Тогда
		
		ПроверитьНаличиеОбновленийЗавершение(ДлительнаяОперация);
		
	Иначе
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения(
			"ПроверитьНаличиеОбновленийЗавершение",
			ЭтотОбъект);
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			ДлительнаяОперация,
			ОповещениеОЗавершении,
			ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНаличиеОбновленийЗапускЗадания(Знач УникальныйИдентификатор)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'Проверка наличия обновления конфигурации.'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"ПолучениеОбновленийПрограммы.ИнформацияОДоступномОбновлении");
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстДекорацииВерсия(Знач АдресРезультата, Знач ТекущаяВерсия)
	
	НовыйТекстДекорации = ТекущаяВерсия;
	
	РезультатОперации = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если Не ЗначениеЗаполнено(РезультатОперации.ИмяОшибки) Тогда
		Если РезультатОперации.Конфигурация <> Неопределено
			И РезультатОперации.Конфигурация.ДоступноОбновление Тогда

			// Сюда попадаем только если подсистема получения обновлений существует,
			// поэтому нет проверки существования подсистемы
			
			МодульПолучениеОбновленийПрограммы = ОбщегоНазначения.ОбщийМодуль("ПолучениеОбновленийПрограммы");
			СсылкаОбновление = "";
			Если МодульПолучениеОбновленийПрограммы.ДоступноИспользованиеОбновленияПрограммы(Истина) Тогда
				СсылкаОбновление = " <a href=""open:updateConfig"">Обновить</a>";
			КонецЕсли;
			
			НовыйТекстДекорации = СтроковыеФункции.ФорматированнаяСтрока(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '<span style=""color: Оранжевый"">%1 (доступна версия %2)</span>%3'"),
					ТекущаяВерсия,
					РезультатОперации.Конфигурация.Версия,
					СсылкаОбновление));
				
		Иначе
			
			НовыйТекстДекорации = СтроковыеФункции.ФорматированнаяСтрока(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '<span style=""color: Зеленый"">%1 (актуальная версия)</span>'"),
					ТекущаяВерсия,
					РезультатОперации.Конфигурация.Версия));
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НовыйТекстДекорации;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьНаличиеОбновленийЗавершение(РезультатОперации, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДекорацияЗаголовок = "ДекорацияТекст_" + КешФормы.ИдентификаторыИзменяемыхЭлементов.Версия;
	НовыйТекстДекорации = СокрЛП(Строка(Элементы[ДекорацияЗаголовок].Заголовок));
	
	Если РезультатОперации.Статус = "Выполнено" Тогда
		НовыйТекстДекорации = ТекстДекорацииВерсия(
			РезультатОперации.АдресРезультата,
			НовыйТекстДекорации);
	КонецЕсли;

	Элементы[ДекорацияЗаголовок].Заголовок = НовыйТекстДекорации;
	
КонецПроцедуры

#КонецОбласти

#Область РегистрационныйНомер

&НаКлиенте
Асинх Процедура ВвестиРегистрационныйНомер()
	
	Если Не ЗначениеЗаполнено(КешФормы.ИдентификаторыИзменяемыхЭлементов.РегистрационныйНомер) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяДекорации = "ДекорацияТекст_" + КешФормы.ИдентификаторыИзменяемыхЭлементов.РегистрационныйНомер;
	
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.СообщенияВСлужбуТехническойПоддержки") Тогда
		Элементы[ИмяДекорации].Заголовок = НедоступноИзменениеРегистрационногоНомера();
		Возврат;
	КонецЕсли;
	
	ИсходноеЗначение = ПрочитатьРегистрационныйНомер();
	
	НовоеЗначение = Ждать ВвестиСтрокуАсинх(
		ИсходноеЗначение,
		НСтр("ru = 'Регистрационный номер'"),
		100);
	
	Если НовоеЗначение = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	УстановитьРегистрационныйНомер(НовоеЗначение);
	
	ТекстРегНомер = ?(ЗначениеЗаполнено(НовоеЗначение),
		НовоеЗначение,
		ПустойРегистрационныйНомер());
		
	Элементы[ИмяДекорации].Заголовок = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '<a href=""open:regNo"">%1</a>'"),
			ТекстРегНомер));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьРегистрационныйНомер()
	
	// Вызов метода только после проверки существования подсистемы
	МодульСообщенияВСлужбуТехническойПоддержки = ОбщегоНазначения.ОбщийМодуль("СообщенияВСлужбуТехническойПоддержки");
	Возврат МодульСообщенияВСлужбуТехническойПоддержки.РегистрационныйНомер();
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьРегистрационныйНомер(Знач РегистрационныйНомер)
	
	// Вызов метода только после проверки существования подсистемы	
	МодульСообщенияВСлужбуТехническойПоддержки = ОбщегоНазначения.ОбщийМодуль("СообщенияВСлужбуТехническойПоддержки");
	МодульСообщенияВСлужбуТехническойПоддержки.УстановитьРегистрационныйНомер(РегистрационныйНомер);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПустойРегистрационныйНомер()
	
	Возврат НСтр("ru = '<Укажите регистрационный номер>'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НедоступноИзменениеРегистрационногоНомера()
	
	Возврат НСтр("ru = '<Недоступно>'");
	
КонецФункции

#КонецОбласти

#Область СохранениеВФайл

&НаКлиенте
Асинх Процедура СохранитьВФайлПослеПодключенияРасширения(Подключено, ДополнительныеПараметры) Экспорт
	
	Если Не Подключено Тогда
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = НСтр("ru = 'Укажите имя файла для сохранения'");
	Диалог.Фильтр = "*.json|*.json";
	
	РезультатВыбора = Ждать Диалог.ВыбратьАсинх();
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ДанныеФайла = ПолучитьДвоичныеДанныеИзСтроки(СводнаяДляТехПоддержкиJSON, "UTF-8");
		Ждать ДанныеФайла.ЗаписатьАсинх(Диалог.ПолноеИмяФайла);
		
		Обработчик = Новый ОписаниеОповещения(
			"СохранитьВФайлОбработкаОповещениеПользователя",
			ЭтотОбъект,
			Диалог.ПолноеИмяФайла);
		
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Информация сохранена в файл'"),
			Обработчик,
			Диалог.ПолноеИмяФайла);
	Исключение
		ПоказатьПредупреждение(
			Неопределено,
			НСтр("ru = 'Не удалось сохранить информацию в файл.
				|Подробности см. в журнале регистрации.'"));

		ЗаписатьВЖурнал(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось записать файл %1.
				|%2'"),
				Диалог.ПолноеИмяФайла,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайлОбработкаОповещениеПользователя(
		ИмяФайла) Экспорт
	
	ФайловаяСистемаКлиент.ОткрытьФайл(ИмяФайла);
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеСлужебныеПроцедурыИФункции

&НаСервере
Функция ТипПриложения()
	
	ТипПриложения = КлиентскоеПриложение.ТипПриложения();
	Если ТипПриложения = ТипКлиентскогоПриложения.ТонкийКлиент Тогда
		Возврат НСтр("ru = 'Тонкий клиент'");
		
	ИначеЕсли ТипПриложения = ТипКлиентскогоПриложения.ТолстыйКлиент Тогда
		Возврат НСтр("ru = 'Толстый клиент'");
		
	ИначеЕсли ТипПриложения = ТипКлиентскогоПриложения.ВебКлиент Тогда
		Возврат НСтр("ru = 'Веб-клиент'");
		
	ИначеЕсли ТипПриложения = ТипКлиентскогоПриложения.МобильныйКлиент Тогда
		Возврат НСтр("ru = 'Мобильный клиент'");
		
	ИначеЕсли ТипПриложения = ТипКлиентскогоПриложения.МобильноеПриложениеКлиент Тогда
		Возврат НСтр("ru = 'Мобильное приложение'");
		
	ИначеЕсли ТипПриложения = ТипКлиентскогоПриложения.ВнешнееСоединение Тогда
		Возврат НСтр("ru = 'Внешнее соединение'");
		
	Иначе
		Возврат НСтр("ru = '<Неизвестно>'");
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ВариантИнтерфейса()
	
	ВариантИнтерфейса = КлиентскоеПриложение.ТекущийВариантИнтерфейса();
	Если ВариантИнтерфейса = ВариантИнтерфейсаКлиентскогоПриложения.Такси Тогда
		Возврат НСтр("ru = 'Такси'");
		
	ИначеЕсли ВариантИнтерфейса = ВариантИнтерфейсаКлиентскогоПриложения.Версия8_5 Тогда
		Возврат НСтр("ru = 'Версия 8.5'");
	
	ИначеЕсли ВариантИнтерфейса = ВариантИнтерфейсаКлиентскогоПриложения.Версия8_2 Тогда
		Возврат НСтр("ru = 'Версия 8.2'");
	
	Иначе
		Возврат НСтр("ru = '<Неизвестно>'");
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция РежимыСовместимости(Знач Значение, Знач ЗначениеИнтерфейс)
	
	РезультатМетода = Новый Структура(
		"РежимСовместимости, РежимСовместимостиИнтерфейса",
		НСтр("ru = '<Неизвестно>'"),
		НСтр("ru = '<Неизвестно>'"));
	
	Если Значение = "НеИспользовать" Тогда
		РезультатМетода.РежимСовместимости = НСтр("ru = 'Не использовать'");
	
	ИначеЕсли СтрНачинаетсяС(Значение, "Версия8_") Тогда
		
		ПредставлениеВерсии = НСтр("ru = 'Версия 8'");
		
		Значение = СтрЗаменить(Значение, "Версия8", ПредставлениеВерсии);
		РезультатМетода.РежимСовместимости = СтрЗаменить(Значение, "_", ".");

	КонецЕсли;
	
	Представления = Новый Соответствие;
	Представления.Вставить("Версия8_2", НСтр("ru = 'Версия 8.2'"));
	Представления.Вставить("Версия8_2РазрешитьТакси", НСтр("ru = 'Версия 8.2. Разрешить Такси'"));
	Представления.Вставить("Версия8_5", НСтр("ru = 'Версия 8.5'"));
	Представления.Вставить("Версия8_5РазрешитьТакси", НСтр("ru = 'Версия 8.5. Разрешить Такси'"));
	Представления.Вставить("Такси", НСтр("ru = 'Такси'"));
	Представления.Вставить("ТаксиРазрешитьВерсия8_2", НСтр("ru = 'Такси. Разрешить Версия 8.2'"));
	Представления.Вставить("ТаксиРазрешитьВерсия8_5", НСтр("ru = 'Такси. Разрешить Версия 8.5'"));
	
	ПредставлениеРежима = Представления.Получить(ЗначениеИнтерфейс);
	Если ПредставлениеРежима <> Неопределено Тогда
		РезультатМетода.РежимСовместимостиИнтерфейса = ПредставлениеРежима;
	КонецЕсли;
	
	Возврат РезультатМетода;
	
КонецФункции

&НаКлиенте
Асинх Процедура КопироватьТекстВБуфер(ТекстДляКопирования)
	
	УдалосьПоместить = Ждать ИнтернетПоддержкаПользователейКлиент.ПоместитьСтрокуВБуферОбмена(
		ТекстДляКопирования);
	
	Если УдалосьПоместить Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Успешно'"),
			,
			НСтр("ru = 'Информация скопирована в буфер'"));
	Иначе
		ПоказатьПредупреждение(
			Неопределено,
			НСтр("ru = 'Не удалось скопировать информацию.'"),);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьВЖурнал(Знач СообщениеОбОшибке, Знач Ошибка = Истина)
	
	ПанельПомощьСлужебный.ЗаписатьИнформациюВЖурналРегистрации(
		СообщениеОбОшибке,
		Ошибка);
	
КонецПроцедуры

