#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КешФормы = Новый Структура;
	КешФормы.Вставить("ИдентификаторыИзменяемыхЭлементов", Новый Структура);
	КешФормы.Вставить("ДанныеДляКопированияВБуфер", Новый Соответствие());

	КешФормы.ИдентификаторыИзменяемыхЭлементов.Вставить("Версия", Неопределено);
	КешФормы.ИдентификаторыИзменяемыхЭлементов.Вставить("РегистрационныйНомер", Неопределено);
	
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();
	
	ТехническаяИнформация = ВыводимаяИнформация();
	
	Если ЭтоМобильныйКлиент Тогда
		Для Каждого Информация Из ТехническаяИнформация.ОписаниеСистемы Цикл
			ВывестиИнформациюМобильныйКлиент(
				Элементы.Приложение,
				Информация);
		КонецЦикла;
	Иначе
		Для Каждого Информация Из ТехническаяИнформация.ОписаниеСистемы Цикл
			ВывестиИнформацию(
				Элементы.Приложение,
				Информация);
		КонецЦикла;
	КонецЕсли;
	
	УстановитьНастройкиФормы();
	УстановитьУсловноеОформление();
	
	Если ЭтоМобильныйКлиент И Не ИнтернетПоддержкаПользователейКлиентСервер.ЭтоИнтерфейс85() Тогда
		ВывестиКарточкиРасширений();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнтернетПоддержкаПользователейКлиент.УстановитьОтображениеКнопкиКопироватьВБуфер(
		Элементы,
		СтандартныйФорматДанныхБуфераОбмена.Текст);
	
	Если КешФормы.ИдентификаторыИзменяемыхЭлементов.Версия <> Неопределено Тогда
		ПодключитьОбработчикОжидания("ПроверитьНаличиеОбновленийКонфигурации", 0.1, Истина);
	КонецЕсли;
	
	Если Не Элементы.КопироватьВБуфер.Видимость Тогда
		Для Каждого КлючЗначение Из КешФормы.ИдентификаторыИзменяемыхЭлементов Цикл
			ИдентификаторЭлементов = КлючЗначение.Ключ;
			Элементы["КартинкаКопировать_" + ИдентификаторЭлементов].Видимость = Ложь;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Подключаемый_ДекорацияОбработкаНавигационнойСсылки(
	Элемент,
	НавигационнаяСсылкаФорматированнойСтроки,
	СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "open:updateConfig" Тогда
		СтандартнаяОбработка = Ложь;
		Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ПолучениеОбновленийПрограммы") Тогда
			МодульПолучениеОбновленийПрограммыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль(
				"ПолучениеОбновленийПрограммыКлиент");
			МодульПолучениеОбновленийПрограммыКлиент.ОбновитьПрограмму();
		КонецЕсли;
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "open:regNo" Тогда
		СтандартнаяОбработка = Ложь;
		ВвестиРегистрационныйНомер();
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КартинкаКопироватьНажатие(Элемент)

	ИдентификаторЭлемента = СтрЗаменить(Элемент.Имя, "КартинкаКопировать_", "");
	
	ТекстДляКопирования = КешФормы.ДанныеДляКопированияВБуфер.Получить(ИдентификаторЭлемента);
	Если ЗначениеЗаполнено(ТекстДляКопирования) Тогда
		КопироватьТекстВБуфер(ТекстДляКопирования);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КопироватьВБуфер(Команда)
	
	КопироватьТекстВБуфер(СводнаяДляТехПоддержкиJSON);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СохранитьВФайлПослеПодключенияРасширения",
		ЭтотОбъект);
	
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботы1СПредприятия(
		ОписаниеОповещения,
		НСтр("ru = 'Для продолжения необходимо установить расширение для работы с файлами.'"));
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыводИнформации

// Выводить единицу информации о программе
// 
// Параметры:
// 
// Родитель - ГруппаФормы - страница, на которую необходимо вывести информацию.
// ОписаниеИнформации - см. НовыйОписаниеТехническойИнформации.
// 
&НаСервере
Процедура ВывестиИнформацию(Родитель, ОписаниеИнформации)
	
	ИдентификаторЭлементов = ПанельПомощьСлужебный.НовыйИдентификаторДляИмени();
	
	НоваяГруппа = Элементы.Добавить(
		"ГруппаИнформация_" + ИдентификаторЭлементов,
		Тип("ГруппаФормы"),
		Родитель);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	НоваяГруппа.РастягиватьПоГоризонтали = Истина;
	НоваяГруппа.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Верх;
	НоваяГруппа.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
	НоваяГруппа.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	НоваяГруппа.РазрешитьИзменениеСостава = Ложь;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ДекорацияЗаголовок = Элементы.Добавить(
		"ДекорацияЗаголовок_" + ИдентификаторЭлементов,
		Тип("ДекорацияФормы"),
		НоваяГруппа);
	ДекорацияЗаголовок.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияЗаголовок.Заголовок = ОписаниеИнформации.Заголовок;
	ДекорацияЗаголовок.АвтоМаксимальнаяШирина = Ложь;
	ДекорацияЗаголовок.МаксимальнаяШирина = 30;
	ДекорацияЗаголовок.Ширина = 20;
	ДекорацияЗаголовок.РастягиватьПоГоризонтали = Ложь;
	ДекорацияЗаголовок.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Верх;
	ДекорацияЗаголовок.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
	ДекорацияЗаголовок.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
	ДекорацияЗаголовок.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
	
	ВыводимыйТекст = СтроковыеФункции.ФорматированнаяСтрока(ОписаниеИнформации.Текст);
	
	СтрокиТекста = Новый Массив;
	СтрокиТекста.Добавить(ВыводимыйТекст);
	
	Если ОписаниеИнформации.ПроверитьНаличиеОбновленийКонфигурации Тогда
		КешФормы.ИдентификаторыИзменяемыхЭлементов.Версия = ИдентификаторЭлементов;
		СтрокиТекста.Добавить("   ");
		СтрокиТекста.Добавить(БиблиотекаКартинок.ДлительнаяОперация16);
	КонецЕсли;
	
	ТекстСообщения = Новый ФорматированнаяСтрока(СтрокиТекста);
	
	ГруппаТекст = Элементы.Добавить(
		"ГруппаТекст_" + ИдентификаторЭлементов,
		Тип("ГруппаФормы"),
		НоваяГруппа);
	ГруппаТекст.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаТекст.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаТекст.ОтображатьЗаголовок = Ложь;
	ГруппаТекст.РастягиватьПоГоризонтали = Истина;
	ГруппаТекст.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Верх;
	ГруппаТекст.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
	ГруппаТекст.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	ГруппаТекст.РазрешитьИзменениеСостава = Ложь;
	ГруппаТекст.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ДекорацияТекст = Элементы.Добавить(
		"ДекорацияТекст_" + ИдентификаторЭлементов,
		Тип("ДекорацияФормы"),
		ГруппаТекст);
	ДекорацияТекст.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияТекст.Заголовок = ТекстСообщения;
	ДекорацияТекст.АвтоМаксимальнаяШирина = Ложь;
	ДекорацияТекст.РастягиватьПоГоризонтали = Истина;
	ДекорацияТекст.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Верх;
	ДекорацияТекст.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
	ДекорацияТекст.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
	ДекорацияТекст.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
	ДекорацияТекст.УстановитьДействие(
		"ОбработкаНавигационнойСсылки",
		"Подключаемый_ДекорацияОбработкаНавигационнойСсылки");
	
	Если ОписаниеИнформации.КнопкаКопирования Тогда
		
		КешФормы.ДанныеДляКопированияВБуфер.Вставить(
			ИдентификаторЭлементов,
			Строка(ВыводимыйТекст));
		
		ДекорацияТекст.РастягиватьПоГоризонтали = Ложь;
		
		ДекорацияКартинкаКопировать = Элементы.Добавить(
			"КартинкаКопировать_" + ИдентификаторЭлементов,
			Тип("ДекорацияФормы"),
			ГруппаТекст);
		ДекорацияКартинкаКопировать.Вид = ВидДекорацииФормы.Картинка;
		ДекорацияКартинкаКопировать.Картинка = БиблиотекаКартинок.КатегорииКопировать;
		ДекорацияКартинкаКопировать.Гиперссылка = Истина;
		ДекорацияКартинкаКопировать.Подсказка = НСтр("ru = 'Копировать в буфер обмена'");
		ДекорацияКартинкаКопировать.РазмерКартинки = РазмерКартинки.ПоРазмеруШрифта;
		ДекорацияКартинкаКопировать.УстановитьДействие(
			"Нажатие",
			"Подключаемый_КартинкаКопироватьНажатие");
		
	КонецЕсли;
	
	Если  ОписаниеИнформации.УстанавливатьРегистрационныйНомер Тогда
		КешФормы.ИдентификаторыИзменяемыхЭлементов.РегистрационныйНомер = ИдентификаторЭлементов;
	КонецЕсли;
	
КонецПроцедуры

// Выводить единицу информации о программе
// 
// Параметры:
// 
// Родитель - ГруппаФормы - страница, на которую необходимо вывести информацию.
// ОписаниеИнформации - см. НовыйОписаниеТехническойИнформации.
// 
&НаСервере
Процедура ВывестиИнформациюМобильныйКлиент(Родитель, ОписаниеИнформации)
	
	ИдентификаторЭлементов = ПанельПомощьСлужебный.НовыйИдентификаторДляИмени();
	
	НоваяГруппа = Элементы.Добавить(
		"ГруппаИнформация_" + ИдентификаторЭлементов,
		Тип("ГруппаФормы"),
		Родитель);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Авто;
	НоваяГруппа.ОтображатьЗаголовок = Истина;
	НоваяГруппа.РастягиватьПоГоризонтали = Истина;
	НоваяГруппа.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Верх;
	НоваяГруппа.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
	НоваяГруппа.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	НоваяГруппа.РазрешитьИзменениеСостава = Ложь;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НоваяГруппа.ОтображатьКакКарточку = Истина;
	НоваяГруппа.Заголовок = ОписаниеИнформации.Заголовок;
	
	ВыводимыйТекст = СтроковыеФункции.ФорматированнаяСтрока(ОписаниеИнформации.Текст);
	
	СтрокиТекста = Новый Массив;
	СтрокиТекста.Добавить(ВыводимыйТекст);
	
	Если ОписаниеИнформации.ПроверитьНаличиеОбновленийКонфигурации Тогда
		КешФормы.ИдентификаторыИзменяемыхЭлементов.Версия = ИдентификаторЭлементов;
		СтрокиТекста.Добавить("   ");
		СтрокиТекста.Добавить(БиблиотекаКартинок.ДлительнаяОперация16);
	КонецЕсли;
	
	ТекстСообщения = Новый ФорматированнаяСтрока(СтрокиТекста);
	
	ДекорацияТекст = Элементы.Добавить(
		"ДекорацияТекст_" + ИдентификаторЭлементов,
		Тип("ДекорацияФормы"),
		НоваяГруппа);
	ДекорацияТекст.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияТекст.Заголовок = ТекстСообщения;
	ДекорацияТекст.АвтоМаксимальнаяШирина = Ложь;
	ДекорацияТекст.РастягиватьПоГоризонтали = Истина;
	ДекорацияТекст.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Верх;
	ДекорацияТекст.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
	ДекорацияТекст.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
	ДекорацияТекст.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
	ДекорацияТекст.УстановитьДействие(
		"ОбработкаНавигационнойСсылки",
		"Подключаемый_ДекорацияОбработкаНавигационнойСсылки");
	
	Если ОписаниеИнформации.КнопкаКопирования Тогда
		
		КешФормы.ДанныеДляКопированияВБуфер.Вставить(
			ИдентификаторЭлементов,
			Строка(ВыводимыйТекст));
		
		ДекорацияТекст.РастягиватьПоГоризонтали = Ложь;
		
		ДекорацияКартинкаКопировать = Элементы.Добавить(
			"КартинкаКопировать_" + ИдентификаторЭлементов,
			Тип("ДекорацияФормы"),
			НоваяГруппа);
		ДекорацияКартинкаКопировать.Вид = ВидДекорацииФормы.Картинка;
		ДекорацияКартинкаКопировать.Картинка = БиблиотекаКартинок.КатегорииКопировать;
		ДекорацияКартинкаКопировать.Гиперссылка = Истина;
		ДекорацияКартинкаКопировать.Подсказка = НСтр("ru = 'Копировать в буфер обмена'");
		ДекорацияКартинкаКопировать.РазмерКартинки = РазмерКартинки.ПоРазмеруШрифта;
		ДекорацияКартинкаКопировать.УстановитьДействие(
			"Нажатие",
			"Подключаемый_КартинкаКопироватьНажатие");
		
	КонецЕсли;
	
	Если  ОписаниеИнформации.УстанавливатьРегистрационныйНомер Тогда
		КешФормы.ИдентификаторыИзменяемыхЭлементов.РегистрационныйНомер = ИдентификаторЭлементов;
	КонецЕсли;
	
КонецПроцедуры

// Собирает данные для вывода на форму.
// 
// Возвращаемое значение:
//  Структура - данные для вывода:
//   * ОписаниеСистемы - Массив Из см. НовыйОписаниеТехническойИнформации.
// 
&НаСервере
Функция ВыводимаяИнформация()
	
	ОписаниеСистемы = Новый Массив;
	
	Результат = Новый Структура("ОписаниеСистемы", ОписаниеСистемы);
	
	СистИнфо = ПанельПомощьСлужебный.ТехническаяИнформацияСистемнаяИнформация();
	
	ПараметрыДанныхДляТехПоддержки = ПанельПомощьСлужебный.ПараметрыДанныхДляТехПоддержки();
	ПараметрыДанныхДляТехПоддержки.ДанныеСистемнойИнформации = СистИнфо;
	ДанныеДляТехПоддержки = ПанельПомощьСлужебный.ДанныеДляТехПоддержки(
		ПараметрыДанныхДляТехПоддержки);
	Если Не ЗначениеЗаполнено(ДанныеДляТехПоддержки.НастройкиИнтернетПоддержки.РегистрационныйНомер) Тогда
		ДанныеДляТехПоддержки.НастройкиИнтернетПоддержки.РегистрационныйНомер = ПустойРегистрационныйНомер();
	КонецЕсли;
	
	// Наименование и версия конфигурации
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Наименование'"),
			ДанныеДляТехПоддержки.ОписаниеПрограммы.ОписаниеКонфигурацииДляВывода));
	
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Поставщик'"),
			ДанныеДляТехПоддержки.ОписаниеПрограммы.Поставщик));
	
	ВерсияПриложения = НовыйОписаниеТехническойИнформации(
		НСтр("ru = 'Версия'"),
		ДанныеДляТехПоддержки.ОписаниеПрограммы.Версия,
		Истина);
	ВерсияПриложения.ПроверитьНаличиеОбновленийКонфигурации = ДанныеДляТехПоддержки.ОписаниеПрограммы.ПроверитьНаличиеОбновленийКонфигурации;
	ОписаниеСистемы.Добавить(ВерсияПриложения);
	
	// Версия платформы
	ВерсияПлатформы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 %2'"),
		СистИнфо.СистемнаяИнформацияСервера.ВерсияПриложения,
		СистИнфо.СистемнаяИнформацияСервера.ВариантПриложения);
	
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Версия 1С:Предприятие'"),
			СокрЛП(ВерсияПлатформы),
			Истина));
	
	// Тип приложения
	ОписаниеСистемы.Добавить(НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Приложение'"),
			ТипПриложения()));
	
	Если ДанныеДляТехПоддержки.ТекущаяСессия.РежимРаботы = "FILE" Тогда
		ОписаниеСистемы.Добавить(НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Режим'"),
			НСтр("ru = 'Файловый'")));
		ОписаниеСистемы.Добавить(НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Каталог'"),
			НСтр(ДанныеДляТехПоддержки.ТекущаяСессия.СтрокаСоединенияИнформационнойБазы, "File")));
	Иначе
		ОписаниеСистемы.Добавить(НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Режим'"),
			НСтр("ru = 'Серверный'")));
		ОписаниеСистемы.Добавить(НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Имя базы'"),
			НСтр(ДанныеДляТехПоддержки.ТекущаяСессия.СтрокаСоединенияИнформационнойБазы, "Ref")));
	КонецЕсли;

	// Пользователь
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Пользователь'"),
			ДанныеДляТехПоддержки.ТекущаяСессия.ИмяПользователя));
			
	// Интернет-поддержка
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Пользователь интернет поддержки'"),
			ДанныеДляТехПоддержки.НастройкиИнтернетПоддержки.Логин));
	
	Если ДанныеДляТехПоддержки.НастройкиИнтернетПоддержки.УстанавливатьРегистрационныйНомер Тогда
		ОписаниеРегистрационныйНомер = НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Регистрационный номер'"),
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '<a href=""open:regNo"">%1</a>'"),
				ДанныеДляТехПоддержки.НастройкиИнтернетПоддержки.РегистрационныйНомер),
			Истина);
		ОписаниеРегистрационныйНомер.УстанавливатьРегистрационныйНомер = Истина;
		ОписаниеСистемы.Добавить(ОписаниеРегистрационныйНомер);
	КонецЕсли;
		
	// Интерфейс
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Интерфейс'"),
			ВариантИнтерфейса()));
	
	// Режим совместимости
	РежимыСовместимости = РежимыСовместимости(
		ДанныеДляТехПоддержки.ОписаниеПрограммы.РежимСовместимости,
		ДанныеДляТехПоддержки.ОписаниеПрограммы.РежимСовместимостиИнтерфейса);
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Режим совместимости'"),
			РежимыСовместимости.РежимСовместимости));
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Режим совместимости интерфейса'"),
			РежимыСовместимости.РежимСовместимостиИнтерфейса));
	
	// Версия ОС
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Операционная система (Клиент)'"),
			СистИнфо.СистемнаяИнформацияКлиента.ВерсияОС));
	ОписаниеСистемы.Добавить(
		НовыйОписаниеТехническойИнформации(
			НСтр("ru = 'Операционная система (Сервер)'"),
			СистИнфо.СистемнаяИнформацияСервера.ВерсияОС));
	
	// Расширения
	Если ДанныеДляТехПоддержки.ДанныеРасширений.АвтоматическаяУстановкаПатчей = Неопределено Тогда
		ЗаголовокАвтоустановкаПатчей = НСтр("ru = 'Автоматическая установка исправлений (патчей) <b>Недоступна в текущей конфигурации</b>'");
		ТекстПодсказки = НСтр("ru = 'В конфигурации отсутствует функциональность, позволяющая автоматически загружать и устанавливать исправления (патчи).'");
	Иначе
		ЗаголовокАвтоустановкаПатчей = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Автоматическая установка исправлений (патчей) <b>%1</b>'"),
			?(ДанныеДляТехПоддержки.ДанныеРасширений.АвтоматическаяУстановкаПатчей = Истина,
				НСтр("ru = 'Включена'"),
				НСтр("ru = 'Выключена'")));
		Если Пользователи.ЭтоПолноправныйПользователь() Тогда
			ТекстПодсказки = НСтр("ru = 'Для включения автоматической загрузки и установки исправлений (патчей) перейдите в панель настройки Интернет-поддержки пользователей и выполните необходимую настройку в разделе ""Обновление версии программы"".'");
		Иначе
			ТекстПодсказки = НСтр("ru = 'Для включения автоматической загрузки и установки исправлений (патчей) обратитесь к администратору.'");
		КонецЕсли;
	КонецЕсли;

	ДанныеДляТехПоддержки.ДанныеРасширений = ДанныеДляТехПоддержки.ДанныеРасширений.Расширения;
	ДанныеДляТехПоддержки.НастройкиИнтернетПоддержки.Удалить("УстанавливатьРегистрационныйНомер");
	
	Элементы.ДекорацияАвтоматическаяУстановкаПатчей.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
		ЗаголовокАвтоустановкаПатчей);
	Элементы.ДекорацияАвтоматическаяУстановкаПатчей.Подсказка = ТекстПодсказки;
	
	КоличествоПатчей = 0;
	КоличествоАктивных = 0;
	КоличествоАктивныхПатчей = 0;
	Для Каждого Расширение Из ДанныеДляТехПоддержки.ДанныеРасширений Цикл
		НоваяСтрока = Расширения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Расширение);
		НоваяСтрока.ЗащитаОтОпасныхДействий = Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
		Если НоваяСтрока.Активно Тогда
			КоличествоАктивных = КоличествоАктивных + 1;
		КонецЕсли;
		Если НоваяСтрока.ЭтоИсправление Тогда
			КоличествоПатчей = КоличествоПатчей + 1;
			Если НоваяСтрока.Активно Тогда
				КоличествоАктивныхПатчей = КоличествоАктивныхПатчей + 1;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока.СвойстваРасширения = НомерКартинкиСвойствоРасширения(НоваяСтрока);
	КонецЦикла;
	
	Элементы.ДекорацияИтоги.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Всего расширений: %1 (активных: %2). Из них исправлений (патчей): %3 (активных: %4)'"),
		Расширения.Количество(),
		КоличествоАктивных,
		КоличествоПатчей,
		КоличествоАктивныхПатчей);
	
	Расширения.Сортировать("ЭтоИсправление УБЫВ, Синоним");
	
	ДанныеДляТехПоддержки.ОписаниеПрограммы.Удалить("ПроверитьНаличиеОбновленийКонфигурации");
	ДанныеДляТехПоддержки.ОписаниеПрограммы.Удалить("ОписаниеКонфигурацииДляВывода");
	
	ВывестиСводДанныеДляТехПоддержки(ДанныеДляТехПоддержки);
	СводнаяДляТехПоддержкиJSON = ОбщегоНазначения.ЗначениеВJSON(ДанныеДляТехПоддержки);
	
	Возврат Результат;
	
КонецФункции

// Формирует описание единицы технической информации, выводимой на форму.
// 
// Параметры:
//  ЗаголовокИнформации - Строка - заголовок элемента.
//  ТекстИнформации - Строка - текст элемента. При выводе преобразовывается в форматированную строку.
//    Может содержать теги оформления, указанные в описании метода СтроковыеФункции.ФорматированнаяСтрока.
//  КнопкаКопирования - Булево - выводить кнопку копирования в буфер после текста.
//  
// Возвращаемое значение:
//  Структура - описание единицы технической информации:
//    * Заголовок - Строка - заголовок элемента.
//    * Текст - Строка - текст элемента.
//    * ПроверитьНаличиеОбновленийКонфигурации - Булево - элемент используется для вывода версии программы.
//        Необходимо для получения информации об обновлении программы.
//    * УстанавливатьРегистрационныйНомер - Булево - элемент используется для вывода регистрационного
//        номера. Необходимо для изменения номера пользователем.
//    * КнопкаКопирования - Булево - выводить кнопку копирования в буфер после текста.
// 
&НаСервере
Функция НовыйОписаниеТехническойИнформации(ЗаголовокИнформации, ТекстИнформации, КнопкаКопирования = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("Заголовок", ЗаголовокИнформации);
	Результат.Вставить("Текст", ТекстИнформации);
	Результат.Вставить("ПроверитьНаличиеОбновленийКонфигурации", Ложь);
	Результат.Вставить("УстанавливатьРегистрационныйНомер", Ложь);
	Результат.Вставить("КнопкаКопирования", КнопкаКопирования);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НомерКартинкиСвойствоРасширения(СтрокаТаблицы)
	
	Если СтрокаТаблицы.ЭтоИсправление И Не СтрокаТаблицы.БезопасныйРежим И Не СтрокаТаблицы.ЗащитаОтОпасныхДействий Тогда
		Возврат 1;
	ИначеЕсли Не СтрокаТаблицы.ЭтоИсправление И СтрокаТаблицы.БезопасныйРежим И Не СтрокаТаблицы.ЗащитаОтОпасныхДействий Тогда
		Возврат 2;
	ИначеЕсли Не СтрокаТаблицы.ЭтоИсправление И Не СтрокаТаблицы.БезопасныйРежим И СтрокаТаблицы.ЗащитаОтОпасныхДействий Тогда
		Возврат 3;
	ИначеЕсли СтрокаТаблицы.ЭтоИсправление И СтрокаТаблицы.БезопасныйРежим И Не СтрокаТаблицы.ЗащитаОтОпасныхДействий Тогда
		Возврат 4;
	ИначеЕсли СтрокаТаблицы.ЭтоИсправление И Не СтрокаТаблицы.БезопасныйРежим И СтрокаТаблицы.ЗащитаОтОпасныхДействий Тогда
		Возврат 5;
	ИначеЕсли Не СтрокаТаблицы.ЭтоИсправление И СтрокаТаблицы.БезопасныйРежим И СтрокаТаблицы.ЗащитаОтОпасныхДействий Тогда
		Возврат 6;
	ИначеЕсли СтрокаТаблицы.ЭтоИсправление И СтрокаТаблицы.БезопасныйРежим И СтрокаТаблицы.ЗащитаОтОпасныхДействий Тогда
		Возврат 7;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура УстановитьНастройкиФормы()
	
	Если ЭтоМобильныйКлиент Тогда
		Элементы.ВсеРасширенияГруппаСвойства.Видимость = Ложь;
		Элементы.ВсеРасширенияАктивно.Видимость = Ложь;
		Элементы.СохранитьВФайл.Видимость = Ложь;
		Если ИнтернетПоддержкаПользователейКлиентСервер.ЭтоИнтерфейс85() Тогда
			Элементы.Переместить(
				Элементы.ГруппаПодвал,
				Элементы.Расширения,
				Элементы.ВсеРасширения);
		КонецЕсли;
	Иначе
		Элементы.ВсеРасширенияСвойстваРасширения.Видимость = Ложь;
		Если ИнтернетПоддержкаПользователейКлиентСервер.ЭтоИнтерфейс85() Тогда
			Элементы.ВсеРасширенияАктивно.Видимость = Ложь;
		Иначе
			Элементы.ГруппаЛегенда6.Видимость = Истина;
			Элементы.ГруппаЛегенда1.Видимость = Ложь;
			Элементы.ГруппаЛегенда2.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ВсеРасширенияСиноним");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Расширения.Активно");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра(
		"ЦветОтметки",
		ЦветаПалитры.Зеленый);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ВсеРасширенияСиноним");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Расширения.Активно");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра(
		"ЦветОтметки",
		ЦветаПалитры.Серый);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиКарточкиРасширений();
	
	Элементы.ВсеРасширения.Видимость = Ложь;
	
	ГруппаРасширения = Элементы.Добавить(
		"ГруппаРасширений_" + ПанельПомощьСлужебный.НовыйИдентификаторДляИмени(),
		Тип("ГруппаФормы"),
		Элементы.Расширения);
	ГруппаРасширения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаРасширения.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаРасширения.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаРасширения.ОтображатьЗаголовок = Ложь;
	ГруппаРасширения.Поведение = ПоведениеОбычнойГруппы.Обычное;
	ГруппаРасширения.РастягиватьПоГоризонтали = Истина;
	ГруппаРасширения.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Двойной;
	ГруппаРасширения.РазрешитьИзменениеСостава = Ложь;
	
	Для Каждого Расширение Из Расширения Цикл

		ИдентификаторЭлементов = ПанельПомощьСлужебный.НовыйИдентификаторДляИмени();
			
