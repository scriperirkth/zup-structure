
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Правило = Параметры.Правило;
	Организация = Параметры.Организация;
	Срок = Параметры.Срок;
	
	ЗаполнитьФорму();
	ЗаполнитьСтатусКомментарий();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьКнопокИзмененияСтатуса();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияНаименованиеЗадачиНажатие(Элемент)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = ЗадачиБухгалтераКлиентСервер.НовыйПараметрыОткрытияФормыРучнойЗадачи();
	ЗаполнитьЗначенияСвойств(ПараметрыОткрытия, ЭтотОбъект);
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияРучнаяЗадача", ЭтотОбъект);
	ОткрытьФорму(
		"ОбщаяФорма.РучнаяЗадачаБухгалтера",
		ПараметрыОткрытия, , , , ,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеКомментарийПриИзменении(Элемент)
	
	ЗаписатьКомментарийЗадачи();
	Оповестить(КалендарьОтчетностиКлиентСервер.ИмяСобытияОповещенияКалендаряОтчетности());
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьВыполнено(Команда)
	
	УстановитьВидимостьКнопокИзмененияСтатуса();
	СтатусУстановленВручную = Истина;
	СтатусыОтчета = КалендарьОтчетностиКлиентСервер.СтатусыОтчета();
	Статус = СтатусыОтчета.Выполнено;
	ЗаписатьРучнойСтатусЗадачи();
	ПриИзмененииСтатусаЗадачи();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьНеТребуется(Команда)
	
	УстановитьВидимостьКнопокИзмененияСтатуса();
	СтатусУстановленВручную = Истина;
	СтатусыОтчета = КалендарьОтчетностиКлиентСервер.СтатусыОтчета();
	Статус = СтатусыОтчета.НеТребуется;
	ЗаписатьРучнойСтатусЗадачи();
	ПриИзмененииСтатусаЗадачи();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСтатусВручную(Команда)
	
	УстановитьВидимостьКнопокИзмененияСтатуса();
	СтатусУстановленВручную = Ложь;
	Статус = "";
	ВернутьАвтоматическийСтатусЗадачи();
	ПриИзмененииСтатусаЗадачи();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриИзмененииСтатусаЗадачи()
	
	ВывестиСтатус();
	УстановитьВидимостьКнопокИзмененияСтатуса();
	Оповестить(КалендарьОтчетностиКлиентСервер.ИмяСобытияОповещенияКалендаряОтчетности());
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРучнойСтатусЗадачи()
	
	ВыполнениеЗадачБухгалтера.ЗаписатьРучнойСтатусЗадачи(ПараметрыЗадачи(), Статус);
	
КонецПроцедуры

&НаСервере
Процедура ВернутьАвтоматическийСтатусЗадачи()
	
	ВыполнениеЗадачБухгалтера.ВернутьАвтоматическийСтатусЗадачи(ПараметрыЗадачи());
	
КонецПроцедуры

&НаСервере
Функция ПараметрыЗадачи()
	
	ПараметрыЗадачи = РегистрыСведений.ЗадачиБухгалтера.КлючиЗадачСтруктурой();
	ПараметрыЗадачи.Вставить("ИдентификаторЗадачи", "");
	
	ПараметрыЗадачи.Организация = Организация;
	ПараметрыЗадачи.Правило = Правило;
	ПараметрыЗадачи.ПериодСобытия = Срок;
	ПараметрыЗадачи.РегистрацияВНалоговомОргане = Справочники.РегистрацииВНалоговомОргане.ПустаяСсылка();
	ПараметрыЗадачи.Действие = Перечисления.ВидыДействийКалендаряБухгалтера.РучнаяЗадача;
	ПараметрыЗадачи.ИдентификаторЗадачи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Задача, "Код");
	
	Возврат ПараметрыЗадачи;
КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеЗакрытияРучнаяЗадача(РезультатЗакрытия, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатЗакрытия) <> Тип("Структура") Или РезультатЗакрытия.Задачи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗадачи = РезультатЗакрытия.Задачи[0];
	
	Правило = ДанныеЗадачи.Правило;
	Организация = ДанныеЗадачи.Организация;
	Срок = ДанныеЗадачи.Срок;
	
	ЗаполнитьФорму();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФорму()
	
	Задача = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Правило, "Владелец");
	
	ПараметрыПравила = Справочники.ПравилаРучныхЗадачБухгалтера.ПрочитатьПоСсылке(Правило);
	
	Заголовок = ПараметрыПравила.НаименованиеЗадачи;
	Элементы.ДекорацияНаименованиеЗадачи.Заголовок = ПараметрыПравила.НаименованиеЗадачи;
	СрокСдачи = Формат(Срок, "ДФ='dd MMMM'");
	Элементы.ДекорацияСрокВыполнения.Заголовок = СтрШаблон(НСтр("ru='Срок выполнения до %1'"), СрокСдачи);
	Элементы.ДекорацияОрганизация.Заголовок = ПараметрыПравила.НаименованиеОрганизации;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатусКомментарий()
	
	МенеджерЗаписи = РегистрыСведений.ЗадачиБухгалтера.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.Действие = Перечисления.ВидыДействийКалендаряБухгалтера.РучнаяЗадача;
	МенеджерЗаписи.РегистрацияВНалоговомОргане = Справочники.РегистрацииВНалоговомОргане.ПустаяСсылка();
	МенеджерЗаписи.Правило = Правило;
	МенеджерЗаписи.ПериодСобытия = Срок;
	
	МенеджерЗаписи.Прочитать();
	
	СтатусыОтчета = КалендарьОтчетностиКлиентСервер.СтатусыОтчета();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Элементы.ДекорацияТекущийСтатус.Заголовок = СтатусыОтчета.НеВыполнено;
		Возврат;
	КонецЕсли;
	
	СтатусУстановленВручную = МенеджерЗаписи.СтатусУстановленВручную;
	Статус = МенеджерЗаписи.Статус;
	Комментарий = МенеджерЗаписи.Комментарий;
	
	ВывестиСтатус();
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСтатус()
	
	СтатусыОтчета = КалендарьОтчетностиКлиентСервер.СтатусыОтчета();
	Если СтатусУстановленВручную Или Статус = СтатусыОтчета.НеТребуется Тогда
		Элементы.КартинкаТекущийСтатус.Картинка = БиблиотекаКартинок.РедактироватьАдресСайта;
		Элементы.ДекорацияТекущийСтатус.Заголовок = Статус;
	ИначеЕсли СтатусУстановленВручную Или Статус = СтатусыОтчета.Выполнено Тогда
		Элементы.КартинкаТекущийСтатус.Картинка = БиблиотекаКартинок.ЗеленыйШар;
		Элементы.ДекорацияТекущийСтатус.Заголовок = Статус;
	ИначеЕсли Не ЗначениеЗаполнено(Статус) И Срок < НачалоДня(ТекущаяДатаСеанса()) Тогда
		Элементы.КартинкаТекущийСтатус.Картинка = БиблиотекаКартинок.КрасныйШар;
		Элементы.ДекорацияТекущийСтатус.Заголовок = СтатусыОтчета.Просрочено;
	Иначе
		Элементы.КартинкаТекущийСтатус.Картинка = БиблиотекаКартинок.СерыйШар;
		Элементы.ДекорацияТекущийСтатус.Заголовок = СтатусыОтчета.НеВыполнено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКнопокИзмененияСтатуса()
	
	Элементы.ГруппаРучнойСтатус.Видимость = Не СтатусУстановленВручную;
	Элементы.КнопкаОтменитьСтатусВручную.Видимость = СтатусУстановленВручную;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКомментарийЗадачи()
	
	ВыполнениеЗадачБухгалтера.ЗаписатьКомментарийЗадачи(ПараметрыЗадачи(), Комментарий);
	
КонецПроцедуры

#КонецОбласти