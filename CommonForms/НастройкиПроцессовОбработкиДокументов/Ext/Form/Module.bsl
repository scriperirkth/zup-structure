	Если НЕ НаборКонстант.ПодписьФайловНастраиваетсяВШаблоне Тогда
		Возврат;
	КонецЕсли;
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(Истина, "Установить");
	Кнопки.Добавить(Ложь, "Сбросить");
	Кнопки.Добавить("", "Не изменять");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеОтветаНаВопросОбИзмененииПризнакаПодписиФайловВШаблонах",
		ЭтотОбъект);
	
	ТекстВопроса = НСтр("ru = 'Как следует заполнить признак ""Подписывать файлы"" во всех текущих шаблонах?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , "");
	
