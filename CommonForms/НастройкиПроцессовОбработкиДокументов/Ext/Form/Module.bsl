	ОбщегоНазначенияКлиент.ОбновитьИнтерфейсПрограммы();
	
КонецПроцедуры

&НаСервере
Функция ПриИзмененииРеквизитаСервер(ИмяЭлемента)
	
	РеквизитПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
	
	КонстантаИмя = СохранитьЗначениеРеквизита(РеквизитПутьКДанным);
	
	УстановитьДоступность(РеквизитПутьКДанным);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаСервере
Функция СохранитьЗначениеРеквизита(РеквизитПутьКДанным)
	
	Если РеквизитПутьКДанным = "" Тогда
		Возврат "";
	КонецЕсли;
	
	// Определение имени константы.
	КонстантаИмя = "";
	Если НРег(Лев(РеквизитПутьКДанным, 14)) = НРег("НаборКонстант.") Тогда
		// Если путь к данным реквизита указан через "НаборКонстант".
		КонстантаИмя = Сред(РеквизитПутьКДанным, 15);
	ИначеЕсли РеквизитПутьКДанным = "СрокНапоминанияСтрокой" Тогда
		КонстантаИмя = "СрокНапоминанияМинуты";
	Иначе
		// Определение имени и запись значения реквизита в соответствующей константе из "НаборКонстант".
		// Используется для тех реквизитов формы, которые связаны с константами напрямую (в отношении один-к-одному).
	КонецЕсли;
	
	// Сохранения значения константы.
	Если КонстантаИмя <> "" Тогда
		КонстантаМенеджер = Константы[КонстантаИмя];
		КонстантаЗначение = НаборКонстант[КонстантаИмя];
		
		Если КонстантаМенеджер.Получить() <> КонстантаЗначение Тогда
			КонстантаМенеджер.Установить(КонстантаЗначение);
		КонецЕсли;
		
		Если (КонстантаИмя = "ИспользоватьЭППриВыполненииЭтапов"
				ИЛИ КонстантаИмя = "ИспользоватьПростыеЭППриВыполненииЭтапов")
				И КонстантаЗначение = Ложь Тогда
			ЭтотОбъект.Прочитать();
		КонецЕсли;
	КонецЕсли;
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаСервере
Процедура УстановитьДоступность(РеквизитПутьКДанным = "")
	
	ТекущийПользовательПолноправный = Пользователи.ЭтоПолноправныйПользователь();
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьЭППриВыполненииЭтапов"
		ИЛИ РеквизитПутьКДанным = "НаборКонстант.ИспользоватьПростыеЭППриВыполненииЭтапов"
		ИЛИ РеквизитПутьКДанным = "" Тогда
		
		ДоступностьНастроекУсиленнаяЭП = НаборКонстант.ИспользоватьЭлектронныеПодписи И НаборКонстант.ИспользоватьЭППриВыполненииЭтапов;
		ДоступностьНастроекПростаяЭП = НаборКонстант.ИспользоватьПростыеЭППриВыполненииЭтапов;
		
		ДоступностьНастроекВсехЭП = ДоступностьНастроекУсиленнаяЭП ИЛИ ДоступностьНастроекПростаяЭП;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ИспользоватьЭППриВыполненииЭтапов", "Доступность", НаборКонстант.ИспользоватьЭлектронныеПодписи);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НастройкаПодписиСсылочныхДанных", "Доступность", ДоступностьНастроекВсехЭП);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ПодписыватьПрисоединенныеФайлы", "Доступность", ДоступностьНастроекУсиленнаяЭП);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ПодписьФайловНастраиваетсяВШаблоне", "Доступность",
			НаборКонстант.ПодписыватьПрисоединенныеФайлы И Элементы.ПодписыватьПрисоединенныеФайлы.Доступность);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ЭлектроннаяПодписьЗаголовокПроверки", "Доступность", ДоступностьНастроекВсехЭП);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ПроверятьИмеющиесяЭППриОчередномПодписании", "Доступность", ДоступностьНастроекУсиленнаяЭП);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ПроверятьПодписанныеДанныеПриОчередномПодписании", "Доступность", ДоступностьНастроекВсехЭП);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "РеестрКлючейПЭП", "Доступность", ДоступностьНастроекПростаяЭП);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ПроверятьНаличиеКлючаПЭПВРеестре", "Доступность", ДоступностьНастроекПростаяЭП);
		
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ПодписыватьПрисоединенныеФайлы" ИЛИ РеквизитПутьКДанным = "" Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ПодписьФайловНастраиваетсяВШаблоне", "Доступность",
			НаборКонстант.ПодписыватьПрисоединенныеФайлы И Элементы.ПодписыватьПрисоединенныеФайлы.Доступность);
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьНесколькоШаблоновДляОдногоТипаДокумента" ИЛИ РеквизитПутьКДанным = "" Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "РазрешитьЗаписьДокументаБезШаблона", "Доступность",
			НаборКонстант.ИспользоватьНесколькоШаблоновДляОдногоТипаДокумента);
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.НапоминатьОПриближенииСрокаВыполненияЗадач" ИЛИ РеквизитПутьКДанным = "" Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "СрокНапоминанияСтрокой", "Доступность",
			НаборКонстант.НапоминатьОПриближенииСрокаВыполненияЗадач И ТекущийПользовательПолноправный);
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьГрафикиРаботы" ИЛИ РеквизитПутьКДанным = "" Тогда
		
		ЕстьПодсистемаГрафикиРаботы = ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ГрафикиРаботы"); 
		Если Не ЕстьПодсистемаГрафикиРаботы Тогда
			 ГрафикРаботы = Неопределено;
			 ПроцессыОбработкиДокументовПереопределяемый.ПриОпределенииГрафикаРаботыИсполнителя(Неопределено, ГрафикРаботы, Ложь);
			 
			 Если ГрафикРаботы <> Неопределено Тогда
				Текст = НСтр("ru='В переопределяемых методах описан график работы ""%1"" как основной график'"); 
				ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
										ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГрафикРаботы, "Наименование"));
										
				РасписаниеРаботы = Новый ТаблицаЗначений;						
				ПроцессыОбработкиДокументовПереопределяемый.ПриПолученииРасписанияРаботы(РасписаниеРаботы);						
				Если РасписаниеРаботы.Количество() > 0 Тогда
					
					НайденныеСтроки = РасписаниеРаботы.НайтиСтроки(Новый Структура("НомерДня",1));
					Если НайденныеСтроки <> Неопределено Тогда  
						ТекстЗаголовка = ТекстЗаголовка + Символы.ПС + "Расписание:"+ Символы.ПС;
						Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
							
							ТекстЗаголовка = ТекстЗаголовка + "С "+ Формат(НайденнаяСтрока.ВремяНачала, "ДЛФ=T")
												+ " по " + Формат(НайденнаяСтрока.ВремяОкончания, "ДЛФ=T")
												+ Символы.ПС;
							
						КонецЦикла;	
						
					КонецЕсли;	
					
				КонецЕсли;						
				Элементы.ИнформацияОбОтсутствииПодсистемыГрафики.Заголовок = ТекстЗаголовка;						
			КонецЕсли;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ОтсутствиеПодсистемыГрафики", "Видимость", НЕ ЕстьПодсистемаГрафикиРаботы);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ОсновнойГрафикРаботы", "Видимость", ЕстьПодсистемаГрафикиРаботы И НаборКонстант.ИспользоватьГрафикиРаботы);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ОсновнойГрафикРаботы", "Доступность", НаборКонстант.ИспользоватьГрафикиРаботы);
		
	КонецЕсли;
	
	Если Элементы.УведомлениеИсполнителей.Видимость
		И (РеквизитПутьКДанным = "УведомлениеИсполнителейОНовыхЗадачахРасписание" Или РеквизитПутьКДанным = "") Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "УведомлениеИсполнителейОНовыхЗадачахИспользование", "Доступность",
			ТекущийПользовательПолноправный);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ГруппаИсключенияУведомлений", "Видимость",
			УведомлениеИсполнителейОНовыхЗадачахИспользование);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "УведомлениеИсполнителейОНовыхЗадачахРасписание", "Доступность",
			УведомлениеИсполнителейОНовыхЗадачахИспользование И НЕ ОбщегоНазначения.РазделениеВключено() И ТекущийПользовательПолноправный);
			
	КонецЕсли;
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы
		(Элементы, "ПереносПодписанныхДанныхВПрисоединенныеФайлы", "Доступность", ТекущийПользовательПолноправный);

	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьДанныеИУстановитьДоступность()
	ЭтотОбъект.Прочитать();
	УстановитьДоступность();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьТипыДокументовСНесколькимиШаблонами()
	
	Возврат ПроцессыОбработкиДокументов.ЕстьТипыДокументовСНесколькимиШаблонами();
	
КонецФункции

&НаКлиенте
Процедура РегламентноеЗаданиеПредставлениеНажатиеЗавершение(Расписание, ДополнительныеПараметры) Экспорт
	
	Если Расписание = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	УведомлениеИсполнителейОНовыхЗадачахРасписание = Расписание;
	УведомлениеИсполнителейОНовыхЗадачахИспользование = Истина;
	
	ЗаписатьРегламентноеЗаданиеУведомлениеОНовыхЗадачах(
		УведомлениеИсполнителейОНовыхЗадачахИспользование, УведомлениеИсполнителейОНовыхЗадачахРасписание);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРегламентноеЗаданиеУведомлениеОНовыхЗадачах(Использование, Расписание)
	
	ПроцессыОбработкиДокументов.ЗаписатьРегламентноеЗадание(
		"УведомлениеОНовыхЗадачахПоОбработкеДокументов", Использование, Расписание);
	
	УстановитьДоступность("УведомлениеИсполнителейОНовыхЗадачахРасписание");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОбИзмененииПризнакаПодписиФайловВШаблонах(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Истина И Результат <> Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРеквизитПодписыватьФайлыЭПВШаблонах(Результат);
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Обработка шаблонов завершена'"));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитПодписыватьФайлыЭПВШаблонах(Значение)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|ГДЕ
	|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяЭП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ШаблоныПроцессовЭтапы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|		ПО ШаблоныПроцессовЭтапы.Этап = ЭтапыПроцессовРезультатыВыполнения.Ссылка
	|ГДЕ
	|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяЭП
	|	И ШаблоныПроцессовЭтапы.ПодписыватьФайлыЭП <> &ПодписыватьФайлыЭП";
	
	Запрос.УстановитьПараметр("ПодписыватьФайлыЭП", Значение);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ЭтапыСЭП = Новый Соответствие;
	Выборка = Результат[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭтапыСЭП.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	
	Выборка = Результат[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.ШаблоныПроцессов");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Блокировка.Заблокировать();
			
			ШаблонОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
				Если ЭтапыСЭП.Получить(Этап.Этап) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Этап.ПодписыватьФайлыЭП = Значение;
			КонецЦикла;
			
			Если ШаблонОбъект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ШаблонОбъект);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти
