#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыРасшифровки = Параметры.ПараметрыРасшифровки;
	
	Заголовок = ПараметрыРасшифровки.Заголовок;
	НаименованиеЭтапа = ПараметрыРасшифровки.НаименованиеЭтапа;
	КартинкаЭтапа = ПараметрыРасшифровки.КартинкаЭтапа;
	КомментарийЭтапа = ПараметрыРасшифровки.КомментарийЭтапа;
	КартинкаКомментария = ПараметрыРасшифровки.КартинкаКомментария;
	
	Если ЗначениеЗаполнено(КартинкаЭтапа) Тогда
		Элементы.КартинкаЭтапа.Картинка = КартинкаЭтапа;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеЭтапа) Тогда
		Элементы.НаименованиеЭтапа.Заголовок = НаименованиеЭтапа;
	Иначе	
		Элементы.ГруппаСтатус.Видимость = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КартинкаКомментария) Тогда
		Элементы.КартинкаКомментария.Картинка = КартинкаКомментария;
		Элементы.КартинкаКомментария.Видимость = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КомментарийЭтапа) Тогда
		Элементы.КомментарийЭтапа.Заголовок = КомментарийЭтапа;
	Иначе	
		Элементы.ГруппаКомментарий.Видимость = Ложь;
	КонецЕсли;
	
	КомандыРасшифровки = ПараметрыРасшифровки.КомандыРасшифровки;
	
	Для каждого Команда Из КомандыРасшифровки Цикл
		ДобавитьКомандуНаФорму(Команда.ИмяКоманды, Команда.ЗаголовокКнопки, Команда.КартинкаКнопки);
	КонецЦикла;
	
	ЭтаФорма.ТекущийЭлемент = Неопределено;
	
КонецПроцедуры   

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыполнитьДействие(Команда)
	
	Закрыть(Команда.Имя); 
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийЭтапаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Закрыть(НавигационнаяСсылкаФорматированнойСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьКомандуНаФорму(ИмяКоманды, ЗаголовокКнопки, КартинкаКнопки)
	
	ТекущийЭлемент = Элементы.Найти(ИмяКоманды);
	Если ТекущийЭлемент <> Неопределено Тогда
		ТекущийЭлемент.Заголовок = ЗаголовокКнопки;
		ТекущийЭлемент.Видимость = Истина;
		Возврат;	
	КонецЕсли; 
	
	Команда = Команды.Добавить(ИмяКоманды);
	Команда.Заголовок = ЗаголовокКнопки;
	Команда.Действие = "КомандаВыполнитьДействие";
	
	КнопкаФормы = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭтаФорма); 
	КнопкаФормы.ИмяКоманды = ИмяКоманды; 
	КнопкаФормы.Вид = ВидКнопкиФормы.Гиперссылка; 
	
	Если КартинкаКнопки <> Неопределено Тогда
		КнопкаФормы.Картинка = КартинкаКнопки; 	
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти