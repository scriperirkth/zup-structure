&НаКлиенте
Процедура СохранитьПодписьПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Электронная подпись сохранена в файл:'"), , ПолученныеФайлы[0].Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Данные сохранены в файл:'"), , ПолученныеФайлы[0].Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеПослеПодключенияРасширенияРаботыСФайлами(Подключено, Контекст) Экспорт
	
	Если Не Подключено Тогда
		
		Для Каждого ПолучаемыйФайл Из Контекст Цикл
			ПолучитьФайл(ПолучаемыйФайл.Хранение, ПолучаемыйФайл.Имя);
		КонецЦикла;
		
	Иначе
		
		ФайловаяСистемаКлиент.ВыбратьКаталог(Новый ОписаниеОповещения(
			"СохранитьДанныеВместеСПодписьюПослеВыбораКаталога", ЭтотОбъект, Контекст));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеВместеСПодписьюПослеВыбораКаталога(ПутьККаталогу, Контекст) Экспорт
	
	Если ПустаяСтрока(ПутьККаталогу) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ПередаваемыйФайл Из Контекст Цикл
		ПередаваемыйФайл.Имя = ПутьККаталогу + "\" + ПередаваемыйФайл.Имя;
	КонецЦикла;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ПередаваемыеФайлы", Контекст);
	ПараметрыОповещения.Вставить("ПроверяемыйИндекс", 0);
	
	Оповещение = Новый ОписаниеОповещения("ПослеПроверкиСуществованияФайла", ЭтотОбъект, ПараметрыОповещения);
	
	Файл = Новый Файл(Контекст[ПараметрыОповещения.ПроверяемыйИндекс].Имя);
	Файл.НачатьПроверкуСуществования(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиСуществованияФайла(Существует, ДополнительныеПараметры) Экспорт
	
	ПередаваемыеФайлы = ДополнительныеПараметры.ПередаваемыеФайлы;
	ПроверяемыйИндекс = ДополнительныеПараметры.ПроверяемыйИндекс;
	
	Если Существует Тогда
		// Если такой файл уже существует, то надо добавить к его имени "(n + 1)"
		РазложенноеИмяФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПередаваемыеФайлы[ПроверяемыйИндекс].Имя);
		ИмяБезРасширения = РазложенноеИмяФайла.ИмяБезРасширения;
		
		ПорядковыйНомерНовогоФайла = 1;
		
		Если Прав(ИмяБезРасширения, 1) = ")" Тогда
			ПозицияОткрывающейСкобки = СтрНайти(ИмяБезРасширения, "(", НаправлениеПоиска.СКонца);
			Если ПозицияОткрывающейСкобки <> 0 Тогда
				ТекущийПорядковыйНомер = Сред(ИмяБезРасширения, ПозицияОткрывающейСкобки + 1,
					СтрДлина(ИмяБезРасширения) - ПозицияОткрывающейСкобки - 1);
				Попытка
					ПорядковыйНомерНовогоФайла = Число(ТекущийПорядковыйНомер) + 1;
				Исключение
					// Исключение не обрабатывается
				КонецПопытки
			КонецЕсли;
		КонецЕсли;
		
		Если ПорядковыйНомерНовогоФайла = 1 Тогда
			ПередаваемыеФайлы[ПроверяемыйИндекс].Имя = РазложенноеИмяФайла.Путь
				+ РазложенноеИмяФайла.ИмяБезРасширения
				+ " (" + ПорядковыйНомерНовогоФайла + ")"
				+ РазложенноеИмяФайла.Расширение;
		Иначе
			ПередаваемыеФайлы[ПроверяемыйИндекс].Имя = РазложенноеИмяФайла.Путь
				+ Сред(РазложенноеИмяФайла.ИмяБезРасширения, 1, ПозицияОткрывающейСкобки)
				+ ПорядковыйНомерНовогоФайла + ")"
				+ РазложенноеИмяФайла.Расширение;
		КонецЕсли;
	Иначе
		ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
	КонецЕсли;
	
	Если ПроверяемыйИндекс <= ПередаваемыеФайлы.ВГраница() Тогда
		// проверка очередного файла
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("ПередаваемыеФайлы", ПередаваемыеФайлы);
		ПараметрыОповещения.Вставить("ПроверяемыйИндекс", ПроверяемыйИндекс);
		
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиСуществованияФайла", ЭтотОбъект, ПараметрыОповещения);
		
		Файл = Новый Файл(ПередаваемыеФайлы[ПроверяемыйИндекс].Имя);
		Файл.НачатьПроверкуСуществования(Оповещение);
		
	Иначе
		// все файлы проверены, сохраняем неинтерактивно
		ПараметрыСохраненияФайлов = ФайловаяСистемаКлиент.ПараметрыСохраненияФайлов();
		ПараметрыСохраненияФайлов.Интерактивно = Ложь;
		ФайловаяСистемаКлиент.СохранитьФайлы(Новый ОписаниеОповещения(
			"СохранитьДанныеВместеСПодписьюПослеПолученияФайлов", ЭтотОбъект, Неопределено),
			ПередаваемыеФайлы, ПараметрыСохраненияФайлов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеВместеСПодписьюПослеПолученияФайлов(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КаталогСФайлами = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолученныеФайлы[0].ПолноеИмя).Путь;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Файлы сохранены в каталог:'"),
		Новый ОписаниеОповещения("ОткрытьКаталогСФайлами", ЭтотОбъект, КаталогСФайлами),
		КаталогСФайлами);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПервичныеДокументыПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КаталогСФайлами = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолученныеФайлы[0].ПолноеИмя).Путь;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Файлы сохранены в каталог:'"),
		Новый ОписаниеОповещения("ОткрытьКаталогСФайлами", ЭтотОбъект, КаталогСФайлами),
		КаталогСФайлами);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКаталогСФайлами(КаталогСФайлами) Экспорт
	
	ФайловаяСистемаКлиент.ОткрытьПроводник(КаталогСФайлами);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбеспечитьУникальностьИменФайлов(ОписаниеФайлов)
	
	УникальныеИменаФайлов = Новый Соответствие;
	
	Для Каждого ОписаниеФайла Из ОписаниеФайлов Цикл
		
		НомерФайла = УникальныеИменаФайлов[ОписаниеФайла.Имя];
		
		Если НомерФайла = Неопределено Тогда
			УникальныеИменаФайлов.Вставить(ОписаниеФайла.Имя, 0);
			Продолжить;
		КонецЕсли;
		
		ПорядковыйНомерНовогоФайла = НомерФайла + 1;
		
		УникальныеИменаФайлов.Вставить(ОписаниеФайла.Имя, ПорядковыйНомерНовогоФайла);
		
		РазложенноеИмяФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ОписаниеФайла.Имя);
		ИмяБезРасширения = РазложенноеИмяФайла.ИмяБезРасширения;
		
		ОписаниеФайла.Имя = РазложенноеИмяФайла.Путь
			+ РазложенноеИмяФайла.ИмяБезРасширения
			+ " ("+ Строка(ПорядковыйНомерНовогоФайла) + ")"
			+ РазложенноеИмяФайла.Расширение;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция АдресXMLПодписанныхДанных(АдресДанных, УИД)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресДанных);
	
	Буфер = Новый БуферДвоичныхДанных(4);
	Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения().Прочитать(Буфер, 0, 4);
	// документ FastInfoset должен начинаться с шестнадцатеричной последовательности октетов E0 00 00 01,
	// в случае, если необязательная декларация XML отсутствует.
	Если Буфер.ПрочитатьЦелое32(0, ПорядокБайтов.BigEndian) = 3758096385 Тогда
		ЧтениеFastInfoSet = Новый ЧтениеFastInfoSet;
		ЧтениеFastInfoSet.УстановитьДвоичныеДанные(ДвоичныеДанные);
		Возврат ПоместитьВоВременноеХранилище(ПрочитатьXML(ЧтениеFastInfoSet), УИД);
	Иначе
		Возврат ПоместитьВоВременноеХранилище(ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные), УИД);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьПодписи(УсиленныеПодписи, ПростыеПодписи)
	
	Если УсиленныеПодписи.Количество() > 0 Тогда
		
		Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
			Возврат;
		КонецЕсли;
		
		ЗапущенаПроверкаСоответствияПодписанныхИТекущихДанных = Ложь;
		
		// Объединим простые и усиленные подписи так, чтобы простые подписи располагались в начале массива
		// проверка криптопровайдером начнется с первой усиленной подписи
		ПроверяемыйИндекс = ПростыеПодписи.ВГраница() + 1;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПростыеПодписи, УсиленныеПодписи);
		
		ПараметрыОповещения = Новый Структура("ПодписиДляПроверки, ПроверяемыйИндекс", ПростыеПодписи, ПроверяемыйИндекс);
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиОчереднойПодписи", ЭтотОбъект, ПараметрыОповещения);
		
		ПроцессыОбработкиДокументовКлиент.ПроверитьПодпись(Оповещение,
			ПростыеПодписи[ПроверяемыйИндекс].АдресДанных, ПростыеПодписи[ПроверяемыйИндекс].АдресПодписи);
		
	Иначе
		
		ПроверитьСоответствиеПодписанныхИТекущихДанных(ПростыеПодписи);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиОчереднойПодписи(Результат, ДопПараметры) Экспорт
	
	ПодписиДляПроверки = ДопПараметры.ПодписиДляПроверки;
	ПроверяемыйИндекс = ДопПараметры.ПроверяемыйИндекс;
	
	ПодписиДляПроверки[ПроверяемыйИндекс].ДатаПроверкиПодписи = ОбщегоНазначенияКлиент.ДатаСеанса();
	
	Если ТипЗнч(Результат) = Тип("Булево") Тогда
		ПодписиДляПроверки[ПроверяемыйИндекс].ПодписьВерна = Результат;
		ПодписиДляПроверки[ПроверяемыйИндекс].ОписаниеОшибки = "";
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
		ТекстОшибки = НСтр("ru = 'Электронная подпись в строке %1 неверна.
			|Причина: %2'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, ПодписиДляПроверки[ПроверяемыйИндекс].НомерСтроки, Результат);
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ТекстОшибки,,"ЭлектронныеПодписи["+(ПодписиДляПроверки[ПроверяемыйИндекс].НомерСтроки-1)+"].Статус");
		ПодписиДляПроверки[ПроверяемыйИндекс].ПодписьВерна = Ложь;
		ПодписиДляПроверки[ПроверяемыйИндекс].ОписаниеОшибки = Результат;
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось проверить подписи электронного документа.
			|Проверьте настройки криптографии или обратитесь к администратору.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если ПроверяемыйИндекс < ПодписиДляПроверки.ВГраница() Тогда
		
		ПараметрыОповещения = Новый Структура("ПодписиДляПроверки, ПроверяемыйИндекс", ПодписиДляПроверки, ПроверяемыйИндекс + 1);
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиОчереднойПодписи", ЭтотОбъект, ПараметрыОповещения);
		
		ПроцессыОбработкиДокументовКлиент.ПроверитьПодпись(Оповещение,
			ПодписиДляПроверки[ПроверяемыйИндекс + 1].АдресДанных, ПодписиДляПроверки[ПроверяемыйИндекс + 1].АдресПодписи);
		
	ИначеЕсли НЕ ЗапущенаПроверкаСоответствияПодписанныхИТекущихДанных Тогда
		
		ЗапущенаПроверкаСоответствияПодписанныхИТекущихДанных = Истина;
		
		// все подписи проверены, запускаем вторую проверку на соответствие текущим данным
		ПроверитьСоответствиеПодписанныхИТекущихДанных(ПодписиДляПроверки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоответствиеПодписанныхИТекущихДанных(ПодписиДляПроверки)
	
	Подписи = Новый Массив;
	ТекущийИндекс = 0;
	Для Каждого СтрокаПодписи Из ПодписиДляПроверки Цикл
		Подпись = Новый Структура;
		Подпись.Вставить("СоставПодписи", СтрокаПодписи.АдресСоставаПодписи);
		Подпись.Вставить("ПодписанныеДанные", СтрокаПодписи.АдресДанных);
		Подпись.Вставить("Индекс", ТекущийИндекс);
		Подпись.Вставить("ОписаниеОшибки", "");
		Подпись.Вставить("ДатаПодписи", СтрокаПодписи.ДатаПодписи);
		Подпись.Вставить("КомуВыданСертификат", СтрокаПодписи.КомуВыданСертификат);
		Подпись.Вставить("Этап", СтрокаПодписи.Этап);
		Подпись.Вставить("УстановившийПодпись", СтрокаПодписи.УстановившийПодпись);
		Подписи.Добавить(Подпись);
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;
	
	ДанныеДокумента = Новый Структура("Документ, ДополнительныеПараметры", Параметры.ЗначениеОтбора, Неопределено);
	ДанныеДокументов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеДокумента);
	
	ОписаниеОшибки = "";
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДокументов(ДанныеДокументов, ОписаниеОшибки);
	// При ошибке подготовки данных документа, все данные считаем неактуальными
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		Для Каждого СтрокаПодписи Из Подписи Цикл
			СтрокаПодписи.ОписаниеОшибки = ОписаниеОшибки;
		КонецЦикла;
	Иначе
		ПроцессыОбработкиДокументовВызовСервера.ПроверитьСоответствиеПодписанныхИТекущихДанных(Параметры.ЗначениеОтбора, Подписи, ДанныеДокументов[0].ДополнительныеПараметры);
	КонецЕсли;
	
	Для Каждого СтрокаПодписи Из Подписи Цикл
		
		ПодписиДляПроверки[СтрокаПодписи.Индекс].ДатаПроверкиДанных = ОбщегоНазначенияКлиент.ДатаСеанса();
		ПодписиДляПроверки[СтрокаПодписи.Индекс].ДанныеАктуальны = НЕ ЗначениеЗаполнено(СтрокаПодписи.ОписаниеОшибки);
		
		МассивСтрокОписаниеОшибки = СтрРазделить(СтрокаПодписи.ОписаниеОшибки, Символы.ПС);
		Если МассивСтрокОписаниеОшибки.Количество() > 1 Тогда
			МассивСтрокОписаниеОшибки.Удалить(0);
			ОписаниеОшибкиДанных = СтрСоединить(МассивСтрокОписаниеОшибки, Символы.ПС);
		Иначе
			ОписаниеОшибкиДанных = СтрокаПодписи.ОписаниеОшибки;
		КонецЕсли;
		ПодписиДляПроверки[СтрокаПодписи.Индекс].ОписаниеОшибкиДанных = ОписаниеОшибкиДанных;
		
		ЗаполнитьСтатусПодписи(ПодписиДляПроверки[СтрокаПодписи.Индекс]);
		
		Если ЗначениеЗаполнено(СтрокаПодписи.ОписаниеОшибки) Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Данные, подписанные электронной подписью в строке %1, неактуальны.'"),
				ПодписиДляПроверки[СтрокаПодписи.Индекс].НомерСтроки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки + "
				|"+СтрокаПодписи.ОписаниеОшибки,
				,
				"ЭлектронныеПодписи["+(ПодписиДляПроверки[СтрокаПодписи.Индекс].НомерСтроки-1)+"].СтатусПроверкиДанных");
		КонецЕсли;
	КонецЦикла;
	
	СохранитьРезультатыПроверкиПодписей(ЭлектронныеПодписи);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтатусПодписи(СтрокаПодписи)
	
	Если Не ЗначениеЗаполнено(СтрокаПодписи.ДатаПроверкиПодписи) Тогда
		СтрокаПодписи.Статус = "";
	ИначеЕсли НЕ СтрокаПодписи.ПодписьВерна Тогда
		СтрокаПодписи.Статус = НСтр("ru = 'Неверна'");
	Иначе
		СтрокаПодписи.Статус = НСтр("ru = 'Верна'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаПодписи.ДатаПроверкиДанных) Тогда
		СтрокаПодписи.СтатусПроверкиДанных = "";
	ИначеЕсли НЕ СтрокаПодписи.ДанныеАктуальны Тогда
		СтрокаПодписи.СтатусПроверкиДанных = НСтр("ru = 'Отличаются от текущих'");
	Иначе
		СтрокаПодписи.СтатусПроверкиДанных = НСтр("ru = 'Соответствуют текущим'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьРезультатыПроверкиПодписей(Знач ПодписиВФорме)
	
	Для Каждого Строка Из ПодписиВФорме Цикл
		
		Если Строка.ПростаяПодпись Тогда
			Продолжить;
		КонецЕсли;
		
		ПодписиВОбъекте = ПроцессыОбработкиДокументов.УстановленныеПодписи(Строка.Задача);
		СтрокаВОбъекте = ПодписиВОбъекте.Получить(Строка.ПорядковыйНомер - 1);
		
		Если Строка.ДатаПодписи <> СтрокаВОбъекте.ДатаПодписи
			ИЛИ Строка.КомуВыданСертификат <> СтрокаВОбъекте.КомуВыданСертификат
			ИЛИ Строка.Отпечаток <> СтрокаВОбъекте.Отпечаток
			ИЛИ Строка.УстановившийПодпись <> СтрокаВОбъекте.УстановившийПодпись Тогда
			Продолжить; // Если подпись была изменена, результаты проверки не переносятся.
		КонецЕсли;
		
		Если Строка.ДатаПроверкиПодписи = СтрокаВОбъекте.ДатаПроверкиПодписи
			И Строка.ПодписьВерна = СтрокаВОбъекте.ПодписьВерна Тогда
			Продолжить; // Не нужно обновлять данные проверки, если результаты проверки совпадают.
		КонецЕсли;
		
		СтрокаВОбъекте.ПодписьВерна = Строка.ПодписьВерна;
		СтрокаВОбъекте.ДатаПроверкиПодписи = Строка.ДатаПроверкиПодписи;
		
		ПроцессыОбработкиДокументов.ОбновитьПодпись(Строка.Задача, СтрокаВОбъекте);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// сохранение результатов проверки соответствия подписанных и текущих данных
	Для Каждого Строка Из ПодписиВФорме Цикл
		
		НаборЗаписей = РегистрыСведений.ПодписанныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Задача.Установить(Строка.Задача);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 1 Тогда
			
			ТекущаяЗапись = НаборЗаписей[0];
			Если Строка.ДатаПроверкиДанных = ТекущаяЗапись.ДатаПроверкиДанных
				И Строка.ДанныеАктуальны = ТекущаяЗапись.ДанныеАктуальны
				И Строка.ОписаниеОшибкиДанных = ТекущаяЗапись.ОписаниеОшибки Тогда
				Продолжить; // Не нужно обновлять данные проверки, если результаты проверки совпадают.
			КонецЕсли;
			
			ТекущаяЗапись.ДатаПроверкиДанных = Строка.ДатаПроверкиДанных;
			ТекущаяЗапись.ДанныеАктуальны = Строка.ДанныеАктуальны;
			ТекущаяЗапись.ОписаниеОшибки = Строка.ОписаниеОшибкиДанных;
			
			НаборЗаписей.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписки()
	
	ЗаполнитьСписокЗадач(ПоказыватьВыполненные);
	
	ТекущийСтатус = ТекущийСтатус(Параметры.ЗначениеОтбора);
	
	ЗаполнитьПорядокТекущегоЭтапа();
	
	ЗаполнитьСписокПодписей();

	ЗаполнитьФормулярыДокументов();
	Если ФормулярыДокументов.Количество() > 0 Тогда
		ЗаполнитьПредставленияЭлектронныхДокументов();
	Иначе	
		ЗаполнитьСохраненныеПредставленияЭлектронныхДокументов();
	КонецЕсли;	
	
	ЗаполнитьПервичныеДокументы();
	
	ЗаполнитьТекущийРегламентныйИнтервал();
	
	УстановитьДоступностьКнопок();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущийСтатус(ДокументСсылка)
	
	ТаблицаСтатусовДокументов = ПроцессыОбработкиДокументов.СтатусыОбъектов(ДокументСсылка);
	Если ТаблицаСтатусовДокументов.Количество() > 0 Тогда
		Возврат ТаблицаСтатусовДокументов[0].Статус;
	Иначе
		Возврат ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка");
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокЗадач(ПоказатьВсеЗадачи)
	
	СписокЗадач.Очистить();
	
	// Проверка права на чтение документа перед получением списка задач
	ЗапросПоПравамДоступа = Новый Запрос;
	ЗапросПоПравамДоступа.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	"+ОбщегоНазначения.ИмяТаблицыПоСсылке(Параметры.ЗначениеОтбора)+" КАК Т
	|ГДЕ
	|	Т.Ссылка = &Документ";
	ЗапросПоПравамДоступа.УстановитьПараметр("Документ", Параметры.ЗначениеОтбора);
	ЗапросПоПравамДоступа.Выполнить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка,
	|	Задачи.ПометкаУдаления КАК ПометкаУдаления,
	|	Задачи.Номер КАК Номер,
	|	Задачи.Дата КАК Дата,
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.Выполнена КАК Выполнена,
	|	ВЫБОР
	|		КОГДА Задачи.Выполнена
	|			ТОГДА 1
	|		КОГДА НЕ СоставПачекВыполняемыхЗадач.Задача ЕСТЬ NULL
	|			ТОГДА 3
	|		КОГДА Задачи.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА Задачи.НеВыполненаИзЗаОшибки
	|						ТОГДА 5
	|					ИНАЧЕ 4
	|				КОНЕЦ
	|		КОГДА Задачи.НеВыполненаИзЗаОшибки
	|			ТОГДА 2
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НомерКартинки,
	|	Задачи.Прервана КАК Прервана,
	|	Задачи.Автор КАК Автор,
	|	Задачи.РезультатВыполнения КАК РезультатВыполнения,
	|	Задачи.Исполнитель КАК Исполнитель,
	|	Задачи.РольИсполнителя КАК РольИсполнителя,
	|	Задачи.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
	|	Задачи.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации,
	|	Задачи.Представление КАК Представление,
	|	Задачи.ПринятаКИсполнению КАК ПринятаКИсполнению,
	|	ИсторияИзмененияСтатусовДокументов.Статус КАК Статус,
	|	Задачи.ДатаИсполнения КАК ДатаИсполнения,
	|	Задачи.ПодписанЭП КАК ПодписанЭП,
	|	Задачи.Этап КАК Этап,
	|	Задачи.НеВыполненаИзЗаОшибки КАК НеВыполненаИзЗаОшибки
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК Задачи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов
	|		ПО Задачи.Предмет = ИсторияИзмененияСтатусовДокументов.Предмет
	|			И Задачи.Ссылка = ИсторияИзмененияСтатусовДокументов.Установил
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
	|		ПО Задачи.Ссылка = СоставПачекВыполняемыхЗадач.Задача
	|ГДЕ
	|	Задачи.Предмет = &Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Задачи.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТекущиеНевыполненныеЗадачи.Ссылка КАК Ссылка,
	|	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа КАК ИдентификаторГрупповогоЭтапа,
	|	ШаблоныПроцессовЭтапы.Этап.Наименование КАК НаименованиеГрупповогоЭтапа
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента.ЗадачиПоИсполнителю(
	|			,
	|			Предмет = &Документ
	|				И НЕ Выполнена) КАК ТекущиеНевыполненныеЗадачи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО (ШаблоныПроцессовЭтапы.Ссылка = ТекущиеНевыполненныеЗадачи.Шаблон)
	|			И (ШаблоныПроцессовЭтапы.ИдентификаторЭтапаКуратора = ТекущиеНевыполненныеЗадачи.ИдентификаторЭтапа)";
	
	Запрос.УстановитьПараметр("Документ", Параметры.ЗначениеОтбора);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ПолныйСписокЗадач.Загрузить(Результат[0].Выгрузить());
	
	ЭтоКураторГрупповогоЭтапа = Ложь;
	ИдентификаторГрупповогоЭтапа = "";
	НаименованиеГрупповогоЭтапа = "";
	
	Выборка = Результат[1].Выбрать();
	Если Выборка.Следующий() Тогда
		ЭтоКураторГрупповогоЭтапа = Истина;
		ИдентификаторГрупповогоЭтапа = Выборка.ИдентификаторГрупповогоЭтапа;
		НаименованиеГрупповогоЭтапа = НСтр("ru = 'Ход выполнения группового этапа: '") + Выборка.НаименованиеГрупповогоЭтапа;
	КонецЕсли;
	
	ОтобратьЗадачиДляОтображения(ПоказатьВсеЗадачи);
	
КонецПроцедуры

&НаСервере
Процедура ОтобратьЗадачиДляОтображения(ПоказатьВсеЗадачи)
	
	Если ПоказатьВсеЗадачи Тогда
		СписокЗадач.Загрузить(ПолныйСписокЗадач.Выгрузить());
	Иначе
		СписокЗадач.Загрузить(ПолныйСписокЗадач.Выгрузить(Новый Структура("Выполнена", Ложь)));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПодписей()
	
	ЭлектронныеПодписи.Очистить();
	
	ЭП = СписокЭлектронныхПодписей(Параметры.ЗначениеОтбора, УникальныйИдентификатор);
	
	НомерСтроки = 0;
	
	Для Каждого ЭлектроннаяПодписьФайла Из ЭП Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока = ЭлектронныеПодписи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлектроннаяПодписьФайла);
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.КартинкаЭП = ?(НоваяСтрока.ПростаяПодпись, 3, 1);
		
		ЗаполнитьСтатусПодписи(НоваяСтрока);
		
	КонецЦикла;
	
	ТекстЗаголовка = НСтр("ru = 'Электронные подписи'");
	
	Если ЭлектронныеПодписи.Количество() <> 0 Тогда
		ТекстЗаголовка = ТекстЗаголовка + " (" + Строка(ЭлектронныеПодписи.Количество()) + ")";
	КонецЕсли;
	
	Элементы.ГруппаЭлектронныеПодписи.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокЭлектронныхПодписей(Предмет, УникальныйИдентификатор)
	
	ЭлектронныеПодписи = УстановленныеПодписи(Предмет);
	
	Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписи Цикл
		
		ЭлектроннаяПодписьФайла.Вставить("Объект", Предмет);
		
		АдресПодписи = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.Подпись, УникальныйИдентификатор);
		ЭлектроннаяПодписьФайла.Вставить("АдресПодписи", АдресПодписи);
		
		АдресСертификата = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.Сертификат, УникальныйИдентификатор);
		ЭлектроннаяПодписьФайла.Вставить("АдресСертификата", АдресСертификата);
		
		АдресСоставаПодписи = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.СоставПодписи, УникальныйИдентификатор);
		ЭлектроннаяПодписьФайла.Вставить("АдресСоставаПодписи", АдресСоставаПодписи);
		
		Владелец = ЭлектроннаяПодписьФайла.ПодписанныеДанныеФайл;
		ДвоичныеДанныеФайл = Неопределено;
		Если ЗначениеЗаполнено(Владелец) Тогда
			ПрисоединенныеФайлы = Новый Массив; 
			РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(Владелец, ПрисоединенныеФайлы);
			Если ПрисоединенныеФайлы.Количество() > 0 Тогда
				ДвоичныеДанныеФайл = РаботаСФайлами.ДвоичныеДанныеФайла(ПрисоединенныеФайлы[0], Истина); 
			КонецЕсли;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДвоичныеДанныеФайл) Тогда	
			АдресДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайл, УникальныйИдентификатор);
			ЭлектроннаяПодписьФайла.Вставить("АдресДанных", АдресДанных);

		ИначеЕсли ЭлектроннаяПодписьФайла.ПодписанныеДанные <> Неопределено	Тогда
		
			АдресДанных = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.ПодписанныеДанные, УникальныйИдентификатор);
			ЭлектроннаяПодписьФайла.Вставить("АдресДанных", АдресДанных);
		КонецЕсли;	
		
		РезультатПроверкиПодписиПоМЧД = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.РезультатПроверкиПодписиПоМЧД, УникальныйИдентификатор);
		ЭлектроннаяПодписьФайла.РезультатПроверкиПодписиПоМЧД = РезультатПроверкиПодписиПоМЧД;
	КонецЦикла;
	
	Возврат ЭлектронныеПодписи;
	
КонецФункции

&НаСервереБезКонтекста
Функция УстановленныеПодписи(Ссылка)
	
	// Проверка права на чтение документа перед получением списка задач
	ЗапросПоПравамДоступа = Новый Запрос;
	ЗапросПоПравамДоступа.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	"+ОбщегоНазначения.ИмяТаблицыПоСсылке(Ссылка)+" КАК Т
	|ГДЕ
	|	Т.Ссылка = &Документ";
	ЗапросПоПравамДоступа.УстановитьПараметр("Документ", Ссылка);
	ЗапросПоПравамДоступа.Выполнить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Задача,
	|	ЗадачаПоОбработкеДокумента.Этап КАК Этап,
	|	ЗадачаПоОбработкеДокумента.Этап.Наименование КАК НаименованиеЭтапа,
	|	РегистрСведенийПодписанныеДанные.СоставПодписи КАК СоставПодписи,
	|	РегистрСведенийПодписанныеДанные.ПодписанныеДанные КАК ПодписанныеДанные,
	|	РегистрСведенийПодписанныеДанные.ДанныеАктуальны КАК ДанныеАктуальны,
	|	РегистрСведенийПодписанныеДанные.ДатаПроверкиДанных КАК ДатаПроверкиДанных,
	|	РегистрСведенийПодписанныеДанные.ПодписанныеДанныеФайл КАК ПодписанныеДанныеФайл,
	|	РегистрСведенийПодписанныеДанные.ОписаниеОшибки КАК ОписаниеОшибкиДанных
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодписанныеДанные КАК РегистрСведенийПодписанныеДанные
	|		ПО (РегистрСведенийПодписанныеДанные.Задача = ЗадачаПоОбработкеДокумента.Ссылка)
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.ПодписанЭП
	|	И ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗадачаПоОбработкеДокумента.Дата";
	
	Запрос.УстановитьПараметр("Документ", Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивЭлектронныхПодписей = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		ПодписиВОбъекте = ПроцессыОбработкиДокументов.УстановленныеПодписи(Выборка.Задача);
		
		Если ПодписиВОбъекте.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОтпечатокСтруктура = Новый Структура(
			"ПорядковыйНомер, ДатаПодписи, УстановившийПодпись, ПростаяПодпись, ДатаПроверкиПодписи,
			|ИмяФайлаПодписи, КомуВыданСертификат, Отпечаток, Подпись, ПодписьВерна,
			|Сертификат, Задача, Этап, НаименованиеЭтапа, СоставПодписи, ПодписанныеДанные,
			|СоставПодписи, ДанныеАктуальны, ДатаПроверкиДанных, ОписаниеОшибкиДанных,
			|ВладелецПодписи, Организация, Должность, ТипПодписи, РезультатПроверкиПодписиПоМЧД,
			|МашиночитаемаяДоверенность, МашиночитаемаяДоверенностьВерна, ПодписанныеДанныеФайл");
		
		ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, ПодписиВОбъекте[0]);
		ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, Выборка);
		
		Если ОтпечатокСтруктура.ПростаяПодпись = Неопределено Тогда
			ОтпечатокСтруктура.Сертификат = ОтпечатокСтруктура.Сертификат.Получить();
		КонецЕсли;
		ОтпечатокСтруктура.СоставПодписи = ОтпечатокСтруктура.СоставПодписи.Получить();
		ОтпечатокСтруктура.ПодписанныеДанные = ОтпечатокСтруктура.ПодписанныеДанные.Получить();
		
		Если ЗначениеЗаполнено(ОтпечатокСтруктура.РезультатПроверкиПодписиПоМЧД) Тогда
			ОтпечатокСтруктура.МашиночитаемаяДоверенностьВерна = ОтпечатокСтруктура.РезультатПроверкиПодписиПоМЧД[0].Верна;
			ОтпечатокСтруктура.МашиночитаемаяДоверенность = ОтпечатокСтруктура.РезультатПроверкиПодписиПоМЧД[0].МашиночитаемаяДоверенность;
		КонецЕсли;	
		
		МассивЭлектронныхПодписей.Добавить(ОтпечатокСтруктура);
		
	КонецЦикла;
	
	Возврат МассивЭлектронныхПодписей;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьФормулярыДокументов()

	УстановитьПривилегированныйРежим(Истина);
	
	ФормулярыДокументов.Очистить();

	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Параметры.ЗначениеОтбора));
	КомандыПечати = МодульУправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ИдентификаторФормуляра КАК ИдентификаторФормуляра,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).НаименованиеДокумента КАК Представление,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).НомерДокумента КАК НомерДокумента,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ДатаДокумента КАК ДатаДокумента,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ОсновнойФайл.ДатаМодификацииУниверсальная КАК ДатаФормирования,
	               |	ФайлыФормуляровЭДПОД.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы
	               |ПОМЕСТИТЬ Формуляры
	               |ИЗ
	               |	РегистрСведений.ФайлыФормуляровЭДПОД КАК ФайлыФормуляровЭДПОД
	               |ГДЕ
	               |	ФайлыФормуляровЭДПОД.Предмет = &Предмет
	               |	И ФайлыФормуляровЭДПОД.КодВидаСведений = 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Формуляры.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
	               |	Формуляры.ИдентификаторФормуляра КАК ИдентификаторФормуляра,
	               |	Формуляры.Представление КАК Представление,
	               |	Формуляры.НомерДокумента КАК НомерДокумента,
	               |	Формуляры.ДатаДокумента КАК ДатаДокумента,
	               |	Формуляры.ДатаФормирования КАК ДатаФормирования,
	               |	Формуляры.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы
	               |ИЗ
	               |	Формуляры КАК Формуляры
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВЫРАЗИТЬ(Формуляры.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ОсновнойФайл.ДатаМодификацииУниверсальная УБЫВ";
	
	Запрос.УстановитьПараметр("Предмет", Параметры.ЗначениеОтбора);
	Запрос.УстановитьПараметр("ВариантФормированияИПодписания", Перечисления.ВариантыФормированияФормуляровПОД.ФормироватьИПодписыватьТолькоНаЭтомЭтапе);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ФормулярыДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка); 
	КонецЦикла;
	
	ТекстЗаголовка = НСтр("ru = 'Формуляры'");
	
	Если ФормулярыДокументов.Количество() > 0 Тогда
		ТекстЗаголовка = ТекстЗаголовка + " (" + Строка(ФормулярыДокументов.Количество()) + ")";
	КонецЕсли;
	
	Элементы.СтраницаПодписанныеПредставленияЭД.Заголовок = ТекстЗаголовка;
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыФормуляров(ЭтаФорма);

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПервичныеДокументы()
	
	ПервичныеДокументы.Очистить();
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Параметры.ЗначениеОтбора));
	КомандыПечати = МодульУправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПервичныеДокументыПОД.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы,
	|	ПервичныеДокументыПОД.ПервичныйДокумент КАК ПервичныйДокумент,
	|	ПервичныеДокументыПОД.ВидДокумента КАК ВидДокумента
	|ИЗ
	|	РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
	|		ПО ПервичныеДокументыПОД.ПервичныйДокумент = ПрисоединенныеФайлыПодписанныеЗадачами.Файл
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО (ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа)
	|			И (ШаблоныПроцессовЭтапы.Ссылка = &ШаблонПроцесса)
	|ГДЕ
	|	ПервичныеДокументыПОД.Предмет = &Документ
	|	И ПервичныеДокументыПОД.Формат = ""mxl""
	|	И ШаблоныПроцессовЭтапы.Порядок <= &ПорядокТекущегоЭтапа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПрисоединенныеФайлыПодписанныеЗадачами.Задача.ДатаИсполнения";
	
	Запрос.УстановитьПараметр("Документ", Параметры.ЗначениеОтбора);
	Запрос.УстановитьПараметр("ШаблонПроцесса", ШаблонПроцесса);
	Запрос.УстановитьПараметр("ПорядокТекущегоЭтапа", ПорядокТекущегоЭтапа);
	
	ИдентификаторыИзРегистра = Новый Соответствие;
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Пока Выборка.Следующий() Цикл
		Документ = Новый Структура("ПервичныйДокумент, ВидДокумента", Выборка.ПервичныйДокумент, Выборка.ВидДокумента);
		ИдентификаторыИзРегистра.Вставить(Выборка.ИдентификаторПечатнойФормы, Документ);
	КонецЦикла;
	
	// сначала выводятся первичные документы в соответствии с сортировкой команд печати,
	// а потом отсутствующие в текущих командах печати
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		Документ = ИдентификаторыИзРегистра[КомандаПечати.Идентификатор];
		Если Документ <> Неопределено Тогда
			НоваяСтрока = ПервичныеДокументы.Добавить();
			НоваяСтрока.ИдентификаторПечатнойФормы = КомандаПечати.Идентификатор;
			НоваяСтрока.Представление = Документ.ВидДокумента;
			НоваяСтрока.ПервичныйДокумент = Документ.ПервичныйДокумент;
			ИдентификаторыИзРегистра.Удалить(КомандаПечати.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючЗначение Из ИдентификаторыИзРегистра Цикл
		НоваяСтрока = ПервичныеДокументы.Добавить();
		НоваяСтрока.ИдентификаторПечатнойФормы = КлючЗначение.Ключ;
		НоваяСтрока.Представление = КлючЗначение.Значение.ВидДокумента;
		НоваяСтрока.ПервичныйДокумент = КлючЗначение.Значение.ПервичныйДокумент;
	КонецЦикла;
	
	ТекстЗаголовка = НСтр("ru = 'Первичные документы'");
	
	Если ПервичныеДокументы.Количество() > 0 Тогда
		ТекстЗаголовка = ТекстЗаголовка + " (" + Строка(ПервичныеДокументы.Количество()) + ")";
	КонецЕсли;
	
	Элементы.СтраницаПервичныеДокументы.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКнопок()

	ВидимостьПредставленийЭД = ПредставленияЭлектронныхДокументов.Количество() > 0;
	ВидимостьФормуляровЭД = ФормулярыДокументов.Количество() > 0;
	
	ДоступностьКнопокЭП = ЭлектронныеПодписи.Количество() > 0;
	ВидимостьПервичныхДокументов = ПервичныеДокументы.Количество() > 0;
	ВидимостьЗакладкиПервичныхДокументов = ВидимостьПервичныхДокументов;
	ВидимостьСохраненныхПредставленийЭД = ПервичныеДокументы.Количество() > 0;
	
	ВидимостьЗакладкиПервичныхДокументов = ВидимостьПервичныхДокументов;

	СтраницаПервичныеДокументы = Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПервичныеДокументы;
	
	Элементы.ЭлектронныеПодписиОткрыть.Доступность = ДоступностьКнопокЭП;
	Элементы.ЭлектронныеПодписиПроверить.Доступность = ДоступностьКнопокЭП;
	Элементы.ЭлектронныеПодписиПроверитьВсе.Доступность = ДоступностьКнопокЭП;
	Элементы.ЭлектронныеПодписиСохранить.Доступность = ДоступностьКнопокЭП;
	
	Элементы.ЭлектронныеПодписиПросмотреть.Доступность = ДоступностьКнопокЭП;
	Элементы.ЭлектронныеПодписиСохранитьДанные.Доступность = ДоступностьКнопокЭП;
	Элементы.ЭлектронныеПодписиСохранитьДанныеСПодписью.Доступность = ДоступностьКнопокЭП;
	Элементы.ЭлектронныеПодписиСохранитьДанныеСПодписьюВсе.Доступность = ДоступностьКнопокЭП;
	
	Элементы.НаименованиеГрупповогоЭтапа.Видимость = ЭтоКураторГрупповогоЭтапа;
	
	Элементы.ФормаТекущийРегламентныйИнтервал.Видимость = ЗначениеЗаполнено(ТекущийРегламентныйИнтервал);
	
	Элементы.ГруппаСохраненныеФормуляры.Видимость = ВидимостьФормуляровЭД;
	Элементы.ГруппаСохраненныеПредставленияЭД.Видимость = ВидимостьПредставленийЭД;
	
	Элементы.ПервичныеДокументы.Видимость = ВидимостьПервичныхДокументов;
	Элементы.ПервичныйДокумент.Видимость = ВидимостьПервичныхДокументов;
	Элементы.ГруппаСтраницы.ОтображениеСтраниц =
		?(ВидимостьЗакладкиПервичныхДокументов ИЛИ ВидимостьПредставленийЭД ИЛИ ВидимостьФормуляровЭД, ОтображениеСтраницФормы.Авто, ОтображениеСтраницФормы.Нет);
	
	Элементы.ФормаПечать.Видимость = СтраницаПервичныеДокументы;
	Элементы.ФормаПредварительныйПросмотр.Видимость = СтраницаПервичныеДокументы;
	Элементы.ПервичныеДокументыГруппаСохранить.Видимость = СтраницаПервичныеДокументы;

	Элементы.СтраницаПодписанныеПредставленияЭД.Видимость = ВидимостьФормуляровЭД;
	Элементы.СтраницаНеПодписанныеПредставленияЭД.Видимость = ВидимостьПредставленийЭД;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СтраницаПодписанныеПредставленияЭД",
		"Видимость",
		ФормированиеФормуляровВключено);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СтраницаНеПодписанныеПредставленияЭД",
		"Видимость",
		ФормированиеФормуляровВключено);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СтраницаВнешниеЭД",
		"Видимость",
		ВнешниеЭлектронныеДокументы.Количество() > 0);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ОтправитьКакВнешнийЭД",
		"Видимость",
		ФормированиеФормуляровВключено И РазрешенаОтправкаФормуляровКонтрагентамПоЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ОтправитьКакВнешнийЭДКопию",
		"Видимость",
		ФормированиеФормуляровВключено И РазрешенаОтправкаФормуляровКонтрагентамПоЭДО);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ОткрытьТекущиеДелаЭДО",
		"Видимость",
		ФормированиеФормуляровВключено И РазрешенаОтправкаФормуляровКонтрагентамПоЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ОткрытьТекущиеДелаЭДОДляВизуализации",
		"Видимость",
		ФормированиеФормуляровВключено И РазрешенаОтправкаФормуляровКонтрагентамПоЭДО);
		
	ПроцессыОбработкиДокументовПереопределяемый.УстановитьСвойстваЭлементовКарточкиПроцессаДокумента(ЭтотОбъект);
	
КонецПроцедуры

