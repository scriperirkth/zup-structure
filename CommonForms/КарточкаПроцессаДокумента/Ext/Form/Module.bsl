		ОбновитьТекстЗаголовковВСтрокеФормуляров(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеФормуляров(ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокДата = НСтр("ru = 'Дата формирования:'");
	ТекущаяСтрока.ЗаголовокЭтап = НСтр("ru = 'Этап формирования:'");
	ТекущаяСтрока.ЗаголовокШаблон = НСтр("ru = 'Шаблон:'");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКакВнешнийЭДНаКлиенте()
	ТекущиеДанныеФормуляров = Элементы.ФормулярыДокументов.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанныеФормуляров.ИдентификаторФормуляра) Тогда
		//Оригинал
		ОткрытьВнешнийЭлектронныйДокументФайла(ТекущиеДанныеФормуляров.ИдентификаторФормуляра);
	Иначе
		ТекстСообщения = НСтр("ru = 'Не выбран формуляр для отправки контрагенту по ЭДО.
			|Следует выбрать формуляр из списка и повторить операцию.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКакВнешнийЭДКопиюНаКлиенте()
	ТекущиеДанныеПредставлений = Элементы.ПредставленияЭлектронныхДокументов.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанныеПредставлений.ИдентификаторФормуляра) Тогда
		//Копия
	    ОткрытьВнешнийЭлектронныйДокументСКопиейФайла(Параметры.ЗначениеОтбора, ПредставлениеДокументаMXL, 
			ТекущиеДанныеПредставлений.ИдентификаторФормуляра, ТекущиеДанныеПредставлений.Представление); 
	Иначе
		ТекстСообщения = НСтр("ru = 'Не выбрана визуализация формуляра для отправки контрагенту по ЭДО.
			|Следует выбрать формуляр из списка и повторить операцию.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущиеДелаЭДОНаКлиенте();	

	Если ИспользуетсяЭДОСКонтрагентамиБЭД Тогда
		ПроцессыОбработкиДокументовКлиент.ОткрытьТекущиеДелаЭДО();
	КонецЕсли;	
	
КонецПроцедуры
	
