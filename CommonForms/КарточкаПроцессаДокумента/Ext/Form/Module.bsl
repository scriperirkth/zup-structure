	ЭлементШрифтаОформления.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДополнительныеКомандыКарточкиПроцессаДокумента()
	
	МассивКоманд = Новый Массив;
	ПараметрыДополнительныхКоманд = Новый Структура;
	
	ПроцессыОбработкиДокументовПереопределяемый.ОписаниеДополнительныхКомандКарточкиПроцессаДокумента(МассивКоманд);
	
	Для Каждого ДополнительнаяКоманда Из МассивКоманд Цикл
		
		Команда = Команды.Добавить(ДополнительнаяКоманда.Идентификатор);
		Команда.Заголовок = ДополнительнаяКоманда.Представление;
		Команда.Действие = "Подключаемый_ВыполнитьДополнительнуюКоманду";
		Если ДополнительнаяКоманда.Свойство("Картинка") Тогда
			Команда.Картинка = ДополнительнаяКоманда.Картинка;
		КонецЕсли;
		
		Элемент = Элементы.Добавить(ДополнительнаяКоманда.Идентификатор, Тип("КнопкаФормы"), Элементы.КоманднаяПанельСписка);
		Элемент.ИмяКоманды = ДополнительнаяКоманда.Идентификатор;
		Элемент.ТолькоВоВсехДействиях = Истина;
		
		ПараметрыКоманды = Новый Структура("Серверная", ДополнительнаяКоманда.Свойство("Серверная"));
		ПараметрыДополнительныхКоманд.Вставить(ДополнительнаяКоманда.Идентификатор, ПараметрыКоманды);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеДоступностьюКомандЗадач(ТекущиеДанные)
	
	ДоступностьОтменитьПринятиеКИсполнению = Ложь;
	ДоступностьОтменитьВыполнение = Ложь;
	
	Если ТекущиеДанные = Неопределено Тогда
		
	ИначеЕсли НЕ ТекущиеДанные.Выполнена
		И ТекущиеДанные.ПринятаКИсполнению Тогда
		ДоступностьОтменитьПринятиеКИсполнению = Истина;
	ИначеЕсли ТекущиеДанные.Выполнена И НЕ ТекущиеДанные.Прервана Тогда
		ДоступностьОтменитьВыполнение = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокЗадачКонтекстноеМенюОтменитьПринятиеКИсполнению", "Доступность", ДоступностьОтменитьПринятиеКИсполнению);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокЗадачКонтекстноеМенюОтменитьВыполнение", "Доступность", ДоступностьОтменитьВыполнение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСпискиНаКлиенте()
	
	ЗапомнитьВыделеннуюЗадачу();
	
	ОбновитьСписки();
	
	УстановитьТекущуюЗадачу();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьВыделеннуюЗадачу()
	
	ТекущиеДанные = Элементы.СписокЗадач.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ВыделеннаяЗадача = Неопределено;
	Иначе
		ВыделеннаяЗадача = ТекущиеДанные.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуюЗадачу()
	
	Если НЕ ЗначениеЗаполнено(ВыделеннаяЗадача) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Задача Из СписокЗадач Цикл
		Если Задача.Ссылка = ВыделеннаяЗадача Тогда
			Элементы.СписокЗадач.ТекущаяСтрока = Задача.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущийРегламентныйИнтервал()
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьРегламентныеИнтервалы") Тогда
		Возврат;
	КонецЕсли;
	
	РегламентныйИнтервалДокумента = ПроцессыОбработкиДокументов.АктивныйРегламентныйИнтервалДокумента(Параметры.ЗначениеОтбора);
	
	ТекущийРегламентныйИнтервал = РегламентныйИнтервалДокумента.РегламентныйИнтервал;
	ТекущийНомерИтерации = РегламентныйИнтервалДокумента.НомерИтерации;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭлектроннуюПодпись()
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;
	
	Если ТекущиеДанные.ПростаяПодпись Тогда
		ПроцессыОбработкиДокументовКлиент.ОткрытьПростуюПодпись(ТекущиеДанные);
	ИначеЕсли ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
		ПроцессыОбработкиДокументовКлиент.ОткрытьПодпись(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПорядокТекущегоЭтапа()
	
	ПорядокТекущегоЭтапа = ПроцессыОбработкиДокументов.ПорядокТекущегоЭтапаШаблонаПроцесса(
		Параметры.ЗначениеОтбора, ШаблонПроцесса);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьТабличныйДокумент()
	ПервичныйДокументMXL.Очистить();
КонецПроцедуры

&НаСервере
Процедура ОтобразитьВизуализациюПервичногоДокумента(ИдентификаторПечатнойФормы, ПервичныйДокумент)
	
	ПервичныйДокументMXL = ПроцессыОбработкиДокументов.ВизуализацияПервичногоДокумента(
		Параметры.ЗначениеОтбора, ИдентификаторПечатнойФормы, ПервичныйДокумент, ШаблонПроцесса, ПорядокТекущегоЭтапа);
	
КонецПроцедуры

&НаСервере
Функция ВыборкаФайловПервичногоДокумента(ИдентификаторПечатнойФормы)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПервичныеДокументыПОД.ПервичныйДокумент КАК ПервичныйДокумент
	|ИЗ
	|	РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
	|		ПО ПервичныеДокументыПОД.ПервичныйДокумент = ПрисоединенныеФайлыПодписанныеЗадачами.Файл
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО (ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа)
	|			И (ШаблоныПроцессовЭтапы.Ссылка = &ШаблонПроцесса)
	|ГДЕ
	|	ПервичныеДокументыПОД.Предмет = &Документ
	|	И ПервичныеДокументыПОД.ИдентификаторПечатнойФормы = &ИдентификаторПечатнойФормы
	|	И ШаблоныПроцессовЭтапы.Порядок < &ПорядокТекущегоЭтапа
	|
	|СГРУППИРОВАТЬ ПО
	|	ПервичныеДокументыПОД.ПервичныйДокумент";
	
	Запрос.УстановитьПараметр("Документ", Параметры.ЗначениеОтбора);
	Запрос.УстановитьПараметр("ШаблонПроцесса", ШаблонПроцесса);
	Запрос.УстановитьПараметр("ИдентификаторПечатнойФормы", ИдентификаторПечатнойФормы);
	Запрос.УстановитьПараметр("ПорядокТекущегоЭтапа", ПорядокТекущегоЭтапа);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

&НаСервере
Функция ФайлыПервичногоДокумента(ИдентификаторПечатнойФормы)
	
	ДанныеФайлов = Новый Массив;
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	
	Выборка = ВыборкаФайловПервичногоДокумента(ИдентификаторПечатнойФормы);
	
	Пока Выборка.Следующий() Цикл
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.ПервичныйДокумент, ПараметрыДанных);
		ДанныеФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(
			ДанныеФайла.ИмяФайла, ДанныеФайла.СсылкаНаДвоичныеДанныеФайла));
	КонецЦикла;
	
	Возврат ДанныеФайлов;
	
КонецФункции

&НаСервере
Функция ФайлыПодписиПервичногоДокумента(ИдентификаторПечатнойФормы)
	
	ДанныеФайлов = Новый Массив;
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПерсональныеНастройки = ЭлектроннаяПодпись.ПерсональныеНастройки();
	
	УникальныеИменаФайлов = Новый Соответствие;
	
	Выборка = ВыборкаФайловПервичногоДокумента(ИдентификаторПечатнойФормы);
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.ПервичныйДокумент, ПараметрыДанных);
		
		ИмяФайла = ДанныеФайла.ИмяФайла;
		
		НомерФайла = УникальныеИменаФайлов[ДанныеФайла.ИмяФайла];
		
		Если НомерФайла = Неопределено Тогда
			УникальныеИменаФайлов.Вставить(ДанныеФайла.ИмяФайла, 0);
		Иначе
			ПорядковыйНомерНовогоФайла = НомерФайла + 1;
			УникальныеИменаФайлов.Вставить(ДанныеФайла.ИмяФайла, ПорядковыйНомерНовогоФайла);
			
			РазложенноеИмяФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла);
			ИмяБезРасширения = РазложенноеИмяФайла.ИмяБезРасширения;
			
			ДанныеФайла.ИмяФайла = РазложенноеИмяФайла.Путь
				+ РазложенноеИмяФайла.ИмяБезРасширения
				+ " ("+ Строка(ПорядковыйНомерНовогоФайла) + ")"
				+ РазложенноеИмяФайла.Расширение;
		КонецЕсли;
		
		ДанныеФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(
			ДанныеФайла.ИмяФайла, ДанныеФайла.СсылкаНаДвоичныеДанныеФайла));
		
		Подписи = ЭлектроннаяПодпись.УстановленныеПодписи(Выборка.ПервичныйДокумент);
		Для Каждого Подпись Из Подписи Цикл
			ДанныеФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(
				ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаПодписиПервичногоДокументаПоУмолчанию(
					ДанныеФайла, Подпись, ПерсональныеНастройки),
				ПоместитьВоВременноеХранилище(Подпись.Подпись)));
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ДанныеФайлов;
	
КонецФункции

&НаСервере
Функция ФайлыПодписиВизуализацияПервичногоДокумента(ИдентификаторПечатнойФормы, ПервичныйДокумент)
	
	ДанныеФайлов = ФайлыПодписиПервичногоДокумента(ИдентификаторПечатнойФормы);
	
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ПолучатьСсылкуНаДвоичныеДанные = Ложь;
	
	ДанныеФайла = РаботаСФайлами.ДанныеФайла(ПервичныйДокумент, ПараметрыДанных);
	
	РазложенноеИмяФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла);
	
	ИмяФайла = РазложенноеИмяФайла.ИмяБезРасширения + " (визуализация)" + ".pdf";
	ПолноеИмяФайла = ИмяВременногоКаталога + ИмяФайла;
	
	ТабличныйДокумент = ПроцессыОбработкиДокументов.ВизуализацияПервичногоДокумента(
		Параметры.ЗначениеОтбора, ИдентификаторПечатнойФормы, ПервичныйДокумент, ШаблонПроцесса, ПорядокТекущегоЭтапа);
	
	ТабличныйДокумент.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.PDF_A_3);
	
	ДанныеФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(
		ИмяФайла, ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла))));
	
	Возврат ДанныеФайлов;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСохраненныеПредставленияЭлектронныхДокументов()
	УстановитьПривилегированныйРежим(Истина);
	
	ПредставленияЭлектронныхДокументов.Очистить();
	
	ЕстьПредставлениеФормуляра = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.Ссылка КАК ДанныеПредставленияПервичногоДокумента,
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.ИдентификаторФормуляра КАК ИдентификаторФормуляра,
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.НаименованиеДокумента КАК Представление,
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.НомерДокумента КАК НомерДокумента,
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.ДатаДокумента КАК ДатаДокумента,
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.ОсновнойФайл.ДатаСоздания КАК ДатаФормирования
	               |ИЗ
	               |	Документ.ПредставлениеФормуляраПервичногоДокументаПОД КАК ПредставлениеФормуляраПервичногоДокументаПОД
	               |ГДЕ
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.Предмет = &Предмет
	               |	И ПредставлениеФормуляраПервичногоДокументаПОД.КодВидаСведений = 1
	               |	И ПредставлениеФормуляраПервичногоДокументаПОД.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.ОсновнойФайл.ДатаСоздания УБЫВ";
	
	Запрос.УстановитьПараметр("Предмет", Параметры.ЗначениеОтбора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ПредставленияЭлектронныхДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка); 
		ЕстьПредставлениеФормуляра = Истина;
	КонецЦикла;

	ТекстЗаголовка = НСтр("ru = 'Представление формуляров'");
	
	Если ПредставленияЭлектронныхДокументов.Количество() > 0 Тогда
		ТекстЗаголовка = ТекстЗаголовка + " (" + Строка(ПредставленияЭлектронныхДокументов.Количество()) + ")";
	КонецЕсли;
	
	Элементы.СтраницаНеПодписанныеПредставленияЭД.Заголовок = ТекстЗаголовка;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПредставленияЭлектронныхДокументов()
	Для Каждого ТекСтрока Из ФормулярыДокументов Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИдентификаторПечатнойФормы", ТекСтрока.ИдентификаторПечатнойФормы);
		НайденныеСтроки = ПредставленияЭлектронныхДокументов.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ПредставленияЭлектронныхДокументов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.ОсновнойФормуляр = ТекСтрока.ДанныеПредставленияПервичногоДокумента;
			
			Реквизиты = "ИдентификаторПечатнойФормы";
			
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.ДанныеПредставленияПервичногоДокумента, Реквизиты);
			НоваяСтрока.ИдентификаторПечатнойФормы = СтруктураДанных.ИдентификаторПечатнойФормы;
		Иначе
			СтрокаФормуляра = НайденныеСтроки[0];
	        ИдентификаторыПрочихФормуляров = СтрокаФормуляра.ИдентификаторыПрочихФормуляров;
			МассивИдентификаторов = СтрРазделить(ИдентификаторыПрочихФормуляров, ",", Ложь);
			МассивИдентификаторов.Добавить(ТекСтрока.ИдентификаторФормуляра);
			ИдентификаторыПрочихФормуляров = СтрСоединить(МассивИдентификаторов, ",");
			СтрокаФормуляра.ИдентификаторыПрочихФормуляров = ИдентификаторыПрочихФормуляров;
		КонецЕсли;
	КонецЦикла;	
		
КонецПроцедуры

&НаСервере
Процедура ОчиститьТабличныйДокументФормуляра()
	ФормулярДокументаMXL.Очистить();
КонецПроцедуры

&НаСервере
Процедура ОчиститьТабличныйДокументПредставленияЭлектронногоДокумента()
	ПредставлениеДокументаMXL.Очистить();
КонецПроцедуры

&НаСервере
Процедура ОтобразитьВизуализациюФормуляраДокумента(Предмет, ДокументФормуляраПОД)
	
	ФормулярДокументаMXL = ПроцессыОбработкиДокументов.ВизуализацияФормуляраПервичногоДокумента(
		Параметры.ЗначениеОтбора, ШаблонПроцесса, ДокументФормуляраПОД);
		
