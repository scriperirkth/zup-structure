
#Область ОписаниеПеременных

// Переменная используется для исключения повторной проверки подписанных данных,
// которая инициируется при возникновении исключения в процедуре проверки, так как
// при этом повторно вызывается обработчик ПослеПроверкиОчереднойПодписи
&НаКлиенте
Перем ЗапущенаПроверкаСоответствияПодписанныхИТекущихДанных;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ЕстьНастройки = Ложь;
	ФормированиеФормуляровВключено = ПроцессыОбработкиДокументов.ВключенаПоддержкаФормированияИПодписанияФормуляров();
	
	ШаблонИСтатус = ПроцессыОбработкиДокументов.ШаблонИСтатусДокумента(Параметры.ЗначениеОтбора);
	
	ШаблонПроцесса = ШаблонИСтатус.Шаблон;
	ТекущийСтатус = ШаблонИСтатус.Статус;
	
	ИспользуетсяЭДОСКонтрагентамиБЭД = ПроцессыОбработкиДокументов.ЕстьДоступностьВнешнегоЭДО(Параметры.ЗначениеОтбора);
	
	Если ИспользуетсяЭДОСКонтрагентамиБЭД Тогда
		РазрешенаОтправкаФормуляровКонтрагентамПоЭДО = ПроцессыОбработкиДокументов.РазрешенаОтправкаФормуляровКонтрагентамПоЭДОДляШаблона(ШаблонПроцесса);
	    Если РазрешенаОтправкаФормуляровКонтрагентамПоЭДО Тогда
			МожноСоздатьНовыйВнешнийЭД = Истина;
		КонецЕсли;	
		ЗаполнитьСписокВнешнихЭД(Параметры.ЗначениеОтбора);
	КонецЕсли;	
		
	ЗаполнитьПорядокТекущегоЭтапа();
	
	ЗаполнитьСписокПодписей();

	ЗаполнитьФормулярыДокументов();
	Если ФормулярыДокументов.Количество() > 0 Тогда
		ЗаполнитьПредставленияЭлектронныхДокументов();
	Иначе	
		ЗаполнитьСохраненныеПредставленияЭлектронныхДокументов();
	КонецЕсли;	
	
	ЗаполнитьПервичныеДокументы();
	
	ЗаполнитьТекущийРегламентныйИнтервал();
	
	Заголовок = НСтр("ru = 'Карточка процесса по документу'");
	
	Если Параметры.Свойство("ОткрытиеВОтдельномОкне") Тогда
		Заголовок = Заголовок + ": " + Параметры.ЗначениеОтбора;
	КонецЕсли;
	
	ПредставлениеДокумента = ПроцессыОбработкиДокументов.ПредставлениеДокументаДляИмениФайла(Параметры.ЗначениеОтбора);
	
	ДобавитьДополнительныеКомандыКарточкиПроцессаДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Запись_ЗадачаПоОбработкеДокумента" Тогда

		ОбновитьСпискиНаКлиенте();

	ИначеЕсли ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
	    Если ИспользуетсяЭДОСКонтрагентамиБЭД Тогда
			УстановитьВидимостьЭлементовВнешнегоЭДО(Параметры.ЗначениеОтбора);
			ЗаполнитьСписокВнешнихЭД(Параметры.ЗначениеОтбора);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	ПоказыватьВыполненные = Настройки["ПоказыватьВыполненные"];
	ЗаполнитьСписокЗадач(ПоказыватьВыполненные);
	УстановитьДоступностьКнопок();
	ЕстьНастройки = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЕстьНастройки Тогда
		ПоказыватьВыполненные = Истина;
		ЗаполнитьСписокЗадач(ПоказыватьВыполненные);
		УстановитьДоступностьКнопок();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаименованиеГрупповогоЭтапаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ", Параметры.ЗначениеОтбора);
	ПараметрыФормы.Вставить("ИдентификаторЭтапа", ИдентификаторГрупповогоЭтапа);
	ПараметрыФормы.Вставить("НаименованиеЭтапа", НаименованиеГрупповогоЭтапа);
	ОткрытьФорму("ОбщаяФорма.ХодВыполненияГрупповогоЭтапа", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьВыполненныеПриИзменении(Элемент)
	ОтобратьЗадачиДляОтображения(ПоказыватьВыполненные);
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	УстановитьДоступностьКнопок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокЗадач

&НаКлиенте
Процедура СписокЗадачВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элемент.ТекущиеДанные.НеВыполненаИзЗаОшибки Тогда
		МассивЗадач = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Элемент.ТекущиеДанные.Ссылка);
		ПроцессыОбработкиДокументовКлиент.ПоказатьИнформациюОбОшибках(МассивЗадач);
	ИначеЕсли Поле.Имя = "СписокЗадачОписаниеВыполнения" И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РезультатВыполнения) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Описание выполнения'"));
		ПараметрыФормы.Вставить("Автор", Элемент.ТекущиеДанные.Исполнитель);
		ПараметрыФормы.Вставить("ОписаниеЗадачи", Элемент.ТекущиеДанные.РезультатВыполнения);
		ОткрытьФорму("ОбщаяФорма.ОписаниеЗадачи", ПараметрыФормы, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокЗадачПриАктивизацииСтроки(Элемент)
	УправлениеДоступностьюКомандЗадач(Элемент.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭлектронныеПодписи

&НаКлиенте
Процедура ЭлектронныеПодписиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьЭлектроннуюПодпись();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПервичныеДокументы

&НаКлиенте
Процедура ПервичныеДокументыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ПервичныеДокументы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ОчиститьТабличныйДокумент();
		Возврат;
	КонецЕсли;
	
	ОтобразитьВизуализациюПервичногоДокумента(ТекущиеДанные.ИдентификаторПечатнойФормы, ТекущиеДанные.ПервичныйДокумент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыФормулярыДокументов

&НаКлиенте
Процедура ФормулярыДокументовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ФормулярыДокументов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ОчиститьТабличныйДокументФормуляра();
		Возврат;
	КонецЕсли;
	
	ОтобразитьВизуализациюФормуляраДокумента(Параметры.ЗначениеОтбора,
		ТекущиеДанные.ДанныеПредставленияПервичногоДокумента);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПредставленияЭлектронныхДокументов

&НаКлиенте
Процедура ПредставленияЭлектронныхДокументовПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ПредставленияЭлектронныхДокументов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ОчиститьТабличныйДокументПредставленияЭлектронногоДокумента();
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДанныеПредставленияПервичногоДокумента) Тогда
		ОтобразитьВизуализациюСохраненногоПредставленияЭлектронногоДокумента(ТекущиеДанные.ДанныеПредставленияПервичногоДокумента);
	Иначе
		Если ЗначениеЗаполнено(ТекущиеДанные.ОсновнойФормуляр) Тогда
			ОтобразитьВизуализациюПредставленияЭлектронногоДокумента(ТекущиеДанные.ОсновнойФормуляр, ТекущиеДанные.ИдентификаторыПрочихФормуляров);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

 #Область  ОбработчикиСобытийЭлементовТаблицыФормыВнешниеЭлектронные

&НаКлиенте
Процедура ВнешниеЭлектронныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ВнешниеЭлектронныеДокументы.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ЭлектронныйДокумент) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.ЭлектронныйДокумент);
		ОткрытьФормуПроизвольногоЭлектронногоДокумента(ПараметрыФормы);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьСпискиНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭП(Команда)
	
	ОткрытьЭлектроннуюПодпись();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЭП(Команда)
	
	Если Элементы.ЭлектронныеПодписи.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УсиленныеПодписи = Новый Массив;
	ПростыеПодписи = Новый Массив;
	Для Каждого Подпись Из Элементы.ЭлектронныеПодписи.ВыделенныеСтроки Цикл
		СтрокаПодписи = ЭлектронныеПодписи.НайтиПоИдентификатору(Подпись);
		Если СтрокаПодписи.ПростаяПодпись Тогда
			ПростыеПодписи.Добавить(СтрокаПодписи);
		Иначе
			УсиленныеПодписи.Добавить(СтрокаПодписи);
		КонецЕсли;
	КонецЦикла;
	
	ПроверитьПодписи(УсиленныеПодписи, ПростыеПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВсе(Команда)
	
	УсиленныеПодписи = Новый Массив;
	ПростыеПодписи = Новый Массив;
	Для Каждого Подпись Из ЭлектронныеПодписи Цикл
		Если Подпись.ПростаяПодпись Тогда
			ПростыеПодписи.Добавить(Подпись);
		Иначе
			УсиленныеПодписи.Добавить(Подпись);
		КонецЕсли;
	КонецЦикла;
	
	ПроверитьПодписи(УсиленныеПодписи, ПростыеПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотретьДанные(Команда)
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо указать строку в списке ""Электронные подписи"" и повторить операцию.'"));
		Возврат;
	КонецЕсли;
	
	АдресДанныхXML = АдресXMLПодписанныхДанных(ТекущиеДанные.АдресДанных, УникальныйИдентификатор);
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ПолучитьИзВременногоХранилища(АдресДанныхXML));
	ТекстовыйДокумент.ТолькоПросмотр = Истина;
	ТекстовыйДокумент.Показать(Строка(Параметры.ЗначениеОтбора) + НСтр("ru = ' (Подписанные данные)'"),"signdata.xml");
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПодпись(Команда)
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Объект = Неопределено Или ТекущиеДанные.Объект.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПростаяПодпись Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Команда не может быть выполнена для простой подписи'"));
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();
	
	ИмяФайла = ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ТекущиеДанные, ПерсональныеНастройки);
	
	Оповещение = Новый ОписаниеОповещения("СохранитьПодписьПослеПолученияФайла", ЭтотОбъект, Неопределено);
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы электронных подписей (*.%1)|*.%1|Все файлы (*.*)|*.*'"),
		ЭлектроннаяПодписьКлиент.ПерсональныеНастройки().РасширениеДляФайловПодписи);
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения подписи'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, ТекущиеДанные.АдресПодписи, ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанные(Команда)
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;
	
	ИмяФайла = ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаДанныхПоУмолчанию(ТекущиеДанные, ПредставлениеДокумента);
	
	Оповещение = Новый ОписаниеОповещения("СохранитьДанныеПослеПолученияФайла", ЭтотОбъект, Неопределено);
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы xml (*.%1)|*.%1|Все файлы (*.*)|*.*'"),
		"xml");
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения данных'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, ТекущиеДанные.АдресДанных, ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеСПодписью(Команда)
	
	Если Элементы.ЭлектронныеПодписи.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;
	
	Если ТекущиеДанные.Объект = Неопределено Или ТекущиеДанные.Объект.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();
	
	ПередаваемыеФайлы = Новый Массив;
	ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(
		ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаДанныхПоУмолчанию(ТекущиеДанные, ПредставлениеДокумента), ТекущиеДанные.АдресДанных));
	Если НЕ ТекущиеДанные.ПростаяПодпись Тогда
		ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(
			ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ТекущиеДанные, ПерсональныеНастройки), ТекущиеДанные.АдресПодписи));
	КонецЕсли;
	
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(Новый ОписаниеОповещения(
		"СохранитьДанныеПослеПодключенияРасширенияРаботыСФайлами", ЭтотОбъект, ПередаваемыеФайлы));
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеСПодписьюВсе(Команда)
	
	ПерсональныеНастройки = ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();
	
	ПередаваемыеФайлы = Новый Массив;
	
	Для Каждого ТекущиеДанные Из ЭлектронныеПодписи Цикл
		
		ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(
			ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаДанныхПоУмолчанию(ТекущиеДанные, ПредставлениеДокумента), ТекущиеДанные.АдресДанных));
		Если НЕ ТекущиеДанные.ПростаяПодпись Тогда
			ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(
				ПроцессыОбработкиДокументовКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ТекущиеДанные, ПерсональныеНастройки), ТекущиеДанные.АдресПодписи));
		КонецЕсли;
		
	КонецЦикла;
	
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(Новый ОписаниеОповещения(
		"СохранитьДанныеПослеПодключенияРасширенияРаботыСФайлами", ЭтотОбъект, ПередаваемыеФайлы));
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКартуМаршрута(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДокументСсылка", Параметры.ЗначениеОтбора);
	ОткрытьФорму("ОбщаяФорма.КартаМаршрутаПроцесса", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПринятиеКИсполнению(Команда)
	
	ТекущиеДанные = Элементы.СписокЗадач.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроцессыОбработкиДокументовКлиент.ОтменитьПринятиеЗадачКИсполнению(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущиеДанные.Ссылка));
		
	ОбновитьФормуВладельца();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыполнение(Команда)
	
	ТекущиеДанные = Элементы.СписокЗадач.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроцессыОбработкиДокументовКлиент.ОтменитьВыполнениеЗадач(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущиеДанные.Ссылка));
		
	ОбновитьФормуВладельца();
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийРегламентныйИнтервал(Команда)
	
	Отбор = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый Структура("Предмет, РегламентныйИнтервал, НомерИтерации",
		Параметры.ЗначениеОтбора, ТекущийРегламентныйИнтервал, ТекущийНомерИтерации));
	
	КлючЗаписи = Новый("РегистрСведенийКлючЗаписи.РегламентныеИнтервалыДокументов", Отбор);
	
	ОткрытьФорму("РегистрСведений.РегламентныеИнтервалыДокументов.ФормаЗаписи", Новый Структура("Ключ", КлючЗаписи));
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПервичныеДокументы(Команда)
	
	ТекущиеДанные = Элементы.ПервичныеДокументы.ТекущиеДанные;
	
	// Для сохранения первичных документов берем все задачи с порядком меньше текущего, получаем их файлы и выгружаем
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПередаваемыеФайлы = ФайлыПервичногоДокумента(ТекущиеДанные.ИдентификаторПечатнойФормы);
	
	ОбеспечитьУникальностьИменФайлов(ПередаваемыеФайлы);
	
	Оповещение = Новый ОписаниеОповещения("СохранитьПервичныеДокументыПослеПолученияФайла", ЭтотОбъект, Неопределено);
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайлов();
	
	ФайловаяСистемаКлиент.СохранитьФайлы(Оповещение, ПередаваемыеФайлы, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПервичныеДокументыСПодписью(Команда)
	
	ТекущиеДанные = Элементы.ПервичныеДокументы.ТекущиеДанные;
	
	// Для сохранения первичных документов берем все задачи с порядком меньше текущего, получаем их файлы и выгружаем
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПередаваемыеФайлы = ФайлыПодписиПервичногоДокумента(ТекущиеДанные.ИдентификаторПечатнойФормы);
	
	ОбеспечитьУникальностьИменФайлов(ПередаваемыеФайлы);
	
	Оповещение = Новый ОписаниеОповещения("СохранитьПервичныеДокументыПослеПолученияФайла", ЭтотОбъект, Неопределено);
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайлов();
	
	ФайловаяСистемаКлиент.СохранитьФайлы(Оповещение, ПередаваемыеФайлы, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПервичныеДокументыСПодписьюИВизуализацией(Команда)
	
	ТекущиеДанные = Элементы.ПервичныеДокументы.ТекущиеДанные;
	
