&НаКлиенте
Процедура ОткрытьВнешнийЭлектронныйДокументСКопиейФайла(Предмет, ПредставлениеДокумента, 
	ИдентификаторПредставленияДокумента, НаименованиеПредставленияДокумента, ЭлектронныйДокумент = Неопределено)

	ПараметрыФормы = Новый Структура;
	
	КопияФормуляраВнешнийЭлектронныйДокументФайла(Предмет, ПредставлениеДокумента, 
		ИдентификаторПредставленияДокумента, НаименованиеПредставленияДокумента, ПараметрыФормы);
	
	Если ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
		ПараметрыФормы.Вставить("Ключ", ЭлектронныйДокумент);
	КонецЕсли;	
	
	Если ПараметрыФормы.Свойство("ДвоичныеДанныеФайла") Тогда
		ОткрытьФормуПроизвольногоЭлектронногоДокумента(ПараметрыФормы);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура КопияФормуляраВнешнийЭлектронныйДокументФайла(УчетныйДокумент, ПредставленияФормуляра,
	ИдентификаторПредставленияДокумента, НаименованиеПредставленияДокумента, ПараметрыФормы)
	
	ИмяФайлаБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(НаименованиеПредставленияДокумента, "_");
	
	ПредставленияФормуляра.АвтоМасштаб = Истина;
	
	ПотокФайла = Новый ПотокВПамяти();
	ПредставленияФормуляра.Записать(ПотокФайла, ТипФайлаТабличногоДокумента.PDF_A_3);
	ДвоичныеДанныеФайлаPDF = ПотокФайла.ЗакрытьИПолучитьДвоичныеДанные();
	
	Если НЕ ДвоичныеДанныеФайлаPDF = Неопределено Тогда
		
		GUIDВнутреннегоЭД = ИдентификаторПредставленияДокумента;
		ШаблонИмениФайла = "%1_2_%2";
		НовоеИмяФайла = СтрШаблон(ШаблонИмениФайла, GUIDВнутреннегоЭД, ИмяФайлаБезРасширения);
		ОграничениеДлиныИмениФайла = 130;
		Если СтрДлина(НовоеИмяФайла) > ОграничениеДлиныИмениФайла Тогда
			ИмяФайлаБезРасширения = Сред(НовоеИмяФайла, 1, ОграничениеДлиныИмениФайла);
		Иначе
			ИмяФайлаБезРасширения = НовоеИмяФайла;
		КонецЕсли;
		
		ПараметрыФормы.Вставить("ДвоичныеДанныеФайла", ДвоичныеДанныеФайлаPDF);
		ПараметрыФормы.Вставить("НаименованиеФайла", ИмяФайлаБезРасширения);
		ПараметрыФормы.Вставить("Расширение", "pdf");
		ПараметрыФормы.Вставить("Уникальность", Истина);
		ПараметрыФормы.Вставить("Основание", УчетныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВнешнийЭлектронныйДокументФайла(ФормулярЭД, ПараметрыФормы) Экспорт
	РеквизитыФормуляра = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФормулярЭД, "ОсновнойФайл, Предмет, НомерДокумента, ДатаДокумента");
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ДанныеФайла = РаботаСФайлами.ДанныеФайла(РеквизитыФормуляра.ОсновнойФайл, ПараметрыДанных);
	
	ДвоичныеДанныеФайлаPDF = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
	
	Если ДвоичныеДанныеФайлаPDF = Неопределено Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не содержит файлов. Возможно, он помечен на удаление'"), ФормулярЭД);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	ИмяФайлаБезРасширения = Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4);
	
	GUIDВнутреннегоЭД = ФормулярЭД.ИдентификаторФормуляра;
	ШаблонИмениФайла = "%1_1_%2";
	НовоеИмяФайла = СтрШаблон(ШаблонИмениФайла, GUIDВнутреннегоЭД, ИмяФайлаБезРасширения);
	ОграничениеДлиныИмениФайла = 130;
	Если СтрДлина(НовоеИмяФайла) > ОграничениеДлиныИмениФайла Тогда
		ИмяФайлаБезРасширения = Сред(НовоеИмяФайла, 1, ОграничениеДлиныИмениФайла);
	Иначе
		ИмяФайлаБезРасширения = Сред(НовоеИмяФайла, 1, СтрДлина(НовоеИмяФайла) - 4);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ДвоичныеДанныеФайла", ДвоичныеДанныеФайлаPDF);
	ПараметрыФормы.Вставить("НаименованиеФайла", ИмяФайлаБезРасширения);
	ПараметрыФормы.Вставить("Расширение", "pdf");
	ПараметрыФормы.Вставить("Уникальность", Истина);
	ПараметрыФормы.Вставить("Основание", РеквизитыФормуляра.Предмет);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВнешнихЭД(Предмет)
	Если НЕ ИспользуетсяЭДОСКонтрагентамиБЭД Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "СтраницаВнешниеЭД", "Видимость", Ложь);
			
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ГруппаЭДОСКонтрагентами", "Видимость", Ложь);
			
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ГруппаЭДОСКонтрагентамиДляВизуализации", "Видимость", Ложь);
			
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ДекорацияРазделительДанных", "Видимость", Ложь);

		Возврат;
	КонецЕсли;
	
	ЭлектронныеДокументыВнешнегоЭДО = ВсеВнешниеПроизвольныеЭлектронныеДокументыВнутреннегоДокумента(Параметры.ЗначениеОтбора);
	ВнешниеЭлектронныеДокументы.Загрузить(ЭлектронныеДокументыВнешнегоЭДО);

	ТекстЗаголовкаПоУмолчанию = НСтр("ru = 'ЭДО с контрагентами'");
	
	Если ВнешниеЭлектронныеДокументы.Количество() > 0 Тогда
		ТекстЗаголовка = СтрШаблон("%1 (%2)", ТекстЗаголовкаПоУмолчанию, ВнешниеЭлектронныеДокументы.Количество());
	Иначе
		ТекстЗаголовка = ТекстЗаголовкаПоУмолчанию;
	КонецЕсли;
	
	Элементы.СтраницаВнешниеЭД.Заголовок = ТекстЗаголовка;
	
	УстановитьВидимостьЭлементовВнешнегоЭДО(Параметры.ЗначениеОтбора);
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовВнешнегоЭДО(Предмет)
	ЕстьЭДОСКонтрагентами = Истина;
	Если ПроцессыОбработкиДокументов.ПоддерживаетсяИнтеграцияСБЭД() Тогда
		ЕстьПравоДоступаКУчетномуДокументу = ПравоДоступа("Просмотр", Метаданные.Документы[Предмет.Метаданные().Имя]);

		УстановитьПривилегированныйРежим(Истина);

		Если Пользователи.РолиДоступны("ДобавлениеИзменениеЭлектронныхДокументов",, Ложь) Тогда
			МожноСоздатьНовыйВнешнийЭД = Истина;
		Иначе
			МожноСоздатьНовыйВнешнийЭД = Ложь;
		КонецЕсли;	
	Иначе	
		ЕстьЭДОСКонтрагентами = Ложь;
		МожноСоздатьНовыйВнешнийЭД = Ложь;
	КонецЕсли;	

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОтправитьКакВнешнийЭДКопию", "Видимость", МожноСоздатьНовыйВнешнийЭД И ЕстьПравоДоступаКУчетномуДокументу);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОтправитьКакВнешнийЭД", "Видимость", МожноСоздатьНовыйВнешнийЭД И ЕстьПравоДоступаКУчетномуДокументу);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтраницаВнешниеЭД", "Видимость", ВнешниеЭлектронныеДокументы.Количество() > 0);
КонецПроцедуры

&НаСервере

&НаСервере
Функция ВсеВнешниеПроизвольныеЭлектронныеДокументыВнутреннегоДокумента(УчетныйДокумент) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЭлектронныйДокумент");
	Результат.Колонки.Добавить("ТипФайлаФормуляра");
	Результат.Колонки.Добавить("СостояниеЭДО");
	
	ПроизвольныеЭД = Новый ТаблицаЗначений;
	ПроцессыОбработкиДокументов.ЗаполнитьВсеВнешниеПроизвольныеЭлектронныеДокументыУчетногоДокумента(УчетныйДокумент, ПроизвольныеЭД);

	Для Каждого ТекСтрока Из ПроизвольныеЭД Цикл
		ИмяФайла = Строка(ТекСтрока.ФайлЭД);
		СтрокаТипаДокумента = Сред(ИмяФайла, 38, 1);
		ПередачаОригинала = Ложь;
		Если СтрокаТипаДокумента = "1" Тогда
			ПередачаОригинала = Истина;
		КонецЕсли;
			
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.ТипФайлаФормуляра = ?(ПередачаОригинала, 1, 2);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ВнешнийЭлектронныйДокументФормуляра(ИдентификаторФормуляра, ПараметрыФормы)
	ФормулярЭД = ПроцессыОбработкиДокументов.ФормулярПоИдентификаторуИКодуВидаСведений(ИдентификаторФормуляра, 2);
	
	ВнешнийЭлектронныйДокументФайла(ФормулярЭД, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВнешнийЭлектронныйДокументФайла(ИдентификаторФормуляра, ЭлектронныйДокумент = Неопределено)
	ПараметрыФормы = Новый Структура;
	
	ВнешнийЭлектронныйДокументФормуляра(ИдентификаторФормуляра, ПараметрыФормы);
	
	Если ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
		ПараметрыФормы.Вставить("Ключ", ЭлектронныйДокумент);
	КонецЕсли;	
	
	Если ПараметрыФормы.Свойство("ДвоичныеДанныеФайла") Тогда
		ОткрытьФормуПроизвольногоЭлектронногоДокумента(ПараметрыФормы);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПроизвольногоЭлектронногоДокумента(ПараметрыФормы) Экспорт
	Если ИспользуетсяЭДОСКонтрагентамиБЭД Тогда
		ПроцессыОбработкиДокументовКлиент.ОткрытьФормуВнешнегоЭлектронногоДокумента(ПараметрыФормы);
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьФормуВладельца()

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтаФорма, "ВладелецФормы")
		И Не ЭтаФорма.ВладелецФормы = Неопределено Тогда
		Попытка
			ЭтаФорма.ВладелецФормы.Прочитать();
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось обновить форму документа'"));    
		КонецПопытки
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти
