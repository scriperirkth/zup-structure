
&НаКлиенте
Процедура ВыборСтрокиДинамическогоСписка(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не Элемент.ТекущиеДанные = Неопределено Тогда
		
		СтандартнаяОбработка = Ложь;
		ОткрытьЗначениеАсинх(Элемент.ТекущиеДанные.Регистратор);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСведенийПриИзменении(Элемент)
	
	УстановитьПараметрыДинамическихСписков();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаСведений = ТекущаяДатаСеанса();
	
	Заголовок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.УчастникПроцессаНаставничества, "Наименование");
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЯвляетсяНаставляемым,
		"УчастникПроцессаНаставничества", Параметры.УчастникПроцессаНаставничества);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЯвляетсяНаставником,
		"УчастникПроцессаНаставничества", Параметры.УчастникПроцессаНаставничества);
	
	УстановитьПараметрыДинамическихСписков();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДинамическихСписков()
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЯвляетсяНаставляемым,
		"ДатаСведений", ДатаСведений);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЯвляетсяНаставником,
		"ДатаСведений", ДатаСведений);
	
КонецПроцедуры


&НаКлиенте
Процедура НазначитьНаставника(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Наставляемый", Параметры.УчастникПроцессаНаставничества);
	ПараметрыФормы.Вставить("ДатаНачала", ДатаСведений);
	
	НаставничествоКлиент.ОткрытьФормуНазначениеНаставника(ЭтотОбъект, ПараметрыФормы);
	
КонецПроцедуры


&НаКлиенте
Процедура НазначитьНаставником(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Наставник", Параметры.УчастникПроцессаНаставничества);
	ПараметрыФормы.Вставить("ДатаНачала", ДатаСведений);
	
	Если ТипЗнч(Параметры.УчастникПроцессаНаставничества) = Тип("СправочникСсылка.Сотрудники") Тогда
		ПараметрыФормы.Вставить("НазначитьДоплату", Истина);
	КонецЕсли;
	
	НаставничествоКлиент.ОткрытьФормуНазначениеНаставника(ЭтотОбъект, ПараметрыФормы);
	
КонецПроцедуры


&НаКлиенте
Процедура ПрекратитьНаставничество(Команда)
	
	ТекущиеДанные = ЭтотОбъект.Элементы.ЯвляетсяНаставником.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Наставник", Параметры.УчастникПроцессаНаставничества);
	ПараметрыФормы.Вставить("Наставляемый", ТекущиеДанные.Наставляемый);
	ПараметрыФормы.Вставить("ДатаОкончания", ТекущиеДанные.ДатаОкончания);
	ПараметрыФормы.Вставить("ДокументОснование", ТекущиеДанные.Регистратор);
	ПараметрыФормы.Вставить("ОтменитьДоплату", ТекущиеДанные.НазначенаДоплата);
	
	НаставничествоКлиент.ОткрытьФормуПрекращенияНаставничества(ЭтотОбъект, ПараметрыФормы);
	
КонецПроцедуры


&НаКлиенте
Процедура ИсторияНаставничества(Команда)
	
	НастройкиОтчета = НастройкиОтчетаИсторияНаставничества();

	ВариантыОтчетовКлиент.ОткрытьФормуОтчета(ЭтотОбъект, НастройкиОтчета.ВариантОтчета, НастройкиОтчета.ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Функция НастройкиОтчетаИсторияНаставничества() Экспорт
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчеты.ОтчетыПоНаставничеству.ПолучитьМакет("ИсторияНаставничества")));
	
	ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("УчастникПроцессаНаставничества", Параметры.УчастникПроцессаНаставничества);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПериодОтчета", ДатаСведений);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);

	ВариантОтчета = ВариантыОтчетов.ВариантОтчета(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Отчеты.ОтчетыПоНаставничеству), "ИсторияНаставничества");
	
	НастройкиОтчета = Новый Структура;
	НастройкиОтчета.Вставить("ВариантОтчета", ВариантОтчета);
	НастройкиОтчета.Вставить("ПараметрыФормы", ПараметрыФормы);
	
	Возврат НастройкиОтчета;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьНаставничество(Команда)
	
	ТекущиеДанные = ЭтотОбъект.Элементы.ЯвляетсяНаставляемым.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Наставник", ТекущиеДанные.Наставник);
	ПараметрыФормы.Вставить("Наставляемый", Параметры.УчастникПроцессаНаставничества);
	ПараметрыФормы.Вставить("ДатаОкончания", ТекущиеДанные.ДатаОкончания);
	ПараметрыФормы.Вставить("ДокументОснование", ТекущиеДанные.Регистратор);
	ПараметрыФормы.Вставить("ОтменитьДоплату", ТекущиеДанные.НазначенаДоплата);
	
	НаставничествоКлиент.ОткрытьФормуПрекращенияНаставничества(ЭтотОбъект, ПараметрыФормы);
	
КонецПроцедуры


