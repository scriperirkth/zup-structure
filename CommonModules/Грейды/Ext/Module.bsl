#Область ПереносДанныхИзПрежнихПрограмм

Процедура ГрейдыПозицийПослеЗагрузки(Объект, ОбъектНайден, ПараметрыОбъекта, Отказ) Экспорт
	
	Если Не ОбъектНайден Или ПараметрыОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ПараметрыПостроения = УправлениеШтатнымРасписанием.ПараметрыПостроенияВТШтатноеРасписание();
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПостроения.Отборы, "Должность", "=",
		ПараметрыОбъекта["Должность"]);
		
	УправлениеШтатнымРасписанием.СоздатьВТШтатноеРасписание(МенеджерВТ, Истина, ПараметрыПостроения,
		"ПозицияШтатногоРасписания");
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ШтатноеРасписание.ПозицияШтатногоРасписания КАК Позиция
		|ИЗ
		|	ВТШтатноеРасписание КАК ШтатноеРасписание";
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			НаборЗаписей = РегистрыСведений.ГрейдыПозиций.СоздатьНаборЗаписей();
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Позиция = Выборка.Позиция;
			НоваяЗапись.Грейд = Объект.Ссылка;
			НаборЗаписей.Отбор.Позиция.Установить(Выборка.Позиция);
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура СхемыМотивацииПоГрейдамПослеЗагрузки(Объект, ОбъектНайден, ПараметрыОбъекта, Отказ) Экспорт
	
	Если Не ОбъектНайден Или ПараметрыОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Начисления и показатели
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачислениеПоказателя", ПараметрыОбъекта["Начисление"]);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НачисленияПоказатели.Ссылка КАК НачислениеПоказатель,
	|	НачисленияПоказатели.Показатель КАК Показатель
	|ИЗ
	|	ПланВидовРасчета.Начисления.Показатели КАК НачисленияПоказатели
	|ГДЕ
	|	НачисленияПоказатели.ЗапрашиватьПриВводе
	|	И НачисленияПоказатели.Ссылка = &НачислениеПоказателя
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоказателиРасчетаЗарплаты.Ссылка,
	|	ПоказателиРасчетаЗарплаты.Ссылка
	|ИЗ
	|	Справочник.ПоказателиРасчетаЗарплаты КАК ПоказателиРасчетаЗарплаты
	|ГДЕ
	|	ПоказателиРасчетаЗарплаты.Ссылка = &НачислениеПоказателя";
	
	ТаблицаНачисленийПоказателей = Запрос.Выполнить().Выгрузить();
	
	// Использование начислений и показателей.
	НаборЗаписей = РегистрыСведений.ИспользованиеНачисленийПоказателейГрейдов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Грейд.Установить(Объект.Ссылка);
	
	ИспользуемыеНачисленияПоказатели = Новый Соответствие;
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Грейд = Объект.Ссылка;
	НоваяЗапись.НачислениеПоказатель = ПараметрыОбъекта["Начисление"];
	НоваяЗапись.ИспользованиеРазрешено = Истина;
	НоваяЗапись.РазмерМин = 0;
	НоваяЗапись.РазмерМакс = 0;
	
	ИспользуемыеНачисленияПоказатели.Вставить(ПараметрыОбъекта["Начисление"], Истина);
	НаборЗаписей.Записать();
	
	// Значения показателей
	НаборЗаписей = РегистрыСведений.ЗначенияПоказателейРасчетаЗарплатыГрейдов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Грейд.Установить(Объект.Ссылка);
	
	УникальныеПоказатели = Новый Соответствие;
	Для Каждого СтрокаНачисленийПоказателей Из ТаблицаНачисленийПоказателей Цикл 
		Если УникальныеПоказатели[СтрокаНачисленийПоказателей.Показатель] = Неопределено 
			И ИспользуемыеНачисленияПоказатели[СтрокаНачисленийПоказателей.НачислениеПоказатель] <> Неопределено Тогда 
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Грейд = Объект.Ссылка;
			НоваяЗапись.Показатель = СтрокаНачисленийПоказателей.Показатель;
			НоваяЗапись.ЗначениеМин = ПараметрыОбъекта["ЗначениеМин"];
			НоваяЗапись.ЗначениеМакс = ПараметрыОбъекта["ЗначениеМакс"];
			
			УникальныеПоказатели.Вставить(СтрокаНачисленийПоказателей.Показатель, Истина);
			
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти
