#Область СлужебныеПроцедурыИФункции

Процедура НачатьУстановкуСостояния(Вакансии, ДатаСостояния, Состояние, ОбработчикУстановкиСостояния) Экспорт
	
	ОтменяемыеСостояния = СостоянияВакансийВызовСервера.ОтменяемыеСостоянияВакансий(Вакансии, Состояние);
	
	Если ОтменяемыеСостояния.Количество() = 0 Тогда
		ВыполнитьОбработкуОповещения(ОбработчикУстановкиСостояния);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Вакансии", Вакансии);
	ДополнительныеПараметры.Вставить("ДатаСостояния", ДатаСостояния);
	ДополнительныеПараметры.Вставить("ОбработчикУстановкиСостояния", ОбработчикУстановкиСостояния);
	
	КнопкиОтвета = Новый СписокЗначений();
	КнопкиОтвета.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
	КнопкиОтвета.Добавить(КодВозвратаДиалога.Отмена);
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Удаление состояний'");
	ПараметрыВопроса.КнопкаПоУмолчанию = КодВозвратаДиалога.Да;
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗавершитьУстановкуСостояния", ЭтотОбъект, ДополнительныеПараметры), 
		ТекстВопроса(ОтменяемыеСостояния, Вакансии), 
		КнопкиОтвета, 
		ПараметрыВопроса);
	
КонецПроцедуры

Процедура ЗавершитьУстановкуСостояния(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = Неопределено Или Ответ.Значение <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработчикУстановкиСостояния);
	
КонецПроцедуры

Функция ТекстВопроса(ОтменяемыеСостояния, Вакансии)
	
	Если Вакансии.Количество() = 1 Тогда
		// Единственная вакансия.
		Возврат СтрШаблон(
			НСтр("ru = 'Ранее установленное состояние «%1» на дату %2 будет удалено из истории работы с вакансией'"), 
			ОтменяемыеСостояния[Вакансии[0]].Состояние, Формат(ОтменяемыеСостояния[Вакансии[0]].Период, "ДЛФ=D;"));
	КонецЕсли;
	
	Если ОтменяемыеСостояния.Количество() = 1 Тогда
		// Одна вакансия из нескольких.
		Вакансия = Неопределено;
		Для Каждого КлючИЗначение Из ОтменяемыеСостояния Цикл
			Вакансия = КлючИЗначение.Ключ;
			Прервать;
		КонецЦикла;
		Возврат СтрШаблон(
			НСтр("ru = 'Ранее установленное состояние «%2» на дату %3 вакансии %1 будет удалено из истории работы с вакансией'"), 
			Вакансия, ОтменяемыеСостояния[Вакансия].Состояние, Формат(ОтменяемыеСостояния[Вакансия].Период, "ДЛФ=D;")); 
	КонецЕсли;

	Период = Неопределено;
	Состояния = Новый Массив();
	Количество = 0;
	
	Для Каждого КлючИЗначение Из ОтменяемыеСостояния Цикл
		Вакансия = КлючИЗначение.Ключ;
		Если Количество > 20 Тогда
			// Ограничиваем обработку на клиенте.
			Прервать;
		КонецЕсли;
		Состояния.Добавить(КлючИЗначение.Значение.Состояние);
		Период = КлючИЗначение.Значение.Период;
		Количество = Количество + 1;
	КонецЦикла;

	// Несколько вакансий, с возможно разными состояниями.
	Возврат СтрШаблон(
		НСтр("ru = 'По нескольким вакансиям будут удалены ранее установленные состояния %1 на дату %2 из истории работы с вакансией'"), 
		СтрСоединить(ОбщегоНазначенияКлиентСервер.СвернутьМассив(Состояния), ", "),
		Формат(Период, "ДЛФ=D;")); 
	
КонецФункции

#КонецОбласти
