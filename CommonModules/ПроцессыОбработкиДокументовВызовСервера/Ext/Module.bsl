Процедура ОтменитьПроведениеДокумента(Знач ЗадачаОбъект, Знач ЗадачиСОтказом)
	
	Если Константы.ОтменятьПроведениеДокументаПриОтменеВыполненияЭтапа.Получить()
		И ЗадачаОбъект.Предшественники.Количество() > 0 Тогда
		
		ПредыдущаяЗадача = ЗадачаОбъект.Предшественники[0].ЗадачаПредшественник; 
		ПредыдущаяЗадачаДанные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПредыдущаяЗадача,
																			"Предмет, Шаблон, ИдентификаторЭтапа, Этап");
		
		УстановленСтатусПредыдущейЗадачи = ПроцессыОбработкиДокументов.УстановленныйСтатус(ПредыдущаяЗадачаДанные.Предмет, 	
																							ПредыдущаяЗадача);
		
		ПризнакПроведенностиПредыдущегоЭтапа = ПроцессыОбработкиДокументовПовтИсп.ПризнакПроведенности(
																				ПредыдущаяЗадачаДанные.Шаблон,
																				Строка(ПредыдущаяЗадачаДанные.ИдентификаторЭтапа),
																				УстановленСтатусПредыдущейЗадачи);
		
		Если ПризнакПроведенностиПредыдущегоЭтапа = Ложь
			И ОбщегоНазначения.ПроверитьПроведенностьДокументов(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗадачаОбъект.Предмет)).Количество() = 0 
			И ЗадачиСОтказом.Найти(ЗадачаОбъект.Наименование) = Неопределено Тогда
			
			ПризнакЗапретаПроведенияТекущегоЭтапа = ПроцессыОбработкиДокументов.ПризнакЗапретаПроведенияЭтапа(
													ЗадачаОбъект.Шаблон,
													Строка(ЗадачаОбъект.ИдентификаторЭтапа));
													
			Если ПризнакЗапретаПроведенияТекущегоЭтапа Тогда 
					
					ПредставлениеРеквизитовЗадачи = Новый Массив();
					ПредставлениеРеквизитовЗадачи.Добавить(ЗадачаОбъект.Предмет);
					ПредставлениеРеквизитовЗадачи.Добавить(ЗадачаОбъект.Шаблон);
					ПредставлениеРеквизитовЗадачи.Добавить(ЗадачаОбъект.Этап);

					ПредставлениеРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ПредставлениеРеквизитовЗадачи, "Представление");
					ПредставлениеШаблона   = ПредставлениеРеквизитов.Получить(ЗадачаОбъект.Шаблон).Представление;
					ПредставлениеЭтапа     = ПредставлениеРеквизитов.Получить(ЗадачаОбъект.Этап).Представление;
					ПредставлениеДокумента = ПредставлениеРеквизитов.Получить(ЗадачаОбъект.Предмет).Представление;
					
					ОписаниеОшибки = НСтр(СтрШаблон("ru = 'для шаблона процесса ""%1"" на этапе ""%2"" установлен запрет на отмену проведения документа'",
									 ПредставлениеШаблона, ПредставлениеЭтапа));
					
					ВызватьИсключение НСтр(СтрШаблон("ru = 'Не удалось отменить проведение документа %1 по причине %2: '", 
									  ПредставлениеДокумента, 
									  ОписаниеОшибки));
			КонецЕсли;										
			
			Если Пользователи.РолиДоступны("ОтменаВыполненияЗадачПоОбработкеДокументов", Пользователи.ТекущийПользователь()) Тогда
				ДополнительныеСвойства = Новый Структура("ПроцессыОбработкиДокументов_ЗаписатьБезПроверки", Истина);
			Иначе	
				ДополнительныеСвойства = Новый Структура("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиЗапущенногоПроцессаВыполнения", Истина); 
			КонецЕсли;
			
			ДокументыДляОтменыПроведения = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗадачаОбъект.Предмет);
			
			СписокНепроведенныхДокументов = ОтменитьПроведениеДокументов(ДокументыДляОтменыПроведения, ДополнительныеСвойства);
			
			Если СписокНепроведенныхДокументов.Количество() = 1 Тогда 
				
				ОписаниеОшибки = СписокНепроведенныхДокументов[0].ОписаниеОшибки;
				ВызватьИсключение НСтр(СтрШаблон("ru = 'Не удалось отменить проведение документа %1 по причине %2'", 
								  ПредставлениеДокумента, 
								  ОписаниеОшибки));
			КонецЕсли;	
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

Функция МногопоточнаПроверкаПодписанныхДанныхНаСервере(УникальныйИдентификатор, ДанныеДокументов) Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Выполнение многопоточной проверки подписанных данных'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ПрерватьВыполнениеЕслиОшибка = Истина;

	
	ПараметрыМетода = Новый Соответствие(); 
	
	ПотокиДокументов = Новый Соответствие(); 
	ИндексПотока = 0;
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
	     Результат = ПроцессыОбработкиДокументов.ЭлектронныеПодписиПредыдущихЭтапов(ДанныеДокумента.Документ, 
		             ДанныеДокумента.Шаблон, ДанныеДокумента.ИдентификаторЭтапа);
		 КоличествоЭлектронныхПодписейПредыдущихЭтапов = ?(Результат.Свойство("ПодписиДляПроверкиДанных"), 
		 												   Результат.ПодписиДляПроверкиДанных.Количество(), 
														   0);

         ИндексПодписи = 0;
		 Пока ИндексПодписи < КоличествоЭлектронныхПодписейПредыдущихЭтапов Цикл 
			 
			 КодПотока = "Поток" + Строка(ИндексПотока);
			 ПараметрыПотока 						= ПроцессыОбработкиДокументов.ПараметрыМногопоточнойФункции();
			 ПараметрыПотока.Документ       		= ДанныеДокумента.Документ;
			 ПараметрыПотока.Шаблон       			= ДанныеДокумента.Шаблон; 
			 ПараметрыПотока.ИдентификаторЭтапа		= ДанныеДокумента.ИдентификаторЭтапа;
			 ПараметрыПотока.ИндексПотока        	= ИндексПодписи; 
			 
			 ПараметрыВызоваСервера = Новый Массив;
			 ПараметрыВызоваСервера.Добавить(КодПотока); 		 
			 ПараметрыВызоваСервера.Добавить(ПараметрыПотока);    // Параметры функции в потоке
			 
			 ПараметрыМетода.Вставить(КодПотока,ПараметрыВызоваСервера); 
			 ИндексПодписи = ИндексПодписи + 1;
			 ИндексПотока = ИндексПотока + 1;
         КонецЦикла;
	КонецЦикла;
	
	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков("ФоновыеЗаданияПроцессыОбработкиДокументов.ВыполнитьПроверкуПодписанныхДанныхМногопоточно",
						ПараметрыВыполнения, ПараметрыМетода);
		
	Возврат ФоновоеЗадание;	
	
КонецФункции 

Функция СуществуютЭлектронныеПодписииПредыдущихЭтапов(ДанныеДокументов) Экспорт
	ВозможностьИспользоватьМногопотончнуюПроверку = Истина;
	
	 Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
	     Результат = ПроцессыОбработкиДокументов.ЭлектронныеПодписиПредыдущихЭтапов(ДанныеДокумента.Документ, 
		             ДанныеДокумента.Шаблон, ДанныеДокумента.ИдентификаторЭтапа);
		 КоличествоЭлектронныхПодписейПредыдущихЭтапов = ?(Результат.Свойство("ПодписиДляПроверкиДанных"), 
		 												   Результат.ПодписиДляПроверкиДанных.Количество(), 
														   0);
		 Если КоличествоЭлектронныхПодписейПредыдущихЭтапов < 1 Тогда
			 // многопоточная проверка возможна только если для каждого документа 
			 // есть хотя бы одна подпись на предыдущем этапе	
			 ВозможностьИспользоватьМногопотончнуюПроверку = Ложь;
		 КонецЕсли;	  
		 
	КонецЦикла;	 

	Возврат ВозможностьИспользоватьМногопотончнуюПроверку;
	
КонецФункции

#КонецОбласти
