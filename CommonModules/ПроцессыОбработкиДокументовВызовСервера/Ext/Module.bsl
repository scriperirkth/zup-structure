Функция ТабличныйДокументПоДвоичнымДанным(Знач ДвоичныеДанные) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	Если ТипЗнч(ДвоичныеДанные) = Тип("Строка") Тогда
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДвоичныеДанные);
	КонецЕсли;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат ТабДок;
	КонецЕсли;
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	
	Возврат МодульУправлениеПечатью.ТабличныйДокументПоДвоичнымДанным(ДвоичныеДанные);
	
КонецФункции

Процедура ПроверитьСовпадениеФайловПервичныхДокументовСРанееПодписанными(ПервичныеДокументы, УникальныйИдентификатор) Экспорт
	
	Для Каждого ПервичныйДокумент Из ПервичныеДокументы Цикл
		
		ПервичныйДокумент.Вставить("Файл");
		ПервичныйДокумент.Вставить("ФайлPDF");
		
		ПакетЗапросов = ПроцессыОбработкиДокументов.ПакетЗапросовПоИмеющимсяПервичнымДокументам(ПервичныйДокумент.Предмет,
			ПервичныйДокумент.ИдентификаторПечатнойФормы, ПервичныйДокумент.Шаблон, ПервичныйДокумент.ИдентификаторЭтапа);
		
		ВыборкаMXL = ПакетЗапросов[0].Выбрать();
		ВыборкаPDF = ПакетЗапросов[1].Выбрать();
		
		Если НЕ ВыборкаMXL.Следующий() Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = ПолучитьИзВременногоХранилища(ПервичныйДокумент.Данные);
		
		Если РаботаСФайлами.ДвоичныеДанныеФайла(ВыборкаMXL.ПервичныйДокумент) = Данные Тогда
			ПервичныйДокумент.Вставить("Файл", ВыборкаMXL.ПервичныйДокумент);
			// Если mxl-файлы совпадают, то считаем, что pdf-файлы тоже
			ВыборкаPDF.Следующий();
			ПервичныйДокумент.Вставить("ФайлPDF", ВыборкаPDF.ПервичныйДокумент);
			ПервичныйДокумент.Вставить("ДанныеPDF", ПоместитьВоВременноеХранилище(
				РаботаСФайлами.ДвоичныеДанныеФайла(ВыборкаPDF.ПервичныйДокумент), УникальныйИдентификатор));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

