//
Процедура СохранитьНастройкиПользователяПанели(КлючНастроек, Настройки) Экспорт
	
	КлючаОбъекта = "БИП_ФормаПомощь";
	ХранилищеСистемныхНастроек.Сохранить(КлючаОбъекта, КлючНастроек, Настройки);
	
КонецПроцедуры

