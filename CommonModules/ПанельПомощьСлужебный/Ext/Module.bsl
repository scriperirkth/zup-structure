#Область ТехническаяИнформация

// Формирует параметры системы, которые могут понадобиться пользователю при обращении в тех. поддержку.
// 
// Параметры:
//  Параметры - см. ПараметрыДанныхДляТехПоддержки.
//            - Неопределено - использовать параметры по умолчанию.
// 
// Возвращаемое значение:
//  см. ИнтернетПоддержкаПользователейКлиентСервер.ОписаниеТехническойИнформации.
// 
Функция ДанныеДляТехПоддержки(Параметры = Неопределено) Экспорт
	
	Эталон = ПараметрыДанныхДляТехПоддержки();
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Эталон, Параметры);
	КонецЕсли;
	
	Результат = ИнтернетПоддержкаПользователейКлиентСервер.ОписаниеТехническойИнформации();
	
	Если Эталон.ОписаниеПрограммы Тогда
		Результат.Вставить(
			"ОписаниеПрограммы",
			ИнтернетПоддержкаПользователей.ОписаниеПрограммы());
	КонецЕсли;
	Если Эталон.ТекущаяСессия Тогда
		Результат.Вставить(
			"ТекущаяСессия",
			ИнтернетПоддержкаПользователей.ОписаниеТекущейСессии());
	КонецЕсли;
	Если Эталон.НастройкиИнтернетПоддержки Тогда
		НастройкиТехническойИнформации = ИнтернетПоддержкаПользователейКлиентСервер.НастройкиТехническойИнформации();
		Если Эталон.НастройкиТехническойИнформации <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НастройкиТехническойИнформации, Эталон.НастройкиТехническойИнформации);
		КонецЕсли;
		Результат.Вставить(
			"НастройкиИнтернетПоддержки",
			ИнтернетПоддержкаПользователей.НастройкиИнтернетПоддержки(
				НастройкиТехническойИнформации));
	КонецЕсли;
	Если Эталон.ИнтернетНастройки Тогда
		Результат.Вставить(
			"ИнтернетНастройки",
			ИнтернетПоддержкаПользователей.ИнтернетНастройки());
	КонецЕсли;
	Если Эталон.ДанныеРасширений Тогда
		Результат.Вставить("ДанныеРасширений", ДанныеРасширений());
	КонецЕсли;
	
	Если Эталон.СистемнаяИнформацияСервера Или Эталон.СистемнаяИнформацияКлиента Тогда
		Если Эталон.ДанныеСистемнойИнформации = Неопределено Тогда
			Эталон.ДанныеСистемнойИнформации = ТехническаяИнформацияСистемнаяИнформация();
		КонецЕсли;
		
		Если Эталон.СистемнаяИнформацияСервера Тогда
			Результат.Вставить(
				"СистемнаяИнформацияСервера",
				Эталон.ДанныеСистемнойИнформации.СистемнаяИнформацияСервера);
		КонецЕсли;
		Если Эталон.СистемнаяИнформацияКлиента Тогда
			Результат.Вставить(
				"СистемнаяИнформацияКлиента",
				Эталон.ДанныеСистемнойИнформации.СистемнаяИнформацияСервера);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конструктор параметров метода ДанныеДляТехПоддержки.
// 
// Возвращаемое значение:
//  Структура - параметры получения данных о системе:
//   * ДанныеСистемнойИнформации - см. ТехническаяИнформацияСистемнаяИнформация.
//                               - Неопределено - данные системной информации должны быть получены внутри
//                                 метода ДанныеДляТехПоддержки.
//   * НастройкиТехническойИнформации - см. ИнтернетПоддержкаПользователейКлиентСервер.НастройкиТехническойИнформации.
//                                    - Неопределено - использовать значения по умолчанию.
//   * ОписаниеПрограммы - Булево - получать описание программы.
//   * ТекущаяСессия - Булево - получать описание текущей сессии.
//   * НастройкиИнтернетПоддержки - Булево - получать настройки интернет-поддержки.
//   * ИнтернетНастройки - Булево - получать интернет-настройки.
//   * СистемнаяИнформацияСервера - Булево - получать системную информацию сервера.
//   * СистемнаяИнформацияКлиента - Булево - получать системную информацию клиента.
//   * ДанныеРасширений - Булево - получать данные расширений.
// 
Функция ПараметрыДанныхДляТехПоддержки() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДанныеСистемнойИнформации", Неопределено);
	Результат.Вставить("НастройкиТехническойИнформации", Неопределено);
	Результат.Вставить("ОписаниеПрограммы", Истина);
	Результат.Вставить("ТекущаяСессия", Истина);
	Результат.Вставить("НастройкиИнтернетПоддержки", Истина);
	Результат.Вставить("ИнтернетНастройки", Истина);
	Результат.Вставить("СистемнаяИнформацияСервера", Истина);
	Результат.Вставить("СистемнаяИнформацияКлиента", Истина);
	Результат.Вставить("ДанныеРасширений", Истина);
	
	Возврат Результат;
	
КонецФункции

// Получает системную информацию клиента и сервера.
// 
// Возвращаемое значение:
//  Структура - системная информация:
//   * СистемнаяИнформацияСервера - см. ИнтернетПоддержкаПользователейКлиентСервер.ОписаниеСистемнойИнформации.
//   * СистемнаяИнформацияКлиента - см. ИнтернетПоддержкаПользователейКлиентСервер.ОписаниеСистемнойИнформации.
// 
Функция ТехническаяИнформацияСистемнаяИнформация() Экспорт
	
	СистИнфоКлиент = ОбщегоНазначения.СистемнаяИнформацияКлиента();
	
	СистемнаяИнформацияКлиента =
		ИнтернетПоддержкаПользователейКлиентСервер.ОписаниеСистемнойИнформации();
	СистемнаяИнформацияСервера =
		ИнтернетПоддержкаПользователейКлиентСервер.ОписаниеСистемнойИнформации();
	
	ЗаполнитьЗначенияСвойств(
		СистемнаяИнформацияСервера,
		Новый СистемнаяИнформация());
	
	Если СистИнфоКлиент <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(
			СистемнаяИнформацияКлиента,
			СистИнфоКлиент);
		СистемнаяИнформацияКлиента.ТипПлатформы =
			ОбщегоНазначенияКлиентСервер.ИмяТипаПлатформы(
				СистемнаяИнформацияКлиента.ТипПлатформы);
	КонецЕсли;
	
	Для Каждого КлючЗначение Из СистемнаяИнформацияСервера Цикл
		Если СистемнаяИнформацияСервера[КлючЗначение.Ключ] <> Неопределено Тогда
			СистемнаяИнформацияСервера[КлючЗначение.Ключ] = Строка(
				СистемнаяИнформацияСервера[КлючЗначение.Ключ]);
		КонецЕсли;
		Если СистемнаяИнформацияКлиента[КлючЗначение.Ключ] <> Неопределено Тогда
			СистемнаяИнформацияКлиента[КлючЗначение.Ключ] = Строка(
				СистемнаяИнформацияКлиента[КлючЗначение.Ключ]);
		КонецЕсли;
	КонецЦикла;
	
	СистемнаяИнформацияСервера.ТипПлатформы =
		ОбщегоНазначенияКлиентСервер.ИмяТипаПлатформы(
			СистемнаяИнформацияСервера.ТипПлатформы);
	
	Результат = Новый Структура(
		"СистемнаяИнформацияСервера, СистемнаяИнформацияКлиента",
		СистемнаяИнформацияСервера,
		СистемнаяИнформацияКлиента);

	Возврат Результат;

КонецФункции

// Получает данные расширений.
// 
// Возвращаемое значение:
//  Структура - данные расширений конфигурации:
//   * АвтоматическаяУстановкаПатчей - Булево - признак включения автоматической установки патчей.
//             - Неопределено - если в конфигурации отсутствует подсистема ПолучениеОбновленийПрограммы.
//   * Расширения - Массив Из см. НовыйРасширениеКонфигурации - описание всех расширений.
// 
Функция ДанныеРасширений()
	
	Результат = Новый Структура;
	
	Результат.Вставить("АвтоматическаяУстановкаПатчей", Неопределено);
	Результат.Вставить("Расширения", Новый Массив);
	
	УстановитьПривилегированныйРежим(Истина);
	Расширения = РасширенияКонфигурации.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	
	НазначениеИсправление = Метаданные.СвойстваОбъектов.НазначениеРасширенияКонфигурации.Исправление;
	ПреобразоватьВСтроку = СтрРазделить("ГлавныйУзел,Назначение,ОбластьДействия,УникальныйИдентификатор,ХешСумма", ",");
	Для Каждого Расширение Из Расширения Цикл
		НовыйЭлемент = НовыйРасширениеКонфигурации();
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, Расширение);
		
		Для Каждого ИмяПоля Из ПреобразоватьВСтроку Цикл
			НовыйЭлемент[ИмяПоля] = Строка(НовыйЭлемент[ИмяПоля]);
		КонецЦикла;
		
		Если НовыйЭлемент.ЗащитаОтОпасныхДействий <> Неопределено Тогда
			НовоеЗначение = НовыйЭлемент.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
			НовыйЭлемент.ЗащитаОтОпасныхДействий = Новый Структура(
				"ПредупреждатьОбОпасныхДействиях",
				НовоеЗначение);
		КонецЕсли;
			
		Если НовыйЭлемент.ОсновныеРоли <> Неопределено Тогда
			ОсновныеРоли = Новый Массив;
			Для Каждого ОсновнаяРоль Из НовыйЭлемент.ОсновныеРоли Цикл
				ОсновныеРоли.Добавить(Строка(ОсновнаяРоль));
			КонецЦикла;
			НовыйЭлемент.ОсновныеРоли = ОсновныеРоли;
		КонецЕсли;
		
		НовыйЭлемент.ЭтоИсправление = (Расширение.Назначение = НазначениеИсправление)
			И СтрНачинаетсяС(Расширение.Имя, "EF");
		
		Результат.Расширения.Добавить(НовыйЭлемент);
		
	КонецЦикла;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ПолучениеОбновленийПрограммы") Тогда
		МодульПолучениеОбновленийПрограммы = ОбщегоНазначения.ОбщийМодуль("ПолучениеОбновленийПрограммы");
		Результат.АвтоматическаяУстановкаПатчей = МодульПолучениеОбновленийПрограммы.АвтоматическаяЗагрузкаИсправленийВключена();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает пустое описание метаданные расширения конфигурации.
//
// Возвращаемое значение:
//   Структура - описание расширения:
//     * Активно - Булево - признак, что расширение активно.
//     * БезопасныйРежим - Булево - признак использования безопасного режима.
//     * Версия - Строка - версия расширения.
//     * ГлавныйУзел - Неопределено, Строка - узел распределенной информационной базы,
//        в котором создано данное расширение конфигурации.
//     * ЗащитаОтОпасныхДействий - Неопределено, ОписаниеЗащитыОтОпасныхДействий - использование защиты от
//         опасных действий.
//     * Имя - Строка - имя расширения.
//     * ИспользоватьОсновныеРолиДляВсехПользователей - Булево - признак использования основных ролей
//        для всех пользователей.
//     * ИспользуетсяВРаспределеннойИнформационнойБазе - Булево - признак использования в распределенной ИБ.
//     * Назначение - Строка - назначение расширения.
//     * ОбластьДействия - Строка, Неопределено - область действия расширения.
//     * ОсновныеРоли - Неопределено, Массив из Строка - список основных ролей.
//     * Синоним - Строка - Синоним имени расширения конфигурации.
//     * УникальныйИдентификатор - Строка - уникальный идентификатор расширения
//     * ХешСумма - Строка - Хеш-сумма расширения.
//     * ЭтоИсправление - Булево - признак, что это исправление.
//
Функция НовыйРасширениеКонфигурации()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Активно", Ложь);
	Результат.Вставить("БезопасныйРежим", Ложь);
	Результат.Вставить("Версия", "");
	Результат.Вставить("ГлавныйУзел", Неопределено);
	Результат.Вставить("ЗащитаОтОпасныхДействий", Неопределено);
	Результат.Вставить("Имя", "");
	Результат.Вставить("ИспользоватьОсновныеРолиДляВсехПользователей", Ложь);
	Результат.Вставить("ИспользуетсяВРаспределеннойИнформационнойБазе", Ложь);
	Результат.Вставить("Назначение", "");
	Результат.Вставить("ОбластьДействия", Неопределено);
	Результат.Вставить("ОсновныеРоли", Неопределено);
	Результат.Вставить("Синоним", "");
	Результат.Вставить("УникальныйИдентификатор", "");
	Результат.Вставить("ХешСумма", "");
	Результат.Вставить("ЭтоИсправление", Ложь);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПрочиеСлужебныеПроцедурыИФункции

// Добавляет запись в журнал регистрации.
//
// Параметры:
//  СообщениеОбОшибке - Строка - комментарий к записи журнала регистрации.
//  Ошибка - Булево - если Истина будет установлен уровень журнала регистрации "Ошибка".
//  Данные -  Неопределено, Произвольный - Данные, с которыми связано событие.
//    Рекомендуется указывать ссылки на объекты данных (элементы справочников, документы,
//    к которым относится событие).
//
Процедура ЗаписатьИнформациюВЖурналРегистрации(
		СообщениеОбОшибке,
		Ошибка = Истина,
		Данные = Неопределено) Экспорт
	
	УровеньЖР = ?(Ошибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурналаРегистрации(),
		УровеньЖР,
		,
		Данные,
		Лев(СообщениеОбОшибке, 5120));
	
КонецПроцедуры

// Возвращает имя события для журнала регистрации.
//
// Возвращаемое значение:
//  Строка - имя события.
//
Функция ИмяСобытияЖурналаРегистрации()
	
	Возврат НСтр("ru = 'Панель Помощь'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

