#Область СлужебныеПроцедурыИФункции

Функция ИнтеграцияС1САрхивомИспользуется() Экспорт
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
		Возврат ПолучитьФункциональнуюОпцию("ИнтеграцияС1САрхивом");
	КонецЕсли;
	Возврат Ложь;
КонецФункции

#Область СохранениеВариантовОтчетов

Функция ПоместитьТабличныйДокументВоВременноеХранилище(ПечатнаяФорма, ПараметрыЗаписи, ПереданныеНастройки) Экспорт
	
	ИнтеграцияС1САрхивом.ЗаполнитьПараметрыИзКомпоновщикаНастроек(ПараметрыЗаписи);
	
	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	ЗаполнитьЗначенияСвойств(НастройкиСохранения, ПереданныеНастройки);
	
	ВыбранныеФорматыСохранения = НастройкиСохранения.ФорматыСохранения;

	ПереводитьИменаФайловВТранслит = НастройкиСохранения.ПереводитьИменаФайловВТранслит;

	ТаблицаФорматов = УправлениеПечатью.НастройкиФорматовСохраненияТабличногоДокумента();

	ОбъектыДляПрикрепления = Неопределено;
	Если ПереданныеНастройки.Свойство("ОбъектыДляПрикрепления") Тогда
		ОбъектыДляПрикрепления = ОбщегоНазначения.СкопироватьРекурсивно(ПереданныеНастройки.ОбъектыДляПрикрепления);
	КонецЕсли;
	
	Результат = Новый Массив;
	
	ИмяВременногоКаталога = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
	СоздатьКаталог(ИмяВременногоКаталога);
	
	Если ИнтеграцияС1САрхивом.ВычислитьИспользованиеВывода(ПечатнаяФорма) = ИспользованиеВывода.Запретить Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ПечатнаяФорма.Защита Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ПечатнаяФорма.ВысотаТаблицы = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ВыбранныйФормат Из ВыбранныеФорматыСохранения Цикл
		ТипФайла = ТипФайлаТабличногоДокумента[ВыбранныйФормат];
		НастройкиФормата = ТаблицаФорматов.НайтиСтроки(Новый Структура("ТипФайлаТабличногоДокумента", ТипФайла))[0];
		
		ИмяФайла = ИнтеграцияС1САрхивом.ИмяФайлаСохраненияОтчета(ПараметрыЗаписи.Заголовок, ПараметрыЗаписи.Организация, ПараметрыЗаписи.Период);
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
		
		Если ПереводитьИменаФайловВТранслит Тогда
			ИмяФайла = СтроковыеФункции.СтрокаЛатиницей(ИмяФайла);
		КонецЕсли;
		
		РасширениеФайла = НастройкиФормата.Расширение;
		ИмяФайлаСРасширением = ИмяФайла + "." + РасширениеФайла;
		ПолноеИмяФайла = ИмяВременногоКаталога + ИмяФайлаСРасширением;
		
		МаксимальнаяДлина = 218; // https://docs.microsoft.com/en-us/office/troubleshoot/office-suite-issues/error-open-document
		Если ТипФайла = ТипФайлаТабличногоДокумента.XLS И СтрДлина(ПолноеИмяФайла) > МаксимальнаяДлина Тогда
			МаксимальнаяДлина = МаксимальнаяДлина - 5; // Резерв для формирования уникального имени.
			Если СтрДлина(ИмяВременногоКаталога) < МаксимальнаяДлина Тогда
				ИмяФайла = Лев(ИмяФайла, МаксимальнаяДлина - СтрДлина(ИмяВременногоКаталога) - СтрДлина(РасширениеФайла) - 1);
				ИмяФайлаСРасширением = ИмяФайла + "." + РасширениеФайла;
				ПолноеИмяФайла = ИмяВременногоКаталога + ИмяФайлаСРасширением;
			КонецЕсли;
		КонецЕсли;
		
		ПолноеИмяФайла = ФайловаяСистема.УникальноеИмяФайла(ПолноеИмяФайла);
		ПечатнаяФорма.Записать(ПолноеИмяФайла, ТипФайла);
		
		Если ТипФайла = ТипФайлаТабличногоДокумента.HTML Тогда
			УправлениеПечатью.ВставитьКартинкиВHTML(ПолноеИмяФайла);
		КонецЕсли;
		
		Для Каждого ОбъектДляПрикрепления Из ОбъектыДляПрикрепления Цикл
			ОбъектПечати = ОбъектДляПрикрепления.Ключ;
			ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
			ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ПараметрыЗаписи.УникальныйИдентификаторХранилища);
			ОписаниеФайла = Новый Структура;
			ОписаниеФайла.Вставить("Представление", ИмяФайлаСРасширением);
			ОписаниеФайла.Вставить("ИмяФайла", ИмяФайла);
			ОписаниеФайла.Вставить("АдресВоВременномХранилище", ПутьВоВременномХранилище);
			ОписаниеФайла.Вставить("ОбъектПечати", ОбъектПечати);
			
			Если ТипФайла = ТипФайлаТабличногоДокумента.ANSITXT Тогда
				ОписаниеФайла.Вставить("Кодировка", "windows-1251");
			КонецЕсли;
			Результат.Добавить(ОписаниеФайла);
		КонецЦикла;
		
	КонецЦикла;
	
	УдалитьФайлы(ИмяВременногоКаталога);

	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	ЗаполнитьЗначенияСвойств(НастройкиСохранения, ПереданныеНастройки);
	
	Если НастройкиСохранения.УпаковатьВАрхив Тогда
		Результат = ИнтеграцияС1САрхивом.ПоместитьФайлыВАрхив(Результат, ПараметрыЗаписи, ПереданныеНастройки, НастройкиСохранения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПрисоединитьПечатныеФормыКОбъекту(ФайлыВоВременномХранилище) Экспорт
	Результат = Новый Массив;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		Для Каждого Файл Из ФайлыВоВременномХранилище Цикл
			Если МодульРаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(Файл["ОбъектПечати"]) Тогда
				ПараметрыФайла = МодульРаботаСФайлами.ПараметрыДобавленияФайла();
				ПараметрыФайла.ВладелецФайлов = Файл["ОбъектПечати"];
				ПараметрыФайла.ИмяБезРасширения = Файл.Представление;
				Результат.Добавить(МодульРаботаСФайлами.ДобавитьФайл(
					ПараметрыФайла, Файл.АдресВоВременномХранилище, , НСтр("ru = 'Отчет'")));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьСведенияОтчетов1САрхив(Файлы, ПараметрыЗаписи) Экспорт
	Перем РегламентированныйОтчет, ИдентификаторПечатнойФормы, ИдентификаторОбъектаМетаданных, ПолноеИмяОбъектаМетаданных, Период, Организация;
	
	Для Каждого Файл Из Файлы Цикл

		Если Файл = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипЗнч(Файл)) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыЗаписи.Свойство("РегламентированныйОтчет", РегламентированныйОтчет) Тогда
			Если ТипЗнч(РегламентированныйОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
				ПараметрыЗаписи.Вставить("Организация", РегламентированныйОтчет.Организация);
				ПараметрыЗаписи.Вставить("Период", РегламентированныйОтчет.ДатаПодписи);
				ПараметрыЗаписи.Вставить("ИдентификаторПечатнойФормы", РегламентированныйОтчет.ИсточникОтчета);
				ПараметрыЗаписи.Вставить("ИдентификаторОбъектаМетаданных", ИдентификаторРегламентированногоОтчета(РегламентированныйОтчет.ИсточникОтчета));
			КонецЕсли;
		ИначеЕсли ПараметрыЗаписи.Свойство("ПолноеИмяОбъектаМетаданных", ПолноеИмяОбъектаМетаданных) Тогда
			ПараметрыЗаписи.Вставить("ИдентификаторОбъектаМетаданных",ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмяОбъектаМетаданных));
		КонецЕсли;
		
		ПараметрыЗаписи.Свойство("ИдентификаторПечатнойФормы", ИдентификаторПечатнойФормы);
		ПараметрыЗаписи.Свойство("ИдентификаторОбъектаМетаданных", ИдентификаторОбъектаМетаданных);
		ПараметрыЗаписи.Свойство("Организация", Организация);
		ПараметрыЗаписи.Свойство("Период", Период);
		
		ВидДокументаБИА = Справочники.ВидыДокументовБИА.НайтиВидДокумента(ИдентификаторПечатнойФормы, ИдентификаторОбъектаМетаданных);
		Сведения1САрхив = Новый Структура("Файл, ВидДокументаБИА, ИдентификаторПечатнойФормы", Файл, ВидДокументаБИА, ИдентификаторПечатнойФормы);
		Если ЗначениеЗаполнено(ВидДокументаБИА) Тогда
			Сведения1САрхив.Вставить("НеВыгружать", ВидДокументаБИА.НеВыгружать);
		Иначе
			Сведения1САрхив.Вставить("НеВыгружать", Истина);
		КонецЕсли;

		Если ТипЗнч(Период) = Тип("Дата") Тогда
			Сведения1САрхив.Вставить("Дата",Период);
		ИначеЕсли ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда
			Сведения1САрхив.Вставить("Дата",Период.ДатаОкончания);
		КонецЕсли;
		Сведения1САрхив.Вставить("Организация", Организация);
		Сведения1САрхив.Вставить("Номер", НСтр("ru = 'Без номера'"));
		
		ИнтеграцияС1САрхивом.ЗаписатьСведения1САрхив(Сведения1САрхив);

	КонецЦикла;
	
КонецПроцедуры

Функция ОбъектыПечати() Экспорт
	ОбъектыПечати = Новый СписокЗначений;
	ПапкаФайлов1САрхив = ИнтеграцияС1САрхивом.ПапкаФайлов1САрхив();
	Если ЗначениеЗаполнено(ПапкаФайлов1САрхив) Тогда
		ОбъектыПечати.Добавить(ПапкаФайлов1САрхив);
	КонецЕсли;
	Возврат ОбъектыПечати;
КонецФункции

Процедура ЗаписатьСведенияПечатнойФормы1САрхив(Файл, Знач НастройкиПечатныхФорм, Знач ОбъектыПечати, Знач ПараметрыФормы, Знач ПараметрОповещения) Экспорт
	
	Перем РезультатПодписанияФайлов, НомерДокумента, ДатаДокумента, СотрудникТрудовогоДоговора, ИдентификаторПечатнойФормы;
	
	Если Файл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипЗнч(Файл)) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбъектыПечати.НайтиПоЗначению(Файл.ВладелецФайла) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрОповещения) = Тип("Структура") Тогда
		ПараметрОповещения.Свойство("РезультатПодписанияФайлов", РезультатПодписанияФайлов);
	КонецЕсли;
	
	Если ПараметрыФормы.ИмяМенеджераПечати = "Справочник.Сотрудники" Тогда
		ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Справочники.Сотрудники);
	Иначе
		ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Файл.ВладелецФайла.Метаданные());
	КонецЕсли;
	
	Для Каждого НастройкаПечатнойФормы Из НастройкиПечатныхФорм Цикл
		Если НастройкаПечатнойФормы.Печатать И ЗначениеЗаполнено(ИдентификаторПечатнойФормы) Тогда
			Возврат;
		ИначеЕсли НастройкаПечатнойФормы.Печатать Тогда
			ИдентификаторПечатнойФормы = НастройкаПечатнойФормы.ИмяМакета;
		КонецЕсли;
	КонецЦикла;
	
	Сотрудник = Неопределено;
	Если ТипЗнч(Файл.ВладелецФайла) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Если ТипЗнч(ПараметрыФормы.ПараметрКоманды) = Тип("Массив") Тогда
			Для Каждого ПараметрКоманды Из ПараметрыФормы.ПараметрКоманды Цикл
				Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Сотрудники") Тогда
					Если ПараметрКоманды.ФизическоеЛицо = Файл.ВладелецФайла Тогда
						Если Сотрудник = Неопределено Тогда
							Сотрудник = ПараметрКоманды;
						Иначе
							Сотрудник = Неопределено;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(РезультатПодписанияФайлов) = Тип("Массив") Тогда
		Для Каждого РезультатПодписания Из РезультатПодписанияФайлов Цикл
			Если РезультатПодписания.ФайлОбъекта = Файл Тогда
				Сотрудник = РезультатПодписания.Сотрудник;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИдентификаторПечатнойФормы = "ПФ_MXL_ТрудовойДоговор" Или ИдентификаторПечатнойФормы = "ПФ_MXL_ТрудовойДоговорПриДистанционнойРаботе" Тогда
		
		Если Не Файл.ВладелецФайла.Метаданные().Реквизиты.Найти("Сотрудник") = Неопределено Тогда
			СотрудникТрудовогоДоговора = Файл.ВладелецФайла.Сотрудник;
		Иначе
			СотрудникТрудовогоДоговора = Сотрудник;
		КонецЕсли;
		
		ДанныеТрудовогоДоговора = Неопределено;
		Если Не СотрудникТрудовогоДоговора = Неопределено Тогда
			ДанныеТрудовогоДоговора = ИнтеграцияС1САрхивом.ДанныеТрудовогоДоговора(Файл.ВладелецФайла, СотрудникТрудовогоДоговора);
			Если ДанныеТрудовогоДоговора = Неопределено Тогда
				ДанныеТрудовогоДоговора = ИнтеграцияС1САрхивом.КадровыеДанныеСотрудника(Файл.ВладелецФайла.Дата, СотрудникТрудовогоДоговора);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ДанныеТрудовогоДоговора = Неопределено Тогда
			НомерДокумента = ДанныеТрудовогоДоговора.ТрудовойДоговорНомер;
			ДатаДокумента = ДанныеТрудовогоДоговора.ТрудовойДоговорДата;
		КонецЕсли;

	КонецЕсли;
	
	ВидДокументаБИА = Справочники.ВидыДокументовБИА.НайтиВидДокумента(ИдентификаторПечатнойФормы, ИдентификаторОбъектаМетаданных);
	
	Сведения1САрхив = РегистрыСведений.СведенияОФайлах1САрхив.ПараметрыРегистрацииСведенийОФайле();
	Сведения1САрхив.Файл = Файл;
	Сведения1САрхив.ВидДокументаБИА = ВидДокументаБИА;
	Сведения1САрхив.ИдентификаторПечатнойФормы = ИдентификаторПечатнойФормы;
	Сведения1САрхив.Сотрудник = Сотрудник;
	Сведения1САрхив.Номер = НомерДокумента;
	Сведения1САрхив.Дата = ДатаДокумента;
	
	Если ЗначениеЗаполнено(ВидДокументаБИА) Тогда
		Сведения1САрхив.Вставить("НеВыгружать", ВидДокументаБИА.НеВыгружать);
	КонецЕсли;
	
	ИнтеграцияС1САрхивом.ЗаписатьСведения1САрхив(Сведения1САрхив);
	
КонецПроцедуры

#КонецОбласти

#Область СведенияОФайлах

Функция ВидДокументаБИАУстановлен(ИдентификаторПечатнойФормы, ИдентификаторОбъектаМетаданных) Экспорт
	ВидДокументаБИА = Справочники.ВидыДокументовБИА.НайтиВидДокумента(ИдентификаторПечатнойФормы, ИдентификаторОбъектаМетаданных);
	Возврат ЗначениеЗаполнено(ВидДокументаБИА);
КонецФункции

Функция ИдентификаторРегламентированногоОтчета(Знач ИсточникОтчета) Экспорт

	Если ТипЗнч(ИсточникОтчета) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		ИсточникОтчета = ИсточникОтчета.ИсточникОтчета;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Отчет."+ИсточникОтчета);
КонецФункции

#КонецОбласти

#Область Формы

Функция ДокументыБИАРегламентированногоОтчета(ТекущиеДанные) Экспорт
	
	ТаблицаДокументовБИА = Неопределено;
	
	Если Не ТекущиеДанные = Неопределено 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "Ссылка") Тогда
		ТаблицаДокументовБИА = ОбменСАрхивом.ТаблицаДокументовБИА(ТекущиеДанные.Ссылка);
	КонецЕсли;
	
	Если Не ТаблицаДокументовБИА = Неопределено Тогда
		ТаблицаДокументовБИА = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДокументовБИА);
	КонецЕсли;
	
	Возврат ТаблицаДокументовБИА;
	
КонецФункции

