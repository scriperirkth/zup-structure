#Область ПодключениеКШинеОтчетности

// Подключается к приложению Отчетность по пин-коду и сохраняет настройки подключения
// В отличие от Подключиться не требует интерактивной формы записи регистра настроек
// и пригодна для тихого подключения при первичной загрузке справочников
//
// Параметры:
//  КодовоеСлово - Строка - пин-код, выданный приложением Отчетность
//  Ошибка - Строка - текст ошибки подключения
//
// Возвращаемое значение:
//  см. Подключиться
//
Функция ПодключитьсяИСохранитьНастройки(КодовоеСлово, Ошибка = "") Экспорт

	Результат = Подключиться(КодовоеСлово, Ошибка);

	Состояние = 0;
	Если Результат.Свойство("Состояние", Состояние) И (Состояние = 1 Или Состояние = 3) Тогда
		ИнтеграцияСОтчетность24.СохранитьНастройкиПодключения(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Подключает учетную базу к приложению 1С-Отчетность 24 по параметру запуска
//
// Параметры:
//  ПараметрЗапуска - Строка - параметр запуска приложения
//
// Возвращаемое значение:
//  Строка - текст ошибки, пустая строка если база подключена
