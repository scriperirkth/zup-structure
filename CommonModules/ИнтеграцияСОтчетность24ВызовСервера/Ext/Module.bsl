Процедура ПолучитьСообщенияПоHttp(ОписаниеОшибки = "", ВыполнитьВФоне = Истина) Экспорт
	
	Если ВыполнитьВФоне Тогда
		КлючФоновогоЗадания = "ИнтеграцияСОтчетность24.ПолучитьСообщенияПоHttp";
		ОтборЗаданий = Новый Структура();
		ОтборЗаданий.Вставить("Ключ", КлючФоновогоЗадания);
		ОтборЗаданий.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
		АктивныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборЗаданий);
		
		Если АктивныеЗадания.Количество()>0 Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне();
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		ПараметрыВыполнения.ОжидатьЗавершение = 0;
		ПараметрыВыполнения.КлючФоновогоЗадания = КлючФоновогоЗадания;
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Получение сообщений из шины отчетности'");
		
		Попытка
			ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
				"ИнтеграцияСОтчетность24.ПолучитьСообщенияПоHttp");
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Интеграция с Отчетность24. Запуск получения сообщений из шины отчетности'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;
	Иначе
		ИнтеграцияСОтчетность24.ПолучитьСообщенияПоHttp(ОписаниеОшибки);
	КонецЕсли;
		
КонецПроцедуры

