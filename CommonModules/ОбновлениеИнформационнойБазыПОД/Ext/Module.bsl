Процедура ОбновитьАктивныеЗадачиПоОбработкеДокументов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	НЕ ЗадачаПоОбработкеДокумента.Выполнена
	|	И ЗадачаПоОбработкеДокумента.РольИсполнителя <> ЗНАЧЕНИЕ(Справочник.РолиИсполнителей.ПустаяСсылка)
	|	И (ЗадачаПоОбработкеДокумента.ОсновнойОбъектАдресации <> НЕОПРЕДЕЛЕНО
	|			ИЛИ ЗадачаПоОбработкеДокумента.ДополнительныйОбъектАдресации <> НЕОПРЕДЕЛЕНО)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	Попытка
		
		Пока Выборка.Следующий() Цикл
			
			ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если Не ЗначениеЗаполнено(ЗадачаОбъект.ОсновнойОбъектАдресации) И ЗадачаОбъект.ОсновнойОбъектАдресации <> Неопределено Тогда
				ЗадачаОбъект.ОсновнойОбъектАдресации = Неопределено;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ЗадачаОбъект.ДополнительныйОбъектАдресации) И ЗадачаОбъект.ДополнительныйОбъектАдресации <> Неопределено Тогда
				ЗадачаОбъект.ДополнительныйОбъектАдресации = Неопределено;
			КонецЕсли;
			Если ЗадачаОбъект.Модифицированность() Тогда
				ЗадачаОбъект.ГруппаИсполнителейЗадач = БизнесПроцессыИЗадачиСервер.ГруппаИсполнителейЗадач(
					ЗадачаОбъект.РольИсполнителя, ЗадачаОбъект.ОсновнойОбъектАдресации, ЗадачаОбъект.ДополнительныйОбъектАдресации);
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ЗадачаОбъект);
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Обновление активных задач по обработке документов'"),
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗарегистрироватьВыполненныеЗадачиДанныеКОбработке(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Выполнена
	|	И ЗадачаПоОбработкеДокумента.РольИсполнителя <> ЗНАЧЕНИЕ(Справочник.РолиИсполнителей.ПустаяСсылка)
	|	И (ЗадачаПоОбработкеДокумента.ОсновнойОбъектАдресации <> НЕОПРЕДЕЛЕНО
	|			ИЛИ ЗадачаПоОбработкеДокумента.ДополнительныйОбъектАдресации <> НЕОПРЕДЕЛЕНО)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗадачаПоОбработкеДокумента.Дата УБЫВ";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбновитьВыполненныеЗадачиПоОбработкеДокументов(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Задача.ЗадачаПоОбработкеДокумента";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если Объект = Неопределено Тогда
				
				// Вероятно был удален раньше, чем обработчик дошел до него
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
				
			Иначе
				
				Если Не ЗначениеЗаполнено(Объект.ОсновнойОбъектАдресации) И Объект.ОсновнойОбъектАдресации <> Неопределено Тогда
					Объект.ОсновнойОбъектАдресации = Неопределено;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Объект.ДополнительныйОбъектАдресации) И Объект.ДополнительныйОбъектАдресации <> Неопределено Тогда
					Объект.ДополнительныйОбъектАдресации = Неопределено;
				КонецЕсли;
				
				Если Не Объект.Модифицированность() Тогда
					
					ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
					
				Иначе
					
					Объект.ГруппаИсполнителейЗадач = БизнесПроцессыИЗадачиСервер.ГруппаИсполнителейЗадач(
						Объект.РольИсполнителя, Объект.ОсновнойОбъектАдресации, Объект.ДополнительныйОбъектАдресации);
					
					ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
					
				КонецЕсли;
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать задачу: %Объект% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Задачи.ЗадачаПоОбработкеДокумента,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

