Процедура ОбновитьНастройкиПравНазначенияИсполнителей() Экспорт
	
	ТипРоль = Тип("СправочникСсылка.РолиИсполнителей");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкаПравНазначенияИсполнителей.НазначающийИсполнителей КАК НазначающийИсполнителей,
	|	НастройкаПравНазначенияИсполнителей.РольИсполнителя КАК РольИсполнителя,
	|	НастройкаПравНазначенияИсполнителей.ОсновнойОбъектАдресацииИсполнителя КАК ОсновнойОбъектАдресацииИсполнителя,
	|	НастройкаПравНазначенияИсполнителей.ОсновнойОбъектАдресацииНазначающего КАК ОсновнойОбъектАдресацииНазначающего,
	|	НастройкаПравНазначенияИсполнителей.ДополнительныйОбъектАдресацииИсполнителя КАК ДополнительныйОбъектАдресацииИсполнителя,
	|	НастройкаПравНазначенияИсполнителей.ДополнительныйОбъектАдресацииНазначающего КАК ДополнительныйОбъектАдресацииНазначающего,
	|	НастройкаПравНазначенияИсполнителей.ГруппаИсполнителейЗадачНазначающий КАК ГруппаИсполнителейЗадачНазначающий
	|ИЗ
	|	РегистрСведений.НастройкаПравНазначенияИсполнителей КАК НастройкаПравНазначенияИсполнителей
	|
	|УПОРЯДОЧИТЬ ПО
	|	НазначающийИсполнителей,
	|	РольИсполнителя";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	Попытка
		
		НаборЗаписей = РегистрыСведений.НастройкаПравНазначенияИсполнителей.СоздатьНаборЗаписей();
		
		Пока Выборка.СледующийПоЗначениюПоля("НазначающийИсполнителей") Цикл
			
			Пока Выборка.СледующийПоЗначениюПоля("РольИсполнителя") Цикл
				
				НаборЗаписей.Очистить();
				Пока Выборка.Следующий() Цикл
					
					НоваяЗапись = НаборЗаписей.Добавить();
					
					НоваяЗапись.НазначающийИсполнителей = Выборка.НазначающийИсполнителей;
					НоваяЗапись.РольИсполнителя = Выборка.РольИсполнителя;
					Если Не ЗначениеЗаполнено(Выборка.ОсновнойОбъектАдресацииИсполнителя) И Выборка.ОсновнойОбъектАдресацииИсполнителя <> Неопределено Тогда
						НоваяЗапись.ОсновнойОбъектАдресацииИсполнителя = Неопределено;
					Иначе
						НоваяЗапись.ОсновнойОбъектАдресацииИсполнителя = Выборка.ОсновнойОбъектАдресацииИсполнителя;
					КонецЕсли;
					Если Не ЗначениеЗаполнено(Выборка.ДополнительныйОбъектАдресацииИсполнителя) И Выборка.ДополнительныйОбъектАдресацииИсполнителя <> Неопределено Тогда
						НоваяЗапись.ДополнительныйОбъектАдресацииИсполнителя = Неопределено;
					Иначе
						НоваяЗапись.ДополнительныйОбъектАдресацииИсполнителя = Выборка.ДополнительныйОбъектАдресацииИсполнителя;
					КонецЕсли;
					Если Не ЗначениеЗаполнено(Выборка.ОсновнойОбъектАдресацииИсполнителя) И Выборка.ОсновнойОбъектАдресацииИсполнителя <> Неопределено Тогда
						НоваяЗапись.ОсновнойОбъектАдресацииИсполнителя = Неопределено;
					Иначе
						НоваяЗапись.ОсновнойОбъектАдресацииИсполнителя = Выборка.ОсновнойОбъектАдресацииИсполнителя;
					КонецЕсли;
					Если Не ЗначениеЗаполнено(Выборка.ДополнительныйОбъектАдресацииИсполнителя) И Выборка.ДополнительныйОбъектАдресацииИсполнителя <> Неопределено Тогда
						НоваяЗапись.ДополнительныйОбъектАдресацииИсполнителя = Неопределено;
					Иначе
						НоваяЗапись.ДополнительныйОбъектАдресацииИсполнителя = Выборка.ДополнительныйОбъектАдресацииИсполнителя;
					КонецЕсли;
					
					Если ТипРоль = ТипЗнч(НоваяЗапись.НазначающийИсполнителей) Тогда
						НоваяЗапись.ГруппаИсполнителейЗадачНазначающий = БизнесПроцессыИЗадачиСервер.ГруппаИсполнителейЗадач(
							НоваяЗапись.НазначающийИсполнителей,
							НоваяЗапись.ОсновнойОбъектАдресацииНазначающего,
							НоваяЗапись.ДополнительныйОбъектАдресацииНазначающего);
					КонецЕсли;
					
				КонецЦикла;
				
				НаборЗаписей.Отбор.НазначающийИсполнителей.Установить(Выборка.НазначающийИсполнителей);
				НаборЗаписей.Отбор.РольИсполнителя.Установить(Выборка.РольИсполнителя);
				
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
				
			КонецЦикла;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Обновление настроек прав назначения исполнителей'"),
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

