	Обработчик.Идентификатор = Новый УникальныйИдентификатор("43871e96-ece7-48e8-a5ed-bd3b435a615d");
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "ОбновлениеИнформационнойБазыПОД.ЗарегистрироватьВыполненныеЗадачиДанныеКОбработке";
	Обработчик.ОчередьОтложеннойОбработки = 1;
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.ЧитаемыеОбъекты = "Задачи.ЗадачаПоОбработкеДокумента";
	Обработчик.ИзменяемыеОбъекты = "Задачи.ЗадачаПоОбработкеДокумента";
	Обработчик.БлокируемыеОбъекты = "Задачи.ЗадачаПоОбработкеДокумента";
	Обработчик.Комментарий = НСтр("ru = 'Заполнение пустых объектов адресации значением Неопределено для задач ""Задача по обработке документа""'");
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбновления

Процедура КорректировкаДоступностиШаблонов() Экспорт
	
	Выборка = Справочники.ШаблоныПроцессов.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.ПолучитьОбъект();
		
		// проверка на наличие доступных реквизитов на более поздних этапах, чем была установлена ответственность
		ОшибочноДоступныеРеквизиты = Новый Массив;
		
		Для Каждого ОтветственностьЗаРеквизит Из Объект.ОтветственностьЗаРеквизиты Цикл
			ДанныеЭтапа = Объект.Этапы.НайтиСтроки(Новый Структура("ИдентификаторЭтапа", ОтветственностьЗаРеквизит.ИдентификаторЭтапа));
			ПорядокОтветственности = ДанныеЭтапа[0].Порядок;
			Для Каждого Этап Из Объект.Этапы Цикл
				
				Если Этап.Порядок < ПорядокОтветственности
					ИЛИ ОтветственностьЗаРеквизит.ИдентификаторЭтапа = Этап.ИдентификаторЭтапа Тогда
					Продолжить;
				КонецЕсли;
				
				РеквизитНайден = Ложь;
				Для Каждого НедоступностьРеквизита Из Объект.НедоступныеРеквизиты Цикл
					Если НедоступностьРеквизита.ИдентификаторЭтапа = Этап.ИдентификаторЭтапа
						И НедоступностьРеквизита.ИмяТабличнойЧасти = ОтветственностьЗаРеквизит.ИмяТабличнойЧасти
						И НедоступностьРеквизита.ИмяРеквизита = ОтветственностьЗаРеквизит.ИмяРеквизита Тогда
						РеквизитНайден = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если РеквизитНайден Тогда
					Продолжить;
				КонецЕсли;
				
				ПараметрыДоступногоРеквизита = Новый Структура;
				ПараметрыДоступногоРеквизита.Вставить("НомерЭтапа", Этап.НомерСтроки);
				ПараметрыДоступногоРеквизита.Вставить("ИдентификаторЭтапа", Этап.ИдентификаторЭтапа);
				ПараметрыДоступногоРеквизита.Вставить("Этап", Этап.Этап);
				ПараметрыДоступногоРеквизита.Вставить("ИмяТабличнойЧасти", ОтветственностьЗаРеквизит.ИмяТабличнойЧасти);
				ПараметрыДоступногоРеквизита.Вставить("ИмяРеквизита", ОтветственностьЗаРеквизит.ИмяРеквизита);
				
				ОшибочноДоступныеРеквизиты.Добавить(ПараметрыДоступногоРеквизита);
				
			КонецЦикла;
		КонецЦикла;
		
		Если ОшибочноДоступныеРеквизиты.Количество() > 0 ИЛИ Объект.УдалитьДоступностьРеквизитовЭтапов.Количество() > 0 Тогда
			
			Для Каждого ОшибочноДоступныйРеквизит Из ОшибочноДоступныеРеквизиты Цикл
				ЗаполнитьЗначенияСвойств(Объект.НедоступныеРеквизиты.Добавить(), ОшибочноДоступныйРеквизит)
			КонецЦикла;
			
			Объект.УдалитьДоступностьРеквизитовЭтапов.Очистить();
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект, Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнениеРеквизитаКомментарийВЭтапах() Экспорт
	
	Выборка = Справочники.ЭтапыПроцессов.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.ПолучитьОбъект();
		
		Если НЕ ПустаяСтрока(Объект.Описание) Тогда
			
			Объект.Комментарий = Объект.Описание;
			Объект.Описание = "";
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект, Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПорядокЭтаповШаблонов() Экспорт
	
	Выборка = Справочники.ШаблоныПроцессов.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.ПолучитьОбъект();
		
		Для Каждого Этап Из Объект.Этапы Цикл
			Этап.Порядок = 99;
			Если Лев(Этап.ПредшественникиВариантИспользования,6) = "Старт," Тогда
				Этап.Порядок = 0;
			КонецЕсли;
		КонецЦикла;
		
		ТекущийПорядок = 0;
		ПоследнееКоличествоСНеПрисвоеннымПорядком = 0;
		ТекущееКоличествоСНеПрисвоеннымПорядком = 99;
		Пока ТекущееКоличествоСНеПрисвоеннымПорядком <> ПоследнееКоличествоСНеПрисвоеннымПорядком Цикл
			ТекущееКоличествоСНеПрисвоеннымПорядком = ПоследнееКоличествоСНеПрисвоеннымПорядком;
			ПоследнееКоличествоСНеПрисвоеннымПорядком = 0;
			Для Каждого Этап Из Объект.Этапы Цикл
				Если Этап.Порядок <> 99 Тогда
					Продолжить;
				КонецЕсли;
				Предшественники = Объект.ПредшественникиЭтапов.НайтиСтроки(Новый Структура("ИдентификаторПоследователя", Этап.ИдентификаторЭтапа));
				МаксимальныйПорядокПредшественника = Неопределено;
				Для Каждого Предшественник Из Предшественники Цикл
					ДанныеПредшественника = Объект.Этапы.НайтиСтроки(Новый Структура("ИдентификаторЭтапа", Предшественник.ИдентификаторПредшественника));
					Если ДанныеПредшественника[0].Порядок = 99 Тогда
						Если Этап.ПредшественникиВариантИспользования = "ВсеПредшественники" Тогда
							// Если этап запускается по И и у одного из предшественников еще не заполнен порядок, то этапу на этой итерации порядок не присваивается
							МаксимальныйПорядокПредшественника = Неопределено;
							Прервать;
						Иначе
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					Если Этап.ПредшественникиВариантИспользования = "ОдинИзПредшественников" Тогда
						// Если этап запускается по ИЛИ, то берем первого из заполненных предшественников
						МаксимальныйПорядокПредшественника = ДанныеПредшественника[0].Порядок;
						Прервать;
					КонецЕсли;
					// Если этап запускается по И - вычисляем максимальный порядок среди предшественников
					Если МаксимальныйПорядокПредшественника = Неопределено Тогда
						МаксимальныйПорядокПредшественника = ДанныеПредшественника[0].Порядок;
					Иначе
						МаксимальныйПорядокПредшественника = Макс(МаксимальныйПорядокПредшественника, ДанныеПредшественника[0].Порядок);
					КонецЕсли;
				КонецЦикла;
				Если МаксимальныйПорядокПредшественника <> Неопределено Тогда
					Этап.Порядок = МаксимальныйПорядокПредшественника + 1;
				КонецЕсли;
				Если Этап.Порядок = 99 Тогда
					ПоследнееКоличествоСНеПрисвоеннымПорядком = ПоследнееКоличествоСНеПрисвоеннымПорядком + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТребованияКПроведению() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка КАК Этап,
	|	ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения КАК Статус
	|ИЗ
	|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|ГДЕ
	|	НЕ ЭтапыПроцессовРезультатыВыполнения.ОтрицательныйРезультат";
	
	ПоложительныеРезультатыЭтапов = Запрос.Выполнить().Выгрузить();
	
	Выборка = Справочники.ШаблоныПроцессов.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.ПолучитьОбъект();
		
		Объект.ТребованияКПроведению.Очистить();
		
		Для Каждого Этап Из Объект.Этапы Цикл
			
			Если НЕ Этап.УдалитьТребуетсяПроведение Тогда
				Продолжить;
			КонецЕсли;
			
			Отбор = Новый Структура("Этап", Этап.Этап);
			ПоложительныеРезультаты = ПоложительныеРезультатыЭтапов.НайтиСтроки(Отбор);
			Для Каждого ПоложительныйРезультат Из ПоложительныеРезультаты Цикл
				НоваяСтрока = Объект.ТребованияКПроведению.Добавить();
				НоваяСтрока.ИдентификаторЭтапа = Этап.ИдентификаторЭтапа;
				НоваяСтрока.Статус = ПоложительныйРезультат.Статус;
				НоваяСтрока.ПризнакПроведенности = Истина;
			КонецЦикла;
			
		КонецЦикла;
		
		Если Объект.Модифицированность() Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПереносПодписанныхДанныхИзЗадачиВРегистрСведений() Экспорт
	
	НаборЗаписей = РегистрыСведений.ПодписанныеДанные.СоздатьНаборЗаписей();
	
	НаборЗаписей.Прочитать();
	// Если записи в регистре уже есть, значит перенос уже был выполнен, повторный перенос не требуется
	Если НаборЗаписей.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Задача,
	|	ЗадачаПоОбработкеДокумента.УдалитьСоставПодписи КАК СоставПодписи,
	|	ЗадачаПоОбработкеДокумента.УдалитьПодписанныеДанные КАК ПодписанныеДанные
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.ПодписанЭП";
	
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Ложь);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитЗапретитьПерепроведение() Экспорт
	
	ВыборкаШаблоны = Справочники.ШаблоныПроцессов.Выбрать();
	
	Пока ВыборкаШаблоны.Следующий() Цикл
		
		ОбъектШаблон = ВыборкаШаблоны.ПолучитьОбъект();
		
		Для Каждого Этап Из ОбъектШаблон.Этапы Цикл
			Если Этап.ЗапретитьПроведениеОтменуПроведения Тогда
				Этап.ЗапретитьПерепроведение = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ОбъектШаблон.Модифицированность() Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектШаблон);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьГруппуИсполнителейЗадачНазначающих() Экспорт
	
	НаборЗаписей = РегистрыСведений.НастройкаПравНазначенияИсполнителей.СоздатьНаборЗаписей();
	
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		Если ТипЗнч(Запись.НазначающийИсполнителей) = Тип("СправочникСсылка.РолиИсполнителей")
			И НЕ ЗначениеЗаполнено(Запись.ГруппаИсполнителейЗадачНазначающий) Тогда
			Запись.ГруппаИсполнителейЗадачНазначающий = БизнесПроцессыИЗадачиСервер.ГруппаИсполнителейЗадач(Запись.НазначающийИсполнителей,
				Запись.ОсновнойОбъектАдресацииНазначающего, Запись.ДополнительныйОбъектАдресацииНазначающего);
		КонецЕсли;
		
	КонецЦикла;
	
	Если НаборЗаписей.Модифицированность() Тогда
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПереносИсторииСтатусовДокументов() Экспорт
	
	НаборЗаписей = РегистрыСведений.ИсторияИзмененияСтатусовДокументов.СоздатьНаборЗаписей();
	
	НаборЗаписей.Прочитать();
	// Если записи в регистре уже есть, значит перенос уже был выполнен, повторный перенос не требуется
	Если НаборЗаписей.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(УдалитьИсторияСтатусовДокументов.Период) КАК Период,
	|	УдалитьИсторияСтатусовДокументов.Предмет КАК Предмет,
	|	УдалитьИсторияСтатусовДокументов.Установил КАК Установил
	|ПОМЕСТИТЬ ВТ_ПоследниеЗаписи
	|ИЗ
	|	РегистрСведений.УдалитьИсторияСтатусовДокументов КАК УдалитьИсторияСтатусовДокументов
	|
	|СГРУППИРОВАТЬ ПО
	|	УдалитьИсторияСтатусовДокументов.Предмет,
	|	УдалитьИсторияСтатусовДокументов.Установил
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоследниеЗаписи.Период КАК ДатаУстановки,
	|	ВТ_ПоследниеЗаписи.Предмет КАК Предмет,
	|	ВТ_ПоследниеЗаписи.Установил КАК Установил,
	|	УдалитьИсторияСтатусовДокументов.Статус КАК Статус
	|ИЗ
	|	ВТ_ПоследниеЗаписи КАК ВТ_ПоследниеЗаписи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УдалитьИсторияСтатусовДокументов КАК УдалитьИсторияСтатусовДокументов
	|		ПО ВТ_ПоследниеЗаписи.Период = УдалитьИсторияСтатусовДокументов.Период
	|			И ВТ_ПоследниеЗаписи.Предмет = УдалитьИсторияСтатусовДокументов.Предмет
	|			И ВТ_ПоследниеЗаписи.Установил = УдалитьИсторияСтатусовДокументов.Установил";
	
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Ложь);
	
КонецПроцедуры

Процедура КорректировкаРегистраТекущиеСтатусыДокументов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТекущиеСтатусыДокументов.Предмет КАК Предмет,
	|	ТекущиеСтатусыДокументов.Шаблон КАК Шаблон,
	|	ТекущиеСтатусыДокументов.Установил КАК Установил
	|ПОМЕСТИТЬ ТекущиеСтатусыСНевыполненнымиЗадачами
	|ИЗ
	|	РегистрСведений.ТекущиеСтатусыДокументов КАК ТекущиеСтатусыДокументов
	|ГДЕ
	|	ТекущиеСтатусыДокументов.Установил ССЫЛКА Задача.ЗадачаПоОбработкеДокумента
	|	И НЕ ВЫРАЗИТЬ(ТекущиеСтатусыДокументов.Установил КАК Задача.ЗадачаПоОбработкеДокумента).Выполнена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТекущиеСтатусыСНевыполненнымиЗадачами.Предмет КАК Предмет,
	|	ТекущиеСтатусыСНевыполненнымиЗадачами.Шаблон КАК Шаблон,
	|	МАКСИМУМ(ИсторияИзмененияСтатусовДокументов.ДатаУстановки) КАК ДатаУстановки
	|ПОМЕСТИТЬ ПоследниеИзмененияСтатусов
	|ИЗ
	|	РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТекущиеСтатусыСНевыполненнымиЗадачами КАК ТекущиеСтатусыСНевыполненнымиЗадачами
	|		ПО ИсторияИзмененияСтатусовДокументов.Предмет = ТекущиеСтатусыСНевыполненнымиЗадачами.Предмет
	|			И ИсторияИзмененияСтатусовДокументов.Установил <> ТекущиеСтатусыСНевыполненнымиЗадачами.Установил
	|
	|СГРУППИРОВАТЬ ПО
	|	ТекущиеСтатусыСНевыполненнымиЗадачами.Предмет,
	|	ТекущиеСтатусыСНевыполненнымиЗадачами.Шаблон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияИзмененияСтатусовДокументов.Предмет КАК Предмет,
	|	ИсторияИзмененияСтатусовДокументов.Установил КАК Установил,
	|	ИсторияИзмененияСтатусовДокументов.Статус КАК Статус,
	|	ИсторияИзмененияСтатусовДокументов.ДатаУстановки КАК ДатаУстановки,
	|	ПоследниеИзмененияСтатусов.Шаблон КАК Шаблон
	|ИЗ
	|	РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследниеИзмененияСтатусов КАК ПоследниеИзмененияСтатусов
	|		ПО ИсторияИзмененияСтатусовДокументов.Предмет = ПоследниеИзмененияСтатусов.Предмет
	|			И ИсторияИзмененияСтатусовДокументов.ДатаУстановки = ПоследниеИзмененияСтатусов.ДатаУстановки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ТекущиеСтатусыДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предмет.Установить(Выборка.Предмет);
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПереносДатыУстановкиВИзмерениеРегистраИсторииСтатусов() Экспорт
	
	НаборЗаписей = РегистрыСведений.ИсторияИзмененияСтатусовДокументов.СоздатьНаборЗаписей();
	
	НаборЗаписей.Прочитать();
	// Если записи в регистре уже есть, и дата уже заполнена, значит перенос уже был выполнен, повторный перенос не требуется
	Если НаборЗаписей.Количество() > 0 И ЗначениеЗаполнено(НаборЗаписей[0].ДатаУстановки) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИсторияИзмененияСтатусовДокументов.Предмет КАК Предмет,
	|	ИсторияИзмененияСтатусовДокументов.Установил КАК Установил,
	|	ИсторияИзмененияСтатусовДокументов.УстарелДатаУстановки КАК ДатаУстановки,
	|	ИсторияИзмененияСтатусовДокументов.Статус КАК Статус,
	|	ИсторияИзмененияСтатусовДокументов.УстарелДатаУстановки КАК УстарелДатаУстановки
	|ИЗ
	|	РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов";
	
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	
КонецПроцедуры

Процедура ЗаполнитьТипПредметаВНевыполненныхЗадачах() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
	|	ЗадачаПоОбработкеДокумента.Предмет КАК Предмет
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	НЕ ЗадачаПоОбработкеДокумента.Выполнена
	|	И ЗадачаПоОбработкеДокумента.Предмет <> НЕОПРЕДЕЛЕНО
	|	И ЗадачаПоОбработкеДокумента.ТипПредметаСтрокой = """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		Объект.ТипПредметаСтрокой = Выборка.Предмет.Метаданные().Синоним;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьКонстантуОтображенияДатыПодписанияВШтампеПЭП() Экспорт
	
	Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭППОД.Получить() = Ложь Тогда
		
		Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭППОД.Установить(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьДанныеКОбработкеРегистрНаличиеФайлов(Параметры) Экспорт

	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.НаличиеФайлов";
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
			
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НаличиеФайлов.ОбъектСФайлами КАК ОбъектСФайлами
	|ИЗ
	|	РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
	|ГДЕ
	|	НаличиеФайлов.ЕстьФайлы";
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные, ДополнительныеПараметры);
	
КонецПроцедуры    

Процедура ОбработатьДанныеРегистрНаличиеФайлов(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ПолноеИмяРегистра = "РегистрСведений.НаличиеФайлов";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	
	РезультатВыборки = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуИзмеренийНезависимогоРегистраСведенийДляОбработки(
	Параметры.Очередь,
	ПолноеИмяРегистра,
	МенеджерВременныхТаблиц,		
	ДополнительныеПараметры);
	
	Если НЕ РезультатВыборки.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	ИначеЕсли НЕ РезультатВыборки.ЕстьЗаписиВоВременнойТаблице Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВременнойТаблицы = РезультатВыборки.ИмяВременнойТаблицы;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НаличиеФайлов.ОбъектСФайлами КАК ОбъектСФайлами,
	|	ПРЕДСТАВЛЕНИЕ(НаличиеФайлов.ОбъектСФайлами) КАК ОбъектСФайламиПредставление
	|ИЗ
	|	РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
	|ГДЕ
	|	НаличиеФайлов.ОбъектСФайлами В
	|			(ВЫБРАТЬ
	|				ВременннаяТаблица.ОбъектСФайлами
	|			ИЗ
	|				&ВременннаяТаблица КАК ВременннаяТаблица)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВременннаяТаблица", ИмяВременнойТаблицы); 
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Выборка = РезультатЗапроса.Выбрать();  
	
	ТабОбработано = Новый ТаблицаЗначений;
	ТабОбработано.Колонки.Добавить("ОбъектСФайлами");
	
	Пока Выборка.Следующий() Цикл
		
		ФайлыДокументаУчета = Новый Массив;
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(Выборка.ОбъектСФайлами, ФайлыДокументаУчета);
		ЕстьФайлы = Ложь;
		Для Каждого ТекФайл Из ФайлыДокументаУчета Цикл  
			Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекФайл, "Служебный") Тогда
				ЕстьФайлы = Истина;
				Прервать;
			ИначеЕсли ТекФайл.Служебный = Ложь Тогда
				ЕстьФайлы = Истина;
				Прервать;
			КонецЕсли;    
		КонецЦикла; 
		
		НачатьТранзакцию();
		Попытка
			Если НЕ ЕстьФайлы Тогда
				//Исправление ошибки 
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяРегистра);
				ЭлементБлокировки.УстановитьЗначение("ОбъектСФайлами", Выборка.ОбъектСФайлами); 
				Блокировка.Заблокировать();  
				Набор = РегистрыСведений.НаличиеФайлов.СоздатьНаборЗаписей();
				Набор.Отбор.ОбъектСФайлами.Установить(Выборка.ОбъектСФайлами);
				Набор.Прочитать();
				Для Каждого Запись Из Набор Цикл
					Запись.ЕстьФайлы = Ложь;
				КонецЦикла;	
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(Набор, Истина, Ложь, Ложь);		
				ЗафиксироватьТранзакцию(); 
				Стр =ТабОбработано.Добавить();
				Стр.ОбъектСФайлами = Выборка.ОбъектСФайлами;
			Иначе 
				Стр =ТабОбработано.Добавить();
				Стр.ОбъектСФайлами = Выборка.ОбъектСФайлами;
				ЗафиксироватьТранзакцию();
			КонецЕсли; 
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Объект% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", Выборка.ОбъектСФайламиПредставление);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.НаличиеФайлов,
			Выборка.ОбъектСФайлами,
			ТекстСообщения);
		КонецПопытки;  
		
	КонецЦикла; 
	
	Если ТабОбработано.Количество() > 0 Тогда
		ДопПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
		ДопПараметры.ЭтоНезависимыйРегистрСведений = Истина;
		ДопПараметры.ПолноеИмяРегистра = "РегистрСведений.НаличиеФайлов"; 
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ТабОбработано, ДопПараметры, Параметры.Очередь);
	КонецЕсли;
	
	Если РезультатЗапроса.Пустой() Тогда
		//если из регистра были удалены записи, то чтобы не было зацикливания, отметим, что обработка выполнена
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВременннаяТаблица.ОбъектСФайлами КАК ОбъектСФайлами
		|ИЗ
		|	&ВременннаяТаблица КАК ВременннаяТаблица";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВременннаяТаблица", ИмяВременнойТаблицы);
		ТаблицаДанных = Запрос.Выполнить().Выгрузить();
		ДопПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
		ДопПараметры.ЭтоНезависимыйРегистрСведений = Истина;
		ДопПараметры.ПолноеИмяРегистра = "РегистрСведений.НаличиеФайлов";
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ТаблицаДанных, ДопПараметры, Параметры.Очередь);
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = НЕ ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяРегистра);	
	
КонецПроцедуры

Процедура ОбновитьТипыДополнительныхКолонок() Экспорт
	
	ПроцессыОбработкиДокументов.ОбновитьТипыДополнительныхКолонок();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбновленияПриПоявленииСоставногоТипаВОбъектахАдресацииЗадач

Процедура ОбновитьИсполнителейЗадач() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИсполнителиЗадач.РольИсполнителя КАК РольИсполнителя,
	|	ИсполнителиЗадач.Исполнитель КАК Исполнитель,
	|	ИсполнителиЗадач.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
	|	ИсполнителиЗадач.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации
	|ИЗ
	|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	Попытка
		
		НаборЗаписей = РегистрыСведений.ИсполнителиЗадач.СоздатьНаборЗаписей();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.РольИсполнителя = Выборка.РольИсполнителя;
			НоваяЗапись.Исполнитель = Выборка.Исполнитель;
			Если Не ЗначениеЗаполнено(Выборка.ОсновнойОбъектАдресации) И Выборка.ОсновнойОбъектАдресации <> Неопределено Тогда
				НоваяЗапись.ОсновнойОбъектАдресации = Неопределено;
			Иначе
				НоваяЗапись.ОсновнойОбъектАдресации = Выборка.ОсновнойОбъектАдресации;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Выборка.ДополнительныйОбъектАдресации) И Выборка.ДополнительныйОбъектАдресации <> Неопределено Тогда
				НоваяЗапись.ДополнительныйОбъектАдресации = Неопределено;
			Иначе
				НоваяЗапись.ДополнительныйОбъектАдресации = Выборка.ДополнительныйОбъектАдресации;
			КонецЕсли;
			
		КонецЦикла;
		
		НовыеИсполнителиЗадач = НаборЗаписей.Выгрузить();
		НовыеИсполнителиЗадач.Свернуть("РольИсполнителя,Исполнитель,ОсновнойОбъектАдресации,ДополнительныйОбъектАдресации");
		
		ГруппыИсполнителейЗадач = БизнесПроцессыИЗадачиСервер.ГруппыИсполнителейЗадач(НовыеИсполнителиЗадач);
		
		НаборЗаписей.Загрузить(НовыеИсполнителиЗадач);
		
		Индекс = 0;
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.ГруппаИсполнителейЗадач = ГруппыИсполнителейЗадач[Индекс];
			Индекс = Индекс + 1;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Обновление исполнителей задач'"),
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьШаблоныПроцессов() Экспорт
	
	ТипРоль = Тип("СправочникСсылка.РолиИсполнителей");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессовЭтапы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|ГДЕ
	|	ШаблоныПроцессовЭтапы.Исполнитель ССЫЛКА Справочник.РолиИсполнителей
	|	И (ШаблоныПроцессовЭтапы.ОсновнойОбъектАдресации <> НЕОПРЕДЕЛЕНО
	|			ИЛИ ШаблоныПроцессовЭтапы.ДополнительныйОбъектАдресации <> НЕОПРЕДЕЛЕНО)
	|
	|СГРУППИРОВАТЬ ПО
	|	ШаблоныПроцессовЭтапы.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	Попытка
		
		Пока Выборка.Следующий() Цикл
			ШаблонОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
				Если ТипЗнч(Этап.Исполнитель) <> ТипРоль Тогда
					Продолжить;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Этап.ОсновнойОбъектАдресации) И Этап.ОсновнойОбъектАдресации <> Неопределено Тогда
					Этап.ОсновнойОбъектАдресации = Неопределено;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Этап.ДополнительныйОбъектАдресации) И Этап.ДополнительныйОбъектАдресации <> Неопределено Тогда
					Этап.ДополнительныйОбъектАдресации = Неопределено;
				КонецЕсли;
			КонецЦикла;
			Если ШаблонОбъект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ШаблонОбъект);
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Обновление шаблонов процессов'"),
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
