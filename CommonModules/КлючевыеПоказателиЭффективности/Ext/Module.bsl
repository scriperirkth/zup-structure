Функция ПоказателиСтрокой(Показатели) Экспорт

	МассивПоказателей = ОбщегоНазначения.ВыгрузитьКолонку(Показатели, "Показатель", Истина);
	
	СоответствиеРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивПоказателей, "Наименование, ПолноеНаименование");
	
	ПоказателиСтрокой = "";
	
	Для каждого СтрокаПоказателя Из СоответствиеРеквизитов Цикл
		ПоказателиСтрокой = ПоказателиСтрокой + ?(ПустаяСтрока(ПоказателиСтрокой), "", ", ")
			+ ?(ЗначениеЗаполнено(СтрокаПоказателя.Значение.ПолноеНаименование), СтрокаПоказателя.Значение.ПолноеНаименование, Лев(СтрокаПоказателя.Значение.Наименование, 30));
	КонецЦикла;

	Возврат ПоказателиСтрокой;
	
КонецФункции

