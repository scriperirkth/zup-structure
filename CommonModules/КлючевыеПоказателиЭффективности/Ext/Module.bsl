	Настройки = РегистрыСведений.НастройкиКлючевыхПоказателейЭффективности.СоздатьМенеджерЗаписи();
	Настройки.Прочитать();
	
	Форма.ЗначениеВРеквизитФормы(Настройки, "НастройкиКлючевыхПоказателейЭффективности");
	
