// @strict-types

#Область ПрограммныйИнтерфейс

// Выполняет запуск подключения к шине
// 
// Параметры:
//  Параметры - см. НовыеПараметрыПодключения
//  
Процедура Подключиться(Параметры) Экспорт
	
	Если ТребуетсяЗакрытиеВебСокета() Тогда

		// соединение больше не нужно
		Соединения = WebSocketКлиентСоединения.ПолучитьСоединения();
		Для Каждого Соединение Из Соединения Цикл
			//@skip-check query-in-loop
			Отключиться(Соединение);
		КонецЦикла;
		
		Возврат;
	КонецЕсли;
	КлючСоединения = КлючСоединения(Параметры);

	Соединение = WebSocketКлиентСоединения.ПолучитьСоединение(КлючСоединения); // WebSocketКлиентСоединение

	ДобавитьПодписку(Параметры, Соединение);
	
	Если Соединение = Неопределено Или СоединениеЗакрыто(Соединение) Тогда
		Если Соединение <> Неопределено Тогда
			Отключиться(Соединение); // Переподключаемся, т.к. соединение закрыто
		КонецЕсли;
		
		ПараметрыСоединения = Новый ПараметрыWebSocketКлиентСоединения(); // ПараметрыWebSocketКлиентСоединения
		ПараметрыСоединения.Пароль = Параметры.Пароль;
		ПараметрыСоединения.Пользователь = Параметры.Пользователь;
		ПараметрыСоединения.Таймаут = Параметры.Таймаут;
		ПараметрыСоединения.ДополнительныеПараметры = ОбщегоНазначения.СкопироватьРекурсивно(Параметры);
	
		ОбработчикиСокета = Новый ОбработчикиWebSocketКлиентСоединения(); // ОбработчикиWebSocketКлиентСоединения
		ОбработчикиСокета.Модуль = Отчетность24БРОШинаСлужебный;
		ОбработчикиСокета.ОбработчикОткрытияСоединения = "ПриОткрытииСоединения";
		ОбработчикиСокета.ОбработчикПолученияСообщения = "ПриПолученииСообщенияСлужебный";
		ОбработчикиСокета.ОбработчикОшибки             = "ПриОшибкеСоединения";
		ОбработчикиСокета.ОбработчикЗакрытияСоединения = "ПриЗакрытииСоединения";

		СтрокаПодключения = СтрокаПодключения(Параметры);

		Соединение = WebSocketКлиентСоединения.ОткрытьСоединение(КлючСоединения, СтрокаПодключения, ОбработчикиСокета, ПараметрыСоединения); // WebSocketКлиентСоединение
	КонецЕсли;
	
	ЗаписатьСохраняемыеПараметрыСокета(Соединение.Ключ);
	
КонецПроцедуры

// Выполняет отмену подписок и отключение от шины
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение 
Процедура Отключиться(Соединение) Экспорт

	Если СоединениеЗакрыто(Соединение) Тогда
		Возврат; // На клиент-серверных базах есть проблема с закрытием сокета при сохранении конфигурации
	КонецЕсли;
	
	Попытка
		РазрешитьЗакрытиеСокета(Соединение, Истина);
		
		// закрываем подключенные подписки
		ОформленныеПодписки = ОформленныеПодписки(Соединение.Ключ);
		Для Каждого КлючИЗначение Из ОформленныеПодписки Цикл
			ИмяПодписки = КлючИЗначение.Ключ;
			Подписка = Подписка(ИмяПодписки,
				ТипыПриемниковОбработкиСообщений().ПоШаблону, "auto"); // получение сообщений адресованных этой базе
			Соединение.ОтправитьСообщение(КомандаОтменыПодпискиНаПолучениеСообщений(Подписка));
		КонецЦикла;
		
		Соединение.ОтправитьСообщение(КомандаОтключения());
	Исключение
		ЗаписьЖурналаРегистрации(
			"ШинаRabbitMQ",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Соединение.Закрыть();
	
КонецПроцедуры

// Добавляет сообщение в очередь для отправки.
// 
// Параметры:
//  Ключ - Строка
//  Сообщение  - см. НовоеСообщениеДляОтправки
Процедура ПоместитьСообщениеВОчередьДляОтправки(Ключ, Сообщение) Экспорт

	Попытка
		СохраненныеПараметры = СохраняемыеПараметрыСокета(Ключ);
		Если СохраненныеПараметры.Количество() > 0 Тогда
			// В разделяемом режиме всегда одна база
			СохраненныеПараметры[0].СообщенияДляОтправки.Добавить(Сообщение);
		КонецЕсли;
		ЗаписатьСохраняемыеПараметрыСокета(Ключ, СохраненныеПараметры);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ШинаRabbitMQ",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;

	Соединение = WebSocketКлиентСоединения.ПолучитьСоединение(Ключ); // WebSocketКлиентСоединение

	Если Соединение <> Неопределено И Не СоединениеЗакрыто(Соединение) Тогда
		ОтправитьСообщения(Соединение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиСоедиения

// Обработчик срабатывающий при открытии соединения
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение 
Процедура ПриОткрытииСоединения(Соединение) Экспорт
	
	Параметры = Соединение.Параметры.ДополнительныеПараметры; // см. НовыеПараметрыПодключения
	КомандаПодключения = КомандаПодключения(Параметры);
	Попытка
		Если Не СоединениеЗакрыто(Соединение) Тогда
			Соединение.ОтправитьСообщение(КомандаПодключения);
		КонецЕсли;
	Исключение
		КлючОбработки = "ПриОткрытииСоединения";
		ЗаписьЖурналаРегистрации(
			СтрШаблон("ШинаRabbitMQ.%1", КлючОбработки),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		Если Параметры.ПереподключениеПриЗакрытииСоединения Тогда
			Подключиться(Параметры);
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры

// Обработчик срабатывающий при закрытии соединения
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение - 
//  КодЗакрытия - Число
Процедура ПриЗакрытииСоединения(Соединение, КодЗакрытия) Экспорт

	Если КодЗакрытия <> 1005 Тогда
		ЗаписьЖурналаРегистрации(
			"ШинаRabbitMQ",
			УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("%1 - Закрылся сокет с кодом: %2", Соединение.URLСервера, КодЗакрытия));
	КонецЕсли;
	
	РазрешитьЗакрытие = РазрешеноЗакрытиеСоединения(Соединение.Ключ);
	
	ПараметрыСозданияСоединения = Соединение.Параметры.ДополнительныеПараметры; // см. НовыеПараметрыПодключения
	Если Не РазрешитьЗакрытие И ПараметрыСозданияСоединения.ПереподключениеПриЗакрытииСоединения Тогда
		// Переподключение
		Параметры = Соединение.Параметры.ДополнительныеПараметры; // см. НовыеПараметрыПодключения
		Подключиться(Параметры);
	КонецЕсли;

КонецПроцедуры

// Обработчик срабатывающий при ошибке соединения
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение - 
//  КодОшибки  - Строка
//  Описание   - Строка
Процедура ПриОшибкеСоединения(Соединение, КодОшибки, Описание) Экспорт

	КлючОбработки = "ПриОшибкеСоединения";
	ЗаписьЖурналаРегистрации(
		СтрШаблон("ШинаRabbitMQ.%1", КлючОбработки),
		УровеньЖурналаРегистрации.Ошибка, , ,
		СтрШаблон("%1 - %2 %3", Соединение.URLСервера, КодОшибки, Описание));

	ВызватьПаузу(2000);
	
	Параметры = Соединение.Параметры.ДополнительныеПараметры; // см. НовыеПараметрыПодключения
	Если Параметры.ПереподключениеПриЗакрытииСоединения Тогда
		Подключиться(Параметры);
	КонецЕсли;

КонецПроцедуры

// Обработчик срабатывающий при получении сообщений из шины
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение
//  Сообщение  - см. СообщениеSTOMP
Процедура ПриПолученииСообщения(Соединение, Сообщение) Экспорт

	КлючОбработки = "ПриПолученииСообщения";
	ДополнительныеПараметры = Соединение.Параметры.ДополнительныеПараметры; // Структура
	Обработчик = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, КлючОбработки); // Строка
	Если Обработчик = "Отчетность24БРОШинаУведомления.ПриПолученииСообщения" Тогда
		Попытка
			Отчетность24БРОШинаУведомления.ПриПолученииСообщения(Соединение, Сообщение);
		Исключение
			ЗаписьЖурналаРегистрации(
				СтрШаблон("ШинаRabbitMQ.%1", КлючОбработки), УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Обработчик срабатывающий при получении ошибки доставки сообщения в шину
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение
//  Сообщение  - см. СообщениеSTOMP
Процедура ПриПолученииОшибки(Соединение, Сообщение) Экспорт

	КлючОбработки = "ПриПолученииОшибки";
	ЗаписьЖурналаРегистрации(
		СтрШаблон("ШинаRabbitMQ.%1", КлючОбработки), УровеньЖурналаРегистрации.Ошибка, , ,
		Сообщение.Тело);

КонецПроцедуры

// Обработчик срабатывающий при получении уведомления об удачной доставке сообщения в шину
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение
//  Сообщение  - см. СообщениеSTOMP
Процедура ПриПодтвержденииОтправкиСообщения(Соединение, Сообщение) Экспорт

	ИдентификаторОтправленногоСообщения = Сообщение.Заголовки["receipt-id"];
	
	Если ЗначениеЗаполнено(ИдентификаторОтправленногоСообщения) Тогда
		НашлиСообщение = Ложь;
		// Находим сообщение и удаляем его из очереди на доставку	
		СохраняемыеПараметрыСокета = СохраняемыеПараметрыСокета(Соединение.Ключ);
		Для Каждого ПараметрыБазы Из СохраняемыеПараметрыСокета Цикл
			СообщенияДляОтправки = ПараметрыБазы.СообщенияДляОтправки;
			Для Каждого СообщениеДляОтправки Из СообщенияДляОтправки Цикл
				Если СообщениеДляОтправки.ИдентификаторОтправки = ИдентификаторОтправленногоСообщения Тогда
					Индекс = СообщенияДляОтправки.Найти(СообщениеДляОтправки);
					Если Индекс <> Неопределено Тогда
						НашлиСообщение = Истина;
						СообщенияДляОтправки.Удалить(Индекс);
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НашлиСообщение Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НашлиСообщение Тогда
			ЗаписатьСохраняемыеПараметрыСокета(Соединение.Ключ, СохраняемыеПараметрыСокета);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// Обработчик срабатывающий при получении сообщений из шины
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение
//  Данные     - Строка
Процедура ПриПолученииСообщенияСлужебный(Соединение, Данные) Экспорт
	
	Попытка

		Сообщение = СообщениеSTOMP(Данные);

		Если Не ЗначениеЗаполнено(Сообщение.Команда) Тогда 
			// Поддержка соединения
			ОтправитьСообщение(Соединение, Символы.ПС);

			Если ТребуетсяЗакрытиеВебСокета() Тогда
				Отключиться(Соединение);
			КонецЕсли;

		ИначеЕсли Сообщение.Команда = КомандыСервера().ПодключениеВыполнено Тогда
			
			РазрешитьЗакрытиеСокета(Соединение, Ложь);
			
			// При соединении оформляем подписки.
			ОформленныеПодписки = ОформленныеПодписки(Соединение.Ключ);
			Если РаботаВМоделиСервиса.РазделениеВключено() Тогда

				// Удаление неиспользуемых областей
				ВыборкаИспользуемыеОбластиДанных = РаботаВМоделиСервиса.ИспользуемыеОбластиДанных();
				МассивОбластей = ВыборкаИспользуемыеОбластиДанных.Выгрузить().ВыгрузитьКолонку("ОбластьДанных");

				Для Каждого КлючИЗначение Из ОформленныеПодписки Цикл
					Если МассивОбластей.Найти(КлючИЗначение.Значение.ОбластьДанных) = Неопределено Тогда
						ОформленныеПодписки.Удалить(КлючИЗначение.Ключ);
					КонецЕсли;
				КонецЦикла;

			КонецЕсли;

			Для Каждого КлючИЗначение Из ОформленныеПодписки Цикл
				ИмяПодписки = КлючИЗначение.Ключ;
				Подписка = Подписка(ИмяПодписки, ТипыПриемниковОбработкиСообщений().ПоШаблону, "auto"); // получение сообщений адресованных этой базе
				ОтправитьСообщение(Соединение, КомандаПодпискаНаПолучениеСообщений(Подписка));
			КонецЦикла;

			ОтправитьСообщения(Соединение);

		ИначеЕсли Сообщение.Команда = КомандыСервера().Ошибка Тогда
			ПриПолученииОшибки(Соединение, Сообщение);
		ИначеЕсли Сообщение.Команда = КомандыСервера().ВходящееСообщение Тогда
		
			// получение сообщение из очереди по подписке
			ИмяПодписки = Сообщение.Заголовки["subscription"];
			ОформленныеПодписки = ОформленныеПодписки(Соединение.Ключ);
			ПараметрыПодписки = ОформленныеПодписки.Получить(ИмяПодписки);
			Если ПараметрыПодписки <> Неопределено Тогда
				Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
					РаботаВМоделиСервиса.ВойтиВОбластьДанных(ПараметрыПодписки.ОбластьДанных);
					ПриПолученииСообщения(Соединение, Сообщение);
					РаботаВМоделиСервиса.ВыйтиИзОбластиДанных();
				Иначе
					ПриПолученииСообщения(Соединение, Сообщение);
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли Сообщение.Команда = КомандыСервера().ПодтверждениеОтправки Тогда  // отправленное сообщение на шину успешно доставлено
			ПриПодтвержденииОтправкиСообщения(Соединение, Сообщение);
		Иначе

			ЗаписьЖурналаРегистрации(
			"ШинаRabbitMQ", УровеньЖурналаРегистрации.Информация, , , 
				СтрШаблон("Получена неучтенная команда из Шины
					|Команда:'%1'
					|Тело:   '%2'", Сообщение.Команда, Сообщение.Тело));

		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации(
			"ШинаRabbitMQ", УровеньЖурналаРегистрации.Ошибка, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(
			ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

// Конструктор параметров подключения к серверу RabbitMQ
// 
// Возвращаемое значение:
//  Структура - Новые параметры подключения:
//	* Сервер               - Строка
//	* Путь                 - Строка - Request-URI
//	* Порт                 - Число  - Порт обслуживающий STOMP
//	* ПереподключениеПриЗакрытииСоединения - Булево 
//	* ПоддерживаемыеВерсии - Строка - поддерживаемые версии протокола (1.0,1.1,1.2)
//	* Пользователь         - Строка - логин
//	* Пароль               - Строка - пароль
//	* ЗащищенноеСоединение - Булево - влияет на URL ws:// или wss://
//	* ВиртуальныйХост      - Строка - виртуальный хост
//	* Заголовки            - Соответствие Из КлючИЗначение:
//	** Ключ                - Строка
//	** Значение            - Строка
//	* Таймаут              - Число  - Таймаут в секундах
//	* ЧастотаПульса        - Число  - частота подтвержения активности в милисекундах
//	* ИдентификаторБазы    - Строка
//	* ИдентификаторНаШине  - Строка
//	* ОбластьДанных        - Число
//	* ПриОткрытииСоединения - Строка - Пример: "ПолучениеУведомленийНовости.ПриОткрытииСоединения" - см. ПриОткрытииСоединения
//	* ПриОшибкеСоединения   - Строка - Пример: "ПолучениеУведомленийНовости.ПриОшибкеСоединения"   - см. ПриОшибкеСоединения
//	* ПриЗакрытииСоединения - Строка - Пример: "ПолучениеУведомленийНовости.ПриЗакрытииСоединения" - см. ПриЗакрытииСоединения
//	* ПриПодтвержденииОтправкиСообщения     - Строка - см. ПриПодтвержденииОтправкиСообщения - Служит для фиксации результата отправки
//	* ПриПолученииОшибки                    - Строка - см. ПриПолученииОшибки - Обработка ошибки полученной с шины, до закрытие соединения  
//	* ПриПолученииСообщения    - Строка - см. ПриПолученииСообщения 
Функция НовыеПараметрыПодключения() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Сервер", "");
	Результат.Вставить("Путь", "/ws");
	Результат.Вставить("Порт", 15674);
	Результат.Вставить("ПереподключениеПриЗакрытииСоединения", Ложь);
	Результат.Вставить("ЗащищенноеСоединение", Ложь);
	Результат.Вставить("ПоддерживаемыеВерсии", "1.0,1.1,1.2");
	Результат.Вставить("Пользователь", "guest");
	Результат.Вставить("Пароль", "guest");
	Результат.Вставить("ВиртуальныйХост", "/");
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("Таймаут", 300);
	Результат.Вставить("ЧастотаПульса", 3000); // время поддержки активности соединения
	
	Результат.Вставить("ПриОткрытииСоединения", "");
	Результат.Вставить("ПриОшибкеСоединения", "");
	Результат.Вставить("ПриЗакрытииСоединения", "");
	Результат.Вставить("ПриПодтвержденииОтправкиСообщения", "");
	Результат.Вставить("ПриПолученииОшибки", "");
	Результат.Вставить("ПриПолученииСообщения", "");

	ИдентификаторБазы = Отчетность24БРО.ИдентификаторБазы();
	ИдентификаторНаШине = ВРЕГ(ОбщегоНазначения.КонтрольнаяСуммаСтрокой(ИдентификаторБазы));
	Результат.Вставить("ИдентификаторБазы", ИдентификаторБазы);
	Результат.Вставить("ИдентификаторНаШине", ИдентификаторНаШине);

	Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
		Результат.Вставить("ОбластьДанных", РаботаВМоделиСервиса.ЗначениеРазделителяСеанса());
	Иначе
		Результат.Вставить("ОбластьДанных", 0);
	КонецЕсли;
	
	
	Возврат Результат;

КонецФункции

