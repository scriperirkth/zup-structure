// Конструктор параметров для сообщения для отправки
//
// Возвращаемое значение:
//   Структура:
//     * Идентификатор      - Строка - уникальный идентификатор сообщения (по умолчанию пустой).
//     * ТипСодержимого     - Строка - MIME-тип содержимого сообщения (по умолчанию "text/plain").
//     * ТочкаОбмена        - Строка - amq.direct, amq.fanout, amq.headers, amq.match, amq.topic и т.п. (Binding from)	 
//     * КлючМаршрутизации  - Строка - ключ маршрутизации сообщения (Routing key) 
//     * Заголовки          - Соответствие Из КлючИЗначение:
//     ** Ключ              - Строка
//     ** Значение          - Строка
//     * Тело               - Строка - содержимое сообщения.
Функция ПараметрыСообщенияДляОтправки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("ТипСодержимого", "text/plain");
	Результат.Вставить("ТочкаОбмена", "");
	Результат.Вставить("КлючМаршрутизации", "");
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("Тело", "");
	
	Возврат Результат;
	
КонецФункции

// Выполняет попытку отправки накопленных сообщений
// 
// Параметры:
//  Соединение - WebSocketКлиентСоединение 
Процедура ОтправитьСообщения(Соединение)
	
	СохраненныеПараметры = СохраняемыеПараметрыСокета(Соединение.Ключ);

	Для Каждого ПараметрыБазы Из СохраненныеПараметры Цикл
		Для Каждого Сообщение Из ПараметрыБазы.СообщенияДляОтправки Цикл
			ПараметрыСообщения = ПараметрыСообщенияДляОтправки();
			ПараметрыСообщения.Идентификатор = Сообщение.ИдентификаторОтправки;
			ПараметрыСообщения.КлючМаршрутизации = Сообщение.КлючМаршрутизации;
			ПараметрыСообщения.Заголовки = Сообщение.Заголовки;
			ПараметрыСообщения.Тело = Сообщение.ТекстСообщения;
			ПараметрыСообщения.ТочкаОбмена = Сообщение.ТочкаОбмена;

			ТекстКоманды = КомандаОтправкиСообщения(ПараметрыСообщения);
			ОтправитьСообщение(Соединение, ТекстКоманды);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает структуру описывающую вариант подписки на сообщения
// 
// Параметры:
//  Ключ - Строка - Ключ маршрутизации (RoutingKey)
//  ТипПриемника - Строка - См. ТипыПриемниковОбработкиСообщений()
//  ТипПодтвержденияПолучения - Строка - Тип подтверждения получения сообщения
// 										 auto (все полученные сообщения сразу считаются подтвержденными)
// 										 client (необходимо подтвердить все последние полученные сообщения)
// 										 client-individual (необходимо подтвердить получение каждого сообщения)
// Возвращаемое значение:
//  Структура - Подписка:
// * Идентификатор - Строка - 
// * Ключ - Строка - 
// * ТипПриемника - Строка
// * ТипПодтвержденияПолучения - Строка 
Функция Подписка(Ключ, ТипПриемника = "topic", ТипПодтвержденияПолучения = "auto") 
	
	Результат = Новый Структура( );
	Результат.Вставить("Идентификатор", Строка(Ключ));
	Результат.Вставить("Ключ", Строка(Ключ));
	Результат.Вставить("ТипПриемника", Строка(ТипПриемника));
	Результат.Вставить("ТипПодтвержденияПолучения", ТипПодтвержденияПолучения);
	
	Возврат Результат;
КонецФункции

// Возваращает перечень типы приемников обработки сообщений на основе которых происходит их маршрутизация по получателям
// 
// Возвращаемое значение:
//  Структура:
// * ПоКлючу      - Строка - 
// * ДляВсем      - Строка - 
// * ПоЗаголовкам - Строка - 
// * ПоШаблону    - Строка - 
Функция ТипыПриемниковОбработкиСообщений() 

	Результат = Новый Структура();

	Результат.Вставить("ПоКлючу",      "direct");  // Маршрутизация происходит по точному совпадению ключа маршрутизации 
	                                               // сообщения с ключом привязки. 
	                                               // Если ключ не совпадает ни с одной привязкой, 
	                                               // сообщение отбрасывается 
	                                               // (или перенаправляется в обменник мёртвых писем, если он настроен)

	Результат.Вставить("ДляВсем",      "fanout");  // Широковещательная рассылка копии каждого сообщения во все 
	                                               // привязанные к нему очереди, полностью игнорируя ключ маршрутизации.

	Результат.Вставить("ПоЗаголовкам", "headers"); // Маршрутизация осуществляется на основе заголовков сообщения 
	                                               // (пар ключ-значение), а не ключа маршрутизации. 
	                                               // При привязке очереди задаётся набор пар ключ-значение 
	                                               // и режим совпадения (x-match):
	                                               //   all — должны совпасть все указанные заголовки.
	                                               //   any — должен совпасть хотя бы один из указанных заголовков

	Результат.Вставить("ПоШаблону",    "topic");   // Маршрутизация основана на сопоставлении шаблонов 
	                                               // с подстановочными знаками. 
	                                               // Ключи маршрутизации и ключи привязки представляют собой 
	                                               // последовательности слов, разделённых точками. 
	                                               // Специальные символы:
	                                               // * (звездочка) — соответствует ровно одному слову.
	                                               // # (решётка) — соответствует нулю или более словам. 

	Возврат Результат;
	
КонецФункции


// Возвращает перечень команд с сервера
// 
// Возвращаемое значение:
//  Структура:
// * ПодключениеВыполнено  - Строка - 
// * ВходящееСообщение     - Строка - 
// * ПодтверждениеОтправки - Строка - 
// * Ошибка                - Строка - 
Функция КомандыСервера() 
	
	Результат = Новый Структура();
	Результат.Вставить("ПодключениеВыполнено",  "CONNECTED");
	Результат.Вставить("ВходящееСообщение",     "MESSAGE");
	Результат.Вставить("ПодтверждениеОтправки", "RECEIPT");
	Результат.Вставить("Ошибка", "ERROR");
	
	Возврат Результат;
	
КонецФункции

// Возвращает перечень команд для отправки на сервер
// 
// Возвращаемое значение:
//  Структура - Команды клиента:
// * ОтправитьСообщение             - Строка - 
// * ОформитьПодпискуНаСообщения    - Строка - 
// * ОтменитьПодпискуНаСообщения    - Строка - 
// * НачатьТранзакцию               - Строка - 
// * ЗафиксироватьТранзакцию        - Строка - 
// * ОтменитьТранзакцию             - Строка - 
// * ПодтвердитьПолучениеСообщения  - Строка - 
// * ОтказатьсяОтПолученияСообщения - Строка - 
// * Отключиться                    - Строка - 
// * Подключиться                   - Строка - 
Функция КомандыКлиента() 
	
	Результат = Новый Структура();
	Результат.Вставить("ОтправитьСообщение",             "SEND");
	Результат.Вставить("ОформитьПодпискуНаСообщения",    "SUBSCRIBE");
	Результат.Вставить("ОтменитьПодпискуНаСообщения",    "UNSUBSCRIBE");
	Результат.Вставить("НачатьТранзакцию",               "BEGIN");
	Результат.Вставить("ЗафиксироватьТранзакцию",        "COMMIT");
    Результат.Вставить("ОтменитьТранзакцию",             "ABORT");
    Результат.Вставить("ПодтвердитьПолучениеСообщения",  "ACK");
    Результат.Вставить("ОтказатьсяОтПолученияСообщения", "NACK");
    Результат.Вставить("Отключиться",                    "DISCONNECT");
    Результат.Вставить("Подключиться",                   "CONNECT");

	Возврат Результат;

КонецФункции

// Возвращает подписки сокета
// 
// Параметры:
//  Ключ - Строка
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение:
//	* Ключ - Строка - Имя подписки
//	* Значение - см. ПараметрыПодписки
Функция ОформленныеПодписки(Ключ)
	
	Результат = Новый Соответствие(); // см. ОформленныеПодписки 

	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Отчетность24БРОПараметрыШины.ИдентификаторБазы КАК ИдентификаторБазы,
			|	Отчетность24БРОПараметрыШины.ОбластьДанныхВспомогательныеДанные КАК ОбластьДанных
			|ИЗ
			|	РегистрСведений.Отчетность24БРОПараметрыШины КАК Отчетность24БРОПараметрыШины
			|ГДЕ
			|	Отчетность24БРОПараметрыШины.Ключ = &Ключ";
		
		Запрос.УстановитьПараметр("Ключ", Ключ);
		
		РезультатЗапроса = Запрос.Выполнить();

		СтруктураВыборки = Новый Структура();
		СтруктураВыборки.Вставить("ИдентификаторБазы", "");
		СтруктураВыборки.Вставить("ОбластьДанных", 0);
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураВыборки, ВыборкаДетальныеЗаписи);
			
			ИмяПодписки = ИмяПодписки(СтруктураВыборки.ИдентификаторБазы);
			Результат.Вставить(ИмяПодписки, ПараметрыПодписки(СтруктураВыборки));
			
		КонецЦикла;
		
	Исключение
		ЗаписьЖурналаРегистрации(
			"ШинаRabbitMQ",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Возвращает параметры подписки
// 
// Параметры: 
//  Параметры - см. НовыеПараметрыПодключения
// 
// Возвращаемое значение:
//  Структура:
// * ИдентификаторБазы - Строка - 
// * ОбластьДанных     - Число - 
Функция ПараметрыПодписки(Параметры)
	Результат = Новый Структура();
	Результат.Вставить("ИдентификаторБазы", Параметры.ИдентификаторБазы);
	Результат.Вставить("ОбластьДанных", Параметры.ОбластьДанных);
	Возврат Результат;
КонецФункции

// Возвращает имя подписки
// 
// Параметры:
//  ИдентификаторБазы - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ИмяПодписки(ИдентификаторБазы)
	ИдентификаторНаШине = ВРЕГ(ОбщегоНазначения.КонтрольнаяСуммаСтрокой(ИдентификаторБазы)); 
	Результат = "db." + ИдентификаторНаШине; // получение сообщений адресованных этой базе
	Возврат Результат;
КонецФункции

// Сохраняет подписку в базе для использования при переподключении
// 
// Параметры:
//  Параметры  - см. НовыеПараметрыПодключения
//  Соединение - WebSocketКлиентСоединение
Процедура ДобавитьПодписку(Параметры, Соединение = Неопределено)
	
	
	КлючСоединения = КлючСоединения(Параметры);
	ОформленныеПодписки = ОформленныеПодписки(КлючСоединения);
	ИмяПодписки = ИмяПодписки(Параметры.ИдентификаторБазы); // получение сообщений адресованных этой базе

	Если ОформленныеПодписки.Получить(ИмяПодписки) = Неопределено Тогда
		ОформленныеПодписки.Вставить(ИмяПодписки, ПараметрыПодписки(Параметры));

		УстановитьПривилегированныйРежим(Истина);

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(
				Метаданные.РегистрыСведений.Отчетность24БРОПараметрыШины.ПолноеИмя());
			ЭлементБлокировки.УстановитьЗначение("Ключ", КлючСоединения);
			ЭлементБлокировки.УстановитьЗначение("ИдентификаторБазы", Параметры.ИдентификаторБазы);
			Блокировка.Заблокировать();

			Запись = РегистрыСведений.Отчетность24БРОПараметрыШины.СоздатьМенеджерЗаписи();
			Запись.Ключ = КлючСоединения;
			Запись.ИдентификаторБазы = Параметры.ИдентификаторБазы;
			Запись.Записать();

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
		КонецПопытки;

		УстановитьПривилегированныйРежим(Ложь);

		Если Соединение <> Неопределено И Не СоединениеЗакрыто(Соединение) Тогда
			Подписка = Подписка(ИмяПодписки, ТипыПриемниковОбработкиСообщений().ПоШаблону, "auto"); // получение сообщений адресованных этой базе
			ОтправитьСообщение(Соединение, КомандаПодпискаНаПолучениеСообщений(Подписка));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает строку подключения
// 
// Параметры:
//  Параметры - см. НовыеПараметрыПодключения
// 
// Возвращаемое значение:
//  Строка 
Функция СтрокаПодключения(Параметры)

	ТипСоединения = ?(Параметры.ЗащищенноеСоединение, "wss", "ws");
	СтрокаПодключения = СтрШаблон("%1://%2:%3%4",
		ТипСоединения, Параметры.Сервер, Формат(Параметры.Порт, "ЧГ=0"), Параметры.Путь);
			
	Возврат СтрокаПодключения;
	
КонецФункции

// Возвращает ключ соединения
// 
// Параметры:
//  Параметры - см. НовыеПараметрыПодключения
// 
// Возвращаемое значение:
//  Строка 
Функция КлючСоединения(Параметры) Экспорт

	СтрокаПодключения = СтрокаПодключения(Параметры);
	
	Результат = "RabbitMQ" + ОбщегоНазначения.КонтрольнаяСуммаСтрокой(
		СтрокаПодключения + Параметры.Пользователь + Параметры.Пароль); //  Для создания соединения для каждой области добавить Строка(Параметры.ОбластьДанных)
	
	Возврат Результат;
	
КонецФункции

// Возвращает имена пользовательских приложений.
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция ИменаПользовательскихПриложений()
	
	Результат = Новый Массив; // Массив Из Строка
	Результат.Добавить("1CV8"); // идентификатор приложения "1С:Предприятие";
	Результат.Добавить("1CV8C"); // идентификатор приложения тонкого клиента "1С:Предприятие";
	Результат.Добавить("WebClient");
	Результат.Добавить("WebServerExtension"); // идентификатор приложения модуля расширения веб-сервера;

	Возврат Результат;
	
КонецФункции

// Возвращает необходимость прервать соединение
// 
// Возвращаемое значение:
//  Булево
Функция ТребуетсяЗакрытиеВебСокета()
	
	УстановитьПривилегированныйРежим(Истина);

	ЕстьЗапущенныйКонфигуратор = Ложь;
	ЕстьАктивныеПользователи = Ложь;
	ИменаПользовательскихПриложений = ИменаПользовательскихПриложений();
	АктивныеСоединения = ПолучитьСеансыИнформационнойБазы();
	Для Каждого АктивноеСоединение Из АктивныеСоединения Цикл
		Если Не ЕстьАктивныеПользователи 
			И ИменаПользовательскихПриложений.Найти(АктивноеСоединение.ИмяПриложения) <> Неопределено
			И АктивноеСоединение.Пользователь.УникальныйИдентификатор 
				<> ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор() Тогда
			
			ЕстьАктивныеПользователи = Истина;
			Прервать;
			
		КонецЕсли;
		
		Если АктивноеСоединение.ИмяПриложения = "Designer" Тогда
			ЕстьЗапущенныйКонфигуратор = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьЗапущенныйКонфигуратор И Не ЕстьАктивныеПользователи;
	
КонецФункции

// Отправляет сообщение в шину
// 
// Параметры:
//  Соединение     - WebSocketКлиентСоединение
//  ТекстСообщения - Строка
// 
Процедура ОтправитьСообщение(Соединение, ТекстСообщения)

	Если СоединениеЗакрыто(Соединение) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Соединение.ОтправитьСообщение(ТекстСообщения);
	Исключение
		Состояние =  Соединение.ПолучитьСостояние(); // СостояниеWebSocketСоединения
		СоединениеЗакрыто = СостояниеWebSocketСоединения.Закрыто;
		Если Состояние = СоединениеЗакрыто Тогда
			ЗаписьЖурналаРегистрации(
				"ШинаRabbitMQ", 
				УровеньЖурналаРегистрации.Информация, , , 
				СтрШаблон("Не удалось отправить сообщение 
				|Тело: '%1'
				|Статус соединения - %2", Строка(Состояние)));
		КонецЕсли; 
	КонецПопытки;
КонецПроцедуры

// Возвращает статус закрытого соединения
// 
// Параметры:
//  Соединение     - WebSocketКлиентСоединение
// 
// Возвращаемое значение:
//  Булево
Функция СоединениеЗакрыто(Соединение) 
	
	Если ТипЗнч(Соединение) = Тип("WebSocketКлиентСоединение") Тогда

		Состояние =  Соединение.ПолучитьСостояние(); // СостояниеWebSocketСоединения
		СоединениеЗакрыто = СостояниеWebSocketСоединения.Закрыто;
		
		Возврат Состояние = СоединениеЗакрыто;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Сохранение параметров сокета в параметрах сеанса
// 
// Параметры:
//  Соединение        - WebSocketКлиентСоединение
//  РазрешитьЗакрытие - Булево
Процедура РазрешитьЗакрытиеСокета(Соединение, РазрешитьЗакрытие)
	
	ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить("ИнтеграцияСОтчетность24.Соединение", Соединение.Ключ, 
		РазрешитьЗакрытие);
	
КонецПроцедуры

// Сохранение параметров сокета в базе
// 
// Параметры:
//  КлючСоединения - Строка
//  СохраняемыеПараметрыСокета - см. СохраняемыеПараметрыСокета
Процедура ЗаписатьСохраняемыеПараметрыСокета(КлючСоединения, СохраняемыеПараметрыСокета = Неопределено)
	
	Если СохраняемыеПараметрыСокета = Неопределено Тогда
		СохраняемыеПараметрыСокета = СохраняемыеПараметрыСокета(КлючСоединения);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	НачатьТранзакцию();
	Попытка
		ИмяОбластьДанныхВспомогательныеДанные = "ОбластьДанныхВспомогательныеДанные";
		Для Каждого ПараметрыБазы Из СохраняемыеПараметрыСокета Цикл

			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(
				Метаданные.РегистрыСведений.Отчетность24БРОПараметрыШины.ПолноеИмя());
			ЭлементБлокировки.УстановитьЗначение("Ключ", КлючСоединения);
			ЭлементБлокировки.УстановитьЗначение("ИдентификаторБазы", ПараметрыБазы.ИдентификаторБазы);
			Блокировка.Заблокировать();

			Запись = РегистрыСведений.Отчетность24БРОПараметрыШины.СоздатьМенеджерЗаписи();
			Запись.Ключ = КлючСоединения;
			Запись.ИдентификаторБазы = ПараметрыБазы.ИдентификаторБазы;
			Если Не (РаботаВМоделиСервиса.РазделениеВключено()
				И РаботаВМоделиСервиса.ДоступноИспользованиеРазделенныхДанных()) Тогда
				Запись[ИмяОбластьДанныхВспомогательныеДанные] = ПараметрыБазы.ОбластьДанных;
			КонецЕсли;
			Запись.СообщенияДляОтправки = Новый ХранилищеЗначения(ПараметрыБазы.СообщенияДляОтправки);
			Запись.Записать();

		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Контруктор структуры сообщения для отправки.
// 
// Параметры:
//  КлючМаршрутизации - Строка
//  ТекстСообщения    - Строка
//  ТочкаОбмена       - Строка
//  Заголовки         - Соответствие из КлючИЗначение - заголовки для маршрутизации:
// * Ключ     - Строка
// * Значение - Строка 
// 
// Возвращаемое значение:
//  Структура - Новое сообщение для отправки:
// * ИдентификаторОтправки - Строка
// * КлючМаршрутизации     - Строка
// * ТочкаОбмена           - Строка
// * ТекстСообщения        - Строка
// * Заголовки             - Соответствие из КлючИЗначение - заголовки для маршрутизации:
// ** Ключ     - Строка
// ** Значение - Строка 
Функция НовоеСообщениеДляОтправки(КлючМаршрутизации, ТекстСообщения = "", ТочкаОбмена = "amq.topic", 
	Заголовки = Неопределено) Экспорт

	СтруктураСообщения = Новый Структура();
	СтруктураСообщения.Вставить("ИдентификаторБазы", Отчетность24БРО.ИдентификаторБазы());
	СтруктураСообщения.Вставить("Сообщение", ТекстСообщения);
	
	Результат = Новый Структура();
	Результат.Вставить("ИдентификаторОтправки", Строка(Новый УникальныйИдентификатор()));
	Результат.Вставить("КлючМаршрутизации", КлючМаршрутизации);
	Результат.Вставить("ТочкаОбмена", ТочкаОбмена);
	Результат.Вставить("ТекстСообщения", ОбщегоНазначения.ЗначениеВJSON(СтруктураСообщения));
	Если ТипЗнч(Заголовки) = Тип("Соответствие") Тогда
		Результат.Вставить("Заголовки", Заголовки);
	Иначе
		Результат.Вставить("Заголовки", Новый Соответствие);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Возвращает сохраняемые параметры сокета из базы
// 
// Параметры:
//  КлючСоединения - Строка
// 
// Возвращаемое значение:
//  Массив Из Структура:
//  * ИдентификаторБазы    - Строка
//  * ОбластьДанных        - Число
// 	* СообщенияДляОтправки - Массив Из см. НовоеСообщениеДляОтправки
Функция СохраняемыеПараметрыСокета(КлючСоединения)
	
	Результат = Новый Массив(); // см. СохраняемыеПараметрыСокета

	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Отчетность24БРОПараметрыШины.ИдентификаторБазы КАК ИдентификаторБазы,
			|	Отчетность24БРОПараметрыШины.ОбластьДанныхВспомогательныеДанные КАК ОбластьДанных,
			|	Отчетность24БРОПараметрыШины.СообщенияДляОтправки КАК СообщенияДляОтправкиХранилище
			|ИЗ
			|	РегистрСведений.Отчетность24БРОПараметрыШины КАК Отчетность24БРОПараметрыШины
			|ГДЕ
			|	Отчетность24БРОПараметрыШины.Ключ = &Ключ";
		
		Запрос.УстановитьПараметр("Ключ", КлючСоединения);
		
		РезультатЗапроса = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СтруктураВыборки = Новый Структура();
			СтруктураВыборки.Вставить("ИдентификаторБазы", "");
			СтруктураВыборки.Вставить("ОбластьДанных", 0);
			СтруктураВыборки.Вставить("СообщенияДляОтправкиХранилище", Новый ХранилищеЗначения(Новый Массив()));
			СтруктураВыборки.Вставить("СообщенияДляОтправки", Новый Массив());

			ЗаполнитьЗначенияСвойств(СтруктураВыборки, ВыборкаДетальныеЗаписи);
			
			МассивСообщений =  СтруктураВыборки.СообщенияДляОтправкиХранилище.Получить();
			Если ТипЗнч(МассивСообщений) = Тип("Массив") Тогда
				СтруктураВыборки.СообщенияДляОтправки = МассивСообщений;
			КонецЕсли;
			СтруктураВыборки.Удалить("СообщенияДляОтправкиХранилище");
			
			Результат.Добавить(СтруктураВыборки);
			
		КонецЦикла;
		
	Исключение
		ЗаписьЖурналаРегистрации(
			"ШинаRabbitMQ",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

	Возврат Результат;
	
КонецФункции

// Возвращает сохраняемые параметры соединения
// 
// Параметры:
//  КлючСоединения - Строка
// 
// Возвращаемое значение:
//  Булево - Признак для блокировки переподключения сокета при закрытии
Функция РазрешеноЗакрытиеСоединения(КлючСоединения)
	
	Результат =  ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить("ИнтеграцияСОтчетность24.Соединение", 
		КлючСоединения, Ложь);
	
	Возврат Результат;
	
КонецФункции

// Возвращает текст сообщения в формате STOMP
// 
// Параметры:
//  СообщениеSTOMP - см. СообщениеSTOMP
// 
// Возвращаемое значение:
//  Строка
Функция ТекстСообщенияВФорматеSTOMP(СообщениеSTOMP)
	
	Заголовки = "";
	
	Для Каждого КлючЗначение Из СообщениеSTOMP.Заголовки Цикл
		
		Заголовки = СтрШаблон("%1:%2%3%4", КлючЗначение.Ключ, ЭкранироватьСимволы(КлючЗначение.Значение), 
										   Символы.ПС, Заголовки);
	КонецЦикла;

	Результат = СообщениеSTOMP.Команда + Символы.ПС + Заголовки;
	
	Результат = СтрШаблон("%1%2%3%4", Результат, Символы.ПС, СообщениеSTOMP.Тело, Символ(0));

	Возврат Результат;
	
КонецФункции

// Структура сообщения STOMP
// 
// Параметры:
//  Данные - Неопределено, Строка - Текст сообщения в формате STOMP
// 
// Возвращаемое значение:
//  Структура:
// * Команда   - Строка 
// * Заголовки - Соответствие из КлючИЗначение:
// ** Ключ     - Строка
// ** Значение - Строка 
// * Тело      - Строка 
Функция СообщениеSTOMP(Знач Данные = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Команда", "");
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("Тело", "");

	Если ТипЗнч(Данные) = Тип("Строка") Тогда
		
		Данные = СтрЗаменить(Данные, Символ(0), "");
		
		ПозицияЗавершенияКоманды = СтрНайти(Данные, Символы.ПС);
		Команда = Лев(Данные, ПозицияЗавершенияКоманды - 1);
		Если Не ЗначениеЗаполнено(Команда) Тогда
			Возврат Результат;
		КонецЕсли;

		Результат.Команда = Команда;
		
		Данные = Сред(Данные, СтрДлина(Результат.Команда) + 2);
		ПозицияЗавершенияЗаголовков = СтрНайти(Данные, Символы.ПС + Символы.ПС);
		СтрокаЗаголовков = Лев(Данные, ПозицияЗавершенияЗаголовков - 1);
		
		Заголовки = СтрРазделить(СтрокаЗаголовков, Символы.ПС, Ложь);
		Для Каждого Заголовок Из Заголовки Цикл
			ДанныеЗаголовка = СтрРазделить(Заголовок, ":", Ложь);
			Результат.Заголовки.Вставить(СокрЛП(ДанныеЗаголовка[0]), СокрЛП(ДанныеЗаголовка[1]));
		КонецЦикла;
		
		РазмерТела = СтрДлина(Данные) - (ПозицияЗавершенияЗаголовков + 2);
		Результат.Тело = Сред(Данные, ПозицияЗавершенияЗаголовков + 2, РазмерТела);
		
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Экранирует символы для передачи в шину
// 
// Параметры:
//  Значение - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ЭкранироватьСимволы(Значение)
	
	Результат = Значение;
	
	ЭкранируемыеСимволы = Новый Соответствие;
	ЭкранируемыеСимволы.Вставить("\", "\\");
	ЭкранируемыеСимволы.Вставить(":", "\c");
	ЭкранируемыеСимволы.Вставить(Символ(10), "\n");
	ЭкранируемыеСимволы.Вставить(Символ(13), "\r");
	
	Для Каждого КлючЗначение Из ЭкранируемыеСимволы Цикл
		Результат = СтрЗаменить(Результат, КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
