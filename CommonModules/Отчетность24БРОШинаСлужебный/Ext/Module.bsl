// Конструктор строки команды подключения к серверу RabbitMQ
// 
// Параметры:
//  ПараметрыПодключения - см. НовыеПараметрыПодключения
//
// Возвращаемое значение:
//	 Строка
Функция КомандаПодключения(ПараметрыПодключения) Экспорт
	
	СообщениеSTOMP = СообщениеSTOMP();
	СообщениеSTOMP.Команда = КомандыКлиента().Подключиться;
	СообщениеSTOMP.Заголовки.Вставить("accept-version",	ПараметрыПодключения.ПоддерживаемыеВерсии);
	СообщениеSTOMP.Заголовки.Вставить("login",			ПараметрыПодключения.Пользователь);
	СообщениеSTOMP.Заголовки.Вставить("passcode",		ПараметрыПодключения.Пароль);
	СообщениеSTOMP.Заголовки.Вставить("host",			ПараметрыПодключения.ВиртуальныйХост);
	СообщениеSTOMP.Заголовки.Вставить("heart-beat",		СтрШаблон("%1,%1", Формат(ПараметрыПодключения.ЧастотаПульса,"ЧГ=0")));
	
	Результат = ТекстСообщенияВФорматеSTOMP(СообщениеSTOMP);

