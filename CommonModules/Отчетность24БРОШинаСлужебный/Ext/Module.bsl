// Конструктор строки команды отправки сообщения
//
// Параметры:
//	 Параметры - см. ПараметрыСообщенияДляОтправки 
//
// Возвращаемое значение:
//	 Строка
Функция КомандаОтправкиСообщения(Параметры) Экспорт
	
	СообщениеSTOMP = СообщениеSTOMP();	
	СообщениеSTOMP.Команда = КомандыКлиента().ОтправитьСообщение;
	СообщениеSTOMP.Заголовки.Вставить("receipt",		Параметры.Идентификатор);
	СообщениеSTOMP.Заголовки.Вставить("content-type",	Параметры.ТипСодержимого);
	СообщениеSTOMP.Заголовки.Вставить("destination",	СтрШаблон("/exchange/%1/%2", Параметры.ТочкаОбмена,
																					 Параметры.КлючМаршрутизации));
		
	Для Каждого КлючЗначение Из Параметры.Заголовки Цикл
		СообщениеSTOMP.Заголовки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение); 
	КонецЦикла;
	
	СообщениеSTOMP.Тело = Параметры.Тело;
	
	Результат = ТекстСообщенияВФорматеSTOMP(СообщениеSTOMP);

	Возврат Результат;
	
КонецФункции

