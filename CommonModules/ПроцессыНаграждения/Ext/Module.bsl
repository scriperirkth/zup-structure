	Возврат "4c18a552-3f25-440b-b276-696cb9fe699a";
КонецФункции

Функция ОписаниеПрофиляПроцессыНаграждения(ПраваНаИнтерфейс = Ложь)
	
	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Идентификатор = ИдентификаторПрофиляПроцессыНаграждения();
	ОписаниеПрофиля.Наименование  = НСтр("ru = 'Управление процессами награждения'");
	
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляОбязательныеРоли(ОписаниеПрофиля);
	
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеАрхиваФизическихЛиц", 				"ЗарплатаКадрыКорпоративнаяПодсистемы.АрхивФизическихЛиц");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеБезПросмотраНачисленияУдержанияПоказатели");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеБезПросмотраПлановыхНачислений");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДанныхОбОбразованииФизическихЛиц");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДанныхОТрудовойДеятельности");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДанныхСотрудников");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДанныхСотрудниковРасширенная");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДанныхФизическихЛицЗарплатаКадры");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДанныхФизическихЛицЗарплатаКадрыРасширенная");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДисциплинарныхВзысканий",				"ЗарплатаКадрыКорпоративнаяПодсистемы.ДисциплинарныеВзыскания");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДополнительныхСведений",				"СтандартныеПодсистемы.Свойства");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеКадровогоСостоянияРасширенная");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеКлассныхЧиновРангов", "ЗарплатаКадрыПриложения.ГосударственнаяСлужба.КлассныеЧиныРанги");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеПродолжительностиДоговоров");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеПрофессийФизическихЛиц",				"ЗарплатаКадрыПриложения.КадровыйУчет.ОбразованияФизическихЛиц");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеСведенийДляРеестраГосслужащих",		"ЗарплатаКадрыКорпоративнаяПодсистемы.РеестрГосслужащих");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеСводныхДанныхФизическихЛиц", "ЗарплатаКадрыПриложения.КадровыйУчет.СводныеДанныеФизическихЛиц");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеСемейныхПоложенийФизическихЛиц",		"ЗарплатаКадрыПриложения.КадровыйУчет.СемейныеПоложенияФизическихЛиц");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеСостоянийСотрудников");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеСтатистикиПерсоналаРасширенная");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеШтатногоРасписания");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ИзменениеДополнительныхСведений",			"СтандартныеПодсистемы.Свойства");
	
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ДобавлениеИзменениеДокументовНаграждения",	"ЗарплатаКадрыКорпоративнаяПодсистемы.ПроцессыНаграждения");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ДобавлениеИзменениеНаград",					"ЗарплатаКадрыКорпоративнаяПодсистемы.ПроцессыНаграждения");

	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ПодсистемаКадры", "ЗарплатаКадрыПриложения.ЗарплатаКадрыКомандныйИнтерфейс");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ИнтерфейсРабочегоСтолаСпециалистПоНаграждениям");

	ОписаниеПрофиля.ВидыДоступа.Добавить("Организации");
	ОписаниеПрофиля.ВидыДоступа.Добавить("ГруппыФизическихЛиц");
	
	Возврат ОписаниеПрофиля;
	
КонецФункции

#Область ПроведениеДокументовНаграждения

Процедура ЗаполнитьДанныеДляПроведенияДокументаНаграждения(ДанныеДляПроведения, ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ДанныеДокументаНагражденияПомещеныВМенеджерВременныхТаблиц(Запрос, ДокументСсылка) Тогда
		
		ДобавитьДанныеДляПроведенияНаградыФизическихЛиц(Запрос, ДанныеДляПроведения);
		ДобавитьДанныеДляПроведенияПредставленияКНаградам(Запрос, ДанныеДляПроведения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьНаградыФизическихЛиц(ДокументСсылка) Экспорт
	РегистрыСведений.НаградыФизическихЛиц.ОчиститьНаградыФизическихЛиц(ДокументСсылка);
КонецПроцедуры

Процедура СформироватьДвиженияДокументовНаграждения(ДокументСсылка, Движения, ДанныеДляПроведения) Экспорт
	
	ОчиститьНаградыФизическихЛиц(ДокументСсылка);
	
	Если ДанныеДляПроведения.Свойство("СтатусыПредставленийКНаградам") Тогда
		
		Для каждого СтрокаДанныхДляПроведения Из ДанныеДляПроведения.СтатусыПредставленийКНаградам Цикл
			СтрокаДвижений = Движения.СтатусыПредставленийКНаградам.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДвижений, СтрокаДанныхДляПроведения);
		КонецЦикла;
		
		Если Движения.СтатусыПредставленийКНаградам.Количество() > 0 Тогда
			Движения.СтатусыПредставленийКНаградам.Записывать = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеДляПроведения.Свойство("НаградыФизическихЛиц") Тогда
		
		РегистрыСведений.НаградыФизическихЛиц.ЗарегистрироватьНаградыФизическихЛиц(ДанныеДляПроведения.НаградыФизическихЛиц, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьДанныеДляПроведенияНаградыФизическихЛиц(Запрос, ДанныеДляПроведения)

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК ДокументРегистратор,
	|	ДанныеДокумента.НаименованиеПервичногоДокумента КАК НаименованиеПриказа,
	|	ДанныеДокумента.НомерПервичногоДокумента КАК НомерПриказа,
	|	ДанныеДокумента.ДатаПервичногоДокумента КАК ДатаПриказа,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.Награда КАК Награда,
	|	ДанныеДокумента.ФизическоеЛицо КАК ФизическоеЛицо,
	|	МАКСИМУМ(ЕСТЬNULL(НаградыФизическихЛиц.НомерПоПорядку, 0)) + ДанныеДокумента.НомерСтроки КАК НомерПоПорядку
	|ИЗ
	|	ВТДанныеДокумента КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаградыФизическихЛиц КАК НаградыФизическихЛиц
	|		ПО ДанныеДокумента.ФизическоеЛицо = НаградыФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.НаименованиеПервичногоДокумента,
	|	ДанныеДокумента.НомерПервичногоДокумента,
	|	ДанныеДокумента.ДатаПервичногоДокумента,
	|	ДанныеДокумента.Номер,
	|	ДанныеДокумента.Дата,
	|	ДанныеДокумента.Награда,
	|	ДанныеДокумента.ФизическоеЛицо,
	|	ДанныеДокумента.НомерСтроки";
	
	ДанныеДокументаДляПроведения = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаДанныхДляПроведения Из ДанныеДокументаДляПроведения Цикл
		СтрокаДанныхДляПроведения.НомерПриказа = ЗарплатаКадрыОтчеты.НомерНаПечать(СтрокаДанныхДляПроведения.Номер, СтрокаДанныхДляПроведения.НомерПриказа);
		СтрокаДанныхДляПроведения.ДатаПриказа = ЗарплатаКадрыОтчеты.ДатаНаПечать(СтрокаДанныхДляПроведения.Дата, СтрокаДанныхДляПроведения.ДатаПриказа);
		СтрокаДанныхДляПроведения.НаименованиеПриказа = ?(ЗначениеЗаполнено(СтрокаДанныхДляПроведения.НаименованиеПриказа), СтрокаДанныхДляПроведения.НаименованиеПриказа,
															НСтр("ru='Приказ о поощрении сотрудников'"));
	КонецЦикла;

	ДанныеДляПроведения.Вставить("НаградыФизическихЛиц", ДанныеДокументаДляПроведения);
	
КонецПроцедуры

Процедура ДобавитьДанныеДляПроведенияПредставленияКНаградам(Запрос, ДанныеДляПроведения)
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ДанныеДокумента.Дата, ДЕНЬ), СЕКУНДА, 2) КАК Период,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.НомерПервичногоДокумента КАК НомерДокумента,
	|	ДанныеДокумента.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ДанныеДокумента.Награда КАК Награда,
	|	ДанныеДокумента.Статус КАК Статус
	|ИЗ
	|	ВТДанныеДокумента КАК ДанныеДокумента";
	
	ДанныеДокументаДляПроведения = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаДанныхДляПроведения Из ДанныеДокументаДляПроведения Цикл
		СтрокаДанныхДляПроведения.НомерДокумента = ЗарплатаКадрыОтчеты.НомерНаПечать(СтрокаДанныхДляПроведения.Номер, СтрокаДанныхДляПроведения.НомерДокумента);
	КонецЦикла;
	
	ДанныеДляПроведения.Вставить("СтатусыПредставленийКНаградам", ДанныеДокументаДляПроведения);
	
КонецПроцедуры

#КонецОбласти

Процедура ДополнитьФормуСправочникаНаграды(Форма, ГруппаРодитель) Экспорт
	
	Если Не ИспользуютсяПроцессыНаграждения() Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьПравоРедактирования = ПравоДоступа("Редактирование", Метаданные.Справочники.Награды);
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ФлажокМинимальныйВозраст",
							Новый ОписаниеТипов("Булево"),,
							НСтр("ru='Минимальный возраст'")));
							
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ФлажокМаксимальныйВозраст",
							Новый ОписаниеТипов("Булево"),,
							НСтр("ru='Максимальный возраст'")));
							
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ФлажокИнтервалыНаграждения",
							Новый ОписаниеТипов("Булево"),,
							НСтр("ru='Исключать ранее награжденных лиц, если не подошел срок повторного награждения'")));
							
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ФлажокОграничениеДолжностей",
							Новый ОписаниеТипов("Булево"),,
							НСтр("ru='Ограничивать поиск кандидатов по занимаемой должности'")));
							
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ФлажокМинимальныеСтажиРаботы",
							Новый ОписаниеТипов("Булево"),,
							НСтр("ru='Исключать лиц, не удовлетворящих ни одному отбору по стажу работы'")));
							
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ФлажокНаличиеНаград",
							Новый ОписаниеТипов("Булево"),,
							НСтр("ru='Проверять наличие наград'")));
							
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Элементы = Форма.Элементы;
	
	ГруппаСтраницы = Элементы.Добавить("ГруппаТребованияККандидатамСтраницы", Тип("ГруппаФормы"), ГруппаРодитель);
	ГруппаСтраницы.Вид = ВидГруппыФормы.Страницы;
	
	ГруппаОсновныеТребования = Элементы.Добавить("ГруппаОсновныеТребованияСтраница", Тип("ГруппаФормы"), ГруппаСтраницы);
	ГруппаОсновныеТребования.Вид = ВидГруппыФормы.Страница;
	ГруппаОсновныеТребования.Заголовок = НСтр("ru='Основные требования'");
	ГруппаОсновныеТребования.Подсказка = НСтр("ru='Основные требования'");
	
	ЭлементФормы = Элементы.Добавить("ПовторноеНаграждениеНеПредусмотрено", Тип("ПолеФормы"), ГруппаОсновныеТребования);
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПутьКДанным = "Объект.ПовторноеНаграждениеНеПредусмотрено";
	ЭлементФормы.Заголовок = НСтр("ru='Исключать кандидатов, уже имеющих данную награду'");
	
	ЭлементФормы = Элементы.Добавить("ОтсутствиеДисциплинарныхВзысканий", Тип("ПолеФормы"), ГруппаОсновныеТребования);
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПутьКДанным = "Объект.ОтсутствиеДисциплинарныхВзысканий";
	ЭлементФормы.Заголовок = НСтр("ru='Исключать кандидатов, имеющих незакрытые дисциплинарные взыскания'");

	ЭлементФормы = Элементы.Добавить("СоблюдатьПоследовательностьНаграждения", Тип("ПолеФормы"), ГруппаОсновныеТребования);
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПутьКДанным = "Объект.СоблюдатьПоследовательностьНаграждения";
	ЭлементФормы.Заголовок = НСтр("ru='Соблюдать последовательность награждения по степени'");
	
	ГруппаТребованияКВозрасту = Элементы.Добавить("ГруппаТребованияКВозрасту", Тип("ГруппаФормы"), ГруппаОсновныеТребования);
	ГруппаТребованияКВозрасту.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаТребованияКВозрасту.Заголовок = НСтр("ru='Возраст'");
	ГруппаТребованияКВозрасту.Подсказка = НСтр("ru='Ограничивать поиск кандидатов по возрасту'");
	ГруппаТребованияКВозрасту.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;

	ЭлементФормы = Элементы.Добавить("ФлажокМинимальныйВозраст", Тип("ПолеФормы"), ГруппаТребованияКВозрасту);
	ЭлементФормы.ПутьКДанным = "ФлажокМинимальныйВозраст";
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.ТолькоПросмотр = Не ЕстьПравоРедактирования;
	ЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТребованийПодбораКандидатов");
	
	ЭлементФормы = Элементы.Добавить("МинимальныйВозраст", Тип("ПолеФормы"), ГруппаТребованияКВозрасту);
	ЭлементФормы.ПутьКДанным = "Объект.МинимальныйВозраст";
	ЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;;
	
	ЭлементФормы = Элементы.Добавить("ФлажокМаксимальныйВозраст", Тип("ПолеФормы"), ГруппаТребованияКВозрасту);
	ЭлементФормы.ПутьКДанным = "ФлажокМаксимальныйВозраст";
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.ТолькоПросмотр = Не ЕстьПравоРедактирования;
	ЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТребованийПодбораКандидатов");
	
	ЭлементФормы = Элементы.Добавить("МаксимальныйВозраст", Тип("ПолеФормы"), ГруппаТребованияКВозрасту);
	ЭлементФормы.ПутьКДанным = "Объект.МаксимальныйВозраст";
	ЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;;
	
	ГруппаМинимальныеСтажи = Элементы.Добавить("ГруппаМинимальныеСтажи", Тип("ГруппаФормы"), ГруппаСтраницы);
	ГруппаМинимальныеСтажи.Вид = ВидГруппыФормы.Страница;
	ГруппаМинимальныеСтажи.Заголовок = НСтр("ru='Отбор по стажу работы'");
	ГруппаМинимальныеСтажи.Подсказка = НСтр("ru = 'Исключать лиц, не удовлетворящих ни одному отбору по стажу работы'");
	
	ЭлементФормы = Элементы.Добавить("ФлажокМинимальныеСтажиРаботы", Тип("ПолеФормы"), ГруппаМинимальныеСтажи);
	ЭлементФормы.ПутьКДанным = "ФлажокМинимальныеСтажиРаботы";
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.ТолькоПросмотр = Не ЕстьПравоРедактирования;
	ЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТребованийПодбораКандидатов");
	
	ЭлементТаблица = Элементы.Добавить("МинимальныеСтажиРаботы", Тип("ТаблицаФормы"), ГруппаМинимальныеСтажи);
	ЭлементТаблица.ПутьКДанным = "Объект.МинимальныеСтажиРаботы";
	ЭлементТаблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ДобавитьКолонкиТаблицыФормы(Элементы, ЭлементТаблица, Метаданные.Справочники.Награды.ТабличныеЧасти.МинимальныеСтажиРаботы.Реквизиты, Истина);

	ГруппаОграничениеДолжностей = Элементы.Добавить("ГруппаОграничениеДолжностей", Тип("ГруппаФормы"), ГруппаСтраницы);
