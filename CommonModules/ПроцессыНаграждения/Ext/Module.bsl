// Содержит настройки размещения вариантов отчетов в панели отчетов.
// Описание см. ЗарплатаКадрыВариантыОтчетов.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчетов(Настройки) Экспорт
	
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.ОтчетыПоПроцессамНаграждения);
	
КонецПроцедуры

// См. ВариантыОтчетовПереопределяемый.ОпределитьОбъектыСКомандамиОтчетов
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	Если Не ИспользуютсяПроцессыНаграждения() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Просмотр", Метаданные.Отчеты.ОтчетыПоПроцессамНаграждения) Тогда
		Возврат;
	КонецЕсли;
	
	Команда = КомандыОтчетов.Добавить();
	Команда.Представление      = НСтр("ru = 'Подбор кандидатов к награждению'");
	Команда.Важность           = "Обычное";
	Команда.ТипПараметра       = Новый ОписаниеТипов("СправочникСсылка.Награды");
	Команда.МножественныйВыбор = Ложь;
	Команда.РежимЗаписи        = "Записывать";
	Команда.Менеджер           = "Отчет.ОтчетыПоПроцессамНаграждения";
	Команда.КлючВарианта       = "ПодборКандидатов";
	Команда.ИмяПараметраФормы  = "Награда";
	
КонецПроцедуры

#КонецОбласти

Функция ИспользуютсяПроцессыНаграждения() Экспорт
	
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыНаграждения");
	
