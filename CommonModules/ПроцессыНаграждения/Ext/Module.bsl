Функция ОснованиеПриказаПечатнойФормыТ11(ДокументНематериальногоПоощрения, Знач Организация, Знач ФизическиеЛица, Знач Награда) Экспорт
	
	Если Не ОбщегоНазначения.ЭтоДокумент(ДокументНематериальногоПоощрения.Метаданные()) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ТипЗнч(ФизическиеЛица) = Тип("Массив") Тогда
		ФизическиеЛица = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическиеЛица);
	КонецЕсли;
	
	ОписаниеПараметров = РегистрыСведений.СтатусыПредставленийКНаградам.ОписаниеПараметровСтатусыПредставленийКНаградам();
	ОписаниеПараметров.НаДату         = Новый Граница(НачалоДня(ДокументНематериальногоПоощрения.Дата)+2, ВидГраницы.Исключая);
	ОписаниеПараметров.Организация    = Организация;
	ОписаниеПараметров.ФизическоеЛицо = ФизическиеЛица;
	ОписаниеПараметров.Награда        = Награда;
	
	ПредставленияКНаградам = РегистрыСведений.СтатусыПредставленийКНаградам.СтатусыПредставленийКНаградам(ОписаниеПараметров);
	ПредставленияКНаградам.Сортировать("Период УБЫВ");
	
	Основания = Новый Массив;
	
	Для Каждого ФизическоеЛицо Из ФизическиеЛица Цикл
		
		ПредставлениеКНаграде = ПредставленияКНаградам.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
		Если ПредставлениеКНаграде.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПредставлениеКНаграде = ПредставлениеКНаграде[0];
		
		Основания.Добавить(СтрШаблон(НСтр("ru='Представление к награде %1 от %2'"), ПредставлениеКНаграде.НомерДокумента, Формат(ПредставлениеКНаграде.Период,"ДФ='dd.MM.yyyy ""г.""'")));
		
	КонецЦикла;
	
	Возврат СтрСоединить(Основания, СтрШаблон(НСтр("ru=',%1'"), Символы.ПС));
	
КонецФункции

Функция ЭтоДокументНаграждения(Данные) Экспорт
	Возврат ТипЗнч(Данные) = Тип("ДокументСсылка.Награждение");
КонецФункции

Процедура ЗаполнитьДанныеНовогоДокументаНаОснованииНаграждения(ДанныеЗаполнения, ДанныеНовогоДокумента) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Награждение") Тогда
		
		РеквизитыЗаполнения = "Организация,МотивПоощрения";
		ЗаполнитьЗначенияСвойств(ДанныеНовогоДокумента, ДанныеЗаполнения, РеквизитыЗаполнения);
		
		Если ДанныеНовогоДокумента.Свойство("ДатаПолученияДохода") Тогда
			ДанныеНовогоДокумента.ДатаПолученияДохода = ДанныеЗаполнения.Дата;
		КонецЕсли;
		
		Если ДанныеНовогоДокумента.Свойство("Дата") Тогда
			ДанныеНовогоДокумента.Дата = ДанныеЗаполнения.Дата;
		КонецЕсли;
		
		Если ДанныеНовогоДокумента.Свойство("Начисления") Тогда
			Для Каждого ДанныеПретендента Из ДанныеЗаполнения.ПретендентыКНаграждению Цикл
				Если ТипЗнч(ДанныеПретендента.Претендент) = Тип("СправочникСсылка.Сотрудники") Тогда
					СтрокаНачисления = ДанныеНовогоДокумента.Начисления.Добавить();
					СтрокаНачисления.Сотрудник = ДанныеПретендента.Претендент;
					Если ПолучитьФункциональнуюОпцию("ВыполнятьРасчетЗарплатыПоПодразделениям") Тогда
						СтрокаНачисления.Подразделение = ДанныеПретендента.Подразделение;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

