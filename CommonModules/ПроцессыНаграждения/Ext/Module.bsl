	ЭлементФормы.ПутьКДанным = "ФлажокОграничениеДолжностей";
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.ТолькоПросмотр = Не ЕстьПравоРедактирования;
	ЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТребованийПодбораКандидатов");
	
	ЭлементТаблица = Элементы.Добавить("ОграничениеДолжностей", Тип("ТаблицаФормы"), ГруппаОграничениеДолжностей);
	ЭлементТаблица.ПутьКДанным = "Объект.ОграничениеДолжностей";
	ЭлементТаблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ДобавитьКолонкиТаблицыФормы(Элементы, ЭлементТаблица, Метаданные.Справочники.Награды.ТабличныеЧасти.ОграничениеДолжностей.Реквизиты, Истина);
	
	ГруппаИнтервалыНаграждения = Элементы.Добавить("ГруппаИнтервалыНаграждения", Тип("ГруппаФормы"), ГруппаСтраницы);
	ГруппаИнтервалыНаграждения.Вид = ВидГруппыФормы.Страница;
	ГруппаИнтервалыНаграждения.Заголовок = НСтр("ru='Интервалы между награждениями'");
	ГруппаИнтервалыНаграждения.Подсказка = НСтр("ru='Исключать ранее награжденных лиц, если не подошел срок повторного награждения'");
	
	ЭлементФормы = Элементы.Добавить("ФлажокИнтервалыНаграждения", Тип("ПолеФормы"), ГруппаИнтервалыНаграждения);
	ЭлементФормы.ПутьКДанным = "ФлажокИнтервалыНаграждения";
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.ТолькоПросмотр = Не ЕстьПравоРедактирования;
	ЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТребованийПодбораКандидатов");
	
	ЭлементТаблица = Элементы.Добавить("ИнтервалыНаграждения", Тип("ТаблицаФормы"), ГруппаИнтервалыНаграждения);
	ЭлементТаблица.ПутьКДанным = "Объект.ИнтервалыНаграждения";
	ЭлементТаблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ДобавитьКолонкиТаблицыФормы(Элементы, ЭлементТаблица, Метаданные.Справочники.Награды.ТабличныеЧасти.ИнтервалыНаграждения.Реквизиты, Истина);

	ГруппаНаличиеНаград = Элементы.Добавить("ГруппаНаличиеНаград", Тип("ГруппаФормы"), ГруппаСтраницы);
	ГруппаНаличиеНаград.Вид = ВидГруппыФормы.Страница;
	ГруппаНаличиеНаград.Заголовок = НСтр("ru='Наличие наград'");
	ГруппаНаличиеНаград.Подсказка = НСтр("ru='Подбирать кандидатов, имеющих минимум одну из наград'");
	
	ЭлементФормы = Элементы.Добавить("ФлажокНаличиеНаград", Тип("ПолеФормы"), ГруппаНаличиеНаград);
	ЭлементФормы.ПутьКДанным = "ФлажокНаличиеНаград";
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.ТолькоПросмотр = Не ЕстьПравоРедактирования;
	ЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлементаТребованийПодбораКандидатов");
	
	ЭлементТаблица = Элементы.Добавить("НаличиеНаград", Тип("ТаблицаФормы"), ГруппаНаличиеНаград);
	ЭлементТаблица.ПутьКДанным = "Объект.НаличиеНаград";
	ЭлементТаблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ДобавитьКолонкиТаблицыФормы(Элементы, ЭлементТаблица, Метаданные.Справочники.Награды.ТабличныеЧасти.НаличиеНаград.Реквизиты, Истина);

	УстановитьЗначенияРеквизитовФормыНаград(Форма);

КонецПроцедуры

Процедура ДобавитьКолонкиТаблицыФормы(Элементы, ЭлементТаблица, Знач КолонкиТаблицы, ЭтоДобавлениеРеквизитовОбъекта = Ложь)
	
	Для Каждого Реквизит Из КолонкиТаблицы Цикл
		
		ПолеПолеТаблицы = Элементы.Добавить(СтрШаблон("%1%2", ЭлементТаблица.Имя, Реквизит.Имя), Тип("ПолеФормы"), ЭлементТаблица);
		
		Если ЭтоДобавлениеРеквизитовОбъекта Тогда
			ПолеПолеТаблицы.ПутьКДанным = СтрШаблон("Объект.%1.%2", ЭлементТаблица.Имя, Реквизит.Имя);
		Иначе
			ПолеПолеТаблицы.ПутьКДанным = СтрШаблон("%1.%2", ЭлементТаблица.Имя, Реквизит.Имя);
		КонецЕсли;
		
		ПолеПолеТаблицы.Заголовок = Реквизит.Синоним;
		ПолеПолеТаблицы.Вид = ВидПоляФормы.ПолеВвода;
		ПолеПолеТаблицы.АвтоОтметкаНезаполненного = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьЗначенияРеквизитовФормыНаград(Форма)
	
	Форма.ФлажокМинимальныйВозраст     = Не Форма.Объект.МинимальныйВозраст = 0;
	Форма.ФлажокМаксимальныйВозраст    = Не Форма.Объект.МаксимальныйВозраст = 0;
	Форма.ФлажокМинимальныеСтажиРаботы = Не Форма.Объект.МинимальныеСтажиРаботы.Количество() = 0;
	Форма.ФлажокОграничениеДолжностей  = Не Форма.Объект.ОграничениеДолжностей.Количество() = 0;
	Форма.ФлажокИнтервалыНаграждения   = Не Форма.Объект.ИнтервалыНаграждения.Количество() = 0;
	Форма.ФлажокНаличиеНаград          = Не Форма.Объект.НаличиеНаград.Количество() = 0;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "МинимальныйВозраст",     "Доступность", Форма.ФлажокМинимальныйВозраст);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "МаксимальныйВозраст",    "Доступность", Форма.ФлажокМаксимальныйВозраст);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "МинимальныеСтажиРаботы", "Доступность", Форма.ФлажокМинимальныеСтажиРаботы);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОграничениеДолжностей",  "Доступность", Форма.ФлажокОграничениеДолжностей);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ИнтервалыНаграждения",   "Доступность", Форма.ФлажокИнтервалыНаграждения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НаличиеНаград",          "Доступность", Форма.ФлажокНаличиеНаград);

КонецПроцедуры

Функция ДанныеДокументаНагражденияПомещеныВМенеджерВременныхТаблиц(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("НомерДокумента", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументСсылка.Номер, Истина, Истина));
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Награждение") Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Награждение.Ссылка КАК Ссылка,
		|	Награждение.Дата КАК Дата,
		|	Награждение.Номер КАК Номер,
		|	Награждение.Организация КАК Организация,
		|	Награждение.НаименованиеПервичногоДокумента КАК НаименованиеПервичногоДокумента,
		|	Награждение.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
		|	Награждение.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	НаграждениеПретенденты.Награда КАК Награда,
		|	НаграждениеПретенденты.Претендент КАК Претендент,
		|	НаграждениеПретенденты.Подразделение КАК Подразделение,
		|	НаграждениеФизическиеЛица.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ЗНАЧЕНИЕ(Перечисление.СтатусыПредставленияКНаградам.НаградаВручена) КАК Статус,
		|	НаграждениеПретенденты.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТДанныеДокумента
		|ИЗ
		|	Документ.Награждение КАК Награждение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Награждение.ПретендентыКНаграждению КАК НаграждениеПретенденты
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Награждение.ФизическиеЛица КАК НаграждениеФизическиеЛица
		|			ПО НаграждениеПретенденты.Ссылка = НаграждениеФизическиеЛица.Ссылка
		|				И (ВЫРАЗИТЬ(НаграждениеПретенденты.Претендент КАК Справочник.Сотрудники).ФизическоеЛицо = НаграждениеФизическиеЛица.ФизическоеЛицо
		|					ИЛИ НаграждениеПретенденты.Претендент = НаграждениеФизическиеЛица.ФизическоеЛицо)
		|		ПО Награждение.Ссылка = НаграждениеПретенденты.Ссылка
		|ГДЕ
		|	Награждение.Ссылка = &Ссылка
		|	И НЕ НаграждениеПретенденты.Награда = ЗНАЧЕНИЕ(Справочник.Награды.ПустаяСсылка)";
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Запрос.Выполнить();
	
	Возврат Истина;

КонецФункции

Процедура ПереопределитьТекстЗапросаДляПечатиТ11(СхемаКомпоновкиДанных) Экспорт
	
	Если Не ПроцессыНагражденияВызовСервера.ИспользуютсяПроцессыНаграждения() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;
	СхемаЗапроса = Новый СхемаЗапроса();
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	ПакетЗапросовСхемыЗапроса = СхемаЗапроса.ПакетЗапросов[0];
	
	Для Каждого ОператорСхемыЗапроса Из ПакетЗапросовСхемыЗапроса.Операторы Цикл
		
		Для Каждого ИсточникСхемыЗапроса Из ОператорСхемыЗапроса.Источники Цикл
			Если ИсточникСхемыЗапроса.Источник.ИмяТаблицы = "Документ.Награждение" Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ОператорСхемыЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы.Добавить();
	ОператорСхемыЗапроса.ТипОбъединения = ТипОбъединенияСхемыЗапроса.Объединить;
	
	ИсточникСхемыЗапросаНаграждения = ОператорСхемыЗапроса.Источники.Добавить("Документ.Награждение", "Награждение");
	ИсточникСхемыЗапросаНаграждения.Соединения.Очистить();
	ИсточникСхемыЗапросаСотрудники = ОператорСхемыЗапроса.Источники.Добавить("Документ.Награждение.ПретендентыКНаграждению", "НаграждениеСотрудники");
	ИсточникСхемыЗапросаСотрудники.Соединения.Очистить();
	ИсточникСхемыЗапросаНаграждения.Соединения.Добавить(ИсточникСхемыЗапросаСотрудники, "Награждение.Ссылка = НаграждениеСотрудники.Ссылка");
	ИсточникСхемыЗапросаНаграждения.Соединения[ИсточникСхемыЗапросаНаграждения.Соединения.Количество()-1].ТипСоединения = ТипСоединенияСхемыЗапроса.Внутреннее;
	ИсточникСхемыЗапросаНаграждения.Соединения[ИсточникСхемыЗапросаНаграждения.Соединения.Количество()-1].ОбязательноеСоединение = Истина;
	
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("НаграждениеСотрудники.Ссылка", 0);
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("ВЫБОР
												|	КОГДА Награждение.ДатаПервичногоДокумента = ДАТАВРЕМЯ(1, 1, 1)
												|		ТОГДА Награждение.Дата
												|	ИНАЧЕ Награждение.ДатаПервичногоДокумента
												|КОНЕЦ", 1);
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("НаграждениеСотрудники.Претендент", 2);
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("НаграждениеСотрудники.Подразделение", 3);
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("НаграждениеСотрудники.НомерСтроки", 4);
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("0", 5);
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("НаграждениеСотрудники.Награда", 6);
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("NULL", 7);
	ОператорСхемыЗапроса.ВыбираемыеПоля.Добавить("NULL", 8);
	
	ОператорСхемыЗапроса.Отбор.Добавить(Новый ВыражениеСхемыЗапроса("Награждение.Ссылка В(&СсылкиНаОбъекты)"));
	ОператорСхемыЗапроса.Отбор.Добавить(Новый ВыражениеСхемыЗапроса("НаграждениеСотрудники.Претендент ССЫЛКА Справочник.Сотрудники"));
	
	СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецПроцедуры

#КонецОбласти
