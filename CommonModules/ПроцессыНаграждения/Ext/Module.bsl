#Область УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных
Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(Описание) Экспорт
	
	Описание = Описание + "
		|Документ.Награждение.Чтение.ГруппыФизическихЛиц
		|Документ.Награждение.Чтение.Организации
		|Документ.Награждение.Изменение.ГруппыФизическихЛиц
		|Документ.Награждение.Изменение.Организации
		|Справочник.НаграждениеПрисоединенныеФайлы.Чтение.ГруппыФизическихЛиц
		|Справочник.НаграждениеПрисоединенныеФайлы.Чтение.Организации
		|Справочник.НаграждениеПрисоединенныеФайлы.Изменение.ГруппыФизическихЛиц
		|Справочник.НаграждениеПрисоединенныеФайлы.Изменение.Организации
		|Документ.ПредставлениеКНаграде.Чтение.ГруппыФизическихЛиц
		|Документ.ПредставлениеКНаграде.Чтение.Организации
		|Документ.ПредставлениеКНаграде.Изменение.ГруппыФизическихЛиц
		|Документ.ПредставлениеКНаграде.Изменение.Организации
		|Справочник.ПредставлениеКНаградеПрисоединенныеФайлы.Чтение.ГруппыФизическихЛиц
		|Справочник.ПредставлениеКНаградеПрисоединенныеФайлы.Чтение.Организации
		|Справочник.ПредставлениеКНаградеПрисоединенныеФайлы.Изменение.ГруппыФизическихЛиц
		|Справочник.ПредставлениеКНаградеПрисоединенныеФайлы.Изменение.Организации
		|РегистрСведений.СтатусыПредставленийКНаградам.Чтение.ГруппыФизическихЛиц
		|РегистрСведений.СтатусыПредставленийКНаградам.Чтение.Организации
		|";
	
КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.Документы.Награждение, Истина);
	Списки.Вставить(Метаданные.Документы.ПредставлениеКНаграде, Истина);

	Списки.Вставить(Метаданные.Справочники.НаграждениеПрисоединенныеФайлы, Истина);
	Списки.Вставить(Метаданные.Справочники.ПредставлениеКНаградеПрисоединенныеФайлы, Истина);

	Списки.Вставить(Метаданные.РегистрыСведений.СтатусыПредставленийКНаградам, Истина);

КонецПроцедуры

Процедура ЗаполнитьПоставляемыеПрофилиГруппДоступа(ОписанияПрофилей, ПараметрыОбновления) Экспорт

