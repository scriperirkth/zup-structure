
#Область СлужебныеПроцедурыИФункции

Функция СериализоватьКоллекцию(Знач Коллекция) Экспорт
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(Коллекция.Выгрузить());
	
КонецФункции

Функция НастройкиОтчетаРасшифровки(Знач КомпоновщикНастроек, Знач ОтчетДанныеРасшифровки, Знач Расшифровка) Экспорт
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(ОтчетДанныеРасшифровки);
	ЭлементРасшифровки = ДанныеРасшифровки.Элементы.Получить(Расшифровка);
	ПоляРасшифровки = ЭлементРасшифровки.ПолучитьПоля();
	
	Если Не ПоляРасшифровки.Найти("НаличиеДисциплинарныхВзысканий") = Неопределено 
		И ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ДисциплинарныеВзыскания") Тогда
		
		ЗначенияРасшифровки = Новый Структура;
		Для Каждого ПолеРасшифровки Из ПоляРасшифровки Цикл
			ЗначенияРасшифровки.Вставить(ПолеРасшифровки.Поле, ПолеРасшифровки.Значение);
		КонецЦикла;
		
		ПолучитьРодителейРасшифровки(ЗначенияРасшифровки, ДанныеРасшифровки, ЭлементРасшифровки);
		
		ЗначениеПоляФизическоеЛицо = Неопределено;
		
		ЗначенияРасшифровки.Свойство("ФизическоеЛицо", ЗначениеПоляФизическоеЛицо);
		
		Если Не ЗначениеПоляФизическоеЛицо = Неопределено Тогда
			
			ОтчетОбъект = Отчеты.ДисциплинарныеВзыскания.Создать();
			КлючПредопределенногоВарианта = "ДисциплинарныеВзыскания";
			ВариантОтчета = ВариантыОтчетов.ВариантОтчета(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОтчетОбъект.Метаданные()), КлючПредопределенногоВарианта);
			
			НастройкиОтчета = Новый Структура;
			НастройкиОтчета.Вставить("ВариантОтчета", ВариантОтчета);
			ОтборФизическоеЛицо = Новый Структура("ФизическоеЛицо", ЗначениеПоляФизическоеЛицо);
			НастройкиОтчета.Вставить("Отбор", Новый Структура("ЛичныеДанные", ОтборФизическоеЛицо));
			
			Возврат НастройкиОтчета;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ПолучитьРодителейРасшифровки(ЗначенияРасшифровки, ДанныеРасшифровки, ЭлементРасшифровки)
	
	ПоляРодителей = ЭлементРасшифровки.ПолучитьРодителей();
	
	Для Каждого ПолеРодителя Из ПоляРодителей Цикл
		
		ЭлементРасшифровкиРодителя = ДанныеРасшифровки.Элементы.Получить(ПолеРодителя.Идентификатор);
		
		Если ТипЗнч(ЭлементРасшифровкиРодителя) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
			
			ПоляРасшифровки = ЭлементРасшифровкиРодителя.ПолучитьПоля();
			Для Каждого ПолеРасшифровки Из ПоляРасшифровки Цикл
				ЗначенияРасшифровки.Вставить(ПолеРасшифровки.Поле, ПолеРасшифровки.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
		ПолучитьРодителейРасшифровки(ЗначенияРасшифровки, ДанныеРасшифровки, ЭлементРасшифровкиРодителя);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИспользуютсяПроцессыНаграждения() Экспорт
	Возврат ПроцессыНаграждения.ИспользуютсяПроцессыНаграждения();
КонецФункции

Функция ХранилищеТаблицыРезультатаОтчета(Знач ИсходныйКомпоновщикНастроек, ИмяОтчета, ИмяМакета, МассивПолей) Экспорт
	
	МенеджерВременныхТаблиц = Неопределено;
	Отчеты.ОтчетыПоПроцессамНаграждения.ЗаполнитьМенеджерВременныхТаблицПриКомпоновке(МенеджерВременныхТаблиц, ИсходныйКомпоновщикНастроек);
	
	Возврат ЗарплатаКадрыРасширенный.ХранилищеТаблицыРезультатаОтчета(ИсходныйКомпоновщикНастроек, ИмяОтчета, ИмяМакета, МассивПолей, МенеджерВременныхТаблиц);

КонецФункции

#КонецОбласти