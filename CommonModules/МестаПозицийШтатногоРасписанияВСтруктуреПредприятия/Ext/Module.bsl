#Область СлужебныйПрограммныйИнтерфейс

Процедура СформироватьДвиженияИсторииИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия(Движения,
	ТаблицаДанныхДляПроведения) Экспорт

	Если Не ЗначениеЗаполнено(ТаблицаДанныхДляПроведения) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаДанныхДляПроведения Из ТаблицаДанныхДляПроведения Цикл
		СтрокаДвижений = Движения.ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДвижений, СтрокаДанныхДляПроведения);
	КонецЦикла;

	Если Движения.ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия.Количество() > 0 Тогда
		Движения.ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия.Записывать = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписиИсторииИзмененияМестаПозицииВСтруктуре(НаборЗаписей, Отказ, Замещение) Экспорт

	Если Не ИспользоватьДокументИзмененияМестаПозицииВСтруктуреПредприятия() Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормирования = ОрганизационнаяСтруктура.ПараметрыФормированияВторичныхДанныхМестаПозицииВСтруктуре(
		НаборЗаписей, Замещение);
	ОрганизационнаяСтруктура.ОбновитьВторичныеДанныеМестаПозицииВСтруктуре(ПараметрыФормирования, Отказ);

КонецПроцедуры

Функция ИспользоватьДокументИзмененияМестаПозицииВСтруктуреПредприятия() Экспорт

	Если ПолучитьФункциональнуюОпцию("ИспользоватьДокументИзмененияМестаПозицииВСтруктуреПредприятия") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПроверитьВозможностьВнесенияИзменений(ТаблицаПозиций) Экспорт

	РезультатПроверки = Новый Структура("ИзмененияВозможны, Позиции", Истина, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПозиций.Позиция КАК ПозицияШтатногоРасписания,
	|	ТаблицаПозиций.ДатаВступленияВСилу КАК Дата
	|ПОМЕСТИТЬ ВТПозицииДокумента
	|ИЗ
	|	&ТаблицаПозиций КАК ТаблицаПозиций
	|ГДЕ
	|	ТаблицаПозиций.Позиция <> ЗНАЧЕНИЕ(Справочник.ШтатноеРасписание.ПустаяСсылка)
	|	И ТаблицаПозиций.ДатаВступленияВСилу <> ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПозицииДокумента.ПозицияШтатногоРасписания КАК ПозицияШтатногоРасписания,
	|	ПозицииДокумента.Дата КАК Дата,
	|	МИНИМУМ(ИсторияИспользованияШтатногоРасписания.Дата) КАК ДатаПоследующихИзменений
	|ПОМЕСТИТЬ ВТДатыПоследующихИзменений
	|ИЗ
	|	ВТПозицииДокумента КАК ПозицииДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияИспользованияШтатногоРасписания КАК
	|			ИсторияИспользованияШтатногоРасписания
	|		ПО ПозицииДокумента.ПозицияШтатногоРасписания = ИсторияИспользованияШтатногоРасписания.ПозицияШтатногоРасписания
	|		И ПозицииДокумента.Дата < ИсторияИспользованияШтатногоРасписания.Дата
	|СГРУППИРОВАТЬ ПО
	|	ПозицииДокумента.ПозицияШтатногоРасписания,
	|	ПозицииДокумента.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДатыПоследующихИзменений.ПозицияШтатногоРасписания КАК Позиция,
	|	ДатыПоследующихИзменений.Дата КАК Дата,
	|	ДатыПоследующихИзменений.ДатаПоследующихИзменений КАК ДатаИзменений,
	|	ИсторияИспользованияШтатногоРасписания.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ИсторияИспользованияШтатногоРасписания.Регистратор) КАК РегистраторПредставление
	|ИЗ
	|	ВТДатыПоследующихИзменений КАК ДатыПоследующихИзменений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияИспользованияШтатногоРасписания КАК
	|			ИсторияИспользованияШтатногоРасписания
	|		ПО ДатыПоследующихИзменений.ПозицияШтатногоРасписания = ИсторияИспользованияШтатногоРасписания.ПозицияШтатногоРасписания
	|		И ДатыПоследующихИзменений.ДатаПоследующихИзменений = ИсторияИспользованияШтатногоРасписания.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаИзменений,
	|	Позиция";

	Запрос.УстановитьПараметр("ТаблицаПозиций", ТаблицаПозиций);
	
	УстановитьПривилегированныйРежим(Истина);

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	РезультатПроверки.ИзмененияВозможны = Ложь;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл


		РезультатПроверкиИзменения = РезультатПроверкиИзменения();
		ЗаполнитьЗначенияСвойств(РезультатПроверкиИзменения, Выборка);
		
		РезультатПроверки.Позиции.Добавить(РезультатПроверкиИзменения);

	КонецЦикла;;

	Возврат РезультатПроверки;

КонецФункции

Функция ПроверитьСоответствиеМестВСтруктуреПредприятия(Позиции, ДатаПроверки) Экспорт

	РезультатПроверки = Новый Структура("ЕстьРасхождения, Позиции", Ложь, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	Позиции.Позиция КАК Позиция,
	|	Позиции.МестоВСтруктуреПредприятия КАК Подразделение
	|ПОМЕСТИТЬ ВТПозиции
	|ИЗ
	|	&Позиции КАК Позиции";

	Запрос.УстановитьПараметр("Позиции", Позиции);
	Запрос.УстановитьПараметр("Период", ДатаПроверки);

	Запрос.Выполнить();

	ОрганизационнаяСтруктура.СоздатьВТМестаПозицийВСтруктуреПредприятияПоВременнойТаблице(Запрос.МенеджерВременныхТаблиц);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Позиции.Позиция КАК Позиция,
	|	МестаПозицийВСтруктуреПредприятия.Основание КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(МестаПозицийВСтруктуреПредприятия.Основание) КАК РегистраторПредставление
	|ИЗ
	|	ВТПозиции КАК Позиции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТМестаПозицийВСтруктуреПредприятия КАК МестаПозицийВСтруктуреПредприятия
	|		ПО Позиции.Позиция = МестаПозицийВСтруктуреПредприятия.Позиция
	|		И Позиции.Период = МестаПозицийВСтруктуреПредприятия.Период
	|ГДЕ
	|	Позиции.Подразделение <> МестаПозицийВСтруктуреПредприятия.Подразделение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Позиция";

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	РезультатПроверки.ЕстьРасхождения = Истина;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		РезультатПроверкиСоответствия = РезультатПроверкиСоответствия();
		ЗаполнитьЗначенияСвойств(РезультатПроверкиСоответствия, Выборка);
		
		РезультатПроверки.Позиции.Добавить(РезультатПроверкиСоответствия);
		
	КонецЦикла;

	Возврат РезультатПроверки;

КонецФункции

Функция ЗапросОбновленияМестаПозицийШтатногоРасписанияПоДвижениямИзмененияМеста() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИсторияИспользованияШтатногоРасписания.Дата КАК Период,
	|	ИсторияИспользованияШтатногоРасписания.ПозицияШтатногоРасписания КАК Позиция,
	|	ИсторияИспользованияШтатногоРасписания.МестоВСтруктуреПредприятия КАК Подразделение,
	|	ИсторияИспользованияШтатногоРасписания.Регистратор КАК Основание,
	|	НЕ &ИспользоватьДокументИзмененияМестаПозицииВСтруктуреПредприятия КАК Приоритет
	|ПОМЕСТИТЬ ВТИсторияИзмененияМестаПозиции
	|ИЗ
	|	РегистрСведений.ИсторияИспользованияШтатногоРасписания КАК ИсторияИспользованияШтатногоРасписания
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия.Период,
	|	ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия.ПозицияШтатногоРасписания,
	|	ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия.МестоВСтруктуреПредприятия,
	|	ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия.Регистратор,
	|	&ИспользоватьДокументИзмененияМестаПозицииВСтруктуреПредприятия
	|ИЗ
	|	РегистрСведений.ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия КАК
	|		ИсторияИзмененияМестаПозицииШтатногоРасписанияВСтруктуреПредприятия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияИзмененияМестаПозиции.Период КАК Период,
	|	ИсторияИзмененияМестаПозиции.Позиция КАК Позиция,
	|	МАКСИМУМ(Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ ВТПриоритетыЗаписей
	|ИЗ
	|	ВТИсторияИзмененияМестаПозиции КАК ИсторияИзмененияМестаПозиции
	|СГРУППИРОВАТЬ ПО
	|	ИсторияИзмененияМестаПозиции.Период,
	|	ИсторияИзмененияМестаПозиции.Позиция
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Позиция,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияИзмененияМестаПозиции.Период КАК Период,
	|	ИсторияИзмененияМестаПозиции.Позиция КАК Позиция,
	|	ИсторияИзмененияМестаПозиции.Подразделение КАК Подразделение,
	|	ИсторияИзмененияМестаПозиции.Основание КАК Основание
	|ИЗ
	|	ВТИсторияИзмененияМестаПозиции КАК ИсторияИзмененияМестаПозиции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПриоритетыЗаписей КАК ПриоритетыЗаписей
	|		ПО ИсторияИзмененияМестаПозиции.Позиция = ПриоритетыЗаписей.Позиция
	|		И ИсторияИзмененияМестаПозиции.Период = ПриоритетыЗаписей.Период
	|		И ИсторияИзмененияМестаПозиции.Приоритет = ПриоритетыЗаписей.Приоритет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Позиция,
	|	Период";
	
	Запрос.УстановитьПараметр("ИспользоватьДокументИзмененияМестаПозицииВСтруктуреПредприятия",
		ИспользоватьДокументИзмененияМестаПозицииВСтруктуреПредприятия());
	
	Возврат Запрос;
	
КонецФункции

Процедура ДополнитьОписаниеПрофиляИзменение(ОписаниеПрофиля) Экспорт

	ОписаниеПрофиля.Роли.Добавить("ДобавлениеИзменениеИзмененийМестПозицийШтатногоРасписанияВСтруктуреПредприятия");

КонецПроцедуры

Процедура ДополнитьОписаниеПрофиляЧтение(ОписаниеПрофиля) Экспорт

	ОписаниеПрофиля.Роли.Добавить("ЧтениеИзмененийМестПозицийШтатногоРасписанияВСтруктуреПредприятия");

КонецПроцедуры

Процедура ОбновитьЗависимыеДанныеПоИсторииИзмененияМестаПозиции(СтрокаТаблицы) Экспорт

	Если СтрокаТаблицы.ВедущиеМетаданные <> Метаданные.РегистрыСведений.ИсторияИспользованияШтатногоРасписания Тогда
		Возврат;
	КонецЕсли;

	Для Каждого НаборЗаписей Из СтрокаТаблицы.ВедущиеДанные Цикл
		ПриЗаписиИсторииИзмененияМестаПозицииВСтруктуре(НаборЗаписей, Ложь, Истина);
	КонецЦикла;

КонецПроцедуры

