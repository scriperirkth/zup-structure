// См. ОбменСАрхивомПереопределяемый.СоздатьДокументыБИА.
Процедура СоздатьДокументыБИА(СсылкаНаОбъектИсточник, ДокументыБИА) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	СформированныеДокументыБИА = Новый Массив;
	
	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("СправочникСсылка.Файлы") Тогда
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументБИАФайла(СсылкаНаОбъектИсточник);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.БольничныйЛист") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата перевода", "ДатаНачала");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата возврата", "ДатаОкончания");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Причина нетрудоспособности", "ПричинаНетрудоспособности");
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыВБанк") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ИмяТабличнойЧастиСотрудники = "Зарплата";
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыВКассу") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ИмяТабличнойЧастиСотрудники = "Зарплата";
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.КадровыйПеревод") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		
		Если СсылкаНаОбъектИсточник.ИзменитьПодразделениеИДолжность Тогда
			ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
			ПараметрыДокумента.ДополнительныеСвойства.Вставить("Должность", "ДолжностьПоШтатномуРасписанию");
		КонецЕсли;
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата перевода", "ДатаНачала");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата возврата", "ДатаОкончания");
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.Отпуск") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата начала", "ДатаНачалаОсновногоОтпуска");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата окончания", "ДатаОкончанияОсновногоОтпуска");
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ОтпускБезСохраненияОплаты") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата начала", "ДатаНачала");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата окончания", "ДатаОкончания");
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПриемНаРаботу") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата приема", "ДатаПриема");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Должность", "Должность");
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.Увольнение") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата увольнения", "ДатаУвольнения");
		
		СформированныеДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	КонецЕсли;
	
	ДокументыБИА = ОбщегоНазначения.СкопироватьРекурсивно(СформированныеДокументыБИА);

КонецПроцедуры

Функция ДанныеТрудовогоДоговора(СсылкаНаДокумент, Сотрудник) Экспорт
	
	Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта("ТрудовойДоговорНомер", Метаданные.Документы.ПриемНаРаботу) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриемНаРаботу.ТрудовойДоговорНомер КАК ТрудовойДоговорНомер,
	|	ПриемНаРаботу.ТрудовойДоговорДата КАК ТрудовойДоговорДата
	|ИЗ
	|	Документ.ПриемНаРаботу КАК ПриемНаРаботу
	|ГДЕ
	|	ПриемНаРаботу.Ссылка = &Ссылка
	|	И ПриемНаРаботу.Сотрудник = &Сотрудник";
	
	ДанныеТрудовогоДоговора = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеТрудовогоДоговора = Новый Структура("ТрудовойДоговорНомер, ТрудовойДоговорДата");
		ЗаполнитьЗначенияСвойств(ДанныеТрудовогоДоговора, Выборка);
	КонецЕсли;
	
	Возврат ДанныеТрудовогоДоговора;
	
КонецФункции

