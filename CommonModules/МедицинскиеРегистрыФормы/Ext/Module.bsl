#Область СлужебныйПрограммныйИнтерфейс  

Процедура УстановитьПараметрыВыбора(Форма, ИмяЭлементаУправления, КодКлассификатора) Экспорт
	КлассификаторФРМР = Справочники.КлассификаторыФедеральныхМедрегистров.НайтиПоКоду(КодКлассификатора);
	Если ЗначениеЗаполнено(КлассификаторФРМР) Тогда
		ПараметрВыбора = Новый ПараметрВыбора("Отбор.Владелец", КлассификаторФРМР);
		Форма.Элементы[ИмяЭлементаУправления].ПараметрыВыбора = 
			Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрВыбора));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МедицинскиеДолжности() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвойстваДолжностейМедицинскихРаботников.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.СвойстваДолжностейМедицинскихРаботников КАК СвойстваДолжностейМедицинскихРаботников
		|ГДЕ
		|	СвойстваДолжностейМедицинскихРаботников.ЯвляетсяМедицинскойДолжностью";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Должность");
	
КонецФункции 

#КонецОбласти