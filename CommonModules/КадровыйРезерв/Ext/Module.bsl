#Область ПереносДанныхИзПрежнихПрограмм

Процедура КадровыйРезерв_ПослеЗагрузки(Объект, ОбъектНайден, ПараметрыОбъекта, Отказ) Экспорт
	
	Если Отказ Или Не ОбъектНайден Или ПараметрыОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация",				ПараметрыОбъекта.Получить("Организация"));
	Запрос.УстановитьПараметр("Должность",					ПараметрыОбъекта.Получить("Должность"));
	Запрос.УстановитьПараметр("Подразделение",				ПараметрыОбъекта.Получить("Подразделение"));
	Запрос.УстановитьПараметр("ПодразделениеОрганизации",	ПараметрыОбъекта.Получить("ПодразделениеОрганизации"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	""00010101"" КАК Период
	|ПОМЕСТИТЬ ВТПериоды";
	
	Запрос.Выполнить();
	
	ОписаниеФильтра = ЗарплатаКадрыОбщиеНаборыДанных.ОписаниеФильтраДляСоздатьВТИмяРегистра("ВТПериоды");
	ПараметрыПостроения = ЗарплатаКадрыОбщиеНаборыДанных.ПараметрыПостроенияДляСоздатьВТИмяРегистраСрез();
	ЗарплатаКадрыОбщиеНаборыДанных.СоздатьВТИмяРегистраСрезПоследних(
		"МестоПозицииШтатногоРасписанияВСтруктуреПредприятия", Запрос.МенеджерВременныхТаблиц, Истина, ОписаниеФильтра,
		ПараметрыПостроения, "ВТМестоПозицииШтатногоРасписанияВСтруктуреПредприятия");
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШтатноеРасписание.Ссылка КАК ПозицияШтатногоРасписания
	|ИЗ
	|	Справочник.ШтатноеРасписание КАК ШтатноеРасписание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТМестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозицииШтатногоРасписанияВСтруктуреПредприятия
	|		ПО ШтатноеРасписание.Ссылка = МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Позиция
	|ГДЕ
	|	ШтатноеРасписание.Должность = &Должность
	|	И ВЫБОР
	|			КОГДА &Подразделение = НЕОПРЕДЕЛЕНО
	|				ТОГДА ШтатноеРасписание.Владелец = &Организация
	|						И ШтатноеРасписание.Подразделение = &ПодразделениеОрганизации
	|			ИНАЧЕ МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение = &Подразделение
	|		КОНЕЦ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.ПозицияШтатногоРасписания = Выборка.ПозицияШтатногоРасписания;
	КонецЕсли;
	
КонецПроцедуры

