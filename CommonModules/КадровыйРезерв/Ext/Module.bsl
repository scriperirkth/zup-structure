#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнениеВремениДвиженийРегистраИРеквизитовДокументов");
	Методы.Вставить("НачальноеЗаполнениеВидовРезерва");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает доступность подсистемы кадрового резерва для пользователя по правам и интерфейсу.
// 
// Возвращаемое значение:
//  Булево
Функция КадровыйРезервДоступенПользователю() Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьКадровыйРезерв") Тогда
		Возврат Ложь;
	Иначе
		Возврат ПравоДоступа("Чтение", Метаданные.Справочники.КадровыйРезерв);
	КонецЕсли;

КонецФункции

// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Период - Дата - 
//	 * УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
// 	 * ПозицияРезерва - СправочникСсылка.КадровыйРезерв
// 	 * Статус - ПеречислениеСсылка.СостоянияСогласования
// 	 * ВидРезерва - СправочникСсылка.ВидыКадровогоРезерва
// 	 * СтатусРезервиста - СправочникСсылка.СтатусыГотовностиРезервистов
// 	 * РольФизическогоЛица - ПеречислениеСсылка.РолиФизическихЛиц
// 	 * Наставник - СправочникСсылка.ФизическиеЛица
// 	 * Куратор - СправочникСсылка.ФизическиеЛица
Функция НоваяТаблицаКадровогоРезерваНаДату() Экспорт
	
	НоваяТаблица = Новый ТаблицаЗначений();
	НоваяТаблица.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	НоваяТаблица.Колонки.Добавить("УчастникКадровогоРезерва", Метаданные.ОпределяемыеТипы.УчастникКадровогоРезерва.Тип);
	НоваяТаблица.Колонки.Добавить("ПозицияРезерва", Новый ОписаниеТипов("СправочникСсылка.КадровыйРезерв"));
	НоваяТаблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("ПеречислениеСсылка.СостоянияСогласования"));
	НоваяТаблица.Колонки.Добавить("ВидРезерва", Новый ОписаниеТипов("СправочникСсылка.ВидыКадровогоРезерва"));
	НоваяТаблица.Колонки.Добавить("СтатусРезервиста", Новый ОписаниеТипов("СправочникСсылка.СтатусыГотовностиРезервистов"));
	НоваяТаблица.Колонки.Добавить("РольФизическогоЛица", Новый ОписаниеТипов("ПеречислениеСсылка.РолиФизическихЛиц"));
	НоваяТаблица.Колонки.Добавить("Наставник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	НоваяТаблица.Колонки.Добавить("Куратор", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	НоваяТаблица.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));

	Возврат НоваяТаблица;
	
КонецФункции

// Возвращаемое значение:
//  Структура - Новый отбор кадрового резерва на дату:
//   * УчастникиКадровогоРезерва - Массив из ОпределяемыйТип.УчастникКадровогоРезерва
//   * Статусы - Массив из ПеречислениеСсылка.СостоянияСогласования
//   * ПозицияРезерва - СправочникСсылка.КадровыйРезерв
//   * ВидРезерва - СправочникСсылка.ВидыКадровогоРезерва
//   * ИсключаемыйРегистратор - ДокументСсылка,Неопределено
Функция НовыйОтборКадровогоРезерваНаДату() Экспорт
	
	Отбор = Новый Структура;
	Отбор.Вставить("УчастникиКадровогоРезерва", Новый Массив);
	Отбор.Вставить("Статусы", Новый Массив);
	Отбор.Вставить("ПозицияРезерва", Справочники.КадровыйРезерв.ПустаяСсылка());
	Отбор.Вставить("ВидРезерва", Справочники.ВидыКадровогоРезерва.ПустаяСсылка());
	Отбор.Вставить("ИсключаемыйРегистратор", Неопределено);
	
	Возврат Отбор;
	
КонецФункции

// Возвращает состояние кадрового резерва на определенную дату.
// 
// Параметры:
//  Период - Дата - дата, на конец дня которой получаем состояние кадрового резерва.
//  Отбор - см. НовыйОтборКадровогоРезерваНаДату
// 
// Возвращаемое значение:
//   см. НоваяТаблицаКадровогоРезерваНаДату
Функция КадровыйРезервНаДату(Период, Отбор = Неопределено) Экспорт

	ДанныеРезерва = НоваяТаблицаКадровогоРезерваНаДату();
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Возврат ДанныеРезерва;
	КонецЕсли;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СоздатьВременнуюТаблицуРезервисты(МенеджерВременныхТаблиц, КонецДня(Период), Отбор);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТРезервисты.УчастникКадровогоРезерва
		|ИЗ
		|	ВТРезервисты КАК ВТРезервисты";
	СписокФизическихЛиц = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("УчастникКадровогоРезерва");
	
	ПараметрыПолученияСотрудников = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолученияСотрудников.СписокФизическихЛиц = СписокФизическихЛиц;
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыПолученияСотрудников);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТСотрудникиОрганизации.Сотрудник) КАК КоличествоСотрудников,
		|	ВТСотрудникиОрганизации.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ ВТПризнакСотрудников
		|ИЗ
		|	ВТСотрудникиОрганизации КАК ВТСотрудникиОрганизации
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТСотрудникиОрганизации.ФизическоеЛицо
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТРезервисты.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ВЫБОР
		|		КОГДА ВТПризнакСотрудников.КоличествоСотрудников ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РолиФизическихЛиц.ПустаяСсылка)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РолиФизическихЛиц.Сотрудник)
		|	КОНЕЦ КАК РольФизическогоЛица,
		|	ВТРезервисты.ПозицияРезерва КАК ПозицияРезерва,
		|	ВТРезервисты.Статус КАК Статус,
		|	ВТРезервисты.ВидРезерва КАК ВидРезерва,
		|	ВТРезервисты.СтатусРезервиста КАК СтатусРезервиста,
		|	ВТРезервисты.Наставник КАК Наставник,
		|	ВТРезервисты.Период КАК Период,
		|	ВТРезервисты.Куратор КАК Куратор,
		|	ВЫБОР
		|		КОГДА ВТРезервисты.УчастникКадровогоРезерва ССЫЛКА Справочник.ФизическиеЛица
		|			ТОГДА ВТРезервисты.УчастникКадровогоРезерва
		|		ИНАЧЕ ФизическиеЛицаКандидатов.ФизическоеЛицо
		|	КОНЕЦ КАК ФизическоеЛицо
		|ИЗ
		|	ВТРезервисты КАК ВТРезервисты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПризнакСотрудников КАК ВТПризнакСотрудников
		|		ПО ВТРезервисты.УчастникКадровогоРезерва = ВТПризнакСотрудников.ФизическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФизическиеЛицаКандидатов КАК ФизическиеЛицаКандидатов
		|		ПО ВТРезервисты.УчастникКадровогоРезерва = ФизическиеЛицаКандидатов.ЛичныеДанныеКандидата";
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Запрос.Выполнить().Выгрузить(), ДанныеРезерва);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		МодульПодборПерсонала.ПриЗаполненииКадровогоРезерваНаДату(ДанныеРезерва);
	КонецЕсли;
	
	Возврат ДанныеРезерва;

КонецФункции

// Параметры:
//  УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
//  Период - Дата
//  Статусы - Массив из ПеречислениеСсылка.СостоянияСогласования,Неопределено
// 
// Возвращаемое значение:
//   см. НоваяТаблицаКадровогоРезерваНаДату
Функция ПозицииРезерваПоУчастникуКадровогоРезерва(УчастникКадровогоРезерва, Период, Статусы = Неопределено) Экспорт
	
	Отбор = НовыйОтборКадровогоРезерваНаДату();
	Отбор.УчастникиКадровогоРезерва = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УчастникКадровогоРезерва);
	Если ЗначениеЗаполнено(Статусы) Тогда
		Отбор.Статусы = Статусы;
	КонецЕсли;
	
	ПозицииРезерва = КадровыйРезервНаДату(Период, Отбор);
	
	Возврат ПозицииРезерва;
	
КонецФункции

Функция СтатусыГотовностиРезервистов(Дата, ПозицияРезерва = Неопределено, УчастникКадровогоРезерва = Неопределено,
	ИсключаемыйРегистратор = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыРезервистовСрезПоследних.ПозицияРезерва КАК ПозицияРезерва,
		|	СтатусыРезервистовСрезПоследних.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	СтатусыРезервистовСрезПоследних.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.СтатусыГотовностиРезервистов.СрезПоследних(
		|			&Дата,
		|			Регистратор <> &ИсключаемыйРегистратор
		|				И ПозицияРезерва В (&ПозицияРезерва)
		|				И УчастникКадровогоРезерва В (&УчастникКадровогоРезерва)) КАК СтатусыРезервистовСрезПоследних";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ПозицияРезерва", ПозицияРезерва);
	Запрос.УстановитьПараметр("УчастникКадровогоРезерва", УчастникКадровогоРезерва);
	Запрос.УстановитьПараметр("ИсключаемыйРегистратор", ИсключаемыйРегистратор);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает состояние кадрового резерва на текущий момент
// 	(запрос происходит по "вторичному" регистру)
// 	
// Параметры:
//	Отбор - Структура:
//	 * УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
//	 * ПозицияРезерва - СправочникСсылка.КадровыйРезерв
//	 * Статус - ПеречислениеСсылка.СостоянияСогласования
//	 * ВидРезерва - СправочникСсылка.ВидыКадровогоРезерва.
//		
// Возвращаемое значение:
// 	ТаблицаЗначений:
//	 * УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
//	 * ПозицияРезерва - СправочникСсылка.КадровыйРезерв
//	 * Статус - ПеречислениеСсылка.СостоянияСогласования
//	 * ВидРезерва - СправочникСсылка.ВидыКадровогоРезерва.
Функция ТекущийРезерв(Отбор = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СоздатьВТКадровыйРезерв(Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КадровыйРезерв.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	КадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
		|	КадровыйРезерв.Статус КАК Статус,
		|	КадровыйРезерв.ВидРезерва КАК ВидРезерва
		|ИЗ
		|	ВТКадровыйРезерв КАК КадровыйРезерв";
		
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		ТекстУсловия = " ГДЕ ";
		Если ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отбор, "Статус")) Тогда
			ТекстУсловия = ТекстУсловия + ?(ТекстУсловия = " ГДЕ ", "", " И ") + "КадровыйРезерв.Статус В(&Статус)";
			Если ТипЗнч(Отбор.Статус) = Тип("Массив") Тогда
				Запрос.УстановитьПараметр("Статус", Отбор.Статус);
			Иначе
				Запрос.УстановитьПараметр("Статус", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Отбор.Статус));
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отбор, "УчастникКадровогоРезерва")) Тогда
			ТекстУсловия = ТекстУсловия + ?(ТекстУсловия = " ГДЕ ", "", " И ")
				+ "КадровыйРезерв.УчастникКадровогоРезерва В(&УчастникиКадровогоРезерва)";
			Если ТипЗнч(Отбор.ФизическоеЛицо) = Тип("Массив") Тогда
				Запрос.УстановитьПараметр("УчастникиКадровогоРезерва", Отбор.УчастникКадровогоРезерва);
			Иначе
				Запрос.УстановитьПараметр("УчастникиКадровогоРезерва", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
					Отбор.УчастникКадровогоРезерва));
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отбор, "ПозицияРезерва")) Тогда
			ТекстУсловия = ТекстУсловия + ?(ТекстУсловия = " ГДЕ ", "", " И ")
				+ "КадровыйРезерв.ПозицияРезерва В(&ПозицияРезерва)";
			Если ТипЗнч(Отбор.ПозицияРезерва) = Тип("Массив") Тогда
				Запрос.УстановитьПараметр("ПозицияРезерва", Отбор.ПозицияРезерва);
			Иначе
				Запрос.УстановитьПараметр("ПозицияРезерва", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
					Отбор.ПозицияРезерва));
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отбор, "ВидРезерва")) Тогда
			ТекстУсловия = ТекстУсловия + ?(ТекстУсловия = " ГДЕ ", "", " И ") + "КадровыйРезерв.ВидРезерва В(&ВидРезерва)";
			Если ТипЗнч(Отбор.ВидРезерва) = Тип("Массив") Тогда
				Запрос.УстановитьПараметр("ВидРезерва", Отбор.ВидРезерва);
			Иначе
				Запрос.УстановитьПараметр("ВидРезерва", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Отбор.ВидРезерва));
			КонецЕсли;
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + ТекстУсловия;
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Определяет является ли позиция штатного расписания ключевой, то есть проассоциирована ли с ней однозначная позиция
// кадрового резерва.
// 
// Параметры:
//  ПозицияШтатногоРасписанияСсылка - СправочникСсылка.ШтатноеРасписание
// 
// Возвращаемое значение:
//  Булево
Функция ЭтоКлючеваяПозицияШтатногоРасписания(ПозицияШтатногоРасписанияСсылка) Экспорт
	
	СписокПозицийШР = ПодобратьПозицииРезерваПоПозицииШтатногоРасписания(ПозицияШтатногоРасписанияСсылка, Ложь);
	Возврат СписокПозицийШР.Количество() = 0;
	
КонецФункции

// Создает временную таблицу ВТКадровыйРезерв с описанием текущих статусов резервистов.
// 
// Параметры:
//  МенеджерВременныхТаблиц - МенеджерВременныхТаблиц
//  ТекущаяДата - Дата, Неопределено - 
Процедура СоздатьВТКадровыйРезерв(МенеджерВременныхТаблиц, ТекущаяДата = Неопределено) Экспорт
	
	Если ТекущаяДата = Неопределено Тогда
		ТекущаяДата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
		|	КадровыйРезерв.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ВЫБОР
		|		КОГДА КадровыйРезерв.ДатаИсключения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА КадровыйРезерв.Статус
		|		ИНАЧЕ ВЫБОР
		|				КОГДА КадровыйРезерв.ДатаИсключения > &ТекущаяДата
		|					ТОГДА КадровыйРезерв.Статус
		|				ИНАЧЕ &СтатусИсключен
		|			КОНЕЦ
		|	КОНЕЦ КАК Статус,
		|	КадровыйРезерв.ВидРезерва КАК ВидРезерва,
		|	КадровыйРезерв.Рейтинг КАК Рейтинг,
		|	КадровыйРезерв.ДатаВключения КАК ДатаВключения,
		|	КадровыйРезерв.ДатаИсключения КАК ДатаИсключения,
		|	КадровыйРезерв.Статус КАК СтатусДоИсключения
		|ПОМЕСТИТЬ ВТКадровыйРезерв
		|ИЗ
		|	РегистрСведений.КадровыйРезерв КАК КадровыйРезерв";
	
	Запрос.УстановитьПараметр("СтатусИсключен", ПредопределенноеЗначение(
		"Перечисление.СостоянияСогласования.ПустаяСсылка"));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	
	Запрос.Выполнить();
	
КонецПроцедуры

#Область ДанныеДокументовДляПроведения

// Возвращает таблицу значений, соответствующую движениям документа по регистру сведений ИсторияКадровогоРезерва.
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка.КадровыйПеревод
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ДанныеКадровогоПереводаДляКадровогоРезерва(ДокументСсылка) Экспорт

	НадоВыключатьПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КадровыйПеревод") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КадровыйПеревод.ДатаНачала КАК Период,
			|	КадровыйПеревод.ФизическоеЛицо КАК УчастникКадровогоРезерва,
			|	КадровыйПереводКадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
			|	КадровыйПереводКадровыйРезерв.ВидРезерва КАК ВидРезерва,
			|	ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.ПустаяСсылка) КАК Статус,
			|	КадровыйПеревод.Ссылка КАК Основание
			|ИЗ
			|	Документ.КадровыйПеревод.КадровыйРезерв КАК КадровыйПереводКадровыйРезерв
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КадровыйПеревод КАК КадровыйПеревод
			|		ПО КадровыйПереводКадровыйРезерв.Ссылка = КадровыйПеревод.Ссылка
			|ГДЕ
			|	КадровыйПереводКадровыйРезерв.Действие = ЗНАЧЕНИЕ(Перечисление.ДействияСКадровымиРезервистами.Отклонить)
			|	И КадровыйПеревод.Ссылка = &Ссылка";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КадровыйПереводСпискомСотрудники.ДатаНачала КАК Период,
			|	КадровыйПереводСпискомСотрудники.ФизическоеЛицо КАК УчастникКадровогоРезерва,
			|	КадровыйПереводСпискомКадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
			|	КадровыйПереводСпискомКадровыйРезерв.ВидРезерва КАК ВидРезерва,
			|	ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.ПустаяСсылка) КАК Статус,
			|	КадровыйПереводСпискомКадровыйРезерв.Ссылка КАК Основание
			|ИЗ
			|	Документ.КадровыйПереводСписком.КадровыйРезерв КАК КадровыйПереводСпискомКадровыйРезерв
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КадровыйПереводСписком.Сотрудники КАК КадровыйПереводСпискомСотрудники
			|		ПО КадровыйПереводСпискомКадровыйРезерв.Ссылка = КадровыйПереводСпискомСотрудники.Ссылка
			|			И КадровыйПереводСпискомКадровыйРезерв.ИдентификаторСтрокиСотрудника = КадровыйПереводСпискомСотрудники.ИдентификаторСтрокиСотрудника
			|ГДЕ
			|	КадровыйПереводСпискомКадровыйРезерв.Действие = ЗНАЧЕНИЕ(Перечисление.ДействияСКадровымиРезервистами.Отклонить)
			|	И КадровыйПереводСпискомСотрудники.Ссылка = &Ссылка";
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НадоВыключатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

// Параметры:
//  ДанныеДляПроведения - Структура
Процедура ДобавитьДанныеКадровогоРезерваДляРезультатовАттестацииСотрудников(ДанныеДляПроведения) Экспорт

	НадоВыключатьПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ДанныеДляПроведения.МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РешенияПоРезерву.Период,
	|	РешенияПоРезерву.Сотрудник.ФизическоеЛицо КАК УчастникКадровогоРезерва,
	|	РешенияПоРезерву.ПозицияРезерва,
	|	РешенияПоРезерву.ВидРезерва,
	|	&Включить КАК Статус,
	|	РешенияПоРезерву.Ссылка КАК Основание
	|ИЗ
	|	ВТРезультатыАттестацийСотрудников КАК РешенияПоРезерву
	|ГДЕ
	|	РешенияПоРезерву.РешениеКомиссии = &РекомендуетсяВКадровыйРезерв
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешенияПоРезерву.Период,
	|	РешенияПоРезерву.Сотрудник.ФизическоеЛицо КАК УчастникКадровогоРезерва,
	|	РешенияПоРезерву.ПозицияРезерва,
	|	РешенияПоРезерву.ВидРезерва,
	|	РешенияПоРезерву.СтатусГотовности КАК Статус
	|ИЗ
	|	ВТРезультатыАттестацийСотрудников КАК РешенияПоРезерву
	|ГДЕ
	|	РешенияПоРезерву.РешениеКомиссии = &РекомендуетсяВКадровыйРезерв";
	
	Запрос.УстановитьПараметр("РекомендуетсяВКадровыйРезерв", ОбщегоНазначения.ПредопределенныйЭлемент(
		"Справочник.РешенияАттестационныхКомиссий.РекомендуетсяВКадровыйРезерв"));
	Запрос.УстановитьПараметр("Включить", ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Согласовано"));
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДвиженияИсторииКадровогоРезерва = РезультатыЗапроса[РезультатыЗапроса.Количество() - 2];
	ДвиженияСтатусыРезервистов = РезультатыЗапроса[РезультатыЗапроса.Количество() - 1];
	
	ДвиженияДокумента = Новый Структура;
	ДвиженияДокумента.Вставить("ДвиженияИсторииКадровогоРезерва", ДвиженияИсторииКадровогоРезерва.Выгрузить());
	ДвиженияДокумента.Вставить("ДвиженияСтатусыРезервистов", ДвиженияСтатусыРезервистов.Выгрузить());
	ДанныеДляПроведения.Вставить("ДвиженияДокумента", ДвиженияДокумента);
	
	Если НадоВыключатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

// Возвращает таблицу значений, соответствующую движениям документа по регистру сведений ИсторияКадровогоРезерва.
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка.Увольнение, ДокументСсылка.УвольнениеСписком -
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ДанныеУвольненияДляКадровогоРезерва(ДокументСсылка) Экспорт

	НадоВыключатьПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Увольнение") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Увольнение.ДатаУвольнения КАК Период,
			|	Увольнение.ФизическоеЛицо КАК УчастникКадровогоРезерва,
			|	УвольнениеКадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
			|	УвольнениеКадровыйРезерв.ВидРезерва КАК ВидРезерва,
			|	ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.ПустаяСсылка) КАК Статус,
			|	УвольнениеКадровыйРезерв.Ссылка КАК Основание
			|ИЗ
			|	Документ.Увольнение.КадровыйРезерв КАК УвольнениеКадровыйРезерв
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Увольнение КАК Увольнение
			|		ПО УвольнениеКадровыйРезерв.Ссылка = Увольнение.Ссылка
			|ГДЕ
			|	УвольнениеКадровыйРезерв.Действие = ЗНАЧЕНИЕ(Перечисление.ДействияСКадровымиРезервистами.Отклонить)
			|	И Увольнение.Ссылка = &Ссылка";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УвольнениеСпискомСотрудники.ДатаУвольнения КАК Период,
			|	УвольнениеСпискомСотрудники.ФизическоеЛицо КАК УчастникКадровогоРезерва,
			|	УвольнениеСпискомКадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
			|	УвольнениеСпискомКадровыйРезерв.ВидРезерва КАК ВидРезерва,
			|	ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.ПустаяСсылка) КАК Статус,
			|	УвольнениеСпискомКадровыйРезерв.Ссылка КАК Основание
			|ИЗ
			|	Документ.УвольнениеСписком.КадровыйРезерв КАК УвольнениеСпискомКадровыйРезерв
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УвольнениеСписком.Сотрудники КАК УвольнениеСпискомСотрудники
			|		ПО УвольнениеСпискомКадровыйРезерв.Ссылка = УвольнениеСпискомСотрудники.Ссылка
			|			И УвольнениеСпискомКадровыйРезерв.ИдентификаторСтрокиСотрудника = УвольнениеСпискомСотрудники.ИдентификаторСтрокиСотрудника
			|ГДЕ
			|	УвольнениеСпискомКадровыйРезерв.Действие = ЗНАЧЕНИЕ(Перечисление.ДействияСКадровымиРезервистами.Отклонить)
			|	И УвольнениеСпискомСотрудники.Ссылка = &Ссылка";
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НадоВыключатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

// Заполняет движения по регистру ИсторияКадровогоРезерва.
//
// Параметры:
//	Движения - КоллекцияДвижений - коллекция движений, которую необходимо заполнить
//	ДвиженияДокумента - Структура
//	ИмяСвойства - Строка
Процедура СформироватьДвиженияИсторииКадровогоРезерва(Движения, ДвиженияДокумента, ИмяСвойства) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДвиженияДокумента, ИмяСвойства) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КадровыйРезервДвижения = ДвиженияДокумента[ИмяСвойства];
	Если КадровыйРезервДвижения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НадоВыключатьПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	Движения.ИсторияКадровогоРезерва.Записывать = Истина;
	Для Каждого СтрокаДанных Из КадровыйРезервДвижения Цикл
		НоваяСтрока = Движения.ИсторияКадровогоРезерва.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		НоваяСтрока.Период = НачалоДня(НоваяСтрока.Период) + ЗначениеВремениПоСтатусуРезерва(НоваяСтрока.Статус);
	КонецЦикла;
	
	Если НадоВыключатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Заполняет движения СтатусыРезервистов.
//
// Параметры:
//  Движения - КоллекцияДвижений - коллекция движений, в которой необходимо заполнить движения.
//	ДвиженияДокумента - Структура
//	ИмяСвойства - Строка
Процедура СформироватьДвиженияСтатусыГотовностиРезервистов(Движения, ДвиженияДокумента, ИмяСвойства) Экспорт
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр("КадровыйРезерв.СформироватьДвиженияСтатусыГотовностиРезервистов",
		"ДвиженияДокумента", ДвиженияДокумента, Тип("Структура"), Новый Структура(ИмяСвойства, Тип("ТаблицаЗначений")));
	
	НадоВыключатьПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	КадровыйРезервДвижения = ДвиженияДокумента[ИмяСвойства];
	Если КадровыйРезервДвижения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения.СтатусыГотовностиРезервистов.Записывать = Истина;
	Для Каждого СтрокаДанных Из КадровыйРезервДвижения Цикл
		НоваяСтрока = Движения.СтатусыГотовностиРезервистов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаДанных);
		НоваяСтрока.Период = НачалоДня(НоваяСтрока.Период);
	КонецЦикла;
	
	Если НадоВыключатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРегистров

// Заполняет вторичный Регистр сведений КадровыйРезерв из источника - РегистрСведений.ИсторияКадровогоРезерва.
//
// Параметры:
//  Движения - РегистрСведенийНаборЗаписей - коллекция движений, в которой необходимо заполнить движения.
//  ТаблицаОтборов - ТаблицаЗначений
Процедура ЗаполнитьЗаписиКадровогоРезерва(Движения, ТаблицаОтборов) Экспорт
	
	НадоВыключатьПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = РезультатЗапросаДляЗаполненияРегистраКадровыйРезерв(ТаблицаОтборов);
	
	Если РезультатЗапроса.Пустой() Тогда
		Для Каждого Строка Из ТаблицаОтборов Цикл
			НаборЗаписей = РегистрыСведений.КадровыйРезерв.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ПозицияРезерва.Установить(Строка.ПозицияРезерва);
			НаборЗаписей.Отбор.УчастникКадровогоРезерва.Установить(Строка.УчастникКадровогоРезерва);
			НаборЗаписей.Записать();
		КонецЦикла;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НаборЗаписей = РегистрыСведений.КадровыйРезерв.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ПозицияРезерва.Установить(ВыборкаДетальныеЗаписи.ПозицияРезерва);
			НаборЗаписей.Отбор.УчастникКадровогоРезерва.Установить(ВыборкаДетальныеЗаписи.УчастникКадровогоРезерва);
			Если ВыборкаДетальныеЗаписи.Статус <> Null Тогда
				НоваяЗапись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
			КонецЕсли;
			НаборЗаписей.Записать(Истина);
			НайденыеСтроки = ТаблицаОтборов.НайтиСтроки(
				Новый Структура("ПозицияРезерва, УчастникКадровогоРезерва", ВыборкаДетальныеЗаписи.ПозицияРезерва,
					ВыборкаДетальныеЗаписи.УчастникКадровогоРезерва));
			Для Каждого НайденнаяСтрока Из НайденыеСтроки Цикл
				ТаблицаОтборов.Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЦикла;
		Для Каждого Строка Из ТаблицаОтборов Цикл
			НаборЗаписей = РегистрыСведений.КадровыйРезерв.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ПозицияРезерва.Установить(Строка.ПозицияРезерва);
			НаборЗаписей.Отбор.УчастникКадровогоРезерва.Установить(Строка.УчастникКадровогоРезерва);
			НаборЗаписей.Записать();
		КонецЦикла;
	КонецЕсли;
	
	Если НадоВыключатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Записывает в регистр сведений КадровыйРезерв рейтинг участника кадрового резерва
// 
// Параметры:
//  ПозицияРезерва - СправочникСсылка.КадровыйРезерв
//  УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
//  Рейтинг - Число
Процедура ПоставитьРейтинг(ПозицияРезерва, УчастникКадровогоРезерва, Рейтинг) Экспорт

	НадоВыключатьПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.КадровыйРезерв.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ПозицияРезерва = ПозицияРезерва;
	МенеджерЗаписи.УчастникКадровогоРезерва = УчастникКадровогоРезерва;
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Рейтинг = Рейтинг;
	МенеджерЗаписи.Записать(Истина);

	Если НадоВыключатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

