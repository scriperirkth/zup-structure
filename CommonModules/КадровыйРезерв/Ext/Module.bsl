// Проверяет заполнение реквизитов ПозицияРезерва и ВидРезерва в табличной части документа.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  ИмяТабличнойЧасти - Строка
//  ПроверяемыеРеквизиты - Массив из Строка
//  Отказ - Булево
//  ПроверкаВнутриТЧ - Булево
Процедура ПроверитьЗаполнениеВидаРезерваВТабличнойЧасти(ДокументОбъект, ИмяТабличнойЧасти, ПроверяемыеРеквизиты, Отказ,
	ПроверкаВнутриТЧ = Ложь) Экспорт

	Если Не КадровыйРезервДоступенПользователю() Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, ИмяТабличнойЧасти + ".ПозицияРезерва");
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, ИмяТабличнойЧасти + ".ВидРезерва");
		Возврат;
	КонецЕсли;
	
	ТабличнаяЧастьДокумента = ДокументОбъект[ИмяТабличнойЧасти];
	
	Для каждого СтрокаТЧ Из ТабличнаяЧастьДокумента Цикл
		// Если проверка идет по условию других полей в строке - проверяем на это условие.
		Если ПроверкаВнутриТЧ Тогда
			Если СтрокаТЧ.РешениеКомиссии <> ОбщегоНазначения.ПредопределенныйЭлемент(
				"Справочник.РешенияАттестационныхКомиссий.РекомендуетсяВКадровыйРезерв") Тогда
				Продолжить;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаТЧ.ПозицияРезерва) Тогда
				ТекстСообщения = НСтр("ru = 'Не заполнена позиция резерва'");
				Поле = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИмяТабличнойЧасти + "[%1].ПозицияРезерва",
					ТабличнаяЧастьДокумента.Индекс(СтрокаТЧ));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект, Поле, , Отказ);
			КонецЕсли;
		КонецЕсли;
		
		// Если включен учет резерва по видам, то проверяем на заполнение и вид.
		Если ПолучитьФункциональнуюОпцию("ИспользоватьКадровыйРезервПоВидам")
			И Не ЗначениеЗаполнено(СтрокаТЧ.ВидРезерва) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен вид резерва'");
			Поле = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИмяТабличнойЧасти + "[%1].ВидРезерва",
				ТабличнаяЧастьДокумента.Индекс(СтрокаТЧ));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект, Поле , , Отказ);
		КонецЕсли;
	КонецЦикла; 
	
	Если ПроверкаВнутриТЧ Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, ИмяТабличнойЧасти + ".ПозицияРезерва");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, ИмяТабличнойЧасти + ".ВидРезерва");

КонецПроцедуры

// Возвращает список позиций кадрового резерва, соответствующих конкретной позиции штатного расписания.
// 
// Параметры:
//  ПозицияШтатногоРасписания - СправочникСсылка.ШтатноеРасписание
//  ВключатьГруппыДолжностей - Булево
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КадровыйРезерв
Функция ПодобратьПозицииРезерваПоПозицииШтатногоРасписания(ПозицияШтатногоРасписания,
	ВключатьГруппыДолжностей = Истина) Экспорт

	ПозицииРезерва = Новый Массив; // Массив из СправочникСсылка.КадровыйРезерв
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПозицияШтатногоРасписания", ПозицияШтатногоРасписания);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КадровыйРезерв.Ссылка КАК ПозицияРезерва
		|ИЗ
		|	Справочник.КадровыйРезерв КАК КадровыйРезерв
		|ГДЕ
		|	КадровыйРезерв.Назначение = ЗНАЧЕНИЕ(Перечисление.НазначенияКадровогоРезерва.ПозицияШтатногоРасписания)
		|	И КадровыйРезерв.ПозицияШтатногоРасписания = &ПозицияШтатногоРасписания";
	
	Если ВключатьГруппыДолжностей Тогда
		Должность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПозицияШтатногоРасписания, "Должность");
		Запрос.УстановитьПараметр("Должность", Должность);
		Запрос.Текст = Запрос.Текст +
		"
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КадровыйРезервДолжности.Ссылка
		|ИЗ
		|	Справочник.КадровыйРезерв.Должности КАК КадровыйРезервДолжности
		|ГДЕ
		|	КадровыйРезервДолжности.Ссылка.Назначение = ЗНАЧЕНИЕ(Перечисление.НазначенияКадровогоРезерва.ГруппаКадровогоРезерва)
		|	И КадровыйРезервДолжности.Должность = &Должность";
		
		Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.КадровыйРезерв.КадровыйРезервГосслужащих") Тогда
			МодульКадровыйРезервГосслужащих = ОбщегоНазначения.ОбщийМодуль("КадровыйРезервГосслужащих");
			МодульКадровыйРезервГосслужащих.ДополнитьПозицииРезерваПоДолжности(ПозицииРезерва, Должность);
		КонецЕсли;
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПозицииРезерва,
		РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ПозицияРезерва"), Истина);
	
	Возврат ПозицииРезерва;

КонецФункции

// Параметры:
//  ПозицияШтатногоРасписания - СправочникСсылка.ШтатноеРасписание
//  УстанавливатьПривилегированныйРежим - Булево
//  ДатаПолученияДанных - Дата - Дата на которую необходимо получить данные 
//  
// Возвращаемое значение:
//  Массив из СправочникСсылка.КадровыйРезерв
Функция ПозицииКадровогоРезерваСогласноПозицииШтатногоРасписания(ПозицияШтатногоРасписания,
	УстанавливатьПривилегированныйРежим = Ложь, ДатаПолученияДанных = '00010101') Экспорт
	
	ПозицииРезерва = Новый Массив; // Массив из СправочникСсылка.КадровыйРезерв
	
	МестоВСтруктуреПредприятия = ОрганизационнаяСтруктура.МестоПозицииВСтруктуреПредприятия(ПозицияШтатногоРасписания,
		ДатаПолученияДанных);
	Должность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПозицияШтатногоРасписания, "Должность");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КадровыйРезерв.Ссылка КАК ПозицияКадровогоРезерва
		|ИЗ
		|	Справочник.КадровыйРезерв КАК КадровыйРезерв
		|ГДЕ
		|	КадровыйРезерв.ВАрхиве = ЛОЖЬ
		|	И КадровыйРезерв.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|			КОГДА &ПозицияШтатногоРасписания <> ЗНАЧЕНИЕ(Справочник.ШтатноеРасписание.ПустаяСсылка)
		|				ТОГДА КадровыйРезерв.ПозицияШтатногоРасписания = &ПозицияШтатногоРасписания
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыйРезервДолжности.Ссылка
		|ИЗ
		|	Справочник.КадровыйРезерв.Должности КАК КадровыйРезервДолжности
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КадровыйРезерв.Подразделения КАК КадровыйРезервПодразделения
		|		ПО КадровыйРезервДолжности.Ссылка = КадровыйРезервПодразделения.Ссылка
		|			И КадровыйРезервДолжности.Должность = КадровыйРезервПодразделения.Должность
		|ГДЕ
		|	КадровыйРезервДолжности.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И КадровыйРезервДолжности.Ссылка.ВАрхиве = ЛОЖЬ
		|	И КадровыйРезервДолжности.Должность = &Должность
		|	И ВЫБОР
		|			КОГДА КадровыйРезервПодразделения.Подразделение ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ КадровыйРезервПодразделения.Подразделение = &МестоВСтруктуреПредприятия
		|		КОНЕЦ";
	Запрос.УстановитьПараметр("Должность", Должность);
	Запрос.УстановитьПараметр("ПозицияШтатногоРасписания", ПозицияШтатногоРасписания);
	Запрос.УстановитьПараметр("МестоВСтруктуреПредприятия", МестоВСтруктуреПредприятия);
	
	Если УстанавливатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПозицииРезерва,
		РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ПозицияКадровогоРезерва"), Истина);
		
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.КадровыйРезерв.КадровыйРезервГосслужащих") Тогда
		МодульКадровыйРезервГосслужащих = ОбщегоНазначения.ОбщийМодуль("КадровыйРезервГосслужащих");
		МодульКадровыйРезервГосслужащих.ДополнитьПозицииРезерваПоДолжности(ПозицииРезерва, Должность);
	КонецЕсли;
	
	Возврат ПозицииРезерва;
	
КонецФункции

// Параметры:
//  Должность - СправочникСсылка.Должности
//  УстанавливатьПривилегированныйРежим - Булево
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КадровыйРезерв
Функция ПозицииКадровогоРезерваСогласноДолжности(Должность, УстанавливатьПривилегированныйРежим = Ложь) Экспорт
	
	ПозицииРезерва = Новый Массив; // Массив из СправочникСсылка.КадровыйРезерв
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КадровыйРезервДолжности.Ссылка КАК ПозицияРезерва
		|ИЗ
		|	Справочник.КадровыйРезерв.Должности КАК КадровыйРезервДолжности
		|ГДЕ
		|	КадровыйРезервДолжности.Должность = &Должность
		|	И КадровыйРезервДолжности.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И КадровыйРезервДолжности.Ссылка.ВАрхиве = ЛОЖЬ";
	Запрос.УстановитьПараметр("Должность", Должность);
	
	Если УстанавливатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПозицииРезерва,
		РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ПозицияРезерва"), Истина);
		
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.КадровыйРезерв.КадровыйРезервГосслужащих") Тогда
		МодульКадровыйРезервГосслужащих = ОбщегоНазначения.ОбщийМодуль("КадровыйРезервГосслужащих");
		МодульКадровыйРезервГосслужащих.ДополнитьПозицииРезерваПоДолжности(ПозицииРезерва, Должность);
	КонецЕсли;
	
	Возврат ПозицииРезерва;
	
КонецФункции

// Функция возвращает список уже введенных позиций кадрового резерва, соотнесенных с позицией штатного расписания.
// 
// Параметры:
//  НеУчитываяСсылку - СправочникСсылка.КадровыйРезерв
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.ШтатноеРасписание
Функция СписокКлючевыхПозицийШтатногоРасписания(НеУчитываяСсылку) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НеУчитываяСсылку", НеУчитываяСсылку);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КадровыйРезерв.ПозицияШтатногоРасписания
	|ИЗ
	|	Справочник.КадровыйРезерв КАК КадровыйРезерв
	|ГДЕ
	|	НЕ КадровыйРезерв.ВАрхиве
	|	И КадровыйРезерв.Назначение = ЗНАЧЕНИЕ(Перечисление.НазначенияКадровогоРезерва.ПозицияШтатногоРасписания)
	|	И НЕ КадровыйРезерв.ПозицияШтатногоРасписания = ЗНАЧЕНИЕ(Справочник.ШтатноеРасписание.ПустаяСсылка)
	|	И КадровыйРезерв.Ссылка <> &НеУчитываяСсылку";	
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПозицияШтатногоРасписания");

КонецФункции

// Возвращает СправочникСсылка.КадровыйРезерв по строковому GUID
// 
// Параметры:
