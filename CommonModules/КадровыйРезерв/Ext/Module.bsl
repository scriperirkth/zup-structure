КонецПроцедуры

// Функция дополняет описание профиля ролями для работы с подсистемой Кадровый резерв.
// 
// Параметры:
//  ОписаниеПрофиля - см. УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа
Процедура ДополнитьОписаниеПрофиляКадровымРезервом(ОписаниеПрофиля) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.КадровыйРезерв.КадровыйРезервГосслужащих") Тогда
		МодульКадровыйРезервГосслужащих = ОбщегоНазначения.ОбщийМодуль("КадровыйРезервГосслужащих");
		МодульКадровыйРезервГосслужащих.ДополнитьОписаниеПрофиля(ОписаниеПрофиля);
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		МодульПодборПерсонала.ДополнитьОписаниеПрофиляПравамиНаЧтение(ОписаниеПрофиля);
		МодульПодборПерсонала.ДополнитьПрофильВидомДоступаПоГруппамКандидатов(ОписаниеПрофиля);
	КонецЕсли;
	
	МассивДобавляемыхРолей = Новый Массив;
	// Роли кадрового резерва.
	МассивДобавляемыхРолей.Добавить("ДобавлениеИзменениеКадровогоРезерва");
	МассивДобавляемыхРолей.Добавить("ДобавлениеИзменениеЗаявокНаВключениеВКадровыйРезерв");
	МассивДобавляемыхРолей.Добавить("НастройкаКадровогоРезерва");
	МассивДобавляемыхРолей.Добавить("ДобавлениеИзменениеСтатусовРезервистов");
	МассивДобавляемыхРолей.Добавить("ДобавлениеИзменениеОснованийКадровогоРезерва");
	МассивДобавляемыхРолей.Добавить("ПодсистемаКадровыйРезерв");

	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеДанныхЭлектронногоИнтервью",
		"ЗарплатаКадрыКорпоративнаяПодсистемы.ЭлектронноеИнтервью");
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОписаниеПрофиля.Роли, МассивДобавляемыхРолей, Истина);
	
КонецПроцедуры

// Возвращаемое значение:
//  ТаблицаЗначений - Новая таблица данных резервистов:
// * ФИОПолные - Строка 
// * УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
// * Организация - СправочникСсылка.Организации
// * Подразделение - СправочникСсылка.ПодразделенияОрганизаций
// * Должность - СправочникСсылка.Должности
// * РабочееМестоПериодРегистрации - Дата
// * МестоВСтруктуреПредприятия - СправочникСсылка.СтруктураПредприятия
// * ДополнительныеДанные - Структура
Функция НоваяТаблицаДанныхУчастниковКадровогоРезерва() Экспорт
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("УчастникКадровогоРезерва", Метаданные.ОпределяемыеТипы.УчастникКадровогоРезерва.Тип);
	ТаблицаДанных.Колонки.Добавить("ФИОПолные", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.ПодразделенияОрганизаций"));
	ТаблицаДанных.Колонки.Добавить("Должность", Новый ОписаниеТипов("СправочникСсылка.Должности"));
	ТаблицаДанных.Колонки.Добавить("РабочееМестоПериодРегистрации", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("МестоВСтруктуреПредприятия", Новый ОписаниеТипов(
		"СправочникСсылка.СтруктураПредприятия"));
	ТаблицаДанных.Колонки.Добавить("ДополнительныеДанные", Новый ОписаниеТипов("Структура"));

	Возврат ТаблицаДанных;
	
КонецФункции

// Параметры:
//  УчастникиКадровогоРезерва - Массив из ОпределяемыйТип.УчастникКадровогоРезерва
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаДанныхУчастниковКадровогоРезерва
Функция ДанныеУчастниковКадровогоРезерва(УчастникиКадровогоРезерва) Экспорт
	
	Данные = НоваяТаблицаДанныхУчастниковКадровогоРезерва();
	
	ФизическиеЛица = ОбщегоНазначения.СкопироватьРекурсивно(УчастникиКадровогоРезерва);
	ОбщегоНазначенияБЗККлиентСервер.УдалитьВсеВхожденияКромеТипаИзМассива(ФизическиеЛица,
		Тип("СправочникСсылка.ФизическиеЛица"));
	ДополнитьДанныеРезервистовДаннымиСотрудников(Данные, ФизическиеЛица);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		МодульПодборПерсонала.ДополнитьДанныеРезервистов(Данные, УчастникиКадровогоРезерва);
	КонецЕсли;
	
	Возврат Данные;
		
КонецФункции

// Параметры:
//  УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
// 
// Возвращаемое значение:
//  Структура,Неопределено:
//   * ФИОПолные - Строка 
//   * УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
//   * Организация - СправочникСсылка.Организации
//   * Подразделение - СправочникСсылка.ПодразделенияОрганизаций
//   * Должность - СправочникСсылка.Должности
//   * РабочееМестоПериодРегистрации - Дата
//   * МестоВСтруктуреПредприятия - СправочникСсылка.СтруктураПредприятия
//   * ДополнительныеДанные - Структура
Функция ДанныеУчастникаКадровогоРезерва(УчастникКадровогоРезерва)Экспорт
	
	ТаблицаДанных = ДанныеУчастниковКадровогоРезерва(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		УчастникКадровогоРезерва));
		
	Если ЗначениеЗаполнено(ТаблицаДанных) Тогда
		Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаДанных[0]);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Параметры:
//  УчастникиКадровогоРезерва - Массив из ОпределяемыйТип.УчастникКадровогоРезерва
// 
// Возвращаемое значение:
//  см. КадровыйУчетРасширенный.АдресаФотографийФизическихЛиц
Функция ФотографииУчастниковКадровогоРезерва(УчастникиКадровогоРезерва) Экспорт
	
	Фотографии = Новый Соответствие;
	
	ФизическиеЛица = ОбщегоНазначения.СкопироватьРекурсивно(УчастникиКадровогоРезерва);
	ОбщегоНазначенияБЗККлиентСервер.УдалитьВсеВхожденияКромеТипаИзМассива(ФизическиеЛица,
		Тип("СправочникСсылка.ФизическиеЛица"));
	
	Фотографии = КадровыйУчетРасширенный.АдресаФотографийФизическихЛиц(ФизическиеЛица);
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПодборПерсонала") Тогда
		МодульПодборПерсонала = ОбщегоНазначения.ОбщийМодуль("ПодборПерсонала");
		ФотографииКандидатов = МодульПодборПерсонала.АдресаФотографийЛичныхДанныхКандидатов(УчастникиКадровогоРезерва);
		ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(Фотографии, ФотографииКандидатов);
	КонецЕсли;
	
	Возврат Фотографии;
	
КонецФункции

// Возвращаемое значение:
//  ОписаниеТипов
Функция ОписаниеТиповУчастниковКадровогоРезерва() Экспорт
	
