	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.КадровыйРезервКлючевыхДолжностей, "КадровыйРезервКлючевыхДолжностей");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьКадровыйРезерв");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.КадровыйРезервКлючевыхДолжностей, "ГотовностьКадровогоРезерва");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьКадровыйРезерв");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.АнализКадровогоРезерва, "АнализКадровогоРезерва");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьКадровыйРезерв");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ДлительностьПодготовкиРезервистов, "ДлительностьПодготовкиРезервистов");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьКадровыйРезерв");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.СоставКадровогоРезерва, "ПозицииРезерва");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьКадровыйРезерв");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.СоставКадровогоРезерва, "ЦелевыеПозиции");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьКадровыйРезерв");
	Вариант.Включен = Не ПолучитьФункциональнуюОпцию("РаботаВБюджетномУчреждении");
	
КонецПроцедуры

// Возвращает таблицу позиций кадрового резерва, соответствующих переданным позициям штатного расписания.
// 
Функция ПозицииРезерваПоПозициямШтатногоРасписания(СписокПозиций, ВключатьГруппыДолжностей = Истина)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СписокПозиций", СписокПозиций);
	Запрос.УстановитьПараметр("ВключатьГруппыДолжностей", ВключатьГруппыДолжностей);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КадровыйРезерв.ПозицияШтатногоРасписания КАК Позиция,
		|	КадровыйРезерв.Ссылка КАК КадровыйРезерв
		|ИЗ
		|	Справочник.КадровыйРезерв КАК КадровыйРезерв
		|ГДЕ
		|	КадровыйРезерв.ПозицияШтатногоРасписания В (&СписокПозиций)
		|	И КадровыйРезерв.Назначение = ЗНАЧЕНИЕ(Перечисление.НазначенияКадровогоРезерва.ПозицияШтатногоРасписания)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ШтатноеРасписание.Ссылка,
		|	КадровыйРезервДолжности.Ссылка
		|ИЗ
		|	Справочник.КадровыйРезерв.Должности КАК КадровыйРезервДолжности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШтатноеРасписание КАК ШтатноеРасписание
		|		ПО КадровыйРезервДолжности.Должность = ШтатноеРасписание.Должность
		|		И (&ВключатьГруппыДолжностей)
		|		И (ШтатноеРасписание.Ссылка В (&СписокПозиций))
		|		И
		|			(КадровыйРезервДолжности.Ссылка.Назначение = ЗНАЧЕНИЕ(Перечисление.НазначенияКадровогоРезерва.ГруппаКадровогоРезерва))";
				   
	УстановитьПривилегированныйРежим(Истина);
	ПозицииРезерва = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ПозицииРезерва;
	
КонецФункции

Функция СогласованныйРезервПозиций(СписокПозиций, ДатаАктуальности) Экспорт 
	
	ПозицииКадровогоРезерва = ПозицииРезерваПоПозициямШтатногоРасписания(СписокПозиций);
	
	Отбор = НовыйОтборКадровогоРезерваНаДату();
	Отбор.Статусы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Согласовано"));
		
	УстановитьПривилегированныйРежим(Истина);
	ДанныеКадровогоРезерва = КадровыйРезервНаДату(ДатаАктуальности, Отбор);
	УстановитьПривилегированныйРежим(Ложь);
		
	УникальныеФизическиеЛица = Новый Соответствие;
	СписокФизическихЛиц = Новый Массив;
	
	ФизическиеЛицаПозиций = Новый Соответствие;
	
	Для Каждого ДанныеФизическогоЛица Из ДанныеКадровогоРезерва Цикл 
		
		Если УникальныеФизическиеЛица[ДанныеФизическогоЛица.ФизическоеЛицо] = Неопределено Тогда 
			УникальныеФизическиеЛица.Вставить(ДанныеФизическогоЛица.ФизическоеЛицо, Истина);
			СписокФизическихЛиц.Добавить(ДанныеФизическогоЛица.ФизическоеЛицо);
		КонецЕсли;
		
		Отбор = Новый Структура("КадровыйРезерв", ДанныеФизическогоЛица.ПозицияРезерва);
		НайденныеПозиции = ПозицииКадровогоРезерва.НайтиСтроки(Отбор);
		
		Для Каждого ДанныеПозиции Из НайденныеПозиции Цикл 
			ФизическиеЛица = ФизическиеЛицаПозиций[ДанныеПозиции.Позиция];
			Если ФизическиеЛица = Неопределено Тогда 
				ФизическиеЛица = Новый Соответствие;
				ФизическиеЛицаПозиций.Вставить(ДанныеПозиции.Позиция, ФизическиеЛица);
			КонецЕсли;
			ФизическиеЛица.Вставить(ДанныеФизическогоЛица.ФизическоеЛицо, Истина);
		КонецЦикла;
		
	КонецЦикла;
	
	КадровыеДанные = КадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, СписокФизическихЛиц, "ФИОПолные", ДатаАктуальности);
	
	КадровыйРезервПозиций = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из ФизическиеЛицаПозиций Цикл 
		
		Позиция = КлючИЗначение.Ключ;
		ФизическиеЛица = КлючИЗначение.Значение;
		
		КадровыйРезервПозиции = Новый СписокЗначений;
		Для Каждого ДанныеФизическогоЛица Из ФизическиеЛица Цикл 
			КадровыеДанныеФизическогоЛица = КадровыеДанные.Найти(ДанныеФизическогоЛица.Ключ, "ФизическоеЛицо");
			Если КадровыеДанныеФизическогоЛица <> Неопределено Тогда 
				КадровыйРезервПозиции.Добавить(КадровыеДанныеФизическогоЛица.ФизическоеЛицо, КадровыеДанныеФизическогоЛица.ФИОПолные);
			КонецЕсли;
		КонецЦикла;
		
		КадровыйРезервПозиции.СортироватьПоПредставлению();
		КадровыйРезервПозиций.Вставить(Позиция, КадровыйРезервПозиции);
		
	КонецЦикла;
	
	Возврат КадровыйРезервПозиций;
	
КонецФункции

Функция ЗначениеВремениПоСтатусуРезерва(Статус) Экспорт 

	Если Статус = ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Рассматривается") Тогда
	    Возврат 20;
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Согласовано") Тогда
		Возврат 40;
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СостоянияСогласования.ПустаяСсылка") Тогда
		Возврат 60;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

Процедура ЗаполнениеВремениДвиженийРегистраИРеквизитовДокументов() Экспорт

	// Движения регистра
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИсторияКадровогоРезерва.Регистратор
		|ИЗ
		|	РегистрСведений.ИсторияКадровогоРезерва КАК ИсторияКадровогоРезерва
		|ГДЕ
		|	ИсторияКадровогоРезерва.Период = НАЧАЛОПЕРИОДА(ИсторияКадровогоРезерва.Период, ДЕНЬ)";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ИсторияКадровогоРезерва.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		Для каждого ЗаписьНабора Из НаборЗаписей Цикл
			ЗаписьНабора.Период = НачалоДня(ЗаписьНабора.Период) + ЗначениеВремениПоСтатусуРезерва(ЗаписьНабора.Статус);
		КонецЦикла;
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать();
	КонецЦикла;
	
	// Документы.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаНаВключениеВКадровыйРезерв.Ссылка КАК Регистратор
		|ИЗ
		|	Документ.ЗаявкаНаВключениеВКадровыйРезерв КАК ЗаявкаНаВключениеВКадровыйРезерв
		|ГДЕ
		|	ЗаявкаНаВключениеВКадровыйРезерв.ДатаВыдвижения = НАЧАЛОПЕРИОДА(ЗаявкаНаВключениеВКадровыйРезерв.ДатаВыдвижения, ДЕНЬ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВключениеВКадровыйРезерв.Ссылка
		|ИЗ
		|	Документ.ВключениеВКадровыйРезерв КАК ВключениеВКадровыйРезерв
		|ГДЕ
		|	ВключениеВКадровыйРезерв.ДатаРассмотрения = НАЧАЛОПЕРИОДА(ВключениеВКадровыйРезерв.ДатаРассмотрения, ДЕНЬ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИсключениеИзКадровогоРезерва.Ссылка
		|ИЗ
		|	Документ.ИсключениеИзКадровогоРезерва КАК ИсключениеИзКадровогоРезерва
		|ГДЕ
		|	ИсключениеИзКадровогоРезерва.ДатаИсключения = НАЧАЛОПЕРИОДА(ИсключениеИзКадровогоРезерва.ДатаИсключения, ДЕНЬ)";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Регистратор.ПолучитьОбъект();
		ДокументОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область НачальнаяНастройкаПрограммы

Процедура ЗначенияСохраняемыхРеквизитовФормыНачальнаяНастройкаПрограммы(Форма, СохраняемыеРеквизиты) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Форма.РаботаВКОРП Тогда
		Возврат;
	КонецЕсли;
	
	СохраняемыеРеквизиты.Вставить("НастройкиКадровогоРезерва", ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(
			Форма.НастройкиКадровогоРезерва, Метаданные.РегистрыСведений.НастройкиКадровогоРезерва));
	
КонецПроцедуры

Процедура СохраненныеНастройкиВРеквизитыФормыНачальнаяНастройкаПрограммы(Форма, СохраненныеНастройки) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	Если СохраненныеНастройки.Свойство("НастройкиКадровогоРезерва") Тогда
		ЗаполнитьЗначенияСвойств(Форма["НастройкиКадровогоРезерва"], СохраненныеНастройки["НастройкиКадровогоРезерва"]);
	КонецЕсли;
	
КонецПроцедуры

Процедура НастройкиПрограммыВРеквизитыФормы(Форма) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = РегистрыСведений.НастройкиКадровогоРезерва.СоздатьМенеджерЗаписи();
	Настройки.Прочитать();
	НастройкиСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(Настройки, Метаданные.РегистрыСведений.НастройкиКадровогоРезерва);
	ЗаполнитьЗначенияСвойств(Форма.НастройкиКадровогоРезерва, НастройкиСтруктура);
	
КонецПроцедуры

Процедура ПолучитьНастройкиПрограммы(НастройкиПриложения) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = РегистрыСведений.НастройкиКадровогоРезерва.СоздатьМенеджерЗаписи();
	Настройки.Прочитать();
	НастройкиСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(Настройки, Метаданные.РегистрыСведений.НастройкиКадровогоРезерва);
	НастройкиПриложения.Вставить("НастройкиКадровогоРезерва", НастройкиСтруктура);
	
КонецПроцедуры

Процедура ЗаписатьНастройкиНачальнаяНастройкаПрограммы(Параметры) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = РегистрыСведений.НастройкиКадровогоРезерва.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Настройки, Параметры.НастройкиКадровогоРезерва);
	Настройки.Записать();
	
КонецПроцедуры

#КонецОбласти

Процедура ДокументКадровогоРезерваПослеЗагрузки(Объект, ФизическиеЛицаОбъекта)
	
	ОсновныеСотрудникиФизическихЛиц =
		КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(ФизическиеЛицаОбъекта, Истина,, Объект.Дата);
		
	КадровыеДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(
		Истина, ОсновныеСотрудникиФизическихЛиц.ВыгрузитьКолонку("Сотрудник"),
		"ДолжностьПоШтатномуРасписанию, МестоВСтруктуреПредприятия", Объект.Дата);
		
	Для Каждого ДанныеСотрудника Из КадровыеДанныеСотрудников Цикл
		Объект.Подразделение = ДанныеСотрудника.МестоВСтруктуреПредприятия;
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  ТаблицаОтборов - ТаблицаЗначений
// 
// Возвращаемое значение:
//  РезультатЗапроса
Функция РезультатЗапросаДляЗаполненияРегистраКадровыйРезерв(ТаблицаОтборов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаОтборов.ПозицияРезерва КАК ПозицияРезерва,
		|	ТаблицаОтборов.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва
		|ПОМЕСТИТЬ ВТТаблицаОтборов
		|ИЗ
		|	&ТаблицаОтборов КАК ТаблицаОтборов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсторияКадровогоРезерва.ПозицияРезерва КАК ПозицияРезерва,
		|	ИсторияКадровогоРезерва.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ИсторияКадровогоРезерва.Статус КАК Статус,
		|	ИсторияКадровогоРезерва.ВидРезерва КАК ВидРезерва,
		|	ИсторияКадровогоРезерва.Период КАК ДатаВключения,
		|	ИсторияКадровогоРезерва.ДатаОкончания КАК ДатаИсключения,
		|	ИсторияКадровогоРезерва.Наставник КАК Наставник,
		|	ИсторияКадровогоРезерва.Куратор КАК Куратор,
		|	ИсторияКадровогоРезерва.Основание КАК Основание
		|ПОМЕСТИТЬ ВТДанныеРегистра
		|ИЗ
		|	РегистрСведений.ИсторияКадровогоРезерва КАК ИсторияКадровогоРезерва
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТаблицаОтборов КАК ВТТаблицаОтборов
		|		ПО ИсторияКадровогоРезерва.ПозицияРезерва = ВТТаблицаОтборов.ПозицияРезерва
		|			И ИсторияКадровогоРезерва.УчастникКадровогоРезерва = ВТТаблицаОтборов.УчастникКадровогоРезерва
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДанныеРегистра.ПозицияРезерва КАК ПозицияРезерва,
		|	ВТДанныеРегистра.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ВТДанныеРегистра.Статус КАК Статус,
		|	ВТДанныеРегистра.ВидРезерва КАК ВидРезерва,
		|	ВТДанныеРегистра.ДатаВключения КАК ДатаВключения,
		|	ВТДанныеРегистра.ДатаИсключения КАК ДатаИсключения,
		|	ВТДанныеРегистра.Наставник КАК Наставник,
		|	ВТДанныеРегистра.Куратор КАК Куратор,
		|	ВТДанныеРегистра.Основание КАК Основание
		|ПОМЕСТИТЬ ВТЗначащихСтатусов
		|ИЗ
		|	ВТДанныеРегистра КАК ВТДанныеРегистра
		|ГДЕ
		|	ВТДанныеРегистра.Статус В(&ЗначащиеСтатусы)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТЗначащихСтатусов.ПозицияРезерва КАК ПозицияРезерва,
		|	ВТЗначащихСтатусов.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	МАКСИМУМ(ВТЗначащихСтатусов.ДатаВключения) КАК ДатаВключения
		|ПОМЕСТИТЬ ВТУказателиПоследнихЗначащихПериодов
		|ИЗ
		|	ВТЗначащихСтатусов КАК ВТЗначащихСтатусов
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТЗначащихСтатусов.ПозицияРезерва,
		|	ВТЗначащихСтатусов.УчастникКадровогоРезерва
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТУказателиПоследнихЗначащихПериодов.ПозицияРезерва КАК ПозицияРезерва,
		|	ВТУказателиПоследнихЗначащихПериодов.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ВТЗначащихСтатусов.Статус КАК Статус,
		|	ВТЗначащихСтатусов.ВидРезерва КАК ВидРезерва,
		|	ВТУказателиПоследнихЗначащихПериодов.ДатаВключения КАК ДатаВключения,
		|	ВТЗначащихСтатусов.ДатаИсключения КАК ДатаИсключения,
		|	ВТЗначащихСтатусов.Наставник КАК Наставник,
		|	ВТЗначащихСтатусов.Куратор КАК Куратор,
		|	ВТЗначащихСтатусов.Основание КАК Основание
		|ПОМЕСТИТЬ ВТИтоговыеЗначащиеПериоды
		|ИЗ
		|	ВТУказателиПоследнихЗначащихПериодов КАК ВТУказателиПоследнихЗначащихПериодов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗначащихСтатусов КАК ВТЗначащихСтатусов
		|		ПО ВТУказателиПоследнихЗначащихПериодов.ПозицияРезерва = ВТЗначащихСтатусов.ПозицияРезерва
		|			И ВТУказателиПоследнихЗначащихПериодов.УчастникКадровогоРезерва = ВТЗначащихСтатусов.УчастникКадровогоРезерва
		|			И ВТУказателиПоследнихЗначащихПериодов.ДатаВключения = ВТЗначащихСтатусов.ДатаВключения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДанныеРегистра.ПозицияРезерва КАК ПозицияРезерва,
		|	ВТДанныеРегистра.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ВТДанныеРегистра.Статус КАК Статус,
		|	ВТДанныеРегистра.ВидРезерва КАК ВидРезерва,
		|	ВТДанныеРегистра.ДатаВключения КАК ДатаИсключения,
		|	ВТДанныеРегистра.Основание КАК Основание
		|ПОМЕСТИТЬ ВТНеЗначащихСтатусов
		|ИЗ
		|	ВТДанныеРегистра КАК ВТДанныеРегистра
		|ГДЕ
		|	ВТДанныеРегистра.Статус В(&СтатусУволен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТНеЗначащихСтатусов.ПозицияРезерва КАК ПозицияРезерва,
		|	ВТНеЗначащихСтатусов.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	МАКСИМУМ(ВТНеЗначащихСтатусов.ДатаИсключения) КАК ДатаИсключения
		|ПОМЕСТИТЬ ВТУказателиПоследнихНеЗначащихПериодов
		|ИЗ
		|	ВТНеЗначащихСтатусов КАК ВТНеЗначащихСтатусов
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТНеЗначащихСтатусов.ПозицияРезерва,
		|	ВТНеЗначащихСтатусов.УчастникКадровогоРезерва
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТНеЗначащихСтатусов.ПозицияРезерва КАК ПозицияРезерва,
		|	ВТНеЗначащихСтатусов.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ВТНеЗначащихСтатусов.Основание КАК Основание,
		|	ВТУказателиПоследнихНеЗначащихПериодов.ДатаИсключения КАК ДатаИсключения
		|ПОМЕСТИТЬ ВТИтоговыеНеЗначащиеСтатусы
		|ИЗ
		|	ВТНеЗначащихСтатусов КАК ВТНеЗначащихСтатусов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТУказателиПоследнихНеЗначащихПериодов КАК ВТУказателиПоследнихНеЗначащихПериодов
		|		ПО ВТНеЗначащихСтатусов.ПозицияРезерва = ВТУказателиПоследнихНеЗначащихПериодов.ПозицияРезерва
		|			И ВТНеЗначащихСтатусов.УчастникКадровогоРезерва = ВТУказателиПоследнихНеЗначащихПериодов.УчастникКадровогоРезерва
		|			И ВТНеЗначащихСтатусов.ДатаИсключения = ВТУказателиПоследнихНеЗначащихПериодов.ДатаИсключения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
		|	КадровыйРезерв.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	КадровыйРезерв.Рейтинг КАК Рейтинг
		|ПОМЕСТИТЬ ВТРейтинг
		|ИЗ
		|	РегистрСведений.КадровыйРезерв КАК КадровыйРезерв
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТаблицаОтборов КАК ВТТаблицаОтборов
		|		ПО КадровыйРезерв.ПозицияРезерва = ВТТаблицаОтборов.ПозицияРезерва
		|			И КадровыйРезерв.УчастникКадровогоРезерва = ВТТаблицаОтборов.УчастникКадровогоРезерва
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТИтоговыеЗначащиеПериоды.ПозицияРезерва КАК ПозицияРезерва,
		|	ВТИтоговыеЗначащиеПериоды.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ВТИтоговыеЗначащиеПериоды.Статус КАК Статус,
		|	ВТИтоговыеЗначащиеПериоды.ВидРезерва КАК ВидРезерва,
		|	ВТИтоговыеЗначащиеПериоды.ДатаВключения КАК ДатаВключения,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТИтоговыеНеЗначащиеСтатусы.ДатаИсключения, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ВТИтоговыеЗначащиеПериоды.ДатаИсключения
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ВТИтоговыеЗначащиеПериоды.ДатаИсключения = ДАТАВРЕМЯ(1, 1, 1)
		|						И ВТИтоговыеЗначащиеПериоды.ДатаВключения < ВТИтоговыеНеЗначащиеСтатусы.ДатаИсключения
		|					ТОГДА ВТИтоговыеНеЗначащиеСтатусы.ДатаИсключения
		|				ИНАЧЕ ВЫБОР
		|						КОГДА ВТИтоговыеЗначащиеПериоды.ДатаИсключения > ВТИтоговыеНеЗначащиеСтатусы.ДатаИсключения
		|								И ВТИтоговыеЗначащиеПериоды.ДатаВключения < ВТИтоговыеНеЗначащиеСтатусы.ДатаИсключения
		|							ТОГДА ВТИтоговыеНеЗначащиеСтатусы.ДатаИсключения
		|						ИНАЧЕ ВТИтоговыеЗначащиеПериоды.ДатаИсключения
		|					КОНЕЦ
		|			КОНЕЦ
		|	КОНЕЦ КАК ДатаИсключения,
		|	ЕСТЬNULL(ВТРейтинг.Рейтинг, 0) КАК Рейтинг,
		|	ВТИтоговыеЗначащиеПериоды.Наставник КАК Наставник,
		|	ВТИтоговыеЗначащиеПериоды.Куратор КАК Куратор,
		|	ВТИтоговыеЗначащиеПериоды.Основание КАК ОснованиеВключенияВРезерв,
		|	ЕСТЬNULL(ВТИтоговыеНеЗначащиеСтатусы.Основание, ЗНАЧЕНИЕ(Справочник.ОснованияКадровогоРезерва.ПустаяСсылка)) КАК ОснованиеИсключенияИзРезерва
		|ИЗ
		|	ВТИтоговыеЗначащиеПериоды КАК ВТИтоговыеЗначащиеПериоды
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИтоговыеНеЗначащиеСтатусы КАК ВТИтоговыеНеЗначащиеСтатусы
		|		ПО ВТИтоговыеЗначащиеПериоды.ПозицияРезерва = ВТИтоговыеНеЗначащиеСтатусы.ПозицияРезерва
		|			И ВТИтоговыеЗначащиеПериоды.УчастникКадровогоРезерва = ВТИтоговыеНеЗначащиеСтатусы.УчастникКадровогоРезерва
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРейтинг КАК ВТРейтинг
		|		ПО ВТИтоговыеЗначащиеПериоды.ПозицияРезерва = ВТРейтинг.ПозицияРезерва
		|			И ВТИтоговыеЗначащиеПериоды.УчастникКадровогоРезерва = ВТРейтинг.УчастникКадровогоРезерва";
		
	Запрос.УстановитьПараметр("ТаблицаОтборов", ТаблицаОтборов);
	ЗначащиеСтатусы = Новый Массив;
	ЗначащиеСтатусы.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Рассматривается"));
	ЗначащиеСтатусы.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияСогласования.Согласовано"));
	Запрос.УстановитьПараметр("ЗначащиеСтатусы", ЗначащиеСтатусы);
	Запрос.УстановитьПараметр("СтатусУволен", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПредопределенноеЗначение("Перечисление.СостоянияСогласования.ПустаяСсылка")));
	
	Возврат Запрос.Выполнить();
		
КонецФункции

// См. КадровыйРезервСлужебный.ТипыУчастниковКадровогоРезерваДоступныхПоФункциональнымОпциям
Функция ТипыУчастниковКадровогоРезерваДоступныхПоФункциональнымОпциям() Экспорт
	
	Возврат КадровыйРезервПовтИсп.ТипыУчастниковКадровогоРезерваДоступныхПоФункциональнымОпциям();
	
КонецФункции

// Параметры:
//  МенеджерВременныхТаблиц - МенеджерВременныхТаблиц
//  ДатаСреза - см. КадровыйРезервНаДату.Период
//  Отбор - см. НовыйОтборКадровогоРезерваНаДату
Процедура СоздатьВременнуюТаблицуРезервисты(МенеджерВременныхТаблиц, ДатаСреза, Отбор = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыРезервистовСрезПоследних.ПозицияРезерва КАК ПозицияРезерва,
		|	СтатусыРезервистовСрезПоследних.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	СтатусыРезервистовСрезПоследних.Статус КАК СтатусРезервиста
		|ПОМЕСТИТЬ ВТСтатусыРезервистов
		|ИЗ
		|	РегистрСведений.СтатусыГотовностиРезервистов.СрезПоследних(&ДатаСреза) КАК СтатусыРезервистовСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПозицияРезерва,
		|	УчастникКадровогоРезерва
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсторияКадровогоРезерваСрезПоследних.УчастникКадровогоРезерва КАК УчастникКадровогоРезерва,
		|	ИсторияКадровогоРезерваСрезПоследних.ПозицияРезерва КАК ПозицияРезерва,
		|	ИсторияКадровогоРезерваСрезПоследних.Статус КАК Статус,
		|	ИсторияКадровогоРезерваСрезПоследних.ВидРезерва КАК ВидРезерва,
		|	ИсторияКадровогоРезерваСрезПоследних.Наставник КАК Наставник,
		|	ИсторияКадровогоРезерваСрезПоследних.Куратор КАК Куратор,
		|	ИсторияКадровогоРезерваСрезПоследних.Период КАК Период,
		|	ВТСтатусыРезервистов.СтатусРезервиста КАК СтатусРезервиста
		|ПОМЕСТИТЬ ВТРезервисты
		|ИЗ
		|	РегистрСведений.ИсторияКадровогоРезерва.СрезПоследних(&ДатаСреза, ДатаОкончания >= &ДатаСреза
		|	ИЛИ ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)) КАК ИсторияКадровогоРезерваСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтатусыРезервистов КАК ВТСтатусыРезервистов
		|		ПО ИсторияКадровогоРезерваСрезПоследних.ПозицияРезерва = ВТСтатусыРезервистов.ПозицияРезерва
		|		И ИсторияКадровогоРезерваСрезПоследних.УчастникКадровогоРезерва = ВТСтатусыРезервистов.УчастникКадровогоРезерва
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	УчастникКадровогоРезерва";
	
	Если Отбор <> Неопределено Тогда
		СхемаЗапроса = Новый СхемаЗапроса();
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
		ПакетЗапросаСтатусыРезервистов = СхемаЗапроса.ПакетЗапросов[0];
		ОператорЗапросаСтатусыРезервистов = ПакетЗапросаСтатусыРезервистов.Операторы[0]; 
		СтатусыГотовностиРезервистовПараметры = ОператорЗапросаСтатусыРезервистов.Источники[0].Источник.Параметры;
		СтатусыГотовностиРезервистовОтбор = "";
		
		ПакетЗапросаРезервисты = СхемаЗапроса.ПакетЗапросов[1];
		ОператорЗапросаРезервисты = ПакетЗапросаРезервисты.Операторы[0]; 
		ИсторияКадровогоРезерваПараметры = ОператорЗапросаРезервисты.Источники[0].Источник.Параметры;
		ИсторияКадровогоРезерваОтбор = "(" + ИсторияКадровогоРезерваПараметры[1].Выражение + ")";
	
		// Отбор по измерениям регистра.
		Если ЗначениеЗаполнено(Отбор.УчастникиКадровогоРезерва) Тогда
			ТекстУсловия = "УчастникКадровогоРезерва В(&УчастникиКадровогоРезерва)";
			ИсторияКадровогоРезерваОтбор = ИсторияКадровогоРезерваОтбор	+ " И " + ТекстУсловия;
			СтатусыГотовностиРезервистовОтбор = СтатусыГотовностиРезервистовОтбор + ТекстУсловия;
			УстановитьПараметрЗначениеВМассиве(Запрос, "УчастникиКадровогоРезерва", Отбор.УчастникиКадровогоРезерва);
		КонецЕсли;
		Если ЗначениеЗаполнено(Отбор.ПозицияРезерва) Тогда
			ТекстУсловия = "ПозицияРезерва В(&ПозицияРезерва)";
			ИсторияКадровогоРезерваОтбор = ИсторияКадровогоРезерваОтбор + " И " + ТекстУсловия;
			СтатусыГотовностиРезервистовОтбор = СтатусыГотовностиРезервистовОтбор
				+ ?(ЗначениеЗаполнено(СтатусыГотовностиРезервистовОтбор), " И ", "") + ТекстУсловия;
			УстановитьПараметрЗначениеВМассиве(Запрос, "ПозицияРезерва", Отбор.ПозицияРезерва);
		КонецЕсли;
		Если ЗначениеЗаполнено(Отбор.ИсключаемыйРегистратор) Тогда
			ИсторияКадровогоРезерваОтбор = ИсторияКадровогоРезерваОтбор + " И Регистратор <> &Регистратор";
			Запрос.УстановитьПараметр("Регистратор", Отбор.ИсключаемыйРегистратор);
		КонецЕсли;
		СтатусыГотовностиРезервистовПараметры[1].Выражение = Новый ВыражениеСхемыЗапроса(СтатусыГотовностиРезервистовОтбор);
		ИсторияКадровогоРезерваПараметры[1].Выражение = Новый ВыражениеСхемыЗапроса(ИсторияКадровогоРезерваОтбор);
		
		// Отбор по ресурсам регистра.
		Если ЗначениеЗаполнено(Отбор.Статусы) Тогда
			ОператорЗапросаСтатусыРезервистов.Отбор.Добавить("СтатусыРезервистовСрезПоследних.Статус В(&Статусы)");
			ОператорЗапросаРезервисты.Отбор.Добавить("ИсторияКадровогоРезерваСрезПоследних.Статус В(&Статусы)");
			УстановитьПараметрЗначениеВМассиве(Запрос, "Статусы", Отбор.Статусы);
		КонецЕсли;
		Если ЗначениеЗаполнено(Отбор.ВидРезерва) Тогда
			ОператорЗапросаРезервисты.Отбор.Добавить("ВидРезерва В(&ВидРезерва)");
			УстановитьПараметрЗначениеВМассиве(Запрос, "ВидРезерва", Отбор.ВидРезерва);
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура УстановитьПараметрЗначениеВМассиве(Запрос, ИмяПараметра, ЗначениеПараметра)
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Массив") Тогда
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеПараметра);
	Иначе
		Запрос.УстановитьПараметр(ИмяПараметра, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗначениеПараметра));
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  ДанныеУчастниковКадровогоРезерва - см. НоваяТаблицаДанныхУчастниковКадровогоРезерва
//  ФизическиеЛица - Массив из СправочникСсылка.ФизическиеЛица
Процедура ДополнитьДанныеРезервистовДаннымиСотрудников(ДанныеУчастниковКадровогоРезерва, ФизическиеЛица)
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.СписокФизическихЛиц = ФизическиеЛица;
	ПараметрыПолучения.ОкончаниеПериода = ТекущаяДатаСеанса();
	ПараметрыПолучения.КадровыеДанные =
		"ФИОПолные, Организация, Подразделение, Должность, РабочееМестоПериодРегистрации, МестоВСтруктуреПредприятия";
	СотрудникиОрганизации = КадровыйУчет.СотрудникиОрганизации(Истина, ПараметрыПолучения);
	Для Каждого СтрокаТаблицы Из СотрудникиОрганизации Цикл
		НоваяСтрока = ДанныеУчастниковКадровогоРезерва.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.УчастникКадровогоРезерва = СтрокаТаблицы.ФизическоеЛицо;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьИспользованиеКадровогоРезерваПоВидам(КадровыйРезервПоВидамДоступен) Экспорт
	
	КадровыйРезервПоВидамДоступен = Ложь;
	
	Если КадровыйРезервДоступенПользователю() И ПолучитьФункциональнуюОпцию("ИспользоватьКадровыйРезервПоВидам") Тогда
		
		КадровыйРезервПоВидамДоступен = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
