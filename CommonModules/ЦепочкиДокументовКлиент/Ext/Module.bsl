#Область ПрограммныйИнтерфейс

#Область ОбработчикиСобытийЭлементовТаблицФормДокументов

// Вызывается при выборе строки табличной части в многосотрудниковых документах.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения -
//  ВыбраннаяСтрока - Число -
//  Поле - ПолеФормы -
//  СтандартнаяОбработка - Булево -
Процедура ПриВыбореСтрокиТабличнойЧасти(Форма, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	
	Если Не ЦепочкиДокументовВызовСервера.ИспользоватьЦепочкиДокументов() Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "СотрудникиЗамещениеИнфоНадпись" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Форма.Модифицированность Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Перед вводом замещения необходимо записать документ.'"));
			Возврат;
		КонецЕсли;
		
		ОписаниеДокумента = ЦепочкиДокументовВызовСервера.ОписаниеДокументовЗамещения(Форма.Объект.Ссылка);
		
		ПараметрыФормы = ПараметрыОткрытияФормыЗамещения();
		ПараметрыФормы.ДокументСсылка = Форма.Объект.Ссылка;
		ЗаполнитьПараметрыФормыИзСтрокиТабличнойЧасти(ПараметрыФормы, Форма.Объект, ОписаниеДокумента, ВыбраннаяСтрока);
			
		ОткрытьФорму("Обработка.ЦепочкиКадровыхДокументов.Форма.ПомощникЗамещения", ПараметрыФормы, ЭтотОбъект, Истина);
		
	КонецЕсли;
		
КонецПроцедуры

// Вызывается перед началом изменения строки табличной части в многосотрудниковых документах.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Элемент - ТаблицаФормы
//  Отказ - Булево
Процедура ПередНачаломИзмененияСтрокиТабличнойЧасти(Форма, Элемент, Отказ) Экспорт
	
	ПроверитьВозможностьРедактированияСтрокиТабличнойЧасти(Форма, Элемент, Отказ);
	
КонецПроцедуры

// Вызывается перед удалением строки табличной части в многосотрудниковых документах.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Элемент - ТаблицаФормы
//  Отказ - Булево
Процедура ПередУдалениемСтрокиТабличнойЧасти(Форма, Элемент, Отказ) Экспорт
	
	ПроверитьВозможностьРедактированияСтрокиТабличнойЧасти(Форма, Элемент, Отказ);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ОткрытьФормуЗамещенияПоСсылке(Форма, НавигационнаяСсылка, СтандартнаяОбработка) Экспорт 

	СтандартнаяОбработка = Ложь;
	
	Если Не ЦепочкиДокументовВызовСервера.ИспользоватьЦепочкиДокументов() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСсылки = ЦепочкиДокументовКлиентСервер.СтруктураНавигационнойСсылки(НавигационнаяСсылка);
	
	Если СтруктураСсылки.Режим = "ВызовФормыЗамещения" Тогда
		ОткрытьФормуПомощникаЗамещения(Форма, СтруктураСсылки);
	Иначе	
		ОткрытьФормуДокументаЗамещения(Форма, СтруктураСсылки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуДокументаЗамещения(Форма, СтруктураСсылки) Экспорт 
	
	Если Не ЦепочкиДокументовВызовСервера.ИспользоватьЦепочкиДокументов() Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураСсылки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяОткрываемойФормы = СтрЗаменить("Документ.%1.ФормаОбъекта", "%1", СтруктураСсылки.ИмяМетаданных);
	ДокументСсылка = ЦепочкиДокументовВызовСервера.ДокументПоСсылке(СтруктураСсылки.ИмяМетаданных,
		СтруктураСсылки.НавигационнаяСсылка);
	
	ОткрытьФорму(ИмяОткрываемойФормы, Новый Структура("Ключ", ДокументСсылка));

КонецПроцедуры

Процедура ОповеститьЗаписанПодчиненныйДокумент(Форма) Экспорт 

	Если Не ЦепочкиДокументовВызовСервера.ИспользоватьЦепочкиДокументов() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ЗамещениеДокументОснование) Тогда
		Оповестить("ЗаписанПодчиненныйДокумент", , Форма.ЗамещениеДокументОснование);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОткрытьФормуПомощникаЗамещения(Форма, СтруктураСсылки) 

	ДополнительныеПараметры = Новый Структура("Форма, СтруктураСсылки", Форма, СтруктураСсылки);
	Если ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		ОткрытьФормуПомощникаЗамещенияЗавершение(Неопределено, ДополнительныеПараметры);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ОткрытьФормуПомощникаЗамещенияЗавершение", ЭтотОбъект,
			ДополнительныеПараметры);
		ТекстВопроса = НСтр("ru = 'Ввести замещение можно только для записанного документа. Записать?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуПомощникаЗамещенияЗавершение(Результат, ДополнительныеПараметры) Экспорт 

	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
	СтруктураСсылки = ДополнительныеПараметры.СтруктураСсылки;
	Объект = Форма.Объект;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Форма.Записать();
	КонецЕсли;
	
	ДокументСсылка = ЦепочкиДокументовВызовСервера.ДокументПоСсылке(СтруктураСсылки.ИмяМетаданных,
		СтруктураСсылки.НавигационнаяСсылка);
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		ДокументСсылка = Объект.Ссылка;
	КонецЕсли;
	
	ПараметрыФормы = ПараметрыОткрытияФормыЗамещения();
	
	ПараметрыФормы.ДокументСсылка = ДокументСсылка;
	ПараметрыФормы.ФормироватьПараметрыПоСсылке = СтруктураСсылки.ФормироватьПараметрыПоСсылке;
	
	Если Не СтруктураСсылки.ФормироватьПараметрыПоСсылке Тогда
		
		ОписаниеДокумента = ЦепочкиДокументовВызовСервера.ОписаниеДокументовЗамещения(ДокументСсылка);
		
		Если ЦепочкиДокументовВызовСервера.ЭтоМногосотрудниковыйДокумент(ДокументСсылка) Тогда
			ИндексСтроки = СтруктураСсылки.Свойство("ИндексСтроки");
			ЗаполнитьПараметрыФормыИзСтрокиТабличнойЧасти(ПараметрыФормы, Объект, ОписаниеДокумента, ИндексСтроки);
		Иначе
			ПараметрыФормы.Сотрудник = Объект[ОписаниеДокумента.ИмяРеквизитаСотрудник];
			ПараметрыФормы.ДатаНачала = Объект[ОписаниеДокумента.ИмяРеквизитаДатаНачалаСобытия];
			ПараметрыФормы.ДатаОкончания = Объект[ОписаниеДокумента.ИмяРеквизитаДатаОкончанияСобытия];
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеДокумента.ИмяРеквизитаФормыТекущаяПозицияШР) Тогда
			ПараметрыФормы.ТекущаяПозицияШР = Форма[ОписаниеДокумента.ИмяРеквизитаФормыТекущаяПозицияШР];
		КонецЕсли;
		
	КонецЕсли;
	
	ОткрытьФорму("Обработка.ЦепочкиКадровыхДокументов.Форма.ПомощникЗамещения", ПараметрыФормы, Форма, Истина);
	
КонецПроцедуры

// Параметры:
//  ПараметрыФормы - см. ПараметрыОткрытияФормыЗамещения
//  Объект - ДанныеФормыСтруктура
//  ОписаниеДокумента - см. ЦепочкиДокументовВызовСервера.ОписаниеДокументовЗамещения
//  ИндексСтроки - Число
Процедура ЗаполнитьПараметрыФормыИзСтрокиТабличнойЧасти(ПараметрыФормы, Объект, ОписаниеДокумента, ИндексСтроки)
	
	ИмяТабличнойЧасти = ОписаниеДокумента.ИмяТабличнойЧастиСотрудники;
	
	ПараметрыФормы.Сотрудник = ЗначениеИзТабличнойЧастиОбъекта(Объект, ИмяТабличнойЧасти,
		ОписаниеДокумента.ИмяРеквизитаСотрудник, ИндексСтроки);
	ПараметрыФормы.ДатаНачала = ЗначениеИзТабличнойЧастиОбъекта(Объект, ИмяТабличнойЧасти,
		ОписаниеДокумента.ИмяРеквизитаДатаНачалаСобытия, ИндексСтроки);
	ПараметрыФормы.ДатаОкончания = ЗначениеИзТабличнойЧастиОбъекта(Объект, ИмяТабличнойЧасти,
		ОписаниеДокумента.ИмяРеквизитаДатаОкончанияСобытия, ИндексСтроки);
	ПараметрыФормы.ИдентификаторСтрокиОснования = ЗначениеИзТабличнойЧастиОбъекта(Объект, ИмяТабличнойЧасти,
		ОписаниеДокумента.ИмяРеквизитаИдентификаторСтроки, ИндексСтроки);
	
КонецПроцедуры

// Параметры:
//  Объект - ДанныеФормыСтруктура
//  ИмяТабличнойЧасти - Строка
//  ИмяРеквизита - Строка
//  ИндексСтроки - Число
// 
// Возвращаемое значение:
//  Произвольный 
Функция ЗначениеИзТабличнойЧастиОбъекта(Объект, ИмяТабличнойЧасти, ИмяРеквизита, ИндексСтроки)
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Объект, ИмяТабличнойЧасти)),
		СтрШаблон(НСтр("ru = 'В документе %1 нет табличной части %2'"), Объект, ИмяТабличнойЧасти),
		"ЦепочкиДокументовКлиент.ЗначениеИзТабличнойЧастиОбъекта");
		
	СтрокаТабличнойЧасти = Объект[ИмяТабличнойЧасти].НайтиПоИдентификатору(ИндексСтроки);

	ОбщегоНазначенияКлиентСервер.Проверить(СтрокаТабличнойЧасти <> Неопределено,
		СтрШаблон(НСтр("ru = 'В документе %1 не найдена строка табличной части %2 с индексом %3'"), Объект,
			ИмяТабличнойЧасти, ИндексСтроки), "ЦепочкиДокументовКлиент.ЗначениеИзТабличнойЧастиОбъекта");
	
	Результат = СтрокаТабличнойЧасти[ИмяРеквизита];
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Элемент - ТаблицаФормы
//  Отказ - Булево
Процедура ПроверитьВозможностьРедактированияСтрокиТабличнойЧасти(Форма, Элемент, Отказ)
	
	Если Не ЦепочкиДокументовВызовСервера.ИспользоватьЦепочкиДокументов()
		Или Не ЗначениеЗаполнено(Форма.Параметры.Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоПодчиненных = Форма.Элементы[Элемент.Имя].ТекущиеДанные.ЗамещениеКоличествоПодчиненных;
	Если КоличествоПодчиненных > 0 Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'По данной строке %1, редактирование невозможно.'"),
			?(КоличествоПодчиненных = 1, НСтр("ru = 'введено замещение'"), НСтр("ru = 'введены замещения'")));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Возвращаемое значение:
//  Структура - Параметры открытия формы замещения:
// * ДокументСсылка - ОпределяемыйТип.ЦепочкиДокументовОснования 
// * Сотрудник - СправочникСсылка.Сотрудники -
// * ПозицияШР - СправочникСсылка.ШтатноеРасписание -
// * ДатаНачала - Дата -
// * ДатаОкончания - Дата -
// * ИдентификаторСтрокиОснования - УникальныйИдентификатор -
// * ТекущаяПозицияШР - СправочникСсылка.ШтатноеРасписание -
// * ФормироватьПараметрыПоСсылке - Булево -
Функция ПараметрыОткрытияФормыЗамещения()

	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДокументСсылка");
	ПараметрыФормы.Вставить("Сотрудник", ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка"));
	ПараметрыФормы.Вставить("ПозицияШР", ПредопределенноеЗначение("Справочник.ШтатноеРасписание.ПустаяСсылка"));
	ПараметрыФормы.Вставить("ДатаНачала", Дата(1, 1, 1));
	ПараметрыФормы.Вставить("ДатаОкончания", Дата(1, 1, 1));
	ПараметрыФормы.Вставить("ИдентификаторСтрокиОснования", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	ПараметрыФормы.Вставить("ТекущаяПозицияШР", ПредопределенноеЗначение("Справочник.ШтатноеРасписание.ПустаяСсылка"));
	ПараметрыФормы.Вставить("ФормироватьПараметрыПоСсылке", Ложь);
	
	//@skip-check constructor-function-return-section
	Возврат ПараметрыФормы;

КонецФункции

#КонецОбласти