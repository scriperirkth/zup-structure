
#Область СлужебныйПрограммныйИнтерфейс

// Получает список цветов, кэшируемый подсистемой
//
// Возвращаемое значение:
// Структура - Кэшируемые цвета:
//  * Пустой          - Цвет - Неинициализированный текст
//  * ПоясняющийТекст - Цвет - См. ЦветаСтиля.ПоясняющийТекст
Функция Цвета() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Пустой"          , Новый Цвет);
	Результат.Вставить("ПоясняющийТекст" , ЦветаСтиля.ПоясняющийТекст);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
