#Область СлужебныеПроцедурыИФункции

// РегламентированнаяОтчетность

// См.  РегламентированнаяОтчетностьКлиентСерверПереопределяемый.ДополнитьСтатусыОбъектовРеглОтчетностиПриРучномВводе
Процедура ДополнитьСтатусыОбъектовРеглОтчетностиПриРучномВводе(Статусы, ОбъектРеглОтчетности) Экспорт
	
	ОбменСВоенкоматами = ВоинскийУчетКлиентСервер.ДокументыЭлектронногоОбмена();
	Если ОбменСВоенкоматами.Найти(ТипЗнч(ОбъектРеглОтчетности)) = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Статусы.Добавить(НСтр("ru = 'В работе'"));
	Статусы.Добавить(НСтр("ru = 'Подготовлено'"));
	Статусы.Добавить(НСтр("ru = 'Сдано'"));
	
КонецПроцедуры

// Конец РегламентированнаяОтчетность

Функция ДокументыЭлектронногоОбмена() Экспорт 
	
	ОбменСВоенкоматами = Новый Массив;
	ОбменСВоенкоматами.Добавить(Тип("ДокументСсылка.ИзвещениеОПриемеИлиУвольненииДляВоенкомата"));
	ОбменСВоенкоматами.Добавить(Тип("ДокументСсылка.ИзмененияСведенийСотрудниковДляВоенкомата"));
	ОбменСВоенкоматами.Добавить(Тип("ДокументСсылка.ПервоначальнаяПостановкаНаВоинскийУчет"));
	ОбменСВоенкоматами.Добавить(Тип("ДокументСсылка.СведенияОПодлежащихВоинскомуУчетуГражданах"));
	ОбменСВоенкоматами.Добавить(Тип("ДокументСсылка.СообщениеОНеСостоящихНаВоинскомУчетеГражданах"));
	
	Возврат ОбменСВоенкоматами;
	
КонецФункции

#КонецОбласти 
