Функция ДанныеДляПроведенияРешениеОПриемеНаРаботу(Ссылка, ФизическоеЛицо, ДолжностьПоШтатномуРасписанию, ДатаПриема) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Сотрудник,
	|	Мероприятия.Мероприятие КАК Мероприятие,
	|	Мероприятия.ДатаНачала КАК ДатаНачала,
	|	Мероприятия.ДатаОкончания КАК ДатаОкончания,
	|	Мероприятия.Исполнитель КАК Исполнитель
	|ИЗ
	|	Документ.РешениеОПриемеНаРаботу.МероприятияАдаптацииУвольнения КАК Мероприятия
	|ГДЕ
	|	Мероприятия.Ссылка = &Ссылка";
		
	ДанныеМероприятий = Запрос.Выполнить().Выгрузить();
	ДанныеМероприятий.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ДанныеМероприятий.ЗаполнитьЗначения(ФизическоеЛицо, "ФизическоеЛицо");
	ДанныеМероприятий.Колонки.Добавить("ДокументОснование", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.СобытияАдаптацииУвольнения.Тип));
	ДанныеМероприятий.ЗаполнитьЗначения(Ссылка, "ДокументОснование");
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		ПлановыеДвиженияСотрудников = Новый ТаблицаЗначений;
	Иначе
		Запрос.УстановитьПараметр("Подразделение", ОрганизационнаяСтруктура.МестоПозицииВСтруктуреПредприятия(
			ДолжностьПоШтатномуРасписанию, ДатаПриема));
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	&Подразделение КАК Подразделение,
		|	РешениеОПриемеНаРаботуПрограммаОбучения.Мероприятие КАК Мероприятие,
		|	РешениеОПриемеНаРаботуПрограммаОбучения.ДатаНачала КАК ДатаНачала,
		|	РешениеОПриемеНаРаботуПрограммаОбучения.ДатаОкончания КАК ДатаОкончания,
		|	РешениеОПриемеНаРаботуПрограммаОбучения.Ответственный КАК Ответственный,
		|	РешениеОПриемеНаРаботуПрограммаОбучения.КоличествоУчебныхЧасов КАК КоличествоУчебныхЧасов,
		|	РешениеОПриемеНаРаботуПрограммаОбучения.СуммаРасходов КАК СуммаРасходов
		|ИЗ
		|	Документ.РешениеОПриемеНаРаботу.ПрограммаОбучения КАК РешениеОПриемеНаРаботуПрограммаОбучения
		|ГДЕ
		|	РешениеОПриемеНаРаботуПрограммаОбучения.Ссылка = &Ссылка";
		ПлановыеДвиженияСотрудников = Запрос.Выполнить().Выгрузить();
		ПлановыеДвиженияСотрудников.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
		ПлановыеДвиженияСотрудников.ЗаполнитьЗначения(ФизическоеЛицо, "ФизическоеЛицо");
	КонецЕсли;
	
	ДанныеДляПроведения = Новый Структура;
	ДанныеДляПроведения.Вставить("ДанныеМероприятийАдаптацииУвольнения", ДанныеМероприятий);
	ДанныеДляПроведения.Вставить("ПлановыеДвиженияСотрудников", ПлановыеДвиженияСотрудников);
	
	Возврат ДанныеДляПроведения;

КонецФункции

Процедура ЗаполнитьРешениеОПриемеНаРаботуПоДаннымКандидата(ДокументОбъект, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт

	Если ТипЗнч(ДанныеЗаполнения) <> Тип("СправочникСсылка.Кандидаты") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеКандидата = Справочники.Кандидаты.ДанныеКандидата(ДанныеЗаполнения);
	Если ДанныеКандидата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеКандидата.Состояние <> Перечисления.СостоянияСогласования.Согласовано Тогда
		ВызватьИсключение НСтр("ru = 'Кандидат не утвержден. 
                                |Решение о приеме на работу вводится для утвержденных (одобренных) кандидатов.'");
	КонецЕсли;
	
	ПараметрыДанных = Справочники.Вакансии.ПараметрыПолученияДанныхВакансии();
	ПараметрыДанных.Согласование = Истина;
	
	ДанныеВакансии = Справочники.Вакансии.ДанныеВакансии(ДанныеКандидата.Вакансия, ПараметрыДанных);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСогласованиеВакансий") Тогда
		Если Не ЗначениеЗаполнено(ДанныеКандидата.Вакансия) Тогда
			ВызватьИсключение НСтр("ru = 'Вакансия не заполнена. 
	                                |Решение о приеме на работу вводится для кандидата на согласованную вакансию.'");
		КонецЕсли;
		Если ДанныеВакансии.Согласование = Неопределено 
			Или ДанныеВакансии.Согласование.СостояниеСогласования <> Перечисления.СостоянияСогласования.Согласовано Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Вакансия %1 не согласована. 
	                  |Решение о приеме на работу вводится для кандидата на согласованную вакансию.'"),
				ДанныеКандидата.Вакансия);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.Кандидат = ДанныеКандидата.Кандидат;
	ДокументОбъект.ЛичныеДанныеКандидата = ДанныеКандидата.ЛичныеДанныеКандидата;
	ДокументОбъект.Подразделение = ДанныеВакансии.Подразделение;
	ДокументОбъект.Должность = ДанныеВакансии.Должность;
	ДокументОбъект.ПрофильДолжности = ДанныеВакансии.ПрофильДолжности;
	ДокументОбъект.НоваяПозиция = ДанныеВакансии.НоваяПозиция;
	ДокументОбъект.РабочееМесто = ДанныеВакансии.РабочееМесто;
	ДокументОбъект.ИспытательныйСрок = ДанныеВакансии.ИспытательныйСрок;
	ДокументОбъект.ФизическоеЛицо = ДанныеКандидата.ФизическоеЛицо;
	
	СуммаВВалютеПоУмолчанию = ПодборПерсоналаКлиентСервер.СуммаВВалютеПоУмолчанию(
		ДанныеКандидата.ОжидаемыйДоход, ДанныеКандидата.ВалютаДохода);
	ДокументОбъект.СогласованныйДоход = ПодборПерсоналаКлиентСервер.ОжидаемыйДоходВМесяц(
		СуммаВВалютеПоУмолчанию, ДанныеКандидата.ПериодичностьДохода);
	
	Если Не ДанныеВакансии.НоваяПозиция Тогда
		ДокументОбъект.ДолжностьПоШтатномуРасписанию = ДанныеВакансии.Позиция;
		ДанныеПозиции = Справочники.ШтатноеРасписание.ДанныеПозицииШтатногоРасписания(ДанныеВакансии.Позиция);
		ДокументОбъект.Организация = ДанныеПозиции.Организация;
	КонецЕсли;

КонецПроцедуры


#Область КадровыеДокументы

Процедура ОбработкаЗаполненияКадровогоПриказа(ДокументОбъект, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если Не Метаданные.ОпределяемыеТипы.КадровоеРешение.Тип.СодержитТип(ТипДанныхЗаполнения) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОКадровомПереводе") Тогда
		КопируемыеРеквизиты = Новый Массив;
		КопируемыеРеквизиты.Добавить("ДатаНачала");
		КопируемыеРеквизиты.Добавить("ДатаОкончания");
		КопируемыеРеквизиты.Добавить("Подразделение");
		КопируемыеРеквизиты.Добавить("Территория");
		КопируемыеРеквизиты.Добавить("ДолжностьПоШтатномуРасписанию");
		КопируемыеРеквизиты.Добавить("ОбособленноеПодразделение");
		КопируемыеРеквизиты.Добавить("Организация");
		КопируемыеРеквизиты.Добавить("Сотрудник"); 
		КопируемыеРеквизиты.Добавить("ФизическоеЛицо");
		КопируемыеРеквизиты.Добавить("РабочееМесто");
		КопируемыеРеквизиты.Добавить("РаботаетДистанционно");
		КопируемыеРеквизиты.Добавить("ИзменитьПодразделениеИДолжность");
		КопируемыеРеквизиты.Добавить("ИзменитьТерриторию");
		КопируемыеРеквизиты.Добавить("ИзменитьРабочееМесто");
		КопируемыеРеквизиты.Добавить("ИзменитьДистанционнуюРаботу");
		ЗаполнитьЗначенияСвойств(ДокументОбъект, 
			ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, КопируемыеРеквизиты));
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОбУвольнении") Тогда
		КопируемыеРеквизиты = Новый Массив;
		КопируемыеРеквизиты.Добавить("ДатаУвольнения");
		КопируемыеРеквизиты.Добавить("Организация");
		КопируемыеРеквизиты.Добавить("Сотрудник");
		КопируемыеРеквизиты.Добавить("ФизическоеЛицо");
		ЗаполнитьЗначенияСвойств(ДокументОбъект, 
			ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, КопируемыеРеквизиты));
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОбОтпускеПоУходуЗаРебенком") Тогда
		КопируемыеРеквизиты = Новый Массив;
		КопируемыеРеквизиты.Добавить("ДатаНачала");
		КопируемыеРеквизиты.Добавить("Организация");
		КопируемыеРеквизиты.Добавить("ОсновнойСотрудник");
		КопируемыеРеквизиты.Добавить("ФизическоеЛицо");
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, КопируемыеРеквизиты);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		ДокументОбъект.Сотрудник = ЗначенияРеквизитов.ФизическоеЛицо;
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОВосстановленииВДолжности") Тогда
		КопируемыеРеквизиты = Новый Массив;
		КопируемыеРеквизиты.Добавить("ДатаВосстановления"); 
		КопируемыеРеквизиты.Добавить("Организация"); 
		КопируемыеРеквизиты.Добавить("Сотрудник"); 
		КопируемыеРеквизиты.Добавить("ФизическоеЛицо"); 
		КопируемыеРеквизиты.Добавить("ДолжностьПоШтатномуРасписанию");
		КопируемыеРеквизиты.Добавить("ДокументОснование");
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, КопируемыеРеквизиты);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		
		РеквизитыПозиции = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.ДолжностьПоШтатномуРасписанию, "Подразделение, Должность");
		ЗаполнитьЗначенияСвойств(ДокументОбъект, РеквизитыПозиции);
		
		ПриказСвязанныйСОснованием = КадровыеРешения.СвязанныйСРешениемПриказ(ЗначенияРеквизитов.ДокументОснование); // ДокументСсылка.Увольнение
		Если ЗначениеЗаполнено(ПриказСвязанныйСОснованием) Тогда
			ДокументОбъект.ДокументУвольнения = ПриказСвязанныйСОснованием;
			ДокументОбъект.ДатаУвольнения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПриказСвязанныйСОснованием, "ДатаУвольнения");
		КонецЕсли;
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОВозвратеИзОтпускаПоУходуЗаРебенком") Тогда
		КопируемыеРеквизиты = Новый Массив;
		КопируемыеРеквизиты.Добавить("ДатаВозврата");
		КопируемыеРеквизиты.Добавить("Организация"); 
		КопируемыеРеквизиты.Добавить("ОсновнойСотрудник");
		КопируемыеРеквизиты.Добавить("ФизическоеЛицо");
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, КопируемыеРеквизиты);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		ДокументОбъект.Сотрудник = ЗначенияРеквизитов.ФизическоеЛицо;
		ПриказСвязанныйСОснованием = КадровыеРешения.СвязанныйСРешениемПриказ(ДанныеЗаполнения.ДокументОснование);
		Если ЗначениеЗаполнено(ПриказСвязанныйСОснованием) Тогда
			ДокументОбъект.ДокументОснование = ПриказСвязанныйСОснованием;
		КонецЕсли;
	КонецЕсли;

	ДокументОбъект.Решение = ДанныеЗаполнения;
	
КонецПроцедуры

Функция ПравоЧтенияРешения(КадровыйДокумент) Экспорт
	
	ТипДокумента = ТипЗнч(КадровыйДокумент);
	Если ЭтоПриемНаРаботу(ТипДокумента)
		И ПравоДоступа("Чтение", Метаданные.Документы.РешениеОПриемеНаРаботу) Тогда
		ПравоЧтенияРешения = Истина;
	ИначеЕсли ЭтоКадровыйПеревод(ТипДокумента)
		И ПравоДоступа("Чтение", Метаданные.Документы.РешениеОКадровомПереводе) Тогда
		ПравоЧтенияРешения = Истина;
	ИначеЕсли ЭтоУвольнение(ТипДокумента)
		И ПравоДоступа("Чтение", Метаданные.Документы.РешениеОбУвольнении) Тогда
		ПравоЧтенияРешения = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтпускПоУходуЗаРебенком")
		И ПравоДоступа("Чтение", Метаданные.Документы.РешениеОбОтпускеПоУходуЗаРебенком) Тогда
		ПравоЧтенияРешения = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВозвратИзОтпускаПоУходуЗаРебенком")
		И ПравоДоступа("Чтение", Метаданные.Документы.РешениеОВозвратеИзОтпускаПоУходуЗаРебенком) Тогда
		ПравоЧтенияРешения = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВосстановлениеВДолжности")
		И ПравоДоступа("Чтение", Метаданные.Документы.РешениеОВосстановленииВДолжности) Тогда
		ПравоЧтенияРешения = Истина;
	Иначе
		ПравоЧтенияРешения = Ложь;
	КонецЕсли;
	
	Возврат ПравоЧтенияРешения;
	
КонецФункции

Функция ИспользуетсяРешение(КадровыйДокумент) Экспорт
	
	Настройки = НастройкиКадровыхРешений();
	ТипДокумента = ТипЗнч(КадровыйДокумент);
	
	Если ЭтоПриемНаРаботу(ТипДокумента)
		И Настройки.ИспользоватьРешениеОПриемеНаРаботу Тогда
		ИспользуетсяРешение = Истина;
	ИначеЕсли ЭтоКадровыйПеревод(ТипДокумента)
		И Настройки.ИспользоватьРешениеОКадровомПереводе Тогда
		ИспользуетсяРешение = Истина;
	ИначеЕсли ЭтоУвольнение(ТипДокумента)
		И Настройки.ИспользоватьРешениеОбУвольнении Тогда
		ИспользуетсяРешение = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтпускПоУходуЗаРебенком")
		И Настройки.ИспользоватьРешениеОбОтпускеПоУходуЗаРебенком Тогда
		ИспользуетсяРешение = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВозвратИзОтпускаПоУходуЗаРебенком")
		И Настройки.ИспользоватьРешениеОВозвратеИзОтпускаПоУходуЗаРебенком Тогда
		ИспользуетсяРешение = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВосстановлениеВДолжности")
		И Настройки.ИспользоватьРешениеОВосстановленииВДолжности Тогда
		ИспользуетсяРешение = Истина;
	Иначе
		ИспользуетсяРешение = Ложь;
	КонецЕсли;
	
	Возврат ИспользуетсяРешение;
	
КонецФункции

