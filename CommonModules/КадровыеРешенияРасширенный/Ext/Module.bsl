// Заполнить кадровые документы по решениям.
// 
// Параметры:
//  ПараметрыОбновления - Структура - Параметры обновления:
//	* ОбработкаЗавершена - Булево
Процедура ЗаполнитьКадровыеДокументыПоРешениям(ПараметрыОбновления) Экспорт
	
	Запрос = ЗапросЗаполненияКадровыхДокументовПоРешениям();
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ПараметрыОбновления.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыОбновления.ОбработкаЗавершена = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.КадровыеДокументыПоРешениям.СоздатьНаборЗаписей();
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
		НаборЗаписей.Отбор.Решение.Установить(Выборка.Решение);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗапросЗаполненияКадровыхДокументовПоРешениям()
		
	ПустыеРешения = Новый Массив;
	Для Каждого ТипРешения Из Метаданные.ОпределяемыеТипы.КадровоеРешение.Тип.Типы() Цикл
		ПустыеРешения.Добавить(Новый(ТипРешения));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустыеРешения", ПустыеРешения);
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.ПриемНаРаботу КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.ПриемНаРаботуСписком.Сотрудники КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ КадровыеДокументы.Ссылка.ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.КадровыйПеревод КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.КадровыйПереводСписком.Сотрудники КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ КадровыеДокументы.Ссылка.ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.Увольнение КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.УвольнениеСписком.Сотрудники КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ КадровыеДокументы.Ссылка.ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.ОтпускПоУходуЗаРебенком КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.ВозвратИзОтпускаПоУходуЗаРебенком КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КадровыеДокументы.Ссылка КАК КадровыйДокумент,
		|	КадровыеДокументы.Решение
		|ИЗ
		|	Документ.ВосстановлениеВДолжности КАК КадровыеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадровыеДокументыПоРешениям КАК РешенияПоКадровымДокументам
		|		ПО РешенияПоКадровымДокументам.КадровыйДокумент = КадровыеДокументы.Ссылка
		|ГДЕ
		|	НЕ ПометкаУдаления
		|	И КадровыеДокументы.Решение НЕ В (&ПустыеРешения)
		|	И РешенияПоКадровымДокументам.Решение ЕСТЬ NULL";
	
	Возврат Запрос;
	
КонецФункции

// Процедура выполняет заполнение данных оплаты труда решений о кадровом переводе
//
Процедура ЗаполнениеОплатыТрудаВРешенияхОКадровомПереводе(ПараметрыОбновления = Неопределено) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	РешениеОКадровомПереводе.Ссылка КАК Решение
		|ИЗ
		|	Документ.РешениеОКадровомПереводе КАК РешениеОКадровомПереводе
		|ГДЕ
		|	РешениеОКадровомПереводе.ВариантОплатыТруда = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыТруда.ПустаяСсылка)";
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Документ.РешениеОКадровомПереводе");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Решение = Выборка.Решение.ПолучитьОбъект();
			Решение.ИзменитьПодразделениеИДолжность = Истина;
			Если ЗначениеЗаполнено(Решение.ДолжностьПоШтатномуРасписанию) Тогда
				Решение.ВариантОплатыТруда = Перечисления.ВариантыОплатыТруда.ФОТ;
			Иначе
				Решение.ВариантОплатыТруда = Перечисления.ВариантыОплатыТруда.СогласованныйДоход;
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Решение);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если ПараметрыОбновления <> Неопределено Тогда
		ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	КонецЕсли;
	
КонецПроцедуры

// Процедура выполняет распределение присоединенных файлов решений по кадровым изменениям
//
Процедура РаспределениеПрисоединенныхФайловРешенийПоКадровымИзменениям(ПараметрыОбновления = Неопределено) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ПрисоединенныеФайлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РешенияПоКадровымИзменениямПрисоединенныеФайлы КАК ПрисоединенныеФайлы
		|ГДЕ
		|	НЕ ПрисоединенныеФайлы.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить(
		Метаданные.Справочники.РешенияПоКадровымИзменениямПрисоединенныеФайлы.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	НачатьТранзакцию();
	Попытка
		БлокировкаДанных.Заблокировать();
		ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ПрисоединенныйФайлНовый = ПрисоединенныйФайлПоТипуЗначения(ТипЗнч(Выборка.Ссылка.ВладелецФайла));
			Если ПрисоединенныйФайлНовый = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ПрисоединенныйФайлНовый, Выборка.Ссылка,, "Владелец, Ссылка, Родитель");
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПрисоединенныйФайлНовый);
			ПрисоединенныйФайлСтарый = Выборка.Ссылка.ПолучитьОбъект();
			ПрисоединенныйФайлСтарый.ПометкаУдаления = Истина;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПрисоединенныйФайлСтарый);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если ПараметрыОбновления <> Неопределено Тогда
		ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьФОКадровыхРешений(ПараметрыОбновления) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ИспользоватьАдаптациюУвольнение
		|ИЗ
		|	Константа.ИспользоватьАдаптациюУвольнение КАК НастройкаАдаптации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиКадровыхРешений КАК Настройки
		|		ПО (ИСТИНА)
		|ГДЕ
		|	НастройкаАдаптации.Значение = ИСТИНА
		|	И ЕСТЬNULL(Настройки.ИспользоватьРешениеОбОтпускеПоУходуЗаРебенком, ЛОЖЬ) = ЛОЖЬ
		|	И ЕСТЬNULL(Настройки.ИспользоватьРешениеОбУвольнении, ЛОЖЬ) = ЛОЖЬ
		|	И ЕСТЬNULL(Настройки.ИспользоватьРешениеОВозвратеИзОтпускаПоУходуЗаРебенком, ЛОЖЬ) = ЛОЖЬ
		|	И ЕСТЬNULL(Настройки.ИспользоватьРешениеОВосстановленииВДолжности, ЛОЖЬ) = ЛОЖЬ
		|	И ЕСТЬNULL(Настройки.ИспользоватьРешениеОКадровомПереводе, ЛОЖЬ) = ЛОЖЬ
		|	И ЕСТЬNULL(Настройки.ИспользоватьРешениеОПриемеНаРаботу, ЛОЖЬ) = ЛОЖЬ";
	
	ОписаниеДанных = Новый Массив;
	ОписаниеДанных.Добавить(ОписаниеБлокируемыхДанных(Метаданные.РегистрыСведений.НастройкиКадровыхРешений));
	ОписаниеДанных.Добавить(ОписаниеБлокируемыхДанных(Метаданные.Константы.ИспользоватьАдаптациюУвольнение));

	Если Не ОбновлениеИБ.НачатьОбновлениеДанных(ОписаниеДанных, ПараметрыОбновления) Тогда
		Возврат;
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		ПараметрыОбновления.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыОбновления.ОбработкаЗавершена = Ложь;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.НастройкиКадровыхРешений.СоздатьНаборЗаписей();
		СтрокаНабора = НаборЗаписей.Добавить();
		СтрокаНабора.ИспользоватьРешениеОбОтпускеПоУходуЗаРебенком = Выборка.ИспользоватьАдаптациюУвольнение;
		СтрокаНабора.ИспользоватьРешениеОбУвольнении = Выборка.ИспользоватьАдаптациюУвольнение;
		СтрокаНабора.ИспользоватьРешениеОВозвратеИзОтпускаПоУходуЗаРебенком = Выборка.ИспользоватьАдаптациюУвольнение;
		СтрокаНабора.ИспользоватьРешениеОВосстановленииВДолжности = Выборка.ИспользоватьАдаптациюУвольнение;
		СтрокаНабора.ИспользоватьРешениеОКадровомПереводе = Выборка.ИспользоватьАдаптациюУвольнение;
		СтрокаНабора.ИспользоватьРешениеОПриемеНаРаботу = Выборка.ИспользоватьАдаптациюУвольнение;
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;
	
	ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	
КонецПроцедуры

// Заполняет кандидатов в решениях о приеме на работу при обновлении.
// 
// Параметры:
//  ПараметрыОбновления - Структура
//  
// Возвращаемое значение:
//  Булево - Истина если все документы уже обработаны, иначе Ложь.
Функция ЗаполнитьКандидатов(ПараметрыОбновления) Экспорт
	
	ОбработанныеДокументы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ПараметрыОбновления, "ОбработанныеДокументы", Новый Массив); // Массив Из ДокументСсылка.РешениеОПриемеНаРаботу
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Документы.РешениеОПриемеНаРаботу.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		
		ОбрабатываемыеДокументы = ДокументыБезКандидатов(ОбработанныеДокументы);
		
		Если ОбрабатываемыеДокументы.Количество() = 0 Тогда
			ЗафиксироватьТранзакцию();
			Возврат Истина;
		КонецЕсли;
		
		ФизическиеЛица = ОбщегоНазначенияКлиентСервер.СвернутьМассив(
			ОбрабатываемыеДокументы.ВыгрузитьКолонку("ФизическоеЛицо"));
		
		Кандидаты = ПодборПерсонала.КандидатыФизическихЛиц(ФизическиеЛица);
		
		УстановитьПривилегированныйРежим(Истина);
		ТаблицаСотрудников = КадровыйУчет.СотрудникиФизическихЛиц(ФизическиеЛица);
		УстановитьПривилегированныйРежим(Ложь);
		ОбщегоНазначенияБЗК.ДобавитьИндексКоллекции(ТаблицаСотрудников, "ФизическоеЛицо");
	
		ИсключаемыеКандидаты = КандидатыРешенийОПриеме();
		
		КоличествоОбработанныхДокументов = 0;
		Для Каждого СтрокаТаблицы Из ОбрабатываемыеДокументы Цикл
			
			Кандидат = КандидатФизическогоЛица(СтрокаТаблицы.ФизическоеЛицо, Кандидаты, ИсключаемыеКандидаты,
				ТаблицаСотрудников);

			Если ЗначениеЗаполнено(Кандидат) Тогда
				ЗаполнитьКандидатаВДокументе(СтрокаТаблицы.Документ, Кандидат);
				НоваяСтрока = ИсключаемыеКандидаты.Добавить();
				НоваяСтрока.Кандидат = Кандидат;
			КонецЕсли;
			
			КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов + 1;
			ОбработанныеДокументы.Добавить(СтрокаТаблицы.Документ);
			
		КонецЦикла;

		ПараметрыОбновления.Вставить("ОбработанныеДокументы", ОбработанныеДокументы);
		ЗафиксироватьТранзакцию();
		
		Возврат КоличествоОбработанныхДокументов = 0;
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Обновление информационной базы.Ошибка заполнения кандидатов в документах Решение о приеме на работу'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.РешениеОПриемеНаРаботу);
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

// Исправляет ситуацию, когда существуют несколько решений о приеме на работу с одинаковым кандидатом.
// В результате остается один документ по кандидату.
// В остальных документах кандидат, при возможности, заменяется на другого или очищается.
// 
// Параметры:
//  ПараметрыОбновления - Структура
Процедура ИсправитьРешенияОПриемеСОдинаковымиКандидатами(ПараметрыОбновления) Экспорт
	
	ПараметрыОбновления.ОбработкаЗавершена = Ложь;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Документы.РешениеОПриемеНаРаботу.ПолноеИмя());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		
		РезультатЗапроса = РезультатЗапросаКандидатовСНесколькимиРешениями();
		
		Если РезультатЗапроса = Неопределено Или РезультатЗапроса.Пустой() Тогда
			ЗафиксироватьТранзакцию();
			ПараметрыОбновления.ОбработкаЗавершена = Истина;
			Возврат;
		КонецЕсли;
		
		ДокументыРешения = Новый Массив; // Массив из ДокументСсылка.РешениеОПриемеНаРаботу
		
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.Прямой);
		Пока Выборка.СледующийПоЗначениюПоля("Документ") Цикл
			ДокументыРешения.Добавить(Выборка.Документ);
		КонецЦикла;
		СотрудникиРешений = РегистрыСведений.СотрудникиПоРешениямОПриемеНаРаботу.СотрудникиПоРешениямОПриемеНаРаботу(
			ДокументыРешения);
		
		ВыборкаКандидатов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		КоличествоОбработанныхДокументов = 0;
		
		Пока ВыборкаКандидатов.Следующий() Цикл
			
			ИсключаемыеКандидаты = Новый ТаблицаЗначений();
			ИсключаемыеКандидаты.Колонки.Добавить("Кандидат", Новый ОписаниеТипов("СправочникСсылка.Кандидаты"));
			
			ФизическоеЛицо =  Неопределено;
			
			ВыборкаДокументы = ВыборкаКандидатов.Выбрать();
			Пока ВыборкаДокументы.Следующий() Цикл
				
				Кандидат = Справочники.Кандидаты.ПустаяСсылка();
				
				СотрудникРешения = СотрудникиРешений.Получить(ВыборкаДокументы.Документ);
				
				Если СотрудникРешения <> Неопределено Тогда
					
					КандидатыСотрудника = ПодборПерсонала.ПриоритетныеКандидатыПоСотрудникам(
						ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СотрудникРешения), ,
						ИсключаемыеКандидаты.ВыгрузитьКолонку("Кандидат"));
						
					Если КандидатыСотрудника.Количество() > 0 Тогда
						Кандидат = КандидатыСотрудника[0].Кандидат;
					КонецЕсли;
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Кандидат) Тогда
					Если ВыборкаДокументы.ФизическоеЛицо <> ФизическоеЛицо Тогда
						ФизическоеЛицо =  ВыборкаДокументы.ФизическоеЛицо;
						ФизическиеЛица = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическоеЛицо);
						Кандидаты = ПодборПерсонала.КандидатыФизическихЛиц(ФизическиеЛица);
						ТаблицаСотрудников = КадровыйУчет.СотрудникиФизическихЛиц(ФизическиеЛица);
					КонецЕсли;
					Кандидат = КандидатФизическогоЛица(ФизическоеЛицо, Кандидаты, ИсключаемыеКандидаты, ТаблицаСотрудников);
				КонецЕсли;
				
				Если ВыборкаКандидатов.Кандидат <> Кандидат Тогда
					ЗаполнитьКандидатаВДокументе(ВыборкаДокументы.Документ, Кандидат);
					КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов + 1;
				КонецЕсли;
				
				НоваяСтрока = ИсключаемыеКандидаты.Добавить();
				НоваяСтрока.Кандидат = Кандидат;
				
			КонецЦикла;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		ПараметрыОбновления.ОбработкаЗавершена = КоличествоОбработанныхДокументов = 0;
		
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Обновление информационной базы.Ошибка при исправлении решений о приеме на работу с одинаковыми кандидатами'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.РешениеОПриемеНаРаботу);
		ВызватьИсключение;
	КонецПопытки;
		
КонецПроцедуры

Функция РезультатЗапросаКандидатовСНесколькимиРешениями()
	
	Если Метаданные.Документы.РешениеОПриемеНаРаботу.Реквизиты.Найти("ФизическоеЛицо") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РешениеОПриемеНаРаботу.Ссылка) КАК Ссылка,
		|	РешениеОПриемеНаРаботу.Кандидат
		|ПОМЕСТИТЬ ВТКандидаты
		|ИЗ
		|	Документ.РешениеОПриемеНаРаботу КАК РешениеОПриемеНаРаботу
		|ГДЕ
		|	РешениеОПриемеНаРаботу.Проведен
		|	И РешениеОПриемеНаРаботу.Кандидат <> ЗНАЧЕНИЕ(Справочник.Кандидаты.ПустаяСсылка)
		|СГРУППИРОВАТЬ ПО
		|	РешениеОПриемеНаРаботу.Кандидат
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РешениеОПриемеНаРаботу.Ссылка) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РешениеОПриемеНаРаботу.Ссылка КАК Документ,
		|	РешениеОПриемеНаРаботу.Кандидат КАК Кандидат,
		|	РешениеОПриемеНаРаботу.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	Документ.РешениеОПриемеНаРаботу КАК РешениеОПриемеНаРаботу
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКандидаты КАК ВТКандидаты
		|		ПО РешениеОПриемеНаРаботу.Кандидат = ВТКандидаты.Кандидат
		|ИТОГИ
		|ПО
		|	Кандидат";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

// Параметры:
//  ОбработанныеДокументы - Массив из ДокументСсылка.РешениеОПриемеНаРаботу
//  
// Возвращаемое значение:
//  ТаблицаЗначений:
//    * Документ - ДокументСсылка.РешениеОПриемеНаРаботу
//    * ФизическоеЛицо - СправочникСсылка.ФизическиеЛица
Функция ДокументыБезКандидатов(ОбработанныеДокументы)
	
	Если Метаданные.Документы.РешениеОПриемеНаРаботу.Реквизиты.Найти("ФизическоеЛицо") = Неопределено Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	РешениеОПриемеНаРаботу.Ссылка КАК Документ,
		|	РешениеОПриемеНаРаботу.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	Документ.РешениеОПриемеНаРаботу КАК РешениеОПриемеНаРаботу
		|ГДЕ
		|	РешениеОПриемеНаРаботу.ФизическоеЛицо <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		|	И РешениеОПриемеНаРаботу.Кандидат = ЗНАЧЕНИЕ(Справочник.Кандидаты.ПустаяСсылка)
		|	И НЕ РешениеОПриемеНаРаботу.Ссылка В (&ОбработанныеДокументы)";
	
	Запрос.УстановитьПараметр("ОбработанныеДокументы", ОбработанныеДокументы);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;

КонецФункции

Функция КандидатыРешенийОПриеме()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РешениеОПриемеНаРаботу.Кандидат
		|ИЗ
		|	Документ.РешениеОПриемеНаРаботу КАК РешениеОПриемеНаРаботу
		|ГДЕ
		|	РешениеОПриемеНаРаботу.Проведен";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Кандидаты = РезультатЗапроса.Выгрузить();
	Кандидаты.Индексы.Добавить("Кандидат");
	
	Возврат Кандидаты;
	
КонецФункции

Функция КандидатФизическогоЛица(ФизическоеЛицо, Кандидаты, ИсключаемыеКандидаты, ТаблицаСотрудников)
	
	Кандидат = Справочники.Кандидаты.ПустаяСсылка();
	
	НайденныеСтроки = Кандидаты.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат Кандидат;
	КонецЕсли;
	
	ДоступныеКандидаты = Новый Массив;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Если НайденнаяСтрока.ПометкаУдаления
			Или НайденнаяСтрока.Состояние = Перечисления.СостоянияСогласования.Отклонено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИсключаемыеКандидаты.Найти(НайденнаяСтрока.Кандидат, "Кандидат") = Неопределено Тогда
			ДоступныеКандидаты.Добавить(НайденнаяСтрока.Кандидат);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДоступныеКандидаты.Количество() = 0 Тогда
		Возврат Кандидат;
	ИначеЕсли ДоступныеКандидаты.Количество() = 1 Тогда
		Кандидат = ДоступныеКандидаты[0];
	Иначе
		НайденныеСотрудники = ТаблицаСотрудников.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
		Если НайденныеСотрудники.Количество() = 0 Тогда
			Кандидат = ДоступныеКандидаты[0];
		Иначе
			Сотрудники = Новый Массив;
			Для Каждого СтрокаТаблицыСотрудников Из НайденныеСотрудники Цикл
				Сотрудники.Добавить(СтрокаТаблицыСотрудников.Сотрудник);
			КонецЦикла;
			КандидатыСотрудников = ПодборПерсонала.ПриоритетныеКандидатыПоСотрудникам(Сотрудники, ,
				ИсключаемыеКандидаты.ВыгрузитьКолонку("Кандидат"));
			Если КандидатыСотрудников.Количество() > 0 Тогда
				Кандидат = КандидатыСотрудников[0].Кандидат;
			Иначе
				Кандидат = ДоступныеКандидаты[0].Кандидат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Кандидат;
	
КонецФункции

Процедура ЗаполнитьКандидатаВДокументе(РешениеОПриеме, Кандидат)
	
	ДокументОбъект = РешениеОПриеме.ПолучитьОбъект();
	ДокументОбъект.Кандидат = Кандидат;
	ДокументОбъект.ЛичныеДанныеКандидата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кандидат, "ЛичныеДанные");
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
	
КонецПроцедуры

// Процедура выполняет заполнение данных оплаты труда решений о приеме на работу
//
Процедура ЗаполнениеОплатыТрудаВРешенияхОПриемеНаРаботу(ПараметрыОбновления = Неопределено) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	РешениеОПриемеНаРаботу.Ссылка КАК Решение
		|ИЗ
		|	Документ.РешениеОПриемеНаРаботу КАК РешениеОПриемеНаРаботу
		|ГДЕ
		|	РешениеОПриемеНаРаботу.ВариантОплатыТруда = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыТруда.ПустаяСсылка)";
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Документ.РешениеОПриемеНаРаботу");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Решение = Выборка.Решение.ПолучитьОбъект();
			Если ЗначениеЗаполнено(Решение.ДолжностьПоШтатномуРасписанию) Тогда
				Решение.ВариантОплатыТруда = Перечисления.ВариантыОплатыТруда.ФОТ;
			Иначе
				Решение.ВариантОплатыТруда = Перечисления.ВариантыОплатыТруда.СогласованныйДоход;
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Решение);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если ПараметрыОбновления <> Неопределено Тогда
		ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	КонецЕсли;
	
КонецПроцедуры

// Связать сотрудников с решениями о приеме на работу.
// 
// Параметры:
//  ПараметрыОбновления - Структура:
//	* ОбработкаЗавершена - Булево
Процедура СвязатьСотрудниковСРешениямиОПриемеНаРаботу(ПараметрыОбновления) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;

	РешенияБезФизическогоЛица = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ПараметрыОбновления, "РешенияБезФизическогоЛица", Новый Массив); // Массив Из ДокументСсылка.РешениеОПриемеНаРаботу
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("РешенияБезФизическогоЛица", РешенияБезФизическогоЛица); 
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	Решения.Ссылка КАК Ссылка,
		|	Решения.Кандидат КАК Кандидат,
		|	Решения.Организация КАК Организация
		|ИЗ
		|	Документ.РешениеОПриемеНаРаботу КАК Решения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиПоРешениямОПриемеНаРаботу КАК СотрудникиПоРешениям
		|		ПО (СотрудникиПоРешениям.Решение = Решения.Ссылка)
		|ГДЕ
		|	Решения.Проведен
		|	И СотрудникиПоРешениям.Сотрудник ЕСТЬ NULL
		|	И НЕ Решения.Ссылка В (&РешенияБезФизическогоЛица)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Решения.Дата УБЫВ";
	
	ОписаниеДанных = Новый Массив;
	ОписаниеДанных.Добавить(ОписаниеБлокируемыхДанных(Метаданные.Документы.РешениеОПриемеНаРаботу));
	ОписаниеДанных.Добавить(ОписаниеБлокируемыхДанных(Метаданные.Справочники.Сотрудники));
	ОписаниеДанных.Добавить(ОписаниеБлокируемыхДанных(Метаданные.РегистрыСведений.СотрудникиПоРешениямОПриемеНаРаботу));

	Если Не ОбновлениеИБ.НачатьОбновлениеДанных(ОписаниеДанных, ПараметрыОбновления) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		ПараметрыОбновления.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыОбновления.ОбработкаЗавершена = Ложь;

	Кандидаты = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Кандидат"); // Массив Из СправочникСсылка.Кандидаты
	
	СотрудникиПоКандидатам = ПодборПерсонала.СотрудникиПоКандидатам(Кандидаты);
	ФизическиеЛицаПоКандидатам = Справочники.Кандидаты.ФизическиеЛицаКандидатов(Кандидаты);
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Сотрудник = СотрудникиПоКандидатам.Получить(Выборка.Кандидат);
		Если Сотрудник = Неопределено Тогда
			Если ФизическиеЛицаПоКандидатам[Выборка.Кандидат] = Неопределено Тогда
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Обновление информационной базы.Связать сотрудников с решениями о приеме на работу'", 
						ОбщегоНазначения.КодОсновногоЯзыка()),
					УровеньЖурналаРегистрации.Предупреждение, , , 
					СтрШаблон(
						НСтр("ru = 'Для кандидата %1 проведено решение о приеме на работу %2, но при этом не удалось обнаружить физическое лицо.
							 |Для этого решения сотрудник не был создан.
							 |Необходимо создать физическое лицо для кандидата %1, затем перепровести документ.'"),
						Выборка.Кандидат,
						Выборка.Ссылка));
				РешенияБезФизическогоЛица.Добавить(Выборка.Ссылка);
				Продолжить;
			КонецЕсли;
			Сотрудник = КадровыйУчет.НовыйСотрудникФизическогоЛица(
				ФизическиеЛицаПоКандидатам[Выборка.Кандидат], Выборка.Организация);
		КонецЕсли;
		НаборЗаписей = РегистрыСведений.СотрудникиПоРешениямОПриемеНаРаботу.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Решение.Установить(Выборка.Ссылка);
		СтрокаНабора = НаборЗаписей.Добавить();
		СтрокаНабора.Решение = Выборка.Ссылка;
		СтрокаНабора.Сотрудник = Сотрудник;
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;
	
	ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);

	ПараметрыОбновления.Вставить("РешенияБезФизическогоЛица", РешенияБезФизическогоЛица);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

