#Область ПрограммныйИнтерфейс

Функция ПредставлениеИсполнителяЭтапа(Исполнитель, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации,
	ИмяРеквизитаОсновногоОбъектаАдресации = "", ИмяРеквизитаДополнительногоОбъектаАдресации = "") Экспорт
	
	Результат = Строка(Исполнитель);
	
	Если НЕ ПустаяСтрока(ИмяРеквизитаОсновногоОбъектаАдресации) Тогда
		Если Лев(ИмяРеквизитаОсновногоОбъектаАдресации, 1) = "*" Тогда
			Результат = Результат + ", доп. реквизит """ + Сред(ИмяРеквизитаОсновногоОбъектаАдресации, 2) + """";
		ИначеЕсли Строка(Исполнитель) = "(функция)" Тогда
			Результат = Результат + " """ + ИмяРеквизитаОсновногоОбъектаАдресации + """";
		Иначе
			Результат = Результат + ", реквизит """ + ИмяРеквизитаОсновногоОбъектаАдресации + """";
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ОсновнойОбъектАдресации) Тогда
		Результат = Результат + ", " + Строка(ОсновнойОбъектАдресации);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ИмяРеквизитаДополнительногоОбъектаАдресации) Тогда
		Если Лев(ИмяРеквизитаДополнительногоОбъектаАдресации, 1) = "*" Тогда
			Результат = Результат + ", доп. реквизит """ + Сред(ИмяРеквизитаДополнительногоОбъектаАдресации, 2) + """";
		Иначе
			Результат = Результат + ", реквизит """ + ИмяРеквизитаДополнительногоОбъектаАдресации + """";
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ДополнительныйОбъектАдресации) Тогда
		Результат = Результат + ", " + Строка(ДополнительныйОбъектАдресации);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеСрокаВыполненияИнтервала(Параметры, ИспользуютсяГрафикиРаботы) Экспорт
	
	Представление = "";
	
	Если Параметры.СрокЗависитОтВремениНачала Тогда
		Представление = Представление + НСтр("ru='если этап начался до '") + Формат(Параметры.ВремяНачала, "ДФ=ЧЧ:мм; ДП=00:00") + НСтр("ru=', то '");
	КонецЕсли;
	
	ЗаполнитьПредставлениеСрокаВыполненияПоПоказателям(Представление, Параметры.СрокВыполненияЧасы, Параметры.СрокВыполненияДни,
		Параметры.СпособУказанияВремениОкончания, Параметры.ВремяОкончания, ИспользуютсяГрафикиРаботы);
	
	Если Параметры.СрокЗависитОтВремениНачала Тогда
		Представление = Представление + НСтр("ru='; если позже, то '");
		ЗаполнитьПредставлениеСрокаВыполненияПоПоказателям(Представление, Параметры.СрокВыполненияЧасыПосле, Параметры.СрокВыполненияДниПосле,
			Параметры.СпособУказанияВремениОкончанияПосле, Параметры.ВремяОкончанияПосле, ИспользуютсяГрафикиРаботы);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Процедура ПоказатьКнопкиПечатиРегламентированногоОтчета(Форма) Экспорт
	
	ПроцессыОбработкиДокументовКлиентСерверПереопределяемый.ПоказатьКнопкиПечатиРегламентированногоОтчета(Форма);
	
КонецПроцедуры

Функция ПредставлениеФормуляраПоСвойствам(Свойства, ЭтоНовый = Ложь) Экспорт

	Если ЗначениеЗаполнено(Свойства.НомерДокумента) И ЗначениеЗаполнено(Свойства.ДатаДокумента) Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 № %2 от %3'"), Свойства.НаименованиеДокумента,
			Свойства.НомерДокумента, Формат(Свойства.ДатаДокумента, "ДЛФ=D;"));
	ИначеЕсли ЗначениеЗаполнено(Свойства.НомерДокумента) Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 № %2'"), Свойства.НаименованиеДокумента,
			Свойства.НомерДокумента);
	ИначеЕсли ЗначениеЗаполнено(Свойства.ДатаДокумента) Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 от %2'"), Свойства.НаименованиеДокумента,
			Формат(Свойства.ДатаДокумента, "ДЛФ=D;"));
	Иначе
		Представление = Строка(Свойства.НаименованиеДокумента);
	КонецЕсли;
	
	Если ЭтоНовый Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 (Создание)'"), Представление);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Функция ДополнениеНаименованияФормуляра(КодВидаСведений) Экспорт
	Результат = "";	
	Если КодВидаСведений = 1 Тогда
		Результат = " (MXL)";	
	ИначеЕсли КодВидаСведений = 2 Тогда
		Результат = " (PDF)";	
	КонецЕсли;	

	Возврат Результат;
КонецФункции	

