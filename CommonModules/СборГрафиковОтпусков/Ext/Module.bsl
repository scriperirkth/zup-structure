// * Периоды - см. ОписаниеПериодовСотрудников
// * Компенсации - см. ОписаниеКомпенсацийСотрудников
Функция НоваяТаблицаПодразделенияСбораГрафиковОтпусков()

	НоваяТаблица = Новый ТаблицаЗначений;
	НоваяТаблица.Колонки.Добавить("ГрафикСбора", 						Новый ОписаниеТипов("ДокументСсылка.СборГрафиковОтпусков"));
	НоваяТаблица.Колонки.Добавить("Год", 								Новый ОписаниеТипов("Число"));
	НоваяТаблица.Колонки.Добавить("Подразделение", 						Новый ОписаниеТипов("СправочникСсылка.ПодразделенияОрганизаций, СправочникСсылка.СтруктураПредприятия"));
	НоваяТаблица.Колонки.Добавить("ОтветственныйЗаСбор", 				Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
