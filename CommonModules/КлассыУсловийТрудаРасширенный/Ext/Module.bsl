#Область СлужебныйПрограммныйИнтерфейс

// См. КлассыУсловийТруда.ОбновитьВыявленныеВредныеФакторыВДокументеОснования
// Вызывается из обработчика обновления внутри открытой транзакции.
//
Процедура ОбновитьВыявленныеВредныеФакторыВДокументеОснования(ДокументСсылка, Должность, ВредныеКлассы) Экспорт

	ТипДокумента = ТипЗнч(ДокументСсылка);
	Если ТипДокумента <> Тип("ДокументСсылка.ИзменениеШтатногоРасписания")
		И ТипДокумента <> Тип("ДокументСсылка.УтверждениеШтатногоРасписания") Тогда

		Возврат;
	КонецЕсли;

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение НСтр("ru = 'Метод должен вызываться внутри активной транзакции.'");
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(ДокументСсылка.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСсылка);
	//@skip-check lock-out-of-try
	Блокировка.Заблокировать();

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЕстьИзменения = Ложь;
	Для Каждого СтрокаПозиции Из ДокументОбъект.Позиции Цикл
		Если СтрокаПозиции.Позиция <> Должность Тогда
			Продолжить;
		КонецЕсли;
		Если ВредныеКлассы.Найти(СтрокаПозиции.КлассУсловийТруда) <> Неопределено И Не СтрокаПозиции.ВыявленыВредныеОпасныеФакторы Тогда
			СтрокаПозиции.ВыявленыВредныеОпасныеФакторы = Истина;
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьИзменения Тогда
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	КонецЕсли;

КонецПроцедуры

// См. КлассыУсловийТруда.ВладелецНабораЗаписейЭтоУсловияТруда
//
Функция ВладелецНабораЗаписейЭтоУсловияТруда(ОбъектВладелец) Экспорт
	Возврат ТипЗнч(ОбъектВладелец) = Тип("СправочникСсылка.УсловияТруда");
КонецФункции

#КонецОбласти
