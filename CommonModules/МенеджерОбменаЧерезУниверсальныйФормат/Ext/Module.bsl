КонецПроцедуры
Процедура ПКО_ДанныеДляРасчетаЗарплаты_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ИспользуетсяВерсия_1_17(КомпонентыОбмена) Тогда
		
		ВидДокумента = Неопределено;
		ФизическиеЛицаПКО = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти("Справочник_ФизическиеЛица_Получение", "ИмяПКО");
		СотрудникиПКО = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти("Справочник_Сотрудники_Получение", "ИмяПКО");
		
		СводныйДокумент = Неопределено;
		ДанныеXDTO.КлючевыеСвойства.Свойство("СводныйДокумент", СводныйДокумент);
		Если СводныйДокумент = Истина Тогда
			ПолученныеДанные.Период = ДанныеXDTO.КлючевыеСвойства.НачалоПериода;
			ПолученныеДанные.ПериодОкончания = ДанныеXDTO.КлючевыеСвойства.ОкончаниеПериода;
			ВидыДокументов = КомпонентыОбмена.ПараметрыКонвертации.ВидыДокументовСдельныеРаботыСводно;
		Иначе
			ВидыДокументов = КомпонентыОбмена.ПараметрыКонвертации.ВидыДокументовСдельныеРаботыДетально;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидыДокументов) Тогда
			ВидДокумента = ВидыДокументов[Справочники.Организации.ПустаяСсылка()];
			Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
				ВидДокумента = ВидыДокументов[ПолученныеДанные.Организация];
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
			Возврат;
		КонецЕсли;
		
		ПолученныеДанные.Период = ПолученныеДанные.Дата;
		ПолученныеДанные.ВидДокумента = ВидДокумента;
		
		ВыполненныеРаботыXDTO = Неопределено;
		Если ДанныеXDTO.Свойство("ВыполненныеРаботы", ВыполненныеРаботыXDTO) И ЗначениеЗаполнено(ВыполненныеРаботыXDTO) Тогда
			
			ВыполненныеРаботы = Новый Массив;
			ФизическиеЛица = Новый Массив;
			СтрокиФизическихЛиц = Новый Соответствие;
			
			Для Каждого СтрокаТЗ Из ВыполненныеРаботыXDTO Цикл
				
				СтрокаВыполненныеРаботы = Новый Структура;
				
				Если СводныйДокумент <> Истина Тогда
					Если ЗначениеЗаполнено(СтрокаТЗ.ДатаВыполнения) Тогда
						СтрокаВыполненныеРаботы.Вставить("Период", СтрокаТЗ.ДатаВыполнения);
					Иначе
						СтрокаВыполненныеРаботы.Вставить("Период", ПолученныеДанные.Дата);
					КонецЕсли;
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(СтрокаТЗ.Сотрудник) Тогда
					СтрокаВыполненныеРаботы.Вставить("Сотрудник", ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, СтрокаТЗ.Сотрудник, СотрудникиПКО, "ПолучитьСсылку").Ссылка);
				Иначе
					ФизическоеЛицоСсылка = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, СтрокаТЗ.ФизическоеЛицо, ФизическиеЛицаПКО, "ПолучитьСсылку").Ссылка;
					СтрокиФизическогоЛица = СтрокиФизическихЛиц[ФизическоеЛицоСсылка];
					Если СтрокиФизическогоЛица = Неопределено Тогда
						СтрокиФизическогоЛица = Новый Массив;
					КонецЕсли;
					СтрокиФизическогоЛица.Добавить(СтрокаВыполненныеРаботы);
					СтрокиФизическихЛиц.Вставить(ФизическоеЛицоСсылка, СтрокиФизическогоЛица);
					ФизическиеЛица.Добавить(ФизическоеЛицоСсылка);
				КонецЕсли;
				СтрокаВыполненныеРаботы.Вставить("ВидРабот", Новый Структура("ИмяПКО, Значение", "Справочник_ВидыРаботСотрудников", СтрокаТЗ.ВидРабот));
				СтрокаВыполненныеРаботы.Вставить("ОбъемВыполненныхРабот", СтрокаТЗ.Количество);
				СтрокаВыполненныеРаботы.Вставить("Расценка", СтрокаТЗ.Расценка);
				СтрокаВыполненныеРаботы.Вставить("Сумма", СтрокаТЗ.Сумма);
				
				ВыполненныеРаботы.Добавить(СтрокаВыполненныеРаботы);
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ФизическиеЛица) Тогда
				ТаблицаСотрудники = КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(ФизическиеЛица, Ложь, ПолученныеДанные.Организация, ПолученныеДанные.Дата);
				Для каждого КлючИЗначение Из СтрокиФизическихЛиц Цикл
					ФизическоеЛицо = КлючИЗначение.Ключ;
					СтрокаСотрудники = ТаблицаСотрудники.Найти(ФизическоеЛицо, "ФизическоеЛицо");
					Если СтрокаСотрудники <> Неопределено Тогда
						СтрокиФизическогоЛица = КлючИЗначение.Значение;
						Для каждого СтрокаВыполненныеРаботы Из СтрокиФизическогоЛица Цикл
							СтрокаВыполненныеРаботы.Вставить("Сотрудник", СтрокаСотрудники.Сотрудник);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ВыполненныеРаботы.Количество() > 0 Тогда
				ПолученныеДанные.ДополнительныеСвойства.Вставить("ВыполненныеРаботы", ВыполненныеРаботы);
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ВидДокумента = Неопределено;
		ВидыДокументов = КомпонентыОбмена.ПараметрыКонвертации.ВидыДокументовСдельныеРаботыДетально;
		Если ЗначениеЗаполнено(ВидыДокументов) Тогда
			ВидДокумента = ВидыДокументов[Справочники.Организации.ПустаяСсылка()];
			Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
				ВидДокумента = ВидыДокументов[ПолученныеДанные.Организация];
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
			Возврат;
		КонецЕсли;
		
		ПолученныеДанные.Период = КонецМесяца(ПолученныеДанные.Дата);
		ПолученныеДанные.ВидДокумента = ВидДокумента;
		
		ПравилоКонвертацииФизЛица_Получение = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти("Справочник_ФизическиеЛица_Получение", "ИмяПКО");
		
		ВыполненныеРаботыXDTO = Неопределено;
		Если ДанныеXDTO.Свойство("ВыполненныеРаботы", ВыполненныеРаботыXDTO)
			И ЗначениеЗаполнено(ВыполненныеРаботыXDTO)
			И Не ПравилоКонвертацииФизЛица_Получение = Неопределено Тогда
			
			ВыполненныеРаботыXDTO.Колонки.Добавить("ФизическоеЛицоСсылка", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
			
			Для Каждого СтрокаВыполненныеРаботыXDTO Из ВыполненныеРаботыXDTO Цикл
				СтрокаВыполненныеРаботыXDTO.ФизическоеЛицоСсылка = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена,
				СтрокаВыполненныеРаботыXDTO.ФизическоеЛицо, ПравилоКонвертацииФизЛица_Получение, "ПолучитьСсылку").Ссылка;
			КонецЦикла;
			
			ТаблицаСотрудники = КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(ВыполненныеРаботыXDTO.ВыгрузитьКолонку("ФизическоеЛицоСсылка"), Ложь, ПолученныеДанные.Организация, ПолученныеДанные.Дата);
			
			ВыполненныеРаботы = Новый Массив;
			ФизическиеЛица    = Новый Массив;
			
			Для Каждого СтрокаВыполненныеРаботыXDTO Из ВыполненныеРаботыXDTO Цикл
				
				СтрокаВыполненныеРаботы = Новый Структура;
				
				СтрокаСотрудники = ТаблицаСотрудники.Найти(СтрокаВыполненныеРаботыXDTO.ФизическоеЛицоСсылка, "ФизическоеЛицо");
				Если Не СтрокаСотрудники = Неопределено Тогда
					СтрокаВыполненныеРаботы.Вставить("Сотрудник", СтрокаСотрудники.Сотрудник);
				КонецЕсли;
				
				СтрокаВыполненныеРаботы.Вставить("Период", ПолученныеДанные.Дата);
				СтрокаВыполненныеРаботы.Вставить("ВидРабот", Новый Структура("ИмяПКО, Значение", "Справочник_ВидыРаботСотрудников", СтрокаВыполненныеРаботыXDTO.ВидРабот));
				СтрокаВыполненныеРаботы.Вставить("ОбъемВыполненныхРабот", СтрокаВыполненныеРаботыXDTO.Количество);
				СтрокаВыполненныеРаботы.Вставить("Расценка", СтрокаВыполненныеРаботыXDTO.Расценка);
				СтрокаВыполненныеРаботы.Вставить("Сумма", СтрокаВыполненныеРаботыXDTO.Сумма);
				
				СтрокаФизическиеЛица = Новый Структура;
				СтрокаФизическиеЛица.Вставить("ФизическоеЛицо", СтрокаВыполненныеРаботыXDTO.ФизическоеЛицоСсылка);
				
				ВыполненныеРаботы.Добавить(СтрокаВыполненныеРаботы);
				ФизическиеЛица.Добавить(СтрокаФизическиеЛица);
			КонецЦикла;
			
			Если ВыполненныеРаботы.Количество() > 0 Тогда
				ПолученныеДанные.ДополнительныеСвойства.Вставить("ВыполненныеРаботы", ВыполненныеРаботы);
			КонецЕсли;
			
			Если ФизическиеЛица.Количество() > 0 Тогда
				ПолученныеДанные.ДополнительныеСвойства.Вставить("ФизическиеЛица", ФизическиеЛица);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_ДанныеДляРасчетаЗарплаты_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если Не ЗначениеЗаполнено(ПолученныеДанные.ВидДокумента) Тогда
		
		ШаблонПредупреждения = НСтр("ru = 'Данные для расчета зарплаты (выработка сотрудников) не могут быть загружены,
		|т.к. в справочнике ""Шаблоны ввода исходных данных"" нет ни одного элемента, соответствующего сдельным работам.
		|Организация'");
		ТекстПредупреждения = СтрШаблон("%1: %2", ШаблонПредупреждения, Строка(ПолученныеДанные.Организация));
		
		КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.ВыполненоСПредупреждениями; 
		ОбменДаннымиXDTOСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ТекстПредупреждения, , Ложь, , , );
		
		ПолученныеДанные = Неопределено;
		
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ИсполнительныйЛист_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ПолученныеДанные = Неопределено;
