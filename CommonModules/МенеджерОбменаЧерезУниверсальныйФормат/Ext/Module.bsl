Процедура ПКО_Документ_РезервыПоОплатеТруда_Получение_Сводно_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ЗначениеЗаполнено(ДанныеXDTO.ВидОперации) Тогда
		ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийРезервовПоОплатеТруда[ДанныеXDTO.ВидОперации];
	КонецЕсли;
	
	Если ИспользуетсяВерсия_1_17(КомпонентыОбмена) Тогда
		ПолученныеДанные.ОбязательстваОтраженыВБухучете = ДанныеXDTO.ОбязательстваОтраженыВРеглУчете;
	Иначе
		ПолученныеДанные.ОбязательстваОтраженыВБухучете = ДанныеXDTO.ОбязательстваОтраженыВРеглхучете;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_ОтражениеУдержанногоНДФЛВБухучете_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ОтражениеУдержанногоНДФЛ_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);
КонецПроцедуры
Процедура ПКО_Справочник_НастройкиРасчетаРезервовПоОплатеТруда_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ВидРезерва) Тогда
		ДанныеXDTO.Вставить("ВидРезерва", ОбщегоНазначения.ИмяЗначенияПеречисления(ДанныеИБ.ВидРезерва));
	КонецЕсли;
	
	ИспользоватьФормат1_15 = (СравнитьВерсии(КомпонентыОбмена.ВерсияФорматаОбмена, "1.15") >= 0);
	
	Если ИспользоватьФормат1_15 Тогда
		ДанныеXDTO.Вставить("СостояниеОбъекта", ?(ДанныеИБ.ПометкаУдаления, "Устаревший", "Актуальный"));
		ДанныеXDTO.КлючевыеСвойства.Вставить("Организация", ДанныеИБ.Организация);
	Иначе
		
		Если ЗначениеЗаполнено(ДанныеИБ.Организация) Тогда
			Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
				ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
			Иначе
				ДополнительныеДанные = Новый Структура;
			КонецЕсли;
			
			УИДОбъектаXDTO = РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.ПубличныйИдентификаторПоСсылкеОбъекта(
			КомпонентыОбмена.УзелКорреспондента, ДанныеИБ.Организация);
			
			ДополнительныеДанные.Вставить("Организация", УИДОбъектаXDTO); 
			ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

