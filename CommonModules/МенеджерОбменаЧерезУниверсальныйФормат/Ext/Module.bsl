		И (НЕ ЗначениеЗаполнено(ПолученныеДанные.Код)
		ИЛИ (ОбщегоНазначения.РазделениеВключено()
		И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных())) Тогда
		
