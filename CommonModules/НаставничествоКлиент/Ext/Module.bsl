
#Область СлужебныйПрограммныйИнтерфейс

#Область ОбщаяФормаНаставничество

// Открыть форму Наставничество.
// 
// Параметры:
//  ФормаВладелец - ФормаКлиентскогоПриложения
//  УчастникПроцессаНаставничества - ОпределяемыйТип.УчастникКадровогоРезерва
Процедура ОткрытьФормуНаставничество(ФормаВладелец, УчастникПроцессаНаставничества) Экспорт

	ПараметрыФормы = Новый Структура("УчастникПроцессаНаставничества", УчастникПроцессаНаставничества);
	ОткрытьФорму("ОбщаяФорма.Наставничество", ПараметрыФормы, ФормаВладелец);

КонецПроцедуры

Процедура ОткрытьФормуНазначениеНаставника(Форма, ПараметрыФормы = Неопределено) Экспорт
	
	ОткрытьФорму("Документ.НазначениеНаставника.ФормаОбъекта", ПараметрыФормы, Форма, Новый УникальныйИдентификатор);
	
КонецПроцедуры

Процедура ОткрытьФормуПрекращенияНаставничества(Форма, ПараметрыФормы = Неопределено) Экспорт
	
	ОткрытьФорму("Документ.ПрекращениеНаставничества.ФормаОбъекта", ПараметрыФормы, Форма, Новый УникальныйИдентификатор);
	
КонецПроцедуры

Процедура ОткрытьОтчетИсторияНаставничества(УчастникиПроцессаНаставничества, ДополнительныеПараметры) Экспорт
	
	ВариантыОтчетовКлиент.ОткрытьФормуОтчета(ДополнительныеПараметры.Форма, ДополнительныеПараметры.ВариантОтчета);

КонецПроцедуры

#КонецОбласти

#Область Формы

Процедура НаставничествоНаставникНачалоВыбораИзСписка(Форма, Элемент, СтандартнаяОбработка) Экспорт
	СписокСотрудников = Форма.СписокВыбораНаставников();
	Элемент.СписокВыбора.ЗагрузитьЗначения(СписокСотрудников);
КонецПроцедуры

Процедура НаставничествоДокументОснованиеНачалоВыбораИзСписка(Форма, Элемент, СтандартнаяОбработка) Экспорт
	
	ТекущиеДанные = Форма.Элементы.Наставничество.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
	ДействующиеНазначения = Новый Массив;
	
	Форма.Подключаемый_НаставничествоДокументОснованиеНачалоВыбораИзСпискаНаСервере(ТекущиеДанные.НомерСтроки-1, ДействующиеНазначения);
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(ДействующиеНазначения);
	
КонецПроцедуры

Процедура ДокументОснованиеПриИзменении(Форма, ОтображатьИзмененияПлановыхНачислений = Истина) Экспорт
	
	ТекущиеДанные = Форма.Элементы.Наставничество.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаставничествоДокументОснованиеПриИзменении(Форма, ТекущиеДанные, ОтображатьИзмененияПлановыхНачислений);
	
КонецПроцедуры

Процедура НаставничествоДокументОснованиеПриИзменении(Форма, ТекущиеДанные, ОтображатьИзмененияПлановыхНачислений = Истина)

	РеквизитыДокументаОснования = Наставничество.РеквизитыДокументаОснования(ТекущиеДанные.ДокументОснование);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыДокументаОснования);
	
	Если ОтображатьИзмененияПлановыхНачислений Тогда
		Форма.Подключаемый_НаставничествоОтменитьДоплатуПриИзмененииНаСервере(ТекущиеДанные.НомерСтроки-1);
	КонецЕсли;
	
КонецПроцедуры

Процедура НаставничествоПриНачалеРедактирования(Форма, Элемент, НоваяСтрока, Копирование, ДатаСобытия) Экспорт
	
	Если НоваяСтрока И Не Копирование Тогда
		Элемент.ТекущиеДанные.ДатаОкончания = ДатаСобытия;
	КонецЕсли;
	
КонецПроцедуры

Процедура НаставничествоОтменитьДоплатуПриИзменении(Форма) Экспорт
	Форма.Подключаемый_НаставничествоОтменитьДоплатуПриИзмененииНаСервере(Форма.Элементы.Наставничество.ТекущиеДанные.НомерСтроки-1);
КонецПроцедуры

Процедура РезервЗавершитьНаставничествоПриИзменении(Форма) Экспорт
	Форма.Подключаемый_РезервЗавершитьНаставничествоПриИзмененииНаСервере(Форма.Элементы.Резерв.ТекущиеДанные.НомерСтроки-1);
КонецПроцедуры

Процедура НаставничествоВыбор(Форма, Поле, СтандартнаяОбработка) Экспорт
	
	Если Не Поле.Имя = "НаставничествоФОТ" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Форма.Элементы.Наставничество.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Наставник) Тогда
		Возврат;
	КонецЕсли;
		
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("АдресВХранилище", Форма.АдресВХранилищеНачисленийИУдержаний(ТекущиеДанные.Наставник, ТекущиеДанные.ВремяРегистрации));
	ПараметрыОткрытия.Вставить("ТолькоПросмотр", Форма.ТолькоПросмотр);
	
	ЗарплатаКадрыРасширенныйКлиент.ОткрытьФормуРедактированияСоставаНачисленийИУдержаний(ПараметрыОткрытия, Форма);
	
КонецПроцедуры

Процедура НаставничествоНаставникПриИзменении(Форма, ОтображатьИзмененияПлановыхНачислений = Истина) Экспорт
	НаставничествоДокументОснованиеПриИзменении(Форма, Форма.Элементы.Наставничество.ТекущиеДанные, ОтображатьИзмененияПлановыхНачислений);
КонецПроцедуры

Процедура ЗаполнитьТаблицуНаставничества(Форма) Экспорт
	Форма.ЗаполнитьТаблицуНаставничестваНаСервере();
КонецПроцедуры

Процедура ЗавершитьНаставничествоПриИзменении(Форма) Экспорт
	
	Форма.Элементы.Наставничество.Доступность = Форма.Объект.ЗавершитьНаставничество;
	Если Форма.Объект.ЗавершитьНаставничество Тогда
		Форма.ЗаполнитьТаблицуНаставничестваНаСервере();
	Иначе
		Форма.Объект.Наставники.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Асинх Процедура ВыбратьНаставника(Форма, Элемент, ДатаОтбора) Экспорт
	
	Если Не Наставничество.ИспользуетсяНаставничество() Тогда
		
		КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(Элемент, , ,
			ДатаОтбора,Ложь);
		
		Возврат;
		
	КонецЕсли;
	
	ТипыНаставников = НаставничествоПовтИсп.ТипыНаставников();

	ТипНаставника = Ждать ТипыНаставников.ВыбратьЭлементАсинх(НСтр("ru='Выбор типа данных'"));
	
	Если Не ТипНаставника = Неопределено Тогда
		
		Если ТипНаставника.Значение = Тип("СправочникСсылка.Сотрудники") Тогда
			
			КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(Элемент, , ,
				ДатаОтбора,Ложь);
		
		ИначеЕсли ТипНаставника.Значение = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			
			КадровыйУчетКлиент.ВыбратьФизическихЛицОрганизации(Элемент, Неопределено, Ложь);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура НаставникОбработкаВыбора(ОбработкаВыполнена) Экспорт
	
	Если Наставничество.ИспользуетсяНаставничество() Тогда
		ОбработкаВыполнена = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
