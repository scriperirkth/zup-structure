#Область ПрограммныйИнтерфейс

#Область КонструкторыПараметров

// Создает параметры запроса.
//
// Параметры:
//  ДанныеДляОбработки - Строка, ДвоичныеДанные, Неопределено - данные для отправки методов передаваемые методом POST,
//    PUT, PATCH.
//    Значение по умолчанию: Неопределено
//  Заголовки - Неопределено
//            - Соответствие из КлючИЗначение:
//    * Ключ - Строка - имя заголовка запроса.
//    * Значение - Строка - значение заголовка запроса.
//    Значение по умолчанию: Неопределено
//  СтандартныеЗаголовки - Булево - если Истина, будут добавлены стандартные заголовки методов сервисов ИТС:
//    X-Correlation-ID, X-Session-ID, X-Info-Base-ID.
//    Значение по умолчанию: Истина
//  ПараметрыЗапросаURL - Неопределено
//                      - Соответствие из КлючИЗначение - параметры запроса, которые будут отправлены в URL
//    (key=value1&key=value2):
//    * Ключ - Строка - имя параметра запроса.
//    * Значение - Строка - значение параметра запроса.
//    Значение по умолчанию: Неопределено
//  ФорматОтвета - Число - определяет формат возврата содержимого ответа операции:
//    0 - как файл (HTTP методы в поле ответа "Содержимое" будет возвращен файл во временном каталоге с именем,
//      указанным в параметре "ИмяФайла").
//    1 - как строка.
//    2 - как двоичные данные.
//    Любое другое значение - как HTTPОтвет.
//    Значение по умолчанию: 1
//  ФорматДанныхДляОбработки - Число - формат отправки данных:
//    0 - как файл.
//    1 - как строка.
//    2 - как двоичные данные.
//    Значение по умолчанию: 1
//  ИмяФайла - Строка - имя файла с расширением, которое будет использовано при создании нового файла если
//    ФорматОтвета = 0.
//
// Возвращаемое значение:
//  Структура - параметры отправки запроса:
//    * ДанныеДляОбработки - Строка, ДвоичныеДанные, Неопределено - данные для отправки методов передаваемые методом
//        POST, PUT, PATCH.
//        Значение по умолчанию: Неопределено
//    * Заголовки - Неопределено
//                - Соответствие из КлючИЗначение:
//        ** Ключ - Строка - имя заголовка запроса.
//        ** Значение - Строка - значение заголовка запроса.
//        Значение по умолчанию: Неопределено
//    * СтандартныеЗаголовки - Булево - если Истина, будут добавлены стандартные заголовки методов сервисов ИТС:
//        X-Correlation-ID, X-Session-ID, X-Info-Base-ID.
//        Значение по умолчанию: Истина
//    * ПараметрыЗапросаURL - Неопределено
//                          - Соответствие из КлючИЗначение - параметры запроса, которые будут отправлены в URL
//        (key=value1&key=value2):
//        ** Ключ - Строка - имя параметра запроса.
//        ** Значение - Строка - значение параметра запроса.
//        Значение по умолчанию: Неопределено
//    * ФорматОтвета - Число - определяет формат возврата содержимого ответа операции:
//        0 - как файл (HTTP методы в поле ответа "Содержимое" будет возвращен файл во временном каталоге с именем,
//          указанным в параметре "ИмяФайла").
//        1 - как строка.
//        2 - как двоичные данные.
//        Любое другое значение - как HTTPОтвет.
//        Значение по умолчанию: 1
//    * ФорматДанныхДляОбработки - Число - формат отправки данных:
//        0 - как файл.
//        1 - как строка.
//        2 - как двоичные данные.
//        Значение по умолчанию: 1
//    * ИмяФайла - Строка - имя файла с расширением, которое будет использовано при создании нового файла если
//        ФорматОтвета = 0.
//
//@skip-check method-too-many-params
Функция НовыйПараметрыЗапроса(
		ДанныеДляОбработки = Неопределено,
		Заголовки = Неопределено,
		СтандартныеЗаголовки = Истина,
		ПараметрыЗапросаURL = Неопределено,
		ФорматОтвета = 1,
		ФорматДанныхДляОбработки = 1,
		ИмяФайла = "") Экспорт
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ДанныеДляОбработки", ДанныеДляОбработки);
	ПараметрыЗапроса.Вставить("Заголовки", Заголовки);
	ПараметрыЗапроса.Вставить("СтандартныеЗаголовки", СтандартныеЗаголовки);
	ПараметрыЗапроса.Вставить("ПараметрыЗапросаURL", ПараметрыЗапросаURL);
	ПараметрыЗапроса.Вставить("ФорматОтвета", ФорматОтвета);
	ПараметрыЗапроса.Вставить("ФорматДанныхДляОбработки", ФорматДанныхДляОбработки);
	ПараметрыЗапроса.Вставить("ИмяФайла", ИмяФайла);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

// Создает параметры обновления токена аутентификации.
//
// Параметры:
//  ИмяМетода - Строка - имя метода, который будет вызван в безопасном режиме
//    в случае если целевая операция вернет значение равное параметру КодОтвета.
//    В вызываемый метод будет передано два параметра:
//      Значения из параметра ПараметрыМетода
//      Обновленный токен аутентификации.
//    В результате работы метода должна быть возвращена структура см. НовыйДанныеВызова.
//  ПараметрыМетода - Произвольный, Неопределено - параметры методы обновления данных запроса.
//  ИдентификаторСервиса - Строка - имя сервиса, для которого выполняется
//    формирование токена.
//  КодОтвета - Число - код ответа метода сервиса при котором необходимо обновить
//    токен аутентификации и повторить запрос.
//    Значение по умолчанию: 401
//
// Возвращаемое значение:
//  Структура - параметры обновления токена аутентификации:
//    * ИмяМетода - Строка - имя метода, который будет вызван в безопасном режиме
//        в случае если целевая операция вернет значение равное параметру КодОтвета.
//        В вызываемый метод будет передано два параметра:
//          Значения из параметра ПараметрыМетода
//          Обновленный токен аутентификации.
//        В результате работы метода должна быть возвращена структура см. НовыйДанныеВызова.
//    * ПараметрыМетода - Произвольный, Неопределено - параметры методы обновления данных запроса.
//    * ИдентификаторСервиса - Строка - имя сервиса, для которого выполняется
//        формирование токена.
//    * КодОтвета - Число - код ответа метода сервиса при котором необходимо обновить
//        токен аутентификации и повторить запрос.
//        Значение по умолчанию: 401
//
// Пример:
//
// Функция ИнформацияОВерсиях(
//    Идентификаторы,
//    ДанныеАутентификации,
//    URLОперации)
//
// ДанныеДляОбработки = versionlatest(
//    Идентификаторы,
//    ДанныеАутентификации,
//    ПараметрыТела.ДополнительныеПараметры);
//  Заголовки = ИнтернетПоддержкаПользователей.НовыйЗаголовкиВызоваОперации();
//
//  ПараметрыОбновленияТокена = Http.НовыйПараметрыОбновленияТокена(
//   "РаботаСКлассификаторами.ПараметрыЗапроса",
//    Http.НовыйДанныеВызова(
//      Заголовки,
//      ДанныеДляОбработки),
//    "OnecClassifiers",
//    401);
//
//  ПараметрЗапроса = Http.НовыйПараметрыЗапроса(
//    ДанныеДляОбработки,
//    Заголовки);
//
//  // Вызов операции сервиса.
//  Возврат Http.POST(
//    URLОперации,
//    ПараметрЗапроса,
//    ПараметрыОбновленияТокена);
//
// КонецФункции
//
// Функция ПараметрыЗапроса(Параметры, ТокенАутентификации) Экспорт
// 
//  Параметры.Заголовки.Вставить(
//    "Authorization",
//    ИнтернетПоддержкаПользователей.ЗаголовокBearerАутентификации(
//      ТокенАутентификации));
//  Возврат Параметры;
// 
// КонецФункции
//
Функция НовыйПараметрыОбновленияТокена(
		ИмяМетода,
		ПараметрыМетода,
		ИдентификаторСервиса,
		КодОтвета = 401) Экспорт
	
	ПараметрыОбновленияТокена = Новый Структура;
	ПараметрыОбновленияТокена.Вставить("ИмяМетода", ИмяМетода);
	ПараметрыОбновленияТокена.Вставить("ПараметрыМетода", ПараметрыМетода);
	ПараметрыОбновленияТокена.Вставить("КодОтвета", КодОтвета);
	ПараметрыОбновленияТокена.Вставить("ИдентификаторСервиса", ИдентификаторСервиса);
	
	Возврат ПараметрыОбновленияТокена;
	
КонецФункции

// Создает структуру с данными вызова операции.
//
// Параметры:
//  ДанныеДляОбработки - Строка - данные для отправки в теле запроса.
//  Заголовки - Соответствие из КлючИЗначение:
//    * Ключ - Строка - имя заголовка вызова операции.
//    * Значение - Строка - значение заголовка вызова операции.
//
// Возвращаемое значение:
//  Структура - данные вызова:
//    * ДанныеДляОбработки - Строка, Неопределено - данные для отправки в теле запроса.
//    * Заголовки - Соответствие из КлючИЗначение:
//        ** Ключ - Строка - имя заголовка вызова операции.
//        ** Значение - Строка - значение заголовка вызова операции.
//
Функция НовыйДанныеВызова(
		ДанныеДляОбработки,
		Заголовки) Экспорт
	
	ДанныеВызова = Новый Структура;
	ДанныеВызова.Вставить("Заголовки", Заголовки);
	ДанныеВызова.Вставить("ДанныеДляОбработки", ДанныеДляОбработки);
	
	Возврат ДанныеВызова;
	
КонецФункции

// Создает параметры подключения.
//
// Параметры:
//  Таймаут - Число - время ожидания завершения операции в секундах.
//    Значение по умолчанию: 30
//  НастройкиПрокси - Неопределено - настройки прокси будут получены из информационной базы.
//                  - Структура - настройки подключения к прокси серверу.
//    Значение по умолчанию: Неопределено
//  ИспользоватьЗащищенноеСоединение - Булево - признак использования защищенного соединения
//    для запросов https.
//    Значение по умолчанию: Истина
//  ЗащищенноеСоединение - Неопределено - при использовании защищенного соединения будет
//    создан новый объект ЗащищенноеСоединениеOpenSSL.
//                       - ЗащищенноеСоединениеOpenSSL - защищенное соединение, которое
//    следует использовать при создании соединения.
//    Значение по умолчанию: Неопределено
//  КоличествоПеренаправлений - Число - максимальное количество перенаправлений,
//    которое следует обрабатывать.
//    Значение по умолчанию: 7
//
// Возвращаемое значение:
//  Структура:
//    * Таймаут - Число - время ожидания завершения операции в секундах.
//        Значение по умолчанию: 30
//    * НастройкиПрокси - Неопределено - настройки прокси будут получены из информационной базы.
//                      - Структура - настройки подключения к прокси серверу.
//        Значение по умолчанию: Неопределено
//    * ИспользоватьЗащищенноеСоединение - Булево - признак использования защищенного соединения
//        для запросов https.
//        Значение по умолчанию: Истина
//    * ЗащищенноеСоединение - Неопределено - при использовании защищенного соединения будет
//        создан новый объект ЗащищенноеСоединениеOpenSSL.
//                           - ЗащищенноеСоединениеOpenSSL - защищенное соединение, которое
//        следует использовать при создании соединения.
//        Значение по умолчанию: Неопределено
//    * КоличествоПеренаправлений - Число - максимальное количество перенаправлений,
//        которое следует обрабатывать.
//        Значение по умолчанию: 7
//
//@skip-check method-too-many-params
Функция НовыйПараметрыПодключения(
		Таймаут = 30,
		НастройкиПрокси = Неопределено,
		ИспользоватьЗащищенноеСоединение = Истина,
		ЗащищенноеСоединение = Неопределено,
		КоличествоПеренаправлений = 7) Экспорт
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Таймаут", Таймаут);
	ПараметрыПодключения.Вставить("НастройкиПрокси", НастройкиПрокси);
	ПараметрыПодключения.Вставить("ИспользоватьЗащищенноеСоединение", ИспользоватьЗащищенноеСоединение);
	ПараметрыПодключения.Вставить("ЗащищенноеСоединение", ЗащищенноеСоединение);
	ПараметрыПодключения.Вставить("КоличествоПеренаправлений", КоличествоПеренаправлений);
	
	Возврат ПараметрыПодключения;
	
КонецФункции

#КонецОбласти

#Область HTTPМетоды

// Выполняет отправку GET запроса по переданным параметрам.
//
// Параметры:
//  URL - Строка - URL операции.
//  ПараметрыЗапроса - см. НовыйПараметрыЗапроса
//  ПараметрыОбновленияТокена - Неопределено
//                            - см. НовыйПараметрыОбновленияТокена
//    Значение по умолчанию: Неопределено
//  ПараметрыПодключения - Неопределено - будут сформированы настройки по умолчанию из
//    метода см. НовыйПараметрыПодключения.
//                       - см. НовыйПараметрыПодключения
//    Значение по умолчанию: Неопределено
//
// Возвращаемое значение:
//  Структура - содержит результат операции:
//    * КодОшибки - Строка - идентификатор ошибки:
//        LockError - запрос заблокирован настройками программы.
//        ConnectError - ошибка установки соединения с сервисом.
//        ServerError - ошибка на сервере.
//        ClientError - ошибка формирования запроса на клиенте.
//    * СообщениеОбОшибке - Строка - описание ошибки для пользователя.
//    * ИнформацияОбОшибке - Строка - описание ошибки для администратора.
//    * Содержимое - Строка, ДвоичныеДанные, HTTPОтвет, Неопределено - тело ответа.
//    * КодСостояния - Число - код состояния http, который вернул сервер.
//        Возможно передача кодов состояний -1 и -2 в случае блокирования запроса
//        со стороны программы 1С.
//    * ФорматОтвета - Число - определяет формат возврата содержимого ответа операции:
//        0 - как файл (в поле "Содержимое" будет возвращен файл во временном
//          каталоге с именем, указанным в параметре см. НовыйПараметрыЗапроса.ИмяФайла).
//        1 - как строка.
//        2 - как двоичные данные.
//        Любое другое значение - как HTTPОтвет.
//   * Заголовки - Соответствие из КлючИЗначение:
//       ** Ключ - Строка - имя заголовка запроса.
//       ** Значение - Строка - значение заголовка запроса.
//
Функция GET(
		URL,
		ПараметрыЗапроса,
		ПараметрыОбновленияТокена = Неопределено,
		ПараметрыПодключения = Неопределено) Экспорт
	
	Возврат ВыполнитьHTTPЗапрос(
		URL,
		"GET",
		ПараметрыЗапроса,
		ПараметрыОбновленияТокена,
		ПараметрыПодключения,
		"HTTP.GET");
	
КонецФункции

// Выполняет отправку OPTIONS запроса по переданным параметрам.
//
// Параметры:
//  URL - Строка - URL операции.
//  ПараметрыЗапроса - см. НовыйПараметрыЗапроса
//  ПараметрыОбновленияТокена - Неопределено
//                            - см. НовыйПараметрыОбновленияТокена
//    Значение по умолчанию: Неопределено
//  ПараметрыПодключения - Неопределено - будут сформированы настройки по умолчанию из
//    метода см. НовыйПараметрыПодключения.
//                       - см. НовыйПараметрыПодключения
//    Значение по умолчанию: Неопределено
//
// Возвращаемое значение:
//  Структура - содержит результат операции:
//    * КодОшибки - Строка - идентификатор ошибки:
//        LockError - запрос заблокирован настройками программы.
//        ConnectError - ошибка установки соединения с сервисом.
//        ServerError - ошибка на сервере.
//        ClientError - ошибка формирования запроса на клиенте.
//    * СообщениеОбОшибке - Строка - описание ошибки для пользователя.
//    * ИнформацияОбОшибке - Строка - описание ошибки для администратора.
//    * Содержимое - Строка, ДвоичныеДанные, HTTPОтвет, Неопределено - тело ответа.
//    * КодСостояния - Число - код состояния http, который вернул сервер.
//        Возможно передача кодов состояний -1 и -2 в случае блокирования запроса
//        со стороны программы 1С.
//    * ФорматОтвета - Число - определяет формат возврата содержимого ответа операции:
//        0 - как файл (в поле "Содержимое" будет возвращен файл во временном
