// Выполняет отправку HTTP запроса запроса по переданным параметрам.
//
// Параметры:
//  URL - Строка - URL операции.
//  Метод - Строка - используемый HTTP метод.
//  ПараметрыЗапроса - см. НовыйПараметрыЗапроса
//  ПараметрыОбновленияТокена - Неопределено
//                            - см. НовыйПараметрыОбновленияТокена
//  ПараметрыПодключения - Неопределено
//                       - см. НовыйПараметрыПодключения
//  ИмяФункции - Строка - имя вызывающей функции.
//
// Возвращаемое значение:
//  Структура - содержит результат операции:
//    * КодОшибки - Строка - идентификатор ошибки:
//        LockError - запрос заблокирован настройками программы.
//        ConnectError - ошибка установки соединения с сервисом.
//        ServerError - ошибка на сервере.
//        ClientError - ошибка формирования запроса на клиенте.
//    * СообщениеОбОшибке - Строка - описание ошибки для пользователя.
//    * ИнформацияОбОшибке - Строка - описание ошибки для администратора.
//    * Содержимое - Строка, ДвоичныеДанные, HTTPОтвет, Неопределено - тело ответа.
//    * КодСостояния - Число - код состояния http, который вернул сервер.
//        Возможно передача кодов состояний -1 и -2 в случае блокирования запроса
//        со стороны программы 1С.
//    * ФорматОтвета - Число - определяет формат возврата содержимого ответа операции:
//        0 - как файл (в поле "Содержимое" будет возвращен файл во временном
//          каталоге с именем, указанным в параметре см. НовыйПараметрыЗапроса.ИмяФайла).
//        1 - как строка.
//        2 - как двоичные данные.
//        Любое другое значение - как HTTPОтвет.
//   * Заголовки - Соответствие из КлючИЗначение:
//       ** Ключ - Строка - имя заголовка запроса.
//       ** Значение - Строка - значение заголовка запроса.
//
Функция ВыполнитьHTTPЗапрос(
		Знач URL,
		Метод,
		ПараметрыЗапроса,
		ПараметрыОбновленияТокена,
		ПараметрыПодключения,
		ИмяФункции)
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		ИмяФункции,
		"URL",
		URL,
		Тип("Строка"));
	
	НовыйПараметрыЗапроса = НовыйПараметрыЗапроса();
	НовыйПараметрыЗапроса.Вставить("Метод", Метод);
	
	ЗаполнитьЗначенияСвойств(
		НовыйПараметрыЗапроса,
		ПараметрыЗапроса);
	ПроверитьПараметрыЗапроса(
		НовыйПараметрыЗапроса,
		ИмяФункции);
	
	НовыйПараметрыПодключения = НовыйПараметрыПодключения();
	Если ПараметрыПодключения <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(
			НовыйПараметрыПодключения,
			ПараметрыПодключения);
		ПроверитьПараметрыПодключения(
			НовыйПараметрыПодключения,
			ИмяФункции);
	КонецЕсли;
	
	НовыйПараметрыОбновленияТокена = НовыйПараметрыОбновленияТокена(
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено);
	Если ПараметрыОбновленияТокена <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(
			НовыйПараметрыОбновленияТокена,
			ПараметрыОбновленияТокена);
		ПроверитьПараметрыОбновленияТокена(
			НовыйПараметрыОбновленияТокена,
			ИмяФункции);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(
		НовыйПараметрыЗапроса,
		НовыйПараметрыПодключения);
	ДобавитьСтандартныеЗаголовки(НовыйПараметрыЗапроса);
	
	URL = URL
		+ СтрокаПараметрыЗапросаURL(
			ПараметрыЗапроса.ПараметрыЗапросаURL);
	
	РезультатОперации = ИнтернетПоддержкаПользователей.ЗагрузитьСодержимоеИзИнтернет(
		URL,
		,
		,
		НовыйПараметрыЗапроса);
	
	// Обработка устаревшего токена
	Если ПараметрыОбновленияТокена <> Неопределено
		И НовыйПараметрыОбновленияТокена.КодОтвета = РезультатОперации.КодСостояния Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		РезультатАутентификации = ИнтернетПоддержкаПользователей.ТокенАутентификации(
			НовыйПараметрыОбновленияТокена.ИдентификаторСервиса,
			Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
		Если ЗначениеЗаполнено(РезультатАутентификации.КодОшибки) Тогда
			Возврат РезультатОперации;
		КонецЕсли;
		
		ПараметрыВызова = Новый Массив;
		ПараметрыВызова.Добавить(НовыйПараметрыОбновленияТокена.ПараметрыМетода);
		ПараметрыВызова.Добавить(РезультатАутентификации.Токен);
		
		ДанныеВызова = ОбщегоНазначения.ВыполнитьМетодКонфигурации(
			НовыйПараметрыОбновленияТокена.ИмяМетода,
			ПараметрыВызова,
			Истина);
		
		НовыйПараметрыЗапроса.Заголовки = ДанныеВызова.Заголовки;
		НовыйПараметрыЗапроса.ДанныеДляОбработки = ДанныеВызова.ДанныеДляОбработки;
		ДобавитьСтандартныеЗаголовки(НовыйПараметрыЗапроса);
		
		РезультатОперации = ИнтернетПоддержкаПользователей.ЗагрузитьСодержимоеИзИнтернет(
			URL,
			,
			,
			НовыйПараметрыЗапроса);
		
	КонецЕсли;
	
	Возврат РезультатОперации;
	
КонецФункции

// Добавляет стандартные заголовки сервисов ИТС.
//
// Параметры:
//  ПараметрыЗапроса - см. НовыйПараметрыЗапроса
//
Процедура ДобавитьСтандартныеЗаголовки(
		ПараметрыЗапроса)
	
	Если ПараметрыЗапроса.СтандартныеЗаголовки Тогда
		Если ПараметрыЗапроса.Заголовки = Неопределено Тогда
			ПараметрыЗапроса.Заголовки = Новый Соответствие;
		КонецЕсли;
		ПараметрыЗапроса.Заголовки.Вставить(
			"X-Correlation-ID",
			Строка(Новый УникальныйИдентификатор));
		ПараметрыЗапроса.Заголовки.Вставить(
			"X-Session-ID",
			ИнтернетПоддержкаПользователейСлужебныйПовтИспНаВремяВызова.НовыйИдентификаторСессии());
		ПараметрыЗапроса.Заголовки.Вставить(
			"X-Info-Base-ID",
			СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы());
		ПараметрыЗапроса.Заголовки.Вставить(
			"X-Program-Nick",
			ИнтернетПоддержкаПользователей.ИмяПрограммы());
	КонецЕсли;
	
КонецПроцедуры

// Проверяет параметры запроса перед выполнением запроса.
//
// Параметры:
//  ПараметрыЗапроса - см. НовыйПараметрыЗапроса
//  ИмяФункции - Строка - имя вызывающей функции.
//
Процедура ПроверитьПараметрыЗапроса(
		ПараметрыЗапроса,
		ИмяФункции)
	
	ТипыДанныеДляОбработки = Новый Массив;
	ТипыДанныеДляОбработки.Добавить(Тип("Строка"));
	ТипыДанныеДляОбработки.Добавить(Тип("ДвоичныеДанные"));
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса.ДанныеДляОбработки) Тогда
		ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
			ИмяФункции,
			"ДанныеДляОбработки",
			ПараметрыЗапроса.ДанныеДляОбработки,
			ТипыДанныеДляОбработки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса.Заголовки) Тогда
		ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
			ИмяФункции,
			"Заголовки",
			ПараметрыЗапроса.Заголовки,
			Тип("Соответствие"));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		ИмяФункции,
		"ФорматОтвета",
		ПараметрыЗапроса.ФорматОтвета,
		Тип("Число"));
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса.ПараметрыЗапросаURL) Тогда
		ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
			ИмяФункции,
			"ПараметрыЗапроса",
			ПараметрыЗапроса.ПараметрыЗапросаURL,
			Тип("Соответствие"));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		ИмяФункции,
		"ФорматДанныхДляОбработки",
		ПараметрыЗапроса.ФорматДанныхДляОбработки,
		Тип("Число"));
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		ИмяФункции,
		"ИмяФайла",
		ПараметрыЗапроса.ИмяФайла,
		Тип("Строка"));
	
КонецПроцедуры

// Проверяет параметры запроса перед выполнением запроса.
//
// Параметры:
//  ПараметрыОбновленияТокена - см. НовыйПараметрыОбновленияТокена
//  ИмяФункции - Строка - имя вызывающей функции.
//
