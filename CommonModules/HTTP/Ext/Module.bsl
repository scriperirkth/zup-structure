		ПараметрыОбновленияТокена,
		ИмяФункции)
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		ИмяФункции,
		"ИмяМетода",
		ПараметрыОбновленияТокена.ИмяМетода,
		Тип("Строка"));
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		ИмяФункции,
		"ИдентификаторСервиса",
		ПараметрыОбновленияТокена.ИдентификаторСервиса,
		Тип("Строка"));
	
	Если ЗначениеЗаполнено(ПараметрыОбновленияТокена.ПараметрыМетода) Тогда
		ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
			ИмяФункции,
