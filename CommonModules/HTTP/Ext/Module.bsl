	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		ИмяФункции,
		"КоличествоПеренаправлений",
		ПараметрыПодключения.КоличествоПеренаправлений,
		Тип("Число"));
	
КонецПроцедуры

// Формирует строку параметров URL.
//
// Параметры:
//  ПараметрыЗапросаURL - Соответствие из КлючИЗначение - параметры запроса, которые будут отправлены в URL:
//    * Ключ - Строка - имя параметра запроса.
//    * Значение - Строка - значение параметра запроса.
//
// Возвращаемое значение:
//  Строка - параметры запроса URL.
//
Функция СтрокаПараметрыЗапросаURL(ПараметрыЗапросаURL)
	
	Если Не ЗначениеЗаполнено(ПараметрыЗапросаURL) Тогда
		Возврат "";
	КонецЕсли;
	
	Параметры = Новый Массив;
	Для Каждого Параметр Из ПараметрыЗапросаURL Цикл
		
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			Значения = Параметр.Значение;
		Иначе
			Значения = Новый Массив;
			Значения.Добавить(Параметр.Значение);
		КонецЕсли;
	
		Если Параметр.Значение = Неопределено Тогда
			Параметры.Добавить(Параметр.Ключ);
		Иначе
			Для Каждого Значение Из Значения Цикл
				Параметры.Добавить(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						"%1=%2",
						Параметр.Ключ,
						КодироватьСтроку(
							Значение,
							СпособКодированияСтроки.КодировкаURL)));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "?" + СтрСоединить(Параметры, "&");
	
КонецФункции

