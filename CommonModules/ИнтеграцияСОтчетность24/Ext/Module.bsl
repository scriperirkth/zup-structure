#Область СлужебныйПрограммныйИнтерфейс

#Область РегистрацияРегламентногоЗаданияВСервисе
// См. ОчередьЗаданийПереопределяемый.ПриПолученииСпискаШаблонов
Процедура ПриПолученииСпискаШаблонов(ШаблоныЗаданий) Экспорт

	ШаблоныЗаданий.Добавить(Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24.Имя);

КонецПроцедуры

// См. ОчередьЗаданийПереопределяемый.ПриОпределенииПсевдонимовОбработчиков
Процедура ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам) Экспорт

	СоответствиеИменПсевдонимам.Вставить(Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24.ИмяМетода);

КонецПроцедуры

// См. РегламентныеЗаданияПереопределяемый.ПриОпределенииНастроекРегламентныхЗаданий
Процедура ПриОпределенииНастроекРегламентныхЗаданий(Настройки) Экспорт
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ИспользоватьПолучениеСообщенийИзШиныОтчетность24;
	Настройка.РаботаетСВнешнимиРесурсами = Истина;
	Настройка.ДоступноВМоделиСервиса = Истина;
	Если Настройки.Колонки.Найти("ОбращаетсяКВнешнимРесурсам") <> Неопределено Тогда
		Настройка.ОбращаетсяКВнешнимРесурсам = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьРегламентноеЗадание() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИспользоватьПолучениеСообщенийИзШиныОтчетность24 = Константы.ИспользоватьПолучениеСообщенийИзШиныОтчетность24.Получить();
	Если Не ИспользоватьПолучениеСообщенийИзШиныОтчетность24 Тогда
		Менеджер = Константы.ИспользоватьПолучениеСообщенийИзШиныОтчетность24.СоздатьМенеджерЗначения();
		Менеджер.ОбменДанными.Загрузка = Истина;
		Менеджер.Значение = Истина;
		Менеджер.Записать();
	КонецЕсли;
	
	Отбор = Новый Структура();
	Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
		Отбор.Вставить("ИмяМетода", Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24.ИмяМетода);
	Иначе
		Отбор.Вставить("Ключ", Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24.Ключ);
	КонецЕсли;
	НайденныеЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);
	Для Каждого Задание Из НайденныеЗадания Цикл
		Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
			Если Не ЗначениеЗаполнено(Задание.Шаблон) Тогда
				ПараметрыЗадания = Новый Структура;
				ПараметрыЗадания.Вставить("Использование", Ложь);
				РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
				РегламентныеЗаданияСервер.УдалитьЗадание(Задание.УникальныйИдентификатор);
				Продолжить;
			КонецЕсли;
		Иначе
			Если Не Задание.Предопределенное Тогда
				ПараметрыЗадания = Новый Структура;
				ПараметрыЗадания.Вставить("Использование", Ложь);
				РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
				РегламентныеЗаданияСервер.УдалитьЗадание(Задание.УникальныйИдентификатор);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("Использование", Истина);
		РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтключитьРегламентноеЗадание() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИспользоватьПолучениеСообщенийИзШиныОтчетность24 = Константы.ИспользоватьПолучениеСообщенийИзШиныОтчетность24.Получить();
	Если ИспользоватьПолучениеСообщенийИзШиныОтчетность24 Тогда
		Менеджер = Константы.ИспользоватьПолучениеСообщенийИзШиныОтчетность24.СоздатьМенеджерЗначения();
		Менеджер.ОбменДанными.Загрузка = Истина;
		Менеджер.Значение = Ложь;
		Менеджер.Записать();
	КонецЕсли;
	
	Отбор = Новый Структура();
	Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
		Отбор.Вставить("ИмяМетода", Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24.ИмяМетода);
	Иначе
		Отбор.Вставить("Ключ", Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24.Ключ);
	КонецЕсли;
	Отбор.Вставить("Использование", Истина);
	НайденныеЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);
	Для Каждого Задание Из НайденныеЗадания Цикл
		Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
			Если Не ЗначениеЗаполнено(Задание.Шаблон) Тогда
				ПараметрыЗадания = Новый Структура;
				ПараметрыЗадания.Вставить("Использование", Ложь);
				РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
				РегламентныеЗаданияСервер.УдалитьЗадание(Задание.УникальныйИдентификатор);
				Продолжить;
			КонецЕсли;
		Иначе
			Если Не Задание.Предопределенное Тогда
				ПараметрыЗадания = Новый Структура;
				ПараметрыЗадания.Вставить("Использование", Ложь);
				РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
				РегламентныеЗаданияСервер.УдалитьЗадание(Задание.УникальныйИдентификатор);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("Использование", Ложь);
		РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
	КонецЦикла;
	
КонецПроцедуры

Процедура ИсправлениеРегламентныхЗаданий() Экспорт
	Возврат;
КонецПроцедуры

#КонецОбласти

// См. ВыгрузкаЗагрузкаДанныхПереопределяемый.ПриЗаполненииТиповИсключаемыхИзВыгрузкиЗагрузки.
Процедура ПриЗаполненииТиповИсключаемыхИзВыгрузкиЗагрузки(Типы) Экспорт

	Если Не ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.ВыгрузкаЗагрузкаДанных") Тогда
		Возврат;
	КонецЕсли;
	
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРОЗапросы);
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРОНастройкиПодтверждения);
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРООграниченияПоОрганизациям);
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРОПараметрыШины);
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРОПодключения);
	
КонецПроцедуры

// Возвращает параметры базы данных.
// 
// Возвращаемое значение:
//  Структура:
// * Имя                - Строка
// * АдресОбласти       - Строка
// * ИдентификаторБазы  - Строка
// * ЭтоФайловаяБаза    - Булево
// * ВерсияКонфигурации - Строка
// * Конфигурация       - Строка
Функция ПараметрыБазыДанных() Экспорт
	
	Результат = Новый Структура(); 
	Результат.Вставить("Имя", Строка(ОбменДаннымиПовтИсп.ИмяЭтойИнформационнойБазы()));
	Результат.Вставить("АдресОбласти", Отчетность24БРО.АдресОбласти());
	Результат.Вставить("ИдентификаторБазы", Отчетность24БРО.ИдентификаторБазы());
	Результат.Вставить("ЭтоФайловаяБаза", ОбщегоНазначения.ИнформационнаяБазаФайловая());
	Результат.Вставить("ВерсияКонфигурации", ИнтернетПоддержкаПользователей.ВерсияКонфигурации());
	Результат.Вставить("Конфигурация", 
		Строка(УдалитьВерсиюИзНаименованияКонфигурации(ИнтернетПоддержкаПользователей.СинонимКонфигурации())));
	
	Возврат Результат;
	
КонецФункции

