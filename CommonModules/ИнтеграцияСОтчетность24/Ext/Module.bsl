// Конструктор структуры транспортного контейнера
// 
// Возвращаемое значение:
//  Структура:
// * Госорган         - Строка - 
// * ДоступРазрешен   - Булево - 
// * ИДОтчета         - Строка - 
// * ИДРедакцииОтчета - Строка - 
// * ИмяТипа          - Строка -
// * ТекстОшибки      - Строка - 
// * ПодробноеПредставлениеОшибки - Строка
// * ТекстРекомендаций - Строка 
Функция НовыйТранспортныйКонтейнер()
	
	Результат = Новый  Структура();
	Результат.Вставить("Госорган", "");
