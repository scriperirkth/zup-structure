// Записывает whitelist организаций получателя в регистр ограничения передачи данных
//
// Параметры:
//  Получатель - Строка - код получателя настройки
//  Организации - Массив Из СправочникСсылка.Организации - организации разрешенные для передачи
//
Процедура ЗаписатьОграничениеПоОрганизациям(Получатель, Организации)

	Если Не ЗначениеЗаполнено(Получатель) Или Организации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МассивОрганизаций = Новый Массив(); // см. ЗаписатьОграничениеПоОрганизациям.Организации
	Для Каждого Организация Из Организации Цикл

		Если Не ЗначениеЗаполнено(Организация) Тогда
			Продолжить;
		КонецЕсли;

		Если МассивОрганизаций.Найти(Организация) = Неопределено Тогда
			МассивОрганизаций.Добавить(Организация);
		КонецЕсли;
	КонецЦикла;

	НаборОграничений = РегистрыСведений.Отчетность24БРООграниченияПоОрганизациям.СоздатьНаборЗаписей();
	НаборОграничений.Отбор.Получатель.Установить(Получатель);
	Для Каждого Организация Из МассивОрганизаций Цикл
		НоваяЗапись = НаборОграничений.Добавить();
		НоваяЗапись.Получатель = Получатель;
		НоваяЗапись.Организация = Организация;
	КонецЦикла;
	НаборОграничений.Записать();

КонецПроцедуры

// Заполняет пользователей учетной базы для подтверждения отправки по получателю
//
// Параметры:
//  Получатель - Строка - код получателя настройки
Процедура ЗаполнитьПользователейДляПодтвержденияОтправки(Получатель)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.Пользователь КАК Пользователь
		|ИЗ
		|	РегистрСведений.Отчетность24БРОНастройкиПодтверждения КАК
		|		НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность
		|ГДЕ
		|	НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.РазрешеноПодтверждениеОтправки
		|	И НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.Получатель = &Получатель";

	Запрос.УстановитьПараметр("Получатель", Получатель);

	РезультатЗапроса = Запрос.Выполнить();

	МассивПользователей = Новый Массив(); // Массив Из ОпределяемыйТип.Пользователь
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ВыборкаПользователь = Выборка["Пользователь"]; // ОпределяемыйТип.Пользователь
		
		Если Не ЗначениеЗаполнено(ВыборкаПользователь) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеСписка = МассивПользователей.Найти(ВыборкаПользователь);
		Если ЗначениеСписка = Неопределено Тогда
			МассивПользователей.Добавить(ВыборкаПользователь);
		КонецЕсли;
		
	КонецЦикла;

	Для Каждого Пользователь Из МассивПользователей Цикл // ОпределяемыйТип.Пользователь
		ЗаписьПодтверждения = РегистрыСведений.Отчетность24БРОНастройкиПодтверждения.СоздатьМенеджерЗаписи();
		ЗаписьПодтверждения.Получатель = Получатель;
		ЗаписьПодтверждения.Пользователь = Пользователь;
		ЗаписьПодтверждения.РазрешеноПодтверждениеОтправки = Истина;
		ЗаписьПодтверждения.Записать();
	КонецЦикла;

КонецПроцедуры

