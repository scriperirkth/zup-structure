#Область ПодключениеКШинеОтчетности

// Сохраняет настройки подключения по результату рукопожатия с шиной
// Вызывается как из интерактивной формы записи регистра, так и из тихого подключения
// при первичной загрузке справочников
//
// Параметры:
//  РезультатПодключения - см. ИнтеграцияСОтчетность24ВызовСервера.Подключиться
//
// Возвращаемое значение:
//  Булево - Истина если настройки записаны
//
Функция СохранитьНастройкиПодключения(РезультатПодключения) Экспорт

	Получатель = "";
	Если Не РезультатПодключения.Свойство("Получатель", Получатель) Или Не ЗначениеЗаполнено(Получатель) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = РегистрыСведений.Отчетность24БРОПодключения.СоздатьМенеджерЗаписи();
	Запись.Получатель = Получатель;
	Запись.Прочитать();
	ЭтоНоваяНастройка = Не Запись.Выбран();

	// Реквизиты подключения заполняются только при первом подключении.
	// Повторное подключение той же базы лишь дополняет список организаций.
	Если ЭтоНоваяНастройка Тогда
		ЗаполнитьЗначенияСвойств(Запись, РезультатПодключения);
		Запись.Получатель = Получатель;
		Запись.ТребоватьПодтверждениеПользователя = Истина;
		Запись.Имя = Запись.Имя
			+ ИнтеграцияСОтчетность24ВызовСервера.ИндексНаименованияНастройки(Запись.Имя, Получатель);
		Запись.Записать();
		
		ДобавитьРегламентноеЗадание();
		
	КонецЕсли;

	Организации = Неопределено; // см. ЗаписатьОграничениеПоОрганизациям.Организации
	Если РезультатПодключения.Свойство("Организации", Организации) И ЗначениеЗаполнено(Организации) Тогда
		ЗаписатьОграничениеПоОрганизациям(Получатель, Организации);
	КонецЕсли;

	ЗаполнитьПользователейДляПодтвержденияОтправки(Получатель);

	Возврат Истина;

КонецФункции

