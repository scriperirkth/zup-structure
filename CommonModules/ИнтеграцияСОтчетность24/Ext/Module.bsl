	Результат.Вставить("ИДРедакцииОтчета", "");
	Результат.Вставить("ИмяТипа", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ПодробноеПредставлениеОшибки", "");
	Результат.Вставить("ТекстРекомендаций", "");
	
	Возврат Результат;
	
КонецФункции

// Описание профиля подтверждение отправки данных в отчетность.
// 
// Возвращаемое значение:
//  см. УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа
Функция ОписаниеПрофиляПодтверждениеОтправкиДанныхВОтчетность()
	
	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Имя           = Метаданные.Роли.ПодтверждениеОтправкиДанныхВОтчетность24.Имя;
	ОписаниеПрофиля.Родитель      = "ДополнительныеПрофили";
	ОписаниеПрофиля.Идентификатор = "954328da-6978-4028-a933-f6e913eea3b0";
	ОписаниеПрофиля.Наименование  = Метаданные.Роли.ПодтверждениеОтправкиДанныхВОтчетность24.Синоним;
