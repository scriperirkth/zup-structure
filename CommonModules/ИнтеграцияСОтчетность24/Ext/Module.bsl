Функция НедоступныеДляЗаписиСтандартныеРеквизиты()

	Результат = Новый Массив;
	Результат.Добавить("Ссылка");
	Результат.Добавить("Проведен");
	Результат.Добавить("ЭтоГруппа");
	Результат.Добавить("Предопределенный");
	Результат.Добавить("ИмяПредопределенныхДанных");

	Возврат Результат;

КонецФункции

// Загрузить контейнер в объект.
// 
// Параметры:
//  Объект           - ДокументОбъект, СправочникОбъект - 
//  ДанныеЗаполнения - Структура
Процедура ЗагрузитьКонтейнерВОбъект(Объект, ДанныеЗаполнения) Экспорт
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	НедоступныеДляЗаписи = НедоступныеДляЗаписиСтандартныеРеквизиты();
	Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если НедоступныеДляЗаписи.Найти(Реквизит.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеРеквизита = Неопределено;
		Если ДанныеЗаполнения.Свойство(Реквизит.Имя, ЗначениеРеквизита) Тогда
			Объект[Реквизит.Имя] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл   
		ЗначениеРеквизита = Неопределено;
		Если ДанныеЗаполнения.Свойство(Реквизит.Имя, ЗначениеРеквизита) Тогда
			Объект[Реквизит.Имя] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;  
	
	Для Каждого ТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		МассивСтрок = Неопределено;
		Если ДанныеЗаполнения.Свойство(ТабЧасть.Имя, МассивСтрок) И ТипЗнч(МассивСтрок) = Тип("Массив") Тогда
			ОбъектТабЧасть = Объект[ТабЧасть.Имя]; // ТабличнаяЧасть
			Для Каждого СтруктураСтроки Из МассивСтрок Цикл
				ЗаполнитьЗначенияСвойств(ОбъектТабЧасть.Добавить(), СтруктураСтроки)	
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

