// Добавляет новый запрос интеграции.
// 
// Параметры:
//  ПараметрыЗапроса - Структура:
// * Идентификатор        - Строка - 
// * Получатель           - Строка - 
// * Отправитель          - Строка - 
// * ИДОтчета             - Строка - 
// * ИДРедакцииОтчета     - Строка - 
// * ИмяТипа              - Строка - 
// * ТекстДополнения      - Строка - 
// * ДатаПолученияЗапроса - Дата - 
// * Организация          - ОпределяемыйТип.Организация 
// * ПериодОтчета         - Строка - 
// * ТелоЗапроса          - Строка - 
Процедура ДобавитьЗапросИнтеграции(ПараметрыЗапроса) Экспорт
	
	Запись = РегистрыСведений.Отчетность24БРОЗапросы.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, ПараметрыЗапроса);
	Запись.Записать();
	
КонецПроцедуры

// Обработка полученного сообщения
// 
// Параметры:
//  ЗаголовкиСообщения - Структура:
// * КодПолучателя  - Строка 
// * КодОтправителя - Строка 
// * Идентификатор  - Строка 
//  ТелоПоток       - Поток 
//  Отказ           - Булево 
Процедура ОбработатьПолученноеСообщение(ЗаголовкиСообщения, ТелоПоток, Отказ = Ложь) Экспорт
	
	НастройкиИнтеграции = ПолучитьНастройкиИнтеграции(ЗаголовкиСообщения.КодОтправителя);
	Если НастройкиИнтеграции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РазмерБуфера = 1024;
	
	Тело  = Новый БуферДвоичныхДанных(0);
	Буфер = Новый БуферДвоичныхДанных(РазмерБуфера);
	
	ПрочитаноВсего = 0;
	Пока Истина Цикл
		Прочитано = ТелоПоток.Прочитать(Буфер, 0, РазмерБуфера);
		Если Прочитано > 0 Тогда
			Тело = Тело.Соединить(Буфер);
			ПрочитаноВсего = ПрочитаноВсего + Прочитано;
		КонецЕсли;

		Если Прочитано < РазмерБуфера Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ТелоПоток.Закрыть();

	ЗапросJson = ПолучитьСтрокуИзБуфераДвоичныхДанных(Тело.Прочитать(0, ПрочитаноВсего));
	Попытка
		ДанныеЗапроса = Отчетность24БРОСериализация.JSONВЗначение(ЗапросJson, Ложь);
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки);
		Возврат;
	КонецПопытки;
	
	ВходящийКонтейнер = Неопределено;
	ИмяТипа = "";
	ЭтоОбъект = Ложь;
	ИмяСвойстваКонтейнер = "Контейнер";
	Если ТипЗнч(ДанныеЗапроса) = Тип("Структура") И ДанныеЗапроса.Свойство(ИмяСвойстваКонтейнер, ВходящийКонтейнер) Тогда
		
		Если ТипЗнч(ВходящийКонтейнер) = Тип("Строка") Тогда
			ВходящийКонтейнерХранилище = XMLЗначение(Тип("ХранилищеЗначения"), ВходящийКонтейнер); // ХранилищеЗначения
			Если ВходящийКонтейнерХранилище <> Неопределено Тогда
				КонтейнерJSON = ВходящийКонтейнерХранилище.Получить(); // Строка
				Попытка
					НовыйВходящийКонтейнер = Отчетность24БРОСериализация.JSONВЗначение(
						КонтейнерJSON, Ложь);
				Исключение
					ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					ЗаписьЖурналаРегистрации(
					ИмяСобытияЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Ошибка,,,
					ОписаниеОшибки);
					Возврат;
				КонецПопытки;
				ДанныеЗапроса[ИмяСвойстваКонтейнер] = НовыйВходящийКонтейнер;
			КонецЕсли;
		КонецЕсли;	
		
		ДанныеЗапросаКонтейнер = ДанныеЗапроса[ИмяСвойстваКонтейнер]; // Структура
		Если ТипЗнч(ДанныеЗапросаКонтейнер) = Тип("Структура") И ДанныеЗапросаКонтейнер.Свойство("ИмяТипа", ИмяТипа) Тогда
			ЭтоОбъект = Истина;
		КонецЕсли;
		
	КонецЕсли;

	ИДОтчета = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗапроса, "ИДОтчета", ""); // Строка
	ИДРедакцииОтчета = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗапроса, "ИДРедакцииОтчета", ""); // Строка
	ПараметрыОтчета = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗапроса, "ПараметрыОтчета", Новый Структура); // Структура
	
	// Доступ в разрезе госорганов
	Если ЭтоОбъект Тогда 
		ГосорганОтчета = ИнтеграцияСОтчетность24КлиентСервер.ГосорганПоИмениТипа(ИмяТипа);
	Иначе
		ГосорганОтчета = ГосорганОтчета(ИДОтчета);
	КонецЕсли;
	
	ТранспортныйКонтейнер = НовыйТранспортныйКонтейнер();
	
	ОрганизацияОтчета = Неопределено;
	НачалоПериодаОтчета = Дата(1, 1, 1);
	КонецПериодаОтчета = Дата(1, 1, 1);
	ТекстДополнения = "";
	ИмяСвойстваДанные = "Данные";
	ИмяСвойстваПараметрыОтчета = "ПараметрыОтчета";
	Если ЭтоОбъект Тогда
		Если ИмяТипа = "СправочникОбъект.ФизическиеЛица" Тогда
			ДанныеЗапросаКонтейнер = ДанныеЗапроса[ИмяСвойстваКонтейнер];  // Структура
			ДанныеЗапросаКонтейнерДанные = ДанныеЗапросаКонтейнер[ИмяСвойстваДанные]; // Структура  
			ДанныеЗапросаКонтейнерДанные.Свойство("Организация", ОрганизацияОтчета);
		Иначе
			ДанныеЗапросаКонтейнер = ДанныеЗапроса[ИмяСвойстваКонтейнер];  // Структура
			ДанныеЗапросаКонтейнерДанные = ДанныеЗапросаКонтейнер[ИмяСвойстваДанные]; // Структура  
			ДанныеЗапросаКонтейнерДанные.Свойство("Организация", ОрганизацияОтчета);
			
			ДанныеЗапросаКонтейнерДанные.Свойство("ОтчетныйПериод", НачалоПериодаОтчета);
			ДанныеЗапросаКонтейнерДанные.Свойство("ОкончаниеОтчетногоПериода", КонецПериодаОтчета);
			Если ЗначениеЗаполнено(КонецПериодаОтчета) = Ложь Тогда
				ДанныеЗапросаКонтейнерДанные.Свойство("Дата", КонецПериодаОтчета);
			КонецЕсли;
			ДанныеЗапросаКонтейнерДанные.Свойство("КраткийСоставДокумента", ТекстДополнения);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗапроса) = Тип("Структура") И ДанныеЗапроса.Свойство("ПараметрыОтчета") Тогда
		ДанныеЗапросаПараметрыОтчета = ДанныеЗапроса[ИмяСвойстваПараметрыОтчета]; // Структура
		ДанныеЗапросаПараметрыОтчета.Свойство("Организация", ОрганизацияОтчета);
		
		ДанныеЗапросаПараметрыОтчета.Свойство("мДатаНачалаПериодаОтчета", НачалоПериодаОтчета);
		Если Не ЗначениеЗаполнено(НачалоПериодаОтчета) Тогда
			ДанныеЗапросаПараметрыОтчета.Свойство("ДатаНачалаПериодаОтчета", НачалоПериодаОтчета);
		КонецЕсли;
		
		ДанныеЗапросаПараметрыОтчета.Свойство("мДатаКонцаПериодаОтчета", КонецПериодаОтчета);
		Если Не ЗначениеЗаполнено(КонецПериодаОтчета) Тогда
			ДанныеЗапросаПараметрыОтчета.Свойство("ДатаКонцаПериодаОтчета", КонецПериодаОтчета);
		КонецЕсли;
	КонецЕсли;
	
	СправочныеДанные = (ИмяТипа = "СправочникОбъект.ФизическиеЛица"
		Или ИмяТипа = "СправочникОбъект.БанковскиеСчета");

	Если Не ЗначениеЗаполнено(ОрганизацияОтчета) И Не СправочныеДанные Тогда
		ТранспортныйКонтейнер.ТекстОшибки = НСтр("ru = 'В учетном приложении нет данных для заполнения по этой организации'");
	ИначеЕсли Не ЗначениеЗаполнено(ГосорганОтчета) Тогда
		ТранспортныйКонтейнер.ДоступРазрешен = Истина;
	Иначе
		ТранспортныйКонтейнер.Госорган = ГосорганОтчета;
		Если СтрНайти(НастройкиИнтеграции.Госорганы, ГосорганОтчета) = 0 Тогда
			ТранспортныйКонтейнер.ТекстОшибки= НСтр("ru = 'Доступ к данным заполнения отчета для'") 
				+ СтрШаблон(" %1 запрещен", ГосорганОтчета);
		Иначе
			ТранспортныйКонтейнер.ДоступРазрешен = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Доступ в разрезе организаций
	Если ТранспортныйКонтейнер.ДоступРазрешен Тогда
		Если ЗначениеЗаполнено(ОрганизацияОтчета) Тогда
			НаборОграничениеПередачиДанных = РегистрыСведений.Отчетность24БРООграниченияПоОрганизациям.СоздатьНаборЗаписей();
			НаборОграничениеПередачиДанных.Отбор.Получатель.Установить(ЗаголовкиСообщения.КодОтправителя);
			НаборОграничениеПередачиДанных.Прочитать();
			Если НаборОграничениеПередачиДанных.Количество() > 0 Тогда
				Для Каждого ЗаписьНабора Из НаборОграничениеПередачиДанных Цикл
					Если ЗаписьНабора.Организация = ОрганизацияОтчета Тогда
						ТранспортныйКонтейнер.ДоступРазрешен = Истина;
						Прервать;
					Иначе
						ТранспортныйКонтейнер.ДоступРазрешен = Ложь;
					КонецЕсли;
				КонецЦикла;
				Если ТранспортныйКонтейнер.ДоступРазрешен = Ложь Тогда
					ТранспортныйКонтейнер.ТекстОшибки = НСтр("ru = 'Доступ к данным по организации'") 
						+ СтрШаблон(" %1 запрещен", ОрганизацияОтчета);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ТранспортныйКонтейнер.ИДОтчета = ИДОтчета;
	ТранспортныйКонтейнер.ИДРедакцииОтчета = ИДРедакцииОтчета;
	ТранспортныйКонтейнер.ИмяТипа = ИмяТипа;
	
	ЕстьОтчет = Ложь;
	ЕстьВерсия = Ложь;
	
	Если Не ЭтоОбъект Тогда
		
		ИДРедакцииОтчетаДляЗаполнения = ИДРедакцииОтчета; // Строка
		
		МетаданныеОтчета = Метаданные.Отчеты.Найти(ИДОтчета);
		ЕстьОтчет = МетаданныеОтчета <> Неопределено;
		ЕстьВерсия = Ложь;
		Если МетаданныеОтчета <> Неопределено Тогда
			ЕстьВерсия = МетаданныеОтчета.Формы.Найти(ИДРедакцииОтчета) <> Неопределено;
		КонецЕсли;

		СкорректироватьПараметрыОтчета(ПараметрыОтчета, ИДОтчета, ТранспортныйКонтейнер);
		
		ЕстьОтчет = ЕстьОтчет // проверка наличия отчета в регламентированных
			И ИнтеграцияСОтчетность24ПовтИсп.ЕстьВСправочникеРегламентированных(ИДОтчета);

		Если ЕстьОтчет И Не ЕстьВерсия Тогда
			// Подбор наиболее актуальной формы, если нет запрашиваемой
			ИДРедакцииОтчетаДляЗаполнения = ПодобратьРедакциюОтчета(МетаданныеОтчета, ИДРедакцииОтчета);
			Если ИДРедакцииОтчетаДляЗаполнения <> ИДРедакцииОтчета Тогда
				ТранспортныйКонтейнер.ИДРедакцииОтчета = ИДРедакцииОтчетаДляЗаполнения; 
			КонецЕсли;
		КонецЕсли;
		
		ЕстьОтчет = ЕстьОтчет // проверка заполняемости с учетов периода отчета 
			И РеализованоЗаполнениеНаФорме(ИДОтчета, Строка(ИДРедакцииОтчетаДляЗаполнения), ПараметрыОтчета);
			
	КонецЕсли;
	
	
	Если ТранспортныйКонтейнер.ДоступРазрешен Тогда
		Если НастройкиИнтеграции.ТребоватьПодтверждениеПользователя = Ложь 
			Или (Не ЭтоОбъект И Не ЕстьОтчет) Тогда
			ДобавитьРезультатЗаполненияВТранспортныйКонтейнер(ТранспортныйКонтейнер, ДанныеЗапроса);
		Иначе
			ПараметрыЗапроса = Новый Структура;
			ПараметрыЗапроса.Вставить("Идентификатор", ЗаголовкиСообщения.Идентификатор);
			ПараметрыЗапроса.Вставить("Получатель", ЗаголовкиСообщения.КодПолучателя);
			ПараметрыЗапроса.Вставить("Отправитель", ЗаголовкиСообщения.КодОтправителя);
			ПараметрыЗапроса.Вставить("ИДОтчета", ИДОтчета);
			ПараметрыЗапроса.Вставить("ИДРедакцииОтчета", ИДРедакцииОтчета);
			ПараметрыЗапроса.Вставить("ИмяТипа", ИмяТипа);
			ПараметрыЗапроса.Вставить("ТекстДополнения", ТекстДополнения);
			ПараметрыЗапроса.Вставить("ДатаПолученияЗапроса", ТекущаяДатаСеанса());
			Если ЗначениеЗаполнено(ОрганизацияОтчета) Тогда
				ПараметрыЗапроса.Вставить("Организация", ОрганизацияОтчета);
			КонецЕсли;
			Если ЗначениеЗаполнено(НачалоПериодаОтчета)
				Или ЗначениеЗаполнено(КонецПериодаОтчета) Тогда
				
				Если Не ЗначениеЗаполнено(НачалоПериодаОтчета) Тогда
					НачалоПериодаОтчета = КонецПериодаОтчета; // Дата
				ИначеЕсли Не ЗначениеЗаполнено(КонецПериодаОтчета) Тогда
					КонецПериодаОтчета = НачалоПериодаОтчета;
				ИначеЕсли КонецПериодаОтчета < НачалоПериодаОтчета Тогда
					КонецПериодаОтчета = НачалоПериодаОтчета;  // Дата
				КонецЕсли;
				ПараметрыЗапроса.Вставить("ПериодОтчета", ПредставлениеПериода(
					НачалоДня(НачалоПериодаОтчета),
					КонецДня(КонецПериодаОтчета),
					"Л=ru_RU;ФП=Истина"));
			КонецЕсли;
			ПараметрыЗапроса.Вставить("ТелоЗапроса", ЗапросJson);
			ДобавитьЗапросИнтеграции(ПараметрыЗапроса);
			
			СистемнаяИнформация = Новый СистемнаяИнформация;
			Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии("8.3.26.0", СистемнаяИнформация.ВерсияПриложения) <= 0 Тогда
				//@skip-check module-unused-local-variable - используется в ВыполнитьВБезопасномРежиме
				ИмяУведомления = Отчетность24БРОКлиентСервер.ИмяУведомленияСообщениеИзШиныОтчетности();
				ДанныеСообщения = Новый Структура();
				ДанныеСообщения.Вставить("Идентификатор", ПараметрыЗапроса.Идентификатор);
				
				УстановитьБезопасныйРежим(Истина);
				// АПК:488-выкл Поддержка новых методов платформы (исполняемый код безопасен)
				Выполнить "УведомленияКлиента.ОтправитьУведомление(ИмяУведомления, ДанныеСообщения)"; // Не нарушает безопасность информации, так как вычисляется фиксированная строка, содержащая только вызов метода платформы.
				// АПК:488-вкл
				УстановитьБезопасныйРежим(Ложь);
			КонецЕсли;
	
			Возврат;
		КонецЕсли;
	Иначе
		ТранспортныйКонтейнер.Вставить("ЕстьВерсия");
	КонецЕсли;
	
	ОтправитьТранспортныйКонтейнер(
		ТранспортныйКонтейнер,
		ЗаголовкиСообщения.КодПолучателя,
		ЗаголовкиСообщения.КодОтправителя,
		ЗаголовкиСообщения.Идентификатор);
		
КонецПроцедуры
	
// Заполняет методы под требование безопасности при использовании ВыполнитьВБезопасномРежиме
// 
// Параметры:
//  Методы - Структура - СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ПолучитьСообщенияПоHttp", Истина);
	Методы.Вставить("ОбработатьОтложенныеЗапросы", Истина);
	Методы.Вставить("РегламентноеЗаданиеПолучениеСообщенийИзОтчетность24");
	Методы.Вставить("ИсправлениеРегламентныхЗаданий");
КонецПроцедуры

// Возвращает наличие прав на подтверждение отправки данных в Отчетность.
// 
// Возвращаемое значение:
//  Булево
Функция РазрешеноПодтверждениеОтправкиДанныхОтчетов() Экспорт
	
	Результат = Ложь;

	//@skip-check using-isinrole
	Если РольДоступна(Метаданные.Роли.ПодтверждениеОтправкиДанныхВОтчетность24) 
		Или РольДоступна(Метаданные.Роли.ПолныеПрава) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции
	
// Получить запросы интеграции для формы подтверждения.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение -:
//  * Ключ - Строка
//  * Значение - Массив Из Структура - Массив данных запросов на интеграцию:
//  ** Идентификатор    - Строка
//  ** Получатель       - Строка
//  ** Отправитель      - Строка
//  ** ИДОтчета         - Строка
//  ** ИДРедакцииОтчета - Строка
//  ** ИмяТипа          - Строка
//  ** ИмяПодключения   - Строка
//  ** АдресПолучателя  - Строка
//  ** Организация      - СправочникСсылка.Организации
//  ** ПериодОтчета     - Строка
Функция ПолучитьЗапросыИнтеграцииДляФормыПодтверждения() Экспорт

	Если Не РазрешеноПодтверждениеОтправкиДанныхОтчетов() Тогда
		// у пользователя нет прав на создание и соответственно подтверждение отчетов
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации";
	
	Попытка
		РазрешенныеОрганизации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Исключение
		// у пользователя нет прав на организации
		Возврат Неопределено;
	КонецПопытки;
	
	Если ПривилегированныйРежим() = Ложь Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Результат = Новый Соответствие();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗапросыПодтверждения.Идентификатор КАК Идентификатор,
	|	ЗапросыПодтверждения.Получатель КАК Получатель,
	|	ЗапросыПодтверждения.Отправитель КАК Отправитель,
	|	ЗапросыПодтверждения.ИДОтчета КАК ИДОтчета,
	|	ЗапросыПодтверждения.ИДРедакцииОтчета КАК ИДРедакцииОтчета,
	|	ЗапросыПодтверждения.ИмяТипа КАК ИмяТипа,
	|	Отчетность24Подключения.Имя КАК ИмяПодключения,
	|	Отчетность24Подключения.АдресПолучателя КАК АдресПолучателя,
	|	ЗапросыПодтверждения.Организация КАК Организация,
	|	ЗапросыПодтверждения.ПериодОтчета КАК ПериодОтчета,
	|	ЕСТЬNULL(НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.Пользователь, ""ВсеПользователи"") КАК Пользователь
	|ИЗ
	|	РегистрСведений.Отчетность24БРОЗапросы КАК ЗапросыПодтверждения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Отчетность24БРОПодключения КАК
	|			Отчетность24Подключения
	|		ПО ЗапросыПодтверждения.Отправитель = Отчетность24Подключения.Получатель
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Отчетность24БРОНастройкиПодтверждения КАК
	|			НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность
	|		ПО ЗапросыПодтверждения.Отправитель = НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.Получатель
	|		И НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.РазрешеноПодтверждениеОтправки
	|ГДЕ
	|	ЗапросыПодтверждения.Подтверждено = ЛОЖЬ
	|	И ЗапросыПодтверждения.Отклонено = ЛОЖЬ
	|	И ( ЗапросыПодтверждения.Организация В (&РазрешенныеОрганизации)
	|	ИЛИ ЗапросыПодтверждения.Организация = Значение(Справочник.Организации.ПустаяСсылка))
	|ИТОГИ
	|ПО
	|	Пользователь";
	
	Запрос.УстановитьПараметр("РазрешенныеОрганизации", РазрешенныеОрганизации);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда  
		МассивКолонок = Новый Массив; // Массив Из Строка
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			МассивКолонок.Добавить(Колонка.Имя);
		КонецЦикла; 
		СписокКолонок = СтрСоединить(МассивКолонок, ",");
		
		ИмяКолонкиПользователь = "Пользователь";
		
		ВыборкаПользователь = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПользователь.Следующий() Цикл   
			МассивЗапросов = Новый Массив; // Массив Из Структура
			Выборка = ВыборкаПользователь.Выбрать(); 
			Пока Выборка.Следующий() Цикл
				ОтложенныйЗапрос = Новый Структура(СписокКолонок);
				ЗаполнитьЗначенияСвойств(ОтложенныйЗапрос, Выборка);
				МассивЗапросов.Добавить(ОтложенныйЗапрос);
			КонецЦикла;
			Если МассивЗапросов.Количество() > 0 Тогда
				Результат.Вставить(ВыборкаПользователь[ИмяКолонкиПользователь], МассивЗапросов);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  
	
	Возврат Результат;
	
КонецФункции

// Выполняет получение сообщения по http.
// 
// Параметры:
//  ОписаниеОшибки - Строка - Описание ошибки
//  ПовторАвторизации - Булево - Повтор авторизации
// 
// Возвращаемое значение:
//  Булево
Функция ПолучитьСообщенияПоHttp(ОписаниеОшибки = "", ПовторАвторизации = Ложь) Экспорт

	Результат = Ложь; // Булево

	Если ПривилегированныйРежим() = Ложь Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Если Не ИнтеграцияСОтчетность24ВызовСервера.ЕстьНастроенныеИнтеграции() Тогда
		Возврат Ложь;
	КонецЕсли;

	АдресаШины = АдресаШины();
	Соединение = УстановитьСоединениеССерверомИнтернета(АдресаШины.Сервер, ОписаниеОшибки);

	Если Соединение <> Неопределено Тогда

		ПараметрыАвторизации = ПолучитьПараметрыАвторизации(Соединение, ПовторАвторизации);
		Если Не ЗначениеЗаполнено(ПараметрыАвторизации.Токен) Тогда
			ОписаниеОшибки = НСтр("ru='Не удалось авторизоваться в сервисе 1С-Отчетность'");
			Возврат Результат;
		КонецЕсли;

		ЗапросHttp = Новый HTTPЗапрос;
		ЗапросHttp.АдресРесурса = АдресаШины.ПолучитьСообщение;
		ЗапросHttp.Заголовки.Вставить(НРег("TicketITS"), ПараметрыАвторизации.ТикетИТС);
		ЗапросHttp.Заголовки.Вставить(НРег("TicketControl"), КонтрольнаяСуммаТикетаИТС(ПараметрыАвторизации.ТикетИТС));
		ЗапросHttp.Заголовки.Вставить(НРег("Authorization"), "Bearer " + ПараметрыАвторизации.Токен);
		ЗапросHttp.Заголовки.Вставить(НРег("MessageLifeTime"), 400);

		Попытка
				//@skip-check bsl-legacy-check-dynamic-feature-access
			Ответ = Соединение.ВызватьHTTPМетод("GET", ЗапросHttp); // HTTPОтвет
		Исключение
			ОписаниеОшибки = НСтр("ru='Не удалось получить сообщение в сервисе 1С-Отчетность'")
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
		КонецПопытки;

		Если Ответ.КодСостояния = 200 Тогда

			RecipientCode = ЗначениеЗаголовкаHTTP(Ответ.Заголовки, "RecipientCode");
			SenderCode = ЗначениеЗаголовкаHTTP(Ответ.Заголовки, "SenderCode");
			MessageId = ЗначениеЗаголовкаHTTP(Ответ.Заголовки, "MessageId");

			ЗаголовкиСообщения = ЗаголовкиСообщения(RecipientCode, SenderCode, MessageId);
			Если ЗначениеЗаполнено(ЗаголовкиСообщения.Идентификатор) Тогда
				ОбработатьПолученноеСообщение(ЗаголовкиСообщения, Ответ.ПолучитьТелоКакПоток());
				ПолучитьСообщенияПоHttp(ОписаниеОшибки); // цикл получения всех сообщений из очереди
				Результат = Истина;
			КонецЕсли;

		ИначеЕсли (Ответ.КодСостояния = 500 Или Ответ.КодСостояния = 401) И Не ПовторАвторизации Тогда
			Результат = ПолучитьСообщенияПоHttp(ОписаниеОшибки, Истина); // Булево
		Иначе
			ЗаписатьОшибкуСервераВЖурналРегистрации(Ответ);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Отправить транспортный контейнер.
// 
// Параметры:
//  ТранспортныйКонтейнер - Структура:
// * Госорган               - Строка - 
// * ДоступРазрешен         - Булево  
// * ТекстОшибки            - Строка
// * ВерсияБРО              - Строка
// * КонфигурацияИмя        - Строка
// * КонфигурацияВерсия     - Строка
// * ИДОтчета               - Строка - 
// * ИДРедакцииОтчета       - Строка - 
// * ИмяТипа                - Строка - 
// * ЕстьВерсия             - Булево
// * ВерсияЗаполненияДанных - Строка
//  КодОтправителя                - Строка 
//  КодПолучателя                 - Строка 
//  ИдентификаторСообщенияЗапроса - Строка 
Процедура ОтправитьТранспортныйКонтейнер(ТранспортныйКонтейнер, КодОтправителя, КодПолучателя, ИдентификаторСообщенияЗапроса) Экспорт
	
	РезультатJson = Отчетность24БРОСериализация.ЗначениеВJSON(ТранспортныйКонтейнер);
	
	РезультатДвоичный = ПолучитьДвоичныеДанныеИзСтроки(РезультатJson);

	АдресаШины = АдресаШины();
	ОписаниеОшибки = "";
	Соединение = УстановитьСоединениеССерверомИнтернета(АдресаШины.Сервер, ОписаниеОшибки);

	Если Соединение <> Неопределено Тогда
		ПараметрыАвторизации = ПолучитьПараметрыАвторизации(Соединение);

		Если Не ЗначениеЗаполнено(ПараметрыАвторизации.Токен) Тогда
			Возврат;
		КонецЕсли;

		Для СчетчикЦикла = 1 По 2 Цикл
			ЗапросHttp = Новый HTTPЗапрос;
			ЗапросHttp.АдресРесурса = АдресаШины.Ответ;
			ЗапросHttp.Заголовки.Вставить(НРег("TicketITS"), ПараметрыАвторизации.ТикетИТС);
			ЗапросHttp.Заголовки.Вставить(НРег("TicketControl"), КонтрольнаяСуммаТикетаИТС(
				ПараметрыАвторизации.ТикетИТС));
			ЗапросHttp.Заголовки.Вставить(НРег("Participant-Sender-Code"), КодОтправителя);
			ЗапросHttp.Заголовки.Вставить(НРег("Participant-Receiver-Codes"), КодПолучателя);
			ЗапросHttp.Заголовки.Вставить(НРег("CorrelationId"), ИдентификаторСообщенияЗапроса);
			ЗапросHttp.Заголовки.Вставить(НРег("Authorization"), "Bearer " + ПараметрыАвторизации.Токен);

			ЗапросHttp.Заголовки.Вставить(НРег("ReportName"), КодироватьСтроку(ТранспортныйКонтейнер.ИДОтчета,
				СпособКодированияСтроки.КодировкаURL));
			ЗапросHttp.Заголовки.Вставить(НРег("ConfigName"), КодироватьСтроку(Метаданные.Имя,
				СпособКодированияСтроки.КодировкаURL));
			ЗапросHttp.Заголовки.Вставить(НРег("ConfigSynonym"), КодироватьСтроку(Метаданные.Синоним,
				СпособКодированияСтроки.КодировкаURL));
			ЗапросHttp.Заголовки.Вставить(НРег("ConfigVersion"), КодироватьСтроку(Метаданные.Версия,
				СпособКодированияСтроки.КодировкаURL));
			ЗапросHttp.Заголовки.Вставить(НРег("ReportForm"), КодироватьСтроку(ТранспортныйКонтейнер.ИДРедакцииОтчета,
				СпособКодированияСтроки.КодировкаURL));
			ЗапросHttp.Заголовки.Вставить(НРег("TypeName"), КодироватьСтроку(ТранспортныйКонтейнер.ИмяТипа,
				СпособКодированияСтроки.КодировкаURL));
				
			Если ЗначениеЗаполнено(ТранспортныйКонтейнер.ИмяТипа) Тогда
				ЗапросHttp.Заголовки.Вставить(НРег("SubsystemName"), КодироватьСтроку("БЗК",
					СпособКодированияСтроки.КодировкаURL));
				ЗапросHttp.Заголовки.Вставить(НРег("SubsystemVersion"), Отчетность24БРО.ВерсияБЗК());
			Иначе
				ЗапросHttp.Заголовки.Вставить(НРег("SubsystemName"), КодироватьСтроку("БРО",
					СпособКодированияСтроки.КодировкаURL));
				ЗапросHttp.Заголовки.Вставить(НРег("SubsystemVersion"), Отчетность24БРО.ВерсияБРО());
			КонецЕсли;
				
			ЗапросHttp.Заголовки.Вставить(НРег("EqualVersion"), XMLСтрока(ТранспортныйКонтейнер.ЕстьВерсия));
			Если ТранспортныйКонтейнер.Свойство("ВерсияЗаполненияДанных") Тогда
				ЗапросHttp.Заголовки.Вставить(НРег("DataVersion"), КодироватьСтроку(
					ТранспортныйКонтейнер.ВерсияЗаполненияДанных, СпособКодированияСтроки.КодировкаURL));
			КонецЕсли;

			ЗапросHttp.УстановитьТелоИзДвоичныхДанных(РезультатДвоичный);

			Попытка
				Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросHttp);
			Исключение
				ОписаниеОшибки = НСтр("ru='Не удалось получить сообщение в сервисе 1С-Отчетность'");
				Возврат;
			КонецПопытки;

			Если Ответ.КодСостояния = 200 Тогда
					
					// отправка уведомление в отчетность для получения сообщений из шины
				КлючМаршрутизации = "db." + ВРег(Сред(КодПолучателя, 3));
				СообщениеНаШинуУведомления = Отчетность24БРОШинаСлужебный.НовоеСообщениеДляОтправки(КлючМаршрутизации);
				Отчетность24БРОШинаУведомления.ОтправитьСообщение(СообщениеНаШинуУведомления);

				Прервать;
			ИначеЕсли (Ответ.КодСостояния = 500 Или Ответ.КодСостояния = 401) И СчетчикЦикла = 1 Тогда
					// Возможно токен закончился в процессе выполнения (или изменился срок жизни токена в шине)
				ПараметрыАвторизации = ПолучитьПараметрыАвторизации(Соединение, Истина);
				Если Не ЗначениеЗаполнено(ПараметрыАвторизации.Токен) Тогда
					Возврат;
				КонецЕсли;
			Иначе
				ЗаписатьОшибкуСервераВЖурналРегистрации(Ответ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Добавить результат заполнения в транспортный контейнер.
// 
// Параметры:
//  ТранспортныйКонтейнер - см. НовыйТранспортныйКонтейнер() 
//  ДанныеЗапроса - Структура -
Процедура ДобавитьРезультатЗаполненияВТранспортныйКонтейнер(ТранспортныйКонтейнер, ДанныеЗапроса) Экспорт

	Объект = Неопределено;
	ЕстьОтчет = Ложь;
	ЕстьВерсия = Ложь;
	
	Контейнер = Неопределено;
	Если ДанныеЗапроса.Свойство("Контейнер", Контейнер) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТипа = ""; 
	Если ТипЗнч(Контейнер) = Тип("Структура") Тогда
		Контейнер.Свойство("ИмяТипа", ИмяТипа);
	КонецЕсли;
	
	ИДОтчета = "";
	ИДРедакцииОтчета = "";
	ПараметрыОтчета = Новый Структура;
	
	ЭтоЗапросОтчета = Не ЗначениеЗаполнено(ИмяТипа); 
	
	Если ЭтоЗапросОтчета Тогда

		Если (ДанныеЗапроса.Свойство("ИДОтчета", ИДОтчета) = Ложь 
			Или ДанныеЗапроса.Свойство("ИДРедакцииОтчета", ИДРедакцииОтчета) = Ложь 
			Или ДанныеЗапроса.Свойство("ПараметрыОтчета", ПараметрыОтчета) = Ложь) Тогда
			// неверный формат параметров запроса
			Возврат;
		КонецЕсли;
		
		ИДРедакцииОтчетаДляЗаполнения = ИДРедакцииОтчета; // Строка
		
		МетаданныеОтчета = Метаданные.Отчеты.Найти(ИДОтчета);
		ЕстьОтчет = МетаданныеОтчета <> Неопределено;
		ЕстьВерсия = Ложь;
		Если МетаданныеОтчета <> Неопределено Тогда
			ЕстьВерсия = МетаданныеОтчета.Формы.Найти(ИДРедакцииОтчета) <> Неопределено;
		КонецЕсли;

		СкорректироватьПараметрыОтчета(ПараметрыОтчета, ИДОтчета, Контейнер);
		
		ЕстьОтчет = ЕстьОтчет // проверка наличия отчета в регламентированных
			И ИнтеграцияСОтчетность24ПовтИсп.ЕстьВСправочникеРегламентированных(ИДОтчета);

		Если ЕстьОтчет И Не ЕстьВерсия Тогда
			// Подбор наиболее актуальной формы, если нет запрашиваемой
			ИДРедакцииОтчетаДляЗаполнения = ПодобратьРедакциюОтчета(МетаданныеОтчета, ИДРедакцииОтчета);
		КонецЕсли;

		ТранспортныйКонтейнер.ИДОтчета = ИДОтчета;
		ТранспортныйКонтейнер.ИмяТипа = ИмяТипа;
		ТранспортныйКонтейнер.ИДРедакцииОтчета = ИДРедакцииОтчетаДляЗаполнения;
		
		ЕстьОтчет = ЕстьОтчет // проверка заполняемости с учетов периода отчета 
			И РеализованоЗаполнениеНаФорме(ИДОтчета, Строка(ИДРедакцииОтчетаДляЗаполнения), ПараметрыОтчета);
		
		Если ЕстьОтчет Тогда
			
			КонтейнерКонтрольнаяСуммаДо = ОбщегоНазначения.КонтрольнаяСуммаСтрокой(
				Отчетность24БРОСериализация.ЗначениеВJSON(Контейнер));
			
			Попытка
				//@skip-check invocation-parameter-type-intersect
				РегламентированнаяОтчетностьПереопределяемый.ЗаполнитьОтчет(
				ИДОтчета, 
				ИДРедакцииОтчетаДляЗаполнения, 
				ПараметрыОтчета, 
				Контейнер);

				КонтейнерКонтрольнаяСуммаПосле = ОбщегоНазначения.КонтрольнаяСуммаСтрокой(
					Отчетность24БРОСериализация.ЗначениеВJSON(Контейнер));
				
				Если КонтейнерКонтрольнаяСуммаДо = КонтейнерКонтрольнаяСуммаПосле Тогда
					КлючСвойства = "ТекстСообщения";
					Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
						ТранспортныйКонтейнер.Вставить(КлючСвойства);
					КонецЕсли;

					ТранспортныйКонтейнер[КлючСвойства] =
					НСтр("ru='Нет данных для заполнения отчета или учетное приложение
					|не поддерживает заполнение и передачу отчета в 1С:Отчетность 24'");
				КонецЕсли;

			Исключение

				КлючСвойства = "ТекстОшибки";
				Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
					ТранспортныйКонтейнер.Вставить(КлючСвойства);
				КонецЕсли;
				
				Если ИДРедакцииОтчетаДляЗаполнения = ИДРедакцииОтчета Тогда
					ТранспортныйКонтейнер.ТекстОшибки = 
						НСтр("ru='Произошла ошибка при формировании данных отчета в учетном приложении'");
				Иначе
					ТранспортныйКонтейнер.ТекстОшибки = 
						НСтр("ru='В учетном приложении не поддерживается заполнение
						|данной редакции отчета.'");
					ТранспортныйКонтейнер.ТекстРекомендаций = 
						НСтр("ru='Возможно, необходимо обновить конфигурацию учетного приложения.'");
				КонецЕсли;

				КлючСвойства = "ПодробноеПредставлениеОшибки";
				Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
					ТранспортныйКонтейнер.Вставить(КлючСвойства);
				КонецЕсли;
				ТранспортныйКонтейнер.ПодробноеПредставлениеОшибки = 
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					
				ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,,,
					ТранспортныйКонтейнер.ПодробноеПредставлениеОшибки);
					
			КонецПопытки;
		Иначе
			КлючСвойства = "ТекстОшибки";
			Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
				ТранспортныйКонтейнер.Вставить(КлючСвойства);
			КонецЕсли;
			
			ТранспортныйКонтейнер.ТекстОшибки = 
			НСтр("ru='В учетном приложении не предусмотрено заполнение данного отчета'");
		КонецЕсли;
		
		Если СтрНачинаетсяС(ИДОтчета, "РегламентированныйОтчетАлко") Тогда
			КлючСвойства = "ДокументСсылка";
			ПараметрыОтчета[КлючСвойства] = Неопределено;
		КонецЕсли;
			
		КлючСвойства = "ВерсияЗаполненияДанных";
		Если ПараметрыОтчета.Свойство(КлючСвойства) Тогда
			ТранспортныйКонтейнер.Вставить("ВерсияЗаполненияДанных", ПараметрыОтчета[КлючСвойства]);
		КонецЕсли; 
			
		КлючСвойства = "АдресВоВременномХранилище";
		Если ПараметрыОтчета.Свойство(КлючСвойства) Тогда
			Результат = ПолучитьИзВременногоХранилища(Строка(ПараметрыОтчета[КлючСвойства]));
		КонецЕсли;
		Если Результат = Неопределено Тогда
			Результат = Контейнер;	
		КонецЕсли;    
	Иначе
		
		ТранспортныйКонтейнер.ИмяТипа = ИмяТипа;
		
		Результат = Неопределено;

		СтандартнаяОбработка = Истина;
		ОшибкаПереопределения = Ложь;
		Попытка
			ИнтеграцияСОтчетность24Переопределяемый.ПриФормированииДанныхОбъекта(
				ИмяТипа, ДанныеЗапроса, Результат, СтандартнаяОбработка);
		Исключение
			СтандартнаяОбработка = Ложь;
			ОшибкаПереопределения = Истина;
			Результат = Неопределено;

			КлючСвойства = "ТекстОшибки";
			Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
				ТранспортныйКонтейнер.Вставить(КлючСвойства);
			КонецЕсли;
			ТранспортныйКонтейнер.ТекстОшибки = НСтр(
				"ru='Произошла ошибка подготовки данных в учетном приложении'");

			ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		// Переопределяемый модуль может вернуть только Структуру или Массив: они сериализуются в JSON.
		Если Результат <> Неопределено И ТипЗнч(Результат) <> Тип("Структура")
			И ТипЗнч(Результат) <> Тип("Массив") Тогда

			ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон(НСтр(
					"ru='Для типа %1 переопределяемый модуль вернул данные неподдерживаемого вида %2'"),
					ИмяТипа, Строка(ТипЗнч(Результат))));

			Результат = Неопределено;
		КонецЕсли;

		Если Не СтандартнаяОбработка И Не ОшибкаПереопределения Тогда
			Если Результат = Неопределено Тогда
				КлючСвойства = "ТекстОшибки";
				Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
					ТранспортныйКонтейнер.Вставить(КлючСвойства);
				КонецЕсли;
				ТранспортныйКонтейнер.ТекстОшибки = НСтр(
					"ru='Учетное приложение отключило стандартное заполнение, но не вернуло данные'");

				ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
					СтрШаблон(НСтр(
						"ru='Для типа %1 переопределяемый модуль отключил стандартную обработку и не вернул данные ответа'"),
						ИмяТипа));
			КонецЕсли;
		КонецЕсли;

		МенеджерОбъекта = Неопределено;
		МетаданныеОбъекта = Неопределено;
		ЧастиИмени = СтрРазделить(ИмяТипа, ".");
		Если СтандартнаяОбработка И ЧастиИмени.Количество() > 1 Тогда
			Если ЧастиИмени[0] = "ДокументОбъект" Тогда
				МетаданныеОбъекта = Метаданные.Документы.Найти(ЧастиИмени[1]);
				ЕстьОтчет = МетаданныеОбъекта <> Неопределено;
				ЕстьВерсия = ЕстьОтчет;

				Если ЕстьОтчет Тогда
					МенеджерОбъекта = Документы[ЧастиИмени[1]];
					Попытка
						Объект = МенеджерОбъекта.СоздатьДокумент();
					Исключение
						МенеджерОбъекта = Неопределено;
						ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
							ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
				КонецЕсли;
			ИначеЕсли ЧастиИмени[0] = "СправочникОбъект" Тогда
				МетаданныеОбъекта = Метаданные.Справочники.Найти(ЧастиИмени[1]);
				ЕстьОтчет = МетаданныеОбъекта <> Неопределено;
				ЕстьВерсия = ЕстьОтчет;

				Если ЕстьОтчет Тогда
					МенеджерОбъекта = Справочники[ЧастиИмени[1]];
					Попытка
						//@skip-check statement-type-change
						Объект = МенеджерОбъекта.СоздатьЭлемент();
					Исключение
						МенеджерОбъекта = Неопределено;
						ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
							ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Если МенеджерОбъекта <> Неопределено Тогда

			КонтейнерДанные = Неопределено;
			Если ТипЗнч(Контейнер) = Тип("Структура") Тогда
				Контейнер.Свойство("Данные", КонтейнерДанные);
			КонецЕсли;

			ИмяРеквизитаОрганизация = "Организация";
			ОбязательныеРеквизитыЗаполнены = ТипЗнч(КонтейнерДанные) = Тип("Структура");

			Если Не ОбязательныеРеквизитыЗаполнены Тогда

				КлючСвойства = "ТекстОшибки";
				Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
					ТранспортныйКонтейнер.Вставить(КлючСвойства);
				КонецЕсли;

				ТранспортныйКонтейнер.ТекстОшибки =
					НСтр("ru='Данные для заполнения не переданы в учетное приложение'");

			Иначе
				Попытка
					ЗагрузитьКонтейнерВОбъект(Объект, КонтейнерДанные);
				Исключение
					ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

					КлючСвойства = "ТекстОшибки";
					Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
						ТранспортныйКонтейнер.Вставить(КлючСвойства);
					КонецЕсли;
					ТранспортныйКонтейнер.ТекстОшибки = НСтр(
						"ru='Данные для заполнения имеют неверный формат'");

					КлючСвойства = "ПодробноеПредставлениеОшибки";
					Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
						ТранспортныйКонтейнер.Вставить(КлючСвойства);
					КонецЕсли;
					ТранспортныйКонтейнер.ПодробноеПредставлениеОшибки = СтрШаблон(НСтр(
						"ru='Для типа %1 - ошибка загрузки данных запроса'") + Символы.ПС + "%2", ИмяТипа,
						ПредставлениеОшибки);

					ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
						ТранспортныйКонтейнер.ПодробноеПредставлениеОшибки);

					ОбязательныеРеквизитыЗаполнены = Ложь;
				КонецПопытки;
			КонецЕсли;

			Если ОбязательныеРеквизитыЗаполнены
				И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизитаОрганизация) Тогда
				Если Не ЗначениеЗаполнено(Объект[ИмяРеквизитаОрганизация]) Тогда

					КлючСвойства = "ТекстОшибки";
					Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
						ТранспортныйКонтейнер.Вставить(КлючСвойства);
					КонецЕсли;

					ТранспортныйКонтейнер.ТекстОшибки =
						НСтр("ru='Организация, по которой запрашиваются данные, отсутствует в учетном приложении'");

					ОбязательныеРеквизитыЗаполнены = Ложь;
				КонецЕсли;
			КонецЕсли;

			Если ОбязательныеРеквизитыЗаполнены И Не ЗаполнениеДокументовПоддерживается() Тогда

				КлючСвойства = "ТекстОшибки";
				Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
					ТранспортныйКонтейнер.Вставить(КлючСвойства);
				КонецЕсли;

				ПредставлениеОбъекта = ?(ЗначениеЗаполнено(МетаданныеОбъекта.Синоним),
					МетаданныеОбъекта.Синоним, МетаданныеОбъекта.Имя);

				ТранспортныйКонтейнер.ТекстОшибки = СтрШаблон(НСтр(
					"ru='Учетное приложение не поддерживает программное заполнение документа ""%1"", обновите версию учетного приложения'"),
					ПредставлениеОбъекта);

				ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение, , ,
					ТранспортныйКонтейнер.ТекстОшибки);

				ОбязательныеРеквизитыЗаполнены = Ложь;
			КонецЕсли;

			Если ОбязательныеРеквизитыЗаполнены Тогда
				ПараметрыЗаполнения = Неопределено;
				Если ДанныеЗапроса.Свойство("ПараметрыОтчета", ПараметрыОтчета)
					И ТипЗнч(ПараметрыОтчета) = Тип("Структура") Тогда
					ПараметрыОтчета.Свойство("ПараметрыЗаполнения", ПараметрыЗаполнения);
				КонецЕсли;

				Если ПараметрыЗаполнения = Неопределено Тогда
					ПараметрыЗаполнения = Новый Структура;
					ПараметрыЗаполнения.Вставить("Действие", "ЗаполнитьПоПараметрамЗаполнения");
				КонецЕсли;

				Попытка
					//@skip-check dynamic-access-method-not-found
					МенеджерОбъекта.ЗаполнитьДокументПоПараметрам(Объект, ПараметрыЗаполнения);
				Исключение
					ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

					КлючСвойства = "ТекстОшибки";
					Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
						ТранспортныйКонтейнер.Вставить(КлючСвойства);
					КонецЕсли;

					ТранспортныйКонтейнер.ТекстОшибки = НСтр(
						"ru='Произошла ошибка заполнения в учетном приложении'");

					КлючСвойства = "ПодробноеПредставлениеОшибки";
					Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
						ТранспортныйКонтейнер.Вставить(КлючСвойства);
					КонецЕсли;
					ТранспортныйКонтейнер.ПодробноеПредставлениеОшибки = СтрШаблон(НСтр(
						"ru='Для типа %1 - ошибка заполнения документа'") + Символы.ПС + "%2", ИмяТипа,
						ПредставлениеОшибки);

					ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
						ТранспортныйКонтейнер.ПодробноеПредставлениеОшибки);

					ОбязательныеРеквизитыЗаполнены = Ложь;
				КонецПопытки;

				Если ОбязательныеРеквизитыЗаполнены Тогда

					ВерсияЗаполненияДанных = "";
					Попытка
						//@skip-check dynamic-access-method-not-found
						ВерсияЗаполненияДанных = МенеджерОбъекта.ВерсияЗаполненияДанных();
					Исключение
						ЗаписьЖурналаРегистрации(
							ИмяСобытияЖурналаРегистрации(),
							УровеньЖурналаРегистрации.Информация, , ,
							СтрШаблон(НСтр(
								"ru='Для типа %1 не реализован метод ""ВерсияЗаполненияДанных"" в менеджере объекта'"),
								ИмяТипа));
					КонецПопытки;

					ТранспортныйКонтейнер.Вставить("ВерсияЗаполненияДанных", ВерсияЗаполненияДанных);

					Попытка
						Результат = ПолучитьКонтейнерОтветаПоОбъекту(Объект);
					Исключение
						ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

						КлючСвойства = "ТекстОшибки";
						Если Не ТранспортныйКонтейнер.Свойство(КлючСвойства) Тогда
							ТранспортныйКонтейнер.Вставить(КлючСвойства);
						КонецЕсли;
						ТранспортныйКонтейнер.ТекстОшибки = НСтр(
							"ru='Не удалось подготовить данные ответа в учетном приложении'");

						ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
							ПредставлениеОшибки);

						Результат = Неопределено;
					КонецПопытки;
				КонецЕсли;
			Иначе
				Результат = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ТранспортныйКонтейнер.Вставить("ЕстьОтчет", ЕстьОтчет);
	ТранспортныйКонтейнер.Вставить("ЕстьВерсия", ЕстьВерсия);

	// Дозагрузка данных сотрудников по флагу из приложения-приёмника:
	// вместе с результатом заполнения отчета/документа в ответ вкладывается массив данных сотрудников.
	ПараметрыЗаполненияЗапроса = Неопределено;
	ПараметрыОтчетаЗапроса = Неопределено;
	Если ДанныеЗапроса.Свойство("ПараметрыОтчета", ПараметрыОтчетаЗапроса)
		И ТипЗнч(ПараметрыОтчетаЗапроса) = Тип("Структура") Тогда
		ПараметрыОтчетаЗапроса.Свойство("ПараметрыЗаполнения", ПараметрыЗаполненияЗапроса);
	КонецЕсли;

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Объект <> Неопределено Тогда
			РеквизитыФормыПоСотрудникам = Неопределено;
			ДополнительныеСвойства = Объект.ДополнительныеСвойства;
			Если ДополнительныеСвойства.Свойство("РеквизитыФормыПоСотрудникам", РеквизитыФормыПоСотрудникам)
				И РеквизитыФормыПоСотрудникам <> Неопределено Тогда
				Результат.Вставить("РеквизитыФормыПоСотрудникам", РеквизитыФормыПоСотрудникам);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ТранспортныйКонтейнер.Вставить("КонфигурацияИмя", 
		Строка(УдалитьВерсиюИзНаименованияКонфигурации(ИнтернетПоддержкаПользователей.СинонимКонфигурации())));
	ТранспортныйКонтейнер.Вставить("КонфигурацияВерсия", ИнтернетПоддержкаПользователей.ВерсияКонфигурации());
	ТранспортныйКонтейнер.Вставить("ВерсияБРО", Отчетность24БРО.ВерсияБРО());
	
	РезультатJSON = Отчетность24БРОСериализация.ЗначениеВJSON(Результат);
	РезультатУпакованный = XMLСтрока(Новый ХранилищеЗначения(РезультатJSON, Новый СжатиеДанных(9)));
	ТранспортныйКонтейнер.Вставить("РезультатЗаполнения", РезультатУпакованный);

КонецПроцедуры

// Возвращает заготовку данных сотрудника для ответа по справочнику физических лиц.
// Заполняется в ИнтеграцияСОтчетность24Переопределяемый.ПриФормированииДанныхОбъекта.
//
// Возвращаемое значение:
//  Структура - данные одного сотрудника, поля описаны ниже
Функция НовыеДанныеСотрудника() Экспорт

	Результат = Новый Структура;

	Результат.Вставить("СотрудникGUID", "");
	Результат.Вставить("СотрудникНаименование", "");
	Результат.Вставить("ИсточникGUID", "");

	Результат.Вставить("Фамилия", "");
	Результат.Вставить("Имя", "");
	Результат.Вставить("Отчество", "");
	Результат.Вставить("ФамилияЛатиницей", "");
	Результат.Вставить("ИмяЛатиницей", "");
	Результат.Вставить("ДатаРождения", Дата(1, 1, 1));
	Результат.Вставить("Пол", "");
	Результат.Вставить("СНИЛС", "");
	Результат.Вставить("ИНН", "");

	Результат.Вставить("ДатаПриема", Дата(1, 1, 1));
	Результат.Вставить("ДатаУвольнения", Дата(1, 1, 1));
	Результат.Вставить("ОформленПоТрудовомуДоговору", Ложь);
	Результат.Вставить("ОсновноеРабочееМестоВОрганизации", Ложь);
	Результат.Вставить("Период", Дата(1, 1, 1));
	Результат.Вставить("ДолжностьНаименование", "");
	Результат.Вставить("ПодразделениеНаименование", "");

	Результат.Вставить("ГоловнаяОрганизацияGUID", "");
	Результат.Вставить("ГоловнаяОрганизацияИНН", "");
	Результат.Вставить("ГоловнаяОрганизацияКПП", "");
	Результат.Вставить("ТекущаяОрганизацияGUID", "");

	Результат.Вставить("Документы", Новый Массив); // см. НовыйДокументФизическогоЛица

	Возврат Результат;

КонецФункции

