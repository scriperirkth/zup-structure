// Процедура выполняет заполнение шкалы оценки в характеристиках
Процедура ЗаполнитьШкалуОценкиВХарактеристиках(ПараметрыОбновления = Неопределено) Экспорт
	
	ОбновлениеВыполнено = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияХарактеристикПерсонала.Владелец КАК Характеристика,
		|	ЗначенияХарактеристикПерсонала.Наименование КАК Значение,
		|	ЗначенияХарактеристикПерсонала.Ссылка КАК Ссылка,
		|	ЗначенияХарактеристикПерсонала.РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания
		|ИЗ
		|	Справочник.ЗначенияХарактеристикПерсонала КАК ЗначенияХарактеристикПерсонала
		|ГДЕ
		|	ЗначенияХарактеристикПерсонала.Владелец.ШкалаЗначений = ЗНАЧЕНИЕ(Справочник.ШкалыЗначенийХарактеристикПерсонала.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗначенияХарактеристикПерсонала.РеквизитДопУпорядочивания
		|ИТОГИ ПО
		|	Характеристика";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СоответствиеЗначенийШкале = Новый Соответствие;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ОбновлениеВыполнено = Ложь;
		ВыборкаХарактеристики = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаХарактеристики.Следующий() Цикл
			
			Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(
				ПараметрыОбновления, "ПланВидовХарактеристик.ХарактеристикиПерсонала", "Ссылка", ВыборкаХарактеристики.Характеристика) Тогда
				Продолжить;
			КонецЕсли;
			
			КлючШкалы = "";
			МассивЗначений = Новый Массив;
			ВыборкаЗначения = ВыборкаХарактеристики.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗначения.Следующий() Цикл
				МассивЗначений.Добавить(ВыборкаЗначения.Ссылка);
				ЗначениеШкалы = НРег(СокрЛП(ВыборкаЗначения.Значение)) + ВыборкаЗначения.РеквизитДопУпорядочивания;
				Если Не ЗначениеЗаполнено(КлючШкалы) Тогда
					КлючШкалы = ЗначениеШкалы;
				Иначе
					КлючШкалы = КлючШкалы + Символ(333) + ЗначениеШкалы;
				КонецЕсли;
			КонецЦикла;
			
			Характеристики = СоответствиеЗначенийШкале.Получить(КлючШкалы);
			Если Характеристики = Неопределено Тогда
				ЗначенияХарактеристик = Новый Структура;
				ЗначенияХарактеристик.Вставить("МассивЗначений", МассивЗначений);
				ЗначенияХарактеристик.Вставить("МассивХарактеристик",
					ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыборкаХарактеристики.Характеристика));
				СоответствиеЗначенийШкале.Вставить(КлючШкалы, ЗначенияХарактеристик);
			Иначе
				МассивХарактеристик = Характеристики.МассивХарактеристик;
				МассивХарактеристик.Добавить(ВыборкаХарактеристики.Характеристика);
				Характеристики.Вставить("МассивХарактеристик", МассивХарактеристик);
				СоответствиеЗначенийШкале.Вставить(КлючШкалы, Характеристики);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Элемент Из СоответствиеЗначенийШкале Цикл
		Характеристики = Элемент.Значение.МассивХарактеристик;
		ЗначенияШкалы = Элемент.Значение.МассивЗначений;
		
		КоличествоЗначений = ЗначенияШкалы.Количество();
		Если КоличествоЗначений = 1 Тогда
			ТекстКоличествоЗначений = НСтр("ru = 'значение'");
		ИначеЕсли КоличествоЗначений > 5 Тогда
			ТекстКоличествоЗначений = НСтр("ru = 'значений'");
		Иначе
			ТекстКоличествоЗначений = НСтр("ru = 'значения'");
		КонецЕсли;
		ПервоеЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначенияШкалы.Получить(0), "Наименование");
		ПоследнееЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ЗначенияШкалы.Получить(КоличествоЗначений - 1), "Наименование");
		Если Не ЗначениеЗаполнено(ПервоеЗначение) Или  Не ЗначениеЗаполнено(ПоследнееЗначение) Тогда
			НаименованиеШкалы = СтрШаблон(НСтр("ru = '%1 %2'"),
				КоличествоЗначений,
				ТекстКоличествоЗначений);
		Иначе
			НаименованиеШкалы = СтрШаблон(НСтр("ru = '%1 %2, %3-%4'"),
				КоличествоЗначений,
				ТекстКоличествоЗначений,
				ПервоеЗначение,
				ПоследнееЗначение);
		КонецЕсли;
		
		ШкалаЗначенийОбъект = Справочники.ШкалыЗначенийХарактеристикПерсонала.СоздатьЭлемент();
