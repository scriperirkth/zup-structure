			ЗначениеОбъект.Владелец = ШкалаЗначений;
			ЗначениеОбъект.Записать();
		КонецЦикла;
		
		Для Каждого Характеристика Из Характеристики Цикл
			ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
