	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ПрофилиДолжностей.Ссылка КАК Ссылка,
		|	ПрофилиДолжностей.Характеристика КАК Характеристика,
		|	ПрофилиДолжностей.УдалитьЗначение КАК Значение,
		|	ЗначенияХарактеристик.Ссылка КАК ОбновленноеЗначение
		|ИЗ
		|	Справочник.ПрофилиДолжностей.ХарактеристикиПерсонала КАК ПрофилиДолжностей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗначенияХарактеристик КАК ЗначенияХарактеристик
		|		ПО ПрофилиДолжностей.Характеристика.ШкалаЗначений = ЗначенияХарактеристик.Владелец
		|			И ПрофилиДолжностей.УдалитьЗначение.РеквизитДопУпорядочивания = ЗначенияХарактеристик.РеквизитДопУпорядочивания
		|ГДЕ
		|	ПрофилиДолжностей.Значение = ЗНАЧЕНИЕ(Справочник.ЗначенияХарактеристик.ПустаяСсылка)
		|	И НЕ ПрофилиДолжностей.Ссылка В (&Обработанные)
		|ИТОГИ ПО
		|	Ссылка";
	Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
		Обработанные = Новый Массив;
		ПараметрыОбновления.Вставить("Обработанные");
	Иначе
		Обработанные = ПараметрыОбновления.Обработанные;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	Иначе
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
		ВыборкаПрофили = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПрофили.Следующий() Цикл
			
			Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(
				ПараметрыОбновления, "Справочник.ПрофилиДолжностей", "Ссылка", ВыборкаПрофили.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			
			Обработанные.Добавить(ВыборкаПрофили.Ссылка);
			ПрофильОбъект = ВыборкаПрофили.Ссылка.ПолучитьОбъект();
			
			ВыборкаХарактеристики = ВыборкаПрофили.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаХарактеристики.Следующий() Цикл
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Характеристика", ВыборкаХарактеристики.Характеристика);
				ПараметрыОтбора.Вставить("УдалитьЗначение", ВыборкаХарактеристики.Значение);
				НайденныеСтроки = ПрофильОбъект.ХарактеристикиПерсонала.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество() > 0 Тогда
					НайденныеСтроки[0].Значение = ВыборкаХарактеристики.ОбновленноеЗначение;
				КонецЕсли;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПрофильОбъект);
			ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		КонецЦикла;
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	КонецЕсли;
КонецПроцедуры

