				НайденныеСтроки = ИПРОбъект.ХарактеристикиСотрудника.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество() > 0 Тогда
					НайденныеСтроки[0].Значение = ВыборкаХарактеристики.ОбновленноеЗначение;
				КонецЕсли;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ИПРОбъект);
			ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		КонецЦикла;
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	КонецЕсли;
КонецПроцедуры

// Процедура выполняет заполнение регистра сведений Настройка вопросов для собеседования
Процедура ЗаполнитьНастройкуВопросовДляСобеседования(ПараметрыОбновления = Неопределено) Экспорт

	НаборЗаписей = РегистрыСведений.НастройкаВопросовДляСобеседования.СоздатьНаборЗаписей();
	
	НаборЗаписей.Прочитать();
	// Если записи в регистре уже есть, значит перенос уже был выполнен, повторный перенос не требуется
	Если НаборЗаписей.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УдалитьНастройкаВопросовДляСобеседования.Объект КАК Объект,
		|	УдалитьНастройкаВопросовДляСобеседования.ВопросДляСобеседования КАК ВопросДляСобеседования,
		|	УдалитьНастройкаВопросовДляСобеседования.ЭлементарныйВопрос КАК ЭлементарныйВопрос,
		|	УдалитьНастройкаВопросовДляСобеседования.ОтветНаВопрос КАК ОтветНаВопрос,
		|	УдалитьНастройкаВопросовДляСобеседования.ХарактеристикаПерсонала КАК ХарактеристикаПерсонала,
		|	ЗначенияХарактеристик.Ссылка КАК ЗначениеХарактеристики,
		|	УдалитьНастройкаВопросовДляСобеседования.Балл КАК Балл,
		|	УдалитьНастройкаВопросовДляСобеседования.ЭлементарныйВопросВопросаДляСобеседования КАК ЭлементарныйВопросВопросаДляСобеседования,
		|	УдалитьНастройкаВопросовДляСобеседования.ОтветНаВопросВопросаДляСобеседования КАК ОтветНаВопросВопросаДляСобеседования,
		|	УдалитьНастройкаВопросовДляСобеседования.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрСведений.УдалитьНастройкаВопросовДляСобеседования КАК УдалитьНастройкаВопросовДляСобеседования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗначенияХарактеристик КАК ЗначенияХарактеристик
		|		ПО УдалитьНастройкаВопросовДляСобеседования.ХарактеристикаПерсонала.ШкалаЗначений = ЗначенияХарактеристик.Владелец
		|			И УдалитьНастройкаВопросовДляСобеседования.ЗначениеХарактеристики.РеквизитДопУпорядочивания = ЗначенияХарактеристик.РеквизитДопУпорядочивания";
	
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	
КонецПроцедуры

