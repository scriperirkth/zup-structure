Процедура СозданиеПользователейЭкспертов(ЭкспертыБезПользователей) Экспорт
	
	Если ЭкспертыБезПользователей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ГруппаДоступа = Константы.ГруппаДоступаЭксперта.Получить();
	Если Не ЗначениеЗаполнено(ГруппаДоступа) Тогда
		ВызватьИсключение НСтр(
			"ru = 'В настройках программы не указана группа доступа для создания пользователя-эксперта'");
	КонецЕсли;
	ГруппаДоступаОбъект = ГруппаДоступа.ПолучитьОбъект();
	УстановитьПривилегированныйРежим(Ложь);
	
	Эксперты = Новый Массив;
	Для Каждого ЭкспертБезПользователя Из ЭкспертыБезПользователей Цикл
		Эксперты.Добавить(ЭкспертБезПользователя.ФизическоеЛицо);
	КонецЦикла;
	
	НастройкиУведомленийПоУмолчанию = СамообслуживаниеСотрудниковКлиентСервер.НастройкиОтправкиУведомленийПоУмолчанию();
	
	КадровыеДанные = КадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, Эксперты, "Фамилия, Имя, Отчество");
	КадровыеДанные.Индексы.Добавить("ФизическоеЛицо");
	
	Для Каждого ДанныеЭксперта Из ЭкспертыБезПользователей Цикл
		Отбор = Новый Структура("ФизическоеЛицо", ДанныеЭксперта.ФизическоеЛицо);
		НайденныеСтроки = КадровыеДанные.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ИмяПользователя = СвободноеИмяПользователя(НайденныеСтроки[0].Фамилия, НайденныеСтроки[0].Имя,
				НайденныеСтроки[0].Отчество, " (2)");
				
			ОписаниеПользователяИБ = Пользователи.НовоеОписаниеПользователяИБ();
			ОписаниеПользователяИБ.Имя = ИмяПользователя;
			ОписаниеПользователяИБ.ПолноеИмя = ИмяПользователя;
			ОписаниеПользователяИБ.АутентификацияСтандартная = Истина;
			ОписаниеПользователяИБ.ПоказыватьВСпискеВыбора = Истина;
			ОписаниеПользователяИБ.ЗапрещеноИзменятьПароль = Истина;
			ОписаниеПользователяИБ.АутентификацияOpenID = Ложь;
			ОписаниеПользователяИБ.АутентификацияОС = Ложь;
			ОписаниеПользователяИБ.Пароль = СамообслуживаниеСотрудников.СлучайныйПароль();
			ОписаниеПользователяИБ.Вставить("Действие", "Записать");
			
			УстановитьПривилегированныйРежим(Истина);
			
			Пользователь = Справочники.Пользователи.СоздатьЭлемент();
			Пользователь.Наименование = ОписаниеПользователяИБ.ПолноеИмя;
			Пользователь.ФизическоеЛицо = ДанныеЭксперта.ФизическоеЛицо;
			Пользователь.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);
			Пользователь.Записать();
			
			ГруппаДоступаОбъект.Пользователи.Добавить().Пользователь = Пользователь.Ссылка;
			
			ТекстПисьма = ТекстПисьмаУведомления(ОписаниеПользователяИБ.Имя, ОписаниеПользователяИБ.Пароль, НастройкиУведомленийПоУмолчанию);
			СамообслуживаниеСотрудников.ОтправитьСообщениеПользователю(ДанныеЭксперта, ТекстПисьма, НастройкиУведомленийПоУмолчанию);
			
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	ГруппаДоступаОбъект.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ВключитьПользователейВГруппуДоступаЭксперты(ЭкспертыСПользователями) Экспорт
	
	Если ЭкспертыСПользователями.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ГруппаДоступа = Константы.ГруппаДоступаЭксперта.Получить();
	Если Не ЗначениеЗаполнено(ГруппаДоступа) Тогда
		ВызватьИсключение НСтр(
			"ru = 'В настройках программы не указана группа доступа для создания пользователя-эксперта'");
	КонецЕсли;
	
	ПользователиБезГруппыДоступа = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГруппыДоступаПользователи.Пользователь КАК Пользователь
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|ГДЕ
		|	ГруппыДоступаПользователи.Ссылка = &ГруппаДоступа
		|	И ГруппыДоступаПользователи.Пользователь В (&Пользователи)";
	Запрос.УстановитьПараметр("ГруппаДоступа", ГруппаДоступа);
	Запрос.УстановитьПараметр("Пользователи", ЭкспертыСПользователями);
	ПользователиЭксперты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь");
	
	Если ПользователиЭксперты.Количество() = 0 Тогда
		ПользователиБезГруппыДоступа = ЭкспертыСПользователями;
	Иначе
		Для Каждого Эксперт Из ЭкспертыСПользователями Цикл
			Если ПользователиЭксперты.Найти(Эксперт) = Неопределено Тогда
				ПользователиБезГруппыДоступа.Добавить(Эксперт);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ПользователиБезГруппыДоступа.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ПользовательБезГруппы Из ПользователиБезГруппыДоступа Цикл
		Если Пользователи.ЭтоПолноправныйПользователь(ПользовательБезГруппы, Ложь, Ложь) Тогда
			Продолжить;
		КонецЕсли;
		ГруппаДоступаОбъект = ГруппаДоступа.ПолучитьОбъект();
		ГруппаДоступаОбъект.Пользователи.Добавить().Пользователь = ПользовательБезГруппы;
		ГруппаДоступаОбъект.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура УстановитьАутентификациюПользователей(ЭкспертыСПользователями) Экспорт

	Если ЭкспертыСПользователями.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого Пользователь Из ЭкспертыСПользователями Цикл
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователь, "Недействителен") Тогда
			СамообслуживаниеСотрудников.УстановитьАутентификациюПользователя(Пользователь, Истина);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция СвободноеИмяПользователя(Фамилия, Имя, Отчество, Постфикс = Неопределено)

	ВозможныеЗначения = Новый Массив;

	ВозможныеЗначения.Добавить(Фамилия + Лев(Имя, 1) + Лев(Отчество, 1));
	Если ЗначениеЗаполнено(Постфикс) Тогда
		ВозможныеЗначения.Добавить(Фамилия + Лев(Имя, 1) + Лев(Отчество, 1) + " " + Постфикс);
	КонецЕсли;

	ВозможныеЗначения.Добавить(Фамилия);
	Если ЗначениеЗаполнено(Постфикс) Тогда
		ВозможныеЗначения.Добавить(Фамилия + " " + Постфикс);
	КонецЕсли;

	ВозможныеЗначения.Добавить(Фамилия + " " + Имя + " " + Отчество);
	Если ЗначениеЗаполнено(Постфикс) Тогда
		ВозможныеЗначения.Добавить(Фамилия + " " + Имя + " " + Отчество + " " + Постфикс);
	КонецЕсли;

	ВозможныеЗначения.Добавить(Фамилия + " " + Имя);
	Если ЗначениеЗаполнено(Постфикс) Тогда
		ВозможныеЗначения.Добавить(Фамилия + " " + Имя + " " + Постфикс);
	КонецЕсли;

	ВозможныеЗначения.Добавить(Фамилия + " " + Имя + " " + Лев(Отчество, 1));
	Если ЗначениеЗаполнено(Постфикс) Тогда
		ВозможныеЗначения.Добавить(Фамилия + " " + Имя + " " + Лев(Отчество, 1) + " " + Постфикс);
	КонецЕсли;

	ВозможныеЗначения.Добавить(Фамилия + Лев(Имя, 4) + Лев(Отчество, 4));
	Если ЗначениеЗаполнено(Постфикс) Тогда
		ВозможныеЗначения.Добавить(Фамилия + Лев(Имя, 4) + Лев(Отчество, 4) + " " + Постфикс);
	КонецЕсли;

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Пользователи.Наименование
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование В(&ВозможныеЗначения)";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВозможныеЗначения", ВозможныеЗначения);
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();

	ЗанятыеЗначения = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ЗанятыеЗначения.Вставить(СокрЛП(Выборка.Наименование), Истина);
	КонецЦикла;

	Для Каждого ИмяПользователя Из ВозможныеЗначения Цикл
		Если ЗанятыеЗначения[ИмяПользователя] = Неопределено Тогда
			Возврат ИмяПользователя;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ТекстПисьмаУведомления(ПользовательИБ, Пароль, НастройкиСообщений) Экспорт 
	
	ТекстПисьма = НастройкиСообщений.ШаблонУведомления;
	
	// имя пользователя и пароль
	ТекстПисьма = СтрЗаменить(ТекстПисьма, "%ИмяПользователяИБ%", ПользовательИБ);
	ТекстПисьма = СтрЗаменить(ТекстПисьма, "%Пароль%", ?(Не ПустаяСтрока(Пароль), Пароль, НСтр("ru = 'без пароля'")));
	
	// адрес веб-сервера
	АдресВебСервера = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВИнтернете();
	Если ЗначениеЗаполнено(АдресВебСервера) Тогда
		Шаблон = "%1%2" + ?(ЗначениеЗаполнено(ПользовательИБ), "?N=%3", "") + ?(ЗначениеЗаполнено(Пароль), "&P=%4", "");
		ВебСсылкаПереходаВСистему = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, 
			СокрЛП(АдресВебСервера), ?(Прав(СокрЛП(АдресВебСервера), 1) <> "/", "/", ""), ПользовательИБ, Пароль);
			ТекстПисьма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1
				|
				|Прямая ссылка:
				|<a href=""%2"">%2</a>'"),
				ТекстПисьма,
				ВебСсылкаПереходаВСистему);
	КонецЕсли;
	
	// обрабатываем разрывы строк
	ОтдельныеСтрокиТекста = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПисьма, Символы.ПС);
	HTMLКодОтдельныхСтрок = ОтдельныеСтрокиТекста[0];
	НомерСтроки = 1;
	Пока НомерСтроки < ОтдельныеСтрокиТекста.Количество() Цикл
		HTMLКодОтдельныхСтрок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1<BR>%2</BR>",
									HTMLКодОтдельныхСтрок, 
									ОтдельныеСтрокиТекста[НомерСтроки]);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	HTMLКод = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1<P>%2</P>",
				HTMLКод,
				HTMLКодОтдельныхСтрок);
	
	Возврат HTMLКод;
	
КонецФункции

Функция ПолучитьСтатусОпроса(МероприятиеЗавершено, АнкетированиеНачато, ДатаОкончания) Экспорт
	
	ТекстИнформацииТекущаяСтадия = "";
	Если ДатаОкончания = NULL Тогда
		Возврат ТекстИнформацииТекущаяСтадия;
	КонецЕсли;
	
	Если МероприятиеЗавершено Тогда 
		ТекстИнформацииТекущаяСтадия = НСтр("ru = 'Прием анкет завершен'");
	Иначе
		Если АнкетированиеНачато Тогда
			ТекстИнформацииТекущаяСтадия = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Идет процесс приема анкет. Анкетирование завершается %1'"), Формат(ДатаОкончания, "ДФ=dd.MM.yy"));
		Иначе
			ТекстИнформацииТекущаяСтадия = НСтр("ru = 'Анкетирование не начато'");
		КонецЕсли;
	КонецЕсли;
		
	Возврат ТекстИнформацииТекущаяСтадия;
КонецФункции

Процедура ДополнитьХарактеристикиОценкамиОтветовОпросаПоКомпетенциям(Форма) Экспорт
	
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Форма.Объект.Основание,
		"Назначение, ПозицияШтатногоРасписания, ПрофильДолжности");
	
	Если ДанныеОснования.Назначение = Перечисления.НазначенияКадровогоРезерва.ГруппаКадровогоРезерва Тогда
		ПрофильДолжности = ДанныеОснования.ПрофильДолжности;
		Если Не ЗначениеЗаполнено(ПрофильДолжности) Тогда
			Возврат;
		КонецЕсли;
	Иначе
		ПрофильДолжностиМассив = ХарактеристикиПерсонала.ПрофильДолжностиПоПозицииШтатногоРасписания(
			ДанныеОснования.ПозицияШтатногоРасписания);
		Если Не ЗначениеЗаполнено(ПрофильДолжностиМассив) Тогда
			Возврат;
		КонецЕсли;
		ПрофильДолжности = ПрофильДолжностиМассив[0];
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
		|	ОпросыПоКомпетенциямОцениваемые.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТОпросы
		|ИЗ
		|	Справочник.ОпросыПоКомпетенциям.Оцениваемые КАК ОпросыПоКомпетенциямОцениваемые
		|ГДЕ
		|	ОпросыПоКомпетенциямОцениваемые.ФизическоеЛицо = &ФизическоеЛицо
		|	И ОпросыПоКомпетенциямОцениваемые.Ссылка.ПрофильДолжности = &ПрофильДолжности
		|	И ОпросыПоКомпетенциямОцениваемые.Ссылка.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОпросыПоКомпетенциямОцениваемые.Ссылка.ДатаНачала УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОценкиОтветовОпросаПоКомпетенциям.ОпросПоКомпетенциям.ДатаНачала КАК ДатаОценки,
		|	ОценкиОтветовОпросаПоКомпетенциям.ХарактеристикаПерсонала КАК ХарактеристикаПерсонала,
		|	СРЕДНЕЕ(ВЫБОР
		|			КОГДА ОценкиОтветовОпросаПоКомпетенциям.ХарактеристикаПерсонала.СпособВыбораОтветаВОпросахПоКомпетенциям = ЗНАЧЕНИЕ(Перечисление.СпособыВыбораОтветовВОпросахПоКомпетенциям.ПоШкале)
		|				ТОГДА ОценкиОтветовОпросаПоКомпетенциям.Значение.ЧисловоеЗначение
		|			ИНАЧЕ ОценкиОтветовОпросаПоКомпетенциям.Оценка
		|		КОНЕЦ) КАК Оценка
		|ИЗ
		|	РегистрСведений.ОценкиОтветовОпросаПоКомпетенциям КАК ОценкиОтветовОпросаПоКомпетенциям
		|ГДЕ
		|	ОценкиОтветовОпросаПоКомпетенциям.ФизическоеЛицо В(&ФизическоеЛицо)
		|	И ОценкиОтветовОпросаПоКомпетенциям.ОпросПоКомпетенциям В
		|			(ВЫБРАТЬ
		|				ВТОпросы.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТОпросы КАК ВТОпросы)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОценкиОтветовОпросаПоКомпетенциям.ХарактеристикаПерсонала,
		|	ОценкиОтветовОпросаПоКомпетенциям.ОпросПоКомпетенциям.ДатаНачала
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОценкиОтветовОпросаПоКомпетенциям.ОпросПоКомпетенциям.ДатаНачала УБЫВ";
	Запрос.УстановитьПараметр("ФизическоеЛицо", Форма.Объект.Владелец);
	Запрос.УстановитьПараметр("ПрофильДолжности", ПрофильДолжности);
	
	РезультатыОценки = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаХарактеристик Из Форма.Характеристики Цикл
		НайденныеСтроки = РезультатыОценки.НайтиСтроки(
			Новый Структура("ХарактеристикаПерсонала", СтрокаХарактеристик.Характеристика));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НайденныеСтроки.Количество() = 1 Тогда
			СтрокаХарактеристик.Оценка = НайденныеСтроки[0].Оценка;
		КонецЕсли;
		Если НайденныеСтроки.Количество() = 2 Тогда
			Если НайденныеСтроки[0].ДатаОценки > НайденныеСтроки[1].ДатаОценки Тогда
				СтрокаХарактеристик.Оценка = НайденныеСтроки[0].Оценка;
				СтрокаХарактеристик.ПредыдущаяОценка = НайденныеСтроки[1].Оценка;
			Иначе
				СтрокаХарактеристик.ПредыдущаяОценка = НайденныеСтроки[0].Оценка;
				СтрокаХарактеристик.Оценка = НайденныеСтроки[1].Оценка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьХарактеристикиРезультатамиЭкспертнойОценкиПерсонала(Форма) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РезультатыЭкспертнойОценкиПерсоналаСрезПоследних.ХарактеристикаПерсонала КАК ХарактеристикаПерсонала,
		|	РезультатыЭкспертнойОценкиПерсоналаСрезПоследних.Оценка КАК Оценка
		|ИЗ
		|	РегистрСведений.РезультатыЭкспертнойОценкиПерсонала.СрезПоследних(
		|			,
		|			ФизическоеЛицо = &ФизическоеЛицо
		|				И ХарактеристикаПерсонала В (&Характеристики)) КАК РезультатыЭкспертнойОценкиПерсоналаСрезПоследних";
	Запрос.УстановитьПараметр("ФизическоеЛицо", Форма.Объект.Владелец);
	Запрос.УстановитьПараметр("Характеристики", Форма.Характеристики.Выгрузить().ВыгрузитьКолонку("Характеристика"));
	
	РезультатыОценки = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаХарактеристик Из Форма.Характеристики Цикл
		НайденныеСтроки = РезультатыОценки.НайтиСтроки(
			Новый Структура("ХарактеристикаПерсонала", СтрокаХарактеристик.Характеристика));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаХарактеристик.Оценка = НайденныеСтроки[0].Оценка;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 