// Процедуры расчета оценок.

// Заполняет регистры сведений оценок персонала
// "ОценкиОтветовОпросаПоКомпетенциям", "РезультатыЭкспертнойОценкиПерсонала" по содержимому ОтветыНаВопросыАнкет.
// передаваемые параметры
// 	Мероприятие - тип СправочникСсылка.ОпросыПоКомпетенциям - опрос, в рамках которого необходимо произвести пересчет
//  Анкета - тип ДокументСсылка.Анкета - анкета, в рамках ответов которой необходимо произвести пересчет
//	Удаление - тип булево - признак того, что произошла отмена проведения документа Анкеты.
Процедура РассчитатьОценкиПоОтветам(Опрос, Анкета, Удаление) Экспорт
	
	РассчитатьОценкиОтветовНаВопросыАнкет(Опрос, Анкета, Удаление);
	РассчитатьРезультатыОценкиСотрудников(Опрос);
	
КонецПроцедуры

Процедура РассчитатьОценкиОтветовНаВопросыАнкет(Опрос, Анкета, Удаление)
	
	НаборЗаписей = РегистрыСведений.ОценкиОтветовОпросаПоКомпетенциям.СоздатьНаборЗаписей();
	
	Если Не Удаление Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ОпросыПоКомпетенциямХарактеристики.Характеристика КАК Характеристика,
		|	ОпросыПоКомпетенциямХарактеристики.Вопрос КАК Вопрос
		|ПОМЕСТИТЬ ВТВопросыХарактеристик
		|ИЗ
		|	Справочник.ОпросыПоКомпетенциям.Характеристики КАК ОпросыПоКомпетенциямХарактеристики
		|ГДЕ
		|	ОпросыПоКомпетенциямХарактеристики.Ссылка = &Опрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Опрос КАК Опрос,
		|	ОпросыПоКомпетенциямОцениваемые.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Анкеты.Респондент.ФизическоеЛицо КАК Эксперт,
		|	ОпросыПоКомпетенциямОценивающиеЭксперты.РольЭксперта КАК РольЭксперта,
		|	ВТВопросыХарактеристик.Характеристика КАК ХарактеристикаПерсонала,
		|	ОтветыНаВопросыАнкет.Вопрос КАК Вопрос,
		|	ВариантыОтветовАнкет.Ссылка КАК Ответ,
		|	ОтветыНаВопросыАнкет.Ответ КАК Балл,
		|	ВЫРАЗИТЬ(АнкетаСостав.ОткрытыйОтвет КАК СТРОКА(150)) КАК КомментарийЭксперта
		|ПОМЕСТИТЬ ВТОтветы
		|ИЗ
		|	РегистрСведений.ОтветыНаВопросыАнкет КАК ОтветыНаВопросыАнкет
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Анкета КАК Анкеты
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОпросыПоКомпетенциям.ОценивающиеЭксперты КАК ОпросыПоКомпетенциямОценивающиеЭксперты
		|			ПО (ОпросыПоКомпетенциямОценивающиеЭксперты.Ссылка = &Опрос)
		|				И Анкеты.Респондент.ФизическоеЛицо = ОпросыПоКомпетенциямОценивающиеЭксперты.ОценивающийЭксперт
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОпросыПоКомпетенциям.Оцениваемые КАК ОпросыПоКомпетенциямОцениваемые
		|			ПО Анкеты.Опрос = ОпросыПоКомпетенциямОцениваемые.НазначениеОпроса
		|				И (ОпросыПоКомпетенциямОцениваемые.Ссылка = &Опрос)
		|				И (&УсловиеПоФизическомуЛицу)
		|		ПО (Анкеты.Ссылка = &Анкета)
		|			И ОтветыНаВопросыАнкет.Анкета = Анкеты.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВопросыХарактеристик КАК ВТВопросыХарактеристик
		|		ПО ОтветыНаВопросыАнкет.Вопрос = ВТВопросыХарактеристик.Вопрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыОтветовАнкет КАК ВариантыОтветовАнкет
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ОтветыНаВопросыАнкет.Ответ) = ТИП(Справочник.ВариантыОтветовАнкет)
		|					ТОГДА ОтветыНаВопросыАнкет.ЭлементарныйВопрос = ВариантыОтветовАнкет.Владелец
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ОтветыНаВопросыАнкет.Ответ) = ТИП(Справочник.ВариантыОтветовАнкет)
		|					ТОГДА ОтветыНаВопросыАнкет.Ответ = ВариантыОтветовАнкет.Ссылка
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ОтветыНаВопросыАнкет.Ответ) = ТИП(Справочник.ВариантыОтветовАнкет)
		|					ТОГДА НЕ ВариантыОтветовАнкет.ПометкаУдаления
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Анкета.Состав КАК АнкетаСостав
		|		ПО ОтветыНаВопросыАнкет.Анкета = АнкетаСостав.Ссылка
		|			И ОтветыНаВопросыАнкет.Вопрос = АнкетаСостав.Вопрос
		|ГДЕ
		|	ОтветыНаВопросыАнкет.БезОтвета = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	ОпросыПоКомпетенциямОценивающиеЭксперты.РольЭксперта,
		|	ВТВопросыХарактеристик.Характеристика,
		|	ОпросыПоКомпетенциямОцениваемые.ФизическоеЛицо,
		|	ВариантыОтветовАнкет.Ссылка,
		|	ОтветыНаВопросыАнкет.Ответ,
		|	ВЫРАЗИТЬ(АнкетаСостав.ОткрытыйОтвет КАК СТРОКА(150)),
		|	ОтветыНаВопросыАнкет.Вопрос,
		|	Анкеты.Респондент.ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОтветы.Опрос КАК ОпросПоКомпетенциям,
		|	ВТОтветы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВТОтветы.Эксперт КАК Эксперт,
		|	ВТОтветы.РольЭксперта КАК РольЭксперта,
		|	ВТОтветы.ХарактеристикаПерсонала КАК ХарактеристикаПерсонала,
		|	ВТОтветы.Вопрос КАК Вопрос,
		|	ВТОтветы.Ответ КАК Ответ,
		|	ВЫБОР
		|		КОГДА ВТОтветы.ХарактеристикаПерсонала.СпособВыбораОтветаВОпросахПоКомпетенциям = ЗНАЧЕНИЕ(Перечисление.СпособыВыбораОтветовВОпросахПоКомпетенциям.ПоШкале)
		|			ТОГДА ЗначенияХарактеристик.Ссылка
		|	КОНЕЦ КАК Значение,
		|	ВЫБОР
		|		КОГДА ВТОтветы.ХарактеристикаПерсонала.СпособВыбораОтветаВОпросахПоКомпетенциям = ЗНАЧЕНИЕ(Перечисление.СпособыВыбораОтветовВОпросахПоКомпетенциям.ТочноеЗначение)
		|			ТОГДА ВТОтветы.Балл
		|	КОНЕЦ КАК Оценка,
		|	ВТОтветы.КомментарийЭксперта КАК КомментарийЭксперта
		|ИЗ
		|	ВТОтветы КАК ВТОтветы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗначенияХарактеристик КАК ЗначенияХарактеристик
		|		ПО ВТОтветы.ХарактеристикаПерсонала.ШкалаЗначений.Ссылка = ЗначенияХарактеристик.Владелец
		|			И ВТОтветы.Ответ.Наименование = ЗначенияХарактеристик.Наименование");
		Запрос.УстановитьПараметр("Опрос", Опрос);
		Запрос.УстановитьПараметр("Анкета", Анкета);
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Опрос, "СпособЗаполненияЭкспертов") = Перечисления.СпособЗаполненияРеспондентовВОценке360.ЕдиноеДляВсех Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.ОпросыПоКомпетенциям.ОценивающиеЭксперты", "Справочник.ОпросыПоКомпетенциям.ОценивающиеЭкспертыЕдиныйНабор");
			Запрос.УстановитьПараметр("УсловиеПоФизическомуЛицу", Истина);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоФизическомуЛицу", "(ОпросыПоКомпетенциямОценивающиеЭксперты.ФизическоеЛицо = ОпросыПоКомпетенциямОцениваемые.ФизическоеЛицо)");
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		НаборЗаписей.Загрузить(РезультатЗапроса);
	Иначе
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	&Мероприятие КАК ОпросПоКомпетенциям,
			|	МероприятияОценкиПерсоналаУчастники.ФизическоеЛицо КАК ФизическоеЛицо,
			|	Анкеты.Респондент.ФизическоеЛицо КАК Эксперт
			|ИЗ
			|	Документ.Анкета КАК Анкеты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НазначениеОпросов КАК НазначениеОпросов
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОпросыПоКомпетенциям.Оцениваемые КАК МероприятияОценкиПерсоналаУчастники
			|			ПО НазначениеОпросов.Ссылка = МероприятияОценкиПерсоналаУчастники.НазначениеОпроса
			|				И (МероприятияОценкиПерсоналаУчастники.Ссылка = &Мероприятие)
			|		ПО Анкеты.Опрос = НазначениеОпросов.Ссылка
			|			И (Анкеты.Ссылка = &Анкета)
			|
			|СГРУППИРОВАТЬ ПО
			|	МероприятияОценкиПерсоналаУчастники.ФизическоеЛицо,
			|	Анкеты.Респондент.ФизическоеЛицо");
		Запрос.УстановитьПараметр("Мероприятие", Опрос);
		Запрос.УстановитьПараметр("Анкета", Анкета);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить()
	КонецЕсли;
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		НаборЗаписей.Отбор.ОпросПоКомпетенциям.Установить(РезультатЗапроса[0].ОпросПоКомпетенциям);
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(РезультатЗапроса[0].ФизическоеЛицо);
		НаборЗаписей.Отбор.Эксперт.Установить(РезультатЗапроса[0].Эксперт);
		НаборЗаписей.Записать();
	Иначе
		ПредставлениеОшибки =
			НСтр("ru = 'Не удалось рассчитать оценки ответов на вопросы анкет'");
		ВызватьИсключение ПредставлениеОшибки;
	КонецЕсли;
	
КонецПроцедуры

Процедура РассчитатьРезультатыОценкиСотрудников(Опрос)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОценкиОтветовОпросаПоКомпетенциям.ОпросПоКомпетенциям.ДатаНачала КАК Период,
		|	ОценкиОтветовОпросаПоКомпетенциям.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОценкиОтветовОпросаПоКомпетенциям.Эксперт КАК Эксперт,
		|	ОценкиОтветовОпросаПоКомпетенциям.ХарактеристикаПерсонала КАК ХарактеристикаПерсонала,
		|	СРЕДНЕЕ(ВЫБОР
		|			КОГДА ОценкиОтветовОпросаПоКомпетенциям.ХарактеристикаПерсонала.СпособВыбораОтветаВОпросахПоКомпетенциям = ЗНАЧЕНИЕ(Перечисление.СпособыВыбораОтветовВОпросахПоКомпетенциям.ПоШкале)
		|				ТОГДА ОценкиОтветовОпросаПоКомпетенциям.Значение.ЧисловоеЗначение
		|			ИНАЧЕ ОценкиОтветовОпросаПоКомпетенциям.Оценка
		|		КОНЕЦ) КАК Оценка
		|ИЗ
		|	РегистрСведений.ОценкиОтветовОпросаПоКомпетенциям КАК ОценкиОтветовОпросаПоКомпетенциям
		|ГДЕ
		|	ОценкиОтветовОпросаПоКомпетенциям.ОпросПоКомпетенциям = &Опрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ОценкиОтветовОпросаПоКомпетенциям.ФизическоеЛицо,
		|	ОценкиОтветовОпросаПоКомпетенциям.ХарактеристикаПерсонала,
		|	ОценкиОтветовОпросаПоКомпетенциям.Эксперт,
		|	ОценкиОтветовОпросаПоКомпетенциям.ОпросПоКомпетенциям.ДатаНачала";
	Запрос.УстановитьПараметр("Опрос", Опрос);
	
	НаборЗаписей = РегистрыСведений.РезультатыЭкспертнойОценкиПерсонала.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	
	НаборЗаписей.Отбор.Период.Установить(Опрос.ДатаНачала);
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#Область ПеренесенныйШаблоныСообщенийСервер

Функция ВнешняяСсылкаНаСписокДоступныхАнкет(ПользовательИБ, Пароль = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	НайденныйПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ПользовательИБ.ИдентификаторПользователяИБ);
	АдресПубликацииИБ = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВИнтернете();
	УстановитьПривилегированныйРежим(Ложь);
	
	СтрокаПользователя = ?(НайденныйПользовательИБ = Неопределено, "", "?N=" + НайденныйПользовательИБ.Имя);
	СтрокаПароля = ?(Пароль = Неопределено, "", "&P=" + Пароль);
	
	ЧастиСтроки = Новый Массив;
	ЧастиСтроки.Добавить(АдресПубликацииИБ);
	ЧастиСтроки.Добавить(?(СтрЗаканчиваетсяНа(СокрЛП(АдресПубликацииИБ), "/"), "", "/"));
	ЧастиСтроки.Добавить(КодироватьСтроку(СтрокаПользователя, СпособКодированияСтроки.URLВКодировкеURL));
	ЧастиСтроки.Добавить(КодироватьСтроку(СтрокаПароля, СпособКодированияСтроки.URLВКодировкеURL));
	ЧастиСтроки.Добавить(КодироватьСтроку("#e1cib/app/" + Метаданные.Обработки.ДоступныеАнкеты.ПолноеИмя(), 
		СпособКодированияСтроки.URLВКодировкеURL));
		
	Возврат СтрСоединить(ЧастиСтроки);
	
КонецФункции
	
#КонецОбласти

#Область НастройкиВариантовОтчетов

// Определяет разделы, в которых доступна панель отчетов.
//
// Параметры:
//   Разделы (Массив) из (ОбъектМетаданных).
//
// Описание:
//   В Разделы необходимо добавить метаданные тех разделов,
//   в которых размещены команды вызова панелей отчетов.
//
// Например:
//	Разделы.Добавить(Метаданные.Подсистемы.ИмяПодсистемы);
//
Процедура ОпределитьРазделыСВариантамиОтчетов(Разделы) Экспорт
	
	Если Разделы.НайтиПоЗначению(Метаданные.Подсистемы.ОбучениеИРазвитие) = Неопределено Тогда
		Разделы.Добавить(Метаданные.Подсистемы.ОбучениеИРазвитие, НСтр("ru = 'Отчеты по обучению и развитию'"));
	КонецЕсли;
	
КонецПроцедуры

// Содержит настройки размещения вариантов отчетов в панели отчетов.
// Описание см. ЗарплатаКадрыВариантыОтчетов.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчетов(Настройки) Экспорт
	
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.РезультатыОпросовПоКомпетенциям);
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.ПрофильнаяОценкаКомпетенцийСотрудников);
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.СравнительныйАнализКомпетенцийСотрудников);
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.СтатусыЗаполненияОпросовПоКомпетенциям);
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.РезультатыОпросовПоКомпетенциям, "РезультатыОпросаПоКомпетенциям");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьЭкспертнуюОценкуПерсонала");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.РезультатыОпросовПоКомпетенциям, "ИндивидуальнаяОценка");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьЭкспертнуюОценкуПерсонала");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.РезультатыОпросовПоКомпетенциям, "ИндивидуальнаяОценкаДляСотрудника");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьЭкспертнуюОценкуПерсонала");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.ПрофильнаяОценкаКомпетенцийСотрудников, "ПрофильнаяОценкаКомпетенцийСотрудников");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьЭкспертнуюОценкуПерсонала");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.СравнительныйАнализКомпетенцийСотрудников, "СравнительныйАнализКомпетенцийСотрудников");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьЭкспертнуюОценкуПерсонала");
	
	Вариант = ВариантыОтчетов.ОписаниеВарианта(Настройки, Метаданные.Отчеты.СтатусыЗаполненияОпросовПоКомпетенциям, "СтатусыЗаполненияОпросов");
	Вариант.ФункциональныеОпции.Добавить("ИспользоватьЭкспертнуюОценкуПерсонала");
	
КонецПроцедуры

#КонецОбласти

// Функция дополняет описание профиля ролями для работы с подсистемой Экспертная оценка персонала.
// 
Процедура ДополнитьОписаниеПрофиля(ОписаниеПрофиля) Экспорт
	
	ОписаниеПрофиля.Роли.Добавить("ПодсистемаЭкспертнаяОценка");
	ОписаниеПрофиля.Роли.Добавить("ДобавлениеИзменениеОпросовПоКомпетенциям");
	
КонецПроцедуры

Процедура ЗаполнитьПараметрМероприятияОценкиШаблонаСообщения(ПараметрыСообщения, Объект) Экспорт

	ПараметрыСообщения.Вставить("Наименование", Объект.Наименование);
	ПараметрыСообщения.Вставить("ДатаНачала", Формат(Объект.ДатаНачала, "ДЛФ=D"));
	ПараметрыСообщения.Вставить("ДатаОкончания", Формат(Объект.ДатаОкончания, "ДЛФ=D"));
	ПараметрыСообщения.Вставить("Ответственный", Объект.Ответственный);

КонецПроцедуры

#Область РаботаСШаблонамиСообщений

Процедура ПриПодготовкеШаблонаСообщения(Реквизиты, Вложения, НазначениеШаблона, ДополнительныеПараметры) Экспорт

	Если Не ДополнительныеПараметры.Свойство("ВладелецШаблона") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры.ВладелецШаблона)
		<> Тип("ПеречислениеСсылка.ИспользованиеШаблоновСообщенийПриОценкеПерсонала") Тогда
		Возврат;
	КонецЕсли;

	ДополнитьШаблонРеквизитамиМероприятияОценкиПерсонала(Реквизиты, Вложения, ДополнительныеПараметры);
	ДополнитьШаблонПроизвольнымиПараметрами(Реквизиты, Вложения, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ПриФормированииСообщения(Сообщение, НазначениеШаблона, ПредметСообщения, ДополнительныеПараметры) Экспорт

	Если Не ДополнительныеПараметры.Свойство("ВладелецШаблона") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры.ВладелецШаблона)
		<> Тип("ПеречислениеСсылка.ИспользованиеШаблоновСообщенийПриОценкеПерсонала") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРеквизитыШаблонаЗначениямиМероприятияОценки(Сообщение, ПредметСообщения, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ПриЗаполненииПочтыПолучателейВСообщении(ПолучателиПисьма, НазначениеШаблона, ПредметСообщения) Экспорт
	
	Если Не ПредметСообщения.Свойство("ПроизвольныеПараметры") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПредметСообщения.ПроизвольныеПараметры["ПараметрыПолучателей"] = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПолучателей = ПредметСообщения.ПроизвольныеПараметры["ПараметрыПолучателей"];
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыПолучателей, "ПереопределятьПолучателей", Ложь) Тогда
		ПереопределитьПолучателейПисьма(ПолучателиПисьма, НазначениеШаблона, ПараметрыПолучателей);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьШаблонРеквизитамиМероприятияОценкиПерсонала(Реквизиты, Вложения, ДополнительныеПараметры)
	
	РеквизитыШаблона = Реквизиты.Родитель.Владелец().Строки;
	
	ГруппаМероприятиеОценки = РеквизитыШаблона.Добавить();
	ГруппаМероприятиеОценки.Имя = "ОпросыПоКомпетенциям";
	ГруппаМероприятиеОценки.Представление = НСтр("ru = 'Опросы по компетенциям'");
	
	РеквизитыМероприятия = ГруппаМероприятиеОценки.Строки;
	
	// Наименование.
	НоваяСтрока = РеквизитыМероприятия.Добавить();
	НоваяСтрока.Имя = "ОпросыПоКомпетенциям.Наименование";
	НоваяСтрока.Представление = НСтр("ru = 'Наименование'");
	
	// Дата начала.
	НоваяСтрока = РеквизитыМероприятия.Добавить();
	НоваяСтрока.Имя = "ОпросыПоКомпетенциям.ДатаНачала";
	НоваяСтрока.Представление = НСтр("ru = 'Дата начала'");
	
	// Дата окончания.
	НоваяСтрока = РеквизитыМероприятия.Добавить();
	НоваяСтрока.Имя = "ОпросыПоКомпетенциям.ДатаОкончания";
	НоваяСтрока.Представление = НСтр("ru = 'Дата окончания'");
	
	// Дата Ответственный.
	НоваяСтрока = РеквизитыМероприятия.Добавить();
	НоваяСтрока.Имя = "ОпросыПоКомпетенциям.Ответственный";
	НоваяСтрока.Представление = НСтр("ru = 'Ответственный'");

КонецПроцедуры

Процедура ДополнитьШаблонПроизвольнымиПараметрами(РеквизитыОбъектаНазначения, Вложения, ДополнительныеПараметры)

	Описание = Новый Структура("ОписаниеТипа, Представление");
	Описание.ОписаниеТипа = Новый ОписаниеТипов("Строка");
	Описание.Представление = НСтр("ru = 'Веб-ссылка на форму анкетирования'");
	
	ДополнительныеПараметры.Параметры.Вставить("ВебСсылкаАнкетирования", Описание);

КонецПроцедуры

Процедура ЗаполнитьРеквизитыШаблонаЗначениямиМероприятияОценки(Сообщение, ПредметСообщения, ДополнительныеПараметры)

	ПараметрыШаблона = Сообщение.ДополнительныеПараметры.ПроизвольныеПараметры;
	Если ПараметрыШаблона["ОпросыПоКомпетенциям"] = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыМероприятияОценкиПерсонала = ПараметрыШаблона["ОпросыПоКомпетенциям"];
	ПараметрыСообщения = ДополнительныеПараметры.ПараметрыСообщения;
	
	Для каждого ПараметрСообщения Из ПараметрыСообщения Цикл
		ПараметрыМероприятияОценкиПерсонала.Вставить(ПараметрСообщения.Ключ, ПараметрСообщения.Значение);
	КонецЦикла; 

КонецПроцедуры

Процедура ПереопределитьПолучателейПисьма(ПолучателиПисьма, НазначениеШаблона, ПараметрыПолучателей)

	ПолучателиПисьма.Очистить();
	
	НоваяСтрока = ПолучателиПисьма.Добавить();
	НоваяСтрока.Представление = ПараметрыПолучателей.ФИОПолучателя;
	НоваяСтрока.Контакт = ПараметрыПолучателей.ФИОПолучателя;
	НоваяСтрока.Адрес = ПараметрыПолучателей.Адрес;

КонецПроцедуры

Процедура ЗаполнитьРеквизитШаблонаВебСсылкаАнкетирования(ПараметрыШаблона) Экспорт

	Если НЕ ПараметрыШаблона.Свойство("ПроизвольныеПараметры") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПараметрыШаблона.Свойство("ПользовательИБ") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыШаблона["ПроизвольныеПараметры"].Вставить("ВебСсылкаАнкетирования", 
		ВнешняяСсылкаНаСписокДоступныхАнкет(ПараметрыШаблона.ПользовательИБ));
	
КонецПроцедуры

Процедура ДобавитьПереопределениеПолучателейСообщения(ПараметрыШаблона, ПриглашаемыйРеспондент) Экспорт

	Если Не ПараметрыШаблона.Свойство("ПроизвольныеПараметры") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПолучателей = Новый Структура;
	
	ФИОПолучателя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПриглашаемыйРеспондент.ФизическоеЛицо, "ФИО");
	ПараметрыПолучателей.Вставить("ПереопределятьПолучателей", Истина);
	ПараметрыПолучателей.Вставить("Получатель", ПриглашаемыйРеспондент.ФизическоеЛицо);
	ПараметрыПолучателей.Вставить("ФИОПолучателя", ФИОПолучателя);
	ПараметрыПолучателей.Вставить("Адрес", ПриглашаемыйРеспондент.Адрес);
	
	ПараметрыШаблона["ПроизвольныеПараметры"].Вставить("ПараметрыПолучателей", ПараметрыПолучателей);

КонецПроцедуры

