#КонецОбласти

Процедура ПроверитьИзменениеДокументаУдостоверяющегоЛичность(Форма) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьМедицинскоеСтрахованиеСотрудников") Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.СозданиеНового Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних.ДоговорСтрахования КАК ДоговорСтрахования
		|ИЗ
		|	РегистрСведений.ПрограммыМедицинскогоСтрахованияСотрудников.СрезПоследних КАК ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних
		|ГДЕ
		|	ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних.Действует = ИСТИНА
		|	И ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних.ДействуетДо >= &ТекущаяДата
		|	И ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних.ФизическоеЛицо = &ФизическоеЛицо";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ФизическоеЛицо", Форма.ФизическоеЛицоСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеСтрахования = РезультатЗапроса.Выгрузить();
	Для Каждого ТекущееСтрахование Из ТекущиеСтрахования Цикл
		ОтправляемыеДанныеТаблица = ОтправляемыеДанныеВСтраховуюКомпанию(ТекущееСтрахование.ДоговорСтрахования);
		ОтправляемыеДанные = ОтправляемыеДанныеТаблица.ВыгрузитьКолонку("Сведение");
		Если ОтправляемыеДанные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ОтправляемыеДанные.Найти("ДокументВид") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОтборСтруктура = Новый Структура("ДоговорСтрахования, Застрахованный",ТекущееСтрахование.ДоговорСтрахования, Форма.ФизическоеЛицоСсылка);
		ТаблицаОтправленныеДанные = РегистрыСведений.ОтправленныеДанныеЗастрахованных.СрезПоследних(, ОтборСтруктура);
		Если ТаблицаОтправленныеДанные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОтправленныеДанные = ТаблицаОтправленныеДанные[0];
		
		Если Форма.ДокументыФизическихЛиц.ВидДокумента <> ОтправленныеДанные.ДокументВид Тогда
			Продолжить;
		КонецЕсли;
		
		ИзменилисьОтправленныеДанные = Ложь;
		ИзмениласьСерия = Ложь;
		Если Форма.ДокументыФизическихЛиц.Серия <> Форма.ДокументыФизическихЛицПрежняя.Серия И Форма.ДокументыФизическихЛиц.Серия <> ОтправленныеДанные.ДокументСерия Тогда
			ИзмениласьСерия = Истина;
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
		
		ИзменилсяНомер = Ложь;
		Если Форма.ДокументыФизическихЛиц.Номер <> Форма.ДокументыФизическихЛицПрежняя.Номер И Форма.ДокументыФизическихЛиц.Номер <> ОтправленныеДанные.ДокументНомер Тогда
			ИзменилсяНомер = Истина;
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
		
		ИзмениласьДатаВыдачи = Ложь;
		Если Форма.ДокументыФизическихЛиц.ДатаВыдачи <> Форма.ДокументыФизическихЛицПрежняя.ДатаВыдачи И Форма.ДокументыФизическихЛиц.ДатаВыдачи <> ОтправленныеДанные.ДокументДатаВыдачи Тогда
			ИзмениласьДатаВыдачи = Истина;
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
		
		ИзменилсяСрокДействия = Ложь;
		Если Форма.ДокументыФизическихЛиц.СрокДействия <> Форма.ДокументыФизическихЛицПрежняя.СрокДействия И Форма.ДокументыФизическихЛиц.СрокДействия <> ОтправленныеДанные.ДокументСрокДействия Тогда
			ИзменилсяСрокДействия = Ложь;
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
		
		ИзменилсяКемВыдан = Ложь;
		Если Форма.ДокументыФизическихЛиц.КемВыдан <> Форма.ДокументыФизическихЛицПрежняя.КемВыдан И Форма.ДокументыФизическихЛиц.КемВыдан <> ОтправленныеДанные.ДокументКемВыдан Тогда
			ИзменилсяКемВыдан = Истина;
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
		
		ИзменилсяКодПодразделения = Ложь;
		Если Форма.ДокументыФизическихЛиц.КодПодразделения <> Форма.ДокументыФизическихЛицПрежняя.КодПодразделения И Форма.ДокументыФизическихЛиц.КодПодразделения <> ОтправленныеДанные.ДокументКодПодразделения Тогда
			ИзменилсяКодПодразделения = Истина;
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
		
		Если Не ИзменилисьОтправленныеДанные Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ИзменениеОтправленныхДанныхЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ТекущееСтрахование.ДоговорСтрахования);
		НаборЗаписей.Отбор.Застрахованный.Установить(Форма.ФизическоеЛицоСсылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.ДоговорСтрахования = ТекущееСтрахование.ДоговорСтрахования;
			Запись.Застрахованный = Форма.ФизическоеЛицоСсылка;
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		
		Если ИзмениласьСерия  Тогда
			Запись.ДокументСерия = Форма.ДокументыФизическихЛиц.Серия;
		КонецЕсли;
		Если ИзменилсяНомер  Тогда
			Запись.ДокументНомер = Форма.ДокументыФизическихЛиц.Номер;
		КонецЕсли;
		Если ИзмениласьДатаВыдачи  Тогда
			Запись.ДокументДатаВыдачи = Форма.ДокументыФизическихЛиц.ДатаВыдачи;
		КонецЕсли;
		Если ИзменилсяСрокДействия  Тогда
			Запись.ДокументСрокДействия = Форма.Форма.ДокументыФизическихЛиц.СрокДействия;
		КонецЕсли;
		Если ИзменилсяКемВыдан  Тогда
			Запись.ДокументКемВыдан = Форма.ДокументыФизическихЛиц.КемВыдан;
		КонецЕсли;
		Если ИзменилсяКодПодразделения  Тогда
			Запись.ДокументКодПодразделения = Форма.ДокументыФизическихЛиц.КодПодразделения;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
	
КонецПроцедуры

Функция ОтправляемыеДанныеВСтраховуюКомпанию(ДоговорСтрахования) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыСтрахованияОтправляемыеДанные.Сведение КАК Сведение,
		|	ДоговорыСтрахованияОтправляемыеДанные.СпособПроверкиЗаполнения КАК СпособПроверкиЗаполнения
		|ИЗ
		|	Справочник.ДоговорыСтрахования.ОтправляемыеДанные КАК ДоговорыСтрахованияОтправляемыеДанные
		|ГДЕ
		|	ДоговорыСтрахованияОтправляемыеДанные.Ссылка = &ДоговорСтрахования
		|	И ДоговорыСтрахованияОтправляемыеДанные.Отправлять";
	Запрос.УстановитьПараметр("ДоговорСтрахования", ДоговорСтрахования);
	ОтправляемыеДанные = Новый ТаблицаЗначений;
	ОтправляемыеДанные.Колонки.Добавить("Сведение", Новый ОписаниеТипов("Строка"));
	ОтправляемыеДанные.Колонки.Добавить("СпособПроверкиЗаполнения", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыПроверкиЗаполненияПерсональныхДанныхМедицинскогоСтрахования"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Сведение = Перечисления.ДанныеЗастрахованных.ДокументУдостоверяющийЛичность Тогда
			СведенияДокументаУдостоверяющегоЛичность = СоставСведенийДокументаУдостоверяющегоЛичность();
			Для Каждого  Сведение Из СведенияДокументаУдостоверяющегоЛичность Цикл
				НоваяСтрока = ОтправляемыеДанные.Добавить();
				НоваяСтрока.Сведение = Сведение;
				НоваяСтрока.СпособПроверкиЗаполнения = Выборка.СпособПроверкиЗаполнения;
			КонецЦикла;
		Иначе
			ИндексЗначения = Перечисления.ДанныеЗастрахованных.Индекс(Выборка.Сведение);
			НоваяСтрока = ОтправляемыеДанные.Добавить();
			НоваяСтрока.Сведение = Метаданные.Перечисления.ДанныеЗастрахованных.ЗначенияПеречисления[ИндексЗначения].Имя;
			НоваяСтрока.СпособПроверкиЗаполнения = Выборка.СпособПроверкиЗаполнения;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОтправляемыеДанные;
	
КонецФункции

Функция ТекущиеСтрахованияФизическихЛиц(ФизическиеЛица) Экспорт
	
	Если ТипЗнч(ФизическиеЛица) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		МассивФизическихЛиц = Новый Массив;
		МассивФизическихЛиц.Добавить(ФизическиеЛица);
	Иначе
		МассивФизическихЛиц = ФизическиеЛица;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних.ДоговорСтрахования КАК ДоговорСтрахования
		|ИЗ
		|	РегистрСведений.ПрограммыМедицинскогоСтрахованияСотрудников.СрезПоследних(, ФизическоеЛицо В (&ФизическиеЛица))
		|							КАК ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних
		|ГДЕ
		|	ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних.Действует";
	Запрос.УстановитьПараметр("ФизическиеЛица", МассивФизическихЛиц);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

// См. УчетОригиналовПервичныхДокументовПереопределяемый.ПриОпределенииОбъектовСКомандамиУчетаОригиналов.
Процедура ПриОпределенииОбъектовСКомандамиУчетаОригиналов(СписокОбъектов) Экспорт
	
	// Формы списков журналов документов
	СписокОбъектов.Добавить("ЖурналДокументов.МедицинскоеСтрахование.Форма.ФормаСписка");
	
	// Формы списков документов
	СписокОбъектов.Добавить("Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.Форма.ФормаСписка");
	
КонецПроцедуры

// См. УчетОригиналовПервичныхДокументовПереопределяемый.ПриОпределенииМногосотрудниковыхДокументов.
Процедура ПриОпределенииМногосотрудниковыхДокументов(СписокОбъектов) Экспорт
	
	СписокОбъектов.Вставить(Метаданные.Документы.ПрикреплениеКПрограммамМедицинскогоСтрахования.ПолноеИмя(), "Сотрудники");
	
КонецПроцедуры

// См. УчетОригиналовПервичныхДокументовПереопределяемый.ЗаполнитьТаблицуУчетаОригиналов.
Процедура ЗаполнитьТаблицуУчетаОригиналов(ТаблицаУчетаОригиналов) Экспорт
	
	// Прикрепление к программам страхования
	НоваяСтрока = ТаблицаУчетаОригиналов.Добавить();
	НоваяСтрока.ОбъектМетаданных = Метаданные.Документы.ПрикреплениеКПрограммамМедицинскогоСтрахования;
	НоваяСтрока.Идентификатор = "ЗаявлениеНаУдержание";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОтправкаПолисовДМС

Функция ПрогрессОтправки(Обработано, Всего)
	Возврат Макс(5, Окр(Обработано / Всего * 100));
КонецФункции

Процедура ОтправитьПолисДМС(ДанныеПолисаДМС, Шаблон, УчетнаяЗапись)
	
	ПараметрыПисьма = ПараметрыПисьма(ДанныеПолисаДМС, Шаблон);
	
	Письмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
	
	РезультатОтправки = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);   
	
	РегистрыСведений.ИсторияРассылкиПолисовДМС.ЗафиксироватьРезультатРассылкиПолисаДМС(ДанныеПолисаДМС, РезультатОтправки, УчетнаяЗапись);
	
КонецПроцедуры

Функция ПараметрыПисьма(ДанныеПолисаДМС, Шаблон)
	
	ИдентификаторПисьма = Новый УникальныйИдентификатор;
	
	Сообщение = ШаблоныСообщений.СформироватьСообщение(Шаблон, ДанныеПолисаДМС.ФизическоеЛицо, ИдентификаторПисьма);
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому", ДанныеПолисаДМС.АдресЭП);
	
	Вложения = Новый Массив;
	
	Если ЗначениеЗаполнено(ДанныеПолисаДМС.Полис) Тогда
		РаботаСФайламиСлужебный.СформироватьСписокФайловДляОтправкиПоПочте(Вложения, ДанныеПолисаДМС.Полис,
			ИдентификаторПисьма);
	КонецЕсли;
	
	ПараметрыПисьма.Вставить("Вложения", Вложения);
	ПараметрыПисьма.Вставить("Тема", Сообщение.Тема);
	ПараметрыПисьма.Вставить("Тело", Сообщение.Текст);
	ПараметрыПисьма.Вставить("Кодировка","UTF-8");
	ПараметрыПисьма.Вставить("Важность", ВажностьИнтернетПочтовогоСообщения.Обычная);
	ПараметрыПисьма.Вставить("ТипТекста", Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст);
		
	Возврат ПараметрыПисьма;
	
КонецФункции

#КонецОбласти

#Область ПараметрыОтправкиПисьма

Функция ТабличныйДокументПоНастройкеПечатнойФормы(НастройкаПечатнойФормы)
	
	МассивОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НастройкаПечатнойФормы.СсылкаДокумента);
	
	ПараметрыПечати = НастройкаПечатнойФормы.ДополнительныеПараметры;
	ДанныеПечати = УправлениеПечатью.СформироватьПечатныеФормы(
		НастройкаПечатнойФормы.СсылкаДокумента.Метаданные().ПолноеИмя(),
		НастройкаПечатнойФормы.ИмяМакета, МассивОбъектов, ПараметрыПечати);
	КоллекцияПечатныхФорм = ДанныеПечати.КоллекцияПечатныхФорм;
	ОбъектыПечати = ДанныеПечати.ОбъектыПечати;
	ПараметрыВывода = ДанныеПечати.ПараметрыВывода;
	
	ПечатнаяФорма = Новый ТабличныйДокумент;
	Если НастройкаПечатнойФормы.ПолноеИмяОбъекта = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
		ПараметрыИсточника = Новый Структура;
		ПараметрыИсточника.Вставить("ИдентификаторКоманды", НастройкаПечатнойФормы.ИмяМакета);
		ПараметрыИсточника.Вставить("ОбъектыНазначения", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НастройкаПечатнойФормы.СсылкаДокумента));
		УправлениеПечатью.ПечатьПоВнешнемуИсточнику(
			НастройкаПечатнойФормы.ДополнительныеПараметры.Ссылка, ПараметрыИсточника, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	Иначе
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(НастройкаПечатнойФормы.ПолноеИмяОбъекта);
		МенеджерОбъекта.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	КонецЕсли;
	Для Каждого ЭлементКоллекции Из КоллекцияПечатныхФорм Цикл
		НастройкаПечатнойФормы.ТабличныйДокумент = ЭлементКоллекции.ТабличныйДокумент;
		ПечатнаяФорма = ЭлементКоллекции.ТабличныйДокумент;
	КонецЦикла;
	
	Возврат ПечатнаяФорма;
	
КонецФункции

Функция ПоместитьТабличныеДокументыВоВременноеХранилище(Форма, ПереданныеНастройки, НастройкиПечатныхФорм)
	Перем ЗаписьZipФайла, ИмяАрхива;
	
	НастройкиСохранения = НастройкиСохранения();
	ЗаполнитьЗначенияСвойств(НастройкиСохранения, ПереданныеНастройки);
	
	Результат = Новый Массив;
	
	// подготовка архива
	Если НастройкиСохранения.УпаковатьВАрхив Тогда
		ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхива);
	КонецЕсли;
	
	// подготовка временной папки
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки);
	
	ВыбранныеФорматыСохранения = НастройкиСохранения.ФорматыСохранения;
	ПереводитьИменаФайловВТранслит = НастройкиСохранения.ПереводитьИменаФайловВТранслит;
	ТаблицаФорматов = УправлениеПечатью.НастройкиФорматовСохраненияТабличногоДокумента();
	
	// сохранение печатных форм
	ОбработанныеПечатныеФормы = Новый Массив;
	Для Каждого НастройкаПечатнойФормы Из НастройкиПечатныхФорм Цикл
		
		Если Не НастройкаПечатнойФормы.Печатать Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкаПечатнойФормы.ТабличныйДокумент = Неопределено Тогда
			ПечатнаяФорма = ТабличныйДокументПоНастройкеПечатнойФормы(НастройкаПечатнойФормы);
		Иначе
			ПечатнаяФорма = НастройкаПечатнойФормы.ТабличныйДокумент;
		КонецЕсли;
		Если ОбработанныеПечатныеФормы.Найти(ПечатнаяФорма) = Неопределено Тогда
			ОбработанныеПечатныеФормы.Добавить(ПечатнаяФорма);
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если ВычислитьИспользованиеВывода(ПечатнаяФорма) = ИспользованиеВывода.Запретить Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПечатнаяФорма.Защита Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПечатнаяФорма.ВысотаТаблицы = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПечатныеФормыПоОбъектам = Новый Соответствие;
		ПечатныеФормыПоОбъектам.Вставить(Форма.Объект.Ссылка, ПечатнаяФорма);
		Для Каждого СоответствиеОбъектаПечатнойФорме Из ПечатныеФормыПоОбъектам Цикл
			ОбъектПечати = СоответствиеОбъектаПечатнойФорме.Ключ;
			ПечатнаяФорма = СоответствиеОбъектаПечатнойФорме.Значение;
			
			Для Каждого ВыбранныйФормат Из ВыбранныеФорматыСохранения Цикл
				ТипФайла = ТипФайлаТабличногоДокумента[ВыбранныйФормат];
				НастройкиФормата = ТаблицаФорматов.НайтиСтроки(Новый Структура("ТипФайлаТабличногоДокумента", ТипФайла))[0];
				ЗаданныеИменаПечатныхФорм = ОбщегоНазначения.ЗначениеИзСтрокиXML(НастройкаПечатнойФормы.ИмяФайлаПечатнойФормы);
				
				ИмяФайла = УправлениеПечатью.ИмяФайлаПечатнойФормыОбъекта(ОбъектПечати, ЗаданныеИменаПечатныхФорм, НастройкаПечатнойФормы.Название);
				ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
				
				Если ПереводитьИменаФайловВТранслит Тогда
					ИмяФайла = СтроковыеФункции.СтрокаЛатиницей(ИмяФайла);
				КонецЕсли;
				
				ИмяФайла = ИмяФайла + "." + НастройкиФормата.Расширение;
				
				ПолноеИмяФайла = УникальноеИмяФайла(ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременнойПапки) + ИмяФайла);
				ПечатнаяФорма.Записать(ПолноеИмяФайла, ТипФайла);
				
				Если ТипФайла = ТипФайлаТабличногоДокумента.HTML Тогда
					УправлениеПечатью.ВставитьКартинкиВHTML(ПолноеИмяФайла);
				КонецЕсли;
				
				Если ЗаписьZipФайла <> Неопределено Тогда 
					ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
				Иначе
					ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
					ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Форма.УникальныйИдентификатор);
					ОписаниеФайла = Новый Структура;
					ОписаниеФайла.Вставить("Представление", ИмяФайла);
					ОписаниеФайла.Вставить("АдресВоВременномХранилище", ПутьВоВременномХранилище);
					Если ТипФайла = ТипФайлаТабличногоДокумента.ANSITXT Тогда
						ОписаниеФайла.Вставить("Кодировка", "windows-1251");
					КонецЕсли;
					Результат.Добавить(ОписаниеФайла);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// Если архив подготовлен, записываем и помещаем его во временное хранилище.
	Если ЗаписьZipФайла <> Неопределено Тогда 
		ЗаписьZipФайла.Записать();
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяАрхива);
		ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Форма.УникальныйИдентификатор);
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("Представление", ПолучитьИмяФайлаДляАрхива(Форма, НастройкиПечатныхФорм, ПереводитьИменаФайловВТранслит));
		ОписаниеФайла.Вставить("АдресВоВременномХранилище", ПутьВоВременномХранилище);
		Результат.Добавить(ОписаниеФайла);
	КонецЕсли;
	
	УдалитьФайлы(ИмяВременнойПапки);
	Если ЗначениеЗаполнено(ИмяАрхива) Тогда
		УдалитьФайлы(ИмяАрхива);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиСохранения()
	
	НастройкиСохранения = Новый Структура;
	НастройкиСохранения.Вставить("ФорматыСохранения", Новый Массив);
	НастройкиСохранения.Вставить("УпаковатьВАрхив", Ложь);
	НастройкиСохранения.Вставить("ПереводитьИменаФайловВТранслит", Ложь);
	
	Возврат НастройкиСохранения;
	
КонецФункции

Функция ВычислитьИспользованиеВывода(ТабличныйДокумент)
	Если ТабличныйДокумент.Вывод = ИспользованиеВывода.Авто Тогда
		Возврат ?(ПравоДоступа("Вывод", Метаданные), ИспользованиеВывода.Разрешить, ИспользованиеВывода.Запретить);
	Иначе
		Возврат ТабличныйДокумент.Вывод;
	КонецЕсли;
КонецФункции

Функция УникальноеИмяФайла(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	Расширение = Файл.Расширение;
	Папка = Файл.Путь;
	
	Счетчик = 1;
	Пока Файл.Существует() Цикл
		Счетчик = Счетчик + 1;
		Файл = Новый Файл(Папка + ИмяБезРасширения + " (" + Счетчик + ")" + Расширение);
	КонецЦикла;
	
	Возврат Файл.ПолноеИмя;

КонецФункции

Функция ПолучитьИмяФайлаДляАрхива(Форма, НастройкиПечатныхФорм, ПереводитьИменаФайловВТранслит)
	
	Результат = "";
	
	Для Каждого НастройкаПечатнойФормы Из НастройкиПечатныхФорм Цикл
		
		Если Не НастройкаПечатнойФормы.Печатать Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкаПечатнойФормы.ТабличныйДокумент = Неопределено Тогда
			ПечатнаяФорма = ТабличныйДокументПоНастройкеПечатнойФормы(НастройкаПечатнойФормы);
		Иначе
			ПечатнаяФорма = НастройкаПечатнойФормы.ТабличныйДокумент;
		КонецЕсли;
		
		Если ВычислитьИспользованиеВывода(ПечатнаяФорма) = ИспользованиеВывода.Запретить Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(Результат) Тогда
			Результат = НастройкаПечатнойФормы.Название;
		Иначе
			Результат = НСтр("ru = 'Документы'");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПереводитьИменаФайловВТранслит Тогда
		Результат = СтроковыеФункции.СтрокаЛатиницей(Результат);
	КонецЕсли;
	
	Возврат Результат + ".zip";
	
КонецФункции

#КонецОбласти

Функция ДатыСтрахованияОбновляемыеДокументы(ПараметрыОбновления)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрограммыСтрахованияСотрудников.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТОбновляемыеДокументы
	|ИЗ
	|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ПрограммыСтрахованияСотрудников КАК ПрограммыСтрахованияСотрудников
	|ГДЕ
	|	ПрограммыСтрахованияСотрудников.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|	И ПрограммыСтрахованияСотрудников.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрограммыСтрахованияСотрудников.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РасширенияПрограммСтрахованияСотрудников.Ссылка
	|ИЗ
	|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.РасширенияПрограммСтрахованияСотрудников КАК РасширенияПрограммСтрахованияСотрудников
	|ГДЕ
	|	РасширенияПрограммСтрахованияСотрудников.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|	И РасширенияПрограммСтрахованияСотрудников.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	РасширенияПрограммСтрахованияСотрудников.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПрограммыСтрахованияРодственников.Ссылка
	|ИЗ
	|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ПрограммыСтрахованияРодственников КАК ПрограммыСтрахованияРодственников
	|ГДЕ
	|	ПрограммыСтрахованияРодственников.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|	И ПрограммыСтрахованияРодственников.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрограммыСтрахованияРодственников.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РасширенияПрограммСтрахованияРодственников.Ссылка
	|ИЗ
	|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.РасширенияПрограммСтрахованияРодственников КАК РасширенияПрограммСтрахованияРодственников
	|ГДЕ
	|	РасширенияПрограммСтрахованияРодственников.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|	И РасширенияПрограммСтрахованияРодственников.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	РасширенияПрограммСтрахованияРодственников.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
	|	Документы.Ссылка КАК Ссылка
	|ИЗ
	|	ВТОбновляемыеДокументы КАК Документы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документы.Ссылка.Дата УБЫВ";
	
	Если ПараметрыОбновления = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 100", "");
	КонецЕсли;
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура ВыполнитьЗаполнениеДатСтрахования(ПараметрыОбновления, ОбновляемыеДокументы)
	
	Выборка = ОбновляемыеДокументы.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(
				ПараметрыОбновления, "Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования", "Ссылка", Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Для каждого СтрокаДокумента Из ДокументОбъект.Сотрудники Цикл
			ОтборСтрок = Новый Структура("Сотрудник", СтрокаДокумента.Сотрудник);
			НайденныеСтроки = ДокументОбъект.ПрограммыСтрахованияСотрудников.НайтиСтроки(ОтборСтрок);
			Для Каждого ИзменяемаяСтрока Из НайденныеСтроки Цикл
				ИзменяемаяСтрока.ДатаНачала = СтрокаДокумента.ДатаПрикрепления;
				ИзменяемаяСтрока.ДатаОкончания = ДокументОбъект.ДатаОкончанияСтрахования;
			КонецЦикла;
			НайденныеСтроки = ДокументОбъект.РасширенияПрограммСтрахованияСотрудников.НайтиСтроки(ОтборСтрок);
			Для Каждого ИзменяемаяСтрока Из НайденныеСтроки Цикл
				ИзменяемаяСтрока.ДатаНачала = СтрокаДокумента.ДатаПрикрепления;
				ИзменяемаяСтрока.ДатаОкончания = ДокументОбъект.ДатаОкончанияСтрахования;
			КонецЦикла;
		КонецЦикла;
		Для каждого СтрокаДокумента Из ДокументОбъект.Родственники Цикл
			ОтборСтрок = Новый Структура("ФизическоеЛицо, Родственник", СтрокаДокумента.ФизическоеЛицо, СтрокаДокумента.Родственник);
			НайденныеСтроки = ДокументОбъект.ПрограммыСтрахованияРодственников.НайтиСтроки(ОтборСтрок);
			Для Каждого ИзменяемаяСтрока Из НайденныеСтроки Цикл
				ИзменяемаяСтрока.ДатаНачала = СтрокаДокумента.ДатаПрикрепления;
				ИзменяемаяСтрока.ДатаОкончания = СтрокаДокумента.ДатаОткрепления;
			КонецЦикла;
			НайденныеСтроки = ДокументОбъект.РасширенияПрограммСтрахованияРодственников.НайтиСтроки(ОтборСтрок);
			Для Каждого ИзменяемаяСтрока Из НайденныеСтроки Цикл
				ИзменяемаяСтрока.ДатаНачала = СтрокаДокумента.ДатаПрикрепления;
				ИзменяемаяСтрока.ДатаОкончания = СтрокаДокумента.ДатаОткрепления;
			КонецЦикла;
		КонецЦикла;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
		
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		
	КонецЦикла;

КонецПроцедуры

Функция РодственникМедицинскогоСтрахования(ФИОРодственника)
	
	РодственникСсылка = Справочники.РодственникиФизическихЛиц.НайтиПоНаименованию(ФИОРодственника);
	Если ЗначениеЗаполнено(РодственникСсылка) Тогда
		Возврат РодственникСсылка;
	КонецЕсли;
	
	РодственникОбъект = Справочники.РодственникиФизическихЛиц.СоздатьЭлемент();
	РодственникОбъект.Наименование = ФИОРодственника;
	ФИО = СокрЛП(ФИОРодственника);
	Пока СтрНайти(ФИО, "  ") > 0 Цикл
		ФИО = СтрЗаменить(ФИО, "  ", " ");
	КонецЦикла;
	СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(ФИО);
	РодственникОбъект.Фамилия  = СтруктураФИО.Фамилия;
	РодственникОбъект.Имя = СтруктураФИО.Имя;
	РодственникОбъект.Отчество = СтруктураФИО.Отчество;
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(РодственникОбъект);
	
	Возврат РодственникОбъект.Ссылка;
	
КонецФункции

Процедура ЗаполнитьДанныеЗастрахованного(Застрахованный, ДокументПрикрепление, СтрокаСведение)
	
	НайденныеДанные = ДокументПрикрепление.ДанныеЗастрахованных.НайтиСтроки(Новый Структура("Застрахованный", Застрахованный));
	Если НайденныеДанные.Количество() = 0 Тогда
		СтрокаДанные = ДокументПрикрепление.ДанныеЗастрахованных.Добавить();
		СтрокаДанные.Застрахованный = Застрахованный;
	Иначе
		СтрокаДанные = НайденныеДанные[0];
	КонецЕсли;
	Если СтрокаСведение.СведениеИмя = "ДатаРождения" Тогда
		СтрокаДанные.ДатаРождения = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДатаРожденияДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "СтраховойНомерПФР" Тогда
		СтрокаДанные.СтраховойНомерПФР = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.СтраховойНомерПФРДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "Пол" Тогда
		СтрокаДанные.Пол = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ПолДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "Страна" Тогда
		СтрокаДанные.Страна = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.СтранаДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "ДокументПредставление" Тогда
		СтрокаДанные.ДокументПредставление = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДокументПредставлениеДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "ДокументВид" Тогда
		СтрокаДанные.ДокументВид = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДокументВидДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "ДокументСерия" Тогда
		СтрокаДанные.ДокументСерия = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДокументСерияДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "ДокументНомер" Тогда
		СтрокаДанные.ДокументНомер = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДокументНомерДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "ДокументДатаВыдачи" Тогда
		СтрокаДанные.ДокументДатаВыдачи = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДокументДатаВыдачиДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "ДокументСрокДействия" Тогда
		СтрокаДанные.ДокументСрокДействия = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДокументСрокДействияДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "ДокументКемВыдан" Тогда
		СтрокаДанные.ДокументКемВыдан = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДокументКемВыданДоИзменения = СтрокаСведение.СведениеЗначение;
	ИначеЕсли СтрокаСведение.СведениеИмя = "ДокументКодПодразделения" Тогда
		СтрокаДанные.ДокументКодПодразделения = СтрокаСведение.СведениеЗначение;
		СтрокаДанные.ДокументКодПодразделенияДоИзменения = СтрокаСведение.СведениеЗначение;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКонтактнуюИнформациюЗастрахованного(Застрахованный, ДокументПрикрепление, СтрокаСведение)
	
	ВидКИ = ВидКонтактнойИнформацииПоСведению()[СтрокаСведение.СведениеИмя];
	ОтборСтрок = Новый Структура("Застрахованный, Вид", Застрахованный, ВидКИ);
	НайденнаяКИ = ДокументПрикрепление.КонтактнаяИнформацияЗастрахованных.НайтиСтроки(ОтборСтрок);
	Если НайденнаяКИ.Количество() = 0 Тогда
		СтрокаКИ = ДокументПрикрепление.КонтактнаяИнформацияЗастрахованных.Добавить();
		СтрокаКИ.Застрахованный = Застрахованный;
		СтрокаКИ.Вид = ВидКИ;
	Иначе
		СтрокаКИ = НайденнаяКИ[0];
	КонецЕсли;
	Если СтрокаСведение.СведениеИмя = "КонтактнаяИнформация1"
		Или СтрокаСведение.СведениеИмя = "КонтактнаяИнформация2"
		Или СтрокаСведение.СведениеИмя = "КонтактнаяИнформация3"
		Или СтрокаСведение.СведениеИмя = "КонтактнаяИнформация4" Тогда
		СтрокаКИ.Значение = СтрокаСведение.СведениеЗначение;
	Иначе
		СтрокаКИ.Представление = СтрокаСведение.СведениеЗначение;
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеЗастрахованных()
	
	ДанныеЗастрахованных = Новый Структура;
	ДанныеЗастрахованных.Вставить("ДатаРождения", Истина);
	ДанныеЗастрахованных.Вставить("СтраховойНомерПФР", Истина);
	ДанныеЗастрахованных.Вставить("Пол", Истина);
	ДанныеЗастрахованных.Вставить("Страна", Истина);
	ДанныеЗастрахованных.Вставить("ДокументПредставление", Истина);
	ДанныеЗастрахованных.Вставить("ДокументВид", Истина);
	ДанныеЗастрахованных.Вставить("ДокументСерия",Истина);
	ДанныеЗастрахованных.Вставить("ДокументНомер", Истина);
	ДанныеЗастрахованных.Вставить("ДокументДатаВыдачи", Истина);
	ДанныеЗастрахованных.Вставить("ДокументСрокДействия", Истина);
	ДанныеЗастрахованных.Вставить("ДокументКемВыдан", Истина);
	ДанныеЗастрахованных.Вставить("ДокументКодПодразделения", Истина);
	ДанныеЗастрахованных.Вставить("КонтактнаяИнформация1", Ложь);
	ДанныеЗастрахованных.Вставить("КонтактнаяИнформация2", Ложь);
	ДанныеЗастрахованных.Вставить("КонтактнаяИнформация3", Ложь);
	ДанныеЗастрахованных.Вставить("КонтактнаяИнформация4", Ложь);
	ДанныеЗастрахованных.Вставить("КонтактнаяИнформация1Представление", Ложь);
	ДанныеЗастрахованных.Вставить("КонтактнаяИнформация2Представление", Ложь);
	ДанныеЗастрахованных.Вставить("КонтактнаяИнформация3Представление", Ложь);
	ДанныеЗастрахованных.Вставить("КонтактнаяИнформация4Представление", Ложь);
	
	Возврат ДанныеЗастрахованных;
	
КонецФункции

Функция ВидКонтактнойИнформацииПоСведению()
	
	СтруктураВидимостьНаФорме = Новый Структура;
	СтруктураВидимостьНаФорме.Вставить("КонтактнаяИнформация1", Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизическиеЛица);
	СтруктураВидимостьНаФорме.Вставить("КонтактнаяИнформация2", Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
	СтруктураВидимостьНаФорме.Вставить("КонтактнаяИнформация3", Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица);
	СтруктураВидимостьНаФорме.Вставить("КонтактнаяИнформация4", Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);
	СтруктураВидимостьНаФорме.Вставить("КонтактнаяИнформация1Представление", Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизическиеЛица);
	СтруктураВидимостьНаФорме.Вставить("КонтактнаяИнформация2Представление", Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
	СтруктураВидимостьНаФорме.Вставить("КонтактнаяИнформация3Представление", Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица);
	СтруктураВидимостьНаФорме.Вставить("КонтактнаяИнформация4Представление", Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);
	
	Возврат СтруктураВидимостьНаФорме;
	
КонецФункции

#Область ПоказателиРасчетаЗарплаты

Процедура ЗаполнитьИсточникДанныхПоказателейИсключений(ПоказательРасчетаЗарплаты) Экспорт
	
	Если ПоказательРасчетаЗарплаты.ИмяПредопределенныхДанных = "СтраховаяПремия"
		Или ПоказательРасчетаЗарплаты.ИмяПредопределенныхДанных = "КоличествоДнейПериодаСтрахования" Тогда
		ПоказательРасчетаЗарплаты.ПериодическийПоказательСотрудника = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьТаблицуУдержанийИзвестнымиПоказателями(ДатаУвольнения, МенеджерРасчета) Экспорт
	
	ЗначениеКалендарныеДни = ЗарплатаКадрыКлиентСервер.ДнейВПериоде(НачалоМесяца(ДатаУвольнения), ДатаУвольнения);
	ПоказательКалендарныеДни = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.КалендарныеДни");
	Для Каждого СтрокаУдержаний Из МенеджерРасчета.Зарплата.Удержания Цикл
		МенеджерРасчета.ДобавитьИзвестноеЗначениеПоказателя(СтрокаУдержаний, ПоказательКалендарныеДни, ЗначениеКалендарныеДни);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ФизическиеЛицаСУдержаниемПоГрафику(Организация, ДокументыОснованияФизическихЛиц, МенеджерВТ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДокументыОснованияФизическихЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДокументыОснованияФизическихЛиц.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ ВТДокументыОснованияФизическихЛиц
		|ИЗ
		|	&ДокументыОснованияФизическихЛиц КАК ДокументыОснованияФизическихЛиц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УдержанияМедицинскогоСтрахованияСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо,
		|	УдержанияМедицинскогоСтрахованияСрезПоследних.ДокументОснование КАК ДокументОснование,
		|	МАКСИМУМ(УдержанияМедицинскогоСтрахованияСрезПоследних.Период) КАК Период
		|ПОМЕСТИТЬ ВТУдержанияПоГрафику
		|ИЗ
		|	РегистрСведений.УдержанияМедицинскогоСтрахования.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И (ФизическоеЛицо, ДокументОснование) В
		|					(ВЫБРАТЬ
		|						ДокументыОснованияФизическихЛиц.ФизическоеЛицо,
		|						ДокументыОснованияФизическихЛиц.ДокументОснование
		|					ИЗ
		|						ВТДокументыОснованияФизическихЛиц КАК ДокументыОснованияФизическихЛиц)) КАК УдержанияМедицинскогоСтрахованияСрезПоследних
		|ГДЕ
		|	УдержанияМедицинскогоСтрахованияСрезПоследних.СпособУдержания = ЗНАЧЕНИЕ(Перечисление.СпособыУдержанияМедицинскогоСтрахованияСотрудников.ПоГрафику)
		|
		|СГРУППИРОВАТЬ ПО
		|	УдержанияМедицинскогоСтрахованияСрезПоследних.ФизическоеЛицо,
		|	УдержанияМедицинскогоСтрахованияСрезПоследних.ДокументОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УдержанияПоГрафику.ФизическоеЛицо КАК ФизическоеЛицо,
		|	УдержанияПоГрафику.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	ВТУдержанияПоГрафику КАК УдержанияПоГрафику";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДокументыОснованияФизическихЛиц", ДокументыОснованияФизическихЛиц);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ГрафикУдержаний(МесяцНачисления, МенеджерВТ, ДополнительныеСвойства)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("МесяцНачисления", МесяцНачисления);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТУдержанияПоГрафику.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ГрафикУдержанийМедицинскогоСтрахования.Дата КАК Дата,
		|	ГрафикУдержанийМедицинскогоСтрахования.ДокументОснование КАК ДокументОснование,
		|	ГрафикУдержанийМедицинскогоСтрахования.Удержание КАК Удержание,
		|	ГрафикУдержанийМедицинскогоСтрахования.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТГрафикУдержанийМедицинскогоСтрахования
		|ИЗ
		|	ВТУдержанияПоГрафику КАК ВТУдержанияПоГрафику
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикУдержанийМедицинскогоСтрахования КАК ГрафикУдержанийМедицинскогоСтрахования
		|		ПО ВТУдержанияПоГрафику.ФизическоеЛицо = ГрафикУдержанийМедицинскогоСтрахования.ФизическоеЛицо
		|			И ВТУдержанияПоГрафику.ДокументОснование = ГрафикУдержанийМедицинскогоСтрахования.ДокументОснование
		|			И ВТУдержанияПоГрафику.Период = ГрафикУдержанийМедицинскогоСтрахования.Период";
	
	Запрос.Выполнить();
	
	Если ДополнительныеСвойства.Свойство("ТаблицаПерерассчитываемыхУдержаний") Тогда
		Запрос.УстановитьПараметр("ТаблицаПерерассчитываемыхУдержаний", ДополнительныеСвойства.ТаблицаПерерассчитываемыхУдержаний);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПерерассчитываемыеУдержания.ФизическоеЛицо КАК ФизическоеЛицо,
			|	ПерерассчитываемыеУдержания.ДокументОснование КАК ДокументОснование,
			|	ПерерассчитываемыеУдержания.Удержание КАК Удержание,
			|	ПерерассчитываемыеУдержания.ДатаНачала КАК ДатаНачала
			|ПОМЕСТИТЬ ВТПерерассчитываемыеУдержания
			|ИЗ
			|	&ТаблицаПерерассчитываемыхУдержаний КАК ПерерассчитываемыеУдержания
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ГрафикУдержанийМедицинскогоСтрахования.Дата КАК Дата,
			|	ГрафикУдержанийМедицинскогоСтрахования.ФизическоеЛицо КАК ФизическоеЛицо,
			|	ГрафикУдержанийМедицинскогоСтрахования.ДокументОснование КАК ДокументОснование,
			|	ГрафикУдержанийМедицинскогоСтрахования.Удержание КАК Удержание,
			|	ГрафикУдержанийМедицинскогоСтрахования.Сумма КАК Сумма,
			|	ЛОЖЬ КАК КПерерасчету
			|ИЗ
			|	ВТГрафикУдержанийМедицинскогоСтрахования КАК ГрафикУдержанийМедицинскогоСтрахования
			|ГДЕ
			|	ГрафикУдержанийМедицинскогоСтрахования.Дата = &МесяцНачисления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ГрафикУдержанийМедицинскогоСтрахования.Дата,
			|	ГрафикУдержанийМедицинскогоСтрахования.ФизическоеЛицо,
			|	ГрафикУдержанийМедицинскогоСтрахования.ДокументОснование,
			|	ГрафикУдержанийМедицинскогоСтрахования.Удержание,
			|	ГрафикУдержанийМедицинскогоСтрахования.Сумма,
			|	ИСТИНА
			|ИЗ
			|	ВТГрафикУдержанийМедицинскогоСтрахования КАК ГрафикУдержанийМедицинскогоСтрахования
			|ГДЕ
			|	(ГрафикУдержанийМедицинскогоСтрахования.ФизическоеЛицо, ГрафикУдержанийМедицинскогоСтрахования.ДокументОснование, ГрафикУдержанийМедицинскогоСтрахования.Удержание, ГрафикУдержанийМедицинскогоСтрахования.Дата) В
			|			(ВЫБРАТЬ
			|				ПерерассчитываемыеУдержания.ФизическоеЛицо,
			|				ПерерассчитываемыеУдержания.ДокументОснование,
			|				ПерерассчитываемыеУдержания.Удержание,
			|				ПерерассчитываемыеУдержания.ДатаНачала
			|			ИЗ
			|				ВТПерерассчитываемыеУдержания КАК ПерерассчитываемыеУдержания)";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ГрафикУдержанийМедицинскогоСтрахования.Дата КАК Дата,
			|	ГрафикУдержанийМедицинскогоСтрахования.ФизическоеЛицо КАК ФизическоеЛицо,
			|	ГрафикУдержанийМедицинскогоСтрахования.ДокументОснование КАК ДокументОснование,
			|	ГрафикУдержанийМедицинскогоСтрахования.Удержание КАК Удержание,
			|	ГрафикУдержанийМедицинскогоСтрахования.Сумма КАК Сумма,
			|	ЛОЖЬ КАК КПерерасчету
			|ИЗ
			|	ВТГрафикУдержанийМедицинскогоСтрахования КАК ГрафикУдержанийМедицинскогоСтрахования
			|ГДЕ
			|	ГрафикУдержанийМедицинскогоСтрахования.Дата = &МесяцНачисления";
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗарегистрироватьИзменениеФизическогоЛицаПриЗаписи(Объект) Экспорт
	
	ТекущиеСтрахования = ТекущиеСтрахованияФизическихЛиц(Объект.Ссылка);
	Если ТекущиеСтрахования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущееСтрахование Из ТекущиеСтрахования Цикл
		ОтборСтруктура = Новый Структура("ДоговорСтрахования, Застрахованный", ТекущееСтрахование.ДоговорСтрахования, Объект.Ссылка);
			
		ОтправляемыеДанныеТаблица = ОтправляемыеДанныеВСтраховуюКомпанию(ТекущееСтрахование.ДоговорСтрахования);
		Если ОтправляемыеДанныеТаблица.Количество() > 0 Тогда
			ТаблицаОтправленныеДанные = РегистрыСведений.ОтправленныеДанныеЗастрахованных.СрезПоследних(, ОтборСтруктура);
			Если ТаблицаОтправленныеДанные.Количество() > 0 Тогда
				ОбработатьИзменениеОтправленныхДанныхФизическогоЛица(
					Объект,
					ОтправляемыеДанныеТаблица.ВыгрузитьКолонку("Сведение"),
					ТаблицаОтправленныеДанные[0],
					ТекущееСтрахование);
			КонецЕсли;
		КонецЕсли;
		
		ОтправленнаяКонтактнаяИнформация = РегистрыСведений.ОтправленнаяКонтактнаяИнформацияЗастрахованных.СрезПоследних(, ОтборСтруктура);
		Если ОтправленнаяКонтактнаяИнформация.Количество() > 0 Тогда
			ОбработатьИзменениеКонтактнойИнформацииФизическогоЛица(
				Объект,
				ОтправленнаяКонтактнаяИнформация,
				ТекущееСтрахование);
		КонецЕсли; 
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения") И УправлениеСвойствами.СвойстваДоступны() Тогда
			ОтправленныеДополнительныеРеквизитыИСведения = РегистрыСведений.ОтправленныеДополнительныеРеквизитыИСведенияЗастрахованных.СрезПоследних(, ОтборСтруктура);
			Если ОтправленныеДополнительныеРеквизитыИСведения.Количество() > 0 Тогда
				ОбработатьИзменениеДополнительныхРеквизитовИСведенийФизическогоЛица(
					Объект,
					ОтправленныеДополнительныеРеквизитыИСведения,
					ТекущееСтрахование);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗарегистрироватьИзменениеРодственникаПриЗаписи(Объект) Экспорт

	ТекущиеСтрахования = ТекущиеСтрахованияРодственника(Объект.Ссылка);
	Если ТекущиеСтрахования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ТекущееСтрахование Из ТекущиеСтрахования Цикл
		ОтборСтруктура = Новый Структура("ДоговорСтрахования, Застрахованный", ТекущееСтрахование.ДоговорСтрахования, Объект.Ссылка);
			
		ОтправляемыеДанныеТаблица = ОтправляемыеДанныеВСтраховуюКомпанию(ТекущееСтрахование.ДоговорСтрахования);
		Если ОтправляемыеДанныеТаблица.Количество() > 0 Тогда
			ТаблицаОтправленныеДанные = РегистрыСведений.ОтправленныеДанныеЗастрахованных.СрезПоследних(, ОтборСтруктура);
			Если ТаблицаОтправленныеДанные.Количество() > 0 Тогда
				ОбработатьИзменениеОтправленныхДанныхРодственника(
					Объект,
					ОтправляемыеДанныеТаблица.ВыгрузитьКолонку("Сведение"),
					ТаблицаОтправленныеДанные[0],
					ТекущееСтрахование);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗапомнитьПрежниеЗначенияГражданстваФизическихЛицПередЗаписью(Источник, Замещение, ФизическиеЛица) Экспорт
	
	ТекущиеСтрахования = ТекущиеСтрахованияФизическихЛиц(ФизическиеЛица);
	Если ТекущиеСтрахования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеСтрахованияМассив = Новый Массив;
	ЗапоминатьГражданство = Ложь;
	
	Для Каждого ТекущееСтрахование Из ТекущиеСтрахования Цикл
		ОтправляемыеДанныеТаблица = ОтправляемыеДанныеВСтраховуюКомпанию(ТекущееСтрахование.ДоговорСтрахования);
		ОтправляемыеДанные = ОтправляемыеДанныеТаблица.ВыгрузитьКолонку("Сведение");
		Если ОтправляемыеДанные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ОтправляемыеДанные.Найти("Страна") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗапоминатьГражданство = Истина;
		ТекущиеСтрахованияМассив.Добавить(Новый Структура("ДоговорСтрахования, ФизическоеЛицо", ТекущееСтрахование.ДоговорСтрахования, ТекущееСтрахование.ФизическоеЛицо));
	КонецЦикла;
	
	Если ЗапоминатьГражданство Тогда
		КадровыеДанныеФизическихЛиц = КадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, ФизическиеЛица, "Страна");
		СоответствиеПрежнееЗначениеГражданства = Новый Соответствие;
		Для Каждого СтрокаКадровыхДанных Из КадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, ФизическиеЛица, "Страна") Цикл
			СоответствиеПрежнееЗначениеГражданства.Вставить(
				СтрокаКадровыхДанных.ФизическоеЛицо, ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаКадровыхДанных));
		КонецЦикла;
		Источник.ДополнительныеСвойства.Вставить("СоответствиеПрежнееЗначениеГражданстваМедицинскогоСтрахования", СоответствиеПрежнееЗначениеГражданства);
		Источник.ДополнительныеСвойства.Вставить("ТекущиеСтрахованияМассив", ТекущиеСтрахованияМассив);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьИзменениеГражданстваМедицинскогоСтрахованияПриЗаписи(Источник, Замещение) Экспорт
	
	СоответствиеПрежнееЗначениеГражданства = Источник.ДополнительныеСвойства["СоответствиеПрежнееЗначениеГражданстваМедицинскогоСтрахования"];
	ТекущиеСтрахованияМассив = Источник.ДополнительныеСвойства["ТекущиеСтрахованияМассив"];
	
	Если РегистрыБЗК.ЭтоДобавлениеНабораЗаписей(Замещение) Тогда
		НовыйНабор = Источник.Выгрузить();
	Иначе
		НовыйНабор = РегистрыБЗК.ЗаписиНабораИзБазыДанных(Источник, Замещение);	
	КонецЕсли;
	
	Для Каждого ТекущееСтрахование Из ТекущиеСтрахованияМассив Цикл
		ОтборСтруктура = Новый Структура("ДоговорСтрахования, Застрахованный",
			ТекущееСтрахование.ДоговорСтрахования, ТекущееСтрахование.ФизическоеЛицо);
		ТаблицаОтправленныеДанные = РегистрыСведений.ОтправленныеДанныеЗастрахованных.СрезПоследних(, ОтборСтруктура);
		Если ТаблицаОтправленныеДанные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;		
		ОтправленныеДанные = ТаблицаОтправленныеДанные[0];
		
		ПрежниеКадровыеДанные = СоответствиеПрежнееЗначениеГражданства.Получить(ТекущееСтрахование.ФизическоеЛицо);
		ПрежняяСтрана = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПрежниеКадровыеДанные, "Страна");
		
		ОтборСтруктура = Новый Структура("ФизическоеЛицо", ТекущееСтрахование.ФизическоеЛицо);
		НайденныеСтрокиНовогоНабора = НовыйНабор.НайтиСтроки(ОтборСтруктура);
		НоваяСтрана = Неопределено;
		Если НайденныеСтрокиНовогоНабора.Количество() > 0 Тогда
			НоваяСтрана = НайденныеСтрокиНовогоНабора[0].Страна;
		КонецЕсли;
		
		ИзменилосьГражданство = ПрежняяСтрана <> НоваяСтрана И НоваяСтрана <> ОтправленныеДанные.Страна;		
		Если ИзменилосьГражданство = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ИзменениеОтправленныхДанныхЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ТекущееСтрахование.ДоговорСтрахования);
		НаборЗаписей.Отбор.Застрахованный.Установить(ТекущееСтрахование.ФизическоеЛицо);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.ДоговорСтрахования = ТекущееСтрахование.ДоговорСтрахования;
			Запись.Застрахованный = ТекущееСтрахование.ФизическоеЛицо;
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		Запись.Страна = НоваяСтрана;
		НаборЗаписей.Записать();		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьИзменениеОтправленныхДанныхФизическогоЛица(Объект, ОтправляемыеДанные, ОтправленныеДанные, ТекущееСтрахование)
	
	ПрежниеЗначения = Объект.ДополнительныеСвойства["ПрежниеЗначения"];
	ИзменилисьОтправленныеДанные = Ложь;
	
	ИзмениласьФамилия = Ложь;
	Если Объект.Фамилия <> ПрежниеЗначения.Фамилия Тогда
		ИзмениласьФамилия = Истина;
		Если Объект.Фамилия <> ОтправленныеДанные.Фамилия Тогда
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИзменилосьИмя = Ложь;
	Если Объект.Имя <> ПрежниеЗначения.Имя Тогда
		ИзменилосьИмя = Истина;
		Если Объект.Имя <> ОтправленныеДанные.Имя Тогда
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИзменилосьОтчество = Ложь;
	Если Объект.Отчество <> ПрежниеЗначения.Отчество Тогда
		ИзменилосьОтчество = Истина;
		Если Объект.Отчество <> ОтправленныеДанные.Отчество Тогда
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИзмениласьДатаРождения = Ложь;
	Если ОтправляемыеДанные.Найти("ДатаРождения") <> Неопределено Тогда
		Если Объект.ДатаРождения <> ПрежниеЗначения.ДатаРождения Тогда
			ИзменилисьОтправленныеДанные = Истина;
			Если Объект.ДатаРождения <> ОтправленныеДанные.ДатаРождения Тогда
				ИзмениласьДатаРождения = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ИзменилсяСНИЛС = Ложь;
	Если ОтправляемыеДанные.Найти("СтраховойНомерПФР") <> Неопределено Тогда
		Если Объект.СтраховойНомерПФР <> ПрежниеЗначения.СтраховойНомерПФР Тогда
			ИзменилисьОтправленныеДанные = Истина;
		 	Если Объект.СтраховойНомерПФР <> ОтправленныеДанные.СтраховойНомерПФР Тогда
				ИзменилсяСНИЛС = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ИзменилсяПол = Ложь;
	Если ОтправляемыеДанные.Найти("Пол") <> Неопределено Тогда
		Если Объект.Пол <> ПрежниеЗначения.Пол Тогда
			ИзменилисьОтправленныеДанные = Истина;
			Если Объект.Пол <> ОтправленныеДанные.Пол Тогда
				ИзменилсяПол = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИзменилисьОтправленныеДанные Тогда
		НаборЗаписей = РегистрыСведений.ИзменениеОтправленныхДанныхЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ТекущееСтрахование.ДоговорСтрахования);
		НаборЗаписей.Отбор.Застрахованный.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.ДоговорСтрахования = ТекущееСтрахование.ДоговорСтрахования;
			Запись.Застрахованный = Объект.Ссылка;
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		
		Запись.ИзмениласьФамилия = ИзмениласьФамилия;
		Запись.Фамилия = ?(ИзмениласьФамилия = Истина, Объект.Фамилия, Неопределено);
		
		Запись.ИзменилосьИмя = ИзменилосьИмя;
		Запись.Имя = ?(ИзменилосьИмя = Истина, Объект.Имя, Неопределено);
		
		Запись.ИзменилосьОтчество = ИзменилосьОтчество;
		Запись.Отчество = ?(ИзменилосьОтчество = Истина, Объект.Отчество, Неопределено);
		
		Запись.ИзмениласьДатаРождения = ИзмениласьДатаРождения;
		Запись.ДатаРождения = ?(ИзмениласьДатаРождения = Истина, Объект.ДатаРождения, Неопределено);
		
		Запись.ИзменилсяСтраховойНомерПФР = ИзменилсяСНИЛС;
		Запись.СтраховойНомерПФР = ?(ИзменилсяСНИЛС = Истина, Объект.СтраховойНомерПФР, Неопределено);
		
		Запись.ИзменилсяПол = ИзменилсяПол;
		Запись.Пол = ?(ИзменилсяПол = Истина, Объект.Пол, Неопределено);

		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьИзменениеКонтактнойИнформацииФизическогоЛица(Объект, ТаблицаОтправленнаяКонтактнаяИнформация, ТекущееСтрахование)
	
	ПрежниеЗначения = Объект.ДополнительныеСвойства["ПрежниеЗначения"];
	ИзмененнаяКИ = Новый Массив;
	ВосстановленнаяКИ = Новый Массив;
	
	Для Каждого ОтправленнаяКонтактнаяИнформация Из ТаблицаОтправленнаяКонтактнаяИнформация Цикл
		Если ПрежниеЗначения.Свойство("ТаблицаКИ") Тогда
			ПрежниеЗначенияКонтактнойИнформации = ПрежниеЗначения.ТаблицаКИ;
			БылоПрежнееЗначениеКИ = Ложь;
			Для Каждого ПрежнееЗначениеСтруктура Из ПрежниеЗначенияКонтактнойИнформации Цикл
				Если ПрежнееЗначениеСтруктура.Вид = ОтправленнаяКонтактнаяИнформация.Вид Тогда
					БылоПрежнееЗначениеКИ = Истина;
					НовоеПредставление = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
						Объект, ОтправленнаяКонтактнаяИнформация.Вид);
					Если Не ЗначениеЗаполнено(НовоеПредставление) Тогда
						НовоеПредставление = "";
					КонецЕсли;
					Если ПрежнееЗначениеСтруктура.Представление <> НовоеПредставление Тогда
						Если НовоеПредставление = ОтправленнаяКонтактнаяИнформация.Представление Тогда
							ВосстановленнаяКИ.Добавить(Новый Структура("Вид, Представление", ОтправленнаяКонтактнаяИнформация.Вид, НовоеПредставление));
						Иначе
							ИзмененнаяКИ.Добавить(Новый Структура("Вид, Представление", ОтправленнаяКонтактнаяИнформация.Вид, НовоеПредставление));
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если Не БылоПрежнееЗначениеКИ Тогда
				ДобавитьИзменениеКонтактнойИнформацииВМассив(Объект, ОтправленнаяКонтактнаяИнформация, ИзмененнаяКИ, ВосстановленнаяКИ);
			КонецЕсли;
		Иначе
			ДобавитьИзменениеКонтактнойИнформацииВМассив(Объект, ОтправленнаяКонтактнаяИнформация, ИзмененнаяКИ, ВосстановленнаяКИ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КИ Из ИзмененнаяКИ Цикл
		НаборЗаписей = РегистрыСведений.ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ТекущееСтрахование.ДоговорСтрахования);
		НаборЗаписей.Отбор.Застрахованный.Установить(Объект.Ссылка);
		НаборЗаписей.Отбор.Вид.Установить(КИ.Вид);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДоговорСтрахования = ТекущееСтрахование.ДоговорСтрахования;
		НоваяЗапись.Застрахованный = Объект.Ссылка;
		НоваяЗапись.Вид = КИ.Вид;
		НоваяЗапись.Представление = КИ.Представление;
		
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
	
	Для Каждого КИ Из ВосстановленнаяКИ Цикл
		НаборЗаписей = РегистрыСведений.ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ТекущееСтрахование.ДоговорСтрахования);
		НаборЗаписей.Отбор.Застрахованный.Установить(Объект.Ссылка);
		НаборЗаписей.Отбор.Вид.Установить(КИ.Вид);
		
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьИзменениеДополнительныхРеквизитовИСведенийФизическогоЛица(Объект, ТаблицаОтправленныеДополнительныеРеквизитыИСведения, ТекущееСтрахование)

	ПрежниеЗначения = Объект.ДополнительныеСвойства["ПрежниеЗначения"];
	ИзмененныеСвойства = Новый Массив;
	ВосстановленныеСвойства = Новый Массив;
	
	Если ТаблицаОтправленныеДополнительныеРеквизитыИСведения.Количество() > 0 Тогда
		Для Каждого ОтправленноеСвойство Из ТаблицаОтправленныеДополнительныеРеквизитыИСведения Цикл
			Если ПрежниеЗначения.Свойство("ДополнительныеРеквизитыИСведения") Тогда
				ПрежниеЗначенияСвойств = ПрежниеЗначения.ДополнительныеРеквизитыИСведения;
				Для Каждого ПрежнееЗначениеСтруктура Из ПрежниеЗначенияСвойств Цикл
					Если ПрежнееЗначениеСтруктура.Свойство = ОтправленноеСвойство.Свойство Тогда
						НовоеЗначение = Объект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ОтправленноеСвойство.Свойство));
						Если НовоеЗначение.Количество() > 0 Тогда
							НовоеЗначениеСвойства = НовоеЗначение[0].Значение;
						Иначе
							НовоеЗначениеСвойства = Неопределено;
						КонецЕсли;
						Если ПрежнееЗначениеСтруктура.Значение <> НовоеЗначениеСвойства Тогда
							Если НовоеЗначениеСвойства = ОтправленноеСвойство.Значение Тогда
								ВосстановленныеСвойства.Добавить(Новый Структура("Свойство, Значение", ОтправленноеСвойство.Свойство, НовоеЗначениеСвойства));
							Иначе
								ИзмененныеСвойства.Добавить(Новый Структура("Свойство, Значение", ОтправленноеСвойство.Свойство, НовоеЗначениеСвойства));
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			Иначе
				НовоеЗначение = Объект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ОтправленноеСвойство.Свойство));
				Если НовоеЗначение.Количество() > 0 Тогда
					НовоеЗначениеСвойства = НовоеЗначение[0].Значение;
				Иначе
					НовоеЗначениеСвойства = Неопределено;
				КонецЕсли;
				Если НовоеЗначениеСвойства <> Неопределено И НовоеЗначениеСвойства <> ОтправленноеСвойство.Значение Тогда
					ИзмененныеСвойства.Добавить(Новый Структура("Свойство, Значение", ОтправленноеСвойство.Свойство, НовоеЗначениеСвойства));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ИзмененноеСвойство Из ИзмененныеСвойства Цикл
		НаборЗаписей = РегистрыСведений.ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ТекущееСтрахование.ДоговорСтрахования);
		НаборЗаписей.Отбор.Застрахованный.Установить(Объект.Ссылка);
		НаборЗаписей.Отбор.Свойство.Установить(ИзмененноеСвойство.Свойство);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДоговорСтрахования = ТекущееСтрахование.ДоговорСтрахования;
		НоваяЗапись.Застрахованный = Объект.Ссылка;
		НоваяЗапись.Свойство = ИзмененноеСвойство.Свойство;
		НоваяЗапись.Значение = ИзмененноеСвойство.Значение;
		
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;

	Для Каждого ИзмененноеСвойство Из ВосстановленныеСвойства Цикл
		НаборЗаписей = РегистрыСведений.ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ТекущееСтрахование.ДоговорСтрахования);
		НаборЗаписей.Отбор.Застрахованный.Установить(Объект.Ссылка);
		НаборЗаписей.Отбор.Свойство.Установить(ИзмененноеСвойство.Свойство);
		
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьИзменениеОтправленныхДанныхРодственника(Объект, ОтправляемыеДанные, ОтправленныеДанные, ТекущееСтрахование)
	
	ПрежниеЗначения = Объект.ДополнительныеСвойства["ПрежниеЗначения"];
	ИзменилисьОтправленныеДанные = Ложь;
	
	ИзмениласьФамилия = Ложь;
	Если Объект.Фамилия <> ПрежниеЗначения.Фамилия Тогда
		ИзмениласьФамилия = Истина;
		Если Объект.Фамилия <> ОтправленныеДанные.Фамилия Тогда
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИзменилосьИмя = Ложь;
	Если Объект.Имя <> ПрежниеЗначения.Имя Тогда
		ИзменилосьИмя = Истина;
		Если Объект.Имя <> ОтправленныеДанные.Имя Тогда
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИзменилосьОтчество = Ложь;
	Если Объект.Отчество <> ПрежниеЗначения.Отчество Тогда
		ИзменилосьОтчество = Истина;
		Если Объект.Отчество <> ОтправленныеДанные.Отчество Тогда
			ИзменилисьОтправленныеДанные = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИзмениласьДатаРождения = Ложь;
	Если ОтправляемыеДанные.Найти("ДатаРождения") <> Неопределено Тогда
		Если Объект.ДатаРождения <> ПрежниеЗначения.ДатаРождения Тогда
			ИзменилисьОтправленныеДанные = Истина;
			Если Объект.ДатаРождения <> ОтправленныеДанные.ДатаРождения Тогда
				ИзмениласьДатаРождения = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ИзменилсяСНИЛС = Ложь;
	Если ОтправляемыеДанные.Найти("СтраховойНомерПФР") <> Неопределено Тогда
		Если Объект.СНИЛС <> ПрежниеЗначения.СНИЛС Тогда
			ИзменилисьОтправленныеДанные = Истина;
		 	Если Объект.СНИЛС <> ОтправленныеДанные.СтраховойНомерПФР Тогда
				ИзменилсяСНИЛС = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИзменилисьОтправленныеДанные Тогда
		НаборЗаписей = РегистрыСведений.ИзменениеОтправленныхДанныхЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ТекущееСтрахование.ДоговорСтрахования);
		НаборЗаписей.Отбор.Застрахованный.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.ДоговорСтрахования = ТекущееСтрахование.ДоговорСтрахования;
			Запись.Застрахованный = Объект.Ссылка;
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		
		Запись.ИзмениласьФамилия = ИзмениласьФамилия;
		Запись.Фамилия = ?(ИзмениласьФамилия = Истина, Объект.Фамилия, Неопределено);
		
		Запись.ИзменилосьИмя = ИзменилосьИмя;
		Запись.Имя = ?(ИзменилосьИмя = Истина, Объект.Имя, Неопределено);
		
		Запись.ИзменилосьОтчество = ИзменилосьОтчество;
		Запись.Отчество = ?(ИзменилосьОтчество = Истина, Объект.Отчество, Неопределено);
		
		Запись.ИзмениласьДатаРождения = ИзмениласьДатаРождения;
		Запись.ДатаРождения = ?(ИзмениласьДатаРождения = Истина, Объект.ДатаРождения, Неопределено);
		
		Запись.ИзменилсяСтраховойНомерПФР = ИзменилсяСНИЛС;
		Запись.СтраховойНомерПФР = ?(ИзменилсяСНИЛС = Истина, Объект.СНИЛС, Неопределено);

		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Функция ТекущиеСтрахованияРодственника(Родственник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПрограммыМедицинскогоСтрахованияСотрудниковСрезПоследних.Организация КАК Организация,
