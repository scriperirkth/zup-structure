Функция СформироватьШаблонОтправкиПолисовДМС() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ШаблоныСообщений.Ссылка КАК Шаблон
		|ИЗ
		|	Справочник.ШаблоныСообщений КАК ШаблоныСообщений
		|ГДЕ
		|	ШаблоныСообщений.ВладелецШаблона = ЗНАЧЕНИЕ(Перечисление.ИспользованиеШаблоновСообщенийДМС.РассылкаПолисовДМС)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Шаблон;
	КонецЕсли;

	// АПК:1223-выкл. Личные местоимения используются в текстах шаблонов 

	// Отправка полисов ДМС.
	ПараметрыШаблона = ШаблоныСообщений.ОписаниеПараметровШаблона();
	ПараметрыШаблона.Назначение = Метаданные.Справочники.ФизическиеЛица.Синоним;
	ПараметрыШаблона.ПолноеИмяТипаНазначения = "Справочник.ФизическиеЛица";
	ПараметрыШаблона.ТипШаблона = "Письмо";
	ПараметрыШаблона.ФорматПисьма = Перечисления.СпособыРедактированияЭлектронныхПисем.ОбычныйТекст;	
	ПараметрыШаблона.Тема = НСтр("ru = 'Полис ДМС'");
	ПараметрыШаблона.Текст = 
		НСтр("ru = 'Добрый день, [ФизическиеЛица.Имя] [ФизическиеЛица.Отчество]!
			 |
			 |Во вложении письма ваш полис ДМС.
			 |
			 |Письмо сформировано автоматически.'");
	
	ПараметрыШаблона.ВладелецШаблона = Перечисления.ИспользованиеШаблоновСообщенийДМС.РассылкаПолисовДМС;
	
	НачатьТранзакцию();
	
	Попытка
		НовыйШаблон = ШаблоныСообщений.СоздатьШаблон(НСтр("ru = 'Отправка полисов ДМС'"), ПараметрыШаблона);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Не удалось записать шаблон отправки полисов ДМС.'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.ШаблоныСообщений);
       	
		НовыйШаблон = Справочники.ШаблоныСообщений.ПустаяСсылка();
		
	КонецПопытки;
	
	// АПК:1223-вкл.
	
	Возврат НовыйШаблон;
	
КонецФункции	

