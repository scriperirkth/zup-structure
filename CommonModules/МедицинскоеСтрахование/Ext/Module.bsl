		|	ДокументыДоговорыПредварительно.Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДокументыДоговорыПредварительно.Документ КАК Документ,
		|	ДокументыДоговорыПредварительно.ЭтоПроведенноеПрикрепление КАК ЭтоПроведенноеПрикрепление,
		|	ДокументыДоговорыПредварительно.Организация КАК Организация,
		|	ДокументыДоговорыПредварительно.СтраховаяКомпания КАК СтраховаяКомпания,
		|	МИНИМУМ(ДокументыДоговорыПредварительно.ДатаНачалаСтрахования) КАК ДатаНачалаСтрахования,
		|	ДокументыДоговорыПредварительно.ДатаОкончанияСтрахования КАК ДатаОкончанияСтрахования,
		|	ДокументыДоговорыМинимальнаяДатаОкончания.ДоговорСтрахования КАК ДоговорСтрахования
		|ИЗ
		|	ВТДокументыДоговорыПредварительно КАК ДокументыДоговорыПредварительно
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДокументыДоговорыМинимальнаяДатаОкончания КАК ДокументыДоговорыМинимальнаяДатаОкончания
		|		ПО ДокументыДоговорыПредварительно.Документ = ДокументыДоговорыМинимальнаяДатаОкончания.Документ
		|		И
		|			ДокументыДоговорыПредварительно.ДатаОкончанияСтрахования = ДокументыДоговорыМинимальнаяДатаОкончания.ДатаОкончанияСтрахования
		|СГРУППИРОВАТЬ ПО
		|	ДокументыДоговорыПредварительно.Документ,
		|	ДокументыДоговорыПредварительно.ЭтоПроведенноеПрикрепление,
		|	ДокументыДоговорыПредварительно.Организация,
		|	ДокументыДоговорыПредварительно.СтраховаяКомпания,
		|	ДокументыДоговорыПредварительно.ДатаОкончанияСтрахования,
		|	ДокументыДоговорыМинимальнаяДатаОкончания.ДоговорСтрахования
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организация,
		|	СтраховаяКомпания,
		|	ДатаНачалаСтрахования,
		|	ДатаОкончанияСтрахования,
		|	ЭтоПроведенноеПрикрепление УБЫВ";
	
	РезультатОбновляемыхДанных = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);
	
	Если РезультатОбновляемыхДанных.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ВыборкаОбновляемыхДанных = Обработки.ОбходКоллекции.НовыйОбход(РезультатОбновляемыхДанных.Выгрузить());
	Пока ВыборкаОбновляемыхДанных.СледующийПоЗначениюПоля("Организация") Цикл
		Пока ВыборкаОбновляемыхДанных.СледующийПоЗначениюПоля("СтраховаяКомпания") Цикл
			Пока ВыборкаОбновляемыхДанных.СледующийПоЗначениюПоля("ДатаНачалаСтрахования") Цикл
				Пока ВыборкаОбновляемыхДанных.СледующийПоЗначениюПоля("ДатаОкончанияСтрахования") Цикл
					ДоговорСтрахования = Неопределено;
					Пока ВыборкаОбновляемыхДанных.СледующийПоЗначениюПоля("ЭтоПроведенноеПрикрепление") Цикл
						Если ДоговорСтрахования = Неопределено Тогда
							ДоговорСтрахования = ДоговорСтрахованияПоПараметрам(ВыборкаОбновляемыхДанных.ТекущиеДанные(), Сегодня);
						КонецЕсли;
						Пока ВыборкаОбновляемыхДанных.Следующий() Цикл
							ТекущиеДанные = ВыборкаОбновляемыхДанных.ТекущиеДанные();
							ОписаниеБлокировки = ОбновлениеИБ.ОписаниеБлокируемыхДанных(ТекущиеДанные.Документ.Метаданные());
							ОписаниеБлокировки.ПоляБлокировки.Ссылка = ТекущиеДанные.Документ;
							Если Не ОбновлениеИБ.НачатьОбновлениеДанных(ОписаниеБлокировки, ПараметрыОбновления) Тогда
								Продолжить;
							КонецЕсли;
							ДокументОбъект = ТекущиеДанные.Документ.ПолучитьОбъект();
							ДокументОбъект.ДоговорСтрахования = ДоговорСтрахования;
							ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьПроверкуДатыЗапретаИзменения", Истина);
							ДокументОбъект.ДополнительныеСвойства.Вставить(
								"НеФормироватьПредварительныеПерерасчетыПриЗаписи", Истина);
							ДокументОбъект.ДополнительныеСвойства.Вставить("НеПроверятьДействующиеПрикрепления", Истина);
							
							ПровестиДокумент = ДокументОбъект.Проведен;
							Если ПровестиДокумент И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПрикреплениеКПрограммамМедицинскогоСтрахования") Тогда
								СведенияОбИсправлении = ИсправлениеДокументовЗарплатаКадры.СведенияОбИсправленииДокумента(ТекущиеДанные.Документ);
								ПровестиДокумент = Не (СведенияОбИсправлении.Исправлен Или СведенияОбИсправлении.Сторнирован);
							КонецЕсли;
							
							РежимЗаписи = ?(ПровестиДокумент, РежимЗаписиДокумента.Проведение, Неопределено);
							ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект, Истина, Истина, РежимЗаписи);
							ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ЗарплатаКадры.ОсвободитьМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	
КонецПроцедуры

Процедура ЗаполнитьДоговорыСтрахованияВРешенияхОбУвольнении(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПустойДоговор", Справочники.ДоговорыСтрахования.ПустаяСсылка());
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
		|	ДокументРешениеОбУвольнении.Ссылка КАК Ссылка,
		|	ДокументРешениеОбУвольнении.Организация КАК Организация,
		|	ДокументРешениеОбУвольнении.ДатаУвольнения КАК ДатаУвольнения,
		|	ДокументРешениеОбУвольнении.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДокументРешениеОбУвольнении.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ ВТРешенияОбУвольнении
		|ИЗ
		|	Документ.РешениеОбУвольнении.ДанныеМедицинскогоСтрахования КАК РешениеОбУвольненииДанныеМедицинскогоСтрахования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОбУвольнении КАК ДокументРешениеОбУвольнении
		|		ПО РешениеОбУвольненииДанныеМедицинскогоСтрахования.Ссылка = ДокументРешениеОбУвольнении.Ссылка
		|ГДЕ
		|	РешениеОбУвольненииДанныеМедицинскогоСтрахования.ДоговорСтрахования = &ПустойДоговор
		|	И НЕ ДокументРешениеОбУвольнении.Ссылка В (&Обработанные)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	1 КАК Приоритет,
		|	ДокументРешениеОбУвольнении.Ссылка КАК Документ,
		|	РешениеОбУвольненииДанныеМедицинскогоСтрахования.УдалитьСтраховаяКомпания КАК СтраховаяКомпания,
		|	СправочникДоговорыСтрахования.Ссылка КАК ДоговорСтрахования
		|ПОМЕСТИТЬ ВТПодобранныеДоговоры
		|ИЗ
		|	Документ.РешениеОбУвольнении.ДанныеМедицинскогоСтрахования КАК РешениеОбУвольненииДанныеМедицинскогоСтрахования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТРешенияОбУвольнении КАК ДокументРешениеОбУвольнении
		|		ПО РешениеОбУвольненииДанныеМедицинскогоСтрахования.Ссылка = ДокументРешениеОбУвольнении.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСтрахования КАК СправочникДоговорыСтрахования
		|		ПО ДокументРешениеОбУвольнении.Организация = СправочникДоговорыСтрахования.Организация
		|		И РешениеОбУвольненииДанныеМедицинскогоСтрахования.УдалитьСтраховаяКомпания = СправочникДоговорыСтрахования.Владелец
		|		И ДокументРешениеОбУвольнении.ДатаУвольнения
		|			МЕЖДУ СправочникДоговорыСтрахования.ДатаНачалаСтрахования И СправочникДоговорыСтрахования.ДатаОкончанияСтрахования
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	2,
		|	ДокументРешениеОбУвольнении.Ссылка,
		|	ПрограммыДМС.ПрограммаСтрахования.СтраховаяКомпания,
		|	ПрограммыДМС.ДоговорСтрахования
		|ИЗ
		|	Документ.РешениеОбУвольнении.ДанныеМедицинскогоСтрахования КАК РешениеОбУвольненииДанныеМедицинскогоСтрахования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТРешенияОбУвольнении КАК ДокументРешениеОбУвольнении
		|		ПО РешениеОбУвольненииДанныеМедицинскогоСтрахования.Ссылка = ДокументРешениеОбУвольнении.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрограммыМедицинскогоСтрахованияСотрудников КАК ПрограммыДМС
		|		ПО ПрограммыДМС.Организация = ДокументРешениеОбУвольнении.Организация
		|		И ПрограммыДМС.ФизическоеЛицо = ДокументРешениеОбУвольнении.ФизическоеЛицо
		|		И
		|			ПрограммыДМС.ПрограммаСтрахования.СтраховаяКомпания = РешениеОбУвольненииДанныеМедицинскогоСтрахования.УдалитьСтраховаяКомпания
		|ГДЕ
		|	ВЫБОР
		|		КОГДА ПрограммыДМС.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ПрограммыДМС.ДействуетДо >= ДокументРешениеОбУвольнении.ДатаУвольнения
		|	КОНЕЦ
		|	И ПрограммыДМС.Действует
		|	И ПрограммыДМС.ДоговорСтрахования <> &ПустойДоговор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ПодобранныеДоговоры.Приоритет) КАК Приоритет,
		|	ПодобранныеДоговоры.СтраховаяКомпания КАК СтраховаяКомпания,
		|	ПодобранныеДоговоры.Документ КАК Документ
		|ПОМЕСТИТЬ ВТПодобранныеДоговорыМаксимальныйПриоритет
		|ИЗ
		|	ВТПодобранныеДоговоры КАК ПодобранныеДоговоры
		|СГРУППИРОВАТЬ ПО
		|	ПодобранныеДоговоры.СтраховаяКомпания,
		|	ПодобранныеДоговоры.Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодобранныеДоговоры.Документ КАК Документ,
		|	ПодобранныеДоговоры.СтраховаяКомпания КАК СтраховаяКомпания,
		|	МАКСИМУМ(ПодобранныеДоговоры.ДоговорСтрахования) КАК ДоговорСтрахования
		|ИЗ
		|	ВТПодобранныеДоговоры КАК ПодобранныеДоговоры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПодобранныеДоговорыМаксимальныйПриоритет КАК ПодобранныеДоговорыМаксимальныйПриоритет
		|		ПО ПодобранныеДоговоры.Документ = ПодобранныеДоговорыМаксимальныйПриоритет.Документ
		|		И ПодобранныеДоговоры.СтраховаяКомпания = ПодобранныеДоговорыМаксимальныйПриоритет.СтраховаяКомпания
		|		И ПодобранныеДоговоры.Приоритет = ПодобранныеДоговорыМаксимальныйПриоритет.Приоритет
		|СГРУППИРОВАТЬ ПО
		|	ПодобранныеДоговоры.Документ,
		|	ПодобранныеДоговоры.СтраховаяКомпания
		|
		|УПОРЯДОЧИТЬ ПО
		|	Документ,
		|	СтраховаяКомпания";
	
	Обработанные = Новый Массив;
	Если ПараметрыОбновления = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000","");
	Иначе
		Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
			ПараметрыОбновления.Вставить("Обработанные");
		Иначе
			Обработанные = ПараметрыОбновления.Обработанные;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	// АПК:1328-выкл используется при начальном заполнении ИБ.
	РезультатОбновляемыхДанных = Запрос.Выполнить();
	// АПК:1328-вкл
	Если РезультатОбновляемыхДанных.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		Обработанные, РезультатОбновляемыхДанных.Выгрузить().ВыгрузитьКолонку("Документ"));
	ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	
	ВыборкаОбновляемыхДанных = Обработки.ОбходКоллекции.НовыйОбход(РезультатОбновляемыхДанных.Выгрузить());
	Пока ВыборкаОбновляемыхДанных.СледующийПоЗначениюПоля("Документ") Цикл
		ТекущиеДанные = ВыборкаОбновляемыхДанных.ТекущиеДанные();
		ОписаниеБлокировки = ОбновлениеИБ.ОписаниеБлокируемыхДанных(ТекущиеДанные.Документ.Метаданные());
		ОписаниеБлокировки.ПоляБлокировки.Ссылка = ТекущиеДанные.Документ;
		Если Не ОбновлениеИБ.НачатьОбновлениеДанных(ОписаниеБлокировки, ПараметрыОбновления) Тогда
			Продолжить;
		КонецЕсли;
		ДокументОбъект = ТекущиеДанные.Документ.ПолучитьОбъект();
		Пока ВыборкаОбновляемыхДанных.Следующий() Цикл
			ТекущиеДанные = ВыборкаОбновляемыхДанных.ТекущиеДанные();
			Для Каждого Строка Из ДокументОбъект.ДанныеМедицинскогоСтрахования Цикл
				Если Строка.УдалитьСтраховаяКомпания = ТекущиеДанные.СтраховаяКомпания Тогда
					Строка.ДоговорСтрахования = ТекущиеДанные.ДоговорСтрахования;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьПроверкуДатыЗапретаИзменения", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить(
			"НеФормироватьПредварительныеПерерасчетыПриЗаписи", Истина);
		
		РежимЗаписи = ?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, Неопределено);
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект, Истина, Истина, РежимЗаписи);
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	КонецЦикла;
	
	ЗарплатаКадры.ОсвободитьМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	
КонецПроцедуры

Процедура ОбновитьСвойстваУдержанияЗаДМС(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	УдержанияПоКатегории = РасчетЗарплаты.УдержанияПоКатегории(Перечисления.КатегорииУдержаний.ДМС, Новый Структура("Рассчитывается", Истина));
	Если УдержанияПоКатегории.Количество() = 0 Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	СоздатьОтключитьУдержаниеЗаДМС(Новый Соответствие);
	
	ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
	
КонецПроцедуры

Процедура ДополнитьУдержанияМедицинскогоСтрахованияДанными(ПараметрыОбновления = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УдержанияМедицинскогоСтрахования.Период КАК Период,
		|	УдержанияМедицинскогоСтрахования.Регистратор КАК Регистратор,
		|	УдержанияМедицинскогоСтрахования.Организация КАК Организация,
