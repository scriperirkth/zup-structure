#Область РассылкаДокументов

Процедура ДобавитьКомандыРассылки(Команды) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	Команда = Команды.Добавить();
	Команда.ТипПараметра = Новый ОписаниеТипов("ДокументСсылка.ПрикреплениеКПрограммамМедицинскогоСтрахования");
	Команда.Представление = НСтр("ru = 'Рассылка заявлений на удержания за ДМС'");
	Команда.Назначение = РассылкаДокументов.ВидыНазначенияКомандыРассылки().ДляСписка;
	Команда.РежимЗаписи = РассылкаДокументов.РежимыЗаписиОбъектаПередВыполнениемКомандыРассылки().Проводить;
	Команда.ПечатныеФормы = РассылкаДокументовКлиентСервер.НоваяПечатнаяФорма();
	Команда.ПечатныеФормы.Идентификатор = "ЗаявлениеНаУдержание";
	Команда.ПечатныеФормы.ОбработчикПолученияДанных = 
		"Документы.ПрикреплениеКПрограммамМедицинскогоСтрахования.ДанныеЗаявленияНаУдержание";
	Команда.ТемаПисьма = НСтр("ru = 'Заявление на удержание за ДМС'");
	// АПК:374-выкл. Восклицательный знак в тексте письма, а не сообщению пользователю.
	Команда.ТекстПисьма = 
		НСтр("ru = 'Добрый день!
			 |
			 |Во вложении заявление на удержание за ДМС.
			 |Пожалуйста, распечатайте его, поставьте свою подпись в обозначенных местах и пришлите нам фотографию или скан-копию в ответ на это письмо.
			 |
			 |С уважением, Администрация.'");
	// АПК:374-вкл

КонецПроцедуры

Функция ПолисыДМСКОтправке(ПолисыДМСКОтправке, Шаблон, УчетнаяЗапись) Экспорт
	
	ДлительныеОперации.СообщитьПрогресс(5);
	ОбработаноПолисовДМС = 0;
	КоличествоПолисовДМС = ПолисыДМСКОтправке.Количество();
	
	Для Каждого ДанныеПолисаДМС Из ПолисыДМСКОтправке Цикл
		
		ОбработаноПолисовДМС = ОбработаноПолисовДМС + 1;
		
		ДлительныеОперации.СообщитьПрогресс(ПрогрессОтправки(ОбработаноПолисовДМС, КоличествоПолисовДМС));
		
		Если Не ДанныеПолисаДМС.Отправлять Тогда
			Продолжить;
		КонецЕсли;	
		
		Попытка
			ОтправитьПолисДМС(ДанныеПолисаДМС, Шаблон, УчетнаяЗапись);
			ДанныеПолисаДМС.Отправлено = Истина;
		Исключение
			ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось отправить полис ДМС получателю %1: %2'"),
				 ДанныеПолисаДМС.ФИО, ИнформацияОбОшибке);
				 
			ДанныеПолисаДМС.ТекстОшибки = ТекстСообщения;	 
				 
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Рассылка полисов ДМС'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Документы.ПрикреплениеКПрограммамМедицинскогоСтрахования, ДанныеПолисаДМС.Прикрепление, ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ПолисыДМСКОтправке;
	
КонецФункции

