////////////////////////////////////////////////////////////////////////////////
// Подсистема "Медицинское страхование"
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает данные о прикрепленных сотрудниках и родственниках
//
// Параметры:
//   МассивДокументов - Массив из ДокументСсылка.ПрикреплениеКПрограммамМедицинскогоСтрахования
//
// Возвращаемое значение:
//  Структура - структура застрахованных. Значения структуры:
//      Сотрудники - Массив - массив структур с ключами:
//      	ДокументПрикрепления - ДокументСсылка.ПрикреплениеКПрограммамМедицинскогоСтрахования - ссылка на документ прикрепления
//      	Организация - СправочникСсылка.Организации
//      	СтраховаяКомпания - СправочникСсылка.Контрагенты
//      	ДатаНачала - Дата - Дата начала страхования
//      	ДатаОкончания - Дата - Дата окончания страхования
//      	ПрограммыСтрахования - Строка
//      	РасширенияПрограммСтрахования - Строка
//      	Сведения - структура сведений о контактной информации застрахованного
//      	Сотрудник - СправочникСсылка.Сотрудники
//      	СтраховаяПремия - Число
//      Родственники - Массив - массив структур с ключами:
//      	ДокументПрикрепления - ДокументСсылка.ПрикреплениеКПрограммамМедицинскогоСтрахования - ссылка на документ прикрепления
//      	Организация - СправочникСсылка.Организации
//      	СтраховаяКомпания - СправочникСсылка.Контрагенты
//      	ДатаНачала - Дата - Дата начала страхования
//      	ДатаОкончания - Дата - Дата окончания страхования
//      	ПрограммыСтрахования - Строка
//      	РасширенияПрограммСтрахования - Строка
//      	Сведения - структура сведений о контактной информации застрахованного
//      	Родственник - СправочникСсылка.РодственникиФизическихЛиц
//      	СтраховаяПремия - Число.
//
Функция ДанныеПрикреплений(МассивДокументов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПрикреплениеКПрограммамМедицинскогоСтрахования", МассивДокументов);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрикреплениеКПрограммамМедицинскогоСтрахования.Организация КАК Организация,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахования.СтраховаяКомпания КАК СтраховаяКомпания,
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.Сотрудник КАК Сотрудник,
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.ДатаПрикрепления КАК ДатаНачала,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахования.ДатаОкончанияСтрахования КАК ДатаОкончания,
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.ПрограммыСтрахования КАК ПрограммыСтрахования,
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.РасширенияПрограммСтрахования КАК РасширенияПрограммСтрахования,
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.СтраховаяПремия КАК СтраховаяПремия,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.ДатаРождения КАК ДатаРождения,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.СтраховойНомерПФР КАК СтраховойНомерПФР,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.Пол КАК Пол,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.Страна КАК Страна,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.ДокументПредставление КАК ДокументПредставление,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных.Представление КАК ПредставлениеКИ,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных.Вид КАК ВидКИ,
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.Ссылка КАК ДокументПрикрепления
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.Сотрудники КАК МедицинскоеСтрахованиеПрикреплениеСотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования КАК ПрикреплениеКПрограммамМедицинскогоСтрахования
		|		ПО МедицинскоеСтрахованиеПрикреплениеСотрудники.Ссылка = ПрикреплениеКПрограммамМедицинскогоСтрахования.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ДанныеЗастрахованных КАК ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных
		|		ПО МедицинскоеСтрахованиеПрикреплениеСотрудники.ФизическоеЛицо = ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.Застрахованный
		|			И МедицинскоеСтрахованиеПрикреплениеСотрудники.Ссылка = ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.КонтактнаяИнформацияЗастрахованных КАК ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных
		|		ПО МедицинскоеСтрахованиеПрикреплениеСотрудники.ФизическоеЛицо = ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных.Застрахованный
		|			И МедицинскоеСтрахованиеПрикреплениеСотрудники.Ссылка = ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных.Ссылка
		|ГДЕ
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.Ссылка.Проведен = ИСТИНА
		|	И МедицинскоеСтрахованиеПрикреплениеСотрудники.Ссылка В(&ПрикреплениеКПрограммамМедицинскогоСтрахования)
		|
		|УПОРЯДОЧИТЬ ПО
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.Сотрудник,
		|	МедицинскоеСтрахованиеПрикреплениеСотрудники.ДатаПрикрепления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрикреплениеКПрограммамМедицинскогоСтрахования.Организация КАК Организация,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахования.СтраховаяКомпания КАК СтраховаяКомпания,
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.РодственникСсылка КАК Родственник,
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.ДатаПрикрепления КАК ДатаНачала,
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.ДатаОткрепления КАК ДатаОкончания,
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.ПрограммыСтрахования КАК ПрограммыСтрахования,
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.РасширенияПрограммСтрахования КАК РасширенияПрограммСтрахования,
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.СтраховаяПремия КАК СтраховаяПремия,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.ДатаРождения КАК ДатаРождения,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.СтраховойНомерПФР КАК СтраховойНомерПФР,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.Пол КАК Пол,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.Страна КАК Страна,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.ДокументПредставление КАК ДокументПредставление,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных.Вид КАК ВидКИ,
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных.Представление КАК ПредставлениеКИ,
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.Ссылка КАК ДокументПрикрепления
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.Родственники КАК МедицинскоеСтрахованиеПрикреплениеРодственники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования КАК ПрикреплениеКПрограммамМедицинскогоСтрахования
		|		ПО МедицинскоеСтрахованиеПрикреплениеРодственники.Ссылка = ПрикреплениеКПрограммамМедицинскогоСтрахования.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ДанныеЗастрахованных КАК ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных
		|		ПО МедицинскоеСтрахованиеПрикреплениеРодственники.РодственникСсылка = ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.Застрахованный
		|			И МедицинскоеСтрахованиеПрикреплениеРодственники.Ссылка = ПрикреплениеКПрограммамМедицинскогоСтрахованияДанныеЗастрахованных.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.КонтактнаяИнформацияЗастрахованных КАК ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных
		|		ПО МедицинскоеСтрахованиеПрикреплениеРодственники.РодственникСсылка = ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных.Застрахованный
		|			И МедицинскоеСтрахованиеПрикреплениеРодственники.Ссылка = ПрикреплениеКПрограммамМедицинскогоСтрахованияКонтактнаяИнформацияЗастрахованных.Ссылка
		|ГДЕ
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.Ссылка.Проведен = ИСТИНА
		|	И МедицинскоеСтрахованиеПрикреплениеРодственники.Ссылка В(&ПрикреплениеКПрограммамМедицинскогоСтрахования)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Родственник,
		|	МедицинскоеСтрахованиеПрикреплениеРодственники.ДатаПрикрепления";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеПрикреплений = Новый Структура;
	ДанныеПрикреплений.Вставить("Сотрудники", Новый Массив);
	ДанныеПрикреплений.Вставить("Родственники", Новый Массив);
	ВыборкаСотрудников = РезультатыЗапроса[РезультатыЗапроса.ВГраница()-1].Выбрать();

	Пока ВыборкаСотрудников.СледующийПоЗначениюПоля("Сотрудник") Цикл
		ДанныеСотрудника = Новый Структура;
		ДанныеСотрудника.Вставить("ДокументПрикрепления", ВыборкаСотрудников.ДокументПрикрепления);
		ДанныеСотрудника.Вставить("Организация", ВыборкаСотрудников.Организация);
		ДанныеСотрудника.Вставить("СтраховаяКомпания", ВыборкаСотрудников.СтраховаяКомпания);
		ДанныеСотрудника.Вставить("Сотрудник", ВыборкаСотрудников.Сотрудник);
		ДанныеСотрудника.Вставить("ДатаНачала", ВыборкаСотрудников.ДатаНачала);
		ДанныеСотрудника.Вставить("ДатаОкончания", ВыборкаСотрудников.ДатаОкончания);
		ДанныеСотрудника.Вставить("ПрограммыСтрахования", ВыборкаСотрудников.ПрограммыСтрахования);
		ДанныеСотрудника.Вставить("РасширенияПрограммСтрахования", ВыборкаСотрудников.РасширенияПрограммСтрахования);
		ДанныеСотрудника.Вставить("СтраховаяПремия", ВыборкаСотрудников.СтраховаяПремия);
		
		ДанныеСведений = Новый Структура;
		ДанныеСведений.Вставить("ДатаРождения", ВыборкаСотрудников.ДатаРождения);
		ДанныеСведений.Вставить("СтраховойНомерПФР", ВыборкаСотрудников.СтраховойНомерПФР);
		ДанныеСведений.Вставить("Пол", ВыборкаСотрудников.Пол);
		ДанныеСведений.Вставить("Страна", ВыборкаСотрудников.Страна);
		ДанныеСведений.Вставить("ДокументПредставление", ВыборкаСотрудников.ДокументПредставление);
		Пока ВыборкаСотрудников.Следующий() Цикл
			ДанныеСведений.Вставить(ВыборкаСотрудников.ВидКИ.ИдентификаторДляФормул, ВыборкаСотрудников.ПредставлениеКИ);
		КонецЦикла;
		ДанныеСотрудника.Вставить("Сведения", ДанныеСведений);
		
		ДанныеПрикреплений.Сотрудники.Добавить(ДанныеСотрудника);
	КонецЦикла;
	
	ВыборкаРодственников = РезультатыЗапроса[РезультатыЗапроса.ВГраница()].Выбрать();
	Пока ВыборкаРодственников.СледующийПоЗначениюПоля("Родственник") Цикл
		ДанныеРодственника = Новый Структура;
		ДанныеРодственника.Вставить("ДокументПрикрепления", ВыборкаРодственников.ДокументПрикрепления);
		ДанныеРодственника.Вставить("Организация", ВыборкаРодственников.Организация);
		ДанныеРодственника.Вставить("СтраховаяКомпания", ВыборкаРодственников.СтраховаяКомпания);
		ДанныеРодственника.Вставить("Родственник", ВыборкаРодственников.Родственник);
		ДанныеРодственника.Вставить("ДатаНачала", ВыборкаРодственников.ДатаНачала);
		ДанныеРодственника.Вставить("ДатаОкончания", ВыборкаРодственников.ДатаОкончания);
		ДанныеРодственника.Вставить("ПрограммыСтрахования", ВыборкаРодственников.ПрограммыСтрахования);
		ДанныеРодственника.Вставить("РасширенияПрограммСтрахования", ВыборкаРодственников.РасширенияПрограммСтрахования);
		ДанныеРодственника.Вставить("СтраховаяПремия", ВыборкаРодственников.СтраховаяПремия);
		
		ДанныеСведений = Новый Структура;
		ДанныеСведений.Вставить("ДатаРождения", ВыборкаРодственников.ДатаРождения);
		ДанныеСведений.Вставить("СтраховойНомерПФР", ВыборкаРодственников.СтраховойНомерПФР);
		ДанныеСведений.Вставить("Пол", ВыборкаРодственников.Пол);
		ДанныеСведений.Вставить("Страна", ВыборкаРодственников.Страна);
		ДанныеСведений.Вставить("ДокументПредставление", ВыборкаРодственников.ДокументПредставление);
		Пока ВыборкаРодственников.Следующий() Цикл
			ДанныеСведений.Вставить(ВыборкаРодственников.ВидКИ.ИдентификаторДляФормул, ВыборкаРодственников.ПредставлениеКИ);
		КонецЦикла;
		
		ДанныеРодственника.Вставить("Сведения", ДанныеСведений);
		
		ДанныеПрикреплений.Родственники.Добавить(ДанныеРодственника);
	КонецЦикла;
	
	Возврат ДанныеПрикреплений;
	
КонецФункции

// Возвращает данные о открепленных сотрудниках и родственниках
//
// Параметры:
//   МассивДокументов - Массив из ДокументСсылка.ПрикреплениеКПрограммамМедицинскогоСтрахования
//
// Возвращаемое значение:
//  Структура - структура застрахованных. Значения структуры:
//      Сотрудники - Массив - массив структур с ключами:
//      	ДокументОткрепления - ДокументСсылка.ОткреплениеОтПрограммМедицинскогоСтрахования - ссылка на документ открепления
//      	Организация - СправочникСсылка.Организации
//      	СтраховаяКомпания - СправочникСсылка.Контрагенты
//      	ДатаОткрепления - Дата - Дата открепления сотрудника
//      	ПрограммыСтрахования - Строка
//      	РасширенияПрограммСтрахования - Строка
//      	Сотрудник - СправочникСсылка.Сотрудники
//      	СтраховаяПремия - Число
//      Родственники - Массив - массив структур с ключами:
//      	ДокументОткрепления - ДокументСсылка.ОткреплениеОтПрограммМедицинскогоСтрахования - ссылка на документ открепления
//      	Организация - СправочникСсылка.Организации
//      	СтраховаяКомпания - СправочникСсылка.Контрагенты
//      	ДатаОткрепления - Дата - Дата открепления родственника
//      	ПрограммыСтрахования - Строка
//      	РасширенияПрограммСтрахования - Строка
//      	Родственник - СправочникСсылка.РодственникиФизическихЛиц
//      	СтраховаяПремия - Число.
//
Функция ДанныеОткреплений(МассивДокументов) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ОткреплениеОтПрограммМедицинскогоСтрахования", МассивДокументов);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.Ссылка КАК ДокументОткрепления,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.Ссылка.Организация КАК Организация,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.Ссылка.СтраховаяКомпания КАК СтраховаяКомпания,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.Ссылка.ДоговорСтрахования КАК ДоговорСтрахования,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.Сотрудник КАК Сотрудник,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.ДатаОткрепления КАК ДатаОткрепления,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.ПрограммыСтрахования КАК ПрограммыСтрахования,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.РасширенияПрограммСтрахования КАК РасширенияПрограммСтрахования,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.СтраховаяПремия КАК СтраховаяПремия
		|ИЗ
		|	Документ.ОткреплениеОтПрограммМедицинскогоСтрахования.Сотрудники КАК ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники
		|ГДЕ
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.Ссылка В(&ОткреплениеОтПрограммМедицинскогоСтрахования)
		|	И ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.Ссылка.Проведен = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.Сотрудник,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияСотрудники.ДатаОткрепления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.Ссылка КАК ДокументОткрепления,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.Ссылка.Организация КАК Организация,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.Ссылка.СтраховаяКомпания КАК СтраховаяКомпания,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.Ссылка.ДоговорСтрахования КАК ДоговорСтрахования,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.РодственникСсылка КАК Родственник,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.ДатаОткрепления КАК ДатаОткрепления,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.ПрограммыСтрахования КАК ПрограммыСтрахования,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.РасширенияПрограммСтрахования КАК РасширенияПрограммСтрахования,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.СтраховаяПремия КАК СтраховаяПремия
		|ИЗ
		|	Документ.ОткреплениеОтПрограммМедицинскогоСтрахования.Родственники КАК ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники
		|ГДЕ
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.Ссылка В(&ОткреплениеОтПрограммМедицинскогоСтрахования)
		|	И ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.Ссылка.Проведен = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.РодственникСсылка,
		|	ОткреплениеОтПрограммМедицинскогоСтрахованияРодственники.ДатаОткрепления";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеОткреплений = Новый Структура;
	ДанныеОткреплений.Вставить("Сотрудники", Новый Массив);
	ДанныеОткреплений.Вставить("Родственники", Новый Массив);
	
	ВыборкаСотрудников = РезультатыЗапроса[РезультатыЗапроса.ВГраница()-1].Выбрать();
	Пока ВыборкаСотрудников.СледующийПоЗначениюПоля("Сотрудник") Цикл
		ДанныеСотрудника = Новый Структура;
		ДанныеСотрудника.Вставить("ДокументОткрепления", ВыборкаСотрудников.ДокументОткрепления);
		ДанныеСотрудника.Вставить("Организация", ВыборкаСотрудников.Организация);
		ДанныеСотрудника.Вставить("СтраховаяКомпания", ВыборкаСотрудников.СтраховаяКомпания);
		ДанныеСотрудника.Вставить("ДоговорСтрахования", ВыборкаСотрудников.ДоговорСтрахования);
		ДанныеСотрудника.Вставить("Сотрудник", ВыборкаСотрудников.Сотрудник);
		ДанныеСотрудника.Вставить("ДатаОткрепления", ВыборкаСотрудников.ДатаОткрепления);
		ДанныеСотрудника.Вставить("ПрограммыСтрахования", ВыборкаСотрудников.ПрограммыСтрахования);
		ДанныеСотрудника.Вставить("РасширенияПрограммСтрахования", ВыборкаСотрудников.РасширенияПрограммСтрахования);
		ДанныеСотрудника.Вставить("СтраховаяПремия", ВыборкаСотрудников.СтраховаяПремия);
		ДанныеОткреплений.Сотрудники.Добавить(ДанныеСотрудника);
	КонецЦикла;
	
	ВыборкаРодственников = РезультатыЗапроса[РезультатыЗапроса.ВГраница()].Выбрать();
	Пока ВыборкаРодственников.СледующийПоЗначениюПоля("Родственник") Цикл
		ДанныеРодственника = Новый Структура;
		ДанныеРодственника.Вставить("ДокументОткрепления", ВыборкаРодственников.ДокументОткрепления);
		ДанныеРодственника.Вставить("Организация", ВыборкаРодственников.Организация);
		ДанныеРодственника.Вставить("СтраховаяКомпания", ВыборкаРодственников.СтраховаяКомпания);
		ДанныеРодственника.Вставить("ДоговорСтрахования", ВыборкаРодственников.ДоговорСтрахования);
		ДанныеРодственника.Вставить("Родственник", ВыборкаРодственников.Родственник);
		ДанныеРодственника.Вставить("ДатаОткрепления", ВыборкаРодственников.ДатаОткрепления);
		ДанныеРодственника.Вставить("ПрограммыСтрахования", ВыборкаРодственников.ПрограммыСтрахования);
		ДанныеРодственника.Вставить("РасширенияПрограммСтрахования", ВыборкаРодственников.РасширенияПрограммСтрахования);
		ДанныеРодственника.Вставить("СтраховаяПремия", ВыборкаРодственников.СтраховаяПремия);
		ДанныеОткреплений.Родственники.Добавить(ДанныеРодственника);
	КонецЦикла;
	
	Возврат ДанныеОткреплений;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ПолисыДМСКОтправке", Истина);
	Методы.Вставить("ДополнитьУдержанияМедицинскогоСтрахованияДанными");
	Методы.Вставить("ОбновитьСвойстваУдержанияЗаДМС");
	Методы.Вставить("ДобавитьРолиДоговоровСтрахованияВПользовательскиеПрофили");
	Методы.Вставить("СоздатьПоказателиМедицинскогоСтрахования");
	Методы.Вставить("ЗаполнитьРодственниковВДокументахПрикрепления");
	Методы.Вставить("ЗаполнитьРодственниковВДокументахОткрепления");
	Методы.Вставить("ЗаполнитьДанныеИКонтактнуюИнформациюЗастрахованныхВДокументахПрикрепления");
	Методы.Вставить("ЗаполнитьУсловияМедицинскогоСтрахованияИзПрикреплений");
