		НаборЗаписей.Отбор.СтраховаяКомпания.Установить(Выборка.СтраховаяКомпания);
		Для Каждого Сведение Из Перечисления.ДанныеЗастрахованных Цикл
			ЗаписьНабора = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьНабора, Выборка);
			ЗаписьНабора.Сведение = Сведение;
			ЗаписьНабора.Отправлять = Истина;
			ЗаписьНабора.СпособПроверкиЗаполнения = Перечисления.СпособыПроверкиЗаполненияПерсональныхДанныхМедицинскогоСтрахования.НеПроверять;
		КонецЦикла;
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОтправляемуюКонтактнуюИнформациюЗастрахованных(ПараметрыОбновления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УсловияМедицинскогоСтрахования.Организация КАК Организация,
		|	УсловияМедицинскогоСтрахования.СтраховаяКомпания КАК СтраховаяКомпания
		|ИЗ
		|	РегистрСведений.УдалитьУсловияМедицинскогоСтрахования КАК УсловияМедицинскогоСтрахования
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УдалитьОтправляемаяКонтактнаяИнформацияЗастрахованных КАК ОтправляемаяКонтактнаяИнформацияЗастрахованных
		|		ПО УсловияМедицинскогоСтрахования.Организация = ОтправляемаяКонтактнаяИнформацияЗастрахованных.Организация
		|			И УсловияМедицинскогоСтрахования.СтраховаяКомпания = ОтправляемаяКонтактнаяИнформацияЗастрахованных.СтраховаяКомпания
		|ГДЕ
		|	ОтправляемаяКонтактнаяИнформацияЗастрахованных.Организация ЕСТЬ NULL";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
	МассивОтправляемойКИ = Новый Массив;
	МассивОтправляемойКИ.Добавить(Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизическиеЛица);
	МассивОтправляемойКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
	МассивОтправляемойКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица);
	МассивОтправляемойКИ.Добавить(Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.УдалитьОтправляемаяКонтактнаяИнформацияЗастрахованных.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);
		НаборЗаписей.Отбор.СтраховаяКомпания.Установить(Выборка.СтраховаяКомпания);
		Для Каждого КИ Из МассивОтправляемойКИ Цикл
			ЗаписьНабора = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьНабора, Выборка);
			ЗаписьНабора.Вид = КИ;
			ЗаписьНабора.Отправлять = Истина;
			ЗаписьНабора.СпособПроверкиЗаполнения = Перечисления.СпособыПроверкиЗаполненияПерсональныхДанныхМедицинскогоСтрахования.НеПроверять;
		КонецЦикла;
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРодственниковВДокументахПрикрепления(ПараметрыОбновления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияСведенияРодственников.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.СведенияРодственников КАК ПрикреплениеКПрограммамМедицинскогоСтрахованияСведенияРодственников
		|ГДЕ
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияСведенияРодственников.РодственникСсылка = ЗНАЧЕНИЕ(Справочник.РодственникиФизическихЛиц.ПустаяСсылка)
		|	И ПрикреплениеКПрограммамМедицинскогоСтрахованияСведенияРодственников.Родственник <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПрикреплениеКПрограммамМедицинскогоСтрахованияСведенияРодственников.Ссылка.Дата УБЫВ";
	Если ПараметрыОбновления = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000", "");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	Иначе
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(ПараметрыОбновления, "Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования", "Ссылка", Выборка.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			
			ДокументПрикрепление = Выборка.Ссылка.ПолучитьОбъект();
			Для Каждого СтрокаРодственник Из ДокументПрикрепление.Родственники Цикл
				Если ЗначениеЗаполнено(СокрЛП(СтрокаРодственник.Родственник)) Тогда
					СтрокаРодственник.РодственникСсылка = РодственникМедицинскогоСтрахования(СокрЛП(СтрокаРодственник.Родственник));
				КонецЕсли;
			КонецЦикла;
			Для Каждого СтрокаПрограммыСтрахования Из ДокументПрикрепление.ПрограммыСтрахованияРодственников Цикл
				Если ЗначениеЗаполнено(СокрЛП(СтрокаПрограммыСтрахования.Родственник)) Тогда
					СтрокаПрограммыСтрахования.РодственникСсылка = РодственникМедицинскогоСтрахования(СокрЛП(СтрокаПрограммыСтрахования.Родственник));
				КонецЕсли;
			КонецЦикла;
			Для Каждого СтрокаРасширениеПрограммСтрахования Из ДокументПрикрепление.РасширенияПрограммСтрахованияРодственников Цикл
				Если ЗначениеЗаполнено(СокрЛП(СтрокаРасширениеПрограммСтрахования.Родственник)) Тогда
					СтрокаРасширениеПрограммСтрахования.РодственникСсылка = РодственникМедицинскогоСтрахования(СокрЛП(СтрокаРасширениеПрограммСтрахования.Родственник));
				КонецЕсли;
			КонецЦикла;
			Для Каждого СтрокаСведениеРодственника Из ДокументПрикрепление.СведенияРодственников Цикл
				Если ЗначениеЗаполнено(СокрЛП(СтрокаСведениеРодственника.Родственник)) Тогда
					СтрокаСведениеРодственника.РодственникСсылка = РодственникМедицинскогоСтрахования(СокрЛП(СтрокаСведениеРодственника.Родственник));
				КонецЕсли;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументПрикрепление);
			ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

