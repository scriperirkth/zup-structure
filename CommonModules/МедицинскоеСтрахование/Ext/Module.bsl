		|
		|УПОРЯДОЧИТЬ ПО
		|	ПрикреплениеКПрограммамМедицинскогоСтрахования.Дата УБЫВ";
	Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
		Обработанные = Новый Массив;
		ПараметрыОбновления.Вставить("Обработанные");
	ИначеЕсли ПараметрыОбновления.Обработанные = Неопределено Тогда
		Обработанные = Новый Массив;
	Иначе
		Обработанные = ПараметрыОбновления.Обработанные;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	Иначе
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Обработанные.Добавить(Выборка.Ссылка);
			ЗаполнитьПрограммыМедицинскогоСтрахованияИзПрикрепления(ПараметрыОбновления, Выборка.Ссылка);
			ЗаполнитьРасширенияПрограммМедицинскогоСтрахованияИзПрикрепления(ПараметрыОбновления, Выборка.Ссылка);
		КонецЦикла;
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьУсловияМедицинскогоСтрахованияИзОткреплений(ПараметрыОбновления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ОткреплениеОтПрограммМедицинскогоСтрахования.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОткреплениеОтПрограммМедицинскогоСтрахования КАК ОткреплениеОтПрограммМедицинскогоСтрахования
		|ГДЕ
		|	ОткреплениеОтПрограммМедицинскогоСтрахования.Проведен = ИСТИНА
		|	И НЕ ОткреплениеОтПрограммМедицинскогоСтрахования.Ссылка В (&Обработанные)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОткреплениеОтПрограммМедицинскогоСтрахования.Дата УБЫВ";
	Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
		Обработанные = Новый Массив;
		ПараметрыОбновления.Вставить("Обработанные");
	ИначеЕсли ПараметрыОбновления.Обработанные = Неопределено Тогда
		Обработанные = Новый Массив;
	Иначе
		Обработанные = ПараметрыОбновления.Обработанные;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
	Иначе
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Обработанные.Добавить(Выборка.Ссылка);
			ЗаполнитьПрограммыМедицинскогоСтрахованияИзОткрепления(ПараметрыОбновления, Выборка.Ссылка);
			ЗаполнитьРасширенияПрограммМедицинскогоСтрахованияИзОткрепления(ПараметрыОбновления, Выборка.Ссылка);
		КонецЦикла;
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПрикреплениеВДокументахИзмененияУсловийМедицинскогоСтрахования(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ИзмененияУсловий.Ссылка КАК Ссылка,
		|	ИзмененияУсловий.Организация КАК Организация,
		|	ИзмененияУсловий.СтраховаяКомпания КАК СтраховаяКомпания,
		|	ИзмененияУсловий.ДатаНачалаСтрахования КАК ДатаНачалаСтрахования,
		|	ИзмененияУсловий.ДатаИзменения КАК ДатаИзменения,
		|	ИзмененияУсловий.Основание КАК Основание
		|ПОМЕСТИТЬ ВТДокументыИзмененияУсловий
		|ИЗ
		|	Документ.ИзменениеУсловийМедицинскогоСтрахования КАК ИзмененияУсловий
		|ГДЕ
		|	НЕ ИзмененияУсловий.Ссылка В (&Обработанные)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДокументыИзмененияУсловий.Ссылка КАК Ссылка
		|ИЗ
		|	ВТДокументыИзмененияУсловий КАК ВТДокументыИзмененияУсловий";
	
	Обработанные = Новый Массив;
	Если ПараметрыОбновления = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000","");
	Иначе
		Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
			ПараметрыОбновления.Вставить("Обработанные");
		Иначе
			Обработанные = ПараметрыОбновления.Обработанные;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Обработанные, РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"));
	ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИзмененияУсловий.Ссылка КАК Ссылка,
		|	ИзмененияУсловий.Организация КАК Организация,
		|	ИзмененияУсловий.СтраховаяКомпания КАК СтраховаяКомпания,
		|	ИзмененияУсловий.ДатаНачалаСтрахования КАК ДатаНачалаСтрахования,
		|	ИзмененияУсловий.ДатаИзменения КАК ДатаИзменения,
		|	ИзмененияУсловий.Основание КАК Основание,
		|	ИзмененияУсловийСотрудники.Сотрудник КАК Сотрудник,
		|	ИзмененияУсловийСотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ИзмененияУсловийСотрудники.ДатаПрикрепления КАК ДатаПрикрепления
		|ПОМЕСТИТЬ ВТИзмененияУсловий
		|ИЗ
		|	ВТДокументыИзмененияУсловий КАК ИзмененияУсловий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеУсловийМедицинскогоСтрахования.Сотрудники КАК ИзмененияУсловийСотрудники
		|		ПО ИзмененияУсловий.Ссылка = ИзмененияУсловийСотрудники.Ссылка
		|ГДЕ
		|	ИзмененияУсловийСотрудники.Прикрепление = ЗНАЧЕНИЕ(Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Прикрепление.Ссылка КАК Ссылка,
		|	Прикрепление.Организация КАК Организация,
		|	Прикрепление.СтраховаяКомпания КАК СтраховаяКомпания,
		|	Прикрепление.ДатаНачалаСтрахования КАК ДатаНачалаСтрахования,
		|	Прикрепление.Проведен КАК Проведен,
		|	Прикрепление.ПометкаУдаления КАК ПометкаУдаления,
		|	ПрикреплениеСотрудники.Сотрудник КАК Сотрудник,
		|	ПрикреплениеСотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПрикреплениеСотрудники.ДатаПрикрепления КАК ДатаПрикрепления
		|ПОМЕСТИТЬ ВТПрикрепления
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.Сотрудники КАК ПрикреплениеСотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования КАК Прикрепление
		|		ПО ПрикреплениеСотрудники.Ссылка = Прикрепление.Ссылка
		|ГДЕ
		|	(Прикрепление.Организация, Прикрепление.СтраховаяКомпания, Прикрепление.ДатаНачалаСтрахования, ПрикреплениеСотрудники.Сотрудник, ПрикреплениеСотрудники.ДатаПрикрепления) В
		|			(ВЫБРАТЬ
		|				ИзмененияУсловий.Организация,
		|				ИзмененияУсловий.СтраховаяКомпания,
		|				ИзмененияУсловий.ДатаНачалаСтрахования,
		|				ИзмененияУсловий.Сотрудник,
		|				ИзмененияУсловий.ДатаПрикрепления
		|			ИЗ
		|				ВТИзмененияУсловий КАК ИзмененияУсловий)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	1 КАК Приоритет,
		|	ИзмененияУсловий.Организация КАК Организация,
		|	ИзмененияУсловий.СтраховаяКомпания КАК СтраховаяКомпания,
		|	ИзмененияУсловий.ДатаНачалаСтрахования КАК ДатаНачалаСтрахования,
		|	ИзмененияУсловий.Сотрудник КАК Сотрудник,
		|	ИзмененияУсловий.Основание КАК Прикрепление
		|ПОМЕСТИТЬ ВТПрикрепленияДляИзмененийУсловийСтрахования
		|ИЗ
		|	ВТИзмененияУсловий КАК ИзмененияУсловий
		|ГДЕ
		|	ИзмененияУсловий.Основание <> ЗНАЧЕНИЕ(Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	2,
		|	Прикрепления.Организация,
		|	Прикрепления.СтраховаяКомпания,
		|	Прикрепления.ДатаНачалаСтрахования,
		|	Прикрепления.Сотрудник,
		|	Прикрепления.Ссылка
		|ИЗ
		|	ВТПрикрепления КАК Прикрепления
		|ГДЕ
		|	Прикрепления.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	3,
		|	Прикрепления.Организация,
		|	Прикрепления.СтраховаяКомпания,
		|	Прикрепления.ДатаНачалаСтрахования,
		|	Прикрепления.Сотрудник,
		|	Прикрепления.Ссылка
		|ИЗ
		|	ВТПрикрепления КАК Прикрепления
		|ГДЕ
		|	НЕ Прикрепления.Проведен
		|	И НЕ Прикрепления.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	4,
		|	Прикрепления.Организация,
		|	Прикрепления.СтраховаяКомпания,
		|	Прикрепления.ДатаНачалаСтрахования,
		|	Прикрепления.Сотрудник,
		|	Прикрепления.Ссылка
		|ИЗ
		|	ВТПрикрепления КАК Прикрепления
		|ГДЕ
		|	НЕ Прикрепления.Проведен
		|	И Прикрепления.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрикрепленияДляИзмененийУсловийСтрахования.Организация КАК Организация,
		|	ПрикрепленияДляИзмененийУсловийСтрахования.СтраховаяКомпания КАК СтраховаяКомпания,
		|	ПрикрепленияДляИзмененийУсловийСтрахования.ДатаНачалаСтрахования КАК ДатаНачалаСтрахования,
		|	ПрикрепленияДляИзмененийУсловийСтрахования.Сотрудник КАК Сотрудник,
		|	МИНИМУМ(ПрикрепленияДляИзмененийУсловийСтрахования.Приоритет) КАК Приоритет
		|ПОМЕСТИТЬ ВТПрикрепленияДляИзмененийУсловийСтрахованияМинимальныйПриоритет
		|ИЗ
		|	ВТПрикрепленияДляИзмененийУсловийСтрахования КАК ПрикрепленияДляИзмененийУсловийСтрахования
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрикрепленияДляИзмененийУсловийСтрахования.Организация,
		|	ПрикрепленияДляИзмененийУсловийСтрахования.СтраховаяКомпания,
		|	ПрикрепленияДляИзмененийУсловийСтрахования.ДатаНачалаСтрахования,
		|	ПрикрепленияДляИзмененийУсловийСтрахования.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрикрепленияДляИзменений.Организация КАК Организация,
		|	ПрикрепленияДляИзменений.СтраховаяКомпания КАК СтраховаяКомпания,
		|	ПрикрепленияДляИзменений.ДатаНачалаСтрахования КАК ДатаНачалаСтрахования,
		|	ПрикрепленияДляИзменений.Сотрудник КАК Сотрудник,
		|	ПрикрепленияДляИзменений.Прикрепление КАК Прикрепление
		|ПОМЕСТИТЬ ВТПрикрепленияДляИзмененийУсловийСтрахованияПредварительно
		|ИЗ
		|	ВТПрикрепленияДляИзмененийУсловийСтрахования КАК ПрикрепленияДляИзменений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПрикрепленияДляИзмененийУсловийСтрахованияМинимальныйПриоритет КАК МинимальныйПриоритет
		|		ПО (МинимальныйПриоритет.Организация = ПрикрепленияДляИзменений.Организация)
		|			И (МинимальныйПриоритет.СтраховаяКомпания = ПрикрепленияДляИзменений.СтраховаяКомпания)
		|			И (МинимальныйПриоритет.ДатаНачалаСтрахования = ПрикрепленияДляИзменений.ДатаНачалаСтрахования)
		|			И (МинимальныйПриоритет.Сотрудник = ПрикрепленияДляИзменений.Сотрудник)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИзмененияУсловий.Ссылка КАК Ссылка,
		|	ИзмененияУсловий.Сотрудник КАК Сотрудник,
		|	МАКСИМУМ(ПрикрепленияДляИзменений.Прикрепление) КАК Прикрепление
		|ИЗ
		|	ВТИзмененияУсловий КАК ИзмененияУсловий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПрикрепленияДляИзмененийУсловийСтрахованияПредварительно КАК ПрикрепленияДляИзменений
		|		ПО ИзмененияУсловий.Организация = ПрикрепленияДляИзменений.Организация
		|			И ИзмененияУсловий.СтраховаяКомпания = ПрикрепленияДляИзменений.СтраховаяКомпания
		|			И ИзмененияУсловий.Сотрудник = ПрикрепленияДляИзменений.Сотрудник
		|			И ИзмененияУсловий.ДатаИзменения >= ПрикрепленияДляИзменений.ДатаНачалаСтрахования
		|
		|СГРУППИРОВАТЬ ПО
		|	ИзмененияУсловий.Ссылка,
		|	ИзмененияУсловий.Сотрудник
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка УБЫВ
		|ИТОГИ ПО
		|	Ссылка";
	
	ВыборкаСсылка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСсылка.Следующий() Цикл
		Если Не ОбновлениеИБ.ПодготовитьОбновлениеДанных(
			ПараметрыОбновления, "Документ.ИзменениеУсловийМедицинскогоСтрахования", "Ссылка", ВыборкаСсылка.Ссылка) Тогда
			
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = ВыборкаСсылка.Ссылка.ПолучитьОбъект();
		Выборка = ВыборкаСсылка.Выбрать();
		Пока Выборка.Следующий() Цикл
			Для Каждого ДанныеСотрудника Из ДокументОбъект.Сотрудники Цикл
				Если Не Выборка.Сотрудник = ДанныеСотрудника.Сотрудник Тогда
					Продолжить;
				КонецЕсли;
				ДанныеСотрудника.Прикрепление = Выборка.Прикрепление;
				Прервать;
			КонецЦикла;
		КонецЦикла;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьПроверкуДатыЗапретаИзменения", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("НеФормироватьПредварительныеПерерасчетыПриЗаписи", Истина);
		
		РежимЗаписи = ?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, Неопределено);
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект, Истина, Истина, РежимЗаписи);
		
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	КонецЦикла;
	
	ЗарплатаКадры.ОсвободитьМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	
КонецПроцедуры

Процедура ЗаполнитьОснованияДляПерерасчетаУдержаний(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("КатегорияУдержания", Перечисления.КатегорииУдержаний.ДМС);
	Запрос.УстановитьПараметр("СпособРасчета", Перечисления.СпособыРасчетаУдержаний.ДМС);
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 300
		|	ПерерасчетУдержаний.Организация КАК Организация,
		|	ПерерасчетУдержаний.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПерерасчетУдержаний.ПериодДействия КАК ПериодДействия,
		|	ПерерасчетУдержаний.Удержание КАК Удержание,
		|	ПерерасчетУдержаний.ДокументНачисления КАК ДокументНачисления
		|ПОМЕСТИТЬ ВТПерерасчетУдержаний
		|ИЗ
		|	РегистрСведений.ПерерасчетУдержаний КАК ПерерасчетУдержаний
		|ГДЕ
		|	ПерерасчетУдержаний.ДокументОснование = НЕОПРЕДЕЛЕНО
		|	И ПерерасчетУдержаний.Удержание.КатегорияУдержания = &КатегорияУдержания
		|	И ПерерасчетУдержаний.Удержание.СпособРасчета = &СпособРасчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПерерасчетУдержаний.Организация КАК Организация,
		|	ПерерасчетУдержаний.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПерерасчетУдержаний.ПериодДействия КАК ПериодДействия,
		|	ПерерасчетУдержаний.Удержание КАК Удержание,
		|	ПерерасчетУдержаний.ДокументНачисления КАК ДокументНачисления,
		|	Удержания.ДокументОснование КАК ДокументОснование,
		|	Удержания.ДокументОснование КАК Основание
		|ПОМЕСТИТЬ ВТПерерасчетыСОснованиями
		|ИЗ
		|	ВТПерерасчетУдержаний КАК ПерерасчетУдержаний
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.Удержания КАК Удержания
		|		ПО ПерерасчетУдержаний.Организация = Удержания.Организация
		|		И ПерерасчетУдержаний.ФизическоеЛицо = Удержания.ФизическоеЛицо
		|		И ПерерасчетУдержаний.ПериодДействия = Удержания.ПериодРегистрации
		|		И ПерерасчетУдержаний.ДокументНачисления = Удержания.Регистратор
		|		И ПерерасчетУдержаний.Удержание = Удержания.ВидРасчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПерерасчетыСОснованиями.Организация,
		|	ПерерасчетыСОснованиями.ФизическоеЛицо,
		|	ПерерасчетыСОснованиями.ПериодДействия,
		|	ПерерасчетыСОснованиями.Удержание,
		|	ПерерасчетыСОснованиями.ДокументНачисления,
		|	ЕСТЬNULL(ИзменениеУсловий.Прикрепление, ПерерасчетыСОснованиями.ДокументОснование) КАК ДокументОснование,
		|	ПерерасчетыСОснованиями.Основание
		|ИЗ
		|	ВТПерерасчетыСОснованиями КАК ПерерасчетыСОснованиями
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИзменениеУсловийМедицинскогоСтрахования.Сотрудники КАК ИзменениеУсловий
		|		ПО ПерерасчетыСОснованиями.ДокументОснование = ИзменениеУсловий.Ссылка
		|		И ПерерасчетыСОснованиями.ФизическоеЛицо = ИзменениеУсловий.ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПредварительныеПерерасчеты.РегистраторПерерасчета,
		|	ПредварительныеПерерасчеты.Организация,
		|	ПредварительныеПерерасчеты.ПериодПерерасчета,
		|	ПредварительныеПерерасчеты.ВладелецПерерасчета,
		|	ПредварительныеПерерасчеты.ТипИзменения,
		|	ПредварительныеПерерасчеты.ИзмененныеДанные,
		|	ПредварительныеПерерасчеты.ДокументОснование,
		|	ПредварительныеПерерасчеты.НачалоУчета
		|ИЗ
		|	РегистрСведений.ПредварительныеПерерасчеты КАК ПредварительныеПерерасчеты
		|ГДЕ
		|	ПредварительныеПерерасчеты.ДокументОснование = НЕОПРЕДЕЛЕНО
		|	И ПредварительныеПерерасчеты.РегистраторПерерасчета = НЕОПРЕДЕЛЕНО";
	
	ОписаниеДанных = Новый Массив;
	ОписаниеДанных.Добавить(ОбновлениеИБ.ОписаниеБлокируемыхДанных(Метаданные.РегистрыСведений.ПредварительныеПерерасчеты));
	ОписаниеДанных.Добавить(ОбновлениеИБ.ОписаниеБлокируемыхДанных(Метаданные.РегистрыСведений.ПерерасчетУдержаний));
	ОписаниеДанных.Добавить(ОбновлениеИБ.ОписаниеБлокируемыхДанных(Метаданные.РегистрыРасчета.Удержания));

	Если Не ОбновлениеИБ.НачатьОбновлениеДанных(ОписаниеДанных, ПараметрыОбновления) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатЗапросаПерерасчетУдержаний = РезультатыЗапроса[РезультатыЗапроса.ВГраница()-1];
	РезультатЗапросаПредварительныеПерерасчеты = РезультатыЗапроса[РезультатыЗапроса.ВГраница()];
	Если РезультатЗапросаПерерасчетУдержаний.Пустой() И РезультатЗапросаПредварительныеПерерасчеты.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Выборка = РезультатЗапросаПерерасчетУдержаний.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ПерерасчетУдержаний.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(Выборка.ФизическоеЛицо);
		НаборЗаписей.Отбор.ПериодДействия.Установить(Выборка.ПериодДействия);
		НаборЗаписей.Отбор.Удержание.Установить(Выборка.Удержание);
		НаборЗаписей.Отбор.ДокументНачисления.Установить(Выборка.ДокументНачисления);
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;
	
	Выборка = РезультатЗапросаПредварительныеПерерасчеты.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ПредварительныеПерерасчеты.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.РегистраторПерерасчета.Установить(Выборка.РегистраторПерерасчета);
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);
		НаборЗаписей.Отбор.ПериодПерерасчета.Установить(Выборка.ПериодПерерасчета);
		НаборЗаписей.Отбор.ВладелецПерерасчета.Установить(Выборка.ВладелецПерерасчета);
		НаборЗаписей.Отбор.ТипИзменения.Установить(Выборка.ТипИзменения);
		НаборЗаписей.Отбор.ИзмененныеДанные.Установить(Выборка.ИзмененныеДанные);
		НаборЗаписей.Отбор.ДокументОснование.Установить(Выборка.ДокументОснование);
		НаборЗаписей.Отбор.НачалоУчета.Установить(Выборка.НачалоУчета);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;
	
	ЗарплатаКадры.ОсвободитьМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	
	ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	
КонецПроцедуры

// Добавляет роли договоров страхования в непоставляемые (пользовательские) профили групп доступа.
//
// Параметры:
//   ПараметрыОбновления - Структура - Параметры отложенного обновления.
//
Процедура ДобавитьРолиДоговоровСтрахованияВПользовательскиеПрофили() Экспорт
	
	ЗаменяемыеРоли = Новый Соответствие;
	
	НовыеРоли = Новый Массив;
	НовыеРоли.Добавить(Метаданные.Роли.ДобавлениеИзменениеМедицинскогоСтрахования.Имя);
	НовыеРоли.Добавить(Метаданные.Роли.ДобавлениеИзменениеДоговоровСтрахования.Имя);
	ЗаменяемыеРоли.Вставить("ДобавлениеИзменениеМедицинскогоСтрахования", НовыеРоли);
	
	НовыеРоли = Новый Массив;
	НовыеРоли.Добавить(Метаданные.Роли.ЧтениеМедицинскогоСтрахования.Имя);
	НовыеРоли.Добавить(Метаданные.Роли.ЧтениеДоговоровСтрахования.Имя);
	ЗаменяемыеРоли.Вставить("ЧтениеМедицинскогоСтрахования", НовыеРоли);
	
	УправлениеДоступом.ЗаменитьРолиВПрофилях(ЗаменяемыеРоли);
	
КонецПроцедуры

Процедура СоздатьАктуальныеДоговорыСтрахования(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УдалитьУсловияМедицинскогоСтрахования.Организация,
		|	УдалитьУсловияМедицинскогоСтрахования.СтраховаяКомпания,
		|	УдалитьУсловияМедицинскогоСтрахования.ОткреплятьСотрудниковВОтпускеПоУходуЗаРебенком,
		|	УдалитьУсловияМедицинскогоСтрахования.СдвигДатыПрикрепления,
		|	УдалитьУсловияМедицинскогоСтрахования.НачалоПериодаСтрахования КАК ДатаНачалаСтрахования,
		|	УдалитьУсловияМедицинскогоСтрахования.ОкончаниеПериодаСтрахования КАК ДатаОкончанияСтрахования,
		|	УдалитьУсловияМедицинскогоСтрахования.ИспользуютсяРасширенияПрограмм
		|ИЗ
		|	РегистрСведений.УдалитьУсловияМедицинскогоСтрахования КАК УдалитьУсловияМедицинскогоСтрахования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыСтрахования КАК ДоговорыСтрахования
		|		ПО УдалитьУсловияМедицинскогоСтрахования.Организация = ДоговорыСтрахования.Организация
		|		И УдалитьУсловияМедицинскогоСтрахования.СтраховаяКомпания = ДоговорыСтрахования.Владелец
		|ГДЕ
		|	ДоговорыСтрахования.Организация ЕСТЬ NULL";
	
	РезультатОбновляемыхДанных = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);
	
	Если РезультатОбновляемыхДанных.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ВыборкаОбновляемыхДанных = Обработки.ОбходКоллекции.НовыйОбход(РезультатОбновляемыхДанных.Выгрузить());
	Пока ВыборкаОбновляемыхДанных.Следующий() Цикл
		ПараметрыДоговора = ВыборкаОбновляемыхДанных.ТекущиеДанные();
		ДоговорСтрахования = ДоговорСтрахованияПоПараметрам(ПараметрыДоговора, Сегодня, Истина);
		
		ЗаполнитьНовыйРегистрСведенийНаОснованииУдаленного("ИзменениеОтправленнойКонтактнойИнформацииЗастрахованных",
			ПараметрыДоговора.Организация, ПараметрыДоговора.СтраховаяКомпания, ДоговорСтрахования);
		ЗаполнитьНовыйРегистрСведенийНаОснованииУдаленного("ИзменениеОтправленныхДанныхЗастрахованных",
			ПараметрыДоговора.Организация, ПараметрыДоговора.СтраховаяКомпания, ДоговорСтрахования);
		ЗаполнитьНовыйРегистрСведенийНаОснованииУдаленного("ИзменениеОтправленныхДополнительныхРеквизитовИСведенийЗастрахованных",
			ПараметрыДоговора.Организация, ПараметрыДоговора.СтраховаяКомпания, ДоговорСтрахования);
		ЗаполнитьНовыйРегистрСведенийНаОснованииУдаленного("ОтложенноеМедицинскоеСтрахованиеСотрудников",
			ПараметрыДоговора.Организация, ПараметрыДоговора.СтраховаяКомпания, ДоговорСтрахования);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДоговорыСтрахованияВДокументахДМС(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПустойДоговор", Справочники.ДоговорыСтрахования.ПустаяСсылка());
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрограммыМедицинскогоСтрахованияСотрудников.Организация КАК Организация,
		|	ВЫРАЗИТЬ(ПрограммыМедицинскогоСтрахованияСотрудников.Регистратор КАК
		|		Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования) КАК Документ,
		|	ВЫРАЗИТЬ(ПрограммыМедицинскогоСтрахованияСотрудников.Регистратор КАК
		|		Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования).СтраховаяКомпания КАК СтраховаяКомпания,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ПрограммыМедицинскогоСтрахованияСотрудников.Регистратор КАК
		|			Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования).ДатаНачалаСтрахования = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ПрограммыМедицинскогоСтрахованияСотрудников.Период
		|		КОГДА ВЫРАЗИТЬ(ПрограммыМедицинскогоСтрахованияСотрудников.Регистратор КАК
		|			Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования).ДатаНачалаСтрахования < ПрограммыМедицинскогоСтрахованияСотрудников.Период
		|			ТОГДА ВЫРАЗИТЬ(ПрограммыМедицинскогоСтрахованияСотрудников.Регистратор КАК
		|				Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования).ДатаНачалаСтрахования
		|		ИНАЧЕ ПрограммыМедицинскогоСтрахованияСотрудников.Период
		|	КОНЕЦ КАК ДатаНачалаСтрахования,
		|	ПрограммыМедицинскогоСтрахованияСотрудников.ДействуетДо КАК ДатаОкончанияСтрахования
		|ПОМЕСТИТЬ ВТДокументы
		|ИЗ
		|	РегистрСведений.ПрограммыМедицинскогоСтрахованияСотрудников КАК ПрограммыМедицинскогоСтрахованияСотрудников
		|ГДЕ
		|	ПрограммыМедицинскогоСтрахованияСотрудников.Регистратор
		|		ССЫЛКА Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования
		|	И ВЫРАЗИТЬ(ПрограммыМедицинскогоСтрахованияСотрудников.Регистратор КАК
		|		Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования).ДоговорСтрахования = &ПустойДоговор
		|
		|ОБЪЕДИНИТЬ ВСЕ
