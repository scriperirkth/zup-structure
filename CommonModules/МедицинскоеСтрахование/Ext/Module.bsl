		|			И ОткреплениеПрограммыСтрахованияРодственников.Родственник = ОткреплениеРодственники.Родственник
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОткреплениеОтПрограммМедицинскогоСтрахования КАК ТаблицаДокумента
		|		ПО ОткреплениеПрограммыСтрахованияРодственников.Ссылка = ТаблицаДокумента.Ссылка
		|ГДЕ
		|	ТаблицаДокумента.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Открепление);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(ПараметрыОбновления, "РегистрСведений.ПрограммыМедицинскогоСтрахованияСотрудников.НаборЗаписей", "Регистратор", Открепление) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ПрограммыМедицинскогоСтрахованияСотрудников.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Открепление);
	Пока Результат.Следующий() Цикл
		СтрокаНабора = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНабора, Результат);
		СтрокаНабора.Регистратор = Открепление;
		НаборЗаписей.Записать();
	КонецЦикла;
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	
КонецПроцедуры

Процедура ЗаполнитьРасширенияПрограммМедицинскогоСтрахованияИзОткрепления(ПараметрыОбновления, Открепление)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДокумента.Организация КАК Организация,
		|	ОткреплениеСотрудники.Сотрудник.ФизическоеЛицо КАК ФизическоеЛицо,
		|	"""" КАК Родственник,
		|	ОткреплениеРасширенияПрограммСтрахованияСотрудников.РасширениеСтрахования КАК РасширениеПрограммСтрахования,
		|	ЛОЖЬ КАК Действует,
		|	ОткреплениеСотрудники.ДатаОткрепления КАК Период,
		|	ОткреплениеСотрудники.ДатаОткрепления КАК ДействуетДо,
		|	ОткреплениеРасширенияПрограммСтрахованияСотрудников.СтраховаяПремия КАК СтраховаяПремия
		|ИЗ
		|	Документ.ОткреплениеОтПрограммМедицинскогоСтрахования.РасширенияПрограммСтрахованияСотрудников КАК ОткреплениеРасширенияПрограммСтрахованияСотрудников
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОткреплениеОтПрограммМедицинскогоСтрахования.Сотрудники КАК ОткреплениеСотрудники
		|		ПО ОткреплениеРасширенияПрограммСтрахованияСотрудников.Ссылка = ОткреплениеСотрудники.Ссылка
		|			И ОткреплениеРасширенияПрограммСтрахованияСотрудников.Сотрудник = ОткреплениеСотрудники.Сотрудник
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОткреплениеОтПрограммМедицинскогоСтрахования КАК ТаблицаДокумента
		|		ПО ОткреплениеРасширенияПрограммСтрахованияСотрудников.Ссылка = ТаблицаДокумента.Ссылка
		|ГДЕ
		|	ТаблицаДокумента.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТаблицаДокумента.Организация,
		|	ОткреплениеРодственники.ФизическоеЛицо,
		|	ОткреплениеРасширенияПрограммСтрахованияРодственников.РодственникСсылка,
		|	ОткреплениеРасширенияПрограммСтрахованияРодственников.РасширениеСтрахования,
		|	ЛОЖЬ,
		|	ОткреплениеРодственники.ДатаОткрепления,
		|	ОткреплениеРодственники.ДатаОткрепления,
		|	ОткреплениеРасширенияПрограммСтрахованияРодственников.СтраховаяПремия
		|ИЗ
		|	Документ.ОткреплениеОтПрограммМедицинскогоСтрахования.РасширенияПрограммСтрахованияРодственников КАК ОткреплениеРасширенияПрограммСтрахованияРодственников
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОткреплениеОтПрограммМедицинскогоСтрахования.Родственники КАК ОткреплениеРодственники
		|		ПО ОткреплениеРасширенияПрограммСтрахованияРодственников.Ссылка = ОткреплениеРодственники.Ссылка
		|			И ОткреплениеРасширенияПрограммСтрахованияРодственников.ФизическоеЛицо = ОткреплениеРодственники.ФизическоеЛицо
		|			И ОткреплениеРасширенияПрограммСтрахованияРодственников.Родственник = ОткреплениеРодственники.Родственник
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОткреплениеОтПрограммМедицинскогоСтрахования КАК ТаблицаДокумента
		|		ПО ОткреплениеРасширенияПрограммСтрахованияРодственников.Ссылка = ТаблицаДокумента.Ссылка
		|ГДЕ
		|	ТаблицаДокумента.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Открепление);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(ПараметрыОбновления, "РегистрСведений.РасширенияПрограммМедицинскогоСтрахованияСотрудников.НаборЗаписей", "Регистратор", Открепление) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.РасширенияПрограммМедицинскогоСтрахованияСотрудников.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Открепление);
	Пока Результат.Следующий() Цикл
		СтрокаНабора = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНабора, Результат);
		СтрокаНабора.Регистратор = Открепление;
		НаборЗаписей.Записать();
	КонецЦикла;
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	
КонецПроцедуры

Процедура ДобавитьИзменениеКонтактнойИнформацииВМассив(Объект, ОтправленнаяКонтактнаяИнформация, ИзмененнаяКИ, ВосстановленнаяКИ)
	
	НовоеПредставление = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
		Объект, ОтправленнаяКонтактнаяИнформация.Вид);
	Если Не ЗначениеЗаполнено(НовоеПредставление) Тогда
		НовоеПредставление = "";
	КонецЕсли;
	Если НовоеПредставление = ОтправленнаяКонтактнаяИнформация.Представление Тогда
		ВосстановленнаяКИ.Добавить(Новый Структура("Вид, Представление", ОтправленнаяКонтактнаяИнформация.Вид, НовоеПредставление));
	Иначе
		ИзмененнаяКИ.Добавить(Новый Структура("Вид, Представление", ОтправленнаяКонтактнаяИнформация.Вид, НовоеПредставление));
	КонецЕсли;
	
КонецПроцедуры

Функция ДоговорСтрахованияПоПараметрам(ПараметрыДоговора, ДатаСозданияДоговора, ЗаполнитьУсловиямиПоУмолчанию = Ложь)
	
	ДоговорСтрахования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыДоговора, "ДоговорСтрахования");
	Если ЗначениеЗаполнено(ДоговорСтрахования) Тогда
		Возврат ДоговорСтрахования;
	КонецЕсли;
	
	ДоговорСтрахованияОбъект = Справочники.ДоговорыСтрахования.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(ДоговорСтрахованияОбъект, ПараметрыДоговора);
	ДоговорСтрахованияОбъект.Наименование = СтрШаблон(НСтр("ru = '%1 с %2'"),
		ПараметрыДоговора.Организация, ПараметрыДоговора.СтраховаяКомпания);
	ДоговорСтрахованияОбъект.Номер = НСтр("ru = '____'");
	ДоговорСтрахованияОбъект.Владелец = ПараметрыДоговора.СтраховаяКомпания;
	ДоговорСтрахованияОбъект.ДоговорЗакрыт = ДоговорСтрахованияОбъект.ДатаОкончанияСтрахования < ДатаСозданияДоговора;
	ДоговорСтрахованияОбъект.Комментарий = НСтр("ru = 'Создан автоматически при переходе на учет по соглашениям'");
	
	Если ЗаполнитьУсловиямиПоУмолчанию Тогда
		ЗаполнитьУсловияДоговораНаОснованииУсловийПоУмолчанию(
			ДоговорСтрахованияОбъект, ПараметрыДоговора.Организация, ПараметрыДоговора.СтраховаяКомпания);
	Иначе
		ЗаполнитьУсловияДоговораНаОснованииПрикрепления(ДоговорСтрахованияОбъект, ПараметрыДоговора.Документ);
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДоговорСтрахованияОбъект);
	
	Возврат ДоговорСтрахованияОбъект.Ссылка;
	
КонецФункции

Процедура ЗаполнитьУсловияДоговораНаОснованииУсловийПоУмолчанию(ДоговорСтрахованияОбъект, Организация, СтраховаяКомпания)
	
	// Программы страхования
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УдалитьПрограммыМедицинскогоСтрахованияПоУмолчанию.ПрограммаСтрахования
		|ИЗ
		|	РегистрСведений.УдалитьПрограммыМедицинскогоСтрахованияПоУмолчанию КАК
		|		УдалитьПрограммыМедицинскогоСтрахованияПоУмолчанию
		|ГДЕ
		|	УдалитьПрограммыМедицинскогоСтрахованияПоУмолчанию.Организация = &Организация
		|	И УдалитьПрограммыМедицинскогоСтрахованияПоУмолчанию.ПрограммаСтрахования.СтраховаяКомпания = &СтраховаяКомпания";
	
	Запрос.УстановитьПараметр("СтраховаяКомпания", СтраховаяКомпания);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = ДоговорСтрахованияОбъект.ПрограммыМедицинскогоСтрахования.Добавить();
		НоваяСтрока.Программа = ВыборкаДетальныеЗаписи.ПрограммаСтрахования;
	КонецЦикла;
	
	// Адреса рассылки
	НаборЗаписей = РегистрыСведений.УдалитьАдресаОтправкиУведомленийСтраховыхКомпаний.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	НаборЗаписей.Прочитать();
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		НоваяСтрока = ДоговорСтрахованияОбъект.АдресаРассылки.Добавить();
		НоваяСтрока.Email = ЗаписьНабора.Email;
	КонецЦикла;
	
	// Шкала возраста
	НаборЗаписей = РегистрыСведений.УдалитьВозрастныеКоэффициентыСтраховыхКомпаний.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	НаборЗаписей.Прочитать();
	ТаблицаШкалы = НаборЗаписей.Выгрузить();
	ТаблицаШкалы.Сортировать("ИндексСтроки");
	
	ЗначениеДоПредыдущее = 0;
	Для Каждого ТекСтрока Из ТаблицаШкалы Цикл 
		НоваяСтрока = ДоговорСтрахованияОбъект.ШкалаВозрастаДляСотрудников.Добавить();
		НоваяСтрока.ЗначениеОт = ЗначениеДоПредыдущее;
		НоваяСтрока.ЗначениеДо = ТекСтрока.ВерхняяГраницаИнтервалаВозраста;
		НоваяСтрока.ЗначениеПоказателя = ТекСтрока.ЗначениеПоказателя;
		МедицинскоеСтрахованиеКлиентСервер.СформироватьПредставлениеИнтервалаШкалыВозраста(НоваяСтрока);
		
		ЗначениеДоПредыдущее = НоваяСтрока.ЗначениеДо + 1;
	КонецЦикла;
	
	// Шкала возраста для родственников
	НаборЗаписей = РегистрыСведений.УдалитьВозрастныеКоэффициентыСтраховыхКомпанийДляРодственников.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	НаборЗаписей.Прочитать();
	ТаблицаШкалы = НаборЗаписей.Выгрузить();
	ТаблицаШкалы.Сортировать("ИндексСтроки");
	
	ЗначениеДоПредыдущее = 0;
	Для Каждого ТекСтрока Из ТаблицаШкалы Цикл 
		НоваяСтрока = ДоговорСтрахованияОбъект.ШкалаВозрастаДляРодственников.Добавить();
		НоваяСтрока.ЗначениеОт = ЗначениеДоПредыдущее;
		НоваяСтрока.ЗначениеДо = ТекСтрока.ВерхняяГраницаИнтервалаВозраста;
		НоваяСтрока.ЗначениеПоказателя = ТекСтрока.ЗначениеПоказателя;
		МедицинскоеСтрахованиеКлиентСервер.СформироватьПредставлениеИнтервалаШкалыВозраста(НоваяСтрока);
		
		ЗначениеДоПредыдущее = НоваяСтрока.ЗначениеДо + 1;
	КонецЦикла;
	
	// Настройки удержаний
	НаборЗаписей = РегистрыСведений.УдалитьНастройкиУдержанийМедицинскогоСтрахования.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		ЗаписьНабора = НаборЗаписей[0];
		ДоговорСтрахованияОбъект.Удержание = ЗаписьНабора.Удержание;
		ДоговорСтрахованияОбъект.СпособУдержания = ЗаписьНабора.СпособУдержания;
		ДоговорСтрахованияОбъект.ТребуетсяУдержание = Истина;
		ДоговорСтрахованияОбъект.УдерживатьЗаСотрудника = ЗаписьНабора.УдержаниеЗаСотрудника;
		ДоговорСтрахованияОбъект.УдерживатьЗаРодственников = ЗаписьНабора.УдержаниеЗаРодственников;
		ДоговорСтрахованияОбъект.ПрименяетсяЧастичноеУдержание = ЗаписьНабора.ПрименяетсяЧастичноеУдержание;
		ДоговорСтрахованияОбъект.ПроцентЧастичногоУдержания = ЗаписьНабора.ПроцентЧастичногоУдержания;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.УдалитьНастройкиГрафиковУдержанийМедицинскогоСтрахования.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	НаборЗаписей.Прочитать();
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		НоваяСтрока = ДоговорСтрахованияОбъект.ГрафикУдержаний.Добавить();
		НоваяСтрока.МесяцУдержания = ЗаписьНабора.Дата;
		НоваяСтрока.МесяцУдержанияСтрокой = Формат(ЗаписьНабора.Дата, НСтр("ru='ДФ=''ММММ гггг'''"));
	КонецЦикла;
	
	// Отправляемые данные
	НаборЗаписей = РегистрыСведений.УдалитьОтправляемыеДанныеЗастрахованных.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	НаборЗаписей.Прочитать();
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		НоваяСтрока = ДоговорСтрахованияОбъект.ОтправляемыеДанные.Добавить();
		НоваяСтрока.Сведение = ЗаписьНабора.Сведение;
		НоваяСтрока.Отправлять = ЗаписьНабора.Отправлять;
		НоваяСтрока.СпособПроверкиЗаполнения = ЗаписьНабора.СпособПроверкиЗаполнения;
	КонецЦикла;
	
	// Отправляемая контактная информация
	НаборЗаписей = РегистрыСведений.УдалитьОтправляемаяКонтактнаяИнформацияЗастрахованных.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	НаборЗаписей.Прочитать();
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		НоваяСтрока = ДоговорСтрахованияОбъект.ОтправляемаяКонтактнаяИнформация.Добавить();
		НоваяСтрока.ВидКонтактнойИнформации = ЗаписьНабора.Вид;
		НоваяСтрока.Отправлять = ЗаписьНабора.Отправлять;
		НоваяСтрока.СпособПроверкиЗаполнения = ЗаписьНабора.СпособПроверкиЗаполнения;
	КонецЦикла;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не УправлениеСвойствами.СвойстваДоступны() Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.УдалитьОтправляемыеДополнительныеРеквизитыИСведенияЗастрахованных.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	НаборЗаписей.Прочитать();
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		НоваяСтрока = ДоговорСтрахованияОбъект.ОтправляемыеДополнительныеРеквизитыИСведения.Добавить();
		НоваяСтрока.Сведение = ЗаписьНабора.Свойство;
		НоваяСтрока.Отправлять = ЗаписьНабора.Отправлять;
		НоваяСтрока.СпособПроверкиЗаполнения = ЗаписьНабора.СпособПроверкиЗаполнения;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьУсловияДоговораНаОснованииПрикрепления(ДоговорСтрахованияОбъект, Документ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	// АПК:96-выкл ОБЪЕДИНИТЬ является необходимым условием запроса
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(ПрикреплениеСотрудники.УдерживатьИзЗарплаты) КАК УдерживатьЗаСотрудника,
		|	МАКСИМУМ(ПрикреплениеРодственники.УдерживатьССотрудника) КАК УдерживатьЗаРодственников,
		|	МАКСИМУМ(ПрикреплениеСотрудники.Удержание) КАК Удержание,
		|	МАКСИМУМ(ПрикреплениеСотрудники.СпособУдержания) КАК СпособУдержания,
		|	МАКСИМУМ(ПрикреплениеСотрудники.ЧастичноеУдержание) КАК ПрименяетсяЧастичноеУдержание,
		|	МАКСИМУМ(ПрикреплениеСотрудники.ПроцентЧастичногоУдержания) КАК ПроцентЧастичногоУдержания
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования КАК ПрикреплениеДокумент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.Сотрудники КАК ПрикреплениеСотрудники
		|		ПО ПрикреплениеДокумент.Ссылка = &Ссылка
		|		И ПрикреплениеДокумент.Ссылка = ПрикреплениеСотрудники.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.Родственники КАК ПрикреплениеРодственники
		|		ПО ПрикреплениеСотрудники.Ссылка = ПрикреплениеРодственники.Ссылка
		|		И ПрикреплениеСотрудники.ФизическоеЛицо = ПрикреплениеРодственники.ФизическоеЛицо
		|СГРУППИРОВАТЬ ПО
		|	ПрикреплениеДокумент.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрикреплениеПрограммыСтрахованияСотрудников.ПрограммаСтрахования КАК ПрограммаСтрахования
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ПрограммыСтрахованияСотрудников КАК
		|		ПрикреплениеПрограммыСтрахованияСотрудников
		|ГДЕ
		|	ПрикреплениеПрограммыСтрахованияСотрудников.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ПрикреплениеПрограммыСтрахованияРодственников.ПрограммаСтрахования
		|ИЗ
		|	Документ.ПрикреплениеКПрограммамМедицинскогоСтрахования.ПрограммыСтрахованияРодственников КАК
		|		ПрикреплениеПрограммыСтрахованияРодственников
		|ГДЕ
		|	ПрикреплениеПрограммыСтрахованияРодственников.Ссылка = &Ссылка";
	// АПК:96-вкл
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаУдержаний = РезультатыЗапроса[РезультатыЗапроса.ВГраница()-1].Выбрать();
	ВыборкаПрограммСтрахования = РезультатыЗапроса[РезультатыЗапроса.ВГраница()].Выбрать();
	
	Если ВыборкаУдержаний.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДоговорСтрахованияОбъект, ВыборкаУдержаний);
		ДоговорСтрахованияОбъект.ТребуетсяУдержание =
			ДоговорСтрахованияОбъект.УдерживатьЗаСотрудника Или ДоговорСтрахованияОбъект.УдерживатьЗаРодственников;
	КонецЕсли;
	
	Пока ВыборкаПрограммСтрахования.Следующий() Цикл
		НоваяСтрока = ДоговорСтрахованияОбъект.ПрограммыМедицинскогоСтрахования.Добавить();
		НоваяСтрока.Программа = ВыборкаПрограммСтрахования.ПрограммаСтрахования;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНовыйРегистрСведенийНаОснованииУдаленного(ИмяРегистра, Организация, СтраховаяКомпания, ДоговорСтрахования)
	
	СтарыйНаборЗаписей = РегистрыСведений["Удалить" + ИмяРегистра].СоздатьНаборЗаписей();
	СтарыйНаборЗаписей.Отбор.Организация.Установить(Организация);
	СтарыйНаборЗаписей.Отбор.СтраховаяКомпания.Установить(СтраховаяКомпания);
	СтарыйНаборЗаписей.Прочитать();
	
	Если СтарыйНаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДоговорСтрахования.Установить(ДоговорСтрахования);
	Для Каждого Запись Из СтарыйНаборЗаписей Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Запись);
		НоваяЗапись.ДоговорСтрахования = ДоговорСтрахования;
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
	
КонецПроцедуры

Функция ТаблицаИзМассиваСтруктур(МассивСтруктур) Экспорт
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Если МассивСтруктур.Количество() = 0 Тогда
		Возврат ТаблицаЗначений;
	КонецЕсли;
	
	Для каждого Свойство Из МассивСтруктур[0] Цикл
		ТипКолонки = ТипЗнч(Свойство.Значение);
		Типы = Новый Массив(1);
		Типы.Добавить(ТипКолонки);
		ТаблицаЗначений.Колонки.Добавить(Свойство.Ключ, Новый ОписаниеТипов(Типы));
	КонецЦикла;
	
	Для каждого Элемент Из МассивСтруктур Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаЗначений.Добавить(), Элемент);
	КонецЦикла;
	
	Возврат ТаблицаЗначений;
	
КонецФункции
	
#КонецОбласти
