// @strict-types

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает признак наличия отчета в справочнике регламентированных
// 
// Параметры:
//  ИДОтчета - Строка
// 
// Возвращаемое значение:
//  Булево
Функция ЕстьВСправочникеРегламентированных(ИДОтчета) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
				   |	РегламентированныеОтчеты.ИсточникОтчета КАК ИсточникОтчета
				   |ИЗ
				   |	Справочник.РегламентированныеОтчеты КАК РегламентированныеОтчеты
				   |ГДЕ
				   |	НЕ РегламентированныеОтчеты.ЭтоГруппа
				   |	И РегламентированныеОтчеты.ИсточникОтчета = &ИсточникОтчета
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	ИсточникОтчета";

	Запрос.УстановитьПараметр("ИсточникОтчета", ИДОтчета);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат Не РезультатЗапроса.Пустой();
КонецФункции

// Возвращает Госорган отчета.
// 
// Параметры:
//  ИДОтчета - Строка
// 
// Возвращаемое значение:
//  Строка 
Функция ГосорганОтчета(ИДОтчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИДОтчета", ИДОтчета);
	Запрос.Текст = "ВЫБРАТЬ 
					|	ВидыОтправляемыхДокументов.ТипПолучателя КАК ТипПолучателя 
					|ИЗ 
					|	Справочник.РегламентированныеОтчеты КАК РегламентированныеОтчеты
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОтправляемыхДокументов КАК ВидыОтправляемыхДокументов
					|		ПО РегламентированныеОтчеты.ИсточникОтчета = ВидыОтправляемыхДокументов.Источник
					|ГДЕ 
					|	РегламентированныеОтчеты.ИсточникОтчета = &ИДОтчета";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		//@skip-check bsl-legacy-check-string-literal
		ТипПолучателя = Строка(Выборка["ТипПолучателя"]);
		ЧастиИмени = СтрРазделить(ТипПолучателя, "(");
		ТипПолучателя = СокрЛП(ЧастиИмени[0]);
		
		Возврат ТипПолучателя;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает настройки интеграции.
// 
// Параметры:
//  Получатель - Строка
// 
// Возвращаемое значение:
//  Неопределено, Структура -:
//  * Получатель      - Строка
//  * Имя             - Строка
//  * Отправитель     - Строка
//  * Госорганы       - Строка
//  * АдресПолучателя - Строка
//  * ТребоватьПодтверждениеПользователя - Булево
Функция ПолучитьНастройкиИнтеграции(Получатель) Экспорт
	
	Результат = Новый Структура;

	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Получатель", Получатель);
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.Отчетность24БРОПодключения КАК Отчетность24Подключения
	|ГДЕ
	|	Отчетность24Подключения.Получатель = &Получатель"; 
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Результат.Вставить(Колонка.Имя);	
		КонецЦикла;                         
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;              
	
	//@skip-check constructor-function-return-section
	Возврат Результат;
	
КонецФункции

#КонецОбласти