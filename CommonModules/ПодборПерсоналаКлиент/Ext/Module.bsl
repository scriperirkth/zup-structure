#Область ПрограммныйИнтерфейс

// Дополняет параметры открытия формы с похожими данными физического лица.
// 
// Параметры:
//  ПараметрыОткрытия - Структура -
Процедура ДополнитьПараметрыОткрытияФормыФизическиеЛицаСПохожимиДанными(ПараметрыОткрытия) Экспорт
	
	ПараметрыОткрытия.Вставить("КандидатУникален", Истина);
	ПараметрыОткрытия.Вставить("ДанныеКандидатов", Новый Массив);
	ПараметрыОткрытия.Вставить("ДанныеКандидатовДоступны", Истина);
	
КонецПроцедуры

// Выполняет в форме сотрудника поиск однофамильцев среди кандидатов.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента справочника Сотрудники или ФизическиеЛица
//  РезультатПоиска - Структура
//  ФизическоеЛицоУникально - Булево
//  КоличествоПохожих - Число
Процедура ПроверитьОднофамильцевСотрудникаСредиКандидатов(Форма, РезультатПоиска, ФизическоеЛицоУникально,
	КоличествоПохожих) Экспорт
	
	ПараметрыПоиска = ПодборПерсоналаВызовСервера.ПараметрыПоискаПохожихКандидатов();
	ПараметрыПоиска.Ссылка = Форма.ЛичныеДанныеКандидатаСсылка;
	ПараметрыПоиска.Фамилия = Форма.ФИОФизическихЛиц.Фамилия;
	ПараметрыПоиска.Имя = Форма.ФИОФизическихЛиц.Имя;
	ПараметрыПоиска.Отчество = Форма.ФИОФизическихЛиц.Отчество;
	ПараметрыПоиска.ИсключаемыеФизическиеЛица = ФизическиеЛицаИсключаемыеПриПоискеПохожихКандидатов(РезультатПоиска);
	
	РезультатПоискаКандидатов = ПодборПерсоналаВызовСервера.ПохожиеКандидаты(ПараметрыПоиска);
	
	РезультатПоиска.Вставить("КандидатУникален", РезультатПоискаКандидатов.КандидатУникален);
	РезультатПоиска.Вставить("ДанныеКандидатов", РезультатПоискаКандидатов.ДанныеКандидатов);
	РезультатПоиска.Вставить("ДанныеКандидатовДоступны", РезультатПоискаКандидатов.ДанныеКандидатовДоступны);
	
	ФизическоеЛицоУникально = ФизическоеЛицоУникально И РезультатПоискаКандидатов.КандидатУникален;
	КоличествоПохожих = КоличествоПохожих + РезультатПоискаКандидатов.ДанныеКандидатов.Количество();
	
КонецПроцедуры

// Выполняет действия при завершении поиска однофамильцев среди кандидатов в форме сотрудника.
// 
// Параметры:
//  РезультатВыбора  - см. СотрудникиКлиент.ПроверитьОднофамильцевДанныеФизическихЛиц.РезультатВыбора
//  ДополнительныеПараметры - см. СотрудникиКлиент.ПроверитьОднофамильцевДанныеФизическихЛиц.ДополнительныеПараметры
Процедура ПроверитьОднофамильцевСотрудникаСредиКандидатовЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
		
	Если ТипЗнч(РезультатВыбора.ПохожийЧеловек) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Форма.ЛичныеДанныеКандидатаСсылка = ПредопределенноеЗначение("Справочник.ЛичныеДанныеКандидатов.ПустаяСсылка");
		СотрудникиКлиент.УстановитьФизическоеЛицоВФормеСотрудника(Форма, РезультатВыбора.ПохожийЧеловек);
	ИначеЕсли ТипЗнч(РезультатВыбора.ПохожийЧеловек) = Тип("СправочникСсылка.ЛичныеДанныеКандидатов") Тогда
		Форма.ЛичныеДанныеКандидатаСсылка = РезультатВыбора.ПохожийЧеловек;
		Форма.ОбновитьДанныеФизическогоЛицаНаСервере();
		Форма.ФИОФизическихЛиц.Фамилия = Форма.ФизическоеЛицо.Фамилия;
		Форма.ФИОФизическихЛиц.Имя = Форма.ФизическоеЛицо.Имя;
		Форма.ФИОФизическихЛиц.Отчество = Форма.ФизическоеЛицо.Отчество;
		СотрудникиКлиент.СформироватьНаименованиеСотрудника(Форма);
		Оповестить("ИзмененЗаголовокФормыСотрудника", Форма.Сотрудник.Наименование, Форма);
		СотрудникиКлиентСервер.УстановитьВидЗанятостиНовогоСотрудника(Форма);
	Иначе
		ОбщегоНазначенияКлиентСервер.Проверить(Ложь, НСтр("ru = 'Некорректные данные в результате выбора.'"),
			"ПодборПерсоналаКлиент.ПроверитьОднофамильцевСотрудникаСредиКандидатовЗавершение");
	КонецЕсли;
		
КонецПроцедуры

// Выполняет действия при завершении поиска однофамильцев среди кандидатов в форме физического лица.
// 
// Параметры:
//  РезультатВыбора  - см. СотрудникиКлиент.ПроверитьОднофамильцевДанныеФизическихЛиц.РезультатВыбора
//  ДополнительныеПараметры - см. СотрудникиКлиент.ПроверитьОднофамильцевДанныеФизическихЛиц.ДополнительныеПараметры
Процедура ПроверитьОднофамильцевФизическогоЛицаСредиКандидатовЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
		
	Если ТипЗнч(РезультатВыбора.ПохожийЧеловек) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Форма.ЛичныеДанныеКандидатаСсылка = ПредопределенноеЗначение("Справочник.ЛичныеДанныеКандидатов.ПустаяСсылка");
		СотрудникиКлиент.ОбработатьВыборФизическогоЛицаОднофамильца(Форма, РезультатВыбора.ПохожийЧеловек);
	ИначеЕсли ТипЗнч(РезультатВыбора.ПохожийЧеловек) = Тип("СправочникСсылка.ЛичныеДанныеКандидатов") Тогда
		Форма.ЛичныеДанныеКандидатаСсылка = РезультатВыбора.ПохожийЧеловек;
		Форма.ЗаполнитьФизическоеЛицоПоКандидату();
		Форма.ФИОФизическихЛиц.Фамилия = Форма.ФизическоеЛицо.Фамилия;
		Форма.ФИОФизическихЛиц.Имя = Форма.ФизическоеЛицо.Имя;
		Форма.ФИОФизическихЛиц.Отчество = Форма.ФизическоеЛицо.Отчество;
		Оповестить("ИзмененЗаголовокФормыСотрудника", Форма.ФизическоеЛицо.Наименование, Форма);
	Иначе
		ОбщегоНазначенияКлиентСервер.Проверить(Ложь, НСтр("ru = 'Некорректные данные в результате выбора.'"),
			"ПодборПерсоналаКлиент.ПроверитьОднофамильцевФизическогоЛицаСредиКандидатовЗавершение");
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает видимость команды открытия списка групп доступа кандидатов в панеле администрирования пользователей
// и прав при изменении использования вида доступа.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
Процедура ОграничиватьДоступНаУровнеЗаписейЛичныеДанныеКандидатовПриИзменении(Форма) Экспорт
	
	ИмяКонстанты = "ОграничиватьДоступНаУровнеЗаписейЛичныеДанныеКандидатов";
	ПодборПерсоналаВызовСервера.УстановитьЗначениеКонстанты(ИмяКонстанты, Форма[ИмяКонстанты]);
	ОбновитьПовторноИспользуемыеЗначения();
	
	Оповестить("Запись_НаборКонстант", Новый Структура, ИмяКонстанты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппыДоступаКандидатовОткрытьСписок",
		"Видимость", ПодборПерсоналаВызовСервера.ОграничиватьДоступНаУровнеЗаписейЛичныеДанныеКандидатов());
	
КонецПроцедуры

// Выделяет совпавшие данные в форме физические лица с похожими данными при завершении проверки архивной записи.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  РезультатПоиска - Структура:
//   * Найдено - Булево
//   * ИмяПоля - Строка
Процедура ПриЗавершенииПроверкиАрхивнойЗаписи(Форма, РезультатПоиска) Экспорт
	
	Если РезультатПоиска.ИмяПоля = "МобильныйТелефон" Тогда
		ИмяСовпавшихДанных = "Телефон";
	ИначеЕсли РезультатПоиска.ИмяПоля = "АдресЭлектроннойПочты" Тогда
		ИмяСовпавшихДанных = "E-mail";
	ИначеЕсли РезультатПоиска.ИмяПоля = "ДатаРождения" Тогда
		ИмяСовпавшихДанных = "ДатаРождения";
	ИначеЕсли РезультатПоиска.ИмяПоля = "ИНН" Тогда
		ИмяСовпавшихДанных = "ИНН";
	ИначеЕсли РезультатПоиска.ИмяПоля = "СтраховойНомерПФР" Тогда
		ИмяСовпавшихДанных = "СтраховойНомерПФР";
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Форма.Однофамильцы.Количество() = 1 Тогда
		НомерСтроки = 0;
	Иначе	
		НомерСтроки = Форма.Элементы.Однофамильцы.ТекущаяСтрока;
	КонецЕсли;
	
	СтрокаДанных = Форма.Однофамильцы.НайтиПоИдентификатору(НомерСтроки);
	Если СтрНайти(СтрокаДанных.СовпадающиеДанные, ИмяСовпавшихДанных) = 0 Тогда
		Если ЗначениеЗаполнено(СтрокаДанных.СовпадающиеДанные) Тогда
			СтрокаДанных.СовпадающиеДанные = СтрШаблон("%1,%2", СтрокаДанных.СовпадающиеДанные, ИмяСовпавшихДанных);
		Иначе
			СтрокаДанных.СовпадающиеДанные = ИмяСовпавшихДанных;
		КонецЕсли;
	КонецЕсли;
		
	ВыделитьСовпадающиеДанные(Форма, НомерСтроки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Предназначена для обработки команды перехода из формы сотрудника к форме кандидата.
//
Процедура ОткрытьФормуКандидатаИзФормыСотрудника(Форма) Экспорт
	
	КандидатСсылка = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "КандидатСсылка");
	Если Не ЗначениеЗаполнено(КандидатСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Кандидаты.ФормаОбъекта", Новый Структура("Ключ", КандидатСсылка));
	
КонецПроцедуры

Процедура ОткрытьФормуНовогоКандидата(Знач ЗначенияЗаполнения = Неопределено, Знач ПараметрыФормы = Неопределено,
	Уникальность = Неопределено) Экспорт
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли;
	
	Если ЗначенияЗаполнения <> Неопределено Тогда
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Кандидаты.ФормаОбъекта", ПараметрыФормы, , Уникальность);
	
КонецПроцедуры

Процедура ФизическиеЛицаФормаЭлементаПриВыполненииКоманды(Команда, Форма) Экспорт
	Если Команда.Имя = ПодборПерсоналаКлиентСервер.ИмяКомандыНовыйКандидатВФормеФизическиеЛица() Тогда
		НачатьОткрытиеФормыНовогоКандидата(Форма);
	КонецЕсли;
КонецПроцедуры

Процедура ПриОткрытииФормыЭлементаИсторииВзаимоотношений(Ссылка, ФормаВладелец, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.Кандидаты") Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", Ссылка);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	
	ОткрытьФорму(
		"Справочник.Кандидаты.ФормаОбъекта", 
		ПараметрыФормы, 
		ФормаВладелец, , , , , 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ФизическиеЛицаФормаЭлементаОбработкаОповещения(Форма, ИмяСобытия, Параметр) Экспорт
	
	Если ИмяСобытия <> "Запись_Кандидаты" Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметр) = Тип("Структура") 
		И Параметр.Свойство("ФизическоеЛицо") 
		И Параметр.ФизическоеЛицо = Форма.ФизическоеЛицоСсылка Тогда
		СотрудникиКлиент.НачатьЗаполнениеИсторииВзаимоотношений(
			Форма, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Форма.ФизическоеЛицоСсылка));
	КонецЕсли;
	
КонецПроцедуры

// Инициирует открытие формы для редактирования места рождения физического лица.
//
// Параметры:
//  Форма - Форма - форма, в которой редактируются данные кандидата.
//  Элемент - ПолеФормы - поле ввода, в котором размещается представление места рождения.
//  СтандартнаяОбработка - Булево - признак стандартной обработки, который будет установлен в Ложь.
//  МестоРождения - Строка - данные места рождения, которые будет отредактированы.
//  ОповещениеЗавершения - ОписаниеОповещения, Неопределено	 - необязательный, если указано,
//  	будет выполнен после завершения редактирования, в качестве параметра передается признак Булево:
//  	Истина, если место рождения изменено, Ложь - в противном случае.
//
Процедура НачатьРедактированиеМестаРожденияКандидата(Форма, Элемент, СтандартнаяОбработка, МестоРождения,
	ОповещениеЗавершения = Неопределено) Экспорт
	
	МестоРожденияКандидатаНачалоВыбора(Форма, Элемент, СтандартнаяОбработка, МестоРождения, ОповещениеЗавершения);
	
КонецПроцедуры

#Область ФормаФизическиеЛицаСПохожимиДанными

// Выделяет цветом совпадающие данные на форме ФизическиеЛицаСПохожимиДанными.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  НомерСтроки - Число
Процедура ВыделитьСовпадающиеДанные(Форма, НомерСтроки) Экспорт
	
	СтрокаДанных = Форма.Однофамильцы.НайтиПоИдентификатору(НомерСтроки);
	СовпадающиеДанные = СтрРазделить(СтрокаДанных.СовпадающиеДанные, ",");
	ИменаПолей = ИменаПолейФормыФизическиеЛицаСПохожимиДанными();
	ШрифтыЦвета = ПодборПерсоналаВызовСервера.ШрифтыЦветаСовпадающихДанных();
	ИменаСовпадающихДанных = ИменаСовпадающихДанных();
	
	Если СовпадающиеДанные.Найти(ИменаСовпадающихДанных.Телефон) = Неопределено Тогда
		Форма.Элементы[ИменаПолей.Телефон].Шрифт = ШрифтыЦвета.ОбычныйШрифтТекста;
		Форма.Элементы[ИменаПолей.Телефон].ШрифтЗаголовка = ШрифтыЦвета.ОбычныйШрифтТекста;
		Форма.Элементы[ИменаПолей.ГруппаТелефон].ЦветФона = ШрифтыЦвета.ОбычныйЦветФона;
	Иначе
		Форма.Элементы[ИменаПолей.Телефон].Шрифт = ШрифтыЦвета.СовпадающиеДанныеШрифт;
		Форма.Элементы[ИменаПолей.Телефон].ШрифтЗаголовка = ШрифтыЦвета.СовпадающиеДанныеШрифт;
		Форма.Элементы[ИменаПолей.ГруппаТелефон].ЦветФона = ШрифтыЦвета.СовпадающиеДанныеЦветФонаГруппы;
	КонецЕсли;
	
	Если СовпадающиеДанные.Найти(ИменаСовпадающихДанных.EMmail) = Неопределено Тогда
		Форма.Элементы[ИменаПолей.АдресЭлектроннойПочты].Шрифт = ШрифтыЦвета.ОбычныйШрифтТекста;
		Форма.Элементы[ИменаПолей.АдресЭлектроннойПочты].ШрифтЗаголовка = ШрифтыЦвета.ОбычныйШрифтТекста;
		Форма.Элементы[ИменаПолей.ГруппаАдресЭлектроннойПочты].ЦветФона = ШрифтыЦвета.ОбычныйЦветФона;
	Иначе
		Форма.Элементы[ИменаПолей.АдресЭлектроннойПочты].Шрифт = ШрифтыЦвета.СовпадающиеДанныеШрифт;
		Форма.Элементы[ИменаПолей.АдресЭлектроннойПочты].ШрифтЗаголовка = ШрифтыЦвета.СовпадающиеДанныеШрифт;
		Форма.Элементы[ИменаПолей.ГруппаАдресЭлектроннойПочты].ЦветФона = ШрифтыЦвета.СовпадающиеДанныеЦветФонаГруппы;
	КонецЕсли;
	
	Если СовпадающиеДанные.Найти(ИменаСовпадающихДанных.ДатаРождения) = Неопределено Тогда
		Форма.Элементы[ИменаПолей.ДатаРождения].Шрифт = ШрифтыЦвета.ОбычныйШрифтТекста;
		Форма.Элементы[ИменаПолей.ДатаРождения].ШрифтЗаголовка = ШрифтыЦвета.ОбычныйШрифтТекста;
		Форма.Элементы[ИменаПолей.ГруппаДатаРождения].ЦветФона = ШрифтыЦвета.ОбычныйЦветФона;
	Иначе
		Форма.Элементы[ИменаПолей.ДатаРождения].Шрифт = ШрифтыЦвета.СовпадающиеДанныеШрифт;
		Форма.Элементы[ИменаПолей.ДатаРождения].ШрифтЗаголовка = ШрифтыЦвета.СовпадающиеДанныеШрифт;
		Форма.Элементы[ИменаПолей.ГруппаДатаРождения].ЦветФона = ШрифтыЦвета.СовпадающиеДанныеЦветФонаГруппы;
	КонецЕсли;
	
	Если СовпадающиеДанные.Найти(ИменаСовпадающихДанных.ИНН) <> Неопределено
		Или СовпадающиеДанные.Найти(ИменаСовпадающихДанных.СтраховойНомерПФР) <> Неопределено Тогда
		Форма.Элементы[ИменаПолей.ГруппаИННиСНИЛС].ЦветФона = ШрифтыЦвета.СовпадающиеДанныеЦветФонаГруппы;
	Иначе
		Форма.Элементы[ИменаПолей.ГруппаИННиСНИЛС].ЦветФона = ШрифтыЦвета.ОбычныйЦветФона;
	КонецЕсли;
	
	Если СовпадающиеДанные.Найти(ИменаСовпадающихДанных.ИНН) = Неопределено Тогда
		Форма.Элементы[ИменаПолей.ИНН].Шрифт = ШрифтыЦвета.ОбычныйШрифтТекста;
		Форма.Элементы[ИменаПолей.ИНН].ШрифтЗаголовка = ШрифтыЦвета.ОбычныйШрифтТекста;
	Иначе
		Форма.Элементы[ИменаПолей.ИНН].Шрифт = ШрифтыЦвета.СовпадающиеДанныеШрифт;
		Форма.Элементы[ИменаПолей.ИНН].ШрифтЗаголовка = ШрифтыЦвета.СовпадающиеДанныеШрифт;
	КонецЕсли;
	
	Если СовпадающиеДанные.Найти(ИменаСовпадающихДанных.СтраховойНомерПФР) = Неопределено Тогда
		Форма.Элементы[ИменаПолей.СтраховойНомерПФР].Шрифт = ШрифтыЦвета.ОбычныйШрифтТекста;
		Форма.Элементы[ИменаПолей.СтраховойНомерПФР].ШрифтЗаголовка = ШрифтыЦвета.ОбычныйШрифтТекста;
	Иначе
		Форма.Элементы[ИменаПолей.СтраховойНомерПФР].Шрифт = ШрифтыЦвета.СовпадающиеДанныеШрифт;
		Форма.Элементы[ИменаПолей.СтраховойНомерПФР].ШрифтЗаголовка = ШрифтыЦвета.СовпадающиеДанныеШрифт;
	КонецЕсли;
	
	Если СовпадающиеДанные.Найти(ИменаСовпадающихДанных.ФИО) = Неопределено Тогда
		Форма.Элементы[ИменаПолей.ГруппаФИО].ЦветФона = ШрифтыЦвета.ОбычныйЦветФона;
	Иначе
		Форма.Элементы[ИменаПолей.ГруппаФИО].ЦветФона = ШрифтыЦвета.СовпадающиеДанныеЦветФонаГруппы;
	КонецЕсли;
	
КонецПроцедуры

