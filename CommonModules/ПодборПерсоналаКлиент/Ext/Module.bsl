Процедура МестоРожденияКандидатаНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт	
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Форма = ДополнительныеПараметры.Форма;
	Элемент = ДополнительныеПараметры.Элемент;
	ОповещениеЗавершения = ДополнительныеПараметры.ОповещениеЗавершения;
	
	Форма.ЛичныеДанныеКандидата.МестоРождения = Результат;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, Элемент.Имя) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, Элемент.Имя,
			ПерсонифицированныйУчетКлиентСервер.ПредставлениеМестаРождения(Результат));
	КонецЕсли;
	Форма.Модифицированность = Истина;

	Если ОповещениеЗавершения <> Неопределено Тогда
		МестоРожденияИзменено = Результат <> Неопределено;
		ВыполнитьОбработкуОповещения(ОповещениеЗавершения, МестоРожденияИзменено);
	Иначе
		Форма.ОбновитьОтображениеДанных();
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьКомментарийПередУдалением(ДанныеКомментария) Экспорт

	Если ДанныеКомментария.Пользователь <> ПользователиКлиент.АвторизованныйПользователь() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Вы не можете удалить комментарий другого пользователя.'"), , 
			НСтр("ru = 'Удаление комментария'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

