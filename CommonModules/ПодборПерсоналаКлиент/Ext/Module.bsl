//  Отбор - Структура, Неопределено - 
//  МножественныйВыбор - Булево
Процедура ПодобратьКандидатов(ВладелецФормыВыбора, Отбор = Неопределено, МножественныйВыбор = Истина) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", МножественныйВыбор);
	Если ЗначениеЗаполнено(Отбор) Тогда
		ПараметрыФормы.Вставить("Отбор", Отбор);
	КонецЕсли;
	ОткрытьФорму("Справочник.Кандидаты.Форма.ФормаСписка", ПараметрыФормы, ВладелецФормыВыбора);
	
КонецПроцедуры

