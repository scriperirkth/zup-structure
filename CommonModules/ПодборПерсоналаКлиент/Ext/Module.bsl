// Открывает форму для объединения дублей личных данных кандидатов из отчета по проверке ведения учета.
// 
// Параметры:
//  ПараметрыИсправления - Структура:
//   * ВидПроверки - СправочникСсылка.ВидыПроверок
//   * ИдентификаторПроверки - Строка
//  ДополнительныеПараметры - Произвольный
Процедура ОткрытьФормуДляОбъединенияЛичныхДанныхКандидатов(ПараметрыИсправления, ДополнительныеПараметры) Экспорт
	
	Если Не КадровыйУчетРасширенныйКлиент.ДоступноОбъединениеДублейПерсональныхДанных() Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Для объединения дублей обратитесь к старшему менеджеру по персоналу или администратору.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОписаниеТипаВладельцаЛичныхДанных",
		Новый ОписаниеТипов("СправочникСсылка.ЛичныеДанныеКандидатов"));
	ПараметрыФормы.Вставить("НеПоказыватьТипВладельцаЛичныхДанных", Истина);
	ПараметрыФормы.Вставить("ВидПроверки", ПараметрыИсправления.ВидПроверки);
	ПараметрыФормы.Вставить("ИдентификаторПроверки", ПараметрыИсправления.ИдентификаторПроверки);

	ОткрытьФорму("Обработка.ОбъединениеДублейПерсональныхДанных.Форма", ПараметрыФормы);

КонецПроцедуры

