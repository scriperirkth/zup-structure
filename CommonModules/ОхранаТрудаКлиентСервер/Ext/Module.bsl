////////////////////////////////////////////////////////////////////////////////
// Подсистема "Охрана труда"
//
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Периодичность

// Возвращает произвольное значение списка выбора периодов из указанной формы.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма, из которой необходимо получить произвольное значение списка выбора
//
// Возвращаемое значение:
//   Строка - произвольное значение списка выбора периодов
Функция ПроизвольноеЗначениеСпискаВыбораПериодов(Форма) Экспорт
	Возврат Форма.ПроизвольноеЗначениеСпискаВыбора;
КонецФункции

// Возвращает структуру периода по его представлению.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма, содержащая список выбора периодов
//   ПериодСтрокой - Строка - представление периода
//
// Возвращаемое значение:
//   Структура, Неопределено - 
Функция СтруктураПериодаПоПредставлению(Форма, ПериодСтрокой) Экспорт
	
	СтруктураПериода = Неопределено;
	Если ПериодСтрокой = Форма.ПроизвольноеЗначениеСпискаВыбора Тогда
		Возврат СтруктураПериода;
	КонецЕсли;
	
	Для Каждого ЗначениеСписка Из Форма.СписокВыбораПериодов Цикл
		Если ЗначениеСписка.Представление = ПериодСтрокой Тогда
			СтруктураПериода = ЗначениеСписка.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураПериода;
	
КонецФункции

#КонецОбласти

Функция ИмяФункциональнойОпцииИспользоватьРабочиеМестаОхраныТруда() Экспорт
	Возврат "ИспользоватьРабочиеМестаОхраныТрудаКорпоративная";
КонецФункции

Процедура ДополнитьОписаниеДополнительнойФормыСотрудника(ОписаниеФормы, ИмяОткрываемойФормы, СтандартнаяОбработка) Экспорт
	
	Если ИмяОткрываемойФормы = "ОбщаяФорма.СотрудникиОхранаТруда" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ОписаниеФормы.КлючевыеРеквизиты.Вставить("СотрудникСсылка");
		ОписаниеФормы.КлючевыеРеквизиты.Вставить("Заголовок", "Сотрудник.Наименование");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗначениеВидимостиСпецоценки(Форма, РазрешитьВидимостьСпецоценки) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ОрганизацияФормы")
		И Не ОхранаТрудаВызовСервера.ОхранаТрудаИспользуется(Форма.ОрганизацияФормы) Тогда
		
		Возврат;
	КонецЕсли;
		
	РазрешитьВидимостьСпецоценки = РазрешитьВидимостьСпецоценки
		И Не (Форма.ПолучитьФункциональнуюОпциюФормы("ИспользоватьСпециальнуюОценкуУсловийТруда")
			И Форма.ПолучитьФункциональнуюОпциюФормы("ПрименятьУсловияТрудаРабочихМестОхраныТруда"));
	
КонецПроцедуры

#Область ПредставлениеДокументов

Процедура ЗаполнитьПредставлениеДокумента(Данные, Представление, КраткоеПредставлениеВидаДокумента) Экспорт
	
	Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 %2 от %3'"), 
		КраткоеПредставлениеВидаДокумента,
		ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Данные.Номер),
		Формат(Данные.Дата, "ДЛФ=D"));
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти