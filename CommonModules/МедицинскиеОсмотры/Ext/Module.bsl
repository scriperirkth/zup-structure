	УстановитьПривилегированныйРежим(Ложь);
	
	ОтборСтрок = Новый Структура("ВидОсмотра", Перечисления.ВидыОбследований.МедицинскийОсмотр);
	Показатели.П000020102503 = ПериодическиеОсмотры.НайтиСтроки(ОтборСтрок).Количество();
	
	КадровыеДанныеЖенщин = КадровыеДанныеСотрудников.НайтиСтроки(Новый Структура("Пол", Перечисления.ПолФизическогоЛица.Женский));
	Для Каждого СтрокаДанных Из КадровыеДанныеЖенщин Цикл
		ОтборСтрок.Вставить("ФизическоеЛицо", СтрокаДанных.ФизическоеЛицо);
		Если ПериодическиеОсмотры.НайтиСтроки(ОтборСтрок).Количество() > 0 Тогда
			Показатели.П000020102504 = Показатели.П000020102504 + 1;
		КонецЕсли;
	КонецЦикла;
			
	Запрос.Текст =
