	ОсмотрыПоФакторам.Колонки.Добавить("Требуется", Новый ОписаниеТипов("Булево"));
	ОсмотрыПоФакторам.Колонки.Добавить("Регистратор");

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ФизическоеЛицо КАК ФизическоеЛицо,
	|	&РабочееМесто КАК РабочееМесто
	|ПОМЕСТИТЬ ВТРабочиеМестаФизическихЛиц";

	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);

	Запрос.Выполнить();
	
	ОписательВременныхТаблиц = ОписательВременныхТаблицДляВТСведенияОсмотровПоВреднымФакторамИВидамРаботФизическихЛиц(
			"ВТРабочиеМестаФизическихЛиц");
	СоздатьВТСведенияОсмотровПоВреднымФакторамИВидамРаботФизическихЛиц(Запрос.МенеджерВременныхТаблиц, ОписательВременныхТаблиц,
		Истина, , ВидОсмотра);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.ВредныйФактор КАК ВредныйФактор,
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.ПоследнийОсмотр КАК ПоследнийОсмотр,
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.Регистратор КАК Регистратор,
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.РезультатОсмотра КАК Результат,
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.ТребуетсяРабочимМестом КАК Требуется,
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.Кратность КАК Кратность,
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.Периодичность КАК Периодичность,
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.ЕдиницаПериодичности КАК ЕдиницаПериодичности,
	|	ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц.Однократно КАК Однократно
	|ИЗ
	|	ВТСведенияОсмотровПоВреднымФакторамИВидамРаботФизическихЛиц КАК ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьСтрокуТаблицыОсмотровПоФакторам(ОсмотрыПоФакторам, Выборка);
	КонецЦикла;
	
	Возврат ОсмотрыПоФакторам;
	
КонецФункции

