Процедура ОбработатьДокументыМедицинскихОсмотров(ВыборкаДокументов)

	Пока ВыборкаДокументов.Следующий() Цикл
		ДокументСсылка = ВыборкаДокументов.Ссылка;
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ДокументСсылка.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСсылка);
		Блокировка.Заблокировать();
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ЗаблокироватьДанныеДляРедактирования(ДокументСсылка);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ВыборкаДокументов, , "Ссылка");
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	КонецЦикла; 
	
КонецПроцедуры

Процедура ОбновитьПериодическиеОсмотрыНазначенныхРабочихМест(ПараметрыОбновления = Неопределено) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РабочиеМестаСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	РабочиеМестаСотрудников.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	РегистрСведений.РабочиеМестаСотрудников КАК РабочиеМестаСотрудников";
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления, , Неопределено);
	
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Выборка = ОбновляемыеДанные.Выбрать();
	
	ТаблицаОбновления = НоваяТаблицаОбновлениеПериодическихОсмотров();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), Выборка);
	КонецЦикла;
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьОбновлениеПериодическихОсмотров(ТаблицаОбновления);
	ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
	
	ФизическиеЛица = ТаблицаОбновления.ВыгрузитьКолонку("ФизическоеЛицо");
	ЗапуститьОбновлениеПериодическихОсмотров(, ФизическиеЛица);
	
КонецПроцедуры

Процедура ОбновитьПериодическиеОсмотрыНаОснованииБудущихНазначенийРабочихМест(ПараметрыОбновления = Неопределено) Экспорт
	
	ТекущаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РабочиеМестаСотрудников.Период КАК Период,
		|	РабочиеМестаСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	РабочиеМестаСотрудников.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	РабочиеМестаСотрудников.ДействуетДо КАК ДействуетДо
		|ИЗ
		|	РегистрСведений.РабочиеМестаСотрудников КАК РабочиеМестаСотрудников
		|ГДЕ
		|	ВЫБОР
		|			КОГДА РабочиеМестаСотрудников.Период > &ТекущаяДата
		|				ТОГДА ИСТИНА
		|			КОГДА РабочиеМестаСотрудников.ДействуетДо > &ТекущаяДата
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления, , Неопределено);
	
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Выборка = ОбновляемыеДанные.Выбрать();
	
	ТаблицаБудущихСобытий = НоваяТаблицаБудущиеСобытияМедицинскиеОсмотры();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьТаблицуБудущихСобытийМедосмотров(Выборка, ТаблицаБудущихСобытий, ТекущаяДата);
	КонецЦикла;
	
	Если ТаблицаБудущихСобытий.Количество() = 0 Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьБудущиеСобытияМедицинскиеОсмотры(ТаблицаБудущихСобытий);
	ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
	
КонецПроцедуры

Процедура ЗаполнитьРабочиеМестаНовымиВреднымиФакторами(ПараметрыОбновления = Неопределено) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Если ПараметрыОбновления = Неопределено Тогда
		ПараметрыОбновления = Новый Структура("ОбработкаЗавершена");
	КонецЕсли;
	
	Если Не Справочники.ВредныеОпасныеПроизводственныеФакторыИВыполняемыеРаботы.ЕстьСоответствия() Тогда
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Обновление информационной базы.Отсутствуют соответствия вредных факторов по приказу 302н вредным факторам по приказу 29н'", 
				ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка);
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВредныеФакторыИВидыРаботРабочегоМеста.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТРабочиеМестаОбновленные
		|ИЗ
		|	РегистрСведений.ВредныеФакторыИВидыРаботРабочегоМеста КАК ВредныеФакторыИВидыРаботРабочегоМеста
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РабочиеМеста.Ссылка КАК РабочееМесто
		|ПОМЕСТИТЬ ВТРабочиеМестаКОбновлению
		|ИЗ
		|	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМеста
		|ГДЕ
		|	НЕ РабочиеМеста.Ссылка В (&Обработанные)
		|	И НЕ РабочиеМеста.ЭтоГруппа
		|	И НЕ РабочиеМеста.ВАрхиве
		|	И НЕ РабочиеМеста.ВредныеФакторыСопоставлены
		|	И НЕ РабочиеМеста.Ссылка В
		|		(ВЫБРАТЬ
		|			РабочиеМестаОбновленные.РабочееМесто
		|		ИЗ
		|			ВТРабочиеМестаОбновленные КАК РабочиеМестаОбновленные)";
	
	Обработанные = ЗначениеПараметраОбновленияОбработанные(ПараметрыОбновления);
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления, "ВТРабочиеМестаКОбновлению");
	
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВредныеФакторыРабочегоМеста.РабочееМесто КАК РабочееМесто,
		|	ВредныеФакторыРабочегоМеста.ВредныйФактор КАК ВредныйФактор
		|ПОМЕСТИТЬ ВТВредныеФакторыРабочегоМеста
		|ИЗ
		|	РегистрСведений.ВредныеФакторыРабочегоМеста КАК ВредныеФакторыРабочегоМеста
		|ГДЕ
		|	ВредныеФакторыРабочегоМеста.РабочееМесто В
		|		(ВЫБРАТЬ
		|			РабочиеМестаКОбновлению.РабочееМесто
		|		ИЗ
		|			ВТРабочиеМестаКОбновлению КАК РабочиеМестаКОбновлению)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВидыРаботРабочегоМеста.РабочееМесто,
		|	ВидыРаботРабочегоМеста.ВидРабот
		|ИЗ
		|	РегистрСведений.ВидыРаботМедицинскихОсмотровРабочегоМеста КАК ВидыРаботРабочегоМеста
		|ГДЕ
		|	ВидыРаботРабочегоМеста.РабочееМесто В
		|		(ВЫБРАТЬ
		|			РабочиеМестаКОбновлению.РабочееМесто
		|		ИЗ
		|			ВТРабочиеМестаКОбновлению КАК РабочиеМестаКОбновлению)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеМестаКОбновлению.РабочееМесто КАК РабочееМесто,
		|	ВредныеФакторыРабочегоМеста.ВредныйФактор
		|ПОМЕСТИТЬ ВТРабочиеМестаСВреднымиФакторами
		|ИЗ
		|	ВТРабочиеМестаКОбновлению КАК РабочиеМестаКОбновлению
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВредныеФакторыРабочегоМеста КАК ВредныеФакторыРабочегоМеста
		|		ПО РабочиеМестаКОбновлению.РабочееМесто = ВредныеФакторыРабочегоМеста.РабочееМесто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеВредныхФакторов.Ссылка КАК ВредныйФактор302Н,
		|	СоответствиеВредныхФакторов.ВредныйФактор КАК ВредныйФактор29Н
		|ПОМЕСТИТЬ ВТСоответствиеВредныхФакторов
		|ИЗ
		|	Справочник.ВредныеОпасныеПроизводственныеФакторы.СоответствующиеВредныеФакторы КАК СоответствиеВредныхФакторов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоответствиеВредныхФакторов.Ссылка,
		|	СоответствиеВредныхФакторов.ВредныйФактор
		|ИЗ
		|	Справочник.ВидыРаботМедицинскихОсмотров.СоответствующиеВредныеФакторы КАК СоответствиеВредныхФакторов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеМестаСВреднымиФакторами.РабочееМесто КАК РабочееМесто,
		|	РабочиеМестаСВреднымиФакторами.ВредныйФактор КАК ВредныйФактор302Н,
		|	СоответствиеВредныхФакторов.ВредныйФактор29Н КАК ВредныйФактор29Н,
		|	НЕ СоответствиеВредныхФакторов.ВредныйФактор29Н ЕСТЬ NULL КАК ЕстьСоответствие
		|ИЗ
		|	ВТРабочиеМестаСВреднымиФакторами КАК РабочиеМестаСВреднымиФакторами
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСоответствиеВредныхФакторов КАК СоответствиеВредныхФакторов
		|		ПО РабочиеМестаСВреднымиФакторами.ВредныйФактор = СоответствиеВредныхФакторов.ВредныйФактор302Н
		|ИТОГИ
		|ПО
		|	РабочееМесто,
		|	ВредныйФактор302Н";
		
	БлокировкаДанных = Новый БлокировкаДанных;
	БлокировкаДанных.Добавить("РегистрСведений.ВредныеФакторыРабочегоМеста");
	БлокировкаДанных.Добавить("РегистрСведений.ВидыРаботМедицинскихОсмотровРабочегоМеста");
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных.Заблокировать();
		
		ВыборкаРабочихМест = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		РабочиеМестаСНовымиФакторами = Новый Массив;
		
		Пока ВыборкаРабочихМест.Следующий() Цикл
			Обработанные.Добавить(ВыборкаРабочихМест.РабочееМесто);
			НовыеФакторы = Новый Массив;
			НаборЗаписей = РегистрыСведений.ВредныеФакторыИВидыРаботРабочегоМеста.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.РабочееМесто.Установить(ВыборкаРабочихМест.РабочееМесто);
			НаборЗаписей.Отбор.ВидОсмотра.Использование = Ложь;
			
			ВыборкаВредныхФакторов = ВыборкаРабочихМест.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			КоличествоФакторов = ВыборкаВредныхФакторов.Количество();
			ВредныеФакторыСопоставлены = Истина;
			Пока ВыборкаВредныхФакторов.Следующий() Цикл
				Если КоличествоФакторов = 1 И Не ЗначениеЗаполнено(ВыборкаВредныхФакторов.ВредныйФактор302Н) Тогда
					Прервать;
				КонецЕсли;
				Выборка = ВыборкаВредныхФакторов.Выбрать();
				Если Выборка.Количество() > 1 Тогда;
					ВредныеФакторыСопоставлены = Ложь;
				КонецЕсли;
				Пока Выборка.Следующий() Цикл
					Если Выборка.ЕстьСоответствие И НовыеФакторы.Найти(Выборка.ВредныйФактор29Н) = Неопределено Тогда
						НовыеФакторы.Добавить(Выборка.ВредныйФактор29Н);
						НоваяЗапись = НаборЗаписей.Добавить();
						НоваяЗапись.РабочееМесто = ВыборкаРабочихМест.РабочееМесто;
						НоваяЗапись.ВредныйФактор = Выборка.ВредныйФактор29Н;
						НоваяЗапись.ВидОсмотра = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ВредныйФактор29Н, "ВидОсмотра");
					Иначе
						ВредныеФакторыСопоставлены = Ложь;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			НовыеФакторыДобавлены = НаборЗаписей.Количество() > 0;
			Если НовыеФакторыДобавлены Тогда
				РабочиеМестаСНовымиФакторами.Добавить(ВыборкаРабочихМест.РабочееМесто);
			КонецЕсли;
			Если ВредныеФакторыСопоставлены Или НовыеФакторыДобавлены Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
				
				РабочееМестоОбъект = ВыборкаРабочихМест.РабочееМесто.ПолучитьОбъект();
				ЗаблокироватьДанныеДляРедактирования(ВыборкаРабочихМест.РабочееМесто);
				РабочееМестоОбъект.ВредныеФакторыСопоставлены = ВредныеФакторыСопоставлены;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(РабочееМестоОбъект);
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ПредставлениеОбработки = НСтр("ru = 'Заполнение рабочих мест вредными факторами из классификатора по приказу №29н'"); 
		ЗарегистрироватьОшибкуОбработкиМедицинскихОсмотров(ИнформацияОбОшибке(), ПредставлениеОбработки);
		ВызватьИсключение;
	КонецПопытки;
	
	ОбновитьПериодичностьОсмотровРабочихМест(РабочиеМестаСНовымиФакторами, Перечисления.ВидыОбследований.МедицинскийОсмотр);
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	
КонецПроцедуры

Процедура ЗаполнитьНаправленияЗаключенияНовымиВреднымиФакторами(ПараметрыОбновления = Неопределено) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Если ПараметрыОбновления = Неопределено Тогда
		ПараметрыОбновления = Новый Структура("ОбработкаЗавершена");
	КонецЕсли;
	
	Если Не Справочники.ВредныеОпасныеПроизводственныеФакторыИВыполняемыеРаботы.ЕстьСоответствия() Тогда
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Обновление информационной базы.Отсутствуют соответствия вредных факторов по приказу 302н вредным факторам по приказу 29н'", 
				ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка);
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВредныеФакторыИВидыРаботНаправлений.Ссылка КАК Документ
		|ПОМЕСТИТЬ ВТНаправленияЗаключенияОбновленные
		|ИЗ
		|	Документ.НаправлениеНаМедицинскийОсмотр.ВредныеФакторыИВидыРабот КАК ВредныеФакторыИВидыРаботНаправлений
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВредныеФакторыИВидыРаботЗаключений.Ссылка
		|ИЗ
		|	Документ.ЗаключениеМедицинскогоОсмотра.ВредныеФакторыИВидыРабот КАК ВредныеФакторыИВидыРаботЗаключений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НаправлениеНаМедицинскийОсмотр.Ссылка КАК Документ
		|ПОМЕСТИТЬ ВТНаправленияЗаключенияКОбновлению
		|ИЗ
		|	Документ.НаправлениеНаМедицинскийОсмотр КАК НаправлениеНаМедицинскийОсмотр
		|ГДЕ
		|	НЕ НаправлениеНаМедицинскийОсмотр.Ссылка В (&Обработанные)
		|	И НЕ НаправлениеНаМедицинскийОсмотр.ПометкаУдаления
		|	И НЕ НаправлениеНаМедицинскийОсмотр.Ссылка В
		|		(ВЫБРАТЬ
		|			НаправленияЗаключенияОбновленные.Документ
		|		ИЗ
		|			ВТНаправленияЗаключенияОбновленные КАК НаправленияЗаключенияОбновленные)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаключениеМедицинскогоОсмотра.Ссылка
		|ИЗ
		|	Документ.ЗаключениеМедицинскогоОсмотра КАК ЗаключениеМедицинскогоОсмотра
		|ГДЕ
		|	НЕ ЗаключениеМедицинскогоОсмотра.Ссылка В (&Обработанные)
		|	И НЕ ЗаключениеМедицинскогоОсмотра.ПометкаУдаления
		|	И НЕ ЗаключениеМедицинскогоОсмотра.Ссылка В
		|		(ВЫБРАТЬ
		|			НаправленияЗаключенияОбновленные.Документ
		|		ИЗ
		|			ВТНаправленияЗаключенияОбновленные КАК НаправленияЗаключенияОбновленные)";
	
	Обработанные = ЗначениеПараметраОбновленияОбработанные(ПараметрыОбновления);
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления, "ВТНаправленияЗаключенияКОбновлению");
	
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВредныеФакторыНаправление.Ссылка КАК Документ,
		|	ВредныеФакторыНаправление.ВредныйФактор КАК ВредныйФактор
		|ПОМЕСТИТЬ ВТВредныеФакторыДокументов
		|ИЗ
		|	Документ.НаправлениеНаМедицинскийОсмотр.ВредныеФакторы КАК ВредныеФакторыНаправление
		|ГДЕ
		|	ВредныеФакторыНаправление.Ссылка В
		|		(ВЫБРАТЬ
		|			НаправленияЗаключенияКОбновлению.Документ
		|		ИЗ
		|			ВТНаправленияЗаключенияКОбновлению КАК НаправленияЗаключенияКОбновлению)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВидыРаботНаправление.Ссылка,
		|	ВидыРаботНаправление.ВидРабот
		|ИЗ
		|	Документ.НаправлениеНаМедицинскийОсмотр.ВидыРабот КАК ВидыРаботНаправление
		|ГДЕ
		|	ВидыРаботНаправление.Ссылка В
		|		(ВЫБРАТЬ
		|			НаправленияЗаключенияКОбновлению.Документ
		|		ИЗ
		|			ВТНаправленияЗаключенияКОбновлению КАК НаправленияЗаключенияКОбновлению)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВредныеФакторыЗаключение.Ссылка,
		|	ВредныеФакторыЗаключение.ВредныйФактор
		|ИЗ
		|	Документ.ЗаключениеМедицинскогоОсмотра.ВредныеФакторы КАК ВредныеФакторыЗаключение
		|ГДЕ
		|	ВредныеФакторыЗаключение.Ссылка В
		|		(ВЫБРАТЬ
		|			НаправленияЗаключенияКОбновлению.Документ
		|		ИЗ
		|			ВТНаправленияЗаключенияКОбновлению КАК НаправленияЗаключенияКОбновлению)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВидыРаботЗаключение.Ссылка,
		|	ВидыРаботЗаключение.ВидРабот
		|ИЗ
		|	Документ.ЗаключениеМедицинскогоОсмотра.ВидыРабот КАК ВидыРаботЗаключение
		|ГДЕ
		|	ВидыРаботЗаключение.Ссылка В
		|		(ВЫБРАТЬ
		|			НаправленияЗаключенияКОбновлению.Документ
		|		ИЗ
		|			ВТНаправленияЗаключенияКОбновлению КАК НаправленияЗаключенияКОбновлению)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НаправленияЗаключенияКОбновлению.Документ КАК Документ,
		|	ВредныеФакторыДокументов.ВредныйФактор
		|ПОМЕСТИТЬ ВТДокументыСВреднымиФакторами
		|ИЗ
		|	ВТНаправленияЗаключенияКОбновлению КАК НаправленияЗаключенияКОбновлению
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВредныеФакторыДокументов КАК ВредныеФакторыДокументов
		|		ПО НаправленияЗаключенияКОбновлению.Документ = ВредныеФакторыДокументов.Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеВредныхФакторов.Ссылка КАК ВредныйФактор302Н,
		|	СоответствиеВредныхФакторов.ВредныйФактор КАК ВредныйФактор29Н
		|ПОМЕСТИТЬ ВТСоответствиеВредныхФакторов
		|ИЗ
		|	Справочник.ВредныеОпасныеПроизводственныеФакторы.СоответствующиеВредныеФакторы КАК СоответствиеВредныхФакторов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоответствиеВредныхФакторов.Ссылка,
		|	СоответствиеВредныхФакторов.ВредныйФактор
		|ИЗ
		|	Справочник.ВидыРаботМедицинскихОсмотров.СоответствующиеВредныеФакторы КАК СоответствиеВредныхФакторов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыСВреднымиФакторами.Документ КАК Документ,
		|	ДокументыСВреднымиФакторами.ВредныйФактор КАК ВредныйФактор302Н,
		|	СоответствиеВредныхФакторов.ВредныйФактор29Н КАК ВредныйФактор29Н,
		|	НЕ СоответствиеВредныхФакторов.ВредныйФактор29Н ЕСТЬ NULL КАК ЕстьСоответствие
		|ИЗ
		|	ВТДокументыСВреднымиФакторами КАК ДокументыСВреднымиФакторами
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСоответствиеВредныхФакторов КАК СоответствиеВредныхФакторов
		|		ПО ДокументыСВреднымиФакторами.ВредныйФактор = СоответствиеВредныхФакторов.ВредныйФактор302Н
		|УПОРЯДОЧИТЬ ПО
		|	Документ
		|ИТОГИ
		|ПО
		|	Документ,
		|	ВредныйФактор302Н";
		
	БлокировкаДанных = Новый БлокировкаДанных;
	БлокировкаДанных.Добавить("Документ.НаправлениеНаМедицинскийОсмотр");
	БлокировкаДанных.Добавить("Документ.ЗаключениеМедицинскогоОсмотра");
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных.Заблокировать();
		
		ВыборкаДокументов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаДокументов.Следующий() Цикл
			Обработанные.Добавить(ВыборкаДокументов.Документ);
			ДокументОбъект = ВыборкаДокументов.Документ.ПолучитьОбъект();
			ВыборкаВредныхФакторов = ВыборкаДокументов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			КоличествоФакторов = ВыборкаВредныхФакторов.Количество();
			ВредныеФакторыСопоставлены = Истина;
			Пока ВыборкаВредныхФакторов.Следующий() Цикл
				Если КоличествоФакторов = 1 И Не ЗначениеЗаполнено(ВыборкаВредныхФакторов.ВредныйФактор302Н) Тогда
					Прервать;
				КонецЕсли;
				Выборка = ВыборкаВредныхФакторов.Выбрать();
				Если Выборка.Количество() > 1 Тогда;
					ВредныеФакторыСопоставлены = Ложь;
				КонецЕсли;
				Пока Выборка.Следующий() Цикл
					Если Выборка.ЕстьСоответствие Тогда
						ДокументОбъект.ВредныеФакторыИВидыРабот.Добавить().ВредныйФактор = Выборка.ВредныйФактор29Н;
					Иначе
						ВредныеФакторыСопоставлены = Ложь;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Если ВредныеФакторыСопоставлены Или ДокументОбъект.ВредныеФакторыИВидыРабот.Количество() > 0 Тогда
				ДокументОбъект.ВредныеФакторыИВидыРабот.Свернуть("ВредныйФактор");
				ДокументОбъект.ВредныеФакторыИВидыРабот.Сортировать("ВредныйФактор");
				Если ТипЗнч(ВыборкаДокументов.Документ) = Тип("ДокументСсылка.ЗаключениеМедицинскогоОсмотра") И ДокументОбъект.Проведен Тогда
					ДокументОбъект.ЗаполнитьМедицинскиеОсмотрыПоВреднымФакторам();
				КонецЕсли;
				ЗаблокироватьДанныеДляРедактирования(ВыборкаДокументов.Документ);
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ПредставлениеОбработки = НСтр("ru = 'Заполнение медицинских документов вредными факторами из классификатора по приказу №29н'"); 
		ЗарегистрироватьОшибкуОбработкиМедицинскихОсмотров(ИнформацияОбОшибке(), ПредставлениеОбработки);
		ВызватьИсключение;
	КонецПопытки;
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	
КонецПроцедуры

Процедура ЗаполнитьОрганизацииРабочихМест(ПараметрыОбновления = Неопределено) Экспорт
	
	Если ПараметрыОбновления = Неопределено Тогда
		ПараметрыОбновления = Новый Структура("ОбработкаЗавершена");
	КонецЕсли;
	
	ИменаРегистров = Новый Массив;
	ИменаРегистров.Добавить("ВидыРаботМедицинскихОсмотровРабочегоМеста");
	ИменаРегистров.Добавить("ВредныеФакторыИВидыРаботРабочегоМеста");
	ИменаРегистров.Добавить("ВредныеФакторыРабочегоМеста");
	ИменаРегистров.Добавить("ПериодичностьМедицинскихОсмотровРабочихМест");
	
	БлокировкаДанных = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		БлокировкаДанных.Добавить("РегистрСведений." + ИмяРегистра);
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных.Заблокировать();
		
		Для Каждого ИмяРегистра Из ИменаРегистров Цикл
			НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
			НаборЗаписей.Прочитать();
			Замещение = Истина;
			ЗаполнитьОрганизацию(НаборЗаписей, Замещение);
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Замещение);
		КонецЦикла;
		
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	Исключение
		ОтменитьТранзакцию();
		ПредставлениеОбработки = НСтр("ru = 'Заполнение организаций для рабочих мест в регистрах сведений медосмотров'");
		ЗарегистрироватьОшибкуОбработкиМедицинскихОсмотров(ИнформацияОбОшибке(), ПредставлениеОбработки);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция НаборЗаписейРегистраСведенийИзВыборки(Выборка, ИмяРегистра)

	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат НаборЗаписей;

КонецФункции

Процедура ОбновитьПериодическиеОсмотрыСотрудниковДо21Года(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПсихиатрическоеОсвидетельствование", Перечисления.ВидыОбследований.ПсихиатрическоеОсвидетельствование);
	Запрос.УстановитьПараметр("МаксимальнаяДата", НачалоДня(ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата()));
	Запрос.УстановитьПараметр("МедицинскийОсмотр", Перечисления.ВидыОбследований.МедицинскийОсмотр);
	Запрос.УстановитьПараметр("ТекущаяДата", ОбщегоНазначения.ТекущаяДатаПользователя());
	
	Обработанные = ЗначениеПараметраОбновленияОбработанные(ПараметрыОбновления);
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПериодическиеОсмотры.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ПериодическиеОсмотры.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПериодическиеОсмотры.ВидОсмотра КАК ВидОсмотра,
		|	ПериодическиеОсмотры.ДатаСледующегоОсмотра КАК ДатаСледующегоОсмотра,
		|	ДОБАВИТЬКДАТЕ(ПериодическиеОсмотры.ФизическоеЛицо.ДатаРождения, ГОД, 21) КАК Дата21Год
		|ПОМЕСТИТЬ ВТПериодическиеОсмотры
		|ИЗ
		|	РегистрСведений.ПериодическиеМедицинскиеОсмотры КАК ПериодическиеОсмотры
		|ГДЕ
		|	НЕ ПериодическиеОсмотры.ФизическоеЛицо В (&Обработанные)
		|	И ДОБАВИТЬКДАТЕ(ПериодическиеОсмотры.ФизическоеЛицо.ДатаРождения, ГОД, 21) > &ТекущаяДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПериодическиеОсмотры.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ПериодическиеОсмотры.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	ВТПериодическиеОсмотры КАК ПериодическиеОсмотры
		|ГДЕ
		|	ПериодическиеОсмотры.ВидОсмотра = &ПсихиатрическоеОсвидетельствование
		|	И ПериодическиеОсмотры.ДатаСледующегоОсмотра < &МаксимальнаяДата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПериодическиеОсмотры.ГоловнаяОрганизация,
		|	ПериодическиеОсмотры.ФизическоеЛицо
		|ИЗ
		|	ВТПериодическиеОсмотры КАК ПериодическиеОсмотры
		|ГДЕ
		|	ПериодическиеОсмотры.ВидОсмотра = &МедицинскийОсмотр
		|	И ПериодическиеОсмотры.Дата21Год < ДОБАВИТЬКДАТЕ(&ТекущаяДата, ГОД, 1)";
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);
	
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	ТаблицаОбновления = НоваяТаблицаОбновлениеПериодическихОсмотров();
	Выборка = ОбновляемыеДанные.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), Выборка);
	КонецЦикла;
	ТаблицаОбновления.Свернуть("ГоловнаяОрганизация,ФизическоеЛицо");
	
	ЗарегистрироватьОбновлениеПериодическихОсмотров(ТаблицаОбновления);
	ФизическиеЛица = ТаблицаОбновления.ВыгрузитьКолонку("ФизическоеЛицо");
	ЗапуститьОбновлениеПериодическихОсмотров(, ФизическиеЛица);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Обработанные, ФизическиеЛица, Истина);
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРеглотчетности

// Процедура заполняет структуру показателей.
// Ключ структуры - идентификатор показателя.
// Значение структуры - массив из двух элементов:
// 	- признак автозаполнения показателя,
//	- признак расшифровки показателя.
//
// Параметры:
// 	ПоказателиОтчета - структура показателей отчета.
//
Процедура ОписаниеПоказателей_ЕФС1ОСС_2023Кв1(ПоказателиОтчета, Организация)
	
	Если Не МедицинскиеОсмотрыИспользуются(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, "П000230000100", Истина, Ложь);
	ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, "П000230000200", Истина, Ложь);
	
КонецПроцедуры

// Процедура заполняет переданную в виде контейнера структуру данных отчета.
//
Процедура ЗначенияПоказателей_ЕФС1ОСС_2023Кв1(ПараметрыОтчета, Контейнер)
	
	ОписаниеТаблиц = Новый Структура("Раздел23");
	РасчетПоказателей_ЕФС1ОСС_2023Кв1(НачалоГода(ПараметрыОтчета.ДатаКонцаПериодаОтчета), ПараметрыОтчета.Организация, ОписаниеТаблиц);
	
	ЗаполнитьЗначенияСвойств(Контейнер.Раздел23.Строки[0].Данные, ОписаниеТаблиц.Раздел23);
	
КонецПроцедуры

Процедура РасчетПоказателей_ЕФС1ОСС_2023Кв1(НачалоПериода, Организация, ОписаниеТаблиц)
	
	Если ОписаниеТаблиц.Свойство("Раздел23") Тогда 
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		СоздатьВТКадровыеДанныеДляМедосмотров(Запрос.МенеджерВременныхТаблиц, НачалоПериода, Организация);
		
		Запрос.Текст =
