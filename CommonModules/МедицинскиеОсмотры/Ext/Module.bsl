Функция ВыданноеНаправление(ФизическоеЛицо, РабочееМесто, ВидОсмотра) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("ВидОсмотра", ВидОсмотра);
