Функция ЗапросВТОсмотрыПоВреднымФакторамФизическихЛиц(ТолькоРазрешенные, ОписательВременныхТаблиц,
	ДатаАктуальности = Неопределено, УчитыватьРаботы = Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсмотрыПоВреднымФакторам.Период КАК ДатаОсмотра,
	|	ОсмотрыПоВреднымФакторам.Регистратор КАК Регистратор,
	|	ОсмотрыПоВреднымФакторам.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ОсмотрыПоВреднымФакторам.ВредныйФактор КАК ВредныйФактор,
	|	ОсмотрыПоВреднымФакторам.РезультатОсмотра КАК РезультатОсмотра
	|ПОМЕСТИТЬ ВТОсмотрыПоВреднымФакторамПредварительные
	|ИЗ
	|	РегистрСведений.МедицинскиеОсмотрыПоВреднымФакторам.СрезПоследних(&ДатаАктуальности, ФизическоеЛицо В
	|		(ВЫБРАТЬ
	|			ТаблицаОтборов.ФизическоеЛицо
	|		ИЗ
	|			ВТОтборовРазличныхФизическихЛиц КАК ТаблицаОтборов)
	|	И ВредныйФактор ССЫЛКА Справочник.ВредныеОпасныеПроизводственныеФакторы) КАК ОсмотрыПоВреднымФакторам
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ФизическоеЛицо,
	|	ВредныйФактор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсмотрыПоВреднымФакторам.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ОсмотрыПоВреднымФакторам.ВредныйФактор КАК ВредныйФактор,
	|	МАКСИМУМ(ОсмотрыПоВреднымФакторам.ДатаОсмотра) КАК ДатаОсмотра
	|ПОМЕСТИТЬ ВТОсмотрыПоВреднымФакторамПредварительныеСгруппированные
	|ИЗ
	|	ВТОсмотрыПоВреднымФакторамПредварительные КАК ОсмотрыПоВреднымФакторам
	|СГРУППИРОВАТЬ ПО
	|	ОсмотрыПоВреднымФакторам.ФизическоеЛицо,
	|	ОсмотрыПоВреднымФакторам.ВредныйФактор
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ФизическоеЛицо,
	|	ВредныйФактор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Осмотры.ДатаОсмотра КАК ДатаОсмотра,
	|	МАКСИМУМ(Осмотры.Регистратор) КАК Регистратор,
	|	Осмотры.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Осмотры.ВредныйФактор КАК ВредныйФактор,
	|	МАКСИМУМ(Осмотры.РезультатОсмотра) КАК РезультатОсмотра
	|ПОМЕСТИТЬ ВТОсмотрыПоВреднымФакторамФизическихЛиц
	|ИЗ
	|	ВТОсмотрыПоВреднымФакторамПредварительные КАК Осмотры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОсмотрыПоВреднымФакторамПредварительныеСгруппированные КАК ОсмотрыСгруппированные
	|		ПО Осмотры.ДатаОсмотра = ОсмотрыСгруппированные.ДатаОсмотра
	|		И Осмотры.ФизическоеЛицо = ОсмотрыСгруппированные.ФизическоеЛицо
	|		И Осмотры.ВредныйФактор = ОсмотрыСгруппированные.ВредныйФактор
	|СГРУППИРОВАТЬ ПО
	|	Осмотры.ДатаОсмотра,
	|	Осмотры.ФизическоеЛицо,
	|	Осмотры.ВредныйФактор";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОтборов.ФизическоеЛицо", СтрШаблон("ТаблицаОтборов.%1",
		ОписательВременныхТаблиц.ПолеОтбораФизическогоЛица));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТОтборовРазличныхФизическихЛиц",
		ОписательВременныхТаблиц.ИмяВТОтборовРазличныхФизическихЛиц);
	ЗарплатаКадрыОбщиеНаборыДанных.ЗаменитьИмяСоздаваемойВременнойТаблицы(Запрос.Текст,
		"ВТОсмотрыПоВреднымФакторамФизическихЛиц", ОписательВременныхТаблиц.ИмяВТОсмотрыПоВреднымФакторамФизическихЛиц);

	Если УчитыватьРаботы Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВредныеОпасныеПроизводственныеФакторы", "ВредныеОпасныеПроизводственныеФакторыИВыполняемыеРаботы");
	КонецЕсли;
	
	Если ДатаАктуальности = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаАктуальности", "");
	ИначеЕсли ТипЗнч(ДатаАктуальности) = Тип("Строка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаАктуальности", ДатаАктуальности);
	Иначе
		Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	КонецЕсли;
	
	ЗарплатаКадрыОбщиеНаборыДанных.УстановитьВыборкуТолькоРазрешенныхДанных(Запрос.Текст, ТолькоРазрешенные);
	
	ВТКУничтожению = Новый Массив;
	ВТКУничтожению.Добавить("ВТОсмотрыПоВреднымФакторамПредварительные");
	ВТКУничтожению.Добавить("ВТОсмотрыПоВреднымФакторамПредварительныеСгруппированные");
	
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьЗапросыУничтоженияВременныхТаблиц(Запрос.Текст, ВТКУничтожению);
	
	Возврат Запрос;
	
КонецФункции

