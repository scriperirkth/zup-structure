Функция ЗапросВТПериодичностьВредныхФакторов(ТолькоРазрешенные, ОписательВременныхТаблиц)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОтборов.ВредныйФактор КАК ВредныйФактор
	|ПОМЕСТИТЬ ВТРазличныеВредныеФакторы
	|ИЗ
	|	ИмяВТОтборовВредныхФакторов КАК ТаблицаОтборов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВредныеФакторы.Ссылка КАК ВредныйФактор,
	|	ВредныеФакторы.КратностьОсмотра КАК Кратность,
	|	ВредныеФакторы.ПериодичностьОсмотра КАК Периодичность,
	|	ВредныеФакторы.ЕдиницаПериодичностиОсмотра КАК ЕдиницаПериодичности,
	|	ВредныеФакторы.Однократно КАК Однократно,
	|	ВредныеФакторы.ПредставлениеПериодичностиОсмотра КАК Представление
	|ПОМЕСТИТЬ ВТПериодичностьВредныхФакторов
	|ИЗ
	|	Справочник.ВредныеОпасныеПроизводственныеФакторы КАК ВредныеФакторы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТРазличныеВредныеФакторы КАК РазличныеВредныеФакторы
	|		ПО ВредныеФакторы.Ссылка = РазличныеВредныеФакторы.ВредныйФактор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВредныеФакторы.Ссылка,
	|	ВредныеФакторы.КратностьОсмотра,
	|	ВредныеФакторы.ПериодичностьОсмотра,
	|	ВредныеФакторы.ЕдиницаПериодичностиОсмотра,
	|	ВредныеФакторы.Однократно КАК Однократно,
	|	ВредныеФакторы.ПредставлениеПериодичностиОсмотра
	|ИЗ
	|	Справочник.ВредныеОпасныеПроизводственныеФакторыИВыполняемыеРаботы КАК ВредныеФакторы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТРазличныеВредныеФакторы КАК РазличныеВредныеФакторы
	|		ПО ВредныеФакторы.Ссылка = РазличныеВредныеФакторы.ВредныйФактор";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОтборов.ВредныйФактор", СтрШаблон("ТаблицаОтборов.%1",
		ОписательВременныхТаблиц.ПолеОтбораВредногоФактора));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВТОтборовВредныхФакторов",
		ОписательВременныхТаблиц.ИмяВТОтборовВредныхФакторов);
	ЗарплатаКадрыОбщиеНаборыДанных.ЗаменитьИмяСоздаваемойВременнойТаблицы(Запрос.Текст,
		"ВТПериодичностьВредныхФакторов", ОписательВременныхТаблиц.ИмяВТПериодичностьВредныхФакторов);

	ЗарплатаКадрыОбщиеНаборыДанных.УстановитьВыборкуТолькоРазрешенныхДанных(Запрос.Текст, ТолькоРазрешенные);

