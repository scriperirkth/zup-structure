		ВидОсмотра);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.ВредныйФактор КАК ВредныйФактор,
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.ПоследнийОсмотр КАК ПоследнийОсмотр,
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.Регистратор КАК Регистратор,
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.РезультатОсмотра КАК Результат,
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.ТребуетсяРабочимМестом КАК Требуется,
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.Кратность КАК Кратность,
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.Периодичность КАК Периодичность,
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.ЕдиницаПериодичности КАК ЕдиницаПериодичности,
	|	СведенияОсмотровПоВреднымФакторамФизическихЛиц.Однократно КАК Однократно
	|ИЗ
	|	ВТСведенияОсмотровПоВреднымФакторамФизическихЛиц КАК СведенияОсмотровПоВреднымФакторамФизическихЛиц";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьСтрокуТаблицыОсмотровПоФакторам(ОсмотрыПоФакторам, Выборка);
	КонецЦикла;

	Возврат ОсмотрыПоФакторам;

