		|	ВТ_ПредварительныеПериодическиеОсмотры.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ВТ_ПредварительныеПериодическиеОсмотры.РабочееМесто КАК РабочееМесто,
		|	ВТ_ПредварительныеПериодическиеОсмотры.ДатаУвольнения КАК ДатаУвольнения,
		|	ВТ_ПредварительныеПериодическиеОсмотры.ВидОсмотра КАК ВидОсмотра,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Дата21Год КАК Дата21Год,
		|	МАКСИМУМ(ВТ_ПредварительныеПериодическиеОсмотры.ДатаПройденногоОсмотра) КАК ДатаПройденногоОсмотра,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Направление КАК Направление,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Заключение КАК Заключение,
		|	ВТ_ПредварительныеПериодическиеОсмотры.РезультатОсмотра КАК РезультатОсмотра,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Однократно КАК Однократно,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Кратность КАК Кратность,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Периодичность КАК Периодичность,
		|	ВТ_ПредварительныеПериодическиеОсмотры.ЕдиницаПериодичности КАК ЕдиницаПериодичности
		|ИЗ
		|	ВТ_ПредварительныеПериодическиеОсмотры КАК ВТ_ПредварительныеПериодическиеОсмотры
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ПредварительныеПериодическиеОсмотры.ФизическоеЛицо,
		|	ВТ_ПредварительныеПериодическиеОсмотры.ГоловнаяОрганизация,
		|	ВТ_ПредварительныеПериодическиеОсмотры.РабочееМесто,
		|	ВТ_ПредварительныеПериодическиеОсмотры.ДатаУвольнения,
		|	ВТ_ПредварительныеПериодическиеОсмотры.ВидОсмотра,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Дата21Год,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Направление,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Заключение,
		|	ВТ_ПредварительныеПериодическиеОсмотры.РезультатОсмотра,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Однократно,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Кратность,
		|	ВТ_ПредварительныеПериодическиеОсмотры.Периодичность,
		|	ВТ_ПредварительныеПериодическиеОсмотры.ЕдиницаПериодичности
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидОсмотра,
		|	ФизическоеЛицо,
		|	ДатаУвольнения УБЫВ,
		|	РабочееМесто";
	
	// АПК:96 -вкл
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("ВидОсмотра") Цикл
		Пока Выборка.СледующийПоЗначениюПоля("ФизическоеЛицо") Цикл
			Пока Выборка.СледующийПоЗначениюПоля("РабочееМесто") Цикл
				НоваяСтрока = ПериодическиеОсмотры.Добавить();
				Пока Выборка.Следующий() Цикл
					ОписаниеПериодичности = ОписаниеПериодичностиОсмотров();
					ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Выборка);
					ДатаСледующегоОсмотра = ДатаСледующегоОсмотра(Выборка.ДатаПройденногоОсмотра, ОписаниеПериодичности);
					УстановитьДатуСледующегоОсмотраСотрудникуДо21Года(Выборка, ДатаСледующегоОсмотра);
					Если Не ЗначениеЗаполнено(НоваяСтрока.ДатаСледующегоОсмотра) Тогда
						НоваяСтрока.ДатаСледующегоОсмотра = ДатаСледующегоОсмотра;
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
					Иначе
						Если ДатаСледующегоОсмотра < НоваяСтрока.ДатаСледующегоОсмотра Тогда
							НоваяСтрока.ДатаСледующегоОсмотра = ДатаСледующегоОсмотра;
							ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
						КонецЕсли;
					КонецЕсли;
					Если ЗначениеЗаполнено(Выборка.ДатаУвольнения) И НоваяСтрока.ДатаСледующегоОсмотра >= Выборка.ДатаУвольнения Тогда
						НоваяСтрока.ДатаСледующегоОсмотра = Дата("00010101");
					КонецЕсли;
					Если Выборка.ДатаПройденногоОсмотра > НоваяСтрока.ДатаПройденногоОсмотра Тогда
						НоваяСтрока.ДатаПройденногоОсмотра = Выборка.ДатаПройденногоОсмотра;
						НоваяСтрока.Направление = Выборка.Направление;
						НоваяСтрока.Заключение = Выборка.Заключение;
						НоваяСтрока.РезультатОсмотра = Выборка.РезультатОсмотра;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьДатуСледующегоОсмотраСотрудникуДо21Года(Знач Выборка, ДатаСледующегоОсмотра)
	
	Если Выборка.ВидОсмотра = Перечисления.ВидыОбследований.ПсихиатрическоеОсвидетельствование Тогда
		Возврат;
	КонецЕсли;
	
	ДатаОсмотраЧерезГодПослеПройденного = ДобавитьМесяц(Выборка.ДатаПройденногоОсмотра, 12);
	Если ДатаОсмотраЧерезГодПослеПройденного < Выборка.Дата21Год Тогда
		ДатаСледующегоОсмотра = Мин(ДатаСледующегоОсмотра, ДатаОсмотраЧерезГодПослеПройденного);
	КонецЕсли;

КонецПроцедуры

