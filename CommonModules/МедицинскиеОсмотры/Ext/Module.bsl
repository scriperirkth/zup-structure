		УстановитьПривилегированныйРежим(Ложь);
		
		ПериодическиеМедицинскиеОсмотры = ПериодическиеОсмотры.НайтиСтроки(Новый Структура("ВидОсмотра", Перечисления.ВидыОбследований.МедицинскийОсмотр));
		
		ОписаниеТаблиц.Раздел23 = НовыйРаздел23ЕФС1();

		ОписаниеТаблиц.Раздел23.П000230000100 = ПериодическиеМедицинскиеОсмотры.Количество();
		
		ПройденныеОсмотры = 0;
		Для Каждого СтрокаОсмотра Из ПериодическиеМедицинскиеОсмотры Цикл
			Если СтрокаОсмотра.ДатаСледующегоОсмотра < НачалоПериода Или Не ЗначениеЗаполнено(СтрокаОсмотра.ДатаПройденногоОсмотра) Тогда
				Продолжить;
			КонецЕсли;
			ПройденныеОсмотры = ПройденныеОсмотры + 1;
		КонецЦикла;
		
		ОписаниеТаблиц.Раздел23.П000230000200 = ПройденныеОсмотры;
    КонецЕсли;
	
