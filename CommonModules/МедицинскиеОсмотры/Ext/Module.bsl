КонецПроцедуры

Функция ЗапросВТСведенияОсмотровПоВидамРаботФизическихЛиц(ТолькоРазрешенные, ОписательВременныхТаблиц,
	ДатаАктуальности = Неопределено, ВидОсмотра = Неопределено)

	Запрос = Новый Запрос;
	ВТКУничтожению = Новый Массив;

	ТекстЗапросаОтборовРазличныхРабочихМест =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОтборов.РабочееМесто КАК РабочееМесто
	|ПОМЕСТИТЬ ВТОтборовРазличныхРабочихМест
	|ИЗ
	|	ИмяВТОтборовФизическихЛиц КАК ТаблицаОтборов";

	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьТекстыЗапросов(Запрос.Текст, ТекстЗапросаОтборовРазличныхРабочихМест);

	ОписательВТВидыРаботРабочегоМеста = ОписательВременныхТаблицДляСоздатьВТВидыРаботРабочегоМеста(
		"ВТОтборовРазличныхРабочихМест");
	ЗапросВТВидыРаботРабочегоМеста = ЗапросВТВидыРаботРабочегоМеста(ТолькоРазрешенные,
		ОписательВТВидыРаботРабочегоМеста, ВидОсмотра);

	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьЗапросы(Запрос, ЗапросВТВидыРаботРабочегоМеста);

	ВТКУничтожению.Добавить("ВТОтборовРазличныхРабочихМест");
	ВТКУничтожению.Добавить("ВТВидыРаботРабочегоМеста");

	ТекстЗапросаОтборовРазличныхФизическихЛиц =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОтборов.ФизическоеЛицо КАК ФизическоеЛицо
	|ПОМЕСТИТЬ ВТОтборовРазличныхФизическихЛиц
	|ИЗ
	|	ИмяВТОтборовФизическихЛиц КАК ТаблицаОтборов";

	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьТекстыЗапросов(Запрос.Текст, ТекстЗапросаОтборовРазличныхФизическихЛиц);

	ОписательВТОсмотрыПоВидамРаботФизическогоЛица = ОписательВременныхТаблицДляСоздатьВТОсмотрыПоВидамРаботФизическогоЛица(
		"ВТОтборовРазличныхФизическихЛиц");
	ЗапросВТОсмотрыПоВидамРаботФизическогоЛица = ЗапросВТОсмотрыПоВидамРаботФизическогоЛица(ТолькоРазрешенные,
		ОписательВТОсмотрыПоВидамРаботФизическогоЛица, ДатаАктуальности);

	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьЗапросы(Запрос, ЗапросВТОсмотрыПоВидамРаботФизическогоЛица);

	ВТКУничтожению.Добавить("ВТОтборовРазличныхФизическихЛиц");
	ВТКУничтожению.Добавить("ВТОсмотрыПоВидамРаботФизическогоЛица");

	ТекстЗапросаСостоянийОсмотров =
	"ВЫБРАТЬ
	|	ТаблицаОтборов.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаОтборов.РабочееМесто КАК РабочееМесто,
	|	ОсмотрыПоВидамРаботФизическогоЛица.ВидРабот КАК ВидРабот,
	|	ОсмотрыПоВидамРаботФизическогоЛица.ДатаОсмотра КАК ПоследнийОсмотр,
	|	ОсмотрыПоВидамРаботФизическогоЛица.Регистратор КАК Регистратор,
	|	ОсмотрыПоВидамРаботФизическогоЛица.РезультатОсмотра КАК РезультатОсмотра,
	|	ВЫБОР
	|		КОГДА ВидыРаботРабочегоМеста.ВидРабот ЕСТЬ НЕ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТребуетсяРабочимМестом
	|ПОМЕСТИТЬ ВТСостояниеОсмотров
	|ИЗ
	|	ИмяВТОтборовФизическихЛиц КАК ТаблицаОтборов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОсмотрыПоВидамРаботФизическогоЛица КАК ОсмотрыПоВидамРаботФизическогоЛица
	|		ПО ТаблицаОтборов.ФизическоеЛицо = ОсмотрыПоВидамРаботФизическогоЛица.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВидыРаботРабочегоМеста КАК ВидыРаботРабочегоМеста
	|		ПО ТаблицаОтборов.РабочееМесто = ВидыРаботРабочегоМеста.РабочееМесто
	|		И ВидыРаботРабочегоМеста.ВидРабот = ОсмотрыПоВидамРаботФизическогоЛица.ВидРабот
	|		И ВЫБОР
	|			КОГДА &ЕстьВидОсмотра
	|				ТОГДА ВидыРаботРабочегоМеста.ВидОсмотра = &ВидОсмотра
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаОтборов.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаОтборов.РабочееМесто КАК РабочееМесто,
	|	ВидыРаботРабочегоМеста.ВидРабот,
	|	NULL,
	|	NULL,
	|	NULL,
	|	ИСТИНА
	|ИЗ
	|	ИмяВТОтборовФизическихЛиц КАК ТаблицаОтборов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВидыРаботРабочегоМеста КАК ВидыРаботРабочегоМеста
	|		ПО ТаблицаОтборов.РабочееМесто = ВидыРаботРабочегоМеста.РабочееМесто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОсмотрыПоВидамРаботФизическогоЛица КАК ОсмотрыПоВидамРаботФизическогоЛица
	|		ПО ТаблицаОтборов.ФизическоеЛицо = ОсмотрыПоВидамРаботФизическогоЛица.ФизическоеЛицо
	|		И ВидыРаботРабочегоМеста.ВидРабот = ОсмотрыПоВидамРаботФизическогоЛица.ВидРабот
	|ГДЕ
	|	ОсмотрыПоВидамРаботФизическогоЛица.ВидРабот ЕСТЬ NULL";

	Если ТипЗнч(ВидОсмотра) = Тип("Строка") Тогда
		ТекстЗапросаСостоянийОсмотров = СтрЗаменить(ТекстЗапросаСостоянийОсмотров, "&ВидОсмотра", ВидОсмотра);
	КонецЕсли;

	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьТекстыЗапросов(Запрос.Текст, ТекстЗапросаСостоянийОсмотров);

	ВТКУничтожению.Добавить("ВТСостояниеОсмотров");

	ОписательВТПериодичностьВидовРабот = ОписательВременныхТаблицДляСоздатьВТПериодичностьВидовРабот(
		"ВТСостояниеОсмотров");
	ЗапросВТПериодичностьВидовРабот = ЗапросВТПериодичностьВидовРабот(ТолькоРазрешенные,
		ОписательВТПериодичностьВидовРабот);

	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьЗапросы(Запрос, ЗапросВТПериодичностьВидовРабот);

	ВТКУничтожению.Добавить("ВТПериодичностьВидовРабот");

	ТекстЗапросаОсмотровПоВреднымФакторамИВидамРабот =
	"ВЫБРАТЬ
	|	СостояниеОсмотров.ФизическоеЛицо КАК ФизическоеЛицо,
	|	СостояниеОсмотров.РабочееМесто КАК РабочееМесто,
	|	СостояниеОсмотров.ВидРабот КАК ВидРабот,
	|	СостояниеОсмотров.ПоследнийОсмотр КАК ПоследнийОсмотр,
	|	СостояниеОсмотров.Регистратор КАК Регистратор,
	|	СостояниеОсмотров.РезультатОсмотра КАК РезультатОсмотра,
	|	СостояниеОсмотров.ТребуетсяРабочимМестом КАК ТребуетсяРабочимМестом,
	|	ПериодичностьВидовРабот.Кратность КАК Кратность,
	|	ПериодичностьВидовРабот.Периодичность КАК Периодичность,
	|	ПериодичностьВидовРабот.ЕдиницаПериодичности КАК ЕдиницаПериодичности,
	|	ПериодичностьВидовРабот.Однократно КАК Однократно
	|ПОМЕСТИТЬ ВТСведенияОсмотровПоВидамРаботФизическихЛиц
	|ИЗ
	|	ВТСостояниеОсмотров КАК СостояниеОсмотров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПериодичностьВидовРабот КАК ПериодичностьВидовРабот
	|		ПО СостояниеОсмотров.ВидРабот = ПериодичностьВидовРабот.ВидРабот";

	ЗарплатаКадрыОбщиеНаборыДанных.ЗаменитьИмяСоздаваемойВременнойТаблицы(
		ТекстЗапросаОсмотровПоВреднымФакторамИВидамРабот, "ВТСведенияОсмотровПоВидамРаботФизическихЛиц",
		ОписательВременныхТаблиц.ИмяВТСведенияОсмотровПоВидамРаботФизическихЛиц);

	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьТекстыЗапросов(Запрос.Текст,
		ТекстЗапросаОсмотровПоВреднымФакторамИВидамРабот);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОтборов.РабочееМесто", СтрШаблон("ТаблицаОтборов.%1",
		ОписательВременныхТаблиц.ПоляОтбораФизическихЛиц.РабочееМесто));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОтборов.ФизическоеЛицо", СтрШаблон("ТаблицаОтборов.%1",
		ОписательВременныхТаблиц.ПоляОтбораФизическихЛиц.ФизическоеЛицо));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВТОтборовФизическихЛиц",
		ОписательВременныхТаблиц.ИмяВТОтборовФизическихЛиц);

	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьЗапросыУничтоженияВременныхТаблиц(Запрос.Текст, ВТКУничтожению);

	Возврат Запрос;

КонецФункции

Функция ОписательВременныхТаблицДляСоздатьВТВредныеФакторыРабочегоМеста(ИмяВТОтборовРазличныхРабочихМест,
	ИменаПолейВременнойТаблицыОтборовРабочихМест = "РабочееМесто") Экспорт

	ОписательВременныхТаблиц = Новый Структура;

	ОписательВременныхТаблиц.Вставить("ИмяВТОтборовРазличныхРабочихМест", ИмяВТОтборовРазличныхРабочихМест);
	ОписательВременныхТаблиц.Вставить("ПолеОтбораРабочихМест", ИменаПолейВременнойТаблицыОтборовРабочихМест);
	ОписательВременныхТаблиц.Вставить("ИмяВТВредныеФакторыРабочегоМеста", "ВТВредныеФакторыРабочегоМеста");

	Возврат ОписательВременныхТаблиц;

КонецФункции

Процедура СоздатьВТВредныеФакторыРабочегоМеста(МенеджерВременныхТаблиц, РабочееМесто, ВидОсмотра)

	Запрос = Новый Запрос;
	ВТКУничтожению = Новый Массив;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	&РабочееМесто КАК РабочееМесто
	|ПОМЕСТИТЬ ВТОтборовРазличныхРабочихМест";

	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);

	ОписательВременныхТаблиц = ОписательВременныхТаблицДляСоздатьВТВредныеФакторыРабочегоМеста(
		"ВТОтборовРазличныхРабочихМест");

	ЗапросВТВредныеФакторыРабочегоМеста = ЗапросВТВредныеФакторыРабочегоМеста(Ложь, ОписательВременныхТаблиц, ВидОсмотра);

	ЗарплатаКадрыОбщиеНаборыДанных.ОбъединитьЗапросы(Запрос, ЗапросВТВредныеФакторыРабочегоМеста);

	ВТКУничтожению.Добавить("ВТОтборовРазличныхРабочихМест");
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьЗапросыУничтоженияВременныхТаблиц(Запрос.Текст, ВТКУничтожению);

	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;

	Запрос.Выполнить();

КонецПроцедуры

Функция ЗапросВТВредныеФакторыРабочегоМеста(ТолькоРазрешенные, ОписательВременныхТаблиц,
	ВидОсмотра = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаОтборов.РабочееМесто КАК РабочееМесто,
		|	ВредныеФакторыРабочегоМеста.ВидОсмотра КАК ВидОсмотра,
		|	ВредныеФакторыРабочегоМеста.ВредныйФактор.Код КАК Код,
		|	ВредныеФакторыРабочегоМеста.ВредныйФактор КАК ВредныйФактор
		|ПОМЕСТИТЬ ВТВредныеФакторыРабочегоМеста
		|ИЗ
		|	ВТОтборовРазличныхРабочихМест КАК ТаблицаОтборов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВредныеФакторыРабочегоМеста КАК
		|			ВредныеФакторыРабочегоМеста
		|		ПО ТаблицаОтборов.РабочееМесто = ВредныеФакторыРабочегоМеста.РабочееМесто
		|		И ВЫБОР
		|			КОГДА &ЕстьВидОсмотра
		|				ТОГДА ВредныеФакторыРабочегоМеста.ВидОсмотра = &ВидОсмотра
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Если ТипЗнч(ВидОсмотра) = Тип("Строка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидОсмотра", ВидОсмотра);
	Иначе
		Запрос.УстановитьПараметр("ВидОсмотра", ВидОсмотра);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЕстьВидОсмотра", Не ВидОсмотра = Неопределено);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОтборов.РабочееМесто", СтрШаблон("ТаблицаОтборов.%1",
		ОписательВременныхТаблиц.ПолеОтбораРабочихМест));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТОтборовРазличныхРабочихМест",
		ОписательВременныхТаблиц.ИмяВТОтборовРазличныхРабочихМест);
	ЗарплатаКадрыОбщиеНаборыДанных.ЗаменитьИмяСоздаваемойВременнойТаблицы(Запрос.Текст,
		"ВТВредныеФакторыРабочегоМеста", ОписательВременныхТаблиц.ИмяВТВредныеФакторыРабочегоМеста);

	ЗарплатаКадрыОбщиеНаборыДанных.УстановитьВыборкуТолькоРазрешенныхДанных(Запрос.Текст, ТолькоРазрешенные);

	Возврат Запрос;
	
КонецФункции

Функция ОписательВременныхТаблицДляСоздатьВТВредныеФакторыИВидыРаботРабочегоМеста(ИмяВТОтборовРазличныхРабочихМест,
	ИменаПолейВременнойТаблицыОтборовРабочихМест = "РабочееМесто") Экспорт

	ОписательВременныхТаблиц = Новый Структура;

