Функция ЗапросПоПредставлению(ИмяПредставления, ТолькоРазрешенные, ПараметрыЗапросаКомпоновки, ИмяВТПредставления,
	ИменаВТИсточниковПараметров) Экспорт
	
	Запрос = Неопределено;
	
	Если Не МедицинскиеОсмотрыИспользуются() Тогда
		Возврат Запрос;
	КонецЕсли;
	
	Если ВРег(ИмяПредставления) = ВРег("ОсмотрыПоВреднымФакторамИВидамРаботФизическихЛиц") Тогда

		ДатаАктуальности = ЗарплатаКадрыОбщиеНаборыДанных.ПараметрЗапроса("ДатаАктуальности",
			ПараметрыЗапросаКомпоновки);
		ВидОсмотра = ЗарплатаКадрыОбщиеНаборыДанных.ПараметрЗапроса("ВидОсмотра", ПараметрыЗапросаКомпоновки);
		ИмяВТИсточникДанных = ИменаВТИсточниковПараметров[0];
		
		ОписательВременныхТаблиц = ОписательВременныхТаблицДляВТСведенияОсмотровПоВреднымФакторамИВидамРаботФизическихЛиц(
			ИмяВТИсточникДанных);
		ОписательВременныхТаблиц.ИмяВТСведенияОсмотровПоВреднымФакторамИВидамРаботФизическихЛиц = ИмяВТПредставления;

		Запрос = ЗапросВТСведенияОсмотровПоВреднымФакторамИВидамРаботФизическихЛиц(ТолькоРазрешенные,
			ОписательВременныхТаблиц, ДатаАктуальности, ВидОсмотра);

	ИначеЕсли ВРег(ИмяПредставления) = ВРег("ОсмотрыПоВреднымФакторамФизическихЛиц") Тогда
	
		ДатаАктуальности = ЗарплатаКадрыОбщиеНаборыДанных.ПараметрЗапроса("ДатаАктуальности",
			ПараметрыЗапросаКомпоновки);
		ВидОсмотра = ЗарплатаКадрыОбщиеНаборыДанных.ПараметрЗапроса("ВидОсмотра", ПараметрыЗапросаКомпоновки);
		ИмяВТИсточникДанных = ИменаВТИсточниковПараметров[0];
		
		ОписательВременныхТаблиц = ОписательВременныхТаблицДляВТСведенияОсмотровПоВреднымФакторамФизическихЛиц(
			ИмяВТИсточникДанных);
		ОписательВременныхТаблиц.ИмяВТСведенияОсмотровПоВреднымФакторамФизическихЛиц = ИмяВТПредставления;

		Запрос = ЗапросВТСведенияОсмотровПоВреднымФакторамФизическихЛиц(ТолькоРазрешенные,
			ОписательВременныхТаблиц, ДатаАктуальности, ВидОсмотра);

	ИначеЕсли ВРег(ИмяПредставления) = ВРег("ОсмотрыПоВидамРаботФизическихЛиц") Тогда

		ДатаАктуальности = ЗарплатаКадрыОбщиеНаборыДанных.ПараметрЗапроса("ДатаАктуальности",
			ПараметрыЗапросаКомпоновки);
		ВидОсмотра = ЗарплатаКадрыОбщиеНаборыДанных.ПараметрЗапроса("ВидОсмотра", ПараметрыЗапросаКомпоновки);
		ИмяВТИсточникДанных = ИменаВТИсточниковПараметров[0];
		
		ОписательВременныхТаблиц = ОписательВременныхТаблицДляВТСведенияОсмотровПоВидамРаботФизическихЛиц(
			ИмяВТИсточникДанных);
		ОписательВременныхТаблиц.ИмяВТСведенияОсмотровПоВидамРаботФизическихЛиц = ИмяВТПредставления;

		Запрос = ЗапросВТСведенияОсмотровПоВидамРаботФизическихЛиц(ТолькоРазрешенные,
			ОписательВременныхТаблиц, ДатаАктуальности, ВидОсмотра);

	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Функция ВредныеФакторыИВидыРаботРабочегоМеста(РабочееМесто, ВидОсмотра = Неопределено) Экспорт
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СоздатьВТВредныеФакторыИВидыРаботРабочегоМеста(МенеджерВременныхТаблиц, РабочееМесто, ВидОсмотра);
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВременныхТаблиц, "ВТВредныеФакторыИВидыРаботРабочегоМеста") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВредныеФакторыИВидыРаботРабочегоМеста.Код КАК Код,
		|	ВредныеФакторыИВидыРаботРабочегоМеста.ВредныйФактор КАК ВредныйФактор
		|ИЗ
		|	ВТВредныеФакторыИВидыРаботРабочегоМеста КАК ВредныеФакторыИВидыРаботРабочегоМеста
		|УПОРЯДОЧИТЬ ПО
		|	Код";
		
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВредныйФактор");
	
КонецФункции

Функция ПериодичностьМедицинскихОсмотров(РабочееМесто, ВидОсмотра = Неопределено) Экспорт
	
	ОписаниеПериодичности = ОписаниеПериодичностиОсмотров();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидОсмотра", ВидОсмотра);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПериодичностьОсмотров.КратностьОсмотра КАК Кратность,
		|	ПериодичностьОсмотров.ПериодичностьОсмотра КАК Периодичность,
		|	ПериодичностьОсмотров.ЕдиницаПериодичностиОсмотра КАК ЕдиницаПериодичности,
		|	ПериодичностьОсмотров.ПредставлениеПериодичностиОсмотра КАК Представление,
		|	ПериодичностьОсмотров.Однократно КАК Однократно
		|ИЗ
		|	РегистрСведений.ПериодичностьМедицинскихОсмотровРабочихМест КАК ПериодичностьОсмотров
		|ГДЕ
		|	ПериодичностьОсмотров.РабочееМесто = &РабочееМесто
		|	И ПериодичностьОсмотров.ВидОсмотра = &ВидОсмотра";
	
	Если ВидОсмотра = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПериодичностьОсмотров.ВидОсмотра = &ВидОсмотра", "ИСТИНА");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ОписаниеПериодичности;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Выборка);
	
	Возврат ОписаниеПериодичности;
	
КонецФункции

Функция ПоследнийОсмотр(ФизическоеЛицо, РабочееМесто, ВидОсмотра, ДатаАктуальности = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("ВидОсмотра", ВидОсмотра);
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МедицинскиеОсмотры.Период КАК Период,
		|	МедицинскиеОсмотры.Регистратор КАК Регистратор,
		|	МедицинскиеОсмотры.ФизическоеЛицо КАК ФизическоеЛицо,
		|	МедицинскиеОсмотры.РабочееМесто КАК РабочееМесто,
		|	МедицинскиеОсмотры.РезультатОсмотра КАК РезультатОсмотра,
		|	МедицинскиеОсмотры.ВидОсмотра КАК ВидОсмотра,
		|	МедицинскиеОсмотры.ТипОсмотра КАК ТипОсмотра,
		|	МедицинскиеОсмотры.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.МедицинскиеОсмотры.СрезПоследних(
		|			&ДатаАктуальности,
		|			ФизическоеЛицо = &ФизическоеЛицо
		|				И ВидОсмотра = &ВидОсмотра
		|				И РабочееМесто = &РабочееМесто) КАК МедицинскиеОсмотры";
	Если ДатаАктуальности = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаАктуальности", "");
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
	
КонецФункции

