Функция АктуальностьОсмотраВПроцентах(ПоследнийОсмотр, СледующийОсмотр)
	
	Если Не ЗначениеЗаполнено(ПоследнийОсмотр) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СледующийОсмотр) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Сегодня = ОбщегоНазначения.ТекущаяДатаПользователя();

	Если Сегодня > СледующийОсмотр Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Сегодня < ПоследнийОсмотр Тогда
		Возврат 100;
	КонецЕсли;
	
	Возврат ((СледующийОсмотр - Сегодня) / (СледующийОсмотр - ПоследнийОсмотр)) * 100;
	
КонецФункции

Процедура ДобавитьСтрокуТаблицыОсмотровПоФакторам(ОсмотрыПоФакторам, ВыборкаЗапроса)
	
	НоваяСтрока = ОсмотрыПоФакторам.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаЗапроса);
	
	НоваяСтрока.Периодичность = ОписаниеПериодичностиОсмотров();
	ЗаполнитьЗначенияСвойств(НоваяСтрока.Периодичность, ВыборкаЗапроса);
	ЗаполнитьПредставлениеПериодичности(НоваяСтрока.Периодичность);
	
	Если Не ЗначениеЗаполнено(ВыборкаЗапроса.ПоследнийОсмотр) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыборкаЗапроса.Результат = Перечисления.РезультатыМедицинскогоОсмотра.ИмеетПротивопоказания Тогда
		НоваяСтрока.СледующийОсмотр = ВыборкаЗапроса.ПоследнийОсмотр;
		НоваяСтрока.СостояниеПроцент = 0;
		Возврат;
	Иначе
		НоваяСтрока.СледующийОсмотр = ДатаСледующегоОсмотра(ВыборкаЗапроса.ПоследнийОсмотр, НоваяСтрока.Периодичность);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.СледующийОсмотр) Тогда
		НоваяСтрока.СостояниеПроцент = АктуальностьОсмотраВПроцентах(НоваяСтрока.ПоследнийОсмотр, НоваяСтрока.СледующийОсмотр);
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеПериодичностиОсмотров()
	
	Возврат МедицинскиеОсмотрыКлиентСервер.ОписаниеПериодичностиОсмотров();
	
КонецФункции

Процедура ЗаполнитьПредставлениеПериодичности(ОписаниеПериодичности)
	
	ОписаниеПериодичности.Представление = ПредставлениеПериодичности(ОписаниеПериодичности.Кратность,
		ОписаниеПериодичности.Периодичность, ОписаниеПериодичности.ЕдиницаПериодичности, ОписаниеПериодичности.Однократно);
	
КонецПроцедуры

Функция ПредставленияФакторов()
	
	Представления = Новый Структура(
		"ВредныеФакторыПолноеПредставление,
		|ВидыРаботПолноеПредставление,
		|ВредныеФакторыКодыПредставление,
		|ВидыРаботКодыПредставление");
	
	Представления.ВредныеФакторыПолноеПредставление = "";
	Представления.ВидыРаботПолноеПредставление = "";
	Представления.ВредныеФакторыКодыПредставление = "";
	Представления.ВидыРаботКодыПредставление = "";
		
	Возврат Представления;
	
КонецФункции

Процедура ДополнитьПредставленияФакторов(Представления, ВыборкаФакторов, ЭтоПсихиатрическоеОсвидетельствование)
	
	Если Не ЭтоПсихиатрическоеОсвидетельствование
		И Не ЗначениеЗаполнено(ВыборкаФакторов.ВредныйФакторКод) И Не ЗначениеЗаполнено(ВыборкаФакторов.ВидРаботКод) Тогда
		Возврат;
	КонецЕсли;
	
	Разделитель = "," + Символы.НПП;
	СимволПробела = ?(ЭтоПсихиатрическоеОсвидетельствование, "", Символы.НПП);
	ВредныйФакторКод = "";
	Если ЗначениеЗаполнено(ВыборкаФакторов.ВредныйФакторКод) Тогда
		ВредныйФакторКод = ВыборкаФакторов.ВредныйФакторКод + ".";
		Если ЗначениеЗаполнено(Представления["ВредныеФакторыКодыПредставление"]) Тогда
			Представления["ВредныеФакторыКодыПредставление"] = Представления["ВредныеФакторыКодыПредставление"] + Разделитель;
		КонецЕсли;
		Представления["ВредныеФакторыКодыПредставление"] = Представления["ВредныеФакторыКодыПредставление"] + ВредныйФакторКод;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаФакторов.ВредныйФакторНаименование) Тогда
		Если ЗначениеЗаполнено(Представления["ВредныеФакторыПолноеПредставление"]) Тогда
			Представления["ВредныеФакторыПолноеПредставление"] = Представления["ВредныеФакторыПолноеПредставление"] + Разделитель;
		КонецЕсли;
		Представления["ВредныеФакторыПолноеПредставление"] = Представления["ВредныеФакторыПолноеПредставление"] + ВредныйФакторКод + СимволПробела + ВыборкаФакторов.ВредныйФакторНаименование;
	КонецЕсли;
	
	ВидРаботКод = "";
	Если ЗначениеЗаполнено(ВыборкаФакторов.ВидРаботКод) Тогда
		ВидРаботКод = ВыборкаФакторов.ВидРаботКод + ".";
		Если ЗначениеЗаполнено(Представления["ВидыРаботКодыПредставление"]) Тогда
			Представления["ВидыРаботКодыПредставление"] = Представления["ВидыРаботКодыПредставление"] + Разделитель;
		КонецЕсли;
		Представления["ВидыРаботКодыПредставление"] = Представления["ВидыРаботКодыПредставление"] + ВидРаботКод;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаФакторов.ВидРаботНаименование) Тогда
		Если ЗначениеЗаполнено(Представления["ВидыРаботПолноеПредставление"]) Тогда
			Представления["ВидыРаботПолноеПредставление"] = Представления["ВидыРаботПолноеПредставление"] + Разделитель;
		КонецЕсли;
		Представления["ВидыРаботПолноеПредставление"] = Представления["ВидыРаботПолноеПредставление"] + ВидРаботКод + СимволПробела + ВыборкаФакторов.ВидРаботНаименование;
	КонецЕсли;
	
КонецПроцедуры
 
Функция МинимальнаяПериодичность(ОписанияПериодичности)
	
	ОписаниеПериодичности = ОписаниеПериодичностиОсмотров();
	
	МаксимальныйКоэффициент = 0;
	Для Каждого Описание Из ОписанияПериодичности Цикл
		Если Описание.Однократно Тогда
			ОписаниеПериодичности.Однократно = Истина;
			Продолжить;
		КонецЕсли;
		Коэффициент = Описание.Кратность * ЧастейВГоду(Описание.ЕдиницаПериодичности) / Описание.Периодичность;
		Если Коэффициент > МаксимальныйКоэффициент Тогда
			ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Описание);
			МаксимальныйКоэффициент = Коэффициент;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьПредставлениеПериодичности(ОписаниеПериодичности);
	
	Возврат ОписаниеПериодичности;
	
КонецФункции

Процедура ЗарегистрироватьОшибкуОбработкиМедицинскихОсмотров(ИнформацияОбОшибке, ПредставлениеОбработки)
	
	ИмяСобытия = НСтр("ru = 'Медицинские осмотры'", ОбщегоНазначения.КодОсновногоЯзыка());
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, 
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Ошибка при обработке медицинских осмотров. Обратитесь к администратору.
              |Техническая информация:
              |При выполнении операции «%1» возникает
              |%2'"), 
		ПредставлениеОбработки,
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

#Область ВредныеФакторыВидыРабот

Процедура СохранитьПрежниеДанныеВредногоФактораВидаРабот(ФакторОбъект) Экспорт
	
	СохранитьПрежнююПериодичностьВредногоФактораВидаРабот(ФакторОбъект);
	СохранитьПрежнийНаборСоответствующихВредныхФакторов(ФакторОбъект);
	
КонецПроцедуры

Процедура СохранитьПрежнююПериодичностьВредногоФактораВидаРабот(ФакторОбъект) Экспорт
	
	Если ФакторОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если ФакторОбъект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыПериодичности = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ФакторОбъект.Ссылка, СравниваемыеПоляПериодичности());
	
	ПрежняяПериодичность = МедицинскиеОсмотрыКлиентСервер.ОписаниеПериодичностиОсмотров();
	МедицинскиеОсмотрыКлиентСервер.ЗаполнитьОписаниеПериодичностиПоВредномуФакторуВидуРабот(ПрежняяПериодичность, РеквизитыПериодичности);
	
	ФакторОбъект.ДополнительныеСвойства.Вставить("ПрежняяПериодичность", ПрежняяПериодичность);

КонецПроцедуры

Процедура СохранитьПрежнийНаборСоответствующихВредныхФакторов(ФакторОбъект) Экспорт
	
	Если ФакторОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если ФакторОбъект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	СоответствующиеВредныеФакторы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФакторОбъект.Ссылка, "СоответствующиеВредныеФакторы");
	ФакторОбъект.ДополнительныеСвойства.Вставить("ПрежниеСоответствующиеВредныеФакторы", СоответствующиеВредныеФакторы.Выгрузить());

КонецПроцедуры

Процедура ПроверитьИзменениеДанныхВредногоФактора(ВредныйФакторОбъект) Экспорт
	
	ПроверитьИзменениеПериодичностиВредногоФактора(ВредныйФакторОбъект);
	ОбновитьРабочиеМестаПоСопоставленнымВреднымФакторам(ВредныйФакторОбъект);
	
КонецПроцедуры

Процедура ПроверитьИзменениеПериодичностиВредногоФактора(ВредныйФакторОбъект)
	
	Если Не ОбновлятьПериодичностьОсмотровПоВредномуФакторуВидуРабот(ВредныйФакторОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ОбновитьПериодичностьОсмотровРабочихМестПоВредномуФактору(ВредныйФакторОбъект.Ссылка);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПроверитьИзменениеДанныхВидаРабот(ВидРаботОбъект) Экспорт
	ПроверитьИзменениеПериодичностиВидаРабот(ВидРаботОбъект);
	ОбновитьРабочиеМестаПоСопоставленнымВреднымФакторам(ВидРаботОбъект);
КонецПроцедуры

Процедура ПроверитьИзменениеПериодичностиВидаРабот(ВидРаботОбъект)
	
	Если Не ОбновлятьПериодичностьОсмотровПоВредномуФакторуВидуРабот(ВидРаботОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ОбновитьПериодичностьОсмотровРабочихМестПоВидуРабот(ВидРаботОбъект.Ссылка);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ОбновлятьПериодичностьОсмотровПоВредномуФакторуВидуРабот(ФакторОбъект)
	
	Если Не ФакторОбъект.ДополнительныеСвойства.Свойство("ПрежняяПериодичность") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПрежняяПериодичность = ФакторОбъект.ДополнительныеСвойства["ПрежняяПериодичность"];
	
	НоваяПериодичность = МедицинскиеОсмотрыКлиентСервер.ОписаниеПериодичностиОсмотров();
	МедицинскиеОсмотрыКлиентСервер.ЗаполнитьОписаниеПериодичностиПоВредномуФакторуВидуРабот(НоваяПериодичность, ФакторОбъект);

	Если ОбщегоНазначения.КоллекцииИдентичны(НоваяПериодичность, ПрежняяПериодичность) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СравниваемыеПоляПериодичности()
	
	Возврат
		"Однократно,
		|КратностьОсмотра, 
		|ПериодичностьОсмотра, 
		|ЕдиницаПериодичностиОсмотра, 
		|ПредставлениеПериодичностиОсмотра";
	
КонецФункции

Функция ПредставлениеПериодичности(Кратность, Периодичность, ЕдиницаПериодичности, Однократно = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Кратность) Или Не ЗначениеЗаполнено(Периодичность) Тогда
		Если Однократно Тогда
			Возврат НСтр("ru='Однократно'");
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	КратностьПредставление = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 раз;;%1 раза;%1 раз;'"), 
		Кратность);
		
	ШаблонЕдиницыПериодичности = "";
	Если ЕдиницаПериодичности = Перечисления.Периодичность.Год Тогда
		ШаблонЕдиницыПериодичности = НСтр("ru=';%1 год;;%1 года;%1 лет;'");
	ИначеЕсли ЕдиницаПериодичности = Перечисления.Периодичность.Полугодие Тогда
		ШаблонЕдиницыПериодичности = НСтр("ru=';%1 полугодие;;%1 полугодия;%1 полугодий;'");
	ИначеЕсли ЕдиницаПериодичности = Перечисления.Периодичность.Квартал Тогда
		ШаблонЕдиницыПериодичности = НСтр("ru=';%1 квартал;;%1 квартала;%1 кварталов;'");
	ИначеЕсли ЕдиницаПериодичности = Перечисления.Периодичность.Месяц Тогда
		ШаблонЕдиницыПериодичности = НСтр("ru=';%1 месяц;;%1 месяца;%1 месяцев;'");
	КонецЕсли;
	
	Если Периодичность = 1 Тогда
		ШаблонЕдиницыПериодичности = СтрЗаменить(ШаблонЕдиницыПериодичности, "%1", "");
	КонецЕсли;
	
	ПериодичностьПредставление = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		ШаблонЕдиницыПериодичности, 
		Периодичность);
	
	Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 в %2'"), 
		КратностьПредставление, 
		ПериодичностьПредставление);
		
	Возврат Представление;
		
КонецФункции

Процедура ЗаполнитьОрганизацию(НаборЗаписей, Замещение) Экспорт
	
	Если НаборЗаписей.Количество() = 0 Или РегистрыБЗК.ЭтоУдалениеНабораЗаписей(Замещение) Тогда
		Возврат;
	КонецЕсли;
	
	РабочиеМеста = НаборЗаписей.ВыгрузитьКолонку("РабочееМесто");
	ОрганизацииРабочихМест = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(РабочиеМеста, "Владелец");
	
	Для Каждого СтрокаНабора Из НаборЗаписей Цикл
		СтрокаНабора.Организация = ОрганизацииРабочихМест[СтрокаНабора.РабочееМесто];
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ОбновитьОтстранениеОтРаботыПоРезультатамМедицинскогоОсмотра(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаключениеПустаяСсылка", Документы.ЗаключениеМедицинскогоОсмотра.ПустаяСсылка());
	
	Обработанные = ЗначениеПараметраОбновленияОбработанные(ПараметрыОбновления);
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтстранениеОтРаботы.ДокументОтстранения КАК ДокументОтстранения,
		|	ОтстранениеОтРаботы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОтстранениеОтРаботы.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.ОтстранениеОтРаботыПоРезультатамМедицинскогоОсмотра КАК ОтстранениеОтРаботы
		|ГДЕ
		|	НЕ ОтстранениеОтРаботы.ДокументОтстранения В (&Обработанные)
		|	И ОтстранениеОтРаботы.ЗаключениеМедицинскогоОсмотра = &ЗаключениеПустаяСсылка";
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);
	
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
		
	Выборка = ОбновляемыеДанные.Выбрать();
	Пока Выборка.Следующий() Цикл
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ОтстранениеОтРаботыПоРезультатамМедицинскогоОсмотра");
		ЭлементБлокировкиДанных.УстановитьЗначение("ДокументОтстранения", Выборка.ДокументОтстранения);
		ЭлементБлокировкиДанных.УстановитьЗначение("ФизическоеЛицо", Выборка.ФизическоеЛицо);
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация", Выборка.Организация);
		
		НаборЗаписей = РегистрыСведений.ОтстранениеОтРаботыПоРезультатамМедицинскогоОсмотра.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументОтстранения.Установить(Выборка.ДокументОтстранения);
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(Выборка.ФизическоеЛицо);
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);
		
		ДокументОтстраненияОбработан = Ложь;
		
		НачатьТранзакцию();
		Попытка
			БлокировкаДанных.Заблокировать();
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ДокументОтстраненияОбработан = Истина;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ПредставлениеОбработки = НСтр("ru = 'Обновление отстранения от работы по результатам медицинского осмотра'"); 
			ЗарегистрироватьОшибкуОбработкиМедицинскихОсмотров(ИнформацияОбОшибке(), ПредставлениеОбработки);
		КонецПопытки;
		
		Если ДокументОтстраненияОбработан Тогда
			Обработанные.Добавить(Выборка.ДокументОтстранения);
		КонецЕсли;
	КонецЦикла;
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	
КонецПроцедуры

Процедура ОбновитьПериодическиеОсмотрыУволенныхСотрудников(ПараметрыОбновления) Экспорт
	
	// Составляем перечень позиций для медосмотров.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеМеста.РабочееМесто КАК РабочееМесто
		|ИЗ
		|	РегистрСведений.ПериодичностьМедицинскихОсмотровРабочихМест КАК РабочиеМеста";
	
	РабочиеМеста = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РабочееМесто");
	
	Если РабочиеМеста.Количество() = 0 Тогда
		ПараметрыОбновления.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыОбновления.ОбработкаЗавершена = Ложь;
	
	// Получаем уволенных сотрудников.
	ПараметрыЗапроса = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыЗапроса.КадровыеДанные = "ФизическоеЛицо, ГоловнаяОрганизация, ДатаУвольнения";
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы, "РабочееМестоОхраныТруда", "В", РабочиеМеста);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы, "ДатаУвольнения", "<>", Дата(1, 1, 1));
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	УстановитьПривилегированныйРежим(Истина);
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(МенеджерВТ, Ложь, ПараметрыЗапроса);
	УстановитьПривилегированныйРежим(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.ДатаУвольнения КАК Период,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДействуетДо
		|ИЗ
		|	ВТСотрудникиОрганизации КАК Сотрудники";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекущаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
	ТаблицаБудущихСобытий = НоваяТаблицаБудущиеСобытияМедицинскиеОсмотры();
	ТаблицаОбновления = НоваяТаблицаОбновлениеПериодическихОсмотров();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьТаблицуБудущихСобытийМедосмотров(Выборка, ТаблицаБудущихСобытий, ТекущаяДата);
		ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), Выборка);
	КонецЦикла;
	ТаблицаОбновления.Свернуть("ГоловнаяОрганизация,ФизическоеЛицо");
	
	Если ТаблицаОбновления.Количество() = 0 И ТаблицаБудущихСобытий.Количество() = 0 Тогда
		ПараметрыОбновления.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьОбновлениеПериодическихОсмотров(ТаблицаОбновления);
	ЗарегистрироватьБудущиеСобытияМедицинскиеОсмотры(ТаблицаБудущихСобытий);
	ПараметрыОбновления.ОбработкаЗавершена = Истина;
	
	ФизическиеЛица = ТаблицаОбновления.ВыгрузитьКолонку("ФизическоеЛицо");
	ЗапуститьОбновлениеПериодическихОсмотров(, ФизическиеЛица);
	
КонецПроцедуры

Процедура ЗаполнитьРабочиеМестаВОбъектахПодсистемыМедосмотры(ПараметрыОбновления = Неопределено) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = ПредварительныйТекстЗапросаРабочиеМестаТребующиеОбработки();
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления, "ВТСвязиРабочихМестСПозициями", Неопределено);
	
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Запрос.Текст = ОсновнойТекстЗапросаРабочиеМестаТребующиеОбработки();
	
	РезультатыЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	ВыборкаВредныеФакторыИВидыРабот = РезультатыЗапроса[РезультатыЗапроса.Количество() - 26].Выбрать();
	ВыборкаВредныеФакторы = РезультатыЗапроса[РезультатыЗапроса.Количество() - 25].Выбрать();
	ВыборкаВидыРабот = РезультатыЗапроса[РезультатыЗапроса.Количество() - 24].Выбрать();
	ВыборкаПериодичностьМедосмотров = РезультатыЗапроса[РезультатыЗапроса.Количество() - 23].Выбрать();
	ВыборкаВыданныеНаправления = РезультатыЗапроса[РезультатыЗапроса.Количество() - 22].Выбрать();
	ВыборкаМедицинскиеОсмотры = РезультатыЗапроса[РезультатыЗапроса.Количество() - 21].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаМедицинскиеДокументы = РезультатыЗапроса[РезультатыЗапроса.Количество() - 20].Выбрать();
	
	// Регистры
	НаборЗаписейВредныеФакторыИВидыРабот = 
		НаборЗаписейРегистраСведенийИзВыборки(ВыборкаВредныеФакторыИВидыРабот, "ВредныеФакторыИВидыРаботРабочегоМеста");
	НаборЗаписейВредныеФакторы = 
		НаборЗаписейРегистраСведенийИзВыборки(ВыборкаВредныеФакторы, "ВредныеФакторыРабочегоМеста");
	НаборЗаписейВидыРабот = 
		НаборЗаписейРегистраСведенийИзВыборки(ВыборкаВидыРабот, "ВидыРаботМедицинскихОсмотровРабочегоМеста");
	НаборЗаписейПериодичностьМедосмотров = 
		НаборЗаписейРегистраСведенийИзВыборки(ВыборкаПериодичностьМедосмотров, "ПериодичностьМедицинскихОсмотровРабочихМест");
	НаборЗаписейВыданныеНаправления = 
		НаборЗаписейРегистраСведенийИзВыборки(ВыборкаВыданныеНаправления, "ВыданныеНаправленияНаМедицинскийОсмотр");
	
	НачатьТранзакцию();
	Попытка
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейВредныеФакторыИВидыРабот, Ложь);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейВредныеФакторы, Ложь);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейВидыРабот, Ложь);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейПериодичностьМедосмотров, Ложь);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейВыданныеНаправления, Ложь);
		
		ОбработатьДокументыМедицинскихОсмотров(ВыборкаМедицинскиеДокументы);
		ОхранаТруда.ОбработатьРегистрСведенийПодчиненныйРегистратору(ВыборкаМедицинскиеОсмотры, "МедицинскиеОсмотры");
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Обновление информационной базы.Ошибка заполнения рабочих мест в объектах подсистемы «Медосмотры»'", 
				ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ПредварительныйТекстЗапросаРабочиеМестаТребующиеОбработки()
	
	// АПК:96 -выкл результат должен содержать уникальные значения
		
	Возврат
		"ВЫБРАТЬ
		|	ПериодичностьРабочихМест.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТПериодичностьМедицинскихОсмотровРабочихМестОбработанные
		|ИЗ
		|	РегистрСведений.ПериодичностьМедицинскихОсмотровРабочихМест КАК ПериодичностьРабочихМест
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МедицинскиеОсмотры.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТМедицинскиеОсмотрыОбработанные
		|ИЗ
		|	РегистрСведений.МедицинскиеОсмотры КАК МедицинскиеОсмотры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВыданныеНаправленияНаМедицинскийОсмотр.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТВыданныеНаправленияНаМедицинскийОсмотрОбработанные
		|ИЗ
		|	РегистрСведений.ВыданныеНаправленияНаМедицинскийОсмотр КАК ВыданныеНаправленияНаМедицинскийОсмотр
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВредныеФакторыИВидыРаботРабочегоМеста.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТВредныеФакторыИВидыРаботРабочегоМестаОбработанные
		|ИЗ
		|	РегистрСведений.ВредныеФакторыИВидыРаботРабочегоМеста КАК ВредныеФакторыИВидыРаботРабочегоМеста
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВредныеФакторыРабочегоМеста.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТВредныеФакторыРабочегоМестаОбработанные
		|ИЗ
		|	РегистрСведений.ВредныеФакторыРабочегоМеста КАК ВредныеФакторыРабочегоМеста
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыРаботРабочегоМеста.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТВидыРаботРабочегоМестаОбработанные
		|ИЗ
		|	РегистрСведений.ВидыРаботМедицинскихОсмотровРабочегоМеста КАК ВидыРаботРабочегоМеста
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НаправлениеНаМедицинскийОсмотр.РабочееМесто КАК РабочееМесто
