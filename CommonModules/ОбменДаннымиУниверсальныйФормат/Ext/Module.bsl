КонецПроцедуры

Процедура ОбновитьНастройкиВыгрузкиВедомостейПроводок() Экспорт

	Запрос = Новый Запрос;
	ВариантыНастроек = Новый Массив;
	ВариантыНастроек.Добавить(ВариантНастройкиОбменаERP());
	Запрос.УстановитьПараметр("ВариантыНастроек", ВариантыНастроек);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СинхронизацияДанныхЧерезУниверсальныйФормат.Ссылка КАК Ссылка,
	|	СинхронизацияДанныхЧерезУниверсальныйФормат.ВариантНастройки КАК ВариантНастройки,
	|	СинхронизацияДанныхЧерезУниверсальныйФормат.ДанныеДляФормированияПроводокОтправлятьСводно КАК ДанныеДляФормированияПроводокОтправлятьСводно
	|ИЗ
	|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК СинхронизацияДанныхЧерезУниверсальныйФормат
	|ГДЕ
	|	НЕ СинхронизацияДанныхЧерезУниверсальныйФормат.ЭтотУзел
	|	И НЕ СинхронизацияДанныхЧерезУниверсальныйФормат.ПометкаУдаления
	|	И СинхронизацияДанныхЧерезУниверсальныйФормат.ВариантНастройки В(&ВариантыНастроек)
	|	И НЕ СинхронизацияДанныхЧерезУниверсальныйФормат.ДанныеДляФормированияПроводокОтправлятьСводно";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		УзелОбъект = Выборка.Ссылка.ПолучитьОбъект();
		УзелОбъект.ДанныеДляФормированияПроводокОтправлятьСводно = Истина;
		УзелОбъект.ОтправлятьВедомости = Истина;
		УзелОбъект.ОтправлятьВедомостиКакЗаявки = Истина;
		УзелОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьНастройкуИспользуетсяОбмен() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СинхронизацияДанныхЧерезУниверсальныйФормат.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК СинхронизацияДанныхЧерезУниверсальныйФормат
	|ГДЕ
	|	НЕ СинхронизацияДанныхЧерезУниверсальныйФормат.ПометкаУдаления
	|	И НЕ СинхронизацияДанныхЧерезУниверсальныйФормат.ЭтотУзел";
	ОбменНастроен = Не Запрос.Выполнить().Пустой();
	
	Если Константы.ИспользуетсяОбменДаннымиУниверсальныйФормат.Получить() <> ОбменНастроен Тогда
		МенеджерКонстанты = Константы.ИспользуетсяОбменДаннымиУниверсальныйФормат.СоздатьМенеджерЗначения();
		МенеджерКонстанты.Значение = ОбменНастроен;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(МенеджерКонстанты);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиУсловийОбмена() Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВариантНастройки", ВариантНастройкиОбменаБП());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК Таблица
	|ГДЕ
	|	Таблица.ВариантНастройки = &ВариантНастройки
	|	И НЕ Таблица.ПометкаУдаления
	|	И НЕ Таблица.ЭтотУзел
	|	И (Таблица.ОтправлятьВсехФизическихЛиц
	|			ИЛИ НЕ Таблица.ОтправлятьБухучет
	|			ИЛИ НЕ Таблица.ОтправлятьСтатистикуПерсонала
	|			ИЛИ НЕ Таблица.ОтправлятьУдержанныйНДФЛ
	|			ИЛИ НЕ Таблица.ОтправлятьРезервы
	|			ИЛИ Таблица.ОтправлятьВидыРабот
	|			ИЛИ Таблица.ОтправлятьВсеДолжности
	|			ИЛИ НЕ Таблица.ОтправлятьРегистрацииНО
	|			ИЛИ Таблица.ОтправлятьСтруктуруПредприятия)";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
