#Область ПравилаРегистрацииОбъектов

Процедура КадровыеДанныеПослеОбработкиПравила(Отказ, Объект, ОбъектМетаданных, Выгрузка, Получатели) Экспорт
	
	Если Получатели.Количество() > 0 Тогда
		
		Регистратор = Объект.Отбор.Регистратор.Значение;
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Регистратор, "Организация");
		Организации = ОрганизацииОтбора(Организация);
		
		Получатели = ПолучателиОрганизаций(Получатели, Организации);
		
	КонецЕсли;

КонецПроцедуры

Процедура СотрудникиПослеОбработкиПравила(Отказ, Объект, ОбъектМетаданных, Выгрузка, Получатели) Экспорт

	Если Получатели.Количество() > 0 Тогда
		
		Организация = Объект.ГоловнаяОрганизация;
		Организации = ОрганизацииОтбора(Организация);
		
		Получатели = ПолучателиОрганизаций(Получатели, Организации);
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучателиОрганизаций(Получатели, Организации)
	
	Если Не ЗначениеЗаполнено(Организации) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Получатели", Получатели);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК ПланОбменаОсновнаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Организации КАК ПланОбменаОрганизации
	|		ПО ПланОбменаОсновнаяТаблица.Ссылка = ПланОбменаОрганизации.Ссылка
	|ГДЕ
	|	(ПланОбменаОсновнаяТаблица.ИспользоватьОтборПоОрганизациям = ЛОЖЬ
	|			ИЛИ ПланОбменаОрганизации.Организация В (&Организации))
	|	И ПланОбменаОсновнаяТаблица.Ссылка В(&Получатели)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция ОрганизацииОтбора(Организация)
	
	Организации = Новый Массив;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Организации;
	КонецЕсли;
	
	ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Организация);
	Организации = ОбменДаннымиУниверсальныйФорматПовтИсп.ФилиалыГоловнойОрганизации(ГоловнаяОрганизация);
	Если Организации.Найти(Организация) = Неопределено Тогда
		Организации.Добавить(Организация);
	КонецЕсли;
	
	Возврат Организации;
	
КонецФункции

