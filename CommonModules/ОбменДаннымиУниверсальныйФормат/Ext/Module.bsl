			УзелОбъект.ОтправлятьРезервы 			= Истина;
			УзелОбъект.ОтправлятьВидыРабот 			= Ложь;
			УзелОбъект.ОтправлятьВсеДолжности 		= Ложь;
			УзелОбъект.ОтправлятьРегистрацииНО 		= Истина;
			УзелОбъект.ОтправлятьСтруктуруПредприятия = Ложь;
			УзелОбъект.Записать();
		КонецЦикла;
	КонецЕсли;
	
	ВариантыНастройки = Новый Массив;
	ВариантыНастройки.Добавить(ВариантНастройкиОбменаERP());
	ВариантыНастройки.Добавить(ВариантНастройкиОбменУниверсальный());
	Запрос.УстановитьПараметр("ВариантыНастройки", ВариантыНастройки);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК Таблица
	|ГДЕ
	|	Таблица.ВариантНастройки В(&ВариантыНастройки)
	|	И НЕ Таблица.ПометкаУдаления
	|	И НЕ Таблица.ЭтотУзел
	|	И (НЕ Таблица.ОтправлятьВсехФизическихЛиц
	|			ИЛИ НЕ Таблица.ОтправлятьБухучет
	|			ИЛИ НЕ Таблица.ОтправлятьСтатистикуПерсонала
	|			ИЛИ НЕ Таблица.ОтправлятьУдержанныйНДФЛ
	|			ИЛИ НЕ Таблица.ОтправлятьРезервы
	|			ИЛИ НЕ Таблица.ОтправлятьВидыРабот
	|			ИЛИ Таблица.ОтправлятьВсеДолжности
	|			ИЛИ НЕ Таблица.ОтправлятьРегистрацииНО
	|			ИЛИ НЕ Таблица.ОтправлятьСтруктуруПредприятия)";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			УзелОбъект = Выборка.Ссылка.ПолучитьОбъект();
			УзелОбъект.ОтправлятьВсехФизическихЛиц 	= Истина;
			УзелОбъект.ОтправлятьБухучет 			= Истина;
			УзелОбъект.ОтправлятьСтатистикуПерсонала = Истина;
			УзелОбъект.ОтправлятьУдержанныйНДФЛ 	= Истина;
			УзелОбъект.ОтправлятьРезервы 			= Истина;
			УзелОбъект.ОтправлятьВидыРабот 			= Истина;
			УзелОбъект.ОтправлятьВсеДолжности 		= Ложь;
			УзелОбъект.ОтправлятьРегистрацииНО 		= Истина;
			УзелОбъект.ОтправлятьСтруктуруПредприятия = Истина;
			УзелОбъект.Записать();
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

