#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

#Область ТекущиеДела

// См. ТекущиеДелаПереопределяемый.ПриОпределенииОбработчиковТекущихДел.
Процедура ПриОпределенииОбработчиковТекущихДел(Обработчики) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетУдостоверений") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.Удостоверения) Тогда
		Возврат;
	КонецЕсли;
	
	Обработчики.Добавить(Удостоверения);
	
КонецПроцедуры

// См. ТекущиеДелаПереопределяемый.ПриОпределенииОбработчиковТекущихДел.
Процедура ПриЗаполненииСпискаТекущихДел(ТекущиеДела) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетУдостоверений") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.Удостоверения) Тогда
		Возврат;
	КонецЕсли;
	
	Раздел							= "Удостоверения";
	ПредставлениеЗаголовка			= НСтр("ru = 'Контроль удостоверений'");
	Представление					= НСтр("ru = 'Контроль удостоверений'");
	Подсказка						= НСтр("ru = 'Проконтролировать состояние удостоверений.'");
	
	ДелоЗаголовок					= ТекущиеДела.Добавить();
	ДелоЗаголовок.Идентификатор		= Раздел;
	ДелоЗаголовок.Важное			= Ложь;
	ДелоЗаголовок.Владелец			= Метаданные.Подсистемы.Найти("Кадры");
	ДелоЗаголовок.Представление		= ПредставлениеЗаголовка;
	ДелоЗаголовок.Подсказка			= ПредставлениеЗаголовка;
	ДелоЗаголовок.ЕстьДела			= Ложь;
	ДелоЗаголовок.Форма				= "Отчет.КонтрольУдостоверений.Форма";
	
	ПериодОтчета = ТекущаяДатаСеанса();

	ПараметрыФормы					= Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("КлючВарианта", "КонтрольУдостоверений");
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Период, ТребуетсяКонтроль", ПериодОтчета, Истина));
	
	ДелоЗаголовок.ПараметрыФормы = ПараметрыФормы;
	
	МодульТекущиеДелаСервер = ОбщегоНазначения.ОбщийМодуль("ТекущиеДелаСервер");
	Если МодульТекущиеДелаСервер.ДелоОтключено(Раздел) Тогда
		Возврат;
	КонецЕсли;
	
	ТребуетсяКонтрольУдостоверений = ТребуетсяКонтрольУдостоверений(ПериодОтчета);
	
	Если ТребуетсяКонтрольУдостоверений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Организации = ОбщегоНазначенияКлиентСервер.СвернутьМассив(
		ТребуетсяКонтрольУдостоверений.ВыгрузитьКолонку("Организация"));
	
	ДанныеОрганизаций = Новый Соответствие;
	
	Для Каждого Организация Из Организации Цикл
		Сотрудники = Новый Массив;
		СтрокиТЗ = ТребуетсяКонтрольУдостоверений.НайтиСтроки(Новый Структура("Организация", Организация));
		Для Каждого СтрокаТЗ Из СтрокиТЗ Цикл
			Сотрудники.Добавить(СтрокаТЗ.Сотрудник);
		КонецЦикла;
		ДанныеОрганизаций.Вставить(Организация, Сотрудники);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ДанныеОрганизаций Цикл
		
		Организация = КлючИЗначение.Ключ;
		
		Дело				= ТекущиеДела.Добавить();
		Дело.Идентификатор	= "Удостоверения" + СтрЗаменить(Организация.УникальныйИдентификатор(), "-", "");
		Дело.ЕстьДела		= Истина;
		Дело.Важное			= Ложь;
		Дело.Владелец		= Раздел;
		Дело.Представление	= Представление + ", " + Строка(Организация);
		Дело.Количество		= Сотрудники.Количество();
		Дело.Подсказка		= Подсказка;
		Дело.Форма			= "Отчет.КонтрольУдостоверений.Форма";
		
		ПараметрыФормыПоОрганизации = Новый Структура;
		ПараметрыФормыПоОрганизации.Вставить("СформироватьПриОткрытии", Истина);
		ПараметрыФормыПоОрганизации.Вставить("КлючВарианта", "КонтрольУдостоверений");
		ПараметрыФормыПоОрганизации.Вставить("Отбор", Новый Структура("Период, Организация, ТребуетсяКонтроль", ПериодОтчета, Организация, Истина));
		
		Дело.ПараметрыФормы = ПараметрыФормыПоОрганизации;
		
		ДелоЗаголовок.ЕстьДела = Истина;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьИсточникиДанныхДляПроверкиЗапретаИзменения(ИсточникиДанных) Экспорт
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.АктУничтоженияУдостоверений", "Дата", "КадровыйУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ВозвратУтеряУдостоверений", "Дата", "КадровыйУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ВыдачаУдостоверений", "Дата","КадровыйУчет", "Организация");
	
КонецПроцедуры

Процедура НастроитьВариантыОтчетов(Настройки) Экспорт
	
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.КонтрольУдостоверений);
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.КнигаВыдачиУдостоверений);
	
КонецПроцедуры

#Область ОпределениеДоступностиДанных

Функция ДоступноИзменениеИспользованияУчетаУдостоверений() Экспорт
	
	Возврат ПравоДоступа("Изменение", Метаданные.Константы.ИспользоватьУчетУдостоверений);
	
КонецФункции

#КонецОбласти

#Область ПанельНастроекЗарплатаКадры

Процедура ПанельЗарплатаКадрыПрочитатьНастройки(Форма) Экспорт
	
	ИспользоватьУчетУдостоверений = Константы.ИспользоватьУчетУдостоверений.Получить();
	Форма.ИспользоватьУчетУдостоверений = ИспользоватьУчетУдостоверений;
	
КонецПроцедуры

Процедура ПанельУправлениеПерсоналомЗаполнитьНастройки(Форма, ПараметрыНастроек) Экспорт
	
	ПараметрыНастроек.ИспользоватьУчетУдостоверений = Форма.ИспользоватьУчетУдостоверений;
	
КонецПроцедуры

Процедура ПанельУправлениеПерсоналомЗаписатьНастройки(Параметры, ПараметрыНастроек) Экспорт
	
	Если ПараметрыНастроек.ИспользоватьУчетУдостоверений Тогда
		Константы.ИспользоватьУчетУдостоверений.Установить(Параметры.ИспользоватьУчетУдостоверений);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбслуживаниеНастроекПрограммы

Процедура ДобавитьПоказателиУдостоверений(ТаблицаПоказателей) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, "Константы", "ИспользоватьУчетУдостоверений", 
		НСтр("ru='Использовать учет удостоверений.'"), "Кадровый учет", "", "Ложь", 3, 1, 7);
	
КонецПроцедуры

#КонецОбласти

