Функция СписокКадровыхДанных() Экспорт
	
	СписокКадровыхДанных = "Сотрудник,ФИО,ФизическоеЛицо,Должность";
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба.КлассныеЧиныРанги") Тогда
		МодульКлассныеЧиныРанги = ОбщегоНазначения.ОбщийМодуль("КлассныеЧиныРанги");
		МодульКлассныеЧиныРанги.КадровыеДанныеКлассныйЧинРанг(СписокКадровыхДанных);
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба.ВоинскиеСпециальныеЗвания") Тогда
		МодульВоинскиеСпециальныеЗвания = ОбщегоНазначения.ОбщийМодуль("ВоинскиеСпециальныеЗвания");
		МодульВоинскиеСпециальныеЗвания.КадровыеДанныеВоинскоеСпециальноеЗвание(СписокКадровыхДанных);
	КонецЕсли;
	
	Возврат СписокКадровыхДанных;
	
КонецФункции

Функция КадровыеДанныеДляЗаполнения(СписокСотрудников, СписокКадровыхДанных, ДатаПолученияДанных) Экспорт
	
	КадровыеДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(
		Истина,
		СписокСотрудников,
		СписокКадровыхДанных,
		ДатаПолученияДанных);
		
	Возврат КадровыеДанныеСотрудников;
	
КонецФункции

#КонецОбласти

#Область ПечатьЛичнойКарточкиТ2

Процедура ДополнитьСведенияУнифицированнойФормыТ2(ЧетвертаяСтраницаТ2ПродолжениеПараметры, ДатаАктуальности, Сотрудник) Экспорт
	
	ДополнительныеСведения = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаАктуальности", КонецДня(ДатаАктуальности));
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(Удостоверения.ВидУдостоверения КАК Справочник.ВидыУдостоверений).Наименование КАК ВидУдостоверения,
		|	Удостоверения.СерияУдостоверения КАК СерияУдостоверения,
		|	Удостоверения.НомерУдостоверения КАК НомерУдостоверения,
		|	Удостоверения.ДатаВыдачи КАК ДатаВыдачи
		|ИЗ
		|	РегистрСведений.Удостоверения.СрезПоследних(
		|			&ДатаАктуальности,
		|			Сотрудник = &Сотрудник
		|				И ВЫРАЗИТЬ(ВидУдостоверения КАК Справочник.ВидыУдостоверений).ОтражатьВТ2) КАК Удостоверения
		|ГДЕ
		|	Удостоверения.СтатусУдостоверения = ЗНАЧЕНИЕ(Перечисление.СтатусыУдостоверений.Выдано)";
	
	Результат = Запрос.Выполнить();
	НомерСтроки = 1;
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ДополнительныеСведения = ДополнительныеСведения
				+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 серия %2 номер %3 от %4%5'"),
					Выборка.ВидУдостоверения,
					Выборка.СерияУдостоверения,
					Выборка.НомерУдостоверения,
					Формат(Выборка.ДатаВыдачи, "ДЛФ=D"),
					?(НомерСтроки = Выборка.Количество(), "", "; "));
					НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЕсли;
	
	ЧетвертаяСтраницаТ2ПродолжениеПараметры.Вставить("ДополнительныеСведения", ДополнительныеСведения);
	
КонецПроцедуры

#КонецОбласти

Функция ТребуетсяКонтрольУдостоверений(ПериодОтчета)
	
	Макет = Отчеты.КонтрольУдостоверений.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Макет));
	КомпоновщикНастроек.ЗагрузитьНастройки(Макет.ВариантыНастроек["КонтрольУдостоверений"].Настройки);
	
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	НастройкиОтчета.Структура.Очистить();
	НастройкиОтчета.Выбор.Элементы.Очистить();
	
	ПараметрПериод = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если ПараметрПериод <> Неопределено Тогда
		ПараметрПериод.Значение = ПериодОтчета;
		ПараметрПериод.Использование = Истина;
	КонецЕсли;
	
	ОтборКомпоновкиДанных = НастройкиОтчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборКомпоновкиДанных.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборКомпоновкиДанных.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуетсяКонтроль");
	ОтборКомпоновкиДанных.ПравоеЗначение = Истина;
	ОтборКомпоновкиДанных.Использование = Истина;
	
	Группировка = НастройкиОтчета.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.ПоляГруппировки.Элементы.Очистить();
	Группировка.Выбор.Элементы.Очистить();
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	ОтчетыСервер.ДобавитьВыбранноеПоле(НастройкиОтчета.Выбор, "Организация");
	ОтчетыСервер.ДобавитьВыбранноеПоле(НастройкиОтчета.Выбор, "Сотрудник");
	
	ЗарплатаКадрыОбщиеНаборыДанных.ЗаполнитьОбщиеИсточникиДанныхОтчета(Новый Структура("СхемаКомпоновкиДанных", Макет));
	
	МакетКомпоновкиДанных = ЗарплатаКадрыОтчеты.МакетКомпоновкиДанныхДляКоллекцииЗначений(Макет, НастройкиОтчета);
	
	ВнешниеНаборыДанных = Отчеты.КонтрольУдостоверений.ВнешниеНаборыДанных(КомпоновщикНастроек);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, ВнешниеНаборыДанных,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаЗначений);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ТребуетсяКонтрольУдостоверений = Новый ТаблицаЗначений;
	ТребуетсяКонтрольУдостоверений.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТребуетсяКонтрольУдостоверений.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗначений Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТребуетсяКонтрольУдостоверений.Добавить(), СтрокаТаблицы);
	КонецЦикла;
	
	Возврат ТребуетсяКонтрольУдостоверений;
	
КонецФункции

Процедура УдалитьПоляОтчета(СхемаКомпоновкиДанных, ТекущийКлючВарианта) Экспорт
	
	ПоляУдаления = Новый Массив;
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба.КлассныеЧиныРанги") Тогда
		ПоляУдаления.Добавить("СменаУдостоверенияПриСменеКлассногоЧинаРанга");
		ПоляУдаления.Добавить("КлассныйЧинРанг");
		ПоляУдаления.Добавить("ТекущийКлассныйЧинРанг");
		ПоляУдаления.Добавить("СменаКлассногоЧинаРанга");
	КонецЕсли;
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ГосударственнаяСлужба.ВоинскиеСпециальныеЗвания") Тогда
		ПоляУдаления.Добавить("СменаУдостоверенияПриСменеВоинскогоСпециальногоЗвания");
		ПоляУдаления.Добавить("ВоинскоеСпециальноеЗвание");
		ПоляУдаления.Добавить("ТекущееВоинскоеСпециальноеЗвание");
		ПоляУдаления.Добавить("СменаВоинскогоСпециальногоЗвания"); 
	КонецЕсли;
	
	// Удаление полей из схемы компоновки данных.
	Для каждого Поле Из ПоляУдаления Цикл
		
		ПолеНабораДанныхСхемыКомпоновкиДанных = СхемаКомпоновкиДанных.НаборыДанных[ТекущийКлючВарианта].Поля.Найти(Поле);
		Если ПолеНабораДанныхСхемыКомпоновкиДанных <> Неопределено Тогда
			СхемаКомпоновкиДанных.НаборыДанных[ТекущийКлючВарианта].Поля.Удалить(ПолеНабораДанныхСхемыКомпоновкиДанных);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОтборЗапроса(СхемаЗапроса, ВТДляОтбора, ЗначениеОтбора) Экспорт
	
	Для НомерЗапроса = 1 По СхемаЗапроса.ПакетЗапросов.Количество() Цикл
		ЗапросПакета = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - НомерЗапроса];
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
			Если ЗначениеЗаполнено(ВТДляОтбора) И ЗначениеЗаполнено(ЗапросПакета.ТаблицаДляПомещения) Тогда
				Если ВТДляОтбора.Свойство(ЗапросПакета.ТаблицаДляПомещения) Тогда
					ЗначениеОтбораКопия = СтрЗаменить(ЗначениеОтбора, "#ИмяТаблицы", ВТДляОтбора[ЗапросПакета.ТаблицаДляПомещения]);
					ЗапросПакета.Операторы[0].Отбор.Добавить(ЗначениеОтбораКопия);
				КонецЕсли;
			ИначеЕсли Не ЗначениеЗаполнено(ВТДляОтбора) И Не ЗначениеЗаполнено(ЗапросПакета.ТаблицаДляПомещения) Тогда
				ЗапросПакета.Операторы[0].Отбор.Добавить(ЗначениеОтбора);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти