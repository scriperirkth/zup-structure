#Область ЗаполнениеКомиссии

Функция ДолжностьЧленаКомиссии(ЧленКомиссии, Организация, Дата) Экспорт
	
	ТаблицаСотрудников = КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(ЧленКомиссии, Истина, Организация, Дата);
	Сотрудники = ТаблицаСотрудников.ВыгрузитьКолонку("Сотрудник");
	КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудников(Истина, Сотрудники, "ТекущаяДолжность", Дата);
	
	Если КадровыеДанные.Количество() > 0 Тогда
		ТекущаяДолжность = КадровыеДанные[0].ТекущаяДолжность;
		Если ЗначениеЗаполнено(ТекущаяДолжность) Тогда
			Возврат ТекущаяДолжность;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОбработкаПроверкиЗаполненияКомиссии(ДокументОбъект, ПроверяемыеРеквизиты) Экспорт
	
	ОбработатьДублиСтрокВТабличнойЧасти(ДокументОбъект, "Комиссия", "ЧленКомиссии", Истина);
	
	КоличествоЧленовКомиссии = ДокументОбъект.Комиссия.Количество();
	
	Если КоличествоЧленовКомиссии = 0 Тогда
		ТекстОшибки = НСтр("ru = 'Не заполнен состав комиссии.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
	ИначеЕсли КоличествоЧленовКомиссии = 1 Тогда
		ТекстОшибки = НСтр("ru = 'Комиссия не может состоять из одного человека.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
	КонецЕсли;
	
	КоличествоПредседателей = 0;
	КоличествоЗаместителейПредседателя = 0;
	КоличествоСекретарей = 0;
	Для каждого СтрокаКомиссии Из ДокументОбъект.Комиссия Цикл
		Если СтрокаКомиссии.РольВКомиссии = Перечисления.РолиЧленовКомиссииПоУничтожениюУдостоверений.Председатель Тогда
			КоличествоПредседателей = КоличествоПредседателей + 1;
		ИначеЕсли СтрокаКомиссии.РольВКомиссии = Перечисления.РолиЧленовКомиссииПоУничтожениюУдостоверений.ЗаместительПредседателя Тогда
			КоличествоЗаместителейПредседателя = КоличествоЗаместителейПредседателя + 1;
		ИначеЕсли СтрокаКомиссии.РольВКомиссии = Перечисления.РолиЧленовКомиссииПоУничтожениюУдостоверений.Секретарь Тогда
			КоличествоСекретарей = КоличествоСекретарей + 1;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоПредседателей > 1 Тогда
		ТекстОшибки = НСтр("ru = 'Председатель в комиссии должен быть один.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
	ИначеЕсли КоличествоПредседателей = 0 И КоличествоЗаместителейПредседателя = 0 Тогда
		ТекстОшибки = НСтр("ru = 'Не указан председатель комиссии.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
	ИначеЕсли КоличествоСекретарей = 0 Тогда
		ТекстОшибки = НСтр("ru = 'Не указан секретарь комиссии.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДублиСтрокВТабличнойЧасти(Объект, ИмяТаблицы, ИмяПоля, СообщатьОДублях = Ложь, Отказ = Ложь) Экспорт
	
	ТаблицаПолей = Объект[ИмяТаблицы];
	Уникальные = Новый Соответствие;
	СообщениеОтправлено = Новый Соответствие;
	
	Индекс = 0;
	Пока Индекс < ТаблицаПолей.Количество() Цикл
		СтрокаТаблицы = ТаблицаПолей[Индекс];
		Если Уникальные[СтрокаТаблицы[ИмяПоля]] = Неопределено Тогда
			Уникальные.Вставить(СтрокаТаблицы[ИмяПоля], Истина);
			Индекс = Индекс + 1;
		Иначе
			Если СообщатьОДублях Тогда
				Если СообщениеОтправлено[СтрокаТаблицы[ИмяПоля]] = Неопределено Тогда
					ТекстОшибки = СтрШаблон( НСтр("ru = 'Сотрудник %1 выбран в комиссию дважды'"), СтрокаТаблицы.ЧленКомиссии);
					ОбщегоНазначения.СообщитьПользователю(
						ТекстОшибки,
						Объект,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТаблицы, СтрокаТаблицы.НомерСтроки, "ЧленКомиссии"),
						,
						Отказ);
					СообщениеОтправлено.Вставить(СтрокаТаблицы[ИмяПоля], Истина);
				КонецЕсли;
				Индекс = Индекс + 1;
			Иначе
				ТаблицаПолей.Удалить(СтрокаТаблицы);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

