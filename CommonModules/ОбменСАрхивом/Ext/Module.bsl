#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания "Обмен с Архивом".
//
Процедура ВыполнитьОбмен() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ОбменС1САрхивом);
	
	ПараметрыТранспорта = ОбменСАрхивомТранспорт.ПараметрыТранспортаДляСеансаОбмена();
	Если ПараметрыТранспорта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДанные(ПараметрыТранспорта);
	ВыгрузитьДанные(ПараметрыТранспорта);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область РаботаСФормами

// Выводит элементы на форму. Для вызова из обработчика формы ПриСозданииНаСервере.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма объекта.
//   ПараметрыРазмещения - Структура, Неопределено - см. ОбменСАрхивом.ПараметрыРазмещенияЭлементов
//
Процедура ПриСозданииНаСервере(Форма, ПараметрыРазмещения = Неопределено) Экспорт
	
#Если Не ВнешнееСоединение Тогда
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ПолучитьФункциональнуюОпцию("ИнтеграцияС1САрхивом") Тогда
		Возврат
	КонецЕсли;
	
	ЭтоФормаОбъекта = ЭтоФормаОбъекта(Форма);
	ИмяПроцедуры = "ОбменСАрхивом.ПриСозданииНаСервере";
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		ИмяПроцедуры, "Форма", Форма, Тип("ФормаКлиентскогоПриложения"));
	
	Если Не ЭтоФормаОбъекта Тогда
		ПриСозданииНаСервереФормыСписка(Форма, ПараметрыРазмещения);
		Возврат;
	КонецЕсли;
	
	Объект = ОбъектИзФормы(Форма);
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДокументыБИАНаФорме(Форма, ПараметрыРазмещения);
	КоличествоДокументов = Форма.ТаблицаДокументовБИА.Количество();
	
	// Размещение команд отправки в Архив и отмены отправки.
	ПанельРазмещенияКоманд = Неопределено;
	ИмяПанели = Форма.ДанныеБИА.ПараметрыРазмещения.ПанельРазмещенияКоманд;
	Если ЗначениеЗаполнено(ИмяПанели) Тогда
		ПанельРазмещенияКоманд = Форма.Элементы.Найти(ИмяПанели);
	КонецЕсли;
	Если ПанельРазмещенияКоманд = Неопределено Тогда
		ПанельРазмещенияКоманд = Форма.КоманднаяПанель;
	КонецЕсли;
	
	ИменаИсключаемыхКоманд = Новый Массив;
	ОбменСАрхивомПереопределяемый.ПриОпределенииИменИсключаемыхКоманд(
		Форма, ИменаИсключаемыхКоманд);
	
	ПодменюОбменС1САрхивом = Форма.Элементы.Найти("ПодменюОбменС1САрхивом");
	Если ПодменюОбменС1САрхивом = Неопределено Тогда
		ПодменюОбменС1САрхивом = Форма.Элементы.Добавить(ПанельРазмещенияКоманд.Имя + "КомандыАрхива", Тип("ГруппаФормы"),
			ПанельРазмещенияКоманд);
		ПодменюОбменС1САрхивом.Вид = ВидГруппыФормы.Подменю;
		ПодменюОбменС1САрхивом.Заголовок = НСтр("ru = '1С:Архив'");
		ПодменюОбменС1САрхивом.Картинка = БиблиотекаКартинок.АрхивБюро;
	КонецЕсли;
		
	// Отправить.
	ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыОтправитьВ1САрхив();
	Если ИменаИсключаемыхКоманд.Найти(ИмяКоманды) = Неопределено Тогда
		КомандаОтправить = Форма.Команды.Добавить(ИмяКоманды);
		КомандаОтправить.Заголовок = НСтр("ru = 'Передать документ'");
		КомандаОтправить.Действие = "Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом";
		КнопкаОтправить = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ПодменюОбменС1САрхивом);
		КнопкаОтправить.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		КнопкаОтправить.ИмяКоманды = ИмяКоманды;
		КнопкаОтправить.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю;
	КонецЕсли;
	
	// Посмотреть переданные документы.
	ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыПоказатьВсеДокументыБИА();
	Если ИменаИсключаемыхКоманд.Найти(ИмяКоманды) = Неопределено Тогда
		КомандаПоказатьПереданные = Форма.Команды.Добавить(ИмяКоманды);
		КомандаПоказатьПереданные.Заголовок = ?(КоличествоДокументов > 1, НСтр("ru = 'Переданные документы'"),
			НСтр("ru = 'Переданный документ'"));
		КомандаПоказатьПереданные.Действие = "Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом";
		КнопкаПоказатьПереданные = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ПодменюОбменС1САрхивом);
		КнопкаПоказатьПереданные.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		КнопкаПоказатьПереданные.ИмяКоманды = ИмяКоманды;
		КнопкаПоказатьПереданные.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
	КонецЕсли;
	
	// История обмена.
	ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыИсторияОбмена();
	Если ИменаИсключаемыхКоманд.Найти(ИмяКоманды) = Неопределено Тогда
		КомандаИстория = Форма.Команды.Добавить(ИмяКоманды);
		КомандаИстория.Заголовок = НСтр("ru = 'История обмена'");
		КомандаИстория.Действие = "Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом";
		КомандаИстория = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ПодменюОбменС1САрхивом);
		КомандаИстория.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		КомандаИстория.ИмяКоманды = ИмяКоманды;
		КомандаИстория.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю;
	КонецЕсли;
	
	// Отмена отправки.
	ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыОтменитьОтправкуВ1САрхив();
	Если ИменаИсключаемыхКоманд.Найти(ИмяКоманды) = Неопределено Тогда
		КомандаОтменить = Форма.Команды.Добавить(ИмяКоманды);
		КомандаОтменить.Заголовок = ?(КоличествоДокументов > 1, НСтр("ru = 'Отменить передачу документов'"),
			НСтр("ru = 'Отменить передачу документа'"));
		КомандаОтменить.Действие = "Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом";
		КнопкаОтменить = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ПодменюОбменС1САрхивом);
		КнопкаОтменить.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		КнопкаОтменить.ИмяКоманды = ИмяКоманды;
		КнопкаОтменить.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
	КонецЕсли;
	
	// Отзыв.
	ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыОтозватьИз1САрхива();
	Если ИменаИсключаемыхКоманд.Найти(ИмяКоманды) = Неопределено Тогда
		КомандаОтзыв = Форма.Команды.Добавить(ИмяКоманды);
		КомандаОтзыв.Заголовок = ?(КоличествоДокументов > 1, НСтр("ru = 'Отозвать документы'"),
			НСтр("ru = 'Отозвать документ'"));
		КомандаОтзыв.Действие = "Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом";
		КомандаОтзыв = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ПодменюОбменС1САрхивом);
		КомандаОтзыв.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		КомандаОтзыв.ИмяКоманды = ИмяКоманды;
		КомандаОтзыв.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
	КонецЕсли;
	
	УстановитьВидимостьИДоступностьКоманд(Форма);
	
	ОбменСАрхивомПереопределяемый.ПриСозданииНаСервере(Форма, ПараметрыРазмещения, Истина);
	
#Иначе
	ВызватьИсключение НСтр(
		"ru = 'Метод ""ОбменСАрхивом.ПриСозданииНаСервере"" недоступен во внешнем соединении.'");
#КонецЕсли
	
КонецПроцедуры

// Конструктор параметра процедуры ОбменСАрхивом.ПриСозданииНаСервере.
//
// Возвращаемое значение:
//   Структура - параметры размещения элементов формы:
//       * ПанельРазмещенияКоманд - ГруппаФормы, Неопределено - командная панель, в которой
//           выводятся команды отправки в 1С:Архив и отмены отправки (для форм элементов).
//           Если не заполнена, используется ком. панель формы элемента.
//       * ГруппаРазмещенияЭлементов - ГруппаФормы, Неопределено - группа, в которой 
//           выводятся элементы после того, как документ отправлен в Архив (для форм элементов).
//           Если не заполнена, элементы добавляются в верхнюю часть формы.
//       * ИмяСписка - Строка - имя элемента с таблицей списка интегрируемых объектов (для форм списков).
//           Если не заполнено, используется значение "Список".
//       * ИмяКолонкиОбъекта - Строка - имя колонки таблицы, в которой содержится
//           ссылка на интегрируемые объекты (для форм списков). Если не заполнено, используется значение "Ссылка".
//
Функция ПараметрыРазмещенияЭлементов() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПанельРазмещенияКоманд", Неопределено);
	Результат.Вставить("ГруппаРазмещенияЭлементов", Неопределено);
	Результат.Вставить("ИмяСписка", "");
	Результат.Вставить("ИмяКолонкиОбъекта", "");
	Возврат Результат;
	
КонецФункции

// Реализация выполнения подключаемой команды из формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма объекта.
//  ДополнительныеПараметры - Структура - см. 
// 
Процедура ВыполнитьПодключаемуюКоманду(Форма, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыОтправитьВ1САрхив() Тогда
		ПодготовитьДокументКВыгрузке(ДополнительныеПараметры.Ссылка);
		ЗаполнитьДокументыБИАНаФорме(Форма);
		УстановитьВидимостьИДоступностьКоманд(Форма);
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыОтменитьОтправкуВ1САрхив() Тогда
		ОтменитьПодготовкуДокументаКВыгрузке(ДополнительныеПараметры.Ссылка);
		ЗаполнитьДокументыБИАНаФорме(Форма);
		УстановитьВидимостьИДоступностьКоманд(Форма);
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыОтозватьИз1САрхива() Тогда
		ОтозватьДокументИзАрхива(ДополнительныеПараметры.Ссылка);
		ЗаполнитьДокументыБИАНаФорме(Форма);
		УстановитьВидимостьИДоступностьКоманд(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьВидимостьИДоступностьКоманд(Форма) Экспорт
	
#Если Не ВнешнееСоединение Тогда

	СтандартнаяОбработка = Истина;
	ОбменСАрхивомПереопределяемый.УстановитьВидимостьИДоступностьКоманд(Форма, СтандартнаяОбработка);
	Если СтандартнаяОбработка = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Объект = ОбъектИзФормы(Форма);
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь(,, Ложь);
	ОтправкаДоступнаПоРеквизитам = Не Объект.ПометкаУдаления
		И (Не ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта)
			Или МетаданныеОбъекта.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить
			Или Объект.Проведен);
	ЭтоАдминистраторОбмена = РольДоступна(Метаданные.Роли.АдминистрированиеОбменаС1САрхивом);
	ОтправкаДоступнаПоПравам = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена
		Или РольДоступна(Метаданные.Роли.ОтправкаДокументовВ1САрхив);
	ОтменаДоступнаБезОграничений = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена;
	ОтзывДоступенБезОграничений = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена;
	Если ОтправкаДоступнаПоПравам
			И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		ОтправкаДоступнаПоПравам = ОтправкаДоступнаПоПравам
			И МодульУправлениеДоступом.ИзменениеРазрешено(Объект.Ссылка, АвторизованныйПользователь);
	КонецЕсли;
	
	ТаблицаДокументовБИА = Форма.ТаблицаДокументовБИА;
	ОтмеченКОтправке = ТаблицаДокументовБИА.Количество() > 0;
	СтрокиВыгруженныхДокументов = ТаблицаДокументовБИА.НайтиСтроки(Новый Структура("Выгружен", Истина));
	ЕстьВыгруженные = СтрокиВыгруженныхДокументов.Количество() > 0;
	
	ВидимостьОтправить = ОтправкаДоступнаПоПравам И ОтправкаДоступнаПоРеквизитам И Не ОтмеченКОтправке;
	ВидимостьИстория = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ИсторияОбменаС1САрхивом)
		И РегистрыСведений.ИсторияОбменаС1САрхивом.ЕстьЗаписиПоОбъекту(Объект.Ссылка);
	ВидимостьОтменить = Ложь;
	ВидимостьОтозвать = Ложь;
	ВидимостьПоказатьДокументы = ЕстьВыгруженные Или ОтмеченКОтправке;
	Если ОтправкаДоступнаПоПравам И ОтмеченКОтправке Тогда
		Если ЕстьВыгруженные Тогда
			ВидимостьОтозвать = ОтзывДоступенБезОграничений;
		ИначеЕсли ОтменаДоступнаБезОграничений Тогда
			ВидимостьОтменить = Истина;
		Иначе
			ЕстьЧужиеДокументы = Ложь;
			Для Каждого СтрокаДокумента Из ТаблицаДокументовБИА Цикл
				Если СтрокаДокумента.Автор <> АвторизованныйПользователь Тогда
					ЕстьЧужиеДокументы = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			ВидимостьОтменить = Не ЕстьЧужиеДокументы;
		КонецЕсли;
	КонецЕсли;
	
	КнопкаОтправить = Форма.Элементы.Найти(ОбменСАрхивомКлиентСервер.ИмяКомандыОтправитьВ1САрхив());
	Если КнопкаОтправить <> Неопределено Тогда
		КнопкаОтправить.Видимость = ВидимостьОтправить;
	КонецЕсли;
	
	КнопкаОтменить = Форма.Элементы.Найти(ОбменСАрхивомКлиентСервер.ИмяКомандыОтменитьОтправкуВ1САрхив());
	Если КнопкаОтменить <> Неопределено Тогда
		КнопкаОтменить.Видимость = ВидимостьОтменить;
	КонецЕсли;
	
	КнопкаИстория = Форма.Элементы.Найти(ОбменСАрхивомКлиентСервер.ИмяКомандыИсторияОбмена());
	Если КнопкаИстория <> Неопределено Тогда
		КнопкаИстория.Видимость = ВидимостьИстория;
	КонецЕсли;
	
	КнопкаОтозвать = Форма.Элементы.Найти(ОбменСАрхивомКлиентСервер.ИмяКомандыОтозватьИз1САрхива());
	Если КнопкаОтозвать <> Неопределено Тогда
		КнопкаОтозвать.Видимость = ВидимостьОтозвать;
	КонецЕсли;
	
	КнопкаПоказатьДокументы = Форма.Элементы.Найти(ОбменСАрхивомКлиентСервер.ИмяКомандыПоказатьВсеДокументыБИА());
	Если КнопкаПоказатьДокументы <> Неопределено Тогда
		КнопкаПоказатьДокументы.Видимость = ВидимостьПоказатьДокументы;
	КонецЕсли;
	
	// Положение подменю в ком. панели.
	ВсеКнопки = Новый Массив;
	ВсеКнопки.Добавить(КнопкаИстория);
	ВсеКнопки.Добавить(КнопкаОтменить);
	ВсеКнопки.Добавить(КнопкаОтозвать);
	ВсеКнопки.Добавить(КнопкаОтправить);
	ВсеКнопки.Добавить(КнопкаПоказатьДокументы);
	ЕстьКнопкаВКомПанели = Ложь;
	ПоложениеВКомПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
	ПоложениеВПодменю = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю;
	Для Каждого Кнопка Из ВсеКнопки Цикл
		Если Кнопка <> Неопределено И Кнопка.Видимость = Истина
				И Кнопка.ПоложениеВКоманднойПанели = ПоложениеВКомПанели Тогда
			ЕстьКнопкаВКомПанели = Истина;
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Кнопка Из ВсеКнопки Цикл
		Если Кнопка <> Неопределено И Кнопка.Видимость = Истина Тогда
			Кнопка.ПоложениеВКоманднойПанели = ?(ЕстьКнопкаВКомПанели, ПоложениеВКомПанели, ПоложениеВПодменю);
		КонецЕсли;
	КонецЦикла;
	
#Иначе
	ВызватьИсключение НСтр(
		"ru = 'Метод ""ОбменСАрхивом.УстановитьВидимостьИДоступностьКоманд"" недоступен во внешнем соединении.'");
#КонецЕсли
	
КонецПроцедуры

Процедура ЗаполнитьДокументыБИАНаФорме(Форма, Знач ПараметрыРазмещения = Неопределено) Экспорт
	
#Если Не ВнешнееСоединение Тогда

	Если Не ЭтоФормаОбъекта(Форма) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	
	// Удаление элементов формы.
	ИмяГруппы = "ГруппаОбменС1САрхивом";
	ГруппаОбменС1САрхивом = Элементы.Найти(ИмяГруппы);
	ЭтоПовторноеЗаполнение = ГруппаОбменС1САрхивом <> Неопределено;
	Если ЭтоПовторноеЗаполнение Тогда
		Форма.Элементы.Удалить(ГруппаОбменС1САрхивом);
		КомандыКУдалению = Новый Массив;
		Для Каждого Команда Из Форма.Команды Цикл
			Если СтрНайти(Команда.Имя, "СкачатьКонтейнерДокументаИз1САрхива") > 0 Тогда
				КомандыКУдалению.Добавить(Команда);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Команда Из КомандыКУдалению Цикл
			Форма.Команды.Удалить(Команда);
		КонецЦикла;
	КонецЕсли;
	
	// Добавление реквизитов формы.
	Объект = ОбъектИзФормы(Форма);
	ТабДокументовБИА = ТаблицаДокументовБИА(Объект.Ссылка);
	Если ЭтоПовторноеЗаполнение Тогда
		Форма.ТаблицаДокументовБИА.Очистить();
	Иначе
		ДобавляемыеРеквизиты = Новый Массив;
		РеквизитТаблицаБИА = Новый РеквизитФормы("ТаблицаДокументовБИА",
			Новый ОписаниеТипов("ТаблицаЗначений"), "", НСтр("ru = 'Таблица документов БИА'"));
		Для Каждого Колонка Из ТабДокументовБИА.Колонки Цикл
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
				Колонка.Имя, Колонка.ТипЗначения, "ТаблицаДокументовБИА"));
		КонецЦикла;
		РеквизитДанныеБИА = Новый РеквизитФормы("ДанныеБИА", Новый ОписаниеТипов(), "",
			НСтр("ru = 'Вспомогательные данные для интеграции с 1С:Архивом'"));
		ДобавляемыеРеквизиты.Добавить(РеквизитТаблицаБИА);
		ДобавляемыеРеквизиты.Добавить(РеквизитДанныеБИА);
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		Если ПараметрыРазмещения = Неопределено Тогда
			ПараметрыРазмещения = ПараметрыРазмещенияЭлементов();
		КонецЕсли;
		Форма.ДанныеБИА = Новый Структура;
		Форма.ДанныеБИА.Вставить("ПараметрыРазмещения", ПараметрыРазмещения);
	КонецЕсли;
	Форма.ТаблицаДокументовБИА.Загрузить(ТабДокументовБИА);
	
	// Добавление элементов и команд.
	МестоРазмещенияЭлементов = Форма.ДанныеБИА.ПараметрыРазмещения.ГруппаРазмещенияЭлементов;
	Если МестоРазмещенияЭлементов = Неопределено Тогда
		МестоРазмещенияЭлементов = Форма;
	КонецЕсли;
	
	ГруппаОбменС1САрхивом = Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), МестоРазмещенияЭлементов);
	ГруппаОбменС1САрхивом.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОбменС1САрхивом.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаОбменС1САрхивом.ОтображатьЗаголовок = Ложь; 
	ГруппаОбменС1САрхивом.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаОбменС1САрхивом.ЦветФона = ЦветаСтиля.ЦветФонаИнформацииОбОбменеС1САрхивом;
	
	Если МестоРазмещенияЭлементов = Форма Тогда
		ПервыйЭлемент = Форма.ПодчиненныеЭлементы.Получить(0);
		Форма.Элементы.Переместить(ГруппаОбменС1САрхивом, ГруппаОбменС1САрхивом.Родитель, ПервыйЭлемент);
	КонецЕсли;
	
	ГруппаОбменС1САрхивом.РастягиватьПоВертикали = Ложь;
	ГруппаОбменС1САрхивом.РастягиватьПоГоризонтали = Истина;
	
	КоличествоДокументов = ТабДокументовБИА.Количество();
	ЕстьДоступныеДокументы = КоличествоДокументов > 0;
	Если ЕстьДоступныеДокументы Тогда
		Форма.ТолькоПросмотр = Истина;
	Иначе
		Возврат;
	КонецЕсли;
	
	ПредставленияСтатусовЕдЧисло = Новый Соответствие;
	ПредставленияСтатусовМнЧисло = Новый Соответствие;
	ЗаполнитьПредставленияСтатусов(ПредставленияСтатусовЕдЧисло, ПредставленияСтатусовМнЧисло);
	
	Если ЕстьДоступныеДокументы Тогда
		СтрокаДокумента = Форма.ТаблицаДокументовБИА[0];
		ИндексСтрокой = "0";
		
		ГруппаСтатусДокумента = Форма.Элементы.Добавить(
			"ГруппаДокументБИА" + ИндексСтрокой, Тип("ГруппаФормы"), ГруппаОбменС1САрхивом);
		ГруппаСтатусДокумента.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаСтатусДокумента.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаСтатусДокумента.ОтображатьЗаголовок = Ложь; 
		ГруппаСтатусДокумента.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		
		ЭлементСтатусаДокумента = Форма.Элементы.Добавить(
			ОбменСАрхивомКлиентСервер.ИмяЭлементаДокументБИА() + ИндексСтрокой,
			Тип("ДекорацияФормы"), ГруппаСтатусДокумента);
		ЭлементСтатусаДокумента.Вид = ВидДекорацииФормы.Надпись;

		Если КоличествоДокументов = 1 Тогда
			ЭлементСтатусаДокумента.Заголовок = ?(СтрокаДокумента.Уничтожен,
				НСтр("ru = 'уничтожен в 1С:Архиве'"),
				ПредставленияСтатусовЕдЧисло[СтрокаДокумента.Статус]);
			СтатусыНеВыгруженныхДокументов = СтатусыНеВыгруженныхДокументовБИА();
			Если СтатусыНеВыгруженныхДокументов.Найти(СтрокаДокумента.Статус) = Неопределено 
					И СтрокаДокумента.Уничтожен <> Истина Тогда
				ИмяКоманды = "СкачатьКонтейнерДокументаИз1САрхива" + Формат(ИндексСтрокой, "ЧГ=");
				КомандаСкачать = Форма.Команды.Добавить(ИмяКоманды);
				КомандаСкачать.Заголовок = НСтр("ru = 'Скачать'");
				КомандаСкачать.Действие = "Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом";
				
				КнопкаСкачать = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ГруппаСтатусДокумента);
				КнопкаСкачать.Вид = ВидКнопкиФормы.Гиперссылка;
				КнопкаСкачать.ИмяКоманды = ИмяКоманды;
			КонецЕсли;
		Иначе
			ЭлементСтатусаДокумента.Заголовок = ?(СтрокаДокумента.Уничтожен,
				НСтр("ru = 'уничтожены в 1С:Архиве'"),
				ПредставленияСтатусовМнЧисло[СтрокаДокумента.Статус]);
		КонецЕсли;
		
		// Добавление кнопки закрытия информации о документе БИА.
		ИмяКоманды = ОбменСАрхивомКлиентСервер.ИмяКомандыЗакрытьИнформационныйБаннер();
		Если Форма.Команды.Найти(ИмяКоманды) = Неопределено Тогда
			КомандаЗакрытьБаннер = Форма.Команды.Добавить(ИмяКоманды);
			КомандаЗакрытьБаннер.Заголовок = НСтр("ru = 'Закрыть'");
			КомандаЗакрытьБаннер.Действие = "Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом";
		КонецЕсли;
		КнопкаЗакрытьБаннер = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ГруппаОбменС1САрхивом);
		КнопкаЗакрытьБаннер.Вид = ВидКнопкиФормы.Гиперссылка;
		КнопкаЗакрытьБаннер.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
		КнопкаЗакрытьБаннер.ИмяКоманды = ИмяКоманды;
		КнопкаЗакрытьБаннер.Отображение = ОтображениеКнопки.Картинка;
		КнопкаЗакрытьБаннер.Картинка = БиблиотекаКартинок.СерыйКрест;
		КнопкаЗакрытьБаннер.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
		
	КонецЕсли;
	
#Иначе
	ВызватьИсключение НСтр(
		"ru = 'Метод ""ОбменСАрхивом.ЗаполнитьДокументыБИАНаФорме"" недоступен во внешнем соединении.'");
#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Заполнение данных подсистемы при начале работы с новой базой.
// 
Процедура НачальноеЗаполнение() Экспорт
	
	Константы.МаксимальноеКоличествоДокументовВПакетеДля1САрхива.Установить(
		МаксКоличествоДокументовВПакете());
	
КонецПроцедуры
	
Процедура ПерейтиНаНовуюВерсиюФорматаОбмена(Параметры = Неопределено) Экспорт
	
	Если ПолучитьФункциональнуюОпцию("ИнтеграцияС1САрхивом") = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметры) = Тип("Структура")
		И Параметры.Свойство("МонопольныйРежим")
		И Параметры.МонопольныйРежим = Ложь Тогда
		Параметры.МонопольныйРежим = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Константы.ВерсияФорматаОбменаС1САрхивомМаксимальная.Получить()) Тогда
		// Отслеживание добавленных типов данных выполняется с версии формата 1.0.11.
		Константы.ВерсияФорматаОбменаС1САрхивомМаксимальная.Установить(
			Метаданные.ПакетыXDTO.АДХ_1_0_11.ПространствоИмен);
	КонецЕсли;
	
	МаксВерсияФорматаДоОбновления = ВерсияФорматаМаксимальная();
	МаксВерсияФорматаПослеОбновления = ВерсияФорматаМаксимальная(Истина);
	Если МаксВерсияФорматаДоОбновления = МаксВерсияФорматаПослеОбновления Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ВерсияДляОтправкиДоОбновления = ВерсияФорматаДляОтправкиСообщений();
		Константы.ВерсияФорматаОбменаС1САрхивомМаксимальная.Установить(МаксВерсияФорматаПослеОбновления);
		СформироватьСообщениеОВерсииФормата();
		ВерсияДляОтправкиПослеОбновления = ВерсияФорматаДляОтправкиСообщений();
		ЗарегистрироватьНовыеДанныеВОбмене(ВерсияДляОтправкиДоОбновления, ВерсияДляОтправкиПослеОбновления);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Регистрирует к обмену данные, возможность обмена которыми была добавлена в новых версиях формата.
// 
// Параметры:
//  СтараяВерсияФормата - Строка - версия, которая использовалась для обмена до внесения изменений.
//  АктуальнаяВерсияФормата - Строка - версия, ставшая актуальной после внесения изменений.
//
Процедура ЗарегистрироватьНовыеДанныеВОбмене(СтараяВерсияФормата, АктуальнаяВерсияФормата) Экспорт
	
	Если СравнитьВерсииФормата(АктуальнаяВерсияФормата, СтараяВерсияФормата) <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоАктуальнаяВерсияИлиНиже = Ложь;
	Для Каждого Элемент Из ВерсииФорматаДоступные() Цикл
		Версия = Элемент.Значение;
		Если Версия = АктуальнаяВерсияФормата Тогда
			ЭтоАктуальнаяВерсияИлиНиже = Истина;
		КонецЕсли;
		Если Не ЭтоАктуальнаяВерсияИлиНиже Тогда
			Продолжить;
		КонецЕсли;
		Если Версия = СтараяВерсияФормата Тогда
			Прервать;
		КонецЕсли;
		ЗарегистрироватьНовыеДанныеВОбменеПоВерсии(Версия);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПодпискиНаСобытия

// Обработчик подписки на событие.
//
// Параметры:
//  Источник - ОпределяемыйТип.ДокументОбъектБИА - документ
//  Отказ - Булево
//  РежимЗаписи - РежимЗаписиДокумента
//  РежимПроведения - РежимПроведенияДокумента
//  
Процедура ПередЗаписьюДокументаОбработчик(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	ОбработчикПодпискиПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения);
	
КонецПроцедуры

Процедура ПередЗаписьюСправочникаОбработчик(Источник, Отказ) Экспорт
	
	ОбработчикПодпискиПередЗаписью(Источник, Отказ);
	
КонецПроцедуры

Процедура ОбменНСИСАрхивомЗарегистрироватьИзменение(Источник, Отказ) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИнтеграцияС1САрхивом") Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов")
	   И Не Источник.ДополнительныеСвойства.Свойство("РегистрироватьНаУзлахПлановОбменаПриОбновленииИБ") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	УзелАрхив = ПланыОбмена.ОбменНСИСАрхивом.УзелАрхив();
	Источник.ОбменДанными.Получатели.Добавить(УзелАрхив);
	
КонецПроцедуры

#КонецОбласти

// Возвращает список доступных для текущей конфигурации версий формата обмена.
//
// Возвращаемое значение:
//  СписокЗначений из Строка - список форматов.
//   Значение - пространство имен XDTO-пакета поддерживаемой версии,
//   Представление - пользовательское представление версии.
//
Функция ВерсииФорматаДоступные() Экспорт
	
	СписокВерсий = Новый СписокЗначений;
	
	НестандартныеПредставления = Новый Соответствие;
	НестандартныеПредставления[Метаданные.ПакетыXDTO.АДХ_1_0_3] = "1.0.6";
	
	ТаблицаВерсий = Новый ТаблицаЗначений;
	ТаблицаВерсий.Колонки.Добавить("ПространствоИмен");
	ТаблицаВерсий.Колонки.Добавить("Представление");
	ТаблицаВерсий.Колонки.Добавить("ЗначениеДляСортировки");
	
	Для Каждого Пакет Из Метаданные.ПакетыXDTO Цикл
		Если Не СтрНачинаетсяС(Пакет.Имя, "АДХ_") Тогда
			Если СписокВерсий.Количество() = 0 Тогда
				Продолжить;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
		СтрокаВерсии = ТаблицаВерсий.Добавить();
		СтрокаВерсии.ПространствоИмен = Пакет.ПространствоИмен;
		СтрокаВерсии.Представление = НестандартныеПредставления[Пакет];
		Если СтрокаВерсии.Представление = Неопределено Тогда
			СтрокаВерсии.Представление = ПредставлениеВерсииФормата(СтрокаВерсии.ПространствоИмен);
		КонецЕсли;
		СтрокаВерсии.ЗначениеДляСортировки = 0;
		ЧастиНомераВерсии = СтрРазделить(СтрокаВерсии.Представление, ".");
		КолСтрок = ЧастиНомераВерсии.Количество();
		Для Сч = 1 По КолСтрок Цикл
			ЧастьНомера = Число(ЧастиНомераВерсии[КолСтрок - Сч]);
			СтрокаВерсии.ЗначениеДляСортировки = СтрокаВерсии.ЗначениеДляСортировки + ЧастьНомера * Pow(1000, Сч-1);
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаВерсий.Сортировать("ЗначениеДляСортировки Убыв");
	Для Каждого СтрокаВерсии Из ТаблицаВерсий Цикл
		СписокВерсий.Добавить(СтрокаВерсии.ПространствоИмен, СтрокаВерсии.Представление);
	КонецЦикла;
	
	Возврат СписокВерсий;
	
КонецФункции

// Возвращает пространство имен актуального пакета XDTO.
// 
// Возвращаемое значение:
//  Строка - версия формата (пространство имен XDTO-пакета).
// 
Функция ВерсияФорматаДляОтправкиСообщений() Экспорт
	
	ВерсияДляОтправки = ВерсияФорматаБазыАрхива();
	ВерсияМаксимальная = ВерсияФорматаМаксимальная();
	
	Если СравнитьВерсииФормата(ВерсияДляОтправки, ВерсияМаксимальная) > 0 Тогда
		ВерсияДляОтправки = ВерсияМаксимальная;
	КонецЕсли;
	
	Возврат ВерсияДляОтправки;
	
КонецФункции

// Возвращает версию формата, поддерживаемую 1С:Архивом. Если не заполнена, выдается исключение.
// 
// Параметры:
//  ВызыватьИсключение - Булево - Если Истина и константа не заполнена, то будет вызвано исключение.
// 
// Возвращаемое значение:
//  Строка - версия формата (пространство имен XDTO-пакета).
// 
Функция ВерсияФорматаБазыАрхива(ВызыватьИсключение = Истина) Экспорт
	
	Версия = Константы.ВерсияФорматаОбменаПоддерживаемая1САрхивом.Получить();
	Если ВызыватьИсключение И Не ЗначениеЗаполнено(Версия) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не заполнено значение настройки ""%1"". Обратитесь к администратору.
			|
			|Контроль версий осуществляется автоматически, но что-то пошло не так. Пожалуйста, обратитесь в поддержку. Для обхода проблемы можно указать версию, которую поддерживает ваша база 1С:Архива, вручную. См. ""Настройка программы - Интеграция с 1С:Архивом - Версия формата"".'"),
			Метаданные.Константы.ВерсияФорматаОбменаПоддерживаемая1САрхивом.Синоним);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Возврат Версия;
	
КонецФункции

// Возвращает максимальную версию формата, доступную в текущей конфигурации.
// 
// Параметры:
//  ВычислитьИзМетаданных - Булево - если Истина, то значение будет вычислено заново
//  	на основании метаданных конфигурации. Если Ложь, значение будет получено из константы.
//
// Возвращаемое значение:
//  Строка - версия формата, доступная для текущей конфигурации.
//
Функция ВерсияФорматаМаксимальная(ВычислитьИзМетаданных = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Версия = Неопределено;
	Если Не ВычислитьИзМетаданных Тогда
		Версия = Константы.ВерсияФорматаОбменаС1САрхивомМаксимальная.Получить();
	КонецЕсли;
	
	Если ВычислитьИзМетаданных Или Не ЗначениеЗаполнено(Версия) Тогда
		ВсеВерсииФормата = ВерсииФорматаДоступные();
		Версия = ВсеВерсииФормата[0].Значение;
	КонецЕсли;
	
	Возврат Версия;
	
КонецФункции

// Формирует сообщения для 1С:Архива о поддерживаемой версии формата файлов обмена.
//
Процедура СформироватьСообщениеОВерсииФормата() Экспорт
	
	ВерсияФормата = ВерсияФорматаМаксимальная();
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(ЗаписьJSON, Новый Структура(ИмяСвойстваВерсияФормата(), ВерсияФормата));
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	НачатьТранзакцию();
	Попытка
		РегистрыСведений.СообщенияДля1САрхива.Добавить(ИмяСвойстваВерсияФормата(), СтрокаJSON);
		Событие = СобытиеДляЛога();
		Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
		Событие.КраткоеОписание = СтрШаблон(
			НСтр("ru = 'Сформировано сообщение о версии формата (%1)'"), ВерсияФормата);
		ЗаписатьВЛог(Событие);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Не удалось сформировать сообщение с версией формата по причине:
			|
			|%1'"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ОписаниеОшибки;
	КонецПопытки;
	
КонецПроцедуры

// Сравнивает две строки версий формата.
//
// Параметры:
//  ВерсияФормата1 - Строка - формат в виде пространства имен (например, "http://v8.1c.ru/doc8/LTA/1.0.8").
//  ВерсияФормата2 - Строка - формат в виде пространства имен.
//
// Возвращаемое значение:
//   Число   - больше 0, если ВерсияФормата1 > ВерсияФормата2; 0, если версии равны.
//
Функция СравнитьВерсииФормата(ВерсияФормата1, ВерсияФормата2) Экспорт
	
	ПредставлениеВерсии1 = ПредставлениеВерсииФормата(ВерсияФормата1) + ".0";
	ПредставлениеВерсии2 = ПредставлениеВерсииФормата(ВерсияФормата2) + ".0";
	
	Возврат ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ПредставлениеВерсии1, ПредставлениеВерсии2);
	
КонецФункции

// Пользовательское представление версии формата.
//
// Параметры:
//  Версия - Строка - формат в виде пространства имен (например, "http://v8.1c.ru/doc8/LTA/1.0.8").
//
// Возвращаемое значение:
//   Строка - представление версии для пользовательского интерфейса.
//
Функция ПредставлениеВерсииФормата(Версия) Экспорт
	
	ПредставлениеВерсии = Версия;
	ЧастиПространстваИмен = СтрРазделить(Версия, "/");
	Если ЧастиПространстваИмен.Количество() > 1 Тогда
		ПредставлениеВерсии = ЧастиПространстваИмен[ЧастиПространстваИмен.Количество() - 1];
	КонецЕсли;
	
	Возврат ПредставлениеВерсии;
	
КонецФункции

// Возвращает строку, которая будет передана в 1С:Архив в качестве идентификатора объекта.
//
// Параметры:
//  Ссылка - СправочникСсылка - ссылка на элемент (НСИ, ДокументБИА).
//
// Возвращаемое значение:
//  Строка - значение идентификатора.
//
Функция ИдентификаторСсылки(Ссылка) Экспорт
	
	Идентификатор = Неопределено;
	ОбменСАрхивомПереопределяемый.ПриОпределенииИдентификатораСсылки(Ссылка, Идентификатор);
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Валюты")
			И ТипЗнч(Ссылка) = Тип("СправочникСсылка.Валюты") Тогда
		Код = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Код");
		Возврат Строка(Код);
	КонецЕсли;
	
	Возврат Строка(Ссылка.УникальныйИдентификатор());
	
КонецФункции

// Возвращает структуру описания МЧД для последующей выгрузки в 1С:Архив.
//
// Возвращаемое значение:
//  Структура:
//   * Тип - Строка - значение из перечисления WarrantType пакета XDTO.
//      "EMCHD" для формата 003, "ON_DOVBB" для предыдущих форматов.
//   * НомерДоверенности - Строка - номер доверенности.
//   * ЕстьВРеестреФНС - Булево - Истина, если доверенность помещена в реестр ФНС.
//   * ИННДоверителя - Строка - ИНН доверителя.
//   * ИмяФайлаМЧД - Строка - локальное имя файла доверенности в папке ВременнаяПапка.
//       Обязательно для нереестровых доверенностей.
//   * ИмяФайлаПодписиМЧД - Строка - локальное имя файла подписи доверенности в папке ВременнаяПапка.
//       Обязательно для нереестровых доверенностей.
//   * Комментарий - Строка - произвольный комментарий.
// 
// Если выгрузка элемента не требуется, возвращается Неопределено.
//
Функция НовоеОписаниеМЧД() Экспорт
	
	Описание = Новый Структура;
	Описание.Вставить("Тип", "");
	Описание.Вставить("НомерДоверенности", "");
	Описание.Вставить("ЕстьВРеестреФНС", Ложь);
	Описание.Вставить("ИННДоверителя", "");
	Описание.Вставить("ИмяФайлаМЧД", "");
	Описание.Вставить("ИмяФайлаПодписиМЧД", "");
	Описание.Вставить("Комментарий", "");
	
	Возврат Описание;
	
КонецФункции

// Возвращает таблицу документов БИА, созданных на основании переданного объекта.
//
// Параметры:
//  ОснованиеСсылка - ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА - ссылка на прикладной объект
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица документов БИА
// 
Функция ТаблицаДокументовБИА(ОснованиеСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ДокументыБИА.Ссылка КАК Документ,
		|	ДокументыБИА.ВидДокумента КАК ВидДокумента,
		|	ДокументыБИА.Автор КАК Автор,
		|	ДокументыБИА.Уничтожен КАК Уничтожен,
		|	ЕСТЬNULL(СтатусыОбменаДокументовБИА.Статус, &СтатусНеГотов) КАК Статус,
		|	НЕ ЕСТЬNULL(СтатусыОбменаДокументовБИА.Статус, &СтатусНеГотов) В (&СтатусыНеВыгруженныхДокументов) КАК Выгружен,
		|	ЕСТЬNULL(СтатусыОбменаДокументовБИА.Статус, &СтатусНеГотов) В (&СтатусыДокументовЗагруженныхВАрхив) КАК ЗагруженВАрхив
		|ИЗ
		|	Справочник.ДокументыБИА КАК ДокументыБИА
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыОбменаДокументовБИА КАК СтатусыОбменаДокументовБИА
		|		ПО ДокументыБИА.Ссылка = СтатусыОбменаДокументовБИА.ДокументБИА
		|ГДЕ
		|	ДокументыБИА.ОбъектОснование = &ОснованиеСсылка
		|	И НЕ ДокументыБИА.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Документ
		|АВТОУПОРЯДОЧИВАНИЕ");

	СтатусыМенеджер = Перечисления.СтатусыОбменаС1САрхивом;
	СтатусыНеВыгруженныхДокументов = Новый Массив;
	СтатусыНеВыгруженныхДокументов.Добавить(СтатусыМенеджер.ГотовКВыгрузке);
	СтатусыНеВыгруженныхДокументов.Добавить(СтатусыМенеджер.НеГотовКВыгрузке);
	СтатусыНеВыгруженныхДокументов.Добавить(СтатусыМенеджер.ОбнаруженыОшибкиПриВыгрузке);
	
	СтатусыДокументовЗагруженныхВАрхив = Новый Массив;
	СтатусыДокументовЗагруженныхВАрхив.Добавить(СтатусыМенеджер.ЗагрузкаВАрхивВыполнена);
	СтатусыДокументовЗагруженныхВАрхив.Добавить(СтатусыМенеджер.ОбнаруженыОшибкиПриЗагрузкеВАрхив);
	СтатусыДокументовЗагруженныхВАрхив.Добавить(СтатусыМенеджер.ОбнаруженыОшибкиПриПроверкеВАрхиве);
	СтатусыДокументовЗагруженныхВАрхив.Добавить(СтатусыМенеджер.ПринятВАрхив);
	
	Запрос.УстановитьПараметр("ОснованиеСсылка", ОснованиеСсылка);
	Запрос.УстановитьПараметр("СтатусНеГотов", СтатусыМенеджер.НеГотовКВыгрузке);
	Запрос.УстановитьПараметр("СтатусыНеВыгруженныхДокументов", СтатусыНеВыгруженныхДокументов);
	Запрос.УстановитьПараметр("СтатусыДокументовЗагруженныхВАрхив", СтатусыДокументовЗагруженныхВАрхив);
		
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ПодготовитьДокументКВыгрузке(Ссылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Отказ = Ложь;
	ОбменСАрхивомПереопределяемый.ПроверитьГотовностьДокументаКОтправке(Ссылка, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Ссылка.Метаданные();
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(	
		МетаданныеОбъекта.ПолноеИмя());
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(МетаданныеОбъекта.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.ДокументыБИА.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("ОбъектОснование", Ссылка);
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		ЕстьОшибкиПроверки = Ложь;
		ДокументыБИА = СоздатьДокументыБИА(Ссылка, МенеджерОбъекта);
		Если ДокументыБИА.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Документы для 1С:Архива не сформированы. Обратитесь к администратору.'");
		КонецЕсли;
		Для Каждого ДокументОбъект Из ДокументыБИА Цикл
			Если ДокументОбъект.ПроверитьЗаполнение() Тогда
				ДокументОбъект.Записать();
			Иначе
				ЕстьОшибкиПроверки = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьОшибкиПроверки Тогда
			ВызватьИсключение НСтр("ru = 'Обнаружены ошибки проверки заполнения документов для 1С:Архива'");
		Иначе
			Событие = СобытиеДляЛога();
			Событие.ОсновнойОбъект = Ссылка;
			Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
			Событие.КраткоеОписание = НСтр("ru = 'Документ отмечен к выгрузке в 1С:Архив'");
			ЗаписатьВЛог(Событие);
			
			РегистрыСведений.ДокументыОтправленныеВ1САрхив.Добавить(Ссылка);
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтменитьПодготовкуДокументаКВыгрузке(Ссылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.ДокументыБИА.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("ОбъектОснование", Ссылка);
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		ТабДокументовБИА = ТаблицаДокументовБИА(Ссылка);
		Для Каждого СтрокаДокумента Из ТабДокументовБИА Цикл
			ДокументБИАОбъект = СтрокаДокумента.Документ.ПолучитьОбъект();
			ДокументБИАОбъект.ДополнительныеСвойства.Вставить("ЭтоОтзывДокумента", Истина);
			ДокументБИАОбъект.УстановитьПометкуУдаления(Истина);
		КонецЦикла;
		
		Событие = СобытиеДляЛога();
		Событие.ОсновнойОбъект = Ссылка;
		Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
		Событие.КраткоеОписание = НСтр("ru = 'Отметка к выгрузке в 1С:Архив отменена'");
		ЗаписатьВЛог(Событие);
		
		РегистрыСведений.ДокументыОтправленныеВ1САрхив.Удалить(Ссылка);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтозватьДокументИзАрхива(Ссылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.ДокументыБИА.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("ОбъектОснование", Ссылка);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ТЧПакетов.Ссылка КАК Пакет,
		|	ТЧПакетов.Документ КАК ДокументБИА
		|ИЗ
		|	Справочник.ПакетыДокументовДля1САрхива.Документы КАК ТЧПакетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДокументыБИА КАК ДокументыБИА
		|		ПО ТЧПакетов.Документ = ДокументыБИА.Ссылка
		|ГДЕ
		|	ДокументыБИА.ОбъектОснование = &ОбъектОснование
		|ИТОГИ
		|ПО
		|	Пакет");
	Запрос.УстановитьПараметр("ОбъектОснование", Ссылка);
	
	ОтозванныеДокументыПакетов = Новый Соответствие;
	ВыборкаПакеты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПакеты.Следующий() Цикл
		ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.ПакетыДокументовДля1САрхива.ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ВыборкаПакеты.Пакет);
		ОтозванныеДокументыПакета = Новый Соответствие;
		Выборка = ВыборкаПакеты.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОтозванныеДокументыПакета[Выборка.ДокументБИА] = Истина;
		КонецЦикла;
		ОтозванныеДокументыПакетов[ВыборкаПакеты.Пакет] = ОтозванныеДокументыПакета;
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		ТабДокументовБИА = ТаблицаДокументовБИА(Ссылка);
		Для Каждого СтрокаДокумента Из ТабДокументовБИА Цикл
			ДокументБИАОбъект = СтрокаДокумента.Документ.ПолучитьОбъект();
			ДокументБИАОбъект.ДополнительныеСвойства.Вставить("ЭтоОтзывДокумента", Истина);
			ДокументБИАОбъект.УстановитьПометкуУдаления(Истина);
		КонецЦикла;
		Для Каждого КлючИЗначение Из ОтозванныеДокументыПакетов Цикл
			Пакет = КлючИЗначение.Ключ;
			ОтозванныеДокументыПакета = КлючИЗначение.Значение;
			ПакетОбъект = Пакет.ПолучитьОбъект();
			КолСтрок = ПакетОбъект.Документы.Количество();
			Для Сч = 1 По КолСтрок Цикл
				СтрокаДокумента = ПакетОбъект.Документы[КолСтрок - Сч];
				Если ОтозванныеДокументыПакета[СтрокаДокумента.Документ] <> Неопределено Тогда
					ПакетОбъект.Документы.Удалить(СтрокаДокумента);
				КонецЕсли;
			КонецЦикла;
			ПакетОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуСтатусаПриЗаписи", Истина);
			ПакетОбъект.Записать();
		КонецЦикла;
		Событие = СобытиеДляЛога();
		Событие.ОсновнойОбъект = Ссылка;
		Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
		Событие.КраткоеОписание = НСтр("ru = 'Документ отозван из 1С:Архива'");
		ЗаписатьВЛог(Событие);
		РегистрыСведений.ДокументыОтправленныеВ1САрхив.Удалить(Ссылка);
		ОтменитьУдалениеДанныхДокументовПринятыхВАрхив(Ссылка);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ТипыXDTOПоТипамЗначений(ВерсияФормата = Неопределено) Экспорт
	
	Если ВерсияФормата = Неопределено Тогда
		ВерсияФормата = ВерсияФорматаДляОтправкиСообщений();
	КонецЕсли;
	
	ДоступныеТипы = Новый Соответствие;
	ОбъектКонтейнер = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ВерсияФормата, "DocumentContainer"));
	ТипXDTOСтрокиДопСвойства = ОбъектКонтейнер.Свойства().Получить("OtherProperties").Тип;
	СтрокаДопСвойств = ФабрикаXDTO.Создать(ТипXDTOСтрокиДопСвойства);
	СтрокиПеречисленияТипов = СтрокаДопСвойств.Свойства().Получить("Type").Тип.Фасеты.Перечисления;
	Для Каждого СтрокаТипа Из СтрокиПеречисленияТипов Цикл
		ДоступныеТипы[СтрокаТипа.Значение] = Истина;
	КонецЦикла;
	
	ИменаТиповXDTO = Новый Соответствие;
	ИменаТиповXDTO[Тип("Строка")] = "String";
	ИменаТиповXDTO[Тип("Число")]  = "Numeric";
	ИменаТиповXDTO[Тип("Булево")] = "Boolean";
	ИменаТиповXDTO[Тип("Дата")]   = "Date";
	
	ИменаТиповXDTO[Тип("СправочникСсылка.ДокументыБИА")] = "Document";
	ИменаТиповXDTO[Тип("СправочникСсылка.ВидыДокументовБИА")] = "DocumentType";
	ИменаТиповXDTO[Тип("СправочникСсылка.ПакетыДокументовДля1САрхива")] = "DocumentPackage";
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Валюты") Тогда
		ИменаТиповXDTO[Тип("СправочникСсылка.Валюты")] = "Currency";
	КонецЕсли;
	
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.ГрифДоступаБИА.Тип.Типы() Цикл
		ИменаТиповXDTO[Тип] = "SecurityLevel";
	КонецЦикла;
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.ДолжностьБИА.Тип.Типы() Цикл
		ИменаТиповXDTO[Тип] = "Title";
	КонецЦикла;
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.КонтрагентБИА.Тип.Типы() Цикл
		ИменаТиповXDTO[Тип] = "Counterparty";
	КонецЦикла;
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.ОрганизацияБИА.Тип.Типы() Цикл
		ИменаТиповXDTO[Тип] = "Organization";
	КонецЦикла;
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.ПодразделениеБИА.Тип.Типы() Цикл
		ИменаТиповXDTO[Тип] = "Department";
	КонецЦикла;
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.ПроектБИА.Тип.Типы() Цикл
		ИменаТиповXDTO[Тип] = "Project";
	КонецЦикла;
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.СотрудникБИА.Тип.Типы() Цикл
		ИменаТиповXDTO[Тип] = "Employee";
	КонецЦикла;
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.ФизическоеЛицоБИА.Тип.Типы() Цикл
		ИменаТиповXDTO[Тип] = "Individual";
	КонецЦикла;
	Если ДоступныеТипы["IndividualAccessGroup"] <> Неопределено Тогда
		Для Каждого Тип Из Метаданные.ОпределяемыеТипы.ГруппыДоступаФизическихЛицБИА.Тип.Типы() Цикл
			ИменаТиповXDTO[Тип] = "IndividualAccessGroup";
		КонецЦикла;
	КонецЕсли;
	
	Возврат ИменаТиповXDTO;
	
КонецФункции

