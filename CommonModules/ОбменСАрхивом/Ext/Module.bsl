Функция ДоступноРедактированиеПоСтатусу(СтатусОбменаСАрхивом, ЭтоПакетДокументов = Ложь) Экспорт

	СтатусыОбмена = Перечисления.СтатусыОбменаС1САрхивом;
	РедактированиеДоступно =
		СтатусОбменаСАрхивом = СтатусыОбмена.ПустаяСсылка()
		Или СтатусОбменаСАрхивом = СтатусыОбмена.НеГотовКВыгрузке
		Или СтатусОбменаСАрхивом = СтатусыОбмена.ОбнаруженыОшибкиПриВыгрузке
		Или СтатусОбменаСАрхивом = СтатусыОбмена.ОбнаруженыОшибкиПриЗагрузкеВАрхив
		Или СтатусОбменаСАрхивом = СтатусыОбмена.ОбнаруженыОшибкиПриПроверкеВАрхиве
		Или ЭтоПакетДокументов И СтатусОбменаСАрхивом = СтатусыОбмена.ГотовКВыгрузке;
	
	Возврат РедактированиеДоступно;
	
КонецФункции

// Обработчик регламентного задания ОбработкаОчередиОперацийСДокументамиДля1САрхива.
// 
Процедура ОбработкаОчередиОперацийСДокументами() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ОбработкаОчередиОперацийСДокументамиДля1САрхива);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Количество = РегистрыСведений.ОчередьОперацийСДокументамиДля1САрхива.ОбработатьПорцию();
	Пока Количество <> 0 Цикл
		Количество = РегистрыСведений.ОчередьОперацийСДокументамиДля1САрхива.ОбработатьПорцию();
	КонецЦикла;	
	
КонецПроцедуры

// Выполняет отложенные операции по передаче документов в архив (удаление данных объекта).
//
// Параметры:
//  ДокументыДляОбработки - Массив из ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА - документы для обработки.
//  Немедленно - Булево - если Ложь, то задание записывается в очередь, удаление выполняется отложенно.
//
Процедура УдалитьДанныеДокументовПринятыхВАрхив(ДокументыДляОбработки, Немедленно = Ложь) Экспорт
	
	Если Не Немедленно Тогда
		ДопСведения = РегистрыСведений.ОчередьОперацийСДокументамиДля1САрхива
			.ИмяОперацииУдаленияДанныхПринятогоОбъекта();
		ДатаУдаления = ТекущаяДатаСеанса() + 14 * 24 * 3600;
		Для Каждого Документ Из ДокументыДляОбработки Цикл
			РегистрыСведений.ОчередьОперацийСДокументамиДля1САрхива.Добавить(
				Документ, ДопСведения, ДатаУдаления);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	ОбменСАрхивомПереопределяемый.УдалитьДанныеДокументовПринятыхВАрхив(Документы, СтандартнаяОбработка);
	Если СтандартнаяОбработка = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ДокументыБИА.Ссылка КАК Ссылка,
		|	ДокументыБИА.ОбъектОснование КАК ОбъектОснование,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументыБИАФайлы.Файл) = ТИП(Справочник.ВерсииФайлов)
		|			ТОГДА ВЫРАЗИТЬ(ДокументыБИАФайлы.Файл КАК Справочник.ВерсииФайлов).Владелец
		|		ИНАЧЕ ДокументыБИАФайлы.Файл
		|	КОНЕЦ КАК Файл,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументыБИАФайлы.ФайлВизуализации) = ТИП(Справочник.ВерсииФайлов)
		|			ТОГДА ВЫРАЗИТЬ(ДокументыБИАФайлы.ФайлВизуализации КАК Справочник.ВерсииФайлов).Владелец
		|		ИНАЧЕ ДокументыБИАФайлы.ФайлВизуализации
		|	КОНЕЦ КАК ФайлВизуализации
		|ИЗ
		|	Справочник.ДокументыБИА КАК ДокументыБИА
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДокументыБИА.Файлы КАК ДокументыБИАФайлы
		|		ПО (ДокументыБИАФайлы.Ссылка = ДокументыБИА.Ссылка)
		|ГДЕ
		|	ДокументыБИА.ОбъектОснование В (&Документы)
		|	И НЕ ДокументыБИА.ПометкаУдаления
		|ИТОГИ
		|ПО
		|	ОбъектОснование");
	
	Запрос.УстановитьПараметр("Документы", ДокументыДляОбработки);
	
	ВыборкаОснование = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОснование.Следующий() Цикл
		
		УдаленоФайлов = 0;
		ОбъектОснование = ВыборкаОснование.ОбъектОснование;
		
		НачатьТранзакцию();
		
		Попытка
			
			Выборка = ВыборкаОснование.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Файл) Тогда
					Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
							Выборка.Файл, "ПометкаУдаления") = Ложь Тогда
						ФайлОбъект = Выборка.Файл.ПолучитьОбъект();
						ФайлОбъект.УстановитьПометкуУдаления(Истина);
						УдаленоФайлов = УдаленоФайлов + 1;
					КонецЕсли; 
				КонецЕсли;
				Если ЗначениеЗаполнено(Выборка.ФайлВизуализации) Тогда
					Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
							Выборка.ФайлВизуализации, "ПометкаУдаления") = Ложь Тогда
						ФайлОбъект = Выборка.ФайлВизуализации.ПолучитьОбъект();
						ФайлОбъект.УстановитьПометкуУдаления(Истина);
						УдаленоФайлов = УдаленоФайлов + 1;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Событие = СобытиеДляЛога("", Истина);
			Событие.ОсновнойОбъект = ОбъектОснование;
			Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
			Событие.КраткоеОписание = СтрШаблон(
				НСтр("ru = 'Удалены файлы документа, переданного в 1С:Архив. Удалено файлов: %1'"),
				УдаленоФайлов);
			ЗаписатьВЛог(Событие);
			
			ЗафиксироватьТранзакцию();
			
		Исключение 
			
			ОтменитьТранзакцию();
			
			ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Ошибка при удалении данных переданного документа:%1%2'"),
				Символы.ПС, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Событие = СобытиеДляЛога("", Истина);
			Событие.ОсновнойОбъект = ОбъектОснование;
			Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
			Событие.КраткоеОписание = ОписаниеОшибки;
			ЗаписатьВЛог(Событие);
			
			ВызватьИсключение ОписаниеОшибки;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Удаляет запланированные отложенные операции по передаче документов в архив (удаление данных объекта).
//
// Параметры:
//  ДокументыДляОбработки - ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА,
//    Массив из ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА - документы для обработки.
//  Немедленно - Булево - если Ложь, то задание записывается в очередь, удаление выполняется отложенно.
//
Процедура ОтменитьУдалениеДанныхДокументовПринятыхВАрхив(Знач ДокументыДляОбработки) Экспорт
	
	Если ТипЗнч(ДокументыДляОбработки) <> Тип("Массив") Тогда
		ДокументыДляОбработки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументыДляОбработки);
	КонецЕсли;
	
	ДопСведения = РегистрыСведений.ОчередьОперацийСДокументамиДля1САрхива
		.ИмяОперацииУдаленияДанныхПринятогоОбъекта();
	Для Каждого Документ Из ДокументыДляОбработки Цикл
		РегистрыСведений.ОчередьОперацийСДокументамиДля1САрхива.Удалить(Документ, ДопСведения);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает ссылку на физ. лицо текущего пользователя.
//
// Возвращаемое значение: 
//   ОпределяемыйТип.ФизическоеЛицоБИА - физ. лицо.
// 
Функция ФизЛицоТекущегоПользователя() Экспорт
	
	ФизЛицо = Неопределено;
	
	Пользователь = Пользователи.АвторизованныйПользователь();
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
		РеквизитПользователя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователь, "ФизическоеЛицо");
		Если ЗначениеЗаполнено(РеквизитПользователя)
				И Метаданные.ОпределяемыеТипы.ФизическоеЛицоБИА.Тип.СодержитТип(ТипЗнч(РеквизитПользователя)) Тогда
			ФизЛицо = РеквизитПользователя;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ФизЛицо;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

