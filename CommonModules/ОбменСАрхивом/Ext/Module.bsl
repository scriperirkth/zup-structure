	ПредставленияСтатусовМнЧисло[СтатусыМенеджер.ОбнаруженыОшибкиПриВыгрузке]
		= НСтр("ru = 'Ошибка выгрузки в 1С:Архив'");
	ПредставленияСтатусовМнЧисло[СтатусыМенеджер.ВыгрузкаВыполнена]
		= НСтр("ru = 'Документы выгружены в 1С:Архив'");
	// Пока нет детализации ошибок пакета по документам, статус "ошибка" не выводится.
	ПредставленияСтатусовМнЧисло[СтатусыМенеджер.ОбнаруженыОшибкиПриЗагрузкеВАрхив]
