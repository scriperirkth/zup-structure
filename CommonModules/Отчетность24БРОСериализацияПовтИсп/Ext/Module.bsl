#Область СлужебныйПрограммныйИнтерфейс

// Проверка наличия стандартного реквизита справочника.
// 
// Параметры:
//  ИмяТипаXML   - Строка
//  ИмяРеквизита - Строка
// 
// Возвращаемое значение:
//  Булево
Функция ЕстьСтандартныйРеквизитСправочника(ИмяТипаXML, ИмяРеквизита = "Код") Экспорт
	
	Результат = Ложь;
	Для Каждого Реквизит Из Метаданные.Справочники[ИмяТипаXML].СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверка наличия реквизита у объекта метаданных
// 
// Параметры:
//  ВидТипаСписка - Строка
//  ИмяТипаXML    - Строка
//  ИмяРеквизита  - Строка
// 
// Возвращаемое значение:
//  Булево
Функция ЕстьРеквизитОбъектаМетаданных(ВидТипаСписка, ИмяТипаXML, ИмяРеквизита) Экспорт
	
	Реквизиты = СтандартныеРеквизитыОбъектаМетаданных(ВидТипаСписка, ИмяТипаXML);
	Если Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	 
	Реквизиты = РеквизитыОбъектаМетаданных(ВидТипаСписка, ИмяТипаXML);
	Если Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

// Возвращает массив реквизитов объекта метаданных.
// 
// Параметры:
//  ВидТипаСписка - Строка
//  ИмяТипа       - Строка
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция РеквизитыОбъектаМетаданных(ВидТипаСписка, ИмяТипа) Экспорт
	
	Результат = Новый Массив(); // Массив Из Строка
	ОбъектМетаданных = Метаданные[ВидТипаСписка][ИмяТипа]; // ОбъектМетаданныхСправочник, ОбъектМетаданныхДокумент, ОбъектМетаданныхПланСчетов - и т.п. 
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Результат.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив стандартных реквизитов объекта метаданных.
// 
// Параметры:
//  ВидТипаСписка - Строка
//  ИмяТипа       - Строка
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция СтандартныеРеквизитыОбъектаМетаданных(ВидТипаСписка, ИмяТипа) Экспорт
	
	Результат = Новый Массив(); // Массив Из Строка
	ОбъектМетаданных = Метаданные[ВидТипаСписка][ИмяТипа]; // ОбъектМетаданныхСправочник, ОбъектМетаданныхДокумент, ОбъектМетаданныхПланСчетов - и т.п.
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		Результат.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти