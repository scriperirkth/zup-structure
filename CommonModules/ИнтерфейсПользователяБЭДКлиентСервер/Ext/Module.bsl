// Определяет, запущено ли приложение в интерфейсе Такси
// 
// Возвращаемое значение:
//  Булево - Истина, если приложение запущено в интерфейсе Такси
//           Ложь, в ином случае.
Функция ЭтоИнтерфейсТакси() Экспорт
	Возврат КлиентскоеПриложение.ТекущийВариантИнтерфейса() = ВариантИнтерфейсаКлиентскогоПриложения.Такси;
КонецФункции

// Определяет, запущено ли приложение в интерфейсе 8.5
// 
// Возвращаемое значение:
//  Булево - Истина, если приложение запущено в интерфейсе 8.5
//           Ложь, в ином случае.
Функция ЭтоИнтерфейсВерсия8_5() Экспорт
	Возврат КлиентскоеПриложение.ТекущийВариантИнтерфейса() = ВариантИнтерфейсаКлиентскогоПриложения.Версия8_5;
КонецФункции

#КонецОбласти

#Область Баннеры

// Метод-конструктор дополнительных параметров оформления баннера
// 
// Возвращаемое значение:
//  Структура - Дополнительные параметры оформления баннера:
//  * ЦветФона   - Цвет - Цвет фона баннера
//  * ЦветТекста - Цвет - Цвет текста баннера
Функция НовыеПараметрыОформленияБаннера() Экспорт
	
	Результат = Новый Структура;
	
	Цвета = ИнтерфейсПользователяБЭДКлиентСерверПовтИсп.Цвета();
	
	Результат.Вставить("ЦветФона"   , Цвета.Пустой);
	Результат.Вставить("ЦветТекста" , Цвета.ПоясняющийТекст);
	
	Возврат Результат;
	
КонецФункции

// Выполняет оформление красного баннера для разных режимов запуска платформы
//
// Параметры:
//  Форма               - ФормаКлиентскогоПриложения - Форма, на которой требуется адаптировать баннер
//  ИмяЭлементаФормы    - Строка                     - Имя группы формы, отображаемой в виде баннера
//  ПараметрыОформления - См. ИнтерфейсПользователяБЭДКлиентСервер.НовыеПараметрыОформленияБаннера
//                        - Неопределено - Параметры оформления по умолчанию
Процедура ОформитьБаннерОшибка(
	Знач Форма, 
	Знач ИмяЭлементаФормы, 
	Знач ПараметрыОформления = Неопределено) Экспорт
	
	ОформитьБаннер(Форма, ИмяЭлементаФормы, НастройкиБаннераОшибка(), ПараметрыОформления);
	
КонецПроцедуры

