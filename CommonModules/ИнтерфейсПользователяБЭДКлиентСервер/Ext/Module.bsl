// Выполняет оформление красного баннера для разных режимов запуска платформы
//
// Параметры:
//  Форма               - ФормаКлиентскогоПриложения - Форма, на которой требуется адаптировать баннер
//  ИмяЭлементаФормы    - Строка                     - Имя группы формы, отображаемой в виде баннера
//  НастройкиБаннера     - См. НовыеНастройкиБаннера
//  ПараметрыОформления - См. ИнтерфейсПользователяБЭДКлиентСервер.НовыеПараметрыОформленияБаннера
//                        - Неопределено - Параметры оформления по умолчанию
Процедура ОформитьБаннер(
	Форма, 
	Знач ИмяЭлементаФормы, 
	Знач НастройкиБаннера, 
	Знач ПараметрыОформления = Неопределено)
	
	Контекст = "ИнтерфейсПользователяБЭДКлиентСервер.ОформитьБаннер";
	
	Если ЭтоИнтерфейсВерсия8_5() Тогда
		// Считаем, что форма по умолчанию оформлена с ориентиром на интерфейс 8.5.
		// То есть модифицируем форму только для интерфейса Такси.
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОформления = Неопределено Тогда
		ПараметрыОформления = НовыеПараметрыОформленияБаннера();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, ИмяЭлементаФормы, "ЦветФона", ПараметрыОформления.ЦветФона);
	
	Баннер = Форма.Элементы.Найти(ИмяЭлементаФормы);
	
	Если Баннер = Неопределено Тогда
		Возврат; // Возможные модификации формы (например, из-за ролей)
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		ТипЗнч(Баннер) = Тип("ГруппаФормы"),
		СтрШаблон(
			НСтр("ru = 'Баннер формы ""%1"" должен иметь тип ""Группа Формы""'"),
			ИмяЭлементаФормы),
		Контекст);
	
	ПодчиненныеЭлементы = ПодчиненныеЭлементы(Баннер);
	
	Для каждого ПодчиненныйЭлемент Из ПодчиненныеЭлементы Цикл
		Если ЭлементОбладаетСпециальнымОформлением(ПодчиненныйЭлемент) Тогда
			Продолжить; // Для некоторых элементов не требуется менять оформление
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, ПодчиненныйЭлемент.Имя, "ЦветТекста", ПараметрыОформления.ЦветТекста);
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоДекорацияГиперссылки(Знач ЭлементФормы)
	Возврат ТипЗнч(ЭлементФормы) = Тип("ДекорацияФормы")
		И ЭлементФормы.Вид = ВидДекорацииФормы.Надпись
		И ЭлементФормы.Гиперссылка;
КонецФункции

Функция ЭлементОбладаетСпециальнымОформлением(Знач ЭлементФормы)
	Возврат ЭтоДекорацияГиперссылки(ЭлементФормы);
КонецФункции

#КонецОбласти

#Область ВидимостьЭлементовФормы

// Скрывает элемент формы
//
// Параметры:
//  Форма               - ФормаКлиентскогоПриложения - Форма, на которой располагается скрываемый элемент
//  ИмяЭлементаФормы    - Строка                     - Имя элемента формы, который требуется скрыть
Процедура СкрытьЭлементФормы(Знач Форма, Знач ИмяЭлементаФормы)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, ИмяЭлементаФормы, "Видимость", Ложь);
КонецПроцедуры

#КонецОбласти

#Область ИерархияЭлементовФормы

Процедура ДобавитьПодчиненныеЭлементы(НакопленныеЭлементы, Знач ПодчиненныеЭлементы)
	
	Для каждого ПодчиненныйЭлемент Из ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда
			ДобавитьПодчиненныеЭлементы(НакопленныеЭлементы, ПодчиненныйЭлемент.ПодчиненныеЭлементы);
		Иначе
			НакопленныеЭлементы.Добавить(ПодчиненныйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПодчиненныеЭлементы(Знач ЭлементВладелец)
	
	Результат = Новый Массив;
	
	ДобавитьПодчиненныеЭлементы(Результат, ЭлементВладелец.ПодчиненныеЭлементы);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
