#Область КнопкаПоУмолчанию

// Настраивает отображение элемента формы только для интерфейса Такси
//
// Параметры:
//  Форма            - ФормаКлиентскогоПриложения - Форма, на которой требуется адаптировать элемент формы
//  ИмяЭлементаФормы - Строка                     - Имя элемента формы, который требуется адаптировать
//  Использование    - Булево                     - Истина, если требуется кнопку оформить как кнопку по умолчанию
//                                                  Ложь, если требуется скрыть команду.
//
// Пример:
//  // Если ЭтоРежимВыбора:
//  //  - Делаем кнопку "ФормаВыбор" кнопкой по умолчанию
//  //  - Скрываем кнопку "ФормаЗагрузить"
//  // Если Не ЭтоРежимВыбора:
//  //  - Делаем кнопку "ФормаЗагрузить" кнопкой по умолчанию
//  //  - Скрываем кнопку "ФормаВыбор"
//  ИнтерфейсПользователяБЭДКлиентСервер.УстановитьКнопкуПоУмолчанию(
//       ЭтотОбъект,
//       Элементы.ФормаВыбор.Имя,
//       ЭтоРежимВыбора);
//  ИнтерфейсПользователяБЭДКлиентСервер.УстановитьКнопкуПоУмолчанию(
//       ЭтотОбъект,
//       Элементы.ФормаЗагрузить.Имя,
//       Не ЭтоРежимВыбора);
Процедура УстановитьКнопкуПоУмолчанию(Знач Форма, Знач ИмяЭлементаФормы, Знач Использование) Экспорт
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		ИмяЭлементаФормы,
		"Видимость",
		Использование);
		
	Если ЭтоИнтерфейсТакси() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы,
			ИмяЭлементаФормы,
			"КнопкаПоУмолчанию",
			Использование);
	ИначеЕсли ЭтоИнтерфейсВерсия8_5() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы,
			ИмяЭлементаФормы,
			"Важность",
			?(Использование, ВажностьКнопки.Главная, ВажностьКнопки.Обычная));
	КонецЕсли;
	
КонецПроцедуры

