// Возвращает структуру, содержащую шаблон процесса и идентификатор этапа для переданной формы документа.
//
// Параметры:
//  Форма - УправляемаяФорма - форма, из которой требуется получить данные шаблона процесса.
//
Функция ШаблонИИдентификаторЭтапаИзФормы(Форма) Экспорт
	
	ДанныеИзФормы = Новый Структура;
	ДанныеИзФормы.Вставить("ПроцессыОбработкиДокументов_ТекущийШаблон", Новый УникальныйИдентификатор());
	ДанныеИзФормы.Вставить("ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа", Новый УникальныйИдентификатор());
	ЗаполнитьЗначенияСвойств(ДанныеИзФормы, Форма);
	
	Результат = Новый Структура;
	Результат.Вставить("Шаблон", ПредопределенноеЗначение("Справочник.ШаблоныПроцессов.ПустаяСсылка"));
	Результат.Вставить("Этап", Новый УникальныйИдентификатор);
	
	Если ТипЗнч(ДанныеИзФормы.ПроцессыОбработкиДокументов_ТекущийШаблон) <> Тип("УникальныйИдентификатор") Тогда
		Результат.Шаблон = ДанныеИзФормы.ПроцессыОбработкиДокументов_ТекущийШаблон;
		Результат.Этап = ДанныеИзФормы.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПоказатьДокументИзПрисоединенногоФайла(Результат, Параметры) Экспорт

	Файл = Параметры.Ссылка;
	Если ЗначениеЗаполнено(Файл) Тогда
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
		ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(
			Файл, Неопределено, УникальныйИдентификатор);
		
		РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьДокументФормуляра(Результат, Параметры) Экспорт

	ДокументФормуляра = Параметры.Формуляр;
	Если ЗначениеЗаполнено(ДокументФормуляра) Тогда
		ПараметрыФормы = Новый Структура("Ключ, СкрытьПрисоединенныеФайлы", ДокументФормуляра, Истина);
	Иначе
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ формуляра не найден.'"));
		Возврат;
	КонецЕсли;

	ФормаФормуляра = ОткрытьФорму("Документ.ФормулярПервичногоДокументаПОД.Форма.ФормаФормуляра", ПараметрыФормы);
	
КонецПроцедуры

