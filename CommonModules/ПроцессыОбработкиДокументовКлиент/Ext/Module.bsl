Процедура ПродолжитьВыполнениеКомандыПослеПодтвержденияЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ВыполняетсяЗаписьПоКнопкеВыполненияЭтапа = Истина;
	
	ШаблонДоЗаписи = ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ТекущийШаблон;
	
	Попытка
		ДополнительныеПараметры.Форма.Записать(Новый Структура);
	Исключение
		ПоказатьОповещениеПользователя(,,КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),БиблиотекаКартинок.Информация32);
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	КонецПопытки;
	
	Если ДополнительныеПараметры.Объект.Ссылка.Пустая() ИЛИ ДополнительныеПараметры.Форма.Модифицированность Тогда
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	ИначеЕсли ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре <> ШаблонДоЗаписи Тогда
		// Произошла смена шаблона, необходимо прекратить выполнение этапа
		ТекстСообщения = НСтр("ru = 'Шаблон процесса был изменен согласно условиям использования. Выполнение задачи отменено.'");
		ПоказатьОповещениеПользователя(,,ТекстСообщения,БиблиотекаКартинок.Информация32);
		// Требуется переинициализция формы
		ДополнительныеПараметры.Форма.Прочитать();
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ДокументЗаписан");
	
	// Если документ был новый либо произошла смена шаблона,
	// то необходимо в параметрах установить ссылку на документ и на новую задачу
	Если ДополнительныеПараметры.ДанныеДокументов[0].Документ.Пустая()
		ИЛИ ДополнительныеПараметры.ДанныеДокументов[0].Задача.Пустая() Тогда
		
		ДополнительныеПараметры.ДанныеДокументов[0].Документ = ДополнительныеПараметры.Объект.Ссылка;
		ДополнительныеПараметры.ДанныеДокументов[0].Задача = ПроцессыОбработкиДокументовВызовСервера.ЗадачаНовогоДокумента(
			ДополнительныеПараметры.ДанныеДокументов[0].Шаблон,
			ДополнительныеПараметры.ДанныеДокументов[0].ИдентификаторЭтапа,
			ДополнительныеПараметры.ДанныеДокументов[0].Документ);
		
		ИдентификаторПачки = ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиКакВыполняемые(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры.ДанныеДокументов[0].Задача));
		ДополнительныеПараметры.Вставить("ИдентификаторПачки", ИдентификаторПачки);
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяЭП ИЛИ ДополнительныеПараметры.ТребуетсяПростаяЭП Тогда
		ОписаниеОшибки = "";
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДокументов(ДополнительныеПараметры.ДанныеДокументов, ОписаниеОшибки);
		Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
			ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ИдентификаторПачки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяВызовСервера Тогда
		ВыполнитьПроцедурыСВызовомСервера(ДополнительныеПараметры);
	КонецЕсли;
	
	Если ДополнительныеПараметры.ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(ДополнительныеПараметры, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВыполнениеЗадач(ДополнительныеПараметры, Отказ, ОписаниеОшибки);
	
КонецПроцедуры

Процедура ПродолжитьВыполнениеКомандыПослеЭлектроннойПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Успех Тогда
		
		Для Каждого ТекДанные Из Результат.НаборДанных Цикл
			Если Результат.Свойство("РезультатПроверкиМЧДДляПодписания") Тогда
				Если Результат.РезультатПроверкиМЧДДляПодписания <> Неопределено Тогда
					РезультатПроверкиПодписиПоМЧД = Новый Структура;
					РезультатПроверкиПодписиПоМЧД.Вставить("ТребуетсяПроверка", Истина);
					
					ТекДанные.СвойстваПодписи.Вставить("РезультатПроверкиПодписиПоМЧД", РезультатПроверкиПодписиПоМЧД);
					Если Результат.Свойство("ВыбраннаяДоверенность") Тогда
						ТекДанные.СвойстваПодписи.РезультатПроверкиПодписиПоМЧД.Вставить("МашиночитаемаяДоверенность", Результат.ВыбраннаяДоверенность);
					КонецЕсли;
					ПротоколПроверки = Новый Соответствие;
					ПроверкаДоверенности = Новый Структура;
					ПроверкаПодписанта = Новый Структура;
					ПроверкаПолномочий = Новый Структура;
					ПроверкаДокумента = Новый Структура;
					
					Проверка = Новый Структура;
					Проверка.Вставить("Верна", Неопределено);
					Проверка.Вставить("ЗаголовокПроверки", "");
					Проверка.Вставить("ТекстПроверки", "");
					Проверка.Вставить("ДатаПроверки", Неопределено);
					Проверка.Вставить("РучнаяПроверка", Ложь);
					Проверка.Вставить("ДополнительныеДанные", Неопределено);
					
					Если Результат.РезультатПроверкиМЧДДляПодписания.Свойство("ПроверкаДоверенности") Тогда
						ПроверкаДоверенности = Результат.РезультатПроверкиМЧДДляПодписания.ПроверкаДоверенности;
					КонецЕсли;	
					Если Результат.РезультатПроверкиМЧДДляПодписания.Свойство("ПроверкаПодписанта") Тогда
						ПроверкаПодписанта = Результат.РезультатПроверкиМЧДДляПодписания.ПроверкаПодписанта;
					КонецЕсли;
						
					ПроверкаПолномочий = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Проверка);
					ПроверкаПолномочий.ЗаголовокПроверки = "Проверка полномочий";
					ПроверкаДокумента = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Проверка);
					ПроверкаДокумента.ЗаголовокПроверки = "Проверка документа";
					
					ПротоколПроверки.Вставить("ПроверкаДоверенности", ПроверкаДоверенности);
					ПротоколПроверки.Вставить("ПроверкаПодписанта", ПроверкаПодписанта);
					ПротоколПроверки.Вставить("ПроверкаПолномочий", ПроверкаПолномочий);
					ПротоколПроверки.Вставить("ПроверкаДокумента", ПроверкаДокумента);
					
					ТекДанные.СвойстваПодписи.РезультатПроверкиПодписиПоМЧД.Вставить("ПротоколПроверки", ПротоколПроверки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ДополнительныеПараметры.Вставить("НаборДанных", Результат.НаборДанных);
		
		ПродолжитьВыполнениеЗадачи(ДополнительныеПараметры);
		
	Иначе
		
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПродолжитьПослеВводаКомментария(Текст, Параметры) Экспорт
	
	Если Текст = Неопределено Тогда
		
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(Параметры.ИдентификаторПачки);
		
	ИначеЕсли ПустаяСтрока(Текст) Тогда
		
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(Параметры.ИдентификаторПачки);
		
		ТекстСообщения = НСтр("ru='Для выполнения выбранного действия необходимо заполнить комментарий.'");
		ПоказатьОповещениеПользователя(,,ТекстСообщения,БиблиотекаКартинок.Информация32);
		
	Иначе
		
		Параметры.Вставить("Комментарий", Текст);
		
		Если Параметры.ТребуетсяЭП ИЛИ Параметры.ТребуетсяПростаяЭП Тогда
			ОписаниеОшибки = "";
			ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДокументов(Параметры.ДанныеДокументов, ОписаниеОшибки);
			Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
				ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(Параметры.ИдентификаторПачки);
				ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если Параметры.ТребуетсяВызовСервера Тогда
			ВыполнитьПроцедурыСВызовомСервера(Параметры);
		КонецЕсли;
		
		Если Параметры.ДанныеДокументов.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Отказ = Ложь;
		ОписаниеОшибки = "";
		СтандартнаяОбработка = Истина;
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(Параметры, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
		Если НЕ СтандартнаяОбработка Тогда
			Возврат;
		КонецЕсли;
		
		ПродолжитьВыполнениеЗадач(Параметры, Отказ, ОписаниеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПродолжитьПослеПодтвержденияЗакрытия(Результат, Форма) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		ПроцессыОбработкиДокументовВызовСервера.СохранитьКомментарийИсполнителяЗадачи(
			Форма.ПроцессыОбработкиДокументов_ТекущаяЗадача,
			Форма.ПроцессыОбработкиДокументов_КомментарийСледующему);
	КонецЕсли;
	
	Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя = Ложь;
	Форма.Закрыть();
	
КонецПроцедуры

Процедура ПродолжитьПослеПодтвержденияЗаписиИЗакрытия(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		
		ДополнительныеПараметры.Форма.Записать();
		
		Если ДополнительныеПараметры.Источник.Ссылка.Пустая() ИЛИ ДополнительныеПараметры.Форма.Модифицированность Тогда
			Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя = Ложь;
	ДополнительныеПараметры.Форма.Закрыть();
	
КонецПроцедуры

Процедура ВыполнитьПроцедурыСВызовомСервера(Параметры)
	
	ЗадачиСОтказомВыполнения = Новый Массив;
	
	ПроцессыОбработкиДокументовВызовСервера.ВыполнитьПроцедурыСВызовомСервера(
		Параметры.ДанныеДокументов,
		Параметры.ДополнительныйКонтекст,
		Параметры.ТребуетсяЭП,
		Параметры.ТребуетсяПростаяЭП,
		Параметры.ДанныеДляПодписи,
		Параметры.УникальныйИдентификатор,
		Параметры.ТребуетсяПроверкаПредыдущихЭП,
		Параметры.ТребуетсяПроверкаПодписанныхДанных,
		Параметры.ТребуетсяПроверкаНаличияКлючаПЭПВРеестре,
		ЗадачиСОтказомВыполнения);
	
	Для Каждого ДанныеДокумента Из Параметры.ДанныеДокументов Цикл
		
		Если ДанныеДокумента.Свойство("ПараметрыОповещения") Тогда
			Оповестить(ДанныеДокумента.ПараметрыОповещения.ИмяСобытия,
				ДанныеДокумента.ПараметрыОповещения.Параметры,
				ДанныеДокумента.ПараметрыОповещения.Источник);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗадачиСОтказомВыполнения.Количество() > 0
		И Параметры.Свойство("ДокументЗаписан")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры.Форма, "ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя")
		И Параметры.Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя Тогда
		
		Комментарий = Параметры.Комментарий;
		Параметры.Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя = Ложь;
		
	КонецЕсли;
	
	ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ЗадачиСОтказомВыполнения, Параметры.ВывестиСообщениеОбОшибке, Комментарий);
	
КонецПроцедуры

Процедура ПодписатьДанныеДокументов(ПараметрыДляПодписи)
	
	Если ПараметрыДляПодписи.ДанныеДляПодписи = Неопределено Тогда
		ПараметрыДляПодписи.ДанныеДляПодписи = ПроцессыОбработкиДокументовВызовСервера.ДанныеДляПодписиМассивДокументов(
			ПараметрыДляПодписи.ДанныеДокументов, ПараметрыДляПодписи.УникальныйИдентификатор, ПараметрыДляПодписи.ТребуетсяЭП);
	КонецЕсли;
	
	ПродолжитьПодписаниеДанныхДокументов(ПараметрыДляПодписи);
	
КонецПроцедуры

Процедура ПослеФормированияПервичныхДокументовНаКлиенте(Результат, ПараметрыДляПодписи) Экспорт
	
	Если Результат = Неопределено Тогда
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ПараметрыДляПодписи.ИдентификаторПачки);
		Возврат;
	КонецЕсли;
	
	// Проверка совпадения файлов первичных документов с ранее подписанными
	ПроцессыОбработкиДокументовВызовСервера.ПроверитьСовпадениеФайловПервичныхДокументовСРанееПодписанными(
		Результат.ПервичныеДокументы, ПараметрыДляПодписи.УникальныйИдентификатор);
	
	Для Каждого ПервичныйДокумент Из Результат.ПервичныеДокументы Цикл
		Для Индекс = 0 По ПараметрыДляПодписи.ДанныеДляПодписи.НаборДанных.ВГраница() Цикл
			Данные = ПараметрыДляПодписи.ДанныеДляПодписи.НаборДанных[Индекс];
			Если ПервичныйДокумент.Предмет = Данные.Владелец
				И ПервичныйДокумент.ИдентификаторПечатнойФормы = Данные.ИдентификаторПечатнойФормы Тогда
				
				Данные.Вставить("Данные", ПервичныйДокумент.Данные);
				Данные.Вставить("ИмяФайла", ПервичныйДокумент.ИмяФайла);
				Данные.Вставить("Ссылка", ПервичныйДокумент.Файл);
				Данные.Вставить("ФорматПервичногоДокумента", "mxl");
				Данные.Вставить("Представление", Данные.ВидДокумента);
				
				ДанныеPDF = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(Данные);
				ДанныеPDF.Данные = ПервичныйДокумент.ДанныеPDF;
				ДанныеPDF.ИмяФайла = Лев(ПервичныйДокумент.ИмяФайла, СтрДлина(ПервичныйДокумент.ИмяФайла) - 3) + "pdf";
				ДанныеPDF.Ссылка = ПервичныйДокумент.ФайлPDF;
				ДанныеPDF.ФорматПервичногоДокумента = "pdf";
				ДанныеPDF.Представление = Данные.ВидДокумента;
				
				ПараметрыДляПодписи.ДанныеДляПодписи.НаборДанных.Вставить(Индекс + 1, ДанныеPDF);
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ПродолжитьПодписаниеДанныхДокументов(ПараметрыДляПодписи);
	
КонецПроцедуры

Процедура ПродолжитьПодписаниеДанныхДокументов(ПараметрыДляПодписи)

	ОдинДокумент = ПараметрыДляПодписи.ДанныеДокументов.Количество() = 1;
	
	Для Каждого Данные Из ПараметрыДляПодписи.ДанныеДляПодписи.НаборДанных Цикл
		
		Если Данные.Свойство("Формуляр") И ЗначениеЗаполнено(Данные.Формуляр) Тогда
			Если ТипЗнч(Данные.Формуляр) = Тип("ДокументСсылка.ФормулярПервичногоДокументаПОД") Тогда
				Представление = Данные.ВидДокумента;
				
				ПараметрыОбработчика = Новый Структура;
				ПараметрыОбработчика.Вставить("Текст", "");
				ПараметрыОбработчика.Вставить("Формуляр", Данные.Формуляр);
				ПараметрыОбработчика.Вставить("Заголовок", Представление);
				ПараметрыОбработчика.Вставить("ФорматПервичногоДокумента", Данные.ФорматПервичногоДокумента);
				
				ОбработчикОткрытияФайла = Новый ОписаниеОповещения("ПоказатьДокументФормуляра", ЭтотОбъект, ПараметрыОбработчика);
				
				Данные.Вставить("Представление", Новый Структура("Значение, Представление", ОбработчикОткрытияФайла, Представление));
					
			КонецЕсли;
		ИначеЕсли Данные.Свойство("Владелец") И Данные.Владелец = Неопределено Тогда
			
			Если ОдинДокумент Тогда
				Представление = НСтр("ru = 'Данные документа (XML)'");
			Иначе
				Представление = Строка(Данные.Ссылка) + НСтр("ru = ' (Данные документа)'");
			КонецЕсли;
			
			ПараметрыОбработчика = Новый Структура;
			ПараметрыОбработчика.Вставить("Текст", Данные.Представление);
			ПараметрыОбработчика.Вставить("Заголовок", Представление);
			
			ОбработчикОткрытияФайла = Новый ОписаниеОповещения("ПоказатьТекстовыйДокумент", ЭтотОбъект, ПараметрыОбработчика);
			
			Данные.Вставить("Представление", Новый Структура("Значение, Представление", ОбработчикОткрытияФайла, Представление));
			
			ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДляПодписиДокумента(
				Данные.Ссылка, Данные.Шаблон, Данные.ИдентификаторЭтапа, Данные);
		ИначеЕсли Данные.Свойство("Владелец") И ЗначениеЗаполнено(Данные.Ссылка) И ТипЗнч(Данные.Данные) = Тип("Строка") Тогда
			Представление = Данные.Представление;
			
			ПараметрыОбработчика = Новый Структура;
			ПараметрыОбработчика.Вставить("Заголовок", Представление);
			ПараметрыОбработчика.Вставить("Ссылка", Данные.Ссылка);
			
			ОбработчикОткрытияФайла = Новый ОписаниеОповещения("ПоказатьДокументИзПрисоединенногоФайла", ЭтотОбъект, ПараметрыОбработчика);
			Данные.Вставить("Представление", Новый Структура("Значение, Представление", ОбработчикОткрытияФайла, Представление));
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОдинДокумент Тогда
		Операция = "Подпись документа";
		ЗаголовокДанных = "Документ";
	Иначе
		Операция = "Подпись документов";
		ЗаголовокДанных = "Документы";
	КонецЕсли;
	
	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("Операция", Операция);
	ОписаниеДанных.Вставить("ЗаголовокДанных", ЗаголовокДанных);
	ОписаниеДанных.Вставить("СообщитьОЗавершении", Ложь);
	ОписаниеДанных.Вставить("ПоказатьКомментарий", Ложь);
	
	ОписаниеДанных.Вставить("НаборДанных", ПараметрыДляПодписи.ДанныеДляПодписи.НаборДанных);
	ОписаниеДанных.Вставить("ПредставлениеНабора", ПараметрыДляПодписи.ДанныеДляПодписи.ПредставлениеНабора);
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Форма", ПараметрыДляПодписи.Форма);
	ПараметрыКоманды.Вставить("ИдентификаторПачки", ПараметрыДляПодписи.ИдентификаторПачки);
	ПараметрыКоманды.Вставить("Статус", ПараметрыДляПодписи.Статус);
	ПараметрыКоманды.Вставить("Комментарий", ПараметрыДляПодписи.Комментарий);
	ПараметрыКоманды.Вставить("ДополнительныйКонтекст", ПараметрыДляПодписи.ДополнительныйКонтекст);
	ПараметрыКоманды.Вставить("ДанныеДокументов", ПараметрыДляПодписи.ДанныеДокументов);
	ПараметрыКоманды.Вставить("ВывестиСообщениеОбОшибке", ПараметрыДляПодписи.ВывестиСообщениеОбОшибке);
	
	Обработчик = Новый ОписаниеОповещения("ПродолжитьВыполнениеКомандыПослеЭлектроннойПодписи", ЭтотОбъект, ПараметрыКоманды);
	
	Если ПараметрыДляПодписи.ТребуетсяЭП Тогда
		ОписаниеДанных.Вставить("ОтборСертификатов", ПараметрыДляПодписи.ДанныеДляПодписи.МассивДоступныхСертификатов);
		Подписать(ОписаниеДанных, , Обработчик);
	ИначеЕсли ПараметрыДляПодписи.ТребуетсяПростаяЭП Тогда
		ОписаниеДанных.Вставить("СведенияДляПростойПодписи", ПараметрыДляПодписи.ДанныеДляПодписи.СведенияДляПростойПодписи);
		
		Отказ = Ложь;
		ПроверитьСведенияОДолжностиПодписантаПЭППОД(ОписаниеДанных, ПараметрыДляПодписи.ИдентификаторПачки, Отказ);
		Если Отказ Тогда
			Возврат;	
		КонецЕсли; 
		
		ПодписатьПростойПодписью(ОписаниеДанных, Обработчик); 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВыполненияЗадачи(Контекст, ДополнительныеПараметры) Экспорт
	
	Если Контекст.Свойство("ЗадачиСОшибками") Тогда
		ПоказатьОповещениеОНеуспешномВыполненииЗадач(Контекст.ЗадачиСОшибками, Контекст.ДанныеДокументов.Количество() = 1);
	КонецЕсли;
	
	Если Контекст.Свойство("ПараметрыОповещения") Тогда
		Оповестить(Контекст.ПараметрыОповещения.ИмяСобытия,
					Контекст.ПараметрыОповещения.Параметры,
					Контекст.ПараметрыОповещения.Источник);
	КонецЕсли;
	
	ОповеститьДинамическиеСпискиДокументов(Контекст.ДанныеДокументов);
	
	Оповестить("Запись_ЗадачаПоОбработкеДокумента");
	
КонецПроцедуры

Процедура ПоказатьОповещениеОНеуспешномВыполненииЗадач(ЗадачиСОшибками, СообщитьПользователю = Ложь)
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось выполнить задач: %1'"),
					ЗадачиСОшибками.Количество());
	Пояснение = НСтр("ru = 'Нажмите для получения информации об ошибках'");
	ОповещениеПриНажатии = Новый ОписаниеОповещения("ПоказатьИнформациюОбОшибках", ЭтотОбъект, ЗадачиСОшибками);
	ПоказатьОповещениеПользователя(ТекстСообщения,
									ОповещениеПриНажатии,
									Пояснение,
									БиблиотекаКартинок.Предупреждение32,
									СтатусОповещенияПользователя.Важное);
									
	Если СообщитьПользователю Тогда
		Для Каждого ЗадачаСОшибками Из ЗадачиСОшибками Цикл
			Если ЗадачаСОшибками.Свойство("СообщениеДляВывода") Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(ЗадачаСОшибками.СообщениеДляВывода);
			Иначе
				ОбщегоНазначенияКлиент.СообщитьПользователю(ЗадачаСОшибками.ОписаниеОшибки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьДинамическиеСпискиДокументов(ДанныеДокументов)
	
	ОповещенныеТипы = Новый Соответствие;
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		ТипДокумента = ТипЗнч(ДанныеДокумента.Документ);
		Если ОповещенныеТипы.Получить(ТипДокумента) = Неопределено Тогда
			ОповеститьОбИзменении(ТипДокумента);
			ОповещенныеТипы.Вставить(ТипДокумента, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЭлектронныеПодписиНаКлиенте(Параметры)
	
	ЗадачиСОтказомВыполнения = Новый Массив;
	
	// Для проверки используются данные подписей, полученные на сервере.
	МассивПодписейДляПроверки = Новый Массив;
	Для Каждого ДанныеДокумента Из Параметры.ДанныеДокументов Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеДокумента, "ЭлектронныеПодписи") Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПодписейДляПроверки, ДанныеДокумента.ЭлектронныеПодписи);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивПодписейДляПроверки.Количество() = 0 Тогда
		ПослеПроверкиЭлектронныхПодписейНаКлиенте(Параметры);
	Иначе
		ПараметрыОповещения = Новый Структура("МассивПодписейДляПроверки, ПроверяемыйИндекс, Параметры, ЗадачиСОтказомВыполнения",
												МассивПодписейДляПроверки, 0, Параметры, ЗадачиСОтказомВыполнения);
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиОчереднойПодписиНаКлиенте", ЭтотОбъект, ПараметрыОповещения);
		ПроверитьПодпись(Оповещение, МассивПодписейДляПроверки[0].АдресДанных, МассивПодписейДляПроверки[0].АдресПодписи);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеПроверкиОчереднойПодписиНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	МассивПодписейДляПроверки = ДополнительныеПараметры.МассивПодписейДляПроверки;
	ПроверяемыйИндекс = ДополнительныеПараметры.ПроверяемыйИндекс;
	
	Если ТипЗнч(Результат) = Тип("Булево") ИЛИ Результат = Неопределено Тогда
		// результат проверки положительный
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
		ОписаниеОшибки = НСтр("ru = 'Электронная подпись для документа %1 неверна.
			|Причина: %2'");
		ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, МассивПодписейДляПроверки[ПроверяемыйИндекс].Документ, Результат);
	Иначе
		ОписаниеОшибки = НСтр("ru = 'Не удалось проверить подписи электронного документа.
			|Проверьте настройки криптографии или обратитесь к администратору.'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		
		ЗадачаСОтказомВыполнения = Новый Структура;
		ЗадачаСОтказомВыполнения.Вставить("Задача", МассивПодписейДляПроверки[ПроверяемыйИндекс].Задача);
		ЗадачаСОтказомВыполнения.Вставить("ДатаПопытки", ОбщегоНазначенияКлиент.ДатаСеанса());
		ЗадачаСОтказомВыполнения.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		ДополнительныеПараметры.ЗадачиСОтказомВыполнения.Добавить(ЗадачаСОтказомВыполнения);
		
		КоличествоЭлементовКоллекции = ДополнительныеПараметры.Параметры.ДанныеДокументов.Количество();
		Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
			Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
			ДанныеДокумента = ДополнительныеПараметры.Параметры.ДанныеДокументов[Индекс];
			Если МассивПодписейДляПроверки[ПроверяемыйИндекс].Документ = ДанныеДокумента.Документ Тогда
				ДополнительныеПараметры.Параметры.ДанныеДокументов.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПроверяемыйИндекс < МассивПодписейДляПроверки.ВГраница() Тогда
		ПараметрыОповещения = Новый Структура("МассивПодписейДляПроверки, ПроверяемыйИндекс, Параметры, ЗадачиСОтказомВыполнения",
			МассивПодписейДляПроверки, ПроверяемыйИндекс + 1, ДополнительныеПараметры.Параметры, ДополнительныеПараметры.ЗадачиСОтказомВыполнения);
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиОчереднойПодписиНаКлиенте", ЭтотОбъект, ПараметрыОповещения);
		ПроверитьПодпись(Оповещение, МассивПодписейДляПроверки[ПроверяемыйИндекс + 1].АдресДанных, МассивПодписейДляПроверки[ПроверяемыйИндекс + 1].АдресПодписи);
	Иначе
		// все подписи проверены
		ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ДополнительныеПараметры.ЗадачиСОтказомВыполнения, ДополнительныеПараметры.Параметры.ВывестиСообщениеОбОшибке);
		
		Если ДополнительныеПараметры.Параметры.ДанныеДокументов.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПослеПроверкиЭлектронныхПодписейНаКлиенте(ДополнительныеПараметры.Параметры);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеПроверкиЭлектронныхПодписейНаКлиенте(ДополнительныеПараметры)
	
	Если ДополнительныеПараметры.ТребуетсяЭП ИЛИ ДополнительныеПараметры.ТребуетсяПростаяЭП Тогда
		ПодписатьДанныеДокументов(ДополнительныеПараметры);
	Иначе
		ПродолжитьВыполнениеЗадачи(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьСхемуВФайлПослеПодключенияРасширенияРаботыСФайлами(Подключено, ГрафическаяСхема) Экспорт
	
	Если Не Подключено Тогда
		
		АдресГрафическойСхемы = ПроцессыОбработкиДокументовВызовСервера.АдресДанныхГрафическойСхемы(ГрафическаяСхема);
		
		ПолучитьФайл(АдресГрафическойСхемы, "untitled.grs");
		
	Иначе
		
		ДиалогСохраненияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		ДиалогСохраненияФайла.Фильтр = НСтр("ru = 'Графическая схема'") + " (*.grs)|*.grs";
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииДиалогаВыбораФайла", ЭтотОбъект, ГрафическаяСхема);
		ДиалогСохраненияФайла.Показать(ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗавершенииДиалогаВыбораФайла(ВыбранныеФайлы, ГрафическаяСхема) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	
	ЗаписатьГрафическуюСхемуИмяФайлаВыбрано(ПутьКФайлу, ГрафическаяСхема);
	
КонецПроцедуры

Процедура ЗаписатьГрафическуюСхемуИмяФайлаВыбрано(ПутьКФайлу, Знач ГрафическаяСхема)
	Если Не ПустаяСтрока(ПутьКФайлу) Тогда
		ГрафическаяСхема.НачатьЗапись(,ПутьКФайлу);
	КонецЕсли;
КонецПроцедуры

Процедура ПереключитьсяНаКомментарийНаправившего(Форма)
	Если НЕ Форма.Элементы.ГруппаКомментарииСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаСтраницаКомментарийНаправившего Тогда
		Форма.Элементы.ГруппаКомментарииСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаСтраницаКомментарийНаправившего;
	КонецЕсли;
КонецПроцедуры

Процедура ПереключитьсяНаКомментарийСледующему(Форма)
	Если НЕ Форма.Элементы.ГруппаКомментарииСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаСтраницаКомментарийСледующему Тогда
		Форма.Элементы.ГруппаКомментарииСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаСтраницаКомментарийСледующему;
	КонецЕсли;
КонецПроцедуры

Процедура ПродолжитьИзменениеШаблонаПослеПодтвержденияЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	Попытка
		ДополнительныеПараметры.Форма.Записать(Новый Структура);
	Исключение
		ПоказатьОповещениеПользователя(,,КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),БиблиотекаКартинок.Информация32);
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	КонецПопытки;
	
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение", ДополнительныеПараметры.Форма);
	ВыполнитьОбработкуОповещения(Оповещение, "ИзменитьШаблонПроцесса");
	
КонецПроцедуры

Процедура ВыполнитьПроверкуДанныхВМногопоточномРежиме(ПараметрыКоманды)
	Форма = ПараметрыКоманды.Форма;
	
	Задание = ПроцессыОбработкиДокументовВызовСервера.МногопоточнаПроверкаПодписанныхДанныхНаСервере(
	Форма.УникальныйИдентификатор, ПараметрыКоманды.ДанныеДокументов);
	
	ИдентификаторЗадания = Задание.ИдентификаторЗадания;
	
	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
	НастройкиОжидания.ВыводитьОкноОжидания = Истина;
    НастройкиОжидания.Заголовок = НСтр("ru='Идёт процесс проверки подписанных данных'"); 
	
	Обработчик = Новый ОписаниеОповещения("ОбработатьРезультатМногопоточнойПроверкиДанных", 
										  ПроцессыОбработкиДокументовКлиент, ПараметрыКоманды);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Задание, Обработчик, НастройкиОжидания);	
	
КонецПроцедуры	   

Процедура ОбработатьРезультатМногопоточнойПроверкиДанных(Задание, ДополнительныеПараметры) Экспорт
	ПараметрыКоманды = ДополнительныеПараметры;
    ЕстьОтрицательныеРезультатыПроверки = Ложь;
	ТекстОшибки = "";
	
	Если Задание <> Неопределено И Задание.Статус = "Выполнено" Тогда
		
		РезультатВыполнения = ПолучитьИЗВременногоХранилища(Задание.АдресРезультата); 
		//нужно проверить все потоки на ошибки
		Для Каждого ПотокЗадание Из РезультатВыполнения Цикл
			
			РезультатТекущегоПотокаяПотока = РезультатВыполнения.Получить(ПотокЗадание.Ключ);	
			Если РезультатТекущегоПотокаяПотока.Статус = "Ошибка" Тогда
				ЕстьОтрицательныеРезультатыПроверки = Истина; 
				ТекстОшибки = РезультатТекущегоПотокаяПотока.КраткоеПредставлениеОшибки; 
				
			ИначеЕсли  РезультатТекущегоПотокаяПотока.Статус = "Выполнено" Тогда
				РезультатВыполненияПотока = ПолучитьИЗВременногоХранилища(РезультатТекущегоПотокаяПотока.АдресРезультата);
				
				Если ЗначениеЗаполнено(РезультатВыполненияПотока) Тогда
					
					ЕстьОтрицательныеРезультатыПроверки = Истина;
					ТекстОшибки = ТекстОшибки + РезультатВыполненияПотока; 
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		
		ЕстьОтрицательныеРезультатыПроверки = Истина; 
		ТекстОшибки = НСтр("ru='Произошла ошибка фонового задания при проверке подписанных данных большего объема. " +
							   "Повторите попытку позже или обратитесь к Администратору'");		
	КонецЕсли;	
	
	Если ЕстьОтрицательныеРезультатыПроверки Тогда
		
		Отказ = Истина;
		ОписаниеОшибки = ТекстОшибки;
		ПараметрыКоманды.Вставить("ОписаниеОшибки", "");
		ПараметрыКоманды.Вставить("ОшибкаФоновогоЗадания", Истина);
		СтандартнаяОбработка = Истина;
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(ПараметрыКоманды, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
		Если НЕ СтандартнаяОбработка Тогда
			Возврат;
		КонецЕсли;

		ПродолжитьВыполнениеЗадач(ПараметрыКоманды, Отказ, ОписаниеОшибки); 

	Иначе		
		// если проверка прошла успешно, то не будем проверять подписанные данные при вызове сервера
		ПараметрыКоманды.ТребуетсяПроверкаПодписанныхДанных = Ложь;
		
		ВыполнитьПроцедурыСВызовомСервера(ПараметрыКоманды);
		
		Если ПараметрыКоманды.ДанныеДокументов.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		Отказ = Ложь;
		ОписаниеОшибки = "";
		СтандартнаяОбработка = Истина;
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(ПараметрыКоманды, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
		Если НЕ СтандартнаяОбработка Тогда
			Возврат;
		КонецЕсли;

		ПродолжитьВыполнениеЗадач(ПараметрыКоманды, Отказ, ОписаниеОшибки);  
	
    КонецЕсли;
	
КонецПроцедуры  

// Получает из текстового описания интервал времени в минутах.
//
// Параметры:
//  СтрокаСоВременем - Строка - текстовое описание времени, где числа записаны цифрами,
//								а единицы измерения - строкой. 
//
// Возвращаемое значение:
//  Число - интервал времени в минутах.
// 
Функция ПолучитьИнтервалВремениИзСтроки(Знач СтрокаСоВременем) Экспорт
	
	Если ПустаяСтрока(СтрокаСоВременем) Тогда
		Возврат 0;
	КонецЕсли;
	
	СтрокаСоВременем = НРег(СтрокаСоВременем);
	СтрокаСоВременем = СтрЗаменить(СтрокаСоВременем, Символы.НПП," ");
	СтрокаСоВременем = СтрЗаменить(СтрокаСоВременем, ".",",");
	СтрокаСоВременем = СтрЗаменить(СтрокаСоВременем, "+","");
	
	ПодстрокаСЦифрами = "";
	ПодстрокаСБуквами = "";
	
	ПредыдущийСимволЭтоЦифра = Ложь;
	ЕстьДробнаяЧасть = Ложь;
	
	Результат = 0;
	Для Позиция = 1 По СтрДлина(СтрокаСоВременем) Цикл
		ТекущийКодСимвола = КодСимвола(СтрокаСоВременем,Позиция);
		Символ = Сред(СтрокаСоВременем,Позиция,1);
		Если (ТекущийКодСимвола >= КодСимвола("0") И ТекущийКодСимвола <= КодСимвола("9"))
			ИЛИ (Символ="," И ПредыдущийСимволЭтоЦифра И Не ЕстьДробнаяЧасть) Тогда
			Если Не ПустаяСтрока(ПодстрокаСБуквами) Тогда
				ПодстрокаСЦифрами = СтрЗаменить(ПодстрокаСЦифрами,",",".");
				Результат = Результат + ?(ПустаяСтрока(ПодстрокаСЦифрами), 1, Число(ПодстрокаСЦифрами))
					* ЗаменитьЕдиницуИзмеренияНаМножитель(ПодстрокаСБуквами);
					
				ПодстрокаСЦифрами = "";
				ПодстрокаСБуквами = "";
				
				ПредыдущийСимволЭтоЦифра = Ложь;
				ЕстьДробнаяЧасть = Ложь;
			КонецЕсли;
			
			ПодстрокаСЦифрами = ПодстрокаСЦифрами + Сред(СтрокаСоВременем,Позиция,1);
			
			ПредыдущийСимволЭтоЦифра = Истина;
			Если Символ = "," Тогда
				ЕстьДробнаяЧасть = Истина;
			КонецЕсли;
		Иначе
			Если Символ = " " И ЗаменитьЕдиницуИзмеренияНаМножитель(ПодстрокаСБуквами) = "0" Тогда
				ПодстрокаСБуквами = "";
			КонецЕсли;
			
			ПодстрокаСБуквами = ПодстрокаСБуквами + Сред(СтрокаСоВременем,Позиция,1);
			ПредыдущийСимволЭтоЦифра = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(ПодстрокаСБуквами) Тогда
		ПодстрокаСЦифрами = СтрЗаменить(ПодстрокаСЦифрами,",",".");
		Результат = Результат + ?(ПустаяСтрока(ПодстрокаСЦифрами), 1, Число(ПодстрокаСЦифрами))
			* ЗаменитьЕдиницуИзмеренияНаМножитель(ПодстрокаСБуквами);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Анализирует слово на предмет соответствия единице времени и, если соответствие установлено,
// возвращает количество минут, содержащееся в единице времени.
//
// Параметры:
//  Единица - Строка - анализируемое слово.
//
// Возвращаемое значение:
//  Число - количество минут в Единице. Если единица не определена или пустая, то возвращается 0.
//
Функция ЗаменитьЕдиницуИзмеренияНаМножитель(Знач Единица)
	
	Результат = 0;
	Единица = НРег(Единица);
	
	ДопустимыеСимволы = НСтр("ru = 'абвгдеёжзийклмнопрстуфхцчшщъыьэюя'"); // АПК:163; АПК:1036 (см. 456:1.1) символы, которые может вводить пользователь.
	ПосторонниеСимволы = СтрСоединить(СтрРазделить(Единица, ДопустимыеСимволы, Ложь), "");
	Если ПосторонниеСимволы <> "" Тогда
		Единица = СтрСоединить(СтрРазделить(Единица, ПосторонниеСимволы, Ложь), "");
	КонецЕсли;
	
	СловоформыЧаса = СтрРазделить(НСтр("ru = 'час,ч'"), ",", Ложь);
	СловоформыМинуты = СтрРазделить(НСтр("ru = 'мин,м'"), ",", Ложь);
	
	ПервыеТриСимвола = Лев(Единица,3);
	Если СловоформыЧаса.Найти(ПервыеТриСимвола) <> Неопределено Тогда
		Результат = 60;
	ИначеЕсли СловоформыМинуты.Найти(ПервыеТриСимвола) <> Неопределено Тогда
		Результат = 1;
	КонецЕсли;
	
	Возврат Формат(Результат,"ЧН=0; ЧГ=0");
	
КонецФункции

#Область ЭлектроннаяПодпись

// См. ЭлектроннаяПодписьКлиент.Подписать
Процедура Подписать(ОписаниеДанных, Форма = Неопределено, ОбработкаРезультата = Неопределено) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ПроцессыОбработкиДокументовКлиентПереопределяемый.Подписать(ОписаниеДанных, Форма, ОбработкаРезультата, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		МодульЭлектроннаяПодписьКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЭлектроннаяПодписьКлиент");
		
