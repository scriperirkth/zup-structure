// Отмечает указанные задачи как не выполненные из-за ошибки, записывает описание ошибки.
//
// Параметры:
//  ЗадачиСОшибками - Массив - коллекция, где каждый элемент - Структура с полями:
//     * Задача - ЗадачаСсылка.ЗадачаПоОбработкеДокумента - ссылка на задачу, которую не удалось выполнить
//     * ОписаниеОшибки - Строка - описание ошибки при попытке выполнить задачу
//
Процедура ОтметитьНеУспешнуюПопыткуВыполненияЗадач(Знач ЗадачиСОшибками, СообщитьПользователю = Ложь, Комментарий = Неопределено) Экспорт
	
	Если ЗадачиСОшибками.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПроцессыОбработкиДокументовВызовСервера.ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ЗадачиСОшибками, Комментарий);
	
	ПоказатьОповещениеОНеуспешномВыполненииЗадач(ЗадачиСОшибками, СообщитьПользователю);
	
	Оповестить("Запись_ЗадачаПоОбработкеДокумента");
	
КонецПроцедуры

// Показывает форму с описанием ошибок, из-за которых не были выполнены задачи
//
// Параметры:
//  МассивЗадач - Массив - массив ссылок на задачи.
//
Процедура ПоказатьИнформациюОбОшибках(Знач МассивЗадач) Экспорт
	
	НовыйМассивЗадач = Новый Массив;
	
	Для Каждого Задача Из МассивЗадач Цикл
		Если ТипЗнч(Задача) = Тип("Структура") Тогда
			НовыйМассивЗадач.Добавить(Задача.Задача);
		ИначеЕсли ТипЗнч(Задача) <> Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			НовыйМассивЗадач.Добавить(Задача);
		КонецЕсли;
	КонецЦикла;
	
	Если НовыйМассивЗадач.Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Команда не может быть выполнена для указанного объекта.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Задачи", НовыйМассивЗадач);
	ОткрытьФорму("Задача.ЗадачаПоОбработкеДокумента.Форма.Ошибки", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

// Снимает признак выполняемости задач, а также задач с тем же идентификатором пачки,
// и отменяет активные фоновые задания по выполнению указанных задач
//
// Параметры:
//  МассивЗадач - Массив - массив ссылок на задачи.
//
Процедура ПрерватьПроцессВыполненияЗадач(Знач МассивЗадач) Экспорт
	
	ЗадачиСОтказом = Новый Массив;
	
	ПроцессыОбработкиДокументовВызовСервера.ПрерватьПроцессВыполненияЗадач(МассивЗадач, ЗадачиСОтказом);
	
	Для Каждого ЗадачаСОтказом Из ЗадачиСОтказом Цикл
		ТекстСообщения = НСтр("ru = 'Выполнение задачи ""'")
							+ Строка(ЗадачаСОтказом.Задача)
							+ НСтр("ru = '"" не может прервано по причине: '")
							+ ЗадачаСОтказом.ПричинаОтказа;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;
	
	Если МассивЗадач.Количество() = 0 Тогда
		Если ЗадачиСОтказом.Количество() = 0 Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Команда не может быть выполнена для указанного объекта.'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Для Каждого Задача Из МассивЗадач Цикл
		Если ТипЗнч(Задача) <> Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Оповестить("Запись_ЗадачаПоОбработкеДокумента");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Обработчик выполнения задачи по обработке документа.
//
// Параметры:
//   Форма - УправляемаяФорма - форма, из которой выполняется задача.
//   Команда - КомандаФормы - выполняемая команда.
//   Источник - ДанныеФормыСтруктура - объект с полем "Ссылка".
//
Процедура ВыполнитьЗадачу(Форма, Команда, Знач Источник) Экспорт

	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередНачаломВыполненияЗадачи(Форма, Команда, Источник, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;	
	
	Если Команда.Имя = "ПринятьКИсполнениюПроцессыОбработкиДокументов" Тогда
		Оповещение = Новый ОписаниеОповещения("Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение", Форма);
		ВыполнитьОбработкуОповещения(Оповещение, "ПринятьКИсполнениюПроцессыОбработкиДокументов");
		Оповестить("Запись_ЗадачаПоОбработкеДокумента");
		Если НЕ ПустаяСтрока(Форма.ПроцессыОбработкиДокументов_ТекстПредупреждения) Тогда
			ПоказатьПредупреждение(,Форма.ПроцессыОбработкиДокументов_ТекстПредупреждения);
		КонецЕсли;
		Возврат;
	ИначеЕсли Команда.Имя = "КомментарийСледующему" Тогда
		Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя = Истина;
		Возврат;
	ИначеЕсли Команда.Имя = "КарточкаПроцессаДокумента" Тогда
		ПараметрыФормы = Новый Структура("ЗначениеОтбора, ОткрытиеВОтдельномОкне", Источник.Ссылка, Истина);
		ОткрытьКарточкуПроцессаДокумента(ПараметрыФормы, Форма, Форма.КлючУникальности);
		Возврат;
	ИначеЕсли Команда.Имя = "ПоказатьКомментарийНаправившего" Тогда
		ПереключитьсяНаКомментарийНаправившего(Форма);
		Возврат;
	ИначеЕсли Команда.Имя = "ПоказатьКомментарийСледующему" Тогда
		ПереключитьсяНаКомментарийСледующему(Форма);
		Возврат;
	ИначеЕсли Команда.Имя = "ДекорацияПодходящийШаблон" Тогда
		Если Форма.Модифицированность Тогда
			Обработчик = Новый ОписаниеОповещения(
				"ПродолжитьИзменениеШаблонаПослеПодтвержденияЗаписи", ЭтотОбъект, Новый Структура("Форма", Форма));
			ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после записи данных.
				|Данные будут записаны.'");
			ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Иначе
			Оповещение = Новый ОписаниеОповещения("Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение", Форма);
			ВыполнитьОбработкуОповещения(Оповещение, "ИзменитьШаблонПроцесса");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Ссылка = Источник.Ссылка;
	Объект = Источник;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Форма", Форма);
	ПараметрыКоманды.Вставить("Объект", Объект);
	ПараметрыКоманды.Вставить("УникальныйИдентификатор", Форма.УникальныйИдентификатор);
	ПараметрыКоманды.Вставить("Комментарий", Форма.ПроцессыОбработкиДокументов_КомментарийСледующему);
	ПараметрыКоманды.Вставить("ДополнительныйКонтекст", Неопределено);
	ПараметрыКоманды.Вставить("ТребуетсяВызовСервера", Ложь);
	ПараметрыКоманды.Вставить("ДанныеДляПодписи", Неопределено);
	ПараметрыКоманды.Вставить("ВывестиСообщениеОбОшибке", Истина);
	
	КомандыФормы = Форма.ПроцессыОбработкиДокументов_ТаблицаКоманд.НайтиСтроки(Новый Структура("ИмяКоманды", Команда.Имя));
	Если КомандыФормы.Количество() = 0 Тогда
		ИнформацияДляЖурнала = НСтр("ru='Количество строк таблицы ""ПроцессыОбработкиДокументов_ТаблицаКоманд"": '")
			+ Форма.ПроцессыОбработкиДокументов_ТаблицаКоманд.Количество();
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Процессы обработки документов.Выполнение этапа процесса'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
			"Ошибка", ИнформацияДляЖурнала, , Истина);
		Если Ссылка.Пустая() ИЛИ Форма.Модифицированность Тогда
			ТекстСообщения = НСтр("ru='Не удалось выполнить команду.
				|Сохраните документ, перечитайте данные либо переоткройте форму заново и попробуйте выполнить команду еще раз.'");
		Иначе
			Форма.Прочитать();
			ТекстСообщения = НСтр("ru='Не удалось выполнить команду.
				|Данные перечитаны, попробуйте выполнить команду еще раз.'");
			ТекстПодсказки = Новый ФорматированнаяСтрока(
				НСтр("ru='(при многократном повторении ошибки переоткройте форму документа)'"), Новый Шрифт(,,,Истина));
			ТекстСообщения = Новый ФорматированнаяСтрока(ТекстСообщения, Символы.ПС, Символы.ПС, ТекстПодсказки);
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстСообщения, 60);
		Возврат;
	ИначеЕсли НЕ Ссылка.Пустая() И НЕ Форма.Модифицированность
		И Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре <> Форма.ПроцессыОбработкиДокументов_ТекущийШаблон Тогда
		// Отображаемый шаблон не соответствует сохраненному, требуется переинициализация формы
		Форма.Прочитать();
		ТекстСообщения = НСтр("ru='Не удалось выполнить команду.
			|Данные перечитаны, попробуйте выполнить команду еще раз.'");
		ПоказатьПредупреждение(, ТекстСообщения, 60);
		Возврат;
	КонецЕсли;
	
	КомандаФормы = КомандыФормы[0];
	
	ПараметрыКоманды.Вставить("Статус", КомандаФормы.Статус);
	ПараметрыКоманды.Вставить("Отрицательная", КомандаФормы.Отрицательная);
	ПараметрыКоманды.Вставить("ТребуетсяПростаяЭП", КомандаФормы.ТребуетсяПростаяЭП);
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
		ПараметрыКоманды.Вставить("ТребуетсяЭП", КомандаФормы.ТребуетсяЭП);
	Иначе
		ПараметрыКоманды.Вставить("ТребуетсяЭП", Ложь);
	КонецЕсли;
	
	ПараметрыКоманды.Вставить("ТребуетсяПроверкаПредыдущихЭП",
		Форма.ПроцессыОбработкиДокументов_ПроверятьИмеющиесяЭППриОчередномПодписании
			И (ПараметрыКоманды.ТребуетсяЭП ИЛИ ПараметрыКоманды.ТребуетсяПростаяЭП));
	ПараметрыКоманды.Вставить("ТребуетсяПроверкаПодписанныхДанных",
		Форма.ПроцессыОбработкиДокументов_ПроверятьПодписанныеДанныеПриОчередномПодписании
			И (ПараметрыКоманды.ТребуетсяЭП ИЛИ ПараметрыКоманды.ТребуетсяПростаяЭП));
	ПараметрыКоманды.Вставить("ТребуетсяПроверкаНаличияКлючаПЭПВРеестре",
		Форма.ПроцессыОбработкиДокументов_ПроверятьНаличиеКлючаПЭПВРеестре И ПараметрыКоманды.ТребуетсяПростаяЭП);
	ПараметрыКоманды.Вставить("ИспользуетсяМногопоточнаяПроверка", Форма.ПроцессыОбработкиДокументов_ИспользоватьМногопоточнуюПроверку);
		
	Если ПараметрыКоманды.Отрицательная
		И НЕ ЗначениеЗаполнено(Форма.ПроцессыОбработкиДокументов_КомментарийСледующему)
		И НЕ Форма.ПроцессыОбработкиДокументов_НеЗаполнятьКомментарийПриОтрицательномРезультате Тогда
		ТекстСообщения = НСтр("ru='Для выполнения выбранного действия необходимо заполнить комментарий.'");
		ПереключитьсяНаКомментарийСледующему(Форма);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Ссылка, "ПроцессыОбработкиДокументов_КомментарийСледующему");
		Возврат;
	КонецЕсли;
	
	Если Ссылка.Пустая() ИЛИ Форма.ПроцессыОбработкиДокументов_ТекущийШаблон <> Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре Тогда
		ИдентификаторПачки = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	Иначе
		Если Форма.ПроцессыОбработкиДокументов_ТекущаяЗадача.Пустая() Тогда
			Форма.ПроцессыОбработкиДокументов_ТекущаяЗадача = ПроцессыОбработкиДокументовВызовСервера.ЗадачаНовогоДокумента(
				Форма.ПроцессыОбработкиДокументов_ТекущийШаблон, Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа, Ссылка);
		КонецЕсли;
		ИдентификаторПачки = ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиКакВыполняемые(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Форма.ПроцессыОбработкиДокументов_ТекущаяЗадача));
	КонецЕсли;
	
	ПараметрыКоманды.Вставить("ИдентификаторПачки", ИдентификаторПачки);
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("Задача", Форма.ПроцессыОбработкиДокументов_ТекущаяЗадача);
	ДанныеДокумента.Вставить("Документ", Ссылка);
	ДанныеДокумента.Вставить("Шаблон", Форма.ПроцессыОбработкиДокументов_ТекущийШаблон);
	ДанныеДокумента.Вставить("ИдентификаторЭтапа", Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа);
	ДанныеДокумента.Вставить("ТребуетсяПроверкаЗаполненностиРеквизитов",
		Форма.ПроцессыОбработкиДокументов_ТребуетсяПроверкаЗаполненностиРеквизитов);
	ДанныеДокумента.Вставить("ТребуетсяПроверкаЗаполненностиРеквизитовПервичныхДокументов",
		Форма.ПроцессыОбработкиДокументов_ТребуетсяПроверкаЗаполненностиРеквизитовПД);
	ДанныеДокумента.Вставить("НаличиеФайловОбязательно", КомандаФормы.НаличиеФайловОбязательно);
	ДанныеДокумента.Вставить("РасшифровкаОбязательныхПрисоединенныхФайлов", КомандаФормы.РасшифровкаОбязательныхПрисоединенныхФайлов);

	ДанныеДокумента.Вставить("ПодписыватьФайлыЭП", КомандаФормы.ПодписыватьФайлыЭП);
	ДанныеДокумента.Вставить("ОбособленнаяЗонаОтветственности", КомандаФормы.ОбособленнаяЗонаОтветственности);
	ДанныеДокумента.Вставить("ОбработчикДоТранзакции", КомандаФормы.ОбработчикДоТранзакции);
	ДанныеДокумента.Вставить("УсловиеВыполнения", КомандаФормы.УсловиеВыполнения);
	Если ДанныеДокумента.ТребуетсяПроверкаЗаполненностиРеквизитов И НЕ ПараметрыКоманды.Отрицательная
		ИЛИ ДанныеДокумента.ТребуетсяПроверкаЗаполненностиРеквизитовПервичныхДокументов И НЕ ПараметрыКоманды.Отрицательная
		ИЛИ ДанныеДокумента.НаличиеФайловОбязательно И НЕ ПараметрыКоманды.Отрицательная
		ИЛИ НЕ ПустаяСтрока(ДанныеДокумента.ОбработчикДоТранзакции)
		ИЛИ НЕ ПустаяСтрока(ДанныеДокумента.УсловиеВыполнения)
		ИЛИ ПараметрыКоманды.ТребуетсяЭП
		ИЛИ ПараметрыКоманды.ТребуетсяПростаяЭП Тогда
		ПараметрыКоманды.ТребуетсяВызовСервера = Истина;
	КонецЕсли;
	ДанныеДокумента.Вставить("ОбработчикКлиентский", КомандаФормы.ОбработчикКлиентский);
	ДанныеДокумента.Вставить("ВыполненныеОбработчики", Новый Массив);
	Если НЕ ПустаяСтрока(ДанныеДокумента.ОбработчикКлиентский) Тогда
		ДанныеДокумента.Вставить("ОбработчикиВыполнены", Ложь);
	Иначе
		ДанныеДокумента.Вставить("ОбработчикиВыполнены", Истина);
	КонецЕсли;
	ДанныеДокумента.Вставить("ДополнительныеПараметры", Неопределено);
	ДанныеДокументов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеДокумента);
	ПараметрыКоманды.Вставить("ДанныеДокументов", ДанныеДокументов);
	
	Если КомандаФормы.ПризнакПроведенности = Истина
		И (Форма.Модифицированность ИЛИ НЕ Источник.Проведен) Тогда
		ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после проведения документа.
							|Документ будет проведен.'");
		Обработчик = Новый ОписаниеОповещения("ПродолжитьВыполнениеКомандыПослеПодтвержденияПроведения", ЭтотОбъект, ПараметрыКоманды);
		ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	Если КомандаФормы.ПризнакПроведенности = Ложь
		И Источник.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после отмены проведения документа.
							|Проведение документа будет отменено.'");
		Обработчик = Новый ОписаниеОповещения("ПродолжитьВыполнениеКомандыПослеПодтвержденияОтменыПроведения", ЭтотОбъект, ПараметрыКоманды);
		ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	Если Ссылка.Пустая() ИЛИ Форма.Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после записи данных.
							|Данные будут записаны.'");
		Обработчик = Новый ОписаниеОповещения("ПродолжитьВыполнениеКомандыПослеПодтвержденияЗаписи", ЭтотОбъект, ПараметрыКоманды);
		ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыКоманды.ТребуетсяЭП ИЛИ ПараметрыКоманды.ТребуетсяПростаяЭП Тогда
		ОписаниеОшибки = "";
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДокументов(ПараметрыКоманды.ДанныеДокументов, ОписаниеОшибки);
		Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
			ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ИдентификаторПачки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыКоманды.ТребуетсяВызовСервера Тогда
		Если ПараметрыКоманды.ИспользуетсяМногопоточнаяПроверка Тогда
			Результат = ПроцессыОбработкиДокументовВызовСервера.СуществуютЭлектронныеПодписииПредыдущихЭтапов(ПараметрыКоманды.ДанныеДокументов);
			Если Результат Тогда
				ВыполнитьПроверкуДанныхВМногопоточномРежиме(ПараметрыКоманды); 
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ВыполнитьПроцедурыСВызовомСервера(ПараметрыКоманды);
	КонецЕсли;
	
	Если ПараметрыКоманды.ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(ПараметрыКоманды, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВыполнениеЗадач(ПараметрыКоманды, Отказ, ОписаниеОшибки);
	
КонецПроцедуры

// Обработчик выполнения задач по обработке документов.
//
// Параметры:
//   Форма - УправляемаяФорма - форма, из которой выполняется задача.
//   Команда - КомандаФормы - выполняемая команда.
//   Источник - ТаблицаФормы - список формы.
//
Процедура ВыполнитьЗадачи(Форма, Команда, Список) Экспорт
	
	ИдентификаторПачки = ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиКакВыполняемые(
							ОбщегоНазначенияКлиент.СкопироватьРекурсивно(Список.ВыделенныеСтроки));
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Форма", Форма);
	ПараметрыКоманды.Вставить("УникальныйИдентификатор", Форма.УникальныйИдентификатор);
	ПараметрыКоманды.Вставить("ИдентификаторПачки", ИдентификаторПачки);
	ПараметрыКоманды.Вставить("НеЗаполнятьКомментарийПриОтрицательномРезультате",
		Форма.НеЗаполнятьКомментарийПриОтрицательномРезультате);
	ПараметрыКоманды.Вставить("Комментарий", Неопределено);
	ПараметрыКоманды.Вставить("ДополнительныйКонтекст", Неопределено);
	ПараметрыКоманды.Вставить("ДанныеДляПодписи", Неопределено);
	
	КомандаФормы = Форма.ТаблицаКоманд.НайтиСтроки(Новый Структура("ИмяКоманды", Команда.Имя))[0];
	
	ПараметрыКоманды.Вставить("Статус", КомандаФормы.Статус);
	ПараметрыКоманды.Вставить("Отрицательная", КомандаФормы.Отрицательная);
	ПараметрыКоманды.Вставить("ТребуетсяПростаяЭП", КомандаФормы.ТребуетсяПростаяЭП);
	ПараметрыКоманды.Вставить("ИспользуетсяМногопоточнаяПроверка", Форма.ИспользоватьМногопоточнуюПроверку);
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
		ПараметрыКоманды.Вставить("ТребуетсяЭП", КомандаФормы.ТребуетсяЭП);
	Иначе
		ПараметрыКоманды.Вставить("ТребуетсяЭП", Ложь);
	КонецЕсли;
	
	ПараметрыКоманды.Вставить("ТребуетсяПроверкаПредыдущихЭП",
		Форма.ПроверятьИмеющиесяЭППриОчередномПодписании
		И (ПараметрыКоманды.ТребуетсяЭП ИЛИ ПараметрыКоманды.ТребуетсяПростаяЭП));
	ПараметрыКоманды.Вставить("ТребуетсяПроверкаПодписанныхДанных",
		Форма.ПроверятьПодписанныеДанныеПриОчередномПодписании
		И (ПараметрыКоманды.ТребуетсяЭП ИЛИ ПараметрыКоманды.ТребуетсяПростаяЭП));
	ПараметрыКоманды.Вставить("ТребуетсяПроверкаНаличияКлючаПЭПВРеестре",
		Форма.ПроверятьНаличиеКлючаПЭПВРеестре И ПараметрыКоманды.ТребуетсяПростаяЭП);
	ПараметрыКоманды.Вставить("ТребуетсяВызовСервера",
		ПараметрыКоманды.ТребуетсяЭП ИЛИ ПараметрыКоманды.ТребуетсяПростаяЭП);
	
	ДокументыКоторыеДолжныБытьПроведены = Новый Массив;
	ДокументыКоторыеДолжныБытьНеПроведены = Новый Массив;
	
	ДанныеДокументов = Новый Массив;
	Для Каждого Задача Из Список.ВыделенныеСтроки Цикл
		
		Если ТипЗнч(Задача) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеЗадачи = Список.ДанныеСтроки(Задача);
		
		Если КомандаФормы.Этап <> ДанныеЗадачи.Этап Тогда
			
			ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ИдентификаторПачки);
			
			ПоказатьПредупреждение(,НСтр("ru = 'Команда не может быть выполнена для указанного объекта.'"));
			
			Возврат;
			
		КонецЕсли;
		
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Задача", ДанныеЗадачи.Ссылка);
		ДанныеДокумента.Вставить("Документ", ДанныеЗадачи.Предмет);
		ДанныеДокумента.Вставить("Шаблон", ДанныеЗадачи.Шаблон);
		ДанныеДокумента.Вставить("ИдентификаторЭтапа", ДанныеЗадачи.ИдентификаторЭтапа);
		ДанныеДокумента.Вставить("РезультатВыполнения", ДанныеЗадачи.РезультатВыполнения);
		ДанныеДокумента.Вставить("ПризнакПроведенности", Неопределено);
		ДанныеДокумента.Вставить("ТребуетсяПроверкаЗаполненностиРеквизитов", Ложь);
		ДанныеДокумента.Вставить("ТребуетсяПроверкаЗаполненностиРеквизитовПервичныхДокументов", Ложь);
		ДанныеДокумента.Вставить("УсловиеВыполнения", "");
		ДанныеДокумента.Вставить("НаличиеФайловОбязательно", Ложь);
		ДанныеДокумента.Вставить("ПодписыватьФайлыЭП", Ложь);
		ДанныеДокумента.Вставить("ОбособленнаяЗонаОтветственности", Ложь);
		ДанныеДокумента.Вставить("ОбработчикДоТранзакции", "");
		ДанныеДокумента.Вставить("ОбработчикКлиентский", "");
		ДанныеДокумента.Вставить("ОбработчикиВыполнены", Истина);
		ДанныеДокумента.Вставить("ВыполненныеОбработчики", Новый Массив);
		ДанныеДокумента.Вставить("ДополнительныеПараметры", Неопределено);
		
		Для Каждого ДополнительныйОбработчик Из Форма.ОбработчикиЗадач Цикл
			Если ДополнительныйОбработчик.Шаблон = ДанныеЗадачи.Шаблон
				И ДополнительныйОбработчик.ИдентификаторЭтапа = ДанныеЗадачи.ИдентификаторЭтапа
				И ДополнительныйОбработчик.Статус = ПараметрыКоманды.Статус Тогда
				
				Если НЕ ПустаяСтрока(ДополнительныйОбработчик.ОбработчикДоТранзакции) Тогда
					ДанныеДокумента.Вставить("ОбработчикДоТранзакции", ДополнительныйОбработчик.ОбработчикДоТранзакции);
					ПараметрыКоманды.ТребуетсяВызовСервера = Истина;
				КонецЕсли;
				
				Если НЕ ПустаяСтрока(ДополнительныйОбработчик.ОбработчикКлиентский) Тогда
					ДанныеДокумента.Вставить("ОбработчикКлиентский", ДополнительныйОбработчик.ОбработчикКлиентский);
					ДанныеДокумента.Вставить("ОбработчикиВыполнены", Ложь);
				КонецЕсли;
				
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ДополнительныйОбработчик Из Форма.ЭтапыСПроверкойЗаполненностиРеквизитов Цикл
			Если ДополнительныйОбработчик.Шаблон = ДанныеЗадачи.Шаблон
				И ДополнительныйОбработчик.ИдентификаторЭтапа = ДанныеЗадачи.ИдентификаторЭтапа
				И НЕ ПараметрыКоманды.Отрицательная Тогда
				ДанныеДокумента.Вставить("ТребуетсяПроверкаЗаполненностиРеквизитов", Истина);
				ПараметрыКоманды.ТребуетсяВызовСервера = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ДополнительныйОбработчик Из Форма.ЭтапыСПроверкойЗаполненностиРеквизитовПД Цикл
			Если ДополнительныйОбработчик.Шаблон = ДанныеЗадачи.Шаблон
				И ДополнительныйОбработчик.ИдентификаторЭтапа = ДанныеЗадачи.ИдентификаторЭтапа
				И НЕ ПараметрыКоманды.Отрицательная Тогда
				ДанныеДокумента.Вставить("ТребуетсяПроверкаЗаполненностиРеквизитовПервичныхДокументов", Истина);
				ПараметрыКоманды.ТребуетсяВызовСервера = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТребованиеКПроведению Из Форма.ТребованияКПроведению Цикл
			Если ТребованиеКПроведению.Шаблон = ДанныеЗадачи.Шаблон
				И ТребованиеКПроведению.ИдентификаторЭтапа = ДанныеЗадачи.ИдентификаторЭтапа
				И ТребованиеКПроведению.Статус = ПараметрыКоманды.Статус Тогда
				ДанныеДокумента.Вставить("ПризнакПроведенности", ТребованиеКПроведению.ПризнакПроведенности);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТребованиеКВыполнению Из Форма.ТребованияКВыполнению Цикл
			Если ТребованиеКВыполнению.Шаблон = ДанныеЗадачи.Шаблон
				И ТребованиеКВыполнению.ИдентификаторЭтапа = ДанныеЗадачи.ИдентификаторЭтапа
				И ТребованиеКВыполнению.Статус = ПараметрыКоманды.Статус Тогда
				ДанныеДокумента.Вставить("УсловиеВыполнения", ТребованиеКВыполнению.УсловиеВыполнения);
				ПараметрыКоманды.ТребуетсяВызовСервера = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СвойстваЭтапов Из Форма.СвойстваЭтаповШаблонов Цикл
			Если СвойстваЭтапов.Шаблон = ДанныеЗадачи.Шаблон
				И СвойстваЭтапов.ИдентификаторЭтапа = ДанныеЗадачи.ИдентификаторЭтапа
				И НЕ ПараметрыКоманды.Отрицательная Тогда
				
				ДанныеДокумента.Вставить("НаличиеФайловОбязательно", СвойстваЭтапов.НаличиеФайловОбязательно);
				ДанныеДокумента.Вставить("РасшифровкаОбязательныхПрисоединенныхФайлов", СвойстваЭтапов.РасшифровкаОбязательныхПрисоединенныхФайлов);
				ДанныеДокумента.Вставить("ПодписыватьФайлыЭП", СвойстваЭтапов.ПодписыватьФайлыЭП);
				ДанныеДокумента.Вставить("ОбособленнаяЗонаОтветственности", СвойстваЭтапов.ОбособленнаяЗонаОтветственности);
				
				Если СвойстваЭтапов.НаличиеФайловОбязательно Тогда
					ПараметрыКоманды.ТребуетсяВызовСервера = Истина;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		ДанныеДокументов.Добавить(ДанныеДокумента);
		
		Если ДанныеДокумента.ПризнакПроведенности = Истина Тогда
			ДокументыКоторыеДолжныБытьПроведены.Добавить(ДанныеЗадачи.Предмет);
		ИначеЕсли ДанныеДокумента.ПризнакПроведенности = Ложь Тогда
			ДокументыКоторыеДолжныБытьНеПроведены.Добавить(ДанныеЗадачи.Предмет);
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыКоманды.Вставить("ДанныеДокументов", ДанныеДокументов);
	ПараметрыКоманды.Вставить("ВывестиСообщениеОбОшибке", ДанныеДокументов.Количество() = 1);
	ПараметрыКоманды.Вставить("КомментарийПоУмолчанию", ?(ДанныеДокументов.Количество() = 1, ДанныеДокументов[0].РезультатВыполнения, ""));
	
	Если ДокументыКоторыеДолжныБытьПроведены.Количество() > 0 Тогда
		МассивНепроведенных = ОбщегоНазначенияВызовСервера.ПроверитьПроведенностьДокументов(ДокументыКоторыеДолжныБытьПроведены);
		Если МассивНепроведенных.Количество() > 0 Тогда
			
			ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после проведения документов:'");
			Для Каждого Документ Из МассивНепроведенных Цикл
				ТекстВопроса = ТекстВопроса + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
				|%1'"), Документ);
			КонецЦикла;
			ТекстВопроса = ТекстВопроса + НСтр("ru = '
										|Документы будут проведены.'");
			
			ПараметрыКоманды.Вставить("МассивДокументовДляПроведения", МассивНепроведенных);
			// Сразу в обработчик передадим массив документов, которые должны быть не проведены
			ПараметрыКоманды.Вставить("ДокументыКоторыеДолжныБытьНеПроведены", ДокументыКоторыеДолжныБытьНеПроведены);
			Обработчик = Новый ОписаниеОповещения("ПродолжитьВыполнениеКомандыПослеПодтвержденияПроведенияДокументов", ЭтотОбъект, ПараметрыКоманды);
			ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
			
			Возврат;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ДокументыКоторыеДолжныБытьНеПроведены.Количество() > 0 Тогда
		МассивПроведенных = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
			ДокументыКоторыеДолжныБытьНеПроведены, ОбщегоНазначенияВызовСервера.ПроверитьПроведенностьДокументов(ДокументыКоторыеДолжныБытьНеПроведены));
		Если МассивПроведенных.Количество() > 0 Тогда
			
			ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после отмены проведения документов:'");
			Для Каждого Документ Из МассивПроведенных Цикл
				ТекстВопроса = ТекстВопроса + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
				|%1'"), Документ);
			КонецЦикла;
			ТекстВопроса = ТекстВопроса + НСтр("ru = '
										|Будет отменено проведение документов.'");
			
			ПараметрыКоманды.Вставить("МассивДокументовДляОтменыПроведения", МассивПроведенных);
			Обработчик = Новый ОписаниеОповещения("ПродолжитьВыполнениеКомандыПослеПодтвержденияОтменыПроведенияДокументов", ЭтотОбъект, ПараметрыКоманды);
			ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
			
			Возврат;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыКоманды.Отрицательная И НЕ ПараметрыКоманды.НеЗаполнятьКомментарийПриОтрицательномРезультате Тогда
		// Вывод окна с вводом комментария для отрицательного результата выполнения
		Подсказка = НСтр("ru = 'Заполните комментарий (причину)'");
		Оповещение = Новый ОписаниеОповещения("ПродолжитьПослеВводаКомментария", ЭтотОбъект, ПараметрыКоманды);
		ПоказатьВводСтроки(Оповещение, ПараметрыКоманды.КомментарийПоУмолчанию, Подсказка, 0, Истина);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыКоманды.ТребуетсяЭП ИЛИ ПараметрыКоманды.ТребуетсяПростаяЭП Тогда
		ОписаниеОшибки = "";
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДокументов(ПараметрыКоманды.ДанныеДокументов, ОписаниеОшибки);
		Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
			ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ИдентификаторПачки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыКоманды.ТребуетсяВызовСервера Тогда 
		Если ПараметрыКоманды.ИспользуетсяМногопоточнаяПроверка Тогда
			Результат = ПроцессыОбработкиДокументовВызовСервера.СуществуютЭлектронныеПодписииПредыдущихЭтапов(ПараметрыКоманды.ДанныеДокументов);
			Если Результат Тогда
				ВыполнитьПроверкуДанныхВМногопоточномРежиме(ПараметрыКоманды); 
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ВыполнитьПроцедурыСВызовомСервера(ПараметрыКоманды);
	КонецЕсли;
	
	Если ПараметрыКоманды.ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(ПараметрыКоманды, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВыполнениеЗадач(ПараметрыКоманды, Отказ, ОписаниеОшибки);
	
КонецПроцедуры

// Процедура выгрузки графической схемы в файл
Процедура ВыгрузитьСхемуВФайл(ГрафическаяСхема) Экспорт
	
	НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения(
		"ВыгрузитьСхемуВФайлПослеПодключенияРасширенияРаботыСФайлами", ЭтотОбъект, ГрафическаяСхема));
	
КонецПроцедуры

// Процедура перехода (открытия связанного элемента)
// по гиперссылке схемы
Процедура ОткрытьГиперссылкуЭлементаСхемы(ЭлементСхемы, ГиперссылкиЭлементовСхемы) Экспорт
	
	Если ТипЗнч(ЭлементСхемы) <> Тип("ЭлементГрафическойСхемыДекорация") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ГиперссылкиЭлементовСхемы) = Тип("Структура")
		И ГиперссылкиЭлементовСхемы.Свойство(ЭлементСхемы.Имя) Тогда
		
		Гиперссылка = ГиперссылкиЭлементовСхемы[ЭлементСхемы.Имя];
		Если ЗначениеЗаполнено(Гиперссылка) Тогда
			ПоказатьЗначение(,Гиперссылка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеДополнительныхОбработчиков() Экспорт
	
	МассивОбработчиков = Новый Массив;
	
	ПроцессыОбработкиДокументовКлиентОбработчикиПереопределяемый.ОписаниеДополнительныхОбработчиков(МассивОбработчиков);
	
	СвернутыйМассив = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивОбработчиков);
	Если МассивОбработчиков.Количество() > СвернутыйМассив.Количество() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Обнаружено дублирование идентификаторов дополнительных клиентских обработчиков. Список обработчиков будет недоступен.'"));
		МассивОбработчиков.Очистить();
	КонецЕсли;
	
	Возврат МассивОбработчиков;
	
КонецФункции

Процедура ПоказатьТекстовыйДокумент(Результат, Параметры) Экспорт
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Параметры.Текст);
	ТекстовыйДокумент.ТолькоПросмотр = Истина;
	ТекстовыйДокумент.Показать(Параметры.Заголовок);
	
КонецПроцедуры

Процедура ПоказатьТабличныйДокумент(Результат, Параметры) Экспорт
	
	ТабличныйДокумент = ПроцессыОбработкиДокументовВызовСервера.ТабличныйДокументПоДвоичнымДанным(Параметры.Данные);
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьГруппировки = Ложь;
	ТабличныйДокумент.Показать(Параметры.Заголовок);
	
КонецПроцедуры

Процедура ПоказатьДокументPDF(Результат, Параметры) Экспорт
	
	ФайловаяСистемаКлиент.ОткрытьФайл(Параметры.Данные, , "pdf");
	
КонецПроцедуры

// Открывает форму выбора исполнителя.
//
// Параметры:
//  ЭлементИсполнитель     - ЭлементФормы - элемент формы, в которой выполняется выбора исполнителя,
//                           который будет указан как владелец формы выбора исполнителя.
//  РеквизитИсполнитель    - СправочникСсылка.Пользователи, СправочникСсылка.РолиИсполнителя
//                         - выбранное ранее значение исполнителя. Используется
//                           для установки текущей строки в форме выбора исполнителя.
//  ТолькоРоли             - Булево - Если Истина, то указывает что для выбора нужно
//                           использовать только роли (без пользователей).
//  ОткрытиеИзФормыШаблона - Булево - признак доступности выбора ролей, предусмотренных для шаблона процесса.
//  Заголовок              - Строка - Заголовок формы выбора, если не заполнено то используется "Выбор исполнителя этапа"
//  ИдентификаторДокумента - Идентификатор документа, для которого выполняется выбор исполнителя.
//  ПараметрыВыбораИсполнителя - Структра - параметры выбора исполнителя.
//
Процедура ВыбратьИсполнителя(ЭлементИсполнитель, РеквизитИсполнитель, ТолькоРоли = Ложь, ОткрытиеИзФормыШаблона = Ложь,
	Заголовок = "", ИдентификаторДокумента = Неопределено, ПараметрыВыбораИсполнителя = Неопределено) Экспорт
	
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриВыбореИсполнителя(ЭлементИсполнитель, РеквизитИсполнитель, ТолькоРоли,
		ОткрытиеИзФормыШаблона, Заголовок, ИдентификаторДокумента, СтандартнаяОбработка, ПараметрыВыбораИсполнителя);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Исполнитель", 					РеквизитИсполнитель);
	ПараметрыФормы.Вставить("ТолькоРоли", 					ТолькоРоли);
	ПараметрыФормы.Вставить("ОткрытиеИзФормыШаблона", 		ОткрытиеИзФормыШаблона);
	ПараметрыФормы.Вставить("Заголовок", 					Заголовок);
	ПараметрыФормы.Вставить("ИдентификаторДокумента", 		ИдентификаторДокумента);
	ПараметрыФормы.Вставить("ПараметрыВыбораИсполнителя", 	ПараметрыВыбораИсполнителя);
	
	ОткрытьФорму("ОбщаяФорма.ВыборИсполнителяЭтапа", ПараметрыФормы, ЭлементИсполнитель);
	
КонецПроцедуры

// Открывает для выбора справочник "Идентификаторы объектов метаданных" с установленным отбором "В списке".
// Вызывается из процедуры "ПриНачалеВыбораЗначения".
//
// Параметры:
//	Элемент - стандартный параметр обработчика события "ПриНачалеВыбораЗначения".
//	ДанныеВыбора - стандартный параметр обработчика события "ПриНачалеВыбораЗначения".
//	СтандартнаяОбработка - стандартный параметр обработчика события "ПриНачалеВыбораЗначения".
//	ПараметрыФормы - Неопределено или Структура - параметры формы выбора (например, ТекущаяСтрока).
//	ЗначениеОтбора - СписокЗначений - правое значение устанавливаемого отбора.
//					Переданная коллекция автоматически преобразуется к списку значений.
//
Процедура ОткрытьФормуВыбораТипаДокумента(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыФормы, ЗначениеОтбора) Экспорт
	
	Если ПараметрыФормы = Неопределено Тогда
		Параметры = Новый Структура;
	Иначе
		Параметры = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПараметрыФормы);
	КонецЕсли;
	
	Если Параметры.Количество() = 0 И Не ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(КомпоновщикНастроек.Настройки.Отбор,
														"Ссылка",
														ЗначениеОтбора);
	
	Параметры.Вставить("ФиксированныеНастройки",	КомпоновщикНастроек.Настройки);
	Параметры.Вставить("РежимВыбора",				Истина);
	
	ОткрытьФорму("Справочник.ИдентификаторыОбъектовМетаданных.ФормаВыбора", Параметры, Элемент);
	
КонецПроцедуры

// Запускает обновляет реквизиты и команды на форме.
//
// Параметры:
//  Форма - УправляемаяФорма - форма, на которой необходимо обновить реквизиты и команды.
//
Процедура ОбновитьРеквизитыПоШаблонуПроцесса(Форма) Экспорт
	
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение", Форма);
	ВыполнитьОбработкуОповещения(Оповещение, "ОбновитьРеквизитыПоШаблонуПроцесса");
	
КонецПроцедуры

// Обработчик события ПередЗакрытием формы объекта.
//
// Параметры:
//   Форма - УправляемаяФорма - Форма, которая закрывается.
//   Источник - ДанныеФормыСтруктура - Объект с полем "Ссылка".
//   Отказ - Булево - одноименный параметр события ПередЗакрытием управляемой формы.
//   ЗавершениеРаботы - Булево - одноименный параметр события ПередЗакрытием управляемой формы.
//   ТекстПредупреждения - Строка - одноименный параметр события ПередЗакрытием управляемой формы.
//   СтандартнаяОбработка - Булево - одноименный параметр события ПередЗакрытием управляемой формы.
//
Процедура ПередЗакрытием(Форма, Знач Источник, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) Экспорт
	
	Ссылка = Источник.Ссылка;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ТекущаяЗадача") Тогда
		Если НЕ Форма.Модифицированность И Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя Тогда
			
			Отказ = Истина;
			
			Если ЗавершениеРаботы Тогда
				ТекстПредупреждения = "Данные были изменены. Все изменения будут потеряны.";
				Возврат;
			КонецЕсли;
			
			Если Ссылка.Пустая() Тогда
				ПараметрыОбработчика = Новый Структура;
				ПараметрыОбработчика.Вставить("Форма", Форма);
				ПараметрыОбработчика.Вставить("Источник", Источник);
				Обработчик = Новый ОписаниеОповещения("ПродолжитьПослеПодтвержденияЗаписиИЗакрытия", ЭтотОбъект, ПараметрыОбработчика);
				ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
				ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
			Иначе
				Обработчик = Новый ОписаниеОповещения("ПродолжитьПослеПодтвержденияЗакрытия", ЭтотОбъект, Форма);
				ТекстВопроса = НСтр("ru = 'Сохранить комментарий задачи по обработке документа?'");
				ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Открывает форму "Карточка процесса документа".
//
// Параметры:
//   ПараметрыФормы - Структура - одноименный параметр функции ОткрытьФорму.
//   Владелец - Форма или Элемент управления Формы - одноименный параметр функции ОткрытьФорму.
//   Уникальность - Произвольный - одноименный параметр функции ОткрытьФорму.
//   Окно - ОкноКлиентскогоПриложения - одноименный параметр функции ОткрытьФорму.
//
Процедура ОткрытьКарточкуПроцессаДокумента(Знач ПараметрыФормы = Неопределено, Знач Владелец = Неопределено, Знач Уникальность = Неопределено, Знач Окно = Неопределено) Экспорт
	
	ОткрытьФорму("ОбщаяФорма.КарточкаПроцессаДокумента", ПараметрыФормы, Владелец, Уникальность, Окно);
	
КонецПроцедуры

Процедура КомментарийНаправившегоОткрытие(Форма, Элемент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ПозицияРазделителя = СтрНайти(Форма.ПроцессыОбработкиДокументов_КомментарийНаправившего, ":");
	Автор = Лев(Форма.ПроцессыОбработкиДокументов_КомментарийНаправившего, ПозицияРазделителя - 1);
	ОписаниеЗадачи = Сред(Форма.ПроцессыОбработкиДокументов_КомментарийНаправившего, ПозицияРазделителя + 2);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Автор", Автор);
	ПараметрыФормы.Вставить("ОписаниеЗадачи", ОписаниеЗадачи);
	
	ОткрытьФорму("ОбщаяФорма.ОписаниеЗадачи", ПараметрыФормы, Форма);
	
КонецПроцедуры

Процедура КомментарийСледующемуНачалоВыбора(Форма, Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования,
																	Форма,
																	"ПроцессыОбработкиДокументов_КомментарийСледующему",
																	НСтр("ru='Комментарий для следующего исполнителя, описание выполнения задачи'"));
	
КонецПроцедуры

Процедура ПриОткрытииФормыПредварительногоПросмотраРегламентированногоОтчета(Форма, ПараметрыФормы) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриОткрытииФормыПредварительногоПросмотраРегламентированногоОтчета(
		Форма, ПараметрыФормы, СтандартнаяОбработка);
		
	Если СтандартнаяОбработка Тогда
		МодульРегламентированнаяОтчетностьКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("РегламентированнаяОтчетностьКлиент");
		МодульРегламентированнаяОтчетностьКлиент.ВывестиНаПечатьИлиНаПредварительныйПросмотрФормуРегламентированногоОтчета(
			Форма, ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСохраненииМодификацийВПечатнойФормеРегламентированногоОтчета(Форма, ТекущиеДанныеОтчета) Экспорт
	
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриСохраненииМодификацийВПечатнойФормеРегламентированногоОтчета(
		Форма, ТекущиеДанныеОтчета);
	
