Процедура ОжидатьЗавершениеВыполненияЗадач(Форма, ДлительнаяОперация, ДополнительныеПараметры) Экспорт
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	
	ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ВыполнениеЗадачПоОбработкеДокументовПрогресс", Форма);
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = ОповещениеОПрогрессеВыполнения;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПриЗавершенииВыполненияДлительнойОперации", Форма, ДополнительныеПараметры);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

Функция ПредставлениеСрокаВыполненияИнтервала(Параметры) Экспорт
	
	ИспользуютсяГрафикиРаботы = ПроцессыОбработкиДокументовКлиентПовтИсп.ИспользуютсяГрафикиРаботы();
	
	Возврат ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеСрокаВыполненияИнтервала(Параметры, ИспользуютсяГрафикиРаботы);
	
КонецФункции

Процедура ПослеНачалаРаботыСистемы() Экспорт
	
	ПараметрыКлиента = СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиентаПриЗапуске();
	Если НЕ ПараметрыКлиента.ДоступноИспользованиеРазделенныхДанных Тогда
		Возврат;
	КонецЕсли;
	
	Если ПользователиКлиент.ЭтоСеансВнешнегоПользователя() Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыКлиента.Свойство("ПроцессыОбработкиДокументов_ПоказыватьОповещенияОНовыхЗадачах")
		И ПараметрыКлиента.ПроцессыОбработкиДокументов_ПоказыватьОповещенияОНовыхЗадачах Тогда
		ПодключитьГлобальныйОбработчикОжидания("ПроцессыОбработкиДокументовВывестиОповещениеОНовыхЗадачах");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодключитьГлобальныйОбработчикОжидания(ИмяОбработчика, Интервал = 0) Экспорт
	ПодключитьОбработчикОжидания(ИмяОбработчика, ?(Интервал = 0, 0.3, Интервал * 60), Интервал = 0);
КонецПроцедуры

Процедура ВывестиОповещениеОНовыхЗадачах() Экспорт
	
	ИмяПараметра = "ПроцессыОбработкиДокументов.ДатаПредыдущегоОповещенияОНовыхЗадачах";
	ДатаПредыдущегоОповещения = ПараметрыПриложения[ИмяПараметра];
	
	ИнформацияОЗадачах = ПроцессыОбработкиДокументовВызовСервера.ИнформацияДляОповещенияОНовыхЗадачах(
		ДатаПредыдущегоОповещения);
	
	ПараметрыПриложения.Вставить(ИмяПараметра, ИнформацияОЗадачах.ТекущаяДата);
	
	Текст = "";
	Если ИнформацияОЗадачах.Всего > 0 Тогда
		Текст = Текст + НСтр("ru = 'всего: '") + Формат(ИнформацияОЗадачах.Всего, "ЧН=; ЧГ=");
		Если ИнформацияОЗадачах.Новые > 0 Тогда
			Текст = Текст + НСтр("ru = ' (новые: '") + Формат(ИнформацияОЗадачах.Новые, "ЧН=; ЧГ=") + ")";
		КонецЕсли;
		Текст = Текст + Символы.ПС + НСтр("ru = 'принято к исполнению: '") + Формат(ИнформацияОЗадачах.ПринятоКИсполнению, "ЧН=; ЧГ=");
		Если ИнформацияОЗадачах.Просроченные > 0 Тогда
			Текст = Текст + Символы.ПС + НСтр("ru = 'просроченные: '") + Формат(ИнформацияОЗадачах.Просроченные, "ЧН=; ЧГ=");
			Если ИнформацияОЗадачах.ПросроченныеНовые > 0 Тогда
				Текст = Текст + НСтр("ru = ' (новые: '") + Формат(ИнформацияОЗадачах.ПросроченныеНовые, "ЧН=; ЧГ=") + ")";
			КонецЕсли;
		КонецЕсли;
		Если ИнформацияОЗадачах.Срочные > 0 Тогда
			Текст = Текст + Символы.ПС + НСтр("ru = 'срочные: '") + Формат(ИнформацияОЗадачах.Срочные, "ЧН=; ЧГ=");
			Если ИнформацияОЗадачах.СрочныеНовые > 0 Тогда
				Текст = Текст + НСтр("ru = ' (новые: '") + Формат(ИнформацияОЗадачах.СрочныеНовые, "ЧН=; ЧГ=") + ")";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Текст) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Задачи по обработке документов'"), , Текст);
	КонецЕсли;
	
	// Первый вызов делается однократно, после - периодически
	Если НЕ ЗначениеЗаполнено(ДатаПредыдущегоОповещения) Тогда
		ПодключитьГлобальныйОбработчикОжидания("ПроцессыОбработкиДокументовВывестиОповещениеОНовыхЗадачах",
			ИнформацияОЗадачах.ИнтервалЗапуска);
	КонецЕсли;
	
КонецПроцедуры

