	ЗадачиСОтказом = Новый Массив;
	
	ПроцессыОбработкиДокументовВызовСервера.НазначитьИсполнителя(МассивЗадач, Исполнитель, ЗадачиСОтказом);
	
	Для Каждого ЗадачаСОтказом Из ЗадачиСОтказом Цикл
		ТекстСообщения = НСтр("ru = 'Для задачи ""'")
							+ Строка(ЗадачаСОтказом.Задача)
							+ НСтр("ru = '"" исполнитель не может быть назначен по причине: '")
							+ ЗадачаСОтказом.ПричинаОтказа;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;
	
	Если МассивЗадач.Количество() = 0 Тогда
		Если ЗадачиСОтказом.Количество() = 0 Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Команда не может быть выполнена для указанного объекта.'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Для Каждого Задача Из МассивЗадач Цикл
		Если ТипЗнч(Задача) <> Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Оповестить("Запись_ЗадачаПоОбработкеДокумента");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

