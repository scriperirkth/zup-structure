Процедура ПродолжитьВыполнениеЗадач(Параметры, Отказ = Ложь, ОписаниеОшибки = "") Экспорт
	
	Если Отказ Тогда
		
		// При отказе выполнение всех задач в пачке прерывается
		
		Параметры.ОписаниеОшибки = ОписаниеОшибки;
		
		ЗадачиСОтказомВыполнения = Новый Массив;
		
		Для Индекс = 0 По Параметры.ДанныеДокументов.ВГраница() Цикл
			ДанныеДокумента = Параметры.ДанныеДокументов[Индекс];
			ЗадачаСОтказомВыполнения = Новый Структура;
			ЗадачаСОтказомВыполнения.Вставить("Задача", ДанныеДокумента.Задача);
			ЗадачаСОтказомВыполнения.Вставить("ДатаПопытки", ОбщегоНазначенияКлиент.ДатаСеанса());
			ЗадачаСОтказомВыполнения.Вставить("ОписаниеОшибки", Параметры.ОписаниеОшибки);
			ЗадачиСОтказомВыполнения.Добавить(ЗадачаСОтказомВыполнения); 
			Если Не Параметры.Свойство("ОшибкаФоновогоЗадания") Тогда
				Параметры.ДанныеДокументов.Удалить(Индекс);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ЗадачиСОтказомВыполнения, Параметры.ВывестиСообщениеОбОшибке);
		
		Возврат;
		
	КонецЕсли;
	
	Если Параметры.ТребуетсяПроверкаПредыдущихЭП Тогда
		ПроверитьЭлектронныеПодписиНаКлиенте(Параметры);
	ИначеЕсли Параметры.ТребуетсяЭП ИЛИ Параметры.ТребуетсяПростаяЭП Тогда
		ПодписатьДанныеДокументов(Параметры);
	Иначе
		ПродолжитьВыполнениеЗадачи(Параметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПродолжитьВыполнениеЗадачи(Параметры) Экспорт
	
	Если Параметры.Свойство("Отказ") И Параметры.Отказ Тогда
		
		Параметры.ОписаниеОшибки = НСтр("ru = 'В дополнительном клиентском обработчике был установлен отказ от выполнения этапа по причине:
									|'") + Параметры.ОписаниеОшибки;
		
		ЗадачиСОтказомВыполнения = Новый Массив;
		// задачи по документам с отказом в доп. обработчике далее не выполняются
		Для Индекс = 0 По Параметры.ДанныеДокументов.ВГраница() Цикл
			ДанныеДокумента = Параметры.ДанныеДокументов[Индекс];
			Если Параметры.Источник = ДанныеДокумента.Документ Тогда
				ЗадачаСОтказомВыполнения = Новый Структура;
				ЗадачаСОтказомВыполнения.Вставить("Задача", ДанныеДокумента.Задача);
				ЗадачаСОтказомВыполнения.Вставить("ДатаПопытки", ОбщегоНазначенияКлиент.ДатаСеанса());
				ЗадачаСОтказомВыполнения.Вставить("ОписаниеОшибки", Параметры.ОписаниеОшибки);
				ЗадачиСОтказомВыполнения.Добавить(ЗадачаСОтказомВыполнения);
				Параметры.ДанныеДокументов.Удалить(Индекс);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ЗадачиСОтказомВыполнения, Параметры.ВывестиСообщениеОбОшибке);
	КонецЕсли;
	
	Параметры.Вставить("Отказ", Ложь);
	Параметры.Вставить("ОписаниеОшибки", "");
	Для Каждого ДанныеДокумента Из Параметры.ДанныеДокументов Цикл
		// для выполненного обработчика по документу сохраним значение дополнительных параметров
		Если Параметры.Свойство("Источник") И Параметры.Источник = ДанныеДокумента.Документ Тогда
			ДанныеДокумента.ДополнительныеПараметры = Параметры.ДополнительныеПараметры;
		КонецЕсли;
		
		Если ДанныеДокумента.ОбработчикиВыполнены Тогда
			Продолжить;
		КонецЕсли;
		
		КлиентскиеОбработчики = СтрРазделить(ДанныеДокумента.ОбработчикКлиентский, ";");
		Для Каждого Обработчик Из КлиентскиеОбработчики Цикл
			Если ДанныеДокумента.ВыполненныеОбработчики.Найти(Обработчик) = Неопределено Тогда
				ДанныеДокумента.ВыполненныеОбработчики.Добавить(Обработчик);
				Если КлиентскиеОбработчики.Количество() = ДанныеДокумента.ВыполненныеОбработчики.Количество() Тогда
					// установка признака выполнения обработчиков по документу перед выполнением последнего их них
					ДанныеДокумента.ОбработчикиВыполнены = Истина;
				КонецЕсли;
				Параметры.Вставить("Источник", ДанныеДокумента.Документ);
				Параметры.Вставить("ДополнительныеПараметры", ДанныеДокумента.ДополнительныеПараметры);
				ПроцессыОбработкиДокументовКлиентОбработчикиПереопределяемый.ВыполнитьДополнительныйОбработчик(Обработчик, Параметры);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	Параметры.Удалить("Отказ");
	Параметры.Удалить("ОписаниеОшибки");
	
	Если Параметры.ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстЗадачи = Новый Структура;
	КонтекстЗадачи.Вставить("Статус", Параметры.Статус);
	КонтекстЗадачи.Вставить("ИдентификаторПачки", Параметры.ИдентификаторПачки);
	КонтекстЗадачи.Вставить("ДанныеДокументов", Параметры.ДанныеДокументов);
	КонтекстЗадачи.Вставить("Комментарий", Параметры.Комментарий);
	
	Если Параметры.Свойство("НаборДанных") Тогда
		Для Каждого Набор Из Параметры.НаборДанных Цикл
			Набор.Удалить("Представление");
		КонецЦикла;
		КонтекстЗадачи.Вставить("НаборДанных", Параметры.НаборДанных);
	КонецЕсли;
	
	КонтекстЗадачи.Вставить("ДополнительныйКонтекст", Параметры.ДополнительныйКонтекст);
	
	ОповещениеПослеВыполненияЗадачи = Новый ОписаниеОповещения("ПослеВыполненияЗадачи", ЭтотОбъект);
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение", Параметры.Форма, ОповещениеПослеВыполненияЗадачи);
	ВыполнитьОбработкуОповещения(Оповещение, КонтекстЗадачи);
	
КонецПроцедуры

Процедура ПродолжитьВыполнениеКомандыПослеПодтвержденияПроведения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ВыполняетсяЗаписьПоКнопкеВыполненияЭтапа = Истина;
	
	ШаблонДоЗаписи = ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ТекущийШаблон;
	
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	
	Попытка
		ДополнительныеПараметры.Форма.Записать(ПараметрыЗаписи);
	Исключение
		ПоказатьОповещениеПользователя(,,КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),БиблиотекаКартинок.Информация32);
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		Возврат;
	КонецПопытки;
	
	Если ДополнительныеПараметры.Объект.Ссылка.Пустая()
		ИЛИ ДополнительныеПараметры.Форма.Модифицированность
		ИЛИ НЕ ДополнительныеПараметры.Объект.Проведен Тогда
		Если НЕ ДополнительныеПараметры.ДанныеДокументов[0].Задача.Пустая() Тогда
			ЗадачаСОтказомВыполнения = Новый Структура;
			ЗадачаСОтказомВыполнения.Вставить("Задача", ДополнительныеПараметры.ДанныеДокументов[0].Задача);
			ЗадачаСОтказомВыполнения.Вставить("ДатаПопытки", ОбщегоНазначенияКлиент.ДатаСеанса());
			ЗадачаСОтказомВыполнения.Вставить("ОписаниеОшибки", НСтр("ru = 'Не удалось провести '") + ДополнительныеПараметры.ДанныеДокументов[0].Документ);
			ОтметитьНеУспешнуюПопыткуВыполненияЗадач(
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗадачаСОтказомВыполнения), ДополнительныеПараметры.ВывестиСообщениеОбОшибке);
		КонецЕсли;
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	ИначеЕсли ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре <> ШаблонДоЗаписи Тогда
		// Произошла смена шаблона, необходимо прекратить выполнение этапа
		ТекстСообщения = НСтр("ru = 'Шаблон процесса был изменен согласно условиям использования. Выполнение задачи отменено.'");
		ПоказатьОповещениеПользователя(,,ТекстСообщения,БиблиотекаКартинок.Информация32);
		// Требуется переинициализция формы
		ДополнительныеПараметры.Форма.Прочитать();
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ДокументЗаписан");
	
	// Если документ был новый либо произошла смена шаблона,
	// то необходимо в параметрах установить ссылку на документ и на новую задачу
	Если ДополнительныеПараметры.ДанныеДокументов[0].Документ.Пустая()
		ИЛИ ДополнительныеПараметры.ДанныеДокументов[0].Задача.Пустая() Тогда
		
		ДополнительныеПараметры.ДанныеДокументов[0].Документ = ДополнительныеПараметры.Объект.Ссылка;
		ДополнительныеПараметры.ДанныеДокументов[0].Задача = ПроцессыОбработкиДокументовВызовСервера.ЗадачаНовогоДокумента(
			ДополнительныеПараметры.ДанныеДокументов[0].Шаблон,
			ДополнительныеПараметры.ДанныеДокументов[0].ИдентификаторЭтапа,
			ДополнительныеПараметры.ДанныеДокументов[0].Документ);
		
		ИдентификаторПачки = ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиКакВыполняемые(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры.ДанныеДокументов[0].Задача));
		ДополнительныеПараметры.Вставить("ИдентификаторПачки", ИдентификаторПачки);
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяЭП ИЛИ ДополнительныеПараметры.ТребуетсяПростаяЭП Тогда
		ОписаниеОшибки = "";
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДокументов(ДополнительныеПараметры.ДанныеДокументов, ОписаниеОшибки);
		Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
			ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяВызовСервера Тогда
		ВыполнитьПроцедурыСВызовомСервера(ДополнительныеПараметры);
	КонецЕсли;
	
	Если ДополнительныеПараметры.ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(ДополнительныеПараметры, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВыполнениеЗадач(ДополнительныеПараметры, Отказ, ОписаниеОшибки);
	
КонецПроцедуры

Процедура ПродолжитьВыполнениеКомандыПослеПодтвержденияОтменыПроведения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ВыполняетсяЗаписьПоКнопкеВыполненияЭтапа = Истина;
	
	ШаблонДоЗаписи = ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ТекущийШаблон;
	
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения);
	
	Попытка
		ДополнительныеПараметры.Форма.Записать(ПараметрыЗаписи);
	Исключение
		ПоказатьОповещениеПользователя(,,КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),БиблиотекаКартинок.Информация32);
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		Возврат;
	КонецПопытки;
	
	Если ДополнительныеПараметры.Объект.Ссылка.Пустая()
		ИЛИ ДополнительныеПараметры.Форма.Модифицированность
		ИЛИ ДополнительныеПараметры.Объект.Проведен Тогда
		ЗадачиСОтказомВыполнения = Новый Массив;
		ЗадачаСОтказомВыполнения = Новый Структура;
		ЗадачаСОтказомВыполнения.Вставить("Задача", ДополнительныеПараметры.ДанныеДокументов[0].Задача);
		ЗадачаСОтказомВыполнения.Вставить("ДатаПопытки", ОбщегоНазначенияКлиент.ДатаСеанса());
		ЗадачаСОтказомВыполнения.Вставить("ОписаниеОшибки", НСтр("ru = 'Не удалось отменить проведение '") + ДополнительныеПараметры.ДанныеДокументов[0].Документ);
		ЗадачиСОтказомВыполнения.Добавить(ЗадачаСОтказомВыполнения);
		ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ЗадачиСОтказомВыполнения, ДополнительныеПараметры.ВывестиСообщениеОбОшибке);
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	ИначеЕсли ДополнительныеПараметры.Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре <> ШаблонДоЗаписи Тогда
		// Произошла смена шаблона, необходимо прекратить выполнение этапа
		ТекстСообщения = НСтр("ru = 'Шаблон процесса был изменен согласно условиям использования. Выполнение задачи отменено.'");
		ПоказатьОповещениеПользователя(,,ТекстСообщения,БиблиотекаКартинок.Информация32);
		// Требуется переинициализция формы
		ДополнительныеПараметры.Форма.Прочитать();
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ДокументЗаписан");
	
	// Если документ был новый, то необходимо в параметрах установить ссылку
	Если ДополнительныеПараметры.ДанныеДокументов[0].Документ.Пустая() Тогда
		ДополнительныеПараметры.ДанныеДокументов[0].Документ = ДополнительныеПараметры.Объект.Ссылка;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяЭП ИЛИ ДополнительныеПараметры.ТребуетсяПростаяЭП Тогда
		ОписаниеОшибки = "";
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДокументов(ДополнительныеПараметры.ДанныеДокументов, ОписаниеОшибки);
		Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
			ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяВызовСервера Тогда
		ВыполнитьПроцедурыСВызовомСервера(ДополнительныеПараметры);
	КонецЕсли;
	
	Если ДополнительныеПараметры.ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(ДополнительныеПараметры, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
