КонецПроцедуры

Процедура ПродолжитьВыполнениеКомандыПослеПодтвержденияПроведенияДокументов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	ЗадачиСОтказомВыполнения = Новый Массив;
	
	ДополнительныеСвойства = Новый Структура("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиЗапущенногоПроцессаВыполнения", Истина);
	
	НепроведенныеДокументы = ПроцессыОбработкиДокументовВызовСервера.ПровестиДокументы(
		ДополнительныеПараметры.МассивДокументовДляПроведения, ДополнительныеСвойства);
	Для Каждого НепроведенныйДокумент Из НепроведенныеДокументы Цикл
		
		Если Лев(НепроведенныйДокумент.ОписаниеОшибки, 28) = НСтр("ru = 'Поля документа не заполнены.'") Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось провести ""%1""!
							|%2'"),
							НепроведенныйДокумент.Ссылка,
							НепроведенныйДокумент.ОписаниеОшибки);
		Иначе
			ТекстСообщения = НепроведенныйДокумент.ОписаниеОшибки;
		КонецЕсли;
		НепроведенныйДокумент.ОписаниеОшибки = ТекстСообщения;
		
		// задачи по не проведенным документам далее не выполняются
		Для Индекс = 0 По ДополнительныеПараметры.ДанныеДокументов.ВГраница() Цикл
			ДанныеДокумента = ДополнительныеПараметры.ДанныеДокументов[Индекс];
			Если ДанныеДокумента.Документ = НепроведенныйДокумент.Ссылка Тогда
				ЗадачаСОтказомВыполнения = Новый Структура;
				ЗадачаСОтказомВыполнения.Вставить("Задача", ДанныеДокумента.Задача);
				ЗадачаСОтказомВыполнения.Вставить("ДатаПопытки", ОбщегоНазначенияКлиент.ДатаСеанса());
				ЗадачаСОтказомВыполнения.Вставить("ОписаниеОшибки", НепроведенныйДокумент.ОписаниеОшибки);
				ЗадачиСОтказомВыполнения.Добавить(ЗадачаСОтказомВыполнения);
				ДополнительныеПараметры.ДанныеДокументов.Удалить(Индекс);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ЗадачиСОтказомВыполнения, ДополнительныеПараметры.ВывестиСообщениеОбОшибке);
	
	Если ДополнительныеПараметры.ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ДокументыКоторыеДолжныБытьНеПроведены.Количество() > 0 Тогда
		МассивНепроведенных = ОбщегоНазначенияВызовСервера.ПроверитьПроведенностьДокументов(ДополнительныеПараметры.ДокументыКоторыеДолжныБытьНеПроведены);
		МассивПроведенных = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ДополнительныеПараметры.ДокументыКоторыеДолжныБытьНеПроведены, МассивНепроведенных);
		Если МассивПроведенных.Количество() > 0 Тогда
			
			ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после отмены проведения документов:'");
			Для Каждого Документ Из МассивПроведенных Цикл
				ТекстВопроса = ТекстВопроса + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
				|%1'"), Документ);
			КонецЦикла;
			ТекстВопроса = ТекстВопроса + НСтр("ru = '
										|Будет отменено проведение документов.'");
			
			ДополнительныеПараметры.Вставить("МассивДокументовДляОтменыПроведения", МассивПроведенных);
			Обработчик = Новый ОписаниеОповещения("ПродолжитьВыполнениеКомандыПослеПодтвержденияОтменыПроведенияДокументов", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
			
			Возврат;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Отрицательная И НЕ ДополнительныеПараметры.НеЗаполнятьКомментарийПриОтрицательномРезультате Тогда
		// Вывод окна с вводом комментария для отрицательного результата выполнения этапа
		Подсказка = НСтр("ru = 'Заполните комментарий (причину)'");
		Оповещение = Новый ОписаниеОповещения("ПродолжитьПослеВводаКомментария", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВводСтроки(Оповещение, ДополнительныеПараметры.КомментарийПоУмолчанию, Подсказка, 0, Истина);
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяЭП ИЛИ ДополнительныеПараметры.ТребуетсяПростаяЭП Тогда
		ОписаниеОшибки = "";
		ПроцессыОбработкиДокументовКлиентПереопределяемый.ПриПодготовкеДанныхДокументов(ДополнительныеПараметры.ДанныеДокументов, ОписаниеОшибки);
		Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
			ПроцессыОбработкиДокументовВызовСервера.ОтметитьЗадачиВПачкеКакНевыполняемые(ДополнительныеПараметры.ИдентификаторПачки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТребуетсяВызовСервера Тогда
		ВыполнитьПроцедурыСВызовомСервера(ДополнительныеПараметры);
	КонецЕсли;
	
	Если ДополнительныеПараметры.ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовКлиентПереопределяемый.ПередВыполнениемЗадач(ДополнительныеПараметры, Отказ, ОписаниеОшибки, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВыполнениеЗадач(ДополнительныеПараметры, Отказ, ОписаниеОшибки);
	
КонецПроцедуры

