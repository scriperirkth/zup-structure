
#Область СлужебныйПрограммныйИнтерфейс

Процедура УстановитьДоступностьЭлементовОтчетаНаградыФизическихЛиц(ФормаОтчета) Экспорт
	
	Если  ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаОтчета, "ИсключатьРанееНагражденных") 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаОтчета.Элементы, "ГруппаИнтервалыНаграждения") Тогда
		
		ИсключатьРанееНагражденных = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ФормаОтчета, "ИсключатьРанееНагражденных");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаОтчета.Элементы, "ГруппаИнтервалыНаграждения", "Доступность", ИсключатьРанееНагражденных);
		
		Если Не ИсключатьРанееНагражденных Тогда
			ФормаОтчета.Элементы.ГруппаИнтервалыНаграждения.Скрыть();
		КонецЕсли;
		
	КонецЕсли;
	
	Если  ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаОтчета, "ИсключатьПоСтажу") 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаОтчета.Элементы, "ГруппаМинимальныеСтажиРаботы") Тогда
		
		ИсключатьПоСтажу = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(ФормаОтчета, "ИсключатьПоСтажу");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаОтчета.Элементы, "ГруппаМинимальныеСтажиРаботы", "Доступность", ИсключатьПоСтажу);
		
		Если Не ИсключатьПоСтажу Тогда
			ФормаОтчета.Элементы.ГруппаМинимальныеСтажиРаботы.Скрыть();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыОтчетаНаградыФизическихЛиц(ФормаОтчета) Экспорт
	
	ПараметрыДанных = ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных;
	ПараметрИнтервалыНаграждения = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ИнтервалыНаграждения"));
	ПараметрИсключатьРанееНагражденных = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ИсключатьРанееНагражденных"));
	ПараметрИсключатьПоСтажу = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ИсключатьПоСтажу"));
	ПараметрМинимальныеСтажиРаботы = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МинимальныеСтажиРаботы"));
	
	Если Не ПараметрИнтервалыНаграждения = Неопределено И Не СокрЛП(ПараметрИнтервалыНаграждения.ИдентификаторПользовательскойНастройки) = "" Тогда
		ПользовательскаяНастройка = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрИнтервалыНаграждения.ИдентификаторПользовательскойНастройки);
		СериализованныеНастройки = ПроцессыНагражденияВызовСервера.СериализоватьКоллекцию(ФормаОтчета.ИнтервалыНаграждения);
		ПользовательскаяНастройка.Значение = СериализованныеНастройки;
	КонецЕсли;
	
	Если Не ПараметрМинимальныеСтажиРаботы = Неопределено И Не СокрЛП(ПараметрМинимальныеСтажиРаботы.ИдентификаторПользовательскойНастройки) = "" Тогда
		ПользовательскаяНастройка = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрМинимальныеСтажиРаботы.ИдентификаторПользовательскойНастройки);
		СериализованныеНастройки = ПроцессыНагражденияВызовСервера.СериализоватьКоллекцию(ФормаОтчета.МинимальныеСтажиРаботы);
		ПользовательскаяНастройка.Значение = СериализованныеНастройки;
	КонецЕсли;
	
	Если Не ПараметрИсключатьРанееНагражденных = Неопределено И Не СокрЛП(ПараметрИсключатьРанееНагражденных.ИдентификаторПользовательскойНастройки) = "" Тогда
		ПользовательскаяНастройка = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрИсключатьРанееНагражденных.ИдентификаторПользовательскойНастройки);
		ПользовательскаяНастройка.Значение = ФормаОтчета.ИсключатьРанееНагражденных;
	КонецЕсли;
	
	Если Не ПараметрИсключатьПоСтажу = Неопределено И Не СокрЛП(ПараметрИсключатьПоСтажу.ИдентификаторПользовательскойНастройки) = "" Тогда
		ПользовательскаяНастройка = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрИсключатьПоСтажу.ИдентификаторПользовательскойНастройки);
		ПользовательскаяНастройка.Значение = ФормаОтчета.ИсключатьПоСтажу;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
