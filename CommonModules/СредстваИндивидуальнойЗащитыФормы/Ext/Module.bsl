Процедура СоздатьРеквизитыФормы(Форма)
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"НормыВыдачиСИЗ", 
			Новый ОписаниеТипов("ТаблицаЗначений"),
			,
			НСтр("ru = 'Нормы выдачи СИЗ'"), 
			Истина));
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"Пометка", 
			Новый ОписаниеТипов("Булево"),
			"НормыВыдачиСИЗ",
			НСтр("ru = 'Пометка'")));
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"ТипНоменклатуры", 
			Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"),
			"НормыВыдачиСИЗ",
			НСтр("ru = 'Тип СИЗ'")));
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"КомандаСИЗ", 
			Новый ОписаниеТипов("Строка"),
			"НормыВыдачиСИЗ",
			НСтр("ru = 'Команда СИЗ'")));
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"МассивСИЗ", 
			Новый ОписаниеТипов(),
			"НормыВыдачиСИЗ",
			НСтр("ru = 'Массив СИЗ'")));
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"НормыВыдачиСИЗНаборЗаписей", 
			Новый ОписаниеТипов("РегистрСведенийНаборЗаписей.СИЗРабочегоМеста"),
			,
			НСтр("ru = 'Нормы выдачи СИЗ'"), 
			Истина));
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"ПериодичностьВыдачи", 
			Новый ОписаниеТипов("Строка"),
			,
			НСтр("ru = 'Периодичность выдачи'")));
	
	МассивИменРеквизитовФормы = Новый Массив;
	ЗарплатаКадры.ЗаполнитьМассивИменРеквизитовФормы(Форма, МассивИменРеквизитовФормы);
	ЗарплатаКадры.ИзменитьРеквизитыФормы(Форма, ДобавляемыеРеквизиты, МассивИменРеквизитовФормы);

КонецПроцедуры

Процедура СоздатьКомандыФормы(Форма)
	
	Если Форма.Команды.Найти("СкопироватьНормыВыдачи") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомандаСкопировать = Форма.Команды.Добавить("СкопироватьНормыВыдачи");
	КомандаСкопировать.Действие = "Подключаемый_СкопироватьНормыВыдачи";
	КомандаСкопировать.Заголовок = НСтр("ru = 'Скопировать из другой должности...'");
	КомандаСкопировать.ИзменяетСохраняемыеДанные = Истина;
	КомандаСкопировать.Подсказка = НСтр("ru = 'Скопировать нормы выдачи средств индивидуальной защиты из другой должности'");
	
	КомандаСнятьФлажки = Форма.Команды.Добавить("СнятьФлажки");
	КомандаСнятьФлажки.Действие = "Подключаемый_СнятьФлажки";
	КомандаСнятьФлажки.Заголовок = НСтр("ru = 'Снять флажки'");
	КомандаСнятьФлажки.ИзменяетСохраняемыеДанные = Истина;
	КомандаСнятьФлажки.Картинка = БиблиотекаКартинок.СнятьФлажки;
	КомандаСнятьФлажки.Подсказка = НСтр("ru = 'Снять флажки'");
	
	КомандаСнятьФлажки = Форма.Команды.Добавить("УстановитьФлажки");
	КомандаСнятьФлажки.Действие = "Подключаемый_УстановитьФлажки";
	КомандаСнятьФлажки.Заголовок = НСтр("ru = 'Установить флажки'");
	КомандаСнятьФлажки.ИзменяетСохраняемыеДанные = Истина;
	КомандаСнятьФлажки.Картинка = БиблиотекаКартинок.УстановитьФлажки;
	КомандаСнятьФлажки.Подсказка = НСтр("ru = 'Установить флажки'");
	
КонецПроцедуры

Процедура ДобавитьЭлементыФормы(Форма)
	
	Элементы = Форма.Элементы;
	ГруппаРазмещения = Элементы.Найти("СредстваИндивидуальнойЗащитыГруппа");
	ГруппаРазмещения.Заголовок = НСтр("ru = 'Средства индивидуальной защиты'");
	ГруппаРазмещения.ОтображатьЗаголовок = Истина;
	ГруппаРазмещения.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	ГруппаРазмещения.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ДобавитьЭлементыПериодичность(Элементы, ГруппаРазмещения);
	ДобавитьЭлементыГруппыНормыВыдачиСИЗ(Элементы, ГруппаРазмещения);
	
КонецПроцедуры

Процедура ДобавитьЭлементыПериодичность(Элементы, ГруппаРазмещения)
	
	Если Элементы.Найти("ПериодичностьВыдачиГруппа") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПериодичностьВыдачиГруппа = Элементы.Добавить("ПериодичностьВыдачиГруппа", Тип("ГруппаФормы"), ГруппаРазмещения);
	ПериодичностьВыдачиГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПериодичностьВыдачиГруппа.ОтображатьЗаголовок = Ложь;
	ПериодичностьВыдачиГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	ПериодичностьВыдачиГруппа.РастягиватьПоГоризонтали = Истина;
	
	ПредставлениеПериодичностиВыдачи = Элементы.Добавить("ПредставлениеПериодичностиВыдачи", Тип("ПолеФормы"), ПериодичностьВыдачиГруппа);
	ПредставлениеПериодичностиВыдачи.Вид = ВидПоляФормы.ПолеВвода;
	ПредставлениеПериодичностиВыдачи.Заголовок = НСтр("ru = 'Периодичность выдачи'");
	ПредставлениеПериодичностиВыдачи.ПутьКДанным = "ПериодичностьВыдачи";
	ПредставлениеПериодичностиВыдачи.ТолькоПросмотр = Истина;
	ПредставлениеПериодичностиВыдачи.Подсказка = НСтр("ru = 'Работа в этих условиях труда требует выдачу СИЗ не реже указанного.'");
	ПредставлениеПериодичностиВыдачи.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	ПредставлениеПериодичностиВыдачи.Ширина = 10;
	
	СкопироватьКнопка = Элементы.Добавить("СкопироватьНормыВыдачи", Тип("КнопкаФормы"), ПериодичностьВыдачиГруппа);
	СкопироватьКнопка.Вид = ВидКнопкиФормы.Гиперссылка;
	СкопироватьКнопка.ИмяКоманды = "СкопироватьНормыВыдачи";
	СкопироватьКнопка.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
	
КонецПроцедуры

Процедура ДобавитьЭлементыГруппыНормыВыдачиСИЗ(Элементы, ГруппаРазмещения)
	
	Если Элементы.Найти("НормыВыдачиСИЗГруппа") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НормыВыдачиСИЗГруппа = Элементы.Добавить("НормыВыдачиСИЗГруппа", Тип("ГруппаФормы"), ГруппаРазмещения);
	НормыВыдачиСИЗГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НормыВыдачиСИЗГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НормыВыдачиСИЗГруппа.ОтображатьЗаголовок = Ложь;
	НормыВыдачиСИЗГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НормыВыдачиСИЗГруппа.Подсказка = НСтр("ru = 'Перечисленные нормы определяют периодичность выдачи СИЗ сотрудников, кроме того, их перечень заполняется в разнарядке на выдачу.'");
	НормыВыдачиСИЗГруппа.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	НормыВыдачиСИЗГруппа.РасширеннаяПодсказка.АвтоМаксимальнаяШирина = Ложь;
	
	НормыВыдачиСИЗКоманднаяПанель = Элементы.Добавить("НормыВыдачиСИЗКоманднаяПанель", Тип("ГруппаФормы"), НормыВыдачиСИЗГруппа);
	НормыВыдачиСИЗКоманднаяПанель.Вид = ВидГруппыФормы.КоманднаяПанель;
	
	УправлениеФлажками = Элементы.Добавить("УправлениеФлажками", Тип("ГруппаФормы"), НормыВыдачиСИЗКоманднаяПанель);
	УправлениеФлажками.Вид = ВидГруппыФормы.ГруппаКнопок;
	
	УстановитьФлажкиКнопка = Элементы.Добавить("УстановитьФлажки", Тип("КнопкаФормы"), УправлениеФлажками);
	УстановитьФлажкиКнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	УстановитьФлажкиКнопка.ИмяКоманды = "УстановитьФлажки";
	
	СнятьФлажкиКнопка = Элементы.Добавить("СнятьФлажки", Тип("КнопкаФормы"), УправлениеФлажками);
	СнятьФлажкиКнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	СнятьФлажкиКнопка.ИмяКоманды = "СнятьФлажки";
	
	// Таблица "Нормы выдачи СИЗ".
	НормыВыдачиСИЗ = Элементы.Добавить("НормыВыдачиСИЗ", Тип("ТаблицаФормы"), НормыВыдачиСИЗГруппа);
	НормыВыдачиСИЗ.ПутьКДанным = "НормыВыдачиСИЗ";
	НормыВыдачиСИЗ.АвтоВводНовойСтроки = Ложь;
	НормыВыдачиСИЗ.Высота = 2;
	НормыВыдачиСИЗ.Заголовок = "Нормы выдачи СИЗ";
	НормыВыдачиСИЗ.ИзменятьПорядокСтрок = Ложь;
	НормыВыдачиСИЗ.ИзменятьСоставСтрок = Ложь;
	НормыВыдачиСИЗ.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НормыВыдачиСИЗ.РежимВыделения = РежимВыделенияТаблицы.Множественный;
	НормыВыдачиСИЗ.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.Авто;
	НормыВыдачиСИЗ.УстановитьДействие("Выбор","Подключаемый_НормыВыдачиСИЗВыбор");
	НормыВыдачиСИЗ.УстановитьДействие("ПриОкончанииРедактирования","Подключаемый_НормыВыдачиСИЗПриОкончанииРедактирования");
	НормыВыдачиСИЗ.УстановитьДействие("ПослеУдаления","Подключаемый_НормыВыдачиСИЗПослеУдаления");
	
	НормыВыдачиСИЗПометка = Элементы.Добавить("НормыВыдачиСИЗПометка", Тип("ПолеФормы"), НормыВыдачиСИЗ);
	НормыВыдачиСИЗПометка.ПутьКДанным = "НормыВыдачиСИЗ.Пометка";
	НормыВыдачиСИЗПометка.Вид = ВидПоляФормы.ПолеФлажка;
	НормыВыдачиСИЗПометка.УстановитьДействие("ПриИзменении","Подключаемый_НормыВыдачиСИЗПометкаПриИзменении");
	
	НормыВыдачиСИЗТипНоменклатуры = Элементы.Добавить("НормыВыдачиСИЗТипНоменклатуры", Тип("ПолеФормы"), НормыВыдачиСИЗ);
	НормыВыдачиСИЗТипНоменклатуры.ПутьКДанным = "НормыВыдачиСИЗ.ТипНоменклатуры";
	НормыВыдачиСИЗТипНоменклатуры.Вид = ВидПоляФормы.ПолеНадписи;
	НормыВыдачиСИЗТипНоменклатуры.РастягиватьПоГоризонтали = Ложь;
	НормыВыдачиСИЗТипНоменклатуры.Ширина = 30;
	НормыВыдачиСИЗТипНоменклатуры.АвтоМаксимальнаяШирина = Ложь;
	
	НормыВыдачиСИЗКомандаСИЗ = Элементы.Добавить("НормыВыдачиСИЗКомандаСИЗ", Тип("ПолеФормы"), НормыВыдачиСИЗ);
	НормыВыдачиСИЗКомандаСИЗ.ПутьКДанным = "НормыВыдачиСИЗ.КомандаСИЗ";
	НормыВыдачиСИЗКомандаСИЗ.Вид = ВидПоляФормы.ПолеВвода;
	НормыВыдачиСИЗКомандаСИЗ.ГиперссылкаЯчейки = Истина;
	НормыВыдачиСИЗКомандаСИЗ.ЦветТекста = ЦветаСтиля.ГиперссылкаЦвет;
	НормыВыдачиСИЗКомандаСИЗ.Заголовок = НСтр("ru = 'Нормы выдачи СИЗ'");
	НормыВыдачиСИЗКомандаСИЗ.ТолькоПросмотр = Истина;
	
КонецПроцедуры

#КонецОбласти

Процедура СкопироватьНормыВыдачиИзДругойДолжности(Форма, ДолжностьИсточник)
	
	ПрочитатьСИЗ(Форма, ДолжностьИсточник);
	ОбновитьПериодичностьВыдачиСИЗОбъекта(Форма);
	Форма.Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьНормыВыдачиСИЗ(Форма)
	
	Если Форма.НормыВыдачиСИЗ.Количество() > 0 Тогда
		Форма.НормыВыдачиСИЗ.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТипыНоменклатуры.Ссылка КАК ТипНоменклатуры,
		|	ТипыНоменклатуры.Порядок КАК Порядок
		|ИЗ
		|	Перечисление.ТипыНоменклатуры КАК ТипыНоменклатуры
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ПараметрыОписанияСтрокиСИЗ = СредстваИндивидуальнойЗащитыКлиентСервер.ПараметрыОписанияСтрокиСИЗ();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = Форма.НормыВыдачиСИЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
		НоваяСтрока.КомандаСИЗ = НСтр("ru = '< Не установлены >'");
		ОтборСтрок = Новый Структура("ТипНоменклатуры", ВыборкаДетальныеЗаписи.ТипНоменклатуры);
		НайденныеСтроки = Форма.НормыВыдачиСИЗНаборЗаписей.НайтиСтроки(ОтборСтрок);
		НоваяСтрока.Пометка = НайденныеСтроки.Количество() > 0;
		Если НоваяСтрока.Пометка Тогда
			ЗаполнитьМассивСИЗ(Форма.НормыВыдачиСИЗНаборЗаписей, НоваяСтрока, "ТипНоменклатуры", ПараметрыОписанияСтрокиСИЗ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьМассивСИЗ(ТаблицаСИЗ, СтрокаТаблицы, ИмяПоля, ПараметрыОписания, ДанныеСИЗ = Неопределено) Экспорт
	
	СИЗНаРабочемМесте = Новый Массив;
	
	НайденныеСтроки = ТаблицаСИЗ.НайтиСтроки(Новый Структура(ИмяПоля, СтрокаТаблицы[ИмяПоля]));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
		Описание = СредстваИндивидуальнойЗащитыКлиентСервер.ОписаниеСтрокиСИЗ(ПараметрыОписания);
		ЗаполнитьЗначенияСвойств(Описание, НайденнаяСтрока);
		Если ТипЗнч(ДанныеСИЗ) = Тип("Соответствие") Тогда
			ЗаполнитьЗначенияСвойств(Описание, ДанныеСИЗ.Получить(НайденнаяСтрока.СИЗ));
		КонецЕсли;
		СИЗНаРабочемМесте.Добавить(Описание);
	КонецЦикла;
	
	СтрокаТаблицы.МассивСИЗ = Новый ФиксированныйМассив(СИЗНаРабочемМесте);
	СтрокаТаблицы.КомандаСИЗ = КраткийСоставСИЗ(СтрокаТаблицы.МассивСИЗ);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеНормВыдачиСИЗ(Форма, Отказ)
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "НормыВыдачиСИЗ") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Форма.НормыВыдачиСИЗ Цикл
		Если СтрокаТаблицы.Пометка И Не ЗначениеЗаполнено(СтрокаТаблицы.МассивСИЗ) Тогда
			ТекстСообщения = НСтр("ru = 'Нормы СИЗ не установлены.'");
			НомерСтроки = Форма.НормыВыдачиСИЗ.Индекс(СтрокаТаблицы) + 1;
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("НормыВыдачиСИЗ", НомерСтроки, "КомандаСИЗ");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , Поле, , Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция РезультатыПакетаЗапросовДляИзмененияНормВыдачиРабочихМест(Форма, ИспользоватьОтбор, ОтборРабочихМест) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РабочиеМестаСправочник.Ссылка КАК РабочееМесто,
		|	ВЫБОР
		|		КОГДА ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА
		|			ИЗ
		|				РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
		|			ГДЕ
		|				СИЗРабочегоМеста.РабочееМесто = РабочиеМестаСправочник.Ссылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьСИЗ,
		|	ПериодичностьВыдачиСИЗРабочихМест.СИЗПолноеПредставление КАК СИЗПолноеПредставление,
		|	ПериодичностьВыдачиСИЗРабочихМест.ПредставлениеПериодичностиВыдачи КАК ПредставлениеПериодичностиВыдачи,
		|	РабочиеМестаСправочник.ПорядковыйНомер КАК ПорядковыйНомер
		|ИЗ
		|	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаСправочник
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПериодичностьВыдачиСИЗРабочихМест КАК ПериодичностьВыдачиСИЗРабочихМест
		|		ПО РабочиеМестаСправочник.Ссылка = ПериодичностьВыдачиСИЗРабочихМест.РабочееМесто
		|ГДЕ
		|	РабочиеМестаСправочник.ЭтоГруппа = ЛОЖЬ
		|	И ВЫБОР
		|		КОГДА &ЕстьОтборРабочихМест
		|			ТОГДА РабочиеМестаСправочник.Ссылка В (&РабочиеМеста)
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &ЕстьОрганизация
		|			ТОГДА РабочиеМестаСправочник.Владелец = &Организация
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &ЕстьПодразделение
		|			ТОГДА РабочиеМестаСправочник.Подразделение = &Подразделение
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|
		|	ПорядковыйНомер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СИЗРабочегоМеста.РабочееМесто,
		|	СИЗРабочегоМеста.СИЗ,
		|	СИЗРабочегоМеста.Количество,
		|	СИЗРабочегоМеста.ЕдиницаИзмерения,
		|	СИЗРабочегоМеста.ТипНоменклатуры,
		|	СИЗРабочегоМеста.СпособВыдачи,
		|	СИЗРабочегоМеста.КратностьВыдачи,
		|	СИЗРабочегоМеста.ПериодичностьВыдачи,
		|	СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи,
		|	СИЗРабочегоМеста.Дежурное
		|ИЗ
		|	РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &ЕстьОтборРабочихМест
		|			ТОГДА СИЗРабочегоМеста.РабочееМесто В (&РабочиеМеста)
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &ЕстьОрганизация
		|			ТОГДА СИЗРабочегоМеста.РабочееМесто.Владелец = &Организация
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &ЕстьПодразделение
		|			ТОГДА СИЗРабочегоМеста.РабочееМесто.Подразделение = &Подразделение
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЕстьОтборРабочихМест", ИспользоватьОтбор);
	Запрос.УстановитьПараметр("РабочиеМеста", ОтборРабочихМест);
	Запрос.УстановитьПараметр("ЕстьОрганизация", ЗначениеЗаполнено(Форма.Организация));
	Запрос.УстановитьПараметр("Организация", Форма.Организация);
	Запрос.УстановитьПараметр("ЕстьПодразделение", ЗначениеЗаполнено(Форма.Подразделение));
	Запрос.УстановитьПараметр("Подразделение", Форма.Подразделение);
	
	Возврат Запрос.ВыполнитьПакет();
	
