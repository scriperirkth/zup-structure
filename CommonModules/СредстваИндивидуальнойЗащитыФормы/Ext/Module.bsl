#Область СлужебныйПрограммныйИнтерфейс

Процедура УстановитьСвернутыйЗаголовокГруппеДополнительныеРеквизиты(Форма) Экспорт
	
	КоличествоСвойств = 0;
	КоличествоУстановленныхСвойств = 0;
	
	Для Каждого Элемент Из Форма.Элементы.ГруппаДополнительныеРеквизиты.ПодчиненныеЭлементы Цикл
		Если Элемент.Вид <> ВидГруппыФормы.ОбычнаяГруппа Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ЭлементГруппы Из Элемент.ПодчиненныеЭлементы Цикл
			Если ЭлементГруппы.Вид <> ВидПоляФормы.ПолеФлажка Тогда
				Продолжить;
			КонецЕсли;
			КоличествоСвойств = КоличествоСвойств + 1;
			Если Форма[ЭлементГруппы.ПутьКДанным] = Истина Тогда
				КоличествоУстановленныхСвойств = КоличествоУстановленныхСвойств + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КоличествоСвойств) Тогда
		КоличествоСвойств = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 защитное свойство;;%1 защитных свойства;%1 защитных свойств;'"), 
			КоличествоСвойств);
		Если КоличествоУстановленныхСвойств > 0 Тогда
			КоличествоУстановленныхСвойств = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
				НСтр("ru=';%1 защитное свойство;;%1 защитных свойства;%1 защитных свойств;'"), 
				КоличествоУстановленныхСвойств);
			Форма.Элементы.ГруппаДополнительныеРеквизиты.ЗаголовокСвернутогоОтображения =
				СтрШаблон(НСтр("ru = 'Всего %1, применяется %2'"),
				КоличествоСвойств, КоличествоУстановленныхСвойств);
		Иначе
			Форма.Элементы.ГруппаДополнительныеРеквизиты.ЗаголовокСвернутогоОтображения =
				СтрШаблон(НСтр("ru = 'Всего %1'"), КоличествоСвойств);
		КонецЕсли;
	Иначе
		Форма.Элементы.ГруппаДополнительныеРеквизиты.ЗаголовокСвернутогоОтображения = НСтр("ru = 'Дополнительные реквизиты'");
	КонецЕсли;
	
КонецПроцедуры

Функция КраткийСоставСИЗ(МассивДанныхСИЗ) Экспорт
	
	Если МассивДанныхСИЗ = Неопределено Или МассивДанныхСИЗ.Количество() = 0 Тогда
		Возврат НСтр("ru = '< Не установлены >'");
	КонецЕсли;
	
	// Первые N СИЗ и M символов.
	МаксимальноеКоличествоСИЗ = 10;
	МаксимальнаяДлинаСтроки = 300;

	Счетчик = 0;
	УникальныеСИЗ = Новый Соответствие;
	
	Для Каждого СтруктураСИЗ Из МассивДанныхСИЗ Цикл
		Если Счетчик = МаксимальноеКоличествоСИЗ Тогда
			Прервать;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтруктураСИЗ.СИЗ) 
			Или УникальныеСИЗ[СтруктураСИЗ.СИЗ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УникальныеСИЗ.Вставить(СтруктураСИЗ.СИЗ, СтруктураСИЗ);
		
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	КраткийСостав = "";
	ШаблонСтроки = НСтр("ru = '%1%2 (%3)'");
	
	Для Каждого КлючИЗначениеСИЗ Из УникальныеСИЗ Цикл
		СтруктураСИЗ = КлючИЗначениеСИЗ.Значение;
		ПредставлениеПериодичностиВыдачи = СредстваИндивидуальнойЗащитыКлиентСервер.ПредставлениеПериодичности(
			СтруктураСИЗ.КратностьВыдачи, СтруктураСИЗ.ПериодичностьВыдачи, СтруктураСИЗ.ЕдиницаПериодичностиВыдачи,
			СтруктураСИЗ.ЕдиницаИзмерения, СтруктураСИЗ.Количество, СтруктураСИЗ.СпособВыдачи);
		Если СтруктураСИЗ.Свойство("Дежурное") И СтруктураСИЗ.Дежурное Тогда
			ПредставлениеПериодичностиВыдачи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1 - дежурное'"), ПредставлениеПериодичностиВыдачи);
		КонецЕсли;
		
		КраткийСостав = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтроки,
			КраткийСостав, Строка(СтруктураСИЗ.СИЗ), ПредставлениеПериодичностиВыдачи);
		ШаблонСтроки = НСтр("ru = '%1;
			|%2 (%3)'");
	КонецЦикла;
	
	Если СтрДлина(КраткийСостав) > МаксимальнаяДлинаСтроки Тогда
		КраткийСостав = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1...'"), Лев(КраткийСостав, МаксимальнаяДлинаСтроки - 3));
	КонецЕсли;
	
	Возврат КраткийСостав;
	
КонецФункции

Процедура ПрочитатьСИЗ(Форма, СсылкаНаОбъект) Экспорт
	
	НаборЗаписей = РегистрыСведений.СИЗРабочегоМеста.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.РабочееМесто.Установить(СсылкаНаОбъект);
	НаборЗаписей.Прочитать();
	
	ЗначениеВДанныеФормы(НаборЗаписей, Форма.НормыВыдачиСИЗНаборЗаписей);
	ЗаполнитьНормыВыдачиСИЗ(Форма);
	
КонецПроцедуры

Процедура УдалитьСвязаннуюНоменклатуруСИЗ(Форма, ИдентификаторСтрокиРабочегоМеста) Экспорт
	
	СтруктураПоискаСИЗ = Новый Структура("ИдентификаторСтрокиРабочегоМеста", ИдентификаторСтрокиРабочегоМеста);
	НайденныеСтроки = Форма.Объект.НоменклатураСИЗ.НайтиСтроки(СтруктураПоискаСИЗ);
	Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Форма.Объект.НоменклатураСИЗ.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьПериодичностьВыдачиСИЗОбъекта(Форма, УстановитьЗаголовокГруппы = Ложь) Экспорт
	
	НормыСИЗМассив = Новый Массив;
	
	Для каждого СтрокаТипаНоменклатуры Из Форма.НормыВыдачиСИЗ Цикл
		Если Не ЗначениеЗаполнено(СтрокаТипаНоменклатуры.МассивСИЗ) Тогда
			Продолжить;
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НормыСИЗМассив, СтрокаТипаНоменклатуры.МассивСИЗ);
	КонецЦикла;
	
	ОписаниеПериодичности = СредстваИндивидуальнойЗащиты.МинимальнаяПериодичность(НормыСИЗМассив, "Выдачи");
	
	Форма.ПериодичностьВыдачи = ОписаниеПериодичности.Представление;
	
	Если ПустаяСтрока(Форма.ПериодичностьВыдачи) Тогда
		Форма.ПериодичностьВыдачи = НСтр("ru = '< Не установлены >'");
	КонецЕсли;
	
	Если Не УстановитьЗаголовокГруппы Тогда
		Возврат;
	КонецЕсли;
	
	Форма.Элементы.ГруппаСИЗ.ЗаголовокСвернутогоОтображения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Нормы выдачи СИЗ: %1'"), Форма.ПериодичностьВыдачи);
	
КонецПроцедуры

Процедура УстановитьСИЗ(Форма, РезультатЗакрытия) Экспорт
	
	НайденныеСтрокиРабочегоМеста = Форма.Объект.РабочиеМеста.НайтиСтроки(
		Новый Структура("РабочееМесто, ФизическоеЛицо", РезультатЗакрытия.РабочееМесто, РезультатЗакрытия.ФизическоеЛицо));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтрокиРабочегоМеста Цикл
		НайденнаяСтрока.МассивСИЗ = Новый ФиксированныйМассив(РезультатЗакрытия.СИЗ);
		НайденнаяСтрока.КомандаСИЗ = КраткийСоставСИЗ(НайденнаяСтрока.МассивСИЗ);
	КонецЦикла;
	
	Форма.Модифицированность = Истина;
	
КонецПроцедуры

#Область СправочникДолжности

Процедура ПодготовитьФормуДолжности(Форма) Экспорт
	
	Если Не СредстваИндивидуальнойЗащиты.СредстваИндивидуальнойЗащитыИспользуются()
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.СИЗРабочегоМеста) Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаСтраницы = Форма.Элементы.Найти("ГруппаСтраницы");
	
	Если ГруппаСтраницы <> Неопределено И ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет Тогда
		ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьФормуЭлементаСправочникаДолжности(Форма) Экспорт
	
	Если Не СредстваИндивидуальнойЗащиты.СредстваИндивидуальнойЗащитыИспользуются() Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьРеквизитыФормы(Форма);
	СоздатьКомандыФормы(Форма);
	
	ДобавитьЭлементыФормы(Форма);
	
КонецПроцедуры

Процедура ПрочитатьДополнительныеДанныеОбъекта(Форма, СсылкаНаОбъект, ОбработатьЗаголовокГруппы = Ложь) Экспорт
	
	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Объект, "Владелец");
	Если Не СредстваИндивидуальнойЗащиты.СредстваИндивидуальнойЗащитыИспользуются(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.СИЗРабочегоМеста) Тогда
		Если ОбработатьЗаголовокГруппы Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Форма.Элементы, "ГруппаСИЗ", "Видимость", Ложь);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПрочитатьСИЗ(Форма, СсылкаНаОбъект);
	ОбновитьПериодичностьВыдачиСИЗОбъекта(Форма, ОбработатьЗаголовокГруппы);
	
КонецПроцедуры

Процедура ДолжностиПриУстановкеУсловногоОформления(Форма) Экспорт
	
	Если Не СредстваИндивидуальнойЗащиты.СредстваИндивидуальнойЗащитыИспользуются() Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	УсловноеОформление = Форма.УсловноеОформление;
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НормыВыдачиСИЗТипНоменклатуры.Имя);
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НормыВыдачиСИЗКомандаСИЗ.Имя);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементУсловногоОформления.Отбор, "НормыВыдачиСИЗ.Пометка", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НормыВыдачиСИЗКомандаСИЗ.Имя);
	ГруппаОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы  = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "НормыВыдачиСИЗ.Пометка", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "НормыВыдачиСИЗ.КомандаСИЗ", НСтр("ru = '< Не установлены >'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполненияОбъекта(Форма, Отказ, ПроверяемыеРеквизиты) Экспорт
	
	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Объект, "Владелец");
	Если Не СредстваИндивидуальнойЗащиты.СредстваИндивидуальнойЗащитыИспользуются(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ПериодичностьВыдачиСИЗРабочихМест) Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьЗаполнениеНормВыдачиСИЗ(Форма, Отказ);
	
КонецПроцедуры

Процедура ЗаписатьДополнительныеДанныеОбъекта(Форма, Ссылка) Экспорт
	
	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Объект, "Владелец");
	Если Не СредстваИндивидуальнойЗащиты.СредстваИндивидуальнойЗащитыИспользуются(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СИЗРабочегоМеста) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = Форма.РеквизитФормыВЗначение("НормыВыдачиСИЗНаборЗаписей");
	НаборЗаписей.Очистить();
	Для каждого СтрокаТипаНоменклатуры Из Форма.НормыВыдачиСИЗ Цикл
		Если Не ЗначениеЗаполнено(СтрокаТипаНоменклатуры.МассивСИЗ) Тогда
			Продолжить;
		КонецЕсли;
		Для каждого СтрокаСИЗ Из СтрокаТипаНоменклатуры.МассивСИЗ Цикл
			СтрокаНабора = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНабора, СтрокаСИЗ);
			СтрокаНабора["РабочееМесто"] = Ссылка;
			СтрокаНабора["ТипНоменклатуры"] = СтрокаТипаНоменклатуры.ТипНоменклатуры;
			СтрокаНабора["ПредставлениеПериодичностиВыдачи"] = СредстваИндивидуальнойЗащитыКлиентСервер.ПредставлениеПериодичности(
				СтрокаНабора.КратностьВыдачи, СтрокаНабора.ПериодичностьВыдачи, СтрокаНабора.ЕдиницаПериодичностиВыдачи,
				СтрокаНабора.ЕдиницаИзмерения, СтрокаНабора.Количество, СтрокаНабора.СпособВыдачи);
		КонецЦикла;
	КонецЦикла;
	
	НаборЗаписей.Отбор.РабочееМесто.Установить(Ссылка);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура УстановитьСИЗПослеЗакрытияНаСервере(Форма, РезультатЗакрытия, ДополнительныеПараметры, УстановитьЗаголовокГруппы = Ложь) Экспорт
	
	ТипНоменклатуры = РезультатЗакрытия.ТипНоменклатуры;
	СИЗ = РезультатЗакрытия.СИЗ;
	
	НайденныеСтрокиРабочегоМеста = Форма.НормыВыдачиСИЗ.НайтиСтроки(Новый Структура("ТипНоменклатуры", ТипНоменклатуры));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтрокиРабочегоМеста Цикл
		НайденнаяСтрока.МассивСИЗ = Новый ФиксированныйМассив(СИЗ);
		НайденнаяСтрока.КомандаСИЗ = КраткийСоставСИЗ(НайденнаяСтрока.МассивСИЗ);
	КонецЦикла;
	
	ОбновитьПериодичностьВыдачиСИЗОбъекта(Форма, УстановитьЗаголовокГруппы);
	
	Форма.Модифицированность = Истина;
	
КонецПроцедуры

Процедура ДолжностиПриКопированииНормВыдачи(Форма, Результат, ДополнительныеПараметры) Экспорт
	СкопироватьНормыВыдачиИзДругойДолжности(Форма, Результат);
КонецПроцедуры

