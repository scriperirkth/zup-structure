
#Область СлужебныйПрограммныйИнтерфейс

// См. ОбменСАрхивомПереопределяемыйКлиент.ПродолжитьВыполнениеКомандыПослеПодтверждения.
Процедура ПродолжитьВыполнениеКомандыПослеПодтверждения(
			ДополнительныеПараметры, СтандартнаяОбработка) Экспорт
			
	Если ДополнительныеПараметры.Форма.ИмяФормы = "Обработка.РаботаСФайлами.Форма.ПрисоединенныйФайл" 
		ИЛИ ДополнительныеПараметры.Форма.ИмяФормы = "Справочник.Файлы.Форма.ФормаЭлемента"
		ИЛИ ДополнительныеПараметры.Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		СтандартнаяОбработка = Ложь;
		ИмяКомандыСервер = Неопределено;
		Если Не ДополнительныеПараметры.Команда.ДополнительныеПараметры.Свойство("ИмяКомандыСервер", ИмяКомандыСервер) = Неопределено Тогда
			Результат = Новый Структура;
			СерверныйКонтекст = Новый Структура;
			СерверныйКонтекст.Вставить("ПараметрКоманды", ДополнительныеПараметры.Ссылка);
			СерверныйКонтекст.Вставить("ИмяКомандыВФорме", ИмяКомандыСервер);
			СерверныйКонтекст.Вставить("Результат", Результат);
			
			ИмяКомандыОтправитьВ1САрхив = "";
			Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
				МодульОбменСАрхивомКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбменСАрхивомКлиентСервер");
				ИмяКомандыОтправитьВ1САрхив = МодульОбменСАрхивомКлиентСервер.ИмяКомандыОтправитьВ1САрхив();
			КонецЕсли;
			
			Если ДополнительныеПараметры.Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность"
				И ДополнительныеПараметры.Команда.ДополнительныеПараметры.ИмяКоманды = ИмяКомандыОтправитьВ1САрхив Тогда
				
				Элементы = ДополнительныеПараметры.Форма.Элементы;
				РегламентированныйОтчет = Элементы.Отчеты.ТекущиеДанные.РегламентированныйОтчет;
				
				Если ТипЗнч(РегламентированныйОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет")
					И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеПараметры.Форма, "АдресБланкаPDFВоВременномХранилище")
					И ТипЗнч(ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище) = Тип("СписокЗначений") Тогда
					
					ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище.Очистить();
					
					СписокОтчетов = Новый СписокЗначений;
					СписокОтчетов.Добавить(РегламентированныйОтчет);
					
					ДополнительныеПараметрыПечати = Новый Структура;
					ДополнительныеПараметрыПечати.Вставить("АдресБланкаPDFВоВременномХранилище");
					
					РегламентированнаяОтчетностьКлиент.НапечататьОтчеты(СписокОтчетов, "СформироватьБланкPDF", ДополнительныеПараметрыПечати);
					
					Если ТипЗнч(ДополнительныеПараметрыПечати.АдресБланкаPDFВоВременномХранилище) = Тип("Массив") Тогда
						ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище.ЗагрузитьЗначения(ДополнительныеПараметрыПечати.АдресБланкаPDFВоВременномХранилище);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_ПродолжитьВыполнениеКомандыНаСервере", ДополнительныеПараметры.Форма);
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, СерверныйКонтекст);
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

// См. ОтчетыКлиентПереопределяемый.ОбработкаВыбора.
Процедура ОбработкаВыбора(ФормаОтчета, ВыбранноеЗначение, ИсточникВыбора, РезультатОбработан = Истина) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИсточникВыбора) = Тип("ФормаКлиентскогоПриложения") Тогда 
		
		Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("ОбщаяФорма.СохранениеПечатнойФормы") Тогда

			Если ВыбранноеЗначение = Неопределено Или ВыбранноеЗначение = КодВозвратаДиалога.Отмена Тогда
				Возврат;
			КонецЕсли;
			
			Если ВыбранноеЗначение.ВариантСохранения <> "Присоединить" Тогда
				Возврат;
			КонецЕсли;
			
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("ИмяФормы", ФормаОтчета.ИмяФормы);
			ПараметрыЗаписи.Вставить("Заголовок", ФормаОтчета.Заголовок);
			ПараметрыЗаписи.Вставить("УникальныйИдентификаторХранилища", ФормаОтчета.УникальныйИдентификатор);

			Если ТипЗнч(ФормаОтчета.НастройкиОтчета.ОтчетСсылка) = Тип("СправочникСсылка.ИдентификаторыОбъектовМетаданных")
				ИЛИ ТипЗнч(ФормаОтчета.НастройкиОтчета.ОтчетСсылка) = Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") Тогда
				
				ПечатнаяФорма = ФормаОтчета.ОтчетТабличныйДокумент;
				ПараметрыЗаписи.Вставить("КомпоновщикНастроек", ФормаОтчета.Отчет.КомпоновщикНастроек);
				ПараметрыЗаписи.Вставить("ИдентификаторПечатнойФормы", ФормаОтчета.КлючТекущегоВарианта);
				ПараметрыЗаписи.Вставить("ПолноеИмяОбъектаМетаданных", ФормаОтчета.НастройкиОтчета.ПолноеИмя);
				ПараметрыЗаписи.Вставить("ИдентификаторОбъектаМетаданных", ФормаОтчета.НастройкиОтчета.ОтчетСсылка);
				
				ФайлыВоВременномХранилище = ИнтеграцияС1САрхивомВызовСервера.ПоместитьТабличныйДокументВоВременноеХранилище(ПечатнаяФорма, ПараметрыЗаписи, ВыбранноеЗначение);
				
			Иначе
				Возврат;
			КонецЕсли;
				
			ЗаписанныеОбъекты = ИнтеграцияС1САрхивомВызовСервера.ПрисоединитьПечатныеФормыКОбъекту(ФайлыВоВременномХранилище);
			
			ИнтеграцияС1САрхивомВызовСервера.ЗаписатьСведенияОтчетов1САрхив(ЗаписанныеОбъекты, ПараметрыЗаписи);
			
			Если ВыбранноеЗначение.Подписать Тогда
				Контекст = Новый Структура("ЗаписанныеОбъекты, ВыбранноеЗначение", ЗаписанныеОбъекты, ВыбранноеЗначение);
				ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеПодписанияФайлов", ЭтотОбъект, Контекст);
				ПодписатьЗаписанныеОбъекты(ЗаписанныеОбъекты, ОписаниеОповещения);
			Иначе
				Если ЗаписанныеОбъекты.Количество() > 0 Тогда
					ОповеститьОбИзменении(ТипЗнч(ЗаписанныеОбъекты[0]));
				КонецЕсли;
				Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
					МодульРаботаСФайламиСлужебныйКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("РаботаСФайламиСлужебныйКлиент");
					МодульРаботаСФайламиСлужебныйКлиент.ОповеститьОбИзмененииФайлов(ЗаписанныеОбъекты);
				КонецЕсли;
				
				ПоказатьОповещениеПользователя(, , НСтр("ru = 'Сохранение завершено'"), БиблиотекаКартинок.Информация32);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОтчетыКлиентПереопределяемый.ОбработчикКоманды.
Процедура ОбработчикКоманды(ФормаОтчета, Команда, Результат) Экспорт
	
	Перем ИдентификаторОбъектаМетаданных, ИдентификаторПечатнойФормы, ОтчетТабличныйДокумент;
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ФормаОтчета) = Тип("ФормаКлиентскогоПриложения") И ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		Если Команда.Имя = "СохранитьВФайлыИПодписать" Тогда
			
			Попытка
				ИдентификаторОбъектаМетаданных = ФормаОтчета.НастройкиОтчета.ОтчетСсылка;
				ИдентификаторПечатнойФормы = ФормаОтчета.КлючТекущегоВарианта;
				ОтчетТабличныйДокумент = ФормаОтчета.ОтчетТабличныйДокумент;
			Исключение
				Возврат;
			КонецПопытки;
			
			Если ОтчетТабличныйДокумент.ВысотаТаблицы = 0 Тогда
				Возврат;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИдентификаторПечатнойФормы) И ЗначениеЗаполнено(ИдентификаторОбъектаМетаданных) Тогда
				
				Если ИнтеграцияС1САрхивомВызовСервера.ВидДокументаБИАУстановлен(ИдентификаторПечатнойФормы, ИдентификаторОбъектаМетаданных) Тогда
					
					ДополнительныеПараметры = Новый Структура;
					ДополнительныеПараметры.Вставить("ФормаОтчета", ФормаОтчета);
					ДополнительныеПараметры.Вставить("ИмяКоманды", "СохранитьВФайлыИПодписать");
					Оповещение = Новый ОписаниеОповещения("ПриПодключенииРасширения", ЭтотОбъект, ДополнительныеПараметры);
					ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(Оповещение);

				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьКомандуИнтеграцииС1САрхивом(Файлы, ДополнительныеПараметры) Экспорт
	
	Перем ИмяКоманды;
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбменСАрхивомКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбменСАрхивомКлиент");
	
	Форма = ДополнительныеПараметры.Форма;
	
	Если ДополнительныеПараметры.ОписаниеКоманды.ДополнительныеПараметры.Свойство("ИмяКоманды", ИмяКоманды) Тогда

		Если ИмяКоманды = "Нажатие" Тогда
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,"ТаблицаДокументовБИА") Тогда
				
				КоличествоДокументов = Форма.ТаблицаДокументовБИА.Количество();
				Если Форма.ТаблицаДокументовБИА.Количество() = 0 Тогда
					Возврат;
				КонецЕсли;
				
				Индекс = КоличествоДокументов-1;
				ИндексСтрокой = Формат(Индекс, "ЧГ=;ЧН=");
				ЭлементДокументаБИА = Форма.Элементы.Найти("ИнформацияДокументаБИА"+ИндексСтрокой);
				Если ЭлементДокументаБИА <> Неопределено Тогда
					МодульОбменСАрхивомКлиент.Нажатие(ЭлементДокументаБИА, Форма);
				КонецЕсли;
				
			ИначеЕсли Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда

				ТекущиеДанные = ДополнительныеПараметры.Источник.ТекущиеДанные;

				ТаблицаДокументовБИА = ИнтеграцияС1САрхивомВызовСервера.ДокументыБИАРегламентированногоОтчета(ТекущиеДанные);
				Если Не ТаблицаДокументовБИА = Неопределено И Не ТаблицаДокументовБИА.Количество()= 0 Тогда
					ПоказатьЗначение(, ТаблицаДокументовБИА[0].Документ);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли СтрНачинаетсяС(ИмяКоманды, "СкачатьКонтейнерДокументаИз1САрхива")
			И Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
			
			ДокументБИА = Неопределено;
			ИндексДокументаБИА = Число(СтрЗаменить(ИмяКоманды, "СкачатьКонтейнерДокументаИз1САрхива", ""));

			ТекущиеДанные = ДополнительныеПараметры.Источник.ТекущиеДанные;
			ДокументыБИА = ИнтеграцияС1САрхивомВызовСервера.ДокументыБИАРегламентированногоОтчета(ТекущиеДанные);

			Если Не ДокументыБИА = Неопределено Тогда
				Если ИндексДокументаБИА < ДокументыБИА.Количество() Тогда
					ДокументБИА = ДокументыБИА[ИндексДокументаБИА].Документ;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДокументБИА) Тогда
				МодульОбменСАрхивомКлиент.СкачатьКонтейнерДокумента(ДокументБИА);
			КонецЕсли;
			
		Иначе
			
			ДополнительныеПараметры.ОписаниеКоманды.Вставить("Имя", ДополнительныеПараметры.ОписаниеКоманды.ДополнительныеПараметры.ИмяКоманды);
			МодульОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(ДополнительныеПараметры.ОписаниеКоманды, ДополнительныеПараметры.Форма, ДополнительныеПараметры.Источник);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКомандуИзменитьСведенияОФайле(Файлы, ДополнительныеПараметры) Экспорт
	ИзменитьСведенияОФайлах1САрхивВФормеФайла(Файлы, ДополнительныеПараметры);
КонецПроцедуры

Процедура ИзменитьСведенияОФайлах1САрхивВФормеФайла(Файлы, ДополнительныеПараметры)
	
	ИмяРеквизитаФормы = Неопределено;
	Если ДополнительныеПараметры.ОписаниеКоманды.ДополнительныеПараметры.Свойство("ИмяРеквизитаФормы", ИмяРеквизитаФормы) И ЗначениеЗаполнено(ИмяРеквизитаФормы) Тогда
		
		ДополнительныеПараметры.Вставить("Ссылка", Файлы);
		ДополнительныеПараметры.Вставить("ИмяРеквизитаФормы", ИмяРеквизитаФормы);
		
		Параметры = Новый Структура;
		Параметры.Вставить("Ключ", ДополнительныеПараметры.Форма[ИмяРеквизитаФормы]);
		Параметры.Вставить("РежимВыбора", Истина);
		ТипРеквизита = ТипЗнч(Параметры.Ключ);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
		"ИзменитьСведенияОФайлах1САрхивВФормеФайлаПослеВыбора", ЭтотОбъект, ДополнительныеПараметры);
		
		Если ТипРеквизита = Тип("Дата") Тогда
			ПоказатьВводДаты(ОписаниеОповещения, Параметры.Ключ,, ЧастиДаты.Дата);
		ИначеЕсли ТипРеквизита = Тип("Строка") Тогда
			ПоказатьВводСтроки(ОписаниеОповещения, Параметры.Ключ);
		ИначеЕсли ТипРеквизита = Тип("Булево") Тогда
			ИзменитьСведенияОФайлах1САрхивВФормеФайлаПослеВыбора(Не Параметры.Ключ, ДополнительныеПараметры);
		ИначеЕсли ТипРеквизита = Тип("СправочникСсылка.ВидыДокументовБИА") Тогда
			ОткрытьФорму("Справочник.ВидыДокументовБИА.ФормаВыбора", Параметры, ДополнительныеПараметры.Форма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли ТипРеквизита = Тип("СправочникСсылка.Организации") Тогда
			ОткрытьФорму("Справочник.Организации.ФормаВыбора", Параметры, ДополнительныеПараметры.Форма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ИзменитьСведенияОФайлах1САрхивВФормеФайлаПослеВыбора(Результат, ДополнительныеПараметры) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Форма = ДополнительныеПараметры.Форма;
		Форма[ДополнительныеПараметры.ИмяРеквизитаФормы] = Результат;

		ИмяКомандыСервер = Неопределено;
		Если Не ДополнительныеПараметры.ОписаниеКоманды.ДополнительныеПараметры.Свойство("ИмяКомандыСервер", ИмяКомандыСервер) = Неопределено Тогда
			Результат = Новый Структура;
			СерверныйКонтекст = Новый Структура;
			СерверныйКонтекст.Вставить("ПараметрКоманды", ДополнительныеПараметры.Ссылка);
			СерверныйКонтекст.Вставить("ИмяКомандыВФорме", ИмяКомандыСервер);
			СерверныйКонтекст.Вставить("Результат", Результат);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_ПродолжитьВыполнениеКомандыНаСервере", ДополнительныеПараметры.Форма);
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, СерверныйКонтекст);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Процедура ПриПодключенииРасширения(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("ФормаОтчета") И ДополнительныеПараметры.Свойство("ИмяКоманды") 
		И ДополнительныеПараметры.ИмяКоманды = "СохранитьВФайлыИПодписать" Тогда

		РасширениеДляРаботыСФайламиПодключено = РасширениеПодключено;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОбъектыПечати", ИнтеграцияС1САрхивомВызовСервера.ОбъектыПечати());
		ПараметрыФормы.Вставить("РасширениеДляРаботыСФайламиПодключено", РасширениеДляРаботыСФайламиПодключено);
		ОткрытьФорму("ОбщаяФорма.СохранениеПечатнойФормы", ПараметрыФормы, ДополнительныеПараметры.ФормаОтчета);
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗавершениеПодписанияФайлов(Результат, Контекст) Экспорт
	Если Результат = Ложь Тогда
		Возврат;
	КонецЕсли;
	ЗаписанныеОбъекты = Контекст.ЗаписанныеОбъекты;

	Если ЗаписанныеОбъекты.Количество() > 0 Тогда
		ОповеститьОбИзменении(ТипЗнч(ЗаписанныеОбъекты[0]));
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайламиСлужебныйКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("РаботаСФайламиСлужебныйКлиент");
		МодульРаботаСФайламиСлужебныйКлиент.ОповеститьОбИзмененииФайлов(ЗаписанныеОбъекты);
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(, , НСтр("ru = 'Сохранение и подписание завершено'"), БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

Процедура ПодписатьЗаписанныеОбъекты(ЗаписанныеОбъекты, ОповещениеЗавершенияПодписания)
	ДополнительныеПараметры = Новый Структура("ОбработкаРезультата", ОповещениеЗавершенияПодписания);
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайламиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("РаботаСФайламиКлиент");
		МодульРаботаСФайламиКлиент.ПодписатьФайл(ЗаписанныеОбъекты, Новый УникальныйИдентификатор, ДополнительныеПараметры);
	КонецЕсли;
КонецПроцедуры

Процедура ПечатьДокументовОбработкаОповещения(Форма, ИмяСобытия, Параметр, Источник) Экспорт
	
	Если ИмяСобытия = "Запись_Файл" Или ИмяСобытия = "ЗаписьПечатныхФормСЭЦП" Тогда
		
		Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
			Возврат;
		КонецЕсли;
		
		Если Форма.ИмяФормы = "ОбщаяФорма.ПечатьДокументов" Тогда
			ИнтеграцияС1САрхивомВызовСервера.ЗаписатьСведенияПечатнойФормы1САрхив(Источник, Форма.НастройкиПечатныхФорм, Форма.ОбъектыПечати, Форма.Параметры, Параметр);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
