//
Процедура ЗаполнитьДоступныеОрганизацииДляОтбора(Результат, Организация, ПравоНаИзменение) Экспорт
	
	ДоступныеОрганизации = ОрганизацииДанныеКоторыхДоступныПользователю("РегистрСведений.ЗадачиБухгалтера", ПравоНаИзменение);
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		
		Результат = ДоступныеОрганизации;
		
	ИначеЕсли ДоступныеОрганизации.Найти(Организация) <> Неопределено Тогда
		
		Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
		
	КонецЕсли;
	
