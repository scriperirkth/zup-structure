// Возвращает параметры вызова rest-метода для чтения всех сведений медицинского работника.
//
// Параметры:
//  oid - Строка - идентификатор организации в ЕГИСЗ.
//  salaryPeriodType - Число - Тип периода заработной платы:
//                             1 – Период фактических показателей.
//                             2 – Период плановых показателей.
// 
// Возвращаемое значение:
//  Структура - см. описание функции МедицинскиеРегистры.ПараметрыВызоваМетода.
//
Функция GetSalaryPeriod(oid, salaryPeriodType, offset, limit) Экспорт 
	
	Шаблон = "org/salaryPeriod?oid=%1&salaryPeriodType=%2&offset=%3&limit=%4";
	ПараметрыВызоваМетода = МедицинскиеРегистры.ПараметрыВызоваМетода();
	ПараметрыВызоваМетода.Метод = "GET";
	ПараметрыВызоваМетода.Команда = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		Шаблон, 
		oid, Формат(salaryPeriodType, "ЧГ=0; ЧН="), Формат(offset, "ЧГ=0; ЧН="), Формат(limit, "ЧГ=0; ЧН=")
		);	
	Возврат ПараметрыВызоваМетода;	      	
    
КонецФункции

// Возвращает параметры вызова rest-метода для создания (create) 
// или обновления (update) сведений о периоде заработной платы.
//
// Параметры:
//  oid - Строка - идентификатор организации в ЕГИСЗ.
//  entityId - Строка(36) – Идентификатор (GUID) записи блока данных о периоде заработной платы,
//                          которые необходимо изменить методом PUT (update)
//                          Для метода POST (create) оставлять в значении Неопределено.
//  SalaryPeriodData - Структура - Данные периода заработной платы.
// 
// Возвращаемое значение:
//  Структура - см. описание функции МедицинскиеРегистрыКлиентСервер.ПараметрыВызоваМетода.
//
Функция PostPutSalaryPeriod(oid, entityId, SalaryPeriodData) Экспорт 
	
	ПозицияШР = Новый Массив;
	МедицинскиеРегистры.ДобавитьЭлементJSON(ПозицияШР, "staffId", SalaryPeriodData.staff.staffId, "Строка"); 
	
	ЭлементыJSON = Новый Массив;
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "salaryPeriodType", SalaryPeriodData.salaryPeriodType, "Число"); 
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "periodDate", SalaryPeriodData.periodDate, "ДатаUTC");
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "staff", "{" + СтрСоединить(ПозицияШР, ",") + "}", "JSON"); 
	ЗаписьJSON = "{" + СтрСоединить(ЭлементыJSON, ",") + "}";
	
	ПараметрыВызоваМетода = МедицинскиеРегистры.ПараметрыВызоваМетода();
	Если ПустаяСтрока(entityId) Тогда 
		ПараметрыВызоваМетода.Метод = "POST";
		ПараметрыВызоваМетода.Команда = "org/salaryPeriod?oid=" + oid;
	Иначе 
		ПараметрыВызоваМетода.Метод = "PUT";
		ПараметрыВызоваМетода.Команда = "org/salaryPeriod?oid=" + oid + "&entityId=" + entityId;
	КонецЕсли;
	ПараметрыВызоваМетода.Тело = ЗаписьJSON;
	
	Возврат ПараметрыВызоваМетода;	      	
    
КонецФункции

// Возвращает параметры вызова rest-метода для создания (create) 
// или обновления (update) записи заработной платы.
//
// Параметры:
//  oid - Строка - идентификатор организации в ЕГИСЗ.
//  entityId - Строка(36) – Идентификатор (GUID) записи блока данных записи заработной платы,
//                          которые необходимо изменить методом PUT (update)
//                          Для метода POST (create) оставлять в значении Неопределено.
//  SalaryPeriodRecordData - Структура - Данные записи заработной платы.
// 
// Возвращаемое значение:
//  Структура - см. описание функции МедицинскиеРегистрыКлиентСервер.ПараметрыВызоваМетода.
//
Функция PostPutSalaryPeriodRecord(oid, entityId, SalaryPeriodRecordData) Экспорт 
	
	ЭлементыНачисленияУдержания = Новый Массив;
	Если ТипЗнч(SalaryPeriodRecordData.financingSources)=Тип("Массив") Тогда 
		Для Каждого ДанныеНачисленияУдержания Из SalaryPeriodRecordData.financingSources Цикл
			ЭлементыJSON = Новый Массив;
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "financingSourceId", ДанныеНачисленияУдержания.financingSourceId, "Строка"); 
			
			ЭлементыТипИсточника = Новый Массив;
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыТипИсточника, "code", ДанныеНачисленияУдержания.financingSource.code, "Число"); 
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыТипИсточника, "name", ДанныеНачисленияУдержания.financingSource.name, "Строка"); 
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "financingSource", "{" + СтрСоединить(ЭлементыТипИсточника, ",") + "}", "JSON"); 
			
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "financingSourceType", ДанныеНачисленияУдержания.financingSourceType, "Число"); 

			ЭлементыНазначениеНачисления = Новый Массив;
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыНазначениеНачисления, "code", ДанныеНачисленияУдержания.accrualPurpose.code, "Число"); 
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыНазначениеНачисления, "name", ДанныеНачисленияУдержания.accrualPurpose.name, "Строка"); 
			Если ЭлементыНазначениеНачисления.Количество()>0 Тогда 
				МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "accrualPurpose", "{" + СтрСоединить(ЭлементыНазначениеНачисления, ",") + "}", "JSON"); 
			КонецЕсли;
		
			ЭлементыНазначениеУдержания = Новый Массив;
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыНазначениеУдержания, "code", ДанныеНачисленияУдержания.retentionPurpose.code, "Число"); 
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыНазначениеУдержания, "name", ДанныеНачисленияУдержания.retentionPurpose.name, "Строка"); 
			Если ЭлементыНазначениеУдержания.Количество()>0 Тогда 
				МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "retentionPurpose", "{" + СтрСоединить(ЭлементыНазначениеУдержания, ",") + "}", "JSON"); 
			КонецЕсли;

			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "accrual", ДанныеНачисленияУдержания.accrual, "Число", 2); 
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "retention", ДанныеНачисленияУдержания.retention, "Число", 2); 
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "overtimeHours", ДанныеНачисленияУдержания.overtimeHours, "Число", 2); 
			МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "overtimePayment", ДанныеНачисленияУдержания.overtimePayment, "Число", 2); 
			
			ЭлементыНачисленияУдержания.Добавить("{" + СтрСоединить(ЭлементыJSON, ",") + "}");
		КонецЦикла;	
	КонецЕсли;

	ЭлементыJSON = Новый Массив;
	
	ЭлементыПериодаЗП = Новый Массив;
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыПериодаЗП, "salaryPeriodId", SalaryPeriodRecordData.salaryPeriod.salaryPeriodId, "Строка"); 
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыПериодаЗП, "salaryPeriodType", SalaryPeriodRecordData.salaryPeriod.salaryPeriodType, "Число"); 
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыПериодаЗП, "periodDate", SalaryPeriodRecordData.salaryPeriod.periodDate, "ДатаUTC"); 
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "salaryPeriod", "{" + СтрСоединить(ЭлементыПериодаЗП, ",") + "}", "JSON"); 
	
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "departId", SalaryPeriodRecordData.departId, "Строка"); 
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "subdivisionId", SalaryPeriodRecordData.subdivisionId, "Строка"); 
	
	ЭлементыДолжности = Новый Массив;
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыДолжности, "code", SalaryPeriodRecordData.postFedCode.code, "Число"); 
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыДолжности, "name", SalaryPeriodRecordData.postFedCode.name, "Строка"); 
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "postFedCode", "{" + СтрСоединить(ЭлементыДолжности, ",") + "}", "JSON"); 
	
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "personalFileNumber", SalaryPeriodRecordData.personalFileNumber, "Строка");
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "personCardId", SalaryPeriodRecordData.personCardId, "Строка");
	МедицинскиеРегистры.ДобавитьЭлементJSON(ЭлементыJSON, "financingSources", "[" + СтрСоединить(ЭлементыНачисленияУдержания, ",") + "]", "JSON"); 
	ЗаписьJSON = "{" + СтрСоединить(ЭлементыJSON, ",") + "}";
	
	ПараметрыВызоваМетода = МедицинскиеРегистры.ПараметрыВызоваМетода();
	Если ПустаяСтрока(entityId) Тогда 
		ПараметрыВызоваМетода.Метод = "POST";
		ПараметрыВызоваМетода.Команда = "org/salaryPeriodRecord?oid=" + oid;
	Иначе 
		ПараметрыВызоваМетода.Метод = "PUT";
		ПараметрыВызоваМетода.Команда = "org/salaryPeriodRecord?oid=" + oid + "&entityId=" + entityId;
	КонецЕсли;
	ПараметрыВызоваМетода.Тело = ЗаписьJSON;
	
	Возврат ПараметрыВызоваМетода;	      	
    
КонецФункции


// Конструктор структуры данных о периоде заработной платы.
// 
// Возвращаемое значение:
//  Структура - параметры, необходимые для вызова метода сервиса REST.
//  	salaryPeriodId - Строка(GUID) – Идентификатор периода заработной платы.
//                                      Только для обновления существующих записей метод PUT.
//  	salaryPeriodType - Число – Тип периода заработной платы: 
//                                 1 – Период фактических показателей.
//                                 2 – Период плановых показателей.
//  	periodDate - Дата(ISO8601) – Отчетный период. Минимальное значение 01.01.2018.
//                                   Пример заполнения ГГГГ-ММ-01.
//                                   Для фактических показателей можно указывать дату только предыдущих месяцев.
//  	staff - Объект – Данные штатного расписания:
//  	                 staffId - Строка – Идентификатор штатного расписания (GUID).
//
Функция SalaryPeriodData() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("salaryPeriodId", Неопределено);
	Результат.Вставить("salaryPeriodType", Неопределено);
	Результат.Вставить("periodDate", Неопределено);
	Результат.Вставить("staff", Новый Структура("staffId", Неопределено));
	Возврат Результат;
КонецФункции

// Конструктор структуры данных о записи заработной платы.
// 
// Возвращаемое значение:
//  Структура - параметры, необходимые для вызова метода сервиса REST.
//  	salaryPeriodRecordId - Строка(GUID) – Идентификатор записи заработной платы.
//                                            Только для обновления существующих записей метод PUT.
//  	salaryPeriod - Объект – Период заработной платы записи:
//  	                 salaryPeriodId - Строка – Идентификатор периода ЗП (GUID).
//  	                 salaryPeriodType - Число – Тип периода заработной платы:
//                                                  1 – Период фактических показателей.
//                                                  2 – Период плановых показателей.
//  	                 periodDate - Дата(ISO8601) – Отчетный период. Минимальное значение 01.01.2018.
//                                                    Пример заполнения ГГГГ-ММ-01.
//                                                    Для фактических показателей можно указывать дату только предыдущих месяцев.
//  	departId - Строка – OID структурного подразделения.
//  	subdivisionId - Строка – OID отделения стационара (заполняется только для стационаров).
//  	postFedCode.code - Число – Код должности по Федеральному справочнику (1.2.643.5.1.13.13.99.2.885).
//  	postFedCode.name - Строка – Наименование должности по Федеральному справочнику (1.2.643.5.1.13.13.99.2.885).
//  	personalFileNumber - Строка – Идентификатор занятости (только для фактических показателей). "AABBBBBCCCCCCCC": 
//                                    A - код региона, 
//                                    B - код должности по федеральному справочнику 885, 
//                                    C - порядковый номер записи ЛД в рамках региона.
//  	personCardId - Строка – Идентификатор личного дела (в записях для позиций ШР не заполняется).
//  	financingSources - Массив объектов – Источники финансирования (см. Функция FinancingSourceData). 
//
Функция SalaryPeriodRecordData() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("salaryPeriodRecordId", Неопределено);
	Результат.Вставить("salaryPeriod", Новый Структура("salaryPeriodId,salaryPeriodType,periodDate", Неопределено, Неопределено, Неопределено));
	Результат.Вставить("departId", Неопределено);
	Результат.Вставить("subdivisionId", Неопределено);
	Результат.Вставить("postFedCode", Новый Структура("code,name", Неопределено, Неопределено));
	Результат.Вставить("personalFileNumber", Неопределено);
	Результат.Вставить("personCardId", Неопределено); 
	Результат.Вставить("financingSources", Неопределено); 
	Возврат Результат;
КонецФункции

// Конструктор структуры данных об источнике финансирования.
// 
// Возвращаемое значение:
//  Структура - параметры, необходимые для вызова метода сервиса REST.
//  	financingSourceId - Строка(GUID) – Идентификатор записи источника финансирования. 
//                                         Только для обновления существующих записей метод PUT.
//  	financingSource.code - Число – Идентификатор источника финансирования по Федеральному справочнику (1.2.643.5.1.13.13.99.2.1105).
//  	financingSource.name - Строка – Наименование источника финансирования по Федеральному справочнику (1.2.643.5.1.13.13.99.2.1105).
//                                      Не обязательно к заполнению. 
//  	financingSourceType - Число – Тип источника финансирования: 
//                                 1 – Начисление.
//                                 2 – Удержание.
//  	accrualPurpose.code - Число – Идентификатор назначения начисления по Федеральному справочнику (1.2.643.5.1.13.13.99.2.1106).
//                                    Заполняется только, если financingSourceType = 1.
//  	accrualPurpose.name - Строка – Наименование назначения начисления по Федеральному справочнику (1.2.643.5.1.13.13.99.2.1106).
//                                     Не обязательно к заполнению. Заполняется только, если financingSourceType = 1
//  	retentionPurpose.code - Число – Идентификатор назначения удержания по Федеральному справочнику (1.2.643.5.1.13.13.99.2.1107).
//                                    Заполняется только, если financingSourceType = 2.
//  	retentionPurpose.name - Строка – Наименование назначения удержания по Федеральному справочнику (1.2.643.5.1.13.13.99.2.1107).
//                                     Не обязательно к заполнению. Заполняется только, если financingSourceType = 2
//  	accrual - Число – Начисление. Сумма в рублях, число с 2 знаками после запятой. Минимальное значение 0,01.
//                        Заполняется только, если financingSourceType = 1.
//  	retention - Число – Удержание. Сумма в рублях, число с 2 знаками после запятой. Минимальное значение 0,01.
//                          Заполняется только, если financingSourceType = 2.
//  	overtimeHours - Число – Количество часов переработок. Дробное число с 2 знаками после запятой.
//                              Не обязательно к заполнению.
//  	overtimePayment - Число – Выплата по переработкам. Сумма в рублях, число с 2 знаками после запятой. Минимальное значение 0,01.
//                                Не обязательно к заполнению.
//
Функция FinancingSourceData() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("financingSourceId", Неопределено);
	Результат.Вставить("financingSource", Новый Структура("code,name", Неопределено, Неопределено));
	Результат.Вставить("financingSourceType", Неопределено);
	Результат.Вставить("accrualPurpose", Новый Структура("code,name", Неопределено, Неопределено));
	Результат.Вставить("retentionPurpose", Новый Структура("code,name", Неопределено, Неопределено));
	Результат.Вставить("accrual", Неопределено);
	Результат.Вставить("retention", Неопределено);
	Результат.Вставить("overtimeHours", Неопределено);
	Результат.Вставить("overtimePayment", Неопределено);
	Возврат Результат;
КонецФункции

