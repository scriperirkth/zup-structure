
////////////////////////////////////////////////////////////////////////////////
// Общий модуль для работы с виджетами.
//
////////////////////////////////////////////////////////////////////////////////
#Область ПрограммныйИнтерфейс

// Создает элементы группы виджетов на форме
//
// Параметры:
//  Форма			 - ФормаКлиентскогоПриложения - форма, на котору будут дабевлены виджеты
//  ГруппаВиджетов	 - СправочникСсылка.ГруппыВиджетов
//  ИмяРодителя		 - Строка - Имя элемента формы, куда будут добавлены виджеты
//
Процедура СоздатьГруппуВиджетов(Форма, ГруппаВиджетов, ИмяРодителя = "") Экспорт
	
	ИнициализироватьРеквизитыФормы(Форма);
	
	ДанныеГруппыВиджетов = Справочники.ГруппыВиджетов.ДанныеГруппыВиджетов(ГруппаВиджетов, ИмяРодителя);
	
	Для Каждого ЭлементГруппыВиджетов Из ДанныеГруппыВиджетов.Элементы Цикл
		СоздатьЭлементГруппыВиджетов(Форма, ДанныеГруппыВиджетов, ЭлементГруппыВиджетов);
	КонецЦикла;
	
	ОсновнаяГруппаВиджета = Форма.Элементы.Найти("КолонкиВиджетов");
	Если ОсновнаяГруппаВиджета <> Неопределено Тогда
		ОсновнаяГруппаВиджета.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
		ОсновнаяГруппаВиджета.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	КонецЕсли;
	
КонецПроцедуры

// Удаляет элементы группы виджетов на форме
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения - форма, на котору будут дабевлены виджеты
//
Процедура УдалитьГруппуВиджетов(Форма) Экспорт
	
	ОсновнаяГруппаВиджета = Форма.Элементы.Найти("КолонкиВиджетов");
	
	Если ОсновнаяГруппаВиджета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомандыВиджета = КомандыВиджета(Форма, ОсновнаяГруппаВиджета);
	
	Форма.Элементы.Удалить(ОсновнаяГруппаВиджета);
	
	Для Каждого КомандаВиджета Из КомандыВиджета Цикл
		Форма.Команды.Удалить(Форма.Команды[КомандаВиджета]);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЭлементГруппыВиджетов(Форма, ДанныеГруппыВиджетов, ЭлементГруппыВиджетов)
	
	Родитель = РодительЭлементаГруппыВиджетов(Форма, ДанныеГруппыВиджетов, ЭлементГруппыВиджетов);
	
	Если ЭлементГруппыВиджетов.ЭтоГруппа Тогда
		
		СозданныйЭлемент = ДобавитьОбычнуюГруппу(Форма, ЭлементГруппыВиджетов.Имя, Родитель);
		Если ЭлементГруппыВиджетов.Группировка <> Неопределено Тогда
			СозданныйЭлемент.Группировка = ЭлементГруппыВиджетов.Группировка;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ЭлементГруппыВиджетов.Виджет) Тогда
		
		СозданныйЭлемент = СоздатьВиджет(Форма, ЭлементГруппыВиджетов, Родитель);
		
	КонецЕсли;
	
	ЭлементГруппыВиджетов.ЭлементФормы = СозданныйЭлемент;
	
	Возврат ЭлементГруппыВиджетов;
	
КонецФункции

Функция РодительЭлементаГруппыВиджетов(Форма, ДанныеГруппыВиджетов, ЭлементГруппыВиджетов)
	
	Если Не ЗначениеЗаполнено(ЭлементГруппыВиджетов.Родитель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЭлементРодитель = ДанныеГруппыВиджетов.Элементы.Найти(ЭлементГруппыВиджетов.Родитель, "Имя");
	
	ЭлементФормы = ?(ЭлементРодитель = Неопределено, 
		Форма.Элементы.Найти(ЭлементГруппыВиджетов.Родитель), 
		ЭлементРодитель.ЭлементФормы);
	
	Если ЭлементФормы = Неопределено Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не найден родитель ""%1"" элемента рабочего стола ""%2"".'"), 
			ЭлементГруппыВиджетов.Родитель, ЭлементГруппыВиджетов.Имя);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат ЭлементФормы;
	
КонецФункции

Функция КомандыВиджета(Форма, ОсновнаяГруппаВиджета)
	
	МассивКоманд = Новый Массив;
	Если ТипЗнч(ОсновнаяГруппаВиджета) = Тип("ГруппаФормы") Тогда
		НайтиКомандыВиджетаРекурсивно(ОсновнаяГруппаВиджета.ПодчиненныеЭлементы, МассивКоманд);
	КонецЕсли;
	
	Возврат МассивКоманд;
	
КонецФункции

Процедура НайтиКомандыВиджетаРекурсивно(ЭлементыФормы, МассивКоманд)
	
	Для Каждого Элемент Из ЭлементыФормы Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента = Тип("ГруппаФормы") Тогда
			НайтиКомандыВиджетаРекурсивно(Элемент.ПодчиненныеЭлементы, МассивКоманд);
		ИначеЕсли ТипЭлемента = Тип("КнопкаФормы") И ЗначениеЗаполнено(Элемент.ИмяКоманды) Тогда
			МассивКоманд.Добавить(Элемент.ИмяКоманды);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьВиджет(Форма, ЭлементГруппыВиджетов, Родитель)
	
	ГруппаВиджета = СоздатьОсновнуюГруппы(Форма, ЭлементГруппыВиджетов, Родитель);
	ГруппаВиджета.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
	СоздатьВстроенныйЗаголовок(Форма, ЭлементГруппыВиджетов, ГруппаВиджета);
	
	СоздатьВиджетСписок(Форма, ЭлементГруппыВиджетов, ГруппаВиджета);
	
	СоздатьПодвал(Форма, ЭлементГруппыВиджетов, ГруппаВиджета);
	
КонецФункции

Функция ВычислитьЗначениеВыражения(Форма, Выражение)
	
	Параметры = Новый Структура("Результат, Форма", Неопределено, Форма);
	
	ОбщегоНазначения.ВыполнитьВБезопасномРежиме(Выражение, Параметры);
	
	Возврат Параметры.Результат;
	
КонецФункции

#Область РаботаСФормами

Функция ДобавитьОбычнуюГруппу(Форма, Имя, Родитель)
	
	СозданныйЭлемент = Форма.Элементы.Вставить(Имя, Тип("ГруппаФормы"), Родитель);
	СозданныйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	СозданныйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СозданныйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	СозданныйЭлемент.ОтображатьЗаголовок = Ложь;
	
	Возврат СозданныйЭлемент;
	
КонецФункции

Функция СоздатьОсновнуюГруппы(Форма, ЭлементГруппыВиджетов, Родитель)
	
	КонтейнерВиджета = ДобавитьОбычнуюГруппу(Форма, ЭлементГруппыВиджетов.Имя + "Контейнер", Родитель);
	КонтейнерВиджета.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонтейнерВиджета.Высота = ЭлементГруппыВиджетов.ДанныеВиджета.Высота;
	КонтейнерВиджета.Ширина = ЭлементГруппыВиджетов.ДанныеВиджета.Ширина;
	КонтейнерВиджета.ЦветФона = ЭлементГруппыВиджетов.ДанныеВиджета.Цвет;
	КонтейнерВиджета.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Одинарный;
	КонтейнерВиджета.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Одинарный;
	
	Возврат КонтейнерВиджета;
	
КонецФункции

Функция СоздатьВстроенныйЗаголовок(Форма, ЭлементГруппыВиджетов, Родитель)
	
	ИмяКомандыФормы = "КомандаЗаголовка" + ЭлементГруппыВиджетов.Имя;
	СозданнаяКоманда = СоздатьКоманду(Форма, ИмяКомандыФормы, ЭлементГруппыВиджетов.ДанныеВиджета, "ПоказательЗаголовка");
	СозданныйЭлемент = СоздатьКнопкуЗаголовка(Форма, ЭлементГруппыВиджетов, СозданнаяКоманда.Имя, Родитель);
	СозданныйЭлемент.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
	СозданныйЭлемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	
	Возврат СозданныйЭлемент;
	
КонецФункции

Функция СоздатьКоманду(Форма, ИмяКомандыФормы, ДанныеВиджета, ИмяПоказателя)
	
	СозданнаяКоманда = Форма.Команды.Добавить(ИмяКомандыФормы);
	СозданнаяКоманда.Действие = "Подключаемый_КомандаВиджета";
	СозданнаяКоманда.Заголовок = ДанныеВиджета.Наименование;
	СозданнаяКоманда.Подсказка = ДанныеВиджета.Наименование;
	
	ПоказательВиджета = ДанныеВиджета[ИмяПоказателя];
	НоваяСтрока = Форма.ТаблицаДействийВиджетов.Добавить();
	НоваяСтрока.ИмяКоманды = ИмяКомандыФормы;
	НоваяСтрока.ДействиеВиджета = ПоказательВиджета.Действие;
	НоваяСтрока.ПараметрПерехода = ПоказательВиджета.Источник;
	НоваяСтрока.АлгоритмДействия = ПоказательВиджета.АлгоритмДействия;
	НоваяСтрока.Заголовок = ДанныеВиджета.Наименование;
	
	Возврат СозданнаяКоманда;
	
КонецФункции

Функция СоздатьКнопкуЗаголовка(Форма, ЭлементГруппыВиджетов, ИмяКомандыФормы, Родитель)
	
	ПоказательЗаголовка = ЭлементГруппыВиджетов.ДанныеВиджета.ПоказательЗаголовка;
	ИмяЭлемента = "КнопкаЗаголовка" + ЭлементГруппыВиджетов.Имя;
	СозданныйЭлемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("КнопкаФормы"), Родитель);
	СозданныйЭлемент.ИмяКоманды = ИмяКомандыФормы;
	СозданныйЭлемент.ОтображениеФигуры = ОтображениеФигурыКнопки.Нет;
	СозданныйЭлемент.Шрифт = ПоказательЗаголовка.Шрифт;
	
	Если ЗначениеЗаполнено(ПоказательЗаголовка.Выражение) Тогда
		МассивЗаголовка = Новый Массив;
		Если ЗначениеЗаполнено(ЭлементГруппыВиджетов.ДанныеВиджета.Наименование) Тогда
			МассивЗаголовка.Добавить(ЭлементГруппыВиджетов.ДанныеВиджета.Наименование);
		КонецЕсли;
		
		ЗначениеПоказателя = ВычислитьЗначениеВыражения(Форма, ПоказательЗаголовка.Выражение); 
		МассивЗаголовка.Добавить(ЗначениеПоказателя);
		
		СозданныйЭлемент.Заголовок = СтрСоединить(МассивЗаголовка, ": ");
	КонецЕсли;
	
	Возврат СозданныйЭлемент;

КонецФункции

Функция СоздатьКнопкуПодвала(Форма, ЭлементГруппыВиджетов, ИмяКомандыФормы, Родитель)
	
	ПоказательПодвала = ЭлементГруппыВиджетов.ДанныеВиджета.ПоказательПодвала;
	ИмяЭлемента = "КнопкаПодвала" + ЭлементГруппыВиджетов.Имя;
	СозданныйЭлемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("КнопкаФормы"), Родитель);
	СозданныйЭлемент.ИмяКоманды = ИмяКомандыФормы;
	СозданныйЭлемент.ОтображениеФигуры = ОтображениеФигурыКнопки.Нет;
	СозданныйЭлемент.Шрифт = ПоказательПодвала.Шрифт;
	
	Если ЗначениеЗаполнено(ПоказательПодвала.Выражение) Тогда
		ЗначениеПоказателя = ВычислитьЗначениеВыражения(Форма, ПоказательПодвала.Выражение);
		СозданныйЭлемент.Заголовок = ЗначениеПоказателя;
	КонецЕсли;
	
	Возврат СозданныйЭлемент;

КонецФункции

Процедура СоздатьВиджетСписок(Форма, ЭлементГруппыВиджетов, Родитель)
	
	Если ЭлементГруппыВиджетов.ДанныеВиджета.ОсновныеПоказатели.Количество() > 0 Тогда
		МаксимальноеКоличествоЗначений = ЭлементГруппыВиджетов.ДанныеВиджета.КоличествоСтрок;
		КоличествоЭлементов = 0;
		Для Каждого Стр Из ЭлементГруппыВиджетов.ДанныеВиджета.ОсновныеПоказатели Цикл
			
			ДанныеСписка = ВычислитьЗначениеВыражения(Форма, Стр.Выражение);
			Если ТипЗнч(ДанныеСписка) = Тип("Массив") Тогда
				Для Каждого СтрокаДанных Из ДанныеСписка Цикл
					КоличествоЭлементов = КоличествоЭлементов + 1;
					ИмяГруппы = СтрШаблон("%1Группа%2", ЭлементГруппыВиджетов.Имя, КоличествоЭлементов);
					ГруппаСтроки = ДобавитьОбычнуюГруппу(Форма, ИмяГруппы, Родитель);
					ГруппаСтроки.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
					ГруппаСтроки.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
					
					ИмяКомандыФормы = ИмяГруппы + "Команда";
					СозданнаяКоманда = Форма.Команды.Добавить(ИмяКомандыФормы);
					СозданнаяКоманда.Действие = "Подключаемый_КомандаВиджета";
					СозданнаяКоманда.Заголовок = СтрокаДанных.Наименование;
					СозданнаяКоманда.Подсказка = СтрокаДанных.Наименование;
					
					НоваяСтрока = Форма.ТаблицаДействийВиджетов.Добавить();
					НоваяСтрока.ИмяКоманды = ИмяКомандыФормы;
					НоваяСтрока.ДействиеВиджета = Стр.Действие;
					НоваяСтрока.ПараметрПерехода = ПолучитьНавигационнуюСсылку(СтрокаДанных.Ссылка);
					НоваяСтрока.АлгоритмДействия = Стр.АлгоритмДействия;
					НоваяСтрока.Заголовок = ЭлементГруппыВиджетов.ДанныеВиджета.Наименование;
					
					ИмяЭлемента = ИмяГруппы + "Кнопка";
					СозданныйЭлемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("КнопкаФормы"), ГруппаСтроки);
					СозданныйЭлемент.ИмяКоманды = ИмяКомандыФормы;
					СозданныйЭлемент.ОтображениеФигуры = ОтображениеФигурыКнопки.Нет;
					СозданныйЭлемент.Шрифт = Стр.Шрифт;
					СозданныйЭлемент.Заголовок = СтрокаДанных.Наименование;
					СозданныйЭлемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
					
					Если КоличествоЭлементов >= МаксимальноеКоличествоЗначений Тогда 
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьРеквизитыФормы(Форма)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ТаблицаДействийВиджетов") Тогда
		Форма.ТаблицаДействийВиджетов.Очистить();
		Возврат;
	КонецЕсли;
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыйРеквизит = Новый РеквизитФормы("ТаблицаДействийВиджетов", Новый ОписаниеТипов("ТаблицаЗначений"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	ДобавляемыйРеквизит = Новый РеквизитФормы("ИмяКоманды", Новый ОписаниеТипов("Строка"), "ТаблицаДействийВиджетов");
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	ДобавляемыйРеквизит = Новый РеквизитФормы("ДействиеВиджета", Новый ОписаниеТипов("ПеречислениеСсылка.ДействияВиджетов"), "ТаблицаДействийВиджетов");
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	ДобавляемыйРеквизит = Новый РеквизитФормы("ПараметрПерехода", Новый ОписаниеТипов("Строка"), "ТаблицаДействийВиджетов");
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	ДобавляемыйРеквизит = Новый РеквизитФормы("АлгоритмДействия", Новый ОписаниеТипов("Строка"), "ТаблицаДействийВиджетов");
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	ДобавляемыйРеквизит = Новый РеквизитФормы("Заголовок", Новый ОписаниеТипов("Строка"), "ТаблицаДействийВиджетов");
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

Функция СоздатьПодвал(Форма, ЭлементГруппыВиджетов, Родитель)
	
	Если Не ЗначениеЗаполнено(ЭлементГруппыВиджетов.ДанныеВиджета.ПоказательПодвала.Выражение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяКомандыФормы = "КомандаПодвала" + ЭлементГруппыВиджетов.Имя;
	СозданнаяКоманда = СоздатьКоманду(Форма, ИмяКомандыФормы, ЭлементГруппыВиджетов.ДанныеВиджета, "ПоказательПодвала");
	СозданныйЭлемент = СоздатьКнопкуПодвала(Форма, ЭлементГруппыВиджетов, СозданнаяКоманда.Имя, Родитель);
	СозданныйЭлемент.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	СозданныйЭлемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
	
	Возврат СозданныйЭлемент;
	
КонецФункции

