//     * Представление - Строка - представление команды в интерфейсе.
//     * Серверная - Булево - (необязательный) - признак вызова контекстного серверного метода для выполнения команды.
//         - если Истина, то код обработчика должен быть описан в модуле ПроцессыОбработкиДокументовПереопределяемый
//         - если Ложь или не указан, то код обработчика должен быть описан в модуле ПроцессыОбработкиДокументовКлиентПереопределяемый
//     * Картинка - Картинка - (необязательный) - картинка команды
//
// Пример:
//   НоваяКоманда = Новый Структура;
//   НоваяКоманда.Вставить("Идентификатор", "ПереходКЗадаче");
//   НоваяКоманда.Вставить("Представление", НСтр("ru = 'Открыть задачу в форме списка'"));
//   МассивКоманд.Добавить(НоваяКоманда);
//   
//   НоваяКоманда = Новый Структура;
//   НоваяКоманда.Вставить("Идентификатор", "ЗаписатьДокумент");
//   НоваяКоманда.Вставить("Представление", НСтр("ru = 'Записать документ'"));
//   НоваяКоманда.Вставить("ТребуетсяВызовСервера", Истина);
//   МассивКоманд.Добавить(НоваяКоманда);
//
// Код обработчика команды должен быть описан в общем переопределяемом модуле ПроцессыОбработкиДокументовПереопределяемый
// или ПроцессыОбработкиДокументовКлиентПереопределяемый в зависимости от значения ключа "Серверная" в виде отдельной
// процедуры (на сервере - неэкспортная, на клиенте - экпортная), имя которой должно совпадать с идентификатором команды
