//       ОткрытьФорму("Задача.ЗадачаПоОбработкеДокумента.Форма.МоиЗадачи");
//       
//   КонецПроцедуры
// 
// Пример серверной команды:
//   Процедура ЗаписатьДокумент(Форма)
//       
//       ДокументОбъект = Форма.Параметры.ЗначениеОтбора.ПолучитьОбъект();
//       ДокументОбъект.Записать();
//       
//   КонецПроцедуры
Процедура ОписаниеДополнительныхКомандКарточкиПроцессаДокумента(МассивКоманд) Экспорт
	
