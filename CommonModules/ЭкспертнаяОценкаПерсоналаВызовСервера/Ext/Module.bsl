
#Область СлужебныеПроцедурыИФункции

Функция ЗапуститьПолноэкранноеРабочееМесто () Экспорт
	
	Если Не ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Пользователи.ЭтоСеансВнешнегоПользователя() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Если УправлениеДоступом.ЕстьРоль("ПолныеПрава",, ТекущийПользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|ГДЕ
		|	ГруппыДоступаПользователи.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь);
	УстановитьПривилегированныйРежим(Истина);
	ГруппыДоступа = Запрос.Выполнить().Выгрузить();
	
	Если ГруппыДоступа.Количество() = 1 Тогда
		ГруппаДоступаЭксперт = Константы.ГруппаДоступаЭксперта.Получить();
		Если Не ЗначениеЗаполнено(ГруппаДоступаЭксперт) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ГруппыДоступа[0].Ссылка = ГруппаДоступаЭксперт Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти