// Возвращает токен аутентификации пользователя на портале поддержки.
// Возвращенный токен может быть проверен вызовом операции validate-token
// сервиса https://login.1c.ru или https://login.1c.eu
//
// Подробнее см. https://login.1c.ru/rest/public/swagger-ui/index.html.
//
// Получение токена выполняется в соответствии с настройками
// библиотеки:
//  - доменная зона серверов (1c.ru или 1c.eu);
// Перед вызовом вызывающий код должен устанавливать привилегированный режим.
//
// Параметры:
//  ИдентификаторСервиса - Строка - имя сервиса, для которого выполняется
//   формирование токена.
//  Обновить - Булево - признак принудительного обновления токена. Токен будет получен
//   заново, значение сохраненное в базе данных будет проигнорировано.
//  Бессрочный - Булево - признак получения бессрочного токена.
//  ДополнительныеПараметры - Соответствие - описывает дополнительные параметры:
//    * Ключ - Строка - имя дополнительного свойства
//    * Значение - Строка, Число, Неопределено, Массив - значение дополнительного свойства
//
// Возвращаемое значение:
//  Структура - результат получения тикета. Поля структуры:
//    * Токен - Строка - полученный токен аутентификации. Если при получении
//      токена произошла ошибка (неверный логин или пароль или другая ошибка),
//      значение поля - пустая строка.
//    * КодОшибки - Строка - строковый код возникшей ошибки, который
//      может быть обработан вызывающим функционалом:
//        - <Пустая строка> - создание нового заказа выполнено успешно;
//        - "НеверныйФорматЗапроса" - передан некорректный запрос или настройка подключения;
//        - "ОшибкаАутентификации" - неверный логин или пароль;
//        - "ПревышеноКоличествоПопыток" - превышено количество попыток
//        обращения к сервису с некорректным логином и паролем;
//        - "ОшибкаПодключения" - ошибка при подключении к сервису;
//        - "ОшибкаСервиса" - внутренняя ошибка сервиса;
//        - "НеизвестнаяОшибка" - при получении информации возникла
//          неизвестная (не обрабатываемая) ошибка;
//        - "СервисВременноНеДоступен" - на сервере ведутся регламентные работы;
//    * СообщениеОбОшибке - Строка - краткое описание ошибки, которое
//      может быть отображено пользователю.
//
Функция СлужебнаяТокенАутентификации(
		ИдентификаторСервиса,
		Обновить = Ложь,
		Бессрочный = Ложь,
		ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Не ПривилегированныйРежим() Тогда
		ВызватьИсключение НСтр("ru = 'Создание токена аутентификации недоступно.'");
	КонецЕсли;
	
	Если ИдентификаторСервиса = ИдентификаторИдентификаторКлиента()
		Или ИдентификаторСервиса = ИдентификаторКлючаМастерТокен()
		Или ИдентификаторСервиса = ИдентификаторЛогин()
		Или ИдентификаторСервиса = ИдентификаторПароль() Тогда
		ВызватьИсключение НСтр("ru = 'Передан не корректный идентификатор сервиса.'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"ИнтернетПоддержкаПользователей.ТокенАутентификации",
		"ИдентификаторСервиса",
		ИдентификаторСервиса,
		Тип("Строка"));
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"ИнтернетПоддержкаПользователей.ТокенАутентификации",
		"Обновить",
		Обновить,
		Тип("Булево"));
	
	Результат = Новый Структура("
		|КодОшибки,
		|СообщениеОбОшибке,
		|Токен",
		"",
		"",
		Неопределено);
	Сценарий = ?(Обновить,
		ИдентификаторСценарияОбновленияТокена(),
		ИдентификаторСценарияСозданияТокена());
	
	Если Не Обновить Тогда
		
		ДанныеТокена = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			ИдентификаторПодсистемы(),
			ИдентификаторСервиса);
		
		Если ДанныеТокена <> Неопределено И ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
			
			Бессрочный = Ложь;
			
			Если ДанныеТокена.Свойство("Бессрочный") Тогда
				Бессрочный = ДанныеТокена.Бессрочный;
			КонецЕсли;
			
			// Увеличиваем текущую дату на минуту (ТекущаяУниверсальнаяДата() + 60) минуту
			// для исключения паразитных запросов.
			Если Бессрочный
				Или ДанныеТокена.ШтампИстечения > (ТекущаяУниверсальнаяДата() + 60) Тогда
				Результат.Токен = ДанныеТокена.Токен;
				Возврат Результат;
			Иначе
				Сценарий = ИдентификаторСценарияОбновленияТокена();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	МастерТокен = МастерТокен();
	Если Не ЗначениеЗаполнено(МастерТокен) Тогда
		МастерТокен = СлужебнаяСоздатьМастерТокен(
			ИдентификаторСценарияСозданияТокена());
		Если Не ЗначениеЗаполнено(МастерТокен) Тогда
			Результат.КодОшибки = ИнтернетПоддержкаПользователейКлиентСервер.КодОшибкиАутентификации();
			Результат.СообщениеОбОшибке = НСтр("ru = 'Ошибка создания мастер токена для подключения к сервисам.'");
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	РезультатОперации = ИнтернетПоддержкаПользователейСервис.ОперацияТокенАутентификации(
		МастерТокен,
		ИдентификаторСервиса,
		Сценарий,
		Бессрочный,
		ДополнительныеПараметры);
	ЗаполнитьЗначенияСвойств(
		Результат,
		РезультатОперации);
	
	// Для случаев, когда по мастер токену не возможно выполнить получение
	// токена аутентификации, выполняется принудительный отзыв существующего
	// мастер токена, создание нового мастер токена и попытка создания нового токена
	// аутентификации.
	Если Результат.КодОшибки = ИнтернетПоддержкаПользователейКлиентСервер.КодОшибкиАутентификации() Тогда
		МастерТокенНовый = СлужебнаяСоздатьМастерТокен(
			ИдентификаторСценарияОбновленияТокена());
		Если ЗначениеЗаполнено(МастерТокенНовый) Тогда
			ИнтернетПоддержкаПользователейСервис.ОперацияОтозватьМастерТокен(
				МастерТокен,
				ИдентификаторСценарияОбновленияТокена());
			РезультатОперации = ИнтернетПоддержкаПользователейСервис.ОперацияТокенАутентификации(
				МастерТокенНовый,
				ИдентификаторСервиса,
				Сценарий,
				Бессрочный,
				ДополнительныеПараметры);
			ЗаполнитьЗначенияСвойств(
				Результат,
				РезультатОперации);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.КодОшибки) Тогда
		
		ДанныеТокена = Новый Структура;
		ДанныеТокена.Вставить("Токен", РезультатОперации.Токен);
		ДанныеТокена.Вставить("ШтампИстечения", РезультатОперации.ШтампИстечения);
		ДанныеТокена.Вставить("Бессрочный", РезультатОперации.Бессрочный);
		
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
			ИдентификаторПодсистемы(),
			ДанныеТокена,
			ИдентификаторСервиса);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

