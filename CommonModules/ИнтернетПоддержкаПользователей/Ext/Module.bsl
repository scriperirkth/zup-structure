#Область БлокировкаРаботыССервисамиИнтернетПоддержки

// Проверяет разрешение на работу с сервисом по переданному URL.
// Работа с хостом разрешена, когда выполняется одно из условий:
//  1) Не установлена блокировка работы с внешними ресурсами.
//  2) Не установлена блокировка работы с сервисами Интернет-поддержки.
//  3) Разрешена работа с сервисом. Сервис определяется по URL.
//
// Параметры:
//  URL - Строка - URL вызываемой операции;
// 
// Возвращаемое значение:
//  Булево - признак разрешения с сервисом.
//
Функция РазрешенаРаботаСХостом(URL) Экспорт
	
	Если Не РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПараметрыБлокировки = ПараметрыБлокировкиССервисамиИнтернетПоддержки();
	Если Не ПараметрыБлокировки.РаботаССервисамиИнтернетПоддержкиЗаблокирована Тогда
		Возврат Истина;
	КонецЕсли;
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(URL);
	СервисИнтернетПоддержки = ПараметрыБлокировки.ХостыСервисовИнтернетПоддержки.Получить(СтруктураURI.ИмяСервера);
	Если СервисИнтернетПоддержки = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПараметрыСервиса = ПараметрыБлокировки.СервисыИнтернетПоддержки.Получить(СервисИнтернетПоддержки);
	РазрешенаРаботаСХостом = (ПараметрыСервиса = Неопределено
		Или ПараметрыСервиса.РазрешенаРабота);
	
	Если Не РазрешенаРаботаСХостом Тогда
		
		ИнформацияОбОшибке = НСтр("ru = 'Обращение к сервисам Интернет-поддержки запрещено.
			|Для разрешения работы с сервисами откройте раздел Интернет-поддержка и сервисы и нажмите ""Настроить"".'");
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,,,
			ИнформацияОбОшибке);
		
	КонецЕсли;
	
	Возврат РазрешенаРаботаСХостом;
	
КонецФункции

// Выполняет снятие блокировки на работу с сервисом по переданному URL.
//
// Параметры:
//  URL - Строка - URL вызываемой операции.
//
Процедура РазблокироватьРаботуСХостом(URL) Экспорт
	
	ПараметрыБлокировки = ПараметрыБлокировкиССервисамиИнтернетПоддержки();
	Если Не ПараметрыБлокировки.РаботаССервисамиИнтернетПоддержкиЗаблокирована Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураURI            = ОбщегоНазначенияКлиентСервер.СтруктураURI(URL);
	СервисИнтернетПоддержки = ПараметрыБлокировки.ХостыСервисовИнтернетПоддержки.Получить(СтруктураURI.ИмяСервера);
	
	ПараметрыСервиса = ПараметрыБлокировки.СервисыИнтернетПоддержки.Получить(СервисИнтернетПоддержки);
	Если ПараметрыСервиса <> Неопределено Тогда
		
		ПараметрыСервиса.РазрешенаРабота = Истина;
		
		СохранитьПараметрыБлокировки(ПараметрыБлокировки);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Интерфейс85

// Настраивает командную панель мастера.
//
// Параметры:
//  КнопкаДалее - КнопкаФормы, Неопределено - элемент формы кнопки "Далее".
//  КнопкаНазад - КнопкаФормы, Неопределено - элемент формы кнопки "Назад".
//
Процедура НастроитьКоманднуюПанельМастера(
		КнопкаДалее = Неопределено,
		КнопкаНазад = Неопределено) Экспорт
	
	Если ИнтернетПоддержкаПользователейКлиентСервер.ЭтоИнтерфейс85() Тогда
		Если КнопкаНазад <> Неопределено Тогда
			КнопкаНазад.Заголовок = НСтр("ru = 'Назад'");
			КнопкаНазад.Картинка = БиблиотекаКартинок.ПерейтиНазад;
			КнопкаНазад.Отображение = ОтображениеКнопки.КартинкаИТекст;
		КонецЕсли;
		Если КнопкаДалее <> Неопределено Тогда
			КнопкаДалее.Заголовок = НСтр("ru = 'Далее'");
			КнопкаДалее.Картинка = БиблиотекаКартинок.ПерейтиВперед;
			КнопкаДалее.Отображение = ОтображениеКнопки.КартинкаИТекст;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ТехническаяИнформация

// Определяет описание настроек Интернет-поддержки.
//
// Параметры:
//  НастройкиТехническойИнформации - см. ИнтернетПоддержкаПользователейКлиентСервер.НастройкиТехническойИнформации.
// 
// Возвращаемое значение:
//  Структура - информация о настройках Интернет-поддержки:
//    * Логин - Строка - логин пользователя интернет-поддержки.
//    * ПарольЗаполнен - Булево - признак того, что пароль заполнен.
//    * ИдентификаторЦентрМониторинга - Строка - идентификатор информационной базы.
//        Заполняется если в конфигурацию включена подсистема СтандартныеПодсистемы.ЦентрМониторинга.
//    * ИмяКлиентаЛицензирования - Строка - имя клиента лицензирования.
//        Заполняется если НастройкиТехническойИнформации.ОтправкаИдентификатораКонфигурации = Истина.
//    * ИДКонфигурации - Строка - идентификатор конфигурации.
//        Заполняется если НастройкиТехническойИнформации.ОтправкаИдентификатораКонфигурации = Истина.
//    * РегистрационныйНомер - Строка - регистрационный номер конфигурации.
//        Заполняется если в конфигурацию включена подсистема
//        ИнтернетПоддержкаПользователей.СообщенияВСлужбуТехническойПоддержки.
//    * УстанавливатьРегистрационныйНомер - Булево - служебный параметр.
//        Используется в форме "О программе".
//
Функция НастройкиИнтернетПоддержки(НастройкиТехническойИнформации) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ДанныеАутентификации = ДанныеАутентификацииПользователяИнтернетПоддержки();
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = Новый Структура(
		"Логин, ПарольЗаполнен",
		"",
		Ложь);
	
	Если ДанныеАутентификации <> Неопределено Тогда
		Результат.Вставить("Логин", ДанныеАутентификации.Логин);
		Результат.Вставить(
			"ПарольЗаполнен",
			Не ПустаяСтрока(ДанныеАутентификации.Пароль));
		ДанныеАутентификации.Очистить();
	КонецЕсли;
	
	ИдентификаторЦентрМониторинга = "";
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЦентрМониторинга") Тогда
		МодульЦентрМониторинга = ОбщегоНазначения.ОбщийМодуль("ЦентрМониторинга");
		ИдентификаторЦентрМониторинга = МодульЦентрМониторинга.ИдентификаторИнформационнойБазы();
	КонецЕсли;
	Результат.Вставить("ИдентификаторЦентрМониторинга", ИдентификаторЦентрМониторинга);
	
	ИмяКлиентаЛицензирования = "";
	ИДКонфигурации = "";
	Если НастройкиТехническойИнформации.ОтправкаИдентификатораКонфигурации
		И ДоступнаРаботаСНастройкамиКлиентаЛицензирования() Тогда
		
		ИДКонфигурации = ИнтернетПоддержкаПользователейСлужебныйПовтИсп.ИДКонфигурации();
		Если Не ПустаяСтрока(ИДКонфигурации) Тогда
			ИмяКлиентаЛицензирования = КлиентЛицензирования.ИмяКлиентаЛицензирования();
		КонецЕсли;
		
	КонецЕсли;
	Результат.Вставить("ИмяКлиентаЛицензирования", ИмяКлиентаЛицензирования);
	Результат.Вставить("ИДКонфигурации", ИДКонфигурации);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.СообщенияВСлужбуТехническойПоддержки") Тогда
		МодульСообщенияВСлужбуТехническойПоддержки = ОбщегоНазначения.ОбщийМодуль("СообщенияВСлужбуТехническойПоддержки");
		
		РегНомер = МодульСообщенияВСлужбуТехническойПоддержки.РегистрационныйНомер();
		Результат.Вставить("РегистрационныйНомер", РегНомер);
		Результат.Вставить("УстанавливатьРегистрационныйНомер", Истина);
	Иначе
		Результат.Вставить("РегистрационныйНомер", "");
		Результат.Вставить("УстанавливатьРегистрационныйНомер", Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет описание настроек Интернет-соединений.
//
// Возвращаемое значение:
//  Структура - информация о текущих настройках Интернет-соединения:
//   * ДоменнаяЗона - Строка - "1c.eu" или "1c.ru".
//   * НастройкиПрокси - Строка - настройка использования прокси.
// 
Функция ИнтернетНастройки() Экспорт
	
	НастройкиСоединения = НастройкиСоединенияССерверами();
	
	Результат = Новый Структура;
	Результат.Вставить(
		"ДоменнаяЗона",
		?(НастройкиСоединения.ДоменРасположенияСерверовИПП = 1, "1c.eu", "1c.ru"));
	
	НастройкиПрокси = ПолучениеФайловИзИнтернета.НастройкиПроксиНаСервере();
	Если НастройкиПрокси = Неопределено Тогда
		ЗначениеНастройкиПрокси = "DONT_USE";
	Иначе
		Если НастройкиПрокси.Получить("ИспользоватьПрокси") Тогда
			ЗначениеНастройкиПрокси = ?(НастройкиПрокси.Получить("ИспользоватьСистемныеНастройки"),
				"AUTO",
				"USE");
		Иначе
			ЗначениеНастройкиПрокси = "DONT_USE";
		КонецЕсли;
	КонецЕсли;
	Результат.Вставить("НастройкиПрокси", ЗначениеНастройкиПрокси);
	
	Возврат Результат;
	
КонецФункции

// Определяет описание текущей сессии пользователя.
//
// Возвращаемое значение:
//  Структура - информация о сессии:
//   * ИмяПользователя - Строка - имя текущего пользователя.
//   * ИспользуемыйКлиент - Строка - используемый клиент.
//   * РежимРаботы - Строка - режим работы с информационной базой (файловый или серверный).
//   * СтрокаСоединенияИнформационнойБазы - Строка - строка соединения с информационной базой.
//   * ЕстьПравоАдминистрирования - Булево - наличие прав администрирования у текущего пользователя.
//   * ЕстьПолныеПрава - Булево - наличие полных прав у текущего пользователя.
//
Функция ОписаниеТекущейСессии() Экспорт
	
	ЭтоФайловаяИБ = ОбщегоНазначения.ИнформационнаяБазаФайловая();
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяПользователя", ИмяПользователя());
	Результат.Вставить("ИспользуемыйКлиент", ОбщегоНазначения.ИспользуемыйКлиент());
	Результат.Вставить(
		"РежимРаботы",
		?(ЭтоФайловаяИБ, "FILE", "SRVR"));
	Результат.Вставить(
		"СтрокаСоединенияИнформационнойБазы",
		СтрокаСоединенияИнформационнойБазы());
	Результат.Вставить(
		"ЕстьПравоАдминистрирования",
		Пользователи.ЭтоПолноправныйПользователь(, Истина, Ложь));
	Результат.Вставить(
		"ЕстьПолныеПрава",
		Пользователи.ЭтоПолноправныйПользователь(, Ложь, Ложь));

	Возврат Результат;
	
КонецФункции

// Определяет описание программы.
//
// Возвращаемое значение:
//  Структура - описание программы:
//    * ОписаниеКонфигурации - Строка - синоним конфигурации.
//    * Версия - Строка - версия конфигурации.
//    * Поставщик - Строка - поставщик конфигурации.
//    * ИдентификаторИнтернетПоддержки - Строка - идентификатор конфигурации для интернет-поддержки.
//    * ИмяКонфигурации - см. ИнтернетПоддержкаПользователей.ИмяКонфигурации.
//    * РежимСовместимости - Строка - режим совместимости конфигурации.
//    * РежимСовместимостиИнтерфейса - Строка - режим совместимости конфигурации интерфейса.
//    * ОписаниеКонфигурацииДляВывода - Строка - описание конфигурации для вывода в форме "О программе".
//    * ПроверитьНаличиеОбновленийКонфигурации - Булево - Истина, если необходимо проверить наличие
//       обновлений программы в форме "О программе".
//
Функция ОписаниеПрограммы() Экспорт
	
	ИмяПрограммы = Строка(СлужебнаяИмяПрограммы());
	Если ИмяПрограммы = "Unknown" Тогда
		ИмяПрограммы = НСтр("ru = '<Не заполнено>'");
	КонецЕсли;
	
	Синоним = Метаданные.Синоним;
	ПодробнаяИнформация = Метаданные.ПодробнаяИнформация;
	URLКонфигурации = Метаданные.АдресИнформацииОКонфигурации;
	Копирайт = Метаданные.АвторскиеПрава;
	
	ПредставлениеКонфигурации = ?(ЗначениеЗаполнено(ПодробнаяИнформация), ПодробнаяИнформация, Синоним);
	Если ЗначениеЗаполнено(URLКонфигурации) Тогда
		URLКонфигурации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"(<a href=""%1"">%1</a>)",
			URLКонфигурации);
	КонецЕсли;
	
	ПредставлениеКонфигурацииДляВывода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1 %2%3",
		ПредставлениеКонфигурации,
		URLКонфигурации,
		?(ЗначениеЗаполнено(Копирайт), Символы.ПС + Копирайт, ""));
	
	Результат = Новый Структура;
	Результат.Вставить("ОписаниеКонфигурации", Синоним);
	Результат.Вставить("Версия", ВерсияКонфигурации());
	Результат.Вставить("Поставщик", Метаданные.Поставщик);
	Результат.Вставить("ИдентификаторИнтернетПоддержки", ИмяПрограммы);
	Результат.Вставить("ИмяКонфигурации", ИмяКонфигурации());
	Результат.Вставить("РежимСовместимости", Строка(Метаданные.РежимСовместимости));
	Результат.Вставить("РежимСовместимостиИнтерфейса", Строка(Метаданные.РежимСовместимостиИнтерфейса));
	Результат.Вставить("ОписаниеКонфигурацииДляВывода", ПредставлениеКонфигурацииДляВывода);
	Результат.Вставить("ПроверитьНаличиеОбновленийКонфигурации", Ложь);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ПолучениеОбновленийПрограммы") Тогда
		Результат.ПроверитьНаличиеОбновленийКонфигурации = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ИнформационныйЦентр

// Проверяет, используется ли в конфигурации отправка сообщений в Информационный центр
// 
// Возвращаемое значение:
//  Булево - признак использования информационного центра.
// 
Функция ИспользуетсяИнформационныйЦентр() Экспорт
	
	Если Не ОбщегоНазначения.РазделениеВключено() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.ИнформационныйЦентр") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульИнформационныйЦентрСервер = ОбщегоНазначения.ОбщийМодуль("ИнформационныйЦентрСервер"); // АПК:271 Ранее проверка существования подсистемы
	Если Не МодульИнформационныйЦентрСервер.НастроенаИнтеграцияСИнформационнымЦентром() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Конструктор параметров передачи обращения в Информационный центр.
// 
// Возвращаемое значение:
//  Структура - параметры передачи обращения в информационный центр:
//  * Тема - Строка - тема обращения;
//  * Текст - Строка - текст обращения;
//  * Вложения - Массив из Структура - описание вложенных файлов:
//     ** ИмяФайла - Строка - имя файла-вложения с расширением, например "file.txt";
//     ** АдресВоВременномХранилище - Строка - адрес файла-вложения во временном хранилище;
//  * ДополнительныеДанные - Структура - произвольная структура данных, которую можно передать в службу поддержки.
//                           Эта структура должна быть сериализуемой в JSON;
//  * ИспользоватьСтандартныйШаблон - Булево - устарел. Больше не используется;
//  * ОбработчикЗавершения - Неопределено - ОписаниеОповещения, Неопределено - описание оповещения о закрытии формы
//                           нового обращения.
//
Функция НовыйСообщениеВИнформационныйЦентр() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Тема",                          "");
	Результат.Вставить("Текст",                         "");
	Результат.Вставить("Вложения",                      Новый Массив);
	Результат.Вставить("ДополнительныеДанные",          Новый Структура);
	Результат.Вставить("ИспользоватьСтандартныйШаблон", Ложь);
	Результат.Вставить("ОбработчикЗавершения",          Неопределено);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ФункциональныеОпцииБСП

// Проверяет наличие подсистемы "Взаимодействия" и производит включение функциональной опции, отвечающей за SMS.
//
Процедура УстановитьИспользованиеSMS()
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Взаимодействия")
		Или Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ОтправкаSMS") Тогда
		Возврат;
	КонецЕсли;
	
	МодульВзаимодействия = ОбщегоНазначения.ОбщийМодуль("Взаимодействия");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не МодульВзаимодействия.ИспользуютсяПрочиеВзаимодействия() Тогда
		МодульВзаимодействия.УстановитьИспользованиеПрочегоВзаимодействия(Истина);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Проверяет наличие подсистемы "Шаблоны сообщений" и производит включение соответствующей функциональной опции.
//
Процедура УстановитьИспользованиеШаблоновСообщений()
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ШаблоныСообщений") Тогда
		Возврат;
	КонецЕсли;
	
	МодульШаблоныСообщений = ОбщегоНазначения.ОбщийМодуль("ШаблоныСообщений");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не МодульШаблоныСообщений.ИспользуютсяШаблоныСообщений() Тогда
		МодульШаблоныСообщений.УстановитьИспользованиеШаблоновСообщений(Истина);
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Проверяет наличие подсистемы "Взаимодействия" и производит включение функциональной опции, отвечающей за ЭП.
//
Процедура УстановитьИспользованиеЭлектроннойПочты()
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Взаимодействия")
		Или Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		Возврат;
	КонецЕсли;
	
	МодульВзаимодействия = ОбщегоНазначения.ОбщийМодуль("Взаимодействия");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не МодульВзаимодействия.ИспользуетсяПочтовыйКлиент() Тогда
		МодульВзаимодействия.УстановитьИспользованиеПочтовогоКлиента(Истина);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Проверяет наличие подсистемы "Взаимодействия" и производит включение функциональной опции,
// отвечающей за отправку писем в формате HTML.
//
Процедура УстановитьОтправкуПисемВФорматеHTML()
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Взаимодействия") Тогда
		Возврат;
	КонецЕсли;
	
	МодульВзаимодействия = ОбщегоНазначения.ОбщийМодуль("Взаимодействия");
	
	УстановитьПривилегированныйРежим(Истина);

	Если Не МодульВзаимодействия.ИспользуетсяОтправкаПисемВФорматеHTML() Тогда
		МодульВзаимодействия.УстановитьИспользованиеОтправкиПисемВФорматеHTML(Истина);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ПодключениеИнтернетПоддержки

// Создает новую структуру параметров аутентификации.
//
// Параметры:
//  Логин  - Строка, Неопределено - логин Интернет-поддержки.
//  Пароль  - Строка, Неопределено - пароль Интернет-поддержки.
//  Тикет  - Строка, Неопределено - тикет аутентификации.
//
// Возвращаемое значение:
//  Структура - описание параметров аутентификации:
//    * Логин  - Строка, Неопределено - логин Интернет-поддержки.
//    * Пароль  - Строка, Неопределено - пароль Интернет-поддержки.
//    * Тикет  - Строка, Неопределено - тикет аутентификации.
//
Функция НовыйДанныеАутентификации(
		Логин = Неопределено,
		Пароль = Неопределено,
		Тикет = Неопределено) Экспорт
	
	Аутентификация = Новый Структура;
	Аутентификация.Вставить("Логин", Логин);
	Аутентификация.Вставить("Пароль", Пароль);
	Аутентификация.Вставить("Тикет", Тикет);
	
	Возврат Аутентификация;
	
КонецФункции

// Создает новую структуру результата получения тикета.
//
// Параметры:
//  Логин  - Строка, Неопределено - логин Интернет-поддержки.
//  Пароль  - Строка, Неопределено - пароль Интернет-поддержки.
//  Тикет  - Строка, Неопределено - тикет аутентификации.
//
// Возвращаемое значение:
//  Структура - описание параметров аутентификации:
//    * КодОшибки  - Строка - код ошибки.
//    * СообщениеОбОшибке  - Строка - сообщение об ошибки для пользователя.
//    * ИнформацияОбОшибке  - Строка - сообщение об ошибки для администратора.
//    * Тикет  - Строка, Неопределено - тикет аутентификации.
//
Функция НовыйРезультатПолученияТикета() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("СообщениеОбОшибке" , "");
	Результат.Вставить("ИнформацияОбОшибке", "");
	Результат.Вставить("Тикет", Неопределено);
	
	Возврат Результат;
	
КонецФункции 

// Создает новый идентификатор клиента.
//
// Возвращаемое значение:
//  Строка - идентификатор клиента.
//
Функция НовыйИдентификаторКлиента()
	
	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	
КонецФункции

// Подключает Интернет-поддержку пользователей в информационной базе.
//
// Параметры:
//  ДанныеАутентификации - Структура - структура, содержащая логин,
//    пароль пользователя Интернет-поддержки и тикет аутентификации.
//  Сценарий - Строка - сценарий выполнения запроса.
//  Капча - Строка, Неопределено - капча, которую должен ввести пользователь в случае
//    блокировки частого получения мастер токена.
//
// Возвращаемое значение:
//  Структура - результат проверки данных аутентификации:
//   * Подключена - Булево - результат проверки, если Истина, логин и пароль ведены верно.
//   * КапчаBase64 - Строка - картинка капчи в формате base64.
//       Картинка капчи может быть возвращена в случае получения ошибки
//       "ПревышеноКоличествоПопыток".
//   * КодОшибки - Строка - идентификатор ошибки в случае если логин и пароль ведены верно
//      или в процессе проверки возникли ошибки;
//   * СообщениеОбОшибке - Строка - описание ошибки проверки данных аутентификации.
//
Функция СлужебнаяПодключить(
		ДанныеАутентификации,
		Сценарий,
		Капча = Неопределено)
	
	Если (Не ОбщегоНазначения.РазделениеВключено() И Не ДоступноПодключениеИнтернетПоддержки())
			Или Не ПривилегированныйРежим() Тогда
		ВызватьИсключение НСтр("ru = 'Подключение Интернет-поддержки недоступно.'");
	КонецЕсли;
	
	Аутентификация = НовыйДанныеАутентификации(
		ДанныеАутентификации.Логин,
		ДанныеАутентификации.Пароль,
		ДанныеАутентификации.Тикет);
	Аутентификация.Вставить("МастерТокен", Неопределено);
	
	Если (Не ЗначениеЗаполнено(Аутентификация.Логин)
		Или Не ЗначениеЗаполнено(Аутентификация.Пароль))
		И Не ЗначениеЗаполнено(Аутентификация.Тикет) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнены параметры аутентификации.'")
	КонецЕсли;
	
	Результат = ИнтернетПоддержкаПользователейКлиентСервер.НовыйРезультатПодключения();
	Результат.Логин = Аутентификация.Логин;
	
	ИдентификаторКлиента = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
		ИдентификаторПодсистемы(),
		ИдентификаторИдентификаторКлиента());
	Если Не ЗначениеЗаполнено(ИдентификаторКлиента) Тогда
		ИдентификаторКлиента = НовыйИдентификаторКлиента();
	КонецЕсли;
	
	РезультатОперации = ИнтернетПоддержкаПользователейСервис.ОперацияМастерТокен(
		Аутентификация.Логин,
		Аутентификация.Пароль,
		Аутентификация.Тикет,
		ИдентификаторКлиента,
		Сценарий,
		Капча);
	
	Если РезультатОперации.ОбновитьИдентификатор Тогда
		ИдентификаторКлиента = НовыйИдентификаторКлиента();
		РезультатОперации = ИнтернетПоддержкаПользователейСервис.ОперацияМастерТокен(
			Аутентификация.Логин,
			Аутентификация.Пароль,
			Аутентификация.Тикет,
			ИдентификаторКлиента,
			ИдентификаторСценарияОбновленияТокена(),
			Капча);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РезультатОперации.КодОшибки) Тогда
		Аутентификация.МастерТокен = РезультатОперации.МастерТокен;
		Если Не ЗначениеЗаполнено(Аутентификация.МастерТокен) Тогда
			ВызватьИсключение НСтр("ru = 'Мастер токен не заполнен.'")
		КонецЕсли;
	Иначе
		ЗаполнитьЗначенияСвойств(
			Результат,
			РезультатОперации);
		Возврат Результат;
	КонецЕсли;
	
	СлужебнаяСохранитьДанныеАутентификации(
		Аутентификация,
		ИдентификаторКлиента);
	Результат.Подключена = Истина;
	
	Возврат Результат;
	
КонецФункции

// Создает мастер токен на основании сохраненного
// логина и пароля Интернет-поддержки пользователей.
//
// Параметры:
//  Сценарий - Строка - сценарий выполнения запроса.
//
// Возвращаемое значение:
//   Строка, Неопределено - созданные мастер токен.
//
Функция СлужебнаяСоздатьМастерТокен(Сценарий)
	
	Если Не ПривилегированныйРежим() Тогда
		ВызватьИсключение НСтр("ru = 'Получение мастер токена не в привилегированном режиме запрещено.'");
	КонецЕсли;
	
	Аутентификация = НовыйДанныеАутентификации();
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Результат = СлужебнаяТикетАутентификацииНаПорталеПоддержки(
			ИдентификаторКлючаМастерТокен(),
			ТипАутентификацииBearer());
		Если ЗначениеЗаполнено(Результат.КодОшибки) Тогда
			ЗаписатьИнформациюВЖурналРегистрации(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось получить тикет для генерации мастер токен по причине:
					|%1'"),
					Результат.ИнформацияОбОшибке),
				Неопределено,
				Истина);
			Возврат Неопределено;
		КонецЕсли;
		Аутентификация.Тикет = Результат.Тикет;
	Иначе
		ДанныеАутентификации = СлужебнаяДанныеАутентификации();
		Если ДанныеАутентификации = Неопределено Тогда
			ЗаписатьИнформациюВЖурналРегистрации(
				НСтр("ru = 'Не удалось получить тикет для генерации мастер токен по причине:
					|Не подключена Интернет-поддержка пользователей.'"));
			Возврат Неопределено;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(
			Аутентификация,
			ДанныеАутентификации,
			"Логин, Пароль");
	КонецЕсли;
	
	СлужебнаяПодключить(
		Аутентификация,
		Сценарий);
	
	Возврат МастерТокен();
	
КонецФункции

// Получает мастер токен из безопасного хранилища.
// Перед вызовом вызывающий код должен устанавливать привилегированный режим.
//
// Возвращаемое значение:
//   Строка, Неопределенно - мастер токен из безопасного хранилища.
//
Функция МастерТокен()
	
	Если Не ПривилегированныйРежим() Тогда
		ВызватьИсключение НСтр("ru = 'Полученные мастер токена не в привилегированном режиме запрещено.'");
	КонецЕсли;
	
	ДанныеВБезопасномХранилище = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
		ИдентификаторПодсистемы(),
		ИдентификаторКлючаМастерТокен());
	
	Если ДанныеВБезопасномХранилище = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат ДанныеВБезопасномХранилище;
	КонецЕсли;
	
КонецФункции

// Сохраняет логин и пароль пользователя в подсистеме Интернет-поддержки
// в безопасном хранилище. В вызывающем коде перед записью данных необходимо
// проверить права и установить привилегированный режим.
//
// Параметры:
// ДанныеАутентификации - Структура, Неопределено - структура, содержащая логин 
//                        и пароль пользователя Интернет-поддержки, тикет и мастер токен.
//                        Если передано значение Неопределено, данные аутентификации удаляются.
//   * Логин - Строка - логин пользователя Интернет-поддержки;
//   * Пароль - Строка - пароль пользователя Интернет-поддержки.
//   * Тикет - Строка
//   * МастерТокен - Строка
// ИдентификаторКлиента - Строка
//
Процедура СлужебнаяСохранитьДанныеАутентификации(
		ДанныеАутентификации,
		ИдентификаторКлиента)
	
	Если ДанныеАутентификации = Неопределено Тогда
		
		// Удалить все данные для логина из безопасного хранилища.
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(
			ИдентификаторПодсистемы());
		
		ЗаписатьИнформациюВЖурналРегистрации(
			НСтр("ru = 'Очищены данные аутентификации.'"),
			Неопределено,
			Ложь);
		
		ИнтеграцияПодсистемБИП.ПриИзмененииДанныхАутентификацииИнтернетПоддержки(
			Неопределено);
		ИнтернетПоддержкаПользователейПереопределяемый.ПриИзмененииДанныхАутентификацииИнтернетПоддержки(
			Неопределено);
		
	Иначе
		
		// Запись данных в безопасное хранилище
		ИДПодсистемы = ИдентификаторПодсистемы();
		НачатьТранзакцию();
		Попытка
			ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ИДПодсистемы);
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				ИДПодсистемы,
				ДанныеАутентификации.Логин,
				ИдентификаторЛогин());
			
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				ИДПодсистемы,
				ДанныеАутентификации.Пароль,
				ИдентификаторПароль());
			
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				ИДПодсистемы,
				ДанныеАутентификации.МастерТокен,
				ИдентификаторКлючаМастерТокен());
			
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				ИДПодсистемы,
				ИдентификаторКлиента,
				ИдентификаторИдентификаторКлиента());
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписатьИнформациюВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение;
		КонецПопытки;
		
		ЗаписатьИнформациюВЖурналРегистрации(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Записаны данные аутентификации, логин ""%1"".'"),
				ДанныеАутентификации.Логин),
			Неопределено,
			Ложь);
			
		Аутентификация = Новый Структура(
			"Логин,
			|Пароль",
			ДанныеАутентификации.Логин,
			ДанныеАутентификации.Пароль);
		ИнтеграцияПодсистемБИП.ПриИзмененииДанныхАутентификацииИнтернетПоддержки(
			Аутентификация);
		ИнтернетПоддержкаПользователейПереопределяемый.ПриИзмененииДанныхАутентификацииИнтернетПоддержки(
			Аутентификация);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает логин и пароль пользователя Интернет-поддержки,
// сохраненные в информационной базе. Перед вызовом вызывающий
// код должен устанавливать привилегированный режим.
//
// Возвращаемое значение:
//  Структура - Структура - логин и пароль пользователя Интернет-поддержки:
//    * Логин - Строка - логин пользователя Интернет-поддержки;
//    * Пароль - Строка - пароль пользователя Интернет-поддержки.
//  Неопределено - при отсутствии сохраненных данных аутентификации.
//
Функция СлужебнаяДанныеАутентификации()
	
	ДанныеВБезопасномХранилище = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
		ИдентификаторПодсистемы(),
		ИдентификаторЛогин()
			+ ","
			+ ИдентификаторПароль());
	
	Если ДанныеВБезопасномХранилище.login <> Неопределено
		И ДанныеВБезопасномХранилище.password <> Неопределено Тогда
		Возврат Новый Структура(
			"Логин, Пароль",
			ДанныеВБезопасномХранилище.login,
			ДанныеВБезопасномХранилище.password);
	КонецЕсли;
	
КонецФункции

// Возвращает тикет аутентификации пользователя на портале поддержки.
// Возвращенный тикет может быть проверен вызовом операции check
// сервиса https://login.1c.ru или https://login.1c.eu
//
// Подробнее см. https://login.1c.ru/rest/public/swagger-ui.html.
//
// Получение тикета выполняется в соответствии с настройками
// библиотеки:
//  - доменная зона серверов (1c.ru или 1c.eu);
// Перед вызовом вызывающий код должен устанавливать привилегированный режим.
//
// Параметры:
//  ВладелецТикета - Строка - произвольное имя сервиса, для которого
//      выполняется аутентификация пользователя. Это же имя должно
//      использоваться при вызове операции https://login.1c.ru/rest/private/ticket/check;
//      Не допускается незаполненное значение параметра.
//  ТипАутентификации - Строка - типа аутентификации при получении тикета.
//
// Возвращаемое значение:
//  Структура - результат получения тикета. Поля структуры:
//        * Тикет - Строка - полученный тикет аутентификации. Если при получении
//          тикета произошла ошибка (неверный логин или пароль или другая ошибка),
//          значение поля - пустая строка.
//        * КодОшибки - Строка - строковый код возникшей ошибки, который
//          может быть обработан вызывающим функционалом:
//              - <Пустая строка> - получение тикета выполнено успешно;
//              - "НеверныйЛогинИлиПароль" - неверный логин или пароль;
//              - "ПревышеноКоличествоПопыток" - превышено количество попыток
//                 получения тикета с некорректным логином и паролем;
//              - "ОшибкаПодключения" - ошибка при подключении к сервису;
//              - "ОшибкаСервиса" - внутренняя ошибка сервиса;
//              - "НеизвестнаяОшибка" - при получении тикета возникла
//                 неизвестная (не обрабатываемая) ошибка;
//              - "ОперацияНеПоддерживается" - сервис не интегрирован с Порталом 1С:ИТС.
//                Ошибка может возникнуть при работе в модели сервиса.
//        * СообщениеОбОшибке - Строка - краткое описание ошибки, которое
//          может быть отображено пользователю;
//        * ИнформацияОбОшибке - Строка - подробное описание ошибки, которое
//          может быть записано в журнал регистрации.
//
Функция СлужебнаяТикетАутентификацииНаПорталеПоддержки(
		ВладелецТикета,
		ТипАутентификации)
	
	Если Не ЗначениеЗаполнено(ВладелецТикета) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнено значение параметра ""ВладелецТикета""'");
	КонецЕсли;
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		МодульИнтернетПоддержкаПользователейВМоделиСервиса =
			ОбщегоНазначения.ОбщийМодуль("ИнтернетПоддержкаПользователейВМоделиСервиса");
		Возврат МодульИнтернетПоддержкаПользователейВМоделиСервиса.ТикетАутентификацииНаПорталеПоддержки(
			ВладелецТикета);
	Иначе
		
		Аутентификация = Новый Структура;
		Аутентификация.Вставить("Логин", Неопределено);
		Аутентификация.Вставить("Пароль", Неопределено);
		Аутентификация.Вставить("МастерТокен", Неопределено);
		
		Результат = НовыйРезультатПолученияТикета();
		Если ТипАутентификации = ТипАутентификацииBearer() Тогда
			
			Аутентификация.МастерТокен = МастерТокен();
			Если Не ЗначениеЗаполнено(Аутентификация.МастерТокен) Тогда
				Аутентификация.МастерТокен = СлужебнаяСоздатьМастерТокен(
					ИдентификаторСценарияСозданияТокена());
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Аутентификация.МастерТокен) Тогда
				Результат.КодОшибки = ИнтернетПоддержкаПользователейКлиентСервер.КодОшибкиАутентификации();
				Результат.СообщениеОбОшибке  = НСтр("ru = 'Не подключена Интернет-поддержка пользователей.'");
				Результат.ИнформацияОбОшибке = Результат.СообщениеОбОшибке;
				Возврат Результат;
			КонецЕсли;
			
		ИначеЕсли ТипАутентификации = ТипАутентификацииBasic() Тогда
			
			ДанныеАутентификации = СлужебнаяДанныеАутентификации();
			Если ДанныеАутентификации <> Неопределено Тогда
				Аутентификация.Логин  = ДанныеАутентификации.Логин;
				Аутентификация.Пароль = ДанныеАутентификации.Пароль;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Аутентификация.Логин) Тогда
				Результат.КодОшибки = "НеверныйЛогинИлиПароль";
				Результат.СообщениеОбОшибке  = НСтр("ru = 'Неверный логин или пароль.'");
				Результат.ИнформацияОбОшибке = Результат.СообщениеОбОшибке;
				Возврат Результат;
			КонецЕсли;
			
		Иначе
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Неизвестный тип авторизации: %1'"),
				ТипАутентификации);
		КонецЕсли;
		
		Возврат ИнтернетПоддержкаПользователейСервис.ОперацияТикетАутентификации(
			ВладелецТикета,
			Аутентификация);
		
	КонецЕсли;
	
КонецФункции

// Определяет заголовок клиентского приложения.
