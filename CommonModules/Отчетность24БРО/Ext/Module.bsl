КонецФункции

// Возвращает адрес и методы шины.
// 
// Возвращаемое значение:
//  Структура:
// * Сервер                   - Строка - 
// * Хост                     - Строка - 
// * ИнициализацияПодключения - Строка - 
// * Подключение              - Строка - 
// * Ответ                    - Строка - 
// * Запрос                   - Строка - 
// * ПолучитьОтвет            - Строка - 
// * ПолучитьСообщение        - Строка -
// * ТаблицаСовместимости     - Строка - 
// * СтатусыКаналов           - Строка - 
Функция АдресаШины() Экспорт
	
	ИмяПриложения = "BusCloudReports";	
	Префикс = "/applications/" + ИмяПриложения;

	Результат = Новый Структура;
	Результат.Вставить("Сервер", СерверШины());
	Результат.Вставить("Хост", Префикс);
	Результат.Вставить("ИнициализацияПодключения", Префикс + "/api/service/startconnect");
	Результат.Вставить("Подключение", Префикс + "/api/service/connect"); 
	Результат.Вставить("Ответ", Префикс + "/api/service/answer");
	Результат.Вставить("Запрос", Префикс + "/api/service/datarequest");
	Результат.Вставить("ПолучитьОтвет", Префикс + "/api/service/getdatamessage");
	Результат.Вставить("ТаблицаСовместимости", Префикс + "/api/service/compatibility");
	Результат.Вставить("СтатусыКаналов", Префикс + "/api/service/channelstatus");
	Результат.Вставить("ПолучитьСообщение", "/applications/" + ИмяПриложения + "/api/service/getmessage");
	
	Возврат Результат;
	
КонецФункции

Функция УстановитьСоединениеССерверомИнтернета(URLСервера, ОписаниеОшибки = "", Таймаут = 60) Экспорт

	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(URLСервера);
	Схема = ?(ЗначениеЗаполнено(СтруктураURI.Схема), СтруктураURI.Схема, "http");
	Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(Схема);
	
	Попытка
		Соединение = Новый HTTPСоединение(
			СтруктураURI.Хост,
			СтруктураURI.Порт,
			СтруктураURI.Логин,
			СтруктураURI.Пароль,
			Прокси,
			Таймаут,
			?(НРег(Схема) = "http", Неопределено, Новый ЗащищенноеСоединениеOpenSSL()));
	Исключение
			
		ИнформацияОбОшибке = ПричинаОшибки(ИнформацияОбОшибке());
			
		ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Ошибка, , ,
					ОписаниеОшибки);

		Возврат Неопределено;

	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции

// Контрольная сумма тикета ИТС.
// 
// Параметры:
//  ТикетИТС - Строка
// 
// Возвращаемое значение:
//  Строка
Функция КонтрольнаяСуммаТикетаИТС(ТикетИТС) Экспорт
	
	ВкИД = "Native";
	Класс = "ReportingAccess";
	ПутьВК = "ОбщийМакет.КомпонентаШиныОтчетности";
	Попытка
		Компонента = Новый ("Addin." + ВкИД + "." + Класс); // ВнешнийКомпонент
	Исключение
		Компонента = Неопределено; // ВнешнийКомпонент
	КонецПопытки;

	Если Компонента = Неопределено Тогда
		//Результат = Ждать УстановитьВнешнююКомпонентуАсинх(ПутьВК);
		Подключена = ПодключитьВнешнююКомпоненту(ПутьВК, ВкИД);
		Если Не Подключена Тогда
			Возврат "";
		КонецЕсли;
		Компонента = Новый ("Addin." + ВкИД + "." + Класс); // ВнешнийКомпонент
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТикетИТС) Тогда
		Возврат "";
	КонецЕсли;
	
	//@skip-check dynamic-access-method-not-found
	Хеш = Компонента.ПолучитьХешДоступа(ТикетИТС); // Строка
	
	Возврат Хеш;
	 
КонецФункции

// Возвращает параметры авторизации.
// 
// Параметры:
//  Соединение - Неопределено, HTTPСоединение -
//  Принудительно  - Булево - Принудительное получение нового токена
//  ЭтоРегистрация - Булево - Признак регистрации новой учетной информационной базы
// 
// Возвращаемое значение:
//  Структура:
// * Токен    - Строка - 
// * ТикетИТС - Строка - 
Функция ПараметрыАвторизации(Соединение = Неопределено, Принудительно = Ложь, ЭтоРегистрация = Ложь) Экспорт
	
	Если ПривилегированныйРежим() = Ложь Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Результат = Новый Структура("Токен, ТикетИТС", "", "");
	
	АдресаШины = АдресаШины();
	
	Если Соединение = Неопределено Тогда   
		ОписаниеОшибки = "";
		Соединение = УстановитьСоединениеССерверомИнтернета(АдресаШины.Сервер, ОписаниеОшибки);	
		Если Соединение = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоРегистрация = Ложь Тогда
		ПостфиксНастройки = "Основная";
	Иначе
		ПостфиксНастройки = "Registration";
	КонецЕсли;
	
	СтруктураТокена = Неопределено;

	Если Принудительно = Ложь Тогда
		СтруктураТокена = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			ПрефикДанныхВБезопасномХранилище() + ПостфиксНастройки, 
			"СтруктураТокена"); // см. Отчетность24БРО.НоваяСтруктураТокена
	КонецЕсли;
	
	РезультатПолученияТикета = ТикетАутентификацииНаПорталеПоддержки();
	Если РезультатПолученияТикета = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ТикетИТС = РезультатПолученияТикета.Тикет;
	
	Если СтруктураТокена = Неопределено Или СтруктураТокена.Окончание < ТекущаяДатаСеанса() Тогда
		НастройкиДоступа = НастройкиДоступа(ЭтоРегистрация);
		ИмяПользователя = НастройкиДоступа.КлиентШиныОтчетности;
		ПарольПользователя = НастройкиДоступа.СекретШиныОтчетности; 
		
		Если ЭтоРегистрация И ЗначениеЗаполнено(ИмяПользователя) = Ложь 
			Или ЗначениеЗаполнено(ПарольПользователя) = Ложь Тогда
			Возврат Результат;
		КонецЕсли;
		
		ЗапросАвторизация = Новый HTTPЗапрос;
		ЗапросАвторизация.АдресРесурса = АдресаШины.Хост + "/sys/token";
		ЗапросАвторизация.Заголовки.Вставить(НРег("Content-Type"), "application/x-www-form-urlencoded");
		ЗапросАвторизация.Заголовки.Вставить(НРег("TicketITS"), Результат.ТикетИТС);
		ЗапросАвторизация.Заголовки.Вставить(НРег("TicketControl"), КонтрольнаяСуммаТикетаИТС(Результат.ТикетИТС));
		ЗапросАвторизация.Заголовки.Вставить(НРег("Authorization"),
			"Basic "
			+ СтрЗаменить(СтрЗаменить(ПолучитьBase64СтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(
				ИмяПользователя
				+ ":"
				+ ПарольПользователя)), Символы.ВК, ""), Символы.ПС, ""));
		ЗапросАвторизация.УстановитьТелоИзСтроки("grant_type=CLIENT_CREDENTIALS");
		
		Попытка
			//@skip-check bsl-legacy-check-dynamic-feature-access
			Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросАвторизация);
		Исключение
			ОписаниеОшибки = НСтр("ru='Не удалось получить сообщение от сервера шины 1С:Отчетность 24'");
			Возврат Результат;
		КонецПопытки;
		
		Если Ответ.КодСостояния = 200 Тогда
			ОтветСтрока = Ответ.ПолучитьТелоКакСтроку();
			ОтветСтруктура = ОбщегоНазначения.JSONВЗначение(ОтветСтрока); // Соответствие
			Результат.Токен = Строка(ОтветСтруктура.Получить("id_token"));
	
			СтруктураТокена = НоваяСтруктураТокена(Результат.Токен);

			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				ПрефикДанныхВБезопасномХранилище() + ПостфиксНастройки, СтруктураТокена, "СтруктураТокена");

			Если ЭтоРегистрация Тогда
				// Сброс токена
				ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
					ПрефикДанныхВБезопасномХранилище() + "Основная", Неопределено, "СтруктураТокена");
			КонецЕсли;
		Иначе
			ЗаписатьОшибкуСервераВЖурналРегистрации(Ответ);
			Возврат Результат;
		КонецЕсли;
	Иначе
		Результат.Токен = СтруктураТокена.Токен;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записать ошибку сервера в журнал регистрации.
// 
// Параметры:
//  Ответ - HTTPОтвет
Процедура ЗаписатьОшибкуСервераВЖурналРегистрации(Ответ) Экспорт
	
	ОписаниеОшибки = СтрШаблон("%1 %2%3%4", НСтр("ru='Код состояния:'"), Ответ.КодСостояния, Символы.ПС, 
		Ответ.ПолучитьТелоКакСтроку());
		
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Ошибка, , ,
		ОписаниеОшибки);
		
КонецПроцедуры

// Возвращает тикет аутентификации на портале поддержки.
// 
// Возвращаемое значение:
//  Неопределено, Структура - :
// * Тикет              - Неопределено, Строка - 
// * КодОшибки          - Строка - 
// * СообщениеОбОшибке  - Строка - 
// * ИнформацияОбОшибке - Строка - 
Функция ТикетАутентификацииНаПорталеПоддержки() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВладелецТикета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ВладелецТикета();
	
	МодульИнтернетПоддержкаПользователей = ЭлектронныйДокументооборотСКонтролирующимиОрганами.МодульИнтернетПоддержкаПользователей();
	
	Если МодульИнтернетПоддержкаПользователей = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		
		РезультатПолученияТикета = МодульИнтернетПоддержкаПользователей.ТикетАутентификацииНаПорталеПоддержки(ВладелецТикета);
		
		//@skip-check constructor-function-return-section
		Возврат РезультатПолученияТикета;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Причина ошибки.
// 
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке - Информация об ошибке
// 
// Возвращаемое значение:
//  ИнформацияОбОшибке
Функция ПричинаОшибки(ИнформацияОбОшибке)
	
	Результат = ИнформацияОбОшибке;
	Если ИнформацияОбОшибке <> Неопределено Тогда
		Если ИнформацияОбОшибке.Причина <> Неопределено Тогда
			Результат = ПричинаОшибки(ИнформацияОбОшибке.Причина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти