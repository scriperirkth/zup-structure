КонецФункции

// Возвращает используемую версию БРО
// 
// Возвращаемое значение:
//  Строка - Версия БРО
Функция ВерсияБРО() Экспорт 
	
	ОписаниеВерсии = Новый Структура("Имя, Версия, ТребуемыеПодсистемы", "","", Новый Массив()); 
	ОбновлениеИнформационнойБазыБРО.ПриДобавленииПодсистемы(ОписаниеВерсии);

	Возврат ОписаниеВерсии.Версия;
		
КонецФункции

// Возвращает используемую версию БЗК
// 
// Возвращаемое значение:
//  Строка 
Функция ВерсияБЗК() Экспорт 
	
	ОписаниеВерсии = Новый Структура("Имя, Версия, ТребуемыеПодсистемы", "","", Новый Массив());
	
	//@skip-check bsl-legacy-check-string-literal
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы") Тогда
		Модуль = ОбщегоНазначения.ОбщийМодуль("ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый");
		//@skip-check dynamic-access-method-not-found
		Модуль.ПриДобавленииПодсистемы(ОписаниеВерсии);
	КонецЕсли;

	Возврат ОписаниеВерсии.Версия;
		
КонецФункции

// Выполняет удаление сохраненных настроек окна формы
// 
// Параметры:
//  ИмяФормы - Строка
Процедура СброситьНастройкиОкна(ИмяФормы) Экспорт
	
	КлючиОбъектов = Новый Массив; // Массив Из Строка
	
	КлючиОбъектов.Добавить(СтрШаблон("%1/НастройкиОкна", ИмяФормы));
	КлючиОбъектов.Добавить(СтрШаблон("%1/Такси/НастройкиОкна", ИмяФормы));
	
	КлючиОбъектов.Добавить(СтрШаблон("%1/НастройкиОкнаТонкогоКлиента", ИмяФормы));
	КлючиОбъектов.Добавить(СтрШаблон("%1/Такси/НастройкиОкнаТонкогоКлиента", ИмяФормы));
	
	КлючиОбъектов.Добавить(СтрШаблон("%1/КлючСохраненияПоложенияОкна/НастройкиОкнаТонкогоКлиента", ИмяФормы));
	КлючиОбъектов.Добавить(СтрШаблон("%1/КлючСохраненияПоложенияОкна/Такси/НастройкиОкнаТонкогоКлиента", ИмяФормы));
	
	КлючиОбъектов.Добавить(СтрШаблон("%1/НастройкиОкнаВебКлиента", ИмяФормы));
	КлючиОбъектов.Добавить(СтрШаблон("%1/Такси/НастройкиОкнаВебКлиента", ИмяФормы));
	
	КлючиОбъектов.Добавить(СтрШаблон("%1/Такси/НастройкиОкнаМобильногоКлиента", ИмяФормы));
	КлючиОбъектов.Добавить(СтрШаблон("%1/Такси/НастройкиОкнаМобильнойПлатформы", ИмяФормы));
	
	ИмяПользователя = ИмяПользователя();
	
	Для Каждого КлючОбъекта Из КлючиОбъектов Цикл
	    ХранилищеСистемныхНастроек.Удалить(КлючОбъекта, Неопределено, ИмяПользователя);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает настройки доступа регистрации.
// 
// Параметры:
//  РежимРегистрацииБазы - Булево
// 
// Возвращаемое значение:
//  Структура:
// * КлиентШиныОтчетности - Строка - 
// * СекретШиныОтчетности - Строка - 
Функция НастройкиДоступа(РежимРегистрацииБазы = Ложь) Экспорт

	Если РежимРегистрацииБазы Тогда
		ИмяПодсистемы = "Отчетность1С";
		Если ОбщегоНазначения.ПодсистемаСуществует(ИмяПодсистемы) Тогда
			ИмяМодуля = "СервисИнтеграцииСУчетнымиСистемами";
			Модуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
			//@skip-check dynamic-access-method-not-found
			Возврат Модуль.НастройкиДоступа();
		КонецЕсли;
	КонецЕсли;

	Если ПривилегированныйРежим() = Ложь Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Результат = Новый Структура("КлиентШиныОтчетности, СекретШиныОтчетности", "", "");
	Результат.КлиентШиныОтчетности = Строка(Константы.КлиентШиныОтчетности.Получить());
	Результат.СекретШиныОтчетности = Строка(Константы.СекретШиныОтчетности.Получить());

	Возврат Результат;
	
КонецФункции

// Возвращает значение заголовка HTTP по имени (регистронезависимый)
//
// Параметры:
//  ЗаголовкиHTTP	 - Соответствие Из КлючИЗначение:
//  * Ключ - Строка
//  * Значение - Строка
//  ИмяЗаголовка	 - Строка
// 
// Возвращаемое значение:
//   Неопределено, Строка -
Функция ЗначениеЗаголовкаHTTP(ЗаголовкиHTTP, ИмяЗаголовка) Экспорт
	Результат = Неопределено;
	Для Каждого КлючИЗначение Из ЗаголовкиHTTP Цикл
		Если НРег(КлючИЗначение.Ключ) = НРег(ИмяЗаголовка) Тогда
			Результат = КлючИЗначение.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
	
// Возвращает идентификатор базы для подключения к шине отчетности.
//
// Возвращаемое значение:
//  Строка
Функция ИдентификаторБазы() Экспорт

	Если ПривилегированныйРежим() = Ложь Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	Если БезопасныйРежим() Тогда
		УстановитьОтключениеБезопасногоРежима(Истина);
	КонецЕсли;
	
	ИдентификаторБазыСохраненный =  ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			ПрефикДанныхВБезопасномХранилище(), 
			"ИдентификаторБазыШиныОтчетности"); // Строка
			
	РазделениеВключено = ОбщегоНазначения.РазделениеВключено();
	СтрокаСоединения = ?(РазделениеВключено, "", СтрокаСоединенияИнформационнойБазы());
	
	ПозицияИмениБазы = СтрНайти(СтрокаСоединения, ";Ref=");
	Если ПозицияИмениБазы > 0 Тогда
		// для серверных баз учитываем только имя базы, т.к. localhost может меняться на имя компьютера
		СтрокаСоединения = Сред(СтрокаСоединения, ПозицияИмениБазы + 6);
		СтрокаСоединения = Лев(СтрокаСоединения, СтрДлина(СтрокаСоединения)-2);
	КонецЕсли;
	
	ИмяКомпьютера = ?(РазделениеВключено, "", ИмяКомпьютера());
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторБазы", СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы());
	Результат.Вставить("ЭтоФайловаяБаза", ОбщегоНазначения.ИнформационнаяБазаФайловая());
	Результат.Вставить("РазделениеВключено", РазделениеВключено);
	
	Попытка
		Результат.Вставить("ОбластьДанныхЗначение", РаботаВМоделиСервиса.ЗначениеРазделителяСеанса());
	Исключение
		Результат.Вставить("ОбластьДанныхЗначение", 0);
	КонецПопытки;
	
	Результат.Вставить("СтрокаСоединения", СтрокаСоединения);
	Результат.Вставить("ИмяКомпьютера", ИмяКомпьютера);
	
	ИдентификаторБазы =  ОбщегоНазначения.КонтрольнаяСуммаСтрокой(Результат, ХешФункция.MD5); 
	
	Если ИдентификаторБазыСохраненный <> ИдентификаторБазы Тогда
		
		УстановитьОтключениеБезопасногоРежима(Истина);
		
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
			ПрефикДанныхВБезопасномХранилище(), 
			ИдентификаторБазы, "ИдентификаторБазыШиныОтчетности");

		// очистка токена, т.к. сменился идентифкатор базы для шины
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
			ПрефикДанныхВБезопасномХранилище() + "Основная", 
			Неопределено, "СтруктураТокена");
			
		// очистка токена, т.к. сменился идентифкатор базы для шины
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
			ПрефикДанныхВБезопасномХранилище() + "Registration", 
			Неопределено, "СтруктураТокена");

		Константы.КлиентШиныОтчетности.Установить("");
		Константы.СекретШиныОтчетности.Установить("");
		
	КонецЕсли;
	
	Возврат ИдентификаторБазы;
	
КонецФункции

// Возвращает время жизни токена авторизации.
// 
// Возвращаемое значение:
//  Число
Функция ВремяЖизниТокенаАвторизации() Экспорт
	Возврат 60 * 60;
КонецФункции

// Возвращает адрес области или строку соединения с ИБ
// 
// Возвращаемое значение:
//  Строка
Функция АдресОбласти() Экспорт
	
	Результат = "";
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Результат = ПолучитьНавигационнуюСсылкуИнформационнойБазы();
	Иначе
		Результат = СтандартныеПодсистемыСервер.ПараметрыКлиентаНаСервере().Получить("СтрокаСоединенияИнформационнойБазы"); // Строка
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = ИдентификаторБазы();
		КонецЕсли;
	КонецЕсли;  
	
	Возврат Строка(Результат);
	
КонецФункции

// Создает новую структуру токена.
// 
// Параметры:
//  Токен - Строка
// 
// Возвращаемое значение:
//  Структура:
// * Токен     - Строка
// * Окончание - Дата 
Функция НоваяСтруктураТокена(Токен) Экспорт
	СтруктураТокена = Новый Структура;
	СтруктураТокена.Вставить("Токен", Токен);
	СтруктураТокена.Вставить("Окончание", ТекущаяДатаСеанса() + ВремяЖизниТокенаАвторизации());
	Возврат СтруктураТокена;
КонецФункции

