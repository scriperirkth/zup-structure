Функция ТипыНаставников() Экспорт
	
	ТипыНаставников = Новый СписокЗначений;
	ТипыНаставников.Добавить(Тип("СправочникСсылка.Сотрудники"), Метаданные.Справочники.Сотрудники.Представление());
