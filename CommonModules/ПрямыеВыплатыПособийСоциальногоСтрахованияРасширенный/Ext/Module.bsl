		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.КоличествоСтраниц
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоСтраниц,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.ДокументОснование
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ОплатаДнейУходаЗаДетьмИинвалидами.ПустаяСсылка)
		|	КОНЕЦ КАК ДокументОснование,
		|	ВсеОстаткиОплат.Сотрудник КАК Сотрудник,
		|	ВсеОстаткиОплат.Ребенок КАК Ребенок,
		|	ВсеОстаткиОплат.Месяц КАК Месяц,
		|	ВсеОстаткиОплат.ИзмененаСуммаВзносов КАК ИзмененаСуммаВзносов,
		|	ВсеОстаткиОплат.ИспользоватьОстатокДнейЗаГод КАК ИспользоватьОстатокДнейЗаГод,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.СреднедневнойЗаработок
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СреднедневнойЗаработок,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.СреднедневнойЗаработокЗаГод
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СреднедневнойЗаработокЗаГод,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.СуммаПособия
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаПособия,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|				ИЛИ ВсеОстаткиОплат.ИзмененаСуммаВзносов
		|			ТОГДА ВсеОстаткиОплат.СуммаВзносовДоступная
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаВзносов,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.КоличествоДней
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоДней,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.КоличествоЧасовЗаМесяц
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоЧасовЗаМесяц,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.КоличествоДнейЗаГод
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоДнейЗаГод,
		|	ВЫБОР
		|		КОГДА ОбработанныеДокументы.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ВсеОстаткиОплат.КоличествоЧасовЗаГод
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоЧасовЗаГод,
		|	ВсеОстаткиОплат.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ НовыеОплаты
		|ИЗ
		|	ВсеОстаткиОплат КАК ВсеОстаткиОплат
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОбработанныеДокументы КАК ОбработанныеДокументы
		|		ПО ВсеОстаткиОплат.ФизическоеЛицо = ОбработанныеДокументы.ФизическоеЛицо
		|			И ВсеОстаткиОплат.Месяц = ОбработанныеДокументы.Месяц
		|			И ВсеОстаткиОплат.ДокументОснование = ОбработанныеДокументы.ДокументОснование
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ОбработанныеДокументы.ДокументОснование ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ВсеОстаткиОплат.ИспользоватьОстатокДнейЗаГод
		|					И НЕ ОбработанныеДокументы.ИспользованОстаток
		|		КОНЕЦ";
	
	Возврат Текст;
КонецФункции

// Текст запроса, заполняет исправление и новые заявления, формирует общие строки по совместителям и накопленные дни.
// Работает по принципу отбора - новые оплаты или данные оплат по ключевым полям (ФизическоеЛицо, Месяц, Ребенок)
// из исправленного заявления.
//
// Возвращаемое значение:
//    Строка - текст запроса.
//
Функция ТекстЗапросаЗаполненияЗаявления()
	Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НовыеОплаты.КоличествоСтраниц КАК КоличествоСтраниц,
		|	НовыеОплаты.ДокументОснование КАК ДокументОснование,
		|	НовыеОплаты.Сотрудник КАК Сотрудник,
		|	НовыеОплаты.Ребенок КАК Ребенок,
