////////////////////////////////////////////////////////////////////////////////
// Подсистема "Квоты для трудоустройства"
//
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область КадровыйУчет

Процедура ДополнитьФормуКадровогоПриказа(Форма, ЭтоТабличнаяЧасть = Ложь, ЭтоПеревод = Ложь) Экспорт
	
	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементГруппаВидКвоты = Форма.Элементы.Найти("ГруппаВидКвоты");
	Если ЭлементГруппаВидКвоты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоПеревод И не ЭтоТабличнаяЧасть Тогда
		Элемент = Форма.Элементы.Найти("ИзменитьКвоту");
		Если Элемент = Неопределено Тогда
			Элемент = Форма.Элементы.Вставить("ИзменитьКвоту", Тип("ПолеФормы"), ЭлементГруппаВидКвоты);
			Элемент.Вид = ВидПоляФормы.ПолеФлажка;
			Элемент.Заголовок = "Изменить квоту";
			Элемент.ШрифтЗаголовка = ШрифтыСтиля.ВажнаяНадписьШрифт;
			Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
			Элемент.ПутьКДанным = "Объект.ИзменитьКвоту";
			Если Не ЭтоТабличнаяЧасть Тогда
				Элемент.УстановитьДействие("ПриИзменении", "Подключаемый_ИзменитьКвотуПриИзменении");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Элемент = Форма.Элементы.Найти("ВидКвоты");
	Если Элемент = Неопределено Тогда 
		Элемент = Форма.Элементы.Вставить("ВидКвоты", Тип("ПолеФормы"), ЭлементГруппаВидКвоты);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.Заголовок = "В счет квоты";
		Если ЭтоТабличнаяЧасть Тогда
			Элемент.ПутьКДанным = "Объект.Сотрудники.ВидКвоты";
		Иначе
			Элемент.КнопкаОчистки = Истина;
			Элемент.ПутьКДанным = "Объект.ВидКвоты";
			Элемент.УстановитьДействие("ПриИзменении", "Подключаемый_ВидКвотыПриИзменении");
			Элемент.УстановитьДействие("Очистка", "Подключаемый_ВидКвотыОчистка");
			Элемент.КнопкаСоздания = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Элемент = Форма.Элементы.Найти("КатегорияКвоты");
	Если Элемент = Неопределено Тогда
		Элемент = Форма.Элементы.Вставить("КатегорияКвоты", Тип("ПолеФормы"), ЭлементГруппаВидКвоты);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.Заголовок = "Категория квоты";
		Если ЭтоТабличнаяЧасть Тогда
			Элемент.ПутьКДанным = "Объект.Сотрудники.КатегорияКвоты";
		Иначе
			Элемент.ПутьКДанным = "Объект.КатегорияКвоты";
			Элемент.КнопкаСоздания = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

Процедура КадровыйПереводДополнитьРасшифровкуСтрокиСотрудника(Форма, ИдентификаторСтрокиСотрудника, ТекстРасшифровки) Экспорт
	
	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Форма.Объект;
	СтрокаСотрудника = Объект.Сотрудники.НайтиПоИдентификатору(ИдентификаторСтрокиСотрудника);
	
	Если СтрокаСотрудника.ИзменитьКвоту Тогда
		ТекстРасшифровки = ?(ПустаяСтрока(ТекстРасшифровки), "", ТекстРасшифровки + ";") + НСтр("ru='Изменён вид квоты'");
	КонецЕсли;
		
КонецПроцедуры

Процедура УстановитьЭлементыФормыДокумента(Форма, ЭтоПеревод = Ложь) Экспорт
	
	УстановитьЗначенияКвотыВФормеДокументаКадровогоПриказа(Форма, ЭтоПеревод);
	УстановитьСвойстваЭлементовВФормеДокумента(Форма, ЭтоПеревод);
	
КонецПроцедуры

Процедура УстановитьСвойстваЭлементовВФормеДокумента(Форма, ЭтоПеревод = Ложь) Экспорт
	
	УстановитьСвойстваЭлементаИзменитьКвотуВФормеДокумента(Форма, ЭтоПеревод);
	УстановитьСвойстваЭлементаВидКвотыВФормеДокумента(Форма, ЭтоПеревод);
	УстановитьСвойстваЭлементаКатегорияКвотыВФормеДокумента(Форма, ЭтоПеревод);
	
КонецПроцедуры 

Процедура ПриИзмененииЭлементаФормыКадровогоПриказа(Форма, ИмяЭлемента, ЭтоПеревод = Ложь, УстановитьСвойстваЭлементов = Ложь) Экспорт

	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоПеревод И ИмяЭлемента = "ИзменитьКвоту" Тогда
		УстановитьЗначенияКвотыВФормеДокументаКадровогоПриказа(Форма, ЭтоПеревод);
		УстановитьСвойстваЭлементовВФормеДокумента(Форма, ЭтоПеревод);
	КонецЕсли;
	
	Если ИмяЭлемента = "ВидКвоты" Тогда
		АвтозаполнениеКатегорииКвотыВФормеДокумента(Форма, ЭтоПеревод);
		УстановитьСвойстваЭлементаКатегорияКвотыВФормеДокумента(Форма, ЭтоПеревод);
	КонецЕсли;
	
	Если УстановитьСвойстваЭлементов Тогда
		УстановитьСвойстваЭлементовВФормеДокумента(Форма, ЭтоПеревод);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоляОтбораПериодическихДанных(ПоляОтбораПериодическихДанных, Отбор) Экспорт
	
	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	ПоляОтбораПериодическихДанных.Вставить("ТрудоустройствоСотрудниковПоКвотам", Отбор);
	
КонецПроцедуры

Процедура ДобавитьКлючиСтруктурыТекущихКадровыхДанныхСотрудника(КлючиСтруктурыТекущихКадровыхДанныхСотрудника) Экспорт
	
	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	КлючиСтруктурыТекущихКадровыхДанныхСотрудника = КлючиСтруктурыТекущихКадровыхДанныхСотрудника + ",ТрудоустроенПоКвоте,ВидКвоты,КатегорияКвоты";
	
КонецПроцедуры

Процедура УстановитьТекущиеЗначенияРеквизитовФормыКадровогоПеревода(ОбъектДанных, ТекущиеКадровыеДанные = Неопределено) Экспорт
	
	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоляВидКвоты = "ТекущийВидКвоты";
	ИмяПоляКатегорияКвоты = "ТекущаяКатегорияКвоты";
	
	ТекущийВидКвоты = Справочники.ВидыКвотДляТрудоустройства.ПустаяСсылка();
	ТекущаяКатегорияКвоты = Справочники.КатегорииСотрудниковТрудоустроенныхПоКвотам.ПустаяСсылка();
	
	Если ТекущиеКадровыеДанные <> Неопределено Тогда
		Если ТекущиеКадровыеДанные.ТрудоустроенПоКвоте Тогда
			ТекущийВидКвоты = ТекущиеКадровыеДанные.ВидКвоты;
			ТекущаяКатегорияКвоты = ТекущиеКадровыеДанные.КатегорияКвоты;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектДанных, ИмяПоляВидКвоты) Тогда
		ОбъектДанных[ИмяПоляВидКвоты] = ТекущийВидКвоты;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектДанных, ИмяПоляКатегорияКвоты) Тогда
		ОбъектДанных[ИмяПоляКатегорияКвоты] = ТекущаяКатегорияКвоты;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЗначенияКвотыВФормеДокументаКадровогоПриказа(Форма, ЭтоПеревод = Ложь) Экспорт

	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Организация");
	Должность = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Должность");
	
	Если ЭтоПеревод Тогда
		ДатаСобытия = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаНачала");
		ДатаОкончания = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаОкончания");
		ИзменитьПодразделениеИДолжность = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьПодразделениеИДолжность");
		ИзменитьКвоту = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьКвоту");
	Иначе
		ДатаСобытия = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаПриема");
		ИзменитьПодразделениеИДолжность = Ложь;
		ИзменитьКвоту = Ложь;
		ДатаОкончания = Неопределено;
	КонецЕсли;
	
	Если Не ЭтоПеревод ИЛИ (ИзменитьПодразделениеИДолжность И ИзменитьКвоту И Не ЗначениеЗаполнено(ДатаОкончания)) Тогда
		
		Если Не ЗначениеЗаполнено(Организация) ИЛИ Не ЗначениеЗаполнено(Должность) ИЛИ Не ЗначениеЗаполнено(ДатаСобытия) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты", Неопределено);
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.КатегорияКвоты", Неопределено);
			Возврат;
		КонецЕсли;
		
		ВидКвоты = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты");
		ДоступныеКвоты = ТрудоустройствоПоКвотам.ДоступныеКвотыПоДолжности(Организация, Должность, ДатаСобытия);
		
		Если ЗначениеЗаполнено(ВидКвоты) Тогда
			
			Если ДоступныеКвоты.Найти(ВидКвоты) = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты", Неопределено);
				ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.КатегорияКвоты", Неопределено);
			КонецЕсли;
			
		ИначеЕсли Не ЭтоПеревод Тогда
			
			ФизическоеЛицо = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ФизическоеЛицо");
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ФизическоеЛицо КАК ФизическоеЛицо,
			|	&ВидКвоты КАК ВидКвоты,
			|	&Период КАК Период
			|ПОМЕСТИТЬ ВТФизическиеЛица" 
			;
			Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
			Запрос.УстановитьПараметр("ВидКвоты", ВидКвоты);
			Запрос.УстановитьПараметр("Период", ДатаСобытия);
			Запрос.Выполнить();
			
			КвотыДляАвтозаполнения = ТрудоустройствоПоКвотам.АвтоподборВидовКвот(Запрос.МенеджерВременныхТаблиц);
			КоличествоКвот = КвотыДляАвтозаполнения.Количество();
			
			Если КоличествоКвот = 1 Тогда 
				Если Не ДоступныеКвоты.Найти(КвотыДляАвтозаполнения[0].ВидКвоты) = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты", КвотыДляАвтозаполнения[0].ВидКвоты);
					АвтозаполнениеКатегорииКвотыВФормеДокумента(Форма, ЭтоПеревод);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Сотрудник = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Сотрудник");
		
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			ТекущийВидКвоты = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "ТекущийВидКвоты");
			ТекущаяКатегорияКвоты = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "ТекущаяКатегорияКвоты");
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты", ТекущийВидКвоты);
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.КатегорияКвоты", ТекущаяКатегорияКвоты);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КатегорияКвоты", "РежимВыбораИзСписка", Ложь);
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты", Неопределено);
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.КатегорияКвоты", Неопределено);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры 

Процедура УстановитьСвойстваЭлементаИзменитьКвотуВФормеДокумента(Форма, ЭтоПеревод = Ложь) 

	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоПеревод Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьПодразделениеИДолжность = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьПодразделениеИДолжность");
	ДатаОкончания = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаОкончания");
	Должность = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Должность");
	Организация = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Организация");
	ВидКвоты = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты");
	ИзменитьКвоту = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьКвоту");

	Если ЭтоПеревод Тогда
		ДатаСобытия = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаНачала");
	Иначе
		ДатаСобытия = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаПриема");
	КонецЕсли;
	
	ИзменитьКвотуНовоеЗначение = ИзменитьКвоту;
	ДоступностьЭлементаИзменитьКвоту = ИзменитьПодразделениеИДолжность И Не ЗначениеЗаполнено(ДатаОкончания);
	
	Если ДоступностьЭлементаИзменитьКвоту Тогда
	
		ДоступныеКвоты = ТрудоустройствоПоКвотам.ДоступныеКвотыПоДолжности(Организация, Должность, ДатаСобытия);
		
		Если ЗначениеЗаполнено(ВидКвоты) И ДоступныеКвоты.Найти(ВидКвоты) = Неопределено Тогда
			ИзменитьКвотуНовоеЗначение = Истина;
			ДоступностьЭлементаИзменитьКвоту = Ложь;
		КонецЕсли;
		
	Иначе
		ИзменитьКвотуНовоеЗначение = Ложь;
	КонецЕсли;
	
	
	ИмяЭлемента = "ИзменитьКвоту";
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЭлемента, "Доступность", ДоступностьЭлементаИзменитьКвоту);
	
	Если Не ДоступностьЭлементаИзменитьКвоту И ИзменитьКвоту <> ИзменитьКвотуНовоеЗначение Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьКвоту", ИзменитьКвотуНовоеЗначение);
		УстановитьЗначенияКвотыВФормеДокументаКадровогоПриказа(Форма, ЭтоПеревод);
	КонецЕсли;
		
КонецПроцедуры

Процедура УстановитьСвойстваЭлементаВидКвотыВФормеДокумента(Форма, ЭтоПеревод = Ложь) 

	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Организация");
	Должность = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Должность");
	
	Если ЭтоПеревод Тогда
		ДатаСобытия = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаНачала");
	Иначе
		ДатаСобытия = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаПриема");
	КонецЕсли;
	
	РеквизитВидКвотыДоступен = ЗначениеЗаполнено(ДатаСобытия) И ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Должность);
	
	ДоступныеКвоты = Новый Массив;
	
	Если РеквизитВидКвотыДоступен Тогда
		
		ДоступныеКвоты = ТрудоустройствоПоКвотам.ДоступныеКвотыПоДолжности(Организация, Должность, ДатаСобытия);

		Если ДоступныеКвоты.Количество() = 0 Тогда
			РеквизитВидКвотыДоступен = Ложь;
		КонецЕсли;

	КонецЕсли;
	
	ИмяЭлемента = "ВидКвоты";

	ИзменитьПодразделениеИДолжность = Истина;
	ИзменитьКвоту = Истина;
	Если ЭтоПеревод Тогда
		ИзменитьПодразделениеИДолжность = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьПодразделениеИДолжность");
		ИзменитьКвоту = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьКвоту");
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЭлемента, "Доступность", РеквизитВидКвотыДоступен И ИзменитьПодразделениеИДолжность И ИзменитьКвоту);

	Если РеквизитВидКвотыДоступен И ИзменитьПодразделениеИДолжность И ИзменитьКвоту Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЭлемента, "РежимВыбораИзСписка", Истина);
		
		ЭлементФормы = Форма.Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда 
			Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
				Если ЭлементФормы.РежимВыбораИзСписка Тогда
					ЭлементФормы.СписокВыбора.ЗагрузитьЗначения(ДоступныеКвоты);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьСвойстваЭлементаКатегорияКвотыВФормеДокумента(Форма, ЭтоПеревод = Ложь) 

	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Организация");
	Должность = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Должность");
	ВидКвоты = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты");

	Если ЭтоПеревод Тогда
		ДатаСобытия = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаНачала");
	Иначе
		ДатаСобытия = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаПриема");
	КонецЕсли;
	
	РеквизитКатегорияКвотыДоступен = ЗначениеЗаполнено(ДатаСобытия) И ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Должность) И ЗначениеЗаполнено(ВидКвоты);
	ДоступныеКатегории = Новый Массив;
	
	Если РеквизитКатегорияКвотыДоступен Тогда
		
		ДоступныеКатегорииПоВидуКвоты = ТрудоустройствоПоКвотам.ДоступныеКатегорииПоВидуКвоты(ВидКвоты);

		Если ДоступныеКатегорииПоВидуКвоты.Количество() = 0 Тогда
			РеквизитКатегорияКвотыДоступен = Ложь;
		КонецЕсли;

	КонецЕсли;
	
	ИмяЭлемента = "КатегорияКвоты";

	ИзменитьПодразделениеИДолжность = Истина;
	ИзменитьКвоту = Истина;
	Если ЭтоПеревод Тогда
		ИзменитьПодразделениеИДолжность = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьПодразделениеИДолжность");
		ИзменитьКвоту = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ИзменитьКвоту");
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЭлемента, "Доступность", РеквизитКатегорияКвотыДоступен И ИзменитьПодразделениеИДолжность И ИзменитьКвоту);
	
	Если РеквизитКатегорияКвотыДоступен И ИзменитьПодразделениеИДолжность И ИзменитьКвоту Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЭлемента, "РежимВыбораИзСписка", Истина);
		
		ЭлементФормы = Форма.Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда 
			Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
				Если ЭлементФормы.РежимВыбораИзСписка Тогда
					ЭлементФормы.СписокВыбора.ЗагрузитьЗначения(ДоступныеКатегорииПоВидуКвоты);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура АвтозаполнениеКатегорииКвотыВФормеДокумента(Форма, ЭтоПеревод = Ложь) 

	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	ВидКвоты = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ВидКвоты");
	ТекущаяКатегорияКвоты = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.КатегорияКвоты");
	ДанныеКатегорииКвоты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяКатегорияКвоты, "ВидКвоты");
	
	Если ВидКвоты <> ДанныеКатегорииКвоты.ВидКвоты Тогда
		
		Если ЭтоПеревод Тогда
			Период = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаНачала");
		Иначе
			Период = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ДатаПриема");
		КонецЕсли;
		
		ФизическоеЛицо = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ФизическоеЛицо");
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ФизическоеЛицо КАК ФизическоеЛицо,
		|	&ВидКвоты КАК ВидКвоты,
		|	&Период КАК Период
		|ПОМЕСТИТЬ ВТФизическиеЛица" 
		;
		Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
		Запрос.УстановитьПараметр("ВидКвоты", ВидКвоты);
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.Выполнить();
		
		КатегорииДляАвтозаполнения = ТрудоустройствоПоКвотам.АвтоподборКатегорийКвот(Период, Запрос.МенеджерВременныхТаблиц);
		КоличествоКатегорий = КатегорииДляАвтозаполнения.Количество();
		
		Если КоличествоКатегорий = 1 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.КатегорияКвоты", КатегорииДляАвтозаполнения[0].КатегорияКвоты);
		ИначеЕсли КоличествоКатегорий = 0 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.КатегорияКвоты", Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОхранаТруда

Процедура ДополнитьФормуРабочегоМеста(Форма) Экспорт
	
	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементГруппаСпециальноеРабочееМесто = Форма.Элементы.Найти("ГруппаСпециальноеРабочееМесто");
	Если ЭлементГруппаСпециальноеРабочееМесто = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = "СпециальноеРабочееМестоДляИнвалидов";

	Элемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если Элемент = Неопределено Тогда
		Элемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), ЭлементГруппаСпециальноеРабочееМесто);
		Элемент.Вид = ВидПоляФормы.ПолеФлажка;
		Элемент.Заголовок = "Специальное рабочее место для трудоустройства инвалидов";
		Элемент.ПутьКДанным = "Объект.СпециальноеРабочееМестоДляИнвалидов";
	КонецЕсли;
	
КонецПроцедуры

Процедура РабочееМестоОхраныТрудаУстановитьОтображениеЭлементовФормы(Форма) Экспорт
	
	УстановитьСвойстваЭлементаСпециальноеРабочееМестоДляИнвалидаФормеСправочника(Форма);
	
КонецПроцедуры 

Процедура УстановитьСвойстваЭлементаСпециальноеРабочееМестоДляИнвалидаФормеСправочника(Форма) 

	Если Не ТрудоустройствоПоКвотам.ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = "СпециальноеРабочееМестоДляИнвалидов";

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЭлемента, "ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Право);

КонецПроцедуры

