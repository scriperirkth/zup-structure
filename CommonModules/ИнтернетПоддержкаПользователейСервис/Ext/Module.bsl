// Определяет по коду состояния и коду ошибки сервиса тип ошибки для потребителей.
//
// Параметры:
//  КодСостояния - Число - код состояния ответа сервиса;
//
// Возвращаемое значение:
//  Строка - код ошибки сервиса.
//
Функция ПереопределитьКодОшибкиСервиса(КодСостояния)
	
	Если КодСостояния = 200 Тогда
		Возврат "";
	ИначеЕсли КодСостояния = 400
		Или КодСостояния = 404
		Или КодСостояния = 422 Тогда
		Возврат КодОшибкиНеверныйФорматЗапроса();
	ИначеЕсли КодСостояния = 401 Тогда
		Возврат ИнтернетПоддержкаПользователейКлиентСервер.КодОшибкиАутентификации();
	ИначеЕсли КодСостояния = 403 Тогда
		Возврат КодОшибкиОтсутствуетДоступКСервису();
	ИначеЕсли КодСостояния = 409 Тогда
		Возврат КодОшибкиКонфликт();
	ИначеЕсли КодСостояния = 429 Тогда
		Возврат ИнтернетПоддержкаПользователейКлиентСервер.КодОшибкиПревышеноКоличествоПопыток();
	ИначеЕсли КодСостояния = 503 Тогда
		Возврат КодОшибкиСервисВременноНеДоступен();
	ИначеЕсли КодСостояния >= 500 Тогда
		Возврат КодОшибкиОшибкаСервиса();
	ИначеЕсли КодСостояния = 0 Тогда
		Возврат КодОшибкиОшибкаПодключения();
	ИначеЕсли КодСостояния = -1
		Или КодСостояния = -2 Тогда
		Возврат КодОшибкиБлокировкаСервисовИПП();
	Иначе
		Возврат КодОшибкиНеизвестнаяОшибка();
	КонецЕсли;
	
КонецФункции

// Определяет по коду ошибки сообщение пользователю.
//
// Параметры:
//  КодОшибки - Строка - ошибка сервиса см. функцию ПереопределитьКодОшибкиСервиса.
//  КодСостояния - Число - код ответа сервиса.
//
// Возвращаемое значение:
//  Строка - сообщение пользователю.
//
Функция ПереопределитьСообщениеПользователю(
		КодОшибки,
		КодСостояния = 0) Экспорт
	
	Если КодСостояния = -1 Тогда
		Возврат ОбщегоНазначения.ЗапрещенДоступКИнтернетСервисамТекстСообщения();
	ИначеЕсли КодСостояния = -2 Тогда
		Возврат ИнтернетПоддержкаПользователей.ЗапрещенДоступКИнтернетПоддержкеТекст();
	КонецЕсли;
	
	Если КодОшибки = КодОшибкиНеверныйФорматЗапроса() Тогда
		Возврат НСтр("ru = 'Неверный набор параметров или формат запроса. Обратитесь к администратору.'");
	КонецЕсли;
	
	Если КодОшибки = ИнтернетПоддержкаПользователейКлиентСервер.КодОшибкиАутентификации()
		Или КодОшибки = КодОшибкиОтсутствуетДоступКСервису() Тогда
			Возврат НСтр("ru = 'Ошибка аутентификации. Проверьте правильность ввода параметров аутентификации.'");
	КонецЕсли;
	
	Если КодОшибки = ИнтернетПоддержкаПользователейКлиентСервер.КодОшибкиПревышеноКоличествоПопыток() Тогда
		Возврат НСтр("ru = 'Превышено количество попыток аутентификации. Повторите попытку позже.'");
	КонецЕсли;
	
	Если КодОшибки = КодОшибкиСервисВременноНеДоступен() Тогда
		Возврат НСтр("ru = 'Не удалось подключиться к сервису Портала 1С:ИТС. Сервис временно недоступен.
			|Повторите попытку подключения позже.'");
	КонецЕсли;
	
	Если КодОшибки = КодОшибкиОшибкаСервиса() Тогда
		Возврат НСтр("ru = 'Ошибка работы с сервисом. Повторите попытку подключения позже.'");
	ИначеЕсли КодОшибки = "ОшибкаПодключения" Тогда
		Возврат НСтр("ru = 'Не удалось подключиться к Порталу 1С:ИТС. Обратитесь к администратору.'");
	Иначе
		Возврат НСтр("ru = 'Неизвестная ошибка при подключении к сервису.'");
	КонецЕсли;
	
КонецФункции

