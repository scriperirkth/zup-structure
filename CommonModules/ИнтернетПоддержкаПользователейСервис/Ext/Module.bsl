////////////////////////////////////////////////////////////////////////////////
// Вызов операции POST /rest/public/program-1c/isl/auth-tokens/integrated-sites/generate

// Выполняет создание нового токена для перехода на интегрированный сайт.
//
// Параметры:
//  МастерТокен - Строка, Неопределено - мастер токен пользователя на Портале 1С:ИТС.
//  Тикет - Строка, Неопределено - тикет аутентификации на Портале 1С:ИТС.
//  URL - Строка - URL интегрированного сайта.
//
// Возвращаемое значение:
//  Структура - результат создания мастер токена:
//    * Токен - Строка - созданный токен сервиса.
//    * КодОшибки - Строка - строковый код возникшей ошибки, который
//      может быть обработан вызывающим методом:
//        - <Пустая строка> - создание нового заказа выполнено успешно;
//        - "НеверныйФорматЗапроса" - передан некорректный запрос или настройка подключения;
//        - "ОшибкаАутентификации" - неверный логин или пароль или параметры
//          подключения к участнику СБП;
//        - "ПревышеноКоличествоПопыток" - превышено количество попыток
//          обращения к сервису с некорректным логином и паролем;
//        - "ОшибкаПодключения" - ошибка при подключении к сервису;
//        - "ОшибкаСервиса" - внутренняя ошибка сервиса;
//        - "НеизвестнаяОшибка" - при получении информации возникла
//          неизвестная (не обрабатываемая) ошибка;
//        - "СервисВременноНеДоступен" - на сервере ведутся регламентные работы;
//    * СообщениеОбОшибке  - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя;
//
Функция ОперацияТокенИнтегрированногоСайта(
		МастерТокен,
		Тикет,
		URL) Экспорт
	
	Результат = Новый Структура("
		|КодОшибки,
		|СообщениеОбОшибке,
		|Токен",
		"",
		"",
		"");
	
	Заголовки = ИнтернетПоддержкаПользователей.НовыйЗаголовкиВызоваОперации();
	URLОперации = URLОперацииСервиса(
		"/program-1c/isl/auth-tokens/integrated-sites/generate");
	
	ПараметрыЗапроса = HTTP.НовыйПараметрыЗапроса(
		integrated_sites_generate(
			МастерТокен,
			Тикет,
			URL),
		Заголовки);
	
	РезультатОтправки = HTTP.POST(
		URLОперации,
		ПараметрыЗапроса);
	
	Если Не ПустаяСтрока(РезультатОтправки.КодОшибки) Тогда
		
		Результат.КодОшибки = ПереопределитьКодОшибкиСервиса(
			РезультатОтправки.КодСостояния);
		Результат.СообщениеОбОшибке = ПереопределитьСообщениеПользователю(
			Результат.КодОшибки,
			РезультатОтправки.КодСостояния);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось создать токен для перехода на интегрированный сайт.
				|
				|%1
				|
				|%2'"),
			Результат.СообщениеОбОшибке,
			ТехническаяИнформацияОбОшибке(
				URLОперации,
				РезультатОтправки.КодОшибки,
				Заголовки,
				РезультатОтправки.ИнформацияОбОшибке));
		
		ИнтернетПоддержкаПользователей.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Неопределено,
			Истина);
		
		Возврат Результат;
		
	КонецЕсли;
	
	ДанныеОтвета = ПрочитатьДанные_integrated_sites_generate(
		РезультатОтправки.Содержимое);
	Результат.Токен = КодироватьСтроку(
		ДанныеОтвета.tokenValue,
		СпособКодированияСтроки.КодировкаURL);
	
	Возврат Результат;
	
КонецФункции

// Формирует параметры запроса для операции
// /rest/public/program-1c/isl/auth-tokens/integrated-sites/generate.
//
Функция integrated_sites_generate(
		МастерТокен,
		Тикет,
		URL)
	
	ЗаписьДанныхСообщения = Новый ЗаписьJSON;
	ЗаписьДанныхСообщения.УстановитьСтроку();
	ЗаписьДанныхСообщения.ЗаписатьНачалоОбъекта();
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("masterTokenValue");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(МастерТокен);
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("ticket");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(Тикет);
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("targetSitePageUrl");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(URL);
	
	ЗаписьДанныхСообщения.ЗаписатьКонецОбъекта();
	
	Возврат ЗаписьДанныхСообщения.Закрыть();
	
КонецФункции

