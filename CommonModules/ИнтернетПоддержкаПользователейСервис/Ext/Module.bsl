#Область СлужебныеПроцедурыИФункции

#Область ВызовОперацииПолученияМастерТокена

////////////////////////////////////////////////////////////////////////////////
// Вызов операции POST /rest/public/program-1c/isl/auth-tokens/master/generate

// Выполняет создание нового мастер токена.
//
// Параметры:
//  Логин - Строка - логин пользователя на Портале 1С:ИТС.
//  Пароль - Строка - пароль пользователя на Портале 1С:ИТС.
//  Тикет - Строка - тикет полученный на Портале 1С:ИТС.
//  ИдентификаторКлиента - Строка - текущий идентификатор клиента.
//  Сценарий - Строка - сценарий выполнения запроса.
//  Капча - Строка, Неопределено - капча, которую должен ввести пользователь в случае
//    блокировки частого получения мастер токена.
//
// Возвращаемое значение:
//  Структура - результат создания мастер токена:
//    * МастерТокен - Строка - созданный мастер токен;
//    * КапчаBase64 - Строка - картинка капчи в формате base64.
//       Картинка капчи может быть возвращена в случае получения ошибки
//       "ПревышеноКоличествоПопыток".
//    * КодОшибки - Строка - строковый код возникшей ошибки, который
//      может быть обработан вызывающим методом:
//        - <Пустая строка> - создание нового заказа выполнено успешно;
//        - "НеверныйФорматЗапроса" - передан некорректный запрос или настройка подключения;
//        - "ОшибкаАутентификации" - неверный логин или пароль или параметры
//          подключения к участнику СБП;
//        - "ПревышеноКоличествоПопыток" - превышено количество попыток
//          обращения к сервису с некорректным логином и паролем;
//        - "ОшибкаПодключения" - ошибка при подключении к сервису;
//        - "ОшибкаСервиса" - внутренняя ошибка сервиса;
//        - "НеизвестнаяОшибка" - при получении информации возникла
//          неизвестная (не обрабатываемая) ошибка;
//        - "СервисВременноНеДоступен" - на сервере ведутся регламентные работы;
//    * СообщениеОбОшибке  - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя;
//
Функция ОперацияМастерТокен(
		Логин,
		Пароль,
		Тикет,
		ИдентификаторКлиента,
		Сценарий,
		Капча = Неопределено) Экспорт
	
	Результат = ИнтернетПоддержкаПользователейКлиентСервер.НовыйРезультатПодключения();
	Результат.Вставить("ОбновитьИдентификатор", Ложь);
	Результат.Вставить("МастерТокен", Неопределено);
	
	Заголовки = ИнтернетПоддержкаПользователей.НовыйЗаголовкиВызоваОперации(Сценарий);
	URLОперации = URLОперацииСервиса("/program-1c/isl/auth-tokens/master/generate");
	
	ТелоЗапроса = master_generate(
			Логин,
			Пароль,
			Тикет,
			ИдентификаторКлиента,
			Капча);
	ПараметрыЗапроса = HTTP.НовыйПараметрыЗапроса(
		ТелоЗапроса,
		Заголовки);
	
	РезультатОтправки = HTTP.POST(
		URLОперации,
		ПараметрыЗапроса);
	
	Если Не ПустаяСтрока(РезультатОтправки.КодОшибки) Тогда
		
		Результат.КодОшибки = ПереопределитьКодОшибкиСервиса(
			РезультатОтправки.КодСостояния);
		Результат.СообщениеОбОшибке = ПереопределитьСообщениеПользователю(
			Результат.КодОшибки,
			РезультатОтправки.КодСостояния);
		
		Если Результат.КодОшибки = ИнтернетПоддержкаПользователейКлиентСервер.КодОшибкиПревышеноКоличествоПопыток()
			Или Результат.КодОшибки = КодОшибкиКонфликт()Тогда
			
			ДанныеОтвета = ПрочитатьДанные_master_generate(
				РезультатОтправки.Содержимое);
			Если ДанныеОтвета.type = "TOKEN_GENERATION_BLOCKED" Тогда
				Результат.КапчаBase64 = ДанныеОтвета.data.captchaChallengeImage;
			ИначеЕсли ДанныеОтвета.type = "TOKEN_ALREADY_EXISTS" Тогда
				Результат.ОбновитьИдентификатор = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось создать мастер токен.
				|
				|%1
				|
				|%2'"),
			Результат.СообщениеОбОшибке,
			ТехническаяИнформацияОбОшибке(
				URLОперации,
				РезультатОтправки.КодОшибки,
				Заголовки,
				РезультатОтправки.ИнформацияОбОшибке));
		
		ИнтернетПоддержкаПользователей.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Неопределено,
			Истина);
		
		Возврат Результат;
		
	КонецЕсли;
	
	ДанныеОтвета = ПрочитатьДанные_master_generate(
		РезультатОтправки.Содержимое);
	Результат.МастерТокен = ДанныеОтвета.tokenValue;
	
	Возврат Результат;
	
КонецФункции

// Формирует параметры запроса для операции
// /rest/public/program-1c/isl/auth-tokens/master/generate.
//
Функция master_generate(
		Логин,
		Пароль,
		Тикет,
		ИдентификаторКлиента,
		Капча)
	
	ЗаписьДанныхСообщения = Новый ЗаписьJSON;
	ЗаписьДанныхСообщения.УстановитьСтроку();
	ЗаписьДанныхСообщения.ЗаписатьНачалоОбъекта();
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("login");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(Логин);
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("password");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(Пароль);
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("ticket");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(Тикет);
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("infoBaseId");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы());
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("clientId");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(ИдентификаторКлиента);
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("clientTitle");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(ИнтернетПоддержкаПользователей.ЗаголовокКлиентскогоПриложения());
	
	Если ЗначениеЗаполнено(Капча) Тогда
		ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("captchaResponse");
		ЗаписьДанныхСообщения.ЗаписатьЗначение(Капча);
	КонецЕсли;
	
	ЗаписьДанныхСообщения.ЗаписатьКонецОбъекта();
	
	Возврат ЗаписьДанныхСообщения.Закрыть();

КонецФункции

// Чтение ответа операции /rest/public/program-1c/isl/auth-tokens/master/generate.
//
Функция ПрочитатьДанные_master_generate(ТелоJSON)
	
	// Ответ сервиса:
	//  tokenValue - созданные мастер токен;
	// 
	//  {
	//    "tokenValue": "string"
	//  }
	
	ИнтернетПоддержкаПользователей.ЗаписатьИнформациюВЖурналРегистрации(
		НСтр("ru = 'Получен мастер токен'"),
		Неопределено,
		Ложь);
	
	ЧтениеОтвета = Новый ЧтениеJSON;
	ЧтениеОтвета.УстановитьСтроку(ТелоJSON);
	Результат = ПрочитатьJSON(ЧтениеОтвета);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ВызовОперацииОтзываМастерТокена

////////////////////////////////////////////////////////////////////////////////
// Вызов операции POST /rest/public/program-1c/isl/auth-tokens/master/revoke

// Выполняет отзыв существующего мастер токена.
//
// Параметры:
//  МастерТокен - Строка - мастер токен пользователя на Портале 1С:ИТС.
//  Сценарий - Строка - сценарий выполнения запроса.
//
// Возвращаемое значение:
//  Структура - результат создания мастер токена:
//    * КодОшибки - Строка - строковый код возникшей ошибки, который
//      может быть обработан вызывающим методом:
//        - <Пустая строка> - создание нового заказа выполнено успешно;
//        - "НеверныйФорматЗапроса" - передан некорректный запрос или настройка подключения;
//        - "ПревышеноКоличествоПопыток" - превышено количество попыток
//          обращения к сервису с некорректным логином и паролем;
//        - "ОшибкаПодключения" - ошибка при подключении к сервису;
//        - "ОшибкаСервиса" - внутренняя ошибка сервиса;
//        - "НеизвестнаяОшибка" - при получении информации возникла
//          неизвестная (не обрабатываемая) ошибка;
//        - "СервисВременноНеДоступен" - на сервере ведутся регламентные работы;
//    * СообщениеОбОшибке  - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя;
//
Функция ОперацияОтозватьМастерТокен(
		МастерТокен,
		Сценарий) Экспорт
	
	Результат = Новый Структура("
		|КодОшибки,
		|СообщениеОбОшибке",
		"",
		"",
		"");
	
	Заголовки = ИнтернетПоддержкаПользователей.НовыйЗаголовкиВызоваОперации(Сценарий);
	URLОперации = URLОперацииСервиса("/program-1c/isl/auth-tokens/master/revoke");
	
	ПараметрыЗапроса = HTTP.НовыйПараметрыЗапроса(
		master_revoke(
			МастерТокен),
		Заголовки);
	
	РезультатОтправки = HTTP.POST(
		URLОперации,
		ПараметрыЗапроса);
	
	Если Не ПустаяСтрока(РезультатОтправки.КодОшибки) Тогда
		
		Результат.КодОшибки = ПереопределитьКодОшибкиСервиса(
			РезультатОтправки.КодСостояния);
		Результат.СообщениеОбОшибке = ПереопределитьСообщениеПользователю(
			Результат.КодОшибки,
			РезультатОтправки.КодСостояния);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось отозвать мастер токен.
				|
				|%1
				|
				|%2'"),
			Результат.СообщениеОбОшибке,
			ТехническаяИнформацияОбОшибке(
				URLОперации,
				РезультатОтправки.КодОшибки,
				Заголовки,
				РезультатОтправки.ИнформацияОбОшибке));
		
		ИнтернетПоддержкаПользователей.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Неопределено,
			Истина);
		
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует параметры запроса для операции
// /rest/public/program-1c/isl/auth-tokens/master/revoke.
//
Функция master_revoke(МастерТокен)
	
	ЗаписьДанныхСообщения = Новый ЗаписьJSON;
	ЗаписьДанныхСообщения.УстановитьСтроку();
	ЗаписьДанныхСообщения.ЗаписатьНачалоОбъекта();
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("masterTokenValue");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(МастерТокен);
	
	ЗаписьДанныхСообщения.ЗаписатьКонецОбъекта();
	
	Возврат ЗаписьДанныхСообщения.Закрыть();

КонецФункции

#КонецОбласти

#Область ВызовОперацииПолученияТокенаАутентификации

////////////////////////////////////////////////////////////////////////////////
// Вызов операции POST /rest/public/program-1c/isl/auth-tokens/services/{serviceNick}/generate

// Выполняет создание нового токена сервиса.
//
// Параметры:
//  МастерТокен - Строка - мастер токен пользователя на Портале 1С:ИТС.
//  ИдентификаторСервиса - Строка - идентификатор сервиса на Портале 1С:ИТС.
//  Сценарий - Строка - сценарий выполнения запроса.
//  Бессрочный - Булево - признак получения бессрочного токена.
//  ДополнительныеПараметры - Соответствие - описывает дополнительные параметры:
//    * Ключ - Строка - имя дополнительного свойства
//    * Значение - Строка, Число, Неопределено, Массив - значение дополнительного свойства
//
// Возвращаемое значение:
//  Структура - результат создания мастер токена:
//    * Токен - Строка - созданный токен сервиса.
//    * КодОшибки - Строка - строковый код возникшей ошибки, который
//      может быть обработан вызывающим методом:
//        - <Пустая строка> - создание нового заказа выполнено успешно;
//        - "НеверныйФорматЗапроса" - передан некорректный запрос или настройка подключения;
//        - "ОшибкаАутентификации" - неверный логин или пароль или параметры
//          подключения к участнику СБП;
//        - "ПревышеноКоличествоПопыток" - превышено количество попыток
//          обращения к сервису с некорректным логином и паролем;
//        - "ОшибкаПодключения" - ошибка при подключении к сервису;
//        - "ОшибкаСервиса" - внутренняя ошибка сервиса;
//        - "НеизвестнаяОшибка" - при получении информации возникла
//          неизвестная (не обрабатываемая) ошибка;
//        - "СервисВременноНеДоступен" - на сервере ведутся регламентные работы;
//    * СообщениеОбОшибке  - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя;
//
Функция ОперацияТокенАутентификации(
		МастерТокен,
		ИдентификаторСервиса,
		Сценарий,
		Бессрочный,
		ДополнительныеПараметры) Экспорт
	
	Результат = Новый Структура("
		|КодОшибки,
		|СообщениеОбОшибке,
		|Токен,
		|ШтампИстечения,
		|Бессрочный",
		"",
		"",
		"",
		Неопределено,
		Ложь);
	
	Заголовки = ИнтернетПоддержкаПользователей.НовыйЗаголовкиВызоваОперации(
		Сценарий);
	URLОперации = URLОперацииСервиса(
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"/program-1c/isl/auth-tokens/services/%1/generate",
			ИдентификаторСервиса));
	
	ПараметрыЗапроса = HTTP.НовыйПараметрыЗапроса(
		services_generate(
			МастерТокен,
			Бессрочный,
			ДополнительныеПараметры),
		Заголовки);
	
	РезультатОтправки = HTTP.POST(
		URLОперации,
		ПараметрыЗапроса);
	
	Если Не ПустаяСтрока(РезультатОтправки.КодОшибки) Тогда
		
		Результат.КодОшибки = ПереопределитьКодОшибкиСервиса(
			РезультатОтправки.КодСостояния);
		Результат.СообщениеОбОшибке = ПереопределитьСообщениеПользователю(
			Результат.КодОшибки,
			РезультатОтправки.КодСостояния);
		
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось создать токен сервиса.
				|
				|%1
				|
				|%2'"),
			Результат.СообщениеОбОшибке,
			ТехническаяИнформацияОбОшибке(
				URLОперации,
				РезультатОтправки.КодОшибки,
				Заголовки,
				РезультатОтправки.ИнформацияОбОшибке));
		
		ИнтернетПоддержкаПользователей.ЗаписатьИнформациюВЖурналРегистрации(
			ИнформацияОбОшибке,
			Неопределено,
			Истина);
		
		Возврат Результат;
		
	КонецЕсли;
	
	ДанныеОтвета = ПрочитатьДанные_services_generate(
		РезультатОтправки.Содержимое);
	
	Результат.Токен = ДанныеОтвета.tokenValue;
	Результат.Бессрочный = Бессрочный;
	
	Если Не Бессрочный Тогда
		Результат.ШтампИстечения = УниверсальноеВремя(ДанныеОтвета.expirationTimestamp);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует параметры запроса для операции
// /rest/public/program-1c/isl/auth-tokens/services/{serviceNick}/generate.
//
Функция services_generate(
	МастерТокен,
	Бессрочный,
	ДополнительныеПараметры)
	
	ЗаписьДанныхСообщения = Новый ЗаписьJSON;
	ЗаписьДанныхСообщения.УстановитьСтроку();
	ЗаписьДанныхСообщения.ЗаписатьНачалоОбъекта();
	
	ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("masterTokenValue");
	ЗаписьДанныхСообщения.ЗаписатьЗначение(МастерТокен);
	
	Если Бессрочный Тогда
		ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("perpetual");
		ЗаписьДанныхСообщения.ЗаписатьЗначение(Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		
		ЗаписьДанныхСообщения.ЗаписатьИмяСвойства("additionalData");
		ЗаписьДанныхСообщения.ЗаписатьНачалоОбъекта();
		
		Для Каждого ДополнительныйПараметр Из ДополнительныеПараметры Цикл
			ЗаписьДанныхСообщения.ЗаписатьИмяСвойства(ДополнительныйПараметр.Ключ);
			ЗаписьДанныхСообщения.ЗаписатьЗначение(ДополнительныйПараметр.Значение);
		КонецЦикла;
		
		ЗаписьДанныхСообщения.ЗаписатьКонецОбъекта();
		
	КонецЕсли;
	
	ЗаписьДанныхСообщения.ЗаписатьКонецОбъекта();
	
	Возврат ЗаписьДанныхСообщения.Закрыть();
	
КонецФункции

// Чтение ответа операции /rest/public/program-1c/isl/auth-tokens/services/{serviceNick}/generate.
//
Функция ПрочитатьДанные_services_generate(ТелоJSON)
	
	// Ответ сервиса:
	//  tokenValue - созданный токен сервиса;
	// 
	//  {
	//    "tokenValue": "string"
