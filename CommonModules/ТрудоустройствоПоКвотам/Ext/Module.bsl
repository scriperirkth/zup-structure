Функция НеобходимыСведенияОКвотахСотрудников(Знач ИмяПоля)
	
	ИмяПоля = ВРег(ИмяПоля);
	
	Возврат ИмяПоля = ВРег("ВидКвоты")
		Или ИмяПоля = ВРег("КатегорияКвоты")
		Или ИмяПоля = ВРег("ТрудоустроенПоКвоте");
		
КонецФункции

Функция ПутьКДаннымСведенийОКвотахСотрудников(Знач ИмяПоля)
	
	ИмяПоляВВерхнемРегистре = ВРег(ИмяПоля);
	
	ПутьКДанным = "";
	
	Если ИмяПоляВВерхнемРегистре = ВРег("ТрудоустройствоПоКвотамПериодРегистрации") Тогда
		ПутьКДанным = "	ЕстьNULL(СведенияОКвотахСотрудников.ПериодЗаписи, ДАТАВРЕМЯ(1,1,1))";
	ИначеЕсли ИмяПоляВВерхнемРегистре = ВРег("ТрудоустройствоПоКвотамРегистратор") Тогда
		ПутьКДанным = "	ЕстьNULL(СведенияОКвотахСотрудников.Регистратор, НЕОПРЕДЕЛЕНО)";
	ИначеЕсли ИмяПоляВВерхнемРегистре = ВРег("ТрудоустроенПоКвоте") Тогда
		ПутьКДанным = "	ЕстьNULL(СведенияОКвотахСотрудников.ТрудоустроенПоКвоте, ЛОЖЬ)";
	ИначеЕсли ИмяПоляВВерхнемРегистре = ВРег("ВидКвоты") Тогда
		ПутьКДанным = "	ЕстьNULL(СведенияОКвотахСотрудников.ВидКвоты, Значение(Справочник.ВидыКвотДляТрудоустройства.ПустаяСсылка))";
	ИначеЕсли ИмяПоляВВерхнемРегистре = ВРег("КатегорияКвоты") Тогда
		ПутьКДанным = "	ЕстьNULL(СведенияОКвотахСотрудников.КатегорияКвоты, Значение(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ПустаяСсылка))";
	КонецЕсли;
	
	Возврат ПутьКДанным;
	
КонецФункции

Функция ЗапросВТСведенияОКвотахСотрудников(ТолькоРазрешенные, ОписательВременнойТаблицыОтборов,
			ПоляОтбораПериодическихДанных, ФормироватьСПериодичностьДень,
			ИмяВТСведенияОКвотахСотрудников = "ВТСведенияОКвотахСотрудников")

	ПоляОтбора = Неопределено;
	Если ПоляОтбораПериодическихДанных <> Неопределено Тогда
		ПоляОтбораПериодическихДанных.Свойство("ВидыКвотДляТрудоустройства", ПоляОтбора);
	КонецЕсли;

	ОписаниеФильтра = ЗарплатаКадрыОбщиеНаборыДанных.ОписаниеФильтраДляСоздатьВТИмяРегистра(
		ОписательВременнойТаблицыОтборов.ИмяВременнойТаблицыОтборовСотрудников, "Сотрудник");

	ОписаниеФильтра.СоответствиеИзмеренийРегистраИзмерениямФильтра.Вставить("Период",
		ОписательВременнойТаблицыОтборов.ИмяПоляПериод);
	ОписаниеФильтра.СоответствиеИзмеренийРегистраИзмерениямФильтра.Вставить("Сотрудник",
		ОписательВременнойТаблицыОтборов.ИмяПоляСотрудник);

	ПараметрыПостроения = ЗарплатаКадрыОбщиеНаборыДанных.ПараметрыПостроенияДляСоздатьВТИмяРегистраСрез();
	ПараметрыПостроения.Отборы = ПоляОтбора;
	ПараметрыПостроения.ФормироватьСПериодичностьДень = ФормироватьСПериодичностьДень;

	ЗапросВТИмяРегистраСрез = ЗарплатаКадрыОбщиеНаборыДанных.ЗапросВТИмяРегистраСрез("ТрудоустройствоСотрудниковПоКвотам",
		ТолькоРазрешенные, ОписаниеФильтра, ПараметрыПостроения, Истина, ИмяВТСведенияОКвотахСотрудников);
		
	Возврат ЗапросВТИмяРегистраСрез;

КонецФункции

Процедура ДобавитьСоединениеВТСведенияОКвотахСотрудников(ЧастиЗапроса, ОписательВременнойТаблицыОтборов)
	
	ТекстЗапроса = ЧастиЗапроса.Получить(ЧастиЗапроса.ВГраница());
	
	Если СтрНайти(ТекстЗапроса, "ЛЕВОЕ СОЕДИНЕНИЕ ВТСведенияОКвотахСотрудников КАК") > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЧастиЗапроса.Добавить(
		"		ЛЕВОЕ СОЕДИНЕНИЕ ВТСведенияОКвотахСотрудников КАК СведенияОКвотахСотрудников
		|		ПО ТаблицаОтборов." + ОписательВременнойТаблицыОтборов.ИмяПоляСотрудник + " = СведенияОКвотахСотрудников.Сотрудник
		|			И ТаблицаОтборов." + ОписательВременнойТаблицыОтборов.ИмяПоляПериод + " = СведенияОКвотахСотрудников.Период");
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРеглотчетности

Процедура ОписаниеПоказателей_Статистика1Квотирование(ИДРедакцииОтчета, ПоказателиОтчета, НачалоПериода, ОкончаниеПериода) 
	
	Если ИДРедакцииОтчета = "ФормаОтчета2024Кв1" Тогда
		ПоказателиОтчетаСтруктура = ПоказателиОтчета_Статистика1КвотированиеС2024Года(НачалоПериода, ОкончаниеПериода);
		ДобавитьПоказателиОтчета_Статистика1КвотированиеС2024Года(ПоказателиОтчета, ПоказателиОтчетаСтруктура);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2023Кв1" Тогда
		ПоказателиОтчетаСтруктура = ПоказателиОтчета_Статистика1Квотирование(НачалоПериода, ОкончаниеПериода);
		ДобавитьПоказателиОтчета_Статистика1Квотирование(ПоказателиОтчета, ПоказателиОтчетаСтруктура);
	Иначе
		Возврат;
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ДобавитьПоказателиОтчета_Статистика1КвотированиеС2024Года(ПоказателиОтчета, ПоказателиОтчетаСтруктура)
	
	Для Каждого ПоказательОтчета Из ПоказателиОтчетаСтруктура Цикл
		Если ТипЗнч(ПоказательОтчета) = Тип("КлючИЗначение") Тогда 
			Для Каждого ПоказательОтчетаСоответствия Из ПоказательОтчета.Значение Цикл
				ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, ПоказательОтчетаСоответствия.Значение, Истина, Ложь);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПоказателиОтчета_Статистика1Квотирование(ПоказателиОтчета, ПоказателиОтчетаСтруктура)
	
	Для Каждого ПоказательОтчета Из ПоказателиОтчетаСтруктура Цикл
		
		Если ТипЗнч(ПоказательОтчета) = Тип("КлючИЗначение") Тогда 
			
			Для Каждого ПоказательОтчетаСоответствия Из ПоказательОтчета.Значение Цикл
				
				Если ТипЗнч(ПоказательОтчетаСоответствия) = Тип("Строка") Тогда
					
					ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, ПоказательОтчетаСоответствия, Истина, Ложь);
					
				Иначе
					
					Если ПоказательОтчета.Ключ = "ПоказателиРазмерКвотыПоИнвалидам" ИЛИ
						ПоказательОтчета.Ключ = "ПоказателиРазмерКвотыПоМолодежи" Тогда
						ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, ПоказательОтчетаСоответствия.Значение, Истина, Ложь);
					Иначе
						ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, ПоказательОтчетаСоответствия.Ключ, Истина, Ложь);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Функция ПоказателиОтчета_Статистика1Квотирование(НачалоПериода, ОкончаниеПериода)
	
