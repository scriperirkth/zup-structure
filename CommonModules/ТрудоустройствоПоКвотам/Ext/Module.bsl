Функция ОпасныеВредныеКлассыУсловийТруда()
	СписокКлассов = Новый Массив;
	СписокКлассов.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Вредный1);
	СписокКлассов.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Вредный2);
	СписокКлассов.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Вредный3);
	СписокКлассов.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Вредный4);
	СписокКлассов.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Опасный);
	
	Возврат СписокКлассов;
КонецФункции

