Процедура ЗначенияПоказателей_Статистика1Квотирование(ПараметрыОтчета, Контейнер)
	
	Организация = ПараметрыОтчета.Организация;
	НачалоПериода = ПараметрыОтчета.ДатаНачалаПериодаОтчета;
	ОкончаниеПериода = ПараметрыОтчета.ДатаКонцаПериодаОтчета;
	
	ПоказателиОтчета = ПоказателиОтчета_Статистика1Квотирование(НачалоПериода, ОкончаниеПериода);

	// Очищаем разделы 
	Для Каждого ПоказательОтчета Из ПоказателиОтчета Цикл
		
		Если ТипЗнч(ПоказательОтчета) = Тип("КлючИЗначение") Тогда 
			
			Для Каждого ПоказательОтчетаСоответствия Из ПоказательОтчета.Значение Цикл
				
				Если ТипЗнч(ПоказательОтчетаСоответствия) = Тип("Строка") Тогда
					
					ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, ПоказательОтчетаСоответствия, Истина, Ложь);
					
				Иначе
					
					Если ПоказательОтчета.Ключ = "ПоказателиРазмерКвотыПоИнвалидам" ИЛИ
						ПоказательОтчета.Ключ = "ПоказателиРазмерКвотыПоМолодежи" Тогда
						Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказательОтчетаСоответствия.Значение] = 0;
					Иначе
						Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказательОтчетаСоответствия.Ключ] = 0;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;

	КонецЦикла;
	
	// Сбор данных
	
	ПоказателиСреднесписочнойЧисленностиВсего	= ПоказателиОтчета.ПоказателиСреднесписочнойЧисленностиВсего;
