#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнитьКраткийСоставДокументаИзменениеКвотыПоТрудоустройству");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ИспользуетсяТрудоустройствоПоКвотам() Экспорт

	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьТрудоустройствоПоКвотам");

КонецФункции

Функция ИспользуетсяПланированиеКвотДляТрудоустройства() Экспорт

	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеКвотДляТрудоустройства");

КонецФункции

#Область ОпределениеДоступностиДанных

Функция ДоступноИзменениеИспользованияКвотДляТрудоустройства() Экспорт

	Возврат ПравоДоступа("Изменение", Метаданные.Константы.ИспользоватьТрудоустройствоПоКвотам);

КонецФункции

Функция ДоступноИзменениеИспользованияПланированияКвотДляТрудоустройства() Экспорт

	Возврат ПравоДоступа("Изменение", Метаданные.Константы.ИспользоватьПланированиеКвотДляТрудоустройства)
		И Константы.ИспользоватьТрудоустройствоПоКвотам.Получить();

КонецФункции

#КонецОбласти

#Область ПанельНастроекЗарплатаКадры

Процедура ПанельЗарплатаКадрыПрочитатьНастройки(Форма) Экспорт
	
	ИспользоватьТрудоустройствоПоКвотам = Константы.ИспользоватьТрудоустройствоПоКвотам.Получить();
	Форма.ИспользоватьТрудоустройствоПоКвотам = ИспользоватьТрудоустройствоПоКвотам;
	
	ИспользоватьПланированиеКвотДляТрудоустройства = Ложь;
	
	Если ИспользоватьТрудоустройствоПоКвотам Тогда
		ИспользоватьПланированиеКвотДляТрудоустройства = Константы.ИспользоватьПланированиеКвотДляТрудоустройства.Получить();
	КонецЕсли;

	Форма.ИспользоватьПланированиеКвотДляТрудоустройства = ИспользоватьПланированиеКвотДляТрудоустройства;

КонецПроцедуры

Процедура ПанельУправлениеПерсоналомЗаполнитьНастройки(Форма, ПараметрыНастроек) Экспорт
	
	ПараметрыНастроек.ИспользоватьТрудоустройствоПоКвотам = Форма.ИспользоватьТрудоустройствоПоКвотам;
	ПараметрыНастроек.ИспользоватьПланированиеКвотДляТрудоустройства = Форма.ИспользоватьПланированиеКвотДляТрудоустройства;
	
КонецПроцедуры

Процедура ПанельУправлениеПерсоналомЗаписатьНастройки(Параметры, ПараметрыНастроек) Экспорт
	
	Если ПараметрыНастроек.ИспользоватьТрудоустройствоПоКвотам Тогда
		Константы.ИспользоватьТрудоустройствоПоКвотам.Установить(Параметры.ИспользоватьТрудоустройствоПоКвотам);
	КонецЕсли;
	Если ПараметрыНастроек.ИспользоватьПланированиеКвотДляТрудоустройства Тогда
		Константы.ИспользоватьПланированиеКвотДляТрудоустройства.Установить(Параметры.ИспользоватьПланированиеКвотДляТрудоустройства);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КадровыеПриказы

Процедура СформироватьДвиженияПоТрудоустройствуСотрудниковПоКвотам(Движения, ДанныеДляПроведения) Экспорт
	
	Если Не ДанныеДляПроведения.Свойство("ТрудоустройствоСотрудниковПоКвотам")
		Или Не ЗначениеЗаполнено(ДанныеДляПроведения.ТрудоустройствоСотрудниковПоКвотам) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаДанныхДляПроведения Из ДанныеДляПроведения.ТрудоустройствоСотрудниковПоКвотам Цикл
		СтрокаДвижений = Движения.ТрудоустройствоСотрудниковПоКвотам.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДвижений, СтрокаДанныхДляПроведения);
	КонецЦикла;
	
	Если Движения.ТрудоустройствоСотрудниковПоКвотам.Количество() > 0 Тогда
		Движения.ТрудоустройствоСотрудниковПоКвотам.Записывать = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриемНаРаботуСведенияОТрудоустройствеСотрудниковПоКвотам(ДанныеДляПроведения, Запрос, ИмяПериода = "") Экспорт
	
	Если Не ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.ДатаПриема КАК Период,
		|	Сотрудники.Сотрудник КАК Сотрудник,
		|	Сотрудники.Организация КАК Организация,
		|	Сотрудники.ВидКвоты КАК ВидКвоты,
		|	Сотрудники.КатегорияКвоты КАК КатегорияКвоты,
		|	ВЫБОР
		|		КОГДА Сотрудники.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.ПустаяСсылка)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ТрудоустроенПоКвоте
		|ИЗ
		|	ВТСотрудники КАК Сотрудники";
	
	Если Не ПустаяСтрока(ИмяПериода) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаПриема", ИмяПериода);
	КонецЕсли;
	
	СведенияОТрудоустройствеСотрудниковПоКвотам = Запрос.Выполнить().Выгрузить();
	
	ДанныеДляПроведения.Вставить("ТрудоустройствоСотрудниковПоКвотам", СведенияОТрудоустройствеСотрудниковПоКвотам);
	
КонецПроцедуры

Процедура КадровыйПереводСведенияОТрудоустройствеСотрудниковПоКвотам(ДанныеДляПроведения, Запрос, ИмяПериода = "") Экспорт
	
	Если Не ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.ДатаНачала КАК Период,
		|	Сотрудники.Сотрудник КАК Сотрудник,
		|	Сотрудники.Организация КАК Организация,
		|	Сотрудники.ВидКвоты КАК ВидКвоты,
		|	Сотрудники.КатегорияКвоты КАК КатегорияКвоты,
		|	ВЫБОР
		|		КОГДА Сотрудники.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.ПустаяСсылка)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ТрудоустроенПоКвоте
		|ИЗ
		|	ВТСотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.ИзменитьКвоту";
	
	Если Не ПустаяСтрока(ИмяПериода) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаПриема", ИмяПериода);
	КонецЕсли;
	
	СведенияОТрудоустройствеСотрудниковПоКвотам = Запрос.Выполнить().Выгрузить();
	
	ДанныеДляПроведения.Вставить("ТрудоустройствоСотрудниковПоКвотам", СведенияОТрудоустройствеСотрудниковПоКвотам);
	
КонецПроцедуры

Функция ДоступныеКвотыПоДолжности(Организация, Должность, ДатаСобытия) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ИспользуетсяПланированиеКвотДляТрудоустройства() Тогда
		
		ДанныеОРазмерахКвот = ДанныеОРазмерахКвот(ДатаСобытия, Организация, Должность);
		
		ИмяКолонки = "ВидКвоты";
		Если Не ДанныеОРазмерахКвот.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			ДанныеОРазмерахКвот.Свернуть(ИмяКолонки);
			ДоступныеКвоты = ДанныеОРазмерахКвот.ВыгрузитьКолонку(ИмяКолонки);
		Иначе
			ДоступныеКвоты = Новый Массив;
		КонецЕсли;
	
	Иначе
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВидыКвотДляТрудоустройства.Ссылка КАК ВидКвоты
		|ИЗ
		|	Справочник.ВидыКвотДляТрудоустройства КАК ВидыКвотДляТрудоустройства
		|ГДЕ
		|	НЕ ВидыКвотДляТрудоустройства.ПометкаУдаления";
		
		ДоступныеКвоты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидКвоты");
		
	КонецЕсли;
	
	Возврат ДоступныеКвоты;

КонецФункции

Функция ДоступныеКатегорииПоВидуКвоты(ВидКвоты) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КатегорииСотрудниковТрудоустроенныхПоКвотам.Ссылка КАК КатегорияКвоты
	|ИЗ
	|	Справочник.ВидыКвотДляТрудоустройства КАК ВидыКвотДляТрудоустройства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам КАК КатегорииСотрудниковТрудоустроенныхПоКвотам
	|		ПО ВидыКвотДляТрудоустройства.Ссылка = КатегорииСотрудниковТрудоустроенныхПоКвотам.ВидКвоты
	|ГДЕ
	|	ВидыКвотДляТрудоустройства.ИспользуютсяКатегории
	|	И ВидыКвотДляТрудоустройства.Ссылка = &ВидКвоты"
	;
	
	Запрос.УстановитьПараметр("ВидКвоты", ВидКвоты);
	
	ДоступныеКатегории = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КатегорияКвоты");
	
	Возврат ДоступныеКатегории;

КонецФункции

Функция АвтоподборВидовКвот(МенеджерВременныхТаблиц) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ОписательОтборов = КадровыйУчет.ОписаниеВременнойТаблицыОтборовФизическихЛиц("ВТФизическиеЛица", "ФизическоеЛицо", Неопределено);
	КадровыйУчет.СоздатьВТОбразованияФизическихЛиц(Запрос.МенеджерВременныхТаблиц, Истина, ОписательОтборов, "ВТОбразованияФЛ");

	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеФизическихЛиц(
		Запрос.МенеджерВременныхТаблиц, "ВТФизическиеЛица");
		
	КадровыеДанные = 
	"ФизическоеЛицо,
	|Пол,
	|Возраст,
	|ДатаРождения,
	|ВидОбразования,
	|ИнвалидностьПериодРегистрации,
	|Инвалидность,
	|ИнвалидностьДатаВыдачи,
	|ИнвалидностьСрокДействияСправки";

	КадровыйУчет.СоздатьВТКадровыеДанныеФизическихЛиц(ОписательВременныхТаблиц, Истина, КадровыеДанные);

	ОписательВременныхТаблиц = Новый Структура("ИмяВременнойТаблицыОтборовФизическихЛиц,ИмяПоляФизическоеЛицо", "ВТФизическиеЛица", "ФизическоеЛицо");
	ЗапросВТТрудоваяДеятельность = КадровыйУчетРасширенный.ЗапросВТТрудоваяДеятельностьФизическихЛиц(Истина, ОписательВременныхТаблиц);
	ЗапросВТТрудоваяДеятельность.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
	ЗапросВТТрудоваяДеятельность.Выполнить();
	
	ОписательВременныхТаблиц = КадровыйУчетРасширенный.ОписательВременнойТаблицыОтборовДляВТСтажиФизическихЛиц("ВТФизическиеЛица", "ФизическоеЛицо");
	КадровыйУчетРасширенный.СоздатьВТСтажиФизическихЛиц(Запрос.МенеджерВременныхТаблиц, Истина, ОписательВременныхТаблиц, "ВТСтажиФизическихЛиц");

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КадровыеДанныеФЛ.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВидыКвотДляТрудоустройства.Ссылка КАК ВидКвоты
	|ИЗ
	|	ВТФизическиеЛица КАК ФизическиеЛица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКадровыеДанныеФизическихЛиц КАК КадровыеДанныеФЛ
	|		ПО ФизическиеЛица.ФизическоеЛицо = КадровыеДанныеФЛ.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОбразованияФЛ КАК ОбразованиеФЛ
	|		ПО (КадровыеДанныеФЛ.ФизическоеЛицо = ОбразованиеФЛ.ФизическоеЛицо)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТрудоваяДеятельностьФизическихЛиц КАК ТрудоваяДеятельность
	|		ПО ФизическиеЛица.ФизическоеЛицо = ТрудоваяДеятельность.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтажиФизическихЛиц КАК Стажи
	|		ПО ФизическиеЛица.ФизическоеЛицо = Стажи.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыКвотДляТрудоустройства КАК ВидыКвотДляТрудоустройства
	|		ПО (ВЫБОР
	|				КОГДА КадровыеДанныеФЛ.Инвалидность
	|						И КадровыеДанныеФЛ.ИнвалидностьПериодРегистрации <= КадровыеДанныеФЛ.Период
	|						И (КадровыеДанныеФЛ.ИнвалидностьСрокДействияСправки >= КадровыеДанныеФЛ.Период
	|							ИЛИ КадровыеДанныеФЛ.ИнвалидностьСрокДействияСправки = ДАТАВРЕМЯ(1, 1, 1))
	|					ТОГДА ВидыКвотДляТрудоустройства.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов)
	|				КОГДА КадровыеДанныеФЛ.Возраст > 0
	|						И КадровыеДанныеФЛ.Возраст <= 17
	|					ТОГДА ВидыКвотДляТрудоустройства.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)
	|				КОГДА КадровыеДанныеФЛ.Возраст > 0
	|						И ЕСТЬNULL(Стажи.ДатаОтсчета, ФизическиеЛица.Период) >= ФизическиеЛица.Период
	|						И ЕСТЬNULL(ТрудоваяДеятельность.ДатаНачала, ФизическиеЛица.Период) >= ФизическиеЛица.Период
	|						И (КадровыеДанныеФЛ.Возраст <= 23
	|								И ЕСТЬNULL(ОбразованиеФЛ.ВидОбразования, """") В (&ВидыНачальногоСреднегоПрофОбразования)
	|							ИЛИ КадровыеДанныеФЛ.Возраст <= 25
	|								И ЕСТЬNULL(ОбразованиеФЛ.ВидОбразования, """") В (&ВидыВысшегоПрофОбразования))
	|					ТОГДА ВидыКвотДляТрудоустройства.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|ГДЕ
	|	НЕ ВидыКвотДляТрудоустройства.ПометкаУдаления";
	
	ВидыВысшегоПрофОбразования = Новый Массив;
	ВидыВысшегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.ВысшееОбразование);
	ВидыВысшегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.ВысшееОбразованиеБакалавриат);
	ВидыВысшегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.ВысшееОбразованиеПодготовкаКадровВысшейКвалификации);
	ВидыВысшегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.ВысшееОбразованиеСпециалитетМагистратура);
	
	ВидыНачальногоСреднегоПрофОбразования = Новый Массив;
	ВидыНачальногоСреднегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.НачальноеПрофессиональноеОбразование);
	ВидыНачальногоСреднегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.СреднееПрофессиональноеОбразование);

	Запрос.УстановитьПараметр("ВидыВысшегоПрофОбразования", ВидыВысшегоПрофОбразования);
	Запрос.УстановитьПараметр("ВидыНачальногоСреднегоПрофОбразования", ВидыНачальногоСреднегоПрофОбразования);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция АвтоподборКатегорийКвот(ДатаСобытия, МенеджерВременныхТаблиц) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ОписательОтборов = КадровыйУчет.ОписаниеВременнойТаблицыОтборовФизическихЛиц("ВТФизическиеЛица", "ФизическоеЛицо", Неопределено);
	КадровыйУчет.СоздатьВТОбразованияФизическихЛиц(Запрос.МенеджерВременныхТаблиц, Истина, ОписательОтборов, "ВТОбразованияФЛ");

	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеФизическихЛиц(
		Запрос.МенеджерВременныхТаблиц, "ВТФизическиеЛица");
		
	КадровыеДанные = 
	"ФизическоеЛицо,
	|Пол,
	|Возраст,
	|ДатаРождения,
	|ВидОбразования,
	|ИнвалидностьПериодРегистрации,
	|Инвалидность,
	|ИнвалидностьДатаВыдачи,
	|ИнвалидностьСрокДействияСправки";

	КадровыйУчет.СоздатьВТКадровыеДанныеФизическихЛиц(ОписательВременныхТаблиц, Истина, КадровыеДанные);

	ОписательВременныхТаблиц = Новый Структура("ИмяВременнойТаблицыОтборовФизическихЛиц,ИмяПоляФизическоеЛицо", "ВТФизическиеЛица", "ФизическоеЛицо");
	ЗапросВТТрудоваяДеятельность = КадровыйУчетРасширенный.ЗапросВТТрудоваяДеятельностьФизическихЛиц(Истина, ОписательВременныхТаблиц);
	ЗапросВТТрудоваяДеятельность.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
	ЗапросВТТрудоваяДеятельность.Выполнить();
	
	ОписательВременныхТаблиц = КадровыйУчетРасширенный.ОписательВременнойТаблицыОтборовДляВТСтажиФизическихЛиц("ВТФизическиеЛица", "ФизическоеЛицо");
	КадровыйУчетРасширенный.СоздатьВТСтажиФизическихЛиц(Запрос.МенеджерВременныхТаблиц, Истина, ОписательВременныхТаблиц, "ВТСтажиФизическихЛиц");

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ФизическиеЛица.ВидКвоты КАК ВидКвоты,
	|	КадровыеДанныеФЛ.ФизическоеЛицо КАК ФизическоеЛицо,
	|	КатегорииКвот.Ссылка КАК КатегорияКвоты
	|ИЗ
	|	ВТФизическиеЛица КАК ФизическиеЛица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКадровыеДанныеФизическихЛиц КАК КадровыеДанныеФЛ
	|		ПО ФизическиеЛица.ФизическоеЛицо = КадровыеДанныеФЛ.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТрудоваяДеятельностьФизическихЛиц КАК ТрудоваяДеятельность
	|		ПО ФизическиеЛица.ФизическоеЛицо = ТрудоваяДеятельность.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтажиФизическихЛиц КАК Стажи
	|		ПО ФизическиеЛица.ФизическоеЛицо = Стажи.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПенсионныйВозраст КАК ПенсионныйВозраст
	|		ПО (ГОД(КадровыеДанныеФЛ.ДатаРождения) = ПенсионныйВозраст.ГодРождения)
	|			И (КадровыеДанныеФЛ.Пол = ПенсионныйВозраст.Пол)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОбразованияФЛ КАК ОбразованиеФЛ
	|		ПО (КадровыеДанныеФЛ.ФизическоеЛицо = ОбразованиеФЛ.ФизическоеЛицо)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам КАК КатегорииКвот
	|		ПО (ВЫБОР
	|					КОГДА КадровыеДанныеФЛ.Возраст = 0
	|						ТОГДА ЛОЖЬ
	|					КОГДА КадровыеДанныеФЛ.Возраст <= 15
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ИнвалидыДети)
	|					КОГДА КадровыеДанныеФЛ.Возраст <= 17
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ИнвалидыТрудоспособныеНесовершеннолетние)
	|					КОГДА КадровыеДанныеФЛ.Возраст >= ЕСТЬNULL(ПенсионныйВозраст.Возраст, 999)
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ИнвалидыСтаршеТрудоспособногоВозраста)
	|					КОГДА КадровыеДанныеФЛ.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
	|							И (КадровыеДанныеФЛ.Возраст >= 60
	|								ИЛИ ГОД(КадровыеДанныеФЛ.ДатаРождения) < 1966)
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ИнвалидыСтаршеТрудоспособногоВозраста)
	|					КОГДА КадровыеДанныеФЛ.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
	|							И (КадровыеДанныеФЛ.Возраст >= 65
	|								ИЛИ ГОД(КадровыеДанныеФЛ.ДатаРождения) < 1961)
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ИнвалидыСтаршеТрудоспособногоВозраста)
	|					ИНАЧЕ КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ИнвалидыТрудоспособные)
	|				КОНЕЦ
	|				ИЛИ ВЫБОР
	|					КОГДА КадровыеДанныеФЛ.Возраст = 0
	|						ТОГДА ЛОЖЬ
	|					КОГДА КадровыеДанныеФЛ.Возраст <= 17
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.МолодежьНесовершеннолетние)
	|					КОГДА КадровыеДанныеФЛ.Возраст <= 23
	|							И ЕСТЬNULL(Стажи.ДатаОтсчета, ФизическиеЛица.Период) >= ФизическиеЛица.Период
	|							И ЕСТЬNULL(ТрудоваяДеятельность.ДатаНачала, ФизическиеЛица.Период) >= ФизическиеЛица.Период
	|							И ЕСТЬNULL(ОбразованиеФЛ.ВидОбразования, """") В (&ВидыНачальногоСреднегоПрофОбразования)
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.МолодежьВыпусникиНачальноеСреднееОбразование)
	|					КОГДА КадровыеДанныеФЛ.Возраст <= 25
	|							И ЕСТЬNULL(Стажи.ДатаОтсчета, ФизическиеЛица.Период) >= ФизическиеЛица.Период
	|							И ЕСТЬNULL(ТрудоваяДеятельность.ДатаНачала, ФизическиеЛица.Период) >= ФизическиеЛица.Период
	|							И ЕСТЬNULL(ОбразованиеФЛ.ВидОбразования, """") В (&ВидыВысшегоПрофОбразования)
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.МолодежьВыпусникиВысшееОбразование)
	|					КОГДА КадровыеДанныеФЛ.Возраст <= 22
	|						ТОГДА КатегорииКвот.Ссылка = ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.МолодежьСироты)
	|					ИНАЧЕ NULL
	|				КОНЕЦ)
	|			И ФизическиеЛица.ВидКвоты = КатегорииКвот.ВидКвоты
	|ГДЕ
	|	НЕ КатегорииКвот.ПометкаУдаления";
	
	ВидыВысшегоПрофОбразования = Новый Массив;
	ВидыВысшегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.ВысшееОбразование);
	ВидыВысшегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.ВысшееОбразованиеБакалавриат);
	ВидыВысшегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.ВысшееОбразованиеПодготовкаКадровВысшейКвалификации);
	ВидыВысшегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.ВысшееОбразованиеСпециалитетМагистратура);
	
	ВидыНачальногоСреднегоПрофОбразования = Новый Массив;
	ВидыНачальногоСреднегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.НачальноеПрофессиональноеОбразование);
	ВидыНачальногоСреднегоПрофОбразования.Добавить(Справочники.ВидыОбразованияФизическихЛиц.СреднееПрофессиональноеОбразование);

	Запрос.УстановитьПараметр("ВидыВысшегоПрофОбразования", ВидыВысшегоПрофОбразования);
	Запрос.УстановитьПараметр("ВидыНачальногоСреднегоПрофОбразования", ВидыНачальногоСреднегоПрофОбразования);
	
	СоздатьВТПенсионныйВозраст(Запрос.МенеджерВременныхТаблиц);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДанныеУвольнения(ДокументСсылка) Экспорт

	НадоВыключатьПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Увольнение") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДОБАВИТЬКДАТЕ(Увольнение.ДатаУвольнения, ДЕНЬ, 1) КАК Период,
			|	Увольнение.Сотрудник КАК Сотрудник,
			|	ЛОЖЬ КАК ТрудоустроенПоКвоте,
			|	ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.ПустаяСсылка) КАК ВидКвоты,
			|	ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ПустаяСсылка) КАК КатегорияКвоты,
			|	Увольнение.Организация КАК Организация
			|ИЗ
			|	Документ.Увольнение КАК Увольнение
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТрудоустройствоСотрудниковПоКвотам.СрезПоследних КАК ТрудоустройствоСотрудниковПоКвотамСрезПоследних
			|		ПО Увольнение.Организация = ТрудоустройствоСотрудниковПоКвотамСрезПоследних.Организация
			|			И Увольнение.Сотрудник = ТрудоустройствоСотрудниковПоКвотамСрезПоследних.Сотрудник
			|			И (ТрудоустройствоСотрудниковПоКвотамСрезПоследних.ТрудоустроенПоКвоте)
			|ГДЕ
			|	Увольнение.Ссылка = &Ссылка";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДОБАВИТЬКДАТЕ(УвольнениеСпискомСотрудники.ДатаУвольнения, ДЕНЬ, 1) КАК Период,
			|	УвольнениеСпискомСотрудники.Сотрудник КАК Сотрудник,
			|	ЛОЖЬ КАК ТрудоустроенПоКвоте,
			|	ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.ПустаяСсылка) КАК ВидКвоты,
			|	ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ПустаяСсылка) КАК КатегорияКвоты,
			|	УвольнениеСписком.Организация КАК Организация
			|ИЗ
			|	Документ.УвольнениеСписком.Сотрудники КАК УвольнениеСпискомСотрудники
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УвольнениеСписком КАК УвольнениеСписком
			|		ПО УвольнениеСпискомСотрудники.Ссылка = УвольнениеСписком.Ссылка
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТрудоустройствоСотрудниковПоКвотам.СрезПоследних КАК ТрудоустройствоСотрудниковПоКвотамСрезПоследних
			|		ПО (ТрудоустройствоСотрудниковПоКвотамСрезПоследних.Организация = УвольнениеСписком.Организация)
			|			И УвольнениеСпискомСотрудники.Сотрудник = ТрудоустройствоСотрудниковПоКвотамСрезПоследних.Сотрудник
			|			И (ТрудоустройствоСотрудниковПоКвотамСрезПоследних.ТрудоустроенПоКвоте)
			|ГДЕ
			|	УвольнениеСпискомСотрудники.Ссылка = &Ссылка";
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НадоВыключатьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

Процедура СоздатьВТПенсионныйВозраст(МенеджерВременныхТаблиц) Экспорт
	
	ПенсионныйВозраст = Новый ТаблицаЗначений;
	ПенсионныйВозраст.Колонки.Добавить("ГодРождения", Новый ОписаниеТипов("Число"));
	ПенсионныйВозраст.Колонки.Добавить("Возраст", Новый ОписаниеТипов("Число"));
	ПенсионныйВозраст.Колонки.Добавить("Пол", Новый ОписаниеТипов("ПеречислениеСсылка.ПолФизическогоЛица"));
	
	Для ИндексСтроки = 0 По 2 Цикл
		ПенсионныйВозраст.Добавить();
		ПенсионныйВозраст.Получить(ИндексСтроки).Пол = Перечисления.ПолФизическогоЛица.Мужской;
	КонецЦикла;
	Для ИндексСтроки = 3 По 5 Цикл
		ПенсионныйВозраст.Добавить();
		ПенсионныйВозраст.Получить(ИндексСтроки).Пол = Перечисления.ПолФизическогоЛица.Женский;
	КонецЦикла;
	
	ГодыРождения = "1961,1962,1963,1966,1967,1968";
	ГодыРождения = СтрРазделить(ГодыРождения, ","); 
	
	Возрасты = "63,64,65,58,59,60";
	Возрасты = СтрРазделить(Возрасты, ",");
	
	ПенсионныйВозраст.ЗагрузитьКолонку(ГодыРождения, "ГодРождения");
	ПенсионныйВозраст.ЗагрузитьКолонку(Возрасты, "Возраст"); 
	
	ЗарплатаКадры.СоздатьВТПоТаблицеЗначений(МенеджерВременныхТаблиц, ПенсионныйВозраст, "ВТПенсионныйВозраст", Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ПервоначальноеЗаполнениеИОбновлениеИнформационнойБазы

