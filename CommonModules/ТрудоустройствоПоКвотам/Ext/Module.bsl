//
Процедура ЗарегистрироватьОбработчикиОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.1.29.32";
	Обработчик.Процедура = "Справочники.ВидыКвотДляТрудоустройства.НачальноеЗаполнение";
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("f4a9cbf1-5d0e-463c-967f-2c0fa424e1dd");
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.1.29.32";
	Обработчик.Процедура = "Справочники.КатегорииСотрудниковТрудоустроенныхПоКвотам.НачальноеЗаполнение";
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("e6077899-d130-4738-a6e0-f86f83797821");
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.1.33.7";
	Обработчик.РежимВыполнения = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ОсновнойРежимВыполненияОбновления();
	Обработчик.Процедура = "ТрудоустройствоПоКвотам.ЗаполнитьКраткийСоставДокументаИзменениеКвотыПоТрудоустройству";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("4b784ea3-8bbe-411f-857d-0a01d7f8dc6a");
	
КонецПроцедуры
	
Процедура ЗаполнитьКраткийСоставДокументаИзменениеКвотыПоТрудоустройству(ПараметрыОбновления = Неопределено) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзменениеКвотыПоТрудоустройству.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИзменениеКвотыПоТрудоустройству КАК ИзменениеКвотыПоТрудоустройству";
	
	ОписаниеБлокировкиДокумента = ОбновлениеИБ.ОписаниеБлокируемыхДанных(Метаданные.Документы.ИзменениеКвотыПоТрудоустройству);
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);

	Если НЕ ОбновляемыеДанные.Пустой() Тогда
		
		ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
		
		ВыборкаОбновляемыхДанных = ОбновляемыеДанные.Выбрать();
		
		Пока ВыборкаОбновляемыхДанных.Следующий() Цикл
			
			Попытка
				Если ВыборкаОбновляемыхДанных.Ссылка.ПолучитьОбъект() = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			Исключение
				Продолжить;
			КонецПопытки;
			
			ОписаниеДокумента = ЗарплатаКадрыСоставДокументов.ОписаниеОбъектаПоСсылке(ВыборкаОбновляемыхДанных.Ссылка);
			Если ОписаниеДокумента = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ОписаниеБлокировкиДокумента.ПоляБлокировки.Ссылка = ВыборкаОбновляемыхДанных.Ссылка;
			Если Не ОбновлениеИБ.НачатьОбновлениеДанных(ОписаниеБлокировкиДокумента, ПараметрыОбновления) Тогда
				Возврат;
			КонецЕсли;
			
			ОбъектДокумента = ВыборкаОбновляемыхДанных.Ссылка.ПолучитьОбъект();
			СоставОбъекта = ЗарплатаКадрыСоставДокументов.СоставОбъекта(ОбъектДокумента);
			
			Если ОписаниеДокумента.ЗаполнятьФизическиеЛицаПоСотрудникам Тогда
				ЗарплатаКадрыСоставДокументов.ЗаполнитьФизическиеЛицаПоСотрудникамВДокументе(ОбъектДокумента, ОписаниеДокумента);
			КонецЕсли;
			
			Если ОписаниеДокумента.ЗаполнятьТабличнуюЧастьФизическиеЛицаДокумента Тогда
				ЗарплатаКадрыСоставДокументов.ЗаполнитьТабличнуюЧастьФизическиеЛицаДокумента(ОбъектДокумента, ОписаниеДокумента, СоставОбъекта.ФизическиеЛица);
			КонецЕсли;
			
			Если ОписаниеДокумента.ИспользоватьКраткийСостав Тогда
				ЗарплатаКадрыСоставДокументов.ЗаполнитьКраткийСоставДокумента(ОбъектДокумента, ОписаниеДокумента, СоставОбъекта.СотрудникиФизическиеЛица);
			КонецЕсли;
			
			ОбъектДокумента.ДополнительныеСвойства.Вставить("ОтключитьПроверкуДатыЗапретаИзменения", Истина);
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектДокумента);
			
			Если ОписаниеДокумента.ИспользоватьОграничениеДоступа Тогда
				НаборЗаписейФизическиеЛицаДокумента = РегистрыСведений.ФизическиеЛицаДокументов.СоздатьНаборЗаписей();
				НаборЗаписейФизическиеЛицаДокумента.Отбор.ДокументФизическогоЛица.Установить(ВыборкаОбновляемыхДанных.Ссылка);
				Для Каждого ФизическоеЛицо Из СоставОбъекта.ФизическиеЛица Цикл
					Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
						Продолжить;
					КонецЕсли;
					НоваяСтрока = НаборЗаписейФизическиеЛицаДокумента.Добавить();
					НоваяСтрока.ФизическоеЛицо = ФизическоеЛицо;
					НоваяСтрока.ДокументФизическогоЛица = ВыборкаОбновляемыхДанных.Ссылка;
				КонецЦикла;
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписейФизическиеЛицаДокумента);
			КонецЕсли;
			
			Если ОписаниеДокумента.ЗаполнятьСоставДокументов Тогда
				СотрудникиФизическиеЛицаДокумента = СоставОбъекта.СотрудникиФизическиеЛица.Скопировать();
				СотрудникиФизическиеЛицаДокумента.Свернуть("Сотрудник, ГоловнойСотрудник, ФизическоеЛицо");
				НаборЗаписей = РегистрыСведений.СоставДокументовЗарплатаКадры.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ДокументФизическогоЛица.Установить(ВыборкаОбновляемыхДанных.Ссылка);
				Для Каждого СотрудникФизическоеЛицо Из СотрудникиФизическиеЛицаДокумента Цикл
					Если Не ЗначениеЗаполнено(СотрудникФизическоеЛицо.ФизическоеЛицо)
						И Не ЗначениеЗаполнено(СотрудникФизическоеЛицо.Сотрудник) Тогда
						
						Продолжить;
					КонецЕсли;
					НоваяСтрока = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СотрудникФизическоеЛицо);
					НоваяСтрока.ДокументФизическогоЛица = ВыборкаОбновляемыхДанных.Ссылка;
					НоваяСтрока.ДатаДокумента = ВыборкаОбновляемыхДанных.Ссылка.Дата;
				КонецЦикла;
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
			КонецЕсли;
			
			ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеДоступом
 // См. УправлениеДоступомПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных
Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(Описание) Экспорт
	
	Описание = Описание + "
		|Документ.ВыделениеКвотДляТрудоустройства.Чтение.Организации
		|Документ.ВыделениеКвотДляТрудоустройства.Изменение.Организации
		|Справочник.ВыделениеКвотДляТрудоустройстваПрисоединенныеФайлы.Чтение.Организации
		|Справочник.ВыделениеКвотДляТрудоустройстваПрисоединенныеФайлы.Изменение.Организации
		|Документ.ИзменениеКвотыПоТрудоустройству.Чтение.Организации
		|Документ.ИзменениеКвотыПоТрудоустройству.Изменение.Организации
		|Справочник.ИзменениеКвотыПоТрудоустройствуПрисоединенныеФайлы.Чтение.Организации
		|Справочник.ИзменениеКвотыПоТрудоустройствуПрисоединенныеФайлы.Изменение.Организации
		|РегистрСведений.ТрудоустройствоСотрудниковПоКвотам.Чтение.Организации
		|РегистрСведений.КвотыДляТрудоустройстваПоДолжностям.Чтение.Организации";
	
КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.РегистрыСведений.КвотыДляТрудоустройстваПоДолжностям, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.ТрудоустройствоСотрудниковПоКвотам, Истина);
	Списки.Вставить(Метаданные.Документы.ВыделениеКвотДляТрудоустройства, Истина);
	Списки.Вставить(Метаданные.Справочники.ВыделениеКвотДляТрудоустройстваПрисоединенныеФайлы, Истина);
	Списки.Вставить(Метаданные.Документы.ИзменениеКвотыПоТрудоустройству, Истина);
	Списки.Вставить(Метаданные.Справочники.ИзменениеКвотыПоТрудоустройствуПрисоединенныеФайлы, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ДатыЗапретаИзмененияДанных

Процедура ЗаполнитьИсточникиДанныхДляПроверкиЗапретаИзменения(ИсточникиДанных) Экспорт
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ВыделениеКвотДляТрудоустройства",			"АктДатаПринятия",		"КадровыйУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ВыделениеКвотДляТрудоустройства",			"Дата",		"КадровыйУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ИзменениеКвотыПоТрудоустройству",			"Дата",		"КадровыйУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.КвотыДляТрудоустройстваПоДолжностям",	"Период",	"КадровыйУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.ТрудоустройствоСотрудниковПоКвотам",	"Период",	"КадровыйУчет", "Организация");

КонецПроцедуры

#КонецОбласти

#Область Печать

// см. УправлениеПечатьюПереопределяемый.ПриОпределенииНастроекПечати
Процедура ПриОпределенииНастроекПечати(НастройкиПечати) Экспорт
	
	НастройкиПечати.ОбъектыПечати.Добавить(Документы.ИзменениеКвотыПоТрудоустройству);
	НастройкиПечати.ОбъектыПечати.Добавить(Документы.ВыделениеКвотДляТрудоустройства);
	
КонецПроцедуры

#КонецОбласти

#Область КадровыеДанныеСотрудников

Функция ДобавитьПолеСведенийОКвотахСотрудников(Знач ИмяПоля, ТекстыОписанияПолей, ИсточникиДанных) Экспорт
	
	ДобавленоПолеСведений = Ложь;
	Если НеобходимыСведенияОКвотахСотрудников(ИмяПоля) Тогда
		ДобавленоПолеСведений = Истина;
		ИсточникиДанных.Вставить("СведенияОКвотахСотрудников", Истина);
		
		ПутьКДанным = ПутьКДаннымСведенийОКвотахСотрудников(ИмяПоля);
		ТекстыОписанияПолей.Добавить(ПутьКДанным + " КАК " + ИмяПоля);
	КонецЕсли;
	
	Возврат ДобавленоПолеСведений;
	
КонецФункции

Функция ДобавитьКритерийПоискаПоСведениямОКвотахСотрудников(КритерииПоиска, УсловиеПоиска) Экспорт
	
	КритерийДобавлен = Ложь;
	Если НеобходимыСведенияОКвотахСотрудников(УсловиеПоиска.ЛевоеЗначение) Тогда
		
		ИмяПоля = ВРег(УсловиеПоиска.ЛевоеЗначение);
		Если ИмяПоля = ВРег("ТрудоустройствоПоКвотамПериодРегистрации") Тогда
			УсловиеПоиска.ЛевоеЗначение = "Период";
		ИначеЕсли ИмяПоля = ВРег("ТрудоустройствоПоКвотамРегистратор") Тогда
			УсловиеПоиска.ЛевоеЗначение = "Регистратор";
		ИначеЕсли ИмяПоля = ВРег("ТрудоустроенПоКвоте") Тогда
			УсловиеПоиска.ЛевоеЗначение = "ТрудоустроенПоКвоте";
		ИначеЕсли ИмяПоля = ВРег("ВидКвоты") Тогда
			УсловиеПоиска.ЛевоеЗначение = "ВидКвоты";
		ИначеЕсли ИмяПоля = ВРег("КатегорияКвоты") Тогда
			УсловиеПоиска.ЛевоеЗначение = "КатегорияКвоты";
		КонецЕсли;
		
		КадровыйУчет.ДобавитьКритерийПоискаСотрудников(КритерииПоиска, "РегистрСведений.ТрудоустройствоСотрудниковПоКвотам", УсловиеПоиска);
		КритерийДобавлен = Истина;
		
	КонецЕсли;
	
	Возврат КритерийДобавлен;
	
КонецФункции

Процедура ЗаполнитьПоляПредставленийКадровыхДанныхСотрудников(ДополнительныеПоляПредставлений, ПутьКПолямСотрудника, ИсключаемыеПоля) Экспорт
	
	ОписаниеПоля = ЗарплатаКадрыОбщиеНаборыДанных.ОписаниеДополнительногоПоляПредставлений();
	ОписаниеПоля.ИмяПоля = "ТрудоустроенПоКвоте";
	ОписаниеПоля.ПустоеЗначениеНаЯзыкеЗапросов = "ЛОЖЬ";
	ОписаниеПоля.ПутьПоляСКД = ПутьКПолямСотрудника + ".ТрудоустроенПоКвоте";
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьПолеПредставления(ДополнительныеПоляПредставлений, ОписаниеПоля, ИсключаемыеПоля);
	
	ОписаниеПоля = ЗарплатаКадрыОбщиеНаборыДанных.ОписаниеДополнительногоПоляПредставлений();
	ОписаниеПоля.ИмяПоля = "ВидКвоты";
	ОписаниеПоля.ПустоеЗначениеНаЯзыкеЗапросов = "ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.ПустаяСсылка)";
	ОписаниеПоля.ПутьПоляСКД = ПутьКПолямСотрудника + ".ВидКвоты";
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьПолеПредставления(ДополнительныеПоляПредставлений, ОписаниеПоля, ИсключаемыеПоля);

	ОписаниеПоля = ЗарплатаКадрыОбщиеНаборыДанных.ОписаниеДополнительногоПоляПредставлений();
	ОписаниеПоля.ИмяПоля = "КатегорияКвоты";
	ОписаниеПоля.ПустоеЗначениеНаЯзыкеЗапросов = "ЗНАЧЕНИЕ(Справочник.КатегорииСотрудниковТрудоустроенныхПоКвотам.ПустаяСсылка)";
	ОписаниеПоля.ПутьПоляСКД = ПутьКПолямСотрудника + ".КатегорияКвоты";
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьПолеПредставления(ДополнительныеПоляПредставлений, ОписаниеПоля, ИсключаемыеПоля);
	
КонецПроцедуры

Процедура ДобавитьТекстЗапросаВТСведенийОКвотахСотрудников(Запрос, ТолькоРазрешенные,
			ОписательВременнойТаблицыОтборов, ПоляОтбораПериодическихДанных, ФормироватьСПериодичностьДень, ИсточникиДанных) Экспорт

	Если ИсточникиДанных.Получить("СведенияОКвотахСотрудников") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗапросВТ = ЗапросВТСведенияОКвотахСотрудников(ТолькоРазрешенные, ОписательВременнойТаблицыОтборов,
		ПоляОтбораПериодическихДанных, ФормироватьСПериодичностьДень);

	ЗарплатаКадрыОбщиеНаборыДанных.СкопироватьПараметрыЗапроса(Запрос, ЗапросВТ);
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ЗапросВТ.Текст);
	ЧастиЗапроса.Добавить(ЗарплатаКадрыОбщиеНаборыДанных.РазделительЗапросов());
	ЧастиЗапроса.Добавить(Запрос.Текст);
	
	ДобавитьСоединениеВТСведенияОКвотахСотрудников(ЧастиЗапроса, ОписательВременнойТаблицыОтборов);
	
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, Символы.ПС);
	
	КадровыйУчет.ДобавитьВКоллекциюИмяКадровыхДанных(ИсточникиДанных, "ВТКУничтожению", "ВТСведенияОКвотахСотрудников");
	
КонецПроцедуры

Процедура ДобавитьСоединениеСКадровымиДанными(ОписательВременнойТаблицыОтборов, ЧастиЗапроса) Экспорт
	
	Если Не ИспользуетсяТрудоустройствоПоКвотам() Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСоединениеВТСведенияОКвотахСотрудников(ЧастиЗапроса, ОписательВременнойТаблицыОтборов);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРеглотчетности

Процедура ПриПолученииСведенийОПоказателяхОтчета(ПоказателиОтчета, ИДОтчета, ИДРедакцииОтчета, ПараметрыОтчета) Экспорт

	Если ИДОтчета = "РегламентированныйОтчетСтатистика1Квотирование" Тогда
		ОписаниеПоказателей_Статистика1Квотирование(ИДРедакцииОтчета, ПоказателиОтчета, ТекущаяДата(), Неопределено);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаполненииРегламентированногоОтчета(ИДОтчета, ИДРедакцииОтчета, ПараметрыОтчета, Контейнер) Экспорт
	Если ИДОтчета = "РегламентированныйОтчетСтатистика1Квотирование" Тогда
		
		Если ИДРедакцииОтчета = "ФормаОтчета2023Кв1" Тогда
			ЗначенияПоказателей_Статистика1Квотирование(ПараметрыОтчета, Контейнер);
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2024Кв1" Тогда
			ЗначенияПоказателей_Статистика1КвотированиеС2024Года(ПараметрыОтчета, Контейнер);
		Иначе
			Возврат;
		КонецЕсли;
		
		Если ПараметрыОтчета.Свойство("АдресВоВременномХранилище") Тогда
			ПоместитьВоВременноеХранилище(Новый Структура("Контейнер", Контейнер), ПараметрыОтчета.АдресВоВременномХранилище);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область НастройкиВариантовОтчетов

// Содержит настройки размещения вариантов отчетов в панели отчетов.
// Описание см. ЗарплатаКадрыВариантыОтчетов.НастроитьВариантыОтчетов.
