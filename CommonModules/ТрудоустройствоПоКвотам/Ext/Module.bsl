	РазмерыКвотВсего = Новый Соответствие;
	РазмерыКвотВсего.Вставить(ДобавитьМесяц(НачалоПериода,0), 0);
	РазмерыКвотВсего.Вставить(ДобавитьМесяц(НачалоПериода,1), 0);
	РазмерыКвотВсего.Вставить(ДобавитьМесяц(НачалоПериода,2), 0);

	РазмерыКвотПоИнвалидам = Новый Соответствие;
	РазмерыКвотПоИнвалидам.Вставить(ДобавитьМесяц(НачалоПериода,0), 0);
	РазмерыКвотПоИнвалидам.Вставить(ДобавитьМесяц(НачалоПериода,1), 0);
	РазмерыКвотПоИнвалидам.Вставить(ДобавитьМесяц(НачалоПериода,2), 0); 
	РазмерыКвотПоИнвалидамИтого = 0;

	РазмерыКвотПоМолодежи = Новый Соответствие;
	РазмерыКвотПоМолодежи.Вставить(ДобавитьМесяц(НачалоПериода,0), 0);
	РазмерыКвотПоМолодежи.Вставить(ДобавитьМесяц(НачалоПериода,1), 0);
	РазмерыКвотПоМолодежи.Вставить(ДобавитьМесяц(НачалоПериода,2), 0); 
	РазмерыКвотПоМолодежиИтого = 0;

	Для Каждого Показатель Из ПоказателиСреднесписочнойЧисленностиВсего Цикл
		Период = Показатель.Значение.Период;
		КлючПоказателя = Показатель.Ключ;
		СреднесписочнаяЧисленностьОтбор = СреднесписочнаяЧисленность.Скопировать(СреднесписочнаяЧисленность.НайтиСтроки(Показатель.Значение));
		СреднесписочнаяЧисленностьВсего = СреднесписочнаяЧисленностьОтбор.Итог("СреднесписочнаяЧисленностьСотрудников");
		Контейнер.ПолеТабличногоДокументаФормаОтчета[КлючПоказателя] = СреднесписочнаяЧисленностьВсего;
		РазмерыКвотВсего[Период] = Цел(СреднесписочнаяЧисленностьВсего * 0.04);
	КонецЦикла;
	
	Для Каждого Показатель Из ПоказателиСреднесписочнойЧисленности Цикл
		Период = Показатель.Значение.Период;
		КлючПоказателя = Показатель.Ключ;
		СреднесписочнаяЧисленностьОтбор = СреднесписочнаяЧисленность.Скопировать(СреднесписочнаяЧисленность.НайтиСтроки(Показатель.Значение));
		СреднесписочнаяЧисленностьБезОпасныхВредныхУсловий = СреднесписочнаяЧисленностьОтбор.Итог("СреднесписочнаяЧисленностьРаботниковБезОпасныхВредныхУсловий"); 
		РазмерКвотыПоИнвалидам = СреднесписочнаяЧисленностьБезОпасныхВредныхУсловий * 0.02;
		Если Не Цел(РазмерКвотыПоИнвалидам) = РазмерКвотыПоИнвалидам Тогда
			РазмерКвотыПоИнвалидам = Мин(РазмерыКвотВсего[Период],Цел(РазмерКвотыПоИнвалидам)+1);
		КонецЕсли;
		РазмерКвотыПоМолодежи = РазмерыКвотВсего[Период] - РазмерКвотыПоИнвалидам;
		РазмерыКвотПоИнвалидам[Период] = РазмерКвотыПоИнвалидам;
		РазмерыКвотПоМолодежи[Период] = РазмерКвотыПоМолодежи;
		РазмерыКвотПоИнвалидамИтого = РазмерыКвотПоИнвалидамИтого + РазмерКвотыПоИнвалидам;
		РазмерыКвотПоМолодежиИтого = РазмерыКвотПоМолодежиИтого + РазмерКвотыПоМолодежи;
		Контейнер.ПолеТабличногоДокументаФормаОтчета[КлючПоказателя] = СреднесписочнаяЧисленностьБезОпасныхВредныхУсловий;
		Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказателиРазмерКвотыПоИнвалидам.Получить(Период)] = РазмерКвотыПоИнвалидам;
		Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказателиРазмерКвотыПоМолодежи.Получить(Период)] = РазмерКвотыПоМолодежи;
	КонецЦикла;
	
	Для Каждого Показатель Из ПоказателиРаботалоИнвалидов Цикл
		Период = Показатель.Значение.Период;
		КлючПоказателя = Показатель.Ключ;
		ТрудоустройствоИнвалидовОтбор = ТрудоустройствоИнвалидов.Скопировать(ТрудоустройствоИнвалидов.НайтиСтроки(Показатель.Значение));
		ТрудоустроеноИнвалидовВСчетКвоты = Мин(РазмерыКвотПоИнвалидам[Период], ТрудоустройствоИнвалидовОтбор.Итог("КоличествоСотрудников"));
		Контейнер.ПолеТабличногоДокументаФормаОтчета[КлючПоказателя] = ТрудоустроеноИнвалидовВСчетКвоты;
	КонецЦикла;
	
	Для Каждого Показатель Из ПоказателиРаботалоМолодежи Цикл
		Период = Показатель.Значение.Период;
		КлючПоказателя = Показатель.Ключ;
		ТрудоустройствоМолодежиОтбор = ТрудоустройствоМолодежи.Скопировать(ТрудоустройствоМолодежи.НайтиСтроки(Показатель.Значение));
		ТрудоустроеноМолодежиВСчетКвоты = Мин(РазмерыКвотПоМолодежи[Период], ТрудоустройствоМолодежи.Итог("КоличествоСотрудников"));
		Контейнер.ПолеТабличногоДокументаФормаОтчета[КлючПоказателя] = ТрудоустроеноМолодежиВСчетКвоты;
	КонецЦикла;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ОхранаТруда") Тогда
		
		МодульОхранаТруда = ОбщегоНазначения.ОбщийМодуль("ОхранаТруда");
		Если МодульОхранаТруда.ОхранаТрудаИспользуется() Тогда
			
			КоличествоСпециальныхРабочихМест = 0;
			ЗанятоСпециальныхРабочихМест = 0;
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпециальныеРабочиеМестаВсего.КоличествоСпециальныхРабочихМест КАК КоличествоСпециальныхРабочихМест
			|ИЗ
			|	ВТСпециальныеРабочиеМестаВсего КАК СпециальныеРабочиеМестаВсего
			|ГДЕ
			|	СпециальныеРабочиеМестаВсего.Организация = &Организация";
			
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				КоличествоСпециальныхРабочихМест = РезультатЗапроса.Выгрузить()[0].КоличествоСпециальныхРабочихМест;
				Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010013001"] = КоличествоСпециальныхРабочихМест;
			КонецЕсли;
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпециальныеРабочиеМестаЗанято.ЗанятоСпециальныхРабочихМест КАК ЗанятоСпециальныхРабочихМест
			|ИЗ
			|	ВТСпециальныеРабочиеМестаЗанято КАК СпециальныеРабочиеМестаЗанято
			|ГДЕ
			|	СпециальныеРабочиеМестаЗанято.Организация = &Организация
			|	И СпециальныеРабочиеМестаЗанято.Период = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОкончаниеПериода, ДЕНЬ, 1), ДЕНЬ)";
			
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				ЗанятоСпециальныхРабочихМест = РезультатЗапроса.Выгрузить()[0].ЗанятоСпециальныхРабочихМест;
				Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010015003"] = ЗанятоСпециальныхРабочихМест;
			КонецЕсли;	
			
			Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010014003"] = КоличествоСпециальныхРабочихМест - ЗанятоСпециальныхРабочихМест;

		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеТрудоустройстваПоКвотам.ДатаНачала КАК ДатаНачала,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеТрудоустройстваПоКвотам.Сотрудник) КАК КоличествоСотрудниковНаНачалоПериода
	|ИЗ
	|	ВТДанныеТрудоустройстваПоКвотам КАК ДанныеТрудоустройстваПоКвотам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТрудоустройствоСотрудниковПоКвотамДвижение КАК КвотыДвижение
	|		ПО ДанныеТрудоустройстваПоКвотам.Организация = КвотыДвижение.Организация
	|			И ДанныеТрудоустройстваПоКвотам.Сотрудник = КвотыДвижение.Сотрудник
	|			И ДанныеТрудоустройстваПоКвотам.ВидКвоты = КвотыДвижение.ВидКвоты
	|			И ДанныеТрудоустройстваПоКвотам.ДатаНачала = КвотыДвижение.ПериодЗаписи
	|			И ДанныеТрудоустройстваПоКвотам.ТрудоустроенПоКвоте = КвотыДвижение.ТрудоустроенПоКвоте
	|ГДЕ
	|	(ДанныеТрудоустройстваПоКвотам.ДатаНачала = &НачалоПериода
	|			ИЛИ ДанныеТрудоустройстваПоКвотам.ДатаНачала = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОкончаниеПериода, ДЕНЬ, 1), ДЕНЬ))
	|	И ДанныеТрудоустройстваПоКвотам.ТрудоустроенПоКвоте
	|	И ДанныеТрудоустройстваПоКвотам.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов)
	|	И ЕСТЬNULL(КвотыДвижение.ПериодЗаписи, 0) = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеТрудоустройстваПоКвотам.ДатаНачала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеТрудоустройстваПоКвотам.ДатаНачала КАК ДатаНачала,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеТрудоустройстваПоКвотам.Сотрудник) КАК КоличествоСотрудниковНаНачалоПериода
	|ИЗ
	|	ВТДанныеТрудоустройстваПоКвотам КАК ДанныеТрудоустройстваПоКвотам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТрудоустройствоСотрудниковПоКвотамДвижение КАК КвотыДвижение
	|		ПО ДанныеТрудоустройстваПоКвотам.Организация = КвотыДвижение.Организация
	|			И ДанныеТрудоустройстваПоКвотам.Сотрудник = КвотыДвижение.Сотрудник
	|			И ДанныеТрудоустройстваПоКвотам.ВидКвоты = КвотыДвижение.ВидКвоты
	|			И ДанныеТрудоустройстваПоКвотам.ДатаНачала = КвотыДвижение.ПериодЗаписи
	|			И ДанныеТрудоустройстваПоКвотам.ТрудоустроенПоКвоте = КвотыДвижение.ТрудоустроенПоКвоте
	|ГДЕ
	|	(ДанныеТрудоустройстваПоКвотам.ДатаНачала = &НачалоПериода
	|			ИЛИ ДанныеТрудоустройстваПоКвотам.ДатаНачала = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОкончаниеПериода, ДЕНЬ, 1), ДЕНЬ))
	|	И ДанныеТрудоустройстваПоКвотам.ТрудоустроенПоКвоте
	|	И ДанныеТрудоустройстваПоКвотам.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)
	|	И ЕСТЬNULL(КвотыДвижение.ПериодЗаписи, 0) = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеТрудоустройстваПоКвотам.ДатаНачала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА КвотыДвижение.ТрудоустроенПоКвоте
	|					И КвотыДвижение.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Принято,
	|	СУММА(ВЫБОР
	|			КОГДА КвотыДвижение.ПредыдущийВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Выбыло
	|ИЗ
	|	ВТТрудоустройствоСотрудниковПоКвотамДвижение КАК КвотыДвижение
	|ГДЕ
	|	КвотыДвижение.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА КвотыДвижение.ТрудоустроенПоКвоте
	|					И КвотыДвижение.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Принято,
	|	СУММА(ВЫБОР
	|			КОГДА КвотыДвижение.ПредыдущийВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Выбыло
	|ИЗ
	|	ВТТрудоустройствоСотрудниковПоКвотамДвижение КАК КвотыДвижение
	|ГДЕ
	|	КвотыДвижение.Организация = &Организация";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();

	ТаблицаПоКоличествуИнвалидов = РезультатЗапроса[0].Выгрузить();

	РаботалоВСчетКвотыПоИнвалидамНаНачалоПериода = 0;
	КоличествоИнвалидовНаНачалоПериода = ТаблицаПоКоличествуИнвалидов.Найти(НачалоПериода);
	Если КоличествоИнвалидовНаНачалоПериода <> Неопределено Тогда
		КоличествоИнвалидовНаНачалоПериода = КоличествоИнвалидовНаНачалоПериода.КоличествоСотрудниковНаНачалоПериода;
		РаботалоВСчетКвотыПоИнвалидамНаНачалоПериода = Мин(РазмерыКвотПоИнвалидам[НачалоПериода], КоличествоИнвалидовНаНачалоПериода);
	Иначе
		КоличествоИнвалидовНаНачалоПериода = 0;
	КонецЕсли;
	Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010016004"] = РаботалоВСчетКвотыПоИнвалидамНаНачалоПериода;

	РаботалоВСчетКвотыПоИнвалидамНаКонецПериода = 0;
	КоличествоИнвалидовНаКонецПериода = ТаблицаПоКоличествуИнвалидов.Найти(НачалоДня(ОкончаниеПериода+1));
	Если КоличествоИнвалидовНаКонецПериода <> Неопределено Тогда
		КоличествоИнвалидовНаКонецПериода = КоличествоИнвалидовНаКонецПериода.КоличествоСотрудниковНаНачалоПериода;
		РаботалоВСчетКвотыПоИнвалидамНаКонецПериода = Мин(РазмерыКвотПоИнвалидам[НачалоМесяца(ОкончаниеПериода)], КоличествоИнвалидовНаКонецПериода);
	Иначе
		КоличествоИнвалидовНаКонецПериода = 0;
	КонецЕсли;
	Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010019004"] = РазмерыКвотПоИнвалидам[НачалоМесяца(ОкончаниеПериода)] - РаботалоВСчетКвотыПоИнвалидамНаКонецПериода;
	Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010120004"] = Макс(0, КоличествоИнвалидовНаКонецПериода - РазмерыКвотПоИнвалидам[НачалоМесяца(ОкончаниеПериода)]);
	
	ТаблицаПоКоличествуМолодежи = РезультатЗапроса[1].Выгрузить();
	
	РаботалоВСчетКвотыПоМолодежиНаНачалоПериода = 0;
	КоличествоМолодежиНаНачалоПериода = ТаблицаПоКоличествуМолодежи.Найти(НачалоПериода);
	Если КоличествоМолодежиНаНачалоПериода <> Неопределено Тогда
		КоличествоМолодежиНаНачалоПериода = КоличествоМолодежиНаНачалоПериода.КоличествоСотрудниковНаНачалоПериода;
		РаботалоВСчетКвотыПоМолодежиНаНачалоПериода = Мин(РазмерыКвотПоМолодежи[НачалоПериода], КоличествоМолодежиНаНачалоПериода);
	Иначе
		КоличествоМолодежиНаНачалоПериода = 0;
	КонецЕсли;
	Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010016005"] = РаботалоВСчетКвотыПоМолодежиНаНачалоПериода;

	РаботалоВСчетКвотыПоМолодежиНаКонецПериода = 0;
	КоличествоМолодежиНаКонецПериода = ТаблицаПоКоличествуМолодежи.Найти(НачалоДня(ОкончаниеПериода+1));
	Если КоличествоМолодежиНаКонецПериода <> Неопределено Тогда
		КоличествоМолодежиНаКонецПериода = КоличествоМолодежиНаКонецПериода.КоличествоСотрудниковНаНачалоПериода;
		РаботалоВСчетКвотыПоМолодежиНаКонецПериода = Мин(РазмерыКвотПоМолодежи[НачалоМесяца(ОкончаниеПериода)], КоличествоМолодежиНаКонецПериода);
	Иначе
		КоличествоМолодежиНаКонецПериода = 0;
	КонецЕсли;
	Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010019005"] = РазмерыКвотПоМолодежи[НачалоМесяца(ОкончаниеПериода)] - РаботалоВСчетКвотыПоМолодежиНаКонецПериода;
	Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010120005"] = Макс(0, КоличествоМолодежиНаКонецПериода - РазмерыКвотПоМолодежи[НачалоМесяца(ОкончаниеПериода)]);

	Если Не РезультатЗапроса[2].Пустой() Тогда 
		ПринятоИнвалидов = РезультатЗапроса[2].Выгрузить()[0].Принято;
		ВыбылоИнвалидов = РезультатЗапроса[2].Выгрузить()[0].Выбыло; 
		Если РазмерыКвотПоИнвалидамИтого = 0 Тогда
			ПринятоИнвалидов = 0;
			ВыбылоИнвалидов = 0;
		КонецЕсли;
		Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010018004"] = ПринятоИнвалидов;
		Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010017004"] = ВыбылоИнвалидов;
	КонецЕсли;
	Если Не РезультатЗапроса[3].Пустой() Тогда
		ПринятоМолодежи = РезультатЗапроса[3].Выгрузить()[0].Принято;
		ВыбылоМолодежи = РезультатЗапроса[3].Выгрузить()[0].Выбыло;
		Если РазмерыКвотПоМолодежиИтого = 0 Тогда
			ПринятоМолодежи = 0;
			ВыбылоМолодежи = 0;
		КонецЕсли;
		Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010018005"] = ПринятоМолодежи;
		Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010017005"] = ВыбылоМолодежи;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(КадровыеДанные.КлассУсловийТрудаПериодРегистрации) КАК КлассУсловийТрудаПериодРегистрации
	|ИЗ
	|	ВТКадровыеДанныеСотрудников КАК КадровыеДанные
	|ГДЕ
	|	КадровыеДанные.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|	И КадровыеДанные.КлассУсловийТруда В(&ОпасныеВредныеКлассыУсловийТруда)"
	;
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010022000"] = РезультатЗапроса.Выгрузить()[0].КлассУсловийТрудаПериодРегистрации;
	КонецЕсли;
	
	КатегорииИнвалидовВТрудоспособномВозрасте = Новый Массив;
	КатегорииИнвалидовВТрудоспособномВозрасте.Добавить(Справочники.КатегорииСотрудниковТрудоустроенныхПоКвотам.ИнвалидыТрудоспособные);
	КатегорииИнвалидовВТрудоспособномВозрасте.Добавить(Справочники.КатегорииСотрудниковТрудоустроенныхПоКвотам.ИнвалидыТрудоспособныеНесовершеннолетние);
	
	Запрос.УстановитьПараметр("КатегорииИнвалидовВТрудоспособномВозрасте", КатегорииИнвалидовВТрудоспособномВозрасте);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеСотрудниковПоКвотам.ВидКвоты КАК ВидКвоты,
	|	ДанныеСотрудниковПоКвотам.КатегорияКвоты КАК КатегорияКвоты,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеСотрудниковПоКвотам.Сотрудник) КАК КоличествоСотрудников,
	|	ЕСТЬNULL(СведенияОбИнвалидностиФизическихЛицСрезПоследних.ГруппаИнвалидности, НЕОПРЕДЕЛЕНО) КАК ГруппаИнвалидности,
	|	ДанныеСотрудниковПоКвотам.КатегорияКвоты В (&КатегорииИнвалидовВТрудоспособномВозрасте) КАК ТрудоспособныйВозраст
	|ИЗ
	|	ВТКадровыеДанныеСотрудниковПоКвотам КАК ДанныеСотрудниковПоКвотам
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОбИнвалидностиФизическихЛиц.СрезПоследних(&ОкончаниеПериода, ) КАК СведенияОбИнвалидностиФизическихЛицСрезПоследних
	|		ПО ДанныеСотрудниковПоКвотам.Сотрудник.ФизическоеЛицо = СведенияОбИнвалидностиФизическихЛицСрезПоследних.ФизическоеЛицо
	|			И (СведенияОбИнвалидностиФизическихЛицСрезПоследних.Инвалидность)
	|			И (СведенияОбИнвалидностиФизическихЛицСрезПоследних.ДействуетДо > &ОкончаниеПериода
	|				ИЛИ СведенияОбИнвалидностиФизическихЛицСрезПоследних.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1))
	|ГДЕ
	|	ДанныеСотрудниковПоКвотам.ТрудоустроенПоКвоте
	|	И ДанныеСотрудниковПоКвотам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, МЕСЯЦ) И &ОкончаниеПериода
	|	И ДанныеСотрудниковПоКвотам.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеСотрудниковПоКвотам.ВидКвоты,
	|	ДанныеСотрудниковПоКвотам.КатегорияКвоты,
	|	ЕСТЬNULL(СведенияОбИнвалидностиФизическихЛицСрезПоследних.ГруппаИнвалидности, НЕОПРЕДЕЛЕНО)"
	;
	СведенияПоКатегориямКвот = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ПоказательКатегории Из ПоказателиКатегорииКвот Цикл
		
		КлючПоказателя = ПоказательКатегории.Ключ;
		КатегорииКвотОтбор = СведенияПоКатегориямКвот.Скопировать(СведенияПоКатегориямКвот.НайтиСтроки(ПоказательКатегории.Значение));
		Контейнер.ПолеТабличногоДокументаФормаОтчета[КлючПоказателя] = КатегорииКвотОтбор.Итог("КоличествоСотрудников");

	КонецЦикла;

	Если ТрудоустройствоПоКвотам.ИспользуетсяПланированиеКвотДляТрудоустройства() Тогда
		
		РазмерВыделеннойКвотыПоИнвалидам = 0;
		РазмерВыделеннойКвотыПоМолодежи = 0;
		
		ДанныеОРазмерахКвот = ТрудоустройствоПоКвотам.ДанныеОРазмерахКвот(ОкончаниеПериода, Организация);
		Если ТипЗнч(ДанныеОРазмерахКвот) = Тип("ТаблицаЗначений") Тогда
			Если ДанныеОРазмерахКвот.Колонки.Найти("ВидКвоты") <> Неопределено И ДанныеОРазмерахКвот.Колонки.Найти("РазмерКвоты")<> Неопределено Тогда
				ДанныеОРазмерахКвотПоИнвалидам = ДанныеОРазмерахКвот.Скопировать(ДанныеОРазмерахКвот.НайтиСтроки(Новый Структура("ВидКвоты", Справочники.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов)));
				РазмерВыделеннойКвотыПоИнвалидам = ДанныеОРазмерахКвотПоИнвалидам.Итог("РазмерКвоты");
				ДанныеОРазмерахКвотПоМолодежи = ДанныеОРазмерахКвот.Скопировать(ДанныеОРазмерахКвот.НайтиСтроки(Новый Структура("ВидКвоты", Справочники.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)));
				РазмерВыделеннойКвотыПоМолодежи = ДанныеОРазмерахКвотПоМолодежи.Итог("РазмерКвоты");
			КонецЕсли;
		КонецЕсли;
		
		Если РазмерВыделеннойКвотыПоИнвалидам > РазмерыКвотПоИнвалидам[НачалоМесяца(ОкончаниеПериода)] Тогда
			Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010022001"] = РазмерВыделеннойКвотыПоИнвалидам - РазмерыКвотПоИнвалидам[НачалоМесяца(ОкончаниеПериода)]; 
		КонецЕсли;
		
		Если РазмерВыделеннойКвотыПоМолодежи > РазмерыКвотПоМолодежи[НачалоМесяца(ОкончаниеПериода)] Тогда
			Контейнер.ПолеТабличногоДокументаФормаОтчета["П000010022002"] = РазмерВыделеннойКвотыПоМолодежи - РазмерыКвотПоМолодежи[НачалоМесяца(ОкончаниеПериода)]; 
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗначенияПоказателей_Статистика1КвотированиеС2024Года(ПараметрыОтчета, Контейнер)
	
	Организация = ПараметрыОтчета.Организация;
	НачалоПериода = ПараметрыОтчета.ДатаНачалаПериодаОтчета;
	ОкончаниеПериода = ПараметрыОтчета.ДатаКонцаПериодаОтчета;
	ПоследнийКварталПредыдущегоГода = Новый СтандартныйПериод;
	ПоследнийКварталПредыдущегоГода.ДатаОкончания = КонецМесяца(НачалоГода(НачалоПериода)-1);
	ПоследнийКварталПредыдущегоГода.ДатаНачала = НачалоМесяца(ДобавитьМесяц(НачалоГода(НачалоПериода),-3));

	ПоказателиОтчета = ПоказателиОтчета_Статистика1КвотированиеС2024Года(НачалоПериода, ОкончаниеПериода);
	
	// Очищаем разделы 
	Для Каждого Показатель Из ПоказателиОтчета Цикл
		Если ТипЗнч(Показатель) = Тип("КлючИЗначение") Тогда 
			Для Каждого ПоказательОтчетаСоответствия Из Показатель.Значение Цикл
				Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказательОтчетаСоответствия.Значение] = 0;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// Сбор данных

	ПоказателиСреднесписочнойЧисленности	= ПоказателиОтчета.ПоказателиСреднесписочнойЧисленности;
	ПоказателиРазмерКвотыПоМолодежи				= ПоказателиОтчета.ПоказателиРазмерКвотыПоМолодежи;
	ПоказателиРаботалоИнвалидовСверхКвоты		= ПоказателиОтчета.ПоказателиРаботалоИнвалидовСверхКвоты;
	ПоказателиРаботалоМолодежи					= ПоказателиОтчета.ПоказателиРаботалоМолодежи;
	ПоказателиКатегорииКвот						= ПоказателиОтчета.ПоказателиКатегорииКвот;
	ПрочиеПоказатели							= ПоказателиОтчета.ПрочиеПоказатели;

	РазмерыКвотВсего = Новый Соответствие;
	РазмерыКвотВсего.Вставить(ДобавитьМесяц(НачалоПериода,0), 0);
	РазмерыКвотВсего.Вставить(ДобавитьМесяц(НачалоПериода,1), 0);
	РазмерыКвотВсего.Вставить(ДобавитьМесяц(НачалоПериода,2), 0);

	РазмерыКвотПоИнвалидам = Новый Соответствие;
	РазмерыКвотПоИнвалидам.Вставить(ДобавитьМесяц(НачалоПериода,0), 0);
	РазмерыКвотПоИнвалидам.Вставить(ДобавитьМесяц(НачалоПериода,1), 0);
	РазмерыКвотПоИнвалидам.Вставить(ДобавитьМесяц(НачалоПериода,2), 0); 
	РазмерыКвотПоИнвалидамИтого = 0;

	РазмерыКвотПоМолодежи = Новый Соответствие;
	РазмерыКвотПоМолодежи.Вставить(ДобавитьМесяц(НачалоПериода,0), 0);
	РазмерыКвотПоМолодежи.Вставить(ДобавитьМесяц(НачалоПериода,1), 0);
	РазмерыКвотПоМолодежи.Вставить(ДобавитьМесяц(НачалоПериода,2), 0); 
	РазмерыКвотПоМолодежиИтого = 0;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СоздатьВТКадровыеДанные(Запрос, ПоследнийКварталПредыдущегоГода.ДатаНачала, ПоследнийКварталПредыдущегоГода.ДатаОкончания, Организация);
	СоздатьВТСреднесписочнаяЧисленностьДляРасчетаКвоты(Запрос, ПоследнийКварталПредыдущегоГода.ДатаНачала, ПоследнийКварталПредыдущегоГода.ДатаОкончания, Организация);
	
	ТекстЗапросаСписочнойЧисленности = 
	"ВЫБРАТЬ
	|	СреднесписочнаяЧисленностьДляРасчетаКвоты.СреднесписочнаяЧисленностьРаботниковБезОпасныхВредныхУсловий КАК СреднесписочнаяЧисленностьРаботниковБезОпасныхВредныхУсловий,
	|	СреднесписочнаяЧисленностьДляРасчетаКвоты.СреднесписочнаяЧисленностьСотрудников КАК СреднесписочнаяЧисленностьСотрудников,
	|	СреднесписочнаяЧисленностьДляРасчетаКвоты.Период КАК Период
	|ИЗ
	|	ВТСреднесписочнаяЧисленностьДляРасчетаКвоты КАК СреднесписочнаяЧисленностьДляРасчетаКвоты
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.Текст = ТекстЗапросаСписочнойЧисленности;
	
	ДанныеПоследнийКварталПредыдущегоГода = Запрос.Выполнить().Выгрузить();
	
	КоличествоПериодов = ДанныеПоследнийКварталПредыдущегоГода.Скопировать();
	КоличествоПериодов.Свернуть("Период");
	КоличествоПериодов = КоличествоПериодов.Количество();
	
	Если КоличествоПериодов > 0 Тогда
		СреднесписочнаяЧисленностьПоследнийКварталПредыдущегоГода = ДанныеПоследнийКварталПредыдущегоГода.Итог("СреднесписочнаяЧисленностьСотрудников")/КоличествоПериодов;
		СреднесписочнаяЧисленностьБезОпасныхВредныхУсловий = ДанныеПоследнийКварталПредыдущегоГода.Итог("СреднесписочнаяЧисленностьРаботниковБезОпасныхВредныхУсловий")/КоличествоПериодов;
	Иначе
		СреднесписочнаяЧисленностьПоследнийКварталПредыдущегоГода = 0;
		СреднесписочнаяЧисленностьБезОпасныхВредныхУсловий = 0;
	КонецЕсли;
	Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказателиСреднесписочнойЧисленности.Получить(ПоследнийКварталПредыдущегоГода.ДатаОкончания)] = СреднесписочнаяЧисленностьПоследнийКварталПредыдущегоГода;
	СреднесписочнаяЧисленностьДляРасчетаКвоты = СреднесписочнаяЧисленностьПоследнийКварталПредыдущегоГода;
	
	Запрос.МенеджерВременныхТаблиц.Закрыть();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СоздатьВТКадровыеДанные(Запрос, НачалоГода(НачалоПериода), ОкончаниеПериода, Организация);
	СоздатьВТКадровыеДанныеПоКвотам(Запрос, НачалоГода(НачалоПериода), ОкончаниеПериода, Организация);
	СоздатьВТСреднесписочнаяЧисленностьДляРасчетаКвоты(Запрос, НачалоГода(НачалоПериода), ОкончаниеПериода, Организация);	
	СоздатьВТРаботалоВСчетКвоты(Запрос);
	Запрос.Текст = ТекстЗапросаСписочнойЧисленности;
	
	ПериодыРасчета = Запрос.Выполнить().Выбрать();
	Пока ПериодыРасчета.Следующий() Цикл
		
		Если Не РазмерыКвотВсего.Получить(ПериодыРасчета.Период) = Неопределено Тогда
			
			РазмерКвотыПоИнвалидам = СреднесписочнаяЧисленностьБезОпасныхВредныхУсловий * 0.02;
			Если Не Цел(РазмерКвотыПоИнвалидам) = РазмерКвотыПоИнвалидам Тогда
				РазмерКвотыПоИнвалидам = Цел(РазмерКвотыПоИнвалидам);
			КонецЕсли;
			
			РазмерКвотыПоМолодежи = СреднесписочнаяЧисленностьДляРасчетаКвоты * 0.02;
			Если Не Цел(РазмерКвотыПоМолодежи) = РазмерКвотыПоМолодежи Тогда
				РазмерКвотыПоМолодежи = Цел(РазмерКвотыПоМолодежи);
			КонецЕсли;
			
			РазмерКвотыВсего = РазмерКвотыПоИнвалидам + РазмерКвотыПоМолодежи;
			
			РазмерыКвотВсего.Вставить(ПериодыРасчета.Период, РазмерКвотыВсего);
			РазмерыКвотПоИнвалидам.Вставить(ПериодыРасчета.Период, РазмерКвотыПоИнвалидам);
			РазмерыКвотПоМолодежи.Вставить(ПериодыРасчета.Период, РазмерКвотыПоМолодежи);
			
		КонецЕсли;
		
		Если Не ПоказателиСреднесписочнойЧисленности.Получить(ПериодыРасчета.Период) = Неопределено Тогда
			Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказателиСреднесписочнойЧисленности.Получить(ПериодыРасчета.Период)] = ПериодыРасчета.СреднесписочнаяЧисленностьСотрудников;
		КонецЕсли;
		Если Не ПоказателиРазмерКвотыПоМолодежи.Получить(ПериодыРасчета.Период) = Неопределено Тогда
			Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказателиРазмерКвотыПоМолодежи.Получить(ПериодыРасчета.Период)] = РазмерыКвотПоМолодежи.Получить(ПериодыРасчета.Период);
		КонецЕсли;
		
		Если ПериодыРасчета.СреднесписочнаяЧисленностьСотрудников < СреднесписочнаяЧисленностьДляРасчетаКвоты
			Или СреднесписочнаяЧисленностьДляРасчетаКвоты = 0 И ПериодыРасчета.СреднесписочнаяЧисленностьСотрудников > 0 Тогда
				СреднесписочнаяЧисленностьДляРасчетаКвоты = ПериодыРасчета.СреднесписочнаяЧисленностьСотрудников;
				СреднесписочнаяЧисленностьБезОпасныхВредныхУсловий = ПериодыРасчета.СреднесписочнаяЧисленностьСотрудников;
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РаботалоВСчетКвотыИнвалидов.КоличествоСотрудников КАК КоличествоСотрудников,
	|	РаботалоВСчетКвотыИнвалидов.Период КАК Период
	|ИЗ
	|	ВТРаботалоВСчетКвотыИнвалидов КАК РаботалоВСчетКвотыИнвалидов";
	ТрудоустройствоИнвалидов = Запрос.Выполнить().Выгрузить();

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РаботалоВСчетКвотыМолодежи.КоличествоСотрудников КАК КоличествоСотрудников,
	|	РаботалоВСчетКвотыМолодежи.Период КАК Период
	|ИЗ
	|	ВТРаботалоВСчетКвотыМолодежи КАК РаботалоВСчетКвотыМолодежи";
	ТрудоустройствоМолодежи = Запрос.Выполнить().Выгрузить();

	Для Каждого Показатель Из ПоказателиРаботалоМолодежи Цикл
		
		Период = Показатель.Ключ;
		
		ТрудоустройствоМолодежиОтбор = ТрудоустройствоМолодежи.Скопировать(ТрудоустройствоМолодежи.НайтиСтроки(Новый Структура("Период", Период)));
		ТрудоустроеноМолодежиВСчетКвоты = Мин(РазмерыКвотПоМолодежи[Период], ТрудоустройствоМолодежиОтбор.Итог("КоличествоСотрудников"));
		Контейнер.ПолеТабличногоДокументаФормаОтчета[Показатель.Значение] = ТрудоустроеноМолодежиВСчетКвоты;
		
		ТрудоустройствоИнвалидовОтбор = ТрудоустройствоИнвалидов.Скопировать(ТрудоустройствоИнвалидов.НайтиСтроки(Новый Структура("Период", Период)));
		ТрудоустроеноИнвалидов = ТрудоустройствоИнвалидовОтбор.Итог("КоличествоСотрудников");
		ТрудоустроеноИнвалидовВСчетКвоты = Мин(РазмерыКвотПоИнвалидам[Период], ТрудоустроеноИнвалидов);
		ТрудоустроеноИнвалидовСверхКвоты = ТрудоустроеноИнвалидов - ТрудоустроеноИнвалидовВСчетКвоты;
		Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказателиРаботалоИнвалидовСверхКвоты.Получить(Период)] = ТрудоустроеноИнвалидовСверхКвоты;
		
	КонецЦикла;

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеТрудоустройстваПоКвотам.ДатаНачала КАК ДатаНачала,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеТрудоустройстваПоКвотам.Сотрудник) КАК КоличествоСотрудниковНаНачалоПериода
	|ИЗ
	|	ВТДанныеТрудоустройстваПоКвотам КАК ДанныеТрудоустройстваПоКвотам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТрудоустройствоСотрудниковПоКвотамДвижение КАК КвотыДвижение
	|		ПО ДанныеТрудоустройстваПоКвотам.Организация = КвотыДвижение.Организация
	|			И ДанныеТрудоустройстваПоКвотам.Сотрудник = КвотыДвижение.Сотрудник
	|			И ДанныеТрудоустройстваПоКвотам.ВидКвоты = КвотыДвижение.ВидКвоты
	|			И ДанныеТрудоустройстваПоКвотам.ДатаНачала = КвотыДвижение.ПериодЗаписи
	|			И ДанныеТрудоустройстваПоКвотам.ТрудоустроенПоКвоте = КвотыДвижение.ТрудоустроенПоКвоте
	|ГДЕ
	|	(ДанныеТрудоустройстваПоКвотам.ДатаНачала = &НачалоПериода
	|			ИЛИ ДанныеТрудоустройстваПоКвотам.ДатаНачала = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОкончаниеПериода, ДЕНЬ, 1), ДЕНЬ))
	|	И ДанныеТрудоустройстваПоКвотам.ТрудоустроенПоКвоте
	|	И ДанныеТрудоустройстваПоКвотам.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)
	|	И ЕСТЬNULL(КвотыДвижение.ПериодЗаписи, 0) = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеТрудоустройстваПоКвотам.ДатаНачала";
	ТаблицаПоКоличествуМолодежи = Запрос.Выполнить().Выгрузить();

	РаботалоВСчетКвотыПоМолодежиНаКонецПериода = 0;
	КоличествоМолодежиНаКонецПериода = ТаблицаПоКоличествуМолодежи.Найти(НачалоДня(ОкончаниеПериода+1));
	Если КоличествоМолодежиНаКонецПериода <> Неопределено Тогда
		КоличествоМолодежиНаКонецПериода = КоличествоМолодежиНаКонецПериода.КоличествоСотрудниковНаНачалоПериода;
		РаботалоВСчетКвотыПоМолодежиНаКонецПериода = Мин(РазмерыКвотПоМолодежи[НачалоМесяца(ОкончаниеПериода)], КоличествоМолодежиНаКонецПериода);
	Иначе
		КоличествоМолодежиНаКонецПериода = 0;
	КонецЕсли;
	Контейнер.ПолеТабличногоДокументаФормаОтчета[ПрочиеПоказатели.Получить("РаботалоМолодежиСверхКвоты")] = Макс(0, КоличествоМолодежиНаКонецПериода - РазмерыКвотПоМолодежи[НачалоМесяца(ОкончаниеПериода)]);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеСотрудниковПоКвотам.ДатаПриема КАК ДатаПриема,
	|	ДанныеСотрудниковПоКвотам.ВидКвоты КАК ВидКвоты,
	|	ДанныеСотрудниковПоКвотам.КатегорияКвоты КАК КатегорияКвоты,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеСотрудниковПоКвотам.Сотрудник) КАК КоличествоСотрудников
	|ИЗ
	|	ВТКадровыеДанныеСотрудниковПоКвотам КАК ДанныеСотрудниковПоКвотам
	|ГДЕ
	|	ДанныеСотрудниковПоКвотам.ТрудоустроенПоКвоте
	|	И ДанныеСотрудниковПоКвотам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, МЕСЯЦ) И &ОкончаниеПериода
	|	И ДанныеСотрудниковПоКвотам.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеСотрудниковПоКвотам.ДатаПриема,
	|	ДанныеСотрудниковПоКвотам.КатегорияКвоты,
	|	ДанныеСотрудниковПоКвотам.ВидКвоты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПриема,
	|	КатегорияКвоты"
	;
	СведенияПоКатегориямКвот = Запрос.Выполнить().Выгрузить();
	
	ОсталосьЗаполнитьСотрудников = РаботалоВСчетКвотыПоМолодежиНаКонецПериода;
	Для Каждого ПоказательКатегории Из ПоказателиКатегорииКвот Цикл
		
		КатегорииКвотОтбор = СведенияПоКатегориямКвот.Скопировать(СведенияПоКатегориямКвот.НайтиСтроки(ПоказательКатегории.Ключ));
		КоличествоСотрудников = Мин(КатегорииКвотОтбор.Итог("КоличествоСотрудников"), ОсталосьЗаполнитьСотрудников);
		Контейнер.ПолеТабличногоДокументаФормаОтчета[ПоказательКатегории.Значение] = КоличествоСотрудников;
		ОсталосьЗаполнитьСотрудников = ОсталосьЗаполнитьСотрудников - КоличествоСотрудников;
		
	КонецЦикла;

КонецПроцедуры

Процедура СоздатьВТКоличествоСпециальныхРабочихМест(Запрос)
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ОхранаТруда") Тогда
		МодульОхранаТруда = ОбщегоНазначения.ОбщийМодуль("ОхранаТруда");
		Если Не МодульОхранаТруда.ОхранаТрудаИспользуется() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РабочиеМестаОхраныТруда.Владелец КАК Организация,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РабочиеМестаОхраныТруда.Ссылка) КАК КоличествоСпециальныхРабочихМест
	|ПОМЕСТИТЬ ВТСпециальныеРабочиеМестаВсего
	|ИЗ
	|	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
	|ГДЕ
	|	НЕ РабочиеМестаОхраныТруда.ПометкаУдаления
	|	И НЕ РабочиеМестаОхраныТруда.ВАрхиве
	|	И РабочиеМестаОхраныТруда.СпециальноеРабочееМестоДляИнвалидов
	|
	|СГРУППИРОВАТЬ ПО
	|	РабочиеМестаОхраныТруда.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТКадровыеДанныеСотрудников.Период КАК Период,
	|	ВТКадровыеДанныеСотрудников.Организация КАК Организация,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(РабочиеМестаОхраныТруда.Ссылка, """") = """"
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК ЗанятоСпециальныхРабочихМест
	|ПОМЕСТИТЬ ВТСпециальныеРабочиеМестаЗанято
	|ИЗ
	|	ВТКадровыеДанныеСотрудников КАК ВТКадровыеДанныеСотрудников
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
	|		ПО (РабочиеМестаОхраныТруда.Владелец = ВТКадровыеДанныеСотрудников.Организация)
	|			И (РабочиеМестаОхраныТруда.Ссылка = ВТКадровыеДанныеСотрудников.РабочееМестоОхраныТруда)
	|			И (ВТКадровыеДанныеСотрудников.ТрудоустроенПоКвоте)
	|			И (ВТКадровыеДанныеСотрудников.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов))
	|			И (НЕ РабочиеМестаОхраныТруда.ПометкаУдаления)
	|			И (НЕ РабочиеМестаОхраныТруда.ВАрхиве)
	|			И (РабочиеМестаОхраныТруда.СпециальноеРабочееМестоДляИнвалидов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТКадровыеДанныеСотрудников.Организация,
	|	ВТКадровыеДанныеСотрудников.Период"
	;

	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СоздатьВТДляЗаполненияОтчетности(Запрос, НачалоПериода, ОкончаниеПериода, Организация) Экспорт

	СоздатьВТКадровыеДанные(Запрос, НачалоПериода, ОкончаниеПериода, Организация);
	СоздатьВТКадровыеДанныеПоКвотам(Запрос, НачалоПериода, ОкончаниеПериода, Организация);
	СоздатьВТСреднесписочнаяЧисленностьДляРасчетаКвоты(Запрос, НачалоПериода, ОкончаниеПериода, Организация);	
	СоздатьВТРаботалоВСчетКвоты(Запрос);
	СоздатьВТКоличествоСпециальныхРабочихМест(Запрос);
	
КонецПроцедуры	

Процедура СоздатьВТСреднесписочнаяЧисленностьДляРасчетаКвоты(Запрос, НачалоПериода, ОкончаниеПериода, Организация)
	
	Запрос.УстановитьПараметр("ОпасныеВредныеКлассыУсловийТруда", ОпасныеВредныеКлассыУсловийТруда());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(КадровыеДанныеСотрудников.КлассУсловийТруда, """") В (&ОпасныеВредныеКлассыУсловийТруда)
	|				ТОГДА 0
	|			ИНАЧЕ СведенияОЧисленностиПоСотрудникам.СредняяЧисленностьСписочногоСостава
	|		КОНЕЦ) КАК СреднесписочнаяЧисленностьРаботниковБезОпасныхВредныхУсловий,
	|	СУММА(СведенияОЧисленностиПоСотрудникам.СредняяЧисленностьСписочногоСостава) КАК СреднесписочнаяЧисленностьСотрудников,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(КадровыеДанныеСотрудников.КлассУсловийТруда, """") В (&ОпасныеВредныеКлассыУсловийТруда)
	|				ТОГДА 0
	|			ИНАЧЕ СведенияОЧисленностиПоСотрудникам.ЧисленностьСотрудников
	|		КОНЕЦ) КАК ЧисленностьСотрудниковБезОпасныхВредныхУсловий,
	|	СУММА(СведенияОЧисленностиПоСотрудникам.ЧисленностьСотрудников) КАК ЧисленностьСотрудников,
	|	СведенияОЧисленностиПоСотрудникам.Период КАК Период
	|ПОМЕСТИТЬ ВТСреднесписочнаяЧисленностьДляРасчетаКвоты
	|ИЗ
	|	ВТСведенияОЧисленностиПоСотрудникам КАК СведенияОЧисленностиПоСотрудникам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
	|		ПО СведенияОЧисленностиПоСотрудникам.Сотрудник = КадровыеДанныеСотрудников.Сотрудник
	|			И СведенияОЧисленностиПоСотрудникам.Должность = КадровыеДанныеСотрудников.Должность
	|			И СведенияОЧисленностиПоСотрудникам.Организация = КадровыеДанныеСотрудников.Организация
	|			И СведенияОЧисленностиПоСотрудникам.Подразделение = КадровыеДанныеСотрудников.Подразделение
	|			И СведенияОЧисленностиПоСотрудникам.Период = КадровыеДанныеСотрудников.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	СведенияОЧисленностиПоСотрудникам.Период"
	;
	
	ПараметрыЧисленности = СтатистикаПерсонала.ПараметрыДляСведенийОЧисленности();
	
	ПараметрыЧисленности.Организация = Организация;
	ПараметрыЧисленности.ДатаНачала = НачалоПериода;
	ПараметрыЧисленности.ДатаОкончания = ОкончаниеПериода;
	ПараметрыЧисленности.ПоГоловнойОрганизации = Ложь;
	ПараметрыЧисленности.ПоМестамВСтруктуреПредприятия = Истина;
	ПараметрыЧисленности.ПоПодразделениям = Истина;
	ПараметрыЧисленности.ПоМесяцам = Истина;
	ПараметрыЧисленности.ПоДолжностям = Истина;
	ПараметрыЧисленности.ДатаНачала = НачалоПериода;
	ПараметрыЧисленности.ДатаОкончания = ОкончаниеПериода;
	
	СведенияОЧисленностиПоСотрудникам = СтатистикаПерсонала.СведенияОЧисленности(10);
	СведенияОЧисленностиПоСотрудникам.Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	СведенияОЧисленностиПоСотрудникам.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	
	СтатистикаПерсонала.ЗаполнитьСведенияОЧисленности(СведенияОЧисленностиПоСотрудникам, ПараметрыЧисленности);
	
	ЗарплатаКадры.СоздатьВТПоТаблицеЗначений(Запрос.МенеджерВременныхТаблиц, СведенияОЧисленностиПоСотрудникам, "ВТСведенияОЧисленностиПоСотрудникам", Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
КонецПроцедуры 

Процедура СоздатьВТРаботалоВСчетКвоты(Запрос)
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ДанныеТрудоустройстваПоКвотам.ДатаНачала, МЕСЯЦ) КАК Период,
	|	ДанныеТрудоустройстваПоКвотам.Организация КАК Организация,
	|	ДанныеТрудоустройстваПоКвотам.Сотрудник КАК Сотрудник,
	|	ДанныеТрудоустройстваПоКвотам.ВидКвоты КАК ВидКвоты,
	|	СУММА(ДанныеТрудоустройстваПоКвотам.КоличествоДнейТрудоустройства) КАК КоличествоДнейТрудоустройства
	|ПОМЕСТИТЬ ВТДанныеТрудоустройстваПоКвотамСвернуто
	|ИЗ
	|	ВТДанныеТрудоустройстваПоКвотам КАК ДанныеТрудоустройстваПоКвотам
	|ГДЕ
	|	ДанныеТрудоустройстваПоКвотам.ТрудоустроенПоКвоте
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ДанныеТрудоустройстваПоКвотам.ДатаНачала, МЕСЯЦ),
	|	ДанныеТрудоустройстваПоКвотам.Организация,
	|	ДанныеТрудоустройстваПоКвотам.Сотрудник,
	|	ДанныеТрудоустройстваПоКвотам.ВидКвоты
	|
	|ИМЕЮЩИЕ
	|	СУММА(ДанныеТрудоустройстваПоКвотам.КоличествоДнейТрудоустройства) >= 15
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеТрудоустройстваПоКвотам.Сотрудник) КАК КоличествоСотрудников,
	|	ДанныеТрудоустройстваПоКвотам.Период КАК Период
	|ПОМЕСТИТЬ ВТРаботалоВСчетКвотыИнвалидов
	|ИЗ
	|	ВТДанныеТрудоустройстваПоКвотамСвернуто КАК ДанныеТрудоустройстваПоКвотам
	|ГДЕ
	|	ДанныеТрудоустройстваПоКвотам.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваИнвалидов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеТрудоустройстваПоКвотам.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеТрудоустройстваПоКвотам.Сотрудник) КАК КоличествоСотрудников,
	|	ДанныеТрудоустройстваПоКвотам.Период КАК Период
	|ПОМЕСТИТЬ ВТРаботалоВСчетКвотыМолодежи
	|ИЗ
	|	ВТДанныеТрудоустройстваПоКвотамСвернуто КАК ДанныеТрудоустройстваПоКвотам
	|ГДЕ
	|	ДанныеТрудоустройстваПоКвотам.ВидКвоты = ЗНАЧЕНИЕ(Справочник.ВидыКвотДляТрудоустройства.КвотаДляТрудоустройстваМолодежи)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеТрудоустройстваПоКвотам.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТДанныеТрудоустройстваПоКвотамСвернуто"
	;
	
	Запрос.Выполнить();
КонецПроцедуры

Процедура СоздатьВТКадровыеДанные(Запрос, НачалоПериода, ОкончаниеПериода, Организация)
	
	ПараметрыПолученияСотрудниковОрганизаций = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолученияСотрудниковОрганизаций.Организация = Организация;
	ПараметрыПолученияСотрудниковОрганизаций.НачалоПериода = НачалоПериода;
	ПараметрыПолученияСотрудниковОрганизаций.ОкончаниеПериода = ОкончаниеПериода;
	ПараметрыПолученияСотрудниковОрганизаций.ПодработкиРаботниковПоТрудовымДоговорам = Истина;
	ПараметрыПолученияСотрудниковОрганизаций.РаботникиПоДоговорамГПХ = Неопределено;
	
	ПараметрыПолученияСотрудниковОрганизаций.Отборы = Новый Массив();
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолученияСотрудниковОрганизаций.Отборы, "ВидДоговора", "В", Перечисления.ВидыДоговоровССотрудниками.ВидыДоговоровКромеВоеннойСлужбы());
	
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыПолученияСотрудниковОрганизаций , "ВТСписокСотрудниковОрганизации");
	
	ЗарплатаКадрыОбщиеНаборыДанных.СоздатьВТПериоды(Запрос.МенеджерВременныхТаблиц, НачалоПериода, ДобавитьМесяц(ОкончаниеПериода,1));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сотрудники.Сотрудник КАК Сотрудник,
	|	Периоды.Период КАК ДатаНачала,
	|	КОНЕЦПЕРИОДА(Периоды.Период, МЕСЯЦ) КАК ДатаОкончания
	|ПОМЕСТИТЬ ВТФильтрСотрудников
	|ИЗ
	|	ВТСписокСотрудниковОрганизации КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПериоды КАК Периоды
	|		ПО (ИСТИНА)";
	
	Запрос.Выполнить();
	
	ОписаниеФильтраСотрудников = ЗарплатаКадрыПериодическиеРегистры.ОписаниеФильтраДляСоздатьВТИмяРегистраПоВременнойТаблице("ВТФильтрСотрудников", "Сотрудник");
	ПараметрыПолученияКадровыхПериодов = ЗарплатаКадрыПериодическиеРегистры.ПараметрыПостроенияДляСоздатьВТИмяРегистра();
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолученияКадровыхПериодов.Отборы, "ВидСобытия", " <> ", Перечисления.ВидыКадровыхСобытий.Увольнение);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолученияКадровыхПериодов.Отборы, "Организация", " = ", Организация);
	
	ЗарплатаКадрыПериодическиеРегистры.СоздатьВТИмяРегистраПериоды(
		"КадроваяИсторияСотрудников", 
		Запрос.МенеджерВременныхТаблиц, 
		Истина, 
		ОписаниеФильтраСотрудников, 
		ПараметрыПолученияКадровыхПериодов, 
		"ВТКадроваяИсторияСотрудниковПериоды");


	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписокСотрудников.Сотрудник КАК Сотрудник,
	|	КадроваяИстория.НачалоПериода КАК Период
	|ПОМЕСТИТЬ ВТСотрудники
	|ИЗ
	|	ВТСписокСотрудниковОрганизации КАК СписокСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКадроваяИсторияСотрудниковПериоды КАК КадроваяИстория
	|		ПО СписокСотрудников.Сотрудник = КадроваяИстория.Сотрудник
	|			И СписокСотрудников.ФизическоеЛицо = КадроваяИстория.ФизическоеЛицо";
	
	Запрос.Выполнить();
	
	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(
			Запрос.МенеджерВременныхТаблиц,
			"ВТСотрудники");

	КадровыеДанные = 
	"Сотрудник,
	|Организация,
	|Подразделение,
	|Должность,
	|ВидДоговора,
	|ВидЗанятости,
	|СрочныйДоговор,
	|КлассУсловийТруда,
	|КлассУсловийТрудаПериодРегистрации,
	|РабочееМестоОхраныТруда,
	|ТрудоустроенПоКвоте,
	|ВидКвоты,
	|Состояние";
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВременныхТаблиц, Истина, КадровыеДанные);
	
КонецПроцедуры

Процедура СоздатьВТКадровыеДанныеПоКвотам(Запрос, НачалоПериода, ОкончаниеПериода, Организация)

	ОписаниеФильтраСотрудников = ЗарплатаКадрыПериодическиеРегистры.ОписаниеФильтраДляСоздатьВТИмяРегистраПоВременнойТаблице("ВТФильтрСотрудников", "Сотрудник");
	ПараметрыПолученияКадровыхПериодов = ЗарплатаКадрыПериодическиеРегистры.ПараметрыПостроенияДляСоздатьВТИмяРегистра();
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолученияКадровыхПериодов.Отборы, "Организация", " = ", Организация);

	ЗарплатаКадрыПериодическиеРегистры.СоздатьВТИмяРегистра(
		"ТрудоустройствоСотрудниковПоКвотам", 
		Запрос.МенеджерВременныхТаблиц, 
		Истина, 
		ОписаниеФильтраСотрудников, 
		ПараметрыПолученияКадровыхПериодов, 
		"ВТТрудоустройствоСотрудниковПоКвотам");
		
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ОкончаниеПериода));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписокСотрудников.Сотрудник КАК Сотрудник,
	|	СписокСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	|	КадроваяИстория.Организация КАК Организация,
	|	НАЧАЛОПЕРИОДА(КадроваяИстория.НачалоПериода, ДЕНЬ) КАК ДатаНачала,
	|	КОНЕЦПЕРИОДА(КадроваяИстория.КонецПериода, ДЕНЬ) КАК ДатаОкончания
	|ИЗ
	|	ВТСписокСотрудниковОрганизации КАК СписокСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКадроваяИсторияСотрудниковПериоды КАК КадроваяИстория
	|		ПО СписокСотрудников.Сотрудник = КадроваяИстория.Сотрудник
	|			И СписокСотрудников.ФизическоеЛицо = КадроваяИстория.ФизическоеЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	ДатаНачала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписокСотрудников.Сотрудник КАК Сотрудник,
	|	СписокСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	|	КвотыДвижение.Организация КАК Организация,
	|	НАЧАЛОПЕРИОДА(КвотыДвижение.ПериодЗаписи, ДЕНЬ) КАК ДатаНачала
	|ИЗ
	|	ВТСписокСотрудниковОрганизации КАК СписокСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТрудоустройствоСотрудниковПоКвотам КАК КвотыДвижение
	|		ПО СписокСотрудников.Сотрудник = КвотыДвижение.Сотрудник
	|ГДЕ
	|	(КвотыДвижение.ПериодЗаписи >= &ДатаНачала
	|			ИЛИ КвотыДвижение.ПериодЗаписи <= &ДатаОкончания)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	ДатаНачала";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ПериодыКадровыхДанных = РезультатЗапроса[0].Выгрузить();
	ПериодыТрудоустройстваПоКвотам = РезультатЗапроса[1].Выгрузить();
	
	Для Каждого ПериодТрудоустройстваПоКвотам Из ПериодыТрудоустройстваПоКвотам Цикл
		
		ПериодыКадровыхДанныхПоСотруднику = ПериодыКадровыхДанных.НайтиСтроки(Новый Структура("Сотрудник", ПериодТрудоустройстваПоКвотам.Сотрудник));
		
		РазделениеПериодаВыполнено = Ложь;
		
		Для Каждого ПериодКадровыхДанныхПоСотруднику Из ПериодыКадровыхДанныхПоСотруднику Цикл
			
			Если ПериодТрудоустройстваПоКвотам.ДатаНачала > ПериодКадровыхДанныхПоСотруднику.ДатаНачала И
				ПериодТрудоустройстваПоКвотам.ДатаНачала < ПериодКадровыхДанныхПоСотруднику.ДатаОкончания Тогда
				
				НоваяСтрока = ПериодыКадровыхДанных.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ПериодКадровыхДанныхПоСотруднику);
				ПериодКадровыхДанныхПоСотруднику.ДатаОкончания = КонецДня(ПериодТрудоустройстваПоКвотам.ДатаНачала -1);
				НоваяСтрока.ДатаНачала = ПериодТрудоустройстваПоКвотам.ДатаНачала;
				
				ПериодКадровыхДанныхПоСотруднику = НоваяСтрока;
				
				РазделениеПериодаВыполнено = Истина;
				
			КонецЕсли;
			
			Если РазделениеПериодаВыполнено Тогда
				прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗарплатаКадры.СоздатьВТПоТаблицеЗначений(Запрос.МенеджерВременныхТаблиц, ПериодыКадровыхДанных, "ВТПериодыКадровыхДанных");

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПериодыКадровыхДанных.Сотрудник КАК Сотрудник,
	|	НАЧАЛОПЕРИОДА(ПериодыКадровыхДанных.ДатаНачала, ДЕНЬ) КАК Период
	|ПОМЕСТИТЬ ВТСотрудникиДляРасчетаПоКвотам
	|ИЗ
	|	ВТПериодыКадровыхДанных КАК ПериодыКадровыхДанных";
	
	Запрос.Выполнить();
	
	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(
			Запрос.МенеджерВременныхТаблиц,
			"ВТСотрудникиДляРасчетаПоКвотам");
	ОписательВременныхТаблиц.ИмяВТКадровыеДанныеСотрудников = "ВТКадровыеДанныеСотрудниковПоКвотам";

	КадровыеДанные = 
	"Сотрудник,
	|ФИО,
	|СтраховойНомерПФР,
	|ДатаРождения,
	|Организация,
	|Подразделение,
	|Должность,
	|ВидДоговора,
	|ДатаПриема,
	|ТрудоустроенПоКвоте,
	|ВидКвоты,
	|КатегорияКвоты,
	|ИнвалидностьГруппаИнвалидности,
	|Состояние";
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВременныхТаблиц, Истина, КадровыеДанные);

	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПериодыКадровыхДанных.Организация КАК Организация,
	|	ПериодыКадровыхДанных.Сотрудник КАК Сотрудник,
	|	ПериодыКадровыхДанных.ДатаНачала КАК ДатаНачала,
	|	ПериодыКадровыхДанных.ДатаОкончания КАК ДатаОкончания,
	|	КадровыеДанныеПоКвотам.ТрудоустроенПоКвоте КАК ТрудоустроенПоКвоте,
	|	КадровыеДанныеПоКвотам.ВидКвоты КАК ВидКвоты,
	|	КадровыеДанныеПоКвотам.КатегорияКвоты КАК КатегорияКвоты,
	|	РАЗНОСТЬДАТ(ПериодыКадровыхДанных.ДатаНачала, ДОБАВИТЬКДАТЕ(ПериодыКадровыхДанных.ДатаОкончания, ДЕНЬ, 1), ДЕНЬ) КАК КоличествоДнейТрудоустройства
	|ПОМЕСТИТЬ ВТДанныеТрудоустройстваПоКвотам
	|ИЗ
	|	ВТПериодыКадровыхДанных КАК ПериодыКадровыхДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудниковПоКвотам КАК КадровыеДанныеПоКвотам
	|		ПО ПериодыКадровыхДанных.Сотрудник = КадровыеДанныеПоКвотам.Сотрудник
	|			И ПериодыКадровыхДанных.ДатаНачала = КадровыеДанныеПоКвотам.Период
	|			И ПериодыКадровыхДанных.Организация = КадровыеДанныеПоКвотам.Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	ПериодыКадровыхДанных.Организация,
	|	ПериодыКадровыхДанных.Сотрудник,
	|	ПериодыКадровыхДанных.ДатаНачала,
	|	ПериодыКадровыхДанных.ДатаОкончания,
	|	КадровыеДанныеПоКвотам.ТрудоустроенПоКвоте,
	|	КадровыеДанныеПоКвотам.ВидКвоты,
	|	КадровыеДанныеПоКвотам.КатегорияКвоты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТрудоустройствоПоКвотам.Организация КАК Организация,
	|	ТрудоустройствоПоКвотам.Сотрудник КАК Сотрудник,
	|	ТрудоустройствоПоКвотам.ПериодЗаписи КАК ПериодЗаписи,
	|	ТрудоустройствоПоКвотам.ТрудоустроенПоКвоте КАК ТрудоустроенПоКвоте,
	|	ТрудоустройствоПоКвотам.ВидКвоты КАК ВидКвоты,
	|	ТрудоустройствоПоКвотам.КатегорияКвоты КАК КатегорияКвоты,
	|	ТрудоустройствоПоКвотам.Активность КАК Активность,
	|	ТрудоустройствоПоКвотам.Регистратор КАК Регистратор,
	|	ТрудоустройствоПоКвотам.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ДанныеПоКвотам.ВидКвоты, НЕОПРЕДЕЛЕНО) КАК ПредыдущийВидКвоты
	|ПОМЕСТИТЬ ВТТрудоустройствоСотрудниковПоКвотамДвижение
	|ИЗ
	|	ВТТрудоустройствоСотрудниковПоКвотам КАК ТрудоустройствоПоКвотам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДанныеТрудоустройстваПоКвотам КАК ДанныеПоКвотам
	|		ПО ТрудоустройствоПоКвотам.Организация = ДанныеПоКвотам.Организация
	|			И ТрудоустройствоПоКвотам.Сотрудник = ДанныеПоКвотам.Сотрудник
	|			И (ТрудоустройствоПоКвотам.ПериодЗаписи = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ДанныеПоКвотам.ДатаОкончания, ДЕНЬ, 1), ДЕНЬ))
	|
	|СГРУППИРОВАТЬ ПО
	|	ТрудоустройствоПоКвотам.ВидКвоты,
	|	ТрудоустройствоПоКвотам.ПериодЗаписи,
	|	ТрудоустройствоПоКвотам.КатегорияКвоты,
	|	ТрудоустройствоПоКвотам.ТрудоустроенПоКвоте,
	|	ТрудоустройствоПоКвотам.Сотрудник,
	|	ТрудоустройствоПоКвотам.Организация,
	|	ТрудоустройствоПоКвотам.НомерСтроки,
	|	ТрудоустройствоПоКвотам.Регистратор,
	|	ТрудоустройствоПоКвотам.Активность,
	|	ЕСТЬNULL(ДанныеПоКвотам.ВидКвоты, НЕОПРЕДЕЛЕНО)"
	;
	Запрос.ВыполнитьПакет();
	
