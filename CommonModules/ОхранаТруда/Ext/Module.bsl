#Область ПереносДанныхИзПрежнихПрограмм

Процедура ВидыИнструктажейПоОхранеТрудаПослеЗагрузки(Объект, ОбъектНайден, ПараметрыОбъекта, Отказ) Экспорт
	
	Если Отказ Или ПараметрыОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Должности", ПараметрыОбъекта.Получить("Должности"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РабочиеМестаОхраныТруда.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
	|ГДЕ
	|	РабочиеМестаОхраныТруда.Должность В(&Должности)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.РабочиеМеста.Добавить();
		НоваяСтрока.РабочееМесто = Выборка.Ссылка;
	КонецЦикла;
	
	Если Объект.РабочиеМеста.Количество() = 0 Тогда
		Объект.ИспользоватьДляВсехРабочихМест = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура НаправлениеНаМедицинскийОсмотрПослеЗагрузки(Объект, ОбъектНайден, ПараметрыОбъекта, Отказ) Экспорт
	
	Если Отказ Или ПараметрыОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСотрудников = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОбъекта.Получить("Сотрудник"));
	КадровыеДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(Истина, МассивСотрудников,
		"Должность, Подразделение, РабочееМестоОхраныТруда", Объект.ДатаОсмотра);
	
	Для Каждого СтрокаКадровыхДанных Из КадровыеДанныеСотрудников Цикл
		Объект.Должность = СтрокаКадровыхДанных.Должность;
		Объект.Подразделение = СтрокаКадровыхДанных.Подразделение;
		Объект.РабочееМесто = СтрокаКадровыхДанных.РабочееМестоОхраныТруда;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаключениеМедицинскогоОсмотраПослеЗагрузки(Объект, ОбъектНайден, ПараметрыОбъекта, Отказ) Экспорт
	
	Если Отказ Или ПараметрыОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСотрудников = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОбъекта.Получить("Сотрудник"));
	КадровыеДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(Истина, МассивСотрудников,
		"РабочееМестоОхраныТруда", Объект.ДатаОсмотра);
	
	Для Каждого СтрокаКадровыхДанных Из КадровыеДанныеСотрудников Цикл
		Если ЗначениеЗаполнено(СтрокаКадровыхДанных.РабочееМестоОхраныТруда) Тогда
			Объект.РабочееМесто = СтрокаКадровыхДанных.РабочееМестоОхраныТруда;
			СоздатьЗаписьВредныеФакторыИВидыРабот(Объект.РабочееМесто, Объект.ВредныеФакторыИВидыРабот[0].ВредныйФактор);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура НесчастныйСлучайНаПроизводствеПослеЗагрузки(Объект, ПараметрыОбъекта, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ПрилагаемыеДокументы = НСтр("ru = 'Нет документов'");
	Если Не ЗначениеЗаполнено(Объект.ВидПроисшествия) И ПараметрыОбъекта <> Неопределено И Не ПустаяСтрока(ПараметрыОбъекта.Получить("ВидПроисшествияСтрокаПоиска")) Тогда
		
		// Попробуем найти нечетким поиском, с постепенным повышением чувствительности
		СравнениеСтрокНаПодобие = Новый Структура;
		СравнениеСтрокНаПодобие.Вставить("ПроцентСовпаденияСтрок", 90);
		СравнениеСтрокНаПодобие.Вставить("ПроцентСовпаденияНебольшихСтрок", 50);
		СравнениеСтрокНаПодобие.Вставить("ДлинаНебольшихСтрок", 10);
		
		НечеткийПоиск = ОбщегоНазначения.ПодключитьКомпонентуИзМакета("FuzzyStringMatchExtension", "ОбщийМакет.КомпонентаПоискаСтрок");
		Если НечеткийПоиск <> Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ВидыПроисшествий.ПолноеНаименование КАК ПолноеНаименование
			|ИЗ
			|	Справочник.ВидыПроисшествий КАК ВидыПроисшествий";
			
			МассивВсехСтрок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПолноеНаименование");
			ИскомыеСтроки = СтрСоединить(МассивВсехСтрок, "~");
			СтрокаДляПоиска = ПараметрыОбъекта.Получить("ВидПроисшествияСтрокаПоиска");
			ИндексыСтрок = НечеткийПоиск.StringSearch(НРег(СтрокаДляПоиска), НРег(ИскомыеСтроки), "~",
				СравнениеСтрокНаПодобие.ДлинаНебольшихСтрок,
				СравнениеСтрокНаПодобие.ПроцентСовпаденияСтрок,
				СравнениеСтрокНаПодобие.ПроцентСовпаденияНебольшихСтрок);
				
			Если Не ПустаяСтрока(ИндексыСтрок) Тогда
				
				ПредыдущийМассив = Новый Массив;
				МассивНайденныхСтрок = СтрРазделить(ИндексыСтрок, ",");
				Пока МассивНайденныхСтрок.Количество() > 1 Цикл
					
					ПредыдущийМассив = МассивНайденныхСтрок;
					
					// Повышаем порог чувствительности
					СравнениеСтрокНаПодобие.ПроцентСовпаденияНебольшихСтрок = СравнениеСтрокНаПодобие.ПроцентСовпаденияНебольшихСтрок + 1;
					НовыйМассивВсехСтрок = Новый Массив;
					Для Каждого НайденнаяСтрока Из МассивНайденныхСтрок Цикл
						НовыйМассивВсехСтрок.Добавить(МассивВсехСтрок.Получить(НайденнаяСтрока));
					КонецЦикла;
					ИскомыеСтроки = СтрСоединить(НовыйМассивВсехСтрок, "~");
					
					ИндексыСтрок = НечеткийПоиск.StringSearch(НРег(СтрокаДляПоиска), НРег(ИскомыеСтроки), "~",
						СравнениеСтрокНаПодобие.ДлинаНебольшихСтрок,
						СравнениеСтрокНаПодобие.ПроцентСовпаденияСтрок,
						СравнениеСтрокНаПодобие.ПроцентСовпаденияНебольшихСтрок);
					
					МассивНайденныхСтрок = СтрРазделить(ИндексыСтрок, ",");
					МассивВсехСтрок = НовыйМассивВсехСтрок;
					
				КонецЦикла;
				Если МассивНайденныхСтрок.Количество() = 0 Тогда
					МассивНайденныхСтрок = ПредыдущийМассив;
				КонецЕсли;
				
				Для Каждого ИндексСтроки Из МассивНайденныхСтрок Цикл
					Если ПустаяСтрока(ИндексСтроки) Тогда
						Продолжить;
					КонецЕсли;
					
					Запрос = Новый Запрос;
					Запрос.УстановитьПараметр("ПолноеНаименование", МассивВсехСтрок.Получить(ИндексСтроки));
					
					Запрос.Текст =
					"ВЫБРАТЬ
					|	ВидыПроисшествий.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.ВидыПроисшествий КАК ВидыПроисшествий
					|ГДЕ
					|	ВидыПроисшествий.ПолноеНаименование ПОДОБНО &ПолноеНаименование";
					
					Выборка = Запрос.Выполнить().Выбрать();
					Если Выборка.Следующий() Тогда
						Объект.ВидПроисшествия = Выборка.Ссылка;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Для каждого СтрокаПричиныПроисшествий Из Объект.ПричиныПроисшествия Цикл
		Если Не ЗначениеЗаполнено(СтрокаПричиныПроисшествий.Причина) И ПараметрыОбъекта <> Неопределено
			И ПараметрыОбъекта.Получить("ПричиныПроисшествияТабличнаяЧасть") <> Неопределено
			И ПараметрыОбъекта.Получить("ПричиныПроисшествияТабличнаяЧасть").Получить(СтрокаПричиныПроисшествий.НомерСтроки-1).ПричинаСтрокаПоиска <> Неопределено Тогда
			
			// Попробуем найти нечетким поиском, с постепенным повышением чувствительности
			СравнениеСтрокНаПодобие = Новый Структура;
			СравнениеСтрокНаПодобие.Вставить("ПроцентСовпаденияСтрок", 90);
			СравнениеСтрокНаПодобие.Вставить("ПроцентСовпаденияНебольшихСтрок", 50);
			СравнениеСтрокНаПодобие.Вставить("ДлинаНебольшихСтрок", 10);
			
			НечеткийПоиск = ОбщегоНазначения.ПодключитьКомпонентуИзМакета("FuzzyStringMatchExtension", "ОбщийМакет.КомпонентаПоискаСтрок");
			Если НечеткийПоиск <> Неопределено Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	ПричиныПроисшествий.ПолноеНаименование КАК ПолноеНаименование
				|ИЗ
				|	Справочник.ПричиныПроисшествий КАК ПричиныПроисшествий";
				
				МассивВсехСтрок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПолноеНаименование");
				ИскомыеСтроки = СтрСоединить(МассивВсехСтрок, "~");
				СтрокаДляПоиска = ПараметрыОбъекта.Получить("ПричиныПроисшествияТабличнаяЧасть").Получить(СтрокаПричиныПроисшествий.НомерСтроки-1).ПричинаСтрокаПоиска;
				ИндексыСтрок = НечеткийПоиск.StringSearch(НРег(СтрокаДляПоиска), НРег(ИскомыеСтроки), "~",
					СравнениеСтрокНаПодобие.ДлинаНебольшихСтрок,
					СравнениеСтрокНаПодобие.ПроцентСовпаденияСтрок,
					СравнениеСтрокНаПодобие.ПроцентСовпаденияНебольшихСтрок);
					
				Если Не ПустаяСтрока(ИндексыСтрок) Тогда
					
					ПредыдущийМассив = Новый Массив;
					МассивНайденныхСтрок = СтрРазделить(ИндексыСтрок, ",");
					Пока МассивНайденныхСтрок.Количество() > 1 Цикл
						
						ПредыдущийМассив = МассивНайденныхСтрок;
						
						// Повышаем порог чувствительности
						СравнениеСтрокНаПодобие.ПроцентСовпаденияНебольшихСтрок = СравнениеСтрокНаПодобие.ПроцентСовпаденияНебольшихСтрок + 1;
						НовыйМассивВсехСтрок = Новый Массив;
						Для Каждого НайденнаяСтрока Из МассивНайденныхСтрок Цикл
							НовыйМассивВсехСтрок.Добавить(МассивВсехСтрок.Получить(НайденнаяСтрока));
						КонецЦикла;
						ИскомыеСтроки = СтрСоединить(НовыйМассивВсехСтрок, "~");
						
						ИндексыСтрок = НечеткийПоиск.StringSearch(НРег(СтрокаДляПоиска), НРег(ИскомыеСтроки), "~",
							СравнениеСтрокНаПодобие.ДлинаНебольшихСтрок,
							СравнениеСтрокНаПодобие.ПроцентСовпаденияСтрок,
							СравнениеСтрокНаПодобие.ПроцентСовпаденияНебольшихСтрок);
						
						МассивНайденныхСтрок = СтрРазделить(ИндексыСтрок, ",");
						МассивВсехСтрок = НовыйМассивВсехСтрок;
						
					КонецЦикла;
					Если МассивНайденныхСтрок.Количество() = 0 Тогда
						МассивНайденныхСтрок = ПредыдущийМассив;
					КонецЕсли;
					
					Для Каждого ИндексСтроки Из МассивНайденныхСтрок Цикл
						Если ПустаяСтрока(ИндексСтроки) Тогда
							Продолжить;
						КонецЕсли;
						
						Запрос = Новый Запрос;
						Запрос.УстановитьПараметр("ПолноеНаименование", МассивВсехСтрок.Получить(ИндексСтроки));
						
						Запрос.Текст =
						"ВЫБРАТЬ
						|	ПричиныПроисшествий.Ссылка КАК Ссылка
						|ИЗ
						|	Справочник.ПричиныПроисшествий КАК ПричиныПроисшествий
						|ГДЕ
						|	ПричиныПроисшествий.ПолноеНаименование ПОДОБНО &ПолноеНаименование";
						
						Выборка = Запрос.Выполнить().Выбрать();
						Если Выборка.Следующий() Тогда
							СтрокаПричиныПроисшествий.Причина = Выборка.Ссылка;
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполняемыеЗначения = Новый Структура;
	
	ЗаполняемыеЗначения.Вставить("Организация",									Объект.Организация);
	ЗаполняемыеЗначения.Вставить("Руководитель",								Неопределено);
	ЗаполняемыеЗначения.Вставить("ДолжностьРуководителя",						Неопределено);
	ЗаполняемыеЗначения.Вставить("ОснованиеПодписиРуководителя",				Неопределено);
	ЗаполняемыеЗначения.Вставить("ОтветственныйЗаОхрануТруда",					Неопределено);
	ЗаполняемыеЗначения.Вставить("ДолжностьОтветственногоЗаОхрануТруда",		Неопределено);
	ЗаполняемыеЗначения.Вставить("ОснованиеПодписиОтветственногоЗаОхрануТруда",	Неопределено);
	
	ЗарплатаКадры.ПолучитьЗначенияПоУмолчанию(ЗаполняемыеЗначения);
	
	Объект.Руководитель = ЗаполняемыеЗначения.Руководитель;
	Объект.ДолжностьРуководителя = ЗаполняемыеЗначения.ДолжностьРуководителя;
	Объект.ОснованиеПодписиРуководителя = ЗаполняемыеЗначения.ОснованиеПодписиРуководителя;
	Объект.ОтветственныйЗаОхрануТруда = ЗаполняемыеЗначения.ОтветственныйЗаОхрануТруда;
	Объект.ДолжностьОтветственногоЗаОхрануТруда = ЗаполняемыеЗначения.ДолжностьОтветственногоЗаОхрануТруда;
	Объект.ОснованиеПодписиОтветственногоЗаОхрануТруда = ЗаполняемыеЗначения.ОснованиеПодписиОтветственногоЗаОхрануТруда;
	
	Для каждого СтрокаПострадавшие Из Объект.Пострадавшие Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПострадавшие.СтажОбщийДатаОтсчета) И СтрокаПострадавшие.СтажОбщийРазмерМесяцев = 0
			И СтрокаПострадавшие.СтажОбщийРазмерДней = 0 Тогда
			СтрокаПострадавшие.СтажОбщийПредставление = НСтр("ru = 'Стаж не задан'");
		Иначе
			СведенияОСтаже = ЗарплатаКадрыРасширенныйКлиентСервер.СведенияОСтаже();
			СведенияОСтаже.ДатаОтсчета = СтрокаПострадавшие.СтажОбщийДатаОтсчета;
			СведенияОСтаже.Лет = Цел(СтрокаПострадавшие.СтажОбщийРазмерМесяцев / 12);
			СведенияОСтаже.Месяцев = СтрокаПострадавшие.СтажОбщийРазмерМесяцев - СведенияОСтаже.Лет * 12;
			СведенияОСтаже.Дней = СтрокаПострадавшие.СтажОбщийРазмерДней;
			
			ПродолжительностьСтажа = ЗарплатаКадрыРасширенныйКлиентСервер.ПродолжительностьСтажа(СведенияОСтаже, Объект.ДатаПроисшествия);
			
			Если ПродолжительностьСтажа.Лет + ПродолжительностьСтажа.Месяцев + ПродолжительностьСтажа.Дней = 0 Тогда
				СтрокаПострадавшие.СтажОбщийПредставление = НСтр("ru = 'Стаж не задан'");
			Иначе
				СтрокаПострадавшие.СтажОбщийПредставление = ЗарплатаКадрыРасширенныйКлиентСервер.ПредставлениеСтажа(
					ПродолжительностьСтажа.Лет, ПродолжительностьСтажа.Месяцев,ПродолжительностьСтажа.Дней);
			КонецЕсли;
		КонецЕсли;
		
		СтрокаПострадавшие.СтажВОрганизацииПредставление = ЗарплатаКадрыРасширенныйКлиентСервер.ПредставлениеСтажа(
			СтрокаПострадавшие.СтажРаботыНаПредприятииЛет, СтрокаПострадавшие.СтажРаботыНаПредприятииМесяцев, СтрокаПострадавшие.СтажРаботыНаПредприятииДней);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура ДобавитьПоказателиОхраныТруда(ТаблицаПоказателей) Экспорт
	
	ИсточникДанных = "РегистрСведений.НастройкиОхраныТруда";
	Раздел = НСтр("ru = 'Настройки организации'");
	Подраздел = НСтр("ru = 'Охрана труда'");
	
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"ИспользоватьРабочиеМестаОхраныТруда", НСтр("ru = 'Вести учет рабочих мест охраны труда'"),
		Раздел, Подраздел, "Ложь", 1, 6, 1, "Организация");
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"КонтролироватьУникальностьНомеровРабочихМест", НСтр("ru = 'Контролировать уникальность номеров рабочих мест'"),
		Раздел, Подраздел, "Ложь", 1, 6, 2, "Организация");
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"СпособКонтроляУникальностиНомеровРабочихМест", НСтр("ru = 'Способ контроля уникальности номеров рабочих мест'"),
		Раздел, Подраздел, "Неопределено", 1, 6, 3, "Организация");
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"ИспользоватьСпециальнуюОценкуУсловийТруда", НСтр("ru = 'Использовать специальную оценку условий труда'"),
		Раздел, Подраздел, "Ложь", 1, 6, 4, "Организация");
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"ИспользоватьНесчастныеСлучаиНаПроизводстве", НСтр("ru = 'Вести учет несчастных случаев на производстве'"),
		Раздел, Подраздел, "Ложь", 1, 6, 5, "Организация");
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"ИспользоватьИнструктажиПоОхранеТруда", НСтр("ru = 'Вести учет инструктажей'"),
		Раздел, Подраздел, "Ложь", 1, 6, 6, "Организация");
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"ИспользоватьМедицинскиеОсмотры", НСтр("ru = 'Вести учет медицинских осмотров'"),
		Раздел, Подраздел, "Ложь", 1, 6, 7, "Организация");
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"ИспользоватьПсихиатрическиеОсвидетельствования", НСтр("ru = 'Вести учет психиатрических освидетельствований'"),
		Раздел, Подраздел, "Ложь", 1, 6, 8, "Организация");
	Отчеты.НастройкиПрограммыЗарплатаКадры.ДобавитьПоказатель(ТаблицаПоказателей, ИсточникДанных,
		"ИспользоватьСредстваИндивидуальнойЗащиты", НСтр("ru = 'Вести учет средств индивидуальной защиты'"),
		Раздел, Подраздел, "Ложь", 1, 6, 9, "Организация");
	
КонецПроцедуры

#Область КадровыеДанныеСотрудников

Процедура ДобавитьТекстыЗапросовВТСведенийЗависящихОтФункциональныхОпцийОрганизаций(Запрос, ТолькоРазрешенные,
	ОписательВременнойТаблицыОтборов, ПоляОтбораПериодическихДанных, ФормироватьСПериодичностьДень, ИсточникиДанных) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.РабочиеМестаОхраныТруда") Тогда
		МодульРабочиеМестаОхраныТруда = ОбщегоНазначения.ОбщийМодуль("РабочиеМестаОхраныТруда");
		МодульРабочиеМестаОхраныТруда.ДобавитьТекстЗапросаВТСведенийОРабочихМестахСотрудников(Запрос, ТолькоРазрешенные,
			ОписательВременнойТаблицыОтборов, ПоляОтбораПериодическихДанных, ФормироватьСПериодичностьДень, ИсточникиДанных);
	КонецЕсли;
		
КонецПроцедуры

Функция ПутьКДаннымСведенийОРабочихМестахСотрудников(Знач ИмяПоля) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяПоляВВерхнемРегистре = ВРег(ИмяПоля);
	
	ПутьКДанным = "";
	
	Если ИмяПоляВВерхнемРегистре = ВРег("РабочееМестоОхраныТрудаПериодРегистрации") Тогда
		ПутьКДанным =
			"	ВЫБОР 
			|		КОГДА ФункциональныеОпции.ИспользоватьРабочиеМестаОхраныТрудаКорпоративная = ИСТИНА
			|			ТОГДА СведенияОРабочихМестахСотрудников.ПериодЗаписи
			|		ИНАЧЕ NULL
			|	КОНЕЦ";
	ИначеЕсли ИмяПоляВВерхнемРегистре = ВРег("РабочееМестоОхраныТрудаРегистратор") Тогда
		ПутьКДанным =
			"	ВЫБОР 
			|		КОГДА ФункциональныеОпции.ИспользоватьРабочиеМестаОхраныТрудаКорпоративная = ИСТИНА
			|			ТОГДА СведенияОРабочихМестахСотрудников.Регистратор
			|		ИНАЧЕ NULL
			|	КОНЕЦ";
	ИначеЕсли ИмяПоляВВерхнемРегистре = ВРег("РабочееМестоОхраныТруда") Тогда
		ПутьКДанным =
			"	ВЫБОР 
			|		КОГДА ФункциональныеОпции.ИспользоватьРабочиеМестаОхраныТрудаКорпоративная = ИСТИНА
			|			ТОГДА СведенияОРабочихМестахСотрудников.РабочееМесто
			|		ИНАЧЕ NULL
			|	КОНЕЦ";
	КонецЕсли;
	
	Возврат ПутьКДанным;
	
КонецФункции

Процедура ДобавитьВКоллекциюИменаКадровыхДанных(ИсточникиДанных) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы") Тогда
		Возврат;
	КонецЕсли;
	
	КадровыйУчет.ДобавитьВКоллекциюИмяКадровыхДанных(
		ИсточникиДанных, "БазовыеКадровыеДанныеСотрудников", "РабочееМестоОхраныТруда");
	КадровыйУчет.ДобавитьВКоллекциюИмяКадровыхДанных(
		ИсточникиДанных, "БазовыеКадровыеДанныеСотрудников", "РабочееМестоОхраныТрудаПериодРегистрации");
	КадровыйУчет.ДобавитьВКоллекциюИмяКадровыхДанных(
		ИсточникиДанных, "КадроваяИсторияСотрудников", "Организация");
	КадровыйУчет.ДобавитьВКоллекциюИмяКадровыхДанных(
		ИсточникиДанных, "ФункциональныеОпцииОрганизаций", "ИспользоватьРабочиеМестаОхраныТрудаКорпоративная");
	
КонецПроцедуры

#КонецОбласти

#Область ОрганизацияУчетнаяПолитика

Процедура ПриЗаписиДополнительныхДанныхФормыУчетнойПолитикиОрганизации(Форма, СтандартнаяОбработка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Если Константы.ИспользоватьНастройкиОхраныТрудаВРазрезеОрганизаций.Получить() Тогда
		ЗаписатьИспользованиеРабочихМестОхраныТрудаПоОрганизации(Форма.ОрганизацияСсылка);
		СтандартнаяОбработка = Ложь;
	Иначе
		Для Каждого Организация Из ОрганизационнаяСтруктура.ВсеОрганизацииБезУправленческой(, Ложь) Цикл
			ЗаписатьИспользованиеРабочихМестОхраныТрудаПоОрганизации(Организация);
		КонецЦикла;
		Константы.ПрименятьУсловияТрудаРабочихМестОхраныТруда.Установить(Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Функция СведенияОНастройкахОхраныТруда(Организация = Неопределено) Экспорт
	Возврат РегистрыСведений.НастройкиОхраныТруда.СведенияОНастройкахОхраныТруда(Организация);
КонецФункции

Функция ФункциональнаяОпцияОрганизацийИспользуется(Организация, ИмяФункциональнойОпции) Экспорт
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат ПолучитьФункциональнуюОпцию(ИмяФункциональнойОпции);
	КонецЕсли;
	
	ТипЗначенияОрганизации = ТипЗнч(Организация);
	Если ТипЗначенияОрганизации = Тип("СписокЗначений") Тогда
		ПроверяемыеОрганизации = Организация.ВыгрузитьЗначения();
	ИначеЕсли ТипЗначенияОрганизации = Тип("Массив") Тогда
		ПроверяемыеОрганизации = Организация;
	Иначе
		ПроверяемыеОрганизации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
	КонецЕсли;
	
	Для Каждого ПроверяемаяОрганизация Из ПроверяемыеОрганизации Цикл
		Если ПолучитьФункциональнуюОпцию(ИмяФункциональнойОпции, ПараметрыФункциональныхОпций(ПроверяемаяОрганизация)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТребуетсяРегистрацияИзмененийКадровойИстории(Источник, Замещение) Экспорт
	
	ОбрабатываемыеТипы = Новый Массив;
	ОбрабатываемыеТипы.Добавить(Тип("ДокументСсылка.Увольнение"));
	ОбрабатываемыеТипы.Добавить(Тип("ДокументСсылка.УвольнениеСписком"));
	ОбрабатываемыеТипы.Добавить(Тип("ДокументСсылка.ПрекращениеПодработки"));
	
	Регистраторы = РегистрыБЗК.ЗначенияОтбораЗаписейНабора(Источник, Замещение, "Регистратор");
	Для Каждого Регистратор Из Регистраторы Цикл
		Если ОбрабатываемыеТипы.Найти(ТипЗнч(Регистратор)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПоставляемыеПрофилиГруппДоступа

Функция ОписаниеПрофиляСпециалистПоОхранеТруда()

	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Идентификатор = ИдентификаторПрофиляСпециалистПоОхранеТруда();
	ОписаниеПрофиля.Наименование  = НСтр("ru = 'Специалист по охране труда'");
	
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляОбязательныеРоли(ОписаниеПрофиля);
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ПодсистемаОхранаТруда");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ВыводНаПринтерФайлБуферОбмена");
	
	// СотрудникиОхранаТруда
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ПросмотрОхраныТрудаСотрудников");
	
	// Рабочие места
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеРабочихМестСотрудников");
	
	// Спецоценка
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ДобавлениеИзменениеСпециальнойОценкиУсловийТруда");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеСпециальнойОценкиУсловийТруда");
	
	// Несчастные случаи
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ДобавлениеИзменениеНесчастныхСлучаев");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеНесчастныхСлучаев");
	
	// Обучение по охране труда
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ДобавлениеИзменениеОбученияСотрудниковОхранеТруда");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ДобавлениеИзменениеПроверокЗнанияТребованийОхраныТруда");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ИспользованиеОбработкиОбучениеПоОхранеТруда");
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ЧтениеРезультатовОбученияПоОхранеТруда");
	
	// Инструктажи
	ЗарплатаКадрыРасширенный.ДобавитьВОписаниеПрофиляРоль(ОписаниеПрофиля, "ДобавлениеИзменениеИнструктажейПоОхранеТруда");
