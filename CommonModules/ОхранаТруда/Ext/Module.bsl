#Область СпециальнаяОценкаУсловийТруда

// Возвращает сведения специальной оценки условий труда по рабочим местам
//
// Параметры:
//		РабочиеМеста - Массив Из СправочникСсылка.РабочиеМестаОхраныТруда - рабочих мест, по которым требуется вернуть сведения о спецоценке
//		ДатаСведений - Дата - на которую требуется получить сведения о спецоценке.
//
// Возвращаемое значение:
//  Соответствие Из Структура:
//		Ключ - Ссылка на рабочее место
//		Значение - Структура
//			СведенияСОУТ - Строка - Сведения спецоценки по рабочему месту
//			СведенияОПСОУТ - Строка - Сведения об организации, проводившей спецоценку рабочего места.
Функция СведенияСпецоценкиУсловийТрудаПоРабочимМестам(РабочиеМеста, ДатаСведений)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочиеМеста", РабочиеМеста);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РезультатыСпециальнойОценкиУсловийТруда.Период КАК ДатаСОУТ,
	|	РезультатыСпециальнойОценкиУсловийТруда.РабочееМесто КАК РабочееМесто,
	|	РезультатыСпециальнойОценкиУсловийТруда.КлассУсловийТруда КАК КлассУсловийТруда,
	|	РезультатыСпециальнойОценкиУсловийТруда.РабочееМесто.Номер КАК НомерРабочегоМеста,
	|	ЕСТЬNULL(Контрагенты.ИНН, """") КАК ИННОПСОУТ,
	|	ЕСТЬNULL(Контрагенты.НаименованиеПолное, """") КАК НаименованиеОПСОУТ
	|ПОМЕСТИТЬ ВТРабочиеМеста
	|ИЗ
	|	РегистрСведений.РезультатыСпециальнойОценкиУсловийТруда.СрезПоследних(&ДатаСведений, РабочееМесто В (&РабочиеМеста)) КАК РезультатыСпециальнойОценкиУсловийТруда
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РезультатыСпецоценкиУсловийТруда КАК РезультатыСпецоценкиУсловийТруда
	|		ПО РезультатыСпециальнойОценкиУсловийТруда.Регистратор = РезультатыСпецоценкиУсловийТруда.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО (РезультатыСпецоценкиУсловийТруда.Исполнитель = Контрагенты.Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	NULL КАК ДатаСОУТ,
	|	РабочиеМестаОхраныТруда.Ссылка КАК РабочееМесто,
	|	"""" КАК КлассУсловийТруда,
	|	"""" КАК НомерРабочегоМеста,
	|	"""" КАК ИННОПСОУТ,
	|	"""" КАК НаименованиеОПСОУТ
	|ИЗ
	|	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
	|ГДЕ
	|	РабочиеМестаОхраныТруда.Ссылка В(&РабочиеМеста)
	|	И НЕ РабочиеМестаОхраныТруда.Ссылка В
	|				(ВЫБРАТЬ
	|					РабочиеМеста.РабочееМесто
	|				ИЗ
	|					ВТРабочиеМеста КАК РабочиеМеста)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РабочиеМеста.ДатаСОУТ,
	|	РабочиеМеста.РабочееМесто,
	|	РабочиеМеста.КлассУсловийТруда,
	|	РабочиеМеста.НомерРабочегоМеста,
	|	РабочиеМеста.ИННОПСОУТ,
	|	РабочиеМеста.НаименованиеОПСОУТ
	|ИЗ
	|	ВТРабочиеМеста КАК РабочиеМеста";
	
	СведенияСпецоценкиУсловийТруда = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СведенияСОУТ = Новый Структура;
		Если ЗначениеЗаполнено(Выборка.КлассУсловийТруда) Тогда
			СведенияСОУТ.Вставить("СведенияСОУТ",
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Специальная оценка условий труда проведена %1 Индивидуальный номер рабочего места %2. Класс условий труда - %3'"),
					Формат(Выборка.ДатаСОУТ, "ДЛФ=ДД"),
					?(ПустаяСтрока(Выборка.НомерРабочегоМеста), НСтр("ru = 'не указан'"), Выборка.НомерРабочегоМеста),
					ПредставлениеКлассаУсловийТруда(Выборка.КлассУсловийТруда)));
			СведенияСОУТ.Вставить("СведенияОПСОУТ",
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1, ИНН %2'"),
					Выборка.НаименованиеОПСОУТ,
					Выборка.ИННОПСОУТ));
		Иначе
			СведенияСОУТ.Вставить("СведенияСОУТ", НСтр("ru = 'Не проводилась'"));
			СведенияСОУТ.Вставить("СведенияОПСОУТ", "");
		КонецЕсли;
		СведенияСпецоценкиУсловийТруда.Вставить(Выборка.РабочееМесто, СведенияСОУТ);
	КонецЦикла;
	
	Возврат СведенияСпецоценкиУсловийТруда;
	
КонецФункции

Процедура ОбновитьВредныеФакторыРабочихМестОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	РабочиеМеста = Неопределено;
	Если Источник.ДополнительныеСвойства.Свойство("ПрежниеРабочиеМеста") Тогда
		РабочиеМеста = Источник.ДополнительныеСвойства["ПрежниеРабочиеМеста"];
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ОхранаТруда.МедицинскиеОсмотры") Тогда
		МодульМедицинскиеОсмотры = ОбщегоНазначения.ОбщийМодуль("МедицинскиеОсмотры");
		МодульМедицинскиеОсмотры.ОбновитьВредныеФакторыРабочихМест(Источник.Ссылка, РабочиеМеста);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьВредныеФакторыРабочихМестОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	РабочиеМеста = Источник.РабочиеМеста.ВыгрузитьКолонку("РабочееМесто");
	АналогичныеМеста = Источник.АналогичныеМеста.ВыгрузитьКолонку("АналогичноеМесто");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РабочиеМеста, АналогичныеМеста, Истина);

	Если Источник.ДополнительныеСвойства.Свойство("ПрежниеРабочиеМеста") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РабочиеМеста, Источник.ДополнительныеСвойства["ПрежниеРабочиеМеста"], Истина);
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ОхранаТруда.МедицинскиеОсмотры") Тогда
		МодульМедицинскиеОсмотры = ОбщегоНазначения.ОбщийМодуль("МедицинскиеОсмотры");
		МодульМедицинскиеОсмотры.ОбновитьВредныеФакторыРабочихМест(, РабочиеМеста);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьАналогичныеРабочиеМестаОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьАналогичныеРабочиеМеста(Источник, Источник.Ссылка);
	
КонецПроцедуры

Процедура ОбновитьАналогичныеРабочиеМестаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьАналогичныеРабочиеМеста(Источник);
	
КонецПроцедуры

Процедура ОбновитьАналогичныеРабочиеМеста(Источник, ИсточникСсылка = Неопределено)
	ОбновитьАналогичныеРабочиеМестаПоРабочимМестам(РабочиеМестаДляОбновленияНаименований(Источник), ИсточникСсылка);
КонецПроцедуры

Процедура ОбновитьАналогичныеРабочиеМестаПоРабочимМестам(РабочиеМестаОтбора, ИсточникСсылка = Неопределено)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	// Исключим документ при отмене проведения
	Запрос.УстановитьПараметр("Ссылка", ИсточникСсылка);
	Запрос.УстановитьПараметр("РабочиеМестаОтбора", РабочиеМестаОтбора);
	Запрос.УстановитьПараметр("ОтбиратьПоРабочимМестам", Истина);

	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаАктуальныхРабочихМестСпецоценки());
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	ВсеРабочиеМеста.РабочееМесто КАК АналогичноеРабочееМесто,
		|	ВсеРабочиеМеста.ОсновноеРабочееМесто КАК РабочееМесто,
		|	ВсеРабочиеМеста.Организация КАК Организация
		|ИЗ
		|	ВТМаксимальныеРабочиеМеста КАК МаксимальныеРабочиеМеста
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВсеРабочиеМеста КАК ВсеРабочиеМеста
		|		ПО МаксимальныеРабочиеМеста.РабочееМесто = ВсеРабочиеМеста.РабочееМесто
		|			И МаксимальныеРабочиеМеста.Документ = ВсеРабочиеМеста.Документ
		|ГДЕ
		|	ВсеРабочиеМеста.ОсновноеРабочееМесто <> НЕОПРЕДЕЛЕНО");
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаНовогоНабора = РезультатЗапроса.Выгрузить();

	ЗаписатьАналогичныеРабочиеМеста(ТаблицаНовогоНабора, РабочиеМестаОтбора);

КонецПроцедуры

Процедура ЗаписатьАналогичныеРабочиеМеста(ТаблицаНовогоНабора, РабочиеМестаДляОбновленияНаименований)

	ПрежнийНабор = АналогичныеРабочиеМестаИзРегистраПоРабочимМестам(РабочиеМестаДляОбновленияНаименований);
	ТаблицаНовогоНабораДляСравнения = АналогичныеРабочиеМестаИзТаблицыПоРабочимМестам(ТаблицаНовогоНабора, РабочиеМестаДляОбновленияНаименований);

	Для Каждого РабочееМесто Из РабочиеМестаДляОбновленияНаименований Цикл
		Отбор = Новый Структура("АналогичноеРабочееМесто", РабочееМесто);
		ПрежнийНаборРабочегоМеста = ПрежнийНабор.Скопировать(Отбор);
		НовыйНаборРабочегоМеста = ТаблицаНовогоНабора.Скопировать(Отбор);

		Если ОбщегоНазначения.КоллекцииИдентичны(
			ПрежнийНаборРабочегоМеста,
			НовыйНаборРабочегоМеста,
			"АналогичноеРабочееМесто,РабочееМесто,Организация") Тогда
			Продолжить;
		КонецЕсли;

		НаборЗаписей = РегистрыСведений.АналогичныеРабочиеМестаСпециальнойОценкиУсловийТруда.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.АналогичноеРабочееМесто.Установить(РабочееМесто);
		НаборЗаписей.Загрузить(НовыйНаборРабочегоМеста);

		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЦикла;

	Если Не ОбщегоНазначения.КоллекцииИдентичны(
		ПрежнийНабор,
		ТаблицаНовогоНабораДляСравнения,
		"АналогичноеРабочееМесто,РабочееМесто,Организация") Тогда

		УстановитьПривилегированныйРежим(Истина);
		ИзменитьНаименованияРабочихМест(РабочиеМестаДляОбновленияНаименований, ТаблицаНовогоНабораДляСравнения);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

Процедура ИзменитьНаименованияРабочихМест(РабочиеМеста, ТаблицаАналогичныхМест)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТАналогичныеРабочиеМеста.АналогичноеРабочееМесто КАК АналогичноеРабочееМесто,
		|	ВТАналогичныеРабочиеМеста.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТАналогичныеРабочиеМеста
		|ИЗ
		|	&АналогичныеРабочиеМеста КАК ВТАналогичныеРабочиеМеста
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеМестаОхраныТруда.Ссылка КАК Ссылка,
		|	РабочиеМестаОхраныТруда.Наименование КАК Наименование,
		|	РабочиеМестаОхраныТруда.Подразделение КАК Подразделение,
		|	РабочиеМестаОхраныТруда.Должность КАК Должность,
		|	РабочиеМестаОхраныТруда.Номер КАК Номер
		|ПОМЕСТИТЬ ВТРабочиеМеста
		|ИЗ
		|	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
		|ГДЕ
		|	РабочиеМестаОхраныТруда.Ссылка В(&РабочиеМеста)
		|	И НЕ РабочиеМестаОхраныТруда.НомерВручную
		|	И НЕ РабочиеМестаОхраныТруда.ЭтоГруппа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТРабочиеМеста.Ссылка КАК Ссылка,
		|	ВТРабочиеМеста.Наименование КАК Наименование,
		|	ВТРабочиеМеста.Подразделение КАК Подразделение,
		|	ВТРабочиеМеста.Должность КАК Должность,
		|	ВТРабочиеМеста.Номер КАК Номер,
		|	ЕСТЬNULL(ВТАналогичныеРабочиеМеста.РабочееМесто.Номер, """") КАК НомерОсновногоРабочегоМеста
		|ИЗ
		|	ВТРабочиеМеста КАК ВТРабочиеМеста
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТАналогичныеРабочиеМеста КАК ВТАналогичныеРабочиеМеста
		|		ПО ВТРабочиеМеста.Ссылка = ВТАналогичныеРабочиеМеста.АналогичноеРабочееМесто";
	
	Запрос.УстановитьПараметр("АналогичныеРабочиеМеста", ТаблицаАналогичныхМест);
	Запрос.УстановитьПараметр("РабочиеМеста", РабочиеМеста);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ДанныеНаименования = РезультатЗапроса.Выбрать();
	
	Пока ДанныеНаименования.Следующий() Цикл
		НовоеНаименование = РабочиеМестаОхраныТруда.НаименованиеРабочегоМеста(
			ДанныеНаименования.Подразделение,
			ДанныеНаименования.Должность,
			ДанныеНаименования.Номер,
			ДанныеНаименования.НомерОсновногоРабочегоМеста);
	
		Если ДанныеНаименования.Наименование = НовоеНаименование Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЗаблокироватьДанныеДляРедактирования(ДанныеНаименования.Ссылка);
		Исключение
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Не удалось изменить наименование рабочего места ""%1"":
				|%2'"),
				ДанныеНаименования.Наименование,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			Продолжить;
		КонецПопытки;
		
		РабочееМестоОбъект = ДанныеНаименования.Ссылка.ПолучитьОбъект();
		РабочееМестоОбъект.Наименование = НовоеНаименование;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(РабочееМестоОбъект);
		РазблокироватьДанныеДляРедактирования(ДанныеНаименования.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Функция РабочиеМестаДляОбновленияНаименований(Источник)

	РабочиеМеста = Источник.РабочиеМеста.ВыгрузитьКолонку("РабочееМесто");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		РабочиеМеста, Источник.АналогичныеМеста.ВыгрузитьКолонку("АналогичноеМесто"), Истина);

	Если Источник.ДополнительныеСвойства.Свойство("ПрежниеРабочиеМеста") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			РабочиеМеста, Источник.ДополнительныеСвойства["ПрежниеРабочиеМеста"], Истина);
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого РабочееМесто Из ОбщегоНазначенияКлиентСервер.СвернутьМассив(РабочиеМеста) Цикл
		Если ЗначениеЗаполнено(РабочееМесто) Тогда
			Результат.Добавить(РабочееМесто);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрежниеРабочиеМестаДокументаСпецоценки(ДокументОбъект)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);

	// АПК:96 -выкл результат должен содержать уникальные значения
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РабочиеМеста.РабочееМесто КАК РабочееМесто
	|ИЗ
	|	Документ.РезультатыСпецоценкиУсловийТруда.РабочиеМеста КАК РабочиеМеста
	|ГДЕ
	|	РабочиеМеста.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	АналогичныеМеста.АналогичноеМесто КАК РабочееМесто
	|ИЗ
	|	Документ.РезультатыСпецоценкиУсловийТруда.АналогичныеМеста КАК АналогичныеМеста
	|ГДЕ
	|	АналогичныеМеста.Ссылка = &Ссылка";
	// АПК:96 -вкл

	ИмяДокумента = ДокументОбъект.Метаданные().Имя;
	Если ИмяДокумента <> "РезультатыСпецоценкиУсловийТруда" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РезультатыСпецоценкиУсловийТруда", ИмяДокумента);
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРабочихМест = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаРабочихМест.ВыгрузитьКолонку("РабочееМесто");

КонецФункции

Функция АналогичныеРабочиеМестаИзРегистраПоРабочимМестам(РабочиеМеста)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочиеМеста", РабочиеМеста);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	АналогичныеРабочиеМеста.АналогичноеРабочееМесто КАК АналогичноеРабочееМесто,
	|	АналогичныеРабочиеМеста.РабочееМесто КАК РабочееМесто,
	|	АналогичныеРабочиеМеста.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.АналогичныеРабочиеМестаСпециальнойОценкиУсловийТруда КАК АналогичныеРабочиеМеста
	|ГДЕ
	|	АналогичныеРабочиеМеста.РабочееМесто В(&РабочиеМеста)
	|	ИЛИ АналогичныеРабочиеМеста.АналогичноеРабочееМесто В(&РабочиеМеста)";

	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

Функция АналогичныеРабочиеМестаИзТаблицыПоРабочимМестам(ТаблицаАналогичныхМест, РабочиеМеста)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("АналогичныеРабочиеМеста", ТаблицаАналогичныхМест);
	Запрос.УстановитьПараметр("РабочиеМеста", РабочиеМеста);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АналогичныеРабочиеМеста.АналогичноеРабочееМесто КАК АналогичноеРабочееМесто,
		|	АналогичныеРабочиеМеста.РабочееМесто КАК РабочееМесто,
		|	АналогичныеРабочиеМеста.Организация КАК Организация
		|ПОМЕСТИТЬ ВТАналогичныеРабочиеМеста
		|ИЗ
		|	&АналогичныеРабочиеМеста КАК АналогичныеРабочиеМеста
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	АналогичноеРабочееМесто,
		|	РабочееМесто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АналогичныеРабочиеМеста.АналогичноеРабочееМесто КАК АналогичноеРабочееМесто,
		|	АналогичныеРабочиеМеста.РабочееМесто КАК РабочееМесто,
		|	АналогичныеРабочиеМеста.Организация КАК Организация
		|ИЗ
		|	ВТАналогичныеРабочиеМеста КАК АналогичныеРабочиеМеста
		|ГДЕ
		|	АналогичныеРабочиеМеста.РабочееМесто В(&РабочиеМеста)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АналогичныеРабочиеМеста.АналогичноеРабочееМесто,
		|	АналогичныеРабочиеМеста.РабочееМесто,
		|	АналогичныеРабочиеМеста.Организация
		|ИЗ
		|	ВТАналогичныеРабочиеМеста КАК АналогичныеРабочиеМеста
		|ГДЕ
		|	АналогичныеРабочиеМеста.АналогичноеРабочееМесто В(&РабочиеМеста)
		|	И НЕ АналогичныеРабочиеМеста.РабочееМесто В(&РабочиеМеста)";

	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();

