	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	РегламентированныеОтчеты = Справочники.РегламентированныеОтчеты;
	ОтчетФорма1Туст = РегламентированныеОтчеты.НайтиПоРеквизиту("ИсточникОтчета", "РегламентированныйОтчетСтатистикаФорма1Туст");
	Если ОтчетФорма1Туст = РегламентированныеОтчеты.ПустаяСсылка() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	ОписаниеБлокировки = ОбновлениеИБ.ОписаниеБлокируемыхДанных(Метаданные.РегистрыСведений.СкрытыеРегламентированныеОтчеты, "РегламентированныйОтчет");
	ОписаниеБлокировки.ПоляБлокировки.РегламентированныйОтчет = ОтчетФорма1Туст;
	Если Не ОбновлениеИБ.НачатьОбновлениеДанных(ОписаниеБлокировки, ПараметрыОбновления) Тогда
		Возврат;
	КонецЕсли;
	
	СкрытыеРегламентированныеОтчеты = РегистрыСведений.СкрытыеРегламентированныеОтчеты.Выбрать(Новый Структура("РегламентированныйОтчет", ОтчетФорма1Туст));
	
	Если СкрытыеРегламентированныеОтчеты.Следующий() Тогда
		СкрытыеРегламентированныеОтчеты.ПолучитьМенеджерЗаписи().Удалить();
	Иначе
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
	КонецЕсли;	
	
	ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	
КонецПроцедуры

