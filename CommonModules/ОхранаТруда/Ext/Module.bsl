		Списки.Вставить(Метаданные.РегистрыНакопления.ВыданныеСИЗ, Истина);
		Списки.Вставить(Метаданные.РегистрыНакопления.СформированныеЗаказыНаВыдачуСИЗ, Истина);
		Списки.Вставить(Метаданные.РегистрыСведений.АктуальныеЗаказыНаВыдачуСИЗ, Истина);
