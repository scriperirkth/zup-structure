Процедура ОбработатьДокументыСпецоценки(ВыборкаРегистратор, ТаблицаСвязейРабочихМестСПозициями)
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		ЕстьСотрудники = Ложь;
		ЕстьТолькоРабочиеМеста = Ложь;
		ИмяТЧ = "РабочиеМеста";
		ИмяПоляПоиска = "УдалитьРабочееМесто";
		
		ДокументСсылка = ВыборкаРегистратор.Ссылка;
		ТипДокумента = ТипЗнч(ДокументСсылка);
		Если ТипДокумента = Тип("ДокументСсылка.ДекларацияСоответствияУсловийТруда") Тогда
			ЕстьТолькоРабочиеМеста = Истина;
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НесчастныйСлучайНаПроизводстве") Тогда
			ЕстьТолькоРабочиеМеста = Истина;
			ИмяТЧ = "Пострадавшие";
			ИмяПоляПоиска = "УдалитьДолжностьПоШтатномуРасписанию";
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПодготовкаСпецоценкиУсловийТруда") Тогда
			ЕстьСотрудники = Истина;
		КонецЕсли;
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ДокументСсылка.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСсылка);
		Блокировка.Заблокировать();
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ЗаблокироватьДанныеДляРедактирования(ДокументСсылка);
		
		ВыборкаРабочиеМеста = ВыборкаРегистратор.Выбрать();
		Пока ВыборкаРабочиеМеста.Следующий() Цикл
			СтруктураПоиска = Новый Структура(ИмяПоляПоиска + ", НомерСтроки");
			СтруктураПоиска[ИмяПоляПоиска] = ВыборкаРабочиеМеста.УдалитьРабочееМесто;
			СтруктураПоиска.НомерСтроки = ВыборкаРабочиеМеста.НомерСтроки;
			
			СтрокиТЧ = ДокументОбъект[ИмяТЧ].НайтиСтроки(СтруктураПоиска);
			
			Если СтрокиТЧ.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТЧ = СтрокиТЧ[0];
			СтрокаТЧ.РабочееМесто = ВыборкаРабочиеМеста.РабочееМесто;
			
			Если ЕстьТолькоРабочиеМеста Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТЧ.ИдентификаторСтрокиРабочегоМеста = ВыборкаРабочиеМеста.НомерСтроки;
			СтрокаТЧ.Должность = ВыборкаРабочиеМеста.Должность;
			СтрокаТЧ.Подразделение = ВыборкаРабочиеМеста.Подразделение;
			
			СтруктураПоиска.Удалить("НомерСтроки");
			
			Если ЕстьСотрудники И ДокументОбъект.Сотрудники.Количество() > 0 Тогда
				СтрокиТЧСотрудники = ДокументОбъект.Сотрудники.НайтиСтроки(СтруктураПоиска);
				Для Каждого СтрокаСотрудника Из СтрокиТЧСотрудники Цикл
					СтрокаСотрудника.РабочееМесто = ВыборкаРабочиеМеста.РабочееМесто;
					СтрокаСотрудника.ИдентификаторСтрокиРабочегоМеста = ВыборкаРабочиеМеста.НомерСтроки;
				КонецЦикла;
			КонецЕсли;
			
			Если ДокументОбъект.АналогичныеМеста.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			МассивАналогичных = Новый Массив;
			МассивАналогичных.Добавить(СтрокаТЧ.РабочееМесто);
			
			СтрокиТЧАналогичные = ДокументОбъект.АналогичныеМеста.НайтиСтроки(СтруктураПоиска);
			Для Каждого СтрокаАналогичные Из СтрокиТЧАналогичные Цикл
				СтруктураПоискаАналога = Новый Структура("Позиция", СтрокаАналогичные.УдалитьАналогичноеМесто);
				СвязиАналогичных = ТаблицаСвязейРабочихМестСПозициями.НайтиСтроки(СтруктураПоискаАналога);
				Если СвязиАналогичных.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого АналогичноеМесто Из СвязиАналогичных Цикл
					Если МассивАналогичных.Найти(АналогичноеМесто.РабочееМесто) = Неопределено Тогда
						МассивАналогичных.Добавить(АналогичноеМесто.РабочееМесто);
						СтрокаАналогичные.АналогичноеМесто = АналогичноеМесто.РабочееМесто;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				СтрокаАналогичные.ИдентификаторСтрокиРабочегоМеста = ВыборкаРабочиеМеста.НомерСтроки;
			КонецЦикла;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаЗагрузкаДанных

// Заполняет массив типов неразделенных данных, для которых поддерживается сопоставление ссылок
// при загрузке данных в другую информационную базу.
//
// Параметры:
//  Типы - Массив(ОбъектМетаданных).
//
Процедура ПриЗаполненииТиповОбщихДанныхПоддерживающихСопоставлениеСсылокПриЗагрузке(Типы) Экспорт
	
	// Здесь перечисляются неразделенные объекты метаданных ссылочного типа, имеющие непредопределенные элементы.
	// В модуле менеджера таких объектов должна быть определена функция ПоляЕстественногоКлюча, 
	// составляющая массив полей для однозначной идентификации элемента.
	
	Типы.Добавить(Метаданные.Справочники.ВидыПроисшествий);
	Типы.Добавить(Метаданные.Справочники.ПричиныПроисшествий);
	
КонецПроцедуры

#КонецОбласти

Функция УсловиеСоединенияСНастройкамиОхраныТруда(Параметры)
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЭтоИнструктажи", Ложь) Тогда
		Возврат "НастройкиОхраныТруда.ИспользоватьИнструктажиПоОхранеТруда";
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЭтоОбучениеПоОхранеТруда", Ложь) Тогда
		Возврат "НастройкиОхраныТруда.ИспользоватьОбучениеПоОхранеТруда";
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЭтоМедосмотры", Ложь) Тогда
		Возврат "НастройкиОхраныТруда.ИспользоватьМедицинскиеОсмотры";
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЭтоНесчастныеСлучаи", Ложь) Тогда
		Возврат "НастройкиОхраныТруда.ИспользоватьНесчастныеСлучаиНаПроизводстве";
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЭтоСОУТ", Ложь) Тогда
		Возврат "НастройкиОхраныТруда.ИспользоватьСпециальнуюОценкуУсловийТруда";
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЭтоСИЗ", Ложь) Тогда
		Возврат "НастройкиОхраныТруда.ИспользоватьСредстваИндивидуальнойЗащиты";
	Иначе
		Возврат "ИСТИНА";
	КонецЕсли;
	
КонецФункции

Функция ПараметрыФункциональныхОпций(Организация)
	
	ПараметрыФО = Новый Структура;
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыФО.Вставить("Организация", Организация);
	КонецЕсли;
	
	Возврат ПараметрыФО;
	
КонецФункции

Процедура ЗаполнитьНастройкиОхраныТрудаНовойОрганизацииПриЗаписи(Источник, Отказ) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.НастройкиОхраныТруда.СоздатьНаборЗаписей();
	НаборЗаписей.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения");
	НаборЗаписей.Отбор.Организация.Установить(Источник.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Организация = Источник.Ссылка;
		Если Не Константы.ИспользоватьНастройкиОхраныТрудаВРазрезеОрганизаций.Получить() Тогда
			НоваяЗапись.ИспользоватьРабочиеМестаОхраныТруда = Константы.ИспользоватьРабочиеМестаОхраныТруда.Получить();
			НоваяЗапись.ИспользоватьИнструктажиПоОхранеТруда = Константы.ИспользоватьИнструктажиПоОхранеТруда.Получить();
			НоваяЗапись.ИспользоватьМедицинскиеОсмотры = Константы.ИспользоватьМедицинскиеОсмотры.Получить();
			НоваяЗапись.ИспользоватьСредстваИндивидуальнойЗащиты = Константы.ИспользоватьСредстваИндивидуальнойЗащиты.Получить();
			НоваяЗапись.ИспользоватьПсихиатрическиеОсвидетельствования = Константы.ИспользоватьПсихиатрическиеОсвидетельствования.Получить();
			НоваяЗапись.КонтролироватьУникальностьНомеровРабочихМест = Константы.КонтролироватьУникальностьНомеровРабочихМест.Получить();
			НоваяЗапись.СпособКонтроляУникальностиНомеровРабочихМест = Константы.СпособКонтроляУникальностиНомеровРабочихМест.Получить();
			
			Настройки = РегистрыСведений.НастройкиСпециальнойОценкиУсловийТруда.СоздатьМенеджерЗаписи();
			Настройки.Прочитать();
			НоваяЗапись.ИспользоватьСпециальнуюОценкуУсловийТруда = Настройки.ИспользоватьСпециальнуюОценкуУсловийТруда;
			
			Настройки = РегистрыСведений.НастройкиНесчастныхСлучаевНаПроизводстве.СоздатьМенеджерЗаписи();
			Настройки.Прочитать();
			НоваяЗапись.ИспользоватьНесчастныеСлучаиНаПроизводстве = Настройки.ИспользоватьНесчастныеСлучаиНаПроизводстве;
		КонецЕсли;
		НаборЗаписей.Записать();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаписатьИспользованиеРабочихМестОхраныТрудаПоОрганизации(Организация)
	
	Настройки = РегистрыСведений.НастройкиОхраныТруда.СоздатьМенеджерЗаписи();
	Настройки.Организация = Организация;
	Настройки.Прочитать();
	
	Если Не Настройки.Выбран() Тогда
		Настройки.Организация = Организация;
	КонецЕсли;
	
	Настройки.ИспользоватьРабочиеМестаОхраныТруда = Истина;
	Настройки.ПрименятьУсловияТрудаРабочихМестОхраныТруда = Истина;
	Настройки.Записать();

КонецПроцедуры

Процедура ЗаписатьОбщиеНастройкиОхраныТруда(Параметры, ПараметрыНастроек) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыНастроек.ИспользоватьРабочиеМестаОхраныТруда Тогда
		Константы.ИспользоватьРабочиеМестаОхраныТруда.Установить(Параметры.ИспользоватьРабочиеМестаОхраныТруда);
	КонецЕсли;
	
	Если ПараметрыНастроек.ПрименятьУсловияТрудаРабочихМестОхраныТруда Тогда
		Константы.ПрименятьУсловияТрудаРабочихМестОхраныТруда.Установить(Параметры.ПрименятьУсловияТрудаРабочихМестОхраныТруда);
	КонецЕсли;
	
