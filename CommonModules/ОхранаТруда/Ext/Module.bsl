	НовыеРоли.Добавить(Метаданные.Роли.ПросмотрОхраныТрудаСотрудников.Имя);
	ЗаменяемыеРоли.Вставить("ЧтениеРабочихМестСотрудников", НовыеРоли);
	
	НовыеРоли = Новый Массив;
	НовыеРоли.Добавить(Метаданные.Роли.ДобавлениеИзменениеРабочихМестСотрудников.Имя);
	НовыеРоли.Добавить(Метаданные.Роли.ПросмотрОхраныТрудаСотрудников.Имя);
	ЗаменяемыеРоли.Вставить("ДобавлениеИзменениеРабочихМестСотрудников", НовыеРоли);
	
	УправлениеДоступом.ЗаменитьРолиВПрофилях(ЗаменяемыеРоли);
	
