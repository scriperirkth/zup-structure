	Поля = Новый Массив; // Массив из Строка
	Поля.Добавить(ТабличнаяЧастьОчевидцы.КонтактныйТелефон.ПолноеИмя());
	Поля.Добавить(ТабличнаяЧастьОчевидцы.КонтактныйТелефонПредставление.ПолноеИмя());
