Функция ТекстЗапросаНекорректныхАналоговРабочихМестСОУТ()

	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаАктуальныхРабочихМестСпецоценки());
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВсеРабочиеМеста.РабочееМесто КАК АналогичноеРабочееМесто,
		|	ВсеРабочиеМеста.ОсновноеРабочееМесто КАК РабочееМесто,
		|	ВсеРабочиеМеста.Организация КАК Организация
		|ПОМЕСТИТЬ ВТНовыеАналогичныеРабочиеМеста
		|ИЗ
		|	ВТМаксимальныеРабочиеМеста КАК МаксимальныеРабочиеМеста
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВсеРабочиеМеста КАК ВсеРабочиеМеста
		|		ПО МаксимальныеРабочиеМеста.РабочееМесто = ВсеРабочиеМеста.РабочееМесто
		|			И МаксимальныеРабочиеМеста.Документ = ВсеРабочиеМеста.Документ
		|ГДЕ
		|	ВсеРабочиеМеста.ОсновноеРабочееМесто <> НЕОПРЕДЕЛЕНО
		|	И ВсеРабочиеМеста.РабочееМесто <> ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка)
		|	И ВсеРабочиеМеста.ОсновноеРабочееМесто <> ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	АналогичноеРабочееМесто,
		|	РабочееМесто,
		|	Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АналогичныеРабочиеМестаСпециальнойОценкиУсловийТруда.АналогичноеРабочееМесто КАК АналогичноеРабочееМесто,
		|	АналогичныеРабочиеМестаСпециальнойОценкиУсловийТруда.РабочееМесто КАК РабочееМесто,
		|	АналогичныеРабочиеМестаСпециальнойОценкиУсловийТруда.Организация КАК Организация
		|ПОМЕСТИТЬ ВТТекущиеАналогичныеРабочиеМеста
		|ИЗ
		|	РегистрСведений.АналогичныеРабочиеМестаСпециальнойОценкиУсловийТруда КАК АналогичныеРабочиеМестаСпециальнойОценкиУсловийТруда
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	АналогичноеРабочееМесто,
		|	РабочееМесто,
		|	Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НовыеАналогичныеРабочиеМеста.АналогичноеРабочееМесто КАК АналогичноеРабочееМесто
		|ПОМЕСТИТЬ ВТРабочиеМестаКОбновлению
		|ИЗ
		|	ВТНовыеАналогичныеРабочиеМеста КАК НовыеАналогичныеРабочиеМеста
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТекущиеАналогичныеРабочиеМеста КАК ТекущиеАналогичныеРабочиеМеста
		|		ПО НовыеАналогичныеРабочиеМеста.АналогичноеРабочееМесто = ТекущиеАналогичныеРабочиеМеста.АналогичноеРабочееМесто
		|			И НовыеАналогичныеРабочиеМеста.РабочееМесто = ТекущиеАналогичныеРабочиеМеста.РабочееМесто
		|			И НовыеАналогичныеРабочиеМеста.Организация = ТекущиеАналогичныеРабочиеМеста.Организация
		|ГДЕ
		|	НовыеАналогичныеРабочиеМеста.АналогичноеРабочееМесто <> ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка)
		|	И ТекущиеАналогичныеРабочиеМеста.АналогичноеРабочееМесто ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ТекущиеАналогичныеРабочиеМеста.АналогичноеРабочееМесто
		|ИЗ
		|	ВТТекущиеАналогичныеРабочиеМеста КАК ТекущиеАналогичныеРабочиеМеста
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНовыеАналогичныеРабочиеМеста КАК НовыеАналогичныеРабочиеМеста
		|		ПО ТекущиеАналогичныеРабочиеМеста.АналогичноеРабочееМесто = НовыеАналогичныеРабочиеМеста.АналогичноеРабочееМесто
		|			И ТекущиеАналогичныеРабочиеМеста.РабочееМесто = НовыеАналогичныеРабочиеМеста.РабочееМесто
		|			И ТекущиеАналогичныеРабочиеМеста.Организация = НовыеАналогичныеРабочиеМеста.Организация
		|ГДЕ
		|	ТекущиеАналогичныеРабочиеМеста.АналогичноеРабочееМесто <> ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка)
		|	И НовыеАналогичныеРабочиеМеста.АналогичноеРабочееМесто ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	АналогичноеРабочееМесто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РабочиеМестаКОбновлению.АналогичноеРабочееМесто КАК АналогичноеРабочееМесто,
		|	ЕСТЬNULL(НовыеАналогичныеРабочиеМеста.РабочееМесто,
		|		ЗНАЧЕНИЕ(Справочник.РабочиеМестаОхраныТруда.ПустаяСсылка)) КАК РабочееМесто,
		|	ЕСТЬNULL(НовыеАналогичныеРабочиеМеста.Организация,
		|		ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
		|	ВЫБОР
		|		КОГДА НовыеАналогичныеРабочиеМеста.АналогичноеРабочееМесто ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НужноОчистить
		|ИЗ
		|	ВТРабочиеМестаКОбновлению КАК РабочиеМестаКОбновлению
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНовыеАналогичныеРабочиеМеста КАК НовыеАналогичныеРабочиеМеста
		|		ПО РабочиеМестаКОбновлению.АналогичноеРабочееМесто = НовыеАналогичныеРабочиеМеста.АналогичноеРабочееМесто");

	Возврат СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());

