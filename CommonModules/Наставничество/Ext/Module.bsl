// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечатиПоОтменеНаставничества(КомандыПечати, ИдентификаторыПФ = Неопределено) Экспорт
	
	Если Не ИспользуетсяНаставничество() Тогда
		Возврат;
	КонецЕсли;
	
	Если Пользователи.РолиДоступны("ДобавлениеИзменениеДанныхДляНачисленияЗарплатыРасширенная, ЧтениеДанныхДляНачисленияЗарплатыРасширенная", , Ложь) Тогда
		
		// Приказ об отмене
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
		КомандаПечати.МенеджерПечати = "Документ.ПрекращениеНаставничества";
		КомандаПечати.Идентификатор = "ПФ_MXL_ПриказОбОтменеНаставничества";
		КомандаПечати.Представление = НСтр("ru = 'Приказ об отмене наставничества'");
		КомандаПечати.Порядок = 20;
		КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
		КомандаПечати.ДополнительныеПараметры.Вставить("ТребуетсяЧтениеБезОграничений", Истина);
		
		Если ИдентификаторыПФ <> Неопределено Тогда
			ЗарплатаКадры.ДобавитьИдентификаторКомандыДляПечатиВПакетномРежиме(ИдентификаторыПФ, КомандаПечати);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЭДОБЗК

Процедура ЗаполнитьНастройкиПечатныхФормПоУмолчанию(ОписанияНастроек) Экспорт
	
	ЭДОБЗК.ДобавитьНастройкуПечатнойФормыПоМетаданным(
		ОписанияНастроек,
		Метаданные.Документы.НазначениеНаставника.Макеты.ПФ_MXL_ДополнительноеСоглашениеОНаставничестве,
		Перечисления.СодержимоеДокументов.СодержитТарифныеСтавки);
	
	ЭДОБЗК.ДобавитьНастройкуПечатнойФормыПоМетаданным(
		ОписанияНастроек,
		Метаданные.Документы.НазначениеНаставника.Макеты.ПФ_MXL_ПриказОНаставничестве,
		Перечисления.СодержимоеДокументов.СодержитТарифныеСтавки);
		
	ЭДОБЗК.ДобавитьНастройкуПечатнойФормыПоМетаданным(
		ОписанияНастроек,
		Метаданные.Документы.ПрекращениеНаставничества.Макеты.ПФ_MXL_ПриказОбОтменеНаставничества,
		Перечисления.СодержимоеДокументов.НеСодержитЗарплаты);
	
КонецПроцедуры

