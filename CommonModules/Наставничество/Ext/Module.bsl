#Область УсловноВызываемыеПроцедурыИзПодписейДокументовИСведенийОбОтветственныхЛицах

// Описание полей ответственного за охрану труда в документах и сведениях об ответственных лицах.
//
Функция ОписаниеРеквизитовРолиРуководительПодразделения()
	ОписаниеРеквизитов = ПодписиДокументов.ОписаниеРеквизитовПодписанта();
	
	ОписаниеРеквизитов.ФизическоеЛицо = "РуководительПодразделения";
	ОписаниеРеквизитов.Должность = "ДолжностьРуководителяПодразделения";
	ОписаниеРеквизитов.ОснованиеПодписи = "ОснованиеПодписиРуководителяПодразделения";
	
	Возврат ОписаниеРеквизитов;
КонецФункции

#КонецОбласти

#Область ПроведениеДокументов

Функция ДублиОтсутствуют(ДокументОбъект, ТекстСообщения) Экспорт
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.НазначениеНаставника")
		И ЗначениеЗаполнено(ДокументОбъект.Наставляемый) Тогда
		
		ПараметрыПолучения = ПараметрыПолученияНазначенийНаставников();
		ПараметрыПолучения.Наставляемый = ДокументОбъект.Наставляемый;
		ПараметрыПолучения.Период = ДокументОбъект.ДатаНачала;
		ПараметрыПолучения.ИсключитьДвиженияДокумента = ДокументОбъект.Ссылка;
		ПараметрыПолучения.Организация = ДокументОбъект.Организация;
		
		ДействующиеНазначения = ДанныеДействующихНаставников(ПараметрыПолучения);
		Если Не ДействующиеНазначения.Количество() = 0 Тогда
			
			ОформленныеДокументы = ДействующиеНазначения.ВыгрузитьКолонку("ДокументОснование");
			ТекстСообщения = СтрШаблон(НСтр("ru='Для %1 уже есть назначение:%2%3'"), ДокументОбъект.Наставляемый, Символы.ПС, СтрСоединить(ОформленныеДокументы, Символы.ПС));
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;

	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПрекращениеНаставничества")
		И ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда
		
		ПараметрыПолучения = ПараметрыПолученияНазначенийНаставников();
		ПараметрыПолучения.ДокументОснование = ДокументОбъект.ДокументОснование;
		ПараметрыПолучения.ИсключитьДвиженияДокумента = ДокументОбъект.Ссылка;
		
		ДействующиеНазначения = ДанныеДействующихНаставников(ПараметрыПолучения);
		Если ДействующиеНазначения.Количество() = 0 Тогда
			
			ПараметрыПолучения = ПараметрыПолученияНазначенийНаставников();
			ПараметрыПолучения.Период = Дата(1,1,1);
			ПараметрыПолучения.ДокументОснование = ДокументОбъект.ДокументОснование;
			
			ДанныеИсторииНаставничества = ДанныеИсторииНаставничества(ПараметрыПолучения);
			
			Если ДанныеИсторииНаставничества.Количество() = 0 Или Не ЗначениеЗаполнено(ДанныеИсторииНаставничества[0].ПрекращениеНаставничества) Тогда
				ТекстСообщения = НСтр("ru='Наставничество уже завершено'");
			Иначе
				ТекстСообщения = СтрШаблон(НСтр("ru='Наставничество завершено документом %1'"), ДанныеИсторииНаставничества[0].ПрекращениеНаставничества);
			КонецЕсли;
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьДвиженияНаставничества(Движения, ДанныеДляПроведения) Экспорт
	
	Если Не ИспользуетсяНаставничество() Тогда 
		Возврат;
	КонецЕсли;
	
	Если ДанныеДляПроведения.Свойство("Наставничество") Тогда
		
		Для каждого СтрокаДанныхДляПроведения Из ДанныеДляПроведения.Наставничество Цикл
			СтрокаДвижений = Движения.Наставничество.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДвижений, СтрокаДанныхДляПроведения);
		КонецЦикла;
		
		Если Движения.Наставничество.Количество() > 0 Тогда
			Движения.Наставничество.Записывать = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииПланаВидовРасчетаПоНастройкам(НастройкиРасчетаЗарплаты, СвойстваНачислений, КоллекторНачислений, ПараметрыПланаВидовРасчета, ТекущиеНастройкиРасчетаЗарплаты) Экспорт
	
	ИзмененоИспользованиеДоплатыЗаНаставничество = РасчетЗарплатыРасширенный.ИзмененаНастройкаРасчетаЗарплаты("ИспользоватьДоплатуЗаНаставничество", НастройкиРасчетаЗарплаты, ТекущиеНастройкиРасчетаЗарплаты);
	
	Если ИзмененоИспользованиеДоплатыЗаНаставничество Тогда 
		
		ПланыВидовРасчетаМенеджер = ПланыВидовРасчета.Начисления;
		ИспользоватьДоплатуЗаНаставничество = НастройкиРасчетаЗарплаты.ИспользоватьДоплатуЗаНаставничество;
		
		Описание = ПланыВидовРасчетаМенеджер.ОписаниеНачисления();
		Описание.КатегорияНачисленияИлиНеоплаченногоВремени = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ПовременнаяОплатаТруда;
		Описание.СвойстваПоКатегории 	= СвойстваНачислений[Описание.КатегорияНачисленияИлиНеоплаченногоВремени];
		Описание.СвойстваПоКатегории.ПоддерживаетНесколькоПлановыхНачислений = Истина;
		Описание.Код					= НСтр("ru = 'ДПНСТ'");
		Описание.Наименование			= НСтр("ru = 'Доплата за наставничество'");
		Описание.КраткоеНаименование 	= НСтр("ru = 'Допл. за наставничество'");
		Описание.ФормулаРасчета			= "ПроцентНадбавкиЗаНаставничество / 100 * РасчетнаяБаза";
		Описание.ВидВремени = Перечисления.ВидыРабочегоВремениСотрудников.ДополнительноОплачиваемоеВПределахНормы;
		Описание.УчетВремениВЧасах		= Ложь;
		Описание.ПериодРасчетаБазовыхНачислений = Перечисления.ПериодыРасчетаБазовыхНачислений.ТекущийМесяц;
		Описание.ЗапрашиваемыеПоказатели = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ПроцентНадбавкиЗаНаставничество");
		Описание.ОтборБазовых = ПланыВидовРасчета.Начисления.ОтборБазовыхПоУмолчанию();
		Если Описание.ОтборБазовых.Свойство("ОбозначениеВТабелеУчетаРабочегоВремени") Тогда
			Описание.ОтборБазовых.Удалить("ОбозначениеВТабелеУчетаРабочегоВремени");
		КонецЕсли;
		Описание.СсылкаНаОбъект = ПараметрыПланаВидовРасчета.СсылкиНачисленийУдержаний.ДоплатаЗаНаставничество;
		Описание.КлючевыеСвойства = "Ссылка";
		Если ИспользоватьДоплатуЗаНаставничество Тогда
			ПланыВидовРасчетаМенеджер.СоздатьИзменитьНачисленияПоОписанию(КоллекторНачислений, Описание, Ложь);
			ПараметрыПланаВидовРасчета.СсылкиНачисленийУдержаний.ДоплатаЗаНаставничество = Описание.СсылкаНаОбъект;
		Иначе
			Описание.Вставить("Ссылка", Описание.СсылкаНаОбъект);
			ПланыВидовРасчетаМенеджер.ОтключитьИспользованиеНачисленийПоОписанию(КоллекторНачислений, Описание);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьПоказателиДоплатыЗаНаставничество(НастройкиРасчетаЗарплаты, ТекущиеНастройкиРасчетаЗарплаты) Экспорт
	
	ИзмененоИспользованиеДоплатыЗаНаставничество = РасчетЗарплатыРасширенный.ИзмененаНастройкаРасчетаЗарплаты("ИспользоватьДоплатуЗаНаставничество", НастройкиРасчетаЗарплаты, ТекущиеНастройкиРасчетаЗарплаты);
	ИспользоватьДоплатуЗаНаставничество = НастройкиРасчетаЗарплаты.ИспользоватьДоплатуЗаНаставничество;
	
	Если ИзмененоИспользованиеДоплатыЗаНаставничество Тогда 
		
		Если ИспользоватьДоплатуЗаНаставничество Тогда
			
			ОписаниеПоказателя = Справочники.ПоказателиРасчетаЗарплаты.ОписаниеПоказателя();
			ОписаниеПоказателя.Идентификатор = "ПроцентНадбавкиЗаНаставничество";
			ОписаниеПоказателя.Наименование = НСтр("ru = 'Процент надбавки за наставничество'");
			ОписаниеПоказателя.КраткоеНаименование = НСтр("ru = '% надб.'");
			ОписаниеПоказателя.ТипПоказателя = Перечисления.ТипыПоказателейРасчетаЗарплаты.Числовой;
			ОписаниеПоказателя.Точность = 2;
			ОписаниеПоказателя.ЗначениеРассчитываетсяАвтоматически = Ложь;
			ОписаниеПоказателя.СпособПримененияЗначений = Перечисления.СпособыПримененияЗначенийПоказателейРасчетаЗарплаты.Постоянное;
			ОписаниеПоказателя.НачальнаяНастройка = Истина;
			Справочники.ПоказателиРасчетаЗарплаты.ЗаписатьПоказатель(ОписаниеПоказателя);
			
		Иначе
			
			Справочники.ПоказателиРасчетаЗарплаты.ОтключитьИспользованиеПредопределенногоЭлемента("ПроцентНадбавкиЗаНаставничество");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеИсторииНаставничества(ПараметрыПолучения)
	
	ДанныеОтчета = Новый ТаблицаЗначений;
	
	СхемаКомпоновки = Отчеты.ОтчетыПоНаставничеству.ПолучитьМакет("ИсторияНаставничества");
	КлючВарианта = "ИсторияНаставничестваСписком";
	НастройкиОтчета = СхемаКомпоновки.ВариантыНастроек[КлючВарианта].Настройки;
	
	Если ПараметрыПолучения.Свойство("Организация") И ЗначениеЗаполнено(ПараметрыПолучения.Организация) Тогда
		Отбор = НастройкиОтчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.Использование = Истина;
		Отбор.ПравоеЗначение = ПараметрыПолучения.Организация;
	КонецЕсли;
	
	Если ПараметрыПолучения.Свойство("ДокументОснование") И ЗначениеЗаполнено(ПараметрыПолучения.ДокументОснование) Тогда
		Отбор = НастройкиОтчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументНазначения");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.Использование = Истина;
		Отбор.ПравоеЗначение = ПараметрыПолучения.ДокументОснование;
	КонецЕсли;
	
	Если ПараметрыПолучения.Свойство("Наставляемый") И ЗначениеЗаполнено(ПараметрыПолучения.Наставляемый) Тогда
		Отбор = НастройкиОтчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наставляемый");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.Использование = Истина;
		Отбор.ПравоеЗначение = ПараметрыПолучения.Наставляемый;
	КонецЕсли;
	
	Если ПараметрыПолучения.Свойство("СписокНаставников") И ЗначениеЗаполнено(ПараметрыПолучения.СписокНаставников) Тогда
		
		СписокНаставников = Неопределено;
		Если ТипЗнч(ПараметрыПолучения.СписокНаставников) = Тип("Массив") Тогда
			СписокНаставников = Новый СписокЗначений;
			СписокНаставников.ЗагрузитьЗначения(ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыПолучения.СписокНаставников));
		ИначеЕсли ТипЗнч(ПараметрыПолучения.СписокНаставников) = Тип("СписокЗначений") Тогда
			СписокНаставников = ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыПолучения.СписокНаставников);
		КонецЕсли;
		
		Если Не СписокНаставников = Неопределено Тогда
			Отбор = НастройкиОтчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наставник");
			Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			Отбор.Использование = Истина;
			Отбор.ПравоеЗначение = СписокНаставников;
		КонецЕсли;
		
	КонецЕсли;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки));
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("КлючВарианта", КлючВарианта);
	
	МакетКомпоновки = ЗарплатаКадрыОтчеты.МакетКомпоновкиДанныхДляКоллекцииЗначений(СхемаКомпоновки, НастройкиОтчета);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ДанныеОтчета);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ДанныеОтчета;
	
КонецФункции

// Создает команду "Наставничество" в формах элементов Сотрудники, ФизическиеЛица, Кандидаты
//
Процедура СоздатьКомандуНаставничествоВФорме(Форма, ГруппаКнопки, ВидКнопки) Экспорт

	Если Не ИспользуетсяНаставничество() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.Наставничество) Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Команды.Найти("Наставничество") = Неопределено Тогда
		КомандаНаставничество = Форма.Команды.Добавить("Наставничество");
		КомандаНаставничество.Действие = "Подключаемый_Наставничество";
		КомандаНаставничество.Заголовок = НСтр("ru = 'Наставничество'");
	КонецЕсли;
	
	// Добавляем саму кнопку
	Если Форма.Элементы.Найти("Наставничество") = Неопределено Тогда
		Элемент = Форма.Элементы.Вставить("Наставничество", Тип("КнопкаФормы"), ГруппаКнопки);
		Элемент.Вид = ВидКнопки;
		Элемент.ИмяКоманды = "Наставничество"; 
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьПараметрыЗаполненияПозицииРезерваПоУчастникуКадровогоРезерва(ПараметрыЗаполнения) Экспорт

	Если Не ИспользуетсяНаставничество() Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения.Вставить("ЗавершитьНаставничество", Истина);
	
КонецПроцедуры

Процедура ДополнитьСтрокуПозицииКадровогоРезерваСведениямиОНаставничестве(Период, УчастникКадровогоРезерва, СтрокаТабличнойЧасти, ПараметрыЗаполнения) Экспорт
	
	Если Не ПараметрыЗаполнения.Свойство("ЗавершитьНаставничество") Или Не ПараметрыЗаполнения.ЗавершитьНаставничество Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПолучения = ПараметрыПолученияНазначенийНаставников();
	ПараметрыПолучения.Период			= Период;
	ПараметрыПолучения.ПозицияРезерва	= СтрокаТабличнойЧасти.ПозицияРезерва;
	ПараметрыПолучения.Наставляемый		= УчастникКадровогоРезерва;
	
	ТаблицаНазначенийНаставников = ДанныеДействующихНаставников(ПараметрыПолучения);
	
	Если Не ТаблицаНазначенийНаставников.Количество() = 0 Тогда
		СтрокаТабличнойЧасти.ЗавершитьНаставничество = Истина;
		СтрокаТабличнойЧасти.Наставник = ТаблицаНазначенийНаставников[0].Наставник;
		СтрокаТабличнойЧасти.ДокументОснование = ТаблицаНазначенийНаставников[0].ДокументОснование;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервереФормыИсключенияИзКадровогоРезерва(Форма, ТаблицаПозицииРезерва) Экспорт

	Если Не ИспользуетсяНаставничество() Тогда 
		Возврат;
	КонецЕсли;
	
	ПолеНаставничество = Форма.Элементы.Добавить("РезервЗавершитьНаставничество", Тип("ПолеФормы"), ТаблицаПозицииРезерва);
	ПолеНаставничество.ПутьКДанным = "Объект.Резерв.ЗавершитьНаставничество";
	ПолеНаставничество.Заголовок = НСтр("ru='Завершить наставничество'");
	ПолеНаставничество.Вид = ВидПоляФормы.ПолеФлажка;
	ПолеНаставничество.УстановитьДействие("ПриИзменении", "Подключаемый_РезервЗавершитьНаставничествоПриИзменении");
	
	ПолеНаставничество = Форма.Элементы.Добавить("РезервНаставник", Тип("ПолеФормы"), ТаблицаПозицииРезерва);
	ПолеНаставничество.ПутьКДанным = "Объект.Резерв.Наставник";
	ПолеНаставничество.Заголовок = НСтр("ru='Наставник'");
	ПолеНаставничество.ТолькоПросмотр = Истина;
	ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеНаставничество = Форма.Элементы.Добавить("РезервДокументОснование", Тип("ПолеФормы"), ТаблицаПозицииРезерва);
	ПолеНаставничество.ПутьКДанным = "Объект.Резерв.ДокументОснование";
	ПолеНаставничество.Заголовок = НСтр("ru='Документ-основание'");
	ПолеНаставничество.ТолькоПросмотр = Истина;
	ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
	
КонецПроцедуры

Процедура ПриИзмененииСотрудникаДокументаУвольнение(Форма) Экспорт
	
	Сотрудник = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Сотрудник");
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ЗавершитьНаставничество", Истина);
		
		Форма.ЗаполнитьТаблицуНаставничестваНаСервере();
		
		Наставники = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Наставники");
		Если Наставники.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ЗавершитьНаставничество", Ложь);
			Форма.ЗаполнитьТаблицуНаставничестваНаСервере();
		КонецЕсли;
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.ЗавершитьНаставничество", Ложь);
		Форма.ЗаполнитьТаблицуНаставничестваНаСервере();
		
	КонецЕсли;
	
	ЗавершитьНаставничество = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.ЗавершитьНаставничество");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Наставничество", "Доступность", ЗавершитьНаставничество);
	
КонецПроцедуры

Процедура ПриСозданииНаСервереФормыДокумента(Форма, ОтображатьИзмененияПлановыхНачислений = Истина) Экспорт
	
	Если Не ИспользуетсяНаставничество() Тогда 
		Возврат;
	КонецЕсли;

	Если Не НаставничествоДоступноПользователю() Тогда 
		Возврат;
	КонецЕсли;
	
	ГруппаФормы = Форма.Элементы.Найти("СтраницаНаставничество");
	
	Если ГруппаФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементЗавершитьНаставничество = Форма.Элементы.Добавить("ЗавершитьНаставничество", Тип("ПолеФормы"), ГруппаФормы);
	ЭлементЗавершитьНаставничество.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементЗавершитьНаставничество.ПутьКДанным = "Объект.ЗавершитьНаставничество";
	ЭлементЗавершитьНаставничество.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементЗавершитьНаставничество.УстановитьДействие("ПриИзменении", "Подключаемый_ЗавершитьНаставничествоПриИзменении");
	
	ТаблицаНаставничество = Форма.Элементы.Добавить("Наставничество", Тип("ТаблицаФормы"), ГруппаФормы);
	ТаблицаНаставничество.ПутьКДанным = "Объект.Наставники";
	ТаблицаНаставничество.Отображение = ОтображениеТаблицы.Список;
	ТаблицаНаставничество.УстановитьДействие("Выбор", "Подключаемый_НаставничествоВыбор");
	ТаблицаНаставничество.УстановитьДействие("ПередУдалением", "Подключаемый_НаставничествоПередУдалением");
	ТаблицаНаставничество.УстановитьДействие("ПередНачаломДобавления", "Подключаемый_НаставничествоПередНачаломДобавления");
	ТаблицаНаставничество.УстановитьДействие("ПриНачалеРедактирования", "Подключаемый_НаставничествоПриНачалеРедактирования");
	ТаблицаНаставничество.УстановитьДействие("Выбор", "Подключаемый_НаставничествоВыбор");

	ИмяКоманды = "ЗаполнитьТаблицуНаставничества";
	КомандаЗаполнитьТаблицуНаставничества = Форма.Команды.Добавить(ИмяКоманды);
	КомандаЗаполнитьТаблицуНаставничества.Действие = "Подключаемый_ЗаполнитьТаблицуНаставничества";
	КнопкаКоманды = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы.НаставничествоКоманднаяПанель);
	КнопкаКоманды.ИмяКоманды = ИмяКоманды;
	КнопкаКоманды.Заголовок = НСтр("ru='Заполнить'");
	
	ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоНомерСтроки", Тип("ПолеФормы"), ТаблицаНаставничество);
	ПолеНаставничество.ПутьКДанным = "Объект.Наставники.НомерСтроки";
	ПолеНаставничество.Заголовок = НСтр("ru='Номер строки'");
	ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоНаставник", Тип("ПолеФормы"), ТаблицаНаставничество);
	ПолеНаставничество.ПутьКДанным = "Объект.Наставники.Наставник";
	ПолеНаставничество.Заголовок = НСтр("ru='Наставник'");
	ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
	ПолеНаставничество.АвтоОтметкаНезаполненного = Истина;
	ПолеНаставничество.РежимВыбораИзСписка = Истина;
	ПолеНаставничество.УстановитьДействие("НачалоВыбора", "Подключаемый_НаставничествоНаставникНачалоВыбораИзСписка");
	ПолеНаставничество.УстановитьДействие("ПриИзменении", "Подключаемый_НаставничествоНаставникПриИзменении");

	ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоДокументОснование", Тип("ПолеФормы"), ТаблицаНаставничество);
	ПолеНаставничество.ПутьКДанным = "Объект.Наставники.ДокументОснование";
	ПолеНаставничество.Заголовок = НСтр("ru='Документ-основание'");
	ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
	ПолеНаставничество.АвтоОтметкаНезаполненного = Истина;
	ПолеНаставничество.РежимВыбораИзСписка = Истина;
	ПолеНаставничество.УстановитьДействие("НачалоВыбора", "Подключаемый_НаставничествоДокументОснованиеНачалоВыбораИзСписка");
	ПолеНаставничество.УстановитьДействие("ПриИзменении", "Подключаемый_НаставничествоДокументОснованиеПриИзменении");

	ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоНаставляемый", Тип("ПолеФормы"), ТаблицаНаставничество);
	ПолеНаставничество.ПутьКДанным = "Объект.Наставники.Наставляемый";
	ПолеНаставничество.Заголовок = НСтр("ru='Наставляемый'");
	ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
	ПолеНаставничество.ТолькоПросмотр = Истина;

	ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоДатаОкончания", Тип("ПолеФормы"), ТаблицаНаставничество);
	ПолеНаставничество.ПутьКДанным = "Объект.Наставники.ДатаОкончания";
	ПолеНаставничество.Заголовок = НСтр("ru='Дата окончания'");
	ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
	ПолеНаставничество.АвтоОтметкаНезаполненного = Истина;
	
	Если ОтображатьИзмененияПлановыхНачислений Тогда
		
		ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоОтменитьДоплату", Тип("ПолеФормы"), ТаблицаНаставничество);
		ПолеНаставничество.ПутьКДанным = "Объект.Наставники.ОтменитьДоплату";
		ПолеНаставничество.Заголовок = НСтр("ru='Отменить доплату'");
		ПолеНаставничество.Вид = ВидПоляФормы.ПолеФлажка;
		ПолеНаставничество.УстановитьДействие("ПриИзменении", "Подключаемый_НаставничествоОтменитьДоплатуПриИзменении");
		
		ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоНачисление", Тип("ПолеФормы"), ТаблицаНаставничество);
		ПолеНаставничество.ПутьКДанным = "Объект.Наставники.Начисление";
		ПолеНаставничество.Заголовок = НСтр("ru='Начисление'");
		ПолеНаставничество.ТолькоПросмотр = Истина;
		ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
		
		ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоСовокупнаяТарифнаяСтавка", Тип("ПолеФормы"), ТаблицаНаставничество);
		ПолеНаставничество.ПутьКДанным = "Объект.Наставники.СовокупнаяТарифнаяСтавка";
		ПолеНаставничество.Заголовок = НСтр("ru='Совокупная тарифная ставка'");
		ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
		ПолеНаставничество.ТолькоПросмотр = Истина;
		
		ПолеНаставничество = Форма.Элементы.Добавить("НаставничествоФОТ", Тип("ПолеФормы"), ТаблицаНаставничество);
		ПолеНаставничество.ПутьКДанным = "Объект.Наставники.ФОТ";
		ПолеНаставничество.Заголовок = НСтр("ru='ФОТ'");
		ПолеНаставничество.Вид = ВидПоляФормы.ПолеВвода;
		ПолеНаставничество.ТолькоПросмотр = Истина;
		
	КонецЕсли;

	УстановитьДоступностьЭлементовНаставничества(Форма);
	
КонецПроцедуры

// Возвращает доступность подсистемы наставничества для пользователя по правам и интерфейсу.
// 
// Возвращаемое значение:
//  Булево
Функция НаставничествоДоступноПользователю()

	Если Не ИспользуетсяНаставничество() Тогда
		Возврат Ложь;
	Иначе
		Возврат ПравоДоступа("Изменение", Метаданные.РегистрыСведений.Наставничество);
	КонецЕсли;

КонецФункции

#Область ОпределениеДоступностиДанных

Функция ДоступноИзменениеИспользованияНаставничества() Экспорт

	Возврат ПравоДоступа("Изменение", Метаданные.Константы.ИспользоватьНаставничество);

КонецФункции

#КонецОбласти

#Область ФормыДокументов

Функция СписокВыбораНаставников(Знач Форма, ИмяТабличнойЧастиСотрудники = Неопределено) Экспорт
	Если ИмяТабличнойЧастиСотрудники = Неопределено Тогда
		Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Форма.Объект.Сотрудник);
	Иначе
		СписокСотрудников = Форма.Объект[ИмяТабличнойЧастиСотрудники].Выгрузить(,"Сотрудник");
		СписокСотрудников.Свернуть("Сотрудник");
		Возврат СписокСотрудников.ВыгрузитьКолонку("Сотрудник");
	КонецЕсли;
КонецФункции

Функция ПараметрыПолученияНазначенийНаставников() Экспорт
	
	ПараметрыПолучения = Новый Структура;
	ПараметрыПолучения.Вставить("СписокНаставников", Новый Массив);
	ПараметрыПолучения.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыПолучения.Вставить("Период", Дата(1,1,1));
	ПараметрыПолучения.Вставить("ПозицияРезерва", Неопределено);
	ПараметрыПолучения.Вставить("Наставляемый", Неопределено);
	ПараметрыПолучения.Вставить("ДокументОснование", Неопределено);
	ПараметрыПолучения.Вставить("ИсключитьДвиженияДокумента", Неопределено);
	
	Возврат ПараметрыПолучения;
	
КонецФункции

Функция РеквизитыДокументаОснования(Знач ДокументОснование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НазначениеНаставника.Наставляемый КАК Наставляемый,
	|	НазначениеНаставника.НазначитьДоплату КАК ОтменитьДоплату,
	|	НазначениеНаставника.Начисление КАК Начисление
	|ИЗ
	|	Документ.НазначениеНаставника КАК НазначениеНаставника
	|ГДЕ
	|	НазначениеНаставника.Ссылка = &Ссылка"
	;
	РеквизитыДокументаОснования = Новый Структура("Наставляемый,ОтменитьДоплату,Начисление");
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыДокументаОснования, РезультатЗапроса);
	КонецЕсли;
	Возврат РеквизитыДокументаОснования;
	
КонецФункции

Процедура НаставничествоОтменитьДоплатуПриИзмененииНаСервере(Форма, ИсходныйНомерСтроки) Экспорт
	ТекущиеДанные = Форма.Объект.Наставники[ИсходныйНомерСтроки];
	Если ТекущиеДанные.ОтменитьДоплату И ТекущиеДанные.Начисление.Пустая() Тогда
		ТекущиеДанные.ОтменитьДоплату = Ложь;
	КонецЕсли;
	ЗаполнитьВремяРегистрации(Форма, ТекущиеДанные);
	РассчитатьИтогиПоФОТ(Форма,ТекущиеДанные)
КонецПроцедуры

Процедура НаставничествоДокументОснованиеНачалоВыбораИзСпискаНаСервере(ДокументОбъект, ИсходныйНомерСтроки, Период, ДействующиеНазначения) Экспорт
	
	ТекущиеДанные = ДокументОбъект.Наставники[ИсходныйНомерСтроки];
	
	ПараметрыПолучения = ПараметрыПолученияНазначенийНаставников();
	ПараметрыПолучения.СписокНаставников = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущиеДанные.Наставник);
	ПараметрыПолучения.Организация = ДокументОбъект.Организация;
	ПараметрыПолучения.Период = Период;
	ПараметрыПолучения.ИсключитьДвиженияДокумента = ДокументОбъект.Ссылка;
	
	ТаблицаНазначенийНаставников = ДанныеДействующихНаставников(ПараметрыПолучения);

	ДействующиеНазначения = ТаблицаНазначенийНаставников.ВыгрузитьКолонку("ДокументОснование");
	
КонецПроцедуры

Процедура РезервЗавершитьНаставничествоПриИзмененииНаСервере(Форма, ИсходныйНомерСтроки) Экспорт
	ТекущиеДанные = Форма.Объект.Резерв[ИсходныйНомерСтроки];
	Если ТекущиеДанные.Наставник.Пустая() Тогда
		ТекущиеДанные.ЗавершитьНаставничество = Ложь;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьВремяРегистрации(Форма, ТекущиеДанные)
	
	ТекущиеДанные.ВремяРегистрации = ЗарплатаКадрыРасширенный.ВремяРегистрацииСотрудникаДокумента(Форма.Объект.Ссылка, ТекущиеДанные.Наставник, ТекущиеДанные.ДатаОкончания);
	
КонецПроцедуры

Процедура РассчитатьИтогиПоФОТ(Форма, ТекущиеДанные)
	
	ОписаниеТаблицыНачислений = ОписаниеТаблицыНачислений();

	ГоловнаяОрганизация = ЗарплатаКадры.ГоловнаяОрганизация(Форма.Объект.Организация);

	СотрудникиДаты = Новый ТаблицаЗначений;
	СотрудникиДаты.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	СотрудникиДаты.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	
	НоваяСтрока = СотрудникиДаты.Добавить();
	НоваяСтрока.Сотрудник = ТекущиеДанные.Наставник;
	НоваяСтрока.Период = ТекущиеДанные.ВремяРегистрации;
	
	ТаблицаНачислений = ПлановыеНачисленияСотрудников.ТаблицаНачисленийДляРасчетаВторичныхДанных();
	ТаблицаПоказателей = ПлановыеНачисленияСотрудников.ТаблицаИзвестныеПоказатели();

	ДанныеНачислений = РасчетЗарплатыРасширенный.ДействующиеПлановыеНачисления(СотрудникиДаты, Форма.Объект.Ссылка);
	ДействующиеПлановыеНачисления = ДанныеНачислений.Начисления;
	
	УдалитьСтроки = Форма.Начисления.НайтиСтроки(Новый Структура("Сотрудник", ТекущиеДанные.Наставник));
	Для Каждого УдаляемаяСтрока Из УдалитьСтроки Цикл
		Форма.Начисления.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	Форма.НачисленияСотрудника.Очистить();
	
	ИдентификаторСтрокиВидаРасчета = 1;
	
	Для Каждого СтрокаНачислений Из ДействующиеПлановыеНачисления Цикл
		
		СтруктураНачисления = Новый Структура("Начисление,ДокументОснование,Действие,ИдентификаторСтрокиВидаРасчета,Размер");
		ЗаполнитьЗначенияСвойств(СтруктураНачисления, СтрокаНачислений);
		СтруктураНачисления.ИдентификаторСтрокиВидаРасчета = ИдентификаторСтрокиВидаРасчета;
		Если СтруктураНачисления.Начисление = ТекущиеДанные.Начисление И СтруктураНачисления.ДокументОснование = ТекущиеДанные.ДокументОснование
			И ТекущиеДанные.ОтменитьДоплату Тогда
			СтруктураНачисления.Действие = Перечисления.ДействияСНачислениямиИУдержаниями.Отменить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Форма.НачисленияСотрудника.Добавить(), СтруктураНачисления);
		
		СведенияОНачислении = ЗарплатаКадрыРасширенныйВызовСервера.ПолучитьИнформациюОВидеРасчета(СтруктураНачисления.Начисление);
		
		ДанныеНачисления = ТаблицаНачислений.Добавить();
		ДанныеНачисления.Сотрудник = ТекущиеДанные.Наставник;
		ДанныеНачисления.ГоловнаяОрганизация = ГоловнаяОрганизация;
		ДанныеНачисления.Период = ТекущиеДанные.ВремяРегистрации;
		ДанныеНачисления.Начисление = СтрокаНачислений.Начисление;
		ДанныеНачисления.ДокументОснование = СтрокаНачислений.ДокументОснование;
		ДанныеНачисления.Размер = СтрокаНачислений.Размер;
		
		ИдентификаторСтрокиВидаРасчета = ИдентификаторСтрокиВидаРасчета + 1;
		
	КонецЦикла;
	
	РассчитанныеВторичныеДанные = ПлановыеНачисленияСотрудников.РассчитатьВторичныеДанныеПлановыхНачислений(ТаблицаНачислений);
	
	Если РассчитанныеВторичныеДанные.ТарифныеСтавки.Количество() = 0 Тогда
		ТекущиеДанные.ВидТарифнойСтавки = Перечисления.ВидыТарифныхСтавок.ПустаяСсылка();
		ТекущиеДанные.СовокупнаяТарифнаяСтавка = 0;
	Иначе
		ТекущиеДанные.ВидТарифнойСтавки = РассчитанныеВторичныеДанные.ТарифныеСтавки[0].ВидТарифнойСтавки;
		ТекущиеДанные.СовокупнаяТарифнаяСтавка = РассчитанныеВторичныеДанные.ТарифныеСтавки[0].СовокупнаяТарифнаяСтавка;
	КонецЕсли;
	
	ОписаниеТаблицыНачислений.СодержитПолеДействие = Истина;
	ОписаниеТаблицыНачислений.ИмяТаблицы = "НачисленияСотрудника";
	ОписаниеТаблицыНачислений.ПутьКДанным = "НачисленияСотрудника";
	ТекущиеДанные.ФОТ = ЗарплатаКадрыРасширенныйКлиентСервер.ИтогиПоФОТ(Форма, ОписаниеТаблицыНачислений);
	
	Для Каждого СтрокаНачисленийСотрудника Из Форма.НачисленияСотрудника Цикл
		СтрокаНачислений = Форма.Начисления.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНачислений, СтрокаНачисленийСотрудника);
		СтрокаНачислений.Сотрудник = ТекущиеДанные.Наставник;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеТаблицыНачислений()
	
	ОписаниеТаблицыВидовРасчета = РасчетЗарплатыРасширенныйКлиентСервер.ОписаниеТаблицыПлановыхНачислений(Ложь, Ложь);
	ОписаниеТаблицыВидовРасчета.Вставить("ЗапретитьИзменениеПоказателяТарифнойСетки", Истина);
	ОписаниеТаблицыВидовРасчета.ПутьКДанным = "Начисления";
	Возврат ОписаниеТаблицыВидовРасчета;
	
КонецФункции

Функция АдресВХранилищеНачисленийИУдержаний(Форма, Наставник, ВремяРегистрации) Экспорт
	
	ПараметрыОткрытия = ЗарплатаКадрыРасширенныйКлиентСервер.ПараметрыРедактированияСоставаНачисленийИУдержаний();
	
	ПараметрыОткрытия.ВладелецНачисленийИУдержаний = Наставник;
	ПараметрыОткрытия.ДатаРедактирования = ВремяРегистрации;
	ПараметрыОткрытия.Организация = Форма.Объект.Организация;
	ПараметрыОткрытия.РежимРаботы = 3;
	ПараметрыОткрытия.ДополнитьНедостающиеЗначенияПоказателей = Истина;
	
	ДополнитьСтруктуруНачислениямиИПоказателямиСтроки(Форма, ПараметрыОткрытия, Наставник);
	
	Возврат ПоместитьВоВременноеХранилище(ПараметрыОткрытия, Форма.УникальныйИдентификатор);
	
КонецФункции

Процедура ДополнитьСтруктуруНачислениямиИПоказателямиСтроки(Форма, ПараметрыОткрытия, Сотрудник)
	
	МассивНачислений = Форма.Начисления.Выгрузить().НайтиСтроки(Новый Структура("Сотрудник", Сотрудник));
	
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.Используется = Истина;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.Таблица = МассивНачислений;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.ИзменятьСоставВидовРасчета = Ложь;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.ИзменятьЗначенияПоказателей = Ложь;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.НомерТаблицы = 1;
	ПараметрыОткрытия.ОписаниеТаблицыНачислений.ПоказатьФОТ = Истина;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуНаставничестваНаСервере(Форма, Организация, ДатаСобытия, ИмяТабличнойЧастиСотрудники = Неопределено, ОтображатьИзмененияПлановыхНачислений = Истина) Экспорт
	
	Форма.Объект.Наставники.Очистить();
	
	СписокСотрудников = СписокВыбораНаставников(Форма, ИмяТабличнойЧастиСотрудники);
	
	ПараметрыПолучения = ПараметрыПолученияНазначенийНаставников();
	ПараметрыПолучения.СписокНаставников	= СписокСотрудников;
	ПараметрыПолучения.Организация			= Организация;
	ПараметрыПолучения.Период		 		= ДатаСобытия;
	ПараметрыПолучения.ИсключитьДвиженияДокумента = Форма.Объект.Ссылка;
	
	ТаблицаНазначенийНаставников = ДанныеДействующихНаставников(ПараметрыПолучения);
	
	Для Каждого ДокументНазначения Из ТаблицаНазначенийНаставников Цикл
		
		НоваяСтрока = Форма.Объект.Наставники.Добавить();
		НоваяСтрока.ДатаОкончания = ДатаСобытия;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДокументНазначения, "Наставник,Наставляемый,Начисление,ДокументОснование");
		
		Если ОтображатьИзмененияПлановыхНачислений Тогда
			НоваяСтрока.ОтменитьДоплату = ДокументНазначения.НазначитьДоплату;
			НаставничествоОтменитьДоплатуПриИзмененииНаСервере(Форма, Форма.Объект.Наставники.Индекс(НоваяСтрока));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьДоступностьЭлементовНаставничества(Форма)
	Форма.Элементы.Наставничество.Доступность = Форма.Объект.ЗавершитьНаставничество;
КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокументов

Процедура СформироватьДвиженияПоНаставничеству(Ссылка, Объект, Движения, ДанныеДляПроведения, ФормироватьДвиженияПлановыхНачислений = Истина) Экспорт
	
	Если Не ИспользуетсяНаставничество() Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеДляПроведения.Свойство("Наставничество") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляПроведенияНаставничество = ДанныеДляПроведения.Наставничество;
	
	Если ФормироватьДвиженияПлановыхНачислений Тогда
		
		ЗарплатаКадрыРасширенный.УстановитьВремяРегистрацииДокумента(Движения, ДанныеДляПроведенияНаставничество.СотрудникиДаты, Ссылка);
		
		СтруктураПлановыхНачислений = Новый Структура;
		СтруктураПлановыхНачислений.Вставить("ДанныеОПлановыхНачислениях", ДанныеДляПроведенияНаставничество.ПлановыеНачисления);
		СтруктураПлановыхНачислений.Вставить("ЗначенияПоказателей", ДанныеДляПроведенияНаставничество.ЗначенияПоказателей);
		
		РасчетЗарплаты.СформироватьДвиженияПлановыхНачислений(Объект, Движения, СтруктураПлановыхНачислений);
		
		ОтражениеЗарплатыВБухучетеРасширенный.СформироватьПрекращениеБухучетаНачисленийСотрудников(Объект, Движения, Движения.ПлановыеНачисления);
		
	КонецЕсли;
	
	СформироватьДвиженияНаставничества(Движения, ДанныеДляПроведенияНаставничество);
	
КонецПроцедуры

Процедура ДополнитьДанныеДляПроведенияДисциплинарногоВзыскания(Ссылка, ДанныеДляПроведения) Экспорт
	
	Если Не ИспользуетсяНаставничество() Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	// Подготовка данных для проведения.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДисциплинарноеВзысканиеНаставничество.ДатаОкончания КАК ДатаСобытия,
	|	ДисциплинарноеВзысканиеНаставничество.Наставник КАК Сотрудник,
	|	ДисциплинарноеВзысканиеНаставничество.Начисление КАК Начисление,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ДисциплинарноеВзысканиеНаставничество.Начисление КАК ПланВидовРасчета.Начисления).ПоддерживаетНесколькоПлановыхНачислений = ИСТИНА
	|			ТОГДА ДисциплинарноеВзысканиеНаставничество.ДокументОснование
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДокументОснование,
	|	ЛОЖЬ КАК Используется,
	|	0 КАК Размер,
	|	ДисциплинарноеВзысканиеНаставничество.Наставник.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	ДисциплинарноеВзысканиеНаставничество.Ссылка.Организация КАК ОрганизацияДокумента
	|ПОМЕСТИТЬ ВТДанныеОПлановыхНачислениях
	|ИЗ
	|	Документ.ДисциплинарноеВзыскание.Наставники КАК ДисциплинарноеВзысканиеНаставничество
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО ДисциплинарноеВзысканиеНаставничество.Наставник = Сотрудники.Ссылка
	|ГДЕ
	|	ДисциплинарноеВзысканиеНаставничество.Ссылка = &Ссылка
	|	И ДисциплинарноеВзысканиеНаставничество.ОтменитьДоплату
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеОПлановыхНачислениях.ДатаСобытия КАК ДатаСобытия,
	|	ДанныеОПлановыхНачислениях.Сотрудник КАК Сотрудник,
	|	ДанныеОПлановыхНачислениях.Начисление КАК Начисление,
	|	ДанныеОПлановыхНачислениях.ДокументОснование КАК ДокументОснование,
	|	ДанныеОПлановыхНачислениях.Используется КАК Используется,
	|	ДанныеОПлановыхНачислениях.Размер КАК Размер,
	|	ДанныеОПлановыхНачислениях.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ДанныеОПлановыхНачислениях.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДействуетДо
	|ИЗ
	|	ВТДанныеОПлановыхНачислениях КАК ДанныеОПлановыхНачислениях
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеОПлановыхНачислениях.ОрганизацияДокумента КАК Организация,
	|	ДанныеОПлановыхНачислениях.Сотрудник КАК Сотрудник,
	|	ДанныеОПлановыхНачислениях.ДатаСобытия КАК ДатаСобытия,
	|	ДанныеОПлановыхНачислениях.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ПоказателиНачислений.Показатель КАК Показатель,
	|	0 КАК Значение,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДействуетДо
	|ИЗ
	|	ВТДанныеОПлановыхНачислениях КАК ДанныеОПлановыхНачислениях
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовРасчета.Начисления.Показатели КАК ПоказателиНачислений
	|		ПО (ПоказателиНачислений.Ссылка = ДанныеОПлановыхНачислениях.Начисление)
	|			И (ПоказателиНачислений.ОтменяемыйПоказатель = ИСТИНА)
	|ГДЕ
	|	ПоказателиНачислений.Показатель ЕСТЬ НЕ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДисциплинарноеВзысканиеНаставничество.Наставник КАК Сотрудник,
	|	ДисциплинарноеВзысканиеНаставничество.ДатаОкончания КАК ДатаСобытия,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДействуетДо,
	|	ДисциплинарноеВзысканиеНаставничество.СовокупнаяТарифнаяСтавка КАК Значение,
	|	ВЫБОР
	|		КОГДА ДисциплинарноеВзысканиеНаставничество.СовокупнаяТарифнаяСтавка = 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыТарифныхСтавок.ПустаяСсылка)
	|		ИНАЧЕ ДисциплинарноеВзысканиеНаставничество.ВидТарифнойСтавки
	|	КОНЕЦ КАК ВидТарифнойСтавки,
	|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	Документ.ДисциплинарноеВзыскание.Наставники КАК ДисциплинарноеВзысканиеНаставничество
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО ДисциплинарноеВзысканиеНаставничество.Наставник = Сотрудники.Ссылка
	|ГДЕ
	|	ДисциплинарноеВзысканиеНаставничество.Ссылка = &Ссылка
	|	И ДисциплинарноеВзысканиеНаставничество.ОтменитьДоплату
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДисциплинарноеВзысканиеНаставничество.ДатаОкончания КАК ДатаСобытия,
	|	ДисциплинарноеВзысканиеНаставничество.Наставник КАК Сотрудник
	|ИЗ
	|	Документ.ДисциплинарноеВзыскание.Наставники КАК ДисциплинарноеВзысканиеНаставничество
	|ГДЕ
	|	ДисциплинарноеВзысканиеНаставничество.Ссылка = &Ссылка
	|	И ДисциплинарноеВзысканиеНаставничество.ОтменитьДоплату";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеДляПроведенияНаставничество = Новый Структура; 
	
	// Таблица для формирования плановых начислений.
	ДанныеДляПроведенияНаставничество.Вставить("ПлановыеНачисления", РезультатыЗапроса[1].Выгрузить());
	
	// Таблица для формирования значений показателей.
	ДанныеДляПроведенияНаставничество.Вставить("ЗначенияПоказателей", РезультатыЗапроса[2].Выгрузить());
	
	// Таблица для формирования значений совокупных тарифных ставок.
	ДанныеДляПроведенияНаставничество.Вставить("ДанныеСовокупныхТарифныхСтавок", РезультатыЗапроса[3].Выгрузить());
	
	// Таблица для формирования времени регистрации документа.
	ДанныеДляПроведенияНаставничество.Вставить("СотрудникиДаты", РезультатыЗапроса[4].Выгрузить());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОНЕЦПЕРИОДА(ДисциплинарноеВзысканиеНаставничество.ДатаОкончания, ДЕНЬ) КАК Период,
	|	ДисциплинарноеВзысканиеНаставничество.Ссылка.Организация КАК Организация,
	|	ДисциплинарноеВзысканиеНаставничество.Наставник КАК Наставник,
	|	ДисциплинарноеВзысканиеНаставничество.Наставляемый КАК Наставляемый,
	|	ЛОЖЬ КАК Назначен,
	|	ДисциплинарноеВзысканиеНаставничество.ДатаОкончания КАК ДатаОкончания,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ДисциплинарноеВзысканиеНаставничество.Наставник) = ТИП(Справочник.ФизическиеЛица)
	|			ТОГДА ДисциплинарноеВзысканиеНаставничество.Наставник
	|		ИНАЧЕ ВЫРАЗИТЬ(ДисциплинарноеВзысканиеНаставничество.Наставник КАК Справочник.Сотрудники).ФизическоеЛицо
	|	КОНЕЦ КАК ФизическоеЛицо,
	|	ДисциплинарноеВзысканиеНаставничество.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ.ДисциплинарноеВзыскание.Наставники КАК ДисциплинарноеВзысканиеНаставничество
	|ГДЕ
	|	ДисциплинарноеВзысканиеНаставничество.Ссылка = &Ссылка
	|	И ДисциплинарноеВзысканиеНаставничество.Ссылка.ЗавершитьНаставничество";
	
	ДанныеДляПроведенияНаставничество.Вставить("Наставничество", Запрос.Выполнить().Выгрузить());
	
	ДанныеДляПроведения.Вставить("Наставничество", ДанныеДляПроведенияНаставничество);

КонецПроцедуры

Процедура ДополнитьДанныеДляПроведенияПоНаставничеству(Ссылка, ДанныеДляПроведения) Экспорт

	Если Не ИспользуетсяНаставничество() Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОНЕЦПЕРИОДА(УвольнениеНаставничество.ДатаОкончания, ДЕНЬ) КАК Период,
	|	УвольнениеНаставничество.Ссылка.Организация КАК Организация,
	|	УвольнениеНаставничество.Наставник КАК Наставник,
	|	УвольнениеНаставничество.Наставляемый КАК Наставляемый,
	|	ЛОЖЬ КАК Назначен,
	|	УвольнениеНаставничество.ДатаОкончания КАК ДатаОкончания,
	|	NULL КАК ДатаНачала,
	|	УвольнениеНаставничество.ДокументОснование КАК ДокументОснование,
	|	NULL КАК ПозицияРезерва,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(УвольнениеНаставничество.Наставник) = ТИП(Справочник.ФизическиеЛица)
	|			ТОГДА УвольнениеНаставничество.Наставник
	|		ИНАЧЕ ВЫРАЗИТЬ(УвольнениеНаставничество.Наставник КАК Справочник.Сотрудники).ФизическоеЛицо
	|	КОНЕЦ КАК ФизическоеЛицо
	|ИЗ
	|	Документ.Увольнение.Наставники КАК УвольнениеНаставничество
	|ГДЕ
	|	УвольнениеНаставничество.Ссылка = &Ссылка
	|	И УвольнениеНаставничество.Ссылка.ЗавершитьНаставничество
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КОНЕЦПЕРИОДА(УвольнениеСпискомНаставники.ДатаОкончания, ДЕНЬ),
	|	УвольнениеСпискомНаставники.Ссылка.Организация,
	|	УвольнениеСпискомНаставники.Наставник,
	|	УвольнениеСпискомНаставники.Наставляемый,
	|	ЛОЖЬ,
	|	УвольнениеСпискомНаставники.ДатаОкончания,
	|	NULL,
	|	УвольнениеСпискомНаставники.ДокументОснование,
	|	NULL,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(УвольнениеСпискомНаставники.Наставник) = ТИП(Справочник.ФизическиеЛица)
	|			ТОГДА УвольнениеСпискомНаставники.Наставник
	|		ИНАЧЕ ВЫРАЗИТЬ(УвольнениеСпискомНаставники.Наставник КАК Справочник.Сотрудники).ФизическоеЛицо
	|	КОНЕЦ
	|ИЗ
	|	Документ.УвольнениеСписком.Сотрудники КАК УвольнениеСпискомСотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УвольнениеСписком.Наставники КАК УвольнениеСпискомНаставники
	|		ПО УвольнениеСпискомСотрудники.Ссылка = УвольнениеСпискомНаставники.Ссылка
	|			И УвольнениеСпискомСотрудники.ИдентификаторСтрокиСотрудника = УвольнениеСпискомНаставники.ИдентификаторСтрокиСотрудника
	|ГДЕ
	|	УвольнениеСпискомНаставники.Ссылка = &Ссылка
	|	И УвольнениеСпискомСотрудники.ЗавершитьНаставничество
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВключениеВКадровыйРезерв.ДатаРассмотрения,
	|	ВЫБОР
	|		КОГДА НЕ ЕСТЬNULL(Организации.Ссылка, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	|				И ЕСТЬNULL(Организации.Ссылка, НЕОПРЕДЕЛЕНО) ССЫЛКА Справочник.Организации
	|				И НЕ ЕСТЬNULL(Организации.Ссылка, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Организации.Ссылка, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(ПодразделенияОрганизаций.Ссылка, НЕОПРЕДЕЛЕНО) КАК Справочник.ПодразделенияОрганизаций).Владелец
	|	КОНЕЦ,
	|	ВключениеВКадровыйРезервСотрудники.Наставник,
	|	ВключениеВКадровыйРезервСотрудники.УчастникКадровогоРезерва,
	|	ИСТИНА,
	|	ВключениеВКадровыйРезервСотрудники.ДатаОкончания,
	|	ВключениеВКадровыйРезерв.ДатаРассмотрения,
	|	ВключениеВКадровыйРезерв.Ссылка,
	|	ВключениеВКадровыйРезервСотрудники.ПозицияРезерва,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВключениеВКадровыйРезервСотрудники.Наставник) = ТИП(Справочник.ФизическиеЛица)
	|			ТОГДА ВключениеВКадровыйРезервСотрудники.Наставник
	|		ИНАЧЕ ВЫРАЗИТЬ(ВключениеВКадровыйРезервСотрудники.Наставник КАК Справочник.Сотрудники).ФизическоеЛицо
	|	КОНЕЦ
	|ИЗ
	|	Документ.ВключениеВКадровыйРезерв.Сотрудники КАК ВключениеВКадровыйРезервСотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВключениеВКадровыйРезерв КАК ВключениеВКадровыйРезерв
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
	|				ПО СтруктураПредприятия.Источник = ПодразделенияОрганизаций.Ссылка
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|				ПО СтруктураПредприятия.Источник = Организации.Ссылка
	|			ПО ВключениеВКадровыйРезерв.Подразделение = СтруктураПредприятия.Ссылка
	|		ПО ВключениеВКадровыйРезервСотрудники.Ссылка = ВключениеВКадровыйРезерв.Ссылка
	|ГДЕ
	|	ВключениеВКадровыйРезервСотрудники.Ссылка = &Ссылка
	|	И НЕ ВключениеВКадровыйРезервСотрудники.Наставник = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КОНЕЦПЕРИОДА(ИсключениеИзКадровогоРезерва.ДатаИсключения, ДЕНЬ),
	|	ВЫБОР
	|		КОГДА НЕ ЕСТЬNULL(Организации.Ссылка, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	|				И ЕСТЬNULL(Организации.Ссылка, НЕОПРЕДЕЛЕНО) ССЫЛКА Справочник.Организации
	|				И НЕ ЕСТЬNULL(Организации.Ссылка, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Организации.Ссылка, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(ПодразделенияОрганизаций.Ссылка, НЕОПРЕДЕЛЕНО) КАК Справочник.ПодразделенияОрганизаций).Владелец
	|	КОНЕЦ,
	|	ИсключениеИзКадровогоРезерваРезерв.Наставник,
	|	ИсключениеИзКадровогоРезерва.УчастникКадровогоРезерва,
	|	ЛОЖЬ,
	|	ИсключениеИзКадровогоРезерва.ДатаИсключения,
	|	NULL,
	|	ИсключениеИзКадровогоРезерваРезерв.ДокументОснование,
	|	ИсключениеИзКадровогоРезерваРезерв.ПозицияРезерва,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ИсключениеИзКадровогоРезерваРезерв.Наставник) = ТИП(Справочник.ФизическиеЛица)
	|			ТОГДА ИсключениеИзКадровогоРезерваРезерв.Наставник
	|		ИНАЧЕ ВЫРАЗИТЬ(ИсключениеИзКадровогоРезерваРезерв.Наставник КАК Справочник.Сотрудники).ФизическоеЛицо
	|	КОНЕЦ
	|ИЗ
	|	Документ.ИсключениеИзКадровогоРезерва.Резерв КАК ИсключениеИзКадровогоРезерваРезерв
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсключениеИзКадровогоРезерва КАК ИсключениеИзКадровогоРезерва
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодразделенияОрганизаций КАК ПодразделенияОрганизаций
	|				ПО СтруктураПредприятия.Источник = ПодразделенияОрганизаций.Ссылка
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|				ПО СтруктураПредприятия.Источник = Организации.Ссылка
	|			ПО ИсключениеИзКадровогоРезерва.Подразделение = СтруктураПредприятия.Ссылка
	|		ПО ИсключениеИзКадровогоРезерваРезерв.Ссылка = ИсключениеИзКадровогоРезерва.Ссылка
	|ГДЕ
	|	ИсключениеИзКадровогоРезерваРезерв.Ссылка = &Ссылка
	|	И НЕ ИсключениеИзКадровогоРезерваРезерв.Наставник = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|	И ИсключениеИзКадровогоРезерваРезерв.ЗавершитьНаставничество";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	ДанныеДляПроведенияНаставничество = Новый Структура("Наставничество", Запрос.Выполнить().Выгрузить());
	ДанныеДляПроведения.Вставить("Наставничество", ДанныеДляПроведенияНаставничество);

КонецПроцедуры

#КонецОбласти

#Область УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных
Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(Описание) Экспорт
	
	Описание = Описание + "
		|Документ.НазначениеНаставника.Чтение.ГруппыФизическихЛиц
		|Документ.НазначениеНаставника.Чтение.Организации
		|Документ.НазначениеНаставника.Изменение.ГруппыФизическихЛиц
		|Документ.НазначениеНаставника.Изменение.Организации
		|Справочник.НазначениеНаставникаПрисоединенныеФайлы.Чтение.ГруппыФизическихЛиц
		|Справочник.НазначениеНаставникаПрисоединенныеФайлы.Чтение.Организации
		|Справочник.НазначениеНаставникаПрисоединенныеФайлы.Изменение.ГруппыФизическихЛиц
		|Справочник.НазначениеНаставникаПрисоединенныеФайлы.Изменение.Организации
		|Документ.ПрекращениеНаставничества.Чтение.ГруппыФизическихЛиц
		|Документ.ПрекращениеНаставничества.Чтение.Организации
		|Документ.ПрекращениеНаставничества.Изменение.ГруппыФизическихЛиц
		|Документ.ПрекращениеНаставничества.Изменение.Организации
		|Справочник.ПрекращениеНаставничестваПрисоединенныеФайлы.Чтение.ГруппыФизическихЛиц
		|Справочник.ПрекращениеНаставничестваПрисоединенныеФайлы.Чтение.Организации
		|Справочник.ПрекращениеНаставничестваПрисоединенныеФайлы.Изменение.ГруппыФизическихЛиц
		|Справочник.ПрекращениеНаставничестваПрисоединенныеФайлы.Изменение.Организации
		|РегистрСведений.Наставничество.Чтение.ГруппыФизическихЛиц
		|РегистрСведений.Наставничество.Чтение.Организации
		|";
	
КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.Документы.НазначениеНаставника, Истина);
	Списки.Вставить(Метаданные.Документы.ПрекращениеНаставничества, Истина);

	Списки.Вставить(Метаданные.Справочники.НазначениеНаставникаПрисоединенныеФайлы, Истина);
	Списки.Вставить(Метаданные.Справочники.ПрекращениеНаставничестваПрисоединенныеФайлы, Истина);

	Списки.Вставить(Метаданные.РегистрыСведений.Наставничество, Истина);

КонецПроцедуры

#КонецОбласти

#Область ВариантыОтчетов

// Содержит настройки размещения вариантов отчетов в панели отчетов.
// Описание см. ЗарплатаКадрыВариантыОтчетов.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчетов(Настройки) Экспорт
	
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.ОтчетыПоНаставничеству);
	
КонецПроцедуры

#КонецОбласти

#Область ПодключаемыеКоманды

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту.
Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	
	Если Не ИспользуетсяНаставничество() Тогда 
		Возврат;
	КонецЕсли;
	
	Команда = Команды.Добавить();
	Команда.Вид = "Наставничество";
	Команда.Важность = "Обычное";
	Команда.Представление = НСтр("ru='История наставничества'");
	Команда.ВидимостьВФормах = "Наставничество";
	Команда.Обработчик = "НаставничествоКлиент.ОткрытьОтчетИсторияНаставничества";
	
	ВариантОтчета = ВариантыОтчетов.ВариантОтчета(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Отчеты.ОтчетыПоНаставничеству), "ИсторияНаставничества");
	Команда.ДополнительныеПараметры.Вставить("ВариантОтчета", ВариантОтчета);
	
КонецПроцедуры

#КонецОбласти

#Область ДатыЗапретаИзмененияДанных

Процедура ЗаполнитьИсточникиДанныхДляПроверкиЗапретаИзменения(ИсточникиДанных) Экспорт
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.НазначениеНаставника", "ДатаНачала", "ОбучениеРазвитие", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ПрекращениеНаставничества", "ДатаОкончания", "ОбучениеРазвитие", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.Наставничество", "Период", "ОбучениеРазвитие", "Организация");

КонецПроцедуры

#КонецОбласти

Функция ПредставлениеРазницыДатВГодахМесяцах(Дата1, Дата2) Экспорт
	
	Если Дата1 = Дата(1,1,1) ИЛИ Дата2 = Дата(1,1,1) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ФизическиеЛицаЗарплатаКадрыКлиентСервер.ПредставлениеВозраста(Дата1, Дата2);

КонецФункции

#Область ПервоначальноеЗаполнениеИОбновлениеИнформационнойБазы

// Добавляет в список Обработчики процедуры-обработчики обновления,
// необходимые данной подсистеме.
//
// Параметры:
//   Обработчики - ТаблицаЗначений - см. описание функции НоваяТаблицаОбработчиковОбновления
//                                   общего модуля ОбновлениеИнформационнойБазы.
//
Процедура ЗарегистрироватьОбработчикиОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.1.36.71";
	Обработчик.РежимВыполнения = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ОсновнойРежимВыполненияОбновления();
	Обработчик.Процедура = "Наставничество.ЗаполнитьРеквизитФизическоеЛицоДокументовНаставничества";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("200b607b-79fe-4da9-b5e7-2cc78e84c991");
	
КонецПроцедуры
	
Процедура ЗаполнитьРеквизитФизическоеЛицоДокументовНаставничества(ПараметрыОбновления = Неопределено) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НазначениеНаставника.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НазначениеНаставника КАК НазначениеНаставника
	|ГДЕ
	|	НазначениеНаставника.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)";
	
	ОписаниеБлокировкиДокумента = ОбновлениеИБ.ОписаниеБлокируемыхДанных(Метаданные.Документы.НазначениеНаставника);
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);

	Если НЕ ОбновляемыеДанные.Пустой() Тогда
		
