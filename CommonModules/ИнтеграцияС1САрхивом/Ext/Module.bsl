Функция ПолучитьИмяФайлаДляАрхива(ИмяФайла, ПереводитьИменаФайловВТранслит) Экспорт
	
	Результат = ИмяФайла;
	
	Если ПереводитьИменаФайловВТранслит Тогда
		Результат = СтроковыеФункции.СтрокаЛатиницей(Результат);
	КонецЕсли;
	
	Возврат Результат + ".zip";
	
КонецФункции

Функция ИмяФайлаСохраненияОтчета(НазваниеПечатнойФормы, Организация = Неопределено, ПериодОтчета = Неопределено) Экспорт
	
	ПараметрыДляВставки = Новый Структура;
	ПараметрыДляВставки.Вставить("НазваниеПечатнойФормы",НазваниеПечатнойФормы);
	Шаблон = НСтр("ru = '[НазваниеПечатнойФормы]'");
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыДляВставки.Вставить("Организация", Организация);
		Шаблон = НСтр("ru = '[НазваниеПечатнойФормы] - [Организация]'");
	КонецЕсли;
	ПараметрыДляВставки.Вставить("Организация", Организация);
	Если ТипЗнч(ПериодОтчета) = Тип("Дата") Тогда
		ПараметрыДляВставки.Вставить("ДатаОтчета",Формат(ПериодОтчета, "ДФ=dd.MM.yy"));
		Шаблон = НСтр("ru = '[НазваниеПечатнойФормы] - [Организация] - [ДатаОтчета]'");
	ИначеЕсли ТипЗнч(ПериодОтчета) = Тип("СтандартныйПериод") Тогда
		ПараметрыДляВставки.Вставить("ДатаНачала",Формат(ПериодОтчета.ДатаНачала, "ДФ=dd.MM.yy"));
		ПараметрыДляВставки.Вставить("ДатаОкончания",Формат(ПериодОтчета.ДатаОкончания, "ДФ=dd.MM.yy"));
		Шаблон = НСтр("ru = '[НазваниеПечатнойФормы] - [Организация] ([ДатаНачала]-[ДатаОкончания])'");
	КонецЕсли;
	
	Результат = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыДляВставки);
	
	Если ОбщегоНазначения.ЭтоLinuxСервер() И СтрДлина(Результат) > 120 Тогда
		СокращаемоеПоле = "НазваниеПечатнойФормы";
		ПараметрыДляВставки[СокращаемоеПоле] = Лев(ПараметрыДляВставки[СокращаемоеПоле],
		СтрДлина(ПараметрыДляВставки[СокращаемоеПоле]) - (СтрДлина(Результат) - 117)) + "...";
		Результат = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыДляВставки);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ВычислитьИспользованиеВывода(ТабличныйДокумент) Экспорт
	Если ТабличныйДокумент.Вывод = ИспользованиеВывода.Авто Тогда
		Возврат ?(ПравоДоступа("Вывод", Метаданные), ИспользованиеВывода.Разрешить, ИспользованиеВывода.Запретить);
	Иначе
		Возврат ТабличныйДокумент.Вывод;
	КонецЕсли;
КонецФункции

Функция ПоместитьФайлыВАрхив(Знач ПечатныеФормыДокументов, ПараметрыЗаписи, ПереданныеНастройки, НастройкиСохранения) Экспорт
	Перем ЗаписьZipФайла, ИмяАрхива;
	
	Результат = Новый Массив;
	
	ВариантСохранения = Неопределено;
	ПереданныеНастройки.Свойство("ВариантСохранения", ВариантСохранения);
	УстанавливатьОбъектПечати = ВариантСохранения = "Присоединить";
	
	ПереводитьИменаФайловВТранслит = НастройкиСохранения.ПереводитьИменаФайловВТранслит;
	
	ИмяВременногоКаталога = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
	СоздатьКаталог(ИмяВременногоКаталога);
	
	СоответствиеДляАрхивов = Новый Соответствие;
		
	Для Каждого СтруктураФайла Из ПечатныеФормыДокументов Цикл
			
		ДанныеФайла = ПолучитьИзВременногоХранилища(СтруктураФайла.АдресВоВременномХранилище);
		ПолноеИмяФайла = ИмяВременногоКаталога + СтруктураФайла.Представление;
		ПолноеИмяФайла = ФайловаяСистема.УникальноеИмяФайла(ПолноеИмяФайла);
		ДанныеФайла.Записать(ПолноеИмяФайла);
		
		ОбъектПечати = ?(УстанавливатьОбъектПечати, СтруктураФайла.ОбъектПечати, Неопределено);
		
		Если СоответствиеДляАрхивов[ОбъектПечати] = Неопределено Тогда
			ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
			ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхива);
			ПараметрыЗаписиАрхива = Новый Структура("ЗаписьZipФайла, ИмяАрхива, ИмяФайла", ЗаписьZipФайла, ИмяАрхива, СтруктураФайла.ИмяФайла);
			СоответствиеДляАрхивов.Вставить(ОбъектПечати, ПараметрыЗаписиАрхива);
		КонецЕсли;
		
		СоответствиеДляАрхивов[ОбъектПечати].ЗаписьZipФайла.Добавить(ПолноеИмяФайла);

	КонецЦикла;
		
	Для Каждого АрхивОбъекта Из СоответствиеДляАрхивов Цикл
		ЗаписьZipФайла = АрхивОбъекта.Значение.ЗаписьZipФайла;
		ИмяАрхива = АрхивОбъекта.Значение.ИмяАрхива;
		ЗаписьZipФайла.Записать();
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяАрхива);
		ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ПараметрыЗаписи.УникальныйИдентификаторХранилища);
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("Представление", ИнтеграцияС1САрхивом.ПолучитьИмяФайлаДляАрхива(АрхивОбъекта.Значение.ИмяФайла, ПереводитьИменаФайловВТранслит));
		ОписаниеФайла.Вставить("ОбъектПечати", АрхивОбъекта.Ключ);
		ОписаниеФайла.Вставить("АдресВоВременномХранилище", ПутьВоВременномХранилище);
		Результат.Добавить(ОписаниеФайла);
		УдалитьФайлы(ИмяАрхива);
	КонецЦикла;
		
	УдалитьФайлы(ИмяВременногоКаталога);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СведенияОФайлах

Процедура ЗадатьИмяФайлаПечатнойФормы(ИмяФайлаПечатнойФормы, НазваниеПечатнойформы, ОбъектыПечати) Экспорт

	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаФайловПечатныхФорм = Новый Соответствие;
	Для Каждого ОбъектПечати Из ОбъектыПечати Цикл
		Если ТипЗнч(ОбъектПечати) = Тип("СправочникСсылка.Сотрудники") Тогда
			Если Не ОбъектПечати.Пустая() Тогда
				ИменаФайловПечатныхФорм.Вставить(ОбъектПечати.ФизическоеЛицо, УправлениеПечатью.ИмяФайлаПечатнойФормыОбъекта(ОбъектПечати,,НазваниеПечатнойформы));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ИменаФайловПечатныхФорм.Количество() = 0 Тогда
		ИмяФайлаПечатнойФормы = ОбщегоНазначения.СкопироватьРекурсивно(ИменаФайловПечатныхФорм);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(КомпоновщикНастроек, Имя)
	
	Настройки = КомпоновщикНастроек.Настройки;
	ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Имя));
	Если Параметр <> Неопределено Тогда
		Если ТипЗнч(Параметр.Значение) = Тип("СтандартныйПериод") Тогда
			Возврат Параметр.Значение.ДатаОкончания;
		Иначе
			Возврат Параметр.Значение;
		КонецЕсли;
	КонецЕсли;
	
	ЭлементыОтбора = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(Настройки.Отбор, Имя);
	МассивИдентификаторов = Новый Массив;
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		МассивИдентификаторов.Добавить(ЭлементОтбора.ИдентификаторПользовательскойНастройки);
		Если ЭлементОтбора.Использование И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
			Возврат ЭлементОтбора.ПравоеЗначение;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого  ИдентификаторПользовательскойНастройки Из МассивИдентификаторов Цикл
		ЭлементПользовательскихНастроек = ПользовательскиеНастройки.Элементы.Найти(ИдентификаторПользовательскойНастройки);
		Если ТипЗнч(ЭлементПользовательскихНастроек) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если ЭлементПользовательскихНастроек.Использование И ЗначениеЗаполнено(ЭлементПользовательскихНастроек.ПравоеЗначение) Тогда
				Возврат ЭлементПользовательскихНастроек.ПравоеЗначение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаписатьСведения1САрхив(Сведения1САрхив) Экспорт
	
	ПараметрыЗаписи = РегистрыСведений.СведенияОФайлах1САрхив.ПараметрыРегистрацииСведенийОФайле();
	ЗаполнитьЗначенияСвойств(ПараметрыЗаписи, Сведения1САрхив);
	РегистрыСведений.СведенияОФайлах1САрхив.ЗарегистрироватьСведенияОФайле(ПараметрыЗаписи);
	
КонецПроцедуры

Процедура ПриПечати(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
				
	Для Каждого ОбъектПечати Из ОбъектыПечати Цикл
		Если ТипЗнч(ОбъектПечати.Значение) = Тип("СправочникСсылка.Сотрудники") Тогда
			ОбъектПечати.Значение = ОбъектПечати.Значение.ФизическоеЛицо;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзменитьСведенияОФайле(Файлы, ДополнительныеПараметры) Экспорт

	Форма = ДополнительныеПараметры.Форма;
	ФайлОбъект = Форма.РеквизитФормыВЗначение("Объект");
	ФайлСсылка = ФайлОбъект.Ссылка;

	Если ЗначениеЗаполнено(ФайлСсылка) Тогда

		ТекущиеСведения = РегистрыСведений.СведенияОФайлах1САрхив.СведенияОФайлеДляВыгрузкиВАрхив(ФайлСсылка, Истина);
		ПараметрыРегистрации = РегистрыСведений.СведенияОФайлах1САрхив.ПараметрыРегистрацииСведенийОФайле();
		ПараметрыРегистрации.Файл = ФайлСсылка;
		ЗаполнитьЗначенияСвойств(ПараметрыРегистрации, ТекущиеСведения, "ВидДокументаБИА, НеВыгружать, ИдентификаторПечатнойФормы, Сотрудник");
		ПараметрыРегистрации.Организация = ТекущиеСведения.ОрганизацияРегистр;
		ПараметрыРегистрации.Номер = ТекущиеСведения.НомерРегистр;
		ПараметрыРегистрации.Дата = ТекущиеСведения.ДатаРегистр;
		
		ЗаписатьИзменениеСведений = Ложь;
		
		Если ТекущиеСведения.ВидДокументаБИА <> Форма.ВидДокументаБИА Тогда
			ЗаписатьИзменениеСведений = Истина;
			ПараметрыРегистрации.ВидДокументаБИА = Форма.ВидДокументаБИА;
		КонецЕсли;

		ЗначениеРеквизитаФормы = Форма[ОписаниеЭлементовСведенияОФайле1САрхив().ИзменитьНеВыгружатьВ1САрхив.ИмяРеквизитаФормы];
		Если ТекущиеСведения.НеВыгружать <> ЗначениеРеквизитаФормы Тогда
			ЗаписатьИзменениеСведений = Истина;
			ПараметрыРегистрации.НеВыгружать = ЗначениеРеквизитаФормы;
		КонецЕсли;

		Если ТекущиеСведения.Организация <> Форма.ОрганизацияБИА И ТекущиеСведения.ОрганизацияРегистр <> Форма.ОрганизацияБИА Тогда
			ЗаписатьИзменениеСведений = Истина;
			ПараметрыРегистрации.Организация = Форма.ОрганизацияБИА;
		КонецЕсли;

		Если ТекущиеСведения.Номер <> Форма.НомерБИА И ТекущиеСведения.НомерРегистр <> Форма.НомерБИА Тогда
			ЗаписатьИзменениеСведений = Истина;
			ПараметрыРегистрации.Номер = Форма.НомерБИА;
		КонецЕсли;
		
		Если ТекущиеСведения.Дата <> Форма.ДатаБИА И ТекущиеСведения.ДатаРегистр <> Форма.ДатаБИА Тогда
			ЗаписатьИзменениеСведений = Истина;
			ПараметрыРегистрации.Дата = Форма.ДатаБИА;
		КонецЕсли;
		
		Если ЗаписатьИзменениеСведений Тогда
			РегистрыСведений.СведенияОФайлах1САрхив.ЗарегистрироватьСведенияОФайле(ПараметрыРегистрации);
			СведенияОФайле = РегистрыСведений.СведенияОФайлах1САрхив.СведенияОФайлеДляВыгрузкиВАрхив(ФайлСсылка, Истина);
			УстановитьСвойстваЭлементовДляВыгрузкиВ1САрхив(Форма, ФайлСсылка, СведенияОФайле);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Функция КадровыеДанныеСотрудника(Период, Знач Сотрудник, Организация = Неопределено) Экспорт
	
	КадровыеДанные = 
	"ФизическоеЛицо,
	|ТрудовойДоговорНомер,
	|ТрудовойДоговорДата,
	|Сотрудник,
	|Подразделение,
	|Организация,
	|Должность";
	Результат = Новый Структура(КадровыеДанные);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Если ТипЗнч(Сотрудник) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		
		ПараметрыСбораДанных = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
		ПараметрыСбораДанных.Организация = Организация;
		ПараметрыСбораДанных.РаботникиПоТрудовымДоговорам = Истина;
		ПараметрыСбораДанных.РаботникиПоДоговорамГПХ = Ложь;
		ПараметрыСбораДанных.НачалоПериода = Период;
		ПараметрыСбораДанных.ОкончаниеПериода = Период;
		ПараметрыСбораДанных.ПодработкиРаботниковПоТрудовымДоговорам = Ложь;
		ПараметрыСбораДанных.СписокФизическихЛиц = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник);
		ПараметрыСбораДанных.КадровыеДанные = "ВидЗанятости";
		
		КадровыйУчет.СоздатьВТСотрудникиОрганизации(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыСбораДанных , "ВТСписокСотрудниковОрганизации");
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СписокСотрудников.Сотрудник КАК Сотрудник
		|ИЗ
		|	ВТСписокСотрудниковОрганизации КАК СписокСотрудников
		|ГДЕ
		|	СписокСотрудников.ВидЗанятости В (ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.ОсновноеМестоРаботы), ЗНАЧЕНИЕ(Перечисление.ВидыЗанятости.Совместительство))";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Сотрудник = Выборка.Сотрудник;
		Иначе
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&Сотрудник КАК Сотрудник,
	|	&Период КАК Период
	|ПОМЕСТИТЬ ВТСотрудники";
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Выполнить();
	
	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(
			Запрос.МенеджерВременныхТаблиц,
			"ВТСотрудники");
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыРасширеннаяПодсистемы.УправлениеШтатнымРасписанием") Тогда
		КадровыеДанные = КадровыеДанные + ",ДолжностьПоШтатномуРасписанию";
	КонецЕсли;

	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВременныхТаблиц, Истина, КадровыеДанные);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
	|	КадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	|	КадровыеДанныеСотрудников.Подразделение КАК Подразделение,
	|	КадровыеДанныеСотрудников.Должность КАК Должность,
	|	КадровыеДанныеСотрудников.Должность КАК ДолжностьПоШтатномуРасписанию,
	|	КадровыеДанныеСотрудников.ТрудовойДоговорНомер КАК ТрудовойДоговорНомер,
	|	КадровыеДанныеСотрудников.ТрудовойДоговорДата КАК ТрудовойДоговорДата
	|ИЗ
	|	ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников";
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыРасширеннаяПодсистемы.УправлениеШтатнымРасписанием") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КадровыеДанныеСотрудников.Должность КАК ДолжностьПоШтатномуРасписанию", "КадровыеДанныеСотрудников.ДолжностьПоШтатномуРасписанию КАК ДолжностьПоШтатномуРасписанию");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);

		Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ОрганизационнаяСтруктура") Тогда
			МодульОрганизационнаяСтруктура = ОбщегоНазначения.ОбщийМодуль("ОрганизационнаяСтруктура");
			Результат.Подразделение = МодульОрганизационнаяСтруктура.ПодразделениеВСтруктуреПредприятия(Результат.Подразделение);
		ИначеЕсли ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы.ИнтеграцияУправлениеПерсоналом") Тогда
			МодульИнтеграцияУправлениеПерсоналом = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияУправлениеПерсоналом");
			Результат.Подразделение = МодульИнтеграцияУправлениеПерсоналом.ПодразделениеВСтруктуреПредприятия(Результат.Подразделение);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеТрудовогоДоговора(СсылкаНаДокумент, Сотрудник) Экспорт
	
	Возврат ИнтеграцияС1САрхивомВнутренний.ДанныеТрудовогоДоговора(СсылкаНаДокумент, Сотрудник);
	
КонецФункции

