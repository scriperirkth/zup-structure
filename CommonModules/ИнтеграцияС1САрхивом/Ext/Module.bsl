Функция ТаблицаДокументовБИА(ОснованиеСсылка, Форма)
	
	ТаблицаДокументовБИА = Неопределено;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Параметры, "Ключ")
		И Не ЗначениеЗаполнено(Форма.Параметры.Ключ) Тогда
		Возврат ТаблицаДокументовБИА;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
		МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");
		ТаблицаДокументовБИА = МодульОбменСАрхивом.ТаблицаДокументовБИА(ОснованиеСсылка);
	КонецЕсли;
	
	Возврат ТаблицаДокументовБИА;
	
КонецФункции

#КонецОбласти

#Область СохранениеВариантовОтчетов

Функция ЗаполнитьПараметрыИзКомпоновщикаНастроек(ПараметрыЗаписи) Экспорт
	
	ПериодОтчета = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "ПериодОтчета");
	Если Не ЗначениеЗаполнено(ПериодОтчета) Тогда
		ПериодОтчета = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "Период");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПериодОтчета) Тогда
		ПериодОтчета = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "Дата");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПериодОтчета) Тогда
		ПериодОтчета = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "ДатаОтчета");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПериодОтчета) Тогда
		ПериодОтчета = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "КонецПериода");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПериодОтчета) Тогда
		ПериодОтчета = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "ПериодРасчета");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПериодОтчета) Тогда
		ПериодОтчета = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "ПериодНалоговый");
	КонецЕсли;
	ПараметрыЗаписи.Вставить("Период", ПериодОтчета);
	
	Организация = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "Организация");
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = НайтиЗначениеПараметраОтбораНастроекКомпоновкиДанных(ПараметрыЗаписи.КомпоновщикНастроек, "ГоловнаяОрганизация");
	КонецЕсли;
	ПараметрыЗаписи.Вставить("Организация", Организация);
	
КонецФункции

