#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗарегистрироватьДанныеДляВыгрузки");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Добавляет в список Обработчики процедуры-обработчики обновления,
// необходимые данной подсистеме.
//
// Параметры:
//   Обработчики - ТаблицаЗначений - см. описание функции НоваяТаблицаОбработчиковОбновления
//                                   общего модуля ОбновлениеИнформационнойБазы.
// 
Процедура ЗарегистрироватьОбработчикиОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.1.35.65";
	Обработчик.РежимВыполнения = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ОсновнойРежимВыполненияОбновления();
	Обработчик.Процедура = "ИнтеграцияС1САрхивом.ЗарегистрироватьДанныеДляВыгрузки";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("4a28d47d-9598-4f3a-92ac-2c9409439dcd");
	Обработчик.Комментарий = НСтр("ru = 'Зарегистрировать НСИ для выгрузки в 1С:Архив.'");
	
КонецПроцедуры

// См. РегламентныеЗаданияПереопределяемый.ПриОпределенииНастроекРегламентныхЗаданий
Процедура ПриОпределенииНастроекРегламентныхЗаданий(Настройки) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
		МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");
		МодульОбменСАрхивом.ПриОпределенииНастроекРегламентныхЗаданий(Настройки);
	КонецЕсли;
	
КонецПроцедуры

#Область ПодключаемыеКоманды

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииВидовПодключаемыхКоманд.
Процедура ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли; 
	
	Вид = ВидыПодключаемыхКоманд.Добавить();
	Вид.Имя = ИмяВидаКомандИнтеграцияС1САрхивом();
	Вид.ИмяПодменю = ИмяПодменюИнтеграцияС1САрхивом();
	Вид.Заголовок = НСтр("ru = '1C:Архив'");
	Вид.Картинка = БиблиотекаКартинок.Архив48;
	Вид.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
КонецПроцедуры

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту.
Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКомандыОтправитьВ1САрхив = ИмяКомандыОтправитьВ1САрхив();
	ИмяКомандыОтменитьОтправкуВ1САрхив = ИмяКомандыОтменитьОтправкуВ1САрхив();
	
	ТипИсточника = Неопределено;
	Если ТипЗнч(Источники) = Тип("ДеревоЗначений") Тогда
		Если Источники.Строки.Количество()>0 Тогда
			ТипИсточника = Источники.Строки[0].ТипСсылкиДанных;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипИсточника = Неопределено Или ТипЗнч(ТипИсточника) <> Тип("Тип") Тогда
		Возврат;
	КонецЕсли;
	
	ТипВладельцаФайла = Неопределено;
	СсылкаНаОбъект = Новый(ТипИсточника);
	Если СсылкаНаОбъект.Метаданные().Реквизиты.Найти("Владелецфайла") <> Неопределено Тогда
		ТипВладельцаФайла = ТипЗнч(СсылкаНаОбъект.ВладелецФайла);
	КонецЕсли;
	
	Если Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипИсточника) ИЛИ НастройкиФормы.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		Если Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.СодержитТип(ТипИсточника) Тогда
			
			Если НастройкиФормы.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
				ИмяРеквизитаВидимостиКоманды = "Ссылка";
			Иначе
				ИмяРеквизитаВидимостиКоманды = "ВладелецФайла";
			КонецЕсли;
			
			ПредставленияКоманд = ПредставленияКомандВыгрузкиВАрхив();
			
			// Отправить в 1С:Архив - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.Отправить;
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивомКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтправитьВ1САрхив);
			ИмяКомандыСервер = СтрШаблон(НСтр("ru = '%1Обычное__%2'"),ИмяПодменюИнтеграцияС1САрхивом(), ИмяКомандыОтправитьВ1САрхив);
			Команда.ДополнительныеПараметры.Вставить("ИмяКомандыСервер", ИмяКомандыСервер);
			
			// Отправить в 1С:Архив - сервер.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивом.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтправитьВ1САрхив);
			Команда.Идентификатор = ИмяКомандыОтправитьВ1САрхив;
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда, ИмяРеквизитаВидимостиКоманды);
			
			// Отменить отправку в 1С:Архив - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.Отменить;
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивомКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтменитьОтправкуВ1САрхив);
			ИмяКомандыСервер = СтрШаблон(НСтр("ru = '%1Обычное__%2'"),ИмяПодменюИнтеграцияС1САрхивом(), ИмяКомандыОтменитьОтправкуВ1САрхив);
			Команда.ДополнительныеПараметры.Вставить("ИмяКомандыСервер", ИмяКомандыСервер);
			
			// Отменить отправку в 1С:Архив - сервер.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивом.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтменитьОтправкуВ1САрхив);
			Команда.Идентификатор = ИмяКомандыОтменитьОтправкуВ1САрхив;
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда, ИмяРеквизитаВидимостиКоманды);
			
			// Отозвать - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.Отозвать;
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивомКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтозватьИз1САрхива());
			ИмяКомандыСервер = СтрШаблон(НСтр("ru = '%1Обычное__%2'"),ИмяПодменюИнтеграцияС1САрхивом(), ИмяКомандыОтозватьИз1САрхива());
			Команда.ДополнительныеПараметры.Вставить("ИмяКомандыСервер", ИмяКомандыСервер);
			
			// Отозвать - сервер.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивом.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтозватьИз1САрхива());
			Команда.Идентификатор = ИмяКомандыОтозватьИз1САрхива();
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда, ИмяРеквизитаВидимостиКоманды);
			
			// История обмена с 1С:Архивом - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.История;
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивомКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыИсторияОбмена());
			
			// Нажатие - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Идентификатор = ИмяЭлементаДокументБИА();
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивомКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", "Нажатие");
			
			// Скачать контейнер - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.Скачать;
			Команда.Идентификатор = "СкачатьКонтейнерДокументаИз1САрхива";
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента,РегламентированнаяОтчетность";
			Команда.Обработчик = "ИнтеграцияС1САрхивомКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", "СкачатьКонтейнерДокументаИз1САрхива0");
			
		КонецЕсли;
		
		Если Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.СодержитТип(ТипИсточника)
			Или Не ТипВладельцаФайла = Неопределено И Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.СодержитТип(ТипВладельцаФайла)
			Или ТипВладельцаФайла = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			
			ИдентификаторКомандыСервер = ИдентификаторКомандыИзменитьСведенияОФайле1САрхив();
			ИмяКомандыСервер = СтрШаблон(НСтр("ru = '%1СмТакже__%2'"),ИмяПодменюИнтеграцияС1САрхивом(), ИдентификаторКомандыСервер);
			
			Команда = Команды.Добавить();
			Команда.Важность = "СмТакже";
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Идентификатор = ИдентификаторКомандыСервер;
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента";
			Команда.Обработчик = "ИнтеграцияС1САрхивом.ИзменитьСведенияОФайле";
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда, "ВладелецФайла", "");
			
			Для Каждого ОписаниеЭлемента Из ОписаниеЭлементовСведенияОФайле1САрхив() Цикл
				Команда = Команды.Добавить();
				Команда.Важность = "СмТакже";
				Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
				Команда.ИзменяетВыбранныеОбъекты = Истина;
				Команда.РежимЗаписи = "НеЗаписывать";
				Команда.Идентификатор = ОписаниеЭлемента.Ключ;
				Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
				Команда.ВидимостьВФормах = "ПрисоединенныйФайл,ФормаЭлемента";
				Команда.Обработчик = "ИнтеграцияС1САрхивомКлиент.ВыполнитьКомандуИзменитьСведенияОФайле";
				Команда.ДополнительныеПараметры.Вставить("ИмяКомандыСервер", ИмяКомандыСервер);
				Команда.ДополнительныеПараметры.Вставить("ИмяРеквизитаФормы", ОписаниеЭлемента.Значение.ИмяРеквизитаФормы);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Формы

// См. ОтчетыПереопределяемый.ПриСозданииНаСервере.
Процедура ПриСозданииНаСервереФормыОтчета(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ПолучитьФункциональнуюОпцию("ИнтеграцияС1САрхивом") Тогда
		Возврат;
	КонецЕсли; 
	
	Если ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения") Тогда
		
		КлючВарианта = Неопределено;
		
		Если Форма.Параметры.Свойство("КлючВарианта", КлючВарианта) И ЗначениеЗаполнено(КлючВарианта) Тогда
			
			КомандаФормы = Форма.Команды.Добавить("СохранитьВФайлыИПодписать");
			КомандаФормы.Действие = "Подключаемый_Команда";
			КомандаФормы.Заголовок = НСтр("ru = 'Сохранить в файлы'");
			КомандаФормы.Подсказка = НСтр("ru = 'Сохранить в файлы и подписать'");
			КомандаФормы.Картинка = БиблиотекаКартинок.СохранитьФайл;
			
			ГруппаФормы = Форма.Элементы.Вставить(КомандаФормы.Имя + "Группа", Тип("ГруппаФормы"),
			Форма.Элементы.ОсновнаяКоманднаяПанель, Форма.Элементы.ГруппаВывод);
			ГруппаФормы.Вид = ВидГруппыФормы.ГруппаКнопок;
			
			КнопкаФормы = Форма.Элементы.Добавить(КомандаФормы.Имя, Тип("КнопкаФормы"), ГруппаФормы);
			
			КнопкаФормы.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			КнопкаФормы.ИмяКоманды = КомандаФормы.Имя;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. РаботаСФайламиПереопределяемый.ПриСозданииФормыСпискаФайлов.
Процедура ПриСозданииФормыСпискаФайлов(Форма) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	ПриСозданииНаСервереФормыСписка(Форма);
	
	ПриСозданииНаСервереФормыСпискаФайлов(Форма);

КонецПроцедуры

// См. РаботаСФайламиПереопределяемый.ПриСозданииФормыЭлементаФайлов.
Процедура ПриСозданииФормыЭлементаФайлов(Форма) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
		МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");
		МодульОбменСАрхивом.ПриСозданииНаСервере(Форма);
	КонецЕсли;
	
	УстановитьВидимостьИДоступностьКоманд(Форма);
	
КонецПроцедуры

// См. РегламентированнаяОтчетностьПереопределяемый.ФормаРегламентированнойОтчетности_ПриСозданииНаСервере.
Процедура ФормаРегламентированнойОтчетности_ПриСозданииНаСервере(Форма) Экспорт
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
		МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");
		ПараметрыРазмещения = МодульОбменСАрхивом.ПараметрыРазмещенияЭлементов();
		ПараметрыРазмещения.ИмяСписка = "Отчеты";
		МодульОбменСАрхивом.ПриСозданииНаСервере(Форма,ПараметрыРазмещения);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаВАрхив

// См. ОбменСАрхивомПереопределяемый.ПриСозданииНаСервере.
Процедура ПриСозданииНаСервере(Форма, ПараметрыРазмещения, ЭтоФормаОбъекта) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		
		НовыйРеквизитФормы = Новый РеквизитФормы("АдресБланкаPDFВоВременномХранилище", Новый ОписаниеТипов("СписокЗначений"));
		Если Форма.ПолучитьРеквизиты().Найти(НовыйРеквизитФормы) = Неопределено Тогда
			ДобавляемыеРеквизиты = Новый Массив;
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
			Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		КонецЕсли;
		
	ИначеЕсли ДоступноИзменениеСведенийОФайлах1САрхив() И (Форма.ИмяФормы = "Обработка.РаботаСФайлами.Форма.ПрисоединенныйФайл"
		ИЛИ Форма.ИмяФормы = "Справочник.Файлы.Форма.ФормаЭлемента") Тогда
		
		Файл = Форма.Объект.Ссылка;
		
		СведенияОФайле = РегистрыСведений.СведенияОФайлах1САрхив.СведенияОФайлеДляВыгрузкиВАрхив(Файл, Истина);
		
		Если Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипЗнч(Файл)) 
			И (Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.СодержитТип(ТипЗнч(Файл.ВладелецФайла))
			ИЛИ Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.СодержитТип(ТипЗнч(Файл))
			ИЛИ ТипЗнч(Файл.ВладелецФайла) = Тип("СправочникСсылка.ФизическиеЛица")) Тогда
			
			ГруппаДополнительныеДанныеСтраницы = Форма.Элементы.Найти("ГруппаДополнительныеДанныеСтраницы");
			Если ГруппаДополнительныеДанныеСтраницы <> Неопределено Тогда
				
				Группа1САрхивСтраница = Форма.Элементы.Найти("Группа1САрхивСтраница");
				Если Группа1САрхивСтраница = Неопределено Тогда
					Группа1САрхивСтраница = Форма.Элементы.Вставить("Группа1САрхивСтраница", Тип("ГруппаФормы"), ГруппаДополнительныеДанныеСтраницы);
				КонецЕсли;
				
				Группа1САрхивСтраница.Вид = ВидГруппыФормы.Страница;
				Группа1САрхивСтраница.Заголовок = "1С:Архив";
				Группа1САрхивСтраница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
				Группа1САрхивСтраница.ВыравниваниеЭлементовИЗаголовков = ВариантВыравниванияЭлементовИЗаголовков.ЭлементыПравоЗаголовкиЛево;
				
				Группа1САрхивСведения = Форма.Элементы.Найти("Группа1САрхивСведения");
				Если Группа1САрхивСведения = Неопределено Тогда
					Группа1САрхивСведения = Форма.Элементы.Вставить("Группа1САрхивСведения", Тип("ГруппаФормы"), Группа1САрхивСтраница);
				КонецЕсли;
				Группа1САрхивСведения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
				Группа1САрхивСведения.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
				Группа1САрхивСведения.ОтображатьЗаголовок = Ложь;
				Группа1САрхивСведения.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
				Группа1САрхивСведения.ВыравниваниеЭлементовИЗаголовков = ВариантВыравниванияЭлементовИЗаголовков.ЭлементыПравоЗаголовкиЛево;
				
				РеквизитыФормы = Форма.ПолучитьРеквизиты();
				ДобавляемыеРеквизиты = Новый Массив;
				
				Для Каждого ОписаниеЭлемента Из ОписаниеЭлементовСведенияОФайле1САрхив() Цикл
					
					ИмяРеквизитаФормы = ОписаниеЭлемента.Значение.ИмяРеквизитаФормы;
					НовыйРеквизитФормы = Новый РеквизитФормы(ИмяРеквизитаФормы, ОписаниеЭлемента.Значение.ОписаниеТипа);
					Если РеквизитыФормы.Найти(НовыйРеквизитФормы) = Неопределено Тогда
						ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
					КонецЕсли;
					
					ИмяНадписи = ОписаниеЭлемента.Значение.ИмяНадписи;
					
					НаименованиеГруппы = "Группа1САрхив"+ИмяНадписи;
					НоваяГруппа = Форма.Элементы.Найти(НаименованиеГруппы);
					Если НоваяГруппа = Неопределено Тогда
						НоваяГруппа = Форма.Элементы.Вставить(НаименованиеГруппы, Тип("ГруппаФормы"), Группа1САрхивСведения);
					КонецЕсли;
					НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
					НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
					НоваяГруппа.ОтображатьЗаголовок = Ложь;
					НоваяГруппа.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
					НоваяГруппа.ВыравниваниеЭлементовИЗаголовков = ВариантВыравниванияЭлементовИЗаголовков.ЭлементыПравоЗаголовкиЛево;
					
					Если ИмяНадписи <> "" Тогда
						ЗаголовокНадписи = ОписаниеЭлемента.Значение.Надпись;
						НоваяНадпись = Форма.Элементы.Найти("ИмяНадписи");
						Если НоваяНадпись = Неопределено Тогда
							НоваяНадпись = Форма.Элементы.Вставить(ИмяНадписи, Тип("ДекорацияФормы"), НоваяГруппа);
						КонецЕсли;
						НоваяНадпись.Вид = ВидДекорацииФормы.Надпись;
						НоваяНадпись.Заголовок = ЗаголовокНадписи;
					КонецЕсли;
					
				КонецЦикла;
				
				Если ДобавляемыеРеквизиты.Количество()>0 Тогда
					Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
				КонецЕсли;
				
				ТаблицаДокументовБИА = ТаблицаДокументовБИА(Файл.ВладелецФайла, Форма);

				УстановитьСвойстваЭлементовДляВыгрузкиВ1САрхив(Форма, Файл, СведенияОФайле, ТаблицаДокументовБИА = Неопределено ИЛИ ТаблицаДокументовБИА.Количество() = 0);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.ПриСозданииДокументовБИА.
Процедура СоздатьДокументыБИА(СсылкаНаОбъектИсточник, ДокументыБИА) Экспорт
	
	ИнтеграцияС1САрхивомВнутренний.СоздатьДокументыБИА(СсылкаНаОбъектИсточник, ДокументыБИА);
	
КонецПроцедуры

// См.ОбменСАрхивомПереопределяемый.ОбновитьВидыДокументовПриОбновленииКонфигурации.
//
Процедура ОбновитьВидыДокументовПриОбновленииКонфигурации(ПараметрОбработчика) Экспорт
	
	ИнтеграцияС1САрхивомВнутренний.ОбновитьВидыДокументовПриОбновленииКонфигурации(ПараметрОбработчика);

КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.ПроверитьГотовностьДокументаКОтправке.
Процедура ПроверитьГотовностьДокументаКОтправке(Ссылка, Отказ) Экспорт
	
	Если Не Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.ПриЗаполненииТаблицыДанныхНСИДляВыгрузки.
Процедура ТаблицаДанныхНСИДляВыгрузки(СсылкиНаОбъектыНСИ, СвойстваОбъектаXDTO, ТаблицаНСИ) Экспорт
	
	ТабДанныхНСИ = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	ТипОбъекта = ТипЗнч(СсылкиНаОбъектыНСИ[0]);
	
	Если ТипОбъекта = Тип("СправочникСсылка.Организации") Тогда 
		
		РеквизитыОрганизации = "НаимЮЛПол, ИННЮЛ, КППЮЛ";
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Таблица.Ссылка)) КАК ID,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(12)) КАК TIN,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(9)) КАК PPC
			|ИЗ
			|	Справочник.Организации КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();
		ТабДанныхНСИ.Колонки.Добавить("FullDescr", Новый ОписаниеТипов("Строка"));
		Для Каждого СтрНСИ Из ТабДанныхНСИ Цикл
			СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(СтрНСИ.Ссылка,,РеквизитыОрганизации);
			СтрНСИ.TIN = СведенияОбОрганизации.ИННЮЛ;
			СтрНСИ.PPC = СведенияОбОрганизации.КППЮЛ;
			СтрНСИ.FullDescr = СведенияОбОрганизации.НаимЮЛПол;
		КонецЦикла;
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	Таблица.Родитель КАК Родитель,
			|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Таблица.Ссылка)) КАК ID,
			|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Таблица.Родитель)) КАК ParentID
			|ИЗ
			|	Справочник.СтруктураПредприятия КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Должности") Тогда	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Таблица.Ссылка)) КАК ID
			|ИЗ
			|	Справочник.Должности КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ФизическиеЛица") Тогда	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.ЭтоГруппа КАК IsFolder,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	Таблица.ДатаРождения КАК BirthDate,
			|	Таблица.Родитель КАК Родитель,
			|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Таблица.Ссылка)) КАК ID,
			|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Таблица.Родитель)) КАК FolderID
			|ИЗ
			|	Справочник.ФизическиеЛица КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();

	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Контрагенты") Тогда	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	ЛОЖЬ КАК IsFolder,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	Таблица.ИНН КАК TIN,
			|	Таблица.КПП КАК PPC,
			|	Таблица.НаименованиеПолное КАК FullDescr,
			|	Таблица.ЮридическоеФизическоеЛицо КАК ЮрФизЛицо,
			|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Таблица.Ссылка)) КАК ID,
			|	ВЫБОР
			|		КОГДА Таблица.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
			|			ТОГДА ""ФизЛицо""
			|		КОГДА Таблица.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
			|			ТОГДА ""ЮрЛицо""
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК Type
			|ИЗ
			|	Справочник.Контрагенты КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();

	КонецЕсли;
	
	ТаблицаНСИ = ТабДанныхНСИ;
	
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.ПриОпределенииИменИсключаемыхКоманд.
Процедура ПриОпределенииИменИсключаемыхКоманд(Форма, ИменаИсключаемыхКоманд) Экспорт
	
	Если Форма.ИмяФормы = "Справочник.Сотрудники.Форма.ФормаЭлемента" Тогда
		Объект = Форма.Сотрудник;
	Иначе
		Объект = Форма.Объект;
	КонецЕсли;

	Если Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипЗнч(Объект.Ссылка)) Тогда
		ИменаИсключаемыхКоманд.Добавить(ИмяКомандыОтправитьВ1САрхив());
		ИменаИсключаемыхКоманд.Добавить(ИмяКомандыОтменитьОтправкуВ1САрхив());
		ИменаИсключаемыхКоманд.Добавить(ИмяКомандыОтозватьИз1САрхива());
		ИменаИсключаемыхКоманд.Добавить(ИмяКомандыИсторияОбмена());
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.ПриЗаписиКонстантыИнтеграцияС1САрхивом.
Процедура ПриЗаписиКонстантыИнтеграцияС1САрхивом(Объект, Отказ) Экспорт
	
	НастроитьПапкуФайлов1САрхива(Объект);
	
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.УстановитьВидимостьИДоступностьКоманд.
Процедура УстановитьВидимостьИДоступностьКоманд(Форма, СтандартнаяОбработка = Неопределено) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;

	Если Не Форма.ИмяФормы = "Обработка.РаботаСФайлами.Форма.ПрисоединенныйФайл"
		И Не Форма.ИмяФормы = "Справочник.Файлы.Форма.ФормаЭлемента"
		И Не Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		
		Возврат;
		
	КонецЕсли;
		
	Если Форма.ИмяФормы = "Справочник.Сотрудники.Форма.ФормаЭлемента" Тогда
		Объект = Форма.Сотрудник;
	ИначеЕсли Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		ТекущаяСтрока = Форма.Элементы.Отчеты.ТекущаяСтрока;
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат;
		Иначе
			Объект = ТекущаяСтрока.Ссылка;
		КонецЕсли;
	Иначе
		Объект = Форма.Объект;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	
	УстановитьВидимостьИДоступностьКомандОбъекта(Объект, Форма);
	
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.ПриОпределенииИмениРеквизитаФормыСодержащегоИнтегрируемыйОбъект.
Процедура ИмяРеквизитаФормыСодержащегоИнтегрируемыйОбъект(Форма, ИмяРеквизита) Экспорт
	
	ИмяРеквизитаФормы = "";
	
	Если Форма.ИмяФормы = "Справочник.Сотрудники.Форма.ФормаЭлемента" Тогда
		ИмяРеквизитаФормы = "Сотрудник";
	КонецЕсли;
	
	ИмяРеквизита = ИмяРеквизитаФормы;
	
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.ПриОпределенииТипаФормы.
Процедура ЭтоФормаОбъекта(Форма, ЭтоФормаОбъекта) Экспорт
	
	ЭтоФормаОбъекта = Неопределено;
	
	Если Форма.ИмяФормы = "Обработка.РаботаСФайлами.Форма.ПрисоединенныйФайл" Тогда
		ЭтоФормаОбъекта = Истина;
	ИначеЕсли Форма.Параметры.Свойство("Ключ") И Не Форма.Параметры.Ключ = Неопределено И ОбщегоНазначения.ЭтоДокумент(Форма.Параметры.Ключ.Метаданные()) Тогда
		ФормаДокумента = Форма.Параметры.Ключ.Метаданные().Формы.Найти("ФормаДокумента");
		Если Не ФормаДокумента = Неопределено
			И ФормаДокумента.ПолноеИмя() = Форма.ИмяФормы Тогда
			ЭтоФормаОбъекта = Истина;
		КонецЕсли;
		ФормаСписка = Форма.Параметры.Ключ.Метаданные().Формы.Найти("ФормаСписка");
		Если Не ФормаСписка = Неопределено
			И ФормаСписка.ПолноеИмя() = Форма.ИмяФормы Тогда
			ЭтоФормаОбъекта = Ложь;
		КонецЕсли;
	ИначеЕсли Форма.Параметры.Свойство("Ключ") И Не Форма.Параметры.Ключ = Неопределено И ОбщегоНазначения.ЭтоСправочник(Форма.Параметры.Ключ.Метаданные()) Тогда
		ФормаЭлемента = Форма.Параметры.Ключ.Метаданные().Формы.Найти("ФормаЭлемента");
		Если Не ФормаЭлемента = Неопределено
			И ФормаЭлемента.ПолноеИмя() = Форма.ИмяФормы Тогда
			ЭтоФормаОбъекта = Истина;
		КонецЕсли;
		ФормаСписка = Форма.Параметры.Ключ.Метаданные().Формы.Найти("ФормаСписка");
		Если Не ФормаСписка = Неопределено
			И ФормаСписка.ПолноеИмя() = Форма.ИмяФормы Тогда
			ЭтоФормаОбъекта = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОбновления

Процедура ЗарегистрироватьДанныеДляВыгрузки(ПараметрыОбновления = Неопределено) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	УзелАрхив = ПланыОбмена.ОбменНСИСАрхивом.УзелАрхив();
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелАрхив, Метаданные.Справочники.ФизическиеЛица);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелАрхив, Метаданные.Справочники.Должности);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелАрхив, Метаданные.Справочники.Контрагенты);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелАрхив, Метаданные.Справочники.Организации);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелАрхив, Метаданные.Справочники.СтруктураПредприятия);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелАрхив, Метаданные.Справочники.ВидыДокументовБИА);
	
КонецПроцедуры

#КонецОбласти

