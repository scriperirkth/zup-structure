КонецФункции

#КонецОбласти

Функция ИсточникРегламентированногоОтчета(Знач РегламентированныйОтчет) Экспорт

	Если ТипЗнч(РегламентированныйОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		Возврат РегламентированныйОтчет.ИсточникОтчета;
	КонецЕсли;
	
	Возврат "";
КонецФункции

Процедура НастроитьПапкуФайлов1САрхива(Объект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаименованиеПапкиФайлов = НСтр("ru = '1С:Архив'");
	ПапкаФайлов1САрхив = Константы.ПапкаФайлов1САрхива.Получить();
	
	Если Объект.Значение Тогда
		
		Если ПапкаФайлов1САрхив.Пустая() Тогда
			
			ПапкаФайлов1САрхив = Справочники.ПапкиФайлов.НайтиПоНаименованию(НаименованиеПапкиФайлов);
			
			Если ПапкаФайлов1САрхив.Пустая() Тогда
				ПапкаФайлов1САрхив = Справочники.ПапкиФайлов.СоздатьЭлемент();
				ПапкаФайлов1САрхив.Наименование = НаименованиеПапкиФайлов;
				ПапкаФайлов1САрхив.Описание = НСтр("ru = 'Папка сохранения файлов для выгрузки в 1С:Архив'");
				ПапкаФайлов1САрхив.ДатаСоздания = ТекущаяДатаСеанса();
				ПапкаФайлов1САрхив.Ответственный = Пользователи.АвторизованныйПользователь();
				ПапкаФайлов1САрхив.Записать();
				ПапкаФайлов1САрхив = ПапкаФайлов1САрхив.Ссылка;
			ИначеЕсли ПапкаФайлов1САрхив.ПометкаУдаления Тогда
				ПапкаФайлов1САрхив.ПолучитьОбъект().УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			
			Константы.ПапкаФайлов1САрхива.Установить(ПапкаФайлов1САрхив);
			
		КонецЕсли;
		
	ИначеЕсли Не ПапкаФайлов1САрхив.Пустая() Тогда
		
		ПапкаФайлов1САрхив.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры

#Область СоздатьДокументыБИА

Функция СоздатьДокументБИА(ДанныеБИА) Экспорт
	
	Перем ДанныеБИАШапка, ДанныеБИАСвойства, ДанныеБИАСубъектыПД, ДанныеБИАФайлы, ДанныеБИАДобавитьФайлы, ДанныеБИАПодписи;
	
	Если ДанныеБИА.Свойство("ДанныеБИАШапка", ДанныеБИАШапка) И ЗначениеЗаполнено(ДанныеБИАШапка) Тогда
		ОбязательныеРеквизиты = "ВидДокумента,Организация,Дата";
		ОбязательныеРеквизиты = СтрРазделить(ОбязательныеРеквизиты, ",");
		
		Для Каждого ОбязательныйРеквизит Из ОбязательныеРеквизиты Цикл
			ЗначениеРеквизита = Неопределено;
			Если ДанныеБИАШапка.Свойство(ОбязательныйРеквизит, ЗначениеРеквизита) И Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	ДокументБИА = Справочники.ДокументыБИА.СоздатьЭлемент();
	СсылкаНаДокументБИА = Справочники.ДокументыБИА.ПолучитьСсылку();
	ДокументБИА.УстановитьСсылкуНового(СсылкаНаДокументБИА);
	
	ЗаполнитьЗначенияСвойств(ДокументБИА, ДанныеБИАШапка);
	
	Если ДанныеБИА.Свойство("ДанныеБИАСвойства", ДанныеБИАСвойства) И ЗначениеЗаполнено(ДанныеБИАСвойства) Тогда
		Для Каждого Свойство Из ДанныеБИАСвойства Цикл
			ДокументБИА.ДобавитьЗначениеСвойства(Свойство.Значение, Свойство.ИмяСвойства);
		КонецЦикла;
	КонецЕсли;
		
	Если ДанныеБИА.Свойство("ДанныеБИАФайлы", ДанныеБИАФайлы) И ЗначениеЗаполнено(ДанныеБИАФайлы) Тогда
		Для Каждого ДанныеФайла Из ДанныеБИАФайлы Цикл
			
			Если Не ЗначениеЗаполнено(ДанныеФайла.Файл) Тогда
				Продолжить;
			КонецЕсли;
			
			ИсключаемыеКолонки = Новый Массив;
			Если ДанныеФайла.Свойство("ФайлВизуализации") Тогда
				ИсключаемыеКолонки.Добавить("ФайлВизуализации");
			КонецЕсли;
			Если ТипЗнч(ДанныеФайла.Файл) = Тип("Структура") Тогда
				ИсключаемыеКолонки.Добавить("Файл");
			КонецЕсли;
			
			СтрокаФайла = ДокументБИА.Файлы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаФайла, ДанныеФайла,, СтрСоединить(ИсключаемыеКолонки, ","));

			Если ТипЗнч(ДанныеФайла.Файл) = Тип("Структура") Тогда
				ИдентификаторСсылкиНаФайл = Неопределено;
				ДанныеФайла.Свойство("ИдентификаторСсылкиНаФайл", ИдентификаторСсылкиНаФайл);
				ПрисоединенныйФайл = СоздатьПрисоединенныйФайлДокументаБИА(СсылкаНаДокументБИА, ДанныеФайла.Файл.ПараметрыДобавленияФайла, ДанныеФайла.Файл.АдресФайлаВХранилище, ИдентификаторСсылкиНаФайл);
				СтрокаФайла.Файл = ПрисоединенныйФайл;
			КонецЕсли;

			Если ДанныеФайла.Свойство("ФайлВизуализации") Тогда
				ПрисоединенныйФайл = СоздатьПрисоединенныйФайлДокументаБИА(СсылкаНаДокументБИА, ДанныеФайла.ФайлВизуализации.ПараметрыДобавленияФайла, ДанныеФайла.ФайлВизуализации.АдресФайлаВХранилище);
				СтрокаФайла.ФайлВизуализации = ПрисоединенныйФайл;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеБИА.Свойство("ДанныеБИАДобавитьФайлы", ДанныеБИАДобавитьФайлы) И ЗначениеЗаполнено(ДанныеБИАДобавитьФайлы) Тогда
		Для Каждого ДанныеФайла Из ДанныеБИАДобавитьФайлы Цикл
			
			ПрисоединенныйФайл = СоздатьПрисоединенныйФайлДокументаБИА(СсылкаНаДокументБИА, ДанныеФайла.ПараметрыДобавленияФайла, ДанныеФайла.АдресФайлаВХранилище);
			СтрокаФайла = ДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = ПрисоединенныйФайл; 
			
			Если ДанныеФайла.Свойство("ФайлВизуализации") Тогда
				ПрисоединенныйФайл = СоздатьПрисоединенныйФайлДокументаБИА(СсылкаНаДокументБИА, ДанныеФайла.ФайлВизуализации.ПараметрыДобавленияФайла, ДанныеФайла.ФайлВизуализации.АдресФайлаВХранилище);
				СтрокаФайла.ФайлВизуализации = ПрисоединенныйФайл;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;

	Если ДанныеБИА.Свойство("ДанныеБИАСубъектыПД", ДанныеБИАСубъектыПД) И ЗначениеЗаполнено(ДанныеБИАСубъектыПД) Тогда
		Для Каждого ДанныеСубъектаПД Из ДанныеБИАСубъектыПД Цикл
			СтрокаПерсДанных = ДокументБИА.СубъектыПерсональныхДанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПерсДанных, ДанныеСубъектаПД);
		КонецЦикла;
	КонецЕсли;

	Если ДанныеБИА.Свойство("ДанныеБИАПодписи", ДанныеБИАПодписи) И ЗначениеЗаполнено(ДанныеБИАПодписи) Тогда
		Для Каждого ДанныеПодписи Из ДанныеБИАПодписи Цикл
			ПодписьДокумента = ДокументБИА.ПодписиДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(ПодписьДокумента, ДанныеПодписи, "ВидПодписи, ДатаПодписи, Подписал, Подпись");
			ПодписьДокумента.Файл = Справочники.ДокументыБИАПрисоединенныеФайлы.ПолучитьСсылку(ДанныеПодписи.ИдентификаторСсылкиНаФайл);
		КонецЦикла;
	КонецЕсли;
		
	Возврат ДокументБИА;
	
КонецФункции

Функция ПараметрыДокумента() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Списочный", Ложь);
	Параметры.Вставить("ИмяТабличнойЧастиСотрудники", "Сотрудники");
	Параметры.Вставить("ДополнительныеСвойства", Новый Соответствие);
	Параметры.Вставить("ИмяРеквизитаСотрудник", "Сотрудник");
	Параметры.Вставить("ВладелецФайлов", Неопределено);
	
	Возврат Параметры;
КонецФункции

Функция ПараметрыДобавленияФайлаБИА(ИмяФайла, АдресФайла)
	
	ПараметрыДобавленияФайлаБИА = Неопределено;
	
	СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайла);
	
	Если ЭтоАдресВременногоХранилища(АдресФайла)
		И Не СтруктураИмениФайла.ИмяБезРасширения = "" И Не СтруктураИмениФайла.Расширение = "" Тогда
		
		ПараметрыДобавленияФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыДобавленияФайла.ИмяБезРасширения = СтруктураИмениФайла.ИмяБезРасширения;
		ПараметрыДобавленияФайла.РасширениеБезТочки = СтрЗаменить(СтруктураИмениФайла.Расширение, ".", "");
		
		ПараметрыДобавленияФайлаБИА = ШаблонПараметровДобавленияФайлаБИА();
		ПараметрыДобавленияФайлаБИА.ПараметрыДобавленияФайла = ПараметрыДобавленияФайла;
		ПараметрыДобавленияФайлаБИА.АдресФайлаВХранилище     = АдресФайла;
		
	КонецЕсли;
	
	Возврат ПараметрыДобавленияФайлаБИА;
	
КонецФункции

Функция ШаблонПараметровДобавленияФайлаБИА()
	Возврат Новый Структура("ПараметрыДобавленияФайла, АдресФайлаВХранилище");
КонецФункции

Функция ШаблонПараметровДобавленияПодписи()
	Возврат Новый Структура("ВидПодписи, ДатаПодписи, Подписал, ИдентификаторСсылкиНаФайл, Подпись");
КонецФункции

Функция СоздатьДокументыБИАПоВладельцуФайлов(ВладелецФайлов, ПараметрыДокумента = Неопределено, ТипыДокументовИсключений = Неопределено) Экспорт
	
	СформированныеДокументыБИА = Новый Массив;
	
	Если ТипыДокументовИсключений = Неопределено Тогда
		ТипыДокументовИсключений = Новый Массив;
	КонецЕсли;
	
	Файлы = Новый Массив;
	Если ТипЗнч(ВладелецФайлов) = Тип("СправочникСсылка.Сотрудники") Тогда
		Файлы = ПрисоединенныеФайлыСотрудникаДляВыгрузкиВ1САрхив(ВладелецФайлов);
	Иначе
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ВладелецФайлов, Файлы);
	КонецЕсли;
	Для Каждого Файл Из Файлы Цикл
		Если Не Файл.ПометкаУдаления Тогда
			
			Если (ОбщегоНазначения.ЭтоДокумент(ВладелецФайлов.Метаданные())
				ИЛИ ТипЗнч(ВладелецФайлов) = Тип("СправочникСсылка.Сотрудники"))
				И ТипыДокументовИсключений.Найти(ТипЗнч(ВладелецФайлов)) = Неопределено Тогда
				ДокументыБИА = Новый Массив;
				ДокументБИА = СоздатьДокументБИАПрисоединенногоФайлаДокумента(Файл, ПараметрыДокумента);
				Если Не ДокументБИА = Неопределено Тогда
					ДокументыБИА.Добавить(ДокументБИА);
				КонецЕсли;
			Иначе
				ДокументыБИА = ИнтеграцияС1САрхивомВнутренний.СоздатьДокументБИАФайлаДокументаИсключения(Файл);
			КонецЕсли;
			
			Для Каждого ДокументБИА Из ДокументыБИА Цикл

				ДокументБИА.ОбъектОснование = ВладелецФайлов;
				
				Для Каждого ПредыдущийДокументБИА Из СформированныеДокументыБИА Цикл
					
					ТипСвязиПрямой = Новый Структура("Идентификатор, Наименование",
										ПредыдущийДокументБИА.ВидДокумента.ИдентификаторСвязи,
										СтрШаблон(НСтр("ru = '%1'"), ПредыдущийДокументБИА.ВидДокумента.Наименование));
					ТипСвязиОбратный = Новый Структура("Идентификатор, Наименование",
										ДокументБИА.ВидДокумента.ИдентификаторСвязи,
										СтрШаблон(НСтр("ru = '%1'"), ДокументБИА.ВидДокумента.Наименование));
										
					СтрокаСвязи = ДокументБИА.Связи.Добавить();
					СтрокаСвязи.СвязанныйДокумент = ПредыдущийДокументБИА.ПолучитьСсылкуНового();
					СтрокаСвязи.ТипСвязиИдентификатор = ТипСвязиПрямой.Идентификатор;
					СтрокаСвязи.ТипСвязиНаименование = ТипСвязиПрямой.Наименование;
					СтрокаСвязи.ТипОбратнойСвязиИдентификатор = ТипСвязиОбратный.Идентификатор;
					СтрокаСвязи.ТипОбратнойСвязиНаименование = ТипСвязиОбратный.Наименование;

					СтрокаСвязи = ПредыдущийДокументБИА.Связи.Добавить();
					СтрокаСвязи.СвязанныйДокумент = ДокументБИА.ПолучитьСсылкуНового();
					СтрокаСвязи.ТипСвязиИдентификатор = ТипСвязиОбратный.Идентификатор;
					СтрокаСвязи.ТипСвязиНаименование = ТипСвязиОбратный.Наименование;
					СтрокаСвязи.ТипОбратнойСвязиИдентификатор = ТипСвязиПрямой.Идентификатор;
					СтрокаСвязи.ТипОбратнойСвязиНаименование = ТипСвязиПрямой.Наименование;
					
				КонецЦикла;
				
				СформированныеДокументыБИА.Добавить(ДокументБИА);
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат СформированныеДокументыБИА;

КонецФункции

Функция СоздатьДокументБИАРегламентированногоОтчета(СсылкаНаОбъектИсточник, ДополнительныеПараметры)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СформированныеДокументыБИА = Новый Массив;
	
	Если ТипЗнч(СсылкаНаОбъектИсточник) <> Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("Организация", СсылкаНаОбъектИсточник.Организация);
	ПараметрыЗаписи.Вставить("Дата", СсылкаНаОбъектИсточник.ДатаПодписи);
	ПараметрыЗаписи.Вставить("Номер", НСтр("ru = 'Без номера'"));
	ПараметрыЗаписи.Вставить("ИдентификаторПечатнойФормы", СсылкаНаОбъектИсточник.ИсточникОтчета); 
	ПараметрыЗаписи.Вставить("ИдентификаторОбъектаМетаданных", ИнтеграцияС1САрхивомВызовСервера.ИдентификаторРегламентированногоОтчета(СсылкаНаОбъектИсточник.ИсточникОтчета));
	
	ВидДокументаБИА = Справочники.ВидыДокументовБИА.НайтиВидДокумента(ПараметрыЗаписи.ИдентификаторПечатнойФормы, ПараметрыЗаписи.ИдентификаторОбъектаМетаданных);
	Если ВидДокументаБИА = Неопределено Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;
	
	ПараметрыЗаписи.Вставить("НеВыгружать", ВидДокументаБИА.НеВыгружать);
	ПараметрыЗаписи.Вставить("ВидДокументаБИА", ВидДокументаБИА);

	СведенияОФайлах1САрхив = РегистрыСведений.СведенияОФайлах1САрхив.ПараметрыРегистрацииСведенийОФайле();
	ЗаполнитьЗначенияСвойств(СведенияОФайлах1САрхив, ПараметрыЗаписи);

	Если СведенияОФайлах1САрхив.НеВыгружать Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;
	
	ДанныеБИАШапка = Новый Структура;
	
	ДанныеБИАШапка.Вставить("ВидДокумента", СведенияОФайлах1САрхив.ВидДокументаБИА);
	ДанныеБИАШапка.Вставить("Организация", СведенияОФайлах1САрхив.Организация);
	ДанныеБИАШапка.Вставить("Дата", СведенияОФайлах1САрхив.Дата);
	
	Если Не ЗначениеЗаполнено(ДанныеБИАШапка.ВидДокумента) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Организация) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Дата) Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;
	
	ПолучитьФайлыОтправкиОтчета = СведенияПоОтправкам.ПолучитьФайлыОтправкиОтчета(СсылкаНаОбъектИсточник);
	
	Если ЗначениеЗаполнено(СведенияОФайлах1САрхив.Номер) Тогда
		ДанныеБИАШапка.Вставить("Номер", СведенияОФайлах1САрхив.Номер);
	КонецЕсли;
	
	ДанныеБИАШапка.Вставить("ЭтоЭлектронныйДокумент", Истина);
	ДанныеБИАШапка.Вставить("ОбъектОснование", СсылкаНаОбъектИсточник);
	ДанныеБИАШапка.Вставить("Заголовок", СтрШаблон(НСтр("ru = '%1'"), Строка(СсылкаНаОбъектИсточник)));
	
	ДанныеБИАФайлы = Новый Массив;
	ДанныеБИАДобавитьФайлы = Новый Массив;
	
	ФайлыОтправкиОтчета = СведенияПоОтправкам.ПолучитьФайлыОтправкиОтчета(СсылкаНаОбъектИсточник);
	
	СтрокаФайла = Неопределено;
	ИдентификаторСсылкиНаФайл = Новый УникальныйИдентификатор;
	
	Если ТипЗнч(ФайлыОтправкиОтчета) = Тип("Структура") Тогда
		ПараметрыДобавленияФайлаБИА = ПараметрыДобавленияФайлаБИА(ФайлыОтправкиОтчета.ИмяФайлаОтчета, ФайлыОтправкиОтчета.АдресФайлаОтчета);
		Если Не ПараметрыДобавленияФайлаБИА = Неопределено Тогда
			СтрокаФайла = Новый Структура;
			СтрокаФайла.Вставить("Файл", ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыДобавленияФайлаБИА));
			СтрокаФайла.Вставить("ИдентификаторСсылкиНаФайл", ИдентификаторСсылкиНаФайл);
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("АдресБланкаPDFВоВременномХранилище") Тогда
		
		Для Каждого ФайлВременногоХранилища Из ДополнительныеПараметры.АдресБланкаPDFВоВременномХранилище Цикл
			
			ПараметрыДобавленияФайлаБИА = ПараметрыДобавленияФайлаБИА(ФайлВременногоХранилища.Наименование, ФайлВременногоХранилища.АдресВоВременномХранилище);
			
			Если ПараметрыДобавленияФайлаБИА = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		
			Если Не СтрокаФайла = Неопределено И Не СтрокаФайла.Свойство("ФайлВизуализации") Тогда
				СтрокаФайла.Вставить("ФайлВизуализации", ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыДобавленияФайлаБИА));
			Иначе
				ДанныеБИАДобавитьФайлы.Добавить(ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыДобавленияФайлаБИА));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не СтрокаФайла = Неопределено Тогда
		ДанныеБИАФайлы.Добавить(СтрокаФайла);
	КонецЕсли;
	
	ДанныеБИАПодписи = Новый Массив;
	
	Если Не СтрокаФайла = Неопределено Тогда
		ДобавитьПодписьРегламентированногоОтчета(ДанныеБИАПодписи, ПолучитьФайлыОтправкиОтчета.ПодписьОрганизации, ИдентификаторСсылкиНаФайл);
		ДобавитьПодписьРегламентированногоОтчета(ДанныеБИАПодписи, ПолучитьФайлыОтправкиОтчета.ПодписьОргана, ИдентификаторСсылкиНаФайл);
	КонецЕсли;
	
	ДанныеБИА = Новый Структура;
	ДанныеБИА.Вставить("ДанныеБИАШапка", ДанныеБИАШапка);
	ДанныеБИА.Вставить("ДанныеБИАФайлы", ДанныеБИАФайлы);
	ДанныеБИА.Вставить("ДанныеБИАДобавитьФайлы", ДанныеБИАДобавитьФайлы);
	ДанныеБИА.Вставить("ДанныеБИАПодписи", ДанныеБИАПодписи);
	
	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		ДанныеБИАСвойства = Новый Массив;
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", СсылкаНаОбъектИсточник.ДатаНачала, НСтр("ru='Дата начала'"), ));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", СсылкаНаОбъектИсточник.ДатаОкончания, НСтр("ru='Дата окончания'"), ));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", СсылкаНаОбъектИсточник.ДатаПодписи, НСтр("ru='Дата подписи'"), ));
		ДанныеБИА.Вставить("ДанныеБИАСвойства", ДанныеБИАСвойства);
	КонецЕсли;
	
	ДокументБИА = СоздатьДокументБИА(ДанныеБИА);
	Если Не ДокументБИА = Неопределено Тогда
		СформированныеДокументыБИА.Добавить(ДокументБИА);
	КонецЕсли;
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

Процедура ДобавитьПодписьРегламентированногоОтчета(ДанныеБИАПодписи, ДанныеПодписи, ИдентификаторСсылкиНаФайл)
	
	Если ЭтоАдресВременногоХранилища(ДанныеПодписи.АдресФайла) Тогда
		ДанныеПодписиБИА = ШаблонПараметровДобавленияПодписи();
		ДанныеПодписиБИА.ВидПодписи = Перечисления.ВидыПодписейДокументовБИА.Усиленная;
		ДанныеПодписиБИА.ДатаПодписи = ДанныеПодписи.ВремяПодписания;
		ДанныеПодписиБИА.Подписал = СтрШаблон(НСтр("ru='%1 %2'"), ДанныеПодписи.ПодписантДолжность, ДанныеПодписи.ПодписантФИО);
		ДанныеПодписиБИА.Подпись = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(ДанныеПодписи.АдресФайла));
		ДанныеПодписиБИА.ИдентификаторСсылкиНаФайл = ИдентификаторСсылкиНаФайл;
		ДанныеБИАПодписи.Добавить(ДанныеПодписиБИА);
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьДокументБИАФайла(СсылкаНаОбъектИсточник) Экспорт
	
	СформированныеДокументыБИА = Новый Массив;
	
	Если ТипЗнч(СсылкаНаОбъектИсточник) <> Тип("СправочникСсылка.Файлы") 
		И ТипЗнч(СсылкаНаОбъектИсточник) <> Тип("СправочникСсылка.РегламентированныйОтчетПрисоединенныеФайлы") Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;

	СведенияОФайлах1САрхив = РегистрыСведений.СведенияОФайлах1САрхив.СведенияОФайлеДляВыгрузкиВАрхив(СсылкаНаОбъектИсточник, Ложь);
	
	Если СведенияОФайлах1САрхив.НеВыгружать Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;
	
	ДанныеБИАШапка = Новый Структура;
	
	ДанныеБИАШапка.Вставить("ВидДокумента", СведенияОФайлах1САрхив.ВидДокументаБИА);
	ДанныеБИАШапка.Вставить("Организация", СведенияОФайлах1САрхив.Организация);
	ДанныеБИАШапка.Вставить("Дата", СведенияОФайлах1САрхив.Дата);
	
	Если Не ЗначениеЗаполнено(ДанныеБИАШапка.ВидДокумента) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Организация) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Дата) Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОФайлах1САрхив.Номер) Тогда
		ДанныеБИАШапка.Вставить("Номер", СведенияОФайлах1САрхив.Номер);
	КонецЕсли;
	
	ДанныеБИАШапка.Вставить("ЭтоЭлектронныйДокумент", Истина);
	ДанныеБИАШапка.Вставить("ОбъектОснование", СсылкаНаОбъектИсточник);
	ДанныеБИАШапка.Вставить("Заголовок", СтрШаблон(НСтр("ru = '%1'"), СсылкаНаОбъектИсточник.Наименование));
	
	ДанныеБИАФайлы = Новый Массив;
	ДанныеБИАФайлы.Добавить(Новый Структура("Файл", СсылкаНаОбъектИсточник));

	ДанныеБИА = Новый Структура;
	ДанныеБИА.Вставить("ДанныеБИАШапка", ДанныеБИАШапка);
	ДанныеБИА.Вставить("ДанныеБИАФайлы", ДанныеБИАФайлы); 
	
	Если ТипЗнч(СсылкаНаОбъектИсточник.ВладелецФайла) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		ДанныеБИАСвойства = Новый Массив;
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", СсылкаНаОбъектИсточник.ВладелецФайла.ДатаНачала, НСтр("ru='Дата начала'"), ));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", СсылкаНаОбъектИсточник.ВладелецФайла.ДатаОкончания, НСтр("ru='Дата окончания'"), ));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", СсылкаНаОбъектИсточник.ВладелецФайла.ДатаПодписи, НСтр("ru='Дата подписи'"), ));
		ДанныеБИА.Вставить("ДанныеБИАСвойства", ДанныеБИАСвойства);
	КонецЕсли;
	
	ДокументБИА = СоздатьДокументБИА(ДанныеБИА);
	Если Не ДокументБИА = Неопределено Тогда
		СформированныеДокументыБИА.Добавить(ДокументБИА);
	КонецЕсли;
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

Процедура ПодготовитьКВыгрузкеРегламентированныйОтчет(Ссылка, ДополнительныеПараметры)
	
	УстановитьПривилегированныйРежим(Истина);
	
	МетаданныеОбъекта = Ссылка.Метаданные();
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(	
		МетаданныеОбъекта.ПолноеИмя());
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(МетаданныеОбъекта.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.ДокументыБИА.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("ОбъектОснование", Ссылка);
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		ЕстьОшибкиПроверки = Ложь;
		ДокументыБИА = СоздатьДокументБИАРегламентированногоОтчета(Ссылка, ДополнительныеПараметры);
		Если ДокументыБИА.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Документы для 1С:Архива не сформированы. Обратитесь к администратору.'");
		КонецЕсли;
		Для Каждого ДокументОбъект Из ДокументыБИА Цикл
			Если ДокументОбъект.ПроверитьЗаполнение() Тогда
				ДокументОбъект.Записать();
			Иначе
				ЕстьОшибкиПроверки = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьОшибкиПроверки Тогда
			ВызватьИсключение НСтр("ru = 'Обнаружены ошибки проверки заполнения документов для 1С:Архива'");
		Иначе
			Событие = ОбменСАрхивом.СобытиеДляЛога();
			Событие.ОсновнойОбъект = Ссылка;
			Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
			Событие.КраткоеОписание = НСтр("ru = 'Документ отмечен к выгрузке в 1С:Архив'");
			ОбменСАрхивом.ЗаписатьВЛог(Событие);
			
			РегистрыСведений.ДокументыОтправленныеВ1САрхив.Добавить(Ссылка);
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция СоздатьПрисоединенныйФайлДокументаБИА(СсылкаНаДокументБИА, ПараметрыДобавленияФайлаБИА, АдресФайлаВХранилище, ИдентификаторСсылкиНаФайл = Неопределено)
	ПараметрыДобавленияФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ЗаполнитьЗначенияСвойств(ПараметрыДобавленияФайла, ПараметрыДобавленияФайлаБИА,,"ВладелецФайлов");
	ПараметрыДобавленияФайла.ВладелецФайлов = СсылкаНаДокументБИА;
	ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыДобавленияФайла, АдресФайлаВХранилище,,, Справочники.ДокументыБИАПрисоединенныеФайлы.ПолучитьСсылку(ИдентификаторСсылкиНаФайл));
	Возврат ПрисоединенныйФайл;
КонецФункции

Функция ПрисоединенныеФайлыСотрудникаДляВыгрузкиВ1САрхив(Сотрудник)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СведенияОФайлах1САрхив.Файл КАК Файл
	|ИЗ
	|	РегистрСведений.СведенияОФайлах1САрхив КАК СведенияОФайлах1САрхив
	|ГДЕ
	|	СведенияОФайлах1САрхив.Сотрудник = &Сотрудник
	|	И СведенияОФайлах1САрхив.Файл ССЫЛКА Справочник.ФизическиеЛицаПрисоединенныеФайлы";
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатЗапроса.ВыгрузитьКолонку("Файл");
	
КонецФункции

Функция СоздатьДокументБИАПрисоединенногоФайлаДокумента(ПрисоединенныйФайл, ПараметрыДокумента = Неопределено)
	
	Перем Списочный, ИмяТабличнойЧастиСотрудники, ДополнительныеСвойства, ИмяРеквизитаСотрудник;
	Перем Сотрудник, Подразделение, Должность, ФизическоеЛицо;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипЗнч(ПрисоединенныйФайл)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ПараметрыДокумента = Неопределено Тогда
		ПараметрыДокумента = ПараметрыДокумента();
	КонецЕсли;
	Списочный = ПараметрыДокумента.Списочный;
	ИмяТабличнойЧастиСотрудники = ПараметрыДокумента.ИмяТабличнойЧастиСотрудники;
	ДополнительныеСвойства = ПараметрыДокумента.ДополнительныеСвойства;
	ИмяРеквизитаСотрудник = ПараметрыДокумента.ИмяРеквизитаСотрудник;
	ВладелецФайла = ПараметрыДокумента.ВладелецФайлов;
	
	Если ВладелецФайла = Неопределено Тогда
		ВладелецФайла = ПрисоединенныйФайл.ВладелецФайла;
	КонецЕсли;
	ВладелецФайлаМетаданные = ВладелецФайла.Метаданные();
	
	ВыгрузкаФайлаСотрудника = (ТипЗнч(ВладелецФайла) = Тип("СправочникСсылка.Сотрудники"));
	
	Если Не ОбщегоНазначения.ЭтоДокумент(ВладелецФайлаМетаданные) И Не ВыгрузкаФайлаСотрудника Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СведенияОФайлах1САрхив = РегистрыСведений.СведенияОФайлах1САрхив.СведенияОФайлеДляВыгрузкиВАрхив(ПрисоединенныйФайл, Истина);
	
	Если СведенияОФайлах1САрхив.НеВыгружать Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеБИАШапка = Новый Структура;
	
	ДанныеБИАШапка.Вставить("ВидДокумента", СведенияОФайлах1САрхив.ВидДокументаБИА);
	ДанныеБИАШапка.Вставить("Организация", СведенияОФайлах1САрхив.Организация);
	ДанныеБИАШапка.Вставить("Дата", СведенияОФайлах1САрхив.Дата);
	
	Если Не ЗначениеЗаполнено(ДанныеБИАШапка.ВидДокумента) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Организация) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОФайлах1САрхив.Номер) Тогда
		ДанныеБИАШапка.Вставить("Номер", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(СведенияОФайлах1САрхив.Номер, Истина, Ложь));
	КонецЕсли;

	ДанныеБИАШапка.Вставить("ЭтоЭлектронныйДокумент", Истина);
	ДанныеБИАШапка.Вставить("ОбъектОснование", ПрисоединенныйФайл);

	Сотрудник = СведенияОФайлах1САрхив.Сотрудник;
	Если Не Списочный И Сотрудник.Пустая() И Не ВладелецФайлаМетаданные.Реквизиты.Найти("Сотрудник") = Неопределено Тогда
		Сотрудник = ВладелецФайла.Сотрудник;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ВыгрузкаФайлаСотрудника Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Сотрудники.Ссылка КАК Сотрудник
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Ссылка = &ВладелецФайла";
		
		Реквизиты = ВладелецФайлаМетаданные.Реквизиты;
		
	ИначеЕсли Списочный Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеДокумента.Сотрудник КАК Сотрудник
		|ИЗ
		|	Документ.ПриемНаРаботуСписком.Сотрудники КАК ДанныеДокумента
		|ГДЕ
		|	ДанныеДокумента.Ссылка = &ВладелецФайла
		|	И (&Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|			ИЛИ ДанныеДокумента.Сотрудник = &Сотрудник)";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПриемНаРаботуСписком.Сотрудники",
			СтрШаблон("Документ.%1.%2", ВладелецФайлаМетаданные.Имя, ИмяТабличнойЧастиСотрудники));
			
		Реквизиты = ВладелецФайлаМетаданные.ТабличныеЧасти[ИмяТабличнойЧастиСотрудники].Реквизиты;
			
	Иначе
			
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеДокумента.Сотрудник КАК Сотрудник
		|ИЗ
		|	Документ.ПриемНаРаботу КАК ДанныеДокумента
		|ГДЕ
		|	ДанныеДокумента.Ссылка = &ВладелецФайла
		|	И (&Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|			ИЛИ ДанныеДокумента.Сотрудник = &Сотрудник)";
		
				
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПриемНаРаботу",
			СтрШаблон("Документ.%1", ВладелецФайлаМетаданные.Имя));
				
		Реквизиты = ВладелецФайлаМетаданные.Реквизиты;

	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДанныеДокумента.Сотрудник", "ДанныеДокумента."+ИмяРеквизитаСотрудник);
		
	Запрос.УстановитьПараметр("ВладелецФайла", ВладелецФайла);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	ЗапросВыбора = СхемаЗапроса.ПакетЗапросов[0];
	ОператорЗапроса = ЗапросВыбора.Операторы[0];

	Если Не Реквизиты.Найти(ИмяРеквизитаСотрудник) = Неопределено
		И Реквизиты[ИмяРеквизитаСотрудник].Тип = Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица") Тогда
		
		ДобавляемоеПоле = ИмяРеквизитаСотрудник;
		
		Если ТипЗнч(Сотрудник) = Тип("СправочникСсылка.Сотрудники") Тогда
			Запрос.УстановитьПараметр("Сотрудник", Сотрудник.ФизическоеЛицо);
		КонецЕсли;
		
	ИначеЕсли Реквизиты.Найти("ФизическоеЛицо") = Неопределено Тогда
		ДобавляемоеПоле = СтрШаблон("%1.ФизическоеЛицо", ИмяРеквизитаСотрудник);
	Иначе
		ДобавляемоеПоле = "ФизическоеЛицо";
	КонецЕсли;
	ОператорЗапроса.ВыбираемыеПоля.Добавить(ДобавляемоеПоле);
	ЗапросВыбора.Колонки[ЗапросВыбора.Колонки.Количество()-1].Псевдоним = "ФизическоеЛицо";
	
	Для Каждого ДополнительноеСвойство Из ДополнительныеСвойства Цикл
		Если Реквизиты.Найти(ДополнительноеСвойство.Значение) = Неопределено Тогда
			ДополнительныеСвойства.Удалить(ДополнительноеСвойство.Ключ);
		Иначе
			Если ДополнительноеСвойство.Значение = "ДолжностьПоШтатномуРасписанию" Тогда
				ДобавляемоеПоле = "ДолжностьПоШтатномуРасписанию.Должность";
				ОператорЗапроса.ВыбираемыеПоля.Добавить(ДобавляемоеПоле);
				ЗапросВыбора.Колонки[ЗапросВыбора.Колонки.Количество()-1].Псевдоним = ДополнительноеСвойство.Значение;
			Иначе
				ДобавляемоеПоле = ДополнительноеСвойство.Значение;
				ОператорЗапроса.ВыбираемыеПоля.Добавить(ДобавляемоеПоле);
				ЗапросВыбора.Колонки[ЗапросВыбора.Колонки.Количество()-1].Псевдоним = ДополнительноеСвойство.Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	ДанныеСотрудниковДокумента = Запрос.Выполнить().Выгрузить();

	ДанныеБИАСвойства = Новый Массив;
	ДанныеБИАСубъектыПД = Новый Массив;
	Для Каждого ДанныеСотрудника Из ДанныеСотрудниковДокумента Цикл
		
		Если ВыгрузкаФайлаСотрудника Тогда
			КадровыеДанныеСотрудника = КадровыеДанныеСотрудника(ПрисоединенныйФайл.ДатаМодификацииУниверсальная, ДанныеСотрудника.Сотрудник, ДанныеБИАШапка.Организация);
		Иначе
			КадровыеДанныеСотрудника = КадровыеДанныеСотрудника(ВладелецФайла.Дата, ДанныеСотрудника.Сотрудник, ДанныеБИАШапка.Организация);
		КонецЕсли;
	
		ДанныеБИАСубъектыПД.Добавить(Новый Структура("ФизическоеЛицо", ДанныеСотрудника.ФизическоеЛицо));
		
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", ДанныеСотрудника.ФизическоеЛицо, НСтр("ru='Физическое лицо'"), ));
		
		Для Каждого ДополнительноеСвойство Из ДополнительныеСвойства Цикл
			
			ЗначениеСвойства = ДанныеСотрудника[ДополнительноеСвойство.Значение];
			
			Если ДополнительноеСвойство.Значение = "Подразделение" Тогда
				Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ОрганизационнаяСтруктура") Тогда
					МодульОрганизационнаяСтруктура = ОбщегоНазначения.ОбщийМодуль("ОрганизационнаяСтруктура");
					ЗначениеСвойства = МодульОрганизационнаяСтруктура.ПодразделениеВСтруктуреПредприятия(ЗначениеСвойства);
				ИначеЕсли ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы.ИнтеграцияУправлениеПерсоналом") Тогда
					МодульИнтеграцияУправлениеПерсоналом = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияУправлениеПерсоналом");
					ЗначениеСвойства = МодульИнтеграцияУправлениеПерсоналом.ПодразделениеВСтруктуреПредприятия(ЗначениеСвойства);
				КонецЕсли;
			КонецЕсли;

			Если Не ОбщегоНазначенияБТСПовтИсп.ОписаниеСсылочныхТипов().Типы().Найти(ТипЗнч(ЗначениеСвойства)) = Неопределено Тогда
				Если Метаданные.ПланыОбмена.ОбменНСИСАрхивом.Состав.Найти(ЗначениеСвойства.Метаданные()) = Неопределено Тогда
					ЗначениеСвойства = Строка(ЗначениеСвойства);
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЗначениеСвойства) Тогда
				ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", ЗначениеСвойства, ДополнительноеСвойство.Ключ));
			КонецЕсли;
			
		КонецЦикла;
		Если ДополнительныеСвойства.Получить("Подразделение") = Неопределено И ЗначениеЗаполнено(КадровыеДанныеСотрудника.Подразделение)Тогда
			ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", КадровыеДанныеСотрудника.Подразделение, "Подразделение"));
		КонецЕсли;
		Если ДополнительныеСвойства.Получить("Должность") = Неопределено И ЗначениеЗаполнено(КадровыеДанныеСотрудника.Должность)Тогда
			ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", КадровыеДанныеСотрудника.Должность, "Должность"));
		КонецЕсли;
			
		Если ДанныеСотрудниковДокумента.Количество() = 1 Тогда
			ФизическоеЛицо = ДанныеСотрудника.ФизическоеЛицо;
		КонецЕсли;
		
		Если Подразделение = Неопределено Тогда
			Если ДополнительныеСвойства.Получить("Подразделение") = Неопределено Тогда
				Подразделение = КадровыеДанныеСотрудника.Подразделение;
			Иначе
				Подразделение = ДанныеСотрудника[ДополнительныеСвойства["Подразделение"]];
			КонецЕсли;
		ИначеЕсли ДополнительныеСвойства.Получить("Подразделение") = Неопределено И Не Подразделение = КадровыеДанныеСотрудника.Подразделение Тогда
			Подразделение = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
		ИначеЕсли Не ДополнительныеСвойства.Получить("Подразделение") = Неопределено И Не Подразделение = ДанныеСотрудника[ДополнительныеСвойства["Подразделение"]] Тогда
			Подразделение = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		ДанныеБИАШапка.Вставить("Заголовок", СтрШаблон(НСтр("ru = '%1 %2'"), ДанныеБИАШапка.ВидДокумента.Наименование, ФизическоеЛицо.ФИО));
		ДанныеБИАШапка.Вставить("Содержание", СтрШаблон(НСтр("ru = '%1 %2 (%3)'"), ДанныеБИАШапка.ВидДокумента.Наименование, ФизическоеЛицо.ФИО, ВладелецФайлаМетаданные.Синоним));
	Иначе
		ДанныеБИАШапка.Вставить("Заголовок", СтрШаблон(НСтр("ru = '%1'"), ДанныеБИАШапка.ВидДокумента.Наименование));
		ДанныеБИАШапка.Вставить("Содержание", СтрШаблон(НСтр("ru = '%1 (%2)'"), ДанныеБИАШапка.ВидДокумента.Наименование, ВладелецФайлаМетаданные.Синоним));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Если Не ТипЗнч(Подразделение) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
			Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ОрганизационнаяСтруктура") Тогда
				МодульОрганизационнаяСтруктура = ОбщегоНазначения.ОбщийМодуль("ОрганизационнаяСтруктура");
				Подразделение = МодульОрганизационнаяСтруктура.ПодразделениеВСтруктуреПредприятия(Подразделение);
			ИначеЕсли ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы.ИнтеграцияУправлениеПерсоналом") Тогда
				МодульИнтеграцияУправлениеПерсоналом = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияУправлениеПерсоналом");
				Подразделение = МодульИнтеграцияУправлениеПерсоналом.ПодразделениеВСтруктуреПредприятия(Подразделение);
			КонецЕсли;
		КонецЕсли;
		ДанныеБИАШапка.Вставить("Подразделение", Подразделение);
	КонецЕсли;
		
	ДанныеБИАФайлы = Новый Массив;
	ДанныеБИАДобавитьФайлы = Новый Массив;

	СтрокаФайла = Новый Структура("Файл", ПрисоединенныйФайл);

	Если ЭДОБЗК.ЭтоЭлектронныйДокумент(ПрисоединенныйФайл) Тогда
		
		ФайлыДляВывода = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПрисоединенныйФайл);
		ДанныеФайловПечатныхФорм = ЭДОБЗКВызовСервера.ДанныеФайловПечатныхФорм(ФайлыДляВывода);
		
		Для Каждого ДанныеФайлаПечатныхФорм Из ДанныеФайловПечатныхФорм Цикл
			Для Каждого ФайлПредставления Из ДанныеФайлаПечатныхФорм.Значение.Представления Цикл
				
				СтрокаФайлаДобавитьФайл = Неопределено;
				Если ФайлПредставления.АдресВХранилищеОригиналMXL <> Неопределено Тогда
					ПараметрыДобавленияФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
					ПараметрыДобавленияФайла.ИмяБезРасширения = ДанныеФайлаПечатныхФорм.Значение.Оригинал.ИмяФайлаБезРасширения+"_Оригинал_MXL";
					ПараметрыДобавленияФайла.РасширениеБезТочки = "MXL";
					СтрокаФайлаДобавитьФайл = Новый Структура("ПараметрыДобавленияФайла, АдресФайлаВХранилище", ПараметрыДобавленияФайла, ФайлПредставления.АдресВХранилищеОригиналMXL);
				КонецЕсли;
				
				ПараметрыДобавленияФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
				ПараметрыДобавленияФайла.ИмяБезРасширения = ФайлПредставления.ИмяФайлаБезРасширения;
				ПараметрыДобавленияФайла.РасширениеБезТочки = ФайлПредставления.РасширениеФайла;
				
				ДанныеФайла = Новый Структура("ПараметрыДобавленияФайла, АдресФайлаВХранилище", ПараметрыДобавленияФайла, ФайлПредставления.АдресВоВременномХранилище);
				Если СтрНайти(ФайлПредставления.ИмяФайлаБезРасширения, "_для_печати") > 0 И Не СтрокаФайла.Свойство("ФайлВизуализации") Тогда
					СтрокаФайла.Вставить("ФайлВизуализации", ДанныеФайла);
				ИначеЕсли СтрокаФайлаДобавитьФайл = Неопределено Тогда
					ДанныеБИАДобавитьФайлы.Добавить(ДанныеФайла);
				Иначе
					СтрокаФайлаДобавитьФайл.Вставить("ФайлВизуализации", ДанныеФайла);
				КонецЕсли;

				Если Не СтрокаФайлаДобавитьФайл = Неопределено Тогда
					ДанныеБИАДобавитьФайлы.Добавить(СтрокаФайлаДобавитьФайл);
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	ДанныеБИАФайлы.Добавить(СтрокаФайла);
	
	ДанныеБИА = Новый Структура;
	ДанныеБИА.Вставить("ДанныеБИАШапка", ДанныеБИАШапка);
	ДанныеБИА.Вставить("ДанныеБИАСвойства", ДанныеБИАСвойства);
	ДанныеБИА.Вставить("ДанныеБИАСубъектыПД", ДанныеБИАСубъектыПД);
	ДанныеБИА.Вставить("ДанныеБИАФайлы", ДанныеБИАФайлы);
	ДанныеБИА.Вставить("ДанныеБИАДобавитьФайлы", ДанныеБИАДобавитьФайлы);
	
	Возврат СоздатьДокументБИА(ДанныеБИА);
	
КонецФункции

#КонецОбласти

#Область Формы

Процедура УстановитьСвойстваЭлементовДляВыгрузкиВ1САрхив(Форма, Файл, СведенияОФайле, Доступность = Истина)
	
	Группа1САрхивСтраница = Форма.Элементы.Найти("Группа1САрхивСтраница");
	Группа1САрхивСведения = Форма.Элементы.Найти("Группа1САрхивСведения");
	
	ИмяЭлемента = ИмяКомандыИзменитьСведенияОФайле1САрхив();
	ЭлементКомандыИзменитьСведения = Форма.Элементы.Найти(ИмяЭлемента);
	Если Не ЭлементКомандыИзменитьСведения = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЭлемента, "Видимость", Ложь);
	КонецЕсли;
	
	Для Каждого ОписаниеЭлемента Из ОписаниеЭлементовСведенияОФайле1САрхив() Цикл
		ИмяРеквизитаФормы = ОписаниеЭлемента.Значение.ИмяРеквизитаФормы;
		ИмяРеквизитаФайла = ОписаниеЭлемента.Значение.ИмяРеквизитаФайла;
		Форма[ИмяРеквизитаФормы] = СведенияОФайле[ИмяРеквизитаФайла];
		Если ИмяРеквизитаФайла = "Номер" Тогда
			Форма[ИмяРеквизитаФормы] = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Форма[ИмяРеквизитаФормы], Истина, Ложь);
		КонецЕсли;
		
		ИмяЭлементаКнопкиКоманды = ИмяПодменюИнтеграцияС1САрхивом()+"СмТакже__"+ОписаниеЭлемента.Ключ;
		
		ЗначениеРеквизита = Форма[ИмяРеквизитаФормы];
		Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
			ЗначениеРеквизита = Формат(ЗначениеРеквизита, "ДЛФ=D");
		КонецЕсли;
		ИмяНадписи = ОписаниеЭлемента.Значение.ИмяНадписи;
		НаименованиеГруппы = "Группа1САрхив"+ИмяНадписи;
		НоваяГруппа = Форма.Элементы.Найти(НаименованиеГруппы);
		
		Если ИмяРеквизитаФайла = ОписаниеЭлементовСведенияОФайле1САрхив().ИзменитьНеВыгружатьВ1САрхив.ИмяРеквизитаФайла Тогда
			Если Группа1САрхивСтраница <> Неопределено И Группа1САрхивСведения <> Неопределено Тогда
				Форма.Элементы.Переместить(Форма.Элементы[ИмяЭлементаКнопкиКоманды], Группа1САрхивСтраница, Группа1САрхивСтраница);
			КонецЕсли;
			НеВыгружатьВАрхив = Форма[ИмяРеквизитаФормы];
			Форма.Элементы[ИмяЭлементаКнопкиКоманды].Заголовок = ?(НеВыгружатьВАрхив, НСтр("ru='Выгружать в 1С:Архив'"), НСтр("ru='Не выгружать в 1С:Архив'"));
			Форма.Элементы[ИмяЭлементаКнопкиКоманды].Отображение = ОтображениеКнопки.Текст;
			Группа1САрхивСведения.Видимость = Не НеВыгружатьВАрхив;
		Иначе
			НаименованиеГруппы = "Группа1САрхив"+ИмяНадписи;
			НоваяГруппа = Форма.Элементы.Найти(НаименованиеГруппы);
			Если Не НоваяГруппа = Неопределено Тогда
				Форма.Элементы.Переместить(Форма.Элементы[ИмяЭлементаКнопкиКоманды], НоваяГруппа);
			КонецЕсли;
			Форма.Элементы[ИмяЭлементаКнопкиКоманды].Вид = ВидКнопкиФормы.Гиперссылка;
			Форма.Элементы[ИмяЭлементаКнопкиКоманды].Заголовок = ?(ЗначениеЗаполнено(ЗначениеРеквизита),ЗначениеРеквизита,"<...>");
			Форма.Элементы[ИмяЭлементаКнопкиКоманды].Отображение = ОтображениеКнопки.Текст;
		КонецЕсли;
		Форма.Элементы[ИмяЭлементаКнопкиКоманды].Доступность = Доступность;
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеЭлементовСведенияОФайле1САрхив()
	СвойстваКоманды = "ИмяНадписи, Надпись, ИмяРеквизитаФайла, ИмяРеквизитаФормы, ОписаниеТипа";
	ИдентификаторыКоманд = Новый Структура;
	ИдентификаторыКоманд.Вставить("ИзменитьНеВыгружатьВ1САрхив",	Новый Структура(СвойстваКоманды, "", 						НСтр("ru = ''"), 				"НеВыгружать",		"НеВыгружатьВ1САрхив",	Новый ОписаниеТипов("Булево")));
	ИдентификаторыКоманд.Вставить("ИзменитьВидДокументаБИА", 		Новый Структура(СвойстваКоманды, "НадписьВидДокументаБИА",	НСтр("ru = 'Вид документа:'"),	"ВидДокументаБИА",	"ВидДокументаБИА",		Новый ОписаниеТипов("СправочникСсылка.ВидыДокументовБИА")));
	ИдентификаторыКоманд.Вставить("ИзменитьОрганизациюБИА", 		Новый Структура(СвойстваКоманды, "НадписьОрганизацияБИА",	НСтр("ru = 'Организация:'"),	"Организация",		"ОрганизацияБИА",		Новый ОписаниеТипов("СправочникСсылка.Организации")));
	ИдентификаторыКоманд.Вставить("ИзменитьНомерБИА", 				Новый Структура(СвойстваКоманды, "НадписьНомерБИА",			НСтр("ru = 'Номер:'"),			"Номер",			"НомерБИА",				Новый ОписаниеТипов("Строка")));
	ИдентификаторыКоманд.Вставить("ИзменитьДатуБИА", 				Новый Структура(СвойстваКоманды, "НадписьДатаБИА",			НСтр("ru = 'Дата:'"),			"Дата",				"ДатаБИА",				Новый ОписаниеТипов("Дата")));
	Возврат ИдентификаторыКоманд;
КонецФункции

Функция ИмяПодменюИнтеграцияС1САрхивом()
	Возврат "ПодменюИнтеграцияС1САрхивом";
КонецФункции

Функция ИмяВидаКомандИнтеграцияС1САрхивом()
	Возврат "ГруппаКомандИнтеграцияС1САрхивом";
КонецФункции

Функция ИмяКомандыИзменитьСведенияОФайле1САрхив() Экспорт
	Возврат СтрШаблон(НСтр("ru = '%1СмТакже__%2'"),ИмяПодменюИнтеграцияС1САрхивом(), ИдентификаторКомандыИзменитьСведенияОФайле1САрхив());
КонецФункции

Функция ИдентификаторКомандыИзменитьСведенияОФайле1САрхив() Экспорт
	Возврат "ИзменитьСведенияОФайле1САрхив";
КонецФункции

Процедура ПриСозданииНаСервереФормыСписка(Форма, ИмяСписка = "Список", ИмяКолонкиОбъекта = Неопределено) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДоступноЧтениеДокументовОтправленныхВ1САрхив() Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
		
		МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");
		
		ПараметрыРазмещения = МодульОбменСАрхивом.ПараметрыРазмещенияЭлементов();
		ПараметрыРазмещения.ИмяСписка = ИмяСписка;
		Если Не ИмяКолонкиОбъекта = Неопределено Тогда
			ПараметрыРазмещения.ИмяКолонкиОбъекта = ИмяКолонкиОбъекта;
		КонецЕсли;
		
		МодульОбменСАрхивом.ПриСозданииНаСервере(Форма, ПараметрыРазмещения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервереФормыСпискаФайлов(Форма)

	Если Форма.Параметры.РежимВыбора Тогда
		Форма.Параметры.МножественныйВыбор = Истина;
		Форма.Элементы.ГруппаОблачныйСервис.Видимость = Ложь;
		Форма.Элементы.ВладелецФайла.Видимость = Ложь;
		Форма.ЗакрыватьПриВыборе = Ложь;
		Для Каждого ЭлементКоманднойПанели Из Форма.Элементы.ФормаКоманднаяПанель.ПодчиненныеЭлементы Цикл
			ЭлементКоманднойПанели.Видимость = Ложь;
		КонецЦикла;
		
		Форма.Элементы.Список.КонтекстноеМеню.Видимость = Ложь;
		Форма.Элементы.СписокВажныеРеквизиты.Видимость = Ложь;
		Форма.Элементы.ФормаКоманднаяПанель.Видимость = Ложь;
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ВыполнитьКомандуИнтеграцииС1САрхивом(Знач Файлы, ДополнительныеПараметры) Экспорт

	Перем ИмяКоманды;
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");
	
	Если Не ДополнительныеПараметры.ОписаниеКоманды.ДополнительныеПараметры.Свойство("ИмяКоманды", ИмяКоманды) = Неопределено Тогда
		
		ДополнительныеПараметры.Вставить("Ссылка", Файлы);
		ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКоманды);
		
		Если ДополнительныеПараметры.Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность"
			И ИмяКоманды = ИмяКомандыОтправитьВ1САрхив() Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеПараметры.Форма, "АдресБланкаPDFВоВременномХранилище")
				И ТипЗнч(ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище) = Тип("СписокЗначений") Тогда
				ДополнительныеПараметры.Вставить("АдресБланкаPDFВоВременномХранилище", Новый ФиксированныйМассив(ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище.ВыгрузитьЗначения()));
			КонецЕсли;
		КонецЕсли;
		
		Если ДополнительныеПараметры.ИмяКоманды = ИмяКомандыОтправитьВ1САрхив() 
			И ДополнительныеПараметры.Ссылка.Метаданные() = Метаданные.Документы.РегламентированныйОтчет Тогда
			
			ПодготовитьКВыгрузкеРегламентированныйОтчет(ДополнительныеПараметры.Ссылка, ДополнительныеПараметры);
			МодульОбменСАрхивом.ЗаполнитьДокументыБИАНаФорме(ДополнительныеПараметры.Форма);
			МодульОбменСАрхивом.УстановитьВидимостьИДоступностьКоманд(ДополнительныеПараметры.Форма);
			
		Иначе
			
			МодульОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ДополнительныеПараметры.Форма, ДополнительныеПараметры);
			
		КонецЕсли;
		
	КонецЕсли;

	
КонецПроцедуры

Функция ВидимостьКоманд(Объект, Форма, ТаблицаДокументовБИА)
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь(,, Ложь);
	ОтправкаДоступнаПоРеквизитам = Не Объект.Ссылка.Пустая() И Не Объект.ПометкаУдаления И (Не ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта)
	Или МетаданныеОбъекта.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить
	Или Объект.Проведен);
	ЭтоАдминистраторОбмена = РольДоступна(Метаданные.Роли.АдминистрированиеОбменаС1САрхивом);
	ОтправкаДоступнаПоПравам = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена
	Или РольДоступна(Метаданные.Роли.ОтправкаДокументовВ1САрхив);
	ОтменаДоступнаБезОграничений = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена;
	ОтзывДоступенБезОграничений = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена;
	Если ОтправкаДоступнаПоПравам
		И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		ОтправкаДоступнаПоПравам = ОтправкаДоступнаПоПравам
		И МодульУправлениеДоступом.ИзменениеРазрешено(Объект.Ссылка, АвторизованныйПользователь);
	КонецЕсли;
	
	Если Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" И Не ЭтоПолноправныйПользователь
		И ОбщегоНазначения.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами")Тогда
		ОтправкаДоступнаПоПравам = ОтправкаДоступнаПоПравам И РольДоступна(Метаданные.Роли.ПросмотрПротоколовОтправкиВКонтролирующиеОрганы);
	КонецЕсли;
	
	Если ТаблицаДокументовБИА = Неопределено Тогда
		ОтмеченКОтправке = Ложь;
		ЕстьВыгруженные = Ложь;
	Иначе
		ОтмеченКОтправке = ТаблицаДокументовБИА.Количество() > 0;
		СтрокиВыгруженныхДокументов = ТаблицаДокументовБИА.НайтиСтроки(Новый Структура("Выгружен", Истина));
		ЕстьВыгруженные = СтрокиВыгруженныхДокументов.Количество() > 0;
	КонецЕсли;
	
	ВидимостьОтправить = ОтправкаДоступнаПоПравам И ОтправкаДоступнаПоРеквизитам И Не ОтмеченКОтправке;
	ВидимостьИстория = Ложь;
	Если ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ИсторияОбменаС1САрхивом) И РегистрыСведений.ИсторияОбменаС1САрхивом.ЕстьЗаписиПоОбъекту(Объект.Ссылка) Тогда
		ВидимостьИстория = Истина;
	КонецЕсли;
	ВидимостьОтменить = Ложь;
	ВидимостьОтозвать = Ложь;
	Если ОтправкаДоступнаПоПравам И ОтмеченКОтправке Тогда
		Если ЕстьВыгруженные Тогда
			ВидимостьОтозвать = ОтзывДоступенБезОграничений;
		ИначеЕсли ОтменаДоступнаБезОграничений Тогда
			ВидимостьОтменить = Истина;
		Иначе
			ЕстьЧужиеДокументы = Ложь;
			Если Не ТаблицаДокументовБИА = Неопределено Тогда
				Для Каждого СтрокаДокумента Из ТаблицаДокументовБИА Цикл
					Если СтрокаДокумента.Автор <> АвторизованныйПользователь Тогда
						ЕстьЧужиеДокументы = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ВидимостьОтменить = Не ЕстьЧужиеДокументы;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("ВидимостьИстория,ВидимостьОтменить,ВидимостьОтправить,ВидимостьОтозвать",ВидимостьИстория,ВидимостьОтменить,ВидимостьОтправить,ВидимостьОтозвать);

КонецФункции

Функция ПредставленияСтатусов()
	ПредставленияСтатусов = Новый Соответствие;
	СтатусыМенеджер = Перечисления.СтатусыОбменаС1САрхивом;
	ПредставленияСтатусов[СтатусыМенеджер.НеГотовКВыгрузке]
		= НСтр("ru = 'ожидает выгрузки в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ГотовКВыгрузке]
		= НСтр("ru = 'ожидает выгрузки в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ОбнаруженыОшибкиПриВыгрузке]
		= НСтр("ru = 'ошибка выгрузки в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ВыгрузкаВыполнена]
		= НСтр("ru = 'выгружен в 1С:Архив'");
	// Пока нет детализации ошибок пакета по документам, статус "ошибка" не выводится.
	ПредставленияСтатусов[СтатусыМенеджер.ОбнаруженыОшибкиПриЗагрузкеВАрхив]
		= НСтр("ru = 'выгружен в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ОбнаруженыОшибкиПриПроверкеВАрхиве]
		= НСтр("ru = 'выгружен в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ЗагрузкаВАрхивВыполнена]
		= НСтр("ru = 'загружен в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ПринятВАрхив]
		= НСтр("ru = 'принят в 1С:Архив'");
	Возврат ПредставленияСтатусов;
КонецФункции

Функция ПредставленияКомандВыгрузкиВАрхив()
	
	ПредставленияКоманд = Новый Структура;
	ПредставленияКоманд.Вставить("История",		НСтр("ru='История обмена с 1С:Архивом'"));
	ПредставленияКоманд.Вставить("Отменить",	НСтр("ru='Отменить отправку в 1С:Архив'"));
	ПредставленияКоманд.Вставить("Отправить",	НСтр("ru='Отправить в 1С:Архив'"));
	ПредставленияКоманд.Вставить("Отозвать",	НСтр("ru='Отозвать документ из 1С:Архива'"));
	ПредставленияКоманд.Вставить("Скачать",		НСтр("ru='Скачать'"));
	
	Возврат ПредставленияКоманд;
	
КонецФункции

Процедура УстановитьВидимостьИДоступностьКомандОбъекта(Объект, Форма)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,"ТаблицаДокументовБИА") Тогда
		ТаблицаДокументовБИА = Форма.ТаблицаДокументовБИА;
	Иначе
		ТаблицаДокументовБИА = ТаблицаДокументовБИА(Объект, Форма);
	КонецЕсли;
	
	ВидимостьКоманд = ВидимостьКоманд(Объект, Форма, ТаблицаДокументовБИА);
	
	ПредставленияКоманд = ПредставленияКомандВыгрузкиВАрхив();
	
	Для Каждого КомандаФормы Из Форма.Команды Цикл
		Если КомандаФормы.Заголовок = ПредставленияКоманд.История Тогда
			Форма.Элементы[КомандаФормы.Имя].Видимость = ВидимостьКоманд.ВидимостьИстория;
		ИначеЕсли КомандаФормы.Заголовок = ПредставленияКоманд.Отменить Тогда
			Форма.Элементы[КомандаФормы.Имя].Видимость = ВидимостьКоманд.ВидимостьОтменить;
		ИначеЕсли КомандаФормы.Заголовок = ПредставленияКоманд.Отправить Тогда
			Форма.Элементы[КомандаФормы.Имя].Видимость = ВидимостьКоманд.ВидимостьОтправить;
		ИначеЕсли КомандаФормы.Заголовок = ПредставленияКоманд.Отозвать Тогда
			Форма.Элементы[КомандаФормы.Имя].Видимость = ВидимостьКоманд.ВидимостьОтозвать;
		КонецЕсли;
	КонецЦикла;
	
	ИмяКнопкиДокументБИА = ИмяПодменюИнтеграцияС1САрхивом()+"Обычное__"+ИмяЭлементаДокументБИА();
	КнопкаДокументБИА = Форма.Элементы.Найти(ИмяКнопкиДокументБИА);

	ИмяКнопкиСкачатьДокументБИА = ИмяПодменюИнтеграцияС1САрхивом()+"Обычное__"+"СкачатьКонтейнерДокументаИз1САрхива";
	КнопкаСкачатьДокументБИА = Форма.Элементы.Найти(ИмяКнопкиСкачатьДокументБИА);
	
	Если КнопкаДокументБИА = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДокументов = ?(ТаблицаДокументовБИА = Неопределено, 0, ТаблицаДокументовБИА.Количество());
	Если Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" И Не КоличествоДокументов = 0 Тогда
		
		СтрокаДокумента = ТаблицаДокументовБИА[0];
		
		СтатусыМенеджер = Перечисления.СтатусыОбменаС1САрхивом;
		ПредставленияСтатусов = ПредставленияСтатусов();
		ПредставлениеСтатуса = ?(СтрокаДокумента.Уничтожен,
			НСтр("ru = 'уничтожен в 1С:Архиве'"),
			ПредставленияСтатусов[СтрокаДокумента.Статус]);
		
		КнопкаДокументБИА.Заголовок = СтрШаблон(НСтр("ru = 'Документ %1'"), ПредставлениеСтатуса);
		КнопкаДокументБИА.Видимость = Истина;
		КнопкаСкачатьДокументБИА.Видимость = СтрокаДокумента.Статус = СтатусыМенеджер.ЗагрузкаВАрхивВыполнена
			Или СтрокаДокумента.Статус = СтатусыМенеджер.ПринятВАрхив;
		
	Иначе
		КнопкаДокументБИА.Видимость = Ложь;
		КнопкаСкачатьДокументБИА.Видимость = Ложь;
	КонецЕсли;
	
	Если КоличествоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Индекс = 0 По КоличествоДокументов - 2 Цикл
		
		ИндексСтрокой = Формат(Индекс, "ЧГ=;ЧН=");
		ГруппаДокумент = Форма.Элементы.Найти("ГруппаДокументБИА" + ИндексСтрокой);
		Если ГруппаДокумент <> Неопределено Тогда
			ГруппаДокумент.Видимость = Ложь; 
		КонецЕсли;
	КонецЦикла;
	
	Индекс = КоличествоДокументов-1;
	ИндексСтрокой = Формат(Индекс, "ЧГ=;ЧН=");
	ГруппаДокумент = Форма.Элементы.Найти("ГруппаДокументБИА" + ИндексСтрокой);
	Если ГруппаДокумент <> Неопределено Тогда
		ЭлементДокументаБИА = Форма.Элементы.Найти("ИнформацияДокументаБИА"+ИндексСтрокой);
		Если ЭлементДокументаБИА <>  Неопределено Тогда
			ЭлементДокументаБИА.Видимость = Ложь;
			
			Форма.Элементы.Переместить(КнопкаДокументБИА, ГруппаДокумент, ЭлементДокументаБИА);
			КнопкаДокументБИА.Вид = ВидКнопкиФормы.Гиперссылка;
			КнопкаДокументБИА.Заголовок = ЭлементДокументаБИА.Заголовок;
			КнопкаДокументБИА.Видимость = Истина;
		КонецЕсли;
		
		ИмяКомандыСкачать = "СкачатьКонтейнерДокументаИз1САрхива" + ИндексСтрокой;
		КнопкаСкачать = Форма.Элементы.Найти(ИмяКомандыСкачать);
		
		Если КнопкаСкачатьДокументБИА <> Неопределено Тогда
			КнопкаСкачатьДокументБИА.Видимость = Ложь;
			Если КнопкаСкачать <> Неопределено Тогда
				КнопкаСкачать.ИмяКоманды = КнопкаСкачатьДокументБИА.ИмяКоманды;
				КнопкаСкачать.Заголовок = НСтр("ru = 'Скачать'");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

