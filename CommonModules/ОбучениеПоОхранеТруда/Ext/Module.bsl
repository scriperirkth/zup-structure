		Обработчик.ОбщиеДанные = Истина;
	КонецЕсли;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.1.36.56";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("f8fd7bbd-2950-4d6d-b759-03b6cf878750");
	Обработчик.Процедура = "ОбучениеПоОхранеТруда.ЗаполнитьРеквизитРабочееМестоВДокументеИнструктажПоОхранеТруда";
	Обработчик.Комментарий = НСтр("ru = 'Заполнение рабочих мест охраны труда в документах Инструктаж по охране труда.'");
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.1.36.57";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("622fcdbc-69cd-4cd8-a456-3459833e1659");
	Обработчик.Процедура = "ОбучениеПоОхранеТруда.ЗаполнитьПодразделенияОрганизацииВИнструктажахНаОснованииРабочихМест";
	Обработчик.Комментарий = НСтр("ru = 'Заполнение подразделений и организация табличной части Рабочие места в инструктажах.'");
	
КонецПроцедуры

Процедура ОтключениеКонтроляПроведенияУИнструктажейПомеченныхНаУдаление(ПараметрыОбновления = Неопределено) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыИнструктажейПоОхранеТруда.Ссылка КАК Инструктаж
		|ИЗ
		|	Справочник.ВидыИнструктажейПоОхранеТруда КАК ВидыИнструктажейПоОхранеТруда
		|ГДЕ
		|	ВидыИнструктажейПоОхранеТруда.КонтролироватьПроведение
		|	И ВидыИнструктажейПоОхранеТруда.ПометкаУдаления";
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Выборка = ОбновляемыеДанные.Выбрать();
	Пока Выборка.Следующий() Цикл
		ИнструктажСсылка = Выборка.Инструктаж; //СправочникСсылка.ВидыИнструктажейПоОхранеТруда
		Если Не ОбновлениеИБ.ПодготовитьОбновлениеДанных(
			ПараметрыОбновления, "Справочник.ВидыИнструктажейПоОхранеТруда", "Ссылка", ИнструктажСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ИнструктажОбъект = ИнструктажСсылка.ПолучитьОбъект();
		ИнструктажОбъект.КонтролироватьПроведение = Ложь;
		
		// АПК:1327-выкл Блокировка выполнена ОбновлениеИБ.ПодготовитьОбновлениеДанных
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ИнструктажОбъект);
		// АПК:1327-вкл
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРабочиеМестаОхраныТрудаВИнструктажахНаОснованииПозицийШтатногоРасписания(ПараметрыОбновления = Неопределено) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыИнструктажейПоОхранеТруда.Ссылка КАК Инструктаж
		|ПОМЕСТИТЬ ВТИнструктажиКОбновлению
		|ИЗ
		|	Справочник.ВидыИнструктажейПоОхранеТруда КАК ВидыИнструктажейПоОхранеТруда
		|ГДЕ
		|	НЕ ВидыИнструктажейПоОхранеТруда.ИспользоватьДляВсехРабочихМест
		|	И НЕ ВидыИнструктажейПоОхранеТруда.Ссылка В (&Обработанные)";
	
	Обработанные = Новый Массив; //СправочникСсылка.ВидыИнструктажейПоОхранеТруда
	Если ПараметрыОбновления <> Неопределено Тогда
		Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
			ПараметрыОбновления.Вставить("Обработанные");
		Иначе
			Обработанные = ПараметрыОбновления.Обработанные;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления, "ВТИнструктажиКОбновлению");
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИнструктажиКОбновлению.Инструктаж КАК Инструктаж,
		|	ПозицииШРИнструктажей.РабочееМесто КАК ДолжностьПоШтатномуРасписанию
		|ИЗ
		|	ВТИнструктажиКОбновлению КАК ИнструктажиКОбновлению
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыИнструктажейПоОхранеТруда.УдалитьРабочиеМеста КАК ПозицииШРИнструктажей
		|		ПО ИнструктажиКОбновлению.Инструктаж = ПозицииШРИнструктажей.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Инструктаж";
		
	// АПК:1328-выкл Блокировку выполнит ОбновлениеИБ.ПодготовитьОбновлениеДанных
	ТаблицаИнструктажей = Запрос.Выполнить().Выгрузить();
	// АПК:1328-вкл
	
	ЗарплатаКадры.УничтожитьВТ(Запрос.МенеджерВременныхТаблиц, "ВТИнструктажиКОбновлению");
	
	ПараметрыЗапроса = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыЗапроса.КадровыеДанные = "РабочееМестоОхраныТруда, ДолжностьПоШтатномуРасписанию";
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы,
		"ДолжностьПоШтатномуРасписанию", "В", ТаблицаИнструктажей.ВыгрузитьКолонку("ДолжностьПоШтатномуРасписанию"));
	
	УстановитьПривилегированныйРежим(Истина);
	Сотрудники = КадровыйУчет.СотрудникиОрганизации(Ложь, ПараметрыЗапроса);
	УстановитьПривилегированныйРежим(Ложь);
	ОбщегоНазначенияБЗК.ДобавитьИндексКоллекции(Сотрудники, "ДолжностьПоШтатномуРасписанию");
	
	РабочиеМестаПоПозициямШР = Новый Соответствие;
	
	Обход = Обработки.ОбходКоллекции.НовыйОбход(ТаблицаИнструктажей);
	Пока Обход.СледующийПоЗначениюПоля("Инструктаж") Цикл
		ИнструктажСсылка = Обход.ТекущиеДанные().Инструктаж; //СправочникСсылка.ВидыИнструктажейПоОхранеТруда
		Если Не ОбновлениеИБ.ПодготовитьОбновлениеДанных(
			ПараметрыОбновления, "Справочник.ВидыИнструктажейПоОхранеТруда", "Ссылка", ИнструктажСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ИнструктажОбъект = ИнструктажСсылка.ПолучитьОбъект();
		ИнструктажОбъект.РабочиеМеста.Очистить();
		
		РабочиеМестаДляИнструктажа = Новый Массив; //Массив Из СправочникСсылка.РабочиеМестаОхраныТруда
		
		Пока Обход.Следующий() Цикл
			ДолжностьПоШтатномуРасписанию = Обход.ТекущиеДанные().ДолжностьПоШтатномуРасписанию; //СправочникСсылка.ШтатноеРасписание
			Если Не ЗначениеЗаполнено(ДолжностьПоШтатномуРасписанию) Тогда
				Продолжить;
			КонецЕсли;
			РабочиеМестаПозиции = РабочиеМестаПоПозициямШР.Получить(ДолжностьПоШтатномуРасписанию);
			Если РабочиеМестаПозиции = Неопределено Тогда
				НайденныеСтроки = Сотрудники.НайтиСтроки(Новый Структура("ДолжностьПоШтатномуРасписанию", ДолжностьПоШтатномуРасписанию));
				РабочиеМестаПозиции = Новый Массив; //Массив Из СправочникСсылка.РабочиеМестаОхраныТруда
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					Если ЗначениеЗаполнено(НайденнаяСтрока.РабочееМестоОхраныТруда) Тогда
						РабочиеМестаПозиции.Добавить(НайденнаяСтрока.РабочееМестоОхраныТруда);
					КонецЕсли;
				КонецЦикла;
				РабочиеМестаПоПозициямШР.Вставить(ДолжностьПоШтатномуРасписанию, РабочиеМестаПозиции);
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РабочиеМестаДляИнструктажа, РабочиеМестаПозиции, Истина);
		КонецЦикла;
		
		Для Каждого РабочееМесто Из РабочиеМестаДляИнструктажа Цикл
			ИнструктажОбъект.РабочиеМеста.Добавить().РабочееМесто = РабочееМесто;
		КонецЦикла;
		
		// АПК:1327-выкл Блокировка выполнена ОбновлениеИБ.ПодготовитьОбновлениеДанных
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ИнструктажОбъект);
		// АПК:1327-вкл
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		Обработанные.Добавить(ИнструктажСсылка);
	КонецЦикла;
	
	ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);

КонецПроцедуры

Процедура ЗаполнитьРеквизитРабочееМестоВДокументеИнструктажПоОхранеТруда(ПараметрыОбновления = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РегистрСведенийИнструктажиПоОхранеТруда.Регистратор КАК Ссылка,
		|	РегистрСведенийИнструктажиПоОхранеТруда.Период КАК ДатаПроведения,
		|	РегистрСведенийИнструктажиПоОхранеТруда.Сотрудник КАК Сотрудник,
		|	ИСТИНА КАК ТолькоПерепроведение
		|ПОМЕСТИТЬ ВТДокументыКОбработке
		|ИЗ
		|	РегистрСведений.ИнструктажиПоОхранеТруда КАК РегистрСведенийИнструктажиПоОхранеТруда
		|ГДЕ
		|	РегистрСведенийИнструктажиПоОхранеТруда.РабочееМесто = &ПустоеРабочееМесто
		|	И НЕ РегистрСведенийИнструктажиПоОхранеТруда.Регистратор В (&Обработанные)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИнструктажПоОхранеТрудаСотрудники.Ссылка,
		|	ИнструктажПоОхранеТруда.ДатаПроведения,
		|	ИнструктажПоОхранеТрудаСотрудники.Сотрудник,
		|	ЛОЖЬ
		|ИЗ
		|	Документ.ИнструктажПоОхранеТруда.Сотрудники КАК ИнструктажПоОхранеТрудаСотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИнструктажПоОхранеТруда КАК ИнструктажПоОхранеТруда
		|		ПО ИнструктажПоОхранеТрудаСотрудники.Ссылка = ИнструктажПоОхранеТруда.Ссылка
		|ГДЕ
		|	ИнструктажПоОхранеТрудаСотрудники.РабочееМесто = &ПустоеРабочееМесто
		|	И НЕ ИнструктажПоОхранеТрудаСотрудники.Ссылка В (&Обработанные)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДокументыКОбработке.Ссылка КАК Ссылка,
		|	ДокументыКОбработке.ДатаПроведения КАК ДатаПроведения,
		|	ДокументыКОбработке.ТолькоПерепроведение КАК ТолькоПерепроведение
		|ИЗ
		|	ВТДокументыКОбработке КАК ДокументыКОбработке";
	
	Обработанные = Новый Массив;
	Если ПараметрыОбновления <> Неопределено Тогда
		Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
			ПараметрыОбновления.Вставить("Обработанные", Обработанные);
		ИначеЕсли ПараметрыОбновления.Обработанные <> Неопределено Тогда
			Обработанные = ПараметрыОбновления.Обработанные;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("ПустоеРабочееМесто", Справочники.РабочиеМестаОхраныТруда.ПустаяСсылка());
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);
	
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	// Получаем кадровые данные только для сотрудников, требующих заполнения рабочего места
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДокументыКОбработке.ДатаПроведения КАК Период,
		|	ДокументыКОбработке.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ ВТСотрудникиКОбработке
		|ИЗ
		|	ВТДокументыКОбработке КАК ДокументыКОбработке
		|ГДЕ
		|	НЕ ДокументыКОбработке.ТолькоПерепроведение";
	Запрос.Выполнить();
		
	// Получаем кадровые данные только если есть сотрудники для заполнения
	КадровыеДанныеСотрудников = Неопределено;
	Если ЗарплатаКадры.ВТСодержитСтроки(Запрос.МенеджерВременныхТаблиц, "ВТСотрудникиКОбработке") Тогда
		ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(
			Запрос.МенеджерВременныхТаблиц, "ВТСотрудникиКОбработке");
		КадровыеДанные = "РабочееМестоОхраныТруда";
		КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВременныхТаблиц, Истина, КадровыеДанные);
		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КадровыеДанныеСотрудников.Период КАК Период,
			|	КадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
			|	КадровыеДанныеСотрудников.РабочееМестоОхраныТруда КАК РабочееМестоОхраныТруда
			|ИЗ
			|	ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
			|ГДЕ
			|	КадровыеДанныеСотрудников.РабочееМестоОхраныТруда <> &ПустоеРабочееМесто";
		
		КадровыеДанныеСотрудников = Запрос.Выполнить().Выгрузить();
		КадровыеДанныеСотрудников.Индексы.Добавить("Период, Сотрудник");
	КонецЕсли;
	
	Отбор = Новый Структура("Период, Сотрудник");
	
	Выборка = ОбновляемыеДанные.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ОбновлениеИБ.ПодготовитьОбновлениеДанных(
			ПараметрыОбновления, "Документ.ИнструктажПоОхранеТруда", "Ссылка", Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Записывать = Ложь;
		
		// Для документов "только перепроведение" - не пытаемся заполнить рабочие места
		Если Выборка.ТолькоПерепроведение Тогда
			// Проверяем, есть ли хотя бы одно заполненное рабочее место для перепроведения
			Для Каждого СтрокаТЧ Из ДокументОбъект.Сотрудники Цикл
				Если ЗначениеЗаполнено(СтрокаТЧ.РабочееМесто) Тогда
					Записывать = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			// Заполняем пустые рабочие места из кадровых данных
			Если КадровыеДанныеСотрудников <> Неопределено Тогда
				Отбор.Период = ДокументОбъект.ДатаПроведения;
				
				Для Каждого СтрокаТЧ Из ДокументОбъект.Сотрудники Цикл
					Если ЗначениеЗаполнено(СтрокаТЧ.РабочееМесто) Тогда
						// Рабочее место уже заполнено
						Записывать = Истина;
						Продолжить;
					КонецЕсли;
					
					Отбор.Сотрудник = СтрокаТЧ.Сотрудник;
					НайденныеСтроки = КадровыеДанныеСотрудников.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						СтрокаТЧ.РабочееМесто = НайденныеСтроки[0].РабочееМестоОхраныТруда;
						Записывать = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если Записывать Тогда
			// АПК:1327-выкл Блокировка выполнена ОбновлениеИБ.ПодготовитьОбновлениеДанных
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(
				ДокументОбъект,,, ?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			// АПК:1327-вкл
		КонецЕсли;
		
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		Обработанные.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);

КонецПроцедуры

Процедура ЗаполнитьПодразделенияОрганизацииВИнструктажахНаОснованииРабочихМест(ПараметрыОбновления = Неопределено) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВидыИнструктажейПоОхранеТруда.Ссылка КАК Инструктаж
		|ИЗ
		|	Справочник.ВидыИнструктажейПоОхранеТруда КАК ВидыИнструктажейПоОхранеТруда
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыИнструктажейПоОхранеТруда.РабочиеМеста КАК РабочиеМестаИнструктажей
		|		ПО ВидыИнструктажейПоОхранеТруда.Ссылка = РабочиеМестаИнструктажей.Ссылка
		|		И РабочиеМестаИнструктажей.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|ГДЕ
		|	НЕ ВидыИнструктажейПоОхранеТруда.ИспользоватьДляВсехРабочихМест";
	
	ОбновляемыеДанные = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);
	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Выборка = ОбновляемыеДанные.Выбрать();
	Пока Выборка.Следующий() Цикл
		ИнструктажСсылка = Выборка.Инструктаж; //СправочникСсылка.ВидыИнструктажейПоОхранеТруда
		Если Не ОбновлениеИБ.ПодготовитьОбновлениеДанных(
			ПараметрыОбновления, "Справочник.ВидыИнструктажейПоОхранеТруда", "Ссылка", ИнструктажСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ИнструктажОбъект = ИнструктажСсылка.ПолучитьОбъект();
		ЗаполнитьРеквизитыТабличнойЧастиПоРабочимМестам(ИнструктажОбъект);
		
		// АПК:1327-выкл Блокировка выполнена ОбновлениеИБ.ПодготовитьОбновлениеДанных
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ИнструктажОбъект);
		// АПК:1327-вкл
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет реквизиты табличной части "Рабочие места" документа на основании данных рабочих мест.
//
// Параметры:
//   Объект - СправочникОбъект.ПрограммыОбученияСотрудниковПоОхранеТруда, СправочникОбъект.ВидыИнструктажейПоОхранеТруда - 
Процедура ЗаполнитьРеквизитыТабличнойЧастиПоРабочимМестам(Объект) Экспорт
	
	Если Объект.РабочиеМеста.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитовРабочихМест = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		Объект.РабочиеМеста.ВыгрузитьКолонку("РабочееМесто"), "Подразделение, Владелец");
	Для Каждого СтрокаТЧ Из Объект.РабочиеМеста Цикл
		ЗначенияРеквизитовРабочегоМеста = ЗначенияРеквизитовРабочихМест[СтрокаТЧ.РабочееМесто];
		СтрокаТЧ.Подразделение = ЗначенияРеквизитовРабочегоМеста.Подразделение;
		СтрокаТЧ.Организация = ЗначенияРеквизитовРабочегоМеста.Владелец;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРегламентированнойОтчетности

// См. РегламентированнаяОтчетностьПереопределяемый.ПолучитьСведенияОПоказателяхОтчета
Процедура ПриПолученииСведенийОПоказателяхОтчета(ПоказателиОтчета, ИДОтчета, ИДРедакцииОтчета, ПараметрыОтчета) Экспорт
	
	Если ИДОтчета = "РегламентированныйОтчетОбученныеПоОхранеТрудаЛица" И ИДРедакцииОтчета >= "ФормаОтчета2023Кв1" Тогда
		ОписаниеПоказателей_ОбученныеПоОхранеТрудаЛица_2023Кв1(ПоказателиОтчета, ПараметрыОтчета);
	КонецЕсли;
	
КонецПроцедуры

// См. РегламентированнаяОтчетностьПереопределяемый.ЗаполнитьОтчет
Процедура ПриЗаполненииРегламентированногоОтчета(ИДОтчета, ИДРедакцииОтчета, ПараметрыОтчета, Контейнер) Экспорт
	
	Если ИДОтчета = "РегламентированныйОтчетОбученныеПоОхранеТрудаЛица" И ИДРедакцииОтчета >= "ФормаОтчета2023Кв1" Тогда
		ЗначенияПоказателей_ОбученныеПоОхранеТрудаЛица_2023Кв1(ПараметрыОтчета, Контейнер);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// См. ОбщегоНазначенияПереопределяемый.ПриДобавленииПереименованийОбъектовМетаданных
Процедура ЗаполнитьТаблицуПереименованияОбъектовМетаданных(Переименования) Экспорт
	
	ОбщегоНазначения.ДобавитьПереименование(Переименования,
		"3.1.36.29",
		"Подсистема.ОхранаТруда.Инструктажи",
		"Подсистема.ОхранаТруда.ОбучениеПоОхранеТруда");
	
	ОбщегоНазначения.ДобавитьПереименование(Переименования,
		"3.1.36.29",
		"Подсистема.ЗарплатаКадрыКорпоративнаяПодсистемы.ОхранаТруда.Инструктажи",
		"Подсистема.ЗарплатаКадрыКорпоративнаяПодсистемы.ОхранаТруда.ОбучениеПоОхранеТруда");
	
КонецПроцедуры

// Возвращает список сотрудников, требующих обучения по заданной программе.
//
// Параметры:
//   МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - менеджер временных таблиц для выполнения запроса
//   РеквизитыПрограммыОбучения - Структура - реквизиты программы обучения, по которой необходимо получить список сотрудников:
//      * Ссылка - СправочникСсылка.ПрограммыОбученияСотрудниковПоОхранеТруда - 
//      * ИспользоватьДляВсехРабочихМест - Булево - признак использования для всех рабочих мест
//      * ПроводитсяПовторно - Булево - 
//      * Периодичность - ПеречислениеСсылка.Периодичность - 
//      * КоличествоРаз - Число - 
//      * КоличествоПериодов - Число - 
//      * РабочиеМеста - ТаблицаЗначений - 
//   НачалоПериода - Дата - 
//   ОкончаниеПериода - Дата - 
//   ПроверятьАктуальностьОбучения - Булево - 
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица со списком сотрудников, требующих обучения
Функция СотрудникиТребующиеОбучение(
	МенеджерВременныхТаблиц, РеквизитыПрограммыОбучения, НачалоПериода, ОкончаниеПериода, ПроверятьАктуальностьОбучения) Экспорт
	
	ОбученияСотрудников = Новый ТаблицаЗначений;
	ОбученияСотрудников.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ОбученияСотрудников.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	ОбученияСотрудников.Колонки.Добавить("ПлановаяДатаПроверкиЗнания", Новый ОписаниеТипов("Дата"));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПрограммаОбучения", РеквизитыПрограммыОбучения.Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СотрудникиОрганизации.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СотрудникиОрганизации.РабочееМестоОхраныТруда КАК РабочееМесто,
		|	&ПрограммаОбучения КАК ПрограммаОбучения
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	ВТСотрудникиОрганизации КАК СотрудникиОрганизации
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ФизическоеЛицо,
		|	РабочееМесто,
		|	ПрограммаОбучения";
	Запрос.Выполнить();
	
	СоздатьВТПройденныеОбучения(МенеджерВременныхТаблиц, ОкончаниеПериода);
	
	Запрос.УстановитьПараметр("КонтролироватьСменуРабочегоМеста", РеквизитыПрограммыОбучения.КонтролироватьСменуРабочегоМеста);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.РабочееМестоОхраныТруда КАК РабочееМесто,
		|	МИНИМУМ(Сотрудники.РабочееМестоОхраныТрудаПериодРегистрации) КАК ПлановаяДатаПроверкиЗнания,
		|	ПройденныеОбучения.ДатаПроверки КАК ДатаПроверки,
		|	ПройденныеОбучения.РезультатПроверки КАК РезультатПроверки
		|ИЗ
		|	ВТСотрудникиОрганизации КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПройденныеОбучения КАК ПройденныеОбучения
		|		ПО Сотрудники.ФизическоеЛицо = ПройденныеОбучения.ФизическоеЛицо
		|			И (ВЫБОР
		|				КОГДА НЕ &КонтролироватьСменуРабочегоМеста
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ Сотрудники.РабочееМестоОхраныТруда = ПройденныеОбучения.РабочееМесто
		|			КОНЕЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	Сотрудники.ФизическоеЛицо,
		|	Сотрудники.РабочееМестоОхраныТруда,
		|	ПройденныеОбучения.ДатаПроверки,
		|	ПройденныеОбучения.РезультатПроверки";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.ДатаПроверки) Тогда
			Если ПроверятьАктуальностьОбучения И ЗначениеЗаполнено(Выборка.ПлановаяДатаПроверкиЗнания)
				И (Выборка.ПлановаяДатаПроверкиЗнания < НачалоПериода Или Выборка.ПлановаяДатаПроверкиЗнания > ОкончаниеПериода) Тогда
				Продолжить;
			КонецЕсли;
			// Обучение не проводилось.
			НоваяСтрока = ОбученияСотрудников.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			Продолжить;
		КонецЕсли;
		Если Выборка.РезультатПроверки = Перечисления.РезультатыПроверкиЗнанияПоОхранеТруда.Неудовлетворительно Тогда
			Если ПроверятьАктуальностьОбучения И (Выборка.ДатаПроверки < НачалоПериода Или Выборка.ДатаПроверки > ОкончаниеПериода) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ОбученияСотрудников.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.ПлановаяДатаПроверкиЗнания = Выборка.ДатаПроверки;
			Продолжить;
		КонецЕсли;
		ОписаниеПериодичности = ОписаниеПериодичностиОбучений();
		ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, РеквизитыПрограммыОбучения);
		// Обучение проводилось, проверяем его актуальность.
		ДатаСледующейПроверкиЗнания = ДатаСледующейПроверкиЗнания(Выборка.ДатаПроверки, РеквизитыПрограммыОбучения);
		Если ПроверятьАктуальностьОбучения И (ДатаСледующейПроверкиЗнания < НачалоПериода Или ДатаСледующейПроверкиЗнания > ОкончаниеПериода) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ОбученияСотрудников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ПлановаяДатаПроверкиЗнания = ДатаСледующейПроверкиЗнания;
	КонецЦикла;
	
	Возврат ОбученияСотрудников;
	
КонецФункции

// Создает временную таблицу пройденных обучения по охране труда.
//
// Параметры:
//   МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц запроса
//   ДатаАктуальности - Дата - дата, на которую актуальны данные
//   ИмяВТСотрудники - Строка - имя временной таблицы сотрудников, по умолчанию "ВТСотрудники"
//   ФизическоеЛицо - СправочникСсылка.ФизическиеЛица - физическое лицо, для которого нужно получить обучения, если не указано - используются все из ВТСотрудники
Процедура СоздатьВТПройденныеОбучения(МенеджерВТ, ДатаАктуальности, ИмяВТСотрудники = "ВТСотрудники", ФизическоеЛицо = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбученияПоРабочимМестам.Период КАК ДатаПроверки,
		|	ОбученияПоРабочимМестам.Регистратор КАК Проверка,
		|	ОбученияПоРабочимМестам.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОбученияПоРабочимМестам.РабочееМесто КАК РабочееМесто,
		|	ОбученияПоРабочимМестам.ПрограммаОбучения КАК ПрограммаОбучения,
		|	ОбученияПоРабочимМестам.РезультатПроверки КАК РезультатПроверки,
		|	ОбученияПоРабочимМестам.Обучение КАК Обучение
		|ПОМЕСТИТЬ ВТПройденныеОбучения
		|ИЗ
		|	РегистрСведений.ПроверкиЗнанияТребованийОхраныТрудаСотрудников.СрезПоследних(
		|			&ДатаАктуальности,
		|			&УсловияОтбора) КАК ОбученияПоРабочимМестам";
	
	Если ФизическоеЛицо = Неопределено Тогда
		УсловияОтбора = СтрШаблон(
			"(ФизическоеЛицо, ПрограммаОбучения) В (ВЫБРАТЬ Т.ФизическоеЛицо, Т.ПрограммаОбучения ИЗ %1 КАК Т)", ИмяВТСотрудники);
	Иначе
		УсловияОтбора = "ФизическоеЛицо = &ФизическоеЛицо";
		Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбора", УсловияОтбора);
	Запрос.Выполнить();
	
КонецПроцедуры

// Возвращает список сотрудников, ожидающих проверку по заданной программе.
//
// Параметры:
//   МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - 
//   ПрограммаОбучения - СправочникСсылка.ПрограммыОбученияСотрудниковПоОхранеТруда - 
//   НачалоПериода - Дата - 
//   ОкончаниеПериода - Дата - 
Процедура СоздатьВТСотрудникиОжидающиеПроверку(МенеджерВременныхТаблиц, ПрограммаОбучения, НачалоПериода, ОкончаниеПериода) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПрограммаОбучения", ПрограммаОбучения);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.РабочееМесто КАК РабочееМесто,
		|	ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.Обучение КАК Обучение,
		|	ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.ДатаНачалаОбучения КАК ДатаНачалаОбучения,
		|	ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.ДатаОкончанияОбучения КАК ДатаОкончанияОбучения
		|ПОМЕСТИТЬ ВТСотрудникиОжидающиеПроверку
		|ИЗ
		|	РегистрСведений.ОбученияСотрудниковОхранеТрудаОжидающиеПроверки КАК ОбученияСотрудниковОхранеТрудаОжидающиеПроверки
		|ГДЕ
		|	ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.ПрограммаОбучения = &ПрограммаОбучения
		|	И ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.Период >= &НачалоПериода
		|	И ОбученияСотрудниковОхранеТрудаОжидающиеПроверки.Период <= &ОкончаниеПериода";
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Возвращает последние проверки знания по охране труда для указанных сотрудников.
//
// Параметры:
//   ФизическиеЛица - Массив из СправочникСсылка.ФизическиеЛица - список физических лиц, для которых необходимо получить проверки
//
// Возвращаемое значение:
//   ТаблицаЗначений - результаты последних проверок знания по охране труда для указанных сотрудников
Функция ОбученияСотрудниковПоОхранеТруда(ФизическиеЛица) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛица);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПроверкиЗнанияТребованийОхраныТруда.Регистратор КАК Документ,
		|	ПроверкиЗнанияТребованийОхраныТруда.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПроверкиЗнанияТребованийОхраныТруда.ПрограммаОбучения КАК ПрограммаОбучения,
		|	ПроверкиЗнанияТребованийОхраныТруда.Период КАК ДатаПроверкиЗнания,
		|	ПроверкиЗнанияТребованийОхраныТруда.НомерПротокола КАК НомерПротокола,
		|	ПроверкиЗнанияТребованийОхраныТруда.РезультатПроверки КАК РезультатПроверки,
		|	ПроверкиЗнанияТребованийОхраныТруда.ДатаНачалаОбучения КАК ДатаНачалаОбучения,
		|	ПроверкиЗнанияТребованийОхраныТруда.ДатаОкончанияОбучения КАК ДатаОкончанияОбучения
		|ИЗ
		|	РегистрСведений.ПроверкиЗнанияТребованийОхраныТрудаСотрудников.СрезПоследних(, ФизическоеЛицо В (&ФизическиеЛица)) КАК ПроверкиЗнанияТребованийОхраныТруда";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает ссылку на документ "Проверка знания требований охраны труда" для указанного обучения.
//
// Параметры:
//   Обучение - ДокументСсылка.ОбучениеСотрудниковОхранеТруда - Ссылка на обучение сотрудников
//
// Возвращаемое значение:
//   Соответствие - 
Функция ПроверкиПоОбучению(Обучение) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Обучение", Обучение);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПроверкаЗнанияТребованийОхраныТруда.Ссылка КАК Проверка,
		|	ПроверкаЗнанияТребованийОхраныТрудаРезультатыОбучения.ФизическоеЛицо
		|ИЗ
		|	Документ.ПроверкаЗнанияТребованийОхраныТруда КАК ПроверкаЗнанияТребованийОхраныТруда
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПроверкаЗнанияТребованийОхраныТруда.РезультатыОбучения КАК
		|			ПроверкаЗнанияТребованийОхраныТрудаРезультатыОбучения
		|		ПО ПроверкаЗнанияТребованийОхраныТруда.Ссылка = ПроверкаЗнанияТребованийОхраныТрудаРезультатыОбучения.Ссылка
		|		И ПроверкаЗнанияТребованийОхраныТрудаРезультатыОбучения.Обучение = &Обучение
		|		И НЕ ПроверкаЗнанияТребованийОхраныТруда.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПроверкаЗнанияТребованийОхраныТруда.Дата";
	
	СоответствиеПроверокФизическимЛицам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеПроверокФизическимЛицам.Вставить(Выборка.ФизическоеЛицо, Выборка.Проверка);
	КонецЦикла;
	
	Возврат СоответствиеПроверокФизическимЛицам;
	
КонецФункции

// Возвращает структуру с описанием периодичности обучений по охране труда.
//
// Возвращаемое значение:
//   Структура - описание периодичности обучений, содержащее информацию о повторении, количестве раз и периоде
Функция ОписаниеПериодичностиОбучений() Экспорт
	
	Описание = Новый Структура;
	
	Описание.Вставить("ПроводитсяПовторно", Ложь);
	Описание.Вставить("КоличествоРаз", 0);
	Описание.Вставить("КоличествоПериодов", 0);
	Описание.Вставить("Периодичность", Перечисления.Периодичность.ПустаяСсылка());
	Описание.Вставить("Представление", "");
	
	Возврат Описание;
	
КонецФункции

// Вычисляет дату следующего обучения с учетом периодичности.
//
// Параметры:
//  ДатаПроверки - Дата - Дата предыдущей проверки знания
//  ОписаниеПериодичности - см. ОписаниеПериодичностиОбучений
//
// Возвращаемое значение:
//  Дата - Дата следующей проверки или Неопределено, если кратность периодичности равна нулю.
//
Функция ДатаСледующейПроверкиЗнания(ДатаПроверки, ОписаниеПериодичности) Экспорт
	
	Если Не ОписаниеПериодичности.ПроводитсяПовторно Тогда
		Возврат ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата();
	КонецЕсли;
	
	Если ОписаниеПериодичности.КоличествоРаз = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КоличествоМесяцев = МесяцевВЕдиницеИзмерения(ОписаниеПериодичности.Периодичность);
	Если КоличествоМесяцев <> Неопределено Тогда
		ИнтервалВМесяцах = ОписаниеПериодичности.КоличествоПериодов * КоличествоМесяцев / ОписаниеПериодичности.КоличествоРаз;
		Возврат ДобавитьМесяц(ДатаПроверки, ИнтервалВМесяцах);
	КонецЕсли;
	
	КоличествоДней = ДнейВЕдиницеИзмерения(ОписаниеПериодичности.Периодичность);
	Если КоличествоДней = 0 Тогда
		Возврат ДатаПроверки;
	КонецЕсли;
	
	ИнтервалВДнях = ОписаниеПериодичности.КоличествоПериодов * КоличествоДней / ОписаниеПериодичности.КоличествоРаз;
	Возврат НачалоДня(ДатаПроверки + ИнтервалВДнях * ЗарплатаКадрыКлиентСервер.ДлительностьСутокВСекундах());
	
КонецФункции

#Область Инструктажи

// Возвращает последние инструктажи по охране труда для указанных сотрудников.
//
// Параметры:
//   Сотрудники - Массив из СправочникСсылка.Сотрудники - список сотрудников, для которых необходимо получить инструктажи
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с данными об инструктажах
Функция ИнструктажиСотрудниковПоОхранеТруда(Сотрудники) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИнструктажиПоОхранеТруда.Регистратор КАК Документ,
	|	ИнструктажиПоОхранеТруда.ВидИнструктажа КАК ВидИнструктажа,
	|	ИнструктажиПоОхранеТруда.Период КАК ДатаПроведения,
	|	ИнструктажиПоОхранеТруда.Сотрудник КАК Сотрудник,
	|	ИнструктажиПоОхранеТруда.Сотрудник.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	РегистрСведений.ИнструктажиПоОхранеТруда.СрезПоследних(, Сотрудник В (&Сотрудники)) КАК ИнструктажиПоОхранеТруда";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область ОбменДанными

// См. СинхронизацияДанныхЗарплатаКадрыИнтеграцияПодсистем.ЗаполнитьТаблицуЗависимыхДанных.
Процедура ПриЗаполненииТаблицыЗависимыхДанныхДляОбмена(ЗависимыеДанные) Экспорт
	
	// Метаданные.РегистрыСведений.КадроваяИсторияСотрудников
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.КадроваяИсторияСотрудников;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда;
	
	// Метаданные.РегистрыСведений.РабочиеМестаСотрудников
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.РабочиеМестаСотрудников;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда;
	
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.РабочиеМестаСотрудников;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.БудущиеСобытияОбучениеПоОхранеТруда;
	
	// Метаданные.Справочники.ФизическиеЛица
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.Справочники.ФизическиеЛица;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда;
	
	// Метаданные.РегистрыСведений.ПроверкиЗнанияТребованийОхраныТрудаСотрудников
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.ПроверкиЗнанияТребованийОхраныТрудаСотрудников;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда;
	
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.ПроверкиЗнанияТребованийОхраныТрудаСотрудников;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.БудущиеСобытияОбучениеПоОхранеТруда;
	
	// Метаданные.Справочники.ПрограммыОбученияСотрудниковПоОхранеТруда
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.Справочники.ПрограммыОбученияСотрудниковПоОхранеТруда;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда;
	
КонецПроцедуры

Процедура ЗаполнитьЗависимыеДанныеПослеСозданияНовогоУзла() Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОбучениеПоОхранеТруда") Тогда
		Возврат;
	КонецЕсли;
	
	// После создания нового узла нужно полностью заполнить вторичные данные, 
	// т.к. они не включаются в состав начального образа.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|ГДЕ
		|	НЕ ФизическиеЛица.Ссылка В (&Обработанные)";
	
	Обработанные = Новый Массив;
	Пока Истина Цикл
		Запрос.УстановитьПараметр("Обработанные", Обработанные);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли;
		ФизическиеЛица = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ФизическоеЛицо");
		ТаблицаОбновления = НоваяТаблицаОбновлениеПериодическихОбучений();
		ЗаполнитьТаблицуОбновленияПериодическихОбученийПоФизическимЛицам(ТаблицаОбновления, ФизическиеЛица);
		ЗарегистрироватьОбновлениеПериодическихОбучений(ТаблицаОбновления);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Обработанные, ФизическиеЛица);
	КонецЦикла;
	
	ОбновитьПериодическиеОсмотрыНаОснованииБудущихНазначенийРабочихМест();
	ЗапуститьОбновлениеПериодическихОбученийПоОхранеТруда();
	
КонецПроцедуры

#КонецОбласти

Процедура ЗапуститьОбновлениеПериодическихОбученийПоОхранеТруда(Организация = Неопределено, ФизическиеЛица = Неопределено) Экспорт
	
	ПараметрыФО = Новый Структура;
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыФО.Вставить("Организация", Организация);
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОбучениеПоОхранеТруда", ПараметрыФО) Тогда 
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Массив;
	Параметры.Добавить(Организация);
	Параметры.Добавить(ФизическиеЛица);
	
	ФоновыеЗадания.Выполнить("ОбучениеПоОхранеТруда.ОбновитьПериодическиеОбучения", Параметры);
	
КонецПроцедуры

#Область ПодключениеСобытийОбновленияПериодическихОсмотров

Процедура ЗарегистрироватьИзменениеРабочихМестДляОбученияПоОхранеТрудаПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицыОбновленияРегистраСведенийДляОбученияПоОхранеТруда(Источник, Замещение, "РабочееМесто");
	
	ТаблицаОбновлениеПериодическихОбучений = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Источник.ДополнительныеСвойства, "ТаблицаОбновлениеПериодическихОбучений"); // ТаблицаЗначений
	ТаблицаБудущиеСобытияОбучениеПоОхранеТруда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Источник.ДополнительныеСвойства, "ТаблицаБудущиеСобытияОбучениеПоОхранеТруда"); // ТаблицаЗначений
	ЗарегистрироватьОбновлениеПериодическихОбучений(ТаблицаОбновлениеПериодическихОбучений);
	ЗарегистрироватьБудущиеСобытияОбучениеПоОхранеТруда(ТаблицаБудущиеСобытияОбучениеПоОхранеТруда);
	
КонецПроцедуры

Процедура ЗарегистрироватьИзменениеКадровойИсторииДляОбученияПоОхранеТрудаПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицыОбновленияРегистраСведенийДляОбученияПоОхранеТруда(Источник, Замещение, "ДолжностьПоШтатномуРасписанию", Истина);
	
	ТаблицаОбновлениеПериодическихОбучений = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Источник.ДополнительныеСвойства, "ТаблицаОбновлениеПериодическихОбучений"); // ТаблицаЗначений
	ТаблицаБудущиеСобытияОбучениеПоОхранеТруда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Источник.ДополнительныеСвойства, "ТаблицаБудущиеСобытияОбучениеПоОхранеТруда"); // ТаблицаЗначений
	ЗарегистрироватьОбновлениеПериодическихОбучений(ТаблицаОбновлениеПериодическихОбучений);
	ЗарегистрироватьБудущиеСобытияОбучениеПоОхранеТруда(ТаблицаБудущиеСобытияОбучениеПоОхранеТруда);
	
КонецПроцедуры

#КонецОбласти

#Область ПодключениеВводаНаОсновании

// Параметры:
//   ДокументОбъект - ДокументОбъект.КадровыйПереводСписком, ДокументОбъект.УвольнениеСписком, ДокументОбъект.НазначениеРабочихМестСотрудникам - 
//   ЕстьФизическоеЛицоВТЧ - Булево - 
Процедура ПриЗаписиДокументаОтстранения(ДокументОбъект, ЕстьФизическоеЛицоВТЧ = Истина) Экспорт
	
	ПроверкаЗнания = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства, "ПроверкаЗнания");
	Если Не ЗначениеЗаполнено(ПроверкаЗнания)
		Или ТипЗнч(ПроверкаЗнания) <> Тип("ДокументСсылка.ПроверкаЗнанияТребованийОхраныТруда") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.ОтстранениеОтРаботыПоРезультатамОбученияОхранеТруда.СоздатьНаборЗаписей();
	
	Если Не ЕстьФизическоеЛицоВТЧ Тогда
		ФизическиеЛицаСотрудников = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(
			ДокументОбъект.Сотрудники.ВыгрузитьКолонку("Сотрудник"), "ФизическоеЛицо");
	КонецЕсли;
	
	Для Каждого СтрокаСотрудника Из ДокументОбъект.Сотрудники Цикл
		СтрокаНабора = НаборЗаписей.Добавить();
		СтрокаНабора.ДокументОтстранения = ДокументОбъект.Ссылка;
		Если ЕстьФизическоеЛицоВТЧ Тогда
			СтрокаНабора.ФизическоеЛицо = СтрокаСотрудника.ФизическоеЛицо;
		Иначе
			СтрокаНабора.ФизическоеЛицо = ФизическиеЛицаСотрудников.Получить(СтрокаСотрудника.Сотрудник);
		КонецЕсли;
		СтрокаНабора.Организация = ДокументОбъект.Организация;
		СтрокаНабора.ПроверкаЗнанияТребованийОхраныТруда = ПроверкаЗнания;
	КонецЦикла;
	
	НаборЗаписей.Отбор.ДокументОтстранения.Установить(ДокументОбъект.Ссылка);
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Параметры:
//   ДокументОбъект - ДокументОбъект.ОплатаПоСреднемуЗаработкуСписком - 
Процедура ПриЗаписиДокументаОтсутствия(ДокументОбъект) Экспорт
	
	ДокументОснование = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства, "ДокументОснование");
	Если Не ЗначениеЗаполнено(ДокументОснование)
		Или (ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ОбучениеСотрудниковОхранеТруда")
			И ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ПроверкаЗнанияТребованийОхраныТруда")) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.ОтсутствияССохранениемОплатыПриОбученииОхранеТруда.СоздатьНаборЗаписей();
	
	Для Каждого СтрокаСотрудника Из ДокументОбъект.Сотрудники Цикл
		СтрокаНабора = НаборЗаписей.Добавить();
		СтрокаНабора.ДокументОтсутствия = ДокументОбъект.Ссылка;
		СтрокаНабора.ФизическоеЛицо = СтрокаСотрудника.ФизическоеЛицо;
		СтрокаНабора.Организация = ДокументОбъект.Организация;
		СтрокаНабора.ДокументОснование = ДокументОснование;
	КонецЦикла;
	
	НаборЗаписей.Отбор.ДокументОтсутствия.Установить(ДокументОбъект.Ссылка);
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Заполняет назначение рабочих мест сотрудникам на основе данных проверки знания требований охраны труда.
//
// Параметры:
//   НазначениеОбъект - ДокументОбъект.НазначениеРабочихМестСотрудникам - объект документа назначения
//   ДанныеЗаполнения - ДокументСсылка.ПроверкаЗнанияТребованийОхраныТруда, Произвольный - данные для заполнения документа
//   СтандартнаяОбработка - Булево - признак стандартной обработки события
Процедура ПриЗаполненииНазначенияРабочихМестСотрудникам(НазначениеОбъект, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт

	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ПроверкаЗнанияТребованийОхраныТруда") Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитовПроверки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДанныеЗаполнения, "Организация, Подразделение, ДатаПроверкиЗнания");
	НазначениеОбъект.Организация = ЗначенияРеквизитовПроверки.Организация;
	НазначениеОбъект.Подразделение = ЗначенияРеквизитовПроверки.Подразделение;
	НазначениеОбъект.НачалоПериода = ЗначенияРеквизитовПроверки.ДатаПроверкиЗнания;
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОснованияДляОбновленияПериодическихОсмотров

Процедура ЗаполнитьТаблицыОбновленияРегистраСведенийДляОбученияПоОхранеТруда(
		Источник, Замещение, ИмяРесурса, ПроверятьТипЗначенийОтбора = Ложь) Экспорт
	
	ТаблицыОбновления = ИнициализироватьТаблицыОбновления();
	
	Если ПроверятьТипЗначенийОтбора И Не ОхранаТруда.ТребуетсяРегистрацияИзмененийКадровойИстории(Источник, Замещение) Тогда
		СохранитьТаблицыВДополнительныеСвойства(Источник, ТаблицыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбработатьИзменившиесяДанные(Источник, ИмяРесурса, ТаблицыОбновления);
	СохранитьТаблицыВДополнительныеСвойства(Источник, ТаблицыОбновления);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуОбновленияПериодическихОбученийПоФизическимЛицам(
		ТаблицаОбновлениеПериодическихОбучений, ФизическиеЛица) Экспорт

	Если ФизическиеЛица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ОтборыМассив = Новый Массив;
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ОтборыМассив, "ФизическоеЛицо", "В", ФизическиеЛица);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ОтборыМассив, "ОформленПоТрудовомуДоговору", "=", Истина);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
		ОтборыМассив, "ДатаУвольнения", "<", ОбщегоНазначения.ТекущаяДатаПользователя());
	УстановитьПривилегированныйРежим(Истина);
	КадровыйУчет.СоздатьВТТекущиеКадровыеДанныеСотрудников(МенеджерВТ, Ложь, ОтборыМассив, "ГоловнаяОрганизация");
	УстановитьПривилегированныйРежим(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КадровыеДанные.ФизическоеЛицо КАК ФизическоеЛицо,
		|	КадровыеДанные.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	ВТТекущиеКадровыеДанныеСотрудников КАК КадровыеДанные";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОбновлениеПериодическихОбучений.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеПериодическогоОбученияПоОхранеТруда

Процедура ОбновлениеПериодическогоОбученияПоОхранеТруда() Экспорт
	
	// Регламентные задания блокируются на время служебных операций с информационной базой.
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ОбновлениеПериодическогоОбученияПоОхранеТруда);
	
	ОбновитьПериодическиеОбучения();
	
КонецПроцедуры

Процедура ОбновитьПериодическиеОбучения(Организация = Неопределено, ФизическиеЛица = Неопределено) Экспорт
	
	// АПК:96 -выкл результат должен содержать уникальные значения
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	ДанныеНабора.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеНабора.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ПОМЕСТИТЬ ВТОбновлениеПериодическихОбученийПоОхранеТруда
		|ИЗ
		|	РегистрСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда КАК ДанныеНабора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 100
		|	ДанныеНабора.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеНабора.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ДанныеНабора.ДатаСобытия КАК ДатаСобытия
		|ПОМЕСТИТЬ ВТБудущиеСобытияОбучениеПоОхранеТруда
		|ИЗ
		|	РегистрСведений.БудущиеСобытияОбучениеПоОхранеТруда КАК ДанныеНабора
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСобытия УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеНабора.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеНабора.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	ВТОбновлениеПериодическихОбученийПоОхранеТруда КАК ДанныеНабора
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеНабора.ФизическоеЛицо,
		|	ДанныеНабора.ГоловнаяОрганизация
		|ИЗ
		|	ВТБудущиеСобытияОбучениеПоОхранеТруда КАК ДанныеНабора
		|ГДЕ
		|	ДанныеНабора.ДатаСобытия <= &ДатаАктуальности
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеНабора.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеНабора.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ДанныеНабора.ДатаСобытия КАК ДатаСобытия
		|ИЗ
		|	ВТБудущиеСобытияОбучениеПоОхранеТруда КАК ДанныеНабора
		|ГДЕ
		|	ДанныеНабора.ДатаСобытия > &ДатаАктуальности
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо";
	
	// АПК:96 -вкл
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	Если Организация <> Неопределено Тогда
		ТекстУсловия = "ДанныеНабора.ГоловнаяОрганизация = &ГоловнаяОрганизация";
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор.Добавить(ТекстУсловия);
		СхемаЗапроса.ПакетЗапросов[1].Операторы[0].Отбор.Добавить(ТекстУсловия);
		Запрос.УстановитьПараметр("ГоловнаяОрганизация", ЗарплатаКадры.ГоловнаяОрганизация(Организация));
	КонецЕсли;
	Если ФизическиеЛица <> Неопределено Тогда
		ТекстУсловия = "ДанныеНабора.ФизическоеЛицо В(&ФизическиеЛица)";
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор.Добавить(ТекстУсловия);
		СхемаЗапроса.ПакетЗапросов[1].Операторы[0].Отбор.Добавить(ТекстУсловия);
		Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛица);
	КонецЕсли;
	ДатаАктуальности = ОбщегоНазначения.ТекущаяДатаПользователя();
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пока Истина Цикл
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		Если РезультатыЗапроса[2].Пустой() Тогда
			Прервать;
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда");
		ЭлементБлокировки.ИсточникДанных = РезультатыЗапроса[2];
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ФизическоеЛицо", "ФизическоеЛицо");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ГоловнаяОрганизация", "ГоловнаяОрганизация");
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.БудущиеСобытияОбучениеПоОхранеТруда"); 
		ЭлементБлокировки.ИсточникДанных = РезультатыЗапроса[3];
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ФизическоеЛицо", "ФизическоеЛицо");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ГоловнаяОрганизация", "ГоловнаяОрганизация");
		
		НачатьТранзакцию();
		Попытка
			Блокировка.Заблокировать();
			ТаблицаОбновления = РезультатыЗапроса[2].Выгрузить();
			ТаблицаБудущихСобытий = РезультатыЗапроса[3].Выгрузить();
			ТаблицаБудущихСобытий.Индексы.Добавить("ФизическоеЛицо, ГоловнаяОрганизация");
			ОбновитьПериодическиеОбученияФизическихЛиц(ТаблицаОбновления, ТаблицаБудущихСобытий, ДатаАктуальности);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Обновляет периодические обучения организации в длительной операции.
//
// Параметры:
//  Параметры - Структура - Параметры обновления периодических обучений:
//	* Организация - СправочникСсылка.Организации - Организация, для которой необходимо обновить периодические обучения.
//  АдресРезультата - Строка - Адрес временного хранилища, куда будет помещен результат выполнения операции.
//
Процедура ОбновитьПериодическиеОбученияОрганизацииДлительнаяОперация(Параметры, АдресРезультата) Экспорт
	
	Попытка
		ОбновитьПериодическиеОбучения(Параметры.Организация);
	Исключение
		ПредставлениеОбработки = СтрШаблон(НСтр("ru = 'Обновление периодических обучений по охране труда по организации %1'"),
			Строка(Параметры.Организация));
		ЗарегистрироватьОшибкуОбработкиОбученияПоОхранеТруда(ИнформацияОбОшибке(), ПредставлениеОбработки);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Процедура обновляет периодические обучения физических лиц по охране труда.
//
// Параметры:
//  ТаблицаОбновления - ТаблицаЗначений - таблица с данными для обновления периодических обучений:
//  	* ФизическоеЛицо - СправочникСсылка.ФизическиеЛица - 
//  	* ГоловнаяОрганизация - СправочникСсылка.Организации - 
//  ТаблицаБудущихСобытий - ТаблицаЗначений - таблица с данными для обновления будущих событий обучения по охране труда.
//  ДатаАктуальности - Дата - дата актуальности данных.
//
Процедура ОбновитьПериодическиеОбученияФизическихЛиц(ТаблицаОбновления, ТаблицаБудущихСобытий, ДатаАктуальности)
	
	ПериодическиеПроверкиЗнания = НоваяТаблицаПериодическиеПроверкиЗнания();
	ЗаполнитьТаблицуПериодическихОбучений(ПериодическиеПроверкиЗнания, ТаблицаОбновления, ДатаАктуальности);
	ПериодическиеПроверкиЗнания.Индексы.Добавить("ФизическоеЛицо, ГоловнаяОрганизация");
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("ФизическоеЛицо");
	ОтборСтрок.Вставить("ГоловнаяОрганизация");
	Для Каждого СтрокаТаблицы Из ТаблицаОбновления Цикл
		// Заполняем набор периодических обучений.
		НаборОбучения = РегистрыСведений.ПериодическиеПроверкиЗнанияТребованийОхраныТруда.СоздатьНаборЗаписей();
		НаборОбучения.Отбор.ФизическоеЛицо.Установить(СтрокаТаблицы.ФизическоеЛицо);
		НаборОбучения.Отбор.ГоловнаяОрганизация.Установить(СтрокаТаблицы.ГоловнаяОрганизация);
		ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаТаблицы);
		НайденныеСтроки = ПериодическиеПроверкиЗнания.НайтиСтроки(ОтборСтрок);
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(НайденныеСтроки, НаборОбучения);
		
		// Подготавливаем к очистке набор обновления.
		НаборОбновления = РегистрыСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда.СоздатьНаборЗаписей();
		НаборОбновления.Отбор.ФизическоеЛицо.Установить(СтрокаТаблицы.ФизическоеЛицо);
		НаборОбновления.Отбор.ГоловнаяОрганизация.Установить(СтрокаТаблицы.ГоловнаяОрганизация);
		
		// Подготавливаем к очистке набор будущих событий.
		НаборБудущихСобытий = РегистрыСведений.БудущиеСобытияОбучениеПоОхранеТруда.СоздатьНаборЗаписей();
		НаборБудущихСобытий.Отбор.ФизическоеЛицо.Установить(СтрокаТаблицы.ФизическоеЛицо);
		НаборБудущихСобытий.Отбор.ГоловнаяОрганизация.Установить(СтрокаТаблицы.ГоловнаяОрганизация);
		ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаТаблицы);
		НайденныеСтроки = ТаблицаБудущихСобытий.НайтиСтроки(ОтборСтрок);
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(НайденныеСтроки, НаборБудущихСобытий);

		НачатьТранзакцию();
		Попытка
			НаборОбучения.Записать();
			НаборОбновления.Записать();
			НаборБудущихСобытий.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуПериодическихОбучений(ПериодическиеПроверкиЗнания, ТаблицаОбновления, ДатаАктуальности, МенеджерВТ = Неопределено)
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если МенеджерВТ = Неопределено Тогда
		МенеджерВТ = Новый МенеджерВременныхТаблиц;
		СоздатьВТКадровыеДанныеДляОбученияПоОхранеТруда(
			МенеджерВТ, ДатаАктуальности, , ТаблицаОбновления.ВыгрузитьКолонку("ФизическоеЛицо"));
	КонецЕсли;
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВТ, "ВТКадровыеДанныеДляОбученияПоОхранеТруда") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТаблицаОбновления", ТаблицаОбновления);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаОбновления.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ТаблицаОбновления.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ПОМЕСТИТЬ ВТОбновления
		|ИЗ
		|	&ТаблицаОбновления КАК ТаблицаОбновления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМестоОхраныТруда КАК РабочееМесто,
		|	Сотрудники.РабочееМестоОхраныТрудаПериодРегистрации КАК ДатаНачала,
		|	Сотрудники.ДатаУвольнения КАК ДатаУвольнения,
		|	ПрограммыОбученияСотрудниковПоОхранеТруда.Ссылка КАК ПрограммаОбучения,
		|	ПрограммыОбученияСотрудниковПоОхранеТруда.КонтролироватьСменуРабочегоМеста КАК КонтролироватьСменуРабочегоМеста,
		|	ПрограммыОбученияСотрудниковПоОхранеТруда.ПроводитсяПовторно КАК ПроводитсяПовторно,
		|	ПрограммыОбученияСотрудниковПоОхранеТруда.КоличествоРаз КАК КоличествоРаз,
		|	ПрограммыОбученияСотрудниковПоОхранеТруда.КоличествоПериодов КАК КоличествоПериодов,
		|	ПрограммыОбученияСотрудниковПоОхранеТруда.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ ВТСотрудникиТребующиеОбучения
		|ИЗ
		|	ВТКадровыеДанныеДляОбученияПоОхранеТруда КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОбновления КАК ТаблицаОбновления
		|		ПО ТаблицаОбновления.ФизическоеЛицо = Сотрудники.ФизическоеЛицо
		|		И ТаблицаОбновления.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда КАК
		|			ПрограммыОбученияСотрудниковПоОхранеТруда
		|		ПО ВЫБОР
		|			КОГДА ПрограммыОбученияСотрудниковПоОхранеТруда.ПометкаУдаления
		|				ТОГДА ЛОЖЬ
		|			КОГДА ПрограммыОбученияСотрудниковПоОхранеТруда.КонтролироватьПроведение
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда.РабочиеМеста КАК
		|			ПрограммыОбученияСотрудниковПоОхранеТрудаРабочиеМеста
		|		ПО ПрограммыОбученияСотрудниковПоОхранеТруда.Ссылка = ПрограммыОбученияСотрудниковПоОхранеТрудаРабочиеМеста.Ссылка
		|ГДЕ
		|	ВЫБОР
		|		КОГДА ПрограммыОбученияСотрудниковПоОхранеТруда.ИспользоватьДляВсехРабочихМест
		|		ИЛИ ПрограммыОбученияСотрудниковПоОхранеТрудаРабочиеМеста.РабочееМесто = Сотрудники.РабочееМестоОхраныТруда
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ";
	Запрос.Выполнить();
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВТ, "ВТСотрудникиТребующиеОбучения") Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем сведения о последнем пройденном обучении.
	СоздатьВТПройденныеОбучения(МенеджерВТ, ДатаАктуальности, "ВТСотрудникиТребующиеОбучения");
	
	// Сотрудники, хотя бы раз проходившие обучение.
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	Сотрудники.ПрограммаОбучения КАК ПрограммаОбучения,
		|	Сотрудники.ДатаУвольнения КАК ДатаУвольнения,
		|	МАКСИМУМ(ПройденныеОбучения.ДатаПроверки) КАК ДатаПройденнойПроверкиЗнания,
		|	ПройденныеОбучения.РезультатПроверки КАК РезультатПроверки,
		|	ПройденныеОбучения.Обучение КАК Обучение,
		|	ПройденныеОбучения.Проверка КАК Проверка,
		|	Сотрудники.ПроводитсяПовторно КАК ПроводитсяПовторно,
		|	Сотрудники.КоличествоРаз КАК КоличествоРаз,
		|	Сотрудники.КоличествоПериодов КАК КоличествоПериодов,
		|	Сотрудники.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ ВТСотрудникиРанееПроходившиеОбучениеНаРабочемМесте
		|ИЗ
		|	ВТСотрудникиТребующиеОбучения КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПройденныеОбучения КАК ПройденныеОбучения
		|		ПО (ПройденныеОбучения.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|			И (ПройденныеОбучения.ПрограммаОбучения = Сотрудники.ПрограммаОбучения)
		|			И (ВЫБОР
		|				КОГДА НЕ Сотрудники.КонтролироватьСменуРабочегоМеста
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ПройденныеОбучения.РабочееМесто = Сотрудники.РабочееМесто
		|			КОНЕЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	Сотрудники.ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто,
		|	Сотрудники.ПрограммаОбучения,
		|	Сотрудники.ДатаУвольнения,
		|	ПройденныеОбучения.РезультатПроверки,
		|	ПройденныеОбучения.Обучение,
		|	ПройденныеОбучения.Проверка,
		|	Сотрудники.ПроводитсяПовторно,
		|	Сотрудники.КоличествоРаз,
		|	Сотрудники.КоличествоПериодов,
		|	Сотрудники.Периодичность";
	Запрос.Выполнить();
	
	// Выявляются люди и рабочие места, которым 
	// - можно или нельзя "перезачесть" обучение.
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.ПрограммаОбучения КАК ПрограммаОбучения,
		|	Сотрудники.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТСотрудникиОбучениеНаРабочемМестеНельзяПерезачесть
		|ИЗ
		|	ВТСотрудникиТребующиеОбучения КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСотрудникиРанееПроходившиеОбучениеНаРабочемМесте КАК ПройденныеОбучения
		|		ПО (ПройденныеОбучения.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|			И (ПройденныеОбучения.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация)
		|			И (ПройденныеОбучения.ПрограммаОбучения = Сотрудники.ПрограммаОбучения)
		|ГДЕ
		|	ПройденныеОбучения.ДатаПройденнойПроверкиЗнания ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.ПрограммаОбучения КАК ПрограммаОбучения,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	КадровыеДанные.ДатаУвольнения КАК ДатаУвольнения,
		|	МАКСИМУМ(ПройденныеОбучения.ДатаПройденнойПроверкиЗнания) КАК ДатаПройденнойПроверкиЗнания,
		|	МАКСИМУМ(ПройденныеОбучения.РезультатПроверки) КАК РезультатОбучения,
		|	МАКСИМУМ(ПройденныеОбучения.Обучение) КАК Обучение,
		|	МАКСИМУМ(ПройденныеОбучения.Проверка) КАК Проверка,
		|	МИНИМУМ(КадровыеДанные.ДатаНачала) КАК ДатаСледующейПроверкиЗнания
		|ИЗ
		|	ВТСотрудникиОбучениеНаРабочемМестеНельзяПерезачесть КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСотрудникиТребующиеОбучения КАК КадровыеДанные
		|		ПО (КадровыеДанные.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|			И (КадровыеДанные.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация)
		|			И (КадровыеДанные.ПрограммаОбучения = Сотрудники.ПрограммаОбучения)
		|			И (КадровыеДанные.РабочееМесто = Сотрудники.РабочееМесто)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСотрудникиРанееПроходившиеОбучениеНаРабочемМесте КАК ПройденныеОбучения
		|		ПО (КадровыеДанные.ФизическоеЛицо = ПройденныеОбучения.ФизическоеЛицо)
		|			И (КадровыеДанные.ГоловнаяОрганизация = ПройденныеОбучения.ГоловнаяОрганизация)
		|			И (КадровыеДанные.ПрограммаОбучения = ПройденныеОбучения.ПрограммаОбучения)
		|
		|СГРУППИРОВАТЬ ПО
		|	Сотрудники.ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация,
		|	Сотрудники.ПрограммаОбучения,
		|	Сотрудники.РабочееМесто,
		|	КадровыеДанные.ДатаУвольнения";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Перечисляем тех, кому не получилось перезачесть обучение.
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ПериодическиеПроверкиЗнания.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если ЗначениеЗаполнено(Выборка.ДатаУвольнения) И Выборка.ДатаСледующейПроверкиЗнания >= Выборка.ДатаУвольнения Тогда
			НоваяСтрока.ДатаСледующейПроверкиЗнания = Дата("00010101");
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	Сотрудники.ДатаУвольнения КАК ДатаУвольнения,
		|	Сотрудники.ПрограммаОбучения КАК ПрограммаОбучения,
		|	Сотрудники.ПроводитсяПовторно КАК ПроводитсяПовторно,
		|	Сотрудники.КоличествоРаз КАК КоличествоРаз,
		|	Сотрудники.КоличествоПериодов КАК КоличествоПериодов,
		|	Сотрудники.Периодичность КАК Периодичность,
		|	Сотрудники.ДатаНачала КАК ДатаНачалаРаботы
		|ПОМЕСТИТЬ ВТСотрудникиОбучениеНаРабочемМестеМожноПерезачесть
		|ИЗ
		|	ВТСотрудникиТребующиеОбучения КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСотрудникиОбучениеНаРабочемМестеНельзяПерезачесть КАК НельзяПерезачесть
		|		ПО (НельзяПерезачесть.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|			И (НельзяПерезачесть.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация)
		|			И (НельзяПерезачесть.ПрограммаОбучения = Сотрудники.ПрограммаОбучения)
		|			И (НельзяПерезачесть.РабочееМесто = Сотрудники.РабочееМесто)
		|ГДЕ
		|	НельзяПерезачесть.РабочееМесто ЕСТЬ NULL";
	
	Запрос.Выполнить();
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВТ, "ВТСотрудникиОбучениеНаРабочемМестеМожноПерезачесть") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.ПрограммаОбучения КАК ПрограммаОбучения,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	Сотрудники.ДатаУвольнения КАК ДатаУвольнения,
		|	Сотрудники.ПроводитсяПовторно КАК ПроводитсяПовторно,
		|	Сотрудники.КоличествоРаз КАК КоличествоРаз,
		|	Сотрудники.КоличествоПериодов КАК КоличествоПериодов,
		|	Сотрудники.Периодичность КАК Периодичность,
		|	МАКСИМУМ(ПройденныеОбучения.ДатаПройденнойПроверкиЗнания) КАК ДатаПройденнойПроверкиЗнания,
		|	МАКСИМУМ(ПройденныеОбучения.РезультатПроверки) КАК РезультатОбучения,
		|	МАКСИМУМ(ПройденныеОбучения.Обучение) КАК Обучение,
		|	МАКСИМУМ(ПройденныеОбучения.Проверка) КАК Проверка
		|ИЗ
		|	ВТСотрудникиОбучениеНаРабочемМестеМожноПерезачесть КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСотрудникиРанееПроходившиеОбучениеНаРабочемМесте КАК ПройденныеОбучения
		|		ПО (Сотрудники.ФизическоеЛицо = ПройденныеОбучения.ФизическоеЛицо)
		|			И (Сотрудники.ГоловнаяОрганизация = ПройденныеОбучения.ГоловнаяОрганизация)
		|			И (Сотрудники.ПрограммаОбучения = ПройденныеОбучения.ПрограммаОбучения)
		|			И (Сотрудники.РабочееМесто = ПройденныеОбучения.РабочееМесто)
		|
		|СГРУППИРОВАТЬ ПО
		|	Сотрудники.ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация,
		|	Сотрудники.ПрограммаОбучения,
		|	Сотрудники.РабочееМесто,
		|	Сотрудники.ДатаУвольнения,
		|	Сотрудники.ПроводитсяПовторно,
		|	Сотрудники.КоличествоРаз,
		|	Сотрудники.КоличествоПериодов,
		|	Сотрудники.Периодичность
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПрограммаОбучения,
		|	ФизическоеЛицо,
		|	ДатаУвольнения УБЫВ,
		|	РабочееМесто";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("ПрограммаОбучения") Цикл
		Пока Выборка.СледующийПоЗначениюПоля("ФизическоеЛицо") Цикл
			Пока Выборка.СледующийПоЗначениюПоля("РабочееМесто") Цикл
				НоваяСтрока = ПериодическиеПроверкиЗнания.Добавить();
				Пока Выборка.Следующий() Цикл
					ОписаниеПериодичности = ОписаниеПериодичностиОбучений();
					ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Выборка);
					Если Выборка.РезультатОбучения = Перечисления.РезультатыПроверкиЗнанияПоОхранеТруда.Неудовлетворительно Тогда
						ДатаСледующейПроверкиЗнания = Выборка.ДатаПройденнойПроверкиЗнания;
					Иначе
						ДатаСледующейПроверкиЗнания = ДатаСледующейПроверкиЗнания(Выборка.ДатаПройденнойПроверкиЗнания, ОписаниеПериодичности);
					КонецЕсли;
					Если Не ЗначениеЗаполнено(НоваяСтрока.ДатаСледующейПроверкиЗнания) Тогда
						НоваяСтрока.ДатаСледующейПроверкиЗнания = ДатаСледующейПроверкиЗнания;
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
					Иначе
						Если ДатаСледующейПроверкиЗнания < НоваяСтрока.ДатаСледующейПроверкиЗнания Тогда
							НоваяСтрока.ДатаСледующейПроверкиЗнания = ДатаСледующейПроверкиЗнания;
							ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
						КонецЕсли;
					КонецЕсли;
					Если ЗначениеЗаполнено(Выборка.ДатаУвольнения) И НоваяСтрока.ДатаСледующейПроверкиЗнания >= Выборка.ДатаУвольнения Тогда
						НоваяСтрока.ДатаСледующейПроверкиЗнания = Дата("00010101");
					КонецЕсли;
					Если Выборка.ДатаПройденнойПроверкиЗнания > НоваяСтрока.ДатаПройденнойПроверкиЗнания Тогда
						НоваяСтрока.ДатаПройденнойПроверкиЗнания = Выборка.ДатаПройденнойПроверкиЗнания;
						НоваяСтрока.Обучение = Выборка.Обучение;
						НоваяСтрока.РезультатОбучения = Выборка.РезультатОбучения;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяТаблицаПериодическиеПроверкиЗнания()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	Таблица.Колонки.Добавить("ГоловнаяОрганизация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("ПрограммаОбучения", Новый ОписаниеТипов("СправочникСсылка.ПрограммыОбученияСотрудниковПоОхранеТруда"));
	Таблица.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	Таблица.Колонки.Добавить("ДатаПройденнойПроверкиЗнания", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ДатаСледующейПроверкиЗнания", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Обучение", Новый ОписаниеТипов("ДокументСсылка.ОбучениеСотрудниковОхранеТруда"));
	Таблица.Колонки.Добавить("Проверка", Новый ОписаниеТипов("ДокументСсылка.ПроверкаЗнанияТребованийОхраныТруда"));
	Таблица.Колонки.Добавить("РезультатОбучения", Новый ОписаниеТипов("ПеречислениеСсылка.РезультатыПроверкиЗнанияПоОхранеТруда"));
	Таблица.Колонки.Добавить("ДатаУвольнения", Новый ОписаниеТипов("Дата"));
	
	Возврат Таблица;
	
КонецФункции

// Обновляет периодические обучения рабочих мест при изменении программы обучения.
//
// Параметры:
//  Программа - СправочникСсылка.ПрограммыОбученияСотрудниковПоОхранеТруда - 
//  РабочиеМеста - Массив Из СправочникСсылка.РабочиеМестаОхраныТруда, Неопределено - 
//                 Если Неопределено, обновляются все рабочие места программы.
//                 Если пустой массив, обновление не выполняется.
//
Процедура ОбновитьПериодическиеОбученияРабочихМест(Программа, РабочиеМеста = Неопределено) Экспорт
	
	Если ТипЗнч(РабочиеМеста) = Тип("Массив") И РабочиеМеста.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СотрудникиДляОбновления = СотрудникиДляОбновленияПериодическихОбучений(РабочиеМеста);
	
	Если СотрудникиДляОбновления.Количество() > 0 Тогда
		ЗарегистрироватьОбновлениеПериодическихОбучений(СотрудникиДляОбновления);
	КонецЕсли;
	
КонецПроцедуры

// Получает список сотрудников для обновления периодических обучений
//
// Параметры:
//  РабочиеМеста - Массив Из СправочникСсылка.РабочиеМестаОхраныТруда, Неопределено - 
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с колонками ФизическоеЛицо, ГоловнаяОрганизация
//
Функция СотрудникиДляОбновленияПериодическихОбучений(РабочиеМеста)
	
	ПараметрыЗапроса = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыЗапроса.КадровыеДанные = "ФизическоеЛицо,ГоловнаяОрганизация";
	
	Если ТипЗнч(РабочиеМеста) = Тип("Массив") Тогда
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
			ПараметрыЗапроса.Отборы, "РабочееМестоОхраныТруда", "В", РабочиеМеста);
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	УстановитьПривилегированныйРежим(Истина);
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(МенеджерВТ, Ложь, ПараметрыЗапроса);
	УстановитьПривилегированныйРежим(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	ВТСотрудникиОрганизации КАК Сотрудники";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗарегистрироватьОбновлениеПериодическихОбучений(ТаблицаОбновления) Экспорт
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаОбновления.Свернуть("ФизическоеЛицо, ГоловнаяОрганизация");
	
	НаборЗаписей = РегистрыСведений.ОбновлениеПериодическогоОбученияПоОхранеТруда.СоздатьНаборЗаписей();
	Для Каждого СтрокаТаблицы Из ТаблицаОбновления Цикл
		НаборЗаписей.Очистить();
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаТаблицы);
		НаборЗаписей.Отбор["ФизическоеЛицо"].Установить(СтрокаТаблицы["ФизическоеЛицо"]);
		НаборЗаписей.Отбор["ГоловнаяОрганизация"].Установить(СтрокаТаблицы["ГоловнаяОрганизация"]);
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяТаблицаОбновлениеПериодическихОбучений() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	Таблица.Колонки.Добавить("ГоловнаяОрганизация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	Возврат Таблица;
	
КонецФункции

Функция МесяцевВЕдиницеИзмерения(ЕдиницаПериодичности)
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Перечисления.Периодичность.Год, 12);
	Соответствие.Вставить(Перечисления.Периодичность.Полугодие, 6);
	Соответствие.Вставить(Перечисления.Периодичность.Квартал, 3);
	Соответствие.Вставить(Перечисления.Периодичность.Месяц, 1);
	
	Возврат Соответствие[ЕдиницаПериодичности];
	
КонецФункции

Функция ДнейВЕдиницеИзмерения(ЕдиницаПериодичности)
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Перечисления.Периодичность.Декада, 10);
