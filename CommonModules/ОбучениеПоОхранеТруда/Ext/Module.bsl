	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчета, "Организация");
	Параметры = Новый Структура;
	Если ЗначениеЗаполнено(Организация) Тогда
		Параметры.Вставить("Организация", Организация);
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОбучениеПоОхранеТруда", Параметры) Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыОтчета.Вставить("СпискиВыбора", "СпискиВыбора2023Кв1");
	ЗаполнитьРеестрОбученныеПоОхранеТрудаЛица(Контейнер, ПараметрыОтчета);
	
КонецПроцедуры

// Процедура заполняет реестр обученных по охране труда лиц в контейнере отчета.
//
// Параметры:
//  Контейнер - Структура - контейнер отчета, содержащий реестр обученных лиц:
//   * Реестр - ДеревоЗначений - заполняемый реестр:
//	  ** Данные - Структура
//	  ** ДанныеМногострочныхЧастей - Структура:
//		*** П10000 - ДеревоЗначений -
//  ПараметрыОтчета - Структура - параметры отчета, содержащие организацию, дату начала и конца периода, максимальное количество строк на странице:
//   * Организация - СправочникСсылка.Организации
//   * мДатаНачалаПериодаОтчета - Дата
//   * мДатаКонцаПериодаОтчета - Дата
//   * МаксКолСтрокНаСтранице - Число
//
Процедура ЗаполнитьРеестрОбученныеПоОхранеТрудаЛица(Контейнер, ПараметрыОтчета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета, -12));
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроверкиЗнания.Период,
		|	ПроверкиЗнания.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПроверкиЗнания.РабочееМесто.Должность КАК Должность,
		|	ПроверкиЗнания.ПрограммаОбученияМинтруда.КодКлассификатораМинтруда КАК ПрограммаОбучения,
		|	ВЫБОР
		|		КОГДА ПроверкиЗнания.ПрограммаОбучения.ФормаОбучения = ЗНАЧЕНИЕ(Перечисление.ФормыОбученияПоОхранеТруда.Внешняя)
		|			ТОГДА ПроверкиЗнания.ПрограммаОбучения.Контрагент
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Контрагент,
		|	ПроверкиЗнания.НомерПротокола,
		|	ВЫБОР
		|		КОГДА
		|			ПроверкиЗнания.РезультатПроверки = ЗНАЧЕНИЕ(Перечисление.РезультатыПроверкиЗнанияПоОхранеТруда.Удовлетворительно)
		|			ТОГДА 1
		|		КОГДА
		|			ПроверкиЗнания.РезультатПроверки = ЗНАЧЕНИЕ(Перечисление.РезультатыПроверкиЗнанияПоОхранеТруда.Неудовлетворительно)
		|			ТОГДА 0
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК РезультатПроверки
		|ПОМЕСТИТЬ ВТПроверкиЗнания
		|ИЗ
		|	РегистрСведений.ПроверкиЗнанияТребованийОхраныТрудаСотрудников КАК ПроверкиЗнания
		|ГДЕ
		|	ПроверкиЗнания.Организация = &Организация
		|	И
		|		ПроверкиЗнания.ПрограммаОбученияМинтруда <> ЗНАЧЕНИЕ(Справочник.КлассификаторПрограммОбученияПоОхранеТруда.ПустаяСсылка)
		|	И ПроверкиЗнания.Период >= &НачалоПериода
		|	И ПроверкиЗнания.Период <= &КонецПериода";
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос.Выполнить();
	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеФизическихЛиц(
			Запрос.МенеджерВременныхТаблиц, "ВТПроверкиЗнания");
	КадровыеДанные = "Фамилия, Имя, Отчество, СтраховойНомерПФР";
	КадровыйУчет.СоздатьВТКадровыеДанныеФизическихЛиц(ОписательВременныхТаблиц, Истина, КадровыеДанные);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроверкиЗнания.Период КАК ДатаПроверки,
		|	ПроверкиЗнания.Должность,
		|	ПроверкиЗнания.ПрограммаОбучения,
		|	ПроверкиЗнания.НомерПротокола,
		|	ПроверкиЗнания.РезультатПроверки,
		|	КадровыеДанныеФизическихЛиц.Фамилия,
		|	КадровыеДанныеФизическихЛиц.Имя,
		|	КадровыеДанныеФизическихЛиц.Отчество,
		|	КадровыеДанныеФизическихЛиц.СтраховойНомерПФР,
		|	Контрагенты.Наименование КАК НаименованиеКонтрагента,
		|	Контрагенты.ИНН КАК ИННКонтрагента
		|ИЗ
		|	ВТПроверкиЗнания КАК ПроверкиЗнания
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКадровыеДанныеФизическихЛиц КАК КадровыеДанныеФизическихЛиц
		|		ПО ПроверкиЗнания.ФизическоеЛицо = КадровыеДанныеФизическихЛиц.ФизическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ПроверкиЗнания.Контрагент = Контрагенты.Ссылка";
	
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не Результат.Пустой() Тогда
		Реестр = Контейнер.Реестр;
		Реестр.Строки.Очистить();
		
		Счетчик = 1 + ПараметрыОтчета.МаксКолСтрокНаСтранице;
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Счетчик > ПараметрыОтчета.МаксКолСтрокНаСтранице Тогда
				НоваяСтраница = Реестр.Строки.Добавить();
				НоваяСтраница.Данные = Новый Структура("ПризнакИзмененияДанных", 0);
				НоваяСтраница.ДанныеМногострочныхЧастей = Новый Структура;
				НоваяСтраница.ДанныеМногострочныхЧастей.Вставить("П10000", ДеревоЗначенийРеестрОбученныхПоОхранеТруда());
				Счетчик = 1;
			КонецЕсли;
			
			НовыйОбученный = НоваяСтраница.ДанныеМногострочныхЧастей.П10000.Строки.Добавить();
			
			ДанныеОбученного = Новый Структура;
			ДанныеОбученного.Вставить("П1000001", 0);
			ДанныеОбученного.Вставить("П1000002", Выборка.Фамилия);
			ДанныеОбученного.Вставить("П1000003", Выборка.Имя);
			ДанныеОбученного.Вставить("П1000004", Выборка.Отчество);
			ДанныеОбученного.Вставить("П1000005", Выборка.СтраховойНомерПФР);
			ДанныеОбученного.Вставить("П1000006", Выборка.Должность);
			ДанныеОбученного.Вставить("П1000007", Выборка.ДатаПроверки);
			ДанныеОбученного.Вставить("П1000008", Выборка.НомерПротокола);
			ДанныеОбученного.Вставить("П1000009", Выборка.ПрограммаОбучения);
			ДанныеОбученного.Вставить("П1000010", Выборка.РезультатПроверки);
			ДанныеОбученного.Вставить("П1000011", Выборка.ИННКонтрагента);
			ДанныеОбученного.Вставить("П1000012", Выборка.НаименованиеКонтрагента);
			
			НовыйОбученный.Данные = ДанныеОбученного;
			
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ДеревоЗначенийРеестрОбученныхПоОхранеТруда()
	
	НовоеДеревоЗначений = Новый ДеревоЗначений();
	НовоеДеревоЗначений.Колонки.Добавить("Данные");
	НовоеДеревоЗначений.Колонки.Добавить("ДанныеМногострочныхЧастей");
	НовоеДеревоЗначений.Колонки.Добавить("АдресТабличногоДокумента");
	
	Возврат НовоеДеревоЗначений;
	
КонецФункции

#Область ВспомогательныеМетодыЗаполненияТаблицОбновления

Функция ИнициализироватьТаблицыОбновления()
	
	ТаблицыОбновления = Новый Структура;
	ТаблицыОбновления.Вставить("ТаблицаОбновления", НоваяТаблицаОбновлениеПериодическихОбучений());
	ТаблицыОбновления.Вставить("ТаблицаБудущихСобытий", НоваяТаблицаБудущиеСобытияОбучениеПоОхранеТруда());
	
	Возврат ТаблицыОбновления;
	
КонецФункции

Процедура ОбработатьИзменившиесяДанные(Источник, ИмяРесурса, ТаблицыОбновления)
	
	ИзменившиесяДанные = Источник.ТаблицаИзменившихсяДанныхНабора(); //ТаблицаЗначений
	Если ИзменившиесяДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
	ИмяПоляИзмененияРесурса = СтрШаблон("ИзменилсяРесурс%1", ИмяРесурса);
	
	Для Каждого СтрокаТаблицы Из ИзменившиесяДанные Цикл
		Если ТребуетсяОбработкаСтроки(СтрокаТаблицы, ИмяПоляИзмененияРесурса) Тогда
			ЗаполнитьЗначенияСвойств(ТаблицыОбновления.ТаблицаОбновления.Добавить(), СтрокаТаблицы);
			ЗаполнитьТаблицуБудущихСобытийОбучениеПоОхранеТруда(
				СтрокаТаблицы, ТаблицыОбновления.ТаблицаБудущихСобытий, ТекущаяДата);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТребуетсяОбработкаСтроки(СтрокаТаблицы, ИмяПоляИзмененияРесурса)
	
	Возврат СтрокаТаблицы["Добавление"] = Истина 
		Или СтрокаТаблицы["Удаление"] = Истина
		Или СтрокаТаблицы[ИмяПоляИзмененияРесурса] = Истина;
	
КонецФункции

Процедура СохранитьТаблицыВДополнительныеСвойства(Источник, ТаблицыОбновления)
	
	Источник.ДополнительныеСвойства.Вставить("ТаблицаОбновлениеПериодическихОбучений", ТаблицыОбновления.ТаблицаОбновления);
	Источник.ДополнительныеСвойства.Вставить("ТаблицаБудущиеСобытияОбучениеПоОхранеТруда", ТаблицыОбновления.ТаблицаБудущихСобытий);
	
КонецПроцедуры

