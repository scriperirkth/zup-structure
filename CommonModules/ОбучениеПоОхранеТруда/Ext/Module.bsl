	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("43066da8-820e-4048-90c3-e0631433abe3");
	Обработчик.Процедура = "ОбучениеПоОхранеТруда.ЗаполнитьРабочиеМестаОхраныТрудаВИнструктажахНаОснованииПозицийШтатногоРасписания";
	Обработчик.Комментарий = НСтр("ru = 'Заполнение рабочих мест охраны труда в инструктажах.'");
	
	Если ЗарплатаКадры.АвтономнаяРаботаРазрешеноИзменениеДанных(Метаданные.Справочники.КлассификаторПрограммОбученияПоОхранеТруда) Тогда
		Обработчик = Обработчики.Добавить();
		Обработчик.Версия = "3.1.36.29";
		Обработчик.Процедура = "Справочники.КлассификаторПрограммОбученияПоОхранеТруда.НачальноеЗаполнение";
