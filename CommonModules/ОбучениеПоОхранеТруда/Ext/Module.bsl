// Регистрирует будущие события обучения по охране труда.
//
// Параметры:
//  ТаблицаБудущихСобытий - ТаблицаЗначений - см. НоваяТаблицаБудущиеСобытияОбучениеПоОхранеТруда()
//
Процедура ЗарегистрироватьБудущиеСобытияОбучениеПоОхранеТруда(ТаблицаБудущихСобытий) Экспорт
	
	Если ТаблицаБудущихСобытий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаБудущихСобытий.Свернуть("ФизическоеЛицо, ГоловнаяОрганизация, ДатаСобытия");
	
	НаборЗаписей = РегистрыСведений.БудущиеСобытияОбучениеПоОхранеТруда.СоздатьНаборЗаписей();
	Для Каждого СтрокаТаблицы Из ТаблицаБудущихСобытий Цикл
		НаборЗаписей.Очистить();
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаТаблицы);
		НаборЗаписей.Отбор["ФизическоеЛицо"].Установить(СтрокаТаблицы["ФизическоеЛицо"]);
		НаборЗаписей.Отбор["ГоловнаяОрганизация"].Установить(СтрокаТаблицы["ГоловнаяОрганизация"]);
		НаборЗаписей.Отбор["ДатаСобытия"].Установить(СтрокаТаблицы["ДатаСобытия"]);
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет таблицу будущих событий обучения по охране труда на основе переданных данных.
//
// Параметры:
//   СтрокаТаблицы - ВыборкаИзРезультатаЗапроса, СтрокаТаблицыЗначений - :
//   	* Период - Дата - 
//   	* ДействуетДо - Дата -
//   ТаблицаБудущихСобытий - ТаблицаЗначений - таблица для заполнения будущими событиями
//   ТекущаяДата - Дата - текущая дата для сравнения с датами в строке таблицы
Процедура ЗаполнитьТаблицуБудущихСобытийОбучениеПоОхранеТруда(СтрокаТаблицы, ТаблицаБудущихСобытий, ТекущаяДата)
	
	Если ТекущаяДата < СтрокаТаблицы.Период Тогда
		НоваяСтрока = ТаблицаБудущихСобытий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.ДатаСобытия = СтрокаТаблицы.Период;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаТаблицы.ДействуетДо) И ТекущаяДата < СтрокаТаблицы.ДействуетДо Тогда
		НоваяСтрока = ТаблицаБудущихСобытий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.ДатаСобытия = СтрокаТаблицы.ДействуетДо;
	КонецЕсли;

КонецПроцедуры

Процедура ОбновитьПериодическиеОсмотрыНаОснованииБудущихНазначенийРабочихМест()
	
	ТекущаяДата = ОбщегоНазначения.ТекущаяДатаПользователя();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РабочиеМестаСотрудников.Период КАК Период,
		|	РабочиеМестаСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	РабочиеМестаСотрудников.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	РабочиеМестаСотрудников.ДействуетДо КАК ДействуетДо
		|ИЗ
		|	РегистрСведений.РабочиеМестаСотрудников КАК РабочиеМестаСотрудников
		|ГДЕ
		|	ВЫБОР
		|			КОГДА РабочиеМестаСотрудников.Период > &ТекущаяДата
		|				ТОГДА ИСТИНА
		|			КОГДА РабочиеМестаСотрудников.ДействуетДо > &ТекущаяДата
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаБудущихСобытий = НоваяТаблицаБудущиеСобытияОбучениеПоОхранеТруда();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьТаблицуБудущихСобытийОбучениеПоОхранеТруда(Выборка, ТаблицаБудущихСобытий, ТекущаяДата);
	КонецЦикла;
	
	Если ТаблицаБудущихСобытий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьБудущиеСобытияОбучениеПоОхранеТруда(ТаблицаБудущихСобытий);
	
КонецПроцедуры

#КонецОбласти

Процедура СоздатьВТКадровыеДанныеДляОбученияПоОхранеТруда(
		МенеджерВТ, ДатаАктуальности, Организация = Неопределено, СписокФизическихЛиц = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыПолученияСотрудниковОрганизаций = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	Если Не Организация = Неопределено Тогда
		ПараметрыПолученияСотрудниковОрганизаций.Организация = Организация;
	КонецЕсли;
	Если Не СписокФизическихЛиц = Неопределено Тогда
		ПараметрыПолученияСотрудниковОрганизаций.СписокФизическихЛиц = СписокФизическихЛиц;
	КонецЕсли;
	ПараметрыПолученияСотрудниковОрганизаций.ОкончаниеПериода = ДатаАктуальности;
	ПараметрыПолученияСотрудниковОрганизаций.РаботникиПоДоговорамГПХ = Истина;
	ПараметрыПолученияСотрудниковОрганизаций.ПодработкиРаботниковПоТрудовымДоговорам = Истина;
	
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(МенеджерВТ, Истина, ПараметрыПолученияСотрудниковОрганизаций);
	
	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(
		МенеджерВТ, "ВТСотрудникиОрганизации");
	КадровыеДанные = "РабочееМестоОхраныТруда, РабочееМестоОхраныТрудаПериодРегистрации, ДатаУвольнения, ГоловнаяОрганизация, ДатаРождения";
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВременныхТаблиц, Истина, КадровыеДанные);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаАктуальности", ?(ЗначениеЗаполнено(ДатаАктуальности), ДатаАктуальности, ОбщегоНазначения.ТекущаяДатаПользователя()));
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	КадровыеДанныеСотрудников.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	КадровыеДанныеСотрудников.РабочееМестоОхраныТруда КАК РабочееМестоОхраныТруда,
		|	КадровыеДанныеСотрудников.РабочееМестоОхраныТрудаПериодРегистрации КАК РабочееМестоОхраныТрудаПериодРегистрации,
		|	КадровыеДанныеСотрудников.ДатаУвольнения КАК ДатаУвольнения
		|ПОМЕСТИТЬ ВТКадровыеДанныеДляОбученияПоОхранеТруда
		|ИЗ
		|	ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
		|ГДЕ
		|	(КадровыеДанныеСотрудников.ДатаУвольнения >= &ДатаАктуальности
		|			ИЛИ КадровыеДанныеСотрудников.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1))";
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибкуОбработкиОбученияПоОхранеТруда(ИнформацияОбОшибке, ПредставлениеОбработки)
	
	ИмяСобытия = НСтр("ru = 'Обучение по охране труда'", ОбщегоНазначения.КодОсновногоЯзыка());
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, 
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Ошибка при обработке обучения по охране труда. Обратитесь к администратору.
			|Техническая информация:
			|При выполнении операции «%1» возникает
			|%2'"), 
		ПредставлениеОбработки,
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

