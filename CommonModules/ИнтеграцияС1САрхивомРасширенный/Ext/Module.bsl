#Область СлужебныйПрограммныйИнтерфейс

#Область УправлениеДоступом

Процедура ЗаполнитьПоставляемыеПрофилиГруппДоступа(ОписанияПрофилей, ПараметрыОбновления) Экспорт
	
	ОписаниеПрофиля = ОписаниеПрофиляОтправкаДокументовВ1САрхив();
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);
	
	ОписаниеПрофиля = ОписаниеПрофиляАдминистрированиеОбменаС1САрхивом();
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);
	
КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаВАрхив

// См. ОбменСАрхивомПереопределяемый.ОбновитьВидыДокументовПриОбновленииКонфигурации.
Процедура ОбновитьВидыДокументовПриОбновленииКонфигурации(ПараметрОбработчика) Экспорт
	
	ИнтеграцияС1САрхивомБазовый.ОбновитьВидыДокументовПриОбновленииКонфигурации(ПараметрОбработчика);
	
	Справочники.ВидыДокументовБИА.НачальноеЗаполнение();
	
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.ПриСозданииДокументовБИА.
Процедура СоздатьДокументыБИА(СсылкаНаОбъектИсточник, ДокументыБИА) Экспорт
	
	ИнтеграцияС1САрхивомБазовый.СоздатьДокументыБИА(СсылкаНаОбъектИсточник, ДокументыБИА);
	
	Если Не ДокументыБИА.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ПроизвольныеКадровыеПриказы") Тогда
		
		МодульПроизвольныеКадровыеПриказы = ОбщегоНазначения.ОбщийМодуль("ПроизвольныеКадровыеПриказы");
		МодульПроизвольныеКадровыеПриказы.СоздатьДокументыБИА(СсылкаНаОбъектИсточник, ДокументыБИА);
		
		Если Не ДокументыБИА.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТипыДокументовИсключений = Новый Массив;
	ТипыДокументовИсключений.Добавить(Тип("ДокументСсылка.ТабельУчетаРабочегоВремени"));
	ТипыДокументовИсключений.Добавить(Тип("ДокументСсылка.ПростойСотрудников"));
	
	Если Не ТипыДокументовИсключений.Найти(ТипЗнч(СсылкаНаОбъектИсточник)) = Неопределено Тогда
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник,, ТипыДокументовИсключений);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("СправочникСсылка.Сотрудники") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.ВладелецФайлов = СсылкаНаОбъектИсточник;
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("СправочникСсылка.ФизическиеЛицаПрисоединенныеФайлы") Тогда
		
		СведенияОФайлах1САрхив = РегистрыСведений.СведенияОФайлах1САрхив.СведенияОФайлеДляВыгрузкиВАрхив(СсылкаНаОбъектИсточник, Истина);
		
		Если СведенияОФайлах1САрхив.НеВыгружать Тогда
			Возврат;
		КонецЕсли;
		
		Сотрудник = СведенияОФайлах1САрхив.Сотрудник;
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			Возврат;
		КонецЕсли;
		
		ДанныеБИАШапка = Новый Структура;
		
		ДанныеБИАШапка.Вставить("ВидДокумента", СведенияОФайлах1САрхив.ВидДокументаБИА);
		ДанныеБИАШапка.Вставить("Организация", СведенияОФайлах1САрхив.Организация);
		ДанныеБИАШапка.Вставить("Дата", СведенияОФайлах1САрхив.Дата);
		
		Если Не ЗначениеЗаполнено(ДанныеБИАШапка.ВидДокумента) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Организация) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Дата) Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СведенияОФайлах1САрхив.Номер) Тогда
			ДанныеБИАШапка.Вставить("Номер", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(СведенияОФайлах1САрхив.Номер, Истина, Ложь));
		КонецЕсли;
		
		КадровыеДанныеСотрудников = ИнтеграцияС1САрхивом.КадровыеДанныеСотрудника(СведенияОФайлах1САрхив.Дата, Сотрудник);
		
		Подразделение = КадровыеДанныеСотрудников.Подразделение;
		
		Если ЗначениеЗаполнено(Подразделение) Тогда
			ДанныеБИАШапка.Вставить("Подразделение", Подразделение);
		КонецЕсли;
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьШтатноеРасписание") Тогда
			ДолжностьСотрудника = КадровыеДанныеСотрудников.ДолжностьПоШтатномуРасписанию.Должность;
		Иначе
			ДолжностьСотрудника = КадровыеДанныеСотрудников.Должность;
		КонецЕсли;
		
		ДанныеБИАШапка.Вставить("ЭтоЭлектронныйДокумент", Истина);
		ДанныеБИАШапка.Вставить("ОбъектОснование", СсылкаНаОбъектИсточник);
		
		ФИО = Сотрудник.ФизическоеЛицо.ФИО;
		
		ДанныеБИАШапка.Вставить("Заголовок", СтрШаблон(НСтр("ru = '%1 %2'"), ДанныеБИАШапка.ВидДокумента.Наименование, ФИО));
		ДанныеБИАШапка.Вставить("Содержание", СтрШаблон(НСтр("ru = '%1 %2'"), ДанныеБИАШапка.ВидДокумента.Наименование, ФИО));
		
		ДанныеБИАСвойства = Новый Массив;
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства, ПредставлениеСвойства", ДолжностьСотрудника, "Должность", НСтр("ru = 'Должность'")));
		
		ДанныеБИАФайлы = Новый Массив;
		ДанныеБИАФайлы.Добавить(Новый Структура("Файл", СсылкаНаОбъектИсточник));
		
		ДанныеБИАСубъектыПД = Новый Массив;
		ДанныеБИАСубъектыПД.Добавить(Новый Структура("ФизическоеЛицо", Сотрудник.ФизическоеЛицо));
		
		ДанныеБИА = Новый Структура;
		ДанныеБИА.Вставить("ДанныеБИАШапка", ДанныеБИАШапка);
		ДанныеБИА.Вставить("ДанныеБИАСвойства", ДанныеБИАСвойства);
		ДанныеБИА.Вставить("ДанныеБИАСубъектыПД", ДанныеБИАСубъектыПД);
		ДанныеБИА.Вставить("ДанныеБИАФайлы", ДанныеБИАФайлы);
		
		ДокументБИА = ИнтеграцияС1САрхивом.СоздатьДокументБИА(ДанныеБИА);
		Если Не ДокументБИА = Неопределено Тогда
			ДокументыБИА.Добавить(ДокументБИА);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыПеречислением") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ИмяТабличнойЧастиСотрудники = "Зарплата";
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыРаздатчиком") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ИмяТабличнойЧастиСотрудники = "Зарплата";
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ВозвратИзОтпускаПоУходуЗаРебенком") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата возврата", "ДатаВозврата");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПриостановлениеТрудовыхДоговоровКонтрактов") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата начала", "ДатаНачала");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата окончания", "ДатаОкончания");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ВозобновлениеТрудовыхДоговоровКонтрактов") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата возобновления", "ДатаВозобновления");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ВосстановлениеВДолжности") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата восстановления", "ДатаВосстановления");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
		Если ПолучитьФункциональнуюОпцию("ИспользоватьШтатноеРасписание") Тогда
			ПараметрыДокумента.ДополнительныеСвойства.Вставить("Должность", "ДолжностьПоШтатномуРасписанию");
		Иначе
			ПараметрыДокумента.ДополнительныеСвойства.Вставить("Должность", "Должность");
		КонецЕсли;
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ИзменениеГрафикаРаботыСписком") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ИмяТабличнойЧастиСотрудники = "Сотрудники";
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ИзменениеКвалификационногоРазряда") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата изменения", "ДатаИзменения");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Разряд (категория)", "РазрядКатегория");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ИзменениеУсловийОплатыОтпускаПоУходуЗаРебенком") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата изменения", "ДатаИзменения");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
		Если ПолучитьФункциональнуюОпцию("ИспользоватьШтатноеРасписание") Тогда
			ПараметрыДокумента.ДополнительныеСвойства.Вставить("Должность", "ДолжностьПоШтатномуРасписанию");
		Иначе
			ПараметрыДокумента.ДополнительныеСвойства.Вставить("Должность", "Должность");
		КонецЕсли;
		
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата перевода", "ДатаНачала");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата возврата", "ДатаОкончания");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.Командировка") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата командировки", "ДатаКомандировки");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата начала", "ДатаНачала");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата окончания", "ДатаОкончания");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.КомандировкиСотрудников") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата начала", "ДатаНачала");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата окончания", "ДатаОкончания");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.МатериальнаяПомощь") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Истина;
		ПараметрыДокумента.ИмяТабличнойЧастиСотрудники = "Начисления";
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Подразделение", "Подразделение");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата начала", "ДатаНачала");
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата окончания", "ДатаОкончания");
		
		ДокументыБИА = ИнтеграцияС1САрхивом.СоздатьДокументыБИАПоВладельцуФайлов(СсылкаНаОбъектИсточник, ПараметрыДокумента);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ОплатаДнейУходаЗаДетьмиИнвалидами") Тогда
		
		ПараметрыДокумента = ИнтеграцияС1САрхивом.ПараметрыДокумента();
		ПараметрыДокумента.Списочный = Ложь;
		ПараметрыДокумента.ДополнительныеСвойства.Вставить("Дата начала", "ДатаНачала");
