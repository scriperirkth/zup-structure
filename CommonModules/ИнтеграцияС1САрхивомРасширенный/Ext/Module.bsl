Функция СоздатьДокументБИАФайлаДокументаИсключения(Файл) Экспорт
	
	Перем Подразделение;
	
	СформированныеДокументыБИА = ИнтеграцияС1САрхивомБазовый.СоздатьДокументБИАФайлаДокументаИсключения(Файл);
	Если Не СформированныеДокументыБИА = Неопределено Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	
	СформированныеДокументыБИА = Новый Массив;
	
	Если ТипЗнч(Файл) = Тип("СправочникСсылка.ПростойСотрудниковПрисоединенныеФайлы") Тогда
		
		СведенияОФайлах1САрхив = РегистрыСведений.СведенияОФайлах1САрхив.СведенияОФайлеДляВыгрузкиВАрхив(Файл, Истина);
		
		Если СведенияОФайлах1САрхив.НеВыгружать Тогда
			Возврат СформированныеДокументыБИА;
		КонецЕсли;
		
		ДанныеБИАШапка = Новый Структура;
		
		ДанныеБИАШапка.Вставить("ВидДокумента", СведенияОФайлах1САрхив.ВидДокументаБИА);
		ДанныеБИАШапка.Вставить("Организация", СведенияОФайлах1САрхив.Организация);
		ДанныеБИАШапка.Вставить("Дата", СведенияОФайлах1САрхив.Дата);
		
		Если Не ЗначениеЗаполнено(ДанныеБИАШапка.ВидДокумента) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Организация) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Дата) Тогда
			Возврат СформированныеДокументыБИА;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СведенияОФайлах1САрхив.Номер) Тогда
			ДанныеБИАШапка.Вставить("Номер", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(СведенияОФайлах1САрхив.Номер, Истина, Ложь));
		КонецЕсли;
		
		ВладелецФайла = Файл.ВладелецФайла;
		Если ВладелецФайла.Подразделение.Пустая() Тогда
			Для Каждого СтрокаНачисления Из ВладелецФайла.Начисления Цикл
				Если Подразделение = Неопределено Тогда
					Подразделение = СтрокаНачисления.Подразделение;
				ИначеЕсли Не Подразделение = СтрокаНачисления.Подразделение Тогда
					Подразделение = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
				КонецЕсли;
			КонецЦикла;
		Иначе
			Подразделение = ВладелецФайла.Подразделение;
		КонецЕсли;
	
		Если ЗначениеЗаполнено(Подразделение) Тогда
			Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ОрганизационнаяСтруктура")
				И Не ТипЗнч(Подразделение) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
				МодульОрганизационнаяСтруктура = ОбщегоНазначения.ОбщийМодуль("ОрганизационнаяСтруктура");
				Подразделение = МодульОрганизационнаяСтруктура.ПодразделениеВСтруктуреПредприятия(Подразделение);
			КонецЕсли;
			ДанныеБИАШапка.Вставить("Подразделение", Подразделение);
		КонецЕсли;
		
		ДанныеБИАШапка.Вставить("ЭтоЭлектронныйДокумент", Истина);
		ДанныеБИАШапка.Вставить("ОбъектОснование", Файл);
		
		ДанныеБИАШапка.Вставить("Заголовок", СтрШаблон(НСтр("ru = '%1'"), ДанныеБИАШапка.ВидДокумента.Наименование));
		ДанныеБИАШапка.Вставить("Содержание", СтрШаблон(НСтр("ru = '%1 (%2)'"), ДанныеБИАШапка.ВидДокумента.Наименование, ВладелецФайла.Метаданные().Синоним));
		
		ДанныеБИАСвойства = Новый Массив;
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства, ПредставлениеСвойства", ВладелецФайла.ДатаНачала, НСтр("ru='Дата начала'")));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства, ПредставлениеСвойства", ВладелецФайла.ДатаОкончания, НСтр("ru='Дата окончания'")));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства, ПредставлениеСвойства", ВладелецФайла.ДатаПростоя, НСтр("ru='Дата простоя'")));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства, ПредставлениеСвойства", ВладелецФайла.ЧасыПростоя, НСтр("ru='Часы простоя'")));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства, ПредставлениеСвойства", ВладелецФайла.ОписаниеПричины, НСтр("ru='Описание причины'")));
		
		ДанныеБИАСубъектыПД = Новый Массив;
		Для Каждого СтрокаФизическоеЛицо Из ВладелецФайла.ФизическиеЛица Цикл
			ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", СтрокаФизическоеЛицо.ФизическоеЛицо, НСтр("ru='Физическое лицо'")));
			ДанныеБИАСубъектыПД.Добавить(Новый Структура("ФизическоеЛицо", СтрокаФизическоеЛицо.ФизическоеЛицо));
		КонецЦикла;
		
		ДанныеБИАФайлы = Новый Массив;
		ДанныеБИАФайлы.Добавить(Новый Структура("Файл", Файл));
		
		ДанныеБИА = Новый Структура;
		ДанныеБИА.Вставить("ДанныеБИАШапка", ДанныеБИАШапка);
		ДанныеБИА.Вставить("ДанныеБИАСвойства", ДанныеБИАСвойства);
		ДанныеБИА.Вставить("ДанныеБИАСубъектыПД", ДанныеБИАСубъектыПД);
		ДанныеБИА.Вставить("ДанныеБИАФайлы", ДанныеБИАФайлы);
		
		ДокументБИА = ИнтеграцияС1САрхивом.СоздатьДокументБИА(ДанныеБИА);
		Если Не ДокументБИА = Неопределено Тогда
			СформированныеДокументыБИА.Добавить(ДокументБИА);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Файл) = Тип("СправочникСсылка.ТабельУчетаРабочегоВремениПрисоединенныеФайлы") Тогда
		
		СведенияОФайлах1САрхив = РегистрыСведений.СведенияОФайлах1САрхив.СведенияОФайлеДляВыгрузкиВАрхив(Файл, Истина);
		
		Если СведенияОФайлах1САрхив.НеВыгружать Тогда
			Возврат СформированныеДокументыБИА;
		КонецЕсли;
		
		ДанныеБИАШапка = Новый Структура;
		
		ДанныеБИАШапка.Вставить("ВидДокумента", СведенияОФайлах1САрхив.ВидДокументаБИА);
		ДанныеБИАШапка.Вставить("Организация", СведенияОФайлах1САрхив.Организация);
		ДанныеБИАШапка.Вставить("Дата", СведенияОФайлах1САрхив.Дата);
		
		Если Не ЗначениеЗаполнено(ДанныеБИАШапка.ВидДокумента) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Организация) Или Не ЗначениеЗаполнено(ДанныеБИАШапка.Дата) Тогда
			Возврат СформированныеДокументыБИА;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СведенияОФайлах1САрхив.Номер) Тогда
			ДанныеБИАШапка.Вставить("Номер", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(СведенияОФайлах1САрхив.Номер, Истина, Ложь));
		КонецЕсли;
		
		ВладелецФайла = Файл.ВладелецФайла;
		Подразделение = ВладелецФайла.Подразделение;
		Если ЗначениеЗаполнено(Подразделение) Тогда
			Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ОрганизационнаяСтруктура")
				И Не ТипЗнч(Подразделение) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
				МодульОрганизационнаяСтруктура = ОбщегоНазначения.ОбщийМодуль("ОрганизационнаяСтруктура");
				Подразделение = МодульОрганизационнаяСтруктура.ПодразделениеВСтруктуреПредприятия(Подразделение);
			КонецЕсли;
			ДанныеБИАШапка.Вставить("Подразделение", Подразделение);
		КонецЕсли;
		
		ДанныеБИАШапка.Вставить("ЭтоЭлектронныйДокумент", Истина);
		ДанныеБИАШапка.Вставить("ОбъектОснование", Файл);
		
		ДанныеБИАШапка.Вставить("Заголовок", СтрШаблон(НСтр("ru = '%1'"), ДанныеБИАШапка.ВидДокумента.Наименование));
		ДанныеБИАШапка.Вставить("Содержание", СтрШаблон(НСтр("ru = '%1 (%2)'"), ДанныеБИАШапка.ВидДокумента.Наименование, ВладелецФайла.Метаданные().Синоним));
		
		ДанныеБИАСвойства = Новый Массив;
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства, ПредставлениеСвойства", ВладелецФайла.ДатаНачалаПериода, НСтр("ru='Дата начала'")));
		ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства, ПредставлениеСвойства", ВладелецФайла.ДатаОкончанияПериода, НСтр("ru='Дата окончания'")));
		
		ДанныеБИАСубъектыПД = Новый Массив;
		Для Каждого Данные Из ВладелецФайла.ДанныеОВремени Цикл
			ДанныеБИАСвойства.Добавить(Новый Структура("Значение, ИмяСвойства", Данные.Сотрудник.ФизическоеЛицо, НСтр("ru='Физическое лицо'")));
			ДанныеБИАСубъектыПД.Добавить(Новый Структура("ФизическоеЛицо", Данные.Сотрудник.ФизическоеЛицо));
		КонецЦикла;
		
		ДанныеБИАФайлы = Новый Массив;
		ДанныеБИАФайлы.Добавить(Новый Структура("Файл", Файл));
		
		ДанныеБИА = Новый Структура;
		ДанныеБИА.Вставить("ДанныеБИАШапка", ДанныеБИАШапка);
		ДанныеБИА.Вставить("ДанныеБИАСвойства", ДанныеБИАСвойства);
		ДанныеБИА.Вставить("ДанныеБИАСубъектыПД", ДанныеБИАСубъектыПД);
		ДанныеБИА.Вставить("ДанныеБИАФайлы", ДанныеБИАФайлы);
		
		ДокументБИА = ИнтеграцияС1САрхивом.СоздатьДокументБИА(ДанныеБИА);
		Если Не ДокументБИА = Неопределено Тогда
			СформированныеДокументыБИА.Добавить(ДокументБИА);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти