Функция ДанныеТрудовогоДоговора(СсылкаНаДокумент, Сотрудник) Экспорт
	
	Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта("ТрудовойДоговорНомер", Метаданные.Документы.ПриемНаРаботу) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриемНаРаботу.ТрудовойДоговорНомер КАК ТрудовойДоговорНомер,
	|	ПриемНаРаботу.ТрудовойДоговорДата КАК ТрудовойДоговорДата
	|ИЗ
	|	Документ.ПриемНаРаботу КАК ПриемНаРаботу
	|ГДЕ
	|	ПриемНаРаботу.Ссылка = &Ссылка
	|	И ПриемНаРаботу.Сотрудник = &Сотрудник
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриемНаРаботуСпискомСотрудники.ТрудовойДоговорНомер,
	|	ПриемНаРаботуСпискомСотрудники.ТрудовойДоговорДата
	|ИЗ
	|	Документ.ПриемНаРаботуСписком.Сотрудники КАК ПриемНаРаботуСпискомСотрудники
	|ГДЕ
	|	ПриемНаРаботуСпискомСотрудники.Ссылка = &Ссылка
	|	И ПриемНаРаботуСпискомСотрудники.Сотрудник = &Сотрудник
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КадровыйПеревод.ТрудовойДоговорНомер,
	|	КадровыйПеревод.ТрудовойДоговорДата
	|ИЗ
	|	Документ.КадровыйПеревод КАК КадровыйПеревод
	|ГДЕ
	|	КадровыйПеревод.Ссылка = &Ссылка
	|	И КадровыйПеревод.Сотрудник = &Сотрудник
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КадровыйПереводСпискомСотрудники.ТрудовойДоговорНомер,
	|	КадровыйПереводСпискомСотрудники.ТрудовойДоговорДата
	|ИЗ
	|	Документ.КадровыйПереводСписком.Сотрудники КАК КадровыйПереводСпискомСотрудники
	|ГДЕ
	|	КадровыйПереводСпискомСотрудники.Ссылка = &Ссылка
	|	И КадровыйПереводСпискомСотрудники.Сотрудник = &Сотрудник";
	
	ДанныеТрудовогоДоговора = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеТрудовогоДоговора = Новый Структура("ТрудовойДоговорНомер, ТрудовойДоговорДата");
		ЗаполнитьЗначенияСвойств(ДанныеТрудовогоДоговора, Выборка);
	КонецЕсли;
	
	Возврат ДанныеТрудовогоДоговора;
	
КонецФункции

// См. ОбменСАрхивомПереопределяемый.ПриСозданииНаСервере.
Процедура ПриСозданииНаСервере(Форма, ПараметрыРазмещения, ЭтоФормаОбъекта) Экспорт
	
	Если Не ИнтеграцияС1САрхивомВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
