//   Булево - если Истина, используется платформа 8.5.1 и выше.
//
Функция ЭтоПлатформа85() Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат (ОбщегоНазначенияКлиентСервер.СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, "8.5.1.1") >= 0);
	
