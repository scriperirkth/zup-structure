// Определяет идентификатор домена на основании
// режима использования внешних ресурсов.
//
// Возвращаемое значение:
//  Число - идентификатор домена.
//
Функция ДоменРасположенияСерверовИПП()
	
#Если МобильныйКлиент Или МобильноеПриложениеКлиент Тогда
	// метод ПолучитьРежимВнешнихРесурсов недоступен в мобильном клиенте, поэтому вызываем сервер.
	Возврат ИнтернетПоддержкаПользователейВызовСервера.ДоменРасположенияСерверовИПП();
#Иначе
	РежимИспользования = ПолучитьРежимВнешнихРесурсов();
	Если ВРег(РежимИспользования) = "D" Тогда
		Возврат 0;
	Иначе
		Возврат 1;
	КонецЕсли;
#КонецЕсли

КонецФункции

#КонецОбласти
