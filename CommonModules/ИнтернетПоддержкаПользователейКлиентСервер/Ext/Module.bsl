#Область ТехническаяИнформация

// Описание системной информации.
//
// Возвращаемое значение:
//  Структура - описание системной информации:
//   * ТипПлатформы - Строка, Неопределено - тип платформы, в рамках которой осуществляется работа;
//   * ВерсияПриложения - Строка, Неопределено - версия используемого 1С:Предприятия 8;
//   * ВерсияОС - Строка, Неопределено - версия операционной системы.
//   * ВариантПриложения - Строка, Неопределено - признак специального варианта поставки платформы.
//
Функция ОписаниеСистемнойИнформации() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТипПлатформы", Неопределено);
	Результат.Вставить("ВерсияПриложения", Неопределено);
	Результат.Вставить("ВерсияОС", Неопределено);
	Результат.Вставить("ВариантПриложения", Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Возвращает настройки подготовки технической информации.
// 
// Возвращаемое значение:
//  Структура - настройки технической информации:
//    *ОтправкаИдентификатораКонфигурации - Булево - признак отправки идентификатора конфигурации.
//
Функция НастройкиТехническойИнформации() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОтправкаИдентификатораКонфигурации", Ложь);
	
	Возврат Результат;
	
КонецФункции

// Описание технической информации.
//
// Возвращаемое значение:
//  Структура:
//    * ОписаниеПрограммы - Структура, Неопределено - См. ИнтернетПоддержкаПользователей.ОписаниеПрограммы;
//    * ТекущаяСессия - Структура, Неопределено - См. ИнтернетПоддержкаПользователей.ОписаниеТекущейСессии;
//    * ДанныеРасширений - Неопределено, Массив из РасширениеКонфигурации, Массив Из Структура -
//        данные расширений конфигурации;
//    * ДанныеПодсистем - Неопределено, Массив Из Структура - описание всех библиотек конфигурации,
//        См. ОбщегоНазначения.ОписанияПодсистем;
//    * НастройкиИнтернетПоддержки - Структура, Неопределено -
//        См. ИнтернетПоддержкаПользователей.НастройкиИнтернетПоддержки;
//    * ИнтернетНастройки - Структура, Неопределено - ИнтернетПоддержкаПользователей.ИнтернетНастройки;
//    * СистемнаяИнформацияКлиента - см. ОписаниеСистемнойИнформации.
//    * СистемнаяИнформацияСервера - см. ОписаниеСистемнойИнформации.
//
Функция ОписаниеТехническойИнформации() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОписаниеПрограммы", Неопределено);
	Результат.Вставить("ТекущаяСессия", Неопределено);
	Результат.Вставить("ИнтернетНастройки", Неопределено);
	Результат.Вставить("ДанныеРасширений", Неопределено);
	Результат.Вставить("ДанныеПодсистем", Неопределено);
	Результат.Вставить("НастройкиИнтернетПоддержки", Неопределено);
	
	Результат.Вставить(
		"СистемнаяИнформацияКлиента",
		ОписаниеСистемнойИнформации());
	Результат.Вставить(
		"СистемнаяИнформацияСервера",
		ОписаниеСистемнойИнформации());
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПереходПоСсылкам

// Проверяет, что для перехода на указанный адрес требуется авторизация по токену.
// 
// Параметры:
//  URLСтраницыСайта - Строка - адрес, который необходимо проверить.
// 
// Возвращаемое значение:
//  Булево - Истина, если для открытия указанной страницы необходима авторизация.
//
Функция ОткрытьСАвторизацией(URLСтраницыСайта) Экспорт
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(URLСтраницыСайта);
	Возврат (СтруктураURI.Хост = "its.1c.ru")
		Или (СтруктураURI.Хост = "its.1c.eu")
		Или (СтруктураURI.Хост = "its.1c.kz");
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает новую структуру с результатом подключения.
//
// Возвращаемое значение:
//  Структура - описание результата подключения:
//   * Подключена - Булево - результат проверки, если Истина, логин и пароль ведены верно.
//   * Логин - Строка - логин пользователя Интернет-поддержки.
//   * КапчаBase64 - Строка, Неопределено - картинка капчи в формате base64.
//       Картинка капчи может быть возвращена в случае получения ошибки
//       "ПревышеноКоличествоПопыток".
//   * КодОшибки - Строка - идентификатор ошибки в случае если логин и пароль ведены верно
//      или в процессе проверки возникли ошибки;
//   * СообщениеОбОшибке - Строка - описание ошибки проверки данных аутентификации.
//
Функция НовыйРезультатПодключения() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("Подключена", Ложь);
	Результат.Вставить("КапчаBase64", "");
	Результат.Вставить("Логин", "");
	
	Возврат Результат;
	
КонецФункции

// Возвращает код ошибки "ПревышеноКоличествоПопыток".
//
// Возвращаемое значение:
//  Строка - код ошибки.
//
Функция КодОшибкиПревышеноКоличествоПопыток() Экспорт
	
	Возврат "ПревышеноКоличествоПопыток";
	
КонецФункции

