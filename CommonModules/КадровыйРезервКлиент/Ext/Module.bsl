КонецПроцедуры

#КонецОбласти

// Параметры:
//  АктуальныйРезерв - Массив из Структура:
//   * ПозицииРезерва - Массив из СправочникСсылка.КадровыйРезерв
//   * ПозицииКандидатаВРезерв - Массив из СправочникСсылка.КадровыйРезерв
//   * УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
//  Форма - ФормаКлиентскогоПриложения
Процедура ВывестиУведомлениеОНаличииРезерва(АктуальныйРезерв, Форма) Экспорт
	
	Форма.ЖдатьЗакрытияФормыУведомления = Истина;
	
	МассивСтрок = Новый Массив;
	
	Для Каждого Резерв Из АктуальныйРезерв Цикл
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(
			Новый ФорматированнаяСтрока(Строка(Резерв.УчастникКадровогоРезерва), Новый Шрифт(,, Истина))));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(":"));
			
		Для Каждого СтрокаРезерв Из Резерв.ПозицииРезерва Цикл
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока("    - "));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Строка(СтрокаРезерв),,,,
				ПолучитьНавигационнуюСсылку(СтрокаРезерв)));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Символы.НПП));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='(в резерве)'")));
		КонецЦикла;
		
		Для Каждого СтрокаКандидатВРезерв Из Резерв.ПозицииКандидатаВРезерв Цикл
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока("    - "));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Строка(СтрокаКандидатВРезерв),,,,
				ПолучитьНавигационнуюСсылку(СтрокаКандидатВРезерв)));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Символы.НПП));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='(кандидат в резерв)'")));
		КонецЦикла;
			
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		
	КонецЦикла;
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Закрыть", НСтр("ru = 'Закрыть'"));
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Истина;
	ПараметрыВопроса.ТекстФлажка = НСтр("ru = 'Больше не выводить'");
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Уведомление о наличии резерва'");
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		Новый ОписаниеОповещения("ЗакрытьПослеПроведения", Форма),
		Новый ФорматированнаяСтрока(МассивСтрок),
		Кнопки,
		ПараметрыВопроса);
			
КонецПроцедуры

// Параметры:
//  Форма - см. Документ.РезультатыАттестацииСотрудников.Форма.ФормаДокумента
Процедура ПроверитьПоляКадровогоРезерва(Форма) Экспорт

	ТекущиеДанные = Форма.Элементы.РезультатыАттестации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РекомендуетсяВКадровыйРезерв = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент(
		"Справочник.РешенияАттестационныхКомиссий.РекомендуетсяВКадровыйРезерв");
	
	Если РекомендуетсяВКадровыйРезерв = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.РешениеКомиссии <> РекомендуетсяВКадровыйРезерв Тогда
		ТекущиеДанные.ПозицияРезерва = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент(
			"Справочник.КадровыйРезерв.ПустаяСсылка");
		ТекущиеДанные.ВидРезерва = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент(
			"Справочник.ВидыКадровогоРезерва.ПустаяСсылка");
	КонецЕсли;

КонецПроцедуры

Функция ТекущиеДанныеТаблицы(Форма) Экспорт
	
	ТекущиеДанные = Форма.Элементы.КадровыйРезервПозицииШР.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Новый Структура("ПозицияРезерва, УчастникКадровогоРезерва", Форма.КадровыйРезервСвязаннаяПозицияРезерва,
			ТекущиеДанные.УчастникКадровогоРезерва);
	КонецЕсли;
	
КонецФункции

// Параметры:
//  ПараметрыВыполненияКоманды - ПараметрыВыполненияКоманды
Процедура КомандаКадровыйРезерв(ПараметрыВыполненияКоманды) Экспорт
	
	ОткрытьФорму("Обработка.УправлениеКадровымРезервом.Форма", ,
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно,
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПроцедуры

// Вызывается при изменении Подразделения в формах документов. Выводит вопрос об очистке табличной части.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяТабличнойЧасти - Строка
Процедура ПодразделениеПриИзменении(Форма, ИмяТабличнойЧасти) Экспорт
	
	Если Форма.Объект.Подразделение = Форма.ПодразделениеПрежнее Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	Оповещение = Новый ОписаниеОповещения("ПодразделениеПриИзмененииЗавершение", КадровыйРезервКлиент,
		ДополнительныеПараметры);
	
	ЗарплатаКадрыРасширенныйКлиент.ПроверитьВозможностьОчисткиТабличныхЧастей(Форма, ИмяТабличнойЧасти, Оповещение);
	
КонецПроцедуры

// Параметры:
//  Отказ - Булево
//  ДополнительныеПараметры - Структура:
//   * Форма - ФормаКлиентскогоПриложения
Процедура ПодразделениеПриИзмененииЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	
	Если Отказ Тогда
		Форма.Объект.Подразделение = Форма.ПодразделениеПрежнее;
	Иначе
		Форма.Объект.Сотрудники.Очистить();
		Форма.ПодразделениеПрежнее = Форма.Объект.Подразделение;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  ОснованиеОбъект - ОпределяемыйТип.ОснованиеИсключенияИзКадровогоРезерва
//  Данные - Массив из Структура:
//   * УчастникКадровогоРезерва - ОпределяемыйТип.УчастникКадровогоРезерва
//   * Подразделение - СправочникСсылка.СтруктураПредприятия 
Процедура СоздатьИсключенияИзКадровогоРезерваПоДаннымОснования(ОснованиеОбъект, Данные)
	
	Если Не ЗначениеЗаполнено(Данные) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет сотрудников для исключения из кадрового резерва'"));
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеДокумента Из Данные Цикл
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Подразделение", ДанныеДокумента.Подразделение);
		ЗначенияЗаполнения.Вставить("УчастникКадровогоРезерва", ДанныеДокумента.УчастникКадровогоРезерва);
		ЗначенияЗаполнения.Вставить("ОснованиеОбъект", ОснованиеОбъект);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		ОткрытьФорму("Документ.ИсключениеИзКадровогоРезерва.Форма.ФормаДокумента", ПараметрыФормы, , Истина);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти