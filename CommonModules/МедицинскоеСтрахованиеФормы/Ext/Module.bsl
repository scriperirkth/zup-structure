Процедура ПолучитьФактическиеУдержания(Объект, Сотрудник, Удержание, ГрафикУдержаний)
	
	Для Каждого СтрокаГрафика Из ГрафикУдержаний Цикл
		СтрокаГрафика.ФактическиУдержано = 0;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Удержание) Тогда
		Возврат;
	КонецЕсли;
	
	УдержанияСотрудника = ОтражениеЗарплатыВУчете.ДанныеДляОтражениеВУчетеУдержаний(
		Объект.Организация, Объект.ДатаНачалаСтрахования, Объект.ДатаОкончанияСтрахования, Сотрудник);
	
	Для Каждого СтрокаУдержание Из УдержанияСотрудника Цикл
		СтрокаУдержание.ДатаНачала = НачалоМесяца(СтрокаУдержание.ДатаНачала);
	КонецЦикла;
	УдержанияСотрудника.Свернуть("ДатаНачала, Удержание, ДокументОснование", "Сумма");
	
	ФактическиеУдержанияСотрудника = УдержанияСотрудника.НайтиСтроки(Новый Структура("Удержание", Удержание));
	КоличествоФактическихУдержаний = ФактическиеУдержанияСотрудника.Количество();
	Если КоличествоФактическихУдержаний = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДляКорректировки = 0;
	Для Каждого СтрокаУдержание Из ФактическиеУдержанияСотрудника Цикл
		
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПрикреплениеКПрограммамМедицинскогоСтрахования") Тогда
			ДокументОснование = Объект.Ссылка;
		Иначе
			ДокументОснование = Объект.Основание;
		КонецЕсли;	
		
		Если СтрокаУдержание.ДокументОснование <> ДокументОснование Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаГрафикаФакт = Неопределено;
		Для Каждого СтрокаГрафика Из ГрафикУдержаний Цикл
			Если СтрокаГрафика.Дата <> СтрокаУдержание.ДатаНачала Тогда
				Продолжить;
			КонецЕсли;
			СтрокаГрафикаФакт = СтрокаГрафика;
			Прервать;
		КонецЦикла;
		Если СтрокаГрафикаФакт = Неопределено Тогда
			СтрокаГрафикаФакт = Объект.ГрафикУдержаний.Добавить();
		КонецЕсли;
		СтрокаГрафикаФакт.Дата = СтрокаУдержание.ДатаНачала;
		СтрокаГрафикаФакт.ДатаСтрокой = Формат(СтрокаГрафика.Дата, НСтр("ru='ДФ=''ММММ гггг'''"));
		СтрокаГрафикаФакт.Представление = СтрШаблон(НСтр("ru = '%1, факт.'"), СтрокаГрафика.ДатаСтрокой);
		СтрокаГрафикаФакт.КоличествоДней = 0;
		СтрокаГрафикаФакт.ФактическиУдержано = СтрокаУдержание.Сумма;
		СтрокаГрафикаФакт.ВведеноПользователем = Ложь;
		СуммаДляКорректировки = СуммаДляКорректировки + СтрокаГрафикаФакт.ФактическиУдержано - СтрокаГрафикаФакт.Сумма;
		СтрокаГрафикаФакт.Сумма = СтрокаГрафикаФакт.ФактическиУдержано;
	КонецЦикла;
	
	Если СуммаДляКорректировки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СуммыКРаспределению = Новый Массив;
	ОбщаяСумма = 0;
	Для Каждого СтрокаГрафика Из ГрафикУдержаний Цикл
		Если СтрокаГрафика.ФактическиУдержано > 0 Или СтрокаГрафика.ВведеноПользователем Тогда
			Продолжить;
		КонецЕсли;
		ОбщаяСумма = ОбщаяСумма + СтрокаГрафика.Сумма;
		СуммыКРаспределению.Добавить(СтрокаГрафика.Сумма);
	КонецЦикла;
	
	Если ОбщаяСумма = 0 Тогда
		Возврат;
	ИначеЕсли СуммаДляКорректировки >= ОбщаяСумма Тогда
		Для Каждого СтрокаГрафика Из ГрафикУдержаний Цикл
			Если СтрокаГрафика.ФактическиУдержано > 0 Или СтрокаГрафика.ВведеноПользователем Тогда
				Продолжить;
			КонецЕсли;
			СтрокаГрафика.Сумма = 0;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	СуммыКРаспределению = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		ОбщаяСумма - СуммаДляКорректировки, СуммыКРаспределению);
	
	Индекс = 0;
	Для Каждого СтрокаГрафика Из ГрафикУдержаний Цикл
		Если СтрокаГрафика.ФактическиУдержано > 0 Или СтрокаГрафика.ВведеноПользователем Тогда
			Продолжить;
		КонецЕсли;
		СтрокаГрафика.Сумма = СуммыКРаспределению[Индекс];
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция СтраховыеПремииЗастрахованных(Объект, ДанныеСотрудника, СуммыКРаспределению, Знач ОтборПоФизическомуЛицу)
	
	СтраховыеПремииЗастрахованных = Новый Массив;
	
	Если ДанныеСотрудника.УдерживатьИзЗарплаты Тогда
		ОтборПоСотруднику = Новый Структура("Сотрудник", ДанныеСотрудника.Сотрудник);
		ИменаТаблиц = Новый Массив;
		ИменаТаблиц.Добавить("ПрограммыСтрахованияСотрудников");
		ИменаТаблиц.Добавить("РасширенияПрограммСтрахованияСотрудников");
		Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
			НастройкиПрограмм = Объект[ИмяТаблицы].НайтиСтроки(ОтборПоСотруднику);
			Для Каждого СведенияОПрограмме Из НастройкиПрограмм Цикл
				СтрокаРаспределениеСумм = НоваяСтрокаРаспределениеСумм();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределениеСумм, СведенияОПрограмме);
				СуммыКРаспределению.Добавить(СтрокаРаспределениеСумм.СтраховаяПремия);
				СтраховыеПремииЗастрахованных.Добавить(СтрокаРаспределениеСумм);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ИменаТаблиц = Новый Массив;
	ИменаТаблиц.Добавить("ПрограммыСтрахованияРодственников");
	ИменаТаблиц.Добавить("РасширенияПрограммСтрахованияРодственников");
	
	НастройкиРодственников = Объект.Родственники.НайтиСтроки(ОтборПоФизическомуЛицу);
	ОтборПоФизическомуЛицу.Вставить("РодственникСсылка");
	Для Каждого Настройка Из НастройкиРодственников Цикл
		Если Не Настройка.УдерживатьССотрудника Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
			ОтборПоФизическомуЛицу.РодственникСсылка = Настройка.РодственникСсылка;
			НастройкиПрограмм = Объект[ИмяТаблицы].НайтиСтроки(ОтборПоФизическомуЛицу);
			Для Каждого СведенияОПрограмме Из НастройкиПрограмм Цикл
				СтрокаРаспределениеСумм = НоваяСтрокаРаспределениеСумм();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределениеСумм, СведенияОПрограмме);
				СуммыКРаспределению.Добавить(СтрокаРаспределениеСумм.СтраховаяПремия);
				СтраховыеПремииЗастрахованных.Добавить(СтрокаРаспределениеСумм);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СтраховыеПремииЗастрахованных;
	
КонецФункции

Функция НоваяСтрокаРаспределениеСумм()
	
	СтрокаРаспределениеСумм = Новый Структура;
	СтрокаРаспределениеСумм.Вставить("СтраховаяПремия", 0);
	СтрокаРаспределениеСумм.Вставить("ДатаНачала", '00010101');
	СтрокаРаспределениеСумм.Вставить("ДатаОкончания", '00010101');
	СтрокаРаспределениеСумм.Вставить("Коэффициенты", Новый Массив);
	СтрокаРаспределениеСумм.Вставить("ВсяСуммаВведенаПользователем", Ложь);
	
	Возврат СтрокаРаспределениеСумм;
	
КонецФункции

Процедура УдалитьСвязанныеССотрудникомДанные(Форма, Сотрудник, ФизическоеЛицо, ИдентификаторСтрокиВидаРасчета = Неопределено, ЭтоИзменениеУсловийСтрахования = Ложь, ЭтоОткрепление = Ложь) Экспорт
	
	// Удалим строки показателей
	Если Не ЭтоОткрепление Тогда
		
		// Показатели
		СтруктураОтбора = Новый Структура("ИдентификаторСтрокиВидаРасчета", ИдентификаторСтрокиВидаРасчета);
		УдалитьСвязанныеССотрудникомДанныеИзТЧ(Форма, СтруктураОтбора, "Показатели");
		
		// Застрахованные
		// Само ФЛ Сотрудника
		СтруктураОтбора = Новый Структура("Застрахованный", ФизическоеЛицо);
		ИменаТаблицКОчистке = ИменаТаблицЗастрахованныхКОчистке();
		// Его родственники
		СтруктураОтбораРодственников = Новый Структура("ФизическоеЛицо", ФизическоеЛицо);
		Родственники = Форма.Объект.Родственники.НайтиСтроки(СтруктураОтбораРодственников);
		Для Каждого ИмяТЧ Из ИменаТаблицКОчистке Цикл
			УдалитьСвязанныеССотрудникомДанныеИзТЧ(Форма, СтруктураОтбора, ИмяТЧ);
			Для Каждого СтрокаРодственника Из Родственники Цикл
				СтруктураОтбора.Застрахованный = СтрокаРодственника.РодственникСсылка;
				УдалитьСвязанныеССотрудникомДанныеИзТЧ(Форма, СтруктураОтбора, ИмяТЧ);
			КонецЦикла;
		КонецЦикла;	
		
	КонецЕсли;	
	
	// Сотрудник
	СтруктураОтбора = Новый Структура("Сотрудник", Сотрудник);
	ИменаТаблицКОчистке = ИменаТаблицСотрудниковКОчистке(ЭтоИзменениеУсловийСтрахования, ЭтоОткрепление);
	Для Каждого ИмяТЧ Из ИменаТаблицКОчистке Цикл
		УдалитьСвязанныеССотрудникомДанныеИзТЧ(Форма, СтруктураОтбора, ИмяТЧ);
	КонецЦикла;
	
	// ФизическоеЛицо
	СтруктураОтбора = Новый Структура("ФизическоеЛицо", ФизическоеЛицо);
	ИменаТаблицКОчистке = ИменаТаблицФизЛицКОчистке(ЭтоИзменениеУсловийСтрахования, ЭтоОткрепление);
	Для Каждого ИмяТЧ Из ИменаТаблицКОчистке Цикл
		УдалитьСвязанныеССотрудникомДанныеИзТЧ(Форма, СтруктураОтбора, ИмяТЧ);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСвязанныеССотрудникомДанныеИзТЧ(Форма, СтруктураОтбора, ИмяТЧ)
	
	НайденныеСтроки = Форма.Объект[ИмяТЧ].НайтиСтроки(СтруктураОтбора);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Форма.Объект[ИмяТЧ].Удалить(НайденнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Функция ИменаТаблицСотрудниковКОчистке(ЭтоИзменениеУсловийСтрахования, ЭтоОткрепление)
	
	ИменаТаблиц = Новый Массив;
	ИменаТаблиц.Добавить("ПрограммыСтрахованияСотрудников");
	ИменаТаблиц.Добавить("РасширенияПрограммСтрахованияСотрудников");
	Если Не ЭтоИзменениеУсловийСтрахования И НЕ ЭтоОткрепление Тогда
		ИменаТаблиц.Добавить("СведенияСотрудников");
	КонецЕсли;	
		
	Возврат ИменаТаблиц;
	
КонецФункции

Функция ИменаТаблицФизЛицКОчистке(ЭтоИзменениеУсловийСтрахования, ЭтоОткрепление)
	
	ИменаТаблиц = Новый Массив;
	ИменаТаблиц.Добавить("Родственники");
	ИменаТаблиц.Добавить("ПрограммыСтрахованияРодственников");
	ИменаТаблиц.Добавить("РасширенияПрограммСтрахованияРодственников");
	Если Не ЭтоОткрепление Тогда
		ИменаТаблиц.Добавить("ГрафикУдержаний");
		Если Не ЭтоИзменениеУсловийСтрахования Тогда
			ИменаТаблиц.Добавить("СведенияРодственников");
		КонецЕсли;
	Иначе
		ИменаТаблиц.Добавить("Удержания");
	КонецЕсли;	
		
	Возврат ИменаТаблиц;
	
КонецФункции

Функция ИменаТаблицЗастрахованныхКОчистке()
	
	ИменаТаблиц = Новый Массив;
	ИменаТаблиц.Добавить("ДанныеЗастрахованных");
	ИменаТаблиц.Добавить("КонтактнаяИнформацияЗастрахованных");
	ИменаТаблиц.Добавить("ДополнительныеРеквизитыИСведенияЗастрахованных");
	
	Возврат ИменаТаблиц;
	
КонецФункции

Процедура УстановитьРасширенияСтрахования(Объект, ТекущиеДанные, ИмяТаблицы, ИмяПоля, РасширенияСтрахования, ИмяПоляФизическогоЛица = Неопределено)
	
	ТекущиеДанные.РасширенияПрограммСтрахования = "";
	СтруктураОтбора = Новый Структура(ИмяПоля, ТекущиеДанные[ИмяПоля]);
	НайденныеСтроки = Объект[ИмяТаблицы].НайтиСтроки(СтруктураОтбора);
	Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		Объект[ИмяТаблицы].Удалить(СтрокаТаблицы);
	КонецЦикла;
	Для каждого ЭлементМассива Из РасширенияСтрахования Цикл
		НоваяСтрока = Объект[ИмяТаблицы].Добавить();
		НоваяСтрока[ИмяПоля] = ТекущиеДанные[ИмяПоля];
		Если ИмяПоляФизическогоЛица <> Неопределено Тогда
			НоваяСтрока[ИмяПоляФизическогоЛица] = ТекущиеДанные[ИмяПоляФизическогоЛица];
		КонецЕсли;
		НоваяСтрока.РасширениеСтрахования = ЭлементМассива.РасширениеСтрахования;
		НоваяСтрока.СтраховаяПремия = ЭлементМассива.СтраховаяПремия;
		НоваяСтрока.ДатаНачала = ЭлементМассива.ДатаНачала;
		НоваяСтрока.ДатаОкончания = ЭлементМассива.ДатаОкончания;
		ТекущиеДанные.РасширенияПрограммСтрахования = ТекущиеДанные.РасширенияПрограммСтрахования + ЭлементМассива.РасширениеСтрахования + "; ";
	КонецЦикла;
	Если Не ПустаяСтрока(ТекущиеДанные.РасширенияПрограммСтрахования) Тогда
		СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(ТекущиеДанные.РасширенияПрограммСтрахования, 2);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
