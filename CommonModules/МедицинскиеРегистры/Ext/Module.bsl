// Останавливает выполнение кода на заданное время.
// Метод продублирован из ОбменДаннымиСервер.
//
// Параметры:
//  Секунд - Число - время ожидания в секундах.
//
Процедура Пауза(Секунд) Экспорт
	
	ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();
	
	Если ФоновоеЗадание = Неопределено Тогда
		
		Параметры = Новый Массив;
		Параметры.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("МедицинскиеРегистры.Пауза", Параметры);
		
	КонецЕсли;
		
	ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);
	
КонецПроцедуры

Функция ЗаполнитьТаблицуУслуг(ТаблицаУслуг,Услуга)
	СтрокаУслуги = ТаблицаУслуг.Добавить();
	СтрокаУслуги.Услуга = Услуга;
	СтрокаУслуги.Родитель = Услуга.Родитель;
	Если ЗначениеЗаполнено(СтрокаУслуги.Родитель)Тогда
		ЗаполнитьТаблицуУслуг(ТаблицаУслуг,СтрокаУслуги.Родитель);
	КонецЕсли;
	
КонецФункции

Функция ДеревоУслугПоСписку(СписокУслуг) Экспорт
	ТаблицаУслуг = Новый ТаблицаЗначений();
	ТаблицаУслуг.Колонки.Добавить("Услуга",Новый ОписаниеТипов("СправочникСсылка.ЭлементыКлассификаторовФедеральныхМедрегистров"));
	ТаблицаУслуг.Колонки.Добавить("Родитель",Новый ОписаниеТипов("СправочникСсылка.ЭлементыКлассификаторовФедеральныхМедрегистров"));

	Для Каждого Услуга Из СписокУслуг Цикл
		ЗаполнитьТаблицуУслуг(ТаблицаУслуг, Услуга);
	КонецЦикла;
	ТаблицаУслуг.Свернуть("Услуга, Родитель");
	ТаблицаУслуг.Сортировать("Родитель");
	ДеревоУслуг = ДеревоИзТаблицы(ТаблицаУслуг, "Услуга", "Родитель");
	
	Возврат ДеревоУслуг;
	
КонецФункции

Функция ДеревоИзТаблицы(ИсходнаяТаблица, КолонкаID, КолонкаParent)
	
	ДеревоРезультатов = Новый ДеревоЗначений; 
	Для Каждого Колонка Из ИсходнаяТаблица.Колонки Цикл
		Если Колонка.Имя = КолонкаParent Тогда
			Продолжить;
		КонецЕсли;
		ДеревоРезультатов.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ИсходнаяТаблица Цикл
		
		СтрокаРодитель = ДеревоРезультатов.Строки.Найти(СтрокаТаблицы[КолонкаParent], КолонкаID, Истина);
		Если СтрокаРодитель = Неопределено Тогда
			СтрокаДерева = ДеревоРезультатов.Строки.Добавить();
		Иначе
			СтрокаДерева = СтрокаРодитель.Строки.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаТаблицы);

	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ИсходнаяТаблица Цикл
		
		СтрокаРодитель = ДеревоРезультатов.Строки.Найти(СтрокаТаблицы[КолонкаParent], КолонкаID, Истина);
		СтрокаДерева    = ДеревоРезультатов.Строки.Найти(СтрокаТаблицы[КолонкаID], КолонкаID, Истина);
		
		Если СтрокаДерева = Неопределено Тогда
			
			СтрокаДерева = ДеревоРезультатов.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаТаблицы);
			
		КонецЕсли; 
		
		Если Не СтрокаДерева.Родитель = СтрокаРодитель Тогда
			ЗаполнитьЗначенияСвойств(СтрокаРодитель.Строки.Добавить(), СтрокаТаблицы);
			ДеревоРезультатов.Строки.Удалить(СтрокаДерева);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДеревоРезультатов;
	
КонецФункции

Функция ПолучитьСписокУслуг(ОбъектСсылка)
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОказываемыеМедицинскиеУслуги.Услуга КАК Услуга
	|ИЗ
	|	РегистрСведений.ОказываемыеМедицинскиеУслуги КАК ОказываемыеМедицинскиеУслуги
	|ГДЕ
	|	ОказываемыеМедицинскиеУслуги.Объект = &ОбъектСсылка
	|";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Услуга");
КонецФункции

Процедура ЗаполнитьПодключаемыеХарактеристики(ПараметрыОбновления = Неопределено) Экспорт
		
	РегистрыСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров.ОбновитьПодключаемыеХарактеристики(
		ПолучитьФункциональнуюОпцию("ИспользоватьВыгрузкуВФедеральныеМедрегистры"), ПараметрыОбновления);
	
КонецПроцедуры

Процедура СохранитьХарактеристикуОбъектаМедицинскогоРегистра(ОбъектСсылка, Классификатор, Характеристика) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = ОбъектСсылка;
	МенеджерЗаписи.Классификатор = Классификатор;
	МенеджерЗаписи.Характеристика = Характеристика;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура СоздатьЭлементыРеквизитовМедицинскихРегистров(Форма, ПодчиненныеКлассификаторыМедрегистров, ИмяГруппыРеквизитовМедицинскихРегистров, ТолькоПросмотр = Ложь)
		
	ЭлементГруппа = Форма.Элементы.Найти(ИмяГруппыРеквизитовМедицинскихРегистров);
	Если ЭлементГруппа = Неопределено Тогда
		ЭлементГруппа = Форма.Элементы.Добавить(ИмяГруппыРеквизитовМедицинскихРегистров, Тип("ГруппаФормы"));
		ЭлементГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ЭлементГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	Если ПодчиненныеКлассификаторыМедрегистров.Количество()>0 Тогда
		ЭлементГруппа.Заголовок = "Дополнительные реквизиты медицинских регистров";
		ЭлементГруппа.ОтображатьЗаголовок = Истина;
	КонецЕсли;
	
	Для каждого ОписаниеРеквизитаКлассификатора Из ПодчиненныеКлассификаторыМедрегистров Цикл
		СоздатьЭлементРеквизитаМедицинскогоРегистраВФорме(Форма, ОписаниеРеквизитаКлассификатора, ЭлементГруппа, ТолькоПросмотр);
	КонецЦикла; 
	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеРеквизитыМедицинскихРегистров(Форма, ОписаниеДополнительныхРеквизитов, ИмяРеквизитаВладельца = "Ссылка")
	//ДополнительныеРеквизитыМедицинскихРегистров = Новый СписокЗначений();
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ОписаниеДополнительныхРеквизитов", ОписаниеДополнительныхРеквизитов);
	Запрос.УстановитьПараметр("Ссылка",  ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма,"Объект."+ИмяРеквизитаВладельца));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОписаниеДополнительныхРеквизитов.ИмяРеквизита КАК ИмяРеквизита,
	|	ОписаниеДополнительныхРеквизитов.Ссылка КАК Классификатор,
	|	&Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТОписаниеДополнительныхРеквизитов
	|ИЗ
	|	&ОписаниеДополнительныхРеквизитов КАК ОписаниеДополнительныхРеквизитов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОписаниеДополнительныхРеквизитов.ИмяРеквизита КАК ИмяРеквизита,
	|	ОписаниеДополнительныхРеквизитов.Классификатор КАК Классификатор,
	|	ЕСТЬNULL(ХарактеристикиОбъектовДляФедеральныхМедрегистров.Характеристика, ЗНАЧЕНИЕ(Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров.ПустаяСсылка)) КАК Значение
	|ИЗ
	|	ВТОписаниеДополнительныхРеквизитов КАК ОписаниеДополнительныхРеквизитов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров КАК ХарактеристикиОбъектовДляФедеральныхМедрегистров
	|		ПО (ХарактеристикиОбъектовДляФедеральныхМедрегистров.Классификатор = ОписаниеДополнительныхРеквизитов.Классификатор)
	|			И (ХарактеристикиОбъектовДляФедеральныхМедрегистров.Объект = ОписаниеДополнительныхРеквизитов.Ссылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Значение) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(
				Форма,
				Выборка.ИмяРеквизита,
				Выборка.Значение);
			КонецЕсли;
	КонецЦикла;
	
	МассивОписанийДополнительныхРеквизитов = ОбщегоНазначения.ТаблицаЗначенийВМассив(ОписаниеДополнительныхРеквизитов);
	Если ЗначениеЗаполнено(Форма.ДополнительныеРеквизитыМедицинскихРегистров) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивОписанийДополнительныхРеквизитов, Форма.ДополнительныеРеквизитыМедицинскихРегистров);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(
	Форма,
	"ДополнительныеРеквизитыМедицинскихРегистров",
	Новый ФиксированныйМассив(МассивОписанийДополнительныхРеквизитов));
	
КонецПроцедуры

Функция ПолучитьПодчиненныеКлассификаторы(ВладелецСсылка, ЗаданныеКласссификаторы = Неопределено)
	ИмяМД = ВладелецСсылка.Метаданные().имя;
	КлассификаторыФРМР = Справочники.КлассификаторыФедеральныхМедрегистров.ПолучитьСправочникиФРМРИзМакета();
	ПодчиненныеКлассификаторы = КлассификаторыФРМР.СкопироватьКолонки("КодКлассификатора,НаименованиеКлассификатора,Ссылка");
	ПодчиненныеКлассификаторы.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
	Для Каждого КлассификаторФРМР из КлассификаторыФРМР Цикл
		Если НЕ ЗначениеЗаполнено(КлассификаторФРМР.Ссылка) Тогда
			Продолжить;
		ИначеЕсли СтрНайти(КлассификаторФРМР.ТипОбъектаМетаданных,ИмяМД) = 0 Тогда
			Продолжить;
		ИначеЕсли НЕ (ЗаданныеКласссификаторы = Неопределено)
			И ЗаданныеКласссификаторы.Найти(КлассификаторФРМР.КодКлассификатора) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ПодчиненныеКлассификаторы.Добавить(),КлассификаторФРМР);
	КонецЦикла;
	Возврат ПодчиненныеКлассификаторы;
КонецФункции

Функция ВызватьМетод(Организация, ТокенДоступа, ПараметрыВызова) Экспорт
	
	Настройки = ПолучитьНастройкиВзаимодействияСФедеральнымиМедрегистрами();
	ПараметрыСервиса = ПараметрыСервиса(Настройки);
	
	Заголовки = Новый Соответствие;
	Если Настройки.СпособПодключения = Перечисления.СпособыПодключенияКФедеральнымМедрегистрам.ИПС Тогда
    	Заголовки.Вставить("Authorization", "Bearer " + ТокенДоступа); 
    ИначеЕсли Настройки.СпособПодключения = Перечисления.СпособыПодключенияКФедеральнымМедрегистрам.РегионСервис1С Тогда 
		ИдентификаторРегистрационныхДанных1СМедицинаРегион = ИдентификаторРегистрационныхДанных1СМедицинаРегион();
		УстановитьПривилегированныйРежим(Истина);
		Если Организация <> Неопределено Тогда 
			КлючДоступа1СМедицинаРегион = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ИдентификаторКлючаДоступа1СМедицинаРегион(Организация), "КлючДоступа");
			Если Не ПустаяСтрока(КлючДоступа1СМедицинаРегион) Тогда 
	    		Заголовки.Вставить("X-API-Key", КлючДоступа1СМедицинаРегион);
	   	 	КонецЕсли;
   	 	КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
   	Иначе 
		ИдентификаторРегистрационныхДанных1СМедицинаРегион = ИдентификаторРегистрационныхДанных1СМедицинаРегион();
		УстановитьПривилегированныйРежим(Истина);
		Логин1СМедицинаРегион = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ИдентификаторРегистрационныхДанных1СМедицинаРегион, "Логин");
		Если Не ПустаяСтрока(Логин1СМедицинаРегион) Тогда 
			ПараметрыСервиса.Логин = Логин1СМедицинаРегион;
			ПараметрыСервиса.Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ИдентификаторРегистрационныхДанных1СМедицинаРегион);
		КонецЕсли;
		Если Организация <> Неопределено Тогда 
			КлючДоступа1СМедицинаРегион = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ИдентификаторКлючаДоступа1СМедицинаРегион(Организация), "КлючДоступа");
			Если Не ПустаяСтрока(КлючДоступа1СМедицинаРегион) Тогда 
	    		Заголовки.Вставить("X-API-Key", КлючДоступа1СМедицинаРегион);
	   	 	КонецЕсли;
   	 	КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
    КонецЕсли;
    Заголовки.Вставить("Content-Type", "application/json");
	
    АдресРесурса = ПараметрыСервиса.ТочкаДоступа + "/" + ПараметрыВызова.Команда;
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	Если ПараметрыВызова.Тело<>Неопределено Тогда 
		HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыВызова.Тело);
    КонецЕсли;
	
	ИнтернетПрокси = Неопределено;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
		МодульПолучениеФайловИзИнтернета = ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");
		ИнтернетПрокси = МодульПолучениеФайловИзИнтернета.ПолучитьПрокси(?(ПараметрыСервиса.ИспользоватьЗащищенноеСоединение, "https", "http"));
	КонецЕсли;
	
	Если ПараметрыСервиса.ИспользоватьЗащищенноеСоединение Тогда 
    	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
		HTTPСоединение = Новый HTTPСоединение(ПараметрыСервиса.Адрес,ПараметрыСервиса.Порт,ПараметрыСервиса.Логин,ПараметрыСервиса.Пароль,ИнтернетПрокси,,ЗащищенноеСоединение);
	Иначе 
		HTTPСоединение = Новый HTTPСоединение(ПараметрыСервиса.Адрес,ПараметрыСервиса.Порт,ПараметрыСервиса.Логин,ПараметрыСервиса.Пароль,ИнтернетПрокси);
    КонецЕсли;
	
	HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(ПараметрыВызова.Метод, HTTPЗапрос);
	ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	Контент = Неопределено;
	СообщениеОбОшибкеПользователю = Неопределено;
	Смещение = Неопределено;
	Ограничение = Неопределено;
	Количество = Неопределено;
	Если HTTPОтвет.КодСостояния < 400 Тогда 
		ДанныеОтвета = JSONВДанные(ТекстОтвета);
		ДанныеОтвета.Свойство("errorUserMessage", СообщениеОбОшибкеПользователю);
		ДанныеОтвета.Свойство("content", Контент);
		ДанныеОтвета.Свойство("offset", Смещение);
		ДанныеОтвета.Свойство("limit", Ограничение);
		ДанныеОтвета.Свойство("total", Количество);
		Если ЗначениеЗаполнено(СообщениеОбОшибкеПользователю) Тогда 
			СообщениеОбОшибкеПользователю = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1", СообщениеОбОшибкеПользователю);
		КонецЕсли;
	Иначе 
		Попытка
			ДанныеОтвета = JSONВДанные(ТекстОтвета);
			ХарактерОшибки = Неопределено;
			СообщениеОбОшибкеСервиса = Неопределено;
			Если Не ДанныеОтвета.Свойство("reasonPhrase", ХарактерОшибки) Тогда 
				ДанныеОтвета.Свойство("error", ХарактерОшибки);
			КонецЕсли;
			Если Не ДанныеОтвета.Свойство("message", СообщениеОбОшибкеСервиса) Тогда
				ДанныеОтвета.Свойство("path", СообщениеОбОшибкеСервиса);
			КонецЕсли;
		Исключение
			ХарактерОшибки = НСтр("ru = 'Ошибка при выполнении запроса'");
			СообщениеОбОшибкеСервиса = ТекстОтвета;
		КонецПопытки;
		ШаблонСообщения = "(%1) %2: %3";
		СообщениеОбОшибкеПользователю = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, HTTPОтвет.КодСостояния, ХарактерОшибки, СообщениеОбОшибкеСервиса);
	КонецЕсли;	
	
	Возврат Новый Структура("ТекстОтвета,КодСостояния,Контент,СообщениеОбОшибкеПользователю,Смещение,Ограничение,Количество,ТекстДляТехподдержки", 
			ТекстОтвета, HTTPОтвет.КодСостояния, Контент, СообщениеОбОшибкеПользователю, Смещение, Ограничение, Количество, 
			ТекстДляТехподдержки(ПараметрыСервиса, ПараметрыВызова, HTTPОтвет.КодСостояния, ТекстОтвета, ТокенДоступа));

КонецФункции

Функция ТекстДляТехподдержки(ПараметрыСервиса, ПараметрыВызова, КодСостояния, ТекстОтвета, ТокенДоступа = Неопределено)
	АдресРесурса = ПараметрыСервиса.Адрес + ПараметрыСервиса.ТочкаДоступа + "/";
	КомандаЗапроса = ПараметрыВызова.Команда;
	UrlЗапроса = ?(ПараметрыСервиса.ИспользоватьЗащищенноеСоединение, "https://", "http://") + АдресРесурса + КомандаЗапроса;
	ТекстДляТехподдержки = Символы.ПС + Символы.ПС +
			НСтр("ru = 'Запрос ('") +  ПараметрыВызова.Метод + "): " + UrlЗапроса + Символы.ПС + Символы.ПС + 
			НСтр("ru = 'Данные: '") +  ПараметрыВызова.Тело + Символы.ПС + Символы.ПС + 
			?(ТокенДоступа = Неопределено, "", НСтр("ru = 'Токен: '") + Символы.ПС + ТокенДоступа + Символы.ПС + Символы.ПС) +
			НСтр("ru = 'Ответ ('") + КодСостояния + "): " + ТекстОтвета;
	Возврат ТекстДляТехподдержки;
КонецФункции

// Параметры вызова метода
// 
// Возвращаемое значение:
//  Структура - параметры, необходимые для вызова метода сервиса REST.
//  	Метод - Строка - метод выполнения запроса ("GET", "PUT", "POST" и т.п.).
//  	Команда - Строка - часть url запроса с именем метода и некоторыми параметрами.
//  	Тело - Строка - Тело запроса в формате json.
//  	РазделМедрегистра - Строка - Имя метода для Команды (см. выше).
//
Функция ПараметрыВызоваМетода() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Метод", Неопределено);
	Результат.Вставить("Команда", Неопределено);
	Результат.Вставить("Тело", Неопределено);
	Результат.Вставить("РазделМедрегистра", Неопределено);
	Возврат Результат;
КонецФункции

Функция КадровыеДанныеСотрудника(СотрудникСсылка) Экспорт
	
