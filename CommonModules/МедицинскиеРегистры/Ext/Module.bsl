// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнитьПодключаемыеХарактеристики");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс  

Функция ДоступнаВыгрузкаЗаработнойПлаты() Экспорт
	Настройки = ПолучитьНастройкиВзаимодействияСФедеральнымиМедрегистрами();
	Если Настройки.ИспользоватьПилотныйПроектПоЗП Тогда 
		Возврат ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.НачисленияУдержанияПоСотрудникам); 
	Иначе 
		Возврат Ложь; 
	КонецЕсли;
КонецФункции

Процедура СоздатьДополнительныеРеквизитыМедицинскихРегистров(Форма, ПодчиненныеКлассификаторыМедрегистров, Префикс="") Экспорт
	
	МассивРеквизитов = Новый Массив;
	Сч = 0;
	Для Каждого ПодчиненныйКлассификатор из ПодчиненныеКлассификаторыМедрегистров Цикл
		ПодчиненныйКлассификатор.ИмяРеквизита = Префикс+"ПодчиненныйКлассификаторМедрегистра" + Формат(Сч,"ЧН=; ЧГ=");
		РеквизитПодчиненногоКлассификатора = Новый РеквизитФормы(ПодчиненныйКлассификатор.ИмяРеквизита, Новый ОписаниеТипов("СправочникСсылка.ЭлементыКлассификаторовФедеральныхМедрегистров"),,ПодчиненныйКлассификатор.НаименованиеКлассификатора+?(ЗначениеЗаполнено(Префикс)," ("+Префикс+")",""));
		МассивРеквизитов.Добавить(РеквизитПодчиненногоКлассификатора);
		Сч = Сч + 1;
	КонецЦикла;

	МассивРеквизитов.Добавить(Новый РеквизитФормы("ДополнительныеРеквизитыМедицинскихРегистров", Новый ОписаниеТипов()));

	МассивИменРеквизитовФормы = Новый Массив;
	ЗарплатаКадры.ЗаполнитьМассивИменРеквизитовФормы(Форма, МассивИменРеквизитовФормы);
	ЗарплатаКадры.ИзменитьРеквизитыФормы(Форма, МассивРеквизитов, МассивИменРеквизитовФормы);
	
КонецПроцедуры

Процедура ПриСозданииНаСервере(Форма, ИмяГруппыРеквизитовМедицинскихРегистров = "РеквизитыМедицинскихРегистров") Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВыгрузкуВФедеральныеМедрегистры") Тогда
		Возврат;
	КонецЕсли;
	ПодчиненныеКлассификаторыМедрегистров = ПолучитьПодчиненныеКлассификаторы(ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма,"Объект.Ссылка"));
	Если ПодчиненныеКлассификаторыМедрегистров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СоздатьДополнительныеРеквизитыМедицинскихРегистров(Форма, ПодчиненныеКлассификаторыМедрегистров);
	ЗаполнитьДополнительныеРеквизитыМедицинскихРегистров(Форма, ПодчиненныеКлассификаторыМедрегистров);
	СоздатьЭлементыРеквизитовМедицинскихРегистров(Форма, ПодчиненныеКлассификаторыМедрегистров, ИмяГруппыРеквизитовМедицинскихРегистров);
	
КонецПроцедуры

Процедура ДобавитьПодчиненныеХарактеристики(Форма, ИмяРеквизитаВладельца, ЗаданныеКласссификаторы, ИмяГруппыРеквизитовМедицинскихРегистров = "РеквизитыМедицинскихРегистров") Экспорт
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВыгрузкуВФедеральныеМедрегистры") Тогда
		Возврат;
	КонецЕсли;
	ПодчиненныеКлассификаторыМедрегистров = ПолучитьПодчиненныеКлассификаторы(ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма,"Объект."+ИмяРеквизитаВладельца), ЗаданныеКласссификаторы);
	Если ПодчиненныеКлассификаторыМедрегистров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СоздатьДополнительныеРеквизитыМедицинскихРегистров(Форма, ПодчиненныеКлассификаторыМедрегистров, ИмяРеквизитаВладельца);
	ЗаполнитьДополнительныеРеквизитыМедицинскихРегистров(Форма, ПодчиненныеКлассификаторыМедрегистров, ИмяРеквизитаВладельца);
	СоздатьЭлементыРеквизитовМедицинскихРегистров(Форма, ПодчиненныеКлассификаторыМедрегистров, ИмяГруппыРеквизитовМедицинскихРегистров, Истина);
	
КонецПроцедуры

Процедура ДополнитьФормуУслугами(Форма, ВладелецУслуг, ИмяГруппыРеквизитовМедицинскихРегистров = "РеквизитыМедицинскихРегистров", ЗаголовокДерева = "") Экспорт
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВыгрузкуВФедеральныеМедрегистры") Тогда
		Возврат;
	КонецЕсли;
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("СписокУслугФРМО",
							Новый ОписаниеТипов("ДеревоЗначений"),,
							СокрЛП(НСтр("ru = 'Услуги'")+?(ЗначениеЗаполнено(ЗаголовокДерева)," ("+ЗаголовокДерева+")",""))));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("Услуга",
							Новый ОписаниеТипов("СправочникСсылка.ЭлементыКлассификаторовФедеральныхМедрегистров"),
							"СписокУслугФРМО"));
	МассивИменРеквизитовФормы = Новый Массив;
	ЗарплатаКадры.ЗаполнитьМассивИменРеквизитовФормы(Форма, МассивИменРеквизитовФормы);
	ЗарплатаКадры.ИзменитьРеквизитыФормы(Форма, ДобавляемыеРеквизиты, МассивИменРеквизитовФормы);

	СоздатьЭлементСписокУслугВФорме(Форма,"СписокУслугФРМО",Форма.Элементы.Найти(ИмяГруппыРеквизитовМедицинскихРегистров),ЗначениеЗаполнено(ЗаголовокДерева));
	
	ОбновитьДеревоУслуг(Форма, ВладелецУслуг);
	
КонецПроцедуры

Процедура ОбновитьДеревоУслуг(Форма, ВладелецУслуг) Экспорт
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВыгрузкуВФедеральныеМедрегистры") Тогда
		Возврат;
	КонецЕсли;

	СписокУслуг = ПолучитьСписокУслуг(ВладелецУслуг);
	Если СписокУслуг.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	ДеревоУслуг = ДеревоУслугПоСписку(СписокУслуг);

	ЗначениеВДанныеФормы(ДеревоУслуг,Форма.СписокУслугФРМО);

	МассивИменРеквизитовФормы = Новый Массив;
	ЗарплатаКадры.ЗаполнитьМассивИменРеквизитовФормы(Форма, МассивИменРеквизитовФормы);
	Если МассивИменРеквизитовФормы.Найти("ДополнительныеРеквизитыМедицинскихРегистров") <> Неопределено Тогда
		Для Каждого ОписаниеРеквизита Из Форма.ДополнительныеРеквизитыМедицинскихРегистров Цикл
			Если ОписаниеРеквизита.КодКлассификатора = "1.2.643.5.1.13.13.99.2.319" Тогда
				ЭлементУправления = Форма.Элементы[ОписаниеРеквизита.ИмяРеквизита];
				ЭлементУправления.СписокВыбора.ЗагрузитьЗначения(СписокУслуг);
				ЭлементУправления.ИсторияВыбораПриВВоде = ИсторияВыбораПриВводе.НеИспользовать;
				//Форма.Элементы[ОписаниеРеквизита.ИмяРеквизита].СписокВыбора.РежимВыбораИзСписка = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#Область СправочникДолжности

Процедура ОбновитьСвязанныеХарактеристики(Форма, Должность, ИмяХарактеристики) Экспорт
	Характеристика = Форма[ИмяХарактеристики];
	id_181 = Характеристика.ОписаниеЭлемента.Найти("id_181","Поле");
	Если ЗначениеЗаполнено(id_181) Тогда
		Для Каждого ДополнительнаяХарактеристика из Форма.ДополнительныеРеквизитыМедицинскихРегистров Цикл
			Если ДополнительнаяХарактеристика.КодКлассификатора = "1.2.643.5.1.13.13.99.2.181" Тогда
				Характеристика_181 = Справочники.ЭлементыКлассификаторовФедеральныхМедрегистров.НайтиПоКоду(id_181.Значение,Ложь, ,ДополнительнаяХарактеристика.Ссылка);
				Если ЗначениеЗаполнено(Характеристика_181) Тогда
					Форма[ДополнительнаяХарактеристика.ИмяРеквизита] = Характеристика_181;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ЗапросОпределитьПолныеНаименованияУчебныхЗаведений(ПараметрыОбновления = Неопределено) Экспорт

	Запрос = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	РегистрыСведений.ХарактеристикиОбъектовДляФедеральныхМедрегистров.СоздатьВТХарактеристикиОбъектовДляФедеральныхМедрегистров(МенеджерВременныхТаблиц);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("КлассификаторУчебноеЗаведение", "1.2.643.5.1.13.13.11.1519");
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	УчебныеЗаведения.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ХарактеристикиУчебноеЗаведениеПоМедРегистру.Характеристика, ЗНАЧЕНИЕ(Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.ЭлементыКлассификаторовФедеральныхМедрегистров.ПустаяСсылка)
	|			ТОГДА ХарактеристикиУчебноеЗаведениеПоМедРегистру.ХарактеристикаНаименование
	|		ИНАЧЕ УчебныеЗаведения.Наименование
	|	КОНЕЦ КАК ПолноеНаименование
	|ИЗ
	|	Справочник.УчебныеЗаведения КАК УчебныеЗаведения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТХарактеристикиОбъектовДляФедеральныхМедрегистров КАК ХарактеристикиУчебноеЗаведениеПоМедРегистру
	|		ПО (ХарактеристикиУчебноеЗаведениеПоМедРегистру.ИдентификаторКлассификатора = &КлассификаторУчебноеЗаведение)
	|			И УчебныеЗаведения.Ссылка = ХарактеристикиУчебноеЗаведениеПоМедРегистру.Объект
	|ГДЕ
	|	УчебныеЗаведения.ПолноеНаименование = """"";
	
	Если ПараметрыОбновления = Неопределено Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000", ""); 
	КонецЕсли;

	Возврат Запрос;
		
КонецФункции

#КонецОбласти

Процедура ПослеЗаписиНаСервере(Форма) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВыгрузкуВФедеральныеМедрегистры") Тогда
		Возврат;
	КонецЕсли;
	МассивИменРеквизитовФормы = Новый Массив;
	ЗарплатаКадры.ЗаполнитьМассивИменРеквизитовФормы(Форма, МассивИменРеквизитовФормы);
	Если МассивИменРеквизитовФормы.Найти("ДополнительныеРеквизитыМедицинскихРегистров") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбъектСсылка = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма,"Объект.Ссылка");
	ДополнительныеРеквизитыМедицинскихРегистров = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(
		Форма, "ДополнительныеРеквизитыМедицинскихРегистров");
	Для каждого ДополнительныйРеквизитМедицинскихРегистров Из ДополнительныеРеквизитыМедицинскихРегистров Цикл
		ЗначениеРекизита = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, ДополнительныйРеквизитМедицинскихРегистров.ИмяРеквизита);
		СохранитьХарактеристикуОбъектаМедицинскогоРегистра(ОбъектСсылка, ДополнительныйРеквизитМедицинскихРегистров.Ссылка, ЗначениеРекизита);
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЭлементСписокУслугВФорме(Форма,ИмяРеквизита,ЭлементГруппа,ОтображатьЗаголовок=Ложь)
	Если Форма.Элементы.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭлементДерево = Форма.Элементы.Вставить(ИмяРеквизита, Тип("ТаблицаФормы"), ЭлементГруппа);
	ЭлементДерево.ПутьКДанным = ИмяРеквизита;
	ЭлементДерево.Отображение = ОтображениеТаблицы.Дерево;
	ЭлементДерево.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	ЭлементДерево.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	ЭлементДерево.ТолькоПросмотр = Истина;
	Если ОтображатьЗаголовок Тогда
		ЭлементДерево.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	КонецЕсли;
	
	Элемент = Форма.Элементы.Добавить(ИмяРеквизита+"Услуга", Тип("ПолеФормы"), ЭлементДерево);
	Элемент.ПутьКДанным = ИмяРеквизита +".Услуга";
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	
КонецПроцедуры

Процедура СоздатьЭлементРеквизитаМедицинскогоРегистраВФорме(Форма, ОписаниеРеквизита, ЭлементГруппа, ТолькоПросмотр = Ложь) Экспорт

	Если Форма.Элементы.Найти(ОписаниеРеквизита.ИмяРеквизита) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = Форма.Элементы.Вставить(ОписаниеРеквизита.ИмяРеквизита, Тип("ПолеФормы"), ЭлементГруппа);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = ОписаниеРеквизита.ИмяРеквизита;
	
	Если ТолькоПросмотр Тогда
		Элемент.ТолькоПросмотр = ТолькоПросмотр;
	Иначе
		Элемент.УстановитьДействие("ПриИзменении", "Подключаемый_РеквизитыМедицинскогоРегистраЭлементПриИзменении");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеРеквизита.Ссылка) Тогда
		НовыйПараметрВыбора = Новый ПараметрВыбора("Отбор.Владелец", ОписаниеРеквизита.Ссылка);
		Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовыйПараметрВыбора));
	КонецЕсли;
		
		
КонецПроцедуры

#Область ПоставляемыеДанные

// Вызывается при получении уведомления о новых данных.
// В теле следует проверить, необходимы ли эти данные приложению, 
// и если да - установить флажок Загружать.
// 
// Параметры:
//   Дескриптор   - ОбъектXDTO -  Дескриптор.
//   Загружать    - булево - возвращаемое.
//
Процедура ДоступныНовыеДанные(Знач Дескриптор, Загружать) Экспорт
	
	Если Дескриптор.DataType = "КлассификаторыМедРегистра" Тогда
		Загружать = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Вызывается после вызова ДоступныНовыеДанные, позволяет разобрать данные.
//
// Параметры:
//   Дескриптор   - ОбъектXDTO - Дескриптор.
//   ПутьКФайлу   - строка - Полное имя извлеченного файла. Файл будет автоматически удален 
//                  после завершения процедуры.
//
Процедура ОбработатьНовыеДанные(Знач Дескриптор, Знач ПутьКФайлу) Экспорт
	
	Если Не Дескриптор.DataType = "КлассификаторыМедРегистра" Тогда
		Возврат;
	КонецЕсли;
		
	РазархивированныеДанные = РазархивироватьКлассификаторыМедРегистра(Дескриптор, ПутьКФайлу);
	ИменаКлассификаторов = РазархивированныеДанные.Выборка;
	
	Пока ИменаКлассификаторов.Следующий() Цикл
		ЗагрузитьКлассификаторМедРегистраПоИмени(ИменаКлассификаторов.Код, РазархивированныеДанные.Каталог);
	КонецЦикла;
		
КонецПроцедуры

// Вызывается при отмене обработки данных в случае сбоя.
//
// Параметры:
//   Дескриптор   - ОбъектXDTO - Дескриптор.
