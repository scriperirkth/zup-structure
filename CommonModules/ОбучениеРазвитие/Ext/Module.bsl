КонецПроцедуры

Процедура ДополнитьНадпись(ТекстНадписи, Дополнение, Разделитель = ", ")
	
	Если Не ПустаяСтрока(ТекстНадписи) Тогда
		ТекстНадписи = ТекстНадписи + Разделитель;
	КонецЕсли;
	
	ТекстНадписи = ТекстНадписи + Дополнение;
	
КонецПроцедуры

#Область РезультатыОбучения

Функция НовыйПланМероприятий() Экспорт 
	
	ПланМероприятий = Новый ТаблицаЗначений();
	ПланМероприятий.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ПланМероприятий.Колонки.Добавить("Мероприятие", Новый ОписаниеТипов("СправочникСсылка.МероприятияОбученияРазвития"));
	ПланМероприятий.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
	ПланМероприятий.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата")); 
	ПланМероприятий.Колонки.Добавить("ВыбранноеОбучение", Новый ОписаниеТипов("ДокументСсылка.ОбучениеРазвитиеСотрудников"));
	
	Возврат ПланМероприятий;
	
КонецФункции

Функция РезультатыОбучения(ПланМероприятий) Экспорт
	Возврат ЗапросРезультатыОбучения(ФильтрДляРезультатыОбучения(ПланМероприятий)).Выполнить().Выгрузить();
КонецФункции

Процедура СоздатьВТРезультатыОбучения(МенеджерВТ, ИмяВТ) Экспорт
	ЗарплатаКадры.СоздатьВТПоЗапросу(МенеджерВТ, 
		ЗапросРезультатыОбучения(ФильтрДляРезультатыОбучения(ИмяВТ, МенеджерВТ)), "ВТРезультатыОбучения");
КонецПроцедуры

Функция ЗапросРезультатыОбучения(Фильтр)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Фильтр.МенеджерВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПланМероприятий.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПланМероприятий.Мероприятие КАК Мероприятие,
		|	ПланМероприятий.ДатаНачала КАК ДатаНачалаПлан,
		|	ПланМероприятий.ДатаОкончания КАК ДатаОкончанияПлан,
		|	ПланМероприятий.ВыбранноеОбучение КАК ВыбранноеОбучение,
		|	ОбучениеСотрудников.Регистратор КАК ДокументОбучения,
		|	ОбучениеСотрудников.ДатаНачала КАК ДатаНачалаФакт,
		|	ОбучениеСотрудников.ДатаОкончания КАК ДатаОкончанияФакт,
		|	ОбучениеСотрудников.Оценка КАК Оценка,
		|	ОбучениеСотрудников.Балл КАК Балл,
		|	ОбучениеСотрудников.КомментарийКОценке КАК КомментарийКОценке,
		|	Свидетельство.Ссылка КАК Свидетельство,
		|	Свидетельство.ВидДокумента КАК ВидДокумента,
		|	Свидетельство.Серия КАК Серия,
		|	Свидетельство.Номер КАК Номер,
		|	Свидетельство.ДатаВыдачи КАК ДатаВыдачи
		|ИЗ
		|	РегистрСведений.ОбучениеСотрудников КАК ОбучениеСотрудников
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланМероприятий КАК ПланМероприятий
		|		ПО ОбучениеСотрудников.ФизическоеЛицо = ПланМероприятий.ФизическоеЛицо
		|			И (ПланМероприятий.ДатаНачала <= ОбучениеСотрудников.ДатаОкончания)
		|			И (ПланМероприятий.ДатаОкончания >= ОбучениеСотрудников.ДатаНачала)
		|			И (ПланМероприятий.Мероприятие = ОбучениеСотрудников.Мероприятие
		|				ИЛИ ПланМероприятий.ВыбранноеОбучение = ОбучениеСотрудников.Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОбразованиеФизическихЛицОснования КАК ЗаписиОбразования
		|		ПО (ЗаписиОбразования.Обучение = ОбучениеСотрудников.Регистратор)
		|			И (ЗаписиОбразования.ОбъектСсылка.Владелец = ОбучениеСотрудников.ФизическоеЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбразованиеФизическихЛиц КАК Свидетельство
		|		ПО (Свидетельство.Ссылка = ЗаписиОбразования.ОбъектСсылка)
		|			И (Свидетельство.Владелец = ОбучениеСотрудников.ФизическоеЛицо)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо,
		|	Мероприятие,
		|	ДатаНачалаПлан,
		|	ДатаОкончанияПлан,
		|	ДатаНачалаФакт";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТПланМероприятий", Фильтр.ИмяВТ);
	
	Возврат Запрос;
	
КонецФункции

Функция ФильтрДляРезультатыОбучения(Таблица = "ВТПланМероприятий", МенеджерВТ = Неопределено)
	
	Фильтр = Новый Структура();
	Фильтр.Вставить("МенеджерВТ");
	Фильтр.Вставить("ИмяВТ");
	
	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		ОбщегоНазначенияКлиентСервер.ПроверитьПараметр("ФильтрДляРезультатыОбучения", "Таблица", Таблица, Тип("Строка"));
		ОбщегоНазначенияКлиентСервер.ПроверитьПараметр("ФильтрДляРезультатыОбучения", "МенеджерВТ", МенеджерВТ, Тип("МенеджерВременныхТаблиц"));
		Фильтр.МенеджерВТ = МенеджерВТ;
		Фильтр.ИмяВТ = Таблица;
		Возврат Фильтр;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПланМероприятий", Таблица);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПланМероприятий.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ПланМероприятий.Мероприятие КАК Мероприятие,
		|	ПланМероприятий.ДатаНачала КАК ДатаНачала,
		|	ПланМероприятий.ДатаОкончания КАК ДатаОкончания,
		|	ПланМероприятий.ВыбранноеОбучение КАК ВыбранноеОбучение
		|ПОМЕСТИТЬ ВТПланМероприятий
		|ИЗ
		|	&ПланМероприятий КАК ПланМероприятий";
	Запрос.Выполнить();
	
	Фильтр.ИмяВТ = "ВТПланМероприятий";
	Фильтр.МенеджерВТ = МенеджерВТ;
	
	Возврат Фильтр;
	
КонецФункции

