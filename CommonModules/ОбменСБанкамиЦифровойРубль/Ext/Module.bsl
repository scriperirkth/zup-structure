Процедура ПрочитатьДанныеОперацияX2G(ДеталиОперации, НовСтрока, Сторона)
	
	Если НовСтрока.ВидОперацииЦР <> ОперацияB2G() Тогда
		ОписаниеПроблемы = СтрШаблон(
			НСтр("ru = 'Некорректные данные в операции с идентификатором %1. В теге <Tp> указан вид операции %2, вместо %3.
			| Т.к. присутствует и заполнен тег <X2G>'"),
				НовСтрока.НомерДокумента, НовСтрока.ВидОперацииЦР, ОперацияB2G());
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,,, ОписаниеПроблемы);
	КонецЕсли;
	
	НовСтрока[Сторона] = Новый Структура;
	
	// Данные участника операции - бюджетополучателя
	ИНН = ЗначениеСвойстваXDTO(ДеталиОперации.X2G, "CrrspINN");
	Если ИНН <> Неопределено Тогда
		НовСтрока[Сторона].Вставить("ИНН", ИНН);
	КонецЕсли;
	
	КПП = ЗначениеСвойстваXDTO(ДеталиОперации.X2G, "CrrspKPP");
	Если КПП <> Неопределено Тогда
		НовСтрока[Сторона].Вставить("КПП", КПП);
	КонецЕсли;
	
	НаименованиеПолучателя = ЗначениеСвойстваXDTO(ДеталиОперации.X2G, "CrrspNm.LineNm");
	Если НаименованиеПолучателя <> Неопределено Тогда
		НовСтрока[Сторона].Вставить("Наименование", НаименованиеПолучателя);
	КонецЕсли;
	
	ИдентификаторПлатежа = ЗначениеСвойстваXDTO(ДеталиОперации.X2G, "PmtID"); // PaymentID
	Если ИдентификаторПлатежа <> Неопределено Тогда
		НовСтрока.УникальныйИдентификаторПлатежа = ИдентификаторПлатежа;
	КонецЕсли;
	
	ДанныеКоррСчета = ЗначениеСвойстваXDTO(ДеталиОперации.X2G, "CrrspAcc"); // CorrespAcc
	Если ДанныеКоррСчета <> Неопределено Тогда
		НовСтрока[Сторона].Вставить("РасчСчет", ЗначениеСвойстваXDTO(ДанныеКоррСчета, "Id", ""));
	КонецЕсли;
	
	НовСтрока[Сторона].Вставить("Банк", Новый Структура);
	
	ДанныеСчета = ЗначениеСвойстваXDTO(ДеталиОперации.X2G, "CtrPty"); // Counterparty
	Если ДанныеСчета <> Неопределено Тогда
		НовСтрока[Сторона].Вставить("ИдентификаторЦифровогоСчета",
			ЗначениеСвойстваXDTO(ДанныеСчета, "Id", ""));
		НовСтрока[Сторона].Банк.Вставить("БИК", БИКПлатформыЦифровогоРубля());
		НовСтрока[Сторона].Банк.Вставить("Наименование", НаименованиеПлатформыЦифровогоРубля());
		ДанныеКазначейскогоСчета = ЗначениеСвойстваXDTO(ДанныеСчета, "DCAcctNb");
		Если ДанныеКазначейскогоСчета <> Неопределено Тогда
			КоррСчет = ЗначениеСвойстваXDTO(ДанныеКазначейскогоСчета, "Id", ""); // Единый казначейский счет
			Если ЗначениеЗаполнено(КоррСчет) Тогда
				НовСтрока[Сторона].Вставить("РасчСчет", КоррСчет);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НазначениеПлатежа = ЗначениеСвойстваXDTO(ДеталиОперации.X2G, "Purp");
	Если НазначениеПлатежа <> Неопределено Тогда
		НовСтрока.НазначениеПлатежа = НазначениеПлатежа;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьДанныеОперацияOPTrf(ДеталиОперации, НовСтрока)
	
	// Операция "Перевод оператором".
	// Для данной операции пока заполняем только Назначение платежа.
	
	НазначениеПлатежа = ЗначениеСвойстваXDTO(ДеталиОперации.OPTrf, "Purp");
	Если НазначениеПлатежа <> Неопределено Тогда
		НовСтрока.НазначениеПлатежа = НазначениеПлатежа;
	КонецЕсли;
	
КонецПроцедуры

Процедура РазборВыпискиВызыватьИсключение()
	
	ШаблонСообщения = НСтр("ru = 'При разборе выписки по счету Цифрового рубля (ЦР) возникла ошибка:
		|%1.
		|Возможно файл не является выпиской по счету ЦР.'");
	КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	ТекстОшибки = СтрШаблон(ШаблонСообщения, КраткоеПредставлениеОшибки);
	Если Пользователи.ЭтоПолноправныйПользователь(, , Ложь) Тогда
		ТекстСообщения = ТекстОшибки;
	Иначе
		ТекстСообщения = НСтр("ru = 'Файл выписки Цифровому рублю (ЦР), полученный из банка, невозможно прочитать.
			|Файл содержит ошибку или не является выпиской по счету ЦР.'");
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстОшибки);
	
	ВызватьИсключение ТекстСообщения;
	
КонецПроцедуры

#КонецОбласти

Функция ТаблицаВыписокБанкаВДерево(ТаблицаВыписок)
	
	МассивСчетов = Новый Массив;
	ДеревоДанных = ДеревоЭлектронногоДокументаБЭД.ДеревоЭлектронногоДокумента("ОбменСБанками.ВыпискаБанка");
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаВыписок, "Выписки");
	
	Возврат ДеревоДанных;
	
КонецФункции

