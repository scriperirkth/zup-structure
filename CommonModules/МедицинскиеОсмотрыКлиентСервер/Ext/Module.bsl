#Область СлужебныеПроцедурыИФункции

Функция ОписаниеПериодичностиОсмотров() Экспорт
	
	Описание = Новый Структура(
		"Однократно,
		|Кратность,
		|Периодичность,
		|ЕдиницаПериодичности,
		|Представление");
	
	Описание.Однократно = Ложь;
	Описание.Кратность = 0;
	Описание.Периодичность = 0;
	Описание.ЕдиницаПериодичности = 0;
	Описание.Представление = "";
	
	Возврат Описание;
	
КонецФункции

Процедура ЗаполнитьОписаниеПериодичностиПоВредномуФакторуВидуРабот(Описание, Объект) Экспорт
	
	Описание.Однократно = Объект.Однократно;
	Описание.Кратность = Объект.КратностьОсмотра;
	Описание.Периодичность = Объект.ПериодичностьОсмотра;
	Описание.ЕдиницаПериодичности = Объект.ЕдиницаПериодичностиОсмотра;
	Описание.Представление = Объект.ПредставлениеПериодичностиОсмотра;
	
КонецПроцедуры

#Область ПредставлениеФакторов

Процедура ЗаполнитьПредставлениеВредногоФактораВидаРабот(Данные, Представление) Экспорт
	
	Представление = Данные.Код + "." + Символы.НПП + Данные.Наименование;
	
КонецПроцедуры

