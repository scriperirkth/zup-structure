Функция СтруктураМанифеста(ЭлектронныйКурс, ДанныеКурса, ВыгруженныеЭлементы, ОписаниеТипаВсеСсылки) Экспорт
	
	СтруктураМанифеста = Новый Структура("UUID, Title, PackageDate, Hash, CourseModifiedDate, Elements, Files, ElementsFolders");
	СтруктураМанифеста.UUID = Строка(ЭлектронныйКурс.УникальныйИдентификатор());
	СтруктураМанифеста.Title = ДанныеКурса.Наименование;
	СтруктураМанифеста.PackageDate = РазработкаЭлектронныхКурсовСлужебный.ЗначениеРеквизитаЭлементаКурсаВСтруктуру(ТекущаяДатаСеанса(), ОписаниеТипаВсеСсылки);
	СтруктураМанифеста.CourseModifiedDate = РазработкаЭлектронныхКурсовСлужебный.ЗначениеРеквизитаЭлементаКурсаВСтруктуру(ДанныеКурса.ДатаИзменения, ОписаниеТипаВсеСсылки);
			
	СтруктураМанифеста.Elements = Новый Массив;
	СтруктураМанифеста.Files = Новый Массив;
	СтруктураМанифеста.ElementsFolders = Новый Массив;
			
	Хеш = Новый ХешированиеДанных(ХешФункция.CRC32);
	
	Для Каждого ВыгруженныйЭлемент Из ВыгруженныеЭлементы Цикл
		СтруктураМанифеста.Elements.Добавить(
			Новый Структура("Element", ВыгруженныйЭлемент.ОтносительныйПутьКФайлуЭлемента)
		);
		Хеш.ДобавитьФайл(ВыгруженныйЭлемент.ПутьКФайлуЭлемента);
		
		Если ВыгруженныйЭлемент.ЭтоФайл Тогда
			СтруктураМанифеста.Files.Добавить(
			Новый Структура("File, Element", ВыгруженныйЭлемент.ОтносительныйПутьКФайлу, ВыгруженныйЭлемент.ОтносительныйПутьКФайлуЭлемента)
			);
			Хеш.ДобавитьФайл(ВыгруженныйЭлемент.ПутьКФайлу);
		КонецЕсли;
		
		Если ВыгруженныйЭлемент.ЭтоГруппаДляХраненияЭлементов Тогда
			СтруктураМанифеста.ElementsFolders.Добавить(
				Новый Структура("Element", ВыгруженныйЭлемент.ОтносительныйПутьКФайлуЭлемента)
			);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураМанифеста.Hash = Хеш.ХешСумма;
	
	Возврат СтруктураМанифеста;
	
КонецФункции

