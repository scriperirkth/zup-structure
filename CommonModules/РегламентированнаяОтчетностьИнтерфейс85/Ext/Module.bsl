#Область СлужебныйПрограммныйИнтерфейс

// Устанавливает тип отображения "Простой" у именованных ячеек табличного документа,
// препятствуя отрисовке прямоугольника со скругленными краями вокруг поля ввода.
//
// Параметры:
//   ТабличныйДокумент - ТабличныйДокумент
//
Процедура УстановитьТипОтображенияРедактируемойЯчейкиТабличногоДокумента(ТабличныйДокумент) Экспорт
	
	Для Каждого ОбластьТабличногоДокумента Из ТабличныйДокумент.Области Цикл
		ОбластьТабличногоДокумента.ТипОтображенияРедактируемойЯчейки =
			ТипОтображенияРедактируемойЯчейкиТабличногоДокумента.Обычный;
	КонецЦикла;                                                         
		
	ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(1, 1);
	
КонецПроцедуры

// Отображает указанную группу формы как командную панель.
//
// Параметры:
//   ЭлементФормы - ГруппаФормы
//
Процедура УстановитьСпособОтображенияКоманднойПанелиФормы(ЭлементФормы) Экспорт
	
	ЭлементФормы.СпособОтображения = СпособОтображенияКоманднойПанелиФормы.КоманднаяПанель;
	
КонецПроцедуры

// Отображает указанную команду в нижней части формы, предназначенной для команд завершения работы с этой формой.
//
// Параметры:
//  КомандаФормы - КомандаФормы
//
Процедура УстановитьНазначениеДействияКоманды(КомандаФормы) Экспорт
	
	КомандаФормы.НазначениеДействия = НазначениеДействияКомандыФормы.Завершение;
	
КонецПроцедуры

Функция МасштабКлиентскогоПриложения() Экспорт

	НастройкиКлиентскогоПриложения = Новый НастройкиКлиентскогоПриложения;
	ВарМасштабаКлиентскогоПриложения = НастройкиКлиентскогоПриложения.ВариантМасштабаКлиентскогоПриложения;
	
	// "Авто" - В веб-клиенте масштаб отображения определяется автоматически в зависимости от размера монитора.
	Результат = "Авто";
	
	Если ВарМасштабаКлиентскогоПриложения = ВариантМасштабаКлиентскогоПриложения.Обычный Тогда
		Результат = "Обычный";
	ИначеЕсли ВарМасштабаКлиентскогоПриложения = ВариантМасштабаКлиентскогоПриложения.Компактный Тогда	
	    Результат = "Компактный";
	КонецЕсли;
	
	Если Результат = "Авто" Тогда
		
		ИмяКлиентскогоПриложения = ПолучитьТекущийСеансИнформационнойБазы().ИмяПриложения;
		ЭтоВебКлиент = (ИмяКлиентскогоПриложения = "WebClient");
		
		Если ЭтоВебКлиент Тогда
			
			ИнформацияЭкрановКлиента = ПолучитьИнформациюЭкрановКлиента();
			Если ИнформацияЭкрановКлиента <> Неопределено Тогда
			
				ОсновнойЭкран = ИнформацияЭкрановКлиента[0];
				Высота = ОсновнойЭкран.Высота;
				
				Если Высота >= 1024 Тогда
					Результат = "Обычный";
				Иначе
				    Результат = "Компактный";
				КонецЕсли;
				
			Иначе
			    // Фоновое задание.
				Результат = "Обычный";
			КонецЕсли;
			
		Иначе
			Результат = "Обычный";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Устанавливает вид флажка в таблице в значение "Флажок" (квадратный чекбокс).
//
// Параметры:
//   КолонкаТаблицы - ПолеФормы
//
Процедура УстановитьВидФлажкаВТаблице(КолонкаТаблицы) Экспорт
	
	КолонкаТаблицы.ВидФлажка = ВидФлажка.Флажок;
	
КонецПроцедуры

// Отображает команды формы регламентированного отчета в нижней части формы,
// предназначенной для команд завершения работы с этой формой.
//
// Параметры:
//  КомандыФормы - КомандыФормы
//
Процедура УстановитьНазначениеДействияКомандФормыРеглОтчета(КомандыФормы) Экспорт
	
	Если НЕ КомандыФормы.Найти("СохранитьОтчет") = Неопределено Тогда
		
		УстановитьНазначениеДействияКоманды(КомандыФормы.СохранитьОтчет);
		
	КонецЕсли;
	
	Если НЕ КомандыФормы.Найти("Сохранить") = Неопределено Тогда
		
		УстановитьНазначениеДействияКоманды(КомандыФормы.Сохранить);
		
	КонецЕсли;
	
	Если НЕ КомандыФормы.Найти("Выгрузить") = Неопределено Тогда
		
		УстановитьНазначениеДействияКоманды(КомандыФормы.Выгрузить);
		
	КонецЕсли;
	
	Если НЕ КомандыФормы.Найти("ОтправитьВКонтролирующийОрган") = Неопределено Тогда
		
		УстановитьНазначениеДействияКоманды(КомандыФормы.ОтправитьВКонтролирующийОрган);
		
	КонецЕсли;
	
	Если НЕ КомандыФормы.Найти("ОтправитьЧерезПредставителя") = Неопределено Тогда
		
		УстановитьНазначениеДействияКоманды(КомандыФормы.ОтправитьЧерезПредставителя);
		
	КонецЕсли;
	
	Если НЕ КомандыФормы.Найти("Отправить") = Неопределено Тогда
		
		УстановитьНазначениеДействияКоманды(КомандыФормы.Отправить);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
