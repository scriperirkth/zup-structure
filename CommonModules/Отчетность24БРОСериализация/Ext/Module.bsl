// @strict-types

// @skip-check bsl-legacy-check-string-literal

#Область СлужебныйПрограммныйИнтерфейс

// Преобразует значение в строку JSON 
// 
// Параметры:
//  Значение - Произвольный
//  ВключатьСсылочныеДанныеОбъектов - Булево
// 
// Возвращаемое значение:
//  Строка
Функция ЗначениеВJSON(Значение, ВключатьСсылочныеДанныеОбъектов = Истина) Экспорт
	
	СтрокаJSON = Строка(ЗначениеВJSONСлужебный(Значение));
	Если ВключатьСсылочныеДанныеОбъектов Тогда
		ДанныеРеквизитовСсылок = ДанныеРеквизитовСсылок(СтрокаJSON);
		Если ЗначениеЗаполнено(ДанныеРеквизитовСсылок) Тогда  
			СтрокаJSONСсылочныхДанных = ЗначениеВJSONСлужебный(ДанныеРеквизитовСсылок);
			КодОтправителя = Отчетность24БРО.ИдентификаторБазы();
			Результат = Новый Структура("КодОтправителя, СтрокаJSON, СтрокаJSONСсылочныхДанных", 
				КодОтправителя, СтрокаJSON, СтрокаJSONСсылочныхДанных);
			Возврат Строка(ЗначениеВJSONСлужебный(Результат));
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрокаJSON;
	 
КонецФункции

// Возвращает десериализованное значение из строки JSON
// 
// Параметры:
//  СтрокаJSON                   - Строка
//  ПрочитатьВСоответствие       - Булево
//  ИменаСвойствСоЗначениямиДата - Строка, Неопределено -
//  КэшНенайденныхСсылочныхЗначений         - Неопределено, Соответствие Из КлючИЗначение - :
//  * Ключ                       - Строка 
//  * Значение                   - Соответствие Из КлючИЗначение:
//  ** Ключ                      - Строка
//  ** Значение                  - Произвольный
//  
// 
// Возвращаемое значение:
//  Произвольный
Функция JSONВЗначение(Знач СтрокаJSON, ПрочитатьВСоответствие = Истина, 
	ИменаСвойствСоЗначениямиДата = Неопределено, КэшНенайденныхСсылочныхЗначений = Неопределено) Экспорт
	
	Если Не (ТипЗнч(СтрокаJSON) = Тип("Строка") 
		И ТипЗнч(ПрочитатьВСоответствие) = Тип("Булево")
		И (ТипЗнч(ИменаСвойствСоЗначениямиДата) = Тип("Строка") 
			Или ТипЗнч(ИменаСвойствСоЗначениямиДата) = Тип("Неопределено")) 
		И (ТипЗнч(КэшНенайденныхСсылочныхЗначений) = Тип("Соответствие") 
			Или ТипЗнч(КэшНенайденныхСсылочныхЗначений) = Тип("Неопределено"))) Тогда
		ВызватьИсключение НСтр("ru = 'Передан неверный тип параметров метода JSONВЗначение'");
	КонецЕсли;

 	Значение = JSONВЗначениеСлужебный(СтрокаJSON, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата); // Произвольный, Структура, Соответствие
 	Если ТипЗнч(Значение) = Тип("Соответствие") 
 		Или (ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("СтрокаJSONСсылочныхДанных")) Тогда

		КодОтправителя = Значение["КодОтправителя"]; // Строка
 		СтрокаJSONСсылочныхДанных = Значение["СтрокаJSONСсылочныхДанных"]; // Строка
		Если ЗначениеЗаполнено(СтрокаJSONСсылочныхДанных) И ЗначениеЗаполнено(КодОтправителя) Тогда

			СтрокаJSON = Значение["СтрокаJSON"]; // Строка
			ДанныеСсылок = JSONВЗначениеСлужебный(СтрокаJSONСсылочныхДанных, Истина); // см. ДанныеРеквизитовСсылок
			
			ДополнительныеПараметры = ДополнительныеПараметрыФункцииВосстановления();
			ДополнительныеПараметры.КодОтправителя = КодОтправителя;
			ДополнительныеПараметры.СсылочныеДанные = ДанныеСсылок;
			ДополнительныеПараметры.КэшНенайденныхСсылок = КэшНенайденныхСсылочныхЗначений;
			

			Значение = JSONВЗначениеСлужебный(СтрокаJSON, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата,
				ДополнительныеПараметры); // Произвольный, Структура, Соответствие
				
		КонецЕсли;

	КонецЕсли; 

	Возврат Значение;

КонецФункции

// Возвращает код базы-отправителя из обёртки ответа, не разворачивая вложенное значение.
// Нужен приёмным процедурам (например, загрузке данных о сотрудниках) для ключа регистра соответствия ссылок.
//
// Параметры:
//  СтрокаJSON - Строка
//
// Возвращаемое значение:
//  Строка
Функция КодОтправителяОтвета(Знач СтрокаJSON) Экспорт

	Если ТипЗнч(СтрокаJSON) <> Тип("Строка") Или Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		Возврат "";
	КонецЕсли;

	Значение = JSONВЗначениеСлужебный(СтрокаJSON, Истина); // Произвольный
	Если ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("Структура") Тогда
		Код = Значение["КодОтправителя"];
		Если ЗначениеЗаполнено(Код) Тогда
			Возврат Строка(Код);
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ФункцииПреобразования

// Заполнить строки дерева.
// 
// Параметры:
//  СтрокиДерева - КоллекцияСтрокДереваЗначений
//  Таблица - ТаблицаЗначений:
//  * Строки - ТаблицаЗначений 
Процедура ЗаполнитьСтрокиДерева(СтрокиДерева, Таблица)

	Для Каждого СтрокаТЗ Из Таблица Цикл
		СтрокаДерева = СтрокиДерева.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаТЗ);
		ЗаполнитьСтрокиДерева(СтрокаДерева.Строки, СтрокаТЗ.Строки);
	КонецЦикла;
	
КонецПроцедуры

// Дерево из таблицы значений.
// 
// Параметры:
//  Таблица - ТаблицаЗначений
// 
// Возвращаемое значение:
//  ДеревоЗначений 
Функция ДеревоИзТаблицыЗначений(Таблица)

	Результат = Новый ДеревоЗначений();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.Имя = "Строки" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
	КонецЦикла;
	
	ЗаполнитьСтрокиДерева(Результат.Строки, Таблица);
	
	Возврат Результат;
	
КонецФункции

// Таблица строк дерева значений.
// 
// Параметры:
//  Колонки - КоллекцияКолонокДереваЗначений 
//  СтрокиДерева - КоллекцияСтрокДереваЗначений
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ТаблицаСтрокДереваЗначений(Колонки, СтрокиДерева)
	
	Результат = Новый ТаблицаЗначений();
	
	Для Каждого Колонка Из Колонки Цикл
		Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
	КонецЦикла;
	Результат.Колонки.Добавить("Строки", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		СтрокаТЗ = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, СтрокаДерева);
		СтрокаТЗ.Строки = ТаблицаСтрокДереваЗначений(Колонки, СтрокаДерева.Строки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Структура подмены дерева значений.
// 
// Параметры:
//  Дерево - ДеревоЗначений
// 
// Возвращаемое значение:
//  Структура:
// * СтруктураДеревоЗначенийJSON - ТаблицаЗначений - Признак того, что это не обычная структура, а её надо преобразовать в дерево после десериализации 
Функция СтруктураПодменыДереваЗначений(Дерево)
	
	СтруктураПодмены = Новый Структура("СтруктураДеревоЗначенийJSON", 
		ТаблицаСтрокДереваЗначений(Дерево.Колонки, Дерево.Строки));
			
	Возврат СтруктураПодмены;
	
КонецФункции

// Преобразования json.
// 
// Параметры:
//  Свойство                - Строка
//  Значение                - Произвольный
//  ДополнительныеПараметры - Структура:
//  * Кэш                   - Соответствие Из КлючИЗначение:
//  ** Ключ                 - Произвольный
//  ** Значение             - Строка
//  Отказ                   - Булево
// 
// Возвращаемое значение:
//  Строка 
Функция ПреобразованияJson(Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	Если ЭтоПростойТип(ТипЗначения) Тогда
		Возврат Значение;
	КонецЕсли;

	КэшЗначений = Новый Соответствие();
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("Кэш", КэшЗначений);
	КонецЕсли;
	
	НеопределенныйРезультат = ПсевдозначениеНеопределено();
	Результат = КэшЗначений.Получить(Значение);
	Если Результат <> Неопределено Тогда
		Если Результат = НеопределенныйРезультат Тогда
			Результат = Неопределено;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Результат = ПрефиксJSON().UUID + Строка(Значение);
	Иначе
		Результат = СериализоватьТипыXDTO(Значение);
	КонецЕсли;
	
	Если Результат <> Неопределено Тогда
		КэшЗначений.Вставить(Значение, Результат);
	Иначе
		КэшЗначений.Вставить(Значение, НеопределенныйРезультат);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция ПсевдозначениеНеопределено()
	Возврат Новый УникальныйИдентификатор("f10542f4-86e4-46a8-b006-2e87a1292162");
КонецФункции

// Восстановление JSON.
// 
// Параметры:
//  Свойство - Строка
//  Значение - Произвольный
//  ДополнительныеПараметры - см. ДополнительныеПараметрыФункцииВосстановления 
// 
// Возвращаемое значение:
//  Произвольный
Функция ВосстановлениеJSON(Свойство, Значение, ДополнительныеПараметры) Экспорт
	
	КэшЗначений = Неопределено;
	Если Не (ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
		И ДополнительныеПараметры.Свойство("Кэш", КэшЗначений)) Тогда
			
		КэшЗначений = Новый Соответствие();
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Кэш", КэшЗначений);
	КонецЕсли;
	
	НеопределенныйРезультат = ПсевдозначениеНеопределено();
	Результат = КэшЗначений.Получить(Значение);
	Если Результат <> Неопределено Тогда
		Если Результат = НеопределенныйРезультат Тогда
			Результат = Неопределено;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Попытка
		
		Если ТипЗначения = Тип("Строка") Тогда
			ЗначениеСтрока = Строка(Значение);
			Если ЗначениеСтрока = "Тип" Тогда
				Результат = Тип(ЗначениеСтрока);
			ИначеЕсли СтрДлина(ЗначениеСтрока) = 19
				И Сред(ЗначениеСтрока, 11, 1) = "T"
				И Сред(ЗначениеСтрока, 14, 1) = ":"
				И Сред(ЗначениеСтрока, 17, 1) = ":" Тогда
				Результат = XMLЗначение(Тип("Дата"), ЗначениеСтрока);
			ИначеЕсли СтрНачинаетсяС(ЗначениеСтрока, ПрефиксJSON().UUID) Тогда
				СтрЗначение = СтрЗаменить(ЗначениеСтрока, ПрефиксJSON().UUID, "");
				Результат = Новый УникальныйИдентификатор(СтрЗначение);
			ИначеЕсли СтрНачинаетсяС(ЗначениеСтрока, ПрефиксJSON().XDTO) Тогда
				Результат = ДесериализоватьТипыXDTO(ЗначениеСтрока, ДополнительныеПараметры);
				
				Если ТипЗнч(Результат) = Тип("Структура") Тогда
					ТаблицаДерева = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "СтруктураДеревоЗначенийJSON", Неопределено);
					Если ТипЗнч(ТаблицаДерева) = Тип("ТаблицаЗначений") Тогда
						Результат = Неопределено;
						Результат = ДеревоИзТаблицыЗначений(ТаблицаДерева);
					КонецЕсли;
				КонецЕсли;
			Иначе
				Результат = ЗначениеСтрока;
			КонецЕсли;
		Иначе
			Результат = Значение;
		КонецЕсли;
		
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"Десериализация XDTO",
			УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки);
		Результат = Неопределено;
		СохранитьОтсутствующиеТипы(ОписаниеОшибки());
	КонецПопытки;
	
	Если Результат <> Неопределено Тогда
		КэшЗначений.Вставить(Значение, Результат);
	Иначе
		КэшЗначений.Вставить(Значение, НеопределенныйРезультат);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Восстановление XDTO.
// 
// Параметры:
//  Свойство - Строка - 
//  Тип - ТипЗначенияXDTO - 
//  Значение - ЗначениеXDTO - 
//  ДополнительныеПараметры - см. ДополнительныеПараметрыФункцииВосстановления
// 
// Возвращаемое значение:
//  ЗначениеXDTO
Функция ВосстановлениеXDTO(Свойство, Тип, Значение, ДополнительныеПараметры) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Значение;
	
	Если СтрНайти(Тип.Имя, "Ref.") Тогда

		ЧастиТипа = СтрРазделить(Тип.Имя, ".");
		ВидТипа = ЧастиТипа[0];
		ИмяТипа = ЧастиТипа[1];
		
		СсылочныеДанные = Новый Соответствие(); // см. ДанныеРеквизитовСсылок
		КодОтправителя = Неопределено;
		КэшЗначений = Новый Соответствие();
		КэшНенайденныхСсылок = Неопределено;
		
		Если Не (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("Кэш", КэшЗначений)
			И ДополнительныеПараметры.Свойство("КэшНенайденныхСсылок", КэшНенайденныхСсылок)
			И ДополнительныеПараметры.Свойство("СсылочныеДанные", СсылочныеДанные)
			И ДополнительныеПараметры.Свойство("КодОтправителя", КодОтправителя)) Тогда
			Возврат Результат;
		КонецЕсли;
		
		ЗначениеИзКеша = КэшЗначений.Получить(Значение);
		Если ЗначениеИзКеша <> Неопределено Тогда
			Возврат ЗначениеИзКеша;
		КонецЕсли;
			

		ТекущаяСсылка = Значение.Значение; // ЛюбаяСсылка
		ТекущаяСсылкаСуществует = ОбщегоНазначения.СсылкаСуществует(ТекущаяСсылка);
		
		Если ТекущаяСсылкаСуществует Тогда
			Если СтрНачинаетсяС(Тип.Имя, "EnumRef") Тогда
				// элемент перечисления есть в конфигурации 
				КэшЗначений.Вставить(Значение, Результат);
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;

		УникальныйИдентификаторСсылки = Значение.ЛексическоеЗначение;
		
		Если СтрНачинаетсяС(Тип.Имя, "EnumRef") Тогда
			Результат = ФабрикаXDTO.Создать(Тип, ""); // Очищаем неизвестный элемент перечисления в текущей базе
			КэшЗначений.Вставить(Значение, Результат);
			Возврат Результат;
		КонецЕсли; 
		
		НайденнаяСсылка = Неопределено;
		
		// Запрос в регистр сопоставления для поиска ранее сопоставленной ссылки (возможно вручную)
		Запись = РегистрыСведений.Отчетность24БРОСоответствиеСсылок.СоздатьМенеджерЗаписи();
		Запись.КодОтправителя = КодОтправителя;
		Запись.Идентификатор = УникальныйИдентификаторСсылки;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			НайденнаяСсылка = Запись.Ссылка; 
		КонецЕсли;

		ЗначенияРеквизитов = СсылочныеДанные.Получить(УникальныйИдентификаторСсылки); // см. ЗначенияРеквизитовСсылки
		Если НайденнаяСсылка = Неопределено И ЗначенияРеквизитов <> Неопределено Тогда
	 		
			Ссылка = ЗначенияРеквизитов.Получить("Ссылка");
			Если Ссылка <> Неопределено Тогда
				// уже было определение ссылки
				НайденнаяСсылка = Ссылка; 
			КонецЕсли;
		КонецЕсли;
		
		Если НайденнаяСсылка = Неопределено И ЗначенияРеквизитов <> Неопределено Тогда
			
			НайденнаяСсылка = НайтиПоРеквизитам(ВидТипа, ИмяТипа, ЗначенияРеквизитов); // ЛюбаяСсылка
			ЗначенияРеквизитов["Ссылка"] = НайденнаяСсылка;

			Если НайденнаяСсылка <> Неопределено Тогда

				Запись = РегистрыСведений.Отчетность24БРОСоответствиеСсылок.СоздатьМенеджерЗаписи();
				Запись.КодОтправителя = КодОтправителя;
				Запись.Идентификатор = УникальныйИдентификаторСсылки;
				Запись.Ссылка = НайденнаяСсылка;
				Запись.Записать();
			Иначе
				Если ТипЗнч(КэшНенайденныхСсылок) = Тип("Соответствие") Тогда
					СтруктураРеквизитов = Новый Соответствие;
					Для Каждого КлючИЗначение Из ЗначенияРеквизитов Цикл
						Если КлючИЗначение.Ключ = "Ссылка" Тогда
							Продолжить;
						КонецЕсли;
						СтруктураРеквизитов.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение["Значение"]);
					КонецЦикла;
					Если УникальныйИдентификаторСсылки <> "00000000-0000-0000-0000-000000000000" Тогда
						КлючНеНайденныхСсылок = ВидМенеджераТипа(ВидТипа) + "." + ИмяТипа + "="
						+ УникальныйИдентификаторСсылки;
						КэшНенайденныхСсылок.Вставить(КлючНеНайденныхСсылок, СтруктураРеквизитов);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;

		ЛокальныйУникальныйИдентификаторСсылки = Строка(
			ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
		Если НайденнаяСсылка <> Неопределено Тогда
			ЛокальныйУникальныйИдентификаторСсылки = Строка(НайденнаяСсылка.УникальныйИдентификатор());
		КонецЕсли;
					
		Результат = ФабрикаXDTO.Создать(Тип, ЛокальныйУникальныйИдентификаторСсылки);
		
		КэшЗначений.Вставить(Значение, Результат);

	КонецЕсли;

	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Преобразует значение в строку JSON 
// 
// Параметры:
//  Значение         - Произвольный
// 
// Возвращаемое значение:
//  Строка
Функция ЗначениеВJSONСлужебный(Значение) 
	
	ДополнительныеПараметрыФункции = Новый Структура;
	ДополнительныеПараметрыФункции.Вставить("Кэш", Новый Соответствие);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(Параметры);
	ЗаписатьJSON(ЗаписьJSON, Значение, , "ПреобразованияJson", Отчетность24БРОСериализация, ДополнительныеПараметрыФункции);
	
	СтрокаJSON = ЗаписьJson.Закрыть();
	
	Возврат СтрокаJSON;
	
КонецФункции

// Дополнительные параметры функции восстановления.
// 
// Параметры:
//  КодОтправителя - Неопределено - Код отправителя
//  СсылочныеДанные - Неопределено - Ссылочные данные
// 
// Возвращаемое значение:
//  Структура:
// * СсылочныеДанные      - см. ДанныеРеквизитовСсылок 
// * КодОтправителя       - Неопределено, Строка - 
// * Кэш                  - Соответствие Из КлючИЗначение:
// ** Ключ                - Произвольный, Строка -
// ** Значение            - Произвольный, ЗначениеXDTO -
// * КэшНенайденныхСсылок - Неопределено, Соответствие Из КлючИЗначение -:
// ** Ключ                - Строка 
// ** Значение            - Соответствие Из КлючИЗначение:
// *** Ключ               - Строка
// *** Значение           - Произвольный
Функция ДополнительныеПараметрыФункцииВосстановления(
			КодОтправителя = Неопределено, 
			СсылочныеДанные = Неопределено)
			
	Результат = Новый Структура();
	
	Результат.Вставить("СсылочныеДанные", Новый Соответствие);
	Результат.Вставить("КодОтправителя", ?(КодОтправителя = Неопределено, Неопределено, КодОтправителя));
	Результат.Вставить("Кэш", Новый Соответствие);
	Результат.Вставить("КэшНенайденныхСсылок", Неопределено);

	Если СсылочныеДанные <> Неопределено Тогда
		Результат.СсылочныеДанные = СсылочныеДанные;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Возвращает десериализованное значение из строки JSON
// 
// Параметры:
//  СтрокаJSON                   - Строка
//  ПрочитатьВСоответствие       - Булево               - Прочитать в соответствие
//  ИменаСвойствСоЗначениямиДата - Строка, Неопределено - Имена свойств со значениями дата
//  ДополнительныеПараметры      - см. ДополнительныеПараметрыФункцииВосстановления
// 
// Возвращаемое значение:
//  Произвольный
//@skip-check method-too-many-params
Функция JSONВЗначениеСлужебный(Знач СтрокаJSON, Знач ПрочитатьВСоответствие = Истина, 
	Знач ИменаСвойствСоЗначениямиДата = Неопределено, ДополнительныеПараметры = Неопределено)
	
	МассивИменСвойствСоЗначениямиДата = Новый Массив(); // Массив Из Строка
	Если ТипЗнч(ИменаСвойствСоЗначениямиДата) = Тип("Строка") Тогда
		МассивИменСвойствСоЗначениямиДата = СтрРазделить(ИменаСвойствСоЗначениямиДата, ", " + Символы.ПС, Ложь);
	КонецЕсли;
	
	КэшЗначений = Новый Соответствие;
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		ДополнительныеПараметры = ДополнительныеПараметрыФункцииВосстановления();
	КонецЕсли;
	ДополнительныеПараметры.Кэш = КэшЗначений;
	
	НеопределенныйРезультат = ПсевдозначениеНеопределено();
	Результат = КэшЗначений.Получить(СтрокаJSON);
	Если Результат <> Неопределено Тогда
		Если Результат = НеопределенныйРезультат Тогда
			Результат = Неопределено;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаJSON) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Неверный тип параметра десериализации'");
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Результат = ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие, МассивИменСвойствСоЗначениямиДата, , 
		"ВосстановлениеJSON", Отчетность24БРОСериализация, ДополнительныеПараметры);
	
	ЧтениеJSON.Закрыть();
	
	Если Результат <> Неопределено Тогда
		КэшЗначений.Вставить(СтрокаJSON, Результат);
	Иначе
		КэшЗначений.Вставить(СтрокаJSON, НеопределенныйРезультат);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Префикс JSON
// 
// Возвращаемое значение:
//  Структура:
// * UUID - Строка 
// * XDTO - Строка 
Функция ПрефиксJSON()
	
	Результат = Новый Структура();
	Результат.Вставить("UUID", "UUID#_");
	Результат.Вставить("XDTO", "{""#");
	Возврат Результат;

КонецФункции

Функция ЭтоПростойТип(ТипЗначения)
	
	Возврат ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево");
				
КонецФункции

// Десериализует строку JSON
// 
// Параметры:
//  СтрокаJSON      - Строка
//  ДополнительныеПараметры      - см. ДополнительныеПараметрыФункцииВосстановления
// 
// Возвращаемое значение:
//  Неопределено, Произвольный - 
Функция ДесериализоватьТипыXDTO(Знач СтрокаJSON, ДополнительныеПараметры)
	
	МассивУдаленныхТипов = Новый Массив(); // Массив Из Строка

	// поиск и замена отсутствующих перечислений в конфигурации
	МассивПеречислений =  СтрНайтиВсеПоРегулярномуВыражению(СтрокаJSON, "jcfg:EnumRef\.\w+\"",\""#value\"":\""\w+", Истина, Истина);
	Для Каждого Элемент Из МассивПеречислений Цикл
		РезультатПоискаСтрокиТипа = СтрНайтиВсеПоРегулярномуВыражению(Элемент.Значение, "jcfg:EnumRef\.\w+", Истина, Истина)[0];
		ТипОбъектаКонфигурации = СтрЗаменить(РезультатПоискаСтрокиТипа.Значение, "jcfg:", "");
		
		Если МассивУдаленныхТипов.Найти(ТипОбъектаКонфигурации) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЗначенияXDTO = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/enterprise/current-config", ТипОбъектаКонфигурации);
		Если ТипЗначенияXDTO = Неопределено И МассивУдаленныхТипов.Найти(ТипОбъектаКонфигурации) = Неопределено Тогда
			// замена типа отсутствующего в конфигурации
			СтрокаJSON = СтрЗаменить(СтрокаJSON, """jcfg:" + ТипОбъектаКонфигурации + """", """jxs:string""");
			МассивУдаленныхТипов.Добавить(ТипОбъектаКонфигурации);
		КонецЕсли;
	КонецЦикла;
	
	// поиск и замена отсутствующих ссылочных типов объектов в конфигурации
	МассивСсылочныхТиповКонфигурации = СтрНайтиВсеПоРегулярномуВыражению(СтрокаJSON, "jcfg:\w+Ref.\w+", Истина, Истина);
	Для Каждого Элемент Из МассивСсылочныхТиповКонфигурации Цикл
		ТипОбъектаКонфигурации = СтрЗаменить(Элемент.Значение, "jcfg:", "");
		ТипЗначенияXDTO = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/enterprise/current-config", ТипОбъектаКонфигурации);
		Если ТипЗначенияXDTO = Неопределено И МассивУдаленныхТипов.Найти(ТипОбъектаКонфигурации) = Неопределено Тогда
			// замена типа отсутствующего в конфигурации
			СтрокаJSON = СтрЗаменить(СтрокаJSON, """jcfg:" + ТипОбъектаКонфигурации+"""", """jxs:string""");
			МассивУдаленныхТипов.Добавить(ТипОбъектаКонфигурации);
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеJson = Новый ЧтениеJSON;
	ЧтениеJson.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Результат = СериализаторXDTO.ПрочитатьJSON(ЧтениеJson, ,"ВосстановлениеXDTO", 
			Отчетность24БРОСериализация, ДополнительныеПараметры);
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"Десериализация XDTO",
			УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки);
		Результат = Неопределено;
	КонецПопытки;
	
	ЧтениеJson.Закрыть();
	
	Возврат Результат;
	
КонецФункции

// Возвращает данные реквизитов объектов по их ссылкам
// 
// Параметры:
//  СтрокаJSON - Строка
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение:
//  * Ключ     - Строка - Уникальный идентификатор ссылки
//  * Значение - см. ЗначенияРеквизитовСсылки
Функция ДанныеРеквизитовСсылок(Знач СтрокаJSON) Экспорт
	
	Результат = Новый Соответствие;
	
	СтрокаJSON = СтрЗаменить(СтрокаJSON,"\\","\");
	СтрокаJSON = СтрЗаменить(СтрокаJSON,"\""","""");
	
	МассивСсылочныхТипов = СтрНайтиВсеПоРегулярномуВыражению(СтрокаJSON, 
		"(jcfg:\w+Ref\.\w+)\"",\""#value\"":\s*\""(\w+-\w+-\w+-\w+-\w+)\""\}", Истина, Истина);

	Для Каждого Элемент Из МассивСсылочныхТипов Цикл

		РезультатПоискаСтрокиТипа = СтрНайтиВсеПоРегулярномуВыражению(Элемент.Значение, "jcfg:\w+Ref\.\w+", Истина,
			Истина)[0];
		ТипОбъектаКонфигурации = СтрЗаменить(РезультатПоискаСтрокиТипа.Значение, "jcfg:", "");
		ТипЗначенияXDTO = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/enterprise/current-config", ТипОбъектаКонфигурации);

		Если ТипЗначенияXDTO <> Неопределено Тогда
			
			СтрокаСсылки = СтрНайтиВсеПоРегулярномуВыражению(Элемент.Значение, "\w+-\w+-\w+-\w+-\w+", Истина,
				Истина)[0].Значение;
				
			Если Результат.Получить(СтрокаСсылки) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			СсылкаНаОбъект = ФабрикаXDTO.Создать(ТипЗначенияXDTO, СтрокаСсылки).Значение; // ЛюбаяСсылка

			Результат.Вставить(СтрокаСсылки, ЗначенияРеквизитовСсылки(СсылкаНаОбъект));

		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает значения реквизитов ссылки.
// 
// Параметры:
//  Ссылка - ЛюбаяСсылка
// 
// Возвращаемое значение:
//  Неопределено, Соответствие Из КлючИЗначение - :
//  * Ключ                - Строка    - Имя реквизита
//  * Значение            - ЛюбаяСсылка - Значение реквизита ссылки - заполняется при поиске элемента 
//                        - Структура - Значения реквизитов:
//  ** КлючевойРеквизит   - Булево    - Значение реквизита явно используется для поиска ссылки в запросе
//  ** УточняющийРеквизит - Булево    - Значение реквизита используется для поиска ссылки в запросе, 
//                                      если по ключевым полям найдено несколько значений
//  ** Значение           - Строка
//			              - Число
//			              - Дата
//			              - Булево
//			              - см. ДанныеРеквизитовСсылки // для данных вложенных ссылочных реквизитов
Функция ЗначенияРеквизитовСсылки(Ссылка)
	
	ЗначенияРеквизитов = Новый Соответствие();

	Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) Тогда
		Возврат ЗначенияРеквизитов;
	КонецЕсли;

	СвойстваСсылки = ИменаРеквизитовОбъектаМетаданных(Ссылка, Истина);
	
	Если СтрНачинаетсяС(Ссылка.Метаданные().ПолноеИмя(), "Перечисление") Тогда
		Для Каждого КлючИЗначение Из СвойстваСсылки Цикл
			СтруктураРеквизита = Новый Структура;
			СтруктураРеквизита.Вставить("КлючевойРеквизит", КлючИЗначение.Значение = Истина);
			СтруктураРеквизита.Вставить("УточняющийРеквизит", КлючИЗначение.Значение = Ложь);
			СтруктураРеквизита.Вставить("Значение", КлючИЗначение.Ключ);
			ЗначенияРеквизитов.Вставить(КлючИЗначение.Ключ, СтруктураРеквизита);
		КонецЦикла;
	Иначе

		Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда

			ЗначенияСариализуемыхРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				Ссылка, МассивИменРеквизитов(СвойстваСсылки)); // Структура

			Для Каждого КлючИЗначение Из СвойстваСсылки Цикл
				СтруктураРеквизита = Новый Структура;
				СтруктураРеквизита.Вставить("КлючевойРеквизит", КлючИЗначение.Значение = Истина);
				СтруктураРеквизита.Вставить("УточняющийРеквизит", КлючИЗначение.Значение = Ложь);
				СтруктураРеквизита.Вставить("Значение", ЗначенияСариализуемыхРеквизитов[КлючИЗначение.Ключ]);
				ЗначенияРеквизитов.Вставить(КлючИЗначение.Ключ, СтруктураРеквизита);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

// Сериализует типы XDTO
// 
// Параметры:
//  Значение - Произвольный
// 
// Возвращаемое значение:
//  Строка
Функция СериализоватьТипыXDTO(Знач Значение)
	
	ЗначениеДляСериализации = Значение;
	 
	Если ТипЗнч(Значение) = Тип("ДеревоЗначений") Тогда
		ЗначениеДляСериализации = СтруктураПодменыДереваЗначений(Значение); // Произвольный
	КонецЕсли;
	
	ЗаписьJson = Новый ЗаписьJSON;
	Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJson.УстановитьСтроку(Параметры);
	СериализаторXDTO.ЗаписатьJSON(ЗаписьJson, ЗначениеДляСериализации, НазначениеТипаXML.Явное);
	
	СтрокаJSON = ЗаписьJson.Закрыть();
	
	Возврат СтрокаJSON;
	
КонецФункции

// Преобразует имя типа XML в имя типа метаданных 
// 
// Параметры:
//  ВидТипаXML - Строка
// 
// Возвращаемое значение:
//  Строка, Неопределено - 
Функция ВидТипаМетаданных(ВидТипаXML)

	Результат = Неопределено;
		
	Если ВидТипаXML = "DocumentRef" Тогда
		Результат = "Документ";
	ИначеЕсли ВидТипаXML = "CatalogRef" Тогда
		Результат = "Справочник";
	ИначеЕсли ВидТипаXML = "ExchangePlanRef" Тогда
		Результат = "ПланОбмена";
	ИначеЕсли ВидТипаXML = "ChartOfCharacteristicTypesRef" Тогда
		Результат = "ПланВидовХарактеристик";
	ИначеЕсли ВидТипаXML = "ChartOfCalculationTypesRef" Тогда
		Результат = "ПланВидовРасчета";
	ИначеЕсли ВидТипаXML = "TaskRef" Тогда
		Результат = "Задача";
	ИначеЕсли ВидТипаXML = "BusinessProcessRef" Тогда
		Результат = "БизнесПроцесс";
	ИначеЕсли ВидТипаXML = "ChartOfAccountsRef" Тогда
		Результат = "ПланСчетов";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя менеджера типа.
// 
// Параметры:
//  ВидТипа - Строка - Вид типа метаданных в формате XDTO
// 
// Возвращаемое значение:
//  Строка
Функция ВидМенеджераТипа(Знач ВидТипа)
	
	Если СтрНайти(ВидТипа,"Ref") > 0 Тогда
		ВидТипа = ВидТипаМетаданных(ВидТипа);
	КонецЕсли;
	
	Если ВидТипа = "Перечисление" Тогда
		Результат = "Перечисления";
	ИначеЕсли ВидТипа = "Справочник" Тогда
		Результат = "Справочники";
	ИначеЕсли ВидТипа = "Документ" Тогда
		Результат = "Документы";
	ИначеЕсли ВидТипа = "ПланВидовХарактеристик" Тогда
		Результат = "ПланыВидовХарактеристик";
	ИначеЕсли ВидТипа = "ПланВидовРасчета" Тогда
		Результат = "ПланыВидовРасчета";
	ИначеЕсли ВидТипа = "ПланСчетов" Тогда
		Результат = "ПланыСчетов";
	ИначеЕсли ВидТипа = "ПланОбмена" Тогда
		Результат = "ПланыОбмена";
	ИначеЕсли ВидТипа = "РегистрСведений" Тогда
		Результат = "РегистрыСведений";
	ИначеЕсли ВидТипа = "РегистрНакопления" Тогда
		Результат = "РегистрыНакопления";
	ИначеЕсли ВидТипа = "РегистрБухгалтерии" Тогда
		Результат = "РегистрыБухгалтерии";
	ИначеЕсли ВидТипа = "РегистрРасчета" Тогда
		Результат = "РегистрыРасчета";
	ИначеЕсли ВидТипа = "БизнесПроцесс" Тогда
		Результат = "БизнесПроцессы";
	ИначеЕсли ВидТипа = "Задача" Тогда
		Результат = "Задачи";
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


// Поиск ссылки по ключевым реквизитам объекта
// 
// Параметры:
//  ВидТипаXML - Строка
//  ИмяТипа    - Строка
//  Отбор      - см. ЗначенияРеквизитовСсылки
// 
// Возвращаемое значение:
//  Неопределено, ЛюбаяСсылка -
Функция НайтиПоРеквизитам(ВидТипаXML, ИмяТипа, Отбор) Экспорт
	
	ВидТипаМетаданных = ВидТипаМетаданных(ВидТипаXML);
	
	Если Не ЗначениеЗаполнено(ВидТипаМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрНачинаетсяС(ВидТипаМетаданных, "Перечисление") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	ЕстьЗначенияОтбора = Ложь;
	Для Каждого КиЗ Из Отбор Цикл
		Если ТипЗнч(КиЗ.Значение) = Тип("Соответствие") Или ТипЗнч(КиЗ.Значение) = Тип("Структура") Тогда

			Если Не КиЗ.Значение["КлючевойРеквизит"] Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КиЗ.Значение["Значение"]) Тогда
				ЕстьЗначенияОтбора = Истина;
				Прервать;
			КонецЕсли;

		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьЗначенияОтбора Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВидМенеджераТипа = ВидМенеджераТипа(ВидТипаМетаданных); // Строка
	КоллекцияОбъектов =  Метаданные[Строка(ВидМенеджераТипа)]; // КоллекцияОбъектовМетаданных
	ОбъектМетаданных = КоллекцияОбъектов.Найти(ИмяТипа); // ОбъектМетаданных
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыПоиска = Отчетность24БРОСериализацияПовтИсп.РеквизитыОбъектаМетаданных(
		ВидМенеджераТипа, ИмяТипа);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РеквизитыПоиска, 
		Отчетность24БРОСериализацияПовтИсп.СтандартныеРеквизитыОбъектаМетаданных(
			ВидМенеджераТипа, ИмяТипа));
	
	ОтборОчищенный = Новый Структура;
	Для Каждого КиЗ Из Отбор Цикл
		Если ТипЗнч(КиЗ.Значение) = Тип("Соответствие") Или ТипЗнч(КиЗ.Значение) = Тип("Структура") Тогда
			Если КиЗ.Значение["КлючевойРеквизит"] Тогда
				Если РеквизитыПоиска.Найти(КиЗ.Ключ) <> Неопределено И ЗначениеЗаполнено(КиЗ.Значение["Значение"]) Тогда
				
					// Ищем только по непустым данным
					ОтборОчищенный.Вставить(КиЗ.Ключ, КиЗ.Значение["Значение"]);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ИмяТаблицы = ВидТипаМетаданных + "." + ИмяТипа;

	Запрос = Новый Запрос;
	
	ТекстОтборМассив = Новый Массив; // Массив Из Строка
		
	Запрос.Текст = "ВЫБРАТЬ
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	ИмяТаблицы КАК Таблица
		|ГДЕ &ТекстОтбор";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТаблицы", ИмяТаблицы);
	Для Каждого КиЗ Из ОтборОчищенный Цикл
		ТекстОтборМассив.Добавить("Таблица." + КиЗ.Ключ + " = &" + КиЗ.Ключ);
		Запрос.УстановитьПараметр(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;

	Если ТекстОтборМассив.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстОтбор", СтрСоединить(ТекстОтборМассив, " И "));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ &ТекстОтбор", "");
	КонецЕсли;

	ТаблицаВыборки = Запрос.Выполнить().Выгрузить();
	Если ТаблицаВыборки.Количество() = 1 Тогда
		Возврат ТаблицаВыборки[0]["Ссылка"];
	КонецЕсли;

	Если ТаблицаВыборки.Количество() > 0 Тогда
		
		// Запрос по ключевым полям дал несколько результатов - пробуем отфильтровать по уточняющим реквизитам
		Возврат НайтиПоРеквизитамСлужебный(ВидТипаXML, ИмяТипа, Отбор, ТаблицаВыборки.ВыгрузитьКолонку("Ссылка"));

	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Поиск ссылки по уточняющим реквизитам объекта
// 
// Параметры:
//  ВидТипаXML - Строка
//  ИмяТипа    - Строка
//  Отбор      - см. ЗначенияРеквизитовСсылки
//  Ссылки     - Массив Из ЛюбаяСсылка
// 
// Возвращаемое значение:
//  Неопределено, ЛюбаяСсылка -
Функция НайтиПоРеквизитамСлужебный(ВидТипаXML, ИмяТипа, Отбор, Ссылки) Экспорт
	
	ВидТипаМетаданных = ВидТипаМетаданных(ВидТипаXML);
	
	Если Не ЗначениеЗаполнено(ВидТипаМетаданных) Или ТипЗнч(Ссылки) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕстьЗначенияОтбора = Ложь;
	Для Каждого КиЗ Из Отбор Цикл
		Если ТипЗнч(КиЗ.Значение) = Тип("Соответствие") 
			Или ТипЗнч(КиЗ.Значение) = Тип("Структура") Тогда
				
			Если Не КиЗ.Значение["УточняющийРеквизит"] Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КиЗ.Значение["Значение"]) Тогда
				ЕстьЗначенияОтбора = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьЗначенияОтбора Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВидМенеджераТипа = ВидМенеджераТипа(ВидТипаМетаданных); // Строка
	КоллекцияОбъектов =  Метаданные[Строка(ВидМенеджераТипа)]; // КоллекцияОбъектовМетаданных
	ОбъектМетаданных = КоллекцияОбъектов.Найти(ИмяТипа); // ОбъектМетаданных
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыПоиска = Отчетность24БРОСериализацияПовтИсп.РеквизитыОбъектаМетаданных(
		ВидМенеджераТипа, ИмяТипа);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РеквизитыПоиска, 
		Отчетность24БРОСериализацияПовтИсп.СтандартныеРеквизитыОбъектаМетаданных(
			ВидМенеджераТипа, ИмяТипа));
	
	ОтборОчищенный = Новый Структура;
	Для Каждого КиЗ Из Отбор Цикл
		Если КиЗ.Значение["УточняющийРеквизит"] Тогда
			Если РеквизитыПоиска.Найти(КиЗ.Ключ) <> Неопределено И ЗначениеЗаполнено(КиЗ.Значение["Значение"]) Тогда
				
				// Ищем только по непустым данных
				ОтборОчищенный.Вставить(КиЗ.Ключ, КиЗ.Значение["Значение"]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ИмяТаблицы = ВидТипаМетаданных + "." + ИмяТипа;

	Запрос = Новый Запрос;
	
	ТекстОтборМассив = Новый Массив; // Массив Из Строка
	Для Каждого КиЗ Из ОтборОчищенный Цикл
		ТекстОтборМассив.Добавить(", Таблица." + КиЗ.Ключ + " КАК " + КиЗ.Ключ);
	КонецЦикла;

	Запрос.Текст = "ВЫБРАТЬ
				   |	Таблица.Ссылка КАК Ссылка
				   |ИЗ
				   |	ИмяТаблицы КАК Таблица
				   |ГДЕ
				   |	Таблица.Ссылка В (&Ссылки)";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТаблицы", ИмяТаблицы);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЗ", СтрСоединить(ТекстОтборМассив, " ") + " ИЗ");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	
	ТаблицаВыборки = Запрос.Выполнить().Выгрузить();

	Если ТаблицаВыборки.Количество() > 0 Тогда
		
		ЧислоНайденныхРеквизитов = Новый Соответствие(); // Соответствие
		Для Каждого СтрокаТЗ Из ТаблицаВыборки Цикл
			Для Каждого КиЗ Из ОтборОчищенный Цикл
				ЗначениеВБазе = СтрокаТЗ[КиЗ.Ключ]; // Произвольный
				
				// проверка только по заполненным в базе реквизитам 
				Если ЗначениеЗаполнено(ЗначениеВБазе) И ЗначениеВБазе = КиЗ.Значение Тогда
					НайденнаяСсылка = СтрокаТЗ["Ссылка"]; // ЛюбаяСсылка
					
					ЧислоРеквизитов = ЧислоНайденныхРеквизитов.Получить(НайденнаяСсылка);
					Если ЧислоРеквизитов = Неопределено Тогда
						ЧислоРеквизитов = 0;
					КонецЕсли;
					
					ЧислоНайденныхРеквизитов[НайденнаяСсылка] = ЧислоРеквизитов + 1;
					 
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
		МаксимальноеЧислоСовпавшихРеквизитов = 0;
		СсылкаСМаксимальнымЧисломСовпавшихРеквизитов = Неопределено;
		Для Каждого КлючИЗначение Из ЧислоНайденныхРеквизитов Цикл
			Если СсылкаСМаксимальнымЧисломСовпавшихРеквизитов = Неопределено Тогда
				СсылкаСМаксимальнымЧисломСовпавшихРеквизитов = КлючИЗначение.Ключ;
				МаксимальноеЧислоСовпавшихРеквизитов = КлючИЗначение.Значение; // Число
				Продолжить;
			КонецЕсли;
			
			Если КлючИЗначение.Значение > МаксимальноеЧислоСовпавшихРеквизитов Тогда
				СсылкаСМаксимальнымЧисломСовпавшихРеквизитов = КлючИЗначение.Ключ;
				МаксимальноеЧислоСовпавшихРеквизитов = КлючИЗначение.Значение; // Число
			КонецЕсли;
		КонецЦикла;
		
		Если СсылкаСМаксимальнымЧисломСовпавшихРеквизитов = Неопределено Тогда
			Возврат Ссылки[0];
		Иначе
			Возврат СсылкаСМаксимальнымЧисломСовпавшихРеквизитов;
		КонецЕсли;

	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает массив всех имен реквизитов
// 
// Параметры:
//  ИменаРеквизитовОбъектаМетаданных - см. ИменаРеквизитовОбъектаМетаданных
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция МассивИменРеквизитов(ИменаРеквизитовОбъектаМетаданных)
	
	Результат = Новый Массив(); // Массив Из Строка
	
	Для Каждого КлючИЗначение Из ИменаРеквизитовОбъектаМетаданных Цикл
		
		Результат.Добавить(КлючИЗначение.Ключ);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет ключевой реквизит в ИменаРеквизитовОбъектаМетаданных 
// 
// Параметры:
//  ИменаРеквизитовОбъектаМетаданных - см. ИменаРеквизитовОбъектаМетаданных
//  ВидТипа         - Строка
//  ИмяТипа         - Строка
//  ИмяРеквизита    - Строка
Процедура ДобавитьКлючевойРеквизит(ИменаРеквизитовОбъектаМетаданных, ВидТипа, ИмяТипа, ИмяРеквизита)
	
	ВидМенеджераТипа = ВидМенеджераТипа(ВидТипа);
	
	Если Отчетность24БРОСериализацияПовтИсп.ЕстьРеквизитОбъектаМетаданных(
		ВидМенеджераТипа, ИмяТипа, ИмяРеквизита) Тогда
		ИменаРеквизитовОбъектаМетаданных.Вставить(ИмяРеквизита, Истина);
	КонецЕсли;
	
КонецПроцедуры

// Добавляет уточняющий реквизит в ИменаРеквизитовОбъектаМетаданных 
// 
// Параметры:
//  ИменаРеквизитовОбъектаМетаданных - см. ИменаРеквизитовОбъектаМетаданных
//  ВидТипа         - Строка
//  ИмяТипа         - Строка
//  ИмяРеквизита    - Строка
Процедура ДобавитьУточняющийРеквизит(ИменаРеквизитовОбъектаМетаданных, ВидТипа, ИмяТипа, ИмяРеквизита)
	
	ВидМенеджераТипа = ВидМенеджераТипа(ВидТипа);
	
	Если Отчетность24БРОСериализацияПовтИсп.ЕстьРеквизитОбъектаМетаданных(
		ВидМенеджераТипа, ИмяТипа, ИмяРеквизита) Тогда
		ИменаРеквизитовОбъектаМетаданных.Вставить(ИмяРеквизита, Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает соответствие имен реквизитов и их значимости для поиска при десериализации
// 
// Параметры:
//  Ссылка                - ДокументСсылка
//                        - СправочникСсылка
//                        - ПеречислениеСсылка
//                        - ПланСчетовСсылка
//                        - ПланВидовРасчетаСсылка
//                        - ПланВидовХарактеристикСсылка
//
//  ТолькоРеквизитыПоиска - Булево    - при Истина будут выгружаться только ключевые реквизиты 
//                                      для поиска ссылки при десериализации 
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение:
//  * Ключ     - Строка               - Имя реквизита метаданых
//  * Значение - Булево, Неопределено - Истина       - для обязательных полей 
//                                      Ложь         - для реквизитов используемых для уточнения поиска 
//                                                     если данные присутствуют и базе и в JSON
//                                      Неопределено - для остальных реквизитов испольуемых при создании нового объекта
//
Функция ИменаРеквизитовОбъектаМетаданных(Ссылка, ТолькоРеквизитыПоиска = Ложь)

	Результат = Новый Соответствие;

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	СсылкаМетаданные = Ссылка.Метаданные();
	ТипСсылки = СсылкаМетаданные.ПолноеИмя();

	ЧастиТипа = СтрРазделить(ТипСсылки, ".");
	ВидТипа = ЧастиТипа[0];
	ИмяТипа = ЧастиТипа[1];

	Если СтрНачинаетсяС(ТипСсылки, "Перечисление") Тогда

		ИндексЗначенияПеречисления = Перечисления[ИмяТипа].Индекс(Ссылка);
		ПеречислениеМетаданных = Метаданные.Перечисления[ИмяТипа];
		ИмяЗначенияПеречисления = ПеречислениеМетаданных.ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
		Результат.Вставить(ИмяЗначенияПеречисления, Истина);

	Иначе
		

		Если ТолькоРеквизитыПоиска = Ложь Тогда

			Реквизиты = Отчетность24БРОСериализацияПовтИсп.РеквизитыОбъектаМетаданных(
				ВидМенеджераТипа(ВидТипа), ИмяТипа);

			Для Каждого Реквизит Из Реквизиты Цикл
				Результат.Вставить(Реквизит);
			КонецЦикла;

		КонецЕсли;

		Если ВидТипа = "Справочник" Тогда // любой неописанный справочник

			Если ИмяТипа = "Организации" Тогда

				ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "ИНН");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "ОГРН");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "КПП");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "НаименованиеСокращенное");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "НаименованиеПолное");
				
			ИначеЕсли ИмяТипа = "Контрагенты" Тогда

				ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "ИНН");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "КПП");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "ЮридическоеФизическоеЛицо");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "НаименованиеПолное");

			ИначеЕсли ИмяТипа = "ФизическиеЛица" Тогда

				ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "ФИО");
				ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "Фамилия");
				ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "Имя");
				ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "Отчество");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "ДатаРождения");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "Пол");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "ИНН");
				ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "СтраховойНомерПФР");

			КонецЕсли;
			
		ИначеЕсли ВидТипа = "Документ" Тогда // любой неописанный документ
			Результат.Вставить("Дата", Истина);
			
			ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "Организация");
			
			Если ИмяТипа = "РеестрДСВ" Тогда
			
			КонецЕсли;
			 
			Если Результат.Количество() = 1 Тогда
				// Если из реквизитов только дата, то добавляем номер
				Результат.Вставить("Номер", Истина);
			КонецЕсли;
			
		ИначеЕсли ВидТипа = "ПланВидовХарактеристик" Тогда
			ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "Наименование");
			ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "Код");
		ИначеЕсли ВидТипа = "ПланСчетов" Тогда
			Результат.Вставить("Код", Истина);
		ИначеЕсли ВидТипа = "ПланОбмена" Тогда
			ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "Наименование");
			ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "Код");
		ИначеЕсли ВидТипа = "ПланВидовРасчета" Тогда
			ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "Наименование");
			ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "Код");
		ИначеЕсли ВидТипа = "БизнесПроцесс" Тогда
			ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "Наименование");
			ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "Код");
		ИначеЕсли ВидТипа = "Задача" Тогда
			ДобавитьКлючевойРеквизит(Результат, ВидТипа, ИмяТипа, "Наименование");
			ДобавитьУточняющийРеквизит(Результат, ВидТипа, ИмяТипа, "Код");
		КонецЕсли;
		
		ВидМенеджераТипа = ВидМенеджераТипа(ВидТипа);
		Если Отчетность24БРОСериализацияПовтИсп.ЕстьРеквизитОбъектаМетаданных(
				ВидМенеджераТипа, ИмяТипа, "Наименование") Тогда
			Результат.Вставить("Наименование", Результат.Количество() = 0);
		КонецЕсли;

		Если Отчетность24БРОСериализацияПовтИсп.ЕстьРеквизитОбъектаМетаданных(
				ВидМенеджераТипа, ИмяТипа, "Код") Тогда
			Результат.Вставить("Код", Результат.Количество() = 0); // Если есть наименование, 
				                                                       // то поиск будет сначала по наименованию 
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура СохранитьОтсутствующиеТипы(ТекстОшибки)
	
	ПрефиксОшибки = "Неизвестный тип '";
	
	ПозНач = СтрНайти(ТекстОшибки, ПрефиксОшибки) + СтрДлина(ПрефиксОшибки);
	ПозКон = СтрНайти(ТекстОшибки, " ", , ПозНач);
	
	ИмяТипа = "jcfg:" + Сред(ТекстОшибки, ПозНач, ПозКон - ПозНач);
	
	НужноОтключитьПривилегированныйРежим = Ложь;
	Если ПривилегированныйРежим() = Ложь Тогда
		УстановитьПривилегированныйРежим(Истина);
		НужноОтключитьПривилегированныйРежим = Истина;
	КонецЕсли;
	
	ТекущиеЗначения = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
		Отчетность24БРО.ПрефикДанныхВБезопасномХранилище(), 
		"ОтсутствующиеТипыСериализации");
	Если ТекущиеЗначения = Неопределено Тогда
		ТекущиеЗначения = Новый Массив;
	КонецЕсли;
	ТекущиеЗначения.Добавить(ИмяТипа);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
		Отчетность24БРО.ПрефикДанныхВБезопасномХранилище(),
		ТекущиеЗначения, 
		"ОтсутствующиеТипыСериализации");
	
	Если НужноОтключитьПривилегированныйРежим = Истина Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

