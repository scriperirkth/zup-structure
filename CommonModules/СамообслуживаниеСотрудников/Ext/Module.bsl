КонецФункции

// Возвращает информацию о том, можно ли выдавать сотруднику данный вид справки без предупреждения.
// 
// Параметры:
//  ВидСправки - СправочникСсылка.ВидыПредоставляемыхСотрудникамСправок
// 
// Возвращаемое значение:
//  Булево
Функция ФормироватьСправкуАвтоматически(ВидСправки) Экспорт
	
	СпособФормирования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидСправки, "СпособФормирования");
	
	Возврат СпособФормирования = Перечисления.СпособыФормированияСправокСотрудникам.Автоматически;
	
КонецФункции

// Параметры:
//  Объект - ОпределяемыйТип.ВладелецПрисоединенныхФайловОбъект -
//  ВладелецФайлов - ОпределяемыйТип.ВладелецПрисоединенныхФайлов -
//  ТабличныйДокумент - ТабличныйДокумент
//  ИмяРеквизита - Строка - 
//  ИмяФайлаБезРасширения - Строка - 
//  ТипФайла - ТипФайлаТабличногоДокумента
Процедура СохранитьТабличныйДокументВПрисоединенномФайле(Объект, ВладелецФайлов, ТабличныйДокумент, ИмяРеквизита,
	ИмяФайлаБезРасширения, ТипФайла = Неопределено) Экспорт
	
	Если ТипФайла = Неопределено Тогда
		ТипФайла = ТипФайлаТабличногоДокумента.MXL;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект[ИмяРеквизита])
		И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект[ИмяРеквизита], "ПометкаУдаления") Тогда
			
		ИнформацияОФайле = Новый Структура;
		ИнформацияОФайле.Вставить("АдресФайлаВоВременномХранилище",
			ПоместитьВоВременноеХранилище(ДвоичныеДанныеТабличногоДокумента(ТабличныйДокумент, ТипФайла)));
		ИнформацияОФайле.Вставить("АдресВременногоХранилищаТекста", "");
		РаботаСФайлами.ОбновитьФайл(Объект[ИмяРеквизита], ИнформацияОФайле);
		
	Иначе
		
		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыФайла.ВладелецФайлов = ВладелецФайлов;
		ПараметрыФайла.ИмяБезРасширения = ИмяФайлаБезРасширения;
		ПараметрыФайла.РасширениеБезТочки = РасширениеПоТипуФайла(ТипФайла);
		ПараметрыФайла.Служебный = Истина;
		УстановитьПривилегированныйРежим(Истина);
		Объект[ИмяРеквизита] = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла,
			ПоместитьВоВременноеХранилище(ДвоичныеДанныеТабличногоДокумента(ТабличныйДокумент, ТипФайла)));
		УстановитьПривилегированныйРежим(Ложь);
			
	КонецЕсли;
	
КонецПроцедуры

// Возвращаемое значение:
//  Структура - Новый результат получения справки:
// * ТабличныйДокумент - ТабличныйДокумент - печатная форма справки.
// * ОК - Булево - если Истина, то справка успешно сформирована, иначе Ложь.
// * ОписаниеОшибки - Строка - описание ошибки в случае если ОК = Ложь.
Функция НовыйРезультатПолученияСправки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ТабличныйДокумент", Новый ТабличныйДокумент);
	Результат.Вставить("ОК", Истина);
	Результат.Вставить("ОписаниеОшибки", "");
	
	Возврат Результат;
	
КонецФункции

// Помечает на удаление присоединенный файл
// 
// Параметры:
//  ПрисоединенныйФайл - СправочникСсылка.ВидыПредоставляемыхСотрудникамСправокПрисоединенныеФайлы
//  УстановитьПометку - Булево
Процедура УдалитьПрисоединенныйФайл(ПрисоединенныйФайл, УстановитьПометку = Истина) Экспорт
	
	ПрисоединенныйФайлОбъект = ПрисоединенныйФайл.ПолучитьОбъект();
	Если УстановитьПометку Тогда
		ПрисоединенныйФайлОбъект.УстановитьПометкуУдаления(Истина);
	Иначе
		ПрисоединенныйФайлОбъект.Удалить(); //АПК:1327 - удалить файл нужно даже если он заблокирован
	КонецЕсли;
	
КонецПроцедуры

