Функция ЭтоДокументОснование(ДокументСсылка) Экспорт
	 Возврат Метаданные.ОпределяемыеТипы.ЦепочкиДокументовОснования.Тип.СодержитТип(ТипЗнч(ДокументСсылка));
КонецФункции

#Область ОбработчикиОбновления
	
Процедура ЗарегистрироватьОбработчикиОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.Процедура = "ЦепочкиДокументов.УстановитьИспользованиеЦепочекДокументов";
	
КонецПроцедуры

Процедура УстановитьИспользованиеЦепочекДокументов() Экспорт 

	Если Константы.ИспользоватьЗарплатаКадрыКорпоративнаяПодсистемы.Получить() = Истина Тогда
		Константы.ИспользоватьЦепочкиДокументов.Установить(Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

Функция ФамилияИОПадеж(СотрудникИО, НомерПадежа) Экспорт

	Возврат СклонениеПредставленийОбъектов.ПросклонятьПредставление(СотрудникИО, НомерПадежа);

КонецФункции

Функция ТаблицаСДокументомОснованием(ДокументОснование = Неопределено, Сотрудник = Неопределено) Экспорт 

	ТаблицаЗамещения = НоваяТаблицаДокументовЗамещения();
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат ТаблицаЗамещения;
	КонецЕсли;
	
	Если Сотрудник = Неопределено И Не ЭтоМногосотрудниковыйДокумент(ДокументОснование) Тогда
		ИмяРеквизитаСотрудник = ОписаниеДокументовЗамещения(ДокументОснование).ИмяРеквизитаОтсутствующийСотрудник;
		Сотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, ИмяРеквизитаСотрудник);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.Проверить(Сотрудник <> Неопределено,
		СтрШаблон(НСтр("ru = 'Не определен сотрудник документа-основания %1'"), ДокументОснование),
		"ЦепочкиДокументов.ТаблицаСДокументомОснованием");
	
	КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудников(Ложь, Сотрудник, "ФамилияИО", ТекущаяДатаСеанса());
	Если КадровыеДанные.Количество() > 0 Тогда
		СотрудникИО = КадровыеДанные[0].ФамилияИО;
	Иначе	
		СотрудникИО = "";
	КонецЕсли;
	
	СтрокаЗамещения = ТаблицаЗамещения.Добавить();
	СтрокаЗамещения.Основание = ДокументОснование;
	СтрокаЗамещения.СотрудникОснования = Сотрудник;
	СтрокаЗамещения.СотрудникОснованияФамилияИО = СотрудникИО;
	
	Возврат ТаблицаЗамещения;
		
КонецФункции

// Параметры:
//  ДокументСсылка - ОпределяемыйТип.ЦепочкиДокументовОснования,ОпределяемыйТип.ЦепочкиДокументовПодчиненные -
// 
// Возвращаемое значение:
//  см. ЗарплатаКадрыРасширенныйКлиентСервер.СтруктураОписанияДокумента
Функция ОписаниеДокументовЗамещения(ДокументСсылка) Экспорт 

	Возврат Документы[ДокументСсылка.Метаданные().Имя].ОписаниеДокумента();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет есть ли у документа подчиненные документы.
// 
// Параметры:
//  ДокументОснование - ОпределяемыйТип.ЦепочкиДокументовОснования
// 
// Возвращаемое значение:
//  Булево
Функция ЕстьПодчиненныеДокументы(ДокументОснование) Экспорт
	
	Возврат ПодчиненныеДокументы(ДокументОснование).Количество() > 0;
	
КонецФункции

// Параметры:
//  Документ - ДокументСсылка
//  ИмяРеквизитаСотрудник - Строка,Неопределено - 
// 
// Возвращаемое значение:
//  Булево
Функция ЭтоМногосотрудниковыйДокумент(Документ) Экспорт
	
	Возврат ЗначениеЗаполнено(ОписаниеДокументовЗамещения(Документ).ИмяТабличнойЧастиСотрудники);
	
КонецФункции

// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица документов замещения:
//   * Основание - ОпределяемыйТип.ЦепочкиДокументовОснования
//   * Подчиненный - ОпределяемыйТип.ЦепочкиДокументовПодчиненные
//   * СотрудникОснования - СправочникСсылка.Сотрудники
//   * СотрудникОснованияФамилияИО - Строка
//	 * СотрудникПодчиненного - СправочникСсылка.Сотрудники
//	 * СотрудникПодчиненногоФамилияИО - Строка
//	 * ИдентификаторСтрокиОснования - УникальныйИдентификатор
Функция НоваяТаблицаДокументовЗамещения()

	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	ТаблицаЗначений.Колонки.Добавить("Основание", Метаданные.ОпределяемыеТипы.ЦепочкиДокументовОснования.Тип);
	ТаблицаЗначений.Колонки.Добавить("Подчиненный", Метаданные.ОпределяемыеТипы.ЦепочкиДокументовПодчиненные.Тип);
	ТаблицаЗначений.Колонки.Добавить("СотрудникОснования", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаЗначений.Колонки.Добавить("СотрудникОснованияФамилияИО", Новый ОписаниеТипов("Строка"));
	ТаблицаЗначений.Колонки.Добавить("СотрудникПодчиненного", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаЗначений.Колонки.Добавить("СотрудникПодчиненногоФамилияИО", Новый ОписаниеТипов("Строка"));
	ТаблицаЗначений.Колонки.Добавить("ИдентификаторСтрокиОснования", Новый ОписаниеТипов("УникальныйИдентификатор"));

	Возврат ТаблицаЗначений;

КонецФункции

// Параметры:
//  ПодчиненныйДокумент - ОпределяемыйТип.ЦепочкиДокументовПодчиненные - 
//  ДокументОснование - Неопределено, ОпределяемыйТип.ЦепочкиДокументовОснования - 
// 
// Возвращаемое значение:
//  см. НовыеДанныеДокументаОснования
Функция ДанныеДокументаОснования(ПодчиненныйДокумент, ДокументОснование = Неопределено) Экспорт

	Результат = НовыеДанныеДокументаОснования();
	
	Если Не ЭтоПодчиненныйДокумент(ПодчиненныйДокумент) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ДокументОснование = Неопределено Тогда
		ДокументыОснования = ДокументыОснования(ПодчиненныйДокумент);
		Если ДокументыОснования.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат, ДокументыОснования[0]);
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ЦепочкиДокументов.Основание,
			|	ЦепочкиДокументов.СотрудникОснования,
			|	ЦепочкиДокументов.ПометкаУдаленияОснования,
			|	ЦепочкиДокументов.ОрганизацияОснования,
			|	ЦепочкиДокументов.ИдентификаторСтрокиОснования
			|ИЗ
			|	РегистрСведений.ЦепочкиДокументов КАК ЦепочкиДокументов
			|ГДЕ
			|	ЦепочкиДокументов.Основание = &Основание
			|	И ЦепочкиДокументов.Подчиненный = &Подчиненный";
		
		Запрос.УстановитьПараметр("Основание", ДокументОснование);
		Запрос.УстановитьПараметр("Подчиненный", ПодчиненныйДокумент);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			ВыборкаДетальныеЗаписи.Следующий();
			ЗаполнитьЗначенияСвойств(Результат, ВыборкаДетальныеЗаписи);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращаемое значение:
//  Структура - Новые данные документа основания:
// * Основание - Неопределено, ОпределяемыйТип.ЦепочкиДокументовОснования - 
// * СотрудникОснования - СправочникСсылка.Сотрудники -
// * ПометкаУдаленияОснования - Булево -
// * ОрганизацияОснования - СправочникСсылка.Организации -
// * ИдентификаторСтрокиОснования - УникальныйИдентификатор -
Функция НовыеДанныеДокументаОснования()
	
	Результат = Новый Структура;
	Результат.Вставить("Основание", Неопределено);
	Результат.Вставить("СотрудникОснования", Справочники.Сотрудники.ПустаяСсылка());
	Результат.Вставить("ПометкаУдаленияОснования", Ложь);
	Результат.Вставить("ОрганизацияОснования", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("ИдентификаторСтрокиОснования", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаПодчиненныеДокументы()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЦепочкиДокументов.Основание,
		|	ЦепочкиДокументов.Подчиненный,
		|	ЦепочкиДокументов.СотрудникОснования,
		|	ЦепочкиДокументов.СотрудникПодчиненного,
		|	ЦепочкиДокументов.ИдентификаторСтрокиОснования
		|ПОМЕСТИТЬ ВТЦепочкиДокументов
		|ИЗ
		|	РегистрСведений.ЦепочкиДокументов КАК ЦепочкиДокументов
		|ГДЕ
		|	ЦепочкиДокументов.Основание В(&ДокументыОснование)
		|	И НЕ ЦепочкиДокументов.ПометкаУдаленияПодчиненного
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТЦепочкиДокументов.СотрудникОснования КАК Сотрудник,
		|	&Период КАК Период
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	ВТЦепочкиДокументов КАК ВТЦепочкиДокументов
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТЦепочкиДокументов.СотрудникПодчиненного,
		|	&Период
		|ИЗ
		|	ВТЦепочкиДокументов КАК ВТЦепочкиДокументов";
		
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаДокументыОснования()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЦепочкиДокументов.Основание,
		|	ЦепочкиДокументов.Подчиненный,
		|	ЦепочкиДокументов.СотрудникОснования,
		|	ЦепочкиДокументов.СотрудникПодчиненного,
		|	ЦепочкиДокументов.ИдентификаторСтрокиОснования
		|ПОМЕСТИТЬ ВТЦепочкиДокументов
		|ИЗ
		|	РегистрСведений.ЦепочкиДокументов КАК ЦепочкиДокументов
		|ГДЕ
		|	ЦепочкиДокументов.Подчиненный В(&ПодчиненныеДокументы)
		|	И НЕ ЦепочкиДокументов.ПометкаУдаленияОснования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТЦепочкиДокументов.СотрудникОснования КАК Сотрудник,
		|	&Период КАК Период
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	ВТЦепочкиДокументов КАК ВТЦепочкиДокументов
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТЦепочкиДокументов.СотрудникПодчиненного,
		|	&Период
		|ИЗ
		|	ВТЦепочкиДокументов КАК ВТЦепочкиДокументов";
		
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстВыборкиИзВТЦепочкиДокументов()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТЦепочкиДокументов.Основание,
		|	ВТЦепочкиДокументов.Подчиненный,
		|	ВТЦепочкиДокументов.СотрудникОснования,
		|	ЕСТЬNULL(Сотрудники.ФамилияИО, """") КАК СотрудникОснованияФамилияИО,
		|	ВТЦепочкиДокументов.СотрудникПодчиненного,
		|	ЕСТЬNULL(СотрудникиДругие.ФамилияИО, """") КАК СотрудникПодчиненногоФамилияИО,
		|	ВТЦепочкиДокументов.ИдентификаторСтрокиОснования
		|ИЗ
		|	ВТЦепочкиДокументов КАК ВТЦепочкиДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК Сотрудники
		|		ПО ВТЦепочкиДокументов.СотрудникОснования = Сотрудники.Сотрудник
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК СотрудникиДругие
		|		ПО ВТЦепочкиДокументов.СотрудникПодчиненного = СотрудникиДругие.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТКадровыеДанныеСотрудников";
		
	Возврат ТекстЗапроса
		
КонецФункции

// Возвращает таблицу значений с документами цепочки замещений, отобранными по документам основаниям
// или подчиененным документам.
// 
// Параметры:
//  ТекстЗапроса - Строка
//  ИмяПараметраОтбора - Строка
//  ДокументыЦепочки - Массив из ОпределяемыйТип.ЦепочкиДокументовОснования, ОпределяемыйТип.ЦепочкиДокументовПодчиненные -
//  
// Возвращаемое значение:
//  см. НоваяТаблицаДокументовЗамещения
Функция ТаблицаЗамещений(ТекстЗапроса, ИмяПараметраОтбора, ДокументыЦепочки) Экспорт
	
	ОбщегоНазначенияБЗККлиентСервер.УдалитьПустыеЗначенияИзМассива(ДокументыЦепочки);
	
	Если Не ЗначениеЗаполнено(ДокументыЦепочки) Тогда
		Возврат НоваяТаблицаДокументовЗамещения();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр(ИмяПараметраОтбора, ДокументыЦепочки);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Описатель = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(
		Запрос.МенеджерВременныхТаблиц, "ВТСотрудники");
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(Описатель, Истина, "ФамилияИО");
	
	Запрос.Текст = ТекстВыборкиИзВТЦепочкиДокументов();
		
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

#КонецОбласти