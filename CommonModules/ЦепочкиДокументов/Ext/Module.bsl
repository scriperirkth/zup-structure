КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает признак использования цепочек документов.
// 
// Возвращаемое значение:
//  Булево
Функция ИспользоватьЦепочкиДокументов() Экспорт 
	
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьЦепочкиДокументов");
	
КонецФункции

// Записывает связь документов Основание-Подчиненный в регистр вместе со вторичными данными.
// Вызывается при записи Подчиненного.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая реквизит-ссылку на документ Основание.
// 	Объект - ДокументОбъект - текущий объект.
//
Процедура СформироватьЦепочкиДокументов(Форма, Объект) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЦепочкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	ПодчиненныйДокумент = Объект.Ссылка; // ОпределяемыйТип.ЦепочкиДокументовПодчиненные
	ДокументОснование = Форма.ЗамещениеДокументОснование; // ОпределяемыйТип.ЦепочкиДокументовОснования
	
	Если ПодчиненныйДокумент = Неопределено Или ДокументОснование = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаСотрудник = ОписаниеДокументовЗамещения(ПодчиненныйДокумент).ИмяРеквизитаСотрудник;
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Организация,ПометкаУдаления");
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.ЦепочкиДокументов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Основание = ДокументОснование;
	МенеджерЗаписи.СотрудникОснования = Форма.ЗамещаемыйСотрудник;
	МенеджерЗаписи.ПометкаУдаленияОснования = РеквизитыОснования["ПометкаУдаления"];
	МенеджерЗаписи.ОрганизацияОснования = РеквизитыОснования["Организация"];
	МенеджерЗаписи.ИдентификаторСтрокиОснования = Форма.ИдентификаторСтрокиОснования;
	
	МенеджерЗаписи.Подчиненный = ПодчиненныйДокумент;
	МенеджерЗаписи.СотрудникПодчиненного = Объект[ИмяРеквизитаСотрудник];
	МенеджерЗаписи.ПометкаУдаленияПодчиненного = Объект["ПометкаУдаления"];
	
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры

// Обновляет вторичные реквизиты документа в регистре.
// Параметры:
//  ТекущийОбъект - ОпределяемыйТип.ЦепочкиДокументовОснования, ОпределяемыйТип.ЦепочкиДокументовПодчиненные -
//   текущий объект.
//
Процедура УстановитьВторичныеРеквизитыДокументаЗамещения(ТекущийОбъект) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЦепочкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументСсылка = ТекущийОбъект.Ссылка;
	ПометкаУдаления = ТекущийОбъект.ПометкаУдаления;
	Организация = ТекущийОбъект.Организация;
	Если ЭтоМногосотрудниковыйДокумент(ДокументСсылка) Тогда
		Сотрудник = Неопределено;
	Иначе
		ОписаниеДокумента = ОписаниеДокументовЗамещения(ДокументСсылка);
		Сотрудник = ТекущийОбъект[ОписаниеДокумента.ИмяРеквизитаСотрудник];
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ПометкаУдаления", ПометкаУдаления);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦепочкиДокументов.Основание,
		|	ЦепочкиДокументов.Подчиненный,
		|	ВЫБОР
		|		КОГДА &Сотрудник = НЕОПРЕДЕЛЕНО
		|			ТОГДА ЦепочкиДокументов.СотрудникОснования
		|		ИНАЧЕ &Сотрудник
		|	КОНЕЦ КАК СотрудникОснования,
		|	&Организация КАК ОрганизацияОснования,
		|	ЦепочкиДокументов.ИдентификаторСтрокиОснования,
		|	&ПометкаУдаления КАК ПометкаУдаленияОснования,
		|	ЦепочкиДокументов.СотрудникПодчиненного,
		|	ЦепочкиДокументов.ПометкаУдаленияПодчиненного
		|ИЗ
		|	РегистрСведений.ЦепочкиДокументов КАК ЦепочкиДокументов
		|ГДЕ
		|	ЦепочкиДокументов.Основание = &Ссылка
		|	И (ЦепочкиДокументов.ПометкаУдаленияОснования <> &ПометкаУдаления
		|	ИЛИ ЦепочкиДокументов.ОрганизацияОснования <> &Организация
		|	ИЛИ (ЦепочкиДокументов.СотрудникОснования <> &Сотрудник
		|	И &Сотрудник <> НЕОПРЕДЕЛЕНО))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦепочкиДокументов.Основание,
		|	ЦепочкиДокументов.Подчиненный,
		|	ЦепочкиДокументов.СотрудникОснования,
		|	ЦепочкиДокументов.ОрганизацияОснования,
		|	ЦепочкиДокументов.ИдентификаторСтрокиОснования,
		|	ЦепочкиДокументов.ПометкаУдаленияОснования,
		|	&Сотрудник,
		|	&ПометкаУдаления
		|ИЗ
		|	РегистрСведений.ЦепочкиДокументов КАК ЦепочкиДокументов
		|ГДЕ
		|	ЦепочкиДокументов.Подчиненный = &Ссылка
		|	И (ЦепочкиДокументов.ПометкаУдаленияПодчиненного <> &ПометкаУдаления
		|	ИЛИ ЦепочкиДокументов.СотрудникПодчиненного <> &Сотрудник)";
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ЦепочкиДокументов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.Записать(Истина);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Возвращает таблицу значений с документами, которые были введены на основании массива документов основания,
// переданных в качестве параметра.
// 
// Параметры:
//  ДокументыОснование - ОпределяемыйТип.ЦепочкиДокументовПодчиненные, Массив из ОпределяемыйТип.ЦепочкиДокументовПодчиненные -
//  ИдентификаторСтрокиОснования - УникальныйИдентификатор, Неопределено -
//  
// Возвращаемое значение:
//  см. ТаблицаЗамещений
Функция ПодчиненныеДокументы(Знач ДокументыОснование, Знач ИдентификаторСтрокиОснования = Неопределено) Экспорт
	
	Если ТипЗнч(ДокументыОснование) <> Тип("Массив") Тогда
		ДокументыОснование = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументыОснование);
	КонецЕсли;
	ТаблицаЗамещений = ТаблицаЗамещений(ТекстЗапросаПодчиненныеДокументы(), "ДокументыОснование", ДокументыОснование);
	
	Если ЗначениеЗаполнено(ИдентификаторСтрокиОснования) Тогда
		Результат = ТаблицаЗамещений.Скопировать(Новый Структура("ИдентификаторСтрокиОснования",
			ИдентификаторСтрокиОснования));
	Иначе
		Результат = ТаблицаЗамещений;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ДокументСсылка - ОпределяемыйТип.ЦепочкиДокументовОснования
//  КлючСтроки - Структура:
//   * Основание - ДокументСсылка.ПриостановлениеТрудовыхДоговоровКонтрактов -
//   * ИдентификаторСтрокиОснования - УникальныйИдентификатор -
//  ТаблицаПодчиненныхДокументов - см. ЦепочкиДокументов.ПодчиненныеДокументы
// 
// Возвращаемое значение:
//  Массив из Структура
Функция ДокументыПодчиненныеСтроке(ДокументСсылка, КлючСтроки, ТаблицаПодчиненныхДокументов = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Если ТаблицаПодчиненныхДокументов = Неопределено Тогда
		ТаблицаПодчиненныхДокументов = ПодчиненныеДокументы(ДокументСсылка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаблицаПодчиненныхДокументов) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбщегоНазначенияБЗК.ДобавитьИндексКоллекции(ТаблицаПодчиненныхДокументов,
		ОбщегоНазначенияКлиентСервер.КлючиСтруктурыВСтроку(КлючСтроки));
	НайденныеСтроки = ТаблицаПодчиненныхДокументов.НайтиСтроки(КлючСтроки);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Результат.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяСтрока));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу значений с документами, являющимися основаниями для массива подчиненных документов,
// переданных в качестве параметра.
// 
// Параметры:
//	ПодчиненныеДокументы - ОпределяемыйТип.ЦепочкиДокументовПодчиненные, Массив из ОпределяемыйТип.ЦепочкиДокументовПодчиненные -
//	
// Возвращаемое значение:
//  см. ТаблицаЗамещений
Функция ДокументыОснования(Знач ПодчиненныеДокументы) Экспорт
	
	Если ТипЗнч(ПодчиненныеДокументы) <> Тип("Массив") Тогда
		ПодчиненныеДокументы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПодчиненныеДокументы);
	КонецЕсли;
	Результат = ТаблицаЗамещений(ТекстЗапросаДокументыОснования(), "ПодчиненныеДокументы", ПодчиненныеДокументы);
	Возврат Результат;
	
КонецФункции

// Возвращает документ Основание для Подчиненного документа.
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка
// 
// Возвращаемое значение:
//  Неопределено, ОпределяемыйТип.ЦепочкиДокументовОснования - 
Функция ДокументОснование(ДокументСсылка) Экспорт

	Возврат ДанныеДокументаОснования(ДокументСсылка).Основание;

КонецФункции

