Процедура ОбновитьПериодичностьВыдачиСИЗРабочихМест(РабочиеМеста)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("РабочиеМеста", РабочиеМеста);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СправочникРабочиеМеста.Ссылка КАК РабочееМесто,
		|	ВЫБОР
		|		КОГДА ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА
		|			ИЗ
		|				РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
		|			ГДЕ
		|				СИЗРабочегоМеста.РабочееМесто = СправочникРабочиеМеста.Ссылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьСИЗ
		|ИЗ
		|	Справочник.РабочиеМестаОхраныТруда КАК СправочникРабочиеМеста
		|ГДЕ
		|	СправочникРабочиеМеста.Ссылка В (&РабочиеМеста)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СправочникДолжности.Ссылка,
		|	ВЫБОР
		|		КОГДА ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА
		|			ИЗ
		|				РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
		|			ГДЕ
		|				СИЗРабочегоМеста.РабочееМесто = СправочникДолжности.Ссылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|ИЗ
		|	Справочник.Должности КАК СправочникДолжности
		|ГДЕ
		|	СправочникДолжности.Ссылка В (&РабочиеМеста)
		|
		|УПОРЯДОЧИТЬ ПО
		|	РабочееМесто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СИЗРабочегоМеста.РабочееМесто КАК РабочееМесто,
		|	СИЗРабочегоМеста.Количество КАК Количество,
		|	СИЗРабочегоМеста.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СИЗРабочегоМеста.КратностьВыдачи КАК Кратность,
		|	СИЗРабочегоМеста.ПериодичностьВыдачи КАК Периодичность,
		|	СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичности,
		|	СИЗРабочегоМеста.СпособВыдачи КАК СпособВыдачи,
		|	СИЗРабочегоМеста.СИЗ.Наименование КАК СИЗНаименование
		|ИЗ
		|	РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
		|ГДЕ
		|	СИЗРабочегоМеста.РабочееМесто В (&РабочиеМеста)
		|
		|УПОРЯДОЧИТЬ ПО
		|	РабочееМесто";
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаРабочихМест = РезультатыЗапроса[0].Выбрать();
	ВыборкаСИЗ = РезультатыЗапроса[1].Выбрать();
	Пока ВыборкаРабочихМест.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ПериодичностьВыдачиСИЗРабочихМест.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.РабочееМесто.Установить(ВыборкаРабочихМест.РабочееМесто);
		Если Не ВыборкаРабочихМест.ЕстьСИЗ Тогда
			НаборЗаписей.Записать();
			Продолжить;
		КонецЕсли;
		ПредставленияСИЗ = ПредставленияСИЗ();
		ОписанияПериодичности = Новый Массив;
		ВыборкаСИЗ.СледующийПоЗначениюПоля("РабочееМесто");
		Пока ВыборкаСИЗ.Следующий() Цикл
			Описание = ОписаниеПериодичностиВыдачи();
			ЗаполнитьЗначенияСвойств(Описание, ВыборкаСИЗ);
			ОписанияПериодичности.Добавить(Описание);
			ДополнитьПредставленияСИЗ(ПредставленияСИЗ, ВыборкаСИЗ);
		КонецЦикла;
		МинимальнаяПериодичность = МинимальнаяПериодичность(ОписанияПериодичности);
		СтрокаНабора = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНабора, ПредставленияСИЗ);
		СтрокаНабора.РабочееМесто = ВыборкаРабочихМест.РабочееМесто;
		СтрокаНабора.СпособВыдачи = МинимальнаяПериодичность.СпособВыдачи;
		СтрокаНабора.КратностьВыдачи = МинимальнаяПериодичность.Кратность;
		СтрокаНабора.ПериодичностьВыдачи = МинимальнаяПериодичность.Периодичность;
		СтрокаНабора.ЕдиницаПериодичностиВыдачи = МинимальнаяПериодичность.ЕдиницаПериодичности;
		СтрокаНабора.ПредставлениеПериодичностиВыдачи = МинимальнаяПериодичность.Представление;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНедопустимыеСимволы(Строка)
	НедопустимыеСимволы = """'`/\[]{}:;|-=?*<>,.()+#№@!%^&~«»";
	Строка = СтрСоединить(СтрРазделить(Строка, НедопустимыеСимволы, Истина));
КонецПроцедуры

Процедура ЗаписатьНастройкиОхраныТруда(Организация)
	
	НастройкиОхраныТруда = РегистрыСведений.НастройкиОхраныТруда.СоздатьНаборЗаписей();
	НастройкиОхраныТруда.Отбор.Организация.Установить(Организация);
	НастройкиОхраныТруда.Прочитать();
	Для Каждого Настройка Из НастройкиОхраныТруда Цикл
		Настройка.ИспользоватьСредстваИндивидуальнойЗащиты = Истина;
	КонецЦикла;
	НастройкиОхраныТруда.Записать();
	
КонецПроцедуры

Процедура ВыполнитьНачальноеЗаполнениеСправочниковСИЗ()

	ПредустановленныеВидыНоменклатуры = Справочники.ВидыНоменклатуры.ПолучитьПредустановленныеВидыНоменклатуры();
	Справочники.СредстваИндивидуальнойЗащиты.НачальноеЗаполнение(ПредустановленныеВидыНоменклатуры);

КонецПроцедуры

#Область ПодборПодходящейНоменклатуры

Процедура ПодобратьПодходящуюНоменклатуру(СИЗ, ЗаполнятьРезультатВыдачи = Истина) Экспорт
	
	Если СИЗ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(СИЗ) = Тип("ДанныеФормыКоллекция") Тогда
		МассивСИЗ = СИЗ.Выгрузить().ВыгрузитьКолонку("СИЗ");
	Иначе
		МассивСИЗ = СИЗ.ВыгрузитьКолонку("СИЗ");
	КонецЕсли;
	
	Запрос = ЗапросПодходящейНоменклатуры(МассивСИЗ);
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.СледующийПоЗначениюПоля("СИЗ") Цикл
		СИЗРабочихМест = СИЗ.НайтиСтроки(Новый Структура("СИЗ", ВыборкаДетальныеЗаписи.СИЗ));
		Для Каждого НайденныйСИЗ Из СИЗРабочихМест Цикл
			НайденныйСИЗ.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
			Если Не ЗаполнятьРезультатВыдачи Тогда
				Продолжить;
			КонецЕсли;
			НайденныйСИЗ.РезультатВыдачи = Перечисления.РезультатыВыдачиСИЗ.Выдано;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗапросПодходящейНоменклатуры(МассивСИЗ)
	
	// Основной запрос
	ЗапросОсновной = Новый Запрос;
	ЗапросОсновной.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
		|	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
		|	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
		|ПОМЕСТИТЬ ВТСвойстваНоменклатуры
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|		ПО Номенклатура.Ссылка = НоменклатураДополнительныеРеквизиты.Ссылка
		|ГДЕ
		|	Номенклатура.ВидНоменклатуры В (&ВидыНоменклатуры)
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
		|	КОЛИЧЕСТВО(Номенклатура.Свойство) КАК КоличествоСвойств
		|ПОМЕСТИТЬ ВТНоменклатура
		|ИЗ
		|	ВТСвойстваНоменклатуры КАК Номенклатура
		|СГРУППИРОВАТЬ ПО
		|	Номенклатура.Ссылка,
		|	Номенклатура.ВидНоменклатуры
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВидНоменклатуры";
	
	ТекстЗапросаНоменклатурыПоСвойствам = ТекстЗапросаНоменклатурыПоСвойствам(МассивСИЗ, ЗапросОсновной);
	Если ПустаяСтрока(ТекстЗапросаНоменклатурыПоСвойствам) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапросаКонец =
		"ВЫБРАТЬ
		|	ПодходящаяНоменклатура.СИЗ КАК СИЗ,
		|	ПодходящаяНоменклатура.Номенклатура КАК Номенклатура,
		|	ПодходящаяНоменклатура.Приоритет КАК Приоритет,
		|	ПодходящаяНоменклатура.ДельтаСвойств КАК ДельтаСвойств,
		|	СУММА(ПодходящаяНоменклатура.Количество) КАК Количество
		|ИЗ
		|	ВТПодходящаяНоменклатура КАК ПодходящаяНоменклатура
		|СГРУППИРОВАТЬ ПО
		|	ПодходящаяНоменклатура.СИЗ,
		|	ПодходящаяНоменклатура.Номенклатура,
		|	ПодходящаяНоменклатура.Приоритет,
		|	ПодходящаяНоменклатура.ДельтаСвойств
		|ИМЕЮЩИЕ
		|	СУММА(ПодходящаяНоменклатура.Количество) > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	СИЗ,
		|	Приоритет,
		|	Количество УБЫВ,
		|	ДельтаСвойств";
	
	ЗапросОсновной.Текст = ЗарплатаКадрыОбщиеНаборыДанных.ТекстОбъединенногоЗапроса(
		ЗапросОсновной.Текст, ТекстЗапросаНоменклатурыПоСвойствам, ТекстЗапросаКонец);
	
	Возврат ЗапросОсновной;
	
КонецФункции

Функция ТекстЗапросаНоменклатурыПоСвойствам(МассивСИЗ, ЗапросОсновной)
	
	ЗапросСИЗ = Новый Запрос;
	ЗапросСИЗ.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СредстваИндивидуальнойЗащиты.Ссылка КАК Ссылка,
		|	СредстваИндивидуальнойЗащиты.ВидНоменклатуры КАК ВидНоменклатуры,
		|	СредстваИндивидуальнойЗащиты.НоменклатураПоУмолчанию КАК НоменклатураПоУмолчанию,
		|	СредстваИндивидуальнойЗащитыДополнительныеРеквизиты.Свойство,
		|	СредстваИндивидуальнойЗащитыДополнительныеРеквизиты.Значение,
		|	ВЫБОР
		|		КОГДА СредстваИндивидуальнойЗащитыДополнительныеРеквизиты.Свойство ЕСТЬ NULL
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК КоличествоСвойств
		|ИЗ
		|	Справочник.СредстваИндивидуальнойЗащиты КАК СредстваИндивидуальнойЗащиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СредстваИндивидуальнойЗащиты.ДополнительныеРеквизиты КАК
		|			СредстваИндивидуальнойЗащитыДополнительныеРеквизиты
		|		ПО СредстваИндивидуальнойЗащиты.Ссылка = СредстваИндивидуальнойЗащитыДополнительныеРеквизиты.Ссылка
		|ГДЕ
		|	СредстваИндивидуальнойЗащиты.Ссылка В (&СИЗ)
		|ИТОГИ
		|	МАКСИМУМ(ВидНоменклатуры) КАК ВидНоменклатуры,
		|	МАКСИМУМ(НоменклатураПоУмолчанию) КАК НоменклатураПоУмолчанию,
		|	СУММА(КоличествоСвойств)
		|ПО
		|	Ссылка";
	
	ЗапросСИЗ.УстановитьПараметр("СИЗ", МассивСИЗ);
	ВыборкаСсылка = ЗапросСИЗ.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Сч = 1;
	СчСвойств = 1;
	ПервыйПроход = Истина;
	ТекстыЗапросов = Новый Массив;
	ВидыНоменклатуры = Новый Массив;
	
	Пока ВыборкаСсылка.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаСсылка.НоменклатураПоУмолчанию) Тогда
			Если ПервыйПроход Тогда
				ТекстФрагмента = 
					"ВЫБРАТЬ
					|	&СИЗ КАК СИЗ,
					|	&Номенклатура КАК Номенклатура,
					|	1 КАК Приоритет,
					|	0 КАК ДельтаСвойств,
					|	1 КАК Количество
					|ПОМЕСТИТЬ ВТПодходящаяНоменклатура";
			Иначе
				ТекстФрагмента = 
					"ВЫБРАТЬ
					|	&СИЗ,
					|	&Номенклатура,
					|	1,
					|	0,
					|	1";
			КонецЕсли;
			ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&СИЗ", "&СИЗ" + Сч);
			ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&Номенклатура", "&Номенклатура" + Сч);
			ЗапросОсновной.УстановитьПараметр("СИЗ" + Сч, ВыборкаСсылка.Ссылка);
			ЗапросОсновной.УстановитьПараметр("Номенклатура" + Сч, ВыборкаСсылка.НоменклатураПоУмолчанию);
			ТекстыЗапросов.Добавить(ТекстФрагмента);
			Сч = Сч + 1;
			ПервыйПроход = Ложь;
			Продолжить;
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(ВыборкаСсылка.КоличествоСвойств) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПервыйПроход Тогда
			ТекстФрагмента = 
				"ВЫБРАТЬ
				|	&СИЗ КАК СИЗ,
				|	Номенклатура.Ссылка КАК Номенклатура,
				|	3 КАК Приоритет,
				|	ВЫБОР
				|		КОГДА &КоличествоСвойствСИЗ - Номенклатура.КоличествоСвойств < 0
				|			ТОГДА Номенклатура.КоличествоСвойств - &КоличествоСвойствСИЗ
				|		ИНАЧЕ &КоличествоСвойствСИЗ - Номенклатура.КоличествоСвойств
				|	КОНЕЦ КАК ДельтаСвойств,
				|	1 КАК Количество
				|ПОМЕСТИТЬ ВТПодходящаяНоменклатура
				|ИЗ
				|	ВТНоменклатура КАК Номенклатура
				|ГДЕ
				|	Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";
		Иначе
			ТекстФрагмента = 
				"ВЫБРАТЬ
				|	&СИЗ,
				|	Номенклатура.Ссылка,
				|	3,
				|	ВЫБОР
				|		КОГДА &КоличествоСвойствСИЗ - Номенклатура.КоличествоСвойств < 0
				|			ТОГДА Номенклатура.КоличествоСвойств - &КоличествоСвойствСИЗ
				|		ИНАЧЕ &КоличествоСвойствСИЗ - Номенклатура.КоличествоСвойств
				|	КОНЕЦ,
				|	1
				|ИЗ
				|	ВТНоменклатура КАК Номенклатура
				|ГДЕ
				|	Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";
		КонецЕсли;
		ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&СИЗ", "&СИЗ" + Сч);
		ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&ВидНоменклатуры", "&ВидНоменклатуры" + Сч);
		ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&КоличествоСвойствСИЗ", "&КоличествоСвойствСИЗ" + Сч);
		ЗапросОсновной.УстановитьПараметр("СИЗ" + Сч, ВыборкаСсылка.Ссылка);
		ЗапросОсновной.УстановитьПараметр("ВидНоменклатуры" + Сч, ВыборкаСсылка.ВидНоменклатуры);
		ЗапросОсновной.УстановитьПараметр("КоличествоСвойствСИЗ" + Сч, ВыборкаСсылка.КоличествоСвойств);
		ТекстыЗапросов.Добавить(ТекстФрагмента);
		
		ВидыНоменклатуры.Добавить(ВыборкаСсылка.ВидНоменклатуры);
		
		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ТекстФрагмента = 
				"ВЫБРАТЬ
				|	&СИЗ,
				|	СвойстваНоменклатуры.Ссылка,
				|	2,
				|	ВЫБОР
				|		КОГДА &КоличествоСвойствСИЗ - Номенклатура.КоличествоСвойств < 0
				|			ТОГДА Номенклатура.КоличествоСвойств - &КоличествоСвойствСИЗ
				|		ИНАЧЕ &КоличествоСвойствСИЗ - Номенклатура.КоличествоСвойств
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА СвойстваНоменклатуры.Значение = &Значение
				|			ТОГДА 1
				|		ИНАЧЕ 0
				|	КОНЕЦ
				|ИЗ
				|	ВТСвойстваНоменклатуры КАК СвойстваНоменклатуры
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНоменклатура КАК Номенклатура
				|		ПО Номенклатура.Ссылка = СвойстваНоменклатуры.Ссылка
				|		И СвойстваНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
				|		И СвойстваНоменклатуры.Свойство = &Свойство
				|		И СвойстваНоменклатуры.Значение = &Значение";
			ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&СИЗ", "&СИЗ" + Сч);
			ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&ВидНоменклатуры", "&ВидНоменклатуры" + Сч);
			ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&КоличествоСвойствСИЗ", "&КоличествоСвойствСИЗ" + Сч);
			ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&Свойство", "&Свойство" + СчСвойств);
			ТекстФрагмента = СтрЗаменить(ТекстФрагмента, "&Значение", "&Значение" + СчСвойств);
			ЗапросОсновной.УстановитьПараметр("Свойство" + СчСвойств, ВыборкаДетальныеЗаписи.Свойство);
			ЗапросОсновной.УстановитьПараметр("Значение" + СчСвойств, ВыборкаДетальныеЗаписи.Значение);
			ТекстыЗапросов.Добавить(ТекстФрагмента);
			СчСвойств = СчСвойств + 1;
		КонецЦикла;
		Сч = Сч + 1;
		ПервыйПроход = Ложь;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТекстыЗапросов) Тогда
		Возврат "";
	КонецЕсли;
	
	ЗапросОсновной.УстановитьПараметр("ВидыНоменклатуры", ВидыНоменклатуры);
	
	Возврат СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ВыдачаСИЗБезНорм

// Дополняет дерево данных отчёта строками СИЗ, выданных сотруднику, но не имеющих соответствующей нормы выдачи в текущих данных дерева.
//
// Параметры:
//  Данные       - ДеревоЗначений - дерево данных отчёта, сформированное КД
//  ДляДежурных  - Булево         - Истина для карточки дежурных СИЗ, Ложь для личной карточки
//
Процедура ДополнитьДанныеВыданнымиСИЗБезНорм(Данные, ДляДежурных = Ложь) Экспорт

	ФизическиеЛица = Новый Массив;
	СотрудникиПоФизЛицам = Новый Соответствие;
	СтрокиСИЗПоФизЛицам = Новый Соответствие;
	НормыСИЗПоФизЛицам = Новый Соответствие;

	Для Каждого СтрокаДанных Из Данные.Строки Цикл
		Если Не ЗначениеЗаполнено(СтрокаДанных.ФизическоеЛицо) Тогда
			Продолжить;
		КонецЕсли;

		ФизическоеЛицо = СтрокаДанных.ФизическоеЛицо;
		Если СотрудникиПоФизЛицам.Получить(ФизическоеЛицо) = Неопределено Тогда
			ФизическиеЛица.Добавить(ФизическоеЛицо);
			СотрудникиПоФизЛицам.Вставить(ФизическоеЛицо, СтрокаДанных);
		КонецЕсли;

		СтрокиСИЗ = Новый Соответствие;
		НормыСИЗ = Новый Соответствие;
		Для Каждого СтрокаСИЗ Из СтрокаДанных.Строки Цикл
			Если ЗначениеЗаполнено(СтрокаСИЗ.СИЗ) Тогда
				СтрокиСИЗ.Вставить(СтрокаСИЗ.СИЗ, СтрокаСИЗ);
				НормыСИЗ.Вставить(СтрокаСИЗ.СИЗ, Истина);
			КонецЕсли;
		КонецЦикла;

		СтрокиСИЗПоФизЛицам.Вставить(ФизическоеЛицо, СтрокиСИЗ);
		НормыСИЗПоФизЛицам.Вставить(ФизическоеЛицо, НормыСИЗ);
	КонецЦикла;

	Если ФизическиеЛица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВыборкаПоВыданнымСИЗ = ПолучитьВыборкуВыданныхСИЗБезНорм(ФизическиеЛица, ДляДежурных);
	Пока ВыборкаПоВыданнымСИЗ.Следующий() Цикл
		Если Не ЗначениеЗаполнено(ВыборкаПоВыданнымСИЗ.СИЗНоменклатуры)
			Или ВыборкаПоВыданнымСИЗ.ДежурноеВыдачи <> ДляДежурных Тогда
			Продолжить;
		КонецЕсли;

		ФизическоеЛицо = ВыборкаПоВыданнымСИЗ.ФизическоеЛицо;
		НормыСИЗ = НормыСИЗПоФизЛицам.Получить(ФизическоеЛицо);
		Если НормыСИЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НормыСИЗ.Получить(ВыборкаПоВыданнымСИЗ.СИЗНоменклатуры) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаДанных = СотрудникиПоФизЛицам.Получить(ФизическоеЛицо);
		СтрокиСИЗ = СтрокиСИЗПоФизЛицам.Получить(ФизическоеЛицо);

		СтрокаСИЗ = СтрокиСИЗ.Получить(ВыборкаПоВыданнымСИЗ.СИЗНоменклатуры);
		Если СтрокаСИЗ = Неопределено Тогда
			СтрокаСИЗ = СтрокаДанных.Строки.Добавить();
			СтрокаСИЗ.СИЗ = ВыборкаПоВыданнымСИЗ.СИЗНоменклатуры;
			СтрокаСИЗ.ЕдиницаИзмеренияПериодичность = ВыборкаПоВыданнымСИЗ.ЕдиницаИзмерения;
			СтрокиСИЗ.Вставить(ВыборкаПоВыданнымСИЗ.СИЗНоменклатуры, СтрокаСИЗ);
		КонецЕсли;

		НоваяСтрокаВыдачи = СтрокаСИЗ.Строки.Добавить();
		НоваяСтрокаВыдачи.СИЗ = ВыборкаПоВыданнымСИЗ.СИЗНоменклатуры;
		НоваяСтрокаВыдачи.СИЗНоменклатуры = ВыборкаПоВыданнымСИЗ.СИЗНоменклатуры;
		НоваяСтрокаВыдачи.Номенклатура = ВыборкаПоВыданнымСИЗ.Номенклатура;
		НоваяСтрокаВыдачи.ДокументВыдачи = ВыборкаПоВыданнымСИЗ.ДокументВыдачи;
		НоваяСтрокаВыдачи.Выдано = ВыборкаПоВыданнымСИЗ.Выдано;
		НоваяСтрокаВыдачи.Возвращено = ВыборкаПоВыданнымСИЗ.Возвращено;
		НоваяСтрокаВыдачи.ДатаВыдачи = ВыборкаПоВыданнымСИЗ.ДатаВыдачи;
		НоваяСтрокаВыдачи.ДатаВозврата = ВыборкаПоВыданнымСИЗ.ДатаВозврата;
		НоваяСтрокаВыдачи.АктСписания = ПредставлениеАктаСписанияСИЗ(ВыборкаПоВыданнымСИЗ.ДатаВозврата,
			ВыборкаПоВыданнымСИЗ.НомерАктаСписания, ВыборкаПоВыданнымСИЗ.НомерПриказаАктаСписания);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьВыборкуВыданныхСИЗБезНорм(ФизическиеЛица, ДляДежурных)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВыданныеСИЗ.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыданныеСИЗ.СИЗ КАК СИЗНоменклатуры,
		|	ВыданныеСИЗ.Номенклатура КАК Номенклатура,
		|	ВыданныеСИЗ.ДокументВыдачи КАК ДокументВыдачи,
		|	СУММА(ВЫБОР
		|		КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ВыданныеСИЗ.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ) КАК Выдано,
		|	СУММА(ВЫБОР
		|		КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА ВыданныеСИЗ.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ) КАК Возвращено,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ВыданныеСИЗ.Период
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ) КАК ДатаВыдачи,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА ВыданныеСИЗ.Период
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ) КАК ДатаВозврата,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА ВЫРАЗИТЬ(ВыданныеСИЗ.Регистратор КАК Документ.СписаниеСИЗИзЭксплуатации).НомерПриказа
		|		ИНАЧЕ """"
		|	КОНЕЦ) КАК НомерПриказаАктаСписания,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА ВЫРАЗИТЬ(ВыданныеСИЗ.Регистратор КАК Документ.СписаниеСИЗИзЭксплуатации).Номер
		|		ИНАЧЕ """"
		|	КОНЕЦ) КАК НомерАктаСписания,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВыданныеСИЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ВыданныеСИЗ.Дежурное
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ) КАК ДежурноеВыдачи,
		|	МАКСИМУМ(ВыданныеСИЗ.СИЗ.ЕдиницаИзмерения) КАК ЕдиницаИзмерения
		|ИЗ
		|	РегистрНакопления.ВыданныеСИЗ КАК ВыданныеСИЗ
		|ГДЕ
		|	ВыданныеСИЗ.ФизическоеЛицо В (&ФизическиеЛица)
		|	И ВыданныеСИЗ.Дежурное = &Дежурное
		|СГРУППИРОВАТЬ ПО
		|	ВыданныеСИЗ.ФизическоеЛицо,
		|	ВыданныеСИЗ.СИЗ,
		|	ВыданныеСИЗ.Номенклатура,
		|	ВыданныеСИЗ.ДокументВыдачи
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо,
		|	СИЗНоменклатуры,
		|	ДатаВыдачи,
		|	ДатаВозврата";

	Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛица);
	Запрос.УстановитьПараметр("Дежурное", ДляДежурных);

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция ПредставлениеАктаСписанияСИЗ(ДатаВозврата, НомерАктаСписания, НомерПриказаАктаСписания)

	Если Не ЗначениеЗаполнено(ДатаВозврата) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("%1, %2", Формат(ДатаВозврата, "ДЛФ=D"),
		ЗарплатаКадрыОтчеты.НомерНаПечать(НомерАктаСписания, НомерПриказаАктаСписания));

КонецФункции

