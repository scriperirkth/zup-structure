#Область ОбменДанными

Процедура ПриЗаполненииТаблицыЗависимыхДанныхДляОбмена(ЗависимыеДанные) Экспорт
	
	// Метаданные.РегистрыСведений.КадроваяИсторияСотрудников
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.КадроваяИсторияСотрудников;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеВыдачСИЗ;
	
	// Метаданные.РегистрыСведений.РабочиеМестаСотрудников
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.РабочиеМестаСотрудников;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеВыдачСИЗ;
	
	// Метаданные.РегистрыСведений.ВыдачиСИЗПоНоменклатуре
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.ВыдачиСИЗПоНоменклатуре;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеВыдачСИЗ;
	
	// Метаданные.РегистрыСведений.ПериодичностьВыдачиСИЗРабочихМест
	НоваяСтрока = ЗависимыеДанные.Добавить();
	НоваяСтрока.ВедущиеМетаданные = Метаданные.РегистрыСведений.ПериодичностьВыдачиСИЗРабочихМест;
	НоваяСтрока.ЗависимыеМетаданные = Метаданные.РегистрыСведений.ОбновлениеВыдачСИЗ;
	
КонецПроцедуры

Процедура ЗаполнитьЗависимыеДанныеПослеСозданияНовогоУзла() Экспорт
	
	Если Не СредстваИндивидуальнойЗащитыИспользуются() Тогда
		Возврат;
	КонецЕсли;
	
	// После создания нового узла нужно полностью заполнить вторичные данные, 
	// т.к. они не включаются в состав начального образа.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|ГДЕ
		|	НЕ ФизическиеЛица.Ссылка В (&Обработанные)";
	
	Обработанные = Новый Массив;
	Пока Истина Цикл
		Запрос.УстановитьПараметр("Обработанные", Обработанные);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли;
		ФизическиеЛица = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ФизическоеЛицо");
		ТаблицаОбновления = НоваяТаблицаОбновлениеВыдачиСИЗ();
		ЗаполнитьТаблицуОбновленияВыдачиСИЗПоФизическимЛицам(ТаблицаОбновления, ФизическиеЛица);
		ЗарегистрироватьОбновлениеВыдачиСИЗ(ТаблицаОбновления);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Обработанные, ФизическиеЛица);
	КонецЦикла;
	
	ЗапуститьОбновлениеВыдачСИЗ();
	
КонецПроцедуры

#КонецОбласти

Функция СредстваИндивидуальнойЗащитыИспользуются(Организация = Неопределено) Экспорт
	
	Возврат ОхранаТруда.ОхранаТрудаИспользуется(Организация)
		И ОхранаТруда.ФункциональнаяОпцияОрганизацийИспользуется(Организация, "ИспользоватьСредстваИндивидуальнойЗащиты");
	
КонецФункции

Функция ДанныеСредствИндивидуальнойЗащитыИнтеграцияУправлениеПерсоналом(ФизическиеЛица) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛица);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВыдачиСИЗ.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	ВыдачиСИЗ.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗ.РабочееМесто КАК РабочееМестоОхраныТруда,
		|	ВЫБОР
		|		КОГДА АктуальныеЗаказыНаВыдачуСИЗ.ЗаказНаВыдачуСИЗ ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА ВыдачиСИЗ.РезультатВыдачи = ЗНАЧЕНИЕ(Перечисление.РезультатыВыдачиСИЗ.ПустаяСсылка)
		|						ТОГДА НЕОПРЕДЕЛЕНО
		|					ИНАЧЕ ВыдачиСИЗ.РезультатВыдачи
		|				КОНЕЦ
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК РезультатВыдачи,
		|	ВыдачиСИЗ.ДатаВыдачи КАК ДатаВыдачи,
		|	ЕСТЬNULL(АктуальныеЗаказыНаВыдачуСИЗ.ДатаЗаказа, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗаказаНаВыдачу,
		|	ВЫРАЗИТЬ(ПериодичностьВыдачиСИЗРабочихМест.ПредставлениеПериодичностиВыдачи КАК СТРОКА(20)) КАК ПериодичностьВыдачи,
		|	ВЫРАЗИТЬ(ПериодичностьВыдачиСИЗРабочихМест.СИЗПолноеПредставление КАК СТРОКА(1000)) КАК ПредставлениеСИЗ
		|ИЗ
		|	РегистрСведений.ВыдачиСИЗ КАК ВыдачиСИЗ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПериодичностьВыдачиСИЗРабочихМест КАК ПериодичностьВыдачиСИЗРабочихМест
		|		ПО ВыдачиСИЗ.РабочееМесто = ПериодичностьВыдачиСИЗРабочихМест.РабочееМесто
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АктуальныеЗаказыНаВыдачуСИЗ КАК АктуальныеЗаказыНаВыдачуСИЗ
		|		ПО (АктуальныеЗаказыНаВыдачуСИЗ.ФизическоеЛицо = ВыдачиСИЗ.ФизическоеЛицо)
		|			И (АктуальныеЗаказыНаВыдачуСИЗ.РабочееМесто = ВыдачиСИЗ.РабочееМесто)
		|			И (АктуальныеЗаказыНаВыдачуСИЗ.ДатаЗаказа >= ВыдачиСИЗ.ДатаВыдачи)
		|ГДЕ
		|	ВыдачиСИЗ.ФизическоеЛицо В(&ФизическиеЛица)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДанныеАнтропометрииИнтеграцияУправлениеПерсоналом(ФизическиеЛица) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛица);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	АнтропометрияФизическихЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВЫБОР
		|		КОГДА АнтропометрияФизическихЛиц.Рост = 0
		|			ТОГДА ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.РостДо)
		|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.Рост)
		|	КОНЕЦ КАК Рост,
		|	ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.РазмерОдежды) КАК РазмерОдежды,
		|	ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.РазмерОбуви) КАК РазмерОбуви,
		|	ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.РазмерГоловногоУбора) КАК РазмерГоловногоУбора,
		|	ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.РазмерПротивогаза) КАК РазмерПротивогаза,
		|	ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.РазмерРеспиратора) КАК РазмерРеспиратора,
		|	ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.РазмерПерчаток) КАК РазмерПерчаток,
		|	ПРЕДСТАВЛЕНИЕ(АнтропометрияФизическихЛиц.РазмерРукавиц) КАК РазмерРукавиц
		|ИЗ
		|	РегистрСведений.АнтропометрияФизическихЛиц КАК АнтропометрияФизическихЛиц
		|ГДЕ
		|	АнтропометрияФизическихЛиц.ФизическоеЛицо В(&ФизическиеЛица)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

