Функция ПолучитьНаборыСвойствДляНоменклатуры(Объект)
	
	Наборы = Новый СписокЗначений;
	НаборСвойств = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Номенклатура_Общие");
	Наборы.Добавить(НаборСвойств, НСтр("ru = 'Общие свойства'"));
	
	НаборСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидНоменклатуры, "НаборСвойств");
	Наборы.Добавить(НаборСвойств, НСтр("ru = 'Свойства для вида номенклатуры'"));
	Возврат Наборы;
	
КонецФункции

Функция ПолучитьНаборыСвойствДляСредствИндивидуальнойЗащиты(Объект)
	
	Наборы = Новый СписокЗначений;
	НаборСвойств = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_СредстваИндивидуальнойЗащиты_Общие");
	Наборы.Добавить(НаборСвойств, НСтр("ru = 'Общие свойства'"));
	
	НаборСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидНоменклатуры, "НаборСвойств");
	Наборы.Добавить(НаборСвойств, НСтр("ru = 'Свойства для вида номенклатуры'"));
	Возврат Наборы;
	
КонецФункции

Функция ПолучитьНаборыСвойствДляХарактеристикНоменклатуры(Объект)
	
	Наборы = Новый СписокЗначений;
	
	НаборСвойств = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_ХарактеристикиНоменклатуры_Общие");
	Наборы.Добавить(НаборСвойств, НСтр("ru = 'Общие свойства характеристик'"));
	
	Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
		НаборСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, "НаборСвойствХарактеристик");
		Наборы.Добавить(НаборСвойств, НСтр("ru = 'Свойства характеристик для вида номенклатуры'"));
	ИначеЕсли ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.Номенклатура") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Объект.Владелец);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НаборСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ВидНоменклатуры, "НаборСвойствХарактеристик");
			Наборы.Добавить(НаборСвойств, НСтр("ru = 'Свойства характеристик для номенклатуры'"));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Наборы;
	
КонецФункции // ПолучитьНаборыСвойствДляХарактеристикНоменклатуры()

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗаполнитьАктуальныеЗаказыНаВыдачуСИЗ(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
		|	СформированныеЗаказыНаВыдачуСИЗ.ФизическоеЛицо,
		|	СформированныеЗаказыНаВыдачуСИЗ.РабочееМесто,
		|	СформированныеЗаказыНаВыдачуСИЗ.ГоловнаяОрганизация
		|ИЗ
		|	РегистрНакопления.СформированныеЗаказыНаВыдачуСИЗ КАК СформированныеЗаказыНаВыдачуСИЗ
		|ГДЕ
		|	НЕ СформированныеЗаказыНаВыдачуСИЗ.ФизическоеЛицо В (&Обработанные)";
	
	Обработанные = Новый Массив;
	Если ПараметрыОбновления = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000","");
	Иначе
		Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
			ПараметрыОбновления.Вставить("Обработанные");
		Иначе
			Обработанные = ПараметрыОбновления.Обработанные;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	ТаблицаОбновления = РезультатЗапроса.Выгрузить();
	ОбновитьАктуальныеЗаказыНаВыдачуСИЗ(ТаблицаОбновления);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Обработанные, ТаблицаОбновления.ВыгрузитьКолонку("ФизическоеЛицо"));
	ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	
КонецПроцедуры

Процедура ОбновитьЧастичноВыданныеСИЗ(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
		|	ВыдачиСИЗ.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗ.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	РегистрСведений.ВыдачиСИЗ КАК ВыдачиСИЗ
		|ГДЕ
		|	ВыдачиСИЗ.РезультатВыдачи В (&РезультатыВыдачи)
		|	И НЕ ВыдачиСИЗ.ФизическоеЛицо В (&Обработанные)";
	
	Обработанные = Новый Массив;
	Если ПараметрыОбновления = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000","");
	Иначе
		Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
			ПараметрыОбновления.Вставить("Обработанные");
		Иначе
			Обработанные = ПараметрыОбновления.Обработанные;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);
	
	РезультатыВыдачи = Новый Массив;
	РезультатыВыдачи.Добавить(Перечисления.РезультатыВыдачиСИЗ.ЧастичноВыдано);
	РезультатыВыдачи.Добавить(Перечисления.РезультатыВыдачиСИЗ.ПустаяСсылка());
	Запрос.УстановитьПараметр("РезультатыВыдачи", РезультатыВыдачи);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаОбновления = НоваяТаблицаОбновлениеВыдачиСИЗ();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), Выборка);
	КонецЦикла;
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьОбновлениеВыдачиСИЗ(ТаблицаОбновления);
	
	ФизическиеЛица = ТаблицаОбновления.ВыгрузитьКолонку("ФизическоеЛицо");
	ЗапуститьОбновлениеВыдачСИЗ(, ФизическиеЛица);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Обработанные, ФизическиеЛица);
	ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);
	
КонецПроцедуры

Процедура ОбновитьВыдачиСИЗУволенныхСотрудников(ПараметрыОбновления) Экспорт
	
	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;
	
	// Составляем перечень рабочих мест для СИЗ.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеМеста.РабочееМесто КАК РабочееМесто
		|ИЗ
		|	РегистрСведений.ПериодичностьВыдачиСИЗРабочихМест КАК РабочиеМеста";
	
	РабочиеМеста = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РабочееМесто");
	
	Если РабочиеМеста.Количество() = 0 Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);
	
	// Получаем уволенных сотрудников.
	ПараметрыЗапроса = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыЗапроса.КадровыеДанные = "ФизическоеЛицо, ГоловнаяОрганизация";
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы, "РабочееМестоОхраныТруда", "В", РабочиеМеста);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыЗапроса.Отборы, "ДатаУвольнения", "<>", Дата(1, 1, 1));
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	УстановитьПривилегированныйРежим(Истина);
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(МенеджерВТ, Ложь, ПараметрыЗапроса);
	УстановитьПривилегированныйРежим(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	ВТСотрудникиОрганизации КАК Сотрудники";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаОбновления = НоваяТаблицаОбновлениеВыдачиСИЗ();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), Выборка);
	КонецЦикла;
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьОбновлениеВыдачиСИЗ(ТаблицаОбновления);
	ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
	
	ФизическиеЛица = ТаблицаОбновления.ВыгрузитьКолонку("ФизическоеЛицо");
	ЗапуститьОбновлениеВыдачСИЗ(, ФизическиеЛица);
	
КонецПроцедуры

Процедура ЗаполнитьДежурноеВВыданныхСИЗ(ПараметрыОбновления) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВыданныеСИЗ.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ВыданныеСИЗ КАК ВыданныеСИЗ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыдачаСИЗ.НоменклатураСИЗ КАК НоменклатураСИЗ
		|		ПО ВыданныеСИЗ.Регистратор = НоменклатураСИЗ.Ссылка
		|			И ВыданныеСИЗ.СИЗ = НоменклатураСИЗ.СИЗ
		|			И ВыданныеСИЗ.Номенклатура = НоменклатураСИЗ.Номенклатура
		|			И ВыданныеСИЗ.ХарактеристикаНоменклатуры = НоменклатураСИЗ.ХарактеристикаНоменклатуры
		|ГДЕ
		|	НЕ ВыданныеСИЗ.Дежурное
		|	И НоменклатураСИЗ.Дежурное
		|	И НЕ ВыданныеСИЗ.Регистратор В (&Обработанные)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВыданныеСИЗ.Регистратор
		|ИЗ
		|	РегистрНакопления.ВыданныеСИЗ КАК ВыданныеСИЗ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатковВыданныхСИЗ.НоменклатураСИЗ КАК НоменклатураСИЗ
		|		ПО ВыданныеСИЗ.Регистратор = НоменклатураСИЗ.Ссылка
		|			И ВыданныеСИЗ.СИЗ = НоменклатураСИЗ.СИЗ
		|			И ВыданныеСИЗ.Номенклатура = НоменклатураСИЗ.Номенклатура
		|			И ВыданныеСИЗ.ХарактеристикаНоменклатуры = НоменклатураСИЗ.ХарактеристикаНоменклатуры
		|ГДЕ
		|	НЕ ВыданныеСИЗ.Дежурное
		|	И НоменклатураСИЗ.Дежурное
		|	И НЕ ВыданныеСИЗ.Регистратор В (&Обработанные)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВыданныеСИЗ.Регистратор
		|ИЗ
		|	РегистрНакопления.ВыданныеСИЗ КАК ВыданныеСИЗ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеСИЗИзЭксплуатации.НоменклатураСИЗ КАК НоменклатураСИЗ
		|		ПО ВыданныеСИЗ.Регистратор = НоменклатураСИЗ.Ссылка
		|			И ВыданныеСИЗ.СИЗ = НоменклатураСИЗ.СИЗ
		|			И ВыданныеСИЗ.Номенклатура = НоменклатураСИЗ.Номенклатура
		|			И ВыданныеСИЗ.ХарактеристикаНоменклатуры = НоменклатураСИЗ.ХарактеристикаНоменклатуры
		|ГДЕ
		|	НЕ ВыданныеСИЗ.Дежурное
		|	И НоменклатураСИЗ.Дежурное
		|	И НЕ ВыданныеСИЗ.Регистратор В (&Обработанные)";

	Обработанные = Новый Массив;
	Если ПараметрыОбновления <> Неопределено Тогда
		Если Не ПараметрыОбновления.Свойство("Обработанные") Тогда
			ПараметрыОбновления.Вставить("Обработанные");
		Иначе
			Обработанные = ПараметрыОбновления.Обработанные;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Обработанные", Обработанные);

	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = ОбновлениеИБ.ВыполнитьЗапросПолученияОбновляемыхДанных(Запрос, ПараметрыОбновления);
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;

	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ОбновлениеИБ.ПодготовитьОбновлениеДанных(
			ПараметрыОбновления, "РегистрНакопления.ВыданныеСИЗ.НаборЗаписей", "Регистратор", Выборка.Регистратор) Тогда
			Продолжить;
		КонецЕсли;

		НаборЗаписей = РегистрыНакопления.ВыданныеСИЗ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();

		ДокументОбъект = Выборка.Регистратор.ПолучитьОбъект();

		СоответствиеФизЛицИдентификаторам = Новый Соответствие;
		Для Каждого СтрокаРМ Из ДокументОбъект.РабочиеМеста Цикл
			Идентификаторы = СоответствиеФизЛицИдентификаторам.Получить(СтрокаРМ.ФизическоеЛицо);
			Если Идентификаторы = Неопределено Тогда
				Идентификаторы = Новый Массив;
				СоответствиеФизЛицИдентификаторам.Вставить(СтрокаРМ.ФизическоеЛицо, Идентификаторы);
			КонецЕсли;
			Идентификаторы.Добавить(СтрокаРМ.ИдентификаторСтрокиРабочегоМеста);
		КонецЦикла;

		Для Каждого Запись Из НаборЗаписей Цикл
			Идентификаторы = СоответствиеФизЛицИдентификаторам.Получить(Запись.ФизическоеЛицо);
			Если Идентификаторы = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ИдентификаторРМ Из Идентификаторы Цикл
				ОтборСИЗ = Новый Структура;
				ОтборСИЗ.Вставить("ИдентификаторСтрокиРабочегоМеста", ИдентификаторРМ);
				ОтборСИЗ.Вставить("СИЗ", Запись.СИЗ);
				ОтборСИЗ.Вставить("Номенклатура", Запись.Номенклатура);
				ОтборСИЗ.Вставить("ХарактеристикаНоменклатуры", Запись.ХарактеристикаНоменклатуры);
				СтрокиТЧ = ДокументОбъект.НоменклатураСИЗ.НайтиСтроки(ОтборСИЗ);
				Если СтрокиТЧ.Количество() > 0 Тогда
					Запись.Дежурное = СтрокиТЧ[0].Дежурное;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
		ОбновлениеИБ.ЗавершитьОбновлениеДанных(ПараметрыОбновления);

		Обработанные.Добавить(Выборка.Регистратор);
	КонецЦикла;

	ОбновлениеИБ.УстановитьПараметрОбновления(ПараметрыОбновления, "Обработанные", Обработанные);

КонецПроцедуры

Процедура ЗаполнитьСправочникиСИЗ(ПараметрыОбновления) Экспорт

	ОбновлениеИБ = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый;

	Если Не СредстваИндивидуальнойЗащитыИспользуются() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СредстваИндивидуальнойЗащиты.Ссылка
		|ИЗ
		|	Справочник.СредстваИндивидуальнойЗащиты КАК СредстваИндивидуальнойЗащиты";

	Если Не Запрос.Выполнить().Пустой() Тогда
		ОбновлениеИБ.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;
	
	ОбновлениеИБ.ПродолжитьОбработчик(ПараметрыОбновления);

	ВыполнитьНачальноеЗаполнениеСправочниковСИЗ();

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРеглотчетности

// Процедура заполняет структуру показателей.
// Ключ структуры - идентификатор показателя.
// Значение структуры - массив из двух элементов:
// 	- признак автозаполнения показателя,
//	- признак расшифровки показателя.
//
// Параметры:
// 	ПоказателиОтчета - структура показателей отчета.
// 	ПараметрыОтчета - структура параметров отчета.
//
Процедура ОписаниеПоказателей_1Туст_2020Кв1(ПоказателиОтчета, ПараметрыОтчета)
	
	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОтчета, "Организация");
	Если Не (ОхранаТруда.СпециальнаяОценкаУсловийТрудаИспользуется(Организация)
		Или РабочиеМестаОхраныТруда.ПрименятьРезультатыСпециальнойОценкиУсловийТрудаДляОрганизаций(Организация)) Тогда
			
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Структура;
	Если ЗначениеЗаполнено(Организация) Тогда
		Параметры.Вставить("Организация", Организация);
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСредстваИндивидуальнойЗащиты", Параметры) Тогда 
		Возврат;
	КонецЕсли;
	
	ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, "П000020103003", Истина, Ложь);
	ЗарплатаКадры.ДобавитьПоказательРегламентированнойОтчетности(ПоказателиОтчета, "П000020103103", Истина, Ложь);
	
КонецПроцедуры

// Процедура заполняет переданную в виде контейнера структуру данных отчета.
//
Процедура ЗначенияПоказателей_1Туст_2020Кв1(ПараметрыОтчета, Контейнер)
	
	Результат = РасчетПоказателей_1Туст_2020Кв1(
		ПараметрыОтчета.мДатаКонцаПериодаОтчета, ПараметрыОтчета.Организация, ПараметрыОтчета.Сотрудники);
	ЗаполнитьЗначенияСвойств(Контейнер.ПолеТабличногоДокументаФормаОтчета, Результат);
	
КонецПроцедуры

Функция РасчетПоказателей_1Туст_2020Кв1(ДатаОтчета, Организация, Сотрудники)
	
	Показатели = Новый Структура;
	Показатели.Вставить("П000020103003", 0);
	Показатели.Вставить("П000020103103", 0);
	
	Если Не (ОхранаТруда.СпециальнаяОценкаУсловийТрудаИспользуется(Организация)
		Или РабочиеМестаОхраныТруда.ПрименятьРезультатыСпециальнойОценкиУсловийТрудаДляОрганизаций(Организация)) Тогда
			
		Возврат Показатели;
	КонецЕсли;
	
	Параметры = Новый Структура;
	Если ЗначениеЗаполнено(Организация) Тогда
		Параметры.Вставить("Организация", Организация);
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСредстваИндивидуальнойЗащиты", Параметры) Тогда 
		Возврат Показатели;
	КонецЕсли;
	
	ВредныеКлассы = Новый Массив;
	ВредныеКлассы.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Вредный1);
	ВредныеКлассы.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Вредный2);
	ВредныеКлассы.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Вредный3);
	ВредныеКлассы.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Вредный4);
	ВредныеКлассы.Добавить(Перечисления.КлассыУсловийТрудаПоРезультатамСпециальнойОценки.Опасный);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВредныеКлассы", ВредныеКлассы);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КадровыйУчет.СоздатьНаДатуВТКадровыеДанныеСотрудников(
		Запрос.МенеджерВременныхТаблиц, Истина, Сотрудники, "ГоловнаяОрганизация,КлассУсловийТруда", ДатаОтчета);
		
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВЫБОР
		|		КОГДА Сотрудники.КлассУсловийТруда В (&ВредныеКлассы)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ВредныйКлассУсловийТруда
		|ИЗ
		|	ВТКадровыеДанныеСотрудников КАК Сотрудники";
	
	КадровыеДанныеСотрудников = Запрос.Выполнить().Выгрузить();
	ВыдачиСИЗ = НоваяТаблицаВыдачиСИЗ();
	
	УстановитьПривилегированныйРежим(Истина);
	ЗаполнитьТаблицуВыдачСИЗ(ВыдачиСИЗ, КадровыеДанныеСотрудников, ДатаОтчета);
	УстановитьПривилегированныйРежим(Ложь);
	
	Показатели.П000020103003 = ВыдачиСИЗ.Количество();
	
	КадровыеДанныеВредные = КадровыеДанныеСотрудников.НайтиСтроки(Новый Структура("ВредныйКлассУсловийТруда", Истина));
	Для Каждого СтрокаДанных Из КадровыеДанныеВредные Цикл
		Если ВыдачиСИЗ.НайтиСтроки(Новый Структура("ФизическоеЛицо", СтрокаДанных.ФизическоеЛицо)).Количество() > 0 Тогда
			Показатели.П000020103103 = Показатели.П000020103103 + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Показатели;
		
КонецФункции

#КонецОбласти

#Область ОснованияДляОбновленияАктуальныхЗаказовНаВыдачуСИЗ

Функция НоваяТаблицаСформированныеЗаказыНаВыдачуСИЗ()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	Таблица.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	Таблица.Колонки.Добавить("ГоловнаяОрганизация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	Возврат Таблица;
	
КонецФункции

Процедура ОбновитьАктуальныеЗаказыНаВыдачуСИЗ(ТаблицаОбновления)
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаОбновления.Свернуть("ФизическоеЛицо, РабочееМесто, ГоловнаяОрганизация");
	
	АктуальныеЗаказыНаВыдачуСИЗ = АктуальныеЗаказыНаВыдачуСИЗ(ТаблицаОбновления);
	
	АктуальныеЗаказыНаВыдачуСИЗ.Индексы.Добавить("ФизическоеЛицо, РабочееМесто, ГоловнаяОрганизация");
	
	ОтборСтрок = Новый Структура("ФизическоеЛицо, РабочееМесто, ГоловнаяОрганизация");
	Для Каждого СтрокаТаблицы Из ТаблицаОбновления Цикл
		// Заполняем набор периодических осмотров.
		НаборЗаписей = РегистрыСведений.АктуальныеЗаказыНаВыдачуСИЗ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(СтрокаТаблицы.ФизическоеЛицо);
		НаборЗаписей.Отбор.РабочееМесто.Установить(СтрокаТаблицы.РабочееМесто);
		НаборЗаписей.Отбор.ГоловнаяОрганизация.Установить(СтрокаТаблицы.ГоловнаяОрганизация);
		ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаТаблицы);
		НайденныеСтроки = АктуальныеЗаказыНаВыдачуСИЗ.НайтиСтроки(ОтборСтрок);
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(НайденныеСтроки, НаборЗаписей);
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПодключениеСобытийОбновленияВыдачиСИЗ

Процедура ЗарегистрироватьИзменениеРабочихМестДляСИЗПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуОбновленияРабочихМестДляСИЗ(Источник);
	
	ЗарегистрироватьОбновлениеВыдачиСИЗ(Источник.ДополнительныеСвойства.ТаблицаОбновлениеВыдачиСИЗ);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуОбновленияВыдачиСИЗПоФизическимЛицам(ТаблицаОбновлениеВыдачиСИЗ, ФизическиеЛица) Экспорт

	Если ФизическиеЛица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ОтборыМассив = Новый Массив;
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ОтборыМассив, "ФизическоеЛицо", "В", ФизическиеЛица);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ОтборыМассив, "ОформленПоТрудовомуДоговору", "=", Истина);
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ОтборыМассив, "ДатаУвольнения", "<", ТекущаяДатаСеанса());
	КадровыйУчет.СоздатьВТТекущиеКадровыеДанныеСотрудников(МенеджерВТ, Ложь, ОтборыМассив, "ГоловнаяОрганизация");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КадровыеДанные.ФизическоеЛицо КАК ФизическоеЛицо,
		|	КадровыеДанные.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	ВТТекущиеКадровыеДанныеСотрудников КАК КадровыеДанные";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОбновлениеВыдачиСИЗ.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗарегистрироватьИзменениеКадровойИсторииДляСИЗПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Регистраторы = РегистрыБЗК.ЗначенияОтбораЗаписейНабора(Источник, Замещение, "Регистратор");
	Для Каждого Регистратор Из Регистраторы Цикл
		ТипРегистратора = ТипЗнч(Регистратор);
		Если Не (ТипРегистратора = Тип("ДокументСсылка.Увольнение") Или ТипРегистратора = Тип("ДокументСсылка.УвольнениеСписком")
			Или ТипРегистратора = Тип("ДокументСсылка.ПрекращениеПодработки")) Тогда
			
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьТаблицуОбновленияКадровойИсторииДляСИЗ(Источник);
		ЗарегистрироватьОбновлениеВыдачиСИЗ(Источник.ДополнительныеСвойства.ТаблицаОбновлениеВыдачиСИЗ);
	    Прервать;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура СоздатьВТСИЗРабочегоМеста(МенеджерВременныхТаблиц, РабочееМесто = Неопределено, ОтмеченныеСИЗ = Неопределено,
	Параметры = Неопределено) Экспорт
	
	Если ТипЗнч(РабочееМесто) = Тип("СправочникСсылка.РабочиеМестаОхраныТруда") Тогда
		РабочиеМеста = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(РабочееМесто);
	Иначе
		РабочиеМеста = РабочееМесто;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СИЗРабочегоМеста.РабочееМесто КАК РабочееМесто,
		|	СИЗРабочегоМеста.СИЗ КАК СИЗ,
		|	СИЗРабочегоМеста.Количество,
		|	СИЗРабочегоМеста.ЕдиницаИзмерения,
		|	СИЗРабочегоМеста.СпособВыдачи,
		|	СИЗРабочегоМеста.Дежурное,
		|	СИЗРабочегоМеста.КратностьВыдачи,
		|	СИЗРабочегоМеста.ПериодичностьВыдачи,
		|	СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи,
		|	ВЫРАЗИТЬ(СИЗРабочегоМеста.ПредставлениеПериодичностиВыдачи КАК СТРОКА(100)) КАК ПредставлениеПериодичностиВыдачи
		|ПОМЕСТИТЬ ВТСИЗРабочегоМеста
		|ИЗ
		|	РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
		|ГДЕ
		|	СИЗРабочегоМеста.РабочееМесто В (&РабочиеМеста)
		|	И СИЗРабочегоМеста.СИЗ В (&ОтмеченныеСИЗ)
		|	И СИЗРабочегоМеста.РабочееМесто ССЫЛКА Справочник.РабочиеМестаОхраныТруда
		|	И ВЫБОР
		|		КОГДА СИЗРабочегоМеста.РабочееМесто ССЫЛКА Справочник.РабочиеМестаОхраныТруда
		|			ТОГДА ВЫБОР
		|				КОГДА &ЕстьОрганизация
		|					ТОГДА СИЗРабочегоМеста.РабочееМесто.Владелец = &Организация
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|			И ВЫБОР
		|				КОГДА &ЕстьПодразделение
		|					ТОГДА СИЗРабочегоМеста.РабочееМесто.Подразделение = &Подразделение
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("РабочиеМеста", РабочиеМеста);
	Запрос.УстановитьПараметр("ОтмеченныеСИЗ", ОтмеченныеСИЗ);
	
	Если Параметры = Неопределено Тогда
		Запрос.УстановитьПараметр("ЕстьОрганизация", Ложь);
		Запрос.УстановитьПараметр("Организация", Неопределено);
		Запрос.УстановитьПараметр("ЕстьПодразделение", Ложь);
		Запрос.УстановитьПараметр("Подразделение", Неопределено);
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст, "СИЗРабочегоМеста.РабочееМесто ССЫЛКА Справочник.РабочиеМестаОхраныТруда", "ИСТИНА");
	Иначе
		Запрос.УстановитьПараметр("ЕстьОрганизация", ЗначениеЗаполнено(Параметры.Организация));
		Запрос.УстановитьПараметр("Организация", Параметры.Организация);
		Запрос.УстановитьПараметр("ЕстьПодразделение", ЗначениеЗаполнено(Параметры.Подразделение));
		Запрос.УстановитьПараметр("Подразделение", Параметры.Подразделение);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтмеченныеСИЗ) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СИЗРабочегоМеста.СИЗ В (&ОтмеченныеСИЗ)", "ИСТИНА");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РабочиеМеста) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СИЗРабочегоМеста.РабочееМесто В (&РабочиеМеста)", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СоздатьВТВыдачиСИЗПоНоменклатуре(
	МенеджерВТ, ИмяВТФизическиеЛица, ДатаАктуальности = '00010101', ИмяПоляРабочееМесто = "РабочееМесто", УчитыватьРабочиеМеста = Истина)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыдачиСИЗПоНоменклатуре.Период КАК ДатаВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор КАК Регистратор,
		|	ВыдачиСИЗПоНоменклатуре.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.РабочееМесто КАК РабочееМесто,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи КАК ОснованиеВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДокументВыдачи КАК ДокументВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи
		|ПОМЕСТИТЬ ВТВыдачиСИЗПоНоменклатуреПредварительно
		|ИЗ
		|	РегистрСведений.ВыдачиСИЗПоНоменклатуре.СрезПоследних(
		|			&ДатаАктуальности,
		|			(ФизическоеЛицо, РабочееМесто) В
		|				(ВЫБРАТЬ
		|					ФизическиеЛица.ФизическоеЛицо,
		|					ФизическиеЛица.РабочееМесто
		|				ИЗ
		|					ВТФизическиеЛица КАК ФизическиеЛица)) КАК ВыдачиСИЗПоНоменклатуре
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ФизическоеЛицо,
		|	СИЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВыдачиСИЗПоНоменклатуре.ДатаВыдачи КАК ДатаВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор КАК Регистратор,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.РабочееМесто КАК РабочееМесто,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи КАК ОснованиеВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДокументВыдачи КАК ДокументВыдачи,
		|	СУММА(ЕСТЬNULL(ВыданныеСИЗОстатки.КоличествоОстаток, 0)) КАК Количество
		|ПОМЕСТИТЬ ВТВыдачиСИЗПоНоменклатуре
		|ИЗ
		|	ВТВыдачиСИЗПоНоменклатуреПредварительно КАК ВыдачиСИЗПоНоменклатуре
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыданныеСИЗ.Остатки(
		|				&ДатаАктуальности,
		|				ФизическоеЛицо В
		|					(ВЫБРАТЬ
		|						ФизическиеЛица.ФизическоеЛицо
		|					ИЗ
		|						ВТФизическиеЛица КАК ФизическиеЛица)) КАК ВыданныеСИЗОстатки
		|		ПО (ВыданныеСИЗОстатки.ФизическоеЛицо = ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо)
		|			И (ВыданныеСИЗОстатки.СИЗ = ВыдачиСИЗПоНоменклатуре.СИЗ)
		|			И (ВыданныеСИЗОстатки.Номенклатура = ВыдачиСИЗПоНоменклатуре.Номенклатура)
		|			И (ВыданныеСИЗОстатки.ХарактеристикаНоменклатуры = ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры)
		|			И (ВыданныеСИЗОстатки.ОснованиеВыдачи = ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи)
		|			И (ВыданныеСИЗОстатки.ДокументВыдачи = ВыдачиСИЗПоНоменклатуре.ДокументВыдачи)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.РабочееМесто,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры,
		|	ВыдачиСИЗПоНоменклатуре.ДатаВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДокументВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ГоловнаяОрганизация";
	
	Если Не УчитыватьРабочиеМеста Тогда
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
		ПараметрыЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Параметры[1];
		ТекстВыражения = "ФизическоеЛицо В (ВЫБРАТЬ ФизическиеЛица.ФизическоеЛицо ИЗ ВТФизическиеЛица КАК ФизическиеЛица)";
		ПараметрыЗапроса.Выражение = Новый ВыражениеСхемыЗапроса(ТекстВыражения);
		Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТФизическиеЛица", ИмяВТФизическиеЛица);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФизическиеЛица.РабочееМесто", "ФизическиеЛица." + ИмяПоляРабочееМесто);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СоздатьВТВыданныеСИЗ(МенеджерВТ, ИмяВТФизическиеЛица = "ВТФизическиеЛица")
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛица.РабочееМесто КАК РабочееМесто
		|ИЗ
		|	ВТФизическиеЛица КАК ФизическиеЛица";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТФизическиеЛица", ИмяВТФизическиеЛица);
	
	СоздатьВТСИЗРабочегоМеста(МенеджерВТ, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РабочееМесто"));
	СоздатьВТВыдачиСИЗПоНоменклатуре(МенеджерВТ, ИмяВТФизическиеЛица, , , Ложь);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ВыдачиСИЗПоНоменклатуре.ДатаВыдачи, ДЕНЬ) КАК ДатаВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор КАК ВыдачаСИЗ,
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.РабочееМесто КАК РабочееМесто,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи КАК ЗаказНаВыдачу,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи
		|ПОМЕСТИТЬ ВТВыданныеСИЗПредварительно
		|ИЗ
		|	ВТВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
		|ГДЕ
		|	ВыдачиСИЗПоНоменклатуре.Количество > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФизическиеЛица.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ФизическиеЛица.РабочееМесто КАК РабочееМесто,
		|	СИЗРабочегоМеста.СИЗ КАК СИЗ,
		|	СИЗРабочегоМеста.СпособВыдачи КАК СпособВыдачи
		|ПОМЕСТИТЬ ВТСИЗФизическихЛиц
		|ИЗ
		|	ВТФизическиеЛица КАК ФизическиеЛица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО ФизическиеЛица.РабочееМесто = СИЗРабочегоМеста.РабочееМесто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СИЗФизическихЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СИЗФизическихЛиц.РабочееМесто КАК РабочееМесто,
		|	ВЫБОР
		|		КОГДА КОЛИЧЕСТВО(СИЗФизическихЛиц.СИЗ) = СУММА(ВЫБОР
		|					КОГДА ВыданныеСИЗПредварительно.СИЗ ЕСТЬ NULL
		|						ТОГДА 0
		|					ИНАЧЕ 1
		|				КОНЕЦ)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РезультатыВыдачиСИЗ.Выдано)
		|		КОГДА СУММА(ВЫБОР
		|					КОГДА ВыданныеСИЗПредварительно.СИЗ ЕСТЬ NULL
		|						ТОГДА 0
		|					ИНАЧЕ 1
		|				КОНЕЦ) = 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РезультатыВыдачиСИЗ.НеВыдано)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РезультатыВыдачиСИЗ.ЧастичноВыдано)
		|	КОНЕЦ КАК РезультатВыдачи
		|ПОМЕСТИТЬ ВТКоличествоВыданныхСИЗ
		|ИЗ
		|	ВТСИЗФизическихЛиц КАК СИЗФизическихЛиц
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыданныеСИЗПредварительно КАК ВыданныеСИЗПредварительно
		|		ПО СИЗФизическихЛиц.ФизическоеЛицо = ВыданныеСИЗПредварительно.ФизическоеЛицо
		|			И СИЗФизическихЛиц.СИЗ = ВыданныеСИЗПредварительно.СИЗ
		|
		|СГРУППИРОВАТЬ ПО
		|	СИЗФизическихЛиц.ФизическоеЛицо,
		|	СИЗФизическихЛиц.РабочееМесто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВыданныеСИЗПредварительно.ДатаВыдачи КАК ДатаВыдачи,
		|	ВыданныеСИЗПредварительно.ВыдачаСИЗ КАК ВыдачаСИЗ,
		|	ВыданныеСИЗПредварительно.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыданныеСИЗПредварительно.РабочееМесто КАК РабочееМесто,
		|	ВыданныеСИЗПредварительно.СИЗ КАК СИЗ,
		|	КоличествоВыданныхСИЗ.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыданныеСИЗПредварительно.ЗаказНаВыдачу КАК ЗаказНаВыдачу,
		|	ВыданныеСИЗПредварительно.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	СИЗФизическихЛиц.СпособВыдачи КАК СпособВыдачи
		|ПОМЕСТИТЬ ВТВыданныеСИЗ
		|ИЗ
		|	ВТВыданныеСИЗПредварительно КАК ВыданныеСИЗПредварительно
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКоличествоВыданныхСИЗ КАК КоличествоВыданныхСИЗ
		|		ПО ВыданныеСИЗПредварительно.ФизическоеЛицо = КоличествоВыданныхСИЗ.ФизическоеЛицо
		|			И ВыданныеСИЗПредварительно.РабочееМесто = КоличествоВыданныхСИЗ.РабочееМесто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСИЗФизическихЛиц КАК СИЗФизическихЛиц
		|		ПО ВыданныеСИЗПредварительно.РабочееМесто = СИЗФизическихЛиц.РабочееМесто
		|			И ВыданныеСИЗПредварительно.ФизическоеЛицо = СИЗФизическихЛиц.ФизическоеЛицо
		|			И ВыданныеСИЗПредварительно.СИЗ = СИЗФизическихЛиц.СИЗ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТФизическиеЛица", ИмяВТФизическиеЛица);
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СоздатьВТСотрудникиОрганизацииЗанятыеНаРабочихМестах(МенеджерВТ, ПараметрыСписка, РабочиеМеста)
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.КадровыеДанные = "РабочееМестоОхраныТруда, РабочееМестоОхраныТрудаПериодРегистрации";
	
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолучения.Отборы,
		"РабочееМестоОхраныТруда", "В", РабочиеМеста);
	
	ПараметрыПолучения.Организация = ПараметрыСписка.Организация;
	Если ЗначениеЗаполнено(ПараметрыСписка.Подразделение) Тогда
		ПараметрыПолучения.Подразделение = ПараметрыСписка.Подразделение;
	КонецЕсли;
	ПараметрыПолучения.НачалоПериода = ПараметрыСписка.ДатаАктуальности;
	ПараметрыПолучения.ОкончаниеПериода = ПараметрыСписка.ДатаАктуальности;
	
	УстановитьПривилегированныйРежим(Истина);
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(
		МенеджерВТ,
		Истина,
		ПараметрыПолучения,
		"ВТСотрудникиОрганизацииЗанятыеНаРабочихМестах");
	
КонецПроцедуры

Функция СИЗКПродлениюСписанию(ТаблицаФизическиеЛицаРабочиеМеста, ВыдачаСсылка, ТолькоИстекающие)
	
	ТаблицаСИЗ = Новый ТаблицаЗначений;
	ТаблицаСИЗ.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	ТаблицаСИЗ.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТаблицаСИЗ.Колонки.Добавить("СИЗ", Новый ОписаниеТипов("СправочникСсылка.СредстваИндивидуальнойЗащиты"));
	ТаблицаСИЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСИЗ.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаСИЗ.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаСИЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ПоследняяВыдача", Новый ОписаниеТипов("Дата"));
	ТаблицаСИЗ.Колонки.Добавить("ОснованиеВыдачи", Метаданные.ОпределяемыеТипы.ОснованиеВыдачиСИЗ.Тип);
	ТаблицаСИЗ.Колонки.Добавить("ДокументВыдачи", Метаданные.ОпределяемыеТипы.ДокументОснованиеВыдачиСИЗ.Тип);
	ТаблицаСИЗ.Колонки.Добавить("СпособВыдачи", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыВыдачиСИЗ"));
	ТаблицаСИЗ.Колонки.Добавить("Дежурное", Новый ОписаниеТипов("Булево"));
	ТаблицаСИЗ.Колонки.Добавить("КратностьВыдачи", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ПериодичностьВыдачи", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ЕдиницаПериодичностиВыдачи", Новый ОписаниеТипов("ПеречислениеСсылка.Периодичность"));
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗарплатаКадры.СоздатьВТПоТаблицеЗначений(МенеджерВременныхТаблиц, ТаблицаФизическиеЛицаРабочиеМеста, "ВТФизическиеЛицаРабочиеМеста");
	
	СоздатьВТСИЗРабочегоМеста(МенеджерВременныхТаблиц, ТаблицаФизическиеЛицаРабочиеМеста.ВыгрузитьКолонку("РабочееМесто"));
	СоздатьВТВыдачиСИЗПоНоменклатуре(МенеджерВременныхТаблиц, "ВТФизическиеЛицаРабочиеМеста");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ИсключаемаяВыдача", ВыдачаСсылка);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛицаРабочиеМеста.РабочееМесто КАК РабочееМесто,
		|	ФизическиеЛицаРабочиеМеста.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВыдачиСИЗПоНоменклатуре.ДатаВыдачи КАК ПоследняяВыдача,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДокументВыдачи КАК ДокументВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи КАК ОснованиеВыдачи,
		|	ЕСТЬNULL(ВыдачиСИЗПоНоменклатуре.Количество, 0) КАК Количество,
		|	ВЫРАЗИТЬ(ВыдачиСИЗПоНоменклатуре.СИЗ КАК Справочник.СредстваИндивидуальнойЗащиты).ЕдиницаИзмерения КАК
		|		ЕдиницаИзмерения,
		|	СИЗРабочегоМеста.СпособВыдачи,
		|	СИЗРабочегоМеста.Дежурное,
		|	СИЗРабочегоМеста.КратностьВыдачи,
		|	СИЗРабочегоМеста.ПериодичностьВыдачи,
		|	СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи
		|ИЗ
		|	ВТФизическиеЛицаРабочиеМеста КАК ФизическиеЛицаРабочиеМеста
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
		|		ПО ФизическиеЛицаРабочиеМеста.ФизическоеЛицо = ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо
		|		И ФизическиеЛицаРабочиеМеста.РабочееМесто = ВыдачиСИЗПоНоменклатуре.РабочееМесто
		|		И ФизическиеЛицаРабочиеМеста.СИЗ = ВыдачиСИЗПоНоменклатуре.СИЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО ВыдачиСИЗПоНоменклатуре.РабочееМесто = СИЗРабочегоМеста.РабочееМесто
		|		И ВыдачиСИЗПоНоменклатуре.СИЗ = СИЗРабочегоМеста.СИЗ
		|ГДЕ
		|	ЕСТЬNULL(ВыдачиСИЗПоНоменклатуре.Количество, 0) > 0
		|	И НЕ ВыдачиСИЗПоНоменклатуре.ДокументВыдачи = &ИсключаемаяВыдача
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо,
		|	РабочееМесто";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДатаАктуальности = ДобавитьМесяц(ТекущаяДатаСеанса(), 1);
	Пока Выборка.Следующий() Цикл
		Если ТолькоИстекающие И Выборка.ДатаСледующейВыдачи > ДатаАктуальности Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаСИЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ТаблицаСИЗ;
	
КонецФункции

Процедура ДобавитьСтрокуТаблицыВыдачиПоСИЗ(ВыдачиПоНоменклатуреСИЗ, ВыборкаЗапроса)
	
	НоваяСтрока = ВыдачиПоНоменклатуреСИЗ.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаЗапроса);
	
	НоваяСтрока.Периодичность = ОписаниеПериодичностиВыдачи();
	ЗаполнитьЗначенияСвойств(НоваяСтрока.Периодичность, ВыборкаЗапроса);
	ЗаполнитьПредставлениеПериодичности(НоваяСтрока.Периодичность);
	
	Если Не ЗначениеЗаполнено(ВыборкаЗапроса.ПоследняяВыдача) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыборкаЗапроса.Результат = Перечисления.РезультатыВыдачиСИЗ.НеВыдано Тогда
		НоваяСтрока.СледующаяВыдача = ВыборкаЗапроса.ПоследняяВыдача;
	ИначеЕсли ВыборкаЗапроса.Результат = Перечисления.РезультатыВыдачиСИЗ.СрокНоскиПродлен Тогда
		НоваяСтрока.СледующаяВыдача = ВыборкаЗапроса.ДатаСледующейВыдачи;
	Иначе
		НоваяСтрока.СледующаяВыдача = ДатаСледующейВыдачи(ВыборкаЗапроса.ПоследняяВыдача, НоваяСтрока.Периодичность);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.СледующаяВыдача) Тогда
		НоваяСтрока.СостояниеПроцент = АктуальностьВыдачиВПроцентах(НоваяСтрока.ПоследняяВыдача, НоваяСтрока.СледующаяВыдача);
	КонецЕсли;
	
КонецПроцедуры

Функция АктуальностьВыдачиВПроцентах(ПоследняяВыдача, СледующаяВыдача)
	
	Если Не ЗначениеЗаполнено(ПоследняяВыдача) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СледующаяВыдача) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Сегодня = НачалоДня(ТекущаяДатаСеанса());

	Если Сегодня > СледующаяВыдача Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Сегодня < ПоследняяВыдача Тогда
		Возврат 100;
	КонецЕсли;
	
	Возврат ((СледующаяВыдача - Сегодня) / (СледующаяВыдача - ПоследняяВыдача)) * 100;
	
КонецФункции

Процедура ЗаполнитьПредставлениеПериодичности(ОписаниеПериодичности, УчитыватьКоличество = Истина)
	
	Если УчитыватьКоличество Тогда
		ОписаниеПериодичности.Представление = СредстваИндивидуальнойЗащитыКлиентСервер.ПредставлениеПериодичности(
			ОписаниеПериодичности.Кратность, ОписаниеПериодичности.Периодичность, ОписаниеПериодичности.ЕдиницаПериодичности,
			ОписаниеПериодичности.ЕдиницаИзмерения, ОписаниеПериодичности.Количество, ОписаниеПериодичности.СпособВыдачи);
	Иначе
		ОписаниеПериодичности.Представление = СредстваИндивидуальнойЗащитыКлиентСервер.ПредставлениеПериодичности(
			ОписаниеПериодичности.Кратность, ОписаниеПериодичности.Периодичность, ОписаниеПериодичности.ЕдиницаПериодичности,
			, , ОписаниеПериодичности.СпособВыдачи);
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаСледующейВыдачи(ДатаВыдачи, ОписаниеПериодичностиВыдачи) Экспорт
	
	Если ОписаниеПериодичностиВыдачи.Кратность = 0 Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Если ОписаниеПериодичностиВыдачи.СпособВыдачи = Перечисления.СпособыВыдачиСИЗ.ДоИзноса Тогда
		Возврат ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата();
	КонецЕсли;
	
	ИнтервалМесяцев = ИнтервалМесяцев(ОписаниеПериодичностиВыдачи.ЕдиницаПериодичности, ОписаниеПериодичностиВыдачи.Периодичность, ОписаниеПериодичностиВыдачи.Кратность);
	
	Возврат ДобавитьМесяц(ДатаВыдачи, ИнтервалМесяцев);
	
КонецФункции

Функция МесяцевВЕдиницуИзмерения(ЕдиницаПериодичности)
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Перечисления.Периодичность.Год, 12);
	Соответствие.Вставить(Перечисления.Периодичность.Полугодие, 6);
	Соответствие.Вставить(Перечисления.Периодичность.Квартал, 3);
	Соответствие.Вставить(Перечисления.Периодичность.Месяц, 1);
	
	Возврат Соответствие[ЕдиницаПериодичности];
	
КонецФункции

Функция ОписаниеПериодичностиВыдачи() Экспорт
	
	ПоляОписания = Новый Соответствие;
	ПоляОписания.Вставить("СпособВыдачи", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыВыдачиСИЗ"));
	ПоляОписания.Вставить("Количество", Новый ОписаниеТипов("Число"));
	ПоляОписания.Вставить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ПоляОписания.Вставить("Кратность", Новый ОписаниеТипов("Число"));
	ПоляОписания.Вставить("Периодичность", Новый ОписаниеТипов("Число"));
	ПоляОписания.Вставить("ЕдиницаПериодичности", Новый ОписаниеТипов("ПеречислениеСсылка.Периодичность"));
	ПоляОписания.Вставить("Представление", Новый ОписаниеТипов("Строка"));
	
	Описание = Новый Структура;
	Для Каждого КлючИЗначение Из ПоляОписания Цикл
		Описание.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение.ПривестиЗначение());
	КонецЦикла;
	
	Возврат Описание;
	
КонецФункции

Функция ПредставленияСИЗ()
	
	ПоляПредставления = Новый Соответствие;
	ПоляПредставления.Вставить("СИЗПолноеПредставление", Новый ОписаниеТипов("Строка"));
	ПоляПредставления.Вставить("СИЗКодыПредставление", Новый ОписаниеТипов("Строка"));
	
	Представления = Новый Структура;
	Для Каждого КлючИЗначение Из ПоляПредставления Цикл
		Представления.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение.ПривестиЗначение());
	КонецЦикла;
	
	Возврат Представления;
	
КонецФункции

Процедура ДополнитьПредставленияСИЗ(Представления, ВыборкаСИЗ)
	
	Если Не ЗначениеЗаполнено(ВыборкаСИЗ.СИЗНаименование) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Представления["СИЗПолноеПредставление"]) Тогда
		Представления["СИЗПолноеПредставление"] = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 (%2 %3)'"),
			ВыборкаСИЗ.СИЗНаименование,
			Строка(ВыборкаСИЗ.Количество),
			ВыборкаСИЗ.ЕдиницаИзмерения);
		Возврат;
	КонецЕсли;
	
	Представления["СИЗПолноеПредставление"] = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1, %2 (%3 %4)'"),
		Представления["СИЗПолноеПредставление"],
		ВыборкаСИЗ.СИЗНаименование,
		Строка(ВыборкаСИЗ.Количество),
		ВыборкаСИЗ.ЕдиницаИзмерения);
	
КонецПроцедуры

Процедура ОбновитьВыдачиФизическихЛиц(ТаблицаОбновления)
	
	ВыдачиСИЗ = НоваяТаблицаВыдачиСИЗ();
	
	ЗаполнитьТаблицуВыдачСИЗ(ВыдачиСИЗ, ТаблицаОбновления);
	
	ВыдачиСИЗ.Индексы.Добавить("ФизическоеЛицо, ГоловнаяОрганизация");
	
	ОтборСтрок = Новый Структура("ФизическоеЛицо, ГоловнаяОрганизация");
	Для Каждого СтрокаТаблицы Из ТаблицаОбновления Цикл
		// Заполняем набор выдачи СИЗ.
		НаборВыдачи = РегистрыСведений.ВыдачиСИЗ.СоздатьНаборЗаписей();
		НаборВыдачи.Отбор.ФизическоеЛицо.Установить(СтрокаТаблицы.ФизическоеЛицо);
		НаборВыдачи.Отбор.ГоловнаяОрганизация.Установить(СтрокаТаблицы.ГоловнаяОрганизация);
		ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаТаблицы);
		НайденныеСтроки = ВыдачиСИЗ.НайтиСтроки(ОтборСтрок);
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(НайденныеСтроки, НаборВыдачи);
		// Подготавливаем к очистке набор обновления.
		НаборОбновления = РегистрыСведений.ОбновлениеВыдачСИЗ.СоздатьНаборЗаписей();
		НаборОбновления.Отбор.ФизическоеЛицо.Установить(СтрокаТаблицы.ФизическоеЛицо);
		НаборОбновления.Отбор.ГоловнаяОрганизация.Установить(СтрокаТаблицы.ГоловнаяОрганизация);
		НачатьТранзакцию();
		Попытка
			НаборВыдачи.Записать();
			НаборОбновления.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуВыдачСИЗ(ВыдачиСИЗ, ТаблицаОбновления, ДатаАктуальности = Неопределено)
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	// Получаем сотрудников и рабочие места.
	ПараметрыСотрудников = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыСотрудников.КадровыеДанные = 
		"ДолжностьПоШтатномуРасписанию,ГоловнаяОрганизация,РабочееМестоОхраныТруда,РабочееМестоОхраныТрудаПериодРегистрации";
	
	ПараметрыСотрудников.СписокФизическихЛиц = ТаблицаОбновления.ВыгрузитьКолонку("ФизическоеЛицо");
	ПараметрыСотрудников.ОкончаниеПериода = ?(ДатаАктуальности = Неопределено, ОбщегоНазначения.ТекущаяДатаПользователя(), ДатаАктуальности);
	ПараметрыСотрудников.ПодработкиРаботниковПоТрудовымДоговорам = Истина;
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыСотрудников.Отборы, "ДатаУвольнения", "=", Дата(1, 1, 1));
	
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(МенеджерВТ, Истина, ПараметрыСотрудников);
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВТ, "ВТСотрудникиОрганизации") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТаблицаОбновления", ТаблицаОбновления);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаОбновления.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ТаблицаОбновления.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ПОМЕСТИТЬ ВТОбновления
		|ИЗ
		|	&ТаблицаОбновления КАК ТаблицаОбновления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.ДолжностьПоШтатномуРасписанию КАК Позиция,
		|	Сотрудники.РабочееМестоОхраныТруда КАК РабочееМесто,
		|	Сотрудники.РабочееМестоОхраныТрудаПериодРегистрации КАК ДатаНачала,
		|	ПериодичностьВыдачиСИЗРабочихМест.КратностьВыдачи КАК Кратность,
		|	ПериодичностьВыдачиСИЗРабочихМест.ПериодичностьВыдачи КАК Периодичность,
		|	ПериодичностьВыдачиСИЗРабочихМест.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичности
		|ПОМЕСТИТЬ ВТСотрудникиТребующиеВыдачи
		|ИЗ
		|	ВТСотрудникиОрганизации КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОбновления КАК ТаблицаОбновления
		|		ПО ТаблицаОбновления.ФизическоеЛицо = Сотрудники.ФизическоеЛицо
		|		И ТаблицаОбновления.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПериодичностьВыдачиСИЗРабочихМест КАК ПериодичностьВыдачиСИЗРабочихМест
		|		ПО ПериодичностьВыдачиСИЗРабочихМест.РабочееМесто = Сотрудники.РабочееМестоОхраныТруда";
	Запрос.Выполнить();
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВТ, "ВТСотрудникиТребующиеВыдачи") Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем сведения о последней выдаче СИЗ.
	СоздатьВТВыданныеСИЗ(МенеджерВТ, "ВТСотрудникиТребующиеВыдачи");
	ДобавитьРанееВыданныеСИЗНаТекущемРабочемМесте(Запрос, ВыдачиСИЗ);
	
	// Никогда не получавшие СИЗ на этом рабочем месте
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	Сотрудники.ДатаНачала КАК ДатаНачала
		|ПОМЕСТИТЬ ВТСотрудникиНеПолучавшиеСИЗНаПозиции
		|ИЗ
		|	ВТСотрудникиТребующиеВыдачи КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыданныеСИЗ КАК ВыданныеСИЗ
		|		ПО (ВыданныеСИЗ.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|		И (ВыданныеСИЗ.РабочееМесто = Сотрудники.РабочееМесто)
		|ГДЕ
		|	ВыданныеСИЗ.ДатаВыдачи ЕСТЬ NULL";
	Запрос.Выполнить();
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВТ, "ВТСотрудникиНеПолучавшиеСИЗНаПозиции") Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьВыдачиСИЗКПерезачету(Запрос, МенеджерВТ, ВыдачиСИЗ);
	
КонецПроцедуры

Функция АктуальныеЗаказыНаВыдачуСИЗ(ТаблицаОбновления)
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		Возврат НоваяТаблицаСформированныеЗаказыНаВыдачуСИЗ();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаОбновления", ТаблицаОбновления);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаОбновления.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ТаблицаОбновления.РабочееМесто КАК РабочееМесто,
		|	ТаблицаОбновления.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ПОМЕСТИТЬ ВТОбновления
		|ИЗ
		|	&ТаблицаОбновления КАК ТаблицаОбновления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.РабочееМесто КАК РабочееМесто,
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.ЗаказНаВыдачуСИЗ КАК ЗаказНаВыдачуСИЗ,
		|	ВЫБОР
		|		КОГДА ДокументЗаказНаВыдачуСИЗ.ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДокументЗаказНаВыдачуСИЗ.Дата
		|		ИНАЧЕ ДокументЗаказНаВыдачуСИЗ.ДатаЗаказа
		|	КОНЕЦ КАК ДатаЗаказа
		|ПОМЕСТИТЬ ВТСформированныеЗаказы
		|ИЗ
		|	РегистрНакопления.СформированныеЗаказыНаВыдачуСИЗ.Остатки(
		|			,
		|			(ФизическоеЛицо, РабочееМесто, ГоловнаяОрганизация) В
		|				(ВЫБРАТЬ
		|					ТаблицаОбновления.ФизическоеЛицо,
		|					ТаблицаОбновления.РабочееМесто,
		|					ТаблицаОбновления.ГоловнаяОрганизация
		|				ИЗ
		|					ВТОбновления КАК ТаблицаОбновления)) КАК СформированныеЗаказыНаВыдачуСИЗОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаВыдачуСИЗ КАК ДокументЗаказНаВыдачуСИЗ
		|		ПО СформированныеЗаказыНаВыдачуСИЗОстатки.ЗаказНаВыдачуСИЗ = ДокументЗаказНаВыдачуСИЗ.Ссылка
		|ГДЕ
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.КоличествоОстаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.ФизическоеЛицо,
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.ЗаказНаВыдачуСИЗ,
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.РабочееМесто,
		|	СформированныеЗаказыНаВыдачуСИЗОстатки.ГоловнаяОрганизация,
		|	ВЫБОР
		|		КОГДА ДокументЗаказНаВыдачуСИЗ.ДатаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДокументЗаказНаВыдачуСИЗ.Дата
		|		ИНАЧЕ ДокументЗаказНаВыдачуСИЗ.ДатаЗаказа
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СформированныеЗаказы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СформированныеЗаказы.РабочееМесто КАК РабочееМесто,
		|	СформированныеЗаказы.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	МАКСИМУМ(СформированныеЗаказы.ДатаЗаказа) КАК ДатаЗаказа
		|ПОМЕСТИТЬ ВТМаксимальныеДатыЗаказов
		|ИЗ
		|	ВТСформированныеЗаказы КАК СформированныеЗаказы
		|
		|СГРУППИРОВАТЬ ПО
		|	СформированныеЗаказы.ФизическоеЛицо,
		|	СформированныеЗаказы.РабочееМесто,
		|	СформированныеЗаказы.ГоловнаяОрганизация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СформированныеЗаказы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СформированныеЗаказы.РабочееМесто КАК РабочееМесто,
		|	СформированныеЗаказы.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	СформированныеЗаказы.ДатаЗаказа КАК ДатаЗаказа,
		|	МАКСИМУМ(СформированныеЗаказы.ЗаказНаВыдачуСИЗ) КАК ЗаказНаВыдачуСИЗ
		|ИЗ
		|	ВТСформированныеЗаказы КАК СформированныеЗаказы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТМаксимальныеДатыЗаказов КАК МаксимальныеДатыЗаказов
		|		ПО СформированныеЗаказы.ФизическоеЛицо = МаксимальныеДатыЗаказов.ФизическоеЛицо
		|			И СформированныеЗаказы.РабочееМесто = МаксимальныеДатыЗаказов.РабочееМесто
		|			И СформированныеЗаказы.ГоловнаяОрганизация = МаксимальныеДатыЗаказов.ГоловнаяОрганизация
		|			И СформированныеЗаказы.ДатаЗаказа = МаксимальныеДатыЗаказов.ДатаЗаказа
		|
		|СГРУППИРОВАТЬ ПО
		|	СформированныеЗаказы.ФизическоеЛицо,
		|	СформированныеЗаказы.РабочееМесто,
		|	СформированныеЗаказы.ГоловнаяОрганизация,
		|	СформированныеЗаказы.ДатаЗаказа";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДобавитьРанееВыданныеСИЗНаТекущемРабочемМесте(Запрос, ВыдачиСИЗ)
	
	// Сотрудники, хотя бы раз получавшие СИЗ на том рабочем месте, на котором сейчас работают.
	// Для них просто отсчитаем дату следующей выдачи.
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	ВыданныеСИЗ.ДатаВыдачи КАК ДатаВыдачи,
		|	ВыданныеСИЗ.СИЗ КАК СИЗ,
		|	ВыданныеСИЗ.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыданныеСИЗ.ВыдачаСИЗ КАК ВыдачаСИЗ,
		|	ВыданныеСИЗ.ЗаказНаВыдачу КАК ЗаказНаВыдачуСИЗ,
		|	ВыданныеСИЗ.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	ВыданныеСИЗ.СпособВыдачи КАК СпособВыдачи,
		|	Сотрудники.Кратность КАК Кратность,
		|	Сотрудники.Периодичность КАК Периодичность,
		|	Сотрудники.ЕдиницаПериодичности КАК ЕдиницаПериодичности
		|ИЗ
		|	ВТСотрудникиТребующиеВыдачи КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВыданныеСИЗ КАК ВыданныеСИЗ
		|		ПО (ВыданныеСИЗ.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|		И (ВыданныеСИЗ.РабочееМесто = Сотрудники.РабочееМесто)
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо,
		|	РабочееМесто,
		|	СИЗ,
		|	ДатаВыдачи";
	
	Обход = Обработки.ОбходКоллекции.НовыйОбход(Запрос.Выполнить().Выгрузить());
	Пока Обход.СледующийПоЗначениюПоля("ФизическоеЛицо") Цикл
		Пока Обход.СледующийПоЗначениюПоля("РабочееМесто") Цикл
			НоваяСтрока = ВыдачиСИЗ.Добавить();
			ДатаСледующейВыдачи = ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата();
			Пока Обход.СледующийПоЗначениюПоля("СИЗ") Цикл
				ДатаСледующейВыдачиСИЗ = '00010101';
				Пока Обход.Следующий() Цикл
					ТекущиеДанные = Обход.ТекущиеДанные();
					Если НоваяСтрока.ДатаВыдачи < ТекущиеДанные.ДатаВыдачи Тогда
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные, , "ДатаСледующейВыдачи");
					КонецЕсли;
					Если ТекущиеДанные.СпособВыдачи = Перечисления.СпособыВыдачиСИЗ.ДоИзноса
						И Не ЗначениеЗаполнено(НоваяСтрока.ДатаСледующейВыдачи) Тогда
						ДатаСледующейВыдачиСИЗ = ЗарплатаКадрыПериодическиеРегистры.МаксимальнаяДата(); 
						Прервать;
					ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДатаСледующейВыдачи) Тогда
						Если ТекущиеДанные.РезультатВыдачи = Перечисления.РезультатыВыдачиСИЗ.ЧастичноВыдано Тогда
							ДатаСледующейВыдачиТекущая = ТекущиеДанные.ДатаВыдачи;
						Иначе
							ДатаСледующейВыдачиТекущая = ТекущиеДанные.ДатаСледующейВыдачи;
						КонецЕсли;
					Иначе
						ОписаниеПериодичности = ОписаниеПериодичностиВыдачи();
						ДатаСледующейВыдачиТекущая = ДатаСледующейВыдачи(ТекущиеДанные.ДатаВыдачи, ОписаниеПериодичности);
					КонецЕсли;
					Если ДатаСледующейВыдачиТекущая > ДатаСледующейВыдачиСИЗ Тогда
						ДатаСледующейВыдачиСИЗ = ДатаСледующейВыдачиТекущая;
					КонецЕсли;
				КонецЦикла;
				Если ДатаСледующейВыдачиСИЗ < ДатаСледующейВыдачи Тогда
					ДатаСледующейВыдачи = ДатаСледующейВыдачиСИЗ;
				КонецЕсли;
			КонецЦикла;
			НоваяСтрока.ДатаСледующейВыдачи = ДатаСледующейВыдачи;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВыдачиСИЗКПерезачету(Запрос, МенеджерВТ, ВыдачиСИЗ)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	СИЗРабочегоМеста.СИЗ КАК СИЗ
		|ПОМЕСТИТЬ ВТТребуемыеСИЗ
		|ИЗ
		|	ВТСотрудникиНеПолучавшиеСИЗНаПозиции КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО (СИЗРабочегоМеста.РабочееМесто = Сотрудники.РабочееМесто)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ВыдачиСИЗПоНоменклатуре.ДатаВыдачи, ДЕНЬ) КАК ДатаВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор КАК ВыдачаСИЗ,
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи КАК ЗаказНаВыдачуСИЗ,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи
		|ПОМЕСТИТЬ ВТВыдачиСИЗПоНоменклатуреНаРуках
		|ИЗ
		|	ВТВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТребуемыеСИЗ КАК ТребуемыеСИЗ
		|		ПО ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо = ТребуемыеСИЗ.ФизическоеЛицо
		|		И ВыдачиСИЗПоНоменклатуре.ГоловнаяОрганизация = ТребуемыеСИЗ.ГоловнаяОрганизация
		|		И ВыдачиСИЗПоНоменклатуре.СИЗ = ТребуемыеСИЗ.СИЗ
		|		И ВыдачиСИЗПоНоменклатуре.Количество > 0";
	Запрос.Выполнить();
	
	// Выявляются люди и рабочие места, которым 
	// - не получается "перезачесть" из-за как минимум одного СИЗ,
	// - можно полностью "перезачесть" выдачу по СИЗ.
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	ВЫБОР
		|		КОГДА ВыдачиСИЗПоНоменклатуре.ДатаВыдачи ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НельзяПерезачесть
		|ПОМЕСТИТЬ ВТСотрудникиВыдачаНаПозицииКПерезачету
		|ИЗ
		|	ВТСотрудникиНеПолучавшиеСИЗНаПозиции КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО (СИЗРабочегоМеста.РабочееМесто = Сотрудники.РабочееМесто)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыдачиСИЗПоНоменклатуреНаРуках КАК ВыдачиСИЗПоНоменклатуре
		|		ПО (ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|			И (ВыдачиСИЗПоНоменклатуре.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация)
		|			И (ВыдачиСИЗПоНоменклатуре.СИЗ = СИЗРабочегоМеста.СИЗ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТСотрудникиВыдачуНаПозицииНельзяПерезачесть
		|ИЗ
		|	ВТСотрудникиВыдачаНаПозицииКПерезачету КАК Сотрудники
		|ГДЕ
		|	Сотрудники.НельзяПерезачесть
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	КадровыеДанные.ДатаНачала КАК ДатаСледующейВыдачи,
		|	ВЫБОР
		|		КОГДА (Сотрудники.ФизическоеЛицо, Сотрудники.ГоловнаяОрганизация) В
		|				(ВЫБРАТЬ
		|					СотрудникиВыдачаНаПозицииКПерезачету.ФизическоеЛицо,
		|					СотрудникиВыдачаНаПозицииКПерезачету.ГоловнаяОрганизация
		|				ИЗ
		|					ВТСотрудникиВыдачаНаПозицииКПерезачету КАК СотрудникиВыдачаНаПозицииКПерезачету
		|				ГДЕ
		|					НЕ СотрудникиВыдачаНаПозицииКПерезачету.НельзяПерезачесть)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РезультатыВыдачиСИЗ.ЧастичноВыдано)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РезультатыВыдачиСИЗ.НеВыдано)
		|	КОНЕЦ КАК РезультатВыдачи
		|ИЗ
		|	ВТСотрудникиВыдачуНаПозицииНельзяПерезачесть КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСотрудникиТребующиеВыдачи КАК КадровыеДанные
		|		ПО (КадровыеДанные.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|			И (КадровыеДанные.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация)
		|			И (КадровыеДанные.РабочееМесто = Сотрудники.РабочееМесто)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Перечисляем тех, кому не получилось перезачесть выдачу из-за одного или нескольких СИЗ.
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ВыдачиСИЗ.Добавить(), Выборка);
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТСотрудникиВыдачуНаПозицииМожноПерезачесть
		|ИЗ
		|	ВТСотрудникиНеПолучавшиеСИЗНаПозиции КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСотрудникиВыдачуНаПозицииНельзяПерезачесть КАК НельзяПерезачесть
		|		ПО (НельзяПерезачесть.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|			И (НельзяПерезачесть.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация)
		|			И (НельзяПерезачесть.РабочееМесто = Сотрудники.РабочееМесто)
		|ГДЕ
		|	НельзяПерезачесть.РабочееМесто ЕСТЬ NULL";
	Запрос.Выполнить();
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВТ, "ВТСотрудникиВыдачуНаПозицииМожноПерезачесть") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СИЗ.Ссылка КАК Ссылка,
		|	СИЗ.КратностьВыдачи КАК КратностьВыдачи,
		|	СИЗ.ПериодичностьВыдачи КАК ПериодичностьВыдачи,
		|	СИЗ.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичностиВыдачи
		|ПОМЕСТИТЬ ВТСправочникиСИЗ
		|ИЗ
		|	Справочник.СредстваИндивидуальнойЗащиты КАК СИЗ";
	Запрос.Выполнить();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Сотрудники.РабочееМесто КАК РабочееМесто,
		|	ВыдачиСИЗПоНоменклатуре.ДатаВыдачи КАК ДатаВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ЗаказНаВыдачуСИЗ КАК ЗаказНаВыдачуСИЗ,
		|	ВыдачиСИЗПоНоменклатуре.ВыдачаСИЗ КАК ВыдачаСИЗ,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	СправочникСИЗ.КратностьВыдачи КАК Кратность,
		|	СправочникСИЗ.ПериодичностьВыдачи КАК Периодичность,
		|	СправочникСИЗ.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичности
		|ИЗ
		|	ВТСотрудникиВыдачуНаПозицииМожноПерезачесть КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО (СИЗРабочегоМеста.РабочееМесто = Сотрудники.РабочееМесто)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСправочникиСИЗ КАК СправочникСИЗ
		|		ПО (СправочникСИЗ.Ссылка = СИЗРабочегоМеста.СИЗ)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВыдачиСИЗПоНоменклатуреНаРуках КАК ВыдачиСИЗПоНоменклатуре
		|		ПО (ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|		И (ВыдачиСИЗПоНоменклатуре.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация)
		|		И (ВыдачиСИЗПоНоменклатуре.СИЗ = СИЗРабочегоМеста.СИЗ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо,
		|	РабочееМесто";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("ФизическоеЛицо") Цикл
		Пока Выборка.СледующийПоЗначениюПоля("РабочееМесто") Цикл
			НоваяСтрока = ВыдачиСИЗ.Добавить();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.ДатаСледующейВыдачи) Тогда
					ДатаСледующейВыдачи = Выборка.ДатаСледующейВыдачи;
				Иначе
					ОписаниеПериодичности = ОписаниеПериодичностиВыдачи();
					ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Выборка);
					ДатаСледующейВыдачи = ДатаСледующейВыдачи(Выборка.ДатаВыдачи, ОписаниеПериодичности);
				КонецЕсли;
				Если Не ЗначениеЗаполнено(НоваяСтрока.ДатаСледующейВыдачи) Тогда
					НоваяСтрока.ДатаСледующейВыдачи = ДатаСледующейВыдачи;
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				Иначе
					Если ДатаСледующейВыдачи < НоваяСтрока.ДатаСледующейВыдачи Тогда
						НоваяСтрока.ДатаСледующейВыдачи = ДатаСледующейВыдачи;
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяТаблицаВыдачиСИЗ()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	Таблица.Колонки.Добавить("ГоловнаяОрганизация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	Таблица.Колонки.Добавить("ДатаВыдачи", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ДатаСледующейВыдачи", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ЗаказНаВыдачуСИЗ", Метаданные.ОпределяемыеТипы.ОснованиеВыдачиСИЗ.Тип);
	Таблица.Колонки.Добавить("ВыдачаСИЗ", Метаданные.ОпределяемыеТипы.ДокументОснованиеВыдачиСИЗ.Тип);
	Таблица.Колонки.Добавить("РезультатВыдачи", Новый ОписаниеТипов("ПеречислениеСсылка.РезультатыВыдачиСИЗ"));
	
	Возврат Таблица;
	
КонецФункции

Функция ЧастейВГоду(ЕдиницаПериодичности)
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Перечисления.Периодичность.Год, 1);
	Соответствие.Вставить(Перечисления.Периодичность.Полугодие, 2);
	Соответствие.Вставить(Перечисления.Периодичность.Квартал, 4);
	Соответствие.Вставить(Перечисления.Периодичность.Месяц, 12);
	
	Возврат Соответствие[ЕдиницаПериодичности];
	
КонецФункции
 
Процедура ЗарегистрироватьОшибкуОбработкиВыдачиСИЗ(ИнформацияОбОшибке, ПредставлениеОбработки)
	
	ИмяСобытия = НСтр("ru = 'Средства индивидуальной защиты'", ОбщегоНазначения.КодОсновногоЯзыка());
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, 
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Ошибка при обработке средств индивидуальной защиты. Обратитесь к администратору.
              |Техническая информация:
              |При выполнении операции «%1» возникает
              |%2'"), 
		ПредставлениеОбработки,
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

Процедура УстановитьИсключительнуюБлокировкуПоСсылке(Ссылка)
	
	Блокировка = Новый БлокировкаДанных();
	
	ЭлементБлокировки = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
		
КонецПроцедуры

Функция ИмяНачинаетсяСЦифры(ИмяРеквизита)
	
	ПервыйСимвол = Лев(ИмяРеквизита, 1);
	Если СтрНайти("0123456789", ПервыйСимвол) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПечатьЛичнаяКарточкаУчетаВыдачиСИЗ(МассивОбъектов, ОбъектыПечати) 
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ДокументРезультат.АвтоМасштаб = Истина;
	
	ОтчетЛичнаяКарточка = Отчеты.ЛичнаяКарточкаУчетаВыдачиСИЗ.Создать();
	ОтчетЛичнаяКарточка.ИнициализироватьОтчет();
	ОтчетЛичнаяКарточка.КомпоновщикНастроек.ЗагрузитьНастройки(
		ОтчетЛичнаяКарточка.СхемаКомпоновкиДанных.ВариантыНастроек.ЛичнаяКарточкаУчетаВыдачиСИЗ.Настройки);
	
	ЗначениеПараметра = ОтчетЛичнаяКарточка.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("КлючВарианта"));
	Если ЗначениеПараметра <> Неопределено Тогда
		ЗначениеПараметра.Значение = "ЛичнаяКарточкаУчетаВыдачиСИЗ";
	КонецЕсли; 
	
	Отбор = ОтчетЛичнаяКарточка.КомпоновщикНастроек.Настройки.Отбор;
	Отбор.Элементы.Очистить();
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Отбор, "Сотрудник", ВидСравненияКомпоновкиДанных.ВСписке, МассивОбъектов);
	
	ОтчетЛичнаяКарточка.СкомпоноватьРезультат(ДокументРезультат);
	
	Возврат ДокументРезультат;
	
КонецФункции

