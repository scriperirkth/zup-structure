#КонецОбласти

Процедура УстановитьИспользованиеСредствИндивидуальнойЗащиты(Организация = Неопределено) Экспорт
	
	ТребуетсяНачальноеЗаполнениеСправочниковСИЗ = Не СредстваИндивидуальнойЗащитыИспользуются();
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Для Каждого ЭлементОрганизация Из ОрганизационнаяСтруктура.ВсеОрганизацииБезУправленческой(, Ложь) Цикл
			ЗаписатьНастройкиОхраныТруда(ЭлементОрганизация);
		КонецЦикла;
	Иначе
		ЗаписатьНастройкиОхраныТруда(Организация);
	КонецЕсли;

	Если ТребуетсяНачальноеЗаполнениеСправочниковСИЗ Тогда
		ВыполнитьНачальноеЗаполнениеСправочниковСИЗ();
	КонецЕсли;

КонецПроцедуры

// Обработчик подписки на событие УстановитьИспользованиеДополнительныхРеквизитовИСведений
//
// Параметры:
//	Источник - КонстантаМенеджерЗначения.ИспользоватьДополнительныеРеквизитыИСведения.
//	Отказ - Булево - отказ от стандартной обработки
//
Процедура УстановитьИспользованиеДополнительныхРеквизитовИСведенийПриЗаписи(Источник, Отказ) Экспорт
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.Значение Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СредстваИндивидуальнойЗащитыИспользуются() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Константы.ИспользоватьСредстваИндивидуальнойЗащиты.Установить(Ложь);
	Для Каждого Организация Из ОрганизационнаяСтруктура.ВсеОрганизацииБезУправленческой(, Ложь) Цикл
		НастройкиОхраныТруда = РегистрыСведений.НастройкиОхраныТруда.СоздатьНаборЗаписей();
		НастройкиОхраныТруда.Отбор.Организация.Установить(Организация);
		НастройкиОхраныТруда.Прочитать();
		Для Каждого Настройка Из НастройкиОхраныТруда Цикл
			Настройка.ИспользоватьСредстваИндивидуальнойЗащиты = Ложь;
		КонецЦикла;
		НастройкиОхраныТруда.Записать();
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
	ТекстСообщения = НСтр("ru = 'Использование средств индивидуальной защиты невозможно без использования дополнительных реквизитов и сведений.
			 | Использование средств индивидуальной защиты так же будет выключено.'");
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

Функция АнтропометрияФизическихЛиц(ФизическиеЛица) Экспорт
	
	АнтропометрияФизическихЛиц = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛица);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АнтропометрияФизическихЛиц.ФизическоеЛицо,
		|	АнтропометрияФизическихЛиц.Рост,
		|	АнтропометрияФизическихЛиц.РостДо,
		|	АнтропометрияФизическихЛиц.РазмерОдежды,
		|	АнтропометрияФизическихЛиц.РазмерОбуви,
		|	АнтропометрияФизическихЛиц.РазмерГоловногоУбора,
		|	АнтропометрияФизическихЛиц.РазмерПротивогаза,
		|	АнтропометрияФизическихЛиц.РазмерРеспиратора,
		|	АнтропометрияФизическихЛиц.РазмерПерчаток,
		|	АнтропометрияФизическихЛиц.РазмерРукавиц,
		|	АнтропометрияФизическихЛиц.ПредставлениеРазмеров,
		|	АнтропометрияФизическихЛиц.ДатаВводаИзмерений,
		|	АнтропометрияФизическихЛиц.Ответственный,
		|	АнтропометрияФизическихЛиц.Комментарий
		|ИЗ
		|	РегистрСведений.АнтропометрияФизическихЛиц КАК АнтропометрияФизическихЛиц
		|ГДЕ
		|	АнтропометрияФизическихЛиц.ФизическоеЛицо В (&ФизическиеЛица)";
	
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		АнтропометрияФизическихЛиц.Вставить(Строка.ФизическоеЛицо, ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Строка));
	КонецЦикла;
	
	Возврат АнтропометрияФизическихЛиц;
	
КонецФункции

Процедура СоздатьОбновитьДополнительныйРеквизит(ВидНоменклатуры, Наименование, ИмяНабораСвойств, ИмяОбъектаСоСвойствами,
		СИЗ = Неопределено, СтрокаТипа = "Булево") Экспорт
	
	НачатьТранзакцию();
	
	Попытка
		НаборСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, ИмяНабораСвойств); // СправочникСсылка.НаборыДополнительныхРеквизитовИСведений
		
		НаименованиеНабора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НаборСвойств, "Наименование");
		
		Если Не ЗначениеЗаполнено(НаборСвойств) Тогда
			РодительНабора = УправлениеСвойствами.НаборСвойствПоИмени(ИмяОбъектаСоСвойствами);
			
			НаборСвойствОбъект = Справочники.НаборыДополнительныхРеквизитовИСведений.СоздатьЭлемент();
			НаборСвойствОбъект.Используется = Истина;
			НаборСвойствОбъект.Наименование = ВидНоменклатуры.Наименование;
			НаборСвойствОбъект.Родитель = РодительНабора;
			НаборСвойствОбъект.Записать();
			НаборСвойств = НаборСвойствОбъект.Ссылка;
			
			ВидНоменклатурыОбъект = ВидНоменклатуры.ПолучитьОбъект();
			ВидНоменклатурыОбъект[ИмяНабораСвойств] = НаборСвойств;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ВидНоменклатурыОбъект);
		Иначе
			НаборСвойствОбъект = НаборСвойств.ПолучитьОбъект();
		КонецЕсли;
		
		РеквизитСсылка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(Наименование);
		Если ЗначениеЗаполнено(РеквизитСсылка) Тогда
			УстановитьИсключительнуюБлокировкуПоСсылке(РеквизитСсылка);
			РеквизитОбъект = РеквизитСсылка.ПолучитьОбъект();
		Иначе
			РеквизитОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
			РеквизитОбъект.ТипЗначения = Новый ОписаниеТипов(СтрокаТипа);
			ЗаголовокОбъекта = Наименование;
			УдалитьНедопустимыеСимволы(ЗаголовокОбъекта);
			ЗаголовокОбъектаЧастями = СтрРазделить(ЗаголовокОбъекта, " ", Ложь);
			Для Каждого ЧастьЗаголовка Из ЗаголовокОбъектаЧастями Цикл
				РеквизитОбъект.Имя = РеквизитОбъект.Имя + ВРег(Лев(ЧастьЗаголовка, 1)) + Сред(ЧастьЗаголовка, 2);
			КонецЦикла;
			
			Если ИмяНачинаетсяСЦифры(РеквизитОбъект.Имя) Тогда
				РеквизитОбъект.Имя = "_" + РеквизитОбъект.Имя;
			КонецЕсли;
			
			СтрокаУИД = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
			РеквизитОбъект.Имя = РеквизитОбъект.Имя + "_" + СтрокаУИД;
			
			РеквизитОбъект.НаборСвойств = НаборСвойств;
			РеквизитОбъект.Доступен     = Истина;
			РеквизитОбъект.Наименование = Наименование + " (" + НаименованиеНабора + ")";
			РеквизитОбъект.Заголовок    = Наименование;
			РеквизитОбъект.Записать();
			РеквизитСсылка = РеквизитОбъект.Ссылка;
		КонецЕсли;
		
		УстановитьИсключительнуюБлокировкуПоСсылке(НаборСвойств);
		
		ОтборСвойства = Новый Структура("Свойство", РеквизитСсылка);
		Если НаборСвойствОбъект.ДополнительныеРеквизиты.НайтиСтроки(ОтборСвойства).Количество() = 0 Тогда;
			НоваяСтрокаРеквизита = НаборСвойствОбъект.ДополнительныеРеквизиты.Добавить();
			НоваяСтрокаРеквизита.Свойство = РеквизитСсылка;
			НаборСвойствОбъект.Записать();
		КонецЕсли;
		
		Если Не СИЗ = Неопределено И СИЗ.ДополнительныеРеквизиты.НайтиСтроки(ОтборСвойства).Количество() = 0 Тогда
			НоваяСтрокаРеквизитаСИЗ = СИЗ.ДополнительныеРеквизиты.Добавить();
			НоваяСтрокаРеквизитаСИЗ.Свойство = РеквизитСсылка;
			НоваяСтрокаРеквизитаСИЗ.Значение = Истина;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция НормыВыдачиСИЗФизическогоЛица(Знач ФизическоеЛицо, РабочееМесто, ДатаАктуальности = '00010101') Экспорт
	
	ВыдачиПоНоменклатуреСИЗ = Новый ТаблицаЗначений;
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("СИЗ", Новый ОписаниеТипов("СправочникСсылка.СредстваИндивидуальнойЗащиты"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("Периодичность", Новый ОписаниеТипов("Структура"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("ПоследняяВыдача", Новый ОписаниеТипов("Дата"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("СледующаяВыдача", Новый ОписаниеТипов("Дата"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("Результат", Новый ОписаниеТипов("ПеречислениеСсылка.РезультатыВыдачиСИЗ"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("СостояниеПроцент", Новый ОписаниеТипов("Число"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("Требуется", Новый ОписаниеТипов("Булево"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("Дежурное", Новый ОписаниеТипов("Булево"));
	ВыдачиПоНоменклатуреСИЗ.Колонки.Добавить("Регистратор");
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СоздатьВТСИЗРабочегоМеста(МенеджерВременныхТаблиц, РабочееМесто);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	&ФизическоеЛицо КАК ФизическоеЛицо,
		|	&РабочееМесто КАК РабочееМесто
		|ПОМЕСТИТЬ ВТФизическиеЛица";
	
	Запрос.Выполнить();
	
	СоздатьВТВыдачиСИЗПоНоменклатуре(МенеджерВременныхТаблиц, "ВТФизическиеЛица", ДатаАктуальности, , Ложь);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ЕСТЬNULL(СИЗРабочегоМеста.Количество, СредстваИндивидуальнойЗащиты.КоличествоПоУмолчанию) КАК Количество,
		|	ЕСТЬNULL(СИЗРабочегоМеста.ЕдиницаИзмерения, СредстваИндивидуальнойЗащиты.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
		|	ЕСТЬNULL(СИЗРабочегоМеста.СпособВыдачи, СредстваИндивидуальнойЗащиты.СпособВыдачи) КАК СпособВыдачи,
		|	ЕСТЬNULL(СИЗРабочегоМеста.Дежурное, ЛОЖЬ) КАК Дежурное,
		|	ЕСТЬNULL(СИЗРабочегоМеста.КратностьВыдачи, СредстваИндивидуальнойЗащиты.КратностьВыдачи) КАК Кратность,
		|	ЕСТЬNULL(СИЗРабочегоМеста.ПериодичностьВыдачи, СредстваИндивидуальнойЗащиты.ПериодичностьВыдачи) КАК Периодичность,
		|	ЕСТЬNULL(СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи, СредстваИндивидуальнойЗащиты.ЕдиницаПериодичностиВыдачи) КАК
		|		ЕдиницаПериодичности,
		|	ЕСТЬNULL(СИЗРабочегоМеста.ПредставлениеПериодичностиВыдачи,
		|		СредстваИндивидуальнойЗащиты.ПредставлениеПериодичностиВыдачи) КАК ПредставлениеПериодичности,
		|	ВыдачиСИЗПоНоменклатуре.ДатаВыдачи КАК ПоследняяВыдача,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор КАК Регистратор,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи КАК Результат,
		|	ВЫБОР
		|		КОГДА СИЗРабочегоМеста.СИЗ ЕСТЬ НЕ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Требуется
		|ПОМЕСТИТЬ ВТВыдачиСИЗПоНоменклатуреНаРуках
		|ИЗ
		|	ВТВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СредстваИндивидуальнойЗащиты КАК СредстваИндивидуальнойЗащиты
		|		ПО ВыдачиСИЗПоНоменклатуре.СИЗ = СредстваИндивидуальнойЗащиты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО СИЗРабочегоМеста.СИЗ = ВыдачиСИЗПоНоменклатуре.СИЗ
		|ГДЕ
		|	ВыдачиСИЗПоНоменклатуре.Количество > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВыдачиСИЗПоНоменклатуре.СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры,
		|	ВыдачиСИЗПоНоменклатуре.Количество,
		|	ВыдачиСИЗПоНоменклатуре.ЕдиницаИзмерения,
		|	ВыдачиСИЗПоНоменклатуре.СпособВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Дежурное,
		|	ВыдачиСИЗПоНоменклатуре.Кратность,
		|	ВыдачиСИЗПоНоменклатуре.Периодичность,
		|	ВыдачиСИЗПоНоменклатуре.ЕдиницаПериодичности,
		|	ВыдачиСИЗПоНоменклатуре.ПредставлениеПериодичности,
		|	ВыдачиСИЗПоНоменклатуре.ПоследняяВыдача,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор,
		|	ВыдачиСИЗПоНоменклатуре.Результат,
		|	ВыдачиСИЗПоНоменклатуре.Требуется
		|ИЗ
		|	ВТВыдачиСИЗПоНоменклатуреНаРуках КАК ВыдачиСИЗПоНоменклатуре
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СИЗРабочегоМеста.СИЗ,
		|	NULL,
		|	NULL,
		|	СИЗРабочегоМеста.Количество,
		|	СИЗРабочегоМеста.ЕдиницаИзмерения,
		|	СИЗРабочегоМеста.СпособВыдачи,
		|	СИЗРабочегоМеста.Дежурное,
		|	СИЗРабочегоМеста.КратностьВыдачи,
		|	СИЗРабочегоМеста.ПериодичностьВыдачи,
		|	СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи,
		|	СИЗРабочегоМеста.ПредставлениеПериодичностиВыдачи,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	ИСТИНА
		|ИЗ
		|	ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыдачиСИЗПоНоменклатуреНаРуках КАК ВыдачиСИЗПоНоменклатуре
		|		ПО СИЗРабочегоМеста.СИЗ = ВыдачиСИЗПоНоменклатуре.СИЗ
		|ГДЕ
		|	ВыдачиСИЗПоНоменклатуре.СИЗ ЕСТЬ NULL";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьСтрокуТаблицыВыдачиПоСИЗ(ВыдачиПоНоменклатуреСИЗ, Выборка);
	КонецЦикла;
	
	Возврат ВыдачиПоНоменклатуреСИЗ;
	
КонецФункции

Функция НормыВыдачиСИЗФизическихЛиц(Параметры, СИЗ, ДанныеРабочихМест) Экспорт
	
	НормыВыдачиСИЗ = Новый ТаблицаЗначений;
	НормыВыдачиСИЗ.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	НормыВыдачиСИЗ.Колонки.Добавить("СИЗ", Новый ОписаниеТипов("СправочникСсылка.СредстваИндивидуальнойЗащиты"));
	НормыВыдачиСИЗ.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	НормыВыдачиСИЗ.Колонки.Добавить("ДатаСледующейВыдачи", Новый ОписаниеТипов("Дата"));
	НормыВыдачиСИЗ.Колонки.Добавить("ПериодичностьМесяц", Новый ОписаниеТипов("Булево"));
	НормыВыдачиСИЗ.Колонки.Добавить("Требуется", Новый ОписаниеТипов("Булево"));
	НормыВыдачиСИЗ.Колонки.Добавить("ДоступноДляПодбора", Новый ОписаниеТипов("Булево"));
	НормыВыдачиСИЗ.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	НормыВыдачиСИЗ.Колонки.Добавить("Выдано", Новый ОписаниеТипов("Булево"));
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	СоздатьВТСИЗРабочегоМеста(МенеджерВТ, , СИЗ, Параметры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СИЗРабочегоМеста.СИЗ КАК СИЗ,
		|	СИЗРабочегоМеста.РабочееМесто КАК РабочееМесто
		|ИЗ
		|	ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста";
	ДанныеРабочихМест = Запрос.Выполнить().Выгрузить();
	Если ДанныеРабочихМест.Количество() = 0 Тогда
		Возврат НормыВыдачиСИЗ;
	КонецЕсли;
	
	СоздатьВТСотрудникиОрганизацииЗанятыеНаРабочихМестах(
		МенеджерВТ, Параметры, ДанныеРабочихМест.ВыгрузитьКолонку("РабочееМесто"));
	СоздатьВТВыдачиСИЗПоНоменклатуре(
		МенеджерВТ, "ВТСотрудникиОрганизацииЗанятыеНаРабочихМестах", Параметры.ДатаАктуальности, "РабочееМестоОхраныТруда");
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.РабочееМесто КАК РабочееМесто,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ЕСТЬNULL(СИЗРабочегоМеста.СпособВыдачи, СредстваИндивидуальнойЗащиты.СпособВыдачи) КАК СпособВыдачи,
		|	ЕСТЬNULL(СИЗРабочегоМеста.Дежурное, ЛОЖЬ) КАК Дежурное,
		|	ЕСТЬNULL(СИЗРабочегоМеста.КратностьВыдачи, СредстваИндивидуальнойЗащиты.КратностьВыдачи) КАК Кратность,
		|	ЕСТЬNULL(СИЗРабочегоМеста.ПериодичностьВыдачи, СредстваИндивидуальнойЗащиты.ПериодичностьВыдачи) КАК Периодичность,
		|	ЕСТЬNULL(СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи, СредстваИндивидуальнойЗащиты.ЕдиницаПериодичностиВыдачи) КАК
		|		ЕдиницаПериодичности,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	ВЫБОР
		|		КОГДА СИЗРабочегоМеста.СИЗ ЕСТЬ НЕ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Требуется
		|ПОМЕСТИТЬ ВТВыдачиСИЗПоНоменклатуреНаРуках
		|ИЗ
		|	ВТВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СредстваИндивидуальнойЗащиты КАК СредстваИндивидуальнойЗащиты
		|		ПО ВыдачиСИЗПоНоменклатуре.СИЗ = СредстваИндивидуальнойЗащиты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО СИЗРабочегоМеста.РабочееМесто = ВыдачиСИЗПоНоменклатуре.РабочееМесто
		|		И СИЗРабочегоМеста.СИЗ = ВыдачиСИЗПоНоменклатуре.СИЗ
		|ГДЕ
		|	ВыдачиСИЗПоНоменклатуре.Количество > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СотрудникиОрганизацииЗанятыеНаРабочихМестах.ФизическоеЛицо,
		|	СИЗРабочегоМеста.РабочееМесто КАК РабочееМесто,
		|	СИЗРабочегоМеста.СИЗ,
		|	СИЗРабочегоМеста.СпособВыдачи,
		|	СИЗРабочегоМеста.Дежурное,
		|	СИЗРабочегоМеста.КратностьВыдачи,
		|	СИЗРабочегоМеста.ПериодичностьВыдачи,
		|	СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи,
		|	СотрудникиОрганизацииЗанятыеНаРабочихМестах.РабочееМестоОхраныТрудаПериодРегистрации КАК ДатаСледующейВыдачи,
		|	ИСТИНА КАК Требуется
		|ПОМЕСТИТЬ ВТНормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи
		|ИЗ
		|	ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСотрудникиОрганизацииЗанятыеНаРабочихМестах КАК СотрудникиОрганизацииЗанятыеНаРабочихМестах
		|		ПО СИЗРабочегоМеста.РабочееМесто = СотрудникиОрганизацииЗанятыеНаРабочихМестах.РабочееМестоОхраныТруда
		|;
