		|	ИСТИНА КАК Выдано
		|ПОМЕСТИТЬ ВТНормыВыдачиСИЗФизическихЛиц
		|ИЗ
		|	ВТВыдачиСИЗПоНоменклатуреНаРуках КАК ВыдачиСИЗПоНоменклатуре
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.ФизическоеЛицо,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.РабочееМесто КАК РабочееМесто,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.СИЗ,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.СпособВыдачи,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.Дежурное,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.КратностьВыдачи,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.ПериодичностьВыдачи,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.ЕдиницаПериодичностиВыдачи,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.ДатаСледующейВыдачи,
		|	НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.Требуется,
		|	ЛОЖЬ
		|ИЗ
		|	ВТНормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи КАК НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыдачиСИЗПоНоменклатуреНаРуках КАК ВыдачиСИЗПоНоменклатуре
		|		ПО НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.ФизическоеЛицо = ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо
		|		И НормыВыдачиСИЗФизическихЛицБезСостоянияВыдачи.СИЗ = ВыдачиСИЗПоНоменклатуре.СИЗ
		|ГДЕ
		|	ВыдачиСИЗПоНоменклатуре.СИЗ ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НормыВыдачиСИЗФизическихЛиц.ФизическоеЛицо КАК Сотрудник,
		|	НормыВыдачиСИЗФизическихЛиц.РабочееМесто,
		|	НормыВыдачиСИЗФизическихЛиц.СИЗ,
		|	МАКСИМУМ(НормыВыдачиСИЗФизическихЛиц.ДатаСледующейВыдачи) КАК ДатаСледующейВыдачи,
		|	МАКСИМУМ(НормыВыдачиСИЗФизическихЛиц.Требуется) КАК Требуется,
		|	МАКСИМУМ(НормыВыдачиСИЗФизическихЛиц.Выдано) КАК Выдано,
		|	ВЫБОР
		|		КОГДА НормыВыдачиСИЗФизическихЛиц.СпособВыдачи = ЗНАЧЕНИЕ(Перечисление.СпособыВыдачиСИЗ.СПериодичностью)
		|		И НормыВыдачиСИЗФизическихЛиц.ЕдиницаПериодичности = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|		И НормыВыдачиСИЗФизическихЛиц.Кратность = 1
		|		И НормыВыдачиСИЗФизическихЛиц.Периодичность = 1
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПериодичностьМесяц
		|ИЗ
		|	ВТНормыВыдачиСИЗФизическихЛиц КАК НормыВыдачиСИЗФизическихЛиц
		|СГРУППИРОВАТЬ ПО
		|	НормыВыдачиСИЗФизическихЛиц.ФизическоеЛицо,
		|	НормыВыдачиСИЗФизическихЛиц.РабочееМесто,
		|	НормыВыдачиСИЗФизическихЛиц.СИЗ,
		|	ВЫБОР
		|		КОГДА НормыВыдачиСИЗФизическихЛиц.СпособВыдачи = ЗНАЧЕНИЕ(Перечисление.СпособыВыдачиСИЗ.СПериодичностью)
		|		И НормыВыдачиСИЗФизическихЛиц.ЕдиницаПериодичности = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|		И НормыВыдачиСИЗФизическихЛиц.Кратность = 1
		|		И НормыВыдачиСИЗФизическихЛиц.Периодичность = 1
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСледующейВыдачи";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = НормыВыдачиСИЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ДоступноДляПодбора = НоваяСтрока.Требуется И НоваяСтрока.ДатаСледующейВыдачи <= Параметры.ДатаАктуальности;
		НоваяСтрока.Пометка = НоваяСтрока.ДоступноДляПодбора;
	КонецЦикла;
	
	Возврат НормыВыдачиСИЗ;
	
КонецФункции

Функция ПериодичностьВыдачиСИЗ(РабочееМесто) Экспорт
	
	ОписаниеПериодичности = ОписаниеПериодичностиВыдачи();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПериодичностьВыдачиСИЗ.КратностьВыдачи КАК Кратность,
		|	ПериодичностьВыдачиСИЗ.ПериодичностьВыдачи КАК Периодичность,
		|	ПериодичностьВыдачиСИЗ.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичности,
		|	ПериодичностьВыдачиСИЗ.ПредставлениеПериодичностиВыдачи КАК Представление
		|ИЗ
		|	РегистрСведений.ПериодичностьВыдачиСИЗРабочихМест КАК ПериодичностьВыдачиСИЗ
		|ГДЕ
		|	ПериодичностьВыдачиСИЗ.РабочееМесто = &РабочееМесто";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ОписаниеПериодичности;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Выборка);
	
	Возврат ОписаниеПериодичности;
	
КонецФункции

Функция ПоследняяВыдача(ФизическоеЛицо, РабочееМесто, ДатаАктуальности = '00010101') Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ВыдачиСИЗПоНоменклатуре.Период, ДЕНЬ) КАК Период,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор КАК Регистратор,
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи КАК РезультатВыдачи
		|ИЗ
		|	РегистрСведений.ВыдачиСИЗПоНоменклатуре.СрезПоследних(&ДатаАктуальности, ФизическоеЛицо = &ФизическоеЛицо И РабочееМесто = РабочееМесто) КАК
		|		ВыдачиСИЗПоНоменклатуре";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
	
КонецФункции

Функция СледующаяВыдача(ФизическоеЛицо, РабочееМесто) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыдачиСИЗ.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	ВыдачиСИЗ.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗ.РабочееМесто КАК РабочееМесто,
		|	ВыдачиСИЗ.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ВыдачиСИЗ.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыдачиСИЗ.ДатаВыдачи КАК ДатаВыдачи,
		|	ВыдачиСИЗ.ЗаказНаВыдачуСИЗ КАК ЗаказНаВыдачуСИЗ,
		|	ВыдачиСИЗ.ВыдачаСИЗ КАК ВыдачаСИЗ
		|ИЗ
		|	РегистрСведений.ВыдачиСИЗ КАК ВыдачиСИЗ
		|ГДЕ
		|	ВыдачиСИЗ.ФизическоеЛицо = &ФизическоеЛицо
		|	И ВыдачиСИЗ.РабочееМесто = &РабочееМесто";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
	
КонецФункции

Функция ПоследниеВыдачиСИЗПоНоменклатуре(ФизическоеЛицо, Организация, ДатаАктуальности = '00010101') Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", ЗарплатаКадры.ГоловнаяОрганизация(Организация));
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ВыдачиСИЗПоНоменклатуре.Период, ДЕНЬ) КАК Период,
		|	ВыдачиСИЗПоНоменклатуре.Регистратор КАК Регистратор,
		|	ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.РезультатВыдачи КАК РезультатВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
		|ИЗ
		|	РегистрСведений.ВыдачиСИЗПоНоменклатуре.СрезПоследних(&ДатаАктуальности, ФизическоеЛицо = &ФизическоеЛицо
		|	И ГоловнаяОрганизация = &ГоловнаяОрганизация) КАК ВыдачиСИЗПоНоменклатуре";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПоследниеВыдачиСИЗ = Новый Соответствие;
	Для Каждого Строка Из РезультатЗапроса.Выгрузить() Цикл
		ПоследниеВыдачиСИЗ.Вставить(Строка.СИЗ, ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Строка));
	КонецЦикла;
	
	Возврат ПоследниеВыдачиСИЗ;
	
КонецФункции

Функция СформированныйЗаказНаВыдачу(ФизическоеЛицо, РабочееМесто) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СформированныеЗаказы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СформированныеЗаказы.РабочееМесто КАК РабочееМесто,
		|	СформированныеЗаказы.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	СформированныеЗаказы.ЗаказНаВыдачуСИЗ КАК ЗаказНаВыдачуСИЗ
		|ИЗ
		|	РегистрНакопления.СформированныеЗаказыНаВыдачуСИЗ.Остатки(, ФизическоеЛицо = &ФизическоеЛицо
		|	И РабочееМесто = &РабочееМесто) КАК СформированныеЗаказы
		|ГДЕ
		|	СформированныеЗаказы.КоличествоОстаток > 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
	
КонецФункции

Функция СИЗКЗаказуНаВыдачу(ТаблицаФизическиеЛицаРабочиеМеста, ДатаАктуальности, ОтмеченныеСИЗ = Неопределено) Экспорт
	
	Колонки = ТаблицаФизическиеЛицаРабочиеМеста.Колонки;
	КолонкаОтмеченныеСИЗ = Колонки.Найти("ОтмеченныеСИЗ");
	Если КолонкаОтмеченныеСИЗ <> Неопределено Тогда
		Колонки.Удалить(Колонки.Индекс(КолонкаОтмеченныеСИЗ));
	КонецЕсли;
	
	ТаблицаСИЗ = Новый ТаблицаЗначений;
	ТаблицаСИЗ.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	ТаблицаСИЗ.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТаблицаСИЗ.Колонки.Добавить("СИЗ", Новый ОписаниеТипов("СправочникСсылка.СредстваИндивидуальнойЗащиты"));
	ТаблицаСИЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСИЗ.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаСИЗ.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаСИЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ОснованиеВыдачи", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаВыдачуСИЗ"));
	ТаблицаСИЗ.Колонки.Добавить("СпособВыдачи", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыВыдачиСИЗ"));
	ТаблицаСИЗ.Колонки.Добавить("Дежурное", Новый ОписаниеТипов("Булево"));
	ТаблицаСИЗ.Колонки.Добавить("КратностьВыдачи", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ПериодичностьВыдачи", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ЕдиницаПериодичностиВыдачи", Новый ОписаниеТипов("ПеречислениеСсылка.Периодичность"));
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗарплатаКадры.СоздатьВТПоТаблицеЗначений(МенеджерВременныхТаблиц, ТаблицаФизическиеЛицаРабочиеМеста, "ВТФизическиеЛицаРабочиеМеста");
	СоздатьВТСИЗРабочегоМеста(
		МенеджерВременныхТаблиц, ТаблицаФизическиеЛицаРабочиеМеста.ВыгрузитьКолонку("РабочееМесто"), ОтмеченныеСИЗ);
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВременныхТаблиц, "ВТСИЗРабочегоМеста") Тогда
		Возврат ТаблицаСИЗ;
	КонецЕсли;
	
	СоздатьВТВыдачиСИЗПоНоменклатуре(МенеджерВременныхТаблиц, "ВТФизическиеЛицаРабочиеМеста", ДатаАктуальности);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛицаРабочиеМеста.РабочееМесто КАК РабочееМесто,
		|	ФизическиеЛицаРабочиеМеста.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СИЗРабочегоМеста.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.ДатаВыдачи КАК ДатаВыдачи,
		|	СИЗРабочегоМеста.СпособВыдачи,
		|	СИЗРабочегоМеста.Дежурное,
		|	СИЗРабочегоМеста.КратностьВыдачи,
		|	СИЗРабочегоМеста.ПериодичностьВыдачи,
		|	СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи,
		|	СИЗРабочегоМеста.ПредставлениеПериодичностиВыдачи КАК ПредставлениеПериодичностиВыдачи,
		|	ЕСТЬNULL(СИЗРабочегоМеста.Количество, 0) КАК НормаВыдачи,
		|	ЕСТЬNULL(ВыдачиСИЗПоНоменклатуре.Количество, 0) КАК КоличествоВыдано,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	СИЗРабочегоМеста.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	ВТФизическиеЛицаРабочиеМеста КАК ФизическиеЛицаРабочиеМеста
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО (ФизическиеЛицаРабочиеМеста.РабочееМесто = СИЗРабочегоМеста.РабочееМесто)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
		|		ПО ФизическиеЛицаРабочиеМеста.ФизическоеЛицо = ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо
		|		И ВыдачиСИЗПоНоменклатуре.СИЗ = СИЗРабочегоМеста.СИЗ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо,
		|	РабочееМесто,
		|	СИЗ";
	
	Обход = Обработки.ОбходКоллекции.НовыйОбход(Запрос.Выполнить().Выгрузить());
	Пока Обход.СледующийПоЗначениюПоля("ФизическоеЛицо") Цикл
		Пока Обход.СледующийПоЗначениюПоля("РабочееМесто") Цикл
			Пока Обход.СледующийПоЗначениюПоля("СИЗ") Цикл
				ОсталосьВыдать = Обход.ТекущиеДанные().НормаВыдачи;
				Пока Обход.Следующий() Цикл
					ТекущиеДанные = Обход.ТекущиеДанные();
					Если Не ЗначениеЗаполнено(ТекущиеДанные.ДатаВыдачи) Тогда
						// Выдачи не было.
						Прервать;
					КонецЕсли;
					// Выдача была, проверяем ее актуальность.
					Если ЗначениеЗаполнено(ТекущиеДанные.ДатаСледующейВыдачи) Тогда
						ДатаСледующейВыдачи = ТекущиеДанные.ДатаСледующейВыдачи;
					Иначе
						ОписаниеПериодичности = ОписаниеПериодичностиВыдачи();
						ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, ТекущиеДанные);
						ОписаниеПериодичности.Кратность = ТекущиеДанные.КратностьВыдачи;
						ОписаниеПериодичности.Периодичность = ТекущиеДанные.ПериодичностьВыдачи;
						ОписаниеПериодичности.ЕдиницаПериодичности = ТекущиеДанные.ЕдиницаПериодичностиВыдачи;
						ДатаСледующейВыдачи = ДатаСледующейВыдачи(ТекущиеДанные.ДатаВыдачи, ОписаниеПериодичности);
					КонецЕсли;
					Если ДатаСледующейВыдачи > ДатаАктуальности Тогда
						ОсталосьВыдать = ОсталосьВыдать - ТекущиеДанные.КоличествоВыдано;
					КонецЕсли;
					Если ОсталосьВыдать <= 0 Тогда
						// Номенклатура выдана и актуальна.
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ОсталосьВыдать > 0 Тогда
					НоваяСтрока = ТаблицаСИЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
					НоваяСтрока.Количество = ОсталосьВыдать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаСИЗ;
	
КонецФункции

Функция ВыданныеСИЗ(ТаблицаФизическиеЛицаРабочиеМеста, ДатаАктуальности, ОтмеченныеСИЗ = Неопределено) Экспорт
	
	ТаблицаСИЗ = Новый ТаблицаЗначений;
	ТаблицаСИЗ.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	ТаблицаСИЗ.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТаблицаСИЗ.Колонки.Добавить("СИЗ", Новый ОписаниеТипов("СправочникСсылка.СредстваИндивидуальнойЗащиты"));
	ТаблицаСИЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСИЗ.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаСИЗ.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаСИЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ДатаВыдачи", Новый ОписаниеТипов("Дата"));
	ТаблицаСИЗ.Колонки.Добавить("ОснованиеВыдачи", Метаданные.ОпределяемыеТипы.ОснованиеВыдачиСИЗ.Тип);
	ТаблицаСИЗ.Колонки.Добавить("ДокументВыдачи", Метаданные.ОпределяемыеТипы.ДокументОснованиеВыдачиСИЗ.Тип);
	ТаблицаСИЗ.Колонки.Добавить("СпособВыдачи", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыВыдачиСИЗ"));
	ТаблицаСИЗ.Колонки.Добавить("Дежурное", Новый ОписаниеТипов("Булево"));
	ТаблицаСИЗ.Колонки.Добавить("КратностьВыдачи", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ПериодичностьВыдачи", Новый ОписаниеТипов("Число"));
	ТаблицаСИЗ.Колонки.Добавить("ЕдиницаПериодичностиВыдачи", Новый ОписаниеТипов("ПеречислениеСсылка.Периодичность"));
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗарплатаКадры.СоздатьВТПоТаблицеЗначений(МенеджерВременныхТаблиц, ТаблицаФизическиеЛицаРабочиеМеста, "ВТФизическиеЛицаРабочиеМеста");
	
	СоздатьВТСИЗРабочегоМеста(МенеджерВременныхТаблиц, , ОтмеченныеСИЗ);
	СоздатьВТВыдачиСИЗПоНоменклатуре(МенеджерВременныхТаблиц, "ВТФизическиеЛицаРабочиеМеста", ДатаАктуальности, , Ложь);
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(МенеджерВременныхТаблиц, "ВТВыдачиСИЗПоНоменклатуре") Тогда
		Возврат ТаблицаСИЗ;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛицаРабочиеМеста.РабочееМесто КАК РабочееМесто,
		|	ФизическиеЛицаРабочиеМеста.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВыдачиСИЗПоНоменклатуре.СИЗ КАК СИЗ,
		|	ВыдачиСИЗПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	ВыдачиСИЗПоНоменклатуре.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВыдачиСИЗПоНоменклатуре.ДатаВыдачи КАК ДатаВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ДокументВыдачи КАК ДокументВыдачи,
		|	ВыдачиСИЗПоНоменклатуре.ОснованиеВыдачи КАК ОснованиеВыдачи,
		|	ЕСТЬNULL(ВыдачиСИЗПоНоменклатуре.Количество, 0) КАК Количество,
		|	ВЫРАЗИТЬ(ВыдачиСИЗПоНоменклатуре.СИЗ КАК Справочник.СредстваИндивидуальнойЗащиты).ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ЕСТЬNULL(СИЗРабочегоМеста.СпособВыдачи, СправочникСИЗ.СпособВыдачи) КАК СпособВыдачи,
		|	ЕСТЬNULL(СИЗРабочегоМеста.Дежурное, ЛОЖЬ) КАК Дежурное,
		|	ЕСТЬNULL(СИЗРабочегоМеста.КратностьВыдачи, СправочникСИЗ.КратностьВыдачи) КАК КратностьВыдачи,
		|	ЕСТЬNULL(СИЗРабочегоМеста.ПериодичностьВыдачи, СправочникСИЗ.ПериодичностьВыдачи) КАК ПериодичностьВыдачи,
		|	ЕСТЬNULL(СИЗРабочегоМеста.ЕдиницаПериодичностиВыдачи, СправочникСИЗ.ЕдиницаПериодичностиВыдачи) КАК ЕдиницаПериодичностиВыдачи
		|ИЗ
		|	ВТФизическиеЛицаРабочиеМеста КАК ФизическиеЛицаРабочиеМеста
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыдачиСИЗПоНоменклатуре КАК ВыдачиСИЗПоНоменклатуре
		|		ПО ФизическиеЛицаРабочиеМеста.ФизическоеЛицо = ВыдачиСИЗПоНоменклатуре.ФизическоеЛицо
		|			И (ВыдачиСИЗПоНоменклатуре.СИЗ В (&ОтмеченныеСИЗ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСИЗРабочегоМеста КАК СИЗРабочегоМеста
		|		ПО (ВыдачиСИЗПоНоменклатуре.РабочееМесто = СИЗРабочегоМеста.РабочееМесто)
		|			И (ВыдачиСИЗПоНоменклатуре.СИЗ = СИЗРабочегоМеста.СИЗ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СредстваИндивидуальнойЗащиты КАК СправочникСИЗ
		|		ПО (ВыдачиСИЗПоНоменклатуре.СИЗ = СправочникСИЗ.Ссылка)
		|ГДЕ
		|	ЕСТЬNULL(ВыдачиСИЗПоНоменклатуре.Количество, 0) > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо,
		|	РабочееМесто";
	
	Запрос.УстановитьПараметр("ОтмеченныеСИЗ", ОтмеченныеСИЗ);
	
	Если Не ЗначениеЗаполнено(ОтмеченныеСИЗ) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВыдачиСИЗПоНоменклатуре.СИЗ В (&ОтмеченныеСИЗ)", "ИСТИНА");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.ДатаВыдачи) Тогда
			// Выдачи не было.
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаСИЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ТаблицаСИЗ;
	
КонецФункции

Процедура ЗаполнитьДокументПоВыдачеСИЗ(ДокументОбъект, ВыдачаСсылка, ДействиеСРанееВыданнымСИЗ, ТолькоИстекающие) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ВыдачаСсылка);
	Запрос.УстановитьПараметр("ДействиеСРанееВыданнымСИЗ", ДействиеСРанееВыданнымСИЗ);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВыдачаСИЗРабочиеМеста.РабочееМесто,
		|	ВыдачаСИЗРабочиеМеста.ФизическоеЛицо,
		|	ВыдачаСИЗНоменклатураСИЗ.СИЗ
		|ИЗ
		|	Документ.ВыдачаСИЗ КАК ВыдачаСИЗ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыдачаСИЗ.РабочиеМеста КАК ВыдачаСИЗРабочиеМеста
		|		ПО ВыдачаСИЗ.Ссылка = &Ссылка
		|		И ВыдачаСИЗ.Ссылка = ВыдачаСИЗРабочиеМеста.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыдачаСИЗ.НоменклатураСИЗ КАК ВыдачаСИЗНоменклатураСИЗ
		|		ПО ВыдачаСИЗРабочиеМеста.Ссылка = ВыдачаСИЗНоменклатураСИЗ.Ссылка
		|		И ВыдачаСИЗНоменклатураСИЗ.ДействиеСРанееВыданнымСИЗ = &ДействиеСРанееВыданнымСИЗ
		|		И ВыдачаСИЗРабочиеМеста.ИдентификаторСтрокиРабочегоМеста = ВыдачаСИЗНоменклатураСИЗ.ИдентификаторСтрокиРабочегоМеста
		|СГРУППИРОВАТЬ ПО
		|	ВыдачаСИЗРабочиеМеста.РабочееМесто,
		|	ВыдачаСИЗРабочиеМеста.ФизическоеЛицо,
		|	ВыдачаСИЗНоменклатураСИЗ.СИЗ";
	
	ВыданныеСИЗ = СИЗКПродлениюСписанию(Запрос.Выполнить().Выгрузить(), ВыдачаСсылка, ТолькоИстекающие);
	
	ИдентификаторСтроки = 1;
	Обход = Обработки.ОбходКоллекции.НовыйОбход(ВыданныеСИЗ);
	Пока Обход.СледующийПоЗначениюПоля("ФизическоеЛицо") Цикл
		НоваяСтрока = ДокументОбъект.РабочиеМеста.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Обход.ТекущиеДанные());
		НоваяСтрока.ИдентификаторСтрокиРабочегоМеста = ИдентификаторСтроки;
		ИдентификаторСтроки = ИдентификаторСтроки + 1;
		Пока Обход.Следующий() Цикл
			НоваяСтрокаСИЗ = ДокументОбъект.НоменклатураСИЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСИЗ, Обход.ТекущиеДанные());
			НоваяСтрокаСИЗ.ИдентификаторСтрокиРабочегоМеста = НоваяСтрока.ИдентификаторСтрокиРабочегоМеста;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция РазмерСотрудника(ТипНоменклатуры, Антропометрия) Экспорт
	
	Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ОдеждаСпециальнаяЗащитная Тогда
		Возврат Антропометрия.РазмерОдежды;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.КостюмыИзолирующие Тогда
		Возврат Антропометрия.РазмерОдежды;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.СредстваЗащитыНог Тогда
		Возврат Антропометрия.РазмерОбуви;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.СредстваЗащитыГоловы Тогда
		Возврат Антропометрия.РазмерГоловногоУбора;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.СредстваЗащитыОргановДыхания Тогда
		Возврат Антропометрия.РазмерПротивогаза;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.СредстваЗащитыРук Тогда
		Возврат Антропометрия.РазмерПерчаток;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ОбновлениеВыдачиСИЗ() Экспорт
	
	// Регламентные задания блокируются на время служебных операций с информационной базой.
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ОбновлениеВыдачиСИЗ);
	
	ОбновитьВыдачиСИЗ();
	
КонецПроцедуры

Процедура ОбновитьВыдачиСИЗ(Организация = Неопределено, ФизическиеЛица = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	ДанныеНабора.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеНабора.ГоловнаяОрганизация КАК ГоловнаяОрганизация
		|ИЗ
		|	РегистрСведений.ОбновлениеВыдачСИЗ КАК ДанныеНабора
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизическоеЛицо";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	ОтборЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
	Если Организация <> Неопределено Тогда
		ОтборЗапроса.Добавить("ДанныеНабора.ГоловнаяОрганизация = &ГоловнаяОрганизация");
		Запрос.УстановитьПараметр("ГоловнаяОрганизация", ЗарплатаКадры.ГоловнаяОрганизация(Организация));
	КонецЕсли;
	Если ФизическиеЛица <> Неопределено Тогда
		ОтборЗапроса.Добавить("ДанныеНабора.ФизическоеЛицо В(&ФизическиеЛица)");
		Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛица);
	КонецЕсли;
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пока Истина Цикл
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОбновлениеВыдачСИЗ"); 
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ФизическоеЛицо", "ФизическоеЛицо");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ГоловнаяОрганизация", "ГоловнаяОрганизация");
		
		НачатьТранзакцию();
		Попытка
			Блокировка.Заблокировать();
			ТаблицаОбновления = РезультатЗапроса.Выгрузить();
			ОбновитьВыдачиФизическихЛиц(ТаблицаОбновления);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьВыдачиСИЗОрганизацииДлительнаяОперация(Параметры, АдресРезультата) Экспорт
	
	Попытка
		ОбновитьВыдачиСИЗ(Параметры.Организация);
	Исключение
		ПредставлениеОбработки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Обновление выдачи СИЗ по организации %1'"), 
			Параметры.Организация);
		ЗарегистрироватьОшибкуОбработкиВыдачиСИЗ(ИнформацияОбОшибке(), ПредставлениеОбработки);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ОбновитьНормыВыдачиСИЗФизическихЛицДлительнаяОперация(Параметры, АдресРезультата) Экспорт
	
	Попытка
		ОбновитьВыдачиСИЗ(, Параметры.ФизическиеЛица);
	Исключение
		ПредставлениеОбработки = НСтр("ru = 'Обновление норм выдачи СИЗ по физическим лицам'"); 
		ЗарегистрироватьОшибкуОбработкиВыдачиСИЗ(ИнформацияОбОшибке(), ПредставлениеОбработки);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ОбновитьВыдачиСИЗРабочихМестПоНаборуСИЗ(НаборЗаписей, Замещение) Экспорт
	
	Если Не НаборЗаписей.ДополнительныеСвойства.Свойство("ПрежнийНабор") Тогда
		Возврат;
	КонецЕсли;
	
	ПрежнийНабор = НаборЗаписей.ДополнительныеСвойства["ПрежнийНабор"];
	
	Если РегистрыБЗК.ЭтоУдалениеНабораЗаписей(Замещение) Тогда
		
		РабочиеМеста = КоллекцииБЗК.УникальныеЗначенияКолонки(ПрежнийНабор, "РабочееМесто");
		
	Иначе
		
		Если ОбщегоНазначения.КоллекцииИдентичны(ПрежнийНабор, НаборЗаписей) Тогда
			Возврат;
		КонецЕсли;
		
		РабочиеМеста = НаборЗаписей.ВыгрузитьКолонку("РабочееМесто");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РабочиеМеста, ПрежнийНабор.ВыгрузитьКолонку("РабочееМесто"), Истина);
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ОбновитьПериодичностьВыдачиСИЗРабочихМест(РабочиеМеста);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗапуститьОбновлениеВыдачСИЗ(Организация = Неопределено, ФизическиеЛица = Неопределено) Экспорт
	
	Если Не СредстваИндивидуальнойЗащитыИспользуются(Организация) Тогда 
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Массив;
	Параметры.Добавить(Организация);
	Параметры.Добавить(ФизическиеЛица);
	
	ФоновыеЗадания.Выполнить("СредстваИндивидуальнойЗащиты.ОбновитьВыдачиСИЗ", Параметры);
	
КонецПроцедуры

Функция ИнтервалМесяцев(ЕдиницаПериодичности, Периодичность, Кратность) Экспорт
	
	МесяцевВЕдиницуИзмерения = МесяцевВЕдиницуИзмерения(ЕдиницаПериодичности);
	
	ИнтервалМесяцев = (Периодичность * МесяцевВЕдиницуИзмерения) / Кратность;
	
	Возврат ИнтервалМесяцев;
	
КонецФункции

Функция МинимальнаяПериодичность(ОписанияПериодичности, Постфикс = "") Экспорт
	
	ОписаниеПериодичности = ОписаниеПериодичностиВыдачи();
	
	МаксимальныйКоэффициент = 0;
	Для Каждого Описание Из ОписанияПериодичности Цикл
		Если Описание.СпособВыдачи = Перечисления.СпособыВыдачиСИЗ.ДоИзноса Тогда
			Описание["Кратность" + Постфикс] = 1;
			Описание["Периодичность" + Постфикс] = 3999;
			Описание["ЕдиницаПериодичности" + Постфикс] = Перечисления.Периодичность.Год;
		КонецЕсли;
		Коэффициент = Описание["Кратность" + Постфикс] * ЧастейВГоду(Описание["ЕдиницаПериодичности" + Постфикс]) / Описание["Периодичность" + Постфикс];
		Если Коэффициент > МаксимальныйКоэффициент Тогда
			Если ОписаниеПериодичности.СпособВыдачи = Перечисления.СпособыВыдачиСИЗ.СПериодичностью И Описание.СпособВыдачи = Перечисления.СпособыВыдачиСИЗ.ДоИзноса Тогда
				ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Описание, , "СпособВыдачи");
			Иначе
				ЗаполнитьЗначенияСвойств(ОписаниеПериодичности, Описание);
			КонецЕсли;
			ОписаниеПериодичности.Кратность = Описание["Кратность" + Постфикс];
			ОписаниеПериодичности.Периодичность = Описание["Периодичность" + Постфикс];
			ОписаниеПериодичности.ЕдиницаПериодичности = Описание["ЕдиницаПериодичности" + Постфикс];
			МаксимальныйКоэффициент = Коэффициент;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьПредставлениеПериодичности(ОписаниеПериодичности, Ложь);
	
	Возврат ОписаниеПериодичности;
	
КонецФункции

Функция НормыВыдачиСИЗРабочегоМестаСоответствуютДолжности(НормыВыдачиСИЗРабочегоМеста, Должность) Экспорт
	
	НаборЗаписей = РегистрыСведений.СИЗРабочегоМеста.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.РабочееМесто.Установить(Должность);
	НаборЗаписей.Прочитать();
	
	Возврат ОбщегоНазначения.КоллекцииИдентичны(
		НормыВыдачиСИЗРабочегоМеста, НаборЗаписей.Выгрузить(), , "ИсходныйНомерСтроки,РабочееМесто");
	
КонецФункции 

Функция ТаблицаФизическиеЛицаРабочиеМеста(ФизическиеЛицаРабочиеМеста, ИмяРабочегоМеста, ОтмеченныеСИЗ = Неопределено,
		ДобавитьКолонкуПериодРегистрации = Ложь) Экспорт
	
	ЭтоТаблица = ТипЗнч(ФизическиеЛицаРабочиеМеста) = Тип("ТаблицаЗначений");
	
	ТаблицаФизическиеЛицаРабочиеМеста = Новый ТаблицаЗначений;
	ТаблицаФизическиеЛицаРабочиеМеста.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТаблицаФизическиеЛицаРабочиеМеста.Колонки.Добавить("РабочееМесто", Новый ОписаниеТипов("СправочникСсылка.РабочиеМестаОхраныТруда"));
	Если ДобавитьКолонкуПериодРегистрации Тогда
		ТаблицаФизическиеЛицаРабочиеМеста.Колонки.Добавить("ДатаВыдачи", Новый ОписаниеТипов("Дата"));
	КонецЕсли;
	ДобавитьКолонкуОтмеченныеСИЗ = ЭтоТаблица И ФизическиеЛицаРабочиеМеста.Колонки.Найти("ОтмеченныеСИЗ") <> Неопределено;
	Если ДобавитьКолонкуОтмеченныеСИЗ Тогда
		ОтмеченныеСИЗ = Новый Массив;
		ТаблицаФизическиеЛицаРабочиеМеста.Колонки.Добавить("ОтмеченныеСИЗ", Новый ОписаниеТипов("Массив"));
	КонецЕсли;
	
	Для Каждого ДанныеСИЗ Из ФизическиеЛицаРабочиеМеста Цикл
		НоваяСтрока = ТаблицаФизическиеЛицаРабочиеМеста.Добавить();
		НоваяСтрока.ФизическоеЛицо = ДанныеСИЗ.ФизическоеЛицо;
		НоваяСтрока.РабочееМесто = ДанныеСИЗ[ИмяРабочегоМеста];
		Если ДобавитьКолонкуПериодРегистрации Тогда
			НоваяСтрока.ДатаВыдачи = ДанныеСИЗ.РабочееМестоОхраныТрудаПериодРегистрации;
		КонецЕсли;
		Если ЭтоТаблица Тогда
			Если ДобавитьКолонкуОтмеченныеСИЗ Тогда
				НоваяСтрока.ОтмеченныеСИЗ = ДанныеСИЗ.ОтмеченныеСИЗ;
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОтмеченныеСИЗ, НоваяСтрока.ОтмеченныеСИЗ, Истина);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ДанныеСИЗ.Свойство("ОтмеченныеСИЗ", ОтмеченныеСИЗ);
	КонецЦикла;
	
	Возврат ТаблицаФизическиеЛицаРабочиеМеста;
	
КонецФункции

#Область ОснованияДляОбновленияВыдачиСИЗ

Функция НоваяТаблицаОбновлениеВыдачиСИЗ() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	Таблица.Колонки.Добавить("ГоловнаяОрганизация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	Возврат Таблица;
	
КонецФункции

Процедура ЗарегистрироватьОбновлениеВыдачиСИЗ(ТаблицаОбновления, ОбновлятьАктуальныеЗаказыНаВыдачуСИЗ = Ложь) Экспорт
	
	Если ТаблицаОбновления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбновлятьАктуальныеЗаказыНаВыдачуСИЗ Тогда
		ОбновитьАктуальныеЗаказыНаВыдачуСИЗ(ТаблицаОбновления);
	КонецЕсли;
	
	ТаблицаОбновления.Свернуть("ФизическоеЛицо, ГоловнаяОрганизация");
	
	НаборЗаписей = РегистрыСведений.ОбновлениеВыдачСИЗ.СоздатьНаборЗаписей();
	Для Каждого СтрокаТаблицы Из ТаблицаОбновления Цикл
		НаборЗаписей.Очистить();
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаТаблицы);
		НаборЗаписей.Отбор["ФизическоеЛицо"].Установить(СтрокаТаблицы["ФизическоеЛицо"]);
		НаборЗаписей.Отбор["ГоловнаяОрганизация"].Установить(СтрокаТаблицы["ГоловнаяОрганизация"]);
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуОбновленияРабочихМестДляСИЗ(Источник) Экспорт
	
	ТаблицаОбновления = НоваяТаблицаОбновлениеВыдачиСИЗ();
	
	ИзменившиесяДанные = Источник.ТаблицаИзменившихсяДанныхНабора();
	
	Если ИзменившиесяДанные <> Неопределено Тогда
		// Анализируем изменения того, что влияет на выдачу: рабочие места, даты.
		Для Каждого СтрокаТаблицы Из ИзменившиесяДанные Цикл
			Если СтрокаТаблицы["Добавление"] = Истина Или СтрокаТаблицы["Удаление"] = Истина Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), СтрокаТаблицы);
			Иначе
				Если СтрокаТаблицы["ИзменилсяРесурсРабочееМесто"] = Истина Тогда
					ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), СтрокаТаблицы);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Источник.ДополнительныеСвойства.Вставить("ТаблицаОбновлениеВыдачиСИЗ", ТаблицаОбновления);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуОбновленияКадровойИсторииДляСИЗ(Источник) Экспорт
	
	ТаблицаОбновления = НоваяТаблицаОбновлениеВыдачиСИЗ();
	
	ИзменившиесяДанные = Источник.ТаблицаИзменившихсяДанныхНабора();
	
	Если ИзменившиесяДанные <> Неопределено Тогда
		// Анализируем изменения того, что влияет на выдачу: позиции, даты.
		Для Каждого СтрокаТаблицы Из ИзменившиесяДанные Цикл
			Если СтрокаТаблицы["Добавление"] = Истина Или СтрокаТаблицы["Удаление"] = Истина Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), СтрокаТаблицы);
			Иначе
				Если СтрокаТаблицы["ИзменилсяРесурсДолжностьПоШтатномуРасписанию"] = Истина Тогда
					ЗаполнитьЗначенияСвойств(ТаблицаОбновления.Добавить(), СтрокаТаблицы);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Источник.ДополнительныеСвойства.Вставить("ТаблицаОбновлениеВыдачиСИЗ", ТаблицаОбновления);
	
КонецПроцедуры

#КонецОбласти

#Область СправочникСотрудники

Процедура ДобавитьКомандыПечатиСправочникуСотрудники(КомандыПечати) Экспорт
	
	Если Не СредстваИндивидуальнойЗащитыИспользуются() Тогда
		Возврат;
	КонецЕсли;
	
	Если ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.ВыдачиСИЗПоНоменклатуре) Тогда
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
		КомандаПечати.МенеджерПечати = "Справочник.Сотрудники";
		КомандаПечати.Идентификатор = "ПФ_MXL_КарточкаУчетаВыдачиДежурныхСИЗ";
		КомандаПечати.Представление = НСтр("ru = 'Карточка учета выдачи дежурных СИЗ'");
		КомандаПечати.Порядок = 43;
		КомандаПечати.ФункциональныеОпции = "ИспользоватьСредстваИндивидуальнойЗащиты";
		
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
		КомандаПечати.МенеджерПечати = "Справочник.Сотрудники";
		КомандаПечати.Идентификатор = "ПФ_MXL_ЛичнаяКарточкаУчетаВыдачиСИЗ";
		КомандаПечати.Представление = НСтр("ru = 'Личная карточка учета выдачи СИЗ'");
		КомандаПечати.Порядок = 47;
		КомандаПечати.ФункциональныеОпции = "ИспользоватьСредстваИндивидуальнойЗащиты";
	КонецЕсли;
	
КонецПроцедуры

Функция НужноПечататьМакетСотрудника(КоллекцияПечатныхФорм) Экспорт
	
	НужноПечататьМакет = Ложь;
	
	Если СредстваИндивидуальнойЗащитыИспользуются() Тогда
