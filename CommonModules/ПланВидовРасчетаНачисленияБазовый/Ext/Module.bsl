Процедура УточнитьКодДоходаНДФЛОтпускаАУСН() Экспорт
	
	КодДохода2000 = Справочники.ВидыДоходовНДФЛ.КодДоходаПоУмолчанию;
	
	КодыНачислений = Новый Массив;
	КодыНачислений.Добавить("ОТ");
	КодыНачислений.Добавить("КОТ");
	
	КодыДоходовНДФЛ = Новый Массив;
	КодыДоходовНДФЛ.Добавить(ВидыДоходовНДФЛПоКоду("2012"));
	КодыДоходовНДФЛ.Добавить(ВидыДоходовНДФЛПоКоду("2013"));
	
	КатегорииНачислений = Новый Массив;
	КатегорииНачислений.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаОтпуска);
	КатегорииНачислений.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.Прочее);
	
	ВидыОперацийПоЗарплате = Новый Массив;
	ВидыОперацийПоЗарплате.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпуск);
	ВидыОперацийПоЗарплате.Добавить(Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпуска);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодыНачислений",         КодыНачислений);
	Запрос.УстановитьПараметр("КодыДоходовНДФЛ",        КодыДоходовНДФЛ);
	Запрос.УстановитьПараметр("КатегорииНачислений",    КатегорииНачислений);
	Запрос.УстановитьПараметр("ВидыОперацийПоЗарплате", ВидыОперацийПоЗарплате);
	Запрос.УстановитьПараметр("КодДоходаНДФЛАУСН",      КодДохода2000);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НачисленияАУСН.НачислениеАУСН КАК Ссылка
	|ИЗ
	|	РегистрСведений.НачисленияАУСН КАК НачисленияАУСН
	|ГДЕ
	|	НачисленияАУСН.НачислениеАУСН.Код В(&КодыНачислений)
	|	И НачисленияАУСН.НачислениеАУСН.КодДоходаНДФЛ В(&КодыДоходовНДФЛ)
	|	И НачисленияАУСН.НачислениеАУСН.КатегорияНачисленияИлиНеоплаченногоВремени В(&КатегорииНачислений)
	|	И НачисленияАУСН.НачислениеАУСН.ВидОперацииПоЗарплате В(&ВидыОперацийПоЗарплате)
	|	И НачисленияАУСН.НачислениеАУСН.КодДоходаНДФЛ <> &КодДоходаНДФЛАУСН";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачислениеОбъект = Выборка.Ссылка.ПолучитьОбъект();
		НачислениеОбъект.КодДоходаНДФЛ   = КодДохода2000;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НачислениеОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УточнитьКодДоходаНДФЛКатегориюОписаниеРКиСН() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РайонныйКоэффициент",	Перечисления.ВидыНачисленийОплатыТрудаДляНУ.пп11ст255);
	Запрос.УстановитьПараметр("СевернаяНадбавка",		Перечисления.ВидыНачисленийОплатыТрудаДляНУ.пп12ст255);
	МассивОбработанныхКатегорий = Новый Массив;
	МассивОбработанныхКатегорий.Добавить(Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавкиАУСН);
	МассивОбработанныхКатегорий.Добавить(Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавки);
	Запрос.УстановитьПараметр("ОбработанныеКатегории",	МассивОбработанныхКатегорий);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Начисления.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Начисления.КатегорияДохода = ЗНАЧЕНИЕ(Перечисление.КатегорииДоходовНДФЛ.ОплатаТрудаАУСН)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КатегорияДоходаАУСН
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.ВидНачисленияДляНУ = &РайонныйКоэффициент
	|	И НЕ Начисления.КатегорияДохода В (&ОбработанныеКатегории)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Начисления.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Начисления.КатегорияДохода = ЗНАЧЕНИЕ(Перечисление.КатегорииДоходовНДФЛ.ОплатаТрудаАУСН)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КатегорияДоходаАУСН
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.ВидНачисленияДляНУ = &СевернаяНадбавка
	|	И НЕ Начисления.КатегорияДохода В (&ОбработанныеКатегории)";
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаРайонныйКоэфициент	= РезультатыЗапроса[0].Выбрать();
	ВыборкаСевернаяНадбавка		= РезультатыЗапроса[1].Выбрать();
	
	Пока ВыборкаРайонныйКоэфициент.Следующий() Цикл
		Начисление = ВыборкаРайонныйКоэфициент.Ссылка.ПолучитьОбъект();
		Если ВыборкаРайонныйКоэфициент.КатегорияДоходаАУСН Тогда
			Начисление.КатегорияДохода	= Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавкиАУСН;
		Иначе
			Начисление.КатегорияДохода	= Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавки;
		КонецЕсли;
		Начисление.КодДоходаНДФЛ	= Справочники.ВидыДоходовНДФЛ.РайонныеСеверныеНадбавки;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Начисление);
	КонецЦикла;
	Пока ВыборкаСевернаяНадбавка.Следующий() Цикл
		Начисление = ВыборкаСевернаяНадбавка.Ссылка.ПолучитьОбъект();
		Если ВыборкаСевернаяНадбавка.КатегорияДоходаАУСН Тогда
			Начисление.КатегорияДохода	= Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавкиАУСН;
		Иначе
			Начисление.КатегорияДохода	= Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавки;
		КонецЕсли;
		Начисление.КодДоходаНДФЛ	= Справочники.ВидыДоходовНДФЛ.РайонныеСеверныеНадбавки;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Начисление);
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьНачисленияОплатыДолейРКиСН(Категории = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если Категории = Неопределено Тогда
		Категории = КатегорииНачисленийОплатПоСреднему();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	НачисленияУдержанияПоСотрудникам.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	РегистрНакопления.НачисленияУдержанияПоСотрудникам КАК НачисленияУдержанияПоСотрудникам
		|ГДЕ
		|	ВЫРАЗИТЬ(НачисленияУдержанияПоСотрудникам.НачислениеУдержание КАК ПланВидовРасчета.Начисления).КатегорияНачисленияИлиНеоплаченногоВремени = ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.СевернаяНадбавка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	НачисленияУдержанияПоСотрудникам.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	РегистрНакопления.НачисленияУдержанияПоСотрудникам КАК НачисленияУдержанияПоСотрудникам
		|ГДЕ
		|	ВЫРАЗИТЬ(НачисленияУдержанияПоСотрудникам.НачислениеУдержание КАК ПланВидовРасчета.Начисления).КатегорияНачисленияИлиНеоплаченногоВремени = ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.РайонныйКоэффициент)";
	
	РезультатПакет = Запрос.ВыполнитьПакет();
	
	ТребуетсяДоляСН = Не РезультатПакет[0].Пустой();
	ТребуетсяДоляРК = Не РезультатПакет[1].Пустой();
	
	ВостребованностьРКиСН = РасчетЗарплаты.ВостребованностьРКиСН();
	
	КатегорииАУСН = Перечисления.КатегорииДоходовНДФЛ.ДоходыАУСН();
	
	КодыКатегорийНачислений = Новый Соответствие;
	КодыКатегорийНачислений.Вставить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоЛиста, "БЛ");
	КодыКатегорийНачислений.Вставить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоЛистаЗаСчетРаботодателя, "БЛР");
	КодыКатегорийНачислений.Вставить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоНесчастныйСлучайНаПроизводстве, "БЛН");
	КодыКатегорийНачислений.Вставить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоПрофзаболевание, "БЛП");
	КодыКатегорийНачислений.Вставить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаКомандировки, "КОМ");
	КодыКатегорийНачислений.Вставить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаОтпуска, "ОТП");
	КодыКатегорийНачислений.Вставить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.КомпенсацияОтпуска, "КОТ");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Начисления.Ссылка КАК ОсновнойВидРасчета,
		|	Начисления.Наименование КАК Наименование,
		|	Начисления.КатегорияНачисленияИлиНеоплаченногоВремени КАК КатегорияНачисленияИлиНеоплаченногоВремени,
		|	Начисления.ВидНачисленияДляНУ КАК ВидНачисленияДляНУ,
		|	Начисления.КодДоходаСтраховыеВзносы КАК КодДоходаСтраховыеВзносы,
		|	Начисления.КатегорияДохода КАК КатегорияДохода,
		|	Начисления.ЯвляетсяДоходомВНатуральнойФорме КАК ЯвляетсяДоходомВНатуральнойФорме,
		|	Начисления.СпособОтраженияЗарплатыВБухучете КАК СпособОтраженияЗарплатыВБухучете,
		|	Начисления.ОтношениеКЕНВД КАК ОтношениеКЕНВД,
		|	Начисления.КодДоходаСтраховыеВзносы2017 КАК КодДоходаСтраховыеВзносы2017,
		|	Начисления.ПорядокОпределенияМесяцаДоходаВВидеОплатыТруда КАК ПорядокОпределенияМесяцаДоходаВВидеОплатыТруда,
		|	Начисления.ВидДоходаИсполнительногоПроизводства КАК ВидДоходаИсполнительногоПроизводства,
		|	Начисления.ВидДоходаИсполнительногоПроизводства2022 КАК ВидДоходаИсполнительногоПроизводства2022,
		|	Начисления.СтрокаРаздела2Расчета6НДФЛ КАК СтрокаРаздела2Расчета6НДФЛ
		|ИЗ
		|	ПланВидовРасчета.Начисления КАК Начисления
		|ГДЕ
		|	Начисления.КатегорияНачисленияИлиНеоплаченногоВремени В(&КатегорииНачисленийИлиНеоплаченногоВремени)
		|	И НЕ Начисления.ПометкаУдаления
		|	И НЕ Начисления.ВАрхиве";
	
	Запрос.УстановитьПараметр("КатегорииНачисленийИлиНеоплаченногоВремени", Категории);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЭтоАУСН = КатегорииАУСН.Найти(Выборка.КатегорияДохода) <> Неопределено;
		// Доля районного коэффициента
		Описание = ОписаниеНачисления();
		ЗаполнитьЗначенияСвойств(Описание, Выборка);
		Описание.Код = СтрШаблон(НСтр("ru = '%1РК'"), КодыКатегорийНачислений.Получить(Выборка.КатегорияНачисленияИлиНеоплаченногоВремени));        
		Описание.Наименование = СтрШаблон(НСтр("ru = '%1 (доля РК)'"), СокрЛП(Выборка.Наименование));
		Описание.КатегорияНачисленияИлиНеоплаченногоВремени = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаДолиРайонногоКоэффициентаВСреднемЗаработке;
		Описание.КодДоходаНДФЛ = Справочники.ВидыДоходовНДФЛ.РайонныеСеверныеНадбавки;

		Если ЭтоАУСН Тогда
			Описание.КатегорияДохода = Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавкиАУСН;
		Иначе
			Описание.КатегорияДохода = Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавки;
		КонецЕсли;
		Описание.КлючевыеСвойства = "ОсновнойВидРасчета";
		
		Если ВостребованностьРКиСН.РайонныйКоэффициент Или ТребуетсяДоляРК Тогда
			ЗаписатьНачисление(Описание);
		КонецЕсли;
		
		// Доля северной надбавки
		Описание = ОписаниеНачисления();
		ЗаполнитьЗначенияСвойств(Описание, Выборка);
		Описание.Код = СтрШаблон(НСтр("ru = '%1СН'"), КодыКатегорийНачислений.Получить(Выборка.КатегорияНачисленияИлиНеоплаченногоВремени));
		Описание.Наименование = СтрШаблон(НСтр("ru = '%1 (доля СН)'"), СокрЛП(Выборка.Наименование));
		Описание.КатегорияНачисленияИлиНеоплаченногоВремени = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаДолиСевернойНадбавкиВСреднемЗаработке;
		Описание.КодДоходаНДФЛ = Справочники.ВидыДоходовНДФЛ.РайонныеСеверныеНадбавки;
		Если ЭтоАУСН Тогда
			Описание.КатегорияДохода = Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавкиАУСН;
		Иначе
			Описание.КатегорияДохода = Перечисления.КатегорииДоходовНДФЛ.РайонныеСеверныеНадбавки;
		КонецЕсли;
		Описание.КлючевыеСвойства = "ОсновнойВидРасчета";
		
		Если ВостребованностьРКиСН.СевернаяНадбавка Или ТребуетсяДоляСН Тогда
			ЗаписатьНачисление(Описание);
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура СоздатьПрочиеПремии() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	КодДоходаНДФЛ_2002 = ВидыДоходовНДФЛПоКоду("2002");
	КодДоходаНДФЛ_2003 = ВидыДоходовНДФЛПоКоду("2003");
	
	// Премии по результатам работа
	Описание = ОписаниеНачисления();
	Описание.Код							= НСтр("ru = 'ПРГС'");
	Описание.Наименование					= НСтр("ru = 'Премия за год (суммой)'");
	Описание.КатегорияНачисленияИлиНеоплаченногоВремени = Перечисления.КатегорииНачисленийИНеоплаченногоВремени.Премия;
	Описание.ВидНачисленияДляНУ 			= Перечисления.ВидыНачисленийОплатыТрудаДляНУ.пп2ст255;
	Описание.КодДоходаНДФЛ 					= КодДоходаНДФЛ_2002;
	Описание.КатегорияДохода				= УчетНДФЛПовтИсп.КатегорияДоходаПоЕгоКоду(Описание.КодДоходаНДФЛ);
	Описание.КодДоходаСтраховыеВзносы	 	= Справочники.ВидыДоходовПоСтраховымВзносам.ОблагаетсяЦеликом;
	Описание.КодДоходаСтраховыеВзносы2017 	= Справочники.ВидыДоходовПоСтраховымВзносам.ОблагаетсяЦеликом;
	Описание.ВходитВБазуРКИСН 				= Истина;
	Описание.ВидОперацииПоЗарплате 			= Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход;
	Описание.КоличествоМесяцевБазовогоПериода = 12;
	Описание.СреднийЗаработокОбщий 			= Перечисления.УчетНачисленийВСреднемЗаработкеОбщий.ПремияГодоваяФиксированнойСуммой;
	Описание.КлючевыеСвойства				= "Код, Наименование, КодДоходаНДФЛ";
	ЗаписатьНачисление(Описание);
	
	Описание = ОписаниеНачисления();
	Описание.Код							= НСтр("ru = 'ПРКП'");
