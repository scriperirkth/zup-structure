Функция НачисленияВключаемыеВБазуРасчетаРКиСН(УчитыватьКатегориюПрочее = Ложь) Экспорт
	
	// Автоматически в базу расчета РК и СН включаются начисления, соответствующие условиям:
	//   - категория начисления и неоплаченного времени не попадает в список оплат по среднему
	//   - в случае, если это Премия или КвартальнаяПремия, тогда СреднийЗаработокОбщий <> НеВключать
	
	КатегорииПремий = Новый Массив;
	КатегорииПремий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.Премия);
	КатегорииПремий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.КвартальнаяПремия);
	
	ОбслуживаемыеКатегории = Новый Массив;
	ОбслуживаемыеКатегории.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ПовременнаяОплатаТруда);
	Если УчитыватьКатегориюПрочее Тогда
		ОбслуживаемыеКатегории.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.Прочее);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОбслуживаемыеКатегории, КатегорииПремий);
	
	СреднийЗаработокОбщий = Новый Массив;
	СреднийЗаработокОбщий.Добавить(Перечисления.УчетНачисленийВСреднемЗаработкеОбщий.ПустаяСсылка());
	СреднийЗаработокОбщий.Добавить(Перечисления.УчетНачисленийВСреднемЗаработкеОбщий.НеВключать);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбслуживаемыеКатегории", ОбслуживаемыеКатегории);
	Запрос.УстановитьПараметр("КатегорииПремий", КатегорииПремий);
	Запрос.УстановитьПараметр("СреднийЗаработокОбщий", СреднийЗаработокОбщий);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачисленияСреднийЗаработокОбщий.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Исключения
	|ИЗ
	|	ПланВидовРасчета.Начисления.СреднийЗаработокОбщий КАК НачисленияСреднийЗаработокОбщий
	|ГДЕ
	|	НачисленияСреднийЗаработокОбщий.Значение В(&СреднийЗаработокОбщий)
	|	И НачисленияСреднийЗаработокОбщий.Ссылка.КатегорияНачисленияИлиНеоплаченногоВремени В(&КатегорииПремий)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Начисления.Ссылка КАК ВидРасчета
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.КатегорияНачисленияИлиНеоплаченногоВремени В (&ОбслуживаемыеКатегории)
	|	И НЕ Начисления.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТ_Исключения.Ссылка
	|				ИЗ
	|					ВТ_Исключения)";
	
	МассивНачислений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидРасчета");
	
	Возврат МассивНачислений;
	
КонецФункции

Функция НачисленияРКиСН() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.КатегорияНачисленияИлиНеоплаченногоВремени В (ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.РайонныйКоэффициент), ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.СевернаяНадбавка))";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ВходитВБазуРКИСН(ВидРасчета) Экспорт
	
	Начисления = НачисленияРКиСН();
	Если Не ЗначениеЗаполнено(Начисления) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачисленияРКиСН", Начисления);
	Запрос.УстановитьПараметр("ВидРасчета", ВидРасчета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачисленияБазовыеВидыРасчета.ВидРасчета КАК ВидРасчета
	|ИЗ
	|	ПланВидовРасчета.Начисления.БазовыеВидыРасчета КАК НачисленияБазовыеВидыРасчета
	|ГДЕ
	|	НачисленияБазовыеВидыРасчета.Ссылка В(&НачисленияРКиСН)
	|	И НачисленияБазовыеВидыРасчета.ВидРасчета = &ВидРасчета";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ОбновитьБазуРасчетаРКиСН(ВидРасчета, Дополнять) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидРасчета) Тогда
		Возврат;
	КонецЕсли;
	
	Начисления = НачисленияРКиСН();
	Если Не ЗначениеЗаполнено(Начисления) Тогда
		Возврат;
	КонецЕсли;
	
	Если Начисления.Найти(ВидРасчета) <> Неопределено Тогда
		Дополнять = Ложь; // РК и СН не может входить в базу РК и СН
	КонецЕсли;
	
	Для Каждого Начисление Из Начисления Цикл
		НачислениеОбъект = Начисление.ПолучитьОбъект();
		СтрокаВидаРасчета = НачислениеОбъект.БазовыеВидыРасчета.Найти(ВидРасчета, "ВидРасчета");
		Если Дополнять И СтрокаВидаРасчета = Неопределено Тогда
			НоваяСтрока = НачислениеОбъект.БазовыеВидыРасчета.Добавить();
			НоваяСтрока.ВидРасчета = ВидРасчета;
			НачислениеОбъект.Записать();
		КонецЕсли;
		Если Не Дополнять И СтрокаВидаРасчета <> Неопределено Тогда
			НачислениеОбъект.БазовыеВидыРасчета.Удалить(НачислениеОбъект.БазовыеВидыРасчета.Индекс(СтрокаВидаРасчета));
			НачислениеОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ДанныеНачислений(ВидыРасчета, СписокРеквизитов) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидыРасчета)
		Или Не ЗначениеЗаполнено(СписокРеквизитов) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеНачислений = Новый Соответствие;
	Для Каждого ВидРасчета Из ВидыРасчета Цикл
		ДанныеНачислений.Вставить(ВидРасчета, ДанныеНачисления(ВидРасчета, СписокРеквизитов));
	КонецЦикла;
	
	Возврат ДанныеНачислений;
	
КонецФункции

Функция ДанныеНачисления(ВидРасчета, СписокРеквизитов) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидРасчета)
		Или Не ЗначениеЗаполнено(СписокРеквизитов) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИменаРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СписокРеквизитов,,Истина, Истина);
	
	ПризнакПолучатьПризнакРКиСН = Ложь;
	ПризнакПолучатьПризнакРасчетаСреднего = Ложь;
	Реквизиты = "";
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если ВРЕГ(ИмяРеквизита) = ВРЕГ("ВходитВБазуРКИСН") Тогда
			ПризнакПолучатьПризнакРКиСН = Истина;
		ИначеЕсли ВРЕГ(ИмяРеквизита) = ВРЕГ("СреднийЗаработокОбщий") Тогда
			ПризнакПолучатьПризнакРасчетаСреднего = Истина;
		Иначе
			Реквизиты = Реквизиты + "," + ИмяРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеНачисления = Новый Структура;
	Если ЗначениеЗаполнено(Реквизиты) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеНачисления, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидРасчета, Реквизиты));
	КонецЕсли;
	
	Если ПризнакПолучатьПризнакРКиСН Тогда
		ДанныеНачисления.Вставить("ВходитВБазуРКИСН", ВходитВБазуРКИСН(ВидРасчета));
	КонецЕсли;
	
	Если ПризнакПолучатьПризнакРасчетаСреднего Тогда
		СреднийЗаработокОбщий = Перечисления.УчетНачисленийВСреднемЗаработкеОбщий.ПустаяСсылка();
		ТаблицаСреднийЗаработокОбщий = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидРасчета, "СреднийЗаработокОбщий");
		Если ТаблицаСреднийЗаработокОбщий.Количество() > 0 Тогда
			СреднийЗаработокОбщий = ТаблицаСреднийЗаработокОбщий[0].Значение;
		КонецЕсли;
		ДанныеНачисления.Вставить("СреднийЗаработокОбщий", СреднийЗаработокОбщий);
	КонецЕсли;
	
	Возврат ДанныеНачисления;
	
КонецФункции

Функция ВидыДоходовНДФЛПоКоду(КодДохода) Экспорт
	
	КодДоходаНДФЛ = Справочники.ВидыДоходовНДФЛ.НайтиПоКоду(КодДохода);
	Если НЕ ЗначениеЗаполнено(КодДоходаНДФЛ) Тогда
		 
		Справочники.ВидыДоходовНДФЛ.СоздатьКодыДоходовНДФЛ();
		КодДоходаНДФЛ = Справочники.ВидыДоходовНДФЛ.НайтиПоКоду(КодДохода);
		
	КонецЕсли; 
	
	Возврат КодДоходаНДФЛ;
	
КонецФункции

