// Обновляет представление периода.
// 
// Параметры:
//  ДатаНачала           - Дата
//  ДатаОкончания        - Дата
//  ПредставлениеПериода - Строка
Процедура ОбновитьПредставлениеПериода(ДатаНачала, ДатаОкончания, ПредставлениеПериода) Экспорт
	
	Если ЗначениеЗаполнено(ДатаНачала) Или ЗначениеЗаполнено(ДатаОкончания) Тогда
		Если ДатаНачала = НачалоГода(ДатаНачала) И ДатаОкончания = КонецГода(ДатаОкончания) 
			И НачалоГода(ДатаНачала) <> НачалоГода(ДатаОкончания) Тогда
				
			ПредставлениеПериода = ПредставлениеПериода(ДатаНачала, КонецГода(ДатаНачала), "Л=ru_RU; ФП=Истина") 
				+ " - " + ПредставлениеПериода(НачалоГода(ДатаОкончания), ДатаОкончания, "Л=ru_RU; ФП=Истина");
		Иначе
			ПредставлениеПериода = ПредставлениеПериода(ДатаНачала, ДатаОкончания, "Л=ru_RU; ФП=Истина");
		КонецЕсли;
	Иначе
		ПредставлениеПериода = ПредставлениеПустогоПериоды();
	КонецЕсли;
	
КонецПроцедуры

