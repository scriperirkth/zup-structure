#Область СлужебныеПроцедурыИФункции

// Выполняет кодировку строки в URL-кодировку
// 
// Параметры:
//  Значение - Строка - строка, которую необходимо закодировать.
// 
// Возвращаемое значение:
//  Строка - результат преобразования.
// 
Функция КодироватьURL(Знач Значение) Экспорт
	
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
	
КонецФункции

// Запускает длительную операцию поиска информации в сервисе.
// 
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - уникальный идентификатор задания.
//  КлючАПИ - Строка - идентификатор конфигурации в сервисе.
//  СтрокаПоиска - Строка - строка, которую необходимо найти.
//  НомерСтраницы - Число - номер страницы из результата поиска, которую необходимо вернуть.
//  
// Возвращаемое значение:
//  см. ДлительныеОперации.ВыполнитьФункцию.
// 
Функция ОперацияВыполнитьПоискВСервисе(
		Знач УникальныйИдентификатор,
		Знач КлючАПИ,
		Знач СтрокаПоиска,
		Знач НомерСтраницы) Экспорт
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"ПанельПомощьСлужебный.ПоискВСервисе",
		КлючАПИ,
		СтрокаПоиска,
		НомерСтраницы);
	
КонецФункции

// см. ПанельПомощьСлужебный.СохранитьНастройкиПользователяПанели
//
Процедура СохранитьНастройкиПользователяПанели(Знач КлючНастроек, Знач Настройки) Экспорт
	
	ПанельПомощьСлужебный.СохранитьНастройкиПользователяПанели(КлючНастроек, Настройки);
	
КонецПроцедуры

// см. ПанельПомощьСлужебный.ОтправитьПожеланияВСервис
//
Функция ОтправитьПожеланияВСервис(Знач Получатель, Знач Тема, Знач Сообщение) Экспорт
	
	Возврат ПанельПомощьСлужебный.ОтправитьПожеланияВСервис(
		Получатель,
		Тема,
		Сообщение);
	
КонецФункции

#КонецОбласти