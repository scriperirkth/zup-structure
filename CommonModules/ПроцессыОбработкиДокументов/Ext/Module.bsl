#Область ОбработчикиПодписокНаСобытия

Процедура ПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка
		И НЕ Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовПереопределяемый.ПередЗаписьюДокумента(Источник, Отказ, 
		РежимЗаписи, РежимПроведения, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_НеЗаписыватьДокумент") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ЗаписатьБезПроверки") Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Источник.Ссылка;
	
	ШаблонИСтатус = ШаблонИСтатусДокумента(Источник);
	Шаблон = ШаблонИСтатус.Шаблон;
	Статус = ШаблонИСтатус.Статус;
	
	// Если есть несколько шаблонов с подходящим условием, то отказ от записи
	Если ШаблонИСтатус.Свойство("ШаблонНеОпределен") Тогда
		ТекстСообщения = НСтр("ru='Не удалось определить шаблон процесса. Запись документа запрещена.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	// Если документу не назначен шаблон бизнес-процесса - записать без проверки (кроме документа "Дополнительное задание")
	ИначеЕсли НЕ ЗначениеЗаполнено(Шаблон) Тогда
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ДополнительноеЗадание") Тогда
			ТекстСообщения = НСтр("ru='Не удалось определить шаблон процесса. Запись документа запрещена.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Если в форме был назначен другой шаблон процесса, то требуется замена текущего шаблона
	Если НЕ Ссылка.Пустая() И Источник.ДополнительныеСвойства.Свойство("ЗаписьВФорме") Тогда
		ШаблонИзФормы = Источник.ДополнительныеСвойства.ШаблонИзФормы;
		Если ШаблонИзФормы <> Шаблон Тогда
			ЗадачиДляПрерывания = Новый Массив;
			ПодходящийШаблон = ПодходящийШаблонДляИзменения(Источник, Шаблон, ЗадачиДляПрерывания);
			Если Не ЗначениеЗаполнено(ПодходящийШаблон) ИЛИ ШаблонИзФормы <> ПодходящийШаблон Тогда
				ТекстСообщения = НСтр("ru='Не удалось изменить шаблон процесса. Запись документа запрещена.'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				Возврат;
			КонецЕсли;
			ИзменитьШаблонПроцесса(Ссылка, ПодходящийШаблон, ЗадачиДляПрерывания);
			Шаблон = ПодходящийШаблон;
		КонецЕсли;
	КонецЕсли;
	
	Источник.ДополнительныеСвойства.Вставить("ЭтоНовый", Ссылка.Пустая());
	Источник.ДополнительныеСвойства.Вставить("Шаблон", Шаблон);
	Источник.ДополнительныеСвойства.Вставить("Статус", Статус);
	
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Шаблон, Ссылка.Пустая(), Истина);
	
	ТекстСообщения = "";
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		Если Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиИсполнителяЭтапа")
			И НЕ ЕстьВыполненныеИПринятыеКИсполнениюЗадачи(Ссылка, Новый Массив) Тогда
			// считывание свойств стартового этапа
			ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Шаблон, Истина);
		Иначе
			ТекстСообщения = НСтр("ru='Запись документа запрещена. '") + ПараметрыТекущегоЭтапа;
		КонецЕсли;
	ИначеЕсли НЕ Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиЗапущенногоПроцессаВыполнения")
		И ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		ТекстСообщения = НСтр("ru='Запись документа запрещена. В данный момент выполняется задача по обработке документа.'");
	ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая() Тогда
		// Если задача пустая, то документ новый
		Если НЕ Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиИсполнителяЭтапа")
			И НЕ ТекущийПользовательМожетБытьИсполнителем(Источник, ПараметрыТекущегоЭтапа, Шаблон) Тогда
			ТекстСообщения = НСтр("ru='Недостаточно прав для записи нового документа.'");
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Процессы обработки документов.Перед записью документа'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Источник.Метаданные(),,
			ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если НЕ Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиТребованийКПроведению") Тогда
		Если ПараметрыТекущегоЭтапа.ЗапретитьПроведениеОтменуПроведения Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не выполнена запись документа %1.
					|На этапе ""%2"" запрещена отмена проведения документа.'"),
					Ссылка,
					ПараметрыТекущегоЭтапа.Этап);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
				Возврат;
			КонецЕсли;
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение И НЕ Источник.Проведен Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не выполнена запись документа %1.
					|На этапе ""%2"" запрещено проведение документа.'"),
					Ссылка,
					ПараметрыТекущегоЭтапа.Этап);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
				Возврат;
			КонецЕсли;
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Источник.Проведен И ПараметрыТекущегоЭтапа.ЗапретитьПерепроведение Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не выполнена запись документа %1.
					|На этапе ""%2"" запрещено перепроведение документа.'"),
					Ссылка,
					ПараметрыТекущегоЭтапа.Этап);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПроцессыОбработкиДокументовПереопределяемый.ДополнительныеПроверкиПередЗаписьюДокумента(Источник, Ссылка,
		РежимЗаписи, Шаблон, ПараметрыТекущегоЭтапа, Отказ);
	
	КонтрольИзмененияРеквизитовПередЗаписьюДокумента(Источник, Ссылка, Шаблон, ПараметрыТекущегоЭтапа, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСнятьПометкуУдаленияЗадачПередЗаписьюДокумента(Источник, Ссылка, Отказ);
	
КонецПроцедуры

Процедура ПриЗаписиДокумента(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка
		И НЕ Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник.ДополнительныеСвойства, "Шаблон") Тогда
		Возврат;
	КонецЕсли;
	
	// необходимо записать комментарий исполнителя задачи
	Если Источник.ДополнительныеСвойства.Свойство("ЗадачаПоОбработкеДокументаДляЗаписи")
		И НЕ Источник.ДополнительныеСвойства.ЗадачаПоОбработкеДокументаДляЗаписи.Пустая() Тогда
		
		СохранитьКомментарийИсполнителяЗадачи(
			Источник.ДополнительныеСвойства.ЗадачаПоОбработкеДокументаДляЗаписи,
			Источник.ДополнительныеСвойства.КомментарийИсполнителя);
		
	КонецЕсли;
	
	ЗаполнитьЗначенияДополнительныхКолонокЗадач(Источник);
	
	// Для не новых документов запуск процесса не производится
	Если НЕ Источник.ДополнительныеСвойства.Свойство("ЭтоНовый")
		ИЛИ НЕ Источник.ДополнительныеСвойства.ЭтоНовый Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Источник.Ссылка;
	
	Шаблон = Источник.ДополнительныеСвойства.Шаблон;
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	ДатаИзмененияСтатуса = ТекущаяДатаСеанса();
	
	// Новому документу присвоим начальный статус и инициируем стартовый этап
	НачальныйСтатус = Источник.ДополнительныеСвойства.Статус;
	
	ИзменитьИсториюСтатусовДокумента(Ссылка, Шаблон, НачальныйСтатус, ТекущийПользователь, ДатаИзмененияСтатуса);
	УстановитьТекущийСтатусДокумента(Ссылка, Шаблон, НачальныйСтатус, ТекущийПользователь, ДатаИзмененияСтатуса);
	
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Шаблон, Истина);
	
	Если Источник.ДополнительныеСвойства.Свойство("КомментарийИсполнителя") Тогда
		КомментарийИсполнителя = Источник.ДополнительныеСвойства.КомментарийИсполнителя;
	Иначе
		КомментарийИсполнителя = "";
	КонецЕсли;
	
	ИсполнителиЭтапа = ИсполнителиЭтапаПроцесса(Ссылка, Шаблон, ПараметрыТекущегоЭтапа);
	
	// создание стартовых задач
	Для Каждого ИсполнительЭтапа Из ИсполнителиЭтапа Цикл
		
		Если ИсполнительЭтапа.НеСоздаватьЗадачу Тогда
			Продолжить;
		КонецЕсли;
		
		ПринятьЗадачуКИсполнению = Источник.ДополнительныеСвойства.Свойство("ЗаписьВФорме")
			И (НЕ ПараметрыТекущегоЭтапа.ЭтапВыполняетсяНесколькимиИсполнителями
				ИЛИ ТекущийПользовательМожетБытьИсполнителем(Ссылка, ПараметрыТекущегоЭтапа, Шаблон, ИсполнительЭтапа));
		
		ПараметрыЗадачи = ПараметрыСозданияЗадачи();
		ПараметрыЗадачи.Шаблон = Шаблон;
		ПараметрыЗадачи.Этап = ПараметрыТекущегоЭтапа.Этап;
		ПараметрыЗадачи.ИдентификаторЭтапа = ПараметрыТекущегоЭтапа.ИдентификаторЭтапа;
		ПараметрыЗадачи.НаименованиеЭтапа = ПараметрыТекущегоЭтапа.НаименованиеЭтапа;
		ПараметрыЗадачи.Статус = НачальныйСтатус;
		ПараметрыЗадачи.Документ = Ссылка;
		ПараметрыЗадачи.Описание = "";
		ПараметрыЗадачи.Автор = ТекущийПользователь;
		ПараметрыЗадачи.РезультатВыполнения = КомментарийИсполнителя;
		ПараметрыЗадачи.ПринятаКИсполнению = ПринятьЗадачуКИсполнению;
		ПараметрыЗадачи.Предшественники = Новый Массив;
		ПараметрыЗадачи.СрокВыполненияЧасы = ПараметрыТекущегоЭтапа.СрокВыполненияЧасы; 
		ПараметрыЗадачи.СрокиОбработкиПоРеквизитуДни = ПараметрыТекущегоЭтапа.СрокиОбработкиПоРеквизитуДни;
		ПараметрыЗадачи.СрокиОбработкиПоРеквизитуЧасы = ПараметрыТекущегоЭтапа.СрокиОбработкиПоРеквизитуЧасы;
		ПараметрыЗадачи.Порядок = ПараметрыТекущегоЭтапа.Порядок;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыЗадачи, ИсполнительЭтапа, Истина);
		
		УстановитьПривилегированныйРежим(Истина);
		СоздатьЗадачу(ПараметрыЗадачи);
		УстановитьПривилегированныйРежим(Ложь);
		
		Если ПараметрыЗадачи.ПринятаКИсполнению Тогда
			СохранитьСобытиеИсторииЗадач(ПараметрыЗадачи.Задача,
				ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.ПринятиеКИсполнению"), , ПараметрыЗадачи.Дата);
		КонецЕсли;
		
		ИсполнительЭтапа.Вставить("Задача", ПараметрыЗадачи.Задача);
		
	КонецЦикла;
	
	УправлениеИсполнителямиГрупповогоЭтапаПриЗапускеЭтапа(Ссылка, ИсполнителиЭтапа, ПараметрыТекущегоЭтапа);
	
КонецПроцедуры

Процедура ПриЗаписиКонстантыЭП(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Источник.Значение Тогда
		КонстантаМенеджер = Константы["ИспользоватьЭППриВыполненииЭтапов"];
		КонстантаЗначение = КонстантаМенеджер.Получить();
		Если КонстантаЗначение Тогда
			КонстантаМенеджер.Установить(Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииДополнительногоЗадания(Источник, ДанныеЗаполнения) Экспорт
	
	Если НЕ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ДополнительноеЗадание") Тогда
		Возврат;
	КонецЕсли;
	
	ПроцессыОбработкиДокументовПереопределяемый.ОбработкаЗаполненияНаОснованииДополнительногоЗадания(Источник, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПередЗаписьюПрисоединенногоФайла(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.ВерсииФайлов") Тогда
		Возврат;
	КонецЕсли;
	
	ВладелецФайла = Источник.ВладелецФайла;
	
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовПереопределяемый.ПередЗаписьюПрисоединенногоФайла(Источник, Отказ, 
		СтандартнаяОбработка, ВладелецФайла);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Метаданные.ОпределяемыеТипы.ПредметПроцессаОбработкиДокументов.Тип.СодержитТип(ТипЗнч(ВладелецФайла)) Тогда
		Возврат;
	КонецЕсли;
	
	Шаблон = ШаблонИСтатусДокумента(ВладелецФайла, Истина).Шаблон;
	
	// Если нет шаблона - нет ограничений на запись файлов
	Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
		Возврат;
	КонецЕсли;
	
	СправочникСТекущейВерсией = Источник.Метаданные().Реквизиты.Найти("ТекущаяВерсия") <> Неопределено;
	
	Если СправочникСТекущейВерсией Тогда
		ФайлНовый = Источник.ЭтоНовый();
		Если НЕ ФайлНовый И Источник.ХранитьВерсии Тогда
			// При записи нового файла БСП происходит несколько перезаписей объекта
			Если Не ЗначениеЗаполнено(Источник.ТекущаяВерсия) Тогда
				// Если в объекте не указана текущая версия, то это новый файл
				ФайлНовый = Истина;
			ИначеЕсли Не ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ТекущаяВерсия")) Тогда
				// Если в объекте указана текущая версия, а в БД - нет, то это новый файл
				ФайлНовый = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если НЕ Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ФайлНовый") Тогда
			Источник.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ФайлНовый", Источник.ЭтоНовый());
		КонецЕсли;
		ФайлНовый = Источник.ДополнительныеСвойства["ПроцессыОбработкиДокументов_ФайлНовый"];
	КонецЕсли;
	
	РазличияТекущейВерсии = Ложь;
	
	Если НЕ ФайлНовый Тогда
		ИсходныеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник.Ссылка,
			"ПометкаУдаления, Наименование, Описание, Редактирует");
		
		Если СправочникСТекущейВерсией Тогда
			РазличияТекущейВерсии = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ТекущаяВерсия") <> Источник.ТекущаяВерсия;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(ВладелецФайла, Шаблон, , Истина);
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		Если ФайлНовый Тогда
			ВызватьИсключение НСтр("ru='Добавление присоединенных файлов запрещено. '") + ПараметрыТекущегоЭтапа;
		ИначеЕсли ИсходныеРеквизиты.ПометкаУдаления <> Источник.ПометкаУдаления
			ИЛИ ИсходныеРеквизиты.Наименование <> Источник.Наименование
			ИЛИ ИсходныеРеквизиты.Описание <> Источник.Описание
			ИЛИ РазличияТекущейВерсии
			ИЛИ (НЕ ЗначениеЗаполнено(ИсходныеРеквизиты.Редактирует) И ЗначениеЗаполнено(Источник.Редактирует)) Тогда
			ВызватьИсключение НСтр("ru='Изменение присоединенных файлов запрещено. '") + ПараметрыТекущегоЭтапа;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Если файл является первичным документом, то на него не распространяются ограничения шаблона процесса
	// Надо отличать программную запись от интерактивной, интерактивная должна быть запрещена,
	// но должна быть разрешена, например, подпись первичного документа
	Если Источник.ЭтоНовый() И ФайлЯвляетсяПервичнымДокументом(Источник.ПолучитьСсылкуНового())
		ИЛИ Источник.ДополнительныеСвойства.Свойство("ПроцессыОбработкиДокументов_ПервичныйДокумент") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Источник.ЭтоНовый() И ФайлЯвляетсяПервичнымДокументом(Источник.Ссылка) Тогда
		Если НЕ ФайлНовый
			И (ИсходныеРеквизиты.ПометкаУдаления <> Источник.ПометкаУдаления
				ИЛИ ИсходныеРеквизиты.Наименование <> Источник.Наименование
				ИЛИ ИсходныеРеквизиты.Описание <> Источник.Описание
				ИЛИ РазличияТекущейВерсии
				ИЛИ (НЕ ЗначениеЗаполнено(ИсходныеРеквизиты.Редактирует)
					И ЗначениеЗаполнено(Источник.Редактирует))) Тогда
			ВызватьИсключение НСтр("ru='Изменение файлов первичных документов запрещено'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ФайлНовый И ПараметрыТекущегоЭтапа.ЗапрещеноДобавлениеФайлов Тогда
		ВызватьИсключение НСтр("ru='Добавление присоединенных файлов запрещено настройками шаблона процесса'");
	КонецЕсли;
	
	Если НЕ ФайлНовый И ПараметрыТекущегоЭтапа.ЗапрещеноИзменениеФайлов
		И (ИсходныеРеквизиты.ПометкаУдаления <> Источник.ПометкаУдаления
			ИЛИ ИсходныеРеквизиты.Наименование <> Источник.Наименование
			ИЛИ ИсходныеРеквизиты.Описание <> Источник.Описание
			ИЛИ РазличияТекущейВерсии
			ИЛИ (НЕ ЗначениеЗаполнено(ИсходныеРеквизиты.Редактирует) И ЗначениеЗаполнено(Источник.Редактирует))) Тогда
		ВызватьИсключение НСтр("ru='Изменение присоединенных файлов запрещено настройками шаблона процесса'");
	КонецЕсли;
	
	Если НЕ ФайлНовый И ФайлыПодписанныеЗадачами(Источник.Ссылка).Количество() > 0
		И ((ИсходныеРеквизиты.ПометкаУдаления <> Источник.ПометкаУдаления И ПараметрыТекущегоЭтапа.Исполнитель <> Источник.Автор)
			ИЛИ ИсходныеРеквизиты.Наименование <> Источник.Наименование
			ИЛИ ИсходныеРеквизиты.Описание <> Источник.Описание
			ИЛИ РазличияТекущейВерсии
			ИЛИ (НЕ ЗначениеЗаполнено(ИсходныеРеквизиты.Редактирует) И ЗначениеЗаполнено(Источник.Редактирует))) Тогда
		ВызватьИсключение НСтр("ru='Файл подписан электронной подписью, изменение запрещено'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура ПриЧтенииНаСервере(Форма, ТекущийОбъект, ИмяГруппыДляРазмещения = "ГруппаПроцесс", ГруппаДляКнопкиПроцесс = Неопределено) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонИСтатус = ШаблонИСтатусДокумента(ТекущийОбъект, Истина);
	Шаблон = ШаблонИСтатус.Шаблон;
	Статус = ШаблонИСтатус.Статус;
	
	Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
		Форма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("ТипПредметаПроцессаОбработкиДокументов"));
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ТекущийШаблон")
			И ЗначениеЗаполнено(Форма.ПроцессыОбработкиДокументов_ТекущийШаблон) Тогда
			НастроитьЭлементыФормыПриОчисткеШаблонаПроцесса(Форма);
		КонецЕсли;
		Возврат;
	ИначеЕсли НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ШаблоныПроцессов) Тогда
		Форма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("ТипПредметаПроцессаОбработкиДокументов"));
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Недостаточно прав для получения сведений о процессе обработки документа.'"));
		Форма.ТолькоПросмотр = Истина;
		Возврат;
	КонецЕсли;
	
	Ссылка = ТекущийОбъект.Ссылка;
	
	// Если шаблон определен, то планка удаляется
	УдалитьЭлементФормыНевозможностьОбработкиДокумента(Форма);
	
	ПовторноеЧтениеОбъекта = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		Форма, "ПроцессыОбработкиДокументов_ТекущийШаблон");
	ПроведенаПолнаяИнициализация = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		Форма, "ПроцессыОбработкиДокументов_ТекущаяЗадача");
	
	ПроверитьСостояниеВыполняемыхЗадач();
	
	// Определение текущего этапа и возможности его выполнения текущим пользователем
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Шаблон);
	
	РазрешитьТолькоПросмотрФормы = Ложь;
	ДобавитьКомандуПринятьКИсполнению = Ложь;
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая()
		И НЕ ТекущийПользовательМожетБытьИсполнителем(Ссылка, ПараметрыТекущегоЭтапа, Шаблон) Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли НЕ Константы.РазрешитьРедактированиеДокументаДоПринятияКИсполнению.Получить()
		И НЕ ПараметрыТекущегоЭтапа.Задача.Пустая()
		И НесколькоПользователейМогутБытьИсполнителями(Ссылка, ПараметрыТекущегоЭтапа) Тогда
		// При ролевой адресации и наличии нескольких потенциальных исполнителей
		// перед работой с документом требуется предварительно "захватить задачу"
		РазрешитьТолькоПросмотрФормы = Истина;
		ДобавитьКомандуПринятьКИсполнению = Истина;
	КонецЕсли;
	
	УдалитьКнопкиСКомандамиРезультатовВыполнения(Форма);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаКомментарии", "Видимость", НЕ РазрешитьТолькоПросмотрФормы ИЛИ ДобавитьКомандуПринятьКИсполнению);
	
	Если РазрешитьТолькоПросмотрФормы Тогда
		
		Форма.ТолькоПросмотр = Истина;
		
		Если НЕ ПовторноеЧтениеОбъекта Тогда
			ДобавитьРеквизитыФормыПроцесса(Форма, ИмяГруппыДляРазмещения, НЕ ПовторноеЧтениеОбъекта, Ложь);
		КонецЕсли;
		
		Если ДобавитьКомандуПринятьКИсполнению Тогда
			
			ГруппаПроцесс = НайтиДобавитьГруппуДляРазмещения(Форма);
			ГруппаРезультатыВыполнения = НайтиДобавитьГруппуРезультатыВыполнения(Форма, ГруппаПроцесс);
			ДобавитьКнопкуСКомандойПринятьКИсполнению(Форма, ГруппаРезультатыВыполнения);
			ДобавитьЭлементыКомментарии(Форма, ГруппаПроцесс);
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
				"КомментарийНаправившего", "Видимость", НЕ ПустаяСтрока(ПараметрыТекущегоЭтапа.Описание));
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
				"КомментарийСледующему", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
				"ГруппаКомандыКомментарии", "Видимость", Ложь);
			
			Форма.Элементы.ГруппаКомментарииСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаСтраницаКомментарийНаправившего;
			
			Форма.ПроцессыОбработкиДокументов_КомментарийНаправившего =
				Строка(ПараметрыТекущегоЭтапа.Автор) + ": " + ПараметрыТекущегоЭтапа.Описание;
			Форма.ПроцессыОбработкиДокументов_ТекущийШаблон = Шаблон;
			Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре = Шаблон;
			Форма.ПроцессыОбработкиДокументов_НаименованиеЭтапа = ПараметрыТекущегоЭтапа.НаименованиеЭтапа;
			
		КонецЕсли;
		
		ДобавитьЭлементФормыТекущийСтатус(Форма, ДобавитьКомандуПринятьКИсполнению);
		Форма.ПроцессыОбработкиДокументов_ТекущийСтатус = Статус;
		
	Иначе
		
		Если ПравоДоступа("Изменение", Ссылка.Метаданные()) И Форма.ТолькоПросмотр Тогда
			Форма.ТолькоПросмотр = Ложь;
		КонецЕсли;
		
		Если НЕ ПовторноеЧтениеОбъекта ИЛИ НЕ ПроведенаПолнаяИнициализация Тогда
			ДобавитьРеквизитыФормыПроцесса(Форма, ИмяГруппыДляРазмещения, НЕ ПовторноеЧтениеОбъекта);
		Иначе
			ДобавитьЭлементФормыТекущийСтатус(Форма, Истина);
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"КомментарийСледующему", "Видимость", Истина);
		
		ОбновитьЗначенияКонстантВРеквизитахФормы(Форма);
		
		Форма.ПроцессыОбработкиДокументов_ТекущийШаблон = Шаблон;
		Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре = Шаблон;
		Форма.ПроцессыОбработкиДокументов_ТекущийСтатус = Статус;
		
		ИнициализацияФормыСогласноТекущемуЭтапу(Форма, ПараметрыТекущегоЭтапа, ПовторноеЧтениеОбъекта);
		
		ОбновитьПодсказкуВозможностиИзмененияШаблона(Форма, ТекущийОбъект);
		
	КонецЕсли;
	
	Если ПроведенаПолнаяИнициализация Тогда
		Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя = Ложь;
	КонецЕсли;
	
	ДобавитьКнопкуСКомандойПроцесс(Форма, ГруппаДляКнопкиПроцесс);
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриИнициализацииФормыДокумента(Форма, ТекущийОбъект, ПараметрыТекущегоЭтапа);
	
КонецПроцедуры

Процедура ПриСозданииНаСервере(Форма, Источник, ИмяГруппыДляРазмещения = "ГруппаПроцесс", ГруппаДляКнопкиПроцесс = Неопределено) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	// Для не новых документов логика реализована в процедуре ПриЧтенииНаСервере
	Если НЕ Источник.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	ПриСозданииНаСервереФормыНовогоДокумента(Форма, Источник, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонИСтатус = ШаблонИСтатусНовогоДокумента(Источник, Истина);
	Шаблон = ШаблонИСтатус.Шаблон;
	Статус = ШаблонИСтатус.Статус;
	
	Если ШаблонИСтатус.Свойство("ШаблонНеОпределен") Тогда
		// если есть несколько шаблонов с подходящим условием, то инициализация прекращается,
		// а на форму выводится соответствующее предупреждение
		ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, ИмяГруппыДляРазмещения, ШаблонИСтатус.ШаблонНеОпределен);
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Шаблон) Тогда
		ДобавитьРеквизитСИменемГруппыРазмещения(Форма, ИмяГруппыДляРазмещения, Истина);
		Форма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("ТипПредметаПроцессаОбработкиДокументов"));
		Возврат;
	ИначеЕсли НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ШаблоныПроцессов) Тогда
		Форма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("ТипПредметаПроцессаОбработкиДокументов"));
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Недостаточно прав для обработки документа по шаблону процесса.'"));
		Форма.ТолькоПросмотр = Истина;
		Возврат;
	КонецЕсли;
	
	Ссылка = Источник.Ссылка;
	
	// Определение текущего этапа и возможности его выполнения текущим пользователем
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Шаблон, Истина);
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, ИмяГруппыДляРазмещения, ПараметрыТекущегоЭтапа);
		Возврат;
	ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, ИмяГруппыДляРазмещения,
			НСтр("ru='В данный момент выполняется задача по обработке документа.'"));
	ИначеЕсли НЕ ТекущийПользовательМожетБытьИсполнителем(Источник, ПараметрыТекущегоЭтапа, Шаблон) Тогда
		ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, ИмяГруппыДляРазмещения,
			НСтр("ru='Недостаточно прав для обработки документа по шаблону процесса.'"));
		Возврат;
	КонецЕсли;
	
	ДобавитьРеквизитыФормыПроцесса(Форма, ИмяГруппыДляРазмещения);
	
	ОбновитьЗначенияКонстантВРеквизитахФормы(Форма);
	
	Форма.ПроцессыОбработкиДокументов_ТекущийШаблон = Шаблон;
	Форма.ПроцессыОбработкиДокументов_ТекущийСтатус = Статус;
	
	ИнициализацияФормыСогласноТекущемуЭтапу(Форма, ПараметрыТекущегоЭтапа);
	
	ДобавитьКнопкуСКомандойПроцесс(Форма, ГруппаДляКнопкиПроцесс);
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриИнициализацииФормыДокумента(Форма, Источник, ПараметрыТекущегоЭтапа);
	
КонецПроцедуры

Процедура ПередЗаписьюНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи, Отказ = Ложь) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	// если документ записывается не по кнопке выполнения этапа, то необходимо при записи объекта
	// записать комментарий исполнителя текущей задачи по обработке документа и сбросить флаг модифицированности комментария
	// если по кнопке выполнения этапа, то задача будет записана при ее выполнении (кроме случаев, когда задачи еще нет)
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ТекущаяЗадача") Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗаписьВФорме", Истина);
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ШаблонИзФормы", Форма.ПроцессыОбработкиДокументов_ТекущийШаблон);
		ТекущийОбъект.ДополнительныеСвойства.Вставить("КомментарийИсполнителя", Форма.ПроцессыОбработкиДокументов_КомментарийСледующему);
		Если Форма.ПроцессыОбработкиДокументов_ВыполняетсяЗаписьПоКнопкеВыполненияЭтапа Тогда
			Форма.ПроцессыОбработкиДокументов_ВыполняетсяЗаписьПоКнопкеВыполненияЭтапа = Ложь;
			ТекущийОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиЗапущенногоПроцессаВыполнения");
		ИначеЕсли Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя Тогда
			ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗадачаПоОбработкеДокументаДляЗаписи", Форма.ПроцессыОбработкиДокументов_ТекущаяЗадача);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ТекущаяЗадача") Тогда
		// после записи документа флаг модифицированности комментария необходимо сбросить
		Если Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя Тогда
			Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя = Ложь;
		КонецЕсли;
		// после первой записи или смены шаблона процесса, необходимо обновить значение шаблона в регистре
		Если НЕ ЗначениеЗаполнено(Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре)
			ИЛИ Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре <> Форма.ПроцессыОбработкиДокументов_ТекущийШаблон Тогда
			Шаблон = ШаблонИСтатусДокумента(ТекущийОбъект).Шаблон;
			Форма.ПроцессыОбработкиДокументов_ШаблонВРегистре = Шаблон;
			Если Шаблон <> Форма.ПроцессыОбработкиДокументов_ТекущийШаблон Тогда
				ОбновитьРеквизитыПоШаблонуПроцесса(Форма, ТекущийОбъект);
			КонецЕсли;
		Иначе
			ОбновитьПодсказкуВозможностиИзмененияШаблона(Форма, ТекущийОбъект);
		КонецЕсли;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_НовыйДокумент")
		И Форма.ПроцессыОбработкиДокументов_НовыйДокумент Тогда
		Форма.ПроцессыОбработкиДокументов_НовыйДокумент = Ложь;
		ОбновитьРеквизитыПоШаблонуПроцесса(Форма, ТекущийОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Доопределяет переданный динамический список дополнительной колонкой со значением текущего статуса документа.
// У доопределяемого списка должна быть определена основная таблица.
// Вызывается из события "ПриСозданииНаСервере" целевой формы списка.
//
// Параметры:
//   Форма            - УправляемаяФорма - Управляемая форма, содержащая доопределяемый список.
//   ИменаСписков     - Строка - Имена доопределяемых динамических списков через запятую.
//   ИмяКолонки       - Строка - Имя колонки статуса. Должно удовлетворять требованиям, предъявляемым к именованию переменных встроенного языка.
//   ЗаголовокКолонки - Строка - Заголовок колонки статуса и пользовательское представление статуса в настройке динамического списка
//   ПоложениеКолонки - Число - Индекс новой колонки в таблице формы.
//                              Если не указан, то добавляется на первое место (индекс = 0)
//                              Если указан индекс, превышающий максимальный, то добавляется на последнее место
//
Процедура ПриСозданииНаСервереФормыСписка(Форма, ИменаСписков, ИмяКолонки = "Статус", ЗаголовокКолонки = Неопределено, ПоложениеКолонки = 0) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Просмотр", Метаданные.Подсистемы.ПроцессыОбработкиДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	СписокИмен = СтрРазделить(ИменаСписков, ",", Ложь);
	Элементы = Форма.Элементы;
	
	Для Каждого ИмяСписка Из СписокИмен Цикл
		
		ТаблицаФормы = Элементы.Найти(СокрЛП(ИмяСписка));
		
		Если ТипЗнч(ТаблицаФормы) <> Тип("ТаблицаФормы")
			ИЛИ ТаблицаФормы.ПутьКДанным <> СокрЛП(ИмяСписка) Тогда
			// Если по имени динамического списка таблица найдена, но путь к данным отличается от имени динамического списка,
			// либо не найдена вообще, то выполняется попытка найти таблицу перебором всех элементов по совпадению пути к данным
			ТаблицаФормы = Неопределено;
			Для Каждого ЭлементФормы Из Элементы Цикл
				Если ТипЗнч(ЭлементФормы) <> Тип("ТаблицаФормы") Тогда
					Продолжить;
				КонецЕсли;
				Если ЭлементФормы.ПутьКДанным = СокрЛП(ИмяСписка) Тогда
					ТаблицаФормы = ЭлементФормы;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ТаблицаФормы = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ТекущийСписок = Форма[ТаблицаФормы.ПутьКДанным];
		ОсновнаяТаблица = ТекущийСписок.ОсновнаяТаблица;
		
		Если НЕ ЗначениеЗаполнено(ОсновнаяТаблица) Тогда
			Продолжить;
		КонецЕсли;
		
		// Для форм списков документов колонка добавляется, если для типа документа указано использование шаблона процесса
		Если СтрРазделить(ОсновнаяТаблица, ".")[0] = "Документ" Тогда
			Выборка = ВыборкаИспользуемыхШаблоновДокумента(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОсновнаяТаблица));
			Если Выборка.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
		// Для журналов документов колонка добавляется, если для хотя бы одного типа из журнала указано использование шаблона процесса
		ИначеЕсли СтрРазделить(ОсновнаяТаблица, ".")[0] = "ЖурналДокументов" Тогда
			РегистрируемыеДокументы = Новый Массив;
			Для Каждого РегистируемыйДокумент Из Метаданные.НайтиПоПолномуИмени(ОсновнаяТаблица).РегистрируемыеДокументы Цикл
				РегистрируемыеДокументы.Добавить(РегистируемыйДокумент);
			КонецЦикла;
			Идентификаторы = Новый Массив;
			Для Каждого Идентификатор Из ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(РегистрируемыеДокументы) Цикл
				Идентификаторы.Добавить(Идентификатор.Значение);
			КонецЦикла;
			Выборка = ВыборкаИспользуемыхШаблоновДокумента(Идентификаторы);
			Если Выборка.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ТекстЗапроса = "";
		Если ТекущийСписок.ПроизвольныйЗапрос Тогда
			ТекстЗапроса = ТекущийСписок.ТекстЗапроса;
		Иначе
			ИсполняемаяСхема = ТаблицаФормы.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
			НаборДанныхДинамическогоСписка = ИсполняемаяСхема.НаборыДанных.Найти("НаборДанныхДинамическогоСписка");
			Если НаборДанныхДинамическогоСписка <> Неопределено Тогда
				ТекущийСписок.ПроизвольныйЗапрос = Истина;
				ТекстЗапроса = НаборДанныхДинамическогоСписка.Запрос;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекстЗапроса) Тогда
			Продолжить;
		КонецЕсли;
		
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.РежимКомпоновкиДанных = Истина;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		
		ПоследнийЗапрос = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
		
		Если ПоследнийЗапрос.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Обнаружено дублирование имен полей динамического списка ""%1"". Колонка со статусом документа выведена не будет'"),
				ИмяСписка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ОператорВыбрать = ПоследнийЗапрос.Операторы[0];
		
		ИсточникОсновнойТаблицы = ОператорВыбрать.Источники[0];
		
		ИсточникТекущиеСтатусыДокументов = ОператорВыбрать.Источники.Добавить("РегистрСведений.ТекущиеСтатусыДокументов", "ТекущиеСтатусыДокументов");
		
		Попытка
			Если НЕ ИсточникОсновнойТаблицы.Соединения.Добавить(
				ИсточникТекущиеСтатусыДокументов,
				ИсточникОсновнойТаблицы.Источник.Псевдоним + ".Ссылка = ТекущиеСтатусыДокументов.Предмет") Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
		
		Соединение = ИсточникОсновнойТаблицы.Соединения.НайтиПоПсевдониму("ТекущиеСтатусыДокументов");
		Соединение.ОбязательноеСоединение = Ложь;
		Соединение.НачалоГруппыНеобязательныхСоединений = Истина;
		
		ОператорВыбрать.ВыбираемыеПоля.Добавить("ТекущиеСтатусыДокументов.Статус");
		
		КолонкаСтатус = ПоследнийЗапрос.Колонки.Получить(ПоследнийЗапрос.Колонки.Количество() - 1);
		КолонкаСтатус.Псевдоним = ИмяКолонки;
		
		СтруктураСвойствДинамическогоСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
		СтруктураСвойствДинамическогоСписка.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
		ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(ТаблицаФормы, СтруктураСвойствДинамическогоСписка);
		
		// добавление колонки на форму
		Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
			КолонкаСтатуса = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), ТаблицаФормы);
		Иначе
			КолонкаСтатуса = Элементы.Добавить(ИмяСписка+ИмяКолонки+"ПОД", Тип("ПолеФормы"), ТаблицаФормы);
		КонецЕсли;
		КолонкаСтатуса.Вид = ВидПоляФормы.ПолеНадписи;
		КолонкаСтатуса.ПутьКДанным = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2", ИмяСписка, ИмяКолонки);
		КолонкаСтатуса.Заголовок = ?(ЗаголовокКолонки = Неопределено, НСтр("ru = 'Статус'"), ЗаголовокКолонки);
		
		КолонкиСписка = ТаблицаФормы.ПодчиненныеЭлементы;
		Если КолонкиСписка.Количество() > 0 Тогда
			Элементы.Переместить(КолонкаСтатуса, ТаблицаФормы, КолонкиСписка.Получить(ПоложениеКолонки));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьЗадачу(Форма, Контекст, Источник) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	Если Контекст = "ПринятьКИсполнениюПроцессыОбработкиДокументов" Тогда
		ПринятьКИсполнениюИРазблокироватьФорму(Форма, Источник);
		Возврат;
	ИначеЕсли Контекст = "ОбновитьРеквизитыПоШаблонуПроцесса" Тогда
		ОбновитьРеквизитыПоШаблонуПроцесса(Форма, Источник);
		Возврат;
	ИначеЕсли Контекст = "ИзменитьШаблонПроцесса" Тогда
		ИзменитьШаблонПроцессаНаФорме(Форма, Источник);
		Возврат;
	КонецЕсли;
	
	Контекст.Вставить("ВызыватьИсключениеПриОшибке", Истина);
	
	ВыполнитьЗадачи(Контекст);
	
	Ссылка = Контекст.ДанныеДокументов[0].Документ;
	
	// Если документ был изменен - перечитывание формы
	Если ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура")
		И Источник.ВерсияДанных <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ВерсияДанных") Тогда
		Форма.Прочитать();
		Возврат; // Инициализация будет выполнена в событии ПриЧтенииНаСервере
	КонецЕсли;
	
	УдалитьКнопкиСКомандамиРезультатовВыполнения(Форма);
	
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Форма.ПроцессыОбработкиДокументов_ТекущийШаблон);
	
	РазрешитьТолькоПросмотрФормы = Ложь;
	ДобавитьКомандуПринятьКИсполнению = Ложь;
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая() Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли НЕ Константы.РазрешитьРедактированиеДокументаДоПринятияКИсполнению.Получить()
		И НесколькоПользователейМогутБытьИсполнителями(Ссылка, ПараметрыТекущегоЭтапа) Тогда
		// При ролевой адресации и наличии нескольких потенциальных исполнителей
		// перед работой с документом требуется предварительно "захватить задачу"
		РазрешитьТолькоПросмотрФормы = Истина;
		ДобавитьКомандуПринятьКИсполнению = Истина;
	КонецЕсли;
	
	ТаблицаСтатусовДокументов = СтатусыОбъектов(Ссылка);
	Если ТаблицаСтатусовДокументов.Количество() > 0 Тогда
		Форма.ПроцессыОбработкиДокументов_ТекущийСтатус = ТаблицаСтатусовДокументов[0].Статус;
	Иначе
		Форма.ПроцессыОбработкиДокументов_ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка");
	КонецЕсли;
	
	Форма.ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя = Ложь;
	
	Если РазрешитьТолькоПросмотрФормы Тогда
		
		Форма.ТолькоПросмотр = Истина;
		
		ДобавитьЭлементФормыТекущийСтатус(Форма, ДобавитьКомандуПринятьКИсполнению);
		
		Если ДобавитьКомандуПринятьКИсполнению Тогда
			
			ДобавитьКнопкуСКомандойПринятьКИсполнению(Форма, Форма.Элементы.Найти("ГруппаРезультатыВыполнения"));
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КомментарийНаправившего", "Видимость", НЕ ПустаяСтрока(ПараметрыТекущегоЭтапа.Описание));
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КомментарийСледующему", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКомандыКомментарии", "Видимость", Ложь);
			
			Форма.ПроцессыОбработкиДокументов_КомментарийНаправившего = Строка(ПараметрыТекущегоЭтапа.Автор) + ": " + ПараметрыТекущегоЭтапа.Описание;
			Форма.ПроцессыОбработкиДокументов_НаименованиеЭтапа = ПараметрыТекущегоЭтапа.НаименованиеЭтапа;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКомментарии", "Видимость", Ложь);
		КонецЕсли;
		
		Форма.РазблокироватьДанныеФормыДляРедактирования();
		
	Иначе
		
		ИнициализацияФормыСогласноТекущемуЭтапу(Форма, ПараметрыТекущегоЭтапа);
		
	КонецЕсли;
	
	// Если была задача была успешно выполнена, то изменение шаблона уже недоступно
	УстановитьВидимостьПодсказкиВозможностиИзмененияШаблона(Форма, Ложь);
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриИнициализацииФормыДокумента(Форма, Источник, ПараметрыТекущегоЭтапа);
	
КонецПроцедуры

Процедура ВыполнитьЗадачи(Контекст, АдресРезультата = Неопределено) Экспорт
	
	МодульОценкаПроизводительности = Неопределено;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ОценкаПроизводительности") Тогда
		МодульОценкаПроизводительности = ОбщегоНазначения.ОбщийМодуль("ОценкаПроизводительности");
	КонецЕсли;
	
	НовыйСтатус = Контекст.Статус;
	
	ЗадачиСОшибками = Новый Массив;
	
	ВсегоЗадач = Контекст.ДанныеДокументов.Количество();
	ОбработаноЗадач = 0;
	ВыполненоУспешноЗадач = 0;
	
	ОповещатьОПрогрессе = Контекст.Свойство("ОповещатьОПрогрессе") И Контекст.ОповещатьОПрогрессе;
	
	Для Каждого ДанныеДокумента Из Контекст.ДанныеДокументов Цикл
		
		Если МодульОценкаПроизводительности <> Неопределено Тогда
			ВремяНачала = МодульОценкаПроизводительности.НачатьЗамерВремени();
			КлючеваяОперация = "ПроцессыОбработкиДокументов.ВыполнениеЗадачи";
			КомментарийДляЗамера = "";
			ВыполненоУспешноДоЗамера = ВыполненоУспешноЗадач;
		КонецЕсли;
		
		Если ОповещатьОПрогрессе Тогда
			ОповеститьОПрогрессеВыполненияЗадач(ВсегоЗадач, ОбработаноЗадач, ВыполненоУспешноЗадач, ЗадачиСОшибками.Количество());
		КонецЕсли;
		
		ИндексПоследнегоСообщения = ПолучитьСообщенияПользователю().ВГраница();
		
		НачатьТранзакцию();
		Попытка
			
			ЗаблокироватьРегистрТекущиеСтатусыДокументов(ДанныеДокумента.Документ);
			
			ЗадачаОбъект = ДанныеДокумента.Задача.ПолучитьОбъект();
			
			Комментарий = ?(Контекст.Комментарий = Неопределено, ЗадачаОбъект.РезультатВыполнения, Контекст.Комментарий);
			
			// Выполняется дополнительный обработчик
			ВыполнитьДополнительныйОбработчик(
				ДанныеДокумента.Документ,
				ДанныеДокумента.Задача,
				ДанныеДокумента.Шаблон,
				ДанныеДокумента.ИдентификаторЭтапа,
				НовыйСтатус,
				Контекст.ДополнительныйКонтекст,
				ДанныеДокумента.ДополнительныеПараметры,
				Контекст,
				,
				,
				Комментарий);
			
			КомментарийДляЗамера = ЗадачаОбъект.Наименование;
			
			// Если документ был подписан ЭП, то необходимо сохранить подписанные данные
			ДобавитьПодписьПриВыполненииЗадачи(ДанныеДокумента, ЗадачаОбъект, Контекст);
			
			// Выполнение текущей задачи пользователя
			ВыполнитьЗадачуПользователя(ЗадачаОбъект, , Комментарий);
			
			ИзменитьИсториюСтатусовДокумента(ДанныеДокумента.Документ, ДанныеДокумента.Шаблон, НовыйСтатус, ЗадачаОбъект.Ссылка,
				ЗадачаОбъект.ДатаИсполнения);
			
			ПроцессыОбработкиДокументовПереопределяемый.ПередЗапускомПрерываниемСледующихЭтапов(ДанныеДокумента.Документ,
				ДанныеДокумента.Шаблон, ДанныеДокумента.ИдентификаторЭтапа, НовыйСтатус, ЗадачаОбъект.Ссылка);
			
			ВыполнитьПрерываниеЭтапов(
				ДанныеДокумента.Документ,
				ДанныеДокумента.Шаблон,
				ДанныеДокумента.ИдентификаторЭтапа,
				НовыйСтатус,
				ДанныеДокумента.Задача,
				Комментарий);
			
			ПриВыполненииЗадачиКуратораГрупповогоЭтапа(ДанныеДокумента.Документ, ДанныеДокумента.Шаблон,
				ДанныеДокумента.ИдентификаторЭтапа, ДанныеДокумента.Задача);
			
			УстановитьТекущийСтатусДокумента(ДанныеДокумента.Документ, ДанныеДокумента.Шаблон, НовыйСтатус, ЗадачаОбъект.Ссылка,
				ЗадачаОбъект.ДатаИсполнения);
			
			// Если выполнение данного этапа является триггером для выполнения этапа другого документа,
			// необходимо запустить выполнение связанных этапов/задач
			ВыполнитьЗависимыеЗадачи(
				ДанныеДокумента.Документ,
				ДанныеДокумента.Шаблон,
				ДанныеДокумента.ИдентификаторЭтапа,
				НовыйСтатус,
				ДанныеДокумента.Задача,
				Контекст.ДополнительныйКонтекст,
				Комментарий);
			
			ВыполнитьЗапускЭтапов(ДанныеДокумента.Документ,
									ДанныеДокумента.Шаблон,
									ДанныеДокумента.ИдентификаторЭтапа,
									НовыйСтатус,
									Комментарий);
			
			УправлениеРегламентнымиИнтерваламиПриВыполненииЗадачи(ЗадачаОбъект);
			
			СохранитьСобытиеИсторииЗадач(ДанныеДокумента.Задача, ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.Выполнение"));
			
			ОтметитьЗадачиКакНевыполняемые(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеДокумента.Задача));
			
			ПроцессыОбработкиДокументовПереопределяемый.ПриВыполненииЗадачи(ДанныеДокумента.Задача);
			
			ВыполненоУспешноЗадач = ВыполненоУспешноЗадач + 1;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение задачи по обработке документа'", ОбщегоНазначения.КодОсновногоЯзыка()),
									УровеньЖурналаРегистрации.Ошибка,,,
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Для ИндексСообщения = ИндексПоследнегоСообщения + 1 По ПолучитьСообщенияПользователю().ВГраница() Цикл
				ОписаниеОшибки = " - " + ПолучитьСообщенияПользователю()[ИндексСообщения].Текст + "
					|" + ОписаниеОшибки;
			КонецЦикла;
			
			ЗадачиСОтказомВыполнения = Новый Структура;
			ЗадачиСОтказомВыполнения.Вставить("Задача", ДанныеДокумента.Задача);
			ЗадачиСОтказомВыполнения.Вставить("ДатаПопытки", ТекущаяДатаСеанса());
			ЗадачиСОтказомВыполнения.Вставить("ОписаниеОшибки ", ОписаниеОшибки);
			
			ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗадачиСОтказомВыполнения));
			
			ЗадачиСОшибками.Добавить(ЗадачиСОтказомВыполнения);
			
			ПроцессыОбработкиДокументовПереопределяемый.ПриНеуспешномВыполненииЗадачи(ДанныеДокумента.Задача, НовыйСтатус, ИнформацияОбОшибке());
			
			Если Контекст.Свойство("ВызыватьИсключениеПриОшибке") И Контекст.ВызыватьИсключениеПриОшибке Тогда
				Если МодульОценкаПроизводительности <> Неопределено Тогда
					МодульОценкаПроизводительности.ЗакончитьЗамерВремени(КлючеваяОперация, ВремяНачала,,, Истина);
				КонецЕсли;
				ВызватьИсключение;
			КонецЕсли;
			
		КонецПопытки;
		
		ОбработаноЗадач = ОбработаноЗадач + 1;
		
		Если МодульОценкаПроизводительности <> Неопределено Тогда
			МодульОценкаПроизводительности.ЗакончитьЗамерВремени(
				КлючеваяОперация, ВремяНачала,,
				?(ЗначениеЗаполнено(КомментарийДляЗамера), КомментарийДляЗамера, ДанныеДокумента.Задача),
				ВыполненоУспешноДоЗамера = ВыполненоУспешноЗадач);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗадачиСОшибками.ВГраница() <> -1 Тогда
		Контекст.Вставить("ЗадачиСОшибками", ЗадачиСОшибками);
	КонецЕсли;
	
	Если АдресРезультата <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(Контекст, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет задачи по обработке документов по имени инициирующего события.
// Может использоваться, когда есть необходимость выполнить задачи по обработке документов в произвольных серверных методах,
// а не по кнопкам библиотеки. Предполагается, что вызов процедуры будет осуществляться в одной транзакции с выполнением
// некоторой прикладной логики конфигурации, которая должна инициировать выполнение задач
//
// Имена событий должно быть предварительно описаны в процедуре ПроцессыОбработкиДокументовПереопределяемый.ОписаниеСобытийИнициирующихВыполнениеЭтапов,
// а также подключены к конкретным результатам выполнения этапов в шаблонах процессов
//
// Параметры:
//  Объекты - Массив, ДокументСсылка - ссылка на документ или массив ссылок на документы, задачи по обработке которых следует выполнить
//  Событие - Строка - Идентификатор события, описанного в процедуре ПроцессыОбработкиДокументовПереопределяемый.ОписаниеСобытийИнициирующихВыполнениеЭтапов
//  Комментарий - Строка - Комментарий для следующего исполнителя, описание выполнения задачи
//  ДополнительныйКонтекст - Произвольный - параметр, доступный для использования в дополнительных обработчиках выполнения задачи по этапу
//
Процедура ВыполнитьЗадачиПоСобытию(Объекты, Событие, Комментарий = "", ДополнительныйКонтекст = Неопределено) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объекты) = Тип("Массив") Тогда
		ОбъектыДляОбработки = Объекты;
	Иначе
		ОбъектыДляОбработки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объекты);
	КонецЕсли;
	
	// Если результат выполнения этапа предполагает электронную подпись, то он не может быть выполнен без клиента
	ПроверитьТребованиеОНаличииЭП = ПолучитьФункциональнуюОпцию("ИспользоватьЭППриВыполненииЭтапов")
		И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись");
	
	ДанныеДокументов = Новый Массив;
	
	СообщенияОбОшибке = Новый Массив;
	
	Для Каждого Объект Из ОбъектыДляОбработки Цикл
		
		Шаблон = ШаблонИСтатусДокумента(Объект).Шаблон;
		
		Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
			Продолжить;
		ИначеЕсли НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ШаблоныПроцессов) Тогда
			ВызватьИсключение НСтр("ru='Недостаточно прав для выполнения задач по обработке документов.'");
		КонецЕсли;
		
		ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Объект, Шаблон, , Истина);
		
		Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка выполнения задачи по обработке документа %1 по причине: '") + ПараметрыТекущегоЭтапа,
				Объект);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка выполнения задачи по обработке документа %1 по причине: В данный момент выполняется задача по обработке документа'"),
				Объект);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая()
			И НЕ ТекущийПользовательМожетБытьИсполнителем(Объект, ПараметрыТекущегоЭтапа, Шаблон) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Недостаточно прав для выполнения задачи по документу %1'"),
				Объект);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ШаблоныПроцессовИнициирующиеСобытия.Статус КАК Статус
		|ИЗ
		|	Справочник.ШаблоныПроцессов.ИнициирующиеСобытия КАК ШаблоныПроцессовИнициирующиеСобытия
		|ГДЕ
		|	ШаблоныПроцессовИнициирующиеСобытия.Ссылка = &Шаблон
		|	И ШаблоныПроцессовИнициирующиеСобытия.ИдентификаторЭтапа = &ИдентификаторЭтапа
		|	И ШаблоныПроцессовИнициирующиеСобытия.Событие = &Событие";
		
		Запрос.УстановитьПараметр("Шаблон", Шаблон);
		Запрос.УстановитьПараметр("ИдентификаторЭтапа", ПараметрыТекущегоЭтапа.ИдентификаторЭтапа);
		Запрос.УстановитьПараметр("Событие", Событие);
		
		Выборка = Запрос.Выполнить().Выбрать();
		// Если в шаблоне для текущего этапа не найдено инициирующее событие - задача не выполняется
		Если НЕ Выборка.Следующий() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПроверитьТребованиеОНаличииЭП Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ИСТИНА КАК Поле1
			|ИЗ
			|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
			|ГДЕ
			|	ЭтапыПроцессовРезультатыВыполнения.Ссылка = &Ссылка
			|	И ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = &СтатусПослеВыполнения
			|	И ЭтапыПроцессовРезультатыВыполнения.ТребуетсяЭП";
			Запрос.УстановитьПараметр("Ссылка", ПараметрыТекущегоЭтапа.Этап);
			Запрос.УстановитьПараметр("СтатусПослеВыполнения", Выборка.Статус);
			Если НЕ Запрос.Выполнить().Пустой() Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка выполнения задачи по обработке документа %1 по причине:
					|этап, предполагающий использование усиленной электронной подписи, не может быть выполнен на сервере'"),
					Объект);
				СообщенияОбОшибке.Добавить(ТекстСообщения);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Ссылка", Объект);
		ДанныеДокумента.Вставить("Шаблон", Шаблон);
		ДанныеДокумента.Вставить("Статус", Выборка.Статус);
		ДанныеДокумента.Вставить("Исполнитель", Неопределено);
		ДанныеДокумента.Вставить("ПараметрыТекущегоЭтапа", ПараметрыТекущегоЭтапа);
		ДанныеДокумента.Вставить("Отказ", Ложь);
		ДанныеДокумента.Вставить("Комментарий", Комментарий);
		
		ДанныеДокументов.Добавить(ДанныеДокумента);
		
	КонецЦикла;
	
	ПроверкаВыполненияТребованийШаблоновПроцессов(ДанныеДокументов, СообщенияОбОшибке);
	
	ВыполнитьЗадачиВТранзакции(ДанныеДокументов, СообщенияОбОшибке, ДополнительныйКонтекст);
	
	// Проброс исключения во внешнюю транзакцию
	Если СообщенияОбОшибке.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(СообщенияОбОшибке, Символы.ПС);
	КонецЕсли;
	
КонецПроцедуры

// Отменяет выполнение задачи по обработке документов, ранее выполненной по имени инициирующего события.
// Может использоваться, когда есть необходимость отмены выполнения задачи по обработке документов в произвольных серверных методах,
// а не по кнопкам библиотеки. Предполагается, что вызов процедуры будет осуществляться в одной транзакции с выполнением
// некоторой прикладной логики конфигурации, которая должна инициировать отмену выполнения задач
//
// Имена событий должно быть предварительно описаны в процедуре ПроцессыОбработкиДокументовПереопределяемый.ОписаниеСобытийИнициирующихВыполнениеЭтапов,
// а также подключены к конкретным результатам выполнения этапов в шаблонах процессов
//
// Параметры:
//  Объекты - Массив, ДокументСсылка - ссылка на документ или массив ссылок на документы, задачи которых следует отменить
//  Событие - Строка - Идентификатор события, описанного в процедуре ПроцессыОбработкиДокументовПереопределяемый.ОписаниеСобытийИнициирующихВыполнениеЭтапов
//  ДополнительныйКонтекст - Произвольный - параметр, доступный для использования в дополнительных обработчиках выполнения задачи по этапу
//
Процедура ОтменитьВыполнениеЗадачиПоСобытию(Объекты, Событие, ДополнительныйКонтекст = Неопределено) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объекты) = Тип("Массив") Тогда
		ОбъектыДляОбработки = Объекты;
	Иначе
		ОбъектыДляОбработки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объекты);
	КонецЕсли;
	
	СообщенияОбОшибке = Новый Массив;
	
	Для Каждого Объект Из ОбъектыДляОбработки Цикл
		
		Шаблон = ШаблонИСтатусДокумента(Объект).Шаблон;
		
		Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
			Продолжить;
		ИначеЕсли НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ШаблоныПроцессов) Тогда
			ВызватьИсключение НСтр("ru='Недостаточно прав для отмены выполнения задач по обработке документов.'");
		КонецЕсли;
		
		// Поиск последней выполенной задачи с идентификатором этапа, соответствующим имени отменяемого события
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ШаблоныПроцессовИнициирующиеСобытия.ИдентификаторЭтапа КАК ИдентификаторЭтапа
		|ПОМЕСТИТЬ ИдентификаторыЭтаповСобытия
		|ИЗ
		|	Справочник.ШаблоныПроцессов.ИнициирующиеСобытия КАК ШаблоныПроцессовИнициирующиеСобытия
		|ГДЕ
		|	ШаблоныПроцессовИнициирующиеСобытия.Ссылка = &Шаблон
		|	И ШаблоныПроцессовИнициирующиеСобытия.Событие = &Событие
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
		|ГДЕ
		|	ЗадачаПоОбработкеДокумента.Предмет = &Предмет
		|	И ЗадачаПоОбработкеДокумента.Шаблон = &Шаблон
		|	И ЗадачаПоОбработкеДокумента.Выполнена
		|	И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа В
		|			(ВЫБРАТЬ
		|				Т.ИдентификаторЭтапа
		|			ИЗ
		|				ИдентификаторыЭтаповСобытия КАК Т)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗадачаПоОбработкеДокумента.ДатаИсполнения УБЫВ";
		
		Запрос.УстановитьПараметр("Шаблон", Шаблон);
		Запрос.УстановитьПараметр("Событие", Событие);
		Запрос.УстановитьПараметр("Предмет", Объект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			ЗадачиДляОтмены = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.Ссылка);
			ЗадачиСОтказом = Новый Массив;
			
			ПроцессыОбработкиДокументовВызовСервера.ОтменитьВыполнениеЗадач(ЗадачиДляОтмены, ЗадачиСОтказом, ДополнительныйКонтекст);
			
			Для Каждого ЗадачаСОтказом Из ЗадачиСОтказом Цикл
				ТекстСообщения = НСтр("ru = 'Выполнение задачи ""'")
					+ Строка(ЗадачаСОтказом.Задача)
					+ НСтр("ru = '"" не может быть отменено по причине: '")
					+ ЗадачаСОтказом.ПричинаОтказа;
				СообщенияОбОшибке.Добавить(ТекстСообщения);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Проброс исключения во внешнюю транзакцию
	Если СообщенияОбОшибке.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(СообщенияОбОшибке, Символы.ПС);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет задачи по обработке документов.
// Может использоваться при необходимости выполнить задачи по обработке документов в произвольных серверных методах,
// а не по кнопкам библиотеки. Задачи будут выполняться от лица переданного пользователя, а не от текущего
//
// Параметры:
//  ДанныеЗадач - Массив - список элементов типа Структура с ключами
//   * Документ - ДокументСсылка - ссылка на документ, задачу которого следует выполнить
//   * Статус - СправочникСсылка.СтатусыДокументов - статус, который должен быть установлен после выполнения задачи
//   * Исполнитель - СправочникСсылка.Пользователи - исполнитель задачи
//   *              - Неопределено - испольнителем будет считаться текущий пользователь
//   * ПодписанПростойЭП - Булево - в случае если документ уже подписан на стороне обработчика, дополнительная проверка простой подписи не выполняется
//   * Комментарий - Строка - комментарий для следующего исполнителя, описание выполнения задачи
//
Процедура ВыполнитьЗадачиПоОбработкеДокументов(ДанныеЗадач) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыОбработкиДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	// Если результат выполнения этапа предполагает электронную подпись, то он не может быть выполнен без клиента
	ПроверитьТребованиеОНаличииЭП = ПолучитьФункциональнуюОпцию("ИспользоватьЭППриВыполненииЭтапов")
		И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись");
	
	ДанныеДокументов = Новый Массив;
	
	СообщенияОбОшибке = Новый Массив;
	
	Для Каждого ДанныеЗадачи Из ДанныеЗадач Цикл
		
		Объект = ДанныеЗадачи.Документ;
		
		ПодписанПростойЭП = Ложь;
		Если ДанныеЗадачи.Свойство("ПодписанПростойЭП") Тогда
			ПодписанПростойЭП = ДанныеЗадачи.ПодписанПростойЭП;
		КонецЕсли;
		
		Шаблон = ШаблонИСтатусДокумента(Объект).Шаблон;
		
		Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка выполнения задачи по обработке документа %1 по причине: По документу не запущен процесс обработки'"),
				Объект);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Объект, Шаблон, , Истина, ДанныеЗадачи.Исполнитель);
		
		Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка выполнения задачи по обработке документа %1 по причине: '") + ПараметрыТекущегоЭтапа,
				Объект);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка выполнения задачи по обработке документа %1 по причине: В данный момент выполняется задача по обработке документа'"),
				Объект);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая()
			И НЕ ТекущийПользовательМожетБытьИсполнителем(Объект, ПараметрыТекущегоЭтапа, Шаблон) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Недостаточно прав для выполнения задачи по документу %1'"),
				Объект);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяЭП КАК ТребуетсяЭП,
		|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяПростаяЭП КАК ТребуетсяПростаяЭП
		|ИЗ
		|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
		|ГДЕ
		|	ЭтапыПроцессовРезультатыВыполнения.Ссылка = &Ссылка
		|	И ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = &СтатусПослеВыполнения";
		
		Запрос.УстановитьПараметр("Ссылка", ПараметрыТекущегоЭтапа.Этап);
		Запрос.УстановитьПараметр("СтатусПослеВыполнения", ДанныеЗадачи.Статус);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка выполнения задачи по обработке документа %1 по причине:
				|у этапа процесса ""%2"" нет результата со статусом ""%3""'"),
				Объект, ПараметрыТекущегоЭтапа.Этап, ДанныеЗадачи.Статус);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		Если ПроверитьТребованиеОНаличииЭП И Выборка.ТребуетсяЭП ИЛИ (Выборка.ТребуетсяПростаяЭП И НЕ ПодписанПростойЭП) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка выполнения задачи по обработке документа %1 по причине:
				|этап, предполагающий использование электронной подписи, не может быть выполнен на сервере'"),
				Объект);
			СообщенияОбОшибке.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Ссылка", Объект);
		ДанныеДокумента.Вставить("Шаблон", Шаблон);
		ДанныеДокумента.Вставить("Статус", ДанныеЗадачи.Статус);
		ДанныеДокумента.Вставить("Исполнитель", ДанныеЗадачи.Исполнитель);
		ДанныеДокумента.Вставить("ПараметрыТекущегоЭтапа", ПараметрыТекущегоЭтапа);
		ДанныеДокумента.Вставить("Отказ", Ложь);
		ДанныеДокумента.Вставить("Комментарий", ДанныеЗадачи.Комментарий);
		Если ДанныеЗадачи.Свойство("ЗадачаВыполненаВЛичномКабинете") Тогда
			ДанныеДокумента.Вставить("ЗадачаВыполненаВЛичномКабинете", ДанныеЗадачи.ЗадачаВыполненаВЛичномКабинете);
			ДанныеДокумента.Вставить("ПодписанПростойЭП", ДанныеЗадачи.ПодписанПростойЭП);
			ДанныеДокумента.Вставить("ПодписанныеДанные", ДанныеЗадачи.ПодписанныеДанные);
		КонецЕсли;
		
		ДанныеДокументов.Добавить(ДанныеДокумента);
		
	КонецЦикла;
	
	ПроверкаВыполненияТребованийШаблоновПроцессов(ДанныеДокументов, СообщенияОбОшибке);
	
	ВыполнитьЗадачиВТранзакции(ДанныеДокументов, СообщенияОбОшибке, Неопределено);
	
	// Проброс исключения во внешнюю транзакцию
	Если СообщенияОбОшибке.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(СообщенияОбОшибке, Символы.ПС);
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыСозданияЗадачи() Экспорт
	
	ПараметрыЗадачи = Новый Структура;
	ПараметрыЗадачи.Вставить("Шаблон");
	ПараметрыЗадачи.Вставить("Этап");
	ПараметрыЗадачи.Вставить("ИдентификаторЭтапа");
	ПараметрыЗадачи.Вставить("НаименованиеЭтапа");
	ПараметрыЗадачи.Вставить("Статус");
	ПараметрыЗадачи.Вставить("Документ");
	ПараметрыЗадачи.Вставить("Описание", "");
	ПараметрыЗадачи.Вставить("Автор", Пользователи.ТекущийПользователь());
	ПараметрыЗадачи.Вставить("РезультатВыполнения", "");
	ПараметрыЗадачи.Вставить("Исполнитель");
	ПараметрыЗадачи.Вставить("РольИсполнителя");
	ПараметрыЗадачи.Вставить("ОсновнойОбъектАдресации");
	ПараметрыЗадачи.Вставить("ДополнительныйОбъектАдресации");
	ПараметрыЗадачи.Вставить("ПринятаКИсполнению", Ложь);
	ПараметрыЗадачи.Вставить("Предшественники", Новый Массив);
	ПараметрыЗадачи.Вставить("СрокВыполненияЧасы", 0);
	ПараметрыЗадачи.Вставить("СрокиОбработкиПоРеквизитуДни", 0); 
	ПараметрыЗадачи.Вставить("СрокиОбработкиПоРеквизитуЧасы", 0);
	ПараметрыЗадачи.Вставить("Порядок", 0);
	
	Возврат ПараметрыЗадачи;
	
КонецФункции

Процедура СоздатьЗадачу(Параметры) Экспорт
	
	ЗадачаОбъект = Задачи.ЗадачаПоОбработкеДокумента.СоздатьЗадачу();
	
	Если ЗначениеЗаполнено(Параметры.Исполнитель) Тогда
		ЗадачаОбъект.Исполнитель = Параметры.Исполнитель;
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.РольИсполнителя) Тогда
		ЗадачаОбъект.РольИсполнителя = Параметры.РольИсполнителя;
		Если ЗначениеЗаполнено(Параметры.ОсновнойОбъектАдресации) Тогда
			ЗадачаОбъект.ОсновнойОбъектАдресации = Параметры.ОсновнойОбъектАдресации;
		КонецЕсли;
		Если ЗначениеЗаполнено(Параметры.ДополнительныйОбъектАдресации) Тогда
			ЗадачаОбъект.ДополнительныйОбъектАдресации = Параметры.ДополнительныйОбъектАдресации;
		КонецЕсли;
	КонецЕсли;
	
	ЗадачаОбъект.Дата 					= ТекущаяДатаСеанса();
	ЗадачаОбъект.Наименование 			= Параметры.НаименованиеЭтапа + ": " + Параметры.Документ;
	ЗадачаОбъект.Автор 					= ?(Параметры.Свойство("Автор") И ЗначениеЗаполнено(Параметры.Автор),
											Параметры.Автор, Пользователи.ТекущийПользователь());
	ЗадачаОбъект.Описание 				= Параметры.Описание;
	ЗадачаОбъект.Предмет 				= Параметры.Документ;
	ЗадачаОбъект.Этап 					= Параметры.Этап;
	ЗадачаОбъект.ИдентификаторЭтапа 	= Параметры.ИдентификаторЭтапа;
	ЗадачаОбъект.Шаблон 				= Параметры.Шаблон;
	ЗадачаОбъект.Статус 				= Параметры.Статус;
	ЗадачаОбъект.РезультатВыполнения 	= Параметры.РезультатВыполнения;
	ЗадачаОбъект.ПринятаКИсполнению 	= Параметры.ПринятаКИсполнению;
	
	Если Параметры.ПринятаКИсполнению И НЕ ЗначениеЗаполнено(Параметры.Исполнитель) Тогда
		ЗадачаОбъект.Исполнитель = ЗадачаОбъект.Автор;
	КонецЕсли;
	
	Если Параметры.Свойство("СрокВыполненияЧасы")
		И ЗначениеЗаполнено(Параметры.СрокВыполненияЧасы) Тогда
		
		ЗадачаОбъект.СрокВыполненияЧасы = Параметры.СрокВыполненияЧасы;
		
		РеквизитыАдресации = Новый Структура("Исполнитель, РольИсполнителя, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации");
		ЗаполнитьЗначенияСвойств(РеквизитыАдресации, ЗадачаОбъект);
		
		Сроки = СрокиВыполненияИНапоминания(РеквизитыАдресации, ЗадачаОбъект.Дата, , Параметры.СрокВыполненияЧасы);
		
		ЗадачаОбъект.СрокВыполнения = Сроки.СрокВыполнения;
		ЗадачаОбъект.СрокНапоминания = Сроки.СрокНапоминания;
		
	КонецЕсли;
	
	// подсчет срока обработки от реквизита документа 
	ЗначениеРеквизитаДляРасчетаСрокаОбработки = ОпределитьРеквизитДляПодсчетаРегламента(Параметры.Шаблон, ЗадачаОбъект.Предмет);
	 
	Если ЗначениеЗаполнено(ЗначениеРеквизитаДляРасчетаСрокаОбработки) Тогда
		
		ЗадачаОбъект.ДатаОтсчетаПредельногоСрокаОбработки = ЗначениеРеквизитаДляРасчетаСрокаОбработки;

		РеквизитыАдресации = Новый Структура("Исполнитель, РольИсполнителя, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации");
		ЗаполнитьЗначенияСвойств(РеквизитыАдресации, ЗадачаОбъект);
		
		СрокОбработкиПоРеквизиту = НачалоДня(ЗначениеРеквизитаДляРасчетаСрокаОбработки);
		
		ПараметрыЭтапа = ОпределитьПродолжительностьПоследующихЭтаповПоРегламенту(Параметры.Порядок, Параметры.Шаблон);
		СрокиОбработки = СрокиОбработкиИНапоминанияПоРеквизиту(РеквизитыАдресации, СрокОбработкиПоРеквизиту, 
																	ПараметрыЭтапа.Дни, ПараметрыЭтапа.Часы); 
		
		ЗадачаОбъект.СрокОбработки  = СрокиОбработки.СрокОбработки;
		ЗадачаОбъект.СрокНапоминанияОбработки = СрокиОбработки.СрокНапоминанияОбработки;
		
	КонецЕсли;
	
	Для Каждого Предшественник Из Параметры.Предшественники Цикл
		НоваяСтрока = ЗадачаОбъект.Предшественники.Добавить();
		НоваяСтрока.ЗадачаПредшественник = Предшественник;
	КонецЦикла;
	
	УправлениеРегламентнымиИнтерваламиПриСозданииЗадачи(ЗадачаОбъект);
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриСозданииЗадачи(Параметры, ЗадачаОбъект);
	
	ЗадачаОбъект.Записать();
	
	ПроцессыОбработкиДокументовПереопределяемый.ПослеСозданияЗадачи(Параметры, ЗадачаОбъект);
	
	// Сохранение реквзитов задачи в исходных параметрах для последующей обработки в месте вызова
	Параметры.Вставить("Задача", ЗадачаОбъект.Ссылка);
	Параметры.Вставить("Дата", ЗадачаОбъект.Дата);
	
КонецПроцедуры

// Отмечает указанные задачи как не выполненные из-за ошибки, записывает описание ошибки.
//
// Параметры:
//  ЗадачиСОшибками - Массив - коллекция, где каждый элемент - Структура с полями:
//     * Задача - ЗадачаСсылка.ЗадачаПоОбработкеДокумента - ссылка на задачу, которую не удалось выполнить
//     * ОписаниеОшибки - Строка - описание ошибки при попытке выполнить задачу
//  Комментарий - Строка, Неопределено - комментарий исполнителя задачи.
//                Будет сохранен, если передано значение типа "Строка"
//
Процедура ОтметитьНеУспешнуюПопыткуВыполненияЗадач(ЗадачиСОшибками, Комментарий = Неопределено) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьЗадачи(ЗадачиСОшибками);
		
		МассивЗадач = Новый Массив;
		МассивОбработанныхЗадач = Новый Массив;
		
		Для Каждого ЗадачаСОшибкой Из ЗадачиСОшибками Цикл
			
			МассивЗадач.Добавить(ЗадачаСОшибкой.Задача);
			
			ЗадачаОбъект = ЗадачаСОшибкой.Задача.ПолучитьОбъект();
			Если ЗадачаОбъект.Выполнена Тогда
				Продолжить;
			КонецЕсли;
			
			ЗадачаОбъект.Заблокировать();
			ЗадачаОбъект.НеВыполненаИзЗаОшибки = Истина;
			ЗадачаОбъект.ОписаниеОшибки = Строка(ЗадачаСОшибкой.ДатаПопытки) + Символы.ПС + ЗадачаСОшибкой.ОписаниеОшибки;
			Если НЕ Комментарий = Неопределено Тогда
				ЗадачаОбъект.РезультатВыполнения = Комментарий;
			КонецЕсли;
			ЗадачаОбъект.Записать();
			
			МассивОбработанныхЗадач.Добавить(ЗадачаСОшибкой.Задача);
			
		КонецЦикла;
		
		СохранитьСобытиеИсторииЗадач(МассивОбработанныхЗадач,
			ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.НеуспешнаяПопыткаВыполнения"));
		
		ОтметитьЗадачиКакНевыполняемые(МассивЗадач);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция НепроверяемыйРеквизит(Имя) Экспорт
	
	Возврат ПроцессыОбработкиДокументовПовтИсп.НепроверяемыеРеквизиты()[Имя] <> Неопределено ИЛИ Лев(Имя, 7) = "Удалить";
	
КонецФункции // НепроверяемыйРеквизит()

Функция СтруктуруВСтрокуXML(Структура) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	СтруктуруВЗаписьXML(Структура, ЗаписьXML);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

// Возвращает строковое значение типа объекта учета, для которого подписываются данные
//
// Параметры:
//   ОбъектУчета - ОпределяемыйТип.ПредметПроцессаОбработкиДокументов - Ссылка на предмет процесса обработки
//
Функция ТипОбъектаУчета(ОбъектУчета) Экспорт
	Результат = "";

	ТипЗначения = ТипЗнч(ОбъектУчета);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
	    Результат = "Справочник";
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
	    Результат = "Документ";
	ИначеЕсли Метаданные.Отчеты.Содержит(ОбъектМетаданных) Тогда
	    Результат = "Регистр учета";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Возвращает список значений, содержащий перечень печатных форм объекта учета
//
// Параметры:
//  Идентификатор - СправочникСсылка.ИдентификаторыОбъектовМетаданных
//                - СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор
//                    объекта метаданных конфигурации или расширения конфигурации.
//  ИдентификаторыКомандПечати - Массив  - Массив идентификаторов печатных форм
//  ВсеФормы - Булево, признак установленной отметки подписания всех возможных печатных форм для объекта учета в настройках этапа шаблона процесса
//
Функция СписокПечатныхФормОбъектаУчета(ИдентификаторДокумента, ИдентификаторыКомандПечати, ВсеФормы) Экспорт
	
	Результат = Новый СписокЗначений;
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		Возврат Результат;
	КонецЕсли;

	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");

	Если НЕ ОбщегоНазначения.СсылкаСуществует(ИдентификаторДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	
	ИсточникиКомандПечати = МодульУправлениеПечатью.ИсточникиКомандПечати();
	Если ИсточникиКомандПечати.Найти(ОбъектМетаданных) = Неопределено Тогда
		КомандыПечати = Новый Массив;
	Иначе
		КомандыПечати = МодульУправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
	КонецЕсли;
	
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		// для внешних печатных форм добавляем уникальный идентификатор
		Если КомандаПечати.МенеджерПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
			КомандаПечати.Идентификатор = КомандаПечати.Идентификатор + КомандаПечати.УникальныйИдентификатор;
		КонецЕсли;
		
		НоваяКоманда = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяКоманда, КомандаПечати);
		НоваяКоманда.Значение = КомандаПечати.Идентификатор;
		
		ИндексКомандыПечати = ИдентификаторыКомандПечати.Найти(КомандаПечати.Идентификатор);
		
		Если ВсеФормы ИЛИ ИндексКомандыПечати <> Неопределено Тогда
			НоваяКоманда.Пометка = Истина;
		КонецЕсли;
		
		Если ИндексКомандыПечати <> Неопределено Тогда
			ИдентификаторыКомандПечати.Удалить(ИндексКомандыПечати);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

// Возвращает список значений, содержащий перечень печатных форм объекта учета для определенного этапа процесса обработки документов
//
// Параметры:
//  ШаблонПроцесса - СправочникСсылка.ШаблоныПроцессов - Ссылка на шаблон процесса
//  ИдентификаторЭтапа - Уникальный идентификатор - идентификатор этапа шаблона процесса
//
Функция ПервичныеДокументыПоЭтапуШаблона(ШаблонПроцесса, ИдентификаторЭтапа) Экспорт
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныПроцессовЭтапы.Этап КАК Этап,
	               |	ШаблоныПроцессовЭтапы.ИдентификаторыКомандПечатиСоШтампом КАК ИдентификаторыКомандПечатиСоШтампом,
	               |	ШаблоныПроцессовЭтапы.ВключатьВШтампВизуализацииЭП КАК ВключатьВШтампВизуализацииЭП
	               |ИЗ
	               |	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	               |ГДЕ
	               |	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = &ИдентификаторЭтапа
	               |	И ШаблоныПроцессовЭтапы.Ссылка = &ШаблонПроцесса";
	Запрос.УстановитьПараметр("ШаблонПроцесса", ШаблонПроцесса);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИдентификаторДокумента = ШаблонПроцесса.ИдентификаторДокумента;
	Результат = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		ИдентификаторыКомандПечатиСоШтампом = СтрРазделить(Выборка.ИдентификаторыКомандПечатиСоШтампом, ",", Ложь);
		ВсеФормы = ПустаяСтрока(ИдентификаторыКомандПечатиСоШтампом) И Выборка.ВключатьВШтампВизуализацииЭП;

		ПечатныеФормыДокументовПоИдентификаторам = СписокПечатныхФормОбъектаУчета(ИдентификаторДокумента, ИдентификаторыКомандПечатиСоШтампом, ВсеФормы);
		ОбщегоНазначенияКлиентСервер.ДополнитьСписок(Результат, ПечатныеФормыДокументовПоИдентификаторам);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Возвращает заполненную структуру с данными описания подписываемых данных
//
// Параметры:
//   ОбъектУчета - ОпределяемыйТип.ПредметПроцессаОбработкиДокументов - Ссылка на предмет процесса обработки
//
Функция ЗначенияРеквизитовОбъектаУчета(ОбъектУчета) Экспорт
	Результат = Новый Структура;
	
	ПроцессыОбработкиДокументовПереопределяемый.СтруктураРеквизитовОбъектаУчета(Результат);
	
	ПроцессыОбработкиДокументовПереопределяемый.ЗаполнитьЗначенияРеквизитовОбъектаУчета(ОбъектУчета, Результат);
	
	Возврат Результат;
КонецФункции

// Возвращает истину, если есть завершенный электронный документ для документа учета и идентификатора печатной формы
//
// Параметры:
//   ДокументУчета - ОпределяемыйТип.ПредметПроцессаОбработкиДокументов - Ссылка на предмет процесса обработки
//   ИдентификаторПечатнойФормы - Строка - Идентификатор команды печати, соответствующей первичному документу, если не заполнен, то факт завершения подписания определяется для любой печатной формы
//
Функция ДляПечатнойФормыДокументаУчетаЕстьЗавершенныйВнутреннийЭД(ДокументУчета, ИдентификаторПечатнойФормы = "") Экспорт
	Результат = Ложь;

	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ИдентификаторПечатнойФормы) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
		               |	ЗадачаПоОбработкеДокумента.Шаблон КАК Шаблон
		               |ИЗ
		               |	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
		               |ГДЕ
		               |	ЗадачаПоОбработкеДокумента.Предмет = &Ссылка
		               |	И НЕ ЗадачаПоОбработкеДокумента.Выполнена
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
		               |	ЗадачаПоОбработкеДокумента.Шаблон КАК Шаблон
		               |ИЗ
		               |	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
		               |ГДЕ
		               |	ЗадачаПоОбработкеДокумента.Предмет = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ДокументУчета);
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		ЕстьНеВыполненнаяЗадача = Ложь;
		Если НЕ РезультатыЗапроса[0].Пустой() Тогда
			
			Выборка = РезультатыЗапроса[0].Выбрать();
			Если Выборка.Следующий() Тогда
				ЕстьНеВыполненнаяЗадача = Истина;
			КонецЕсли;	
		КонецЕсли;
		
        ЕстьЗадачи = Ложь;
		Если НЕ РезультатыЗапроса[1].Пустой() Тогда
			
			ВсеЗадачи = РезультатыЗапроса[1].Выгрузить();
			Если ВсеЗадачи.Количество() > 0 Тогда
                ЕстьЗадачи = Истина;
			КонецЕсли;
		КонецЕсли;	
		
		Если ЕстьЗадачи И НЕ ЕстьНеВыполненнаяЗадача Тогда
			ШаблонПОД = ВсеЗадачи[0].Шаблон;
			
			Если ЗначениеЗаполнено(ШаблонПОД) Тогда
				ЗапросДляШаблона = Новый Запрос;
				ЗапросДляШаблона.Текст = "ВЫБРАТЬ
				                         |	ШаблоныПроцессовЭтапы.Ссылка КАК Ссылка,
				                         |	ШаблоныПроцессовЭтапы.ИдентификаторыКомандПечатиСоШтампом КАК ИдентификаторыКомандПечатиСоШтампом,
				                         |	ШаблоныПроцессовЭтапы.ВключатьВШтампВизуализацииЭП КАК ВключатьВШтампВизуализацииЭП
				                         |ИЗ
				                         |	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
				                         |ГДЕ
				                         |	ШаблоныПроцессовЭтапы.Ссылка = &Шаблон";
				ЗапросДляШаблона.УстановитьПараметр("Шаблон", ШаблонПОД);
				ДанныеЭтаповШаблона = ЗапросДляШаблона.Выполнить().Выгрузить();
				ВсеПФ = Истина;
				МассивИдентификаторовПФ = Новый Массив;
				Для Каждого ТекСтрока Из ДанныеЭтаповШаблона Цикл
					Если НЕ ТекСтрока.ВключатьВШтампВизуализацииЭП Тогда
						ВсеПФ = Ложь;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ТекСтрока.ИдентификаторыКомандПечатиСоШтампом) Тогда
						ИдентификаторыПФ = СтрРазделить(ТекСтрока.ИдентификаторыКомандПечатиСоШтампом, ",", Ложь);
						ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивИдентификаторовПФ, ИдентификаторыПФ, Истина);
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;
			
			Если ВсеПФ И МассивИдентификаторовПФ.Количество() = 0 Тогда
				Результат = Истина;
			Иначе	
				Для Каждого ТекИдПФ Из МассивИдентификаторовПФ Цикл
					Если СокрЛП(ТекИдПФ) = СокрЛП(ИдентификаторПечатнойФормы) Тогда
						Результат = Истина;
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка
		               |ИЗ
		               |	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
		               |ГДЕ
		               |	ЗадачаПоОбработкеДокумента.Предмет = &Ссылка
		               |	И НЕ ЗадачаПоОбработкеДокумента.Выполнена
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка
		               |ИЗ
		               |	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
		               |ГДЕ
		               |	ЗадачаПоОбработкеДокумента.Предмет = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ДокументУчета);
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		ЕстьНеВыполненнаяЗадача = Ложь;
		Если НЕ РезультатыЗапроса[0].Пустой() Тогда
			
			Выборка = РезультатыЗапроса[0].Выбрать();
			Если Выборка.Следующий() Тогда
				ЕстьНеВыполненнаяЗадача = Истина;
			КонецЕсли;	
		КонецЕсли;
		
        ЕстьЗадачи = Ложь;
		Если НЕ РезультатыЗапроса[1].Пустой() Тогда
			
			ВсеЗадачи = РезультатыЗапроса[1].Выгрузить();
			Если ВсеЗадачи.Количество() > 0 Тогда
                ЕстьЗадачи = Истина;
			КонецЕсли;
		КонецЕсли;	
		
		Если ЕстьЗадачи И НЕ ЕстьНеВыполненнаяЗадача Тогда
			Результат = Истина;
		КонецЕсли;	
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;
КонецФункции

// Возвращает Истина, если для пользователя есть подпись и в настройках этапа шаблона указана печатная форма соответствующего макета
//
// Параметры:
//   Документ - ОпределяемыйТип.ПредметПроцессаОбработкиДокументов - Ссылка на предмет процесса обработки
//   ИдентификаторПечатнойФормы - Строка - Идентификатор команды печати, соответствующей первичному документу
//   Пользователь - ссылка на элемент справочника "Пользователи"
//
Функция НаличиеПодписиПользователяДляМакетаПечатнойФормыДокумента(Документ, ИдентификаторПечатнойФормы, Пользователь) Экспорт
	Результат = Ложь;
	
	Шаблон = ШаблонИСтатусДокумента(Документ).Шаблон;
	Если Шаблон = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ЭлектронныеПодписиДляШтампа = УстановленныеПодписиДляШтампа(Документ, Шаблон, ИдентификаторПечатнойФормы);

	ПользователиУстановившиеПодпись = Новый ТаблицаЗначений;
	ПользователиУстановившиеПодпись.Колонки.Добавить("УстановившийПодпись", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Для Каждого ТекСтрока Из ЭлектронныеПодписиДляШтампа Цикл
		НоваяСтрока = ПользователиУстановившиеПодпись.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("УстановившийПодпись", Пользователь);
	НайденныеСтроки = ПользователиУстановившиеПодпись.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ДанныеФорматаПервичногоДокументаВСтрокуXML(Документ, ИдентификаторПечатнойФормы, Данные) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ПервичныйДокумент");
	ЗаписьXML.ЗаписатьАтрибут("Идентификатор", ИдентификаторПечатнойФормы);
	ЗаписьXML.ЗаписатьАтрибут("ТипДокумента",
		СтрРазделить(ОбщегоНазначения.СтроковоеПредставлениеТипа(ТипЗнч(Документ)), ".")[1]);
	
	ТаблицуЗначенийВЗаписьXML(Данные, Данные["Шапка"], Истина, ЗаписьXML);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

Функция КоллекцияДополнительныхРеквизитов() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор");
	Результат.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Значение");
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьЗадачуПользователя(Задача, ПрерватьВыполнение = Ложь, РезультатВыполнения = "",
	ЗадачаОбъект = Неопределено, Исполнитель = Неопределено) Экспорт
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Задача) Тогда
		ЗаблокироватьЗадачи(Задача);
		ЗадачаОбъект = Задача.ПолучитьОбъект();
	Иначе
		ЗаблокироватьЗадачи(Задача.Ссылка);
		ЗадачаОбъект = Задача;
	КонецЕсли;
	
	ТекущийИсполнитель = ?(ЗначениеЗаполнено(Исполнитель), Исполнитель, Пользователи.АвторизованныйПользователь());
	
	Если ЗадачаОбъект.Выполнена Тогда
		ВызватьИсключение НСтр("ru = 'Задача уже была выполнена ранее.'");
	ИначеЕсли НЕ ПрерватьВыполнение
		И ЗадачаОбъект.ИсполнительНазначенПринудительно
		И НЕ ЗадачаОбъект.Исполнитель = ТекущийИсполнитель Тогда
		ВызватьИсключение НСтр("ru = 'Задача была назначена другому исполнителю.'");
	ИначеЕсли НЕ ПрерватьВыполнение
		И ЗадачаОбъект.ПринятаКИсполнению
		И НЕ ЗадачаОбъект.Исполнитель = ТекущийИсполнитель Тогда
		ВызватьИсключение НСтр("ru = 'Задача принята к исполнению другим исполнителем.'");
	ИначеЕсли ЗадачаОбъект.ПометкаУдаления Тогда
		ВызватьИсключение НСтр("ru = 'Задача помечена на удаление.'");
	ИначеЕсли НЕ ПрерватьВыполнение
		И НЕ ЗначениеЗаполнено(ЗадачаОбъект.Исполнитель) Тогда
		ЗадачаОбъект.Исполнитель = ТекущийИсполнитель;
	КонецЕсли;
	
	Если НЕ ПрерватьВыполнение Тогда
		// При прерывании выполнения результат выполнения не заполняется (интерфейсное поле "Описание выполнения").
		// Поэтому очищать описание для прерванной задачи не требуется.
		ЗадачаОбъект.РезультатВыполнения = РезультатВыполнения;
	КонецЕсли;
	
	ЗадачаОбъект.Выполнена = Истина;
	ЗадачаОбъект.Прервана = ПрерватьВыполнение;
	ЗадачаОбъект.Записать();
	
КонецПроцедуры

Процедура РеквизитыДляПодписиМассиваДокументов(ДанныеДокументов) Экспорт
	
	НастройкаПодписиСсылочныхДанных = РегистрыСведений.НастройкаПодписиСсылочныхДанных.ПолучитьДанныеРегистра();
	
	//необходимо свернуть массив структур по полям "Шаблон" и "ИдентификаторЭтапа"
	ДанныеДляЗапросов = Новый ТаблицаЗначений;
	ДанныеДляЗапросов.Колонки.Добавить("Шаблон");
	ДанныеДляЗапросов.Колонки.Добавить("ИдентификаторЭтапа");
	ДанныеДляЗапросов.Колонки.Добавить("ОбособленнаяЗонаОтветственности");
	Для Каждого ЭлементМассива Из ДанныеДокументов Цикл
		ЗаполнитьЗначенияСвойств(ДанныеДляЗапросов.Добавить(), ЭлементМассива);
	КонецЦикла;
	ДанныеДляЗапросов.Свернуть("Шаблон, ИдентификаторЭтапа, ОбособленнаяЗонаОтветственности");
	ДанныеДляЗапросов.Колонки.Добавить("КонтролируемыеРеквизиты");
	
	Для Каждого ДанныеДляЗапроса Из ДанныеДляЗапросов Цикл
		
		Запрос = Новый Запрос;
		
		Если ДанныеДляЗапроса.ОбособленнаяЗонаОтветственности Тогда
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ШаблоныПроцессовОтветственностьЗаРеквизиты.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
			|	ШаблоныПроцессовОтветственностьЗаРеквизиты.ИмяРеквизита КАК ИмяРеквизита,
			|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
			|ИЗ
			|	Справочник.ШаблоныПроцессов.ОтветственностьЗаРеквизиты КАК ШаблоныПроцессовОтветственностьЗаРеквизиты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
			|		ПО ШаблоныПроцессовОтветственностьЗаРеквизиты.Ссылка = ШаблоныПроцессовЭтапы.Ссылка
			|			И ШаблоныПроцессовОтветственностьЗаРеквизиты.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа
			|ГДЕ
			|	ШаблоныПроцессовОтветственностьЗаРеквизиты.Ссылка = &Шаблон
			|	И ШаблоныПроцессовОтветственностьЗаРеквизиты.ИдентификаторЭтапа = &ИдентификаторЭтапа
			|
			|УПОРЯДОЧИТЬ ПО
			|	ШаблоныПроцессовЭтапы.Порядок,
			|	ИмяТабличнойЧасти,
			|	ИмяРеквизита";
			
		Иначе
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ШаблоныПроцессовОтветственностьЗаРеквизиты.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
			|	ШаблоныПроцессовОтветственностьЗаРеквизиты.ИмяРеквизита КАК ИмяРеквизита,
			|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
			|ИЗ
			|	Справочник.ШаблоныПроцессов.ОтветственностьЗаРеквизиты КАК ШаблоныПроцессовОтветственностьЗаРеквизиты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
			|		ПО ШаблоныПроцессовОтветственностьЗаРеквизиты.Ссылка = ШаблоныПроцессовЭтапы.Ссылка
			|			И ШаблоныПроцессовОтветственностьЗаРеквизиты.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы1
			|		ПО (ШаблоныПроцессовЭтапы.Ссылка = ШаблоныПроцессовЭтапы1.Ссылка)
			|			И (ШаблоныПроцессовЭтапы1.ИдентификаторЭтапа = &ИдентификаторЭтапа)
			|ГДЕ
			|	ШаблоныПроцессовОтветственностьЗаРеквизиты.Ссылка = &Шаблон
			|	И ((ШаблоныПроцессовЭтапы.Порядок < ШаблоныПроцессовЭтапы1.Порядок И ШаблоныПроцессовОтветственностьЗаРеквизиты.ИдентификаторЭтапа В (&ИдентификаторыПредшественников))
			|	И НЕ ШаблоныПроцессовЭтапы.ОбособленнаяЗонаОтветственности
			|			ИЛИ ШаблоныПроцессовОтветственностьЗаРеквизиты.ИдентификаторЭтапа = &ИдентификаторЭтапа)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ШаблоныПроцессовЭтапы.Порядок,
			|	ИмяТабличнойЧасти,
			|	ИмяРеквизита";
			
			ИдентификаторыПредшественников = ПолучитьИдентификаторыПредшественниковПоИдентификатору(ДанныеДляЗапроса.Шаблон, ДанныеДляЗапроса.ИдентификаторЭтапа);
			Запрос.УстановитьПараметр("ИдентификаторыПредшественников", ИдентификаторыПредшественников);
		
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Шаблон", ДанныеДляЗапроса.Шаблон);
		Запрос.УстановитьПараметр("ИдентификаторЭтапа", ДанныеДляЗапроса.ИдентификаторЭтапа);
		
		ДанныеДляЗапроса.КонтролируемыеРеквизиты = Запрос.Выполнить().Выгрузить();
		
	КонецЦикла;
	
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
		ФайлыДляПодписи = Новый Массив;
		
		Отбор = Новый Структура("Шаблон, ИдентификаторЭтапа", ДанныеДокумента.Шаблон, ДанныеДокумента.ИдентификаторЭтапа);
		Строки = ДанныеДляЗапросов.НайтиСтроки(Отбор);
		ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаПоСоставу(
			ДанныеДокумента.Документ,
			Строки[0].КонтролируемыеРеквизиты.Скопировать(),
			ДанныеДокумента.ДополнительныеПараметры,
			НастройкаПодписиСсылочныхДанных,
			,
			ФайлыДляПодписи);

		Если Константы.ИспользоватьПроверкуПодписываемыхДанныхЧерезХэш.Получить() 
			И Строки.Количество() > 0 Тогда
			СжатиеДанных = Новый СжатиеДанных(9);
			ХранилищеКонтролируемыхРеквизитов = Новый ХранилищеЗначения(Строки[0].КонтролируемыеРеквизиты.Скопировать(), СжатиеДанных);
			ХранилищеНастроекПодписыСсылочныхДанных = Новый ХранилищеЗначения(НастройкаПодписиСсылочныхДанных, СжатиеДанных);
			ДанныеДокумента.Вставить("ПроверкаХэшКонтролируемыеРеквизиты", ХранилищеКонтролируемыхРеквизитов);
			ДанныеДокумента.Вставить("ПроверкаХэшНастройкаПодписиСсылочныхДанных", ХранилищеНастроекПодписыСсылочныхДанных); 
		КонецЕсли;
		
		ДанныеДокумента.Вставить("ЗначенияРеквизитов", ЗначенияРеквизитов);
		ДанныеДокумента.Вставить("ФайлыДляПодписи", ФайлыДляПодписи);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗначенияРеквизитовОбъектаПоСоставу(Ссылка, КонтролируемыеРеквизиты, Параметры,
		НастройкаХранения = Неопределено, СвойстваПодписи = Неопределено, ФайлыДляПодписи) Экспорт
	
	ЗначенияРеквизитов = Новый Структура;
	
	// Если в составе реквизитов передан номер строки табличной части, то считывание значений осуществляется построчно
	Если КонтролируемыеРеквизиты.Колонки.Найти("НомерСтроки") = Неопределено Тогда
		КонтролируемыеРеквизиты.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(9));
	КонецЕсли;
	
	ЗначенияПереопределенныхРеквизитов = Новый Структура;
	ПроцессыОбработкиДокументовПереопределяемый.ЗначенияРеквизитовОбъектаПоСоставу(Ссылка, КонтролируемыеРеквизиты,
		НастройкаХранения, ЗначенияПереопределенныхРеквизитов, Параметры, СвойстваПодписи, ФайлыДляПодписи);
	
	ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти", "");
	
	// Если известны составы свойств, то все реквизиты (с учетом разыменовки полей) можно получить одним запросом,
	// при этом для имен полей будут использоваться уникальные идентификаторы для обозначения уровня вложенности
	Если НастройкаХранения = Неопределено Тогда
		
		ТаблицаИменРеквизитов = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "Порядок, ИмяРеквизита, СоставСвойствРеквизита");
		ТаблицаИменРеквизитов.Сортировать("Порядок, ИмяРеквизита");
		
		МетаданныеОбъекта = Ссылка.Метаданные();
		СтандартныеРеквизиты = МетаданныеОбъекта.СтандартныеРеквизиты;
		
		РазделителиПсевдонимовУровнейВложенности = Новый Массив;
		МассивПолейЗапроса = Новый Массив;
		
		Для Каждого ТекРеквизит Из ТаблицаИменРеквизитов Цикл
			Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта(ТекРеквизит.ИмяРеквизита, МетаданныеОбъекта)
				И Не ОбщегоНазначения.ЭтоСтандартныйРеквизит(СтандартныеРеквизиты, ТекРеквизит.ИмяРеквизита) Тогда
				Продолжить;
			КонецЕсли;
			ПолучитьПоляЗапросаПоСоставуСвойств(
				МассивПолейЗапроса,
				ТекРеквизит.ИмяРеквизита,
				ТекРеквизит.ИмяРеквизита,
				ТекРеквизит.СоставСвойствРеквизита,
				РазделителиПсевдонимовУровнейВложенности,
				1);

			РазыменоватьПоляЗапросаДляРеквизитовСоставногоТипа(МассивПолейЗапроса, МетаданныеОбъекта, Ссылка, ТекРеквизит);
				
		КонецЦикла;
		
		Если МассивПолейЗапроса.ВГраница() > -1 Тогда
			
			ТекстПолейЗапроса = СтрСоединить(МассивПолейЗапроса, "," + Символы.ПС + Символы.Таб);
			
			ПолноеИмяОбъектаМетаданных = МетаданныеОбъекта.ПолноеИмя(); 
			
			ТекстЗапроса =
			"ВЫБРАТЬ
			|&ТекстПолейЗапроса
			|ИЗ
			|	&ПолноеИмяОбъектаМетаданных КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка = &Ссылка";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПолейЗапроса", ТекстПолейЗапроса);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяОбъектаМетаданных", ПолноеИмяОбъектаМетаданных);
			
			// Выполнение запроса.
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Запрос.Текст = ТекстЗапроса;
			
			Если ЗначенияПереопределенныхРеквизитов.Свойство("ПоляШапкиДляЗамены") Тогда
				Для Каждого Поле Из ЗначенияПереопределенныхРеквизитов.ПоляШапкиДляЗамены Цикл
					ИмяПоля = Поле.Ключ;
					ИмяПараметра = СтрЗаменить(ИмяПоля, ".", "_");
					Запрос.Текст = СтрЗаменить(Запрос.Текст, ИмяПоля, "&" + ИмяПараметра);
					Запрос.УстановитьПараметр(ИмяПараметра, Поле.Значение);
				КонецЦикла;
			КонецЕсли;
			
			Результат = Запрос.Выполнить();
			КолонкиРезультата = Результат.Колонки;
			
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			
			Для Каждого Колонка Из КолонкиРезультата Цикл
				ИмяПсевдонима = Колонка.Имя;
				МассивИменУровнейВложенности = Новый Массив;
				Для Каждого Разделитель Из РазделителиПсевдонимовУровнейВложенности Цикл
					ПозицияРазделителя = СтрНайти(ИмяПсевдонима, Разделитель);
					Если ПозицияРазделителя = 0 Тогда
						Прервать;
					Иначе
						МассивИменУровнейВложенности.Добавить(Лев(ИмяПсевдонима, ПозицияРазделителя - 1));
						ИмяПсевдонима = Сред(ИмяПсевдонима, ПозицияРазделителя + СтрДлина(Разделитель));
					КонецЕсли;
				КонецЦикла;
				МассивИменУровнейВложенности.Добавить(ИмяПсевдонима);
				ВставитьЗначениеВСтруктуруСУчетомВложенности(ЗначенияРеквизитов, Выборка[Колонка.Имя], МассивИменУровнейВложенности);
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ТаблицаИменРеквизитов = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "Порядок, ИмяРеквизита");
		ТаблицаИменРеквизитов.Сортировать("Порядок, ИмяРеквизита");
		
		МассивРеквизитов = Новый Массив;
		Для Каждого ТекРеквизит Из ТаблицаИменРеквизитов Цикл
			
			// Если реквизит переопределяемый, то он пропукается из стандартной обработки
			Если ЗначенияПереопределенныхРеквизитов.Свойство(ТекРеквизит.ИмяРеквизита) Тогда
				Продолжить;
			КонецЕсли;
			
			МассивРеквизитов.Добавить(ТекРеквизит.ИмяРеквизита);
		КонецЦикла;
		
		Если МассивРеквизитов.ВГраница() > -1 Тогда
			РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, МассивРеквизитов);
			Для Каждого РеквизитОбъекта Из РеквизитыОбъекта Цикл
				Если РеквизитОбъекта.Значение <> Неопределено
					И ПроцессыОбработкиДокументовПовтИсп.ОписаниеТиповСРазыменовкой().СодержитТип(ТипЗнч(РеквизитОбъекта.Значение)) Тогда
					ЗначенияРеквизитов.Вставить(РеквизитОбъекта.Ключ, ЗначенияРеквизитовОбъектаСогласноНастройке(РеквизитОбъекта.Значение, НастройкаХранения));
				Иначе
					ЗначенияРеквизитов.Вставить(РеквизитОбъекта.Ключ, РеквизитОбъекта.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаТЧ = КонтролируемыеРеквизиты.Скопировать(,"Порядок, ИмяТабличнойЧасти");
	ТаблицаТЧ.Сортировать("Порядок, ИмяТабличнойЧасти");
	ТаблицаТЧ.Свернуть("ИмяТабличнойЧасти");
	МассивТЧ = ТаблицаТЧ.ВыгрузитьКолонку("ИмяТабличнойЧасти");
	
	Для Каждого ТекТЧ Из МассивТЧ Цикл
		
		Если ПустаяСтрока(ТекТЧ) Тогда
			Продолжить;
		КонецЕсли;
		
		// Если табличная часть переопределяемая, то она пропукается из стандартной обработки
		Если ЗначенияПереопределенныхРеквизитов.Свойство(ТекТЧ) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти", ТекТЧ);
		
		Если НастройкаХранения = Неопределено Тогда
			
			ТаблицаИменРеквизитов = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "НомерСтроки, Порядок, ИмяРеквизита, СоставСвойствРеквизита");
			ТаблицаИменРеквизитов.Сортировать("НомерСтроки, Порядок, ИмяРеквизита");
			ТаблицаИменРеквизитов.Индексы.Добавить("НомерСтроки, ИмяРеквизита");
			
			ТабличнаяЧастьМетаданные = МетаданныеОбъекта.ТабличныеЧасти[ТекТЧ];
			
			// Для исключения многократной проверки существования реквизитов табличной части закэшируем существующие реквизиты в структуре
			СуществующиеРеквизитыТЧ = Новый Структура;
			
			НомераСтрокИспользующихПоле = Новый Структура;
			НомераСтрок = Неопределено;
			
			РазделителиПсевдонимовУровнейВложенности = Новый Массив;
			
			МассивПолейЗапроса = Новый Массив;
			МассивПолейЗапроса.Добавить("НомерСтроки КАК НомерСтроки");
			
			Для Каждого СтрокаИменРеквизитов Из ТаблицаИменРеквизитов Цикл
				
				Если ПустаяСтрока(СтрокаИменРеквизитов.ИмяРеквизита) Тогда
					Продолжить;
				ИначеЕсли СуществующиеРеквизитыТЧ.Свойство(СтрокаИменРеквизитов.ИмяРеквизита) = Ложь Тогда
					Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта(СтрокаИменРеквизитов.ИмяРеквизита, ТабличнаяЧастьМетаданные) Тогда
						Продолжить;
					Иначе
						СуществующиеРеквизитыТЧ.Вставить(СтрокаИменРеквизитов.ИмяРеквизита, Истина);
					КонецЕсли;
				КонецЕсли;
				
				НачальныйИндекс = МассивПолейЗапроса.ВГраница();
				
				ПолучитьПоляЗапросаПоСоставуСвойств(
					МассивПолейЗапроса,
					СтрокаИменРеквизитов.ИмяРеквизита,
					СтрокаИменРеквизитов.ИмяРеквизита,
					СтрокаИменРеквизитов.СоставСвойствРеквизита,
					РазделителиПсевдонимовУровнейВложенности,
					1);
				
				Для Индекс = НачальныйИндекс + 1 по МассивПолейЗапроса.ВГраница() Цикл
					Псевдноним = Сред(МассивПолейЗапроса[Индекс], СтрНайти(МассивПолейЗапроса[Индекс], " КАК ") + 5);
					Если НЕ НомераСтрокИспользующихПоле.Свойство(Псевдноним, НомераСтрок) Тогда
						НомераСтрок = Новый Соответствие;
					КонецЕсли;
					НомераСтрок.Вставить(СтрокаИменРеквизитов.НомерСтроки, Истина);
					НомераСтрокИспользующихПоле.Вставить(Псевдноним, НомераСтрок);
				КонецЦикла;
				
			КонецЦикла;
			
			Если МассивПолейЗапроса.ВГраница() < 1 Тогда
				Продолжить;
			КонецЕсли;
			
			МассивПолейЗапроса = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивПолейЗапроса);
			ТекстПолейЗапроса = Символы.Таб + СтрСоединить(МассивПолейЗапроса, "," + Символы.ПС + Символы.Таб);
			
			// Среди реквизитов ТЧ необходимо найти реквизиты составного типа, для которых требуется разыменовка,
			// в тексте запроса обращение к их свойствам будет реализовано через функцию "ВЫРАЗИТЬ()"
			МассивРеквизитовТребующихРазыменовки = Новый Массив;
			// Также следует найти ссылочные реквизиты несоставного типа для проверки существования их свойств
			ТипыРеквизитовНесоставногоТипа = Новый Соответствие;
			Для Каждого РеквизитТЧ Из СуществующиеРеквизитыТЧ Цикл
				Если СтрНайти(ТекстПолейЗапроса, Символы.Таб + РеквизитТЧ.Ключ + ".") > 0 Тогда
					ТипыРеквизита = ТабличнаяЧастьМетаданные.Реквизиты[РеквизитТЧ.Ключ].Тип.Типы();
					Если ТипыРеквизита.Количество() = 1 Тогда
						ТипыРеквизитовНесоставногоТипа.Вставить(РеквизитТЧ.Ключ, ТипыРеквизита[0]);
					//Если реквизит не составного типа, то его не требуется разыменовывать через "ВЫРАЗИТЬ()"
					ИначеЕсли ТипыРеквизита.Количество() > 1 Тогда
						МассивРеквизитовТребующихРазыменовки.Добавить(РеквизитТЧ.Ключ);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			МассивРеквизитовТребующихРазыменовкиСтрокой = СтрСоединить(МассивРеквизитовТребующихРазыменовки, ",");
			ТЧСКолонкамиДляРазыменовки = Ссылка[ТекТЧ].Выгрузить(, МассивРеквизитовТребующихРазыменовкиСтрокой);
			
			// Получение списка типов реквизитов, имеющихся в табличной части
			// Для сохранения типов используется соответствие, где ключ - имя реквизита, а значение - массив встречающихся типов
			ТипыРеквизитовСоставногоТипа = Новый Соответствие;
			
			Для Каждого СтрокаТЧ Из ТЧСКолонкамиДляРазыменовки Цикл
				
				Для Каждого ИмяРеквизита Из МассивРеквизитовТребующихРазыменовки Цикл
					
					ТипРеквизита = ТипЗнч(СтрокаТЧ[ИмяРеквизита]);
					
					МассивТипов = ТипыРеквизитовСоставногоТипа.Получить(ИмяРеквизита);
					
					Если МассивТипов = Неопределено Тогда
						ТипыРеквизитовСоставногоТипа.Вставить(ИмяРеквизита, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипРеквизита));
					ИначеЕсли МассивТипов.Найти(ТипРеквизита) = Неопределено Тогда
						МассивТипов.Добавить(ТипРеквизита);
						ТипыРеквизитовСоставногоТипа.Вставить(ИмяРеквизита, МассивТипов);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
			// Для ссылочных несоставных полей следует проверить наличие свойств
			Для Каждого РеквизитНесоставногоТипа Из ТипыРеквизитовНесоставногоТипа Цикл
				
				МетаданныеТипа = Метаданные.НайтиПоТипу(РеквизитНесоставногоТипа.Значение);
				СтандартныеРеквизитыТипа = МетаданныеТипа.СтандартныеРеквизиты;
				
				СтрокаИменРеквизитов = ТаблицаИменРеквизитов.Найти(РеквизитНесоставногоТипа.Ключ, "ИмяРеквизита");
				
				Для Каждого Свойство Из СтрокаИменРеквизитов.СоставСвойствРеквизита Цикл
					
					Если ТипЗнч(Свойство) = Тип("Структура") Тогда
						Для Каждого КлючЗначение Из Свойство Цикл
							ИмяСвойства = КлючЗначение.Ключ;
						КонецЦикла;
					Иначе
						ИмяСвойства = Свойство;
					КонецЕсли;
						
					Если ОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяСвойства, МетаданныеТипа)
						ИЛИ ОбщегоНазначения.ЭтоСтандартныйРеквизит(СтандартныеРеквизитыТипа, ИмяСвойства) Тогда
						Продолжить;
					КонецЕсли;
					
					// Если этого свойства нет - надо удалить поля из запроса
					КоличествоЭлементовКоллекции = МассивПолейЗапроса.Количество();
					Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
						Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
						ПолеЗапроса = МассивПолейЗапроса[Индекс];
						Если СтрНайти(ПолеЗапроса, РеквизитНесоставногоТипа.Ключ + "." + ИмяСвойства) = 1 Тогда
							МассивПолейЗапроса.Удалить(Индекс);
						КонецЕсли;
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;
			
			Для Каждого ТипыРеквизитаСоставногоТипа Из ТипыРеквизитовСоставногоТипа Цикл
				
				ФрагментыТекстаПоляЗапросаПоМетаданнымТипов = Новый Соответствие;
				
				// Подготовка текста замены для полей запроса
				Для Каждого ТипРеквизита Из ТипыРеквизитаСоставногоТипа.Значение Цикл
					Если ТипРеквизита = Тип("Неопределено") Тогда
						// Если тип всего один и он равен Неопределено, то поле запроса следует заменить на НЕОПРЕДЕЛЕНО КАК ...
						Если ТипыРеквизитаСоставногоТипа.Значение.Количество() = 1 Тогда
							ШаблонЗамены = "НЕОПРЕДЕЛЕНО";
							ФрагментыТекстаПоляЗапросаПоМетаданнымТипов.Вставить(Неопределено, ШаблонЗамены);
						КонецЕсли;
					ИначеЕсли ПроцессыОбработкиДокументовПовтИсп.ОписаниеТиповСРазыменовкой().СодержитТип(ТипРеквизита) Тогда
						ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипРеквизита);
						ИмяОбъектаМетаданных = ОбъектМетаданных.ПолноеИмя();
						
						ШаблонЗамены = "		КОГДА "+ТипыРеквизитаСоставногоТипа.Ключ+" ССЫЛКА "+ИмяОбъектаМетаданных+"
							|			ТОГДА ВЫРАЗИТЬ("+ТипыРеквизитаСоставногоТипа.Ключ+" КАК "+ИмяОбъектаМетаданных+").%ИмяСвойства%";
						
						ФрагментыТекстаПоляЗапросаПоМетаданнымТипов.Вставить(ОбъектМетаданных, ШаблонЗамены);
					КонецЕсли;
				КонецЦикла;
				
				ПолеПоиска = ТипыРеквизитаСоставногоТипа.Ключ + ".";
				
				Для Индекс = 0 По МассивПолейЗапроса.ВГраница() Цикл
					
					ПолеЗапроса = МассивПолейЗапроса[Индекс];
					
					Если НЕ СтрНачинаетсяС(ПолеЗапроса, ПолеПоиска) Тогда
						Продолжить;
					КонецЕсли;
					
					ПоложениеСловаКАК = СтрНайти(ПолеЗапроса, " КАК ");
					
					ИмяСвойства = Сред(ПолеЗапроса, СтрДлина(ПолеПоиска) + 1, ПоложениеСловаКАК - СтрДлина(ПолеПоиска) - 1);
					
					// Проверка наличия свойства первого уровня у типа: если свойство отсутствует у объекта метаданных,
					// то секцию "КОГДА ТОГДА ВЫРАЗИТЬ" для данного типа не надо включать в текст поля запроса
					ПоложениеТочки = СтрНайти(ИмяСвойства, ".");
					Если ПоложениеТочки > 0 Тогда
						ИмяСвойстваПервогоУровня = Лев(ИмяСвойства, СтрНайти(ИмяСвойства, ".") - 1);
					Иначе
						ИмяСвойстваПервогоУровня = ИмяСвойства;
					КонецЕсли;
					
					ШаблонЗамены = "ВЫБОР";
					Для Каждого ФрагментТекстаПоляЗапросаПоМетаданнымТипа Из ФрагментыТекстаПоляЗапросаПоМетаданнымТипов Цикл
						
						Если ФрагментТекстаПоляЗапросаПоМетаданнымТипа.Ключ = Неопределено Тогда
							ШаблонЗамены = ФрагментТекстаПоляЗапросаПоМетаданнымТипа.Значение;
						Иначе
							
							МетаданныеТипа = ФрагментТекстаПоляЗапросаПоМетаданнымТипа.Ключ;
							
							СтандартныеРеквизитыТипа = МетаданныеТипа.СтандартныеРеквизиты;
							
							Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяСвойстваПервогоУровня, МетаданныеТипа)
								И Не ОбщегоНазначения.ЭтоСтандартныйРеквизит(СтандартныеРеквизитыТипа, ИмяСвойстваПервогоУровня) Тогда
								Продолжить;
							КонецЕсли;
							
							ШаблонЗамены = ШаблонЗамены + Символы.ПС + ФрагментТекстаПоляЗапросаПоМетаданнымТипа.Значение;
							
						КонецЕсли;
					КонецЦикла;
					
					Если ШаблонЗамены = "ВЫБОР" Тогда
						ШаблонЗамены = "НЕОПРЕДЕЛЕНО";
					ИначеЕсли ШаблонЗамены <> "НЕОПРЕДЕЛЕНО" Тогда
						ШаблонЗамены = ШаблонЗамены + "
							|	КОНЕЦ";
					КонецЕсли;
					
					ИмяПсевдонима = Сред(ПолеЗапроса, ПоложениеСловаКАК);
					
					ПолеЗапросаСРазыменовкой = СтрЗаменить(ШаблонЗамены, "%ИмяСвойства%", ИмяСвойства) + ИмяПсевдонима;
					
					МассивПолейЗапроса[Индекс] = ПолеЗапросаСРазыменовкой;
					
				КонецЦикла;
			КонецЦикла;
			
			ТекстПолейЗапроса = Символы.Таб + СтрСоединить(МассивПолейЗапроса, "," + Символы.ПС + Символы.Таб);
			
			ПолноеИмяОбъектаМетаданных = МетаданныеОбъекта.ПолноеИмя() + "." + ТекТЧ;
			
			ТекстЗапроса =
			"ВЫБРАТЬ
			|&ТекстПолейЗапроса
			|ИЗ
			|	&ПолноеИмяОбъектаМетаданных КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка = &Ссылка
			|УПОРЯДОЧИТЬ ПО
			|	Таблица.НомерСтроки";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПолейЗапроса", ТекстПолейЗапроса);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяОбъектаМетаданных", ПолноеИмяОбъектаМетаданных);
			
			// Выполнение запроса.
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Запрос.Текст = ТекстЗапроса;
			
			Результат = Запрос.Выполнить();
			КолонкиРезультата = Результат.Колонки;
			
			МассивСтруктурТЧ = Новый Массив;
			
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				СтруктураСтрокиТЧ = Новый Структура;
				
				Для Каждого Колонка Из КолонкиРезультата Цикл
					
					ИмяПсевдонима = Колонка.Имя;
					
					Если ИмяПсевдонима <> "НомерСтроки" И НомераСтрокИспользующихПоле[ИмяПсевдонима].Получить(Выборка.НомерСтроки) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					МассивИменУровнейВложенности = Новый Массив;
					Для Каждого Разделитель Из РазделителиПсевдонимовУровнейВложенности Цикл
						ПозицияРазделителя = СтрНайти(ИмяПсевдонима, Разделитель);
						Если ПозицияРазделителя = 0 Тогда
							Прервать;
						Иначе
							МассивИменУровнейВложенности.Добавить(Лев(ИмяПсевдонима, ПозицияРазделителя - 1));
							ИмяПсевдонима = Сред(ИмяПсевдонима, ПозицияРазделителя + СтрДлина(Разделитель));
						КонецЕсли;
					КонецЦикла;
					МассивИменУровнейВложенности.Добавить(ИмяПсевдонима);
					ВставитьЗначениеВСтруктуруСУчетомВложенности(СтруктураСтрокиТЧ, Выборка[Колонка.Имя], МассивИменУровнейВложенности);
					
				КонецЦикла;
				
				МассивСтруктурТЧ.Добавить(СтруктураСтрокиТЧ);
				
			КонецЦикла;
			
			ЗначенияРеквизитов.Вставить(ТекТЧ, МассивСтруктурТЧ);
			
		Иначе
			
			ТаблицаИменРеквизитов = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "НомерСтроки, Порядок, ИмяРеквизита");
			ТаблицаИменРеквизитов.Сортировать("НомерСтроки, Порядок, ИмяРеквизита");
			ТаблицаИменРеквизитов.Индексы.Добавить("НомерСтроки, ИмяРеквизита");
			
			МассивИменРеквизитов = Новый Массив;
			
			Для Каждого СтрокаИменРеквизитов Из ТаблицаИменРеквизитов Цикл
				
				ПараметрыПоиска = Новый Структура("ИмяРеквизита, ИмяТабличнойЧасти", СтрокаИменРеквизитов.ИмяРеквизита, ТекТЧ);
				
				Если ПустаяСтрока(СтрокаИменРеквизитов.ИмяРеквизита) Тогда
					Продолжить;
				КонецЕсли;
				
				МассивИменРеквизитов.Добавить(СтрокаИменРеквизитов.ИмяРеквизита);
				
			КонецЦикла;
			
			МассивИменРеквизитов.Вставить(0, "НомерСтроки");
			
			МассивИменРеквизитовСтрокой = СтрСоединить(МассивИменРеквизитов,",");
			ТЧСНужнымиКолонками = Ссылка[ТекТЧ].Выгрузить(, МассивИменРеквизитовСтрокой);
			
			// На первом проходе необходимо получить данные, требующие разыменовки и сгруппировать их по типам.
			// Для это будет использоваться соответствие, где ключами будут типы данных, а значениями - массивы ссылок
			ДанныеДляРазыменовки = Новый Соответствие;
			
			Для Каждого СтрокаТЧ Из ТЧСНужнымиКолонками Цикл
				
				Для Каждого ИмяРеквизита Из МассивИменРеквизитов Цикл
					
					ДобавитьЗначениеВДанныеДляРазыменовки(ДанныеДляРазыменовки, СтрокаТЧ[ИмяРеквизита]);
					
				КонецЦикла;
				
			КонецЦикла;
			
			РазыменовкаРеквизитов = РазыменовкаРеквизитовСогласноНастройке(ДанныеДляРазыменовки, НастройкаХранения);
			
			МассивСтруктурТЧ = Новый Массив;
			
			Для Каждого СтрокаТЧ Из ТЧСНужнымиКолонками Цикл
				
				СтруктураСтрокиТЧ = Новый Структура;
				
				Для Каждого ИмяРеквизита Из МассивИменРеквизитов Цикл
					
					ЗначениеРеквизита = СтрокаТЧ[ИмяРеквизита];
					
					РазыменовкаРеквизита = РазыменовкаРеквизитов.Получить(ЗначениеРеквизита);
					
					Если НЕ РазыменовкаРеквизита = Неопределено Тогда
						СтруктураСтрокиТЧ.Вставить(ИмяРеквизита, РазыменовкаРеквизита);
					Иначе
						СтруктураСтрокиТЧ.Вставить(ИмяРеквизита, ЗначениеРеквизита);
					КонецЕсли;
					
				КонецЦикла;
				
				МассивСтруктурТЧ.Добавить(СтруктураСтрокиТЧ);
				
			КонецЦикла;
			
			ЗначенияРеквизитов.Вставить(ТекТЧ, МассивСтруктурТЧ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Переопределеннные реквизиты добавляются в последнюю очередь
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ЗначенияРеквизитов, ЗначенияПереопределенныхРеквизитов);
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

Функция СоставКлючейСтруктуры(Структура) Экспорт
	
	Массив = Новый Массив;
	
	Для Каждого КлючЗначение Из Структура Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
			Массив.Добавить(Новый Структура(КлючЗначение.Ключ, СоставКлючейСтруктуры(КлючЗначение.Значение)));
		Иначе
			Массив.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция ЗначенияРеквизитовОбъектаСогласноНастройке(Ссылка, НастройкаХранения) Экспорт
	
	ПараметрыПоиска = Новый Структура("ТипДанных", ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Ссылка)));
	МассивРеквизитов = НастройкаХранения.Скопировать(ПараметрыПоиска, "ИмяРеквизита").ВыгрузитьКолонку("ИмяРеквизита");
	
	Если МассивРеквизитов.Количество() > 0 Тогда
		СтруктураЭП = Новый Структура;
		РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, МассивРеквизитов);
		Для Каждого РеквизитОбъекта Из РеквизитыОбъекта Цикл
			Если РеквизитОбъекта.Значение <> Неопределено
				И ПроцессыОбработкиДокументовПовтИсп.ОписаниеТиповСРазыменовкой().СодержитТип(ТипЗнч(РеквизитОбъекта.Значение)) Тогда
				СтруктураЭП.Вставить(РеквизитОбъекта.Ключ, ЗначенияРеквизитовОбъектаСогласноНастройке(РеквизитОбъекта.Значение, НастройкаХранения));
			Иначе
				СтруктураЭП.Вставить(РеквизитОбъекта.Ключ, РеквизитОбъекта.Значение);
			КонецЕсли;
		КонецЦикла;
		Возврат СтруктураЭП;
	Иначе
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Для типа данных ""%1"" не задана настройка состава реквизитов для электронной подписи.'"),
						ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Ссылка)));
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
КонецФункции

Функция ЗначенияРеквизитовОбъектаСогласноСоставу(Ссылка, СоставСвойств) Экспорт
	
	ВложенныеСоставыСвойств = Новый Структура;
	МассивРеквизитов = Новый Массив;
	Для Каждого ЭлементМассива Из СоставСвойств Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
			Для Каждого КлючЗначение Из ЭлементМассива Цикл
				МассивРеквизитов.Добавить(КлючЗначение.Ключ);
				ВложенныеСоставыСвойств.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		Иначе
			МассивРеквизитов.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивРеквизитов.Количество() > 0 Тогда
		СтруктураЭП = Новый Структура;
		РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, МассивРеквизитов);
		Для Каждого РеквизитОбъекта Из РеквизитыОбъекта Цикл
			Если РеквизитОбъекта.Значение <> Неопределено
				И ПроцессыОбработкиДокументовПовтИсп.ОписаниеТиповСРазыменовкой().СодержитТип(ТипЗнч(РеквизитОбъекта.Значение)) Тогда
				Если ВложенныеСоставыСвойств.Свойство(РеквизитОбъекта.Ключ) Тогда
					СтруктураЭП.Вставить(РеквизитОбъекта.Ключ, ЗначенияРеквизитовОбъектаСогласноСоставу(РеквизитОбъекта.Значение, ВложенныеСоставыСвойств[РеквизитОбъекта.Ключ]));
				Иначе
					СтруктураЭП.Вставить(РеквизитОбъекта.Ключ, Строка(РеквизитОбъекта.Значение));
				КонецЕсли;
			Иначе
				СтруктураЭП.Вставить(РеквизитОбъекта.Ключ, РеквизитОбъекта.Значение);
			КонецЕсли;
		КонецЦикла;
		Возврат СтруктураЭП;
	Иначе
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Для типа данных ""%1"" не задана настройка состава реквизитов для электронной подписи.'"),
						ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Ссылка)));
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
КонецФункции

Функция МассивДоступныхДляВыбораСертификатовКлючейЭП() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сертификаты.Ссылка КАК Ссылка,
	|	Сертификаты.Пользователь КАК Пользователь
	|ПОМЕСТИТЬ ВсеСертификаты
	|ИЗ
	|	Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования КАК Сертификаты
	|ГДЕ
	|	НЕ Сертификаты.Отозван
	|	И НЕ Сертификаты.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеСертификаты.Ссылка КАК Ссылка
	|ИЗ
	|	ВсеСертификаты КАК ВсеСертификаты";
	
	Если НЕ Пользователи.ЭтоПолноправныйПользователь( , , Ложь) Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	ВсеСертификаты.Ссылка В
		|			(ВЫБРАТЬ
		|				ВсеСертификаты.Ссылка КАК Ссылка
		|			ИЗ
		|				ВсеСертификаты КАК ВсеСертификаты
		|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.Пользователи КАК СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи
		|					ПО
		|						ВсеСертификаты.Ссылка = СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи.Ссылка
		|			ГДЕ
		|				ВсеСертификаты.Пользователь В (&Пользователи)
		|				И СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи.Пользователь ЕСТЬ NULL
		|		
		|			ОБЪЕДИНИТЬ ВСЕ
		|		
		|			ВЫБРАТЬ
		|				ВсеСертификаты.Ссылка
		|			ИЗ
		|				ВсеСертификаты КАК ВсеСертификаты
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.Пользователи КАК СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи
		|					ПО
		|						ВсеСертификаты.Ссылка = СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи.Ссылка
		|			ГДЕ
		|				СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи.Пользователь В (&Пользователи))";
		
		ПользователиДляОтбора = Новый Массив;
		ПользователиДляОтбора.Добавить(Пользователи.АвторизованныйПользователь());
		ПользователиДляОтбора.Добавить(Справочники.Пользователи.ПустаяСсылка());
		ПользователиДляОтбора.Добавить(Пользователи.СсылкаНеуказанногоПользователя());
		
		Запрос.УстановитьПараметр("Пользователи", ПользователиДляОтбора);
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Помечает на удаление (или снимает отметку) у задач.
//
// Параметры:
//  Задачи - Массив - массив ссылок на задачи.
//  ПометкаУдаления - Булево - значение свойства ПометкаУдаления для задач.
//
Процедура УстановитьПометкуУдаленияЗадачи(Задачи, ПометкаУдаления) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		ПроверитьИЗаблокироватьЗадачиОтВыполнения(Задачи);
		
		ЗаблокироватьЗадачи(Задачи);
		
		Для Каждого Задача Из Задачи Цикл
			ЗадачаОбъект = Задача.ПолучитьОбъект();
			ЗадачаОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Установить исключительную управляемую блокировку на указанные задачи.
// Для вызова из обработчиков команд динамических список.
// Строки группировки динамического списка игнорируются.
//
// Параметры:
//   Задачи - Массив, ЗадачаСсылка.ЗадачаПоОбработкеДокумента - ссылки на задачи или одна ссылка.
//
Процедура ЗаблокироватьЗадачи(Задачи) Экспорт
	
	Блокировка = Новый БлокировкаДанных;
	Если ТипЗнч(Задачи) = Тип("Массив") Тогда
		Для Каждого Задача Из Задачи Цикл
			Если ТипЗнч(Задача) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда 
				Продолжить;
			КонецЕсли;
			ЭлементБлокировки = Блокировка.Добавить("Задача.ЗадачаПоОбработкеДокумента");
			Если ТипЗнч(Задача) = Тип("Структура") Тогда
				ЭлементБлокировки.УстановитьЗначение("Ссылка", Задача.Задача);
			Иначе
				ЭлементБлокировки.УстановитьЗначение("Ссылка", Задача);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Если ТипЗнч(Задачи) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Возврат;
		КонецЕсли;
		ЭлементБлокировки = Блокировка.Добавить("Задача.ЗадачаПоОбработкеДокумента");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Задачи);
	КонецЕсли;
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Установить исключительную управляемую блокировку на регистр сведений "ТекущиеСтатусыДокументов"
// по измерению "Документ" согласно указанным документам.
//
// Параметры:
//   Документы - Массив, ДокументСсылка - ссылки на документы или одна ссылка.
//
Процедура ЗаблокироватьРегистрТекущиеСтатусыДокументов(Документы) Экспорт
	
	Блокировка = Новый БлокировкаДанных;
	Если ТипЗнч(Документы) = Тип("Массив") Тогда
		Для Каждого Документ Из Документы Цикл
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТекущиеСтатусыДокументов");
			ЭлементБлокировки.УстановитьЗначение("Предмет", Документ);
		КонецЦикла;
	Иначе
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТекущиеСтатусыДокументов");
		ЭлементБлокировки.УстановитьЗначение("Предмет", Документы);
	КонецЕсли;
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Установить исключительную управляемую блокировку на регистр сведений "ОчередьЗаполненияДополнительныхКолонокЗадач"
// по измерениям "Колонка" и "ИдентификаторДокумента"
//
// Параметры:
//   Документы - Массив, ДокументСсылка - ссылки на документы или одна ссылка.
//
Процедура ЗаблокироватьРегистрОчередьЗаполненияДополнительныхКолонокЗадач(
	Колонка = Неопределено, ИдентификаторДокумента = Неопределено) Экспорт
	
	Блокировка = Новый БлокировкаДанных;
	Если Колонка = Неопределено Тогда
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОчередьЗаполненияДополнительныхКолонокЗадач");
	Иначе
		Если ТипЗнч(ИдентификаторДокумента) = Тип("Массив") Тогда
			Для Каждого Идентификатор Из ИдентификаторДокумента Цикл
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОчередьЗаполненияДополнительныхКолонокЗадач");
				ЭлементБлокировки.УстановитьЗначение("Колонка", Колонка);
				ЭлементБлокировки.УстановитьЗначение("ИдентификаторДокумента", Идентификатор);
			КонецЦикла;
		Иначе
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОчередьЗаполненияДополнительныхКолонокЗадач");
			ЭлементБлокировки.УстановитьЗначение("Колонка", Колонка);
			ЭлементБлокировки.УстановитьЗначение("ИдентификаторДокумента", ИдентификаторДокумента);
		КонецЕсли;
	КонецЕсли;
	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура УстановкаПризнаковПереходаПоЗапускаемомуЭтапу(ДокументСсылка, Шаблон, ИдентификаторЗапускаемогоЭтапа, ПереходОт = Ложь, ПереходК = Истина) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого Предшественник Из Шаблон.ПредшественникиЭтапов Цикл
		Если Предшественник.ИдентификаторПредшественника = ИдентификаторЗапускаемогоЭтапа Тогда
			
			НаборЗаписейПереходов = РегистрыСведений.ПереходыМеждуЭтапамиПроцесса.СоздатьНаборЗаписей();
			НаборЗаписейПереходов.Отбор.Предмет.Установить(ДокументСсылка);
			НаборЗаписейПереходов.Отбор.ИдентификаторПоследователя.Установить(Предшественник.ИдентификаторПоследователя);
			НаборЗаписейПереходов.Отбор.ИдентификаторПредшественника.Установить(ИдентификаторЗапускаемогоЭтапа);
			Запись = НаборЗаписейПереходов.Добавить();
			ЗаполнитьЗначенияСвойств(Запись,Предшественник);
			Запись.Предмет = ДокументСсылка;
			Запись.УсловныйПереходБылВыполнен = ПереходОт;
			НаборЗаписейПереходов.Записать(Истина);
			
		КонецЕсли;
		Если Предшественник.ИдентификаторПоследователя = ИдентификаторЗапускаемогоЭтапа Тогда
			
			НаборЗаписейПереходов = РегистрыСведений.ПереходыМеждуЭтапамиПроцесса.СоздатьНаборЗаписей();
			НаборЗаписейПереходов.Отбор.Предмет.Установить(ДокументСсылка);
			НаборЗаписейПереходов.Отбор.ИдентификаторПоследователя.Установить(ИдентификаторЗапускаемогоЭтапа);
			НаборЗаписейПереходов.Отбор.ИдентификаторПредшественника.Установить(Предшественник.ИдентификаторПредшественника);
			Запись = НаборЗаписейПереходов.Добавить();
			ЗаполнитьЗначенияСвойств(Запись,Предшественник);
			Запись.Предмет = ДокументСсылка;
			Запись.УсловныйПереходБылВыполнен = ПереходК;
			НаборЗаписейПереходов.Записать(Истина);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеДополнительныхОбработчиков() Экспорт
	
	Обработчики = Новый Массив;
	
	ПроцессыОбработкиДокументовОбработчикиПереопределяемый.ОписаниеДополнительныхОбработчиков(Обработчики);
	
	УникальныеИдентификаторы = Новый Соответствие;
	Для Каждого Элемент Из Обработчики Цикл
		Если УникальныеИдентификаторы.Получить(Элемент.Идентификатор) <> Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru='Обнаружено дублирование идентификаторов дополнительных обработчиков. Список обработчиков будет недоступен.'"));
			Обработчики.Очистить();
			Прервать;
		Иначе
			УникальныеИдентификаторы.Вставить(Элемент.Идентификатор, "");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Обработчики;
	
КонецФункции

