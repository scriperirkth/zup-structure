	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИДЭтапа);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессовНедоступныеРеквизиты.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ШаблоныПроцессовНедоступныеРеквизиты.ИмяРеквизита КАК ИмяРеквизита
	|ИЗ
	|	Справочник.ШаблоныПроцессов.НедоступныеРеквизиты КАК ШаблоныПроцессовНедоступныеРеквизиты
	|ГДЕ
	|	ШаблоныПроцессовНедоступныеРеквизиты.Ссылка = &Шаблон
	|	И ШаблоныПроцессовНедоступныеРеквизиты.ИдентификаторЭтапа = &ИдентификаторЭтапа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ШаблоныПроцессовИзменениеРеквизитовЭтапов.ИмяТабличнойЧасти,
	|	ШаблоныПроцессовИзменениеРеквизитовЭтапов.ИмяРеквизита
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ИзменениеРеквизитовЭтапов КАК ШаблоныПроцессовИзменениеРеквизитовЭтапов
	|ГДЕ
	|	ШаблоныПроцессовИзменениеРеквизитовЭтапов.Ссылка = &Шаблон
	|	И ШаблоныПроцессовИзменениеРеквизитовЭтапов.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НедоступныеРеквизиты = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.ИмяТабличнойЧасти) Тогда
			НедоступныеРеквизиты.Добавить(Выборка.ИмяРеквизита);
		ИначеЕсли ПустаяСтрока(Выборка.ИмяРеквизита) Тогда
			НедоступныеРеквизиты.Добавить(Выборка.ИмяТабличнойЧасти);
		Иначе
			НедоступныеРеквизиты.Добавить(Выборка.ИмяТабличнойЧасти+"."+Выборка.ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НедоступныеРеквизиты;
	
КонецФункции

