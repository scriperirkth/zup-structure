КонецПроцедуры

Процедура ПроверитьЗаполненностьОбязательныхРеквизитов(ДанныеДокумента) Экспорт
	
	КонтролируемыеРеквизиты = ПроцессыОбработкиДокументовПовтИсп.ОбязательныеРеквизиты(ДанныеДокумента.Шаблон, Строка(ДанныеДокумента.ИдентификаторЭтапа));
	
	КонтролируемыеРеквизиты = КонтролируемыеРеквизиты.Скопировать();
	ПроцессыОбработкиДокументовПереопределяемый.ПриПроверкеЗаполненияОбязательныхРеквизитов(ДанныеДокумента, КонтролируемыеРеквизиты);
	
	ТаблицаТЧ = КонтролируемыеРеквизиты.Скопировать(,"ИмяТабличнойЧасти");
	ТаблицаТЧ.Свернуть("ИмяТабличнойЧасти");
	МассивТЧ = ТаблицаТЧ.ВыгрузитьКолонку("ИмяТабличнойЧасти");
	
	ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти", "");
	ПроверяемыеРеквизиты = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "ИмяРеквизита");
	
	Ссылка = ДанныеДокумента.Источник;
	
	Для Каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
		
		Если НЕ ЗначениеЗаполнено(Ссылка[ТекРеквизит.ИмяРеквизита]) Тогда
			ОписаниеРеквизита = Ссылка.Метаданные().Реквизиты.Найти(ТекРеквизит.ИмяРеквизита);
			Если ОписаниеРеквизита = Неопределено Тогда
				ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
			Иначе
				ПредставлениеРеквизита = ОписаниеРеквизита.Синоним;
			КонецЕсли;
			ДанныеДокумента.ОписаниеОшибки = ДанныеДокумента.ОписаниеОшибки + "
										|- не заполнен реквизит """ + ПредставлениеРеквизита + """";
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекТЧ Из МассивТЧ Цикл
		
		Если ПустаяСтрока(ТекТЧ) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеТЧ = Ссылка.Метаданные().ТабличныеЧасти.Найти(ТекТЧ);
		Если ОписаниеТЧ = Неопределено Тогда
			ПредставлениеТЧ = ТекТЧ;
		Иначе
			ПредставлениеТЧ = ОписаниеТЧ.Синоним;
		КонецЕсли;
		
		ОтборТЧ = Новый Структура("ИмяТабличнойЧасти,ИмяРеквизита", ТекТЧ, "");
		Если КонтролируемыеРеквизиты.НайтиСтроки(ОтборТЧ).Количество() > 0
			И Ссылка[ТекТЧ].Количество() = 0 Тогда
			ДанныеДокумента.ОписаниеОшибки = ДанныеДокумента.ОписаниеОшибки + "
										|- не заполнена таблица """ + ПредставлениеТЧ + """";
		КонецЕсли;
		
		Если Ссылка[ТекТЧ].Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти",ТекТЧ);
		ПроверяемыеРеквизиты = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "ИмяРеквизита");
		Для ИндексСтроки = 0 По Ссылка[ТекТЧ].Количество() - 1 Цикл
			СтрокаСсылка = Ссылка[ТекТЧ][ИндексСтроки];
			Для Каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
				Если ПустаяСтрока(ТекРеквизит.ИмяРеквизита) Тогда
					Продолжить;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СтрокаСсылка[ТекРеквизит.ИмяРеквизита]) Тогда
					Если ОписаниеТЧ <> Неопределено Тогда
						ОписаниеРеквизита = ОписаниеТЧ.Реквизиты.Найти(ТекРеквизит.ИмяРеквизита);
						Если ОписаниеРеквизита = Неопределено Тогда
							ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
						Иначе
							ПредставлениеРеквизита = ОписаниеРеквизита.Синоним;
						КонецЕсли;
					Иначе
						ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
					КонецЕсли;
					ДанныеДокумента.ОписаниеОшибки = ДанныеДокумента.ОписаниеОшибки
						+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
							|- не заполнен реквизит ""%1"" в строке %2 таблицы ""%3""'"),
							ПредставлениеРеквизита,
							ИндексСтроки+1,
							ПредставлениеТЧ);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(ДанныеДокумента.ОписаниеОшибки) Тогда
		ДанныеДокумента.ОписаниеОшибки = НСтр("ru='Документ не прошел проверку контроля заполненности обязательных реквизитов:'") + ДанныеДокумента.ОписаниеОшибки;
		ДанныеДокумента.Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполненностьОбязательныхРеквизитовПервичныхДокументов(ДанныеДокумента) Экспорт
	
	// Реквизиты первичного документа
	КонтролируемыеРеквизиты = ПроцессыОбработкиДокументовПовтИсп.ОбязательныеРеквизитыПервичныхДокументов(
		ДанныеДокумента.Шаблон, Строка(ДанныеДокумента.ИдентификаторЭтапа));
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ДанныеДокумента.Источник));
	
	ФорматыПервичныхДокументов = Новый Структура;
	ПроцессыОбработкиДокументовПереопределяемый.ПриЗаполненииФорматовПервичныхДокументов(
		ФорматыПервичныхДокументов, ИдентификаторДокумента);
	
	ПервичныеДокументыВШаблоне = Новый Соответствие;
	Для Каждого Реквизит Из КонтролируемыеРеквизиты Цикл
		КонтролируемыеРеквизитыДокумента = ПервичныеДокументыВШаблоне[Реквизит.ИдентификаторПечатнойФормы];
		Если КонтролируемыеРеквизитыДокумента = Неопределено Тогда
			КонтролируемыеРеквизитыДокумента = Новый ТаблицаЗначений;
			КонтролируемыеРеквизитыДокумента.Колонки.Добавить("ИмяТабличнойЧасти", Новый ОписаниеТипов("Строка"));
			КонтролируемыеРеквизитыДокумента.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
			ПервичныеДокументыВШаблоне.Вставить(Реквизит.ИдентификаторПечатнойФормы, КонтролируемыеРеквизитыДокумента);
		КонецЕсли;
		НоваяСтрока = КонтролируемыеРеквизитыДокумента.Добавить();
		НоваяСтрока.ИмяТабличнойЧасти = Реквизит.ИмяТабличнойЧасти;
		НоваяСтрока.ИмяРеквизита = Реквизит.ИмяРеквизита;
	КонецЦикла;
	
	Для Каждого ПервичныйДокумент Из ПервичныеДокументыВШаблоне Цикл
		
		ИдентификаторПечатнойФормы = ПервичныйДокумент.Ключ;
		
		КонтролируемыеРеквизитыДокумента = ПервичныйДокумент.Значение;
		
		ТекущиеРеквизитыДокумента = РеквизитыПоФорматуПервичногоДокумента(
			ДанныеДокумента.Источник, ИдентификаторПечатнойФормы)[ДанныеДокумента.Источник];
		
		ТаблицаТЧ = КонтролируемыеРеквизитыДокумента.Скопировать(,"ИмяТабличнойЧасти");
		ТаблицаТЧ.Свернуть("ИмяТабличнойЧасти");
		МассивТЧ = ТаблицаТЧ.ВыгрузитьКолонку("ИмяТабличнойЧасти");
		
		Для Каждого ТекТЧ Из МассивТЧ Цикл
			
			ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти", ТекТЧ);
			ПроверяемыеРеквизиты = КонтролируемыеРеквизитыДокумента.Скопировать(ОтборРеквизитов, "ИмяРеквизита");
			
			ТаблицаДокумента = ТекущиеРеквизитыДокумента[?(ПустаяСтрока(ТекТЧ), "Шапка", ТекТЧ)];
			
			Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
				Для Каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
					Если НЕ ЗначениеЗаполнено(СтрокаДокумента[ТекРеквизит.ИмяРеквизита]) Тогда
						ПредставлениеРеквизита = ТаблицаДокумента.Колонки[ТекРеквизит.ИмяРеквизита].Заголовок;
						Если ПустаяСтрока(ТекТЧ) Тогда
							ДанныеДокумента.ОписаниеОшибки = ДанныеДокумента.ОписаниеОшибки
								+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
								|- у первичного документа ""%1"" не заполнен реквизит ""%2""'"),
								ИдентификаторПечатнойФормы,
								ПредставлениеРеквизита);
						Иначе
							ПредставлениеТЧ = ТекущиеРеквизитыДокумента["Шапка"].Колонки[ТекТЧ].Заголовок;
							ДанныеДокумента.ОписаниеОшибки = ДанныеДокумента.ОписаниеОшибки
								+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
								|- у первичного документа ""%1"" не заполнен реквизит ""%2"" в строке %3 таблицы ""%4""'"),
								ИдентификаторПечатнойФормы,
								ПредставлениеРеквизита,
								ТаблицаДокумента.Индекс(СтрокаДокумента) + 1,
								ПредставлениеТЧ);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(ДанныеДокумента.ОписаниеОшибки) Тогда
		ДанныеДокумента.ОписаниеОшибки = НСтр("ru='Документ не прошел проверку контроля заполненности обязательных реквизитов:'") + ДанныеДокумента.ОписаниеОшибки;
		ДанныеДокумента.Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьСобытиеИсторииЗадач(Знач Задачи, Событие, Исполнитель = Неопределено, ДатаСобытия = Неопределено) Экспорт
	
	Если ТипЗнч(Задачи) = Тип("ЗадачаСсылка.ЗадачаПоОбработкеДокумента") Тогда
		Задачи = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Задачи);
	КонецЕсли;
	
	Если ДатаСобытия = Неопределено Тогда
		ДатаСобытия = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Для Каждого Задача ИЗ Задачи Цикл
		
		НаборЗаписей = РегистрыСведений.ИсторияЗадачПоОбработкеДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Задача.Установить(Задача);
		НаборЗаписей.Отбор.Период.Установить(ДатаСобытия);
		
		Запись = НаборЗаписей.Добавить();
		Запись.Период = НаборЗаписей.Отбор.Период.Значение;
		Запись.Задача = Задача;
		Запись.Событие = Событие;
		Запись.Пользователь = Пользователи.АвторизованныйПользователь();
		Если Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.ПринятиеКИсполнению")
			ИЛИ Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.НазначениеИсполнителя") Тогда
			Запись.Исполнитель = Исполнитель;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать(Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьКомментарийИсполнителяЗадачи(Задача, Комментарий) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьЗадачи(Задача);
		
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		ЗадачаОбъект.Заблокировать();
		ЗадачаОбъект.РезультатВыполнения = Комментарий;
		ЗадачаОбъект.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция XMLВСтруктуру(ЧтениеXML, УскоренноеЧтение = Ложь) Экспорт
	
	ИмяСвойства = ЧтениеXML.Имя;
	Значение = "";
	
	ВозвращаемаяСтруктура = Новый Структура;
	
	Если УскоренноеЧтение Тогда
		ИменаСвойствXMLБольшогоОбъема = ПроцессыОбработкиДокументовПереопределяемый.ИменаСвойствXMLБольшогоОбъема();
	Иначе
		ИменаСвойствXMLБольшогоОбъема = Новый Массив;
	КонецЕсли;
	
	//Пропуск чтения объемных данных отчета.
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		
		Если ИменаСвойствXMLБольшогоОбъема.Найти(ИмяСвойства) <> Неопределено Тогда
			ВозвращаемаяСтруктура.Вставить(ИмяСвойства, "");
			Возврат ВозвращаемаяСтруктура;
		КонецЕсли;
	КонецЕсли;
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если ИмяСвойства = "" Тогда
				ИмяСвойства = ЧтениеXML.Имя;
				
				//Пропуск чтения объемных данных отчета.
				Если ИменаСвойствXMLБольшогоОбъема.Найти(ИмяСвойства) <> Неопределено Тогда
					ВозвращаемаяСтруктура.Вставить(ИмяСвойства, "");
					Прервать;
				КонецЕсли;
				
			ИначеЕсли ЧтениеXML.Имя = "СтрокаТабличнойЧасти" Тогда
				//ЧтениеXML.Прочитать(); // переходим к вложенной структуре строки
				ВозвращаемаяСтруктура.Вставить(ИмяСвойства, XMLВМассив(ЧтениеXML));
				ИмяСвойства = "";
			Иначе
				ВозвращаемаяСтруктура.Вставить(ИмяСвойства, XMLВСтруктуру(ЧтениеXML, УскоренноеЧтение));
				Если ИменаСвойствXMLБольшогоОбъема.Найти(ЧтениеXML.Имя) <> Неопределено Тогда
					ЧтениеXML.Закрыть();
				КонецЕсли;
				ИмяСвойства = "";
			КонецЕсли;
		ИначеЕсли ЧтениеXML.ИмеетЗначение Тогда
			Значение = ЧтениеXML.Значение;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если ИмяСвойства = "" Тогда
				Возврат ВозвращаемаяСтруктура;
			Иначе
				ВозвращаемаяСтруктура.Вставить(ИмяСвойства, Значение);
				ИмяСвойства = "";
				Значение = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВозвращаемаяСтруктура;
	
КонецФункции

Процедура ПроверитьСоответствиеПодписанныхИТекущихДанных(ДокументСсылка, Подписи, Параметры) Экспорт
	
	МодульОценкаПроизводительности = Неопределено;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ОценкаПроизводительности") Тогда
		МодульОценкаПроизводительности = ОбщегоНазначения.ОбщийМодуль("ОценкаПроизводительности");
		ПредставлениеДокумента = ОбщегоНазначения.ПредметСтрокой(ДокументСсылка);
	КонецЕсли;
	
	Для Каждого СтрокаПодписи Из Подписи Цикл
		
		Если МодульОценкаПроизводительности <> Неопределено Тогда
			ОписаниеЗамера = МодульОценкаПроизводительности.НачатьЗамерДлительнойОперации(
				"ПроцессыОбработкиДокументов.ПроверкаСоответствияПодписанныхИТекущихДанных");
		КонецЕсли;
		
		ОписаниеОшибки = "";
		
		Если ЭтоАдресВременногоХранилища(СтрокаПодписи.ПодписанныеДанные) Тогда
			Данные = ПолучитьИзВременногоХранилища(СтрокаПодписи.ПодписанныеДанные)
		Иначе
			Данные = СтрокаПодписи.ПодписанныеДанные;
		КонецЕсли;
		
		Если Данные = Неопределено 
			И СтрокаПодписи.Свойство("ПодписанныеДанныеФайл")
			И ЗначениеЗаполнено(СтрокаПодписи.ПодписанныеДанныеФайл) Тогда
			
			ПрисоединенныеФайлы = Новый Массив; 
			РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(СтрокаПодписи.ПодписанныеДанныеФайл, ПрисоединенныеФайлы);
			
			Данные = РаботаСФайлами.ДвоичныеДанныеФайла(ПрисоединенныеФайлы[0], Истина); 
			Если Данные = Неопределено	Тогда	
				ТекстСообщения = НСтр("ru='Не найдены подписанные данные'"); 
				СтрокаПодписи.ОписаниеОшибки = ТекстСообщения;  
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ЧтениеXML = Новый ЧтениеXML;
		ПодписываемыеДанныеXML = ПолучитьСтрокуИзДвоичныхДанных(Данные);
		
		Буфер = Новый БуферДвоичныхДанных(4);
		Поток = Данные.ОткрытьПотокДляЧтения().Прочитать(Буфер, 0, 4);
		// документ FastInfoset должен начинаться с шестнадцатеричной последовательности октетов E0 00 00 01,
		// в случае, если необязательная декларация XML отсутствует.
		Если Буфер.ПрочитатьЦелое32(0, ПорядокБайтов.BigEndian) = 3758096385 Тогда
			ЧтениеFastInfoSet = Новый ЧтениеFastInfoSet;
			ЧтениеFastInfoSet.УстановитьДвоичныеДанные(Данные);
			ЧтениеXML.УстановитьСтроку(ПрочитатьXML(ЧтениеFastInfoSet));
		Иначе
			ПараметрыЧтенияXML = Новый ПараметрыЧтенияXML(,,,,,,,,,Ложь,);
			ЧтениеXML.УстановитьСтроку(ПодписываемыеДанныеXML, ПараметрыЧтенияXML);
		КонецЕсли;
		
		ЧтениеXML.ПерейтиКСодержимому();
		
		ЧтениеXML.Прочитать(); // пропускаем первый тег "ДанныеПодписи"
		
		ТипыДокументовXMLБольшогоОбъема = ПроцессыОбработкиДокументовПереопределяемый.ТипыДокументовXMLБольшогоОбъема();
		
		ПроверятьЧерезХэш = Ложь;
		Если Константы.ИспользоватьПроверкуПодписываемыхДанныхЧерезХэш.Получить() 
			И ТипыДокументовXMLБольшогоОбъема.Найти(ТипЗнч(ДокументСсылка)) = Неопределено  //прежний функционал большого объема остается
			И СтрокаПодписи.Свойство("Задача") Тогда
			
			НастройкиДляПроверкиПодписанныхДанных = НастройкиДляПроверкиДанныхБольшихОбъемов(СтрокаПодписи.Задача);
			
			Если НастройкиДляПроверкиПодписанныхДанных.Свойство("СоставПодписи") 
				И НастройкиДляПроверкиПодписанныхДанных.Свойство("НастройкаПодписиСсылочныхДанных") Тогда
				
				СоставПодписи = НастройкиДляПроверкиПодписанныхДанных.СоставПодписи.Получить();
				НастройкаПодписиСсылочныхДанных = НастройкиДляПроверкиПодписанныхДанных.НастройкаПодписиСсылочныхДанных.Получить();
				
			КонецЕсли;
			
			Если Не (СоставПодписи = Неопределено) И Не (НастройкаПодписиСсылочныхДанных = Неопределено) Тогда 
				ПроверятьЧерезХэш = Истина; 
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПодписываемыеДанныеXML) И ПроверятьЧерезХэш Тогда
			
			    ХэшФайлаПодписываемыхДанныхXML = Новый ХешированиеДанных(ХешФункция.MD5);
				ХэшФайлаПодписываемыхДанныхXML.Добавить(Данные); 
				
				ИспользуетсяОписаниеПодписываемыхДокументов = Ложь;
			    ОписаниеПодписываемыхДокументов = Новый Структура;
				ПодписанныеЗначенияРеквизитовБезДанныхБольшогоОбъема = XMLВСтруктуру(ЧтениеXML, Истина);
				ЧтениеXML = Неопределено;

				ИспользуетсяОписаниеПодписываемыхДокументов = ПодписанныеЗначенияРеквизитовБезДанныхБольшогоОбъема.Свойство("ОписаниеПодписываемыхДокументов");
				ОписаниеПодписываемыхДокументов = ПодписанныеЗначенияРеквизитовБезДанныхБольшогоОбъема.ОписаниеПодписываемыхДокументов;

			    Результат = Новый Структура;
				ДанныеПодписи = Новый Структура;
				ДанныеПодписи.Вставить("ОписаниеПодписываемыхДокументов", ОписаниеПодписываемыхДокументов);
				ДанныеПодписи.Вставить("ПодписываемыеДанныеДокументов", ЗначенияРеквизитовОбъектаПоСоставу(ДокументСсылка, СоставПодписи,
																		Параметры, НастройкаПодписиСсылочныхДанных, СтрокаПодписи, Новый Массив));
				
				Результат.Вставить("ДанныеПодписи", ДанныеПодписи);
			
				СериализованныйРезультат = СтруктуруВСтрокуXML(Результат);
				ДвоичныйРезультат = ПолучитьДвоичныеДанныеИзСтроки(СериализованныйРезультат); 
				
                ХэшФайлаРезультат = Новый ХешированиеДанных(ХешФункция.MD5);
				ХэшФайлаРезультат.Добавить(ДвоичныйРезультат);
				Если ХэшФайлаПодписываемыхДанныхXML.ХешСумма  = ХэшФайлаРезультат.ХешСумма Тогда
					// Данные соответствуют, дальнейшая проверка не требуется.
					Продолжить;
				Иначе
					ПредставлениеДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Представление");
					ПредставлениеЭтапа     =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПодписи.Этап, "Представление");
					ШаблонСообщения = НСтр("ru='Подписываемые данные большого объема (для документа ""%1"" на Этапе ""%2"") отличаются от текущих. 
											|Для получения подробной информации о различиях необходимо воспользоваться " +
											"дополнительной функцией ""Проверить"" в разделе ""Процессы"".'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ПредставлениеДокумента, ПредставлениеЭтапа);
					
					СтрокаПодписи.ОписаниеОшибки = ТекстСообщения;  
					
					Возврат;
                КонецЕсли;
		
		ИначеЕсли ЗначениеЗаполнено(ПодписываемыеДанныеXML) И ТипыДокументовXMLБольшогоОбъема.Найти(ТипЗнч(ДокументСсылка)) <> Неопределено Тогда
			
			// Проверка по строковому представлению данных.
			// Если строковые данные совпадают, то дальнейшая детальная сверка по каждому элементу структуры не требуется.
			
			СоставПодписи = Неопределено;
			
			Если СтрокаПодписи.Свойство("СоставПодписи") Тогда
				
				Если ЭтоАдресВременногоХранилища(СтрокаПодписи.СоставПодписи) Тогда
					СоставПодписи = ПолучитьИзВременногоХранилища(СтрокаПодписи.СоставПодписи);
				Иначе
					СоставПодписи = СтрокаПодписи.СоставПодписи;
				КонецЕсли;
				
			КонецЕсли;
			
			ИспользуетсяОписаниеПодписываемыхДокументов = Ложь;
			ОписаниеПодписываемыхДокументов = Новый Структура;
			
			Если СоставПодписи = Неопределено Тогда
				
				ПодписанныеЗначенияРеквизитовБезДанныхБольшогоОбъема = XMLВСтруктуру(ЧтениеXML, Истина);
				ЧтениеXML = Неопределено;
				
				ИспользуетсяОписаниеПодписываемыхДокументов = ПодписанныеЗначенияРеквизитовБезДанныхБольшогоОбъема.Свойство("ОписаниеПодписываемыхДокументов");
				ОписаниеПодписываемыхДокументов = ПодписанныеЗначенияРеквизитовБезДанныхБольшогоОбъема.ОписаниеПодписываемыхДокументов;
				СоставПодписи = СоставПодписиИзПодписанныхДанных(ПодписанныеЗначенияРеквизитовБезДанныхБольшогоОбъема);
				
				ПодписанныеЗначенияРеквизитовБезДанныхБольшогоОбъема = Неопределено;
				
			КонецЕсли;
			
			Результат = Новый Структура;
			Если ИспользуетсяОписаниеПодписываемыхДокументов Тогда
				ДанныеПодписи = Новый Структура;
				ДанныеПодписи.Вставить("ОписаниеПодписываемыхДокументов", ОписаниеПодписываемыхДокументов);
				ДанныеПодписи.Вставить("ПодписываемыеДанныеДокументов", ЗначенияРеквизитовОбъектаПоСоставу(ДокументСсылка, СоставПодписи, Параметры,, СтрокаПодписи, Новый Массив));
				Результат.Вставить("ДанныеПодписи", ДанныеПодписи);
			Иначе
				Результат.Вставить("ДанныеПодписи", ЗначенияРеквизитовОбъектаПоСоставу(ДокументСсылка, СоставПодписи, Параметры,, СтрокаПодписи, Новый Массив));
			КонецЕсли;
			СоставПодписи = Неопределено;
			
			Если СтруктуруВСтрокуXML(Результат) = ПодписываемыеДанныеXML Тогда 
				// Данные соответствуют, дальнейшая проверка не требуется.
				Возврат;
			КонецЕсли;
			
			Если СтрДлина(ПодписываемыеДанныеXML) > 25000000 Тогда
				// Данные отличаются, но из-за большого объема проверка по каждому узлу 
				// займет слишком большое количество времени.
				ОписаниеОшибки = ОписаниеОшибки + "
							|В подписанных данных документа большого объема данные отличаются от текущих данных. 
							|Это может быть вызвано порядком подписи, анализ изменений требуется выполнить вручную.";
			
				Если СтрокаПодписи.Свойство("ДатаПодписи") И СтрокаПодписи.Свойство("КомуВыданСертификат") Тогда
					СтрокаПодписи.ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Подписанные данные (подпись от %1, автор %2, этап ""%3"") отличаются от текущих:%4'"),
					СтрокаПодписи.ДатаПодписи,
					СтрокаПодписи.КомуВыданСертификат,
					СтрокаПодписи.Этап,
					ОписаниеОшибки);
				Иначе
					СтрокаПодписи.ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Подписанные при выполнении этапа ""%1"" данные отличаются от текущих:%2'"),
					СтрокаПодписи.Этап,
					ОписаниеОшибки);
				КонецЕсли;  
				
			Иначе
				// Выполняется полное чтение XML для дальнейшего полного сравнения по узлам через структуру.
				ЧтениеXML = Новый ЧтениеXML;
				
				Буфер = Новый БуферДвоичныхДанных(4);
				Поток = Данные.ОткрытьПотокДляЧтения().Прочитать(Буфер, 0, 4);
				// документ FastInfoset должен начинаться с шестнадцатеричной последовательности октетов E0 00 00 01,
				// в случае, если необязательная декларация XML отсутствует.
				Если Буфер.ПрочитатьЦелое32(0, ПорядокБайтов.BigEndian) = 3758096385 Тогда
					ЧтениеFastInfoSet = Новый ЧтениеFastInfoSet;
					ЧтениеFastInfoSet.УстановитьДвоичныеДанные(Данные);
					ЧтениеXML.УстановитьСтроку(ПрочитатьXML(ЧтениеFastInfoSet));
				Иначе
					ПараметрыЧтенияXML = Новый ПараметрыЧтенияXML(,,,,,,,,,Ложь,);
					ЧтениеXML.УстановитьСтроку(ПодписываемыеДанныеXML, ПараметрыЧтенияXML);
				КонецЕсли;
				
				ЧтениеXML.ПерейтиКСодержимому();
				
				ЧтениеXML.Прочитать(); // пропускаем первый тег "ДанныеПодписи"
				
			КонецЕсли;
			
		КонецЕсли;		
		
		ПодписываемыеДанныеXML = Неопределено;
		
		ПодписанныеЗначенияРеквизитов = XMLВСтруктуру(ЧтениеXML);
		
		Если ПодписанныеЗначенияРеквизитов.Свойство("ПодписываемыеДанныеДокументов") Тогда
			Если ТипЗнч(ПодписанныеЗначенияРеквизитов.ПодписываемыеДанныеДокументов) <> Тип("Структура") Тогда
				ПодписанныеЗначенияРеквизитов = Новый Структура;
			Иначе
				ПодписанныеЗначенияРеквизитов = ПодписанныеЗначенияРеквизитов.ПодписываемыеДанныеДокументов;
			КонецЕсли;
		КонецЕсли;
		
		Если МодульОценкаПроизводительности <> Неопределено Тогда
			МодульОценкаПроизводительности.ЗафиксироватьЗамерДлительнойОперации(
				ОписаниеЗамера, 1, "ПолучениеПодписанныхДанных", ПредставлениеДокумента);
		КонецЕсли;
		
		// для совместимости с предыдущим алгоритмом хранения подписанных данных:
		// из сохраненного состава подписи получим имена табличных частей
		// и отберем те, которые в подписанных данных не заполнены, т.е. у которых не было строк
		МассивПустыхПодписанныхТЧ = Новый Массив;
		Если СтрокаПодписи.Свойство("СоставПодписи") Тогда
			Если ЭтоАдресВременногоХранилища(СтрокаПодписи.СоставПодписи) Тогда
				СоставПодписи = ПолучитьИзВременногоХранилища(СтрокаПодписи.СоставПодписи);
			Иначе
				СоставПодписи = СтрокаПодписи.СоставПодписи;
			КонецЕсли;
			Если СоставПодписи <> Неопределено Тогда
				ТаблицаТЧ = СоставПодписи.Скопировать(,"ИмяТабличнойЧасти");
				ТаблицаТЧ.Свернуть("ИмяТабличнойЧасти");
				МассивТЧ = ТаблицаТЧ.ВыгрузитьКолонку("ИмяТабличнойЧасти");
				Для Каждого ТекТЧ Из МассивТЧ Цикл
					Если ПустаяСтрока(ТекТЧ) ИЛИ НЕ ПодписанныеЗначенияРеквизитов.Свойство(ТекТЧ) Тогда
						Продолжить;
					КонецЕсли;
					Если НЕ ТипЗнч(ПодписанныеЗначенияРеквизитов[ТекТЧ]) = Тип("Массив") Тогда
						МассивПустыхПодписанныхТЧ.Добавить(ТекТЧ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		СоставПодписи = СоставПодписиИзПодписанныхДанных(ПодписанныеЗначенияРеквизитов);
		СоставПодписи.Индексы.Добавить("ИмяТабличнойЧасти, НомерСтроки");
		
		// замена признака реквизита на признак табличной части в составе полей
		Для Каждого ИмяТЧ Из МассивПустыхПодписанныхТЧ Цикл
			СтрокаТЧ = СоставПодписи.Найти(ИмяТЧ, "ИмяРеквизита");
			Если СтрокаТЧ <> Неопределено Тогда
				СтрокаТЧ.ИмяТабличнойЧасти = ИмяТЧ;
				СтрокаТЧ.ИмяРеквизита = "";
			КонецЕсли;
		КонецЦикла;
		
		ТекущиеЗначенияРеквизитов = ЗначенияРеквизитовОбъектаПоСоставу(ДокументСсылка, СоставПодписи, Параметры, ,
			СтрокаПодписи, Новый Массив);
		
		Если МодульОценкаПроизводительности <> Неопределено Тогда
			МодульОценкаПроизводительности.ЗафиксироватьЗамерДлительнойОперации(
				ОписаниеЗамера, 1, "ПолучениеТекущихДанных", ПредставлениеДокумента);
		КонецЕсли;
		
		ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти", "");
		ПроверяемыеРеквизиты = СоставПодписи.Скопировать(ОтборРеквизитов, "ИмяРеквизита, СоставСвойствРеквизита");
		
		Для Каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
			
			ПодписанноеЗначение = ПодписанныеЗначенияРеквизитов[ТекРеквизит.ИмяРеквизита];
			ТекущееЗначение = Неопределено;
			
			Если ТекРеквизит.СоставСвойствРеквизита.Количество() = 0 Тогда
				Если ТекущиеЗначенияРеквизитов.Свойство(ТекРеквизит.ИмяРеквизита, ТекущееЗначение)
					И НЕ СокрП(ПодписанноеЗначение) = СокрП(XMLСтрока(ТекущееЗначение)) Тогда
					ОписаниеОшибки = ОписаниеОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
						|- Поле ""%1"": подписанное значение ""%2"" <-> текущее значение ""%3""'"),
						ТекРеквизит.ИмяРеквизита,
						СокрП(ПодписанноеЗначение),
						СокрП(XMLСтрока(ТекущееЗначение)));
				КонецЕсли;
			Иначе
				Если ТекущиеЗначенияРеквизитов.Свойство(ТекРеквизит.ИмяРеквизита, ТекущееЗначение) Тогда
					// ожидается, что ПодписанноеЗначение имеет тип Структура. Если тип Строка, то было сохранено значение Неопределено
					Если ТипЗнч(ПодписанноеЗначение) = Тип("Строка") Тогда
						Если ТекущееЗначение <> Неопределено Тогда
							ОписаниеОшибки = ОписаниеОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
								|- Поле ""%1"": подписанное значение ""%2"" <-> текущее значение ""%3""'"),
								ТекРеквизит.ИмяРеквизита,
								"Неопределено",
								СокрП(XMLСтрока(ТекущееЗначение)));
						КонецЕсли;
					Иначе
						ПроверитьСоответствиеПодписанныхИТекущихДанныхПоСоставуСвойств(ТекРеквизит.СоставСвойствРеквизита,
							ПодписанноеЗначение, ТекущееЗначение, ТекРеквизит.ИмяРеквизита, ОписаниеОшибки);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаТЧ = СоставПодписи.Скопировать(,"ИмяТабличнойЧасти");
		ТаблицаТЧ.Свернуть("ИмяТабличнойЧасти");
		МассивТЧ = ТаблицаТЧ.ВыгрузитьКолонку("ИмяТабличнойЧасти");
		
		Для Каждого ТекТЧ Из МассивТЧ Цикл
			
			Если ПустаяСтрока(ТекТЧ) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ПодписанныеЗначенияРеквизитов.Свойство(ТекТЧ) Тогда
				Продолжить;
			КонецЕсли;
			
			ПодписаннаяТЧ = ПодписанныеЗначенияРеквизитов[ТекТЧ];
			ТекущаяТЧ = Неопределено;
			
			Если ТекущиеЗначенияРеквизитов.Свойство(ТекТЧ, ТекущаяТЧ) Тогда
				Если НЕ ТипЗнч(ПодписаннаяТЧ) = Тип("Массив") Тогда
					Если ТекущаяТЧ.Количество() > 0 Тогда
						ОписаниеОшибки = ОписаниеОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
							|- Изменено количество строк в табличной части ""%1"": в подписанных данных 0 строк <-> в текущих данных %2 строк(а)'"),
							ТекТЧ,
							ТекущаяТЧ.Количество());
					КонецЕсли;
				ИначеЕсли НЕ ПодписаннаяТЧ.Количество() = ТекущаяТЧ.Количество() Тогда
					ОписаниеОшибки = ОписаниеОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
						|- Изменено количество строк в табличной части ""%1"": в подписанных данных %2 строк(а) <-> в текущих данных %3 строк(а)'"),
						ТекТЧ,
						ПодписаннаяТЧ.Количество(),
						ТекущаяТЧ.Количество());
				Иначе
					Для Индекс = 0 По ПодписаннаяТЧ.ВГраница() Цикл
						
						ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти, НомерСтроки", ТекТЧ, Индекс + 1);
						ПроверяемыеРеквизиты = СоставПодписи.НайтиСтроки(ОтборРеквизитов);
						
						Для Каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
							
							Если ПустаяСтрока(ТекРеквизит.ИмяРеквизита) Тогда
								Продолжить;
							КонецЕсли;
							
							ПодписанноеЗначение = ПодписаннаяТЧ[Индекс][ТекРеквизит.ИмяРеквизита];
							ТекущееЗначение = Неопределено;
							
							Если ТекРеквизит.СоставСвойствРеквизита.Количество() = 0 Тогда
								Если ТекущаяТЧ[Индекс].Свойство(ТекРеквизит.ИмяРеквизита, ТекущееЗначение)
									И НЕ СокрП(ПодписанноеЗначение) = СокрП(XMLСтрока(ТекущееЗначение)) Тогда
									ОписаниеОшибки = ОписаниеОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
										|- Поле ""%1""[строка номер %2].""%3"": подписанное значение ""%4"" <-> текущее значение ""%5""'"),
										ТекТЧ,
										Индекс + 1,
										ТекРеквизит.ИмяРеквизита,
										СокрП(ПодписанноеЗначение),
										СокрП(XMLСтрока(ТекущееЗначение)));
								КонецЕсли;
							Иначе
								Если ТекущаяТЧ[Индекс].Свойство(ТекРеквизит.ИмяРеквизита, ТекущееЗначение) Тогда
									// ожидается, что ПодписанноеЗначение имеет тип Структура. Если тип Строка, то было сохранено значение Неопределено
									Если ТипЗнч(ПодписанноеЗначение) = Тип("Строка") Тогда
										Если ТекущееЗначение <> Неопределено Тогда
											ОписаниеОшибки = ОписаниеОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
												|- Поле ""%1""[строка номер %2].""%3"": подписанное значение ""%4"" <-> текущее значение ""%5""'"),
												ТекТЧ,
												Индекс + 1,
												ТекРеквизит.ИмяРеквизита,
												"Неопределено",
												СокрП(XMLСтрока(ТекущееЗначение)));
										КонецЕсли;
									Иначе
										ПроверитьСоответствиеПодписанныхИТекущихДанныхПоСоставуСвойств(ТекРеквизит.СоставСвойствРеквизита,
											ПодписанноеЗначение, ТекущееЗначение, ТекТЧ+"[строка номер "+(Индекс + 1)+"]."+ТекРеквизит.ИмяРеквизита, ОписаниеОшибки);
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если МодульОценкаПроизводительности <> Неопределено Тогда
			МодульОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(
				ОписаниеЗамера, 1, "СравнениеПодписанныхИТекущихДанных", ПредставлениеДокумента);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ОписаниеОшибки) Тогда
			Если СтрокаПодписи.Свойство("ДатаПодписи") И СтрокаПодписи.Свойство("КомуВыданСертификат") Тогда
				СтрокаПодписи.ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Подписанные данные (подпись от %1, автор %2, этап ""%3"") отличаются от текущих:%4'"),
					СтрокаПодписи.ДатаПодписи,
					СтрокаПодписи.КомуВыданСертификат,
					СтрокаПодписи.Этап,
					ОписаниеОшибки);
			Иначе
				СтрокаПодписи.ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Подписанные при выполнении этапа ""%1"" данные отличаются от текущих:%2'"),
					СтрокаПодписи.Этап,
					ОписаниеОшибки);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеБлокировкойЭлементовФормы(Форма, ЭлементыФормы, Заблокировать) Экспорт
	
	Для Каждого Элемент Из ЭлементыФормы Цикл
		ЭлементФормы = Форма.Элементы.Найти(Элемент);
		Если ЭлементФормы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТипЭлементаФормы = ТипЗнч(ЭлементФормы);
		Если ТипЭлементаФормы = Тип("ПолеФормы")
			И ЭлементФормы.Вид <> ВидПоляФормы.ПолеНадписи Тогда
			ЭлементФормы.ТолькоПросмотр = Заблокировать;
			Если ЭлементФормы.Вид = ВидПоляФормы.ПолеТабличногоДокумента Тогда
				ЭлементФормы.Защита = Заблокировать;
			КонецЕсли;
		ИначеЕсли ТипЭлементаФормы = Тип("ТаблицаФормы") Тогда
			ЭлементФормы.ИзменятьСоставСтрок = НЕ Заблокировать;
			ЭлементФормы.ИзменятьПорядокСтрок = НЕ Заблокировать;
		ИначеЕсли ТипЭлементаФормы = Тип("ГруппаФормы")
			И ЭлементФормы.Вид = ВидГруппыФормы.Страница Тогда
			ЭлементФормы.ТолькоПросмотр = Заблокировать;
		Иначе
			ЭлементФормы.Доступность = НЕ Заблокировать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДеревоРеквизитовПоИдентификатору(Дерево, ИдентификаторДокумента) Экспорт
	
	Корень = Дерево.Строки.Добавить();
	Корень.Представление = "Реквизиты шапки";
	Корень.НомерКартинки = 0;
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	
	Для Каждого Реквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
		
		Если НепроверяемыйРеквизит(Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаДерева = Корень.Строки.Добавить();
		СтрокаДерева.ИмяРеквизита = Реквизит.Имя;
		СтрокаДерева.Представление = Реквизит.Имя;
		СтрокаДерева.НомерКартинки = 1;
		
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		
		Если НепроверяемыйРеквизит(Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаДерева = Корень.Строки.Добавить();
		СтрокаДерева.ИмяРеквизита = Реквизит.Имя;
		Если ПустаяСтрока(Реквизит.Синоним) Тогда
			СтрокаДерева.Представление = Реквизит.Имя;
		Иначе
			СтрокаДерева.Представление = Реквизит.Синоним + " ["+Реквизит.Имя+"]";
		КонецЕсли;
		СтрокаДерева.НомерКартинки = 1;
		
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		
		Корень = Дерево.Строки.Добавить();
		Корень.ИмяТабличнойЧасти = ТабличнаяЧасть.Имя;
		Если ПустаяСтрока(ТабличнаяЧасть.Синоним) Тогда
			Корень.Представление = ТабличнаяЧасть.Имя;
		Иначе
			Корень.Представление = ТабличнаяЧасть.Синоним + " ["+ТабличнаяЧасть.Имя+"]";
		КонецЕсли;
		Корень.НомерКартинки = 2;
		
		Для Каждого Реквизит Из ТабличнаяЧасть.СтандартныеРеквизиты Цикл
			
			Если НепроверяемыйРеквизит(Реквизит.Имя) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаДерева = Корень.Строки.Добавить();
			СтрокаДерева.ИмяТабличнойЧасти = ТабличнаяЧасть.Имя;
			СтрокаДерева.ИмяРеквизита = Реквизит.Имя;
			СтрокаДерева.Представление = Реквизит.Имя;
			СтрокаДерева.НомерКартинки = 1;
			
		КонецЦикла;
		
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			
			Если НепроверяемыйРеквизит(Реквизит.Имя) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаДерева = Корень.Строки.Добавить();
			СтрокаДерева.ИмяТабличнойЧасти = ТабличнаяЧасть.Имя;
			СтрокаДерева.ИмяРеквизита = Реквизит.Имя;
			Если ПустаяСтрока(Реквизит.Синоним) Тогда
				СтрокаДерева.Представление = Реквизит.Имя;
			Иначе
				СтрокаДерева.Представление = Реквизит.Синоним + " ["+Реквизит.Имя+"]";
			КонецЕсли;
			СтрокаДерева.НомерКартинки = 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Выполняет проверку того, что задачи в данный момент никем не выполняются и устанавливает
// исключительную управляемую блокировку на регистр сведений "СоставПачекВыполняемыхЗадач" по измерению "Задача".
//
// Параметры:
//   Задачи - Массив - задачи, которые необоходимо проверить и заблокировать выполнение.
//
Процедура ПроверитьИЗаблокироватьЗадачиОтВыполнения(Задачи) Экспорт
	
	Блокировка = Новый БлокировкаДанных;
	Если ТипЗнч(Задачи) = Тип("Массив") Тогда
		Для Каждого Задача Из Задачи Цикл
			Если ТипЗнч(Задача) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда 
				Продолжить;
			КонецЕсли;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СоставПачекВыполняемыхЗадач");
			ЭлементБлокировки.УстановитьЗначение("Задача", Задача);
		КонецЦикла;
	Иначе
		Если ТипЗнч(Задачи) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Возврат;
		КонецЕсли;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СоставПачекВыполняемыхЗадач");
		ЭлементБлокировки.УстановитьЗначение("Задача", Задачи);
	КонецЕсли;
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(СоставПачекВыполняемыхЗадач.Задача) КАК Задача
	|ИЗ
	|	РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
	|ГДЕ
	|	СоставПачекВыполняемыхЗадач.Задача В(&Задачи)";
	Запрос.УстановитьПараметр("Задачи", Задачи);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		ЗадачиСтрокой = Новый Массив;
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗадачиСтрокой.Добавить(Выборка.Задача);
		КонецЦикла;
		
		ВызватьИсключение НСтр("ru = 'В данный момент уже выполняются задачи:
		|'") + СтрСоединить(ЗадачиСтрокой, Символы.ПС);
		
	КонецЕсли;
	
КонецПроцедуры

// Снимает признак выполняемости всех задач в пачке.
//
// Параметры:
//   ИдентификаторПачки - УникальныйИдентификатор - Идентификатор пачки выполняемых задач, которые требуется освободить.
Процедура ОтметитьЗадачиВПачкеКакНевыполняемые(ИдентификаторПачки) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СоставПачекВыполняемыхЗадач.Задача КАК Задача
		|ИЗ
		|	РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
		|ГДЕ
		|	СоставПачекВыполняемыхЗадач.ИдентификаторПачки = &ИдентификаторПачки";
		
		Запрос.УстановитьПараметр("ИдентификаторПачки", ИдентификаторПачки);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		МенеджерЗаписи = РегистрыСведений.ПачкиВыполняемыхЗадач.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторПачки = ИдентификаторПачки;
		МенеджерЗаписи.Удалить();
		
		МенеджерЗаписи = РегистрыСведений.СоставПачекВыполняемыхЗадач.СоздатьМенеджерЗаписи();
		Пока Выборка.Следующий() Цикл
			МенеджерЗаписи.Задача = Выборка.Задача;
			МенеджерЗаписи.Удалить();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Снимает признак выполняемости задач.
//
// Параметры:
//   Задачи - Массив - массив ссылок на задачи, которые требуется освободить.
Процедура ОтметитьЗадачиКакНевыполняемые(Задачи) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		// Получение массива идентификаторов пачек для установки даты обновления
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СоставПачекВыполняемыхЗадач.ИдентификаторПачки КАК ИдентификаторПачки
		|ИЗ
		|	РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
		|ГДЕ
		|	СоставПачекВыполняемыхЗадач.Задача В(&Задачи)";
		
		Запрос.УстановитьПараметр("Задачи", Задачи);
		
		ПачкиВыполняемыхЗадач = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторПачки");
		
		Для Каждого Задача Из Задачи Цикл
			МенеджерЗаписи = РегистрыСведений.СоставПачекВыполняемыхЗадач.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Задача = Задача;
			МенеджерЗаписи.Удалить();
		КонецЦикла;
		
		ОбновитьДатуОбновленияПачекВыполняемыхЗадач(ПачкиВыполняемыхЗадач);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПодготовитьПараметрыПередВыполнениемЗадачВФоне(Контекст) Экспорт
	
	Контекст.Вставить("ОповещатьОПрогрессе", Истина);
	
	ЗаменитьАдресаВременногоХранилищаНаЗначения(Контекст);
	
КонецПроцедуры

Процедура ПроверитьСостояниеВыполняемыхЗадач() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПачкиВыполняемыхЗадач.ИдентификаторПачки КАК ИдентификаторПачки,
	|	ПачкиВыполняемыхЗадач.ДатаПоследнегоОбновления КАК ДатаПоследнегоОбновления
	|ИЗ
	|	РегистрСведений.ПачкиВыполняемыхЗадач КАК ПачкиВыполняемыхЗадач";
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Наименование", "ПроцессыОбработкиДокументов.ВыполнитьЗадачи");
	
	УстановитьПривилегированныйРежим(Истина);
	МассивФоновыйЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	УстановитьПривилегированныйРежим(Ложь);
	
	КлючиАктивныхЗаданий = Новый Массив;
	КлючиНеактивныхЗаданий = Новый Массив;
	
	Для Каждого ФоновоеЗадание Из МассивФоновыйЗаданий Цикл
		Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			КлючиАктивныхЗаданий.Добавить(ФоновоеЗадание.Ключ);
		Иначе
			КлючиНеактивныхЗаданий.Добавить(ФоновоеЗадание.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	ВремяОжидания = ВремяОжиданияВыполненияЗадачи();
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		// Если есть неактивное фоновое задание, то признак выполняемости задач для таких заданий сбрасывается
		Если КлючиНеактивныхЗаданий.Найти(Строка(Выборка.ИдентификаторПачки)) <> Неопределено Тогда
			ОтметитьЗадачиВПачкеКакНевыполняемые(Выборка.ИдентификаторПачки);
		// Если нет активного фонового задания и время ожидания превышено, то признак выполняемости сбрасывается
		ИначеЕсли КлючиАктивныхЗаданий.Найти(Строка(Выборка.ИдентификаторПачки)) = Неопределено
			И Выборка.ДатаПоследнегоОбновления < ТекущаяДатаСеанса() - ВремяОжидания Тогда
			ОтметитьЗадачиВПачкеКакНевыполняемые(Выборка.ИдентификаторПачки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция РабочееВремяМеждуДатами(ДатаОт, ДатаДо, Параметры, ИнтервалыРабочегоВремени = Неопределено) Экспорт
	
	Если НЕ Константы.ИспользоватьГрафикиРаботы.Получить() Тогда
		Возврат ДатаДо - ДатаОт;
	КонецЕсли;
	
	РабочееВремяВСекундах = 0;
	
	Если ИнтервалыРабочегоВремени = Неопределено Тогда
		
		РеквизитыАдресации = Новый Структура("Исполнитель, РольИсполнителя, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации");
		ЗаполнитьЗначенияСвойств(РеквизитыАдресации, Параметры);
		
		СтандартнаяОбработка = Истина;
		
		ГрафикРаботы = ГрафикРаботыИсполнителя(РеквизитыАдресации, СтандартнаяОбработка);
		
		Если СтандартнаяОбработка И Не ЗначениеЗаполнено(ГрафикРаботы) Тогда
			Возврат 0;
		КонецЕсли;
		
		ИнтервалыРабочегоВремени = РасписаниеРаботыНаПериод(ГрафикРаботы, ДатаОт, ДатаДо, СтандартнаяОбработка);
		
	КонецЕсли;
	
	Для Каждого Интервал Из ИнтервалыРабочегоВремени Цикл
		
		Если ДатаОт > Интервал.ДатаОкончания Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДатаДо < Интервал.ДатаНачала Тогда
			Продолжить;
		КонецЕсли;
		
		Длительность = Интервал.Длительность;
		
		Если ДатаОт > Интервал.ДатаНачала Тогда
			Длительность = Длительность - (ДатаОт - Интервал.ДатаНачала);
		КонецЕсли;
		
		Если ДатаДо < Интервал.ДатаОкончания Тогда
			Длительность = Длительность - (Интервал.ДатаОкончания - ДатаДо);
		КонецЕсли;
		
		РабочееВремяВСекундах = РабочееВремяВСекундах + Длительность;
		
	КонецЦикла;
	
	Возврат РабочееВремяВСекундах;
	
КонецФункции

// Выполняет рассылку уведомлений исполнителям о новых задачах за период с момента предыдущей рассылки.
// Рассылка выполняется по почте от имени системной учетной записи.
// Также является обработчиком регламентного задания УведомлениеОНовыхЗадачахПоОбработкеДокументов.
//
Процедура УведомитьОНовыхЗадачахПоОбработкеДокументов() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.УведомлениеОНовыхЗадачахПоОбработкеДокументов);
	
	ОписаниеОшибки = "";
	ВидСообщения = НСтр("ru = 'Процессы обработки документов.Уведомление о новых задачах'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если НЕ СистемнаяУчетнаяЗаписьНастроена(ОписаниеОшибки) Тогда
		ЗаписьЖурналаРегистрации(ВидСообщения, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегламентныеЗадания.УведомлениеОНовыхЗадачахПоОбработкеДокументов,, ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ДатаУведомления = ТекущаяДатаСеанса();
	ДатаПоследнегоУведомления = Константы.ДатаУведомленияОНовыхЗадачахПоОбработкеДокументов.Получить();
	
	// Если оповещение ранее не производилось, или последнее оповещение происходило
	// ранее, чем за сутки, то отбираем новые задачи за последние сутки.
	Если (ДатаПоследнегоУведомления = '00010101000000') 
		Или (ДатаУведомления - ДатаПоследнегоУведомления > 24*60*60) Тогда
		ДатаПоследнегоУведомления = ДатаУведомления - 24*60*60;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ВидСообщения, УровеньЖурналаРегистрации.Информация,,,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Начато регламентное уведомление о новых задачах за период %1 - %2'"),
		ДатаПоследнегоУведомления, ДатаУведомления));
	
	АдресИБВЛокальнойСети = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети();
	АдресИБВИнтернет = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВИнтернете();
	
	ПараметрыРассылки = Новый Структура;
	ПараметрыРассылки.Вставить("АдресИБВЛокальнойСети", АдресИБВЛокальнойСети);
	ПараметрыРассылки.Вставить("АдресИБВИнтернет", АдресИБВИнтернет);
	
	ЗадачиПоИсполнителям = ВыбратьНовыеЗадачиПоИсполнителям(ДатаПоследнегоУведомления, ДатаУведомления);
	Для Каждого СтрокаИсполнителя Из ЗадачиПоИсполнителям.Строки Цикл
		ОтправитьУведомлениеОНовыхЗадачах(СтрокаИсполнителя.Исполнитель, СтрокаИсполнителя, ПараметрыРассылки);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	Константы.ДатаУведомленияОНовыхЗадачахПоОбработкеДокументов.Установить(ДатаУведомления);
	УстановитьПривилегированныйРежим(Ложь);
	
	ЗаписьЖурналаРегистрации(ВидСообщения, УровеньЖурналаРегистрации.Информация,,,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Завершено регламентное уведомление о новых задачах (уведомлено исполнителей: %1)'"),
		ЗадачиПоИсполнителям.Строки.Количество()));
	
КонецПроцедуры

// Выполняет заполнение значений дополнительных колонок задач по всем типам документов,
// записанным в регистре сведений ОчередьЗаполненияДополнительныхКолонокЗадач
//
// В конце процедуры производится провека наличия записей в регистре, и, если их нет, то выполняется
// отключение регламентного задания
//
Процедура ЗаполнениеДополнительныхКолонокЗадач() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ЗаполнениеДополнительныхКолонокЗадач);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Очередь.Колонка КАК Колонка,
	|	Очередь.ИдентификаторДокумента КАК ИдентификаторДокумента
	|ИЗ
	|	РегистрСведений.ОчередьЗаполненияДополнительныхКолонокЗадач КАК Очередь";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗапросПутьКЗначению = Новый Запрос;
		ЗапросПутьКЗначению.Текст =
		"ВЫБРАТЬ
		|	ПутиКЗначениямДополнительныхКолонокЗадач.ПутьКЗначению КАК ПутьКЗначению
		|ИЗ
		|	РегистрСведений.ПутиКЗначениямДополнительныхКолонокЗадач КАК ПутиКЗначениямДополнительныхКолонокЗадач
		|ГДЕ
		|	ПутиКЗначениямДополнительныхКолонокЗадач.Колонка = &Колонка
		|	И ПутиКЗначениямДополнительныхКолонокЗадач.ИдентификаторДокумента = &ИдентификаторДокумента";
		
		ЗапросПутьКЗначению.УстановитьПараметр("Колонка", Выборка.Колонка);
		ЗапросПутьКЗначению.УстановитьПараметр("ИдентификаторДокумента", Выборка.ИдентификаторДокумента);
		
		ВыборкаПутьКЗначению = ЗапросПутьКЗначению.Выполнить().Выбрать();
		
		Если ВыборкаПутьКЗначению.Следующий() И ЗначениеЗаполнено(ВыборкаПутьКЗначению.ПутьКЗначению) Тогда
			
			ЗапросПоДокументам = ЗапросДляЗаполненияДополнительнойКолонки(
				Выборка.Колонка, Выборка.ИдентификаторДокумента, ВыборкаПутьКЗначению.ПутьКЗначению, 1000);
			
			Пока Истина Цикл
				
				ВыборкаПоДокументам = ЗапросПоДокументам.Выполнить().Выбрать();
				
				Если ВыборкаПоДокументам.Количество() = 0 Тогда
					Прервать;
				КонецЕсли;
				
				НачатьТранзакцию();
				Попытка
					
					Пока ВыборкаПоДокументам.Следующий() Цикл
						МенеджерЗаписи = РегистрыСведений.ЗначенияДополнительныхКолонокЗадач.СоздатьМенеджерЗаписи();
						МенеджерЗаписи.Колонка = Выборка.Колонка;
						МенеджерЗаписи.Предмет = ВыборкаПоДокументам.Предмет;
						МенеджерЗаписи.Значение = ВыборкаПоДокументам.Значение;
						МенеджерЗаписи.Записать();
					КонецЦикла;
					
					ЗафиксироватьТранзакцию();
				Исключение
					ОтменитьТранзакцию();
					ЗаписьЖурналаРегистрации(
						НСтр("ru = 'Заполнение значений дополнительных колонок задач'", ОбщегоНазначения.КодОсновногоЯзыка()),
						УровеньЖурналаРегистрации.Ошибка,,,
						ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					Прервать;
				КонецПопытки;
				
				Если ВыборкаПоДокументам.Количество() < 1000 Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			ЗапросПоДокументам = ЗапросДляОчисткиДополнительнойКолонки(
				Выборка.Колонка, Выборка.ИдентификаторДокумента, 1000);
			
			Пока Истина Цикл
				
				ВыборкаПоДокументам = ЗапросПоДокументам.Выполнить().Выбрать();
				
				Если ВыборкаПоДокументам.Количество() = 0 Тогда
					Прервать;
				КонецЕсли;
				
				НачатьТранзакцию();
				Попытка
					
					Пока ВыборкаПоДокументам.Следующий() Цикл
						МенеджерЗаписи = РегистрыСведений.ЗначенияДополнительныхКолонокЗадач.СоздатьМенеджерЗаписи();
						МенеджерЗаписи.Колонка = Выборка.Колонка;
						МенеджерЗаписи.Предмет = ВыборкаПоДокументам.Предмет;
						МенеджерЗаписи.Удалить();
					КонецЦикла;
					
					ЗафиксироватьТранзакцию();
				Исключение
					ОтменитьТранзакцию();
					ЗаписьЖурналаРегистрации(
						НСтр("ru = 'Очистка значений дополнительных колонок задач'", ОбщегоНазначения.КодОсновногоЯзыка()),
						УровеньЖурналаРегистрации.Ошибка,,,
						ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					Прервать;
				КонецПопытки;
				
				Если ВыборкаПоДокументам.Количество() < 1000 Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// Попытка очистки очереди, если все значения документов соответствуют текущей настройке путей
		НачатьТранзакцию();
		Попытка
			
			ЗаблокироватьРегистрОчередьЗаполненияДополнительныхКолонокЗадач(
				Выборка.Колонка, Выборка.ИдентификаторДокумента);
			
			ВыборкаПутьКЗначению = ЗапросПутьКЗначению.Выполнить().Выбрать();
			
			Если ВыборкаПутьКЗначению.Следующий() И ЗначениеЗаполнено(ВыборкаПутьКЗначению.ПутьКЗначению) Тогда
				ЗапросПоДокументам = ЗапросДляЗаполненияДополнительнойКолонки(
					Выборка.Колонка, Выборка.ИдентификаторДокумента, ВыборкаПутьКЗначению.ПутьКЗначению, 1);
			Иначе
				ЗапросПоДокументам = ЗапросДляОчисткиДополнительнойКолонки(
					Выборка.Колонка, Выборка.ИдентификаторДокумента, 1);
			КонецЕсли;
			
			Если ЗапросПоДокументам.Выполнить().Пустой() Тогда
				НаборЗаписей = РегистрыСведений.ОчередьЗаполненияДополнительныхКолонокЗадач.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Колонка.Установить(Выборка.Колонка);
				НаборЗаписей.Отбор.ИдентификаторДокумента.Установить(Выборка.ИдентификаторДокумента);
				НаборЗаписей.Записать();
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Очистка очереди заполнения дополнительных колонок задач'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	// Отключение регламентного задания, если в очереди больше нет записей
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьРегистрОчередьЗаполненияДополнительныхКолонокЗадач();
		
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Очередь.Колонка КАК Колонка
		|ИЗ
		|	РегистрСведений.ОчередьЗаполненияДополнительныхКолонокЗадач КАК Очередь";
		
		Если Запрос.Выполнить().Пустой() Тогда
			
			РегламентноеЗадание = НайтиРегламентноеЗадание("ЗаполнениеДополнительныхКолонокЗадач");
			
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("Использование", Ложь);
			
			РегламентныеЗаданияСервер.ИзменитьЗадание(РегламентноеЗадание, ПараметрыЗадания);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Отключение регламентного задания при отсутствии документов в очереди'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		// Обработка исключения не требуется, вероятно, в данный момент производится запись колонки,
		// регламентное задание будет запущено повторно
	КонецПопытки;
	
КонецПроцедуры

Процедура ПриСозданииНаСервереФормыНастроекРегламентированногоОтчета(Форма, Параметры) Экспорт
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриСозданииНаСервереФормыНастроекРегламентированногоОтчета(Форма, Параметры);
	
КонецПроцедуры

Процедура ПриИнициализацииФормыПечатиРегламентированныхОтчетов(Форма, ДеревоЛистов) Экспорт
	
