Процедура СоздатьКнопкиСКомандамиРезультатовВыполнения(Форма, ИмяГруппы = "Этапы") Экспорт
	
	ИспользуетсяУсиленнаяЭП = ПолучитьФункциональнуюОпцию("ИспользоватьЭППриВыполненииЭтапов");
	ИспользуетсяПростаяЭП = ПолучитьФункциональнуюОпцию("ИспользоватьПростыеЭППриВыполненииЭтапов");
	
	Форма.ТаблицаКоманд.Очистить();
	
	ГруппаЭтапы = Форма.Элементы.Найти(ИмяГруппы);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка КАК Ссылка,
	|	ЭтапыПроцессовРезультатыВыполнения.ПредставлениеРезультата КАК ПредставлениеРезультата,
	|	ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения КАК СтатусПослеВыполнения,
	|	ЭтапыПроцессовРезультатыВыполнения.ОтрицательныйРезультат КАК ОтрицательныйРезультат,
	|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяЭП КАК ТребуетсяЭП,
	|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяПростаяЭП КАК ТребуетсяПростаяЭП
	|ИЗ
	|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|ГДЕ
	|	НЕ ЭтапыПроцессовРезультатыВыполнения.Скрытый
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтрицательныйРезультат,
	|	ЭтапыПроцессовРезультатыВыполнения.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		ИдентификаторЭтапа = СтрЗаменить(XMLСтрока(Выборка.Ссылка), "-", "_");
		
		ВыборкаРезультатыВыполнения = Выборка.Выбрать();
		Пока ВыборкаРезультатыВыполнения.Следующий() Цикл
			
			ДляВыполненияЭтапаТребуетсяУсиленнаяЭП = ВыборкаРезультатыВыполнения.ТребуетсяЭП И ИспользуетсяУсиленнаяЭП;
			ДляВыполненияЭтапаТребуетсяПростаяЭП = ВыборкаРезультатыВыполнения.ТребуетсяПростаяЭП И ИспользуетсяПростаяЭП;
			ДляВыполненияЭтапаТребуетсяЭП = ДляВыполненияЭтапаТребуетсяУсиленнаяЭП ИЛИ ДляВыполненияЭтапаТребуетсяПростаяЭП;
			
			ИдентификаторКоманды = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "_");
			
			ИмяКоманды = "Этап" + ИдентификаторЭтапа + ИдентификаторКоманды;
			
			ГруппаРезультатВыполнения = Форма.Элементы.Найти(ИмяКоманды);
			Если ГруппаРезультатВыполнения = Неопределено Тогда
				ГруппаРезультатВыполнения = Форма.Элементы.Добавить(ИмяКоманды, Тип("ГруппаФормы"), ГруппаЭтапы);
			КонецЕсли;
			ГруппаРезультатВыполнения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаРезультатВыполнения.Отображение = ОтображениеОбычнойГруппы.Нет;
			ГруппаРезультатВыполнения.ОтображатьЗаголовок = Ложь;
			
			НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Действие = "Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента";
			НоваяКоманда.Заголовок = ВыборкаРезультатыВыполнения.ПредставлениеРезультата;
			Если ДляВыполненияЭтапаТребуетсяУсиленнаяЭП Тогда
				НоваяКоманда.Картинка = БиблиотекаКартинок.ПодписанЭП;
			ИначеЕсли ДляВыполненияЭтапаТребуетсяПростаяЭП Тогда
				НоваяКоманда.Картинка = БиблиотекаКартинок.ПодписанПростойЭП;
			КонецЕсли;
			НоваяКоманда.Отображение = ?(ДляВыполненияЭтапаТребуетсяЭП,
									ОтображениеКнопки.КартинкаИТекст,
									ОтображениеКнопки.Авто);
			
			НоваяКнопка = Форма.Элементы.Добавить("Кнопка"+ИмяКоманды,
											Тип("КнопкаФормы"),
											ГруппаРезультатВыполнения);
			НоваяКнопка.Заголовок = ВыборкаРезультатыВыполнения.ПредставлениеРезультата;
			НоваяКнопка.ЦветТекста = ?(ВыборкаРезультатыВыполнения.ОтрицательныйРезультат,
									WebЦвета.Кирпичный,
									WebЦвета.Зеленый);
			НоваяКнопка.Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,,,Истина);
			НоваяКнопка.Видимость = Ложь;
			
			НоваяКнопка.ИмяКоманды = ИмяКоманды;
			
			СвойстваКоманды 					= Форма.ТаблицаКоманд.Добавить();
			СвойстваКоманды.ИмяКоманды 			= НоваяКнопка.ИмяКоманды;
			СвойстваКоманды.ИмяКнопки 			= НоваяКнопка.Имя;
			СвойстваКоманды.Этап 				= Выборка.Ссылка;
			СвойстваКоманды.Статус 				= ВыборкаРезультатыВыполнения.СтатусПослеВыполнения;
			СвойстваКоманды.ТребуетсяЭП 		= ДляВыполненияЭтапаТребуетсяУсиленнаяЭП;
			СвойстваКоманды.ТребуетсяПростаяЭП 	= ДляВыполненияЭтапаТребуетсяПростаяЭП;
			СвойстваКоманды.Отрицательная 		= ВыборкаРезультатыВыполнения.ОтрицательныйРезультат;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьКнопкиСКомандамиРезультатовВыполнения(Форма) Экспорт
	
	ИменаКомандШаблонаПроцесса = "";
	МассивКомандКУдалению = Новый Массив;
	МассивКнопокКУдалению = Новый Массив;
	МассивГруппКУдалению = Новый Массив;
	
	Для Каждого КомандаФормы Из Форма.Команды Цикл
		Если КомандаФормы.Действие = "Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента"
			И НЕ КомандаФормы.Имя = "КарточкаПроцессаДокумента"
			И НЕ КомандаФормы.Имя = "ПоказатьКомментарийНаправившего"
			И НЕ КомандаФормы.Имя = "ПоказатьКомментарийСледующему" Тогда
			ИменаКомандШаблонаПроцесса = ИменаКомандШаблонаПроцесса+КомандаФормы.Имя;
			МассивКомандКУдалению.Добавить(КомандаФормы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из Форма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы")
			И ИменаКомандШаблонаПроцесса <> ""
			И Элемент.ИмяКоманды <> ""
			И СтрНайти(ИменаКомандШаблонаПроцесса,Элемент.ИмяКоманды) > 0 Тогда
			
			МассивКнопокКУдалению.Добавить(Элемент);
			
			Если МассивГруппКУдалению.Найти(Элемент.Родитель) = Неопределено Тогда
				МассивГруппКУдалению.Добавить(Элемент.Родитель);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КнопкаФормы Из МассивКнопокКУдалению Цикл
		Форма.Элементы.Удалить(КнопкаФормы);
	КонецЦикла;
	Для Каждого ГруппаФормы Из МассивГруппКУдалению Цикл
		Форма.Элементы.Удалить(ГруппаФормы);
	КонецЦикла;
