	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.ИдентификаторыКомандПечатиСоШтампом = Выборка.ИдентификаторыКомандПечатиСоШтампом;
		Результат.КодыНастройкиФормированияИПодписанияФормуляров = Выборка.КодыНастройкиФормированияИПодписанияФормуляров;
	КонецЕсли;	

	Возврат Результат;
КонецФункции	

Функция ПоследнийФормулярПервичногоДокументаДляПодписания(Документ, ИдентификаторПечатнойФормы, ИдентификаторЭтапа,
	Шаблон, КодВидаСведений, Расширение) Экспорт
	
	ДвоичныеДанные = Неопределено;
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументФормуляра", Неопределено);
	Результат.Вставить("ОсновнойФайлФормуляра", Неопределено);
	Результат.Вставить("ДвоичныеДанные", Неопределено);
	Результат.Вставить("Предмет", Неопределено);
	Результат.Вставить("ИдентификаторПечати", Неопределено);
	Результат.Вставить("ИдентификаторЭтапа", Неопределено);
	Результат.Вставить("КодВидаСведений", Неопределено);
	Результат.Вставить("Расширение", Неопределено);
	Результат.Вставить("НаименованиеДокумента", Неопределено);
	Результат.Вставить("НомерДокумента", Неопределено);
	Результат.Вставить("ДатаДокумента", Неопределено);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
	               |	ФайлыФормуляровЭДПОД.ВыполняемаяЗадача КАК ВыполняемаяЗадача,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ОсновнойФайл КАК ОсновнойФайлФормуляра,
	               |	ФайлыФормуляровЭДПОД.НаименованиеДокумента КАК НаименованиеДокумента,
	               |	ФайлыФормуляровЭДПОД.НомерДокумента КАК НомерДокумента,
	               |	ФайлыФормуляровЭДПОД.ДатаДокумента КАК ДатаДокумента
	               |ИЗ
	               |	РегистрСведений.ФайлыФормуляровЭДПОД КАК ФайлыФормуляровЭДПОД
	               |ГДЕ
	               |	ФайлыФормуляровЭДПОД.Предмет = &Предмет
	               |	И ФайлыФормуляровЭДПОД.ИдентификаторПечатнойФормы = &ИдентификаторПечатнойФормы
	               |	И НЕ ФайлыФормуляровЭДПОД.ИдентификаторЭтапа = &ИдентификаторЭтапа
	               |	И ФайлыФормуляровЭДПОД.КодВидаСведений = &КодВидаСведений
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ФайлыФормуляровЭДПОД.ДатаФормирования УБЫВ";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	Запрос.УстановитьПараметр("ИдентификаторПечатнойФормы", ИдентификаторПечатнойФормы);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	Запрос.УстановитьПараметр("КодВидаСведений", КодВидаСведений);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Задача = Задачи.ЗадачаПоОбработкеДокумента.ПустаяСсылка();
	
	Если Выборка.Следующий() Тогда
		Результат.ДокументФормуляра = Выборка.ДанныеПредставленияПервичногоДокумента;
		Результат.ОсновнойФайлФормуляра = Выборка.ОсновнойФайлФормуляра;
		Результат.ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.ОсновнойФайлФормуляра, Ложь);
		Результат.Предмет = Документ;
		Результат.ИдентификаторПечати = ИдентификаторПечатнойФормы;
		Результат.ИдентификаторЭтапа = ИдентификаторЭтапа;
		Результат.КодВидаСведений = КодВидаСведений;
		Результат.Расширение = Расширение;
		Результат.НаименованиеДокумента = Выборка.НаименованиеДокумента;
		Результат.НомерДокумента = Выборка.НомерДокумента;
		Результат.ДатаДокумента = Выборка.ДатаДокумента;
		
		Задача = Выборка.ВыполняемаяЗадача;
	КонецЕсли;

	Если ДвоичныеДанные = Неопределено Тогда
		
		Возврат Результат;
		
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ВизуализацияФормуляраПервичногоДокумента(Документ, Шаблон, ДанныеПредставленияПервичногоДокумента) Экспорт
	
	ДвоичныеДанные = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);

	Реквизиты = "ОсновнойФайл, ИдентификаторПечатнойФормы, ИдентификаторФормуляра, Предмет, Организация";
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПредставленияПервичногоДокумента, Реквизиты);
	
	ОсновнойФайлФормуляра = ЗначенияРеквизитов.ОсновнойФайл;
	ИдентификаторПечатнойФормы = ЗначенияРеквизитов.ИдентификаторПечатнойФормы;
	ИдентификаторФормуляра = ЗначенияРеквизитов.ИдентификаторФормуляра;
	
	ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ОсновнойФайлФормуляра, Ложь);

	Если ДвоичныеДанные = Неопределено Тогда
		
		Возврат Новый ТабличныйДокумент;
		
	КонецЕсли;

	ТабличныйДокумент = ПроцессыОбработкиДокументовВызовСервера.ТабличныйДокументПоДвоичнымДанным(ДвоичныеДанные);

	ПрисоединенныеФайлыФормуляраПервичногоДокумента = ПрисоединенныеФайлыФормуляраПервичногоДокумента(Документ, ИдентификаторФормуляра);
	ФайлPDF = ПрисоединенныеФайлыФормуляраПервичногоДокумента.ФайлPDF;
	
	ЭлектронныеПодписиДляШтампов = УстановленныеПодписиДляФормуляраПОД(ФайлPDF);

	Штампы = ШтампыДляТабличногоДокумента(ЭлектронныеПодписиДляШтампов);
			
	ДобавитьШтампыВТабличныйДокумент(
		Документ, Шаблон, ИдентификаторПечатнойФормы, ТабличныйДокумент, Штампы);
		
	Организация = ЗначенияРеквизитов.Организация;
	
	Если ПоддерживаетсяИнтеграцияСБЭД() Тогда
		ЭлектронныеПодписиВнешнегоЭД = ЭлектронныеПодписиВнешнегоЭДСвязанногоСВнутреннимЭД(ДанныеПредставленияПервичногоДокумента);
		
		Если ЭлектронныеПодписиВнешнегоЭД.Количество() > 0 Тогда
			ВыводитьДатуПодписи = Ложь;
			Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭППОД.Получить() = Истина 
				И ОтображатьДатуПодписанияПоОрганизации(Организация) Тогда
				ВыводитьДатуПодписи = Истина;
			КонецЕсли;
			
			ДобавитьШтампыЭлектронныхПодписейВнешнегоЭД(ТабличныйДокумент, 
				ЭлектронныеПодписиВнешнегоЭД, Организация, ВыводитьДатуПодписи);
		КонецЕсли;
	КонецЕсли;	

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ВизуализацияПредставленияЭлектронногоДокумента(Документ, ИдентификаторПечатнойФормы, ИдентификаторЭтапа,
	Шаблон, ПорядокТекущегоЭтапа) Экспорт
	
	ДвоичныеДанные = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФайлыПредставленияЭДПОД.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
	               |	ВЫРАЗИТЬ(ФайлыПредставленияЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ПредставлениеФормуляраПервичногоДокументаПОД).ОсновнойФайл КАК ОсновнойФайлФормуляра
	               |ИЗ
	               |	РегистрСведений.ФайлыПредставленияЭДПОД КАК ФайлыПредставленияЭДПОД
	               |ГДЕ
	               |	ФайлыПредставленияЭДПОД.Предмет = &Предмет
	               |	И ФайлыПредставленияЭДПОД.ИдентификаторПечатнойФормы = &ИдентификаторПечатнойФормы
	               |	И ФайлыПредставленияЭДПОД.ИдентификаторЭтапа = &ИдентификаторЭтапа
	               |	И ФайлыПредставленияЭДПОД.КодВидаСведений = 1";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	Запрос.УстановитьПараметр("ИдентификаторПечатнойФормы", ИдентификаторПечатнойФормы);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеПредставленияПервичногоДокумента = Выборка.ДанныеПредставленияПервичногоДокумента;
		ОсновнойФайлФормуляра = Выборка.ОсновнойФайлФормуляра;
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ОсновнойФайлФормуляра, Ложь);
	КонецЕсли;

	Если ДвоичныеДанные = Неопределено Тогда
		
		Возврат Новый ТабличныйДокумент;
		
	КонецЕсли;
	
	ТабличныйДокумент = ПроцессыОбработкиДокументовВызовСервера.ТабличныйДокументПоДвоичнымДанным(ДвоичныеДанные);

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ВизуализацияПредставленияЭлектронногоДокументаПоСсылке(СсылкаНаДокументПредставленияФормуляраЭД) Экспорт
	
	ДвоичныеДанные = Неопределено;
	ДанныеПредставленияПервичногоДокумента = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФайлыПредставленияЭДПОД.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
	               |	ВЫРАЗИТЬ(ФайлыПредставленияЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ПредставлениеФормуляраПервичногоДокументаПОД).ОсновнойФайл КАК ОсновнойФайлФормуляра
	               |ИЗ
	               |	РегистрСведений.ФайлыПредставленияЭДПОД КАК ФайлыПредставленияЭДПОД
	               |ГДЕ
	               |	ФайлыПредставленияЭДПОД.КодВидаСведений = 1
	               |	И ФайлыПредставленияЭДПОД.ДанныеПредставленияПервичногоДокумента = &СсылкаНаДокументПредставленияФормуляраЭД";
	
	Запрос.УстановитьПараметр("СсылкаНаДокументПредставленияФормуляраЭД", СсылкаНаДокументПредставленияФормуляраЭД);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеПредставленияПервичногоДокумента = Выборка.ДанныеПредставленияПервичногоДокумента;
		ОсновнойФайлФормуляра = Выборка.ОсновнойФайлФормуляра;
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ОсновнойФайлФормуляра, Ложь);
	КонецЕсли;

	Если ДвоичныеДанные = Неопределено Тогда
		
		Возврат Новый ТабличныйДокумент;
		
	КонецЕсли;
	
	ТабличныйДокумент = ПроцессыОбработкиДокументовВызовСервера.ТабличныйДокументПоДвоичнымДанным(ДвоичныеДанные);
	
	Если ПоддерживаетсяИнтеграцияСБЭД() И ЗначениеЗаполнено(ДанныеПредставленияПервичногоДокумента) Тогда
		Реквизиты = "Организация";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокументПредставленияФормуляраЭД, Реквизиты);
		Организация = ЗначенияРеквизитов.Организация;
		
		ЭлектронныеПодписиВнешнегоЭД = ЭлектронныеПодписиВнешнегоЭДСвязанногоСВнутреннимЭД(ДанныеПредставленияПервичногоДокумента);
		
		Если ЭлектронныеПодписиВнешнегоЭД.Количество() > 0 Тогда
			ВыводитьДатуПодписи = Ложь;
			Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭППОД.Получить() = Истина 
				И ОтображатьДатуПодписанияПоОрганизации(Организация) Тогда
				ВыводитьДатуПодписи = Истина;
			КонецЕсли;
			
			ДобавитьШтампыЭлектронныхПодписейВнешнегоЭД(ТабличныйДокумент, 
				ЭлектронныеПодписиВнешнегоЭД, Организация, ВыводитьДатуПодписи);
		КонецЕсли;
	КонецЕсли;	

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ВизуализацияИтоговогоФормуляраПервичногоДокумента(Документ, Шаблон, ДанныеПредставленияПервичногоДокумента, ИдентификаторыПрочихФормуляров) Экспорт
	
	ДвоичныеДанные = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);

	Реквизиты = "ОсновнойФайл, ИдентификаторПечатнойФормы, ИдентификаторФормуляра, Организация";
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПредставленияПервичногоДокумента, Реквизиты);
	
	ОсновнойФайлФормуляра = ЗначенияРеквизитов.ОсновнойФайл;
	ИдентификаторПечатнойФормы = ЗначенияРеквизитов.ИдентификаторПечатнойФормы;
	ИдентификаторФормуляра = ЗначенияРеквизитов.ИдентификаторФормуляра;
	
	ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ОсновнойФайлФормуляра, Ложь);

	Если ДвоичныеДанные = Неопределено Тогда
		
		Возврат Новый ТабличныйДокумент;
		
	КонецЕсли;

	ТабличныйДокумент = ПроцессыОбработкиДокументовВызовСервера.ТабличныйДокументПоДвоичнымДанным(ДвоичныеДанные);
	
	ПереченьИдентификаторыПрочихФормуляров = СтрРазделить(ИдентификаторыПрочихФормуляров, ",", Ложь);
	ПереченьИдентификаторыПрочихФормуляров.Добавить(ЗначенияРеквизитов.ИдентификаторФормуляра);
	
	ЭлектронныеПодписиДляШтампов = Новый Массив;
	
	Для Каждого ТекСтрока Из ПереченьИдентификаторыПрочихФормуляров Цикл
		ИдентификаторТекФормуляра = ТекСтрока;
	
		ПрисоединенныеФайлыФормуляраПервичногоДокумента = ПрисоединенныеФайлыФормуляраПервичногоДокумента(Документ, ИдентификаторТекФормуляра);
		ФайлPDF = ПрисоединенныеФайлыФормуляраПервичногоДокумента.ФайлPDF;
		
		ЭлектронныеПодписиДляШтамповТекФормуляра = УстановленныеПодписиДляФормуляраПОД(ФайлPDF);
	    ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЭлектронныеПодписиДляШтампов, ЭлектронныеПодписиДляШтамповТекФормуляра);
	КонецЦикла;
	
	СписокПодписей = Новый ТаблицаЗначений;
	СписокПодписей.Колонки.Добавить("СведенияОПодписи");
	СписокПодписей.Колонки.Добавить("ДатаПодписи", Новый ОписаниеТипов("Дата"));

	Для Каждого СведенияОПодписи Из ЭлектронныеПодписиДляШтампов Цикл
		НоваяСтрока = СписокПодписей.Добавить();
		НоваяСтрока.СведенияОПодписи = СведенияОПодписи;
		НоваяСтрока.ДатаПодписи = СведенияОПодписи.ДатаПодписи;
	КонецЦикла;

	СписокПодписей.Сортировать("ДатаПодписи Возр");
	
	ЭлектронныеПодписи = Новый Массив;

	Для Каждого ТекПодпись Из СписокПодписей Цикл
		ЭлектронныеПодписи.Добавить(ТекПодпись.СведенияОПодписи);
	КонецЦикла;

	Штампы = ШтампыДляТабличногоДокумента(ЭлектронныеПодписи);
			
	ДобавитьШтампыВТабличныйДокумент(
		Документ, Шаблон, ИдентификаторПечатнойФормы, ТабличныйДокумент, Штампы);
		
	Если ПоддерживаетсяИнтеграцияСБЭД() Тогда
		Организация = ЗначенияРеквизитов.Организация;
		
		ЭлектронныеПодписиВнешнегоЭД = ЭлектронныеПодписиВнешнегоЭДСвязанногоСВнутреннимЭД(ДанныеПредставленияПервичногоДокумента);
		
		Если ЭлектронныеПодписиВнешнегоЭД.Количество() > 0 Тогда
			ВыводитьДатуПодписи = Ложь;
			Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭППОД.Получить() = Истина 
				И ОтображатьДатуПодписанияПоОрганизации(Организация) Тогда
				ВыводитьДатуПодписи = Истина;
			КонецЕсли;
			
			ДобавитьШтампыЭлектронныхПодписейВнешнегоЭД(ТабличныйДокумент, 
				ЭлектронныеПодписиВнешнегоЭД, Организация, ВыводитьДатуПодписи);
		КонецЕсли;
	КонецЕсли;	
		
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПолучитьПредставлениеФормуляровПервичногоДокумента(ДокументУчета) Экспорт
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ДокументУчета));
	КомандыПечати = МодульУправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ИдентификаторФормуляра КАК ИдентификаторФормуляра,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).НаименованиеДокумента КАК Представление,
	               |	ФайлыФормуляровЭДПОД.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы,
				   |	ФайлыФормуляровЭДПОД.ВыполняемаяЗадача КАК ВыполняемаяЗадача,
				   |	ФайлыФормуляровЭДПОД.Предмет КАК Предмет,
				   |	ФайлыФормуляровЭДПОД.КодВидаСведений КАК КодВидаСведений
	               |ПОМЕСТИТЬ Формуляры
	               |ИЗ
	               |	РегистрСведений.ФайлыФормуляровЭДПОД КАК ФайлыФормуляровЭДПОД
	               |ГДЕ
	               |	ФайлыФормуляровЭДПОД.Предмет = &Предмет
	               |	И ФайлыФормуляровЭДПОД.КодВидаСведений = 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ 
	               |	Формуляры.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
	               |	Формуляры.ИдентификаторФормуляра КАК ИдентификаторФормуляра,
	               |	Формуляры.Представление КАК Представление,
	               |	Формуляры.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы,
				   |	Формуляры.ВыполняемаяЗадача КАК ВыполняемаяЗадача,
				   |	Формуляры.Предмет КАК Предмет,
				   |	Формуляры.КодВидаСведений КАК КодВидаСведений
	               |ИЗ
	               |	Формуляры КАК Формуляры
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВЫРАЗИТЬ(Формуляры.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ОсновнойФайл.ДатаМодификацииУниверсальная УБЫВ";
	
	Запрос.УстановитьПараметр("Предмет", ДокументУчета);
	
	СведенияОФормуляреПервичногоДокумента = Новый Соответствие;
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Пока Выборка.Следующий() Цикл
		
		Документ = СведенияОФормуляреПервичногоДокумента.Получить(Выборка.ИдентификаторПечатнойФормы);
		Если Документ <> Неопределено Тогда
			Если Документ.ИдентификаторыПрочихФормуляров = "" Тогда
				Документ.ИдентификаторыПрочихФормуляров = Выборка.ИдентификаторФормуляра;
			Иначе
				Документ.ИдентификаторыПрочихФормуляров = Выборка.ИдентификаторФормуляра + "," + Документ.ИдентификаторыПрочихФормуляров;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		Документ = Новый Структура();
		Документ.Вставить("ДанныеПредставленияПервичногоДокумента", Выборка.ДанныеПредставленияПервичногоДокумента);
		Документ.Вставить("ИдентификаторФормуляра", 				Выборка.ИдентификаторФормуляра);
		Документ.Вставить("Представление", 					 	 	Выборка.Представление);
		Документ.Вставить("ИдентификаторПечати", 					Выборка.ИдентификаторПечатнойФормы);
        Документ.Вставить("ВыполняемаяЗадача", 						Выборка.ВыполняемаяЗадача);
		Документ.Вставить("КодВидаСведений", 						Выборка.КодВидаСведений);
		Документ.Вставить("Предмет", 								Выборка.Предмет);
		Документ.Вставить("ИдентификаторыПрочихФормуляров", 		"");
		
		СведенияОФормуляреПервичногоДокумента.Вставить(Выборка.ИдентификаторПечатнойФормы, Документ);
	КонецЦикла;
	
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		Документ = СведенияОФормуляреПервичногоДокумента[КомандаПечати.Идентификатор];
		Если Документ = Неопределено Тогда
			СведенияОФормуляреПервичногоДокумента.Удалить(КомандаПечати.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СведенияОФормуляреПервичногоДокумента;		
	
КонецФункции

Функция ПредставленияВсехВнутреннихЭДПоПроцессу(Предмет, Шаблон) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ДатаФормирования", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ИдентификаторПечатнойФормы");
	Результат.Колонки.Добавить("ИдентификаторЭтапа");
	Результат.Колонки.Добавить("Этап", Новый ОписаниеТипов("СправочникСсылка.ЭтапыПроцессов"));
	Результат.Колонки.Добавить("Формат");
	Результат.Колонки.Добавить("НаименованиеДокумента");
	Результат.Колонки.Добавить("НомерДокумента");
	Результат.Колонки.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата"));
	
	ИдентификаторыЭтаповШаблона = ИдентификаторыЭтаповШаблона(Шаблон);
	ИдентификаторыЭтаповШаблона.Добавить(ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	               |	ШаблоныПроцессовЭтапы.Этап КАК Этап
	               |ПОМЕСТИТЬ ЭтапыШаблона
	               |ИЗ
	               |	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	               |ГДЕ
	               |	ШаблоныПроцессовЭтапы.Ссылка = &Шаблон
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ФайлыПредставленияЭДПОД.Организация КАК Организация,
	               |	ФайлыПредставленияЭДПОД.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы,
	               |	ФайлыПредставленияЭДПОД.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	               |	ФайлыПредставленияЭДПОД.Формат КАК Формат,
	               |	ФайлыПредставленияЭДПОД.ДатаФормирования КАК ДатаФормирования,
	               |	ФайлыПредставленияЭДПОД.НаименованиеДокумента КАК НаименованиеДокумента,
	               |	ФайлыПредставленияЭДПОД.НомерДокумента КАК НомерДокумента,
	               |	ФайлыПредставленияЭДПОД.ДатаДокумента КАК ДатаДокумента,
	               |	ЭтапыШаблона.Этап КАК Этап
	               |ИЗ
	               |	РегистрСведений.ФайлыПредставленияЭДПОД КАК ФайлыПредставленияЭДПОД
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ЭтапыШаблона КАК ЭтапыШаблона
	               |		ПО ФайлыПредставленияЭДПОД.ИдентификаторЭтапа = ЭтапыШаблона.ИдентификаторЭтапа
	               |ГДЕ
	               |	ФайлыПредставленияЭДПОД.Предмет = &Предмет
	               |	И ФайлыПредставленияЭДПОД.ИдентификаторЭтапа В(&ИдентификаторыЭтапа)
	               |	И ФайлыПредставленияЭДПОД.КодВидаСведений = 1";
	
	Запрос.УстановитьПараметр("Предмет", Предмет);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторыЭтапа", ИдентификаторыЭтаповШаблона);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ИдентификаторПечатнойФормы) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ИдентификаторПечатнойФормы", Выборка.ИдентификаторПечатнойФормы);
			
			НайденныеСтроки = Результат.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				Для Каждого ТекРезультат Из НайденныеСтроки Цикл
					Если ТекРезультат.ДатаФормирования < Выборка.ДатаФормирования Тогда
						ЗаполнитьЗначенияСвойств(ТекРезультат, Выборка);
					КонецЕсли;	
				КонецЦикла;	
			Иначе
				НоваяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;	

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции

Функция ФайлыПоИдентификаторуФормуляра(ИдентификаторФормуляра) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФормулярПервичногоДокументаПОД.Ссылка КАК Формуляр,
	               |	ВЫБОР
	               |		КОГДА ФормулярПервичногоДокументаПОД.КодВидаСведений = 1
	               |			ТОГДА ""mxl""
	               |		КОГДА ФормулярПервичногоДокументаПОД.КодВидаСведений = 2
	               |			ТОГДА ""pdf""
	               |	КОНЕЦ КАК Расширение
	               |ИЗ
	               |	Документ.ФормулярПервичногоДокументаПОД КАК ФормулярПервичногоДокументаПОД
	               |ГДЕ
	               |	ФормулярПервичногоДокументаПОД.ИдентификаторФормуляра = &ИдентификаторФормуляра";
    Запрос.УстановитьПараметр("ИдентификаторФормуляра", ИдентификаторФормуляра);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ФормулярПоИдентификаторуИКодуВидаСведений(ИдентификаторФормуляра, КодВидаСведений) Экспорт
	Результат = Документы.ФормулярПервичногоДокументаПОД.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФормулярПервичногоДокументаПОД.Ссылка КАК Формуляр
	               |ИЗ
	               |	Документ.ФормулярПервичногоДокументаПОД КАК ФормулярПервичногоДокументаПОД
	               |ГДЕ
	               |	ФормулярПервичногоДокументаПОД.ИдентификаторФормуляра = &ИдентификаторФормуляра
	               |	И ФормулярПервичногоДокументаПОД.КодВидаСведений = &КодВидаСведений";
    Запрос.УстановитьПараметр("ИдентификаторФормуляра", ИдентификаторФормуляра);
    Запрос.УстановитьПараметр("КодВидаСведений", КодВидаСведений);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Формуляр;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура ДобавитьСтрокуПростойПодписиДляФормуляра(Задача, ОбъектДанных, СвойстваПодписи, СообщениеЖурналаРегистрации)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НоваяЗапись = РегистрыСведений.ПростыеЭлектронныеПодписиФормуляровПОД.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(НоваяЗапись, СвойстваПодписи);
	
	НоваяЗапись.ПодписанныйОбъект = ОбъектДанных.Ссылка;
	НоваяЗапись.ВыполняемаяЗадача = Задача;
	
	Если Не ЗначениеЗаполнено(НоваяЗапись.УстановившийПодпись) Тогда
		НоваяЗапись.УстановившийПодпись = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
	СообщениеЖурналаРегистрации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Дата подписи: %1'"), Формат(НоваяЗапись.ДатаПодписи, "ДЛФ=DT"));
	
	НоваяЗапись.Записать();
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Процессы обработки документов.Добавление простой подписи формуляра'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,
		ОбъектДанных.Метаданные(),
		ОбъектДанных.Ссылка,
		СообщениеЖурналаРегистрации,
		РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);
	
КонецПроцедуры
	
Процедура УдалитьПростуюПодписьДляФормуляра(Задача, Объект) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПроверитьИзменениеРазрешено(Объект);
	КонецЕсли;
	
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект));
	
	НачатьТранзакцию();
	Попытка
		
		Если ЭтоСсылка Тогда
			ЗаблокироватьДанныеДляРедактирования(Объект);
			ОбъектДанных = Объект.ПолучитьОбъект();
		Иначе
			ОбъектДанных = Объект;
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ОбъектДанных.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ОбъектДанных.Ссылка);
		Блокировка.Заблокировать();
		
		СообщениеЖурналаРегистрации = "";
		
		УдалитьСтрокуПростойПодписиДляФормуляра(Задача, ОбъектДанных, СообщениеЖурналаРегистрации);
		
		ОбъектДанных.ПодписанЭП = Ложь;
		
		Если ЭтоСсылка Тогда
			// Чтобы определить, что это запись с целью добавления/удаления подписи.
			ОбъектДанных.ДополнительныеСвойства.Вставить("ЗаписьПодписанногоОбъекта", Истина);
			Если ОбъектДанных.Модифицированность() Тогда
				ОбъектДанных.Записать();
			КонецЕсли;
			РазблокироватьДанныеДляРедактирования(Объект.Ссылка);
			ЗаписанныйОбъект = ОбъектДанных;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Если ЗначениеЗаполнено(СообщениеЖурналаРегистрации) Тогда
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Процессы обработки документов.Ошибка удаления простой подписи формуляра'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Информация,
				Объект.Метаданные(),
				Объект.Ссылка,
				СообщениеЖурналаРегистрации + "
				|
				|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьСтрокуПростойПодписиДляФормуляра(Задача, ПодписанныйОбъект, СообщениеЖурналаРегистрации)
	
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПростыеЭлектронныеПодписиФормуляровПОД.ПодписанныйОбъект КАК ПодписанныйОбъект,
	|	ПростыеЭлектронныеПодписиФормуляровПОД.ВыполняемаяЗадача КАК ВыполняемаяЗадача
	|ИЗ
	|	РегистрСведений.ПростыеЭлектронныеПодписиФормуляровПОД КАК ПростыеЭлектронныеПодписиФормуляровПОД
	|ГДЕ
	|	ПростыеЭлектронныеПодписиФормуляровПОД.ПодписанныйОбъект = &ПодписанныйОбъект
	|	И ПростыеЭлектронныеПодписиФормуляровПОД.ВыполняемаяЗадача = &Задача";
	
	Запрос.УстановитьПараметр("ПодписанныйОбъект", ПодписанныйОбъект.Ссылка);
	Запрос.УстановитьПараметр("Задача", Задача);
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Строка с подписью не существует.'");
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ПростыеЭлектронныеПодписиФормуляровПОД.СоздатьМенеджерЗаписи();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	МенеджерЗаписи.Прочитать();
	
	ЕстьПрава = ЭтоПолноправныйПользователь
		Или МенеджерЗаписи.УстановившийПодпись = Пользователи.АвторизованныйПользователь();
		
	СообщениеЖурналаРегистрации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Дата подписи: %1'"), Формат(МенеджерЗаписи.ДатаПодписи, "ДЛФ=DT"));
		
	Если ЕстьПрава Тогда
		МенеджерЗаписи.Удалить();
	Иначе
		ВызватьИсключение НСтр("ru = 'Недостаточно прав на удаление простой подписи формуляра.'");
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Процессы обработки документов.Удаление простой подписи формуляра'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,
		ПодписанныйОбъект.Метаданные(),
		ПодписанныйОбъект.Ссылка,
		СообщениеЖурналаРегистрации,
		РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);
	
КонецПроцедуры
	
Функция УстановленныеПодписиДляФормуляраПОД(Объект) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ЭлектронныеПодписи = ПроцессыОбработкиДокументовПереопределяемый.УстановленныеПодписиДляФормуляраПОД(Объект, СтандартнаяОбработка);

	Если СтандартнаяОбработка Тогда
		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЭлектронныеПодписи, МодульЭлектроннаяПодпись.УстановленныеПодписи(Объект, , Истина));

		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЭлектронныеПодписи, УстановленныеПростыеПодписиДляФормуляраПОД(Объект));
	КонецЕсли;
	
	Возврат ЭлектронныеПодписи;
	
КонецФункции

Функция УстановленныеПростыеПодписиДляФормуляраПОД(Объект) Экспорт
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) Тогда
		ОбъектСсылка = Объект;
	Иначе
		ОбъектСсылка = Объект.Ссылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК Подпись,
	|	1 КАК ПорядковыйНомер,
	|	ЭлектронныеПодписи.УстановившийПодпись КАК УстановившийПодпись,
	|	ЭлектронныеПодписи.ДатаПодписи КАК ДатаПодписи,
	|	ЭлектронныеПодписи.ВладелецПодписи КАК ВладелецПодписи,
	|	ЭлектронныеПодписи.Организация КАК Организация,
	|	ЭлектронныеПодписи.Должность КАК Должность,
	|	ИСТИНА КАК ПростаяПодпись
	|ИЗ
	|	РегистрСведений.ПростыеЭлектронныеПодписиФормуляровПОД КАК ЭлектронныеПодписи
	|ГДЕ
	|	ЭлектронныеПодписи.ПодписанныйОбъект = &ПодписанныйОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("ПодписанныйОбъект", ОбъектСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЭлектронныеПодписи = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ОтпечатокСтруктура = Новый Структура(
			"ПорядковыйНомер, ДатаПодписи, УстановившийПодпись, ПростаяПодпись,
			|ДатаПроверкиПодписи, ИмяФайлаПодписи, Комментарий, ПодписьВерна,
			|КомуВыданСертификат, ВладелецПодписи, Организация, Должность");
		ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, Выборка);
		ОтпечатокСтруктура.КомуВыданСертификат = Выборка.ВладелецПодписи + ", " + Строка(Выборка.Организация) + ", " + Выборка.Должность;
		ЭлектронныеПодписи.Добавить(ОтпечатокСтруктура);
	КонецЦикла;
	
	Возврат ЭлектронныеПодписи;
	
КонецФункции

Функция РезультатыЗапросаДокументовДляОбработкиДокументовПрошлыхПериодов() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПредметыДляФормированияФайловПредставленийФормуляровПОД.Предмет КАК Предмет,
	               |	ПредметыДляФормированияФайловПредставленийФормуляровПОД.Шаблон КАК Шаблон
	               |ИЗ
	               |	РегистрСведений.ПредметыДляФормированияФайловПредставленийФормуляровПОД КАК ПредметыДляФормированияФайловПредставленийФормуляровПОД";
