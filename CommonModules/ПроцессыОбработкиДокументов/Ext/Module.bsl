Функция СтатусыОбъектов(КлючиСтрок) Экспорт
	
	ТекущийПользовательПолноправный = Пользователи.ЭтоПолноправныйПользователь();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТекущиеСтатусыДокументов.Предмет КАК Документ,
	|	ТекущиеСтатусыДокументов.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ТекущиеСтатусыДокументов КАК ТекущиеСтатусыДокументов
	|ГДЕ
	|	ТекущиеСтатусыДокументов.Предмет В (&СписокОбъектов)");
	
	Запрос.УстановитьПараметр("СписокОбъектов", КлючиСтрок);
	
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	ТаблицаСтатусовОбъектов = Запрос.Выполнить().Выгрузить();
	
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Запрос = Неопределено;
	
	Возврат ТаблицаСтатусовОбъектов;
	
КонецФункции

Функция СформироватьГрафическуюСхему(Шаблон, ГиперссылкиЭлементовСхемы, ЭтапыДляВыделения = Неопределено, Заголовок = Неопределено) Экспорт
	
	Настройки = НастройкиФорматированияСхем();
	
	МакетСхемы = Справочники.ШаблоныПроцессов.ПолучитьМакет("Схема");
	МакетЭтапа = Справочники.ШаблоныПроцессов.ПолучитьМакет("Элементы");
	
	Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
	ОбъектXDTOСхема = Сериализатор.ЗаписатьXDTO(МакетСхемы);
	
	ЭлементыСхемы = ОбъектXDTOСхема.ПолучитьСписок("item");
	
	ТаблицаИдентификаторовЭлементов = Новый ТаблицаЗначений;
	ТаблицаИдентификаторовЭлементов.Колонки.Добавить("ИдентификаторЭтапа");
	ТаблицаИдентификаторовЭлементов.Колонки.Добавить("ТипЭлемента");
	ТаблицаИдентификаторовЭлементов.Колонки.Добавить("Порядок");
	ТаблицаИдентификаторовЭлементов.Колонки.Добавить("НомерРезолюции");
	ТаблицаИдентификаторовЭлементов.Колонки.Добавить("УсловиеРассмотрения");
	ТаблицаИдентификаторовЭлементов.Колонки.Добавить("ОтрицательныйРезультат");
	ТаблицаИдентификаторовЭлементов.Колонки.Добавить("КонтекстЭлемента");
	ТаблицаИдентификаторовЭлементов.Колонки.Добавить("ItemID");
	
	Контекст = Новый Структура;
	Контекст.Вставить("МаксимальныйИдентификатор",0);
	Контекст.Вставить("Порядок", 0);
	Контекст.Вставить("Середина", 0);
	Контекст.Вставить("КоличествоРезолюций", 0);
	Контекст.Вставить("КоличествоВлияний", 0);
	Контекст.Вставить("КоличествоЛиний", 0);
	Контекст.Вставить("ТекущаяНижняяГраница",0);
	Контекст.Вставить("ТекущаяЛеваяГраницаРезолюции", 0);
	Контекст.Вставить("НомерРезолюции", 0);
	Контекст.Вставить("МаксимальныйПорядокЭтапа", 0);
	Контекст.Вставить("ТаблицаИдентификаторовЭлементов", ТаблицаИдентификаторовЭлементов);
	Контекст.Вставить("СоответствиеЭлементов", Новый Соответствие);
	Контекст.Вставить("КоординатыПорядков", Новый Соответствие);
	Контекст.Вставить("РезолюцииБезСвязи", Новый Массив);
	Контекст.Вставить("ВлияющиеПроцессы", Новый ТаблицаЗначений);
	Контекст.Вставить("ЗависимыеПроцессы", Новый ТаблицаЗначений);
	Контекст.Вставить("ГиперссылкиЭлементовСхемы", ГиперссылкиЭлементовСхемы);
	Контекст.Вставить("ЭтапыДляВыделения", ЭтапыДляВыделения);
	
	МаксИД = 0;
	Порядок = 0;
	
	Для Каждого ЭлементСхемы Из ЭлементыСхемы Цикл
		
		Если ЭлементСхемы.ItemID > МаксИД Тогда
			МаксИД = ЭлементСхемы.ItemID;
		КонецЕсли;
		
		Если ЭлементСхемы.ItemTabOrder > Порядок Тогда
			Порядок = ЭлементСхемы.ItemTabOrder;
		КонецЕсли;
		
		ИмяЭлемента = ЭлементСхемы.ItemCode;
		
		Если ИмяЭлемента = "ЗаголовокСхемы" Тогда
			ЗаголовокСхемы = "Схема бизнес-процесса """ + Шаблон.Наименование + """";
			УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, ЗаголовокСхемы);
			УстановитьРазмерЗаголовкаСхемы(ЭлементСхемы, ЗаголовокСхемы, 11);
		ИначеЕсли ИмяЭлемента = "ИдентификаторДокумента" Тогда
			ЗаголовокСхемы = ?(Заголовок = Неопределено, Строка(Шаблон.ИдентификаторДокумента), Заголовок);
			УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, ЗаголовокСхемы);
			УстановитьРазмерЗаголовкаСхемы(ЭлементСхемы, ЗаголовокСхемы, 10);
		ИначеЕсли ИмяЭлемента = "ЛинияНачала" Тогда
			
			Контекст.СоответствиеЭлементов.Вставить(ЭлементСхемы.ItemID, ЭлементСхемы);
			
			НоваяСтрока = Контекст.ТаблицаИдентификаторовЭлементов.Добавить();
			НоваяСтрока.ИдентификаторЭтапа = "ЛинияНачала";
			НоваяСтрока.Порядок = -1;
			НоваяСтрока.ItemID = ЭлементСхемы.ItemID;
			
			УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, "");
			
		ИначеЕсли ИмяЭлемента = "Начало" Тогда
			
			Контекст.Вставить("ТекущаяНижняяГраница", ЭлементСхемы.rectBottom);
			Контекст.СоответствиеЭлементов.Вставить(ЭлементСхемы.ItemID, ЭлементСхемы);
			
			НоваяСтрока = Контекст.ТаблицаИдентификаторовЭлементов.Добавить();
			НоваяСтрока.ИдентификаторЭтапа = "Начало";
			НоваяСтрока.Порядок = -1;
			НоваяСтрока.НомерРезолюции = 1;
			НоваяСтрока.ItemID = ЭлементСхемы.ItemID;
			
			ЗаголовокЭлемента = ИмяЭлемента + Символы.ПС + "(" + Строка(Шаблон.НачальныйСтатус) + ")";
			УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, ЗаголовокЭлемента);
			
		ИначеЕсли ИмяЭлемента = "Конец" Тогда
			
			Контекст.СоответствиеЭлементов.Вставить(ЭлементСхемы.ItemID, ЭлементСхемы);
			
			НоваяСтрока = Контекст.ТаблицаИдентификаторовЭлементов.Добавить();
			НоваяСтрока.ИдентификаторЭтапа = "Конец";
			НоваяСтрока.Порядок = 99;
			НоваяСтрока.ItemID = ЭлементСхемы.ItemID;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Контекст.Вставить("МаксимальныйИдентификатор", МаксИД);
	Контекст.Вставить("Порядок", Порядок);
	
	ДобавитьЭтапы(ЭлементыСхемы, Шаблон.Ссылка, Шаблон.Этапы.Выгрузить(), Шаблон.ВлияниеНаДругиеПроцессы.Выгрузить(), Контекст, Настройки);
	ДобавитьСвязиМеждуЭтапами(ЭлементыСхемы, Шаблон.ПредшественникиЭтапов.Выгрузить(), Контекст, Настройки);
	
	ДобавитьВлияющиеПроцессы(ЭлементыСхемы, Контекст, Настройки);
	ДобавитьСвязиСВлияющимиПроцессами(ЭлементыСхемы, Контекст, Настройки);
	
	ДобавитьЗависимыеПроцессы(ЭлементыСхемы, Контекст, Настройки);
	ДобавитьСвязиСЗависимымиПроцессами(ЭлементыСхемы, Контекст, Настройки);
	
	Для Каждого ЭлементСхемы Из ЭлементыСхемы Цикл
		
		ИмяЭлемента = ЭлементСхемы.ItemCode;
		
		Если ИмяЭлемента = "Начало" Тогда
			
			ЭлементСхемы.rectLeft = Контекст.Середина - 60;
			ЭлементСхемы.rectRight = Контекст.Середина + 60;
			
			УстановитьКоординатыТочкиСтартаЗавершения(ЭлементСхемы,
											ЭлементСхемы.rectLeft, ЭлементСхемы.rectTop,
											ЭлементСхемы.rectRight - 1, ЭлементСхемы.rectTop,
											ЭлементСхемы.rectRight - 1, ЭлементСхемы.rectTop + 11,
											Контекст.Середина, ЭлементСхемы.rectBottom - 1,
											ЭлементСхемы.rectLeft, ЭлементСхемы.rectTop + 11);
											
			// Для стартового этапа установим связь с элементом "Начало"
			СтрокаОткуда = Контекст.ТаблицаИдентификаторовЭлементов.Найти("Начало", "ИдентификаторЭтапа");
			
			Отбор = Новый Структура;
			Отбор.Вставить("Порядок", 0);
			Отбор.Вставить("УсловиеРассмотрения", ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка"));
			СтрокиКуда = Контекст.ТаблицаИдентификаторовЭлементов.НайтиСтроки(Отбор);
			
			Если СтрокиКуда.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Линия = Контекст.ТаблицаИдентификаторовЭлементов.Найти("ЛинияНачала", "ИдентификаторЭтапа");
			ЭлементЛиния = Контекст.СоответствиеЭлементов[Линия.ItemID];
			УстановитьНачалоИКонецЛинии(ЭлементЛиния, СтрокаОткуда, СтрокиКуда[0]);
			УстановитьКоординатыЛинии(ЭлементЛиния, СтрокаОткуда, СтрокиКуда[0], Контекст, Настройки);
			
		ИначеЕсли ИмяЭлемента = "Конец" Тогда
			
			ЭлементСхемы.rectTop = Контекст.ТекущаяНижняяГраница + Настройки.ОтступМеждуПорядкамиПоВертикали;
			ЭлементСхемы.rectBottom = ЭлементСхемы.rectTop + 45;
			ЭлементСхемы.rectLeft = Контекст.Середина - 60;
			ЭлементСхемы.rectRight = Контекст.Середина + 60;
			
			Контекст.ТекущаяНижняяГраница = ЭлементСхемы.rectBottom;
			
			УстановитьКоординатыТочкиСтартаЗавершения(ЭлементСхемы,
											Контекст.Середина, ЭлементСхемы.rectTop,
											ЭлементСхемы.rectRight -1 , ЭлементСхемы.rectBottom - 11,
											ЭлементСхемы.rectRight - 1, ЭлементСхемы.rectBottom - 1,
											ЭлементСхемы.rectLeft, ЭлементСхемы.rectBottom - 1,
											ЭлементСхемы.rectLeft, ЭлементСхемы.rectBottom - 11);
											
			// Элемент "Конец" должен быть связан со всеми резолюциями, которые еще ни с чем не связаны
			Для Каждого РезолюцияБезСвязи Из Контекст.РезолюцииБезСвязи Цикл
				
				СтрокаОткуда = Контекст.ТаблицаИдентификаторовЭлементов.Найти(РезолюцияБезСвязи.ItemID, "ItemID");
				
				СтрокаКуда = Контекст.ТаблицаИдентификаторовЭлементов.Найти("Конец", "ИдентификаторЭтапа");
				
				ЭлементЛиния = ЭлементСхемыПоИмени(МакетЭтапа, "ДекоративнаяЛиния");
				ДобавленныйЭлементЛиния = ЭлементыСхемы.Добавить(ЭлементЛиния);
				//УстановитьСвойстваЛинии(ДобавленныйЭлементЛиния, Строка(СтрокаОткуда.УсловиеРассмотрения), СтрокаОткуда, СтрокаКуда, Контекст, Настройки);
				УстановитьСвойстваЛинии(ДобавленныйЭлементЛиния, "", СтрокаОткуда, СтрокаКуда, Контекст, Настройки);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбъектXDTOСхема.EnableGrid = Ложь;
	
	Возврат Сериализатор.ПрочитатьXDTO(ОбъектXDTOСхема);
	
КонецФункции

Функция СформироватьКартуМаршрута(ДокументСсылка) Экспорт
	
	Шаблон = ШаблонИСтатусДокумента(ДокументСсылка).Шаблон;
	
	Если Шаблон = Неопределено Тогда
		Возврат Новый ГрафическаяСхема;
	Иначе
		НевыполненныеЭтапы = НевыполненныеЭтапыПроцессаДокумента(Шаблон, ДокументСсылка);
		Заголовок = ОбщегоНазначения.ПредметСтрокой(ДокументСсылка);
		Возврат СформироватьГрафическуюСхему(Шаблон, Новый Структура, НевыполненныеЭтапы, Заголовок);
	КонецЕсли;
	
КонецФункции

// Вызывается после завершения вызова процедуры Печать менеджера печати объекта, имеет те же параметры.
// Может использоваться для постобработки всех печатных форм при их формировании.
// Например, можно вставить в колонтитул дату формирования печатной формы.
//
// Параметры:
//  МассивОбъектов - Массив - список объектов, для которых была выполнена процедура Печать;
//  ПараметрыПечати - Структура - произвольные параметры, переданные при вызове команды печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - содержит табличные документы и дополнительную информацию;
//  ОбъектыПечати - СписокЗначений - соответствие между объектами и именами областей в табличных документах, где
//                                   значение - Объект, представление - имя области с объектом в табличных документах;
//  ПараметрыВывода - Структура - параметры, связанные с выводом табличных документов:
//   * ПараметрыОтправки - Структура - информация для заполнения письма при отправке печатной формы по электронной почте.
//                                     Содержит следующие поля (описание см. в общем модуле конфигурации
//                                     РаботаСПочтовымиСообщениямиКлиент в процедуре СоздатьНовоеПисьмо):
//    ** Получатель;
//    ** Тема,
//    ** Текст.
Процедура ПриПечати(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовПереопределяемый.ПриПечати(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,
		ОбъектыПечати, ПараметрыВывода, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПечати.Свойство("ИсключитьШтампы") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ШаблоныПроцессов) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЭППриВыполненииЭтапов")
		И НЕ ПолучитьФункциональнуюОпцию("ИспользоватьПростыеЭППриВыполненииЭтапов") Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(МассивОбъектов) Тогда
		МассивОбъектовДляПечати = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(МассивОбъектов);
	ИначеЕсли МассивОбъектов.Количество() = 1 Тогда
		МассивОбъектовДляПечати = ОбщегоНазначения.СкопироватьРекурсивно(МассивОбъектов);
	ИначеЕсли ОбъектыПечати.Количество() = 0 Тогда
		Возврат;
	Иначе
		МассивОбъектовДляПечати = ОбщегоНазначения.СкопироватьРекурсивно(МассивОбъектов);
	КонецЕсли;
	
	ШаблоныОбъектов = Новый Соответствие;
	Для Каждого Ссылка Из МассивОбъектовДляПечати Цикл
		Шаблон = ШаблонИСтатусДокумента(Ссылка).Шаблон;
		Если Шаблон = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ШаблоныОбъектов.Вставить(Ссылка, Шаблон);
	КонецЦикла;
	
	Если ШаблоныОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ПечатнаяФорма Из КоллекцияПечатныхФорм Цикл
		
		ИсходныйТабличныйДокумент = ПечатнаяФорма.ТабличныйДокумент;
		
		Если ИсходныйТабличныйДокумент.ВысотаТаблицы = 0 Тогда
			// к пустому документу штампы не добавляются
			Продолжить;
		КонецЕсли;
		
		ТабличныйДокументСоШтампами = Новый ТабличныйДокумент;
		ЗаполнитьЗначенияСвойств(ТабличныйДокументСоШтампами, ИсходныйТабличныйДокумент);
		
		Для Каждого Ссылка Из МассивОбъектовДляПечати Цикл
			
			ИмяОбласти = "";
			
			Если ОбъектыПечати.Количество() = 0 Тогда
				ОбластьДокумент = ИсходныйТабличныйДокумент;
			ИначеЕсли МассивОбъектовДляПечати.Количество() = 1 Тогда
				// передан только один объект для печати
				// штамп будет выведен в конец исходного табличного документа
				ОбластьДокумент = ИсходныйТабличныйДокумент;
			Иначе
				ДокументОбласть = ОбъектыПечати.НайтиПоЗначению(Ссылка);
				Если ДокументОбласть = Неопределено Тогда
					// не удалось найти имя области для объекта печати;
					// штамп будет выведен в конец исходного табличного документа
					ОбластьДокумент = ИсходныйТабличныйДокумент;
				Иначе
					ИмяОбласти = ДокументОбласть.Представление;
					Если ИсходныйТабличныйДокумент.Области.Найти(ИмяОбласти) = Неопределено Тогда
						// в табличном документе нет области, соответствующей объекту печати;
						// штамп объекта не выводится
						ТабличныйДокументСоШтампами.Присоединить(ИсходныйТабличныйДокумент);
						Продолжить;
					Иначе
						ОбластьДокумент = ИсходныйТабличныйДокумент.ПолучитьОбласть(ИмяОбласти);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ТабличныйДокументСоШтампами.ВысотаТаблицы > 0 Тогда
				ТабличныйДокументСоШтампами.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			НомерСтрокиНачало = ТабличныйДокументСоШтампами.ВысотаТаблицы + 1;
			
			ТабличныйДокументСоШтампами.Присоединить(ОбластьДокумент);
			
			НомерСтрокиКонец = ТабличныйДокументСоШтампами.ВысотаТаблицы;
			
			ТабличныйДокументСоШтампами.Область(ТабличныйДокументСоШтампами.ВысотаТаблицы, , ТабличныйДокументСоШтампами.ВысотаТаблицы).КонецСтраницы = Ложь;
			
			Если ШаблоныОбъектов.Получить(Ссылка) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ВыводитьШтампыЭлектронныхПодписейПриПечати(Ссылка, ПечатнаяФорма.ИмяМакета, ШаблоныОбъектов[Ссылка], Истина) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлектронныеПодписиДляШтампа = УстановленныеПодписиДляШтампа(Ссылка, ШаблоныОбъектов[Ссылка], ПечатнаяФорма.ИмяМакета);
			
			Штампы = ШтампыДляТабличногоДокумента(ЭлектронныеПодписиДляШтампа);
			
			ДобавитьШтампыВТабличныйДокумент(Ссылка, ШаблоныОбъектов[Ссылка], ПечатнаяФорма.ИмяМакета, ТабличныйДокументСоШтампами, Штампы);
			
			Если НЕ ПустаяСтрока(ИмяОбласти) Тогда
				ТабличныйДокументСоШтампами.Область(НомерСтрокиНачало, , НомерСтрокиКонец).Имя = "";
				ТабличныйДокументСоШтампами.Область(НомерСтрокиНачало, , ТабличныйДокументСоШтампами.ВысотаТаблицы).Имя = ИмяОбласти;
			КонецЕсли;
			
		КонецЦикла;
		
		ПечатнаяФорма.ТабличныйДокумент = ТабличныйДокументСоШтампами;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ШтампыДляТабличногоДокумента(ЭлектронныеПодписиДляШтампа) Экспорт
	
	ПараметрыШтампа = Новый Структура;
	ПараметрыШтампа.Вставить("ТекстОтметки", "");
	ПараметрыШтампа.Вставить("Логотип");
	
	Штампы = Новый Массив;
	Для Каждого Подпись Из ЭлектронныеПодписиДляШтампа Цикл
		
		МодульРаботаСФайламиПереопределяемый = ОбщегоНазначения.ОбщийМодуль("РаботаСФайламиПереопределяемый");
		
		Если Подпись.Свойство("ПростаяПодпись") И Подпись.ПростаяПодпись Тогда
			
			МодульРаботаСФайламиПереопределяемый.ПриПечатиФайлаСоШтампом(ПараметрыШтампа, Неопределено);
			
			Штамп = ШтампВизуализацииПростойЭлектроннойПодписи(Подпись, ПараметрыШтампа.ТекстОтметки, ПараметрыШтампа.Логотип);
			
		Иначе
			
			Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
				Продолжить;
			КонецЕсли;
			
			Сертификат = Подпись.Сертификат;
			ДанныеСертификата = Сертификат.Получить();
			Если ДанныеСертификата = Неопределено И ЗначениеЗаполнено(Подпись.Отпечаток) Тогда
				СсылкаНаСертификат = СсылкаНаСертификатПоОтпечатку(Подпись.Отпечаток);
				Если ЗначениеЗаполнено(СсылкаНаСертификат) Тогда
					ДанныеСертификатаПоОтпечатку = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаСертификат, "ДанныеСертификата");
					СертификатКриптографии = Новый СертификатКриптографии(ДанныеСертификатаПоОтпечатку.Получить());
				КонецЕсли;
			Иначе	
				СертификатКриптографии = Новый СертификатКриптографии(ДанныеСертификата);
			КонецЕсли;
			
			ИдентификаторПодписи = Новый Массив;
			ИдентификаторПодписи.Добавить(Подпись.ИдентификаторПодписи);
			
			МодульРаботаСФайламиПереопределяемый.ПриПечатиФайлаСоШтампом(ПараметрыШтампа, СертификатКриптографии);

			СвойстваПодписи = ЭлектроннаяПодписьКлиентСервер.НовыеСвойстваПодписи();
            ЗаполнитьЗначенияСвойств(СвойстваПодписи, Подпись);
            СвойстваПодписи.Сертификат = СертификатКриптографии.Выгрузить();
            Если ЭтоАдресВременногоХранилища(СвойстваПодписи.РезультатПроверкиПодписиПоМЧД) Тогда
                СвойстваПодписи.РезультатПроверкиПодписиПоМЧД = ПолучитьИзВременногоХранилища(СвойстваПодписи.РезультатПроверкиПодписиПоМЧД);
            КонецЕсли;

			ПараметрыОтображения = Новый Структура;
			ПараметрыОтображения.Вставить("Сертификат", СертификатКриптографии);
			Если Не (Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭППОД.Получить() 
				И ПроцессыОбработкиДокументовПереопределяемый.ОтображатьДатуПодписанияВШтампе(ПараметрыОтображения)) Тогда
				СвойстваПодписи.ДатаПодписи = Неопределено;
				СвойстваПодписи.ДатаПодписиИзМетки = Неопределено;
			КонецЕсли;

            Штамп = ШтампВизуализацииЭлектроннойПодписи(СвойстваПодписи, ,ПараметрыШтампа.ТекстОтметки, ПараметрыШтампа.Логотип);			
		КонецЕсли;
		
		Штампы.Добавить(Штамп);
		
	КонецЦикла;
	
	Возврат Штампы;
	
КонецФункции

//Определяет объекты, в которых есть процедура ДобавитьКомандыПечати()
//
Процедура ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов) Экспорт
	
	СписокОбъектов.Добавить(Справочники.ШаблоныПроцессов);
	СписокОбъектов.Добавить(Документы.ДополнительноеЗадание);
	
КонецПроцедуры

//Определяет объекты, в которых есть процедура ПриОпределенииНастроекПечати()
//
Процедура ПриОпределенииНастроекПечати(ОбъектыПечати) Экспорт
	
	ПриОпределенииОбъектовСКомандамиПечати(ОбъектыПечати);
	
КонецПроцедуры

Процедура НастроитьВариантыОтчетов(Настройки) Экспорт
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ВариантыОтчетов") Тогда
		Возврат;
	КонецЕсли;
	
	МодульВариантыОтчетов = ОбщегоНазначения.ОбщийМодуль("ВариантыОтчетов");
	МодульВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.АнализВыполненияРегламентныхИнтервалов);
	МодульВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.ЗадачиПоОбработкеДокументов);
	МодульВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.РеестрКлючейПростыхЭлектронныхПодписейПОД);
	МодульВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.ШаблоныПроцессовПоДокументам);
	
КонецПроцедуры

Процедура ЗаполнитьСписокДоступныхИдентификаторов(СписокДоступныхИдентификаторов) Экспорт
	
	ИдентификаторТипаДокументы = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документы");
	СписокДоступныхИдентификаторов.Добавить(ИдентификаторТипаДокументы);
	
	МассивТипов = Метаданные.ОбщиеКоманды.КарточкаПроцессаДокумента.ТипПараметраКоманды.Типы();
	
	Для Каждого Тип Из МассивТипов Цикл
		СписокДоступныхИдентификаторов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип));
	КонецЦикла;
	
	СписокДоступныхИдентификаторов.СортироватьПоПредставлению();
	
КонецПроцедуры

Функция ДокументПодходитПоУсловию(Документ, УсловиеИспользования) Экспорт
	
	Если НЕ ЗначениеЗаполнено(УсловиеИспользования) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
		Ссылка = Документ;
	Иначе
		Ссылка = Документ.Ссылка;
	КонецЕсли;
	
	МетаданныеОбъекта = Ссылка.Метаданные();
	СтандартныеРеквизитыДокумента = МетаданныеОбъекта.СтандартныеРеквизиты;
	РеквизитыДокумента = МетаданныеОбъекта.Реквизиты; 
	
	//получение доступных функций предопределенных условий для текущего документа
	ДоступныеФункцииУсловий = ОписаниеФункцийПредопределенныхУсловий(); 
	ФункцииУсловий = Новый Массив;
	Для Каждого ДоступнаяФункцияУсловия Из ДоступныеФункцииУсловий Цикл
		
		ДоступныеОбъектыДляФункции = СтрРазделить(ДоступнаяФункцияУсловия.ОбъектыМетаданных, Символы.ПС, Ложь);
		Если ДоступныеОбъектыДляФункции.Найти("Документ." + МетаданныеОбъекта.Имя) <> Неопределено Тогда
			
			ФункцииУсловий.Добавить(ДоступнаяФункцияУсловия); 
			
         КонецЕсли;
		
	КонецЦикла;
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.ТипИсточникаДанных = "local";
	ИсточникДанных.Имя = "ИсточникДанных1";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = ИсточникДанных.Имя;
	НаборДанных.Имя = "Запрос";
	НаборДанных.Запрос = "ВЫБРАТЬ
		|	ИСТИНА КАК ПолеРезультат";
	
	ОтборИзУсловияИспользования = ОбщегоНазначения.ЗначениеИзСтрокиXML(УсловиеИспользования).Отбор;
	
	ИменаРеквизитовИзУсловия = Новый Массив;
	ПолучитьИменаРеквизитовИзОтбораКомпоновкиДанных(ОтборИзУсловияИспользования, ИменаРеквизитовИзУсловия);
	ИменаРеквизитовИзУсловия = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ИменаРеквизитовИзУсловия);
	
	Если ИменаРеквизитовИзУсловия.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ИспользуютсяДопРеквизиты = Ложь;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
		ИспользуютсяДопРеквизиты = МодульУправлениеСвойствами.ИспользоватьДопРеквизиты(Ссылка);
	КонецЕсли;
	
	ИменаПолейДляЗамены = Новый Соответствие;
	ИменаПолейДляЗаменыДопРеквизитов = Новый Соответствие;
	ИменаПолейЗапроса = Новый Соответствие;
	
	//формирований параметров Схемы компоновки с учётом предопределенных функций условий
	ИменаРеквизитовПараметровИсточников = Новый Соответствие;
	ВыбранныеФункцииУсловий = Новый Соответствие();
	Если ФункцииУсловий.Количество() > 0 Тогда
		Для Каждого ИмяРеквизитаУсловия Из ИменаРеквизитовИзУсловия Цикл 
			
			Для Каждого ФункцияУсловия Из ФункцииУсловий Цикл
				ПолеФункция = Новый ПолеКомпоновкиДанных(ФункцияУсловия.Идентификатор);
				Если ИмяРеквизитаУсловия = ПолеФункция Тогда
					ВыбранныеФункцииУсловий.Вставить(ИмяРеквизитаУсловия, ФункцияУсловия); 
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ВыбранныеФункцииУсловий.Количество() > 0 Тогда  
		
		ПоляЗапроса = "";
		Для Каждого ФункцияУсловие Из ВыбранныеФункцииУсловий Цикл
			
			Если ФункцияУсловие.Значение.Свойство("РеквизитыИсточника")
				И ЗначениеЗаполнено(ФункцияУсловие.Значение.РеквизитыИсточника) Тогда
				
				РеквизитыИсточника = СтрЗаменить(ФункцияУсловие.Значение.РеквизитыИсточника, " ", "");
				ПереченьРеквизитовИсточников = СтрРазделить(РеквизитыИсточника, ",", Ложь);
				
				ПоляПараметровФункции = Новый Массив;
				Для Каждого РеквизитИсточник Из ПереченьРеквизитовИсточников Цикл
					ПоляЗапроса = ПоляЗапроса + "&ПараметрИсточник_" + РеквизитИсточник + "," + Символы.ПС; 
					
					//для нового документа ещё нет ссылки, в параметр СКД нельзя передать тип ДанныеФормыСтруктура
					Если РеквизитИсточник = "Ссылка" 
						И ТипЗнч(Документ) = Тип("ДанныеФормыСтруктура") Тогда
						ЗначениеРеквизита = Неопределено;
					Иначе
						ЗначениеРеквизита = Документ[РеквизитИсточник];
					КонецЕсли;

					//добавляем поле 
					ПолеИсточник = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
					ПолеИсточник.ПутьКДанным = "ПараметрИсточник_" + РеквизитИсточник;
					ПолеИсточник.Заголовок   = "Заголовок_" + РеквизитИсточник;
					ПолеИсточник.Поле	     = "ПараметрИсточник_" + РеквизитИсточник;
					
					//добавляем параметр Источник
					ПараметрСКД = СхемаКомпоновки.Параметры.Добавить();
					ПараметрСКД.Имя = "ПараметрИсточник_" + РеквизитИсточник;
					ПараметрСКД.Значение = ЗначениеРеквизита; 

					ПоляПараметровФункции.Добавить("ПараметрИсточник_" + РеквизитИсточник);					
					
				КонецЦикла;	
				
			 //формируем строку для параметров функции в СКД
			 ИменаРеквизитовПараметровИсточников.Вставить(ФункцияУсловие.Значение.Идентификатор, СтрСоединить(ПоляПараметровФункции, ",")); 
				
			 КонецЕсли;
		КонецЦикла;	
		//меняем запрос
		НаборДанных.Запрос = "ВЫБРАТЬ ПЕРВЫЕ 1 " + Символы.ПС + ПоляЗапроса + Символы.ПС +
							 "ИСТИНА КАК ПолеРезультат";
		
	КонецЕсли;
	ЕстьФункцияУсловия = Ложь;
	
	Для Каждого ИмяРеквизитаУсловия Из ИменаРеквизитовИзУсловия Цикл 
		
		ФункцияУсловия = ВыбранныеФункцииУсловий.Получить(ИмяРеквизитаУсловия);
		Если ФункцияУсловия <> Неопределено Тогда 
			
			ИмяРеквизитаФункция = ФункцияУсловия.Идентификатор;
			
			ОбщийМодульВВыражении = Метаданные.ОбщиеМодули.Найти(ФункцияУсловия.Выражение) <> Неопределено;
			УказаныРеквизитыФункции = ФункцияУсловия.Свойство("РеквизитыИсточника")	И ЗначениеЗаполнено(ФункцияУсловия.РеквизитыИсточника); 
			
			ПараметрыФункцииУсловия = ?(УказаныРеквизитыФункции,
								 ИменаРеквизитовПараметровИсточников.Получить(ФункцияУсловия.Идентификатор),	
								 "");
			ПредставлениеВыражения = ?(ОбщийМодульВВыражении, 
								 ФункцияУсловия.Выражение + "." + ФункцияУсловия.Идентификатор + "(" + ПараметрыФункцииУсловия + ")",
								 ФункцияУсловия.Выражение + "(" + ПараметрыФункцииУсловия + ")");

			//вычисляемое поле функции условия
			ВычисляемоеПоле = СхемаКомпоновки.ВычисляемыеПоля.Добавить();
			ВычисляемоеПоле.ПутьКДанным = ИмяРеквизитаФункция;
			ВычисляемоеПоле.Заголовок = ФункцияУсловия.Представление;
			ВычисляемоеПоле.Выражение = ПредставлениеВыражения;
			ВычисляемоеПоле.ТипЗначения = Новый ОписаниеТипов("Булево");
			
			//параметр для отбора - булево
			ПараметрСКД = СхемаКомпоновки.Параметры.Добавить();
			ПараметрСКД.Имя = ИмяРеквизитаФункция;
			ПараметрСКД.ТипЗначения = Новый ОписаниеТипов("Булево"); ;
			ПараметрСКД.ВключатьВДоступныеПоля = Истина;
			
			ЕстьФункцияУсловия = Истина;
			
			продолжить;
		КонецЕсли;		
				
		// Внутри скобок точки не должны учитываться, поскольку они часть имени реквизита.
		КоличествоИменРеквизитов = СтрЧислоВхождений(ИмяРеквизитаУсловия,"[");
		Если КоличествоИменРеквизитов > 0 Тогда
			НеделимыйРеквизитНачало = 0;
			СокращенныеИмена = Новый Соответствие;
			Для Сч = 1 По КоличествоИменРеквизитов Цикл
				НеделимыйРеквизитНачало = СтрНайти(ИмяРеквизитаУсловия, "[", , НеделимыйРеквизитНачало+1);
				НеделимыйРеквизитКонец = СтрНайти(ИмяРеквизитаУсловия, "]", , НеделимыйРеквизитНачало);
				
				СокращенныеИмена.Вставить("СокращенноеИмя_"+Сч, Сред(ИмяРеквизитаУсловия, НеделимыйРеквизитНачало, НеделимыйРеквизитКонец - НеделимыйРеквизитНачало+1));
			КонецЦикла;
			
			Для Каждого СокращенноеИмя Из СокращенныеИмена Цикл
				ИмяРеквизитаУсловия = СтрЗаменить(ИмяРеквизитаУсловия, СокращенноеИмя.Значение, СокращенноеИмя.Ключ);
			КонецЦикла;
			РеквизитыУсловия = СтрРазделить(ИмяРеквизитаУсловия, ".");
			
			Для Каждого СокращенноеИмя Из СокращенныеИмена Цикл
				ИндексРеквизитаУсловия = РеквизитыУсловия.Найти(СокращенноеИмя.Ключ);
				Если ИндексРеквизитаУсловия <> Неопределено Тогда
					РеквизитыУсловия.Удалить(ИндексРеквизитаУсловия);
					РеквизитыУсловия.Добавить(СокращенноеИмя.Значение);
				КонецЕсли;
			КонецЦикла;			
		Иначе		
			РеквизитыУсловия = СтрРазделить(ИмяРеквизитаУсловия, ".");
		КонецЕсли;	
				
		ИмяРеквизитаДокумента = РеквизитыУсловия[0];
		
		ПозицияТип = СтрНайти(ИмяРеквизитаДокумента, "типРеквизита_");
		Если ПозицияТип > 0 Тогда
			ИмяРеквизитаДокумента = Сред(ИмяРеквизитаДокумента, 14);
			Если ИменаПолейЗапроса.Получить(РеквизитыУсловия[0]) = Неопределено Тогда
				ИменаПолейЗапроса.Вставить(РеквизитыУсловия[0], Истина);
				НаборДанных.Запрос = НаборДанных.Запрос + ",
					|	ТИПЗНАЧЕНИЯ(Замена." + ИмяРеквизитаДокумента + ") КАК " + РеквизитыУсловия[0];
			КонецЕсли;
		Иначе
			Если ИменаПолейЗапроса.Получить(ИмяРеквизитаДокумента) = Неопределено Тогда
				ИменаПолейЗапроса.Вставить(ИмяРеквизитаДокумента, Истина);
				НаборДанных.Запрос = НаборДанных.Запрос + ",
					|	Замена." + ИмяРеквизитаДокумента + " КАК " + ИмяРеквизитаДокумента;
			КонецЕсли;
		КонецЕсли;
		
		ТипПараметра = Неопределено;
		
		РеквизитДокумента = РеквизитыДокумента.Найти(ИмяРеквизитаДокумента);
		Если РеквизитДокумента <> Неопределено Тогда
			ТипПараметра = РеквизитДокумента.Тип;
		Иначе
			Для Каждого СтандартныйРеквизит Из СтандартныеРеквизитыДокумента Цикл
				Если СтандартныйРеквизит.Имя = ИмяРеквизитаДокумента Тогда
					ТипПараметра = СтандартныйРеквизит.Тип;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Если реквизит не найден, то шаблон считается неподходящим
		Если ТипПараметра = Неопределено Тогда
			ТекстСообщения = НСтр("ru='Не удалось проверить условие использование шаблона: не найден реквизит '") + ИмяРеквизитаДокумента;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ИмяПараметра = СтрСоединить(РеквизитыУсловия, "_");
		ИмяПараметра = СтроковыеФункцииКлиентСервер.ЗаменитьОдниСимволыДругими(" ()[],-.", ИмяПараметра, "");
		
		Если ПозицияТип > 0 Тогда
			ИменаПолейДляЗамены.Вставить("Замена." + ИмяРеквизитаДокумента, "&" + ИмяПараметра);
		Иначе
			ИменаПолейДляЗамены.Вставить("Замена." + ИмяРеквизитаУсловия, "&" + ИмяПараметра);
		КонецЕсли;
		
		РеквизитыУсловия.Удалить(0); // удаление первого реквизита
		
		Если ИмяРеквизитаДокумента = "Ссылка" И РеквизитыУсловия.Количество() = 1
			И Лев(РеквизитыУсловия[0], 1) = "[" И Прав(РеквизитыУсловия[0], 1) = "]" Тогда
			ДополнительныйРеквизит = Сред(РеквизитыУсловия[0], 2, СтрДлина(РеквизитыУсловия[0]) - 2);
		ИначеЕсли РеквизитыУсловия.Количество() = 1
			И Лев(РеквизитыУсловия[0], 1) = "[" И Прав(РеквизитыУсловия[0], 1) = "]" Тогда
			ДополнительныйРеквизит = Сред(РеквизитыУсловия[0], 2, СтрДлина(РеквизитыУсловия[0]) - 2);
		Иначе
			ДополнительныйРеквизит = "";
		КонецЕсли;
		
		ПараметрСКД = СхемаКомпоновки.Параметры.Добавить();
		ПараметрСКД.Имя = ИмяПараметра;
		ПараметрСКД.ТипЗначения = ТипПараметра;
		ПараметрСКД.ВключатьВДоступныеПоля = Истина;
		Если РеквизитыУсловия.Количество() = 0 Тогда
			ПараметрСКД.Значение = Документ[ИмяРеквизитаДокумента];
		ИначеЕсли ДополнительныйРеквизит <> "" Тогда
			ПараметрСКД.Значение = NULL;
			Если ИмяРеквизитаДокумента = "Ссылка" И ИспользуютсяДопРеквизиты Тогда
				ДополнительныеРеквизиты = МодульУправлениеСвойствами.СвойстваОбъекта(Документ, Истина, Ложь);
				Для Каждого Реквизит Из ДополнительныеРеквизиты Цикл
					Если Строка(Реквизит) = ДополнительныйРеквизит Тогда
						ИменаПолейДляЗаменыДопРеквизитов.Вставить(Реквизит, "&" + ИмяПараметра);
						ПараметрСКД.ТипЗначения = Реквизит.ТипЗначения;
						Если Ссылка.Пустая() Тогда
							Для Каждого ДопРеквизит Из Документ["ДополнительныеРеквизиты"] Цикл
								Если ДопРеквизит.Свойство = Реквизит Тогда
									ПараметрСКД.Значение = ДопРеквизит.Значение;
									Прервать;
								КонецЕсли;
							КонецЦикла;
						Иначе
							ПараметрСКД.Значение = МодульУправлениеСвойствами.ЗначениеСвойства(Ссылка, Реквизит);
						КонецЕсли;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли ИмяРеквизитаДокумента <> "Ссылка"
				И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства")
				И МодульУправлениеСвойствами.ИспользоватьДопРеквизиты(Документ[ИмяРеквизитаДокумента]) Тогда
				ДополнительныеРеквизиты = МодульУправлениеСвойствами.СвойстваОбъекта(Документ[ИмяРеквизитаДокумента], Истина, Ложь);
				Для Каждого Реквизит Из ДополнительныеРеквизиты Цикл
					Если Строка(Реквизит) = ДополнительныйРеквизит Тогда
						ИменаПолейДляЗаменыДопРеквизитов.Вставить(Реквизит, "&" + ИмяПараметра);
						ПараметрСКД.ТипЗначения = Реквизит.ТипЗначения;
						ПараметрСКД.Значение = МодульУправлениеСвойствами.ЗначениеСвойства(Документ[ИмяРеквизитаДокумента], Реквизит);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли Документ[ИмяРеквизитаДокумента] <> Неопределено Тогда
			ПараметрСКД.Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ[ИмяРеквизитаДокумента], СтрСоединить(РеквизитыУсловия, "."));
		Иначе
			ПараметрСКД.Значение = NULL;
		КонецЕсли;
		
	КонецЦикла;
	
	НаборДанных.Запрос = НаборДанных.Запрос + "
		|ИЗ
		|	Документ." + МетаданныеОбъекта.Имя + " КАК Замена";
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки));
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("ПолеРезультат");
	
	ГруппировкаКомпоновкиДанных = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаКомпоновкиДанных.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	Для Каждого ЭлементОтбора Из Настройки.ПараметрыДанных.Элементы Цикл
		ЭлементОтбора.Использование = Истина;
	КонецЦикла;
	
	СкопироватьОтборНастроекКомпоновкиДанных(Настройки.Отбор, ОтборИзУсловияИспользования);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, Настройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
	
	// Замену необходимо выполнить в порядке убывания длины полей, чтобы не было ошибочных замен
	СписокДляЗамены = Новый СписокЗначений;
	Для Каждого ИмяДляЗамены Из ИменаПолейДляЗамены Цикл
		СписокДляЗамены.Добавить(ИмяДляЗамены.Ключ, ИмяДляЗамены.Значение);
	КонецЦикла;
	СписокДляЗамены.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	
	Для Каждого ИмяДляЗамены Из СписокДляЗамены Цикл
		МакетКомпоновки.НаборыДанных.Запрос.Запрос = СтрЗаменить(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			ИмяДляЗамены.Значение, ИмяДляЗамены.Представление);
	КонецЦикла;
	
	// Дополнительные реквизиты
	Для к = 1 По СтрЧислоВхождений(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ".Свойство = &П") Цикл
		
		ПозицияСвойство = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ".Свойство = &П", , , к);
		
		ПозицияКАК = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			" КАК ", НаправлениеПоиска.СКонца, ПозицияСвойство);
		ПозицияПеренос = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			Символы.ПС, , ПозицияКАК);
		ПсевдонимТаблицы = Сред(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			ПозицияКАК + 5, ПозицияПеренос - ПозицияКАК - 5);
		
		ПозицияПараметра = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			"&", , ПозицияСвойство);
		ПозицияСкобки = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			")", , ПозицияСвойство);
		ИмяПараметра = Сред(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			ПозицияПараметра + 1, ПозицияСкобки - ПозицияПараметра - 1);
		
		Параметр = МакетКомпоновки.ЗначенияПараметров.Найти(ИмяПараметра);
		ИмяДляЗамены = ИменаПолейДляЗаменыДопРеквизитов[Параметр.Значение];
		
		ПозицияЗначение = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			ПсевдонимТаблицы + ".Значение");
		ПозицияПараметра = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			"&", , ПозицияЗначение);
		Если Сред(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ПозицияПараметра - 1, 1) = "(" Тогда
			ПозицияПараметра = ПозицияПараметра - 1;
		КонецЕсли;
		Если Сред(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ПозицияЗначение - 1, 1) = "(" Тогда
			ПозицияЗначение = ПозицияЗначение - 1;
		КонецЕсли;
		Если Сред(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ПозицияЗначение - 8, 8) = "ВЫРАЗИТЬ" Тогда
			ПозицияЗначение = ПозицияЗначение - 8;
		КонецЕсли;
		Если Сред(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ПозицияЗначение - 1, 1) = "(" Тогда
			ПозицияЗначение = ПозицияЗначение - 1;
		КонецЕсли;
		
		ЗначениеДляЗамены = СокрЛП(Сред(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ПозицияЗначение, ПозицияПараметра - ПозицияЗначение - 3));
		МакетКомпоновки.НаборыДанных.Запрос.Запрос = СтрЗаменить(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			ЗначениеДляЗамены, ИмяДляЗамены);
		
		// Поле может использоваться дополнительно, без скобок, например в случае проверки на NULL, 
		// для этого выполним замену без скобок.
		Если Лев(ЗначениеДляЗамены, 1) = "(" Тогда
			ЗначениеДляЗаменыБезСкобок = Сред(ЗначениеДляЗамены, 2, СтрДлина(ЗначениеДляЗамены)-2);
			МакетКомпоновки.НаборыДанных.Запрос.Запрос = СтрЗаменить(МакетКомпоновки.НаборыДанных.Запрос.Запрос,
			ЗначениеДляЗаменыБезСкобок, ИмяДляЗамены);
		КонецЕсли;
		
	КонецЦикла;
	
	ПозицияИЗ = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос, Символы.ПС + "ИЗ");
	ПозицияГДЕ = СтрНайти(МакетКомпоновки.НаборыДанных.Запрос.Запрос, Символы.ПС + "ГДЕ");
	
	Если ПозицияГДЕ <> 0 Тогда
		МакетКомпоновки.НаборыДанных.Запрос.Запрос = Лев(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ПозицияИЗ - 1) +
			Сред(МакетКомпоновки.НаборыДанных.Запрос.Запрос, ПозицияГДЕ);
	КонецЕсли;		
			
	// При наличии вида сравнения ПОДОБНО необходимо убедиться, что значение параметра слева имеет тип Строка
	СтрокаПоиска = МакетКомпоновки.НаборыДанных.Запрос.Запрос;
	Пока Истина Цикл
		ПозицияПОДОБНО = СтрНайти(СтрокаПоиска, " ПОДОБНО ");
		Если ПозицияПОДОБНО = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияПараметра = СтрНайти(СтрокаПоиска, "&", НаправлениеПоиска.СКонца, ПозицияПОДОБНО);
		ИмяПараметра = Сред(СтрокаПоиска, ПозицияПараметра + 1, ПозицияПОДОБНО - ПозицияПараметра - 1);
		ПараметрМакета = МакетКомпоновки.ЗначенияПараметров.Найти(ИмяПараметра);
		Если ТипЗнч(ПараметрМакета.Значение) <> Тип("Строка") Тогда
			ПараметрМакета.Значение = "";
		КонецЕсли;
		СтрокаПоиска = Сред(СтрокаПоиска, ПозицияПОДОБНО + 9);
	КонецЦикла;
	
	//включение безопасного режима при использовании функций предопределенных условий
	Если ЕстьФункцияУсловия Тогда
		УстановитьБезопасныйРежим(Истина);
		
		Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
			МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
			МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
		Иначе
			МассивРазделителей = Новый Массив;
		КонецЕсли;
		
		Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
			УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
		КонецЦикла;
		
	КонецЕсли; 
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,,Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат Результат.Количество() > 0;
	
КонецФункции

Функция ПредставлениеОтбораКомпоновщикаНастроек(Условие) Экспорт
	
	Если ЗначениеЗаполнено(Условие) Тогда
		Настройки = ОбщегоНазначения.ЗначениеИзСтрокиXML(Условие);
		Возврат Строка(Настройки.Отбор);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Процедура ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки,
													ПредставлениеОтбора = Неопределено,
													КомпоновщикНастроек = Неопределено,
													СхемаКомпоновкиДанных = Неопределено,
													УникальныйИдентификатор = Неопределено,
													Отказ = Ложь) Экспорт
													
	// Формирование источника схемы компоновки
	
	Если ПараметрыНастройки.Свойство("ТекстЗапроса") Тогда
		ТекстЗапроса = ПараметрыНастройки.ТекстЗапроса;
	Иначе
		Если ПараметрыНастройки.Свойство("ТипЗначения") Тогда
			ТипЗначения = ПараметрыНастройки.ТипЗначения;
		ИначеЕсли ПараметрыНастройки.Свойство("Реквизит") Тогда
			ТипЗначения = ПараметрыНастройки.Реквизит.ТипЗначения;
		ИначеЕсли ПараметрыНастройки.Свойство("ИдентификаторДокумента") Тогда
			ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
				ТипЗнч(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыНастройки.ИдентификаторДокумента, "ЗначениеПустойСсылки"))));
		Иначе
			ВызватьИсключение "Неверный вызов формы. Необходимо передать текст запроса, тип значения, или идентификатор документа";
		КонецЕсли;
		
		ТекстЗапроса = СформироватьТекстЗапроса(ТипЗначения, Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ТекстСообщения = НСтр("ru='Для данного типа не поддерживается установка отбора'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	// Формирование схемы компоновки
	
	Если УникальныйИдентификатор = Неопределено Тогда
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.ТипИсточникаДанных = "Local";
	ИсточникДанных.Имя = "ЭтаИБ";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.АвтоЗаполнениеДоступныхПолей	= Истина;
	НаборДанных.ИсточникДанных					= ИсточникДанных.Имя;
	НаборДанных.Запрос							= ТекстЗапроса;
	
	ОписаниеФункций = ОписаниеФункцийПредопределенныхУсловий();
	ДобавитьФункцииПредопределенныхУсловий(ОписаниеФункций, ПараметрыНастройки, СхемаКомпоновки);
		
	// Скрываем исключаемые поля
	Если ПараметрыНастройки.Свойство("ИсключенныеПоля") Тогда
		Для Каждого Поле Из ПараметрыНастройки.ИсключенныеПоля Цикл
			ПолеСхемы = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ПолеСхемы.Поле = Поле;
			ПолеСхемы.ПутьКДанным = Поле;
			ПолеСхемы.ОграничениеИспользования.Группировка	= Истина;
			ПолеСхемы.ОграничениеИспользования.Поле			= Истина;
			ПолеСхемы.ОграничениеИспользования.Порядок		= Истина;
			ПолеСхемы.ОграничениеИспользования.Условие		= Истина;
		КонецЦикла;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
	Если КомпоновщикНастроек = Неопределено Тогда
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КонецЕсли;
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	
	// Загрузка настроек из сериализованного представления
	
	Если ПараметрыНастройки.Свойство("НастройкиОтбора") Тогда
		СериализованнаяНастройка = ПараметрыНастройки.НастройкиОтбора;
		Если ЗначениеЗаполнено(СериализованнаяНастройка) Тогда
			Попытка
				Настройки = ОбщегоНазначения.ЗначениеИзСтрокиXML(СериализованнаяНастройка);
				КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
				КомпоновщикНастроек.Восстановить();
			Исключение
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли ПараметрыНастройки.Свойство("Отбор") Тогда
		СериализованныйОтбор = ПараметрыНастройки.Отбор;
		Если ЗначениеЗаполнено(СериализованныйОтбор) Тогда
			Попытка
				Отбор = ОбщегоНазначения.ЗначениеИзСтрокиXML(СериализованныйОтбор);
				Настройки = КомпоновщикНастроек.ПолучитьНастройки();
				СкопироватьОтборНастроекКомпоновкиДанных(Настройки.Отбор, Отбор);
				КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
				КомпоновщикНастроек.Восстановить();
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	// Формирование представления отбора
	ПредставлениеОтбора = Строка(КомпоновщикНастроек.Настройки.Отбор);
	
КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных
Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(Описание) Экспорт
	
	Описание = Описание + "
		|Задача.ЗадачаПоОбработкеДокумента.Чтение.Пользователи
		|Задача.ЗадачаПоОбработкеДокумента.Изменение.Пользователи
		|РегистрСведений.РегламентныеИнтервалыДокументов.Изменение.Пользователи
		|Справочник.ДополнительноеЗаданиеПрисоединенныеФайлы.Чтение.Объект.Документ.ДополнительноеЗадание
		|Справочник.ДополнительноеЗаданиеПрисоединенныеФайлы.Изменение.Объект.Документ.ДополнительноеЗадание
		|";

КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа
Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.Задачи.ЗадачаПоОбработкеДокумента, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.РегламентныеИнтервалыДокументов, Истина);
	Списки.Вставить(Метаданные.Справочники.ДополнительноеЗаданиеПрисоединенныеФайлы, Истина);
	
КонецПроцедуры

// См. РегламентныеЗаданияПереопределяемый.ПриОпределенииНастроекРегламентныхЗаданий
Процедура ПриОпределенииНастроекРегламентныхЗаданий(Настройки) Экспорт
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.УведомлениеОНовыхЗадачахПоОбработкеДокументов;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ИспользоватьПроцессыОбработкиДокументов;
	Настройка.РаботаетСВнешнимиРесурсами = Истина;
	Настройка.ВключатьПриВключенииФункциональнойОпции = Ложь;
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.ЗаполнениеДополнительныхКолонокЗадач;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ИспользоватьПроцессыОбработкиДокументов;
	Настройка.ВключатьПриВключенииФункциональнойОпции = Ложь;
	
КонецПроцедуры

// См. ОчередьЗаданийПереопределяемый.ПриПолученииСпискаШаблонов
//
Процедура ПриПолученииСпискаШаблонов(ШаблоныЗаданий) Экспорт
	
	ШаблоныЗаданий.Добавить(Метаданные.РегламентныеЗадания.УведомлениеОНовыхЗадачахПоОбработкеДокументов.Имя);
	ШаблоныЗаданий.Добавить(Метаданные.РегламентныеЗадания.ЗаполнениеДополнительныхКолонокЗадач.Имя);
	
КонецПроцедуры

// См. ОчередьЗаданийПереопределяемый.ПриОпределенииПсевдонимовОбработчиков
//
Процедура ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам) Экспорт
	
