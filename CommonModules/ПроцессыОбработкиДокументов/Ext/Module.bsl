Функция ИдентификаторыАктивныхФоновыхЗаданий() Экспорт
	
	ИдентификаторыЗаданийПоКлючам = Новый Соответствие;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	Отбор.Вставить("Наименование", "ПроцессыОбработкиДокументов.ВыполнитьЗадачи");
	
	Для Каждого ФоновоеЗадание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		ИдентификаторыЗаданийПоКлючам.Вставить(ФоновоеЗадание.Ключ, ФоновоеЗадание.УникальныйИдентификатор);
	КонецЦикла;
	
	Возврат ИдентификаторыЗаданийПоКлючам;
	
КонецФункции

Функция ПользовательМожетПринятьКИсполнениюЗадачу(Пользователь, Задача, Результат) Экспорт
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриПроверкеПраваПринятияКИсполнениюЗадачи(Задача.Ссылка, Пользователь, Результат);
	Если Результат = Истина Тогда
		Возврат Истина;
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПользовательМожетОтменитьПринятиеКИсполнениюЗадачи(Пользователь, Задача, Результат) Экспорт
	
	Если Пользователи.РолиДоступны("ОтменаПринятияКИсполнениюЗадачПоОбработкеДокументов",Пользователь) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриПроверкеПраваОтменыПринятияКИсполнениюЗадачи(Задача.Ссылка, Пользователь, Результат);
	Если Результат = Истина Тогда
		Возврат Истина;
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Стандартные проверки
	
	// Исполнитель задачи может отменить в любом случае
	Если Задача.Исполнитель = Пользователь Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ПользователюПереданоПравоОтменыВыполненияПринятияКИсполнениюЗадачи(Пользователь, Задача) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Результат = НСтр("ru = 'Задача принята к исполнению другим исполнителем.'");
	Возврат Ложь;
	
КонецФункции

Функция ПользовательМожетОтменитьВыполнениеЗадачи(Пользователь, Задача, Результат) Экспорт
	
	Если Пользователи.РолиДоступны("ОтменаВыполненияЗадачПоОбработкеДокументов",Пользователь) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриПроверкеПраваОтменыВыполненияЗадачи(Задача.Ссылка, Пользователь, Результат);
	Если Результат = Истина Тогда
		Возврат Истина;
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Стандартные проверки
	Если Пользователи.ЭтоПолноправныйПользователь(Пользователь) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Исполнитель задачи может отменить в любом случае
	Если Задача.Исполнитель = Пользователь Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ПользователюПереданоПравоОтменыВыполненияПринятияКИсполнениюЗадачи(Пользователь, Задача) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Результат = НСтр("ru = 'Задача выполнена другим исполнителем.'");
	Возврат Ложь;
	
КонецФункции

Функция МаршрутыШаблонаОтНачальногоЭтапаДоКонечного(ТаблицаПредшественников, ИдентификаторНачальногоЭтапа, ИдентификаторКонечногоЭтапа) Экспорт
	
	// Массив, где каждый элемент - массив маршрутов до конечного этапа
	Маршруты = Новый Массив;
	
	БазовыйМаршрут = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторНачальногоЭтапа);
	
	ПроложитьМаршрутыДоКонечногоЭтапа(
		Маршруты, БазовыйМаршрут, ТаблицаПредшественников, Новый Соответствие, ИдентификаторКонечногоЭтапа);
	
	Возврат Маршруты;
	
КонецФункции

Функция ТаблицаПредшественниковПоМаршрутам(Маршруты) Экспорт
	
	ТаблицаПредшественников = Новый ТаблицаЗначений;
	ТаблицаПредшественников.Колонки.Добавить("ИдентификаторПредшественника");
	ТаблицаПредшественников.Колонки.Добавить("ИдентификаторПоследователя");
	
	НулевойПредшественник = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	
	ПоследователиЭтапа = Новый Соответствие;
	
	Для Каждого Маршрут Из Маршруты Цикл
		Для ИндексЭтапа = 0 По Маршрут.ВГраница() Цикл
			ПредыдущийЭтап = ?(ИндексЭтапа = 0, НулевойПредшественник, Маршрут[ИндексЭтапа-1]);
			ТекущийЭтап = Маршрут[ИндексЭтапа];
			Последователи = ПоследователиЭтапа.Получить(ПредыдущийЭтап);
			Если Последователи = Неопределено Тогда
				ПоследователиЭтапа.Вставить(ПредыдущийЭтап, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущийЭтап));
			Иначе
				Если Последователи.Найти(ТекущийЭтап) = Неопределено Тогда
					Последователи.Добавить(ТекущийЭтап);
					ПоследователиЭтапа.Вставить(ПредыдущийЭтап, Последователи);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого Предшественник Из ПоследователиЭтапа Цикл
		Для Каждого Последователь Из Предшественник.Значение Цикл
			НоваяСтрокаПредшественники = ТаблицаПредшественников.Добавить();
			НоваяСтрокаПредшественники.ИдентификаторПредшественника = Предшественник.Ключ;
			НоваяСтрокаПредшественники.ИдентификаторПоследователя = Последователь;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаПредшественников;
	
КонецФункции

Процедура ЗаполнитьДеревоЭтапов(ДеревоЭтапов, ТаблицаЭтапов, Маршруты) Экспорт
	
	//Найдем общую подпоследовательность в маршрутах
	ОбщиеЭтапыМаршрутов = Новый Массив;
	
	Для Каждого Этап Из Маршруты[0] Цикл
		ЭтоОбщийЭтап = Истина;
		Для Каждого Маршрут Из Маршруты Цикл
			Если Маршрут.Найти(Этап) = Неопределено Тогда
				ЭтоОбщийЭтап = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоОбщийЭтап Тогда
			ОбщиеЭтапыМаршрутов.Добавить(Этап);
		КонецЕсли;
	КонецЦикла;
	
	// Для каждого общего этапа найдем список его необщих последователей для определения места вставки в дерево
	ПоследователиОбщихЭтапов = Новый Соответствие;
	Для Каждого Маршрут Из Маршруты Цикл
		ПредыдущийОбщийЭтап = Неопределено;
		ПоследователиОбщихЭтаповМаршрута = Новый Соответствие;
		Для Каждого Этап Из Маршрут Цикл
			Если ОбщиеЭтапыМаршрутов.Найти(Этап) = Неопределено Тогда
				// это не общий этап, сохраним его общего предшественника
				Последователи = ПоследователиОбщихЭтаповМаршрута.Получить(ПредыдущийОбщийЭтап);
				Если Последователи = Неопределено Тогда
					ПоследователиОбщихЭтаповМаршрута.Вставить(ПредыдущийОбщийЭтап, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Этап));
				Иначе
					Последователи.Добавить(Этап);
					ПоследователиОбщихЭтаповМаршрута.Вставить(ПредыдущийОбщийЭтап, Последователи);
				КонецЕсли;
			Иначе
				ПредыдущийОбщийЭтап = Этап;
			КонецЕсли;
		КонецЦикла;
		// Добавим массив последователей общего этапа маршрута в общий массив последователей общих этапов
		Для Каждого ПоследователиОбщегоЭтапаМаршрута Из ПоследователиОбщихЭтаповМаршрута Цикл
			Подмаршруты = ПоследователиОбщихЭтапов.Получить(ПоследователиОбщегоЭтапаМаршрута.Ключ);
			Если Подмаршруты = Неопределено Тогда
				ПоследователиОбщихЭтапов.Вставить(ПоследователиОбщегоЭтапаМаршрута.Ключ, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПоследователиОбщегоЭтапаМаршрута.Значение));
			Иначе
				// Проверка, что такого подмаршрута последователей еще нет, чтобы не дублировать значения
				ТакойПодмаршрутУжеЕсть = Ложь;
				Для Каждого Подмаршрут Из Подмаршруты Цикл
					Если ОбщегоНазначенияКлиентСервер.СпискиЗначенийИдентичны(Подмаршрут, ПоследователиОбщегоЭтапаМаршрута.Значение) Тогда
						ТакойПодмаршрутУжеЕсть = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ ТакойПодмаршрутУжеЕсть Тогда
					Подмаршруты.Добавить(ПоследователиОбщегоЭтапаМаршрута.Значение);
					ПоследователиОбщихЭтапов.Вставить(ПоследователиОбщегоЭтапаМаршрута.Ключ, Подмаршруты);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ОбщийЭтап Из ОбщиеЭтапыМаршрутов Цикл
		
		ЗаполнитьСвойстваЭтапаВСтроке(ДеревоЭтапов.ПолучитьЭлементы().Добавить(), ОбщийЭтап, ТаблицаЭтапов);
		
		ПоследователиОбщегоЭтапа = ПоследователиОбщихЭтапов.Получить(ОбщийЭтап);
		Если ПоследователиОбщегоЭтапа <> Неопределено Тогда
			
			//Если у общего этапа только один необщий маршрут-последователь, то группу параллельных этапов делать не надо
			Если ПоследователиОбщегоЭтапа.Количество() = 1 Тогда
				Для Каждого Этап Из ПоследователиОбщегоЭтапа[0] Цикл
					ЗаполнитьСвойстваЭтапаВСтроке(ДеревоЭтапов.ПолучитьЭлементы().Добавить(), Этап, ТаблицаЭтапов);
				КонецЦикла;
			Иначе
				
				СтрокаПервогоУровня = ДобавитьПараллельнуюГруппуВДерево(ДеревоЭтапов);
				
				Для Каждого Подмаршрут Из ПоследователиОбщегоЭтапа Цикл
					Если Подмаршрут.Количество() > 1 Тогда
						СтрокаВторогоУровня = ДобавитьПоследовательнуюГруппуВДерево(СтрокаПервогоУровня);
						Для Каждого Этап Из Подмаршрут Цикл
							ЗаполнитьСвойстваЭтапаВСтроке(СтрокаВторогоУровня.ПолучитьЭлементы().Добавить(), Этап, ТаблицаЭтапов);
						КонецЦикла;
					Иначе
						ЗаполнитьСвойстваЭтапаВСтроке(СтрокаПервогоУровня.ПолучитьЭлементы().Добавить(), Подмаршрут[0], ТаблицаЭтапов);
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// Если в дереве есть одинаковые этапы, то их ветки надо объединить с выделением общей части
	ОбъединениеГруппЭтаповДерева(ДеревоЭтапов);
	
	УпроститьДерево(ДеревоЭтапов);
	
КонецПроцедуры

Процедура ЗаполнитьСвойстваЭтапаВСтроке(Строка, ИдентификаторЭтапа, ТаблицаЭтапов) Экспорт
	
	СвойстваЭтапа = ТаблицаЭтапов.НайтиСтроки(Новый Структура("ИдентификаторЭтапа", ИдентификаторЭтапа))[0];
	
	ЗаполнитьЗначенияСвойств(Строка, СвойстваЭтапа);
	
КонецПроцедуры

Функция ГрафикРаботыИсполнителя(РеквизитыАдресации, СтандартнаяОбработка) Экспорт
	
	ГрафикРаботы = Неопределено;
	ПроцессыОбработкиДокументовПереопределяемый.ПриОпределенииГрафикаРаботыИсполнителя(РеквизитыАдресации, ГрафикРаботы, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ГрафикиРаботы") Тогда
			ГрафикРаботы = Константы.ОсновнойГрафикРаботы.Получить();
			Если Не ЗначениеЗаполнено(ГрафикРаботы) Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не указан основной график работы'"));
			КонецЕсли;
		Иначе
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'График работы не определен'"));
		КонецЕсли;
	КонецЕсли;
	
	Возврат ГрафикРаботы;
	
КонецФункции

Процедура РасчетРегламентныхСроковЭтапаИЕгоПредшественников(Результат, ИдентификаторЭтапа, СрокПоРегламенту,
		ИнтервалыРабочегоВремени, ГрафикРаботы, СтандартнаяОбработка, Предшественники, РассчитанныеЭтапы) Экспорт
	
	Если ИдентификаторЭтапа = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРезультата = Результат.Найти(ИдентификаторЭтапа, "ИдентификаторЭтапа");
	Если ЗначениеЗаполнено(СтрокаРезультата.СрокПоРегламенту) Тогда
		СтрокаРезультата.СрокПоРегламенту = Мин(СтрокаРезультата.СрокПоРегламенту, СрокПоРегламенту);
	Иначе
		СтрокаРезультата.СрокПоРегламенту = СрокПоРегламенту;
	КонецЕсли;
	
	// Если все последователи этапа рассчитаны, то только тогда можно переходить к расчету времени начала этого этапа
	Последователи = Предшественники.НайтиСтроки(Новый Структура("ИдентификаторПредшественника", ИдентификаторЭтапа));
	Для Каждого Последователь Из Последователи Цикл
		Если РассчитанныеЭтапы.Получить(Последователь.ИдентификаторПоследователя) = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	СрокВСекундах = СтрокаРезультата.СрокВыполненияЧасы * 60 * 60;
	
	Если Константы.ИспользоватьГрафикиРаботы.Получить() Тогда
		СтрокаРезультата.НачалоЭтапаНеПозднее = ДатаПоГрафикуДоНаступленияСрока(ИнтервалыРабочегоВремени, ГрафикРаботы,
			СтандартнаяОбработка, СтрокаРезультата.СрокПоРегламенту, СрокВСекундах);
	Иначе
		СтрокаРезультата.НачалоЭтапаНеПозднее = СтрокаРезультата.СрокПоРегламенту - СрокВСекундах;
	КонецЕсли;
		
	// Расчет срока напоминания
	СрокНапоминанияМинуты = ?(Константы.НапоминатьОПриближенииСрокаВыполненияЗадач.Получить(), Константы.СрокНапоминанияМинуты.Получить(), 0);
	СрокВСекундах = СрокНапоминанияМинуты * 60;
	
	Если Константы.ИспользоватьГрафикиРаботы.Получить() Тогда
		СтрокаРезультата.СрокНапоминания = ДатаПоГрафикуДоНаступленияСрока(ИнтервалыРабочегоВремени, ГрафикРаботы,
			СтандартнаяОбработка, СтрокаРезультата.СрокПоРегламенту, СрокВСекундах);
	Иначе
		СтрокаРезультата.СрокНапоминания = СтрокаРезультата.СрокПоРегламенту - СрокВСекундах;
	КонецЕсли;
	
	РассчитанныеЭтапы.Вставить(СтрокаРезультата.ИдентификаторЭтапа, Истина);
	
	// Заполнение сроков по регламенту для предшественников этапа
	ПредшественникиЭтапа = Предшественники.НайтиСтроки(Новый Структура("ИдентификаторПоследователя", СтрокаРезультата.ИдентификаторЭтапа));
	Для Каждого Предшественник Из ПредшественникиЭтапа Цикл
		РасчетРегламентныхСроковЭтапаИЕгоПредшественников(Результат, Предшественник.ИдентификаторПредшественника,
			СтрокаРезультата.НачалоЭтапаНеПозднее, ИнтервалыРабочегоВремени, ГрафикРаботы,
			СтандартнаяОбработка, Предшественники, РассчитанныеЭтапы);
	КонецЦикла;
	
КонецПроцедуры

Функция ПустаяТаблицаРабочегоВремени() Экспорт
	
	ТаблицаРабочегоВремени = Новый ТаблицаЗначений;
	ТаблицаРабочегоВремени.Колонки.Добавить("ДатаНачала");
	ТаблицаРабочегоВремени.Колонки.Добавить("ДатаОкончания");
	ТаблицаРабочегоВремени.Колонки.Добавить("Длительность");
	
	Возврат ТаблицаРабочегоВремени;
	
КонецФункции

Функция ПредставлениеСрокаВыполненияИнтервала(Параметры) Экспорт
	
	ИспользуютсяГрафикиРаботы = ПроцессыОбработкиДокументовВызовСервера.ИспользуютсяГрафикиРаботы();
	
	Возврат ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеСрокаВыполненияИнтервала(Параметры, ИспользуютсяГрафикиРаботы);
	
КонецФункции

Функция ВремяВыполненияЗадачи(Задача, ДатаИсполнения, ДатаПоследнейОтменыВыполнения, ИнтервалыРабочегоВремени = Неопределено) Экспорт
	
	ДатаОтсчета = Задача.Дата;
	
	Если НЕ Задача.Ссылка.Пустая() Тогда
		
		ДатаПоследнейОтменыВыполнения = Дата(1, 1, 1);
		
		// Определим дату последней отмены выполнения задачи
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИсторияЗадачПоОбработкеДокументовСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.ИсторияЗадачПоОбработкеДокументов.СрезПоследних(
		|			,
		|			Задача = &Задача
		|				И Событие = &Событие) КАК ИсторияЗадачПоОбработкеДокументовСрезПоследних";
		
		Запрос.УстановитьПараметр("Задача", Задача.Ссылка);
		Запрос.УстановитьПараметр("Событие", ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.ОтменаВыполнения"));
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДатаПоследнейОтменыВыполнения = Выборка.Период;
			ДатаОтсчета = ДатаПоследнейОтменыВыполнения;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РабочееВремяМеждуДатами(ДатаОтсчета, ДатаИсполнения, Задача, ИнтервалыРабочегоВремени);
	
КонецФункции

Функция УстановленныйСтатус(Предмет, Установил) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИсторияИзмененияСтатусовДокументов.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов
	|ГДЕ
	|	ИсторияИзмененияСтатусовДокументов.Предмет = &Предмет
	|	И ИсторияИзмененияСтатусовДокументов.Установил = &Установил";
	Запрос.УстановитьПараметр("Предмет", Предмет);
	Запрос.УстановитьПараметр("Установил", Установил);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		УстановленСтатус = Выборка.Статус;
	Иначе
		УстановленСтатус = ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка");
	КонецЕсли;
	
	Возврат УстановленСтатус;
	
КонецФункции

Процедура ИзменитьИсториюСтатусовДокумента(Документ, Шаблон, Статус, Знач Установил, Период = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Установил) Тогда
		Установил = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ИсторияИзмененияСтатусовДокументов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Предмет = Документ;
	МенеджерЗаписи.Установил = Установил;
	МенеджерЗаписи.Статус = Статус;
	МенеджерЗаписи.ДатаУстановки = Период;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи.Записать(Ложь);
	
КонецПроцедуры

Процедура УстановитьТекущийСтатусДокумента(Документ, Шаблон, Статус, Знач Установил, Период = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Установил) Тогда
		Установил = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	// текущий статус устанавливается, если нет активных невыполненных задач (c заполненным конечным статусом)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Задача
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|		ПО ЗадачаПоОбработкеДокумента.Этап = ЭтапыПроцессовРезультатыВыполнения.Ссылка
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|	И НЕ ЗадачаПоОбработкеДокумента.Выполнена
	|	И НЕ ЗадачаПоОбработкеДокумента.ПометкаУдаления
	|	И НЕ ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = ЗНАЧЕНИЕ(Справочник.СтатусыДокументов.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Запрос.Выполнить().Пустой() Тогда
		МенеджерЗаписи = РегистрыСведений.ТекущиеСтатусыДокументов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Предмет = Документ;
		МенеджерЗаписи.Статус = Статус;
		МенеджерЗаписи.Шаблон = Шаблон;
		МенеджерЗаписи.Установил = Установил;
		МенеджерЗаписи.ДатаУстановки = Период;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ИсполнителиЭтапаПроцесса(Документ, Шаблон, Параметры) Экспорт
	
	ИсполнителиЭтапа = Новый Массив;
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
		Ссылка = Документ;
	Иначе
		Ссылка = Документ.Ссылка;
	КонецЕсли;
	
	Если Параметры.ЭтапВыполняетсяНесколькимиИсполнителями Тогда
		
		МетаданныеДокумента = Ссылка.Метаданные();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ШаблоныПроцессовИсполнителиГрупповыхЭтапов.Исполнитель КАК Исполнитель,
		|	ШаблоныПроцессовИсполнителиГрупповыхЭтапов.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
		|	ШаблоныПроцессовИсполнителиГрупповыхЭтапов.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации,
		|	ШаблоныПроцессовИсполнителиГрупповыхЭтапов.ИмяРеквизитаОсновногоОбъектаАдресации КАК ИмяРеквизитаОсновногоОбъектаАдресации,
		|	ШаблоныПроцессовИсполнителиГрупповыхЭтапов.ИмяРеквизитаДополнительногоОбъектаАдресации КАК ИмяРеквизитаДополнительногоОбъектаАдресации
		|ИЗ
		|	Справочник.ШаблоныПроцессов.ИсполнителиГрупповыхЭтапов КАК ШаблоныПроцессовИсполнителиГрупповыхЭтапов
		|ГДЕ
		|	ШаблоныПроцессовИсполнителиГрупповыхЭтапов.Ссылка = &Шаблон
		|	И ШаблоныПроцессовИсполнителиГрупповыхЭтапов.ИдентификаторЭтапа = &ИдентификаторЭтапа
		|
		|УПОРЯДОЧИТЬ ПО
		|	ШаблоныПроцессовИсполнителиГрупповыхЭтапов.НомерСтроки";
		
		Запрос.УстановитьПараметр("Шаблон", Шаблон);
		Запрос.УстановитьПараметр("ИдентификаторЭтапа", Параметры.ИдентификаторЭтапа);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			// Если в качестве объекта адресации указан реквизит табличной части документа, то необходимо создать
			// несколько задач по числу соответствующих уникальных значений реквизитов этой табличной части
			ИмяТабличнойЧасти = Неопределено;
			ИмяРеквизитаООА = Неопределено;
			ИмяРеквизитаООА2Уровень = "";
			ИмяРеквизитаДОА = Неопределено;
			ИмяРеквизитаДОА2Уровень = "";
			
			Если ТипЗнч(Выборка.Исполнитель) = Тип("СправочникСсылка.РолиИсполнителей") Тогда
				Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Исполнитель, "ИспользуетсяСОбъектамиАдресации") Тогда
					Если ЗначениеЗаполнено(Выборка.ИмяРеквизитаОсновногоОбъектаАдресации)
						И Лев(Выборка.ИмяРеквизитаОсновногоОбъектаАдресации, 1) <> "*" Тогда
						ЧастиИмениРеквизита = СтрРазделить(Выборка.ИмяРеквизитаОсновногоОбъектаАдресации, ".");
						Если МетаданныеДокумента.ТабличныеЧасти.Найти(ЧастиИмениРеквизита[0]) <> Неопределено Тогда
							ИмяТабличнойЧасти = ЧастиИмениРеквизита[0];
							ИмяРеквизитаООА = ЧастиИмениРеквизита[1];
							Если ЧастиИмениРеквизита.Количество() = 3 Тогда
								ИмяРеквизитаООА2Уровень = ЧастиИмениРеквизита[2];
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					Если ЗначениеЗаполнено(Выборка.ИмяРеквизитаДополнительногоОбъектаАдресации)
						И Лев(Выборка.ИмяРеквизитаДополнительногоОбъектаАдресации, 1) <> "*" Тогда
						ЧастиИмениРеквизита = СтрРазделить(Выборка.ИмяРеквизитаДополнительногоОбъектаАдресации, ".");
						Если МетаданныеДокумента.ТабличныеЧасти.Найти(ЧастиИмениРеквизита[0]) <> Неопределено Тогда
							ИмяТабличнойЧасти = ЧастиИмениРеквизита[0];
							ИмяРеквизитаДОА = ЧастиИмениРеквизита[1];
							Если ЧастиИмениРеквизита.Количество() = 3 Тогда
								ИмяРеквизитаДОА2Уровень = ЧастиИмениРеквизита[2];
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ИмяРеквизитаООА <> Неопределено И ИмяРеквизитаДОА <> Неопределено Тогда
				
				ЗначенияРеквизитовСОбъектамиАдресации = Документ[ИмяТабличнойЧасти].Выгрузить(, ИмяРеквизитаООА + "," + ИмяРеквизитаДОА);
				ЗначенияРеквизитовСОбъектамиАдресации.Свернуть(ИмяРеквизитаООА + "," + ИмяРеквизитаДОА);
				
				Если ИмяРеквизитаООА2Уровень <> "" ИЛИ ИмяРеквизитаДОА2Уровень <> "" Тогда
					Если ИмяРеквизитаООА2Уровень <> "" Тогда
						ЗначенияРеквизитовСОбъектамиАдресации.Колонки.Добавить(ИмяРеквизитаООА+ИмяРеквизитаООА2Уровень);
					КонецЕсли;
					Если ИмяРеквизитаДОА2Уровень <> "" Тогда
						ЗначенияРеквизитовСОбъектамиАдресации.Колонки.Добавить(ИмяРеквизитаДОА+ИмяРеквизитаДОА2Уровень);
					КонецЕсли;
					Для Каждого ОбъектыАдресации Из ЗначенияРеквизитовСОбъектамиАдресации Цикл
						Если ИмяРеквизитаООА2Уровень <> "" Тогда
							ОбъектыАдресации[ИмяРеквизитаООА+ИмяРеквизитаООА2Уровень] = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
								ОбъектыАдресации[ИмяРеквизитаООА], ИмяРеквизитаООА2Уровень);
						КонецЕсли;
						Если ИмяРеквизитаДОА2Уровень <> "" Тогда
							ОбъектыАдресации[ИмяРеквизитаДОА+ИмяРеквизитаДОА2Уровень] = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
								ОбъектыАдресации[ИмяРеквизитаДОА], ИмяРеквизитаДОА2Уровень);
						КонецЕсли;
					КонецЦикла;
					ЗначенияРеквизитовСОбъектамиАдресации.Свернуть(
						ИмяРеквизитаООА+ИмяРеквизитаООА2Уровень + "," + ИмяРеквизитаДОА+ИмяРеквизитаДОА2Уровень);
				КонецЕсли;
				
				Для Каждого ОбъектыАдресации Из ЗначенияРеквизитовСОбъектамиАдресации Цикл
					
					ИсполнительЭтапа = Новый Структура;
					ИсполнительЭтапа.Вставить("Исполнитель", Выборка.Исполнитель);
					ИсполнительЭтапа.Вставить("ОсновнойОбъектАдресации", ОбъектыАдресации[ИмяРеквизитаООА+ИмяРеквизитаООА2Уровень]);
					ИсполнительЭтапа.Вставить("ДополнительныйОбъектАдресации", ОбъектыАдресации[ИмяРеквизитаДОА+ИмяРеквизитаДОА2Уровень]);
					ИсполнительЭтапа.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", "");
					ИсполнительЭтапа.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", "");
					
					ИсполнителиЭтапа.Добавить(ИсполнительЭтапа);
					
				КонецЦикла;
				
			ИначеЕсли ИмяРеквизитаООА <> Неопределено Тогда
				
				ЗначенияРеквизитовСОбъектамиАдресации = Документ[ИмяТабличнойЧасти].Выгрузить(, ИмяРеквизитаООА);
				ЗначенияРеквизитовСОбъектамиАдресации.Свернуть(ИмяРеквизитаООА);
				
				Если ИмяРеквизитаООА2Уровень <> "" Тогда
					ЗначенияРеквизитовСОбъектамиАдресации.Колонки.Добавить(ИмяРеквизитаООА+ИмяРеквизитаООА2Уровень);
					Для Каждого ОбъектыАдресации Из ЗначенияРеквизитовСОбъектамиАдресации Цикл
						ОбъектыАдресации[ИмяРеквизитаООА+ИмяРеквизитаООА2Уровень] = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
							ОбъектыАдресации[ИмяРеквизитаООА], ИмяРеквизитаООА2Уровень);
					КонецЦикла;
					ЗначенияРеквизитовСОбъектамиАдресации.Свернуть(ИмяРеквизитаООА+ИмяРеквизитаООА2Уровень);
				КонецЕсли;
				
				Для Каждого ОбъектыАдресации Из ЗначенияРеквизитовСОбъектамиАдресации Цикл
					
					ИсполнительЭтапа = Новый Структура;
					ИсполнительЭтапа.Вставить("Исполнитель", Выборка.Исполнитель);
					ИсполнительЭтапа.Вставить("ОсновнойОбъектАдресации", ОбъектыАдресации[ИмяРеквизитаООА+ИмяРеквизитаООА2Уровень]);
					ИсполнительЭтапа.Вставить("ДополнительныйОбъектАдресации", Выборка.ДополнительныйОбъектАдресации);
					ИсполнительЭтапа.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", "");
					ИсполнительЭтапа.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", Выборка.ИмяРеквизитаДополнительногоОбъектаАдресации);
					
					ИсполнителиЭтапа.Добавить(ИсполнительЭтапа);
					
				КонецЦикла;
				
			ИначеЕсли ИмяРеквизитаДОА <> Неопределено Тогда
				
				ЗначенияРеквизитовСОбъектамиАдресации = Документ[ИмяТабличнойЧасти].Выгрузить(, ИмяРеквизитаДОА);
				ЗначенияРеквизитовСОбъектамиАдресации.Свернуть(ИмяРеквизитаДОА);
				
				Если ИмяРеквизитаДОА2Уровень <> "" Тогда
					ЗначенияРеквизитовСОбъектамиАдресации.Колонки.Добавить(ИмяРеквизитаДОА+ИмяРеквизитаДОА2Уровень);
					Для Каждого ОбъектыАдресации Из ЗначенияРеквизитовСОбъектамиАдресации Цикл
						ОбъектыАдресации[ИмяРеквизитаДОА+ИмяРеквизитаДОА2Уровень] = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
							ОбъектыАдресации[ИмяРеквизитаДОА], ИмяРеквизитаДОА2Уровень);
					КонецЦикла;
					ЗначенияРеквизитовСОбъектамиАдресации.Свернуть(ИмяРеквизитаДОА+ИмяРеквизитаДОА2Уровень);
				КонецЕсли;
				
				Для Каждого ОбъектыАдресации Из ЗначенияРеквизитовСОбъектамиАдресации Цикл
					
					ИсполнительЭтапа = Новый Структура;
					ИсполнительЭтапа.Вставить("Исполнитель", Выборка.Исполнитель);
					ИсполнительЭтапа.Вставить("ОсновнойОбъектАдресации", Выборка.ОсновнойОбъектАдресации);
					ИсполнительЭтапа.Вставить("ДополнительныйОбъектАдресации", ОбъектыАдресации[ИмяРеквизитаДОА+ИмяРеквизитаДОА2Уровень]);
					ИсполнительЭтапа.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", Выборка.ИмяРеквизитаОсновногоОбъектаАдресации);
					ИсполнительЭтапа.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", "");
					
					ИсполнителиЭтапа.Добавить(ИсполнительЭтапа);
					
				КонецЦикла;
				
			ИначеЕсли Выборка.Исполнитель = "(функция)" Тогда
				
				// для определения используется подключаемая функция
				ИмяФункции = Выборка.ИмяРеквизитаОсновногоОбъектаАдресации;
				
				Если Ссылка.Пустая() Тогда
					Исполнители = ПроцессыОбработкиДокументовПереопределяемый.Исполнители(ИмяФункции, Документ);
				Иначе
					Исполнители = ПроцессыОбработкиДокументовПереопределяемый.Исполнители(ИмяФункции, Ссылка);
				КонецЕсли;
				
				Если Исполнители = "НеДобавлятьИсполнителей" Тогда
					Продолжить;
				КонецЕсли;
				
				Если Исполнители.Количество() = 0 Тогда
					ВызватьИсключение НСтр("ru = 'Не найдено ни одного исполнителя для выполнения этапа. Функция: '") + ИмяФункции;
				КонецЕсли;
				
				Для Каждого Исполнитель Из Исполнители Цикл
					
					ИсполнительЭтапа = Новый Структура;
					ИсполнительЭтапа.Вставить("Исполнитель", Исполнитель.Исполнитель);
					ИсполнительЭтапа.Вставить("ОсновнойОбъектАдресации", Исполнитель.ОсновнойОбъектАдресации);
					ИсполнительЭтапа.Вставить("ДополнительныйОбъектАдресации", Исполнитель.ДополнительныйОбъектАдресации);
					ИсполнительЭтапа.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", "");
					ИсполнительЭтапа.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", "");
					ИсполнительЭтапа.Вставить("НеСоздаватьЗадачу", Исполнитель.НеСоздаватьЗадачу);
					
					ИсполнителиЭтапа.Добавить(ИсполнительЭтапа);
					
				КонецЦикла;
				
			Иначе
				
				ИсполнительЭтапа = Новый Структура;
				ИсполнительЭтапа.Вставить("Исполнитель");
				ИсполнительЭтапа.Вставить("ОсновнойОбъектАдресации");
				ИсполнительЭтапа.Вставить("ДополнительныйОбъектАдресации");
				ИсполнительЭтапа.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации");
				ИсполнительЭтапа.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации");
				
				ЗаполнитьЗначенияСвойств(ИсполнительЭтапа, Выборка);
				
				ИсполнителиЭтапа.Добавить(ИсполнительЭтапа);
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли Параметры.Исполнитель = "(функция)" Тогда
		
		// для определения используется подключаемая функция
		ИмяФункции = Параметры.ИмяРеквизитаОсновногоОбъектаАдресации;
		
		Если Ссылка.Пустая() Тогда
			Исполнители = ПроцессыОбработкиДокументовПереопределяемый.Исполнители(ИмяФункции, Документ);
		Иначе
			Исполнители = ПроцессыОбработкиДокументовПереопределяемый.Исполнители(ИмяФункции, Ссылка);
		КонецЕсли;
		
		Если Исполнители = "НеДобавлятьИсполнителей" Тогда
			// Обработка не требуется
		ИначеЕсли ТипЗнч(Исполнители) = Тип("Массив") Тогда	
			Если Исполнители.Количество() > 0 Тогда
			
				ИсполнительЭтапа = Новый Структура;
				ИсполнительЭтапа.Вставить("Исполнитель", Исполнители[0].Исполнитель);
				ИсполнительЭтапа.Вставить("ОсновнойОбъектАдресации", Исполнители[0].ОсновнойОбъектАдресации);
				ИсполнительЭтапа.Вставить("ДополнительныйОбъектАдресации", Исполнители[0].ДополнительныйОбъектАдресации);
				ИсполнительЭтапа.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", "");
				ИсполнительЭтапа.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", "");
				
				ИсполнителиЭтапа.Добавить(ИсполнительЭтапа);
			КонецЕсли;
		Иначе
			Если НЕ ЗначениеЗаполнено(ИмяФункции) Тогда
				ИмяФункции = НСтр("ru = '<Функция не определена! Следует проверить настройку исполнителя для этапа в шаблоне.>'");
			КонецЕсли;	
			
			ВызватьИсключение НСтр("ru = 'Не найдено ни одного исполнителя для выполнения этапа. Функция: '") + ИмяФункции;
			
		КонецЕсли;
		
	Иначе
		
		ИсполнительЭтапа = Новый Структура;
		ИсполнительЭтапа.Вставить("Исполнитель");
		ИсполнительЭтапа.Вставить("ОсновнойОбъектАдресации");
		ИсполнительЭтапа.Вставить("ДополнительныйОбъектАдресации");
		ИсполнительЭтапа.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации");
		ИсполнительЭтапа.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации");
		
		ЗаполнитьЗначенияСвойств(ИсполнительЭтапа, Параметры);
		
		ИсполнителиЭтапа.Добавить(ИсполнительЭтапа);
		
	КонецЕсли;
	
	ИсполнителиЭтапаРезультат = Новый Массив;
	
	Для Каждого ИсполнительЭтапа Из ИсполнителиЭтапа Цикл
		
		РеквизитыАдресации = Новый Структура;
		РеквизитыАдресации.Вставить("Исполнитель", Неопределено);
		РеквизитыАдресации.Вставить("РольИсполнителя", Неопределено);
		РеквизитыАдресации.Вставить("ОсновнойОбъектАдресации", Неопределено);
		РеквизитыАдресации.Вставить("ДополнительныйОбъектАдресации", Неопределено);
		
		ПараметрыЭтапа = Новый Структура;
		ПараметрыЭтапа.Вставить("Документ", Ссылка);
		ПараметрыЭтапа.Вставить("Шаблон", Шаблон);
		ПараметрыЭтапа.Вставить("ИдентификаторЭтапа", Параметры.ИдентификаторЭтапа);
		ПараметрыЭтапа.Вставить("Этап", Параметры.Этап);
		
		СтандартнаяОбработка = Истина;
		
		ПроцессыОбработкиДокументовПереопределяемый.ПриОпределенииРеквизитовАдресации(
			ПараметрыЭтапа, ИсполнительЭтапа, РеквизитыАдресации, СтандартнаяОбработка);
		
		Если Не СтандартнаяОбработка Тогда
			// Для адресации будет использоваться структура РеквизитыАдресации
		ИначеЕсли ТипЗнч(ИсполнительЭтапа.Исполнитель) = Тип("СправочникСсылка.Пользователи") Тогда
			РеквизитыАдресации.Исполнитель = ИсполнительЭтапа.Исполнитель;
		ИначеЕсли ТипЗнч(ИсполнительЭтапа.Исполнитель) = Тип("СправочникСсылка.РолиИсполнителей") Тогда
			РеквизитыАдресации.РольИсполнителя = ИсполнительЭтапа.Исполнитель;
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыАдресации.РольИсполнителя, "ИспользуетсяСОбъектамиАдресации") Тогда
				Если ЗначениеЗаполнено(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации) Тогда
					Если Лев(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации, 1) = "*" Тогда
						МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
						Если МодульУправлениеСвойствами.ИспользоватьДопРеквизиты(Ссылка) Тогда
							ДополнительныеРеквизиты = МодульУправлениеСвойствами.СвойстваОбъекта(Ссылка, Истина, Ложь);
							Для Каждого Реквизит Из ДополнительныеРеквизиты Цикл
								Если Реквизит.ИдентификаторДляФормул = Сред(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации, 2) Тогда
									РеквизитыАдресации.ОсновнойОбъектАдресации = МодульУправлениеСвойствами.ЗначениеСвойства(Ссылка, Реквизит.Ссылка);
									Прервать;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
					Иначе
						Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
							РеквизитыАдресации.ОсновнойОбъектАдресации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
								Документ, ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации);
						Иначе
							ПозицияТочки = СтрНайти(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации, ".");
							Если ПозицияТочки = 0 Тогда
								РеквизитыАдресации.ОсновнойОбъектАдресации = Документ[ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации];
							Иначе
								РеквизитДокумента = Документ[Лев(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации, ПозицияТочки - 1)];
								ИмяАтрибута = Сред(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации, ПозицияТочки + 1);
								Если ЗначениеЗаполнено(РеквизитДокумента) Тогда
									РеквизитыАдресации.ОсновнойОбъектАдресации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
										РеквизитДокумента, ИмяАтрибута);
								Иначе
									РеквизитыАдресации.ОсновнойОбъектАдресации = РеквизитДокумента[ИмяАтрибута];
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли ЗначениеЗаполнено(ИсполнительЭтапа.ОсновнойОбъектАдресации) Тогда
					РеквизитыАдресации.ОсновнойОбъектАдресации = ИсполнительЭтапа.ОсновнойОбъектАдресации;
				КонецЕсли;
				Если ЗначениеЗаполнено(ИсполнительЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации) Тогда
					Если Лев(ИсполнительЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации, 1) = "*" Тогда
						МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
						Если МодульУправлениеСвойствами.ИспользоватьДопРеквизиты(Ссылка) Тогда
							ДополнительныеРеквизиты = МодульУправлениеСвойствами.СвойстваОбъекта(Ссылка, Истина, Ложь);
							Для Каждого Реквизит Из ДополнительныеРеквизиты Цикл
								Если Реквизит.ИдентификаторДляФормул = Сред(ИсполнительЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации, 2) Тогда
									РеквизитыАдресации.ДополнительныйОбъектАдресации = МодульУправлениеСвойствами.ЗначениеСвойства(Ссылка, Реквизит.Ссылка);
									Прервать;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
					Иначе
						Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
							РеквизитыАдресации.ДополнительныйОбъектАдресации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
								Документ, ИсполнительЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации);
						Иначе
							ПозицияТочки = СтрНайти(ИсполнительЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации, ".");
							Если ПозицияТочки = 0 Тогда
								РеквизитыАдресации.ДополнительныйОбъектАдресации = Документ[ИсполнительЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации];
							Иначе
								РеквизитДокумента = Документ[Лев(ИсполнительЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации, ПозицияТочки - 1)];
								ИмяАтрибута = Сред(ИсполнительЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации, ПозицияТочки + 1);
								Если ЗначениеЗаполнено(РеквизитДокумента) Тогда
									РеквизитыАдресации.ДополнительныйОбъектАдресации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
										РеквизитДокумента, ИмяАтрибута);
								Иначе
									РеквизитыАдресации.ДополнительныйОбъектАдресации = РеквизитДокумента[ИмяАтрибута];
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли ЗначениеЗаполнено(ИсполнительЭтапа.ДополнительныйОбъектАдресации) Тогда
					РеквизитыАдресации.ДополнительныйОбъектАдресации = ИсполнительЭтапа.ДополнительныйОбъектАдресации;
				КонецЕсли;
			КонецЕсли;
			Если Параметры.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске Тогда
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
				|	ЗадачаПоОбработкеДокумента.Исполнитель КАК Исполнитель
				|ИЗ
				|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
				|ГДЕ
				|	ЗадачаПоОбработкеДокумента.Предмет = &Предмет
				|	И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = &ИдентификаторЭтапа
				|	И ЗадачаПоОбработкеДокумента.Выполнена
				|
				|УПОРЯДОЧИТЬ ПО
				|	ЗадачаПоОбработкеДокумента.ДатаИсполнения УБЫВ";
				Запрос.УстановитьПараметр("Предмет", Ссылка);
				Запрос.УстановитьПараметр("ИдентификаторЭтапа", Параметры.ИдентификаторЭтапа);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий()
					И ПользовательЯвляетсяОднимИзИсполнителейРоли(Выборка.Исполнитель, РеквизитыАдресации.РольИсполнителя,
						РеквизитыАдресации.ОсновнойОбъектАдресации, РеквизитыАдресации.ДополнительныйОбъектАдресации) Тогда
					РеквизитыАдресации.Исполнитель = Выборка.Исполнитель;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ИсполнительЭтапа.Исполнитель = "Автор документа" Тогда
			Если Ссылка.Пустая() Тогда
				// если документ новый, то автором может стать любой, у кого есть право записи документа
				РеквизитыАдресации.Исполнитель = Пользователи.ТекущийПользователь();
			Иначе
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	ИсторияИзмененияСтатусовДокументов.Установил КАК Установил
				|ИЗ
				|	РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов
				|ГДЕ
				|	ИсторияИзмененияСтатусовДокументов.Предмет = &Ссылка
				|	И ТИПЗНАЧЕНИЯ(ИсторияИзмененияСтатусовДокументов.Установил) = ТИП(Справочник.Пользователи)
				|
				|УПОРЯДОЧИТЬ ПО
				|	ИсторияИзмененияСтатусовДокументов.ДатаУстановки";
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					РеквизитыАдресации.Исполнитель = Выборка.Установил;
				Иначе
					ВызватьИсключение НСтр("ru = 'Следующий этап не может быть запущен: не удалось определить автора документа.'");
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ИсполнительЭтапа.Исполнитель = "Пользователь" Тогда
			Если ЗначениеЗаполнено(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации) Тогда
				Если Лев(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации, 1) = "*" Тогда
					Исполнитель = Неопределено;
					МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
					Если МодульУправлениеСвойствами.ИспользоватьДопРеквизиты(Ссылка) Тогда
						ДополнительныеРеквизиты = МодульУправлениеСвойствами.СвойстваОбъекта(Ссылка, Истина, Ложь);
						Для Каждого Реквизит Из ДополнительныеРеквизиты Цикл
							Если Реквизит.ИдентификаторДляФормул = Сред(ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации, 2) Тогда
								Исполнитель = МодульУправлениеСвойствами.ЗначениеСвойства(Ссылка, Реквизит.Ссылка);
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				Иначе
					Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
						Исполнитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
							Документ, ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации);
					Иначе
						Исполнитель = Документ[ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации];
					КонецЕсли;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Исполнитель) Тогда
					ВызватьИсключение НСтр("ru = 'Следующий этап не может быть запущен: не удалось определить исполнителя по реквизиту ""'")
						+ ИсполнительЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации + """";
				КонецЕсли;
				РеквизитыАдресации.Исполнитель = Исполнитель;
			Иначе
				ВызватьИсключение НСтр("ru = 'Следующий этап не может быть запущен: не указан реквизит для определения исполнителя.'");
			КонецЕсли;
		КонецЕсли;
		
		Если ИсполнительЭтапа.Свойство("НеСоздаватьЗадачу") Тогда
			РеквизитыАдресации.Вставить("НеСоздаватьЗадачу", ИсполнительЭтапа.НеСоздаватьЗадачу);
		Иначе
			РеквизитыАдресации.Вставить("НеСоздаватьЗадачу", Ложь);
		КонецЕсли;
		
		ИсполнителиЭтапаРезультат.Добавить(РеквизитыАдресации);
		
	КонецЦикла;
	
	Возврат ИсполнителиЭтапаРезультат;
	
КонецФункции

Функция ЭлектронныеПодписиПредыдущихЭтапов(Документ, Шаблон, ИдентификаторЭтапа) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
	|	ЗадачаПоОбработкеДокумента.Этап КАК Этап,
	|	РегистрСведенийПодписанныеДанные.СоставПодписи КАК СоставПодписи, 
	|	РегистрСведенийПодписанныеДанные.ПодписанныеДанныеФайл КАК ПодписанныеДанныеФайл,
	|	РегистрСведенийПодписанныеДанные.ПодписанныеДанные КАК ПодписанныеДанные
	|ПОМЕСТИТЬ ЗадачиСПодписью
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО ЗадачаПоОбработкеДокумента.Шаблон = ШаблоныПроцессовЭтапы.Ссылка
	|			И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы1
	|		ПО (ШаблоныПроцессовЭтапы.Ссылка = ШаблоныПроцессовЭтапы1.Ссылка)
	|			И (ШаблоныПроцессовЭтапы1.ИдентификаторЭтапа = &ИдентификаторЭтапа)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодписанныеДанные КАК РегистрСведенийПодписанныеДанные
	|		ПО ЗадачаПоОбработкеДокумента.Ссылка = РегистрСведенийПодписанныеДанные.Задача
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.ПодписанЭП
	|	И ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|	И ЗадачаПоОбработкеДокумента.Шаблон = &Шаблон
	|	И ШаблоныПроцессовЭтапы.Порядок < ШаблоныПроцессовЭтапы1.Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭлектронныеПодписи.Подпись КАК Подпись,
	|	ЭлектронныеПодписи.ПорядковыйНомер КАК ПорядковыйНомер,
	|	ЭлектронныеПодписи.УстановившийПодпись КАК УстановившийПодпись,
	|	ЭлектронныеПодписи.ДатаПодписи КАК ДатаПодписи,
	|	ЭлектронныеПодписи.ДатаПроверкиПодписи КАК ДатаПроверкиПодписи,
	|	ЭлектронныеПодписи.ПодписьВерна КАК ПодписьВерна,
	|	ЭлектронныеПодписи.Отпечаток КАК Отпечаток,
	|	ЭлектронныеПодписи.КомуВыданСертификат КАК КомуВыданСертификат,
	|	ЗадачиСПодписью.СоставПодписи КАК СоставПодписи,
	|	ЗадачиСПодписью.ПодписанныеДанные КАК ПодписанныеДанные,
	|	ЗадачиСПодписью.ПодписанныеДанныеФайл КАК ПодписанныеДанныеФайл,
	|	ЗадачиСПодписью.Ссылка КАК Задача,
	|	ЗадачиСПодписью.Этап КАК Этап
	|ИЗ
	|	РегистрСведений.ЭлектронныеПодписи КАК ЭлектронныеПодписи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗадачиСПодписью КАК ЗадачиСПодписью
	|		ПО ЭлектронныеПодписи.ПодписанныйОбъект = ЗадачиСПодписью.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядковыйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПростыеЭлектронныеПодписиПОД.ДатаПодписи КАК ДатаПодписи,
	|	ПростыеЭлектронныеПодписиПОД.ВладелецПодписи КАК КомуВыданСертификат,
	|	ПростыеЭлектронныеПодписиПОД.УстановившийПодпись КАК УстановившийПодпись,
	|	ЗадачиСПодписью.СоставПодписи КАК СоставПодписи,
	|	ЗадачиСПодписью.ПодписанныеДанные КАК ПодписанныеДанные,
	|	ЗадачиСПодписью.ПодписанныеДанныеФайл КАК ПодписанныеДанныеФайл,
	|	ЗадачиСПодписью.Ссылка КАК Задача,
	|	ЗадачиСПодписью.Этап КАК Этап
	|ИЗ
	|	РегистрСведений.ПростыеЭлектронныеПодписиПОД КАК ПростыеЭлектронныеПодписиПОД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗадачиСПодписью КАК ЗадачиСПодписью
	|		ПО ПростыеЭлектронныеПодписиПОД.ПодписанныйОбъект = ЗадачиСПодписью.Ссылка";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ЭлектронныеПодписи = Новый Массив;
	РасширениеДляФайловПодписи = ЭлектроннаяПодпись.ПерсональныеНастройки().РасширениеДляФайловПодписи;
	
	// Усиленные электронные подписи
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ОтпечатокСтруктура = Новый Структура(
		"ПорядковыйНомер, ДатаПодписи, УстановившийПодпись,
		|ДатаПроверкиПодписи, ИмяФайлаПодписи, КомуВыданСертификат, Отпечаток,
		|Подпись, ПодписьВерна, Сертификат, СоставПодписи, ПодписанныеДанные,
		|Этап, ОписаниеОшибки, Документ, Задача, ПодписанныеДанныеФайл");
		ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, Выборка);
		ОтпечатокСтруктура.Подпись = ОтпечатокСтруктура.Подпись.Получить();
		ОтпечатокСтруктура.СоставПодписи = ОтпечатокСтруктура.СоставПодписи.Получить();
		ОтпечатокСтруктура.ПодписанныеДанные = ОтпечатокСтруктура.ПодписанныеДанные.Получить();
		ОтпечатокСтруктура.Сертификат = ЭлектроннаяПодпись.СертификатИзДвоичныхДанныхПодписи(ОтпечатокСтруктура.Подпись);
		ОтпечатокСтруктура.ИмяФайлаПодписи = ЭлектроннаяПодписьКлиентСервер.ИмяФайлаПодписи(Строка(Документ),
			ОтпечатокСтруктура.КомуВыданСертификат, РасширениеДляФайловПодписи);
		ОтпечатокСтруктура.Задача = Выборка.Задача;
		
		ЭлектронныеПодписи.Добавить(ОтпечатокСтруктура);
	КонецЦикла;
	
	ПроцессыОбработкиДокументовПереопределяемый.ПолучитьЭлектронныеПодписиДляПроверки(
		Документ, Шаблон, ИдентификаторЭтапа, ЭлектронныеПодписи);
	
	ПодписиДляПроверкиДанных = ОбщегоНазначения.СкопироватьРекурсивно(ЭлектронныеПодписи);
	
	// Простые электронные подписи
	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ОтпечатокСтруктура = Новый Структура(
		"ДатаПодписи, КомуВыданСертификат, УстановившийПодпись, СоставПодписи, ПодписанныеДанные, 
		|Этап, ОписаниеОшибки, ПодписанныеДанныеФайл");
		ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, Выборка);
		ОтпечатокСтруктура.СоставПодписи = ОтпечатокСтруктура.СоставПодписи.Получить();
		ОтпечатокСтруктура.ПодписанныеДанные = ОтпечатокСтруктура.ПодписанныеДанные.Получить();
		ОтпечатокСтруктура.Вставить("Задача", Выборка.Задача);
		ПодписиДляПроверкиДанных.Добавить(ОтпечатокСтруктура);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ЭлектронныеПодписи", ЭлектронныеПодписи);
	Результат.Вставить("ПодписиДляПроверкиДанных", ПодписиДляПроверкиДанных);
	
	Возврат Результат;
	
КонецФункции

Функция ПодписанныеРанееДанныеАктуальны(Документ, Шаблон, ИдентификаторЭтапа, ОписаниеОшибки)
	
	ПодписиДляПроверкиДанных = ЭлектронныеПодписиПредыдущихЭтапов(
		Документ, Шаблон, ИдентификаторЭтапа).ПодписиДляПроверкиДанных;
	
	ПроверитьСоответствиеПодписанныхИТекущихДанных(Документ, ПодписиДляПроверкиДанных, Неопределено);
	
	Ошибки = Новый Массив;
	
	Для Каждого ПровереннаяПодпись Из ПодписиДляПроверкиДанных Цикл
		
		Если ПустаяСтрока(ПровереннаяПодпись.ОписаниеОшибки) Тогда
			Продолжить;
		КонецЕсли;
		
		Ошибки.Добавить(ПровереннаяПодпись.ОписаниеОшибки);
		
	КонецЦикла;
	
	ОписаниеОшибки = СтрСоединить(Ошибки, Символы.ПС);
	
	Возврат Ошибки.Количество() = 0;
	
КонецФункции

Функция АктивныйРегламентныйИнтервалДокумента(Документ) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("РегламентныйИнтервал");
	Результат.Вставить("НомерИтерации");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегламентныеИнтервалыДокументов.РегламентныйИнтервал КАК РегламентныйИнтервал,
	|	РегламентныеИнтервалыДокументов.НомерИтерации КАК НомерИтерации
	|ИЗ
	|	РегистрСведений.РегламентныеИнтервалыДокументов КАК РегламентныеИнтервалыДокументов
	|ГДЕ
	|	РегламентныеИнтервалыДокументов.Предмет = &Предмет
	|	И РегламентныеИнтервалыДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияРегламентныхИнтервалов.Активен)";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции

Процедура ВвестиРегламентныйИнтервалВДействие(РегламентныйИнтервал, Шаблон, ИдентификаторНачальногоЭтапа) Экспорт
	
	НаборЗаписей = РегистрыСведений.ДействующиеРегламентныеИнтервалы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Шаблон.Установить(Шаблон);
	НаборЗаписей.Отбор.ИдентификаторНачальногоЭтапа.Установить(ИдентификаторНачальногоЭтапа);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Если НаборЗаписей[0].РегламентныйИнтервал <> РегламентныйИнтервал Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Интервал ""%1"" не может быть введен в действие: уже есть другой действующий интервал с таким же начальным этапом'"),
				РегламентныйИнтервал);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	Иначе
		Запись = НаборЗаписей.Добавить();
		Запись.Шаблон = Шаблон;
		Запись.ИдентификаторНачальногоЭтапа = ИдентификаторНачальногоЭтапа;
		Запись.РегламентныйИнтервал = РегламентныйИнтервал;
		
		НаборЗаписей.Записать(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтменитьВводВДействиеРегламентногоИнтервала(РегламентныйИнтервал, Шаблон, ИдентификаторНачальногоЭтапа) Экспорт
	
	НаборЗаписей = РегистрыСведений.ДействующиеРегламентныеИнтервалы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Шаблон.Установить(Шаблон);
	НаборЗаписей.Отбор.ИдентификаторНачальногоЭтапа.Установить(ИдентификаторНачальногоЭтапа);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 И НаборЗаписей[0].РегламентныйИнтервал = РегламентныйИнтервал Тогда
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ВключитьОтображениеКолонки(Колонка) Экспорт
	
	НаборЗаписей = РегистрыСведений.ОтображаемыеДополнительныеКолонкиЗадач.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Колонка.Установить(Колонка);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		
		Запись = НаборЗаписей.Добавить();
		Запись.Колонка = Колонка;
		
		НаборЗаписей.Записать(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтключитьОтображениеКолонки(Колонка) Экспорт
	
	НаборЗаписей = РегистрыСведений.ОтображаемыеДополнительныеКолонкиЗадач.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Колонка.Установить(Колонка);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтменитьВыполнениеЗадачи(Задача, Предмет, Шаблон, ИдентификаторЭтапа, СвойстваЭтапа,
	ДополнительныйКонтекст) Экспорт
	
	ЗаблокироватьРегистрТекущиеСтатусыДокументов(Предмет);
	
	ЗадачиДляПрерыванияРезультат = ЗадачиДляПрерыванияВыполнения(Задача);
	
	// Если задача является предшественником задачи с более ранним порядком, то необходимо проверить, не изменились ли данные
	Если СвойстваЭтапа.Порядок > ЗадачиДляПрерыванияРезультат.МинимальныйПорядокПоследователя Тогда
		ОписаниеОшибки = "";
		Если НЕ ПодписанныеРанееДанныеАктуальны(Предмет, Шаблон, ИдентификаторЭтапа, ОписаниеОшибки) Тогда
			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;
	КонецЕсли;
	
	ЗадачиДляПрерывания = ЗадачиДляПрерыванияРезультат.ЗадачиДляПрерыванияАктивные;
	
	ЗаблокироватьЗадачи(ЗадачиДляПрерывания);
	
	ЗадачиДляВосстановления = ЗадачиДляВосстановления(Задача);
	
	ЗаблокироватьЗадачи(ЗадачиДляВосстановления);
	
	ЗадачаОбъект = Задача.ПолучитьОбъект();
	
	ПредыдущийИсполнитель = ЗадачаОбъект.Исполнитель;
	ПредыдущаяДатаИсполнения = ЗадачаОбъект.ДатаИсполнения;
	
	ЗадачаОбъект.Заблокировать();
	ЗадачаОбъект.Выполнена = Ложь;
	ЗадачаОбъект.ДатаИсполнения = Дата(1, 1, 1);
	
	// Задача принимается к исполнению, если ее отменяет исполнитель, иначе возвращается на роль
	Если ЗадачаОбъект.Исполнитель = Пользователи.ТекущийПользователь() Тогда
		ЗадачаОбъект.ПринятаКИсполнению = Истина;
	Иначе
		ЗадачаОбъект.ПринятаКИсполнению = Ложь;
		ЗадачаОбъект.ДатаПринятияКИсполнению = "00010101000000";
		Если Не ЗадачаОбъект.РольИсполнителя.Пустая() Тогда
			ЗадачаОбъект.Исполнитель = Справочники.Пользователи.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	// При отмене выполнения необходимо удалить ранее установленную электронную подпись
	Если ЗадачаОбъект.ПодписанЭП Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Для Каждого Подпись Из УстановленныеПодписи(Задача) Цикл
			ПростаяПодпись = Неопределено;
			Если Подпись.Свойство("ПростаяПодпись", ПростаяПодпись) И ПростаяПодпись = Истина Тогда
				УдалитьПростуюПодпись(ЗадачаОбъект);
			Иначе
				УдалитьПодпись(ЗадачаОбъект, 1);
			КонецЕсли;
			УдалитьПодписанныеДанные(Задача);
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗадачаОбъект.Записать();
		
		// Удаление электронных подписей в подписанных файлах
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ПрисоединенныеФайлыПодписанныеЗадачами.Задача КАК Задача,
			|	ПрисоединенныеФайлыПодписанныеЗадачами.Файл КАК Файл,
			|	ПрисоединенныеФайлыПодписанныеЗадачами.ДатаПодписи КАК ДатаПодписи,
			|	ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
			|	ПрисоединенныеФайлыПодписанныеЗадачами.УстановившийПодпись КАК УстановившийПодпись,
			|	ВЫБОР
			|		КОГДА ПервичныеДокументыПОД.ПервичныйДокумент ЕСТЬ NULL
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК ЭтоПервичныйДокумент
			|ИЗ
			|	РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
			|		ПО ПрисоединенныеФайлыПодписанныеЗадачами.Файл = ПервичныеДокументыПОД.ПервичныйДокумент
			|ГДЕ
			|	ПрисоединенныеФайлыПодписанныеЗадачами.Задача = &Задача";
			Запрос.УстановитьПараметр("Задача", Задача);
			
			УстановитьПривилегированныйРежим(Истина);
			
			ФайлыПодписанныеЗадачей = Запрос.Выполнить().Выгрузить();
			
			ПервичныеДокументыНаУдаление = Новый Массив;
			
			// Удаление связи отменяемой задачи и подписанных файлов
			Для Каждого ФайлПодписанныйЗадачей Из ФайлыПодписанныеЗадачей Цикл
				Запись = РегистрыСведений.ПрисоединенныеФайлыПодписанныеЗадачами.СоздатьМенеджерЗаписи();
				Запись.Задача = ФайлПодписанныйЗадачей.Задача;
				Запись.Файл = ФайлПодписанныйЗадачей.Файл;
				Запись.Удалить();
				
				Если ФайлПодписанныйЗадачей.ЭтоПервичныйДокумент Тогда
					ПервичныеДокументыНаУдаление.Добавить(ФайлПодписанныйЗадачей.Файл);
				КонецЕсли;
				
			КонецЦикла;
			
			УстановитьПривилегированныйРежим(Ложь);
			
			// Удаление подписи, установленной отменяемой задачей
			Для Каждого ФайлПодписанныйЗадачей Из ФайлыПодписанныеЗадачей Цикл
				
				УстановленныеПодписи = УстановленныеПодписи(ФайлПодписанныйЗадачей.Файл);
				СписокНомеровДляУдаления = Новый СписокЗначений;
				
				Для Каждого УстановленнаяПодпись Из УстановленныеПодписи Цикл
					Если УстановленнаяПодпись.УстановившийПодпись = ФайлПодписанныйЗадачей.УстановившийПодпись
						И УстановленнаяПодпись.ДатаПодписи = ФайлПодписанныйЗадачей.ДатаПодписи Тогда
						СписокНомеровДляУдаления.Добавить(УстановленнаяПодпись.ПорядковыйНомер);
					КонецЕсли;
				КонецЦикла;
				
				СписокНомеровДляУдаления.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
				Для Каждого НомеровДляУдаления Из СписокНомеровДляУдаления Цикл
					УдалитьПодпись(ФайлПодписанныйЗадачей.Файл, НомеровДляУдаления.Значение);
				КонецЦикла;
				
			КонецЦикла;
			
			// Удаление первичных документов
			ДокументыКоторыеНельзяУдалять = ПроцессыОбработкиДокументовКлиентСервер.МассивВСоответствие(
				ФайлыПодписанныеЗадачами(ПервичныеДокументыНаУдаление));
			
			УстановитьПривилегированныйРежим(Истина);
			
			Для Каждого ПервичныйДокумент Из ПервичныеДокументыНаУдаление Цикл
				Если ДокументыКоторыеНельзяУдалять[ПервичныйДокумент] = Неопределено Тогда
					
					Запись = РегистрыСведений.ПервичныеДокументыПОД.СоздатьМенеджерЗаписи();
					Запись.Предмет = Предмет;
					Запись.ПервичныйДокумент = ПервичныйДокумент;
					Запись.Удалить();
					
					ПервичныйДокументОбъект = ПервичныйДокумент.ПолучитьОбъект();
					ПервичныйДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ПервичныйДокумент");
					ПервичныйДокументОбъект.УстановитьПометкуУдаления(Истина);
					
				КонецЕсли;
			КонецЦикла;
			
			УстановитьПривилегированныйРежим(Ложь);
			
			//Удаление подписей формуляров
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ПодписанныеФормулярыЭДПОД.Организация КАК Организация,
			|	ПодписанныеФормулярыЭДПОД.Предмет КАК Предмет,
			|	ПодписанныеФормулярыЭДПОД.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы,
			|	ПодписанныеФормулярыЭДПОД.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
			|	ПодписанныеФормулярыЭДПОД.КодВидаСведений КАК КодВидаСведений,
			|	ПодписанныеФормулярыЭДПОД.ВыполняемаяЗадача КАК ВыполняемаяЗадача,
			|	ПодписанныеФормулярыЭДПОД.Подписан КАК Подписан,
			|	ПодписанныеФормулярыЭДПОД.ТипЭлектроннойПодписи КАК ТипЭлектроннойПодписи,
			|	ПодписанныеФормулярыЭДПОД.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
			|	ВЫРАЗИТЬ(ПодписанныеФормулярыЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ОсновнойФайл КАК Файл,
			|	ПодписанныеФормулярыЭДПОД.Формат КАК Формат,
			|	ПодписанныеФормулярыЭДПОД.ДатаПодписи КАК ДатаПодписи,
			|	ПодписанныеФормулярыЭДПОД.НаименованиеДокумента КАК НаименованиеДокумента,
			|	ПодписанныеФормулярыЭДПОД.НомерДокумента КАК НомерДокумента,
			|	ПодписанныеФормулярыЭДПОД.ДатаДокумента КАК ДатаДокумента,
			|	ПодписанныеФормулярыЭДПОД.УстановившийПодпись КАК УстановившийПодпись
			|ИЗ
			|	РегистрСведений.ПодписанныеФормулярыЭДПОД КАК ПодписанныеФормулярыЭДПОД
			|ГДЕ
			|	ПодписанныеФормулярыЭДПОД.ВыполняемаяЗадача = &Задача";
			Запрос.УстановитьПараметр("Задача", Задача);
			
			УстановитьПривилегированныйРежим(Истина);
			
			ФормулярыПодписанныеЗадачей = Запрос.Выполнить().Выгрузить();
			
			Для Каждого ТекФормуляр Из ФормулярыПодписанныеЗадачей Цикл
				УстановленныеПодписи = УстановленныеПодписиДляФормуляраПОД(ТекФормуляр.Файл);
				
				СписокНомеровДляУдаления = Новый СписокЗначений;
				
				Для Каждого УстановленнаяПодпись Из УстановленныеПодписи Цикл
					Если УстановленнаяПодпись.УстановившийПодпись = ТекФормуляр.УстановившийПодпись
						И УстановленнаяПодпись.ДатаПодписи = ТекФормуляр.ДатаПодписи Тогда
						СписокНомеровДляУдаления.Добавить(УстановленнаяПодпись.ПорядковыйНомер);
					КонецЕсли;
				КонецЦикла;
				
				СписокНомеровДляУдаления.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
				Для Каждого НомеровДляУдаления Из СписокНомеровДляУдаления Цикл
					Если ТекФормуляр.ТипЭлектроннойПодписи = 1 Тогда
						УдалитьПростуюПодписьДляФормуляра(ТекФормуляр.ВыполняемаяЗадача, ТекФормуляр.Файл);
					Иначе	
						УдалитьПодпись(ТекФормуляр.Файл, НомеровДляУдаления.Значение);
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
			
			
		КонецЕсли;
		
	Иначе
		
		ЗадачаОбъект.Записать();
		
	КонецЕсли;
	
	УдалитьСохраненныеФормулярыЭДПоЭтапу(Задача);
	СнятьОтметкиОПодписанииФормуляровЭтапа(Задача);
	
	УстановленСтатус = УстановленныйСтатус(Предмет, Задача);
	
	// Выполняется дополнительный обработчик
	ВыполнитьДополнительныйОбработчик(Предмет,
		Задача,
		Шаблон,
		ИдентификаторЭтапа,
		УстановленСтатус,
		ДополнительныйКонтекст,
		,
		,
		Истина);
	
	Если ЗначениеЗаполнено(УстановленСтатус) Тогда
		
		// Удаляется запись об установленном статусе документа для задачи, выполнение которой отменяется
		НаборЗаписей = РегистрыСведений.ИсторияИзмененияСтатусовДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предмет.Установить(Предмет);
		НаборЗаписей.Отбор.Установил.Установить(Задача);
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать();
		УстановитьПривилегированныйРежим(Ложь);
		
		// Изменяется текущий статус документа
		НаборЗаписей = РегистрыСведений.ТекущиеСтатусыДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предмет.Установить(Предмет);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			// Необходимо установить статус по предыдущей выполненной задаче
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ИсторияИзмененияСтатусовДокументов.Установил КАК Установил,
			|	ИсторияИзмененияСтатусовДокументов.Статус КАК Статус,
			|	ИсторияИзмененияСтатусовДокументов.ДатаУстановки КАК ДатаУстановки
			|ИЗ
			|	РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов
			|ГДЕ
			|	ИсторияИзмененияСтатусовДокументов.Предмет = &Предмет
			|	И ИсторияИзмененияСтатусовДокументов.ДатаУстановки <= &ДатаУстановки
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаУстановки УБЫВ";
			
			Запрос.УстановитьПараметр("Предмет", Предмет);
			Запрос.УстановитьПараметр("ДатаУстановки", ЗадачаОбъект.Дата);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НаборЗаписей[0].Статус = Выборка.Статус;
				НаборЗаписей[0].Установил = Выборка.Установил;
				НаборЗаписей[0].ДатаУстановки = Выборка.ДатаУстановки;
				УстановитьПривилегированныйРежим(Истина);
				НаборЗаписей.Записать();
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Если задача повлияла на выполнение других задач, то следует отменить их выполнение
	ОтменитьВыполнениеЗависимыхЗадач(Задача);
	
	// Для заново инициированного этапа надо удалить признак перехода по нему
	УстановкаПризнаковПереходаПоЗапускаемомуЭтапу(Предмет, Шаблон, ИдентификаторЭтапа);
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриВыполненииЗадачи(Задача);
	
	ЗадачиОбъектыДляПрерывания = Новый Массив;
	
	ПрерватьВыполнениеЗадач(ЗадачиДляПрерывания, ЗадачиОбъектыДляПрерывания);
	
	ЗадачиОбъектыДляВосстановления = Новый Массив;
	
	ВосстановитьЗадачи(ЗадачиДляВосстановления, ЗадачиОбъектыДляВосстановления);
	
	// Очистка регистра прерванных задач после их восстановления
	УдалитьСвязьСИнициаторомПрерывания(Задача);
	
	УправлениеРегламентнымиИнтерваламиПриОтменеВыполненияЗадачи(ЗадачаОбъект, ЗадачиОбъектыДляПрерывания, ЗадачиОбъектыДляВосстановления);
	
	УправлениеИсполнителямиГрупповогоЭтапаПриОтменеВыполненияЗадачи(ЗадачаОбъект, ЗадачиДляПрерыванияРезультат.ЗадачиДляПрерыванияВсе);
	
	СохранитьСобытиеИсторииЗадач(ЗадачиДляПрерывания, ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.Прерывание"));
	
	СохранитьСобытиеИсторииЗадач(ЗадачиДляВосстановления, ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.ВосстановлениеПрерванной"));
	
	СохранитьСобытиеИсторииЗадач(Задача, ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.ОтменаВыполнения"));
	
КонецПроцедуры

Функция ЭтапЗадачиПрерван(Задача) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачиПрерванныхЭтапов.ИнициаторПрерывания КАК ИнициаторПрерывания
	|ИЗ
	|	РегистрСведений.ЗадачиПрерванныхЭтапов КАК ЗадачиПрерванныхЭтапов
	|ГДЕ
	|	ЗадачиПрерванныхЭтапов.ЗадачаПреванногоЭтапа = &ЗадачаПреванногоЭтапа";
	
	Запрос.УстановитьПараметр("ЗадачаПреванногоЭтапа", Задача);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция СвойстваЭтапаШаблонаПроцесса(Шаблон, ИдентификаторЭтапа) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|ГДЕ
	|	ШаблоныПроцессовЭтапы.Ссылка = &Шаблон
	|	И ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка;
	
КонецФункции

Функция ЕстьРанееПрерванныеЗадачи(ОтменяемыеЗадачи) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПрерванныеЗадачи.ИнициаторПрерывания КАК ИнициаторПрерывания
	|ИЗ
	|	РегистрСведений.ПрерванныеЗадачи КАК ПрерванныеЗадачи
	|ГДЕ
	|	ПрерванныеЗадачи.ИнициаторПрерывания В(&ИнициаторПрерывания)";
	
	Запрос.УстановитьПараметр("ИнициаторПрерывания", ОтменяемыеЗадачи);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ДобавитьДополнительныеКолонкиСпискаЗадач(Форма, ИмяТаблицы) Экспорт
	
	ТаблицаФормы = Форма.Элементы.Найти(ИмяТаблицы);
	
	Если ТаблицаФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСписка = ТаблицаФормы.ПутьКДанным;
	ДинамическийСписок = Форма[ИмяСписка];
	
	ТекстЗапроса = "";
	Если ДинамическийСписок.ПроизвольныйЗапрос Тогда
		ТекстЗапроса = ДинамическийСписок.ТекстЗапроса;
	Иначе
		ИсполняемаяСхема = ТаблицаФормы.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
		НаборДанныхДинамическогоСписка = ИсполняемаяСхема.НаборыДанных.Найти("НаборДанныхДинамическогоСписка");
		Если НаборДанныхДинамическогоСписка <> Неопределено Тогда
			ДинамическийСписок.ПроизвольныйЗапрос = Истина;
			ТекстЗапроса = НаборДанныхДинамическогоСписка.Запрос;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.РежимКомпоновкиДанных = Истина;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	ПоследнийЗапрос = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	
	ОператорВыбрать = ПоследнийЗапрос.Операторы[0];
	
	ИсточникОсновнойТаблицы = ОператорВыбрать.Источники[0];
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтображаемыеДополнительныеКолонкиЗадач.Колонка КАК Колонка,
	|	ОтображаемыеДополнительныеКолонкиЗадач.Колонка.Наименование КАК ИмяКолонки,
	|	ДополнительныеКолонкиСписковЗадач.ТипыЗначений КАК ТипыЗначений
	|ИЗ
	|	РегистрСведений.ОтображаемыеДополнительныеКолонкиЗадач КАК ОтображаемыеДополнительныеКолонкиЗадач
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеКолонкиСписковЗадач КАК ДополнительныеКолонкиСписковЗадач
	|		ПО ОтображаемыеДополнительныеКолонкиЗадач.Колонка = ДополнительныеКолонкиСписковЗадач.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПерваяКолонка = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		ЗаголовокКолонки = Выборка.ИмяКолонки;
		
		ПсевдонимПоляЗапроса = Выборка.ИмяКолонки;
		УдалитьНедопустимыеСимволыПсевдонимаПоляЗапроса(ПсевдонимПоляЗапроса);
		ПсевдонимПоляЗапроса = "Доп_Колонка_" + СтрЗаменить(ПсевдонимПоляЗапроса, " ", "_");
		
		ИдентификаторКолонки = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "_");
		ПсевдонимКолонки = "Доп_Колонка_" + ИдентификаторКолонки;
		ПсевдонимТаблицы = "ЗначенияДополнительныхКолонокЗадач" + ИдентификаторКолонки;
		
		ИсточникЗначенияДопКолонок = ОператорВыбрать.Источники.Добавить(
			"РегистрСведений.ЗначенияДополнительныхКолонокЗадач", ПсевдонимТаблицы);
		
		Попытка
			Если НЕ ИсточникОсновнойТаблицы.Соединения.Добавить(
				ИсточникЗначенияДопКолонок,
				ИсточникОсновнойТаблицы.Источник.Псевдоним + ".Предмет = " + ПсевдонимТаблицы + ".Предмет
				| И " + ПсевдонимТаблицы + ".Колонка = &"+ПсевдонимКолонки) Тогда
				Возврат;
			КонецЕсли;
		Исключение
			Возврат;
		КонецПопытки;
		
		Соединение = ИсточникОсновнойТаблицы.Соединения.НайтиПоПсевдониму(ПсевдонимТаблицы);
		Соединение.ОбязательноеСоединение = Ложь;
		Соединение.НачалоГруппыНеобязательныхСоединений = ПерваяКолонка;
		
		Если ЗначениеЗаполнено(Выборка.ТипыЗначений) Тогда
			Типы = Новый Массив;
			Для Каждого ТипЗначения Из СтрРазделить(Выборка.ТипыЗначений, ",") Цикл
				ПозицияСсылка = СтрНайти(ТипЗначения, "Ссылка.");
				Тип = Новый Структура;
				Если ТипЗначения = "Строка" Тогда
					Тип.Вставить("Сравнение", ТипЗначения);
					Тип.Вставить("Выражение", ТипЗначения + "(1024)");
				ИначеЕсли ПозицияСсылка = 0 Тогда
					Тип.Вставить("Сравнение", ТипЗначения);
					Тип.Вставить("Выражение", ТипЗначения);
				Иначе
					Тип.Вставить("Сравнение", Лев(ТипЗначения, ПозицияСсылка - 1) + Сред(ТипЗначения, ПозицияСсылка + 6));
					Тип.Вставить("Выражение", Лев(ТипЗначения, ПозицияСсылка - 1) + Сред(ТипЗначения, ПозицияСсылка + 6));
				КонецЕсли;
				Типы.Добавить(Тип);
			КонецЦикла;
			Если Типы.Количество() = 1 Тогда
				ОператорВыбрать.ВыбираемыеПоля.Добавить("ВЫРАЗИТЬ("+ПсевдонимТаблицы + ".Значение КАК "+Типы[0].Выражение+")");
			Иначе
				Поле = "ВЫБОР";
				Для Каждого Тип Из Типы Цикл
					Поле = Поле + "
					|	КОГДА ТИП("+Тип.Сравнение+") = ТИПЗНАЧЕНИЯ("+ПсевдонимТаблицы + ".Значение)
					|		ТОГДА ВЫРАЗИТЬ("+ПсевдонимТаблицы + ".Значение КАК "+Тип.Выражение+")";
				КонецЦикла;
				Поле = Поле + "
					|КОНЕЦ";
				ОператорВыбрать.ВыбираемыеПоля.Добавить(Поле);
			КонецЕсли;
		Иначе
			ОператорВыбрать.ВыбираемыеПоля.Добавить(ПсевдонимТаблицы + ".Значение");
		КонецЕсли;
		
		КолонкаПоле = ПоследнийЗапрос.Колонки.Получить(ПоследнийЗапрос.Колонки.Количество() - 1);
		КолонкаПоле.Псевдоним = ПсевдонимПоляЗапроса;
		
		СтруктураСвойствДинамическогоСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
		СтруктураСвойствДинамическогоСписка.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
		ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(ТаблицаФормы, СтруктураСвойствДинамическогоСписка);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			ДинамическийСписок, ПсевдонимКолонки, Выборка.Колонка);
		
		// добавление колонки на форму
		КолонкаЭлемент = Форма.Элементы.Добавить(ПсевдонимКолонки, Тип("ПолеФормы"), ТаблицаФормы);
		КолонкаЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
		КолонкаЭлемент.ПутьКДанным = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2", ИмяСписка, ПсевдонимПоляЗапроса);
		КолонкаЭлемент.Заголовок = ЗаголовокКолонки;
		
		ПерваяКолонка = Ложь;
		
	КонецЦикла;
	
КонецПроцедуры

