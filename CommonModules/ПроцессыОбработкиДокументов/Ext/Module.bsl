Функция ЭлементСхемыПоИмени(МакетСхемы, ИмяЭлемента)
	
	ЭлементФункция = Неопределено;
	
	Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
	ОбъектXDTOСхема = Сериализатор.ЗаписатьXDTO(МакетСхемы);
	
	СписокЭлементов = ОбъектXDTOСхема.ПолучитьСписок("item");
	
	Для Каждого ЭлементСхемы Из СписокЭлементов Цикл
		Если ЭлементСхемы.ItemCode = ИмяЭлемента Тогда
			ЭлементФункция = ЭлементСхемы;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЭлементФункция;
	
КонецФункции

Процедура УстановитьСвойстваБлокаЭтапа(ЭлементСхемы, Данные, ВыборкаЭтапыРезультатыВыполнения, Контекст, Настройки)
	
	Контекст.МаксимальныйИдентификатор = Контекст.МаксимальныйИдентификатор + 1;
	Контекст.Порядок = Контекст.Порядок + 1;
	
	ЭлементСхемы.ItemID = Контекст.МаксимальныйИдентификатор;
	ЭлементСхемы.ItemTabOrder = Контекст.Порядок;
	
	ЭлементСхемы.groupNum = Данные.НомерСтроки;
	
	ЭлементСхемы.ItemCode = "Этап" + Данные.НомерСтроки;
	
	УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, Строка(Данные.НомерСтроки) + ". " + Строка(Данные.Этап));
	
	ЭлементСхемы.rectTop = Контекст.ТекущаяНижняяГраница + Настройки.ОтступМеждуПорядкамиПоВертикали;
	ЭлементСхемы.rectBottom = ЭлементСхемы.rectTop + Настройки.ВысотаЭтапа;
	
	Контекст.ТекущаяНижняяГраница = ЭлементСхемы.rectBottom;
	
	ЛеваяГраница = Контекст.КоординатыПорядков[Данные.Порядок].ЛеваяГраница;
	ЭлементСхемы.rectLeft = ЛеваяГраница;
	
	// Ширина блока этапа зависит от числа резолюций.
	// Если резолюций две и менее, ширина = Настройки.ШиринаЭтапа
	// Если резолюций более двух, то ширина = Настройки.ШиринаЭтапа/ 2 * число резолюций
	ВыборкаЭтапыРезультатыВыполнения.Сбросить();
	ВыборкаЭтапыРезультатыВыполнения.НайтиСледующий(Новый Структура("Этап", Данные.Этап));
	КоличествоРезолюций = ВыборкаЭтапыРезультатыВыполнения.ПредставлениеРезультата;
	Если КоличествоРезолюций < 3 Тогда
		ЭлементСхемы.rectRight = ЭлементСхемы.rectLeft + Настройки.ШиринаЭтапа;
	Иначе
		ЭлементСхемы.rectRight = ЭлементСхемы.rectLeft + Настройки.ШиринаЭтапа*КоличествоРезолюций/2;
	КонецЕсли;
	
	ШиринаЭтапа = ЭлементСхемы.rectRight - ЭлементСхемы.rectLeft;
	Если ШиринаЭтапа > СтрДлина(Данные.ИсполнительЭтапаСтрокой)*7 Тогда
		ЭлементСхемы.explanation = Данные.ИсполнительЭтапаСтрокой;
		ЭлементСхемы.tipText.item.Очистить();
	Иначе
		ЭлементСхемы.explanation = Лев(Данные.ИсполнительЭтапаСтрокой, Цел(ШиринаЭтапа/7))
			+ Символы.ПС + Сред(Данные.ИсполнительЭтапаСтрокой, Цел(ШиринаЭтапа/7)+1);
		ЭлементСхемы.tipText.item[0].content = Данные.ИсполнительЭтапаСтрокой;
	КонецЕсли;
	
	Контекст.КоординатыПорядков[Данные.Порядок].ЛеваяГраница = ЭлементСхемы.rectRight + Настройки.ОтступМеждуЭтапамиПоГоризонтали;
	
	Контекст.ТекущаяЛеваяГраницаРезолюции = ЭлементСхемы.rectLeft;
	Контекст.НомерРезолюции = 0;
	
	НоваяСтрока = Контекст.ТаблицаИдентификаторовЭлементов.Добавить();
	НоваяСтрока.ТипЭлемента = "Этап";
	НоваяСтрока.ИдентификаторЭтапа = Данные.ИдентификаторЭтапа;
	НоваяСтрока.Порядок = Данные.Порядок;
	НоваяСтрока.УсловиеРассмотрения = ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка");
	НоваяСтрока.ItemID = ЭлементСхемы.ItemID;
	
	УстановитьКоординатыТочкиДействия(ЭлементСхемы,
										ЭлементСхемы.rectLeft, ЭлементСхемы.rectTop,
										ЭлементСхемы.rectRight - 1 , ЭлементСхемы.rectTop,
										ЭлементСхемы.rectRight - 1, ЭлементСхемы.rectBottom - 1,
										ЭлементСхемы.rectLeft, ЭлементСхемы.rectBottom - 1);
	
	Контекст.СоответствиеЭлементов.Вставить(ЭлементСхемы.ItemID, ЭлементСхемы);
	
КонецПроцедуры

Процедура УстановитьСвойстваБлокаРезолюции(ЭлементСхемы, ДанныеВладельца, Данные, Контекст, Настройки)
	
	Контекст.МаксимальныйИдентификатор = Контекст.МаксимальныйИдентификатор + 1;
	Контекст.Порядок = Контекст.Порядок + 1;
	
	ЭлементСхемы.ItemID = Контекст.МаксимальныйИдентификатор;
	ЭлементСхемы.ItemTabOrder = Контекст.Порядок;
	
	ЭлементСхемы.groupNum = ДанныеВладельца.НомерСтроки;
	
	Контекст.КоличествоРезолюций = Контекст.КоличествоРезолюций + 1;
	ЭлементСхемы.ItemCode = "Резолюция" + Контекст.КоличествоРезолюций;
	
	Контекст.НомерРезолюции = Контекст.НомерРезолюции + 1;
	
	ЗаголовокРезолюции = Строка(Данные.ПредставлениеРезультата);
	Если ЗначениеЗаполнено(Данные.СтатусПослеВыполнения) Тогда
		ЗаголовокРезолюции = ЗаголовокРезолюции + Символы.ПС + "(" + Строка(Данные.СтатусПослеВыполнения) + ")";
	КонецЕсли;
	
	УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, ЗаголовокРезолюции);
	
	ЭлементСхемы.rectTop = Контекст.ТекущаяНижняяГраница;
	ЭлементСхемы.rectLeft = Контекст.ТекущаяЛеваяГраницаРезолюции;
	
	Если Данные.Количество() = 1 Тогда
		ЭлементСхемы.rectBottom = ЭлементСхемы.rectTop + Настройки.ВысотаОдиночнойРезолюции;
		ЭлементСхемы.rectRight = ЭлементСхемы.rectLeft + Настройки.ШиринаЭтапа;
	Иначе
		ЭлементСхемы.rectBottom = ЭлементСхемы.rectTop + Настройки.ВысотаРезолюции;
		ЭлементСхемы.rectRight = ЭлементСхемы.rectLeft + Настройки.ШиринаЭтапа/2;
	КонецЕсли;
	Контекст.ТекущаяЛеваяГраницаРезолюции = ЭлементСхемы.rectRight;
	
	// Смещение верхней границы для совпадения границ элементов
	ЭлементСхемы.rectTop = ЭлементСхемы.rectTop - 1;
	
	// Смещение левой границы для совпадения границ элементов
	Если Контекст.НомерРезолюции > 1 Тогда
		ЭлементСхемы.rectLeft = ЭлементСхемы.rectLeft - 1;
	КонецЕсли;
	
	Если Данные.ОтрицательныйРезультат Тогда
		ЭлементСхемы.backColor = webЦвета.Перламутровый;
	Иначе
		ЭлементСхемы.backColor = webЦвета.Роса;
	КонецЕсли;
	
	Если НЕ Данные.ТребуетсяЭП И НЕ Данные.ТребуетсяПростаяЭП Тогда
		ЭлементСхемы.picture.__content = "";
	КонецЕсли;
	
	НоваяСтрока = Контекст.ТаблицаИдентификаторовЭлементов.Добавить();
	НоваяСтрока.ИдентификаторЭтапа = ДанныеВладельца.ИдентификаторЭтапа;
	НоваяСтрока.ТипЭлемента = "Резолюция";
	НоваяСтрока.Порядок = ДанныеВладельца.Порядок;
	НоваяСтрока.НомерРезолюции = Контекст.НомерРезолюции;
	НоваяСтрока.УсловиеРассмотрения = Данные.СтатусПослеВыполнения;
	НоваяСтрока.ОтрицательныйРезультат = Данные.ОтрицательныйРезультат;
	НоваяСтрока.ItemID = ЭлементСхемы.ItemID;
	
	Контекст.СоответствиеЭлементов.Вставить(ЭлементСхемы.ItemID, ЭлементСхемы);
	
	Контекст.РезолюцииБезСвязи.Добавить(ЭлементСхемы);
	
КонецПроцедуры

Процедура УстановитьСвойстваБлокаВлияние(ЭлементСхемы, Данные, Контекст, Настройки)
	
	Контекст.МаксимальныйИдентификатор = Контекст.МаксимальныйИдентификатор + 1;
	Контекст.Порядок = Контекст.Порядок + 1;
	
	ЭлементСхемы.ItemID = Контекст.МаксимальныйИдентификатор;
	ЭлементСхемы.ItemTabOrder = Контекст.Порядок;
	
	Контекст.КоличествоВлияний = Контекст.КоличествоВлияний + 1;
	ЭлементСхемы.ItemCode = "Влияние" + Контекст.КоличествоВлияний;
	
	УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, Строка(Данные.ВлияющийПроцесс));
	
	ЭлементСхемы.rectTop = Контекст.КоординатыПорядков[Данные.Порядок].ВерхняяГраницаВлияющие;
	ЭлементСхемы.rectLeft = Контекст.Середина
							- Контекст.КоординатыПорядков[Данные.Порядок].Ширина/2
							- Настройки.ОтступДоВлияющегоЭтапа
							- Настройки.ШиринаВлияющегоЭтапа;
							
	ВысотаВлияющегоЭтапа = ?(СтрДлина(Данные.ВлияющийПроцесс)<=35, Настройки.ВысотаВлияющегоЭтапа, Настройки.ВысотаВлияющегоЭтапа + Настройки.ШагСетки);
	
	ЭлементСхемы.rectBottom = ЭлементСхемы.rectTop + ВысотаВлияющегоЭтапа;
	ЭлементСхемы.rectRight = ЭлементСхемы.rectLeft + Настройки.ШиринаВлияющегоЭтапа;
	
	Контекст.КоординатыПорядков[Данные.Порядок].ВерхняяГраницаВлияющие = ЭлементСхемы.rectBottom + Настройки.ОтступМеждуВлияющимиЭтапамиПоВертикали;
	
	// Смещение верхней границы для совпадения границ элементов
	Если ЭлементСхемы.rectTop <> Контекст.КоординатыПорядков[Данные.Порядок].ВерхняяГраница Тогда
		ЭлементСхемы.rectTop = ЭлементСхемы.rectTop - 1;
	КонецЕсли;
	
	НоваяСтрока = Контекст.ТаблицаИдентификаторовЭлементов.Добавить();
	НоваяСтрока.ИдентификаторЭтапа = Данные.ИдентификаторЭтапаЗависимогоШаблона;
	НоваяСтрока.ТипЭлемента = "ВлияющийПроцесс";
	НоваяСтрока.Порядок = Данные.Порядок;
	НоваяСтрока.УсловиеРассмотрения = Данные.УстанавливаемыйСтатус;
	НоваяСтрока.КонтекстЭлемента = Данные.ВлияющийПроцесс;
	НоваяСтрока.ItemID = ЭлементСхемы.ItemID;
	
	Контекст.СоответствиеЭлементов.Вставить(ЭлементСхемы.ItemID, ЭлементСхемы);
	
	Контекст.ГиперссылкиЭлементовСхемы.Вставить(ЭлементСхемы.ItemCode, Данные.ВлияющийПроцесс);
	
КонецПроцедуры

Процедура УстановитьСвойстваБлокаЗависимость(ЭлементСхемы, Данные, Контекст, Настройки)
	
	Контекст.МаксимальныйИдентификатор = Контекст.МаксимальныйИдентификатор + 1;
	Контекст.Порядок = Контекст.Порядок + 1;
	
	ЭлементСхемы.ItemID = Контекст.МаксимальныйИдентификатор;
	ЭлементСхемы.ItemTabOrder = Контекст.Порядок;
	
	Контекст.КоличествоВлияний = Контекст.КоличествоВлияний + 1;
	ЭлементСхемы.ItemCode = "Влияние" + Контекст.КоличествоВлияний;
	
	УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, Строка(Данные.ЗависимыйШаблон));
	
	ЭлементСхемы.rectTop = Контекст.КоординатыПорядков[Данные.Порядок].ВерхняяГраницаЗависимые;
	ЭлементСхемы.rectLeft = Контекст.Середина
							+ Контекст.КоординатыПорядков[Данные.Порядок].Ширина/2
							+ Настройки.ОтступДоВлияющегоЭтапа;
	
	ЭлементСхемы.rectBottom = ЭлементСхемы.rectTop + Настройки.ВысотаВлияющегоЭтапа;
	ЭлементСхемы.rectRight = ЭлементСхемы.rectLeft + Настройки.ШиринаВлияющегоЭтапа;
	
	Контекст.КоординатыПорядков[Данные.Порядок].ВерхняяГраницаЗависимые = ЭлементСхемы.rectBottom + Настройки.ОтступМеждуВлияющимиЭтапамиПоВертикали;
	
	// Смещение верхней границы для совпадения границ элементов
	Если ЭлементСхемы.rectTop <> Контекст.КоординатыПорядков[Данные.Порядок].ВерхняяГраница Тогда
		ЭлементСхемы.rectTop = ЭлементСхемы.rectTop - 1;
	КонецЕсли;
	
	НоваяСтрока = Контекст.ТаблицаИдентификаторовЭлементов.Добавить();
	НоваяСтрока.ИдентификаторЭтапа = Данные.ИдентификаторЭтапа;
	НоваяСтрока.ТипЭлемента = "ЗависимыйПроцесс";
	НоваяСтрока.Порядок = Данные.Порядок;
	НоваяСтрока.УсловиеРассмотрения = Данные.Статус;
	НоваяСтрока.КонтекстЭлемента = Данные.ЗависимыйШаблон;
	НоваяСтрока.ItemID = ЭлементСхемы.ItemID;
	
	Контекст.СоответствиеЭлементов.Вставить(ЭлементСхемы.ItemID, ЭлементСхемы);
	
	Контекст.ГиперссылкиЭлементовСхемы.Вставить(ЭлементСхемы.ItemCode, Данные.ЗависимыйШаблон);
	
КонецПроцедуры

Процедура УстановитьСвойстваРамкиТекущегоЭтапа(ЭлементСхемы, ЭлементЭтап, Контекст, Настройки)
	
	Контекст.МаксимальныйИдентификатор = Контекст.МаксимальныйИдентификатор + 1;
	Контекст.Порядок = Контекст.Порядок + 1;
	
	ЭлементСхемы.ItemID = Контекст.МаксимальныйИдентификатор;
	ЭлементСхемы.ItemTabOrder = Контекст.Порядок;
	
	ЭлементСхемы.groupNum = ЭлементЭтап.groupNum;
	
	ЭлементСхемы.ItemCode = "Рамка" + ЭлементЭтап.ItemCode;
	
	ЭлементСхемы.rectTop = ЭлементЭтап.rectTop - Настройки.ОтступРамкиОтЭтапа;
	ЭлементСхемы.rectBottom = Контекст.ТекущаяНижняяГраница + Настройки.ОтступРамкиОтЭтапа;
	
	ЭлементСхемы.rectLeft = ЭлементЭтап.rectLeft - Настройки.ОтступРамкиОтЭтапа;
	ЭлементСхемы.rectRight = ЭлементЭтап.rectRight + Настройки.ОтступРамкиОтЭтапа;
	
КонецПроцедуры

Процедура УстановитьСвойстваЛинии(ЭлементСхемы, Заголовок, ЭлементОткуда, ЭлементКуда, Контекст, Настройки)
	
	Контекст.МаксимальныйИдентификатор = Контекст.МаксимальныйИдентификатор + 1;
	Контекст.Порядок = Контекст.Порядок + 1;
	
	ЭлементСхемы.ItemID = Контекст.МаксимальныйИдентификатор;
	ЭлементСхемы.ItemTabOrder = Контекст.Порядок;
	
	Если ЭлементОткуда.ОтрицательныйРезультат = Истина Тогда
		ЭлементСхемы.lineColor = webЦвета.Кирпичный;
	ИначеЕсли ЭлементОткуда.ОтрицательныйРезультат = Ложь Тогда
		ЭлементСхемы.lineColor = webЦвета.Зеленый;
	КонецЕсли;
	
	Контекст.КоличествоЛиний = Контекст.КоличествоЛиний + 1;
	ЭлементСхемы.ItemCode = "ДекоративнаяЛиния" + Контекст.КоличествоЛиний;
	
	УстановитьЗаголовокЭлементаСхемы(ЭлементСхемы.ItemTitle, Заголовок);
	
	УстановитьНачалоИКонецЛинии(ЭлементСхемы, ЭлементОткуда, ЭлементКуда);
	
	УстановитьКоординатыЛинии(ЭлементСхемы, ЭлементОткуда, ЭлементКуда, Контекст, Настройки);
	
КонецПроцедуры

Процедура УстановитьСвойстваЛинииВлияния(ЭлементСхемы, ЭлементОткуда, ЭлементКуда, Контекст, Настройки)
	
	Контекст.МаксимальныйИдентификатор = Контекст.МаксимальныйИдентификатор + 1;
	Контекст.Порядок = Контекст.Порядок + 1;
	
	ЭлементСхемы.ItemID = Контекст.МаксимальныйИдентификатор;
	ЭлементСхемы.ItemTabOrder = Контекст.Порядок;
	
	Контекст.КоличествоЛиний = Контекст.КоличествоЛиний + 1;
	ЭлементСхемы.ItemCode = "ДекоративнаяЛиния" + Контекст.КоличествоЛиний;
	
	УстановитьНачалоИКонецЛинииВлияния(ЭлементСхемы, ЭлементОткуда, ЭлементКуда);
	
	УстановитьКоординатыЛинииВлияния(ЭлементСхемы, ЭлементОткуда, ЭлементКуда, Контекст, Настройки);
	
КонецПроцедуры

Процедура УстановитьНачалоИКонецЛинии(ЭлементСхемы, ЭлементОткуда, ЭлементКуда)
	
	ЭлементСхемы.ConnectFromItemID = ЭлементОткуда.ItemID;
	ЭлементСхемы.ConnectToItemID = ЭлементКуда.ItemID;
	
	ЭлементСхемы.PortIndexFrom = 4;
	Если ЭлементКуда.Порядок < ЭлементОткуда.Порядок Тогда
		ЭлементСхемы.PortIndexTo = 3;
	Иначе
		ЭлементСхемы.PortIndexTo = 2;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьНачалоИКонецЛинииВлияния(ЭлементСхемы, ЭлементОткуда, ЭлементКуда)
	
	ЭлементСхемы.ConnectFromItemID = ЭлементОткуда.ItemID;
	ЭлементСхемы.ConnectToItemID = ЭлементКуда.ItemID;
	
	ЭлементСхемы.PortIndexFrom = 3;
	ЭлементСхемы.PortIndexTo = 1;
	
КонецПроцедуры

Процедура УстановитьКоординатыТочкиДействия(ЭлементыСхемы, X1, Y1, X2, Y2, X3, Y3, X4, Y4)
	
	СписокТочек = ЭлементыСхемы.Point;
	
	СписокТочек[0].X = X1;
	СписокТочек[0].Y = Y1;
	
	СписокТочек[1].X = X2;
	СписокТочек[1].Y = Y2;
	
	СписокТочек[2].X = X3;
	СписокТочек[2].Y = Y3;
	
	СписокТочек[3].X = X4;
	СписокТочек[3].Y = Y4;
	
КонецПроцедуры

Процедура УстановитьКоординатыТочкиСтартаЗавершения(ЭлементыСхемы, X1, Y1, X2, Y2, X3, Y3, X4, Y4, X5, Y5)
	
	СписокТочек = ЭлементыСхемы.Point;
	
	СписокТочек[0].X = X1;
	СписокТочек[0].Y = Y1;
	
	СписокТочек[1].X = X2;
	СписокТочек[1].Y = Y2;
	
	СписокТочек[2].X = X3;
	СписокТочек[2].Y = Y3;
	
	СписокТочек[3].X = X4;
	СписокТочек[3].Y = Y4;
	
	СписокТочек[4].X = X5;
	СписокТочек[4].Y = Y5;
	
КонецПроцедуры

Процедура УстановитьКоординатыЛинии(Линия, ЭлементОткуда, ЭлементКуда, Контекст, Настройки)
	
	ЭлементНачало = Контекст.СоответствиеЭлементов[ЭлементОткуда.ItemID];
	ЭлементОкончание = Контекст.СоответствиеЭлементов[ЭлементКуда.ItemID];
	
	СписокТочек = Линия.Point;
	
	X = ЭлементНачало.RectLeft + Цел((ЭлементНачало.RectRight - ЭлементНачало.RectLeft)/2);
	Y = ЭлементНачало.RectBottom;
	
	СписокТочек[0].X = X;
	СписокТочек[0].Y = Y;
	
	СписокТочек[1].X = X;
	СписокТочек[1].Y = Y + Настройки.ШагСетки;
	
	Если Линия.PortIndexTo = 1 Тогда
		Xlast = ЭлементОкончание.RectLeft;
		Ylast = ЭлементОкончание.RectTop + Цел((ЭлементОкончание.RectBottom - ЭлементОкончание.RectTop)/2);
	ИначеЕсли Линия.PortIndexTo = 2 Тогда
		Xlast = ЭлементОкончание.RectLeft + Цел((ЭлементОкончание.RectRight - ЭлементОкончание.RectLeft)/2);
		Ylast = ЭлементОкончание.RectTop;
	ИначеЕсли Линия.PortIndexTo = 3 Тогда
		Xlast = ЭлементОкончание.RectRight;
		Ylast = ЭлементОкончание.RectTop + Цел((ЭлементОкончание.RectBottom - ЭлементОкончание.RectTop)/2);
	КонецЕсли;
	
	Если Линия.PortIndexTo = 1 Тогда
		
		НужноТочекВЛинии = 5;
		
		МаксимальнаяШирина = МаксимальнаяШиринаМеждуЭтапами(ЭлементОткуда ,ЭлементКуда, Контекст, Настройки);
		
	ИначеЕсли Линия.PortIndexTo = 2 Тогда
		Если (ЭлементКуда.Порядок = 99 ИЛИ ЭлементКуда.Порядок - ЭлементОткуда.Порядок > 1)
			И ЭлементОткуда.Порядок <> Контекст.МаксимальныйПорядокЭтапа Тогда
			
			НужноТочекВЛинии = 6;
			МаксимальнаяШирина = МаксимальнаяШиринаМеждуЭтапами(ЭлементОткуда ,ЭлементКуда, Контекст, Настройки);
			Отступ = ОтступСлеваСУчетомЗанятыхЛиний(ЭлементОткуда ,ЭлементКуда, МаксимальнаяШирина, Контекст, Настройки);
			
			СписокТочек[2].X = Контекст.Середина + Цел(МаксимальнаяШирина/2) + Отступ;
			СписокТочек[2].Y = СписокТочек[1].Y;
			
			СписокТочек[3].X = СписокТочек[2].X;
			СписокТочек[3].Y = Ylast - Настройки.ШагСетки;
			
			СписокТочек[4].X = Контекст.Середина;
			СписокТочек[4].Y = СписокТочек[3].Y;
			
		ИначеЕсли ЭлементОткуда.НомерРезолюции > 1 Тогда
			
			НужноТочекВЛинии = 5;
			
			СписокТочек[2].X = СписокТочек[1].X;
			СписокТочек[2].Y = СписокТочек[1].Y + Цел(Настройки.ШагСетки*(ЭлементОткуда.НомерРезолюции - 1)/2);
			
			СписокТочек[3].X = ЭлементОкончание.RectLeft + Цел((ЭлементОкончание.RectRight - ЭлементОкончание.RectLeft)/2);
			СписокТочек[3].Y = СписокТочек[2].Y;
			
		Иначе
			НужноТочекВЛинии = 4;
			СписокТочек[2].X = ЭлементОкончание.RectLeft + Цел((ЭлементОкончание.RectRight - ЭлементОкончание.RectLeft)/2);
			СписокТочек[2].Y = СписокТочек[1].Y;
		КонецЕсли;
	ИначеЕсли Линия.PortIndexTo = 3 Тогда
		
		Если ЭлементОткуда.НомерРезолюции > 1 Тогда
			НужноТочекВЛинии = 6;
			СписокТочек[2].X = X;
			СписокТочек[2].Y = Y + Настройки.ШагСетки + Цел(Настройки.ШагСетки*(ЭлементОткуда.НомерРезолюции - 1)/2);
		Иначе
			НужноТочекВЛинии = 5;
		КонецЕсли;
		
		МаксимальнаяШирина = МаксимальнаяШиринаМеждуЭтапами(ЭлементОткуда ,ЭлементКуда, Контекст, Настройки);
		Отступ = ОтступСлеваСУчетомЗанятыхЛиний(ЭлементОткуда ,ЭлементКуда, МаксимальнаяШирина, Контекст, Настройки);
		
		СписокТочек[НужноТочекВЛинии-3].X = Контекст.Середина + Цел(МаксимальнаяШирина/2) + Отступ;
		СписокТочек[НужноТочекВЛинии-3].Y = СписокТочек[НужноТочекВЛинии-4].Y;
		
		СписокТочек[НужноТочекВЛинии-2].X = СписокТочек[НужноТочекВЛинии-3].X;
		СписокТочек[НужноТочекВЛинии-2].Y = Ylast;
		
	КонецЕсли;
	
	Пока СписокТочек.Количество() > НужноТочекВЛинии Цикл
		СписокТочек.Удалить(СписокТочек.Количество()-1);
	КонецЦикла;
	
	СписокТочек[СписокТочек.Количество()-1].X = Xlast;
	СписокТочек[СписокТочек.Количество()-1].Y = Ylast;
	
КонецПроцедуры

Процедура УстановитьКоординатыЛинииВлияния(Линия, ЭлементОткуда, ЭлементКуда, Контекст, Настройки)
	
	ЭлементНачало = Контекст.СоответствиеЭлементов[ЭлементОткуда.ItemID];
	ЭлементОкончание = Контекст.СоответствиеЭлементов[ЭлементКуда.ItemID];
	
	СписокТочек = Линия.Point;
	
	X = ЭлементНачало.RectRight;
	Y = ЭлементНачало.RectTop + Цел((ЭлементНачало.RectBottom - ЭлементНачало.RectTop)/2);
	
	СписокТочек[0].X = X;
	СписокТочек[0].Y = Y;
	
	СписокТочек[1].X = X + Цел(Настройки.ОтступДоВлияющегоЭтапа/2);
	СписокТочек[1].Y = Y;
	
	Xlast = ЭлементОкончание.RectLeft;
	Ylast = ЭлементОкончание.RectTop + Цел((ЭлементОкончание.RectBottom - ЭлементОкончание.RectTop)/2);
	
	СписокТочек[2].X = СписокТочек[1].X;
	СписокТочек[2].Y = Ylast;
	
	СписокТочек[3].X = Xlast;
	СписокТочек[3].Y = Ylast;
	
КонецПроцедуры

Функция МаксимальнаяШиринаМеждуЭтапами(ЭлементОткуда ,ЭлементКуда, Контекст, Настройки)
	// Необходимо проложить линию справа от самого широкого этапа.
	// Самый широкий этап ищется между соединяемыми этапами, включая их самих.
	МаксимальнаяШирина = Настройки.ШиринаЭтапа;
	НачальныйПорядок = Мин(ЭлементОткуда.Порядок, ЭлементКуда.Порядок);
	Если ЭлементКуда.Порядок = 99 Тогда
		КонечныйПорядок = Контекст.МаксимальныйПорядокЭтапа;
	Иначе
		КонечныйПорядок = Макс(ЭлементОткуда.Порядок, ЭлементКуда.Порядок);
	КонецЕсли;
	Для к = НачальныйПорядок По КонечныйПорядок Цикл
		МаксимальнаяШирина = Макс(Контекст.КоординатыПорядков[к].Ширина, МаксимальнаяШирина);
	КонецЦикла;
	Возврат МаксимальнаяШирина;
КонецФункции

Функция ОтступСлеваСУчетомЗанятыхЛиний(ЭлементОткуда ,ЭлементКуда, ИскомаяШирина, Контекст, Настройки)
	
	НачальныйПорядок = Мин(ЭлементОткуда.Порядок, ЭлементКуда.Порядок);
	Если ЭлементКуда.Порядок = 99 Тогда
		КонечныйПорядок = Контекст.МаксимальныйПорядокЭтапа;
	Иначе
		КонечныйПорядок = Макс(ЭлементОткуда.Порядок, ЭлементКуда.Порядок);
	КонецЕсли;
	Для к = НачальныйПорядок По КонечныйПорядок Цикл
		Если Контекст.КоординатыПорядков[к].Ширина = ИскомаяШирина Тогда
			ИндексЛинии = Контекст.КоординатыПорядков[к].ЛинииСправа.Найти(ЭлементКуда.Порядок);
			Если ИндексЛинии = Неопределено Тогда
				ИндексЛинии = Контекст.КоординатыПорядков[к].ЛинииСправа.Количество();
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для к = 0 По КонечныйПорядок Цикл
		Если Контекст.КоординатыПорядков[к].Ширина = ИскомаяШирина Тогда
			Если Контекст.КоординатыПорядков[к].ЛинииСправа.Найти(ЭлементКуда.Порядок) = Неопределено Тогда
				Контекст.КоординатыПорядков[к].ЛинииСправа.Вставить(ИндексЛинии, ЭлементКуда.Порядок);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Настройки.ШагСетки * (ИндексЛинии + 1);
	
КонецФункции

Функция НастройкиФорматированияСхем()
	
	Структура = Новый Структура;
	
	Структура.Вставить("ОтступПоГоризонтали",30);
	Структура.Вставить("ОтступМеждуПорядкамиПоВертикали",45);
	Структура.Вставить("ОтступМеждуЭтапамиПоГоризонтали",30);
	Структура.Вставить("ОтступДоВлияющегоЭтапа",60);
	Структура.Вставить("ОтступМеждуВлияющимиЭтапамиПоВертикали",0);
	Структура.Вставить("ОтступРамкиОтЭтапа",2);
	Структура.Вставить("ВысотаЭтапа",60);
	Структура.Вставить("ШиринаЭтапа",240);
	// ширина резолюции равна половине ширины этапа
	Структура.Вставить("ВысотаРезолюции",65); //60
	Структура.Вставить("ВысотаОдиночнойРезолюции",65); //30
	Структура.Вставить("ВысотаВлияющегоЭтапа",30);
	Структура.Вставить("ШиринаВлияющегоЭтапа",240);
	Структура.Вставить("ШагСетки",15);
	
	Возврат Структура;
	
КонецФункции

Функция ВключенаПоддержкаФормированияИПодписанияФормуляров() Экспорт
	Результат = Ложь;
	
	ПроцессыОбработкиДокументовПереопределяемый.РежимФормированияИПодписанияФормуляров(Результат);
	
	Возврат Результат;
КонецФункции

Процедура ФормированиеФормуляраДляПодписания(ВыполняемаяЗадача, Предмет, Шаблон, ИдентификаторЭтапа) Экспорт

	ВыводитьШтампы = Ложь;
	
	РеквизитыДокумента = Новый Структура;
	ПроцессыОбработкиДокументовПереопределяемый.СтруктураРеквизитовОбъектаУчета(РеквизитыДокумента);
	
	Исполнитель = ВыполняемаяЗадача.Исполнитель;
	
	ПроцессыОбработкиДокументовПереопределяемый.ЗаполнитьРеквизитыДокументаУчета(Предмет, РеквизитыДокумента);
	
	ДатаДокумента = РеквизитыДокумента.Дата;
	НомерДокумента = РеквизитыДокумента.Номер;
	
	ЭтапВыполняетсяНесколькимиИсполнителями = ФормулярЭтапаВыполняемогоНесколькимиИсполнителями(Шаблон, ИдентификаторЭтапа);
	НастройкиФормированияФормуляровЭтапа = СписокКодовНастроекПечатныхФормФормуляровЭтапа(Шаблон, ИдентификаторЭтапа);
	
	ИдентификаторыКомандПечатиДляФормированияФормуляров = НастройкиФормированияФормуляровЭтапа.ИдентификаторыКомандПечатиСоШтампом;
	КодыНастроекФормированияПодписания = НастройкиФормированияФормуляровЭтапа.КодыНастройкиФормированияИПодписанияФормуляров;
	
	ИдентификаторыДляФормированияФормуляров = СтрРазделить(ИдентификаторыКомандПечатиДляФормированияФормуляров, ",", Ложь);
	КодыДляФормированияФормуляров = СтрРазделить(КодыНастроекФормированияПодписания, ",", Ложь);
	
	КоличествоВидовФормуляров = ИдентификаторыДляФормированияФормуляров.Количество();
	
	ПроверкаПроведенияПередФормированиемФормуляра(ИдентификаторыДляФормированияФормуляров, Предмет, ВыполняемаяЗадача.Этап);
	
	НомерНастройки = 0;
	Для НомерВидаФормуляра = 1 По КоличествоВидовФормуляров Цикл
		ИдентификаторПечати = ИдентификаторыДляФормированияФормуляров[НомерВидаФормуляра - 1];
		
		КодНастройкиДляПечатнойФормы = "0";
		Если НомерНастройки < КодыДляФормированияФормуляров.Количество() Тогда
			КодНастройкиДляПечатнойФормы = КодыДляФормированияФормуляров[НомерНастройки];
		КонецЕсли;
		НомерНастройки = НомерНастройки + 1;
		
		НастройкаДляПечатнойФормы = ПроцессыОбработкиДокументовВызовСервера.ЗначениеНастройкиФормированияИПодписанияФормуляров(КодНастройкиДляПечатнойФормы);
		
		Если НастройкаДляПечатнойФормы = Перечисления.ВариантыФормированияФормуляровПОД.ФормироватьИПодписыватьТолькоНаЭтомЭтапе
			ИЛИ НастройкаДляПечатнойФормы = Перечисления.ВариантыФормированияФормуляровПОД.ФормироватьИПодписыватьНаЭтомИСледующихЭтапах Тогда
			НаименованиеДокумента = НаименованиеПервичногоДокументаПоИдентификаторуПечати(Предмет, Шаблон, ИдентификаторПечати);
			НаименованиеПечатнойФормыДокумента = НаименованиеПечатнойФормыПоИдентификаторуПечати(Предмет, Шаблон, ИдентификаторПечати);
			
			ВариантФормированияИПодписания = ПроцессыОбработкиДокументовВызовСервера.ЗначениеНастройкиФормированияИПодписанияФормуляров(КодНастройкиДляПечатнойФормы);
			
			ИдентификаторФормуляра = Строка(Новый УникальныйИдентификатор);
			
			Расширение = Новый Массив;
		    Расширение.Добавить("MXL");
			Расширение.Добавить("PDF");
			
			СведенияПредставленияВнутреннегоЭД = СведенияПредставленияВнутреннегоЭД(ИдентификаторФормуляра, Предмет, Шаблон, ИдентификаторПечати, 
				НаименованиеПечатнойФормыДокумента, НаименованиеДокумента, ДатаДокумента, НомерДокумента, Расширение, ВыводитьШтампы);

			ЗаписатьСведенияФормуляровВнутреннегоЭДВФайл(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД, РеквизитыДокумента, Шаблон, 
				ИдентификаторЭтапа, ВариантФормированияИПодписания, Исполнитель, ЭтапВыполняетсяНесколькимиИсполнителями);

		ИначеЕсли НастройкаДляПечатнойФормы = Перечисления.ВариантыФормированияФормуляровПОД.ПодписыватьНаЭтомЭтапе Тогда
			Расширение = "MXL";
			СведенияСуществующегоВнутреннегоЭД = ПоследнийФормулярПервичногоДокументаДляПодписания(Предмет, ИдентификаторПечати, ИдентификаторЭтапа, 
				Шаблон, 1, Расширение);
			ВариантФормированияИПодписания = НастройкаДляПечатнойФормы;
			
			ЗаписатьСведенияСуществующихФормуляровВнутреннегоЭДВФайл(ВыполняемаяЗадача, СведенияСуществующегоВнутреннегоЭД, РеквизитыДокумента, 
				Шаблон, ИдентификаторЭтапа, ВариантФормированияИПодписания);
			
			Расширение = "PDF";
			СведенияСуществующегоВнутреннегоЭД = ПоследнийФормулярПервичногоДокументаДляПодписания(Предмет, ИдентификаторПечати, ИдентификаторЭтапа, 
				Шаблон, 2, Расширение);

			ЗаписатьСведенияСуществующихФормуляровВнутреннегоЭДВФайл(ВыполняемаяЗадача, СведенияСуществующегоВнутреннегоЭД, РеквизитыДокумента, 
				Шаблон, ИдентификаторЭтапа, ВариантФормированияИПодписания);
			
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаписатьСведенияСуществующихФормуляровВнутреннегоЭДВФайл(ВыполняемаяЗадача, СведенияСуществующегоВнутреннегоЭД, 
	РеквизитыДокумента, Шаблон, ИдентификаторЭтапа, ВариантФормированияИПодписания, ФайлФормируетПользователь = Неопределено)

	УстановитьПривилегированныйРежим(Истина);
	
	ДатаФормирования = ТекущаяДатаСеанса();
	
	ФайлФормуляраПервичногоДокумента = СведенияСуществующегоВнутреннегоЭД.ДокументФормуляра;
	
	Исполнитель = ?(ЗначениеЗаполнено(ВыполняемаяЗадача.Исполнитель), ВыполняемаяЗадача.Исполнитель, Пользователи.ТекущийПользователь());
	
	НаборЗаписейПриложения = РегистрыСведений.ФайлыФормуляровЭДПОД.СоздатьНаборЗаписей();
	НаборЗаписейПриложения.Отбор.Предмет.Установить(СведенияСуществующегоВнутреннегоЭД.Предмет);
	НаборЗаписейПриложения.Отбор.ИдентификаторЭтапа.Установить(ИдентификаторЭтапа);
	НаборЗаписейПриложения.Отбор.ИдентификаторПечатнойФормы.Установить(СведенияСуществующегоВнутреннегоЭД.ИдентификаторПечати);
	НаборЗаписейПриложения.Отбор.КодВидаСведений.Установить(СведенияСуществующегоВнутреннегоЭД.КодВидаСведений);
	НаборЗаписейПриложения.Отбор.Исполнитель.Установить(Исполнитель);
	
	Если ЗначениеЗаполнено(ФайлФормуляраПервичногоДокумента) Тогда
		ЗаписьПриложение = НаборЗаписейПриложения.Добавить();
		ЗаписьПриложение.Предмет = СведенияСуществующегоВнутреннегоЭД.Предмет;
		ЗаписьПриложение.ИдентификаторПечатнойФормы = СведенияСуществующегоВнутреннегоЭД.ИдентификаторПечати;
		ЗаписьПриложение.Организация = РеквизитыДокумента.Организация;	
		ЗаписьПриложение.КодВидаСведений = СведенияСуществующегоВнутреннегоЭД.КодВидаСведений;
		ЗаписьПриложение.ИдентификаторЭтапа = ИдентификаторЭтапа;
		ЗаписьПриложение.Формат = СведенияСуществующегоВнутреннегоЭД.Расширение;
		ЗаписьПриложение.ДатаФормирования = ДатаФормирования;
		ЗаписьПриложение.НаименованиеДокумента = СведенияСуществующегоВнутреннегоЭД.НаименованиеДокумента;
		ЗаписьПриложение.НаименованиеПечатнойФормы = ФайлФормуляраПервичногоДокумента.НаименованиеПечатнойФормы;
		ЗаписьПриложение.НомерДокумента = СведенияСуществующегоВнутреннегоЭД.НомерДокумента;
		ЗаписьПриложение.ДатаДокумента = СведенияСуществующегоВнутреннегоЭД.ДатаДокумента;
		ЗаписьПриложение.ВариантФормированияИПодписания = ВариантФормированияИПодписания;
		ЗаписьПриложение.ВыполняемаяЗадача = ВыполняемаяЗадача;
		ЗаписьПриложение.Исполнитель = Исполнитель;
		
		ЗаписьПриложение.ДанныеПредставленияПервичногоДокумента = ФайлФормуляраПервичногоДокумента;
	КонецЕсли;	
	
	НаборЗаписейПриложения.Записать();

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаписатьСведенияФормуляровВнутреннегоЭДВФайл(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД, 
	РеквизитыДокумента, Шаблон, ИдентификаторЭтапа, ВариантФормированияИПодписания, 
	Исполнитель, ЭтапВыполняетсяНесколькимиИсполнителями, ФайлФормируетПользователь = Неопределено)

	УстановитьПривилегированныйРежим(Истина);
	
	ДатаФормирования = ТекущаяДатаСеанса();

	Исполнитель = ВыполняемаяЗадача.Исполнитель;
	
	Если ТипЗнч(СведенияПредставленияВнутреннегоЭД) = Тип("Массив") Тогда
		
		Для Каждого ЭлементСведенияПредставленияВнутреннегоЭД Из СведенияПредставленияВнутреннегоЭД Цикл
			
			СформироватьФайлФормуляраПервичногоДокумента(ВариантФормированияИПодписания, ВыполняемаяЗадача, ДатаФормирования, ИдентификаторЭтапа, 
				Исполнитель, РеквизитыДокумента, ЭлементСведенияПредставленияВнутреннегоЭД, ФайлФормируетПользователь);
		
		КонецЦикла;
		
	Иначе
			
		СформироватьФайлФормуляраПервичногоДокумента(ВариантФормированияИПодписания, ВыполняемаяЗадача, ДатаФормирования, ИдентификаторЭтапа, 
			Исполнитель, РеквизитыДокумента, СведенияПредставленияВнутреннегоЭД, ФайлФормируетПользователь);
 
	КонецЕсли;	
		
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

Процедура СформироватьФайлФормуляраПервичногоДокумента(Знач ВариантФормированияИПодписания, ВыполняемаяЗадача, Знач ДатаФормирования, ИдентификаторЭтапа, Исполнитель, Знач РеквизитыДокумента, Знач СведенияПредставленияВнутреннегоЭД, Знач ФайлФормируетПользователь)
	
	ФайлФормуляраПервичногоДокумента = ФайлФормуляраПервичногоДокументаПОД(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД, ИдентификаторЭтапа, РеквизитыДокумента, ДатаФормирования, ФайлФормируетПользователь);
	
	НаборЗаписейПриложения = РегистрыСведений.ФайлыФормуляровЭДПОД.СоздатьНаборЗаписей();
	НаборЗаписейПриложения.Отбор.Предмет.Установить(СведенияПредставленияВнутреннегоЭД.Предмет);
	НаборЗаписейПриложения.Отбор.ИдентификаторЭтапа.Установить(ИдентификаторЭтапа);
	НаборЗаписейПриложения.Отбор.ИдентификаторПечатнойФормы.Установить(СведенияПредставленияВнутреннегоЭД.ИдентификаторПечати);
	НаборЗаписейПриложения.Отбор.КодВидаСведений.Установить(СведенияПредставленияВнутреннегоЭД.КодВидаСведений);
	НаборЗаписейПриложения.Отбор.Исполнитель.Установить(Исполнитель);
	
	Если ЗначениеЗаполнено(СведенияПредставленияВнутреннегоЭД.ДвоичныеДанныеФайла) Тогда
		ЗаписьПриложение = НаборЗаписейПриложения.Добавить();
		ЗаписьПриложение.Предмет = СведенияПредставленияВнутреннегоЭД.Предмет;
		ЗаписьПриложение.ИдентификаторПечатнойФормы = СведенияПредставленияВнутреннегоЭД.ИдентификаторПечати;
		ЗаписьПриложение.Организация = РеквизитыДокумента.Организация;	
		ЗаписьПриложение.КодВидаСведений = СведенияПредставленияВнутреннегоЭД.КодВидаСведений;
		ЗаписьПриложение.ИдентификаторЭтапа = ИдентификаторЭтапа;
		ЗаписьПриложение.Формат = СведенияПредставленияВнутреннегоЭД.Расширение;
		ЗаписьПриложение.ДатаФормирования = ДатаФормирования;
		ЗаписьПриложение.НаименованиеДокумента = СведенияПредставленияВнутреннегоЭД.НаименованиеДокумента;
		ЗаписьПриложение.НомерДокумента = СведенияПредставленияВнутреннегоЭД.НомерДокумента;
		ЗаписьПриложение.ДатаДокумента = СведенияПредставленияВнутреннегоЭД.ДатаДокумента;
		ЗаписьПриложение.ВариантФормированияИПодписания = ВариантФормированияИПодписания;
		ЗаписьПриложение.ВыполняемаяЗадача = ВыполняемаяЗадача;
		ЗаписьПриложение.НаименованиеПечатнойФормы = СведенияПредставленияВнутреннегоЭД.НаименованиеПечатнойФормыДокумента;
		ЗаписьПриложение.Исполнитель = Исполнитель;
		
		ЗаписьПриложение.ДанныеПредставленияПервичногоДокумента = ФайлФормуляраПервичногоДокумента;
	КонецЕсли;	
	
	НаборЗаписейПриложения.Записать();

КонецПроцедуры  

Процедура ЗаписатьПредставленияФормуляраПервичногоДокумента(Знач ДатаФормирования, ИдентификаторЭтапа, Знач РеквизитыДокумента, Знач СведенияПредставленияВнутреннегоЭД, Знач ФайлПредставленияФормуляраПервичногоДокумента)
	
	НаборЗаписейПриложения = РегистрыСведений.ФайлыПредставленияЭДПОД.СоздатьНаборЗаписей();
	НаборЗаписейПриложения.Отбор.Предмет.Установить(СведенияПредставленияВнутреннегоЭД.Предмет);
	НаборЗаписейПриложения.Отбор.ИдентификаторЭтапа.Установить(ИдентификаторЭтапа);
	НаборЗаписейПриложения.Отбор.ИдентификаторПечатнойФормы.Установить(СведенияПредставленияВнутреннегоЭД.ИдентификаторПечати);
	НаборЗаписейПриложения.Отбор.КодВидаСведений.Установить(СведенияПредставленияВнутреннегоЭД.КодВидаСведений);
	
	Если ЗначениеЗаполнено(СведенияПредставленияВнутреннегоЭД.ДвоичныеДанныеФайла) Тогда
		ЗаписьПриложение = НаборЗаписейПриложения.Добавить();
		ЗаписьПриложение.Предмет = СведенияПредставленияВнутреннегоЭД.Предмет;
		ЗаписьПриложение.ИдентификаторПечатнойФормы = СведенияПредставленияВнутреннегоЭД.ИдентификаторПечати;
		ЗаписьПриложение.Организация = РеквизитыДокумента.Организация;	
		ЗаписьПриложение.КодВидаСведений = СведенияПредставленияВнутреннегоЭД.КодВидаСведений;
		ЗаписьПриложение.ИдентификаторЭтапа = ИдентификаторЭтапа;
		ЗаписьПриложение.Формат = СведенияПредставленияВнутреннегоЭД.Расширение;
		ЗаписьПриложение.ДатаФормирования = ДатаФормирования;
		ЗаписьПриложение.НаименованиеДокумента = СведенияПредставленияВнутреннегоЭД.НаименованиеДокумента;
		ЗаписьПриложение.НомерДокумента = СведенияПредставленияВнутреннегоЭД.НомерДокумента;
		ЗаписьПриложение.ДатаДокумента = СведенияПредставленияВнутреннегоЭД.ДатаДокумента;
		ЗаписьПриложение.НаименованиеПечатнойФормы = СведенияПредставленияВнутреннегоЭД.НаименованиеПечатнойФормыДокумента;
		
		ЗаписьПриложение.ДанныеПредставленияПервичногоДокумента = ФайлПредставленияФормуляраПервичногоДокумента;
