КонецПроцедуры

// См. ЭлектроннаяПодпись.УстановленныеПодписи
Функция УстановленныеПодписи(Объект) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ЭлектронныеПодписи = ПроцессыОбработкиДокументовПереопределяемый.УстановленныеПодписи(Объект, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЭлектронныеПодписи, МодульЭлектроннаяПодпись.УстановленныеПодписи(Объект, , Истина));
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЭлектронныеПодписи, УстановленныеПростыеПодписи(Объект));
	КонецЕсли;
	
	Возврат ЭлектронныеПодписи;
	
КонецФункции

// См. ЭлектроннаяПодпись.ШтампВизуализацииЭлектроннойПодписи
Функция ШтампВизуализацииЭлектроннойПодписи(Сертификат, ДатаПодписи = Неопределено, ТекстОтметки = "", ЛоготипОрганизации = Неопределено, СведенияМЧД = Неопределено) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ШтампВизуализацииЭлектроннойПодписи = ПроцессыОбработкиДокументовПереопределяемый.ШтампВизуализацииЭлектроннойПодписи(
		Сертификат, ДатаПодписи, ТекстОтметки, ЛоготипОрганизации, СведенияМЧД, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
		ШтампВизуализацииЭлектроннойПодписи = МодульЭлектроннаяПодпись.ШтампВизуализацииЭлектроннойПодписи(
                Сертификат,,ТекстОтметки, ЛоготипОрганизации);  
				
		ДатаПодписиИзМетки = Неопределено;		
		Сертификат.Свойство("ДатаПодписиИзМетки", ДатаПодписиИзМетки);			
		Если ЗначениеЗаполнено(Сертификат.ДатаПодписи) 
			И Не ЗначениеЗаполнено(ДатаПодписиИзМетки) Тогда
			ШтампВизуализацииЭлектроннойПодписи.Область(3,3,3,3).Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Параметр;
			ШтампВизуализацииЭлектроннойПодписи.Область(3,3,3,3).Параметр = "ДатаПодписи";
			ШтампВизуализацииЭлектроннойПодписи.Область(3,3,3,3).ВертикальноеПоложение = ВертикальноеПоложение.Верх;
			ШтампВизуализацииЭлектроннойПодписи.Параметры.ДатаПодписи = Сертификат.ДатаПодписи;
		КонецЕсли;

		ШтампВизуализацииЭлектроннойПодписи.Области.Штамп.ЦветРамки =  Новый Цвет(0, 0, 0);
		ШтампВизуализацииЭлектроннойПодписи.Области.Штамп.ЦветТекста = ЦветаСтиля.ЦветТекстаПоля.ПолучитьАбсолютный(); 

	КонецЕсли;
	
	Возврат ШтампВизуализацииЭлектроннойПодписи;
	
КонецФункции

// См. ЭлектроннаяПодпись.ДобавитьШтампыВТабличныйДокумент
// Параметры:
//  Ссылка -              - ДокументСсылка - объект, для которого выполняется печать
//  Шаблон                - СправочникСсылка.ШаблоныПроцессов - шаблон процесса обработки документа
//  ИмяМакета             - Строка - имя макета, соответствует свойству "Идентификатор" подключаемой команды печати
//  <остальные параметры> - соответствуют параметрам процедуры ЭлектроннаяПодпись.ДобавитьШтампыВТабличныйДокумент
Процедура ДобавитьШтампыВТабличныйДокумент(Ссылка, Шаблон, ИмяМакета, Документ, ОписаниеШтампов, Размеры = Неопределено) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ПроцессыОбработкиДокументовПереопределяемый.ДобавитьШтампыВТабличныйДокумент(Ссылка, Шаблон, ИмяМакета, Документ, ОписаниеШтампов, Размеры, СтандартнаяОбработка);
	
	//Отступ чтобы штампы не накладывались на представление документа
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	МакетШтампов = МодульУправлениеПечатью.МакетПечатнойФормы("Обработка.ПодготовкаДокументовПОД.ПФ_MXL_ШтампПЭПсДатой");
	ОбластьМакета = МакетШтампов.ПолучитьОбласть("Отступ");
	Документ.Вывести(ОбластьМакета);
	
	Если СтандартнаяОбработка Тогда
		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
		МодульЭлектроннаяПодпись.ДобавитьШтампыВТабличныйДокумент(Документ, ОписаниеШтампов, Размеры);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьПростуюПодпись(Объект) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПроверитьИзменениеРазрешено(Объект);
	КонецЕсли;
	
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект));
	
	НачатьТранзакцию();
	Попытка
		
		Если ЭтоСсылка Тогда
			ЗаблокироватьДанныеДляРедактирования(Объект);
			ОбъектДанных = Объект.ПолучитьОбъект();
		Иначе
			ОбъектДанных = Объект;
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ОбъектДанных.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ОбъектДанных.Ссылка);
		Блокировка.Заблокировать();
		
		СообщениеЖурналаРегистрации = "";
		
		УдалитьСтрокуПростойПодписи(ОбъектДанных, СообщениеЖурналаРегистрации);
		
		ОбъектДанных.ПодписанЭП = Ложь;
		
		Если ЭтоСсылка Тогда
			// Чтобы определить, что это запись с целью добавления/удаления подписи.
			ОбъектДанных.ДополнительныеСвойства.Вставить("ЗаписьПодписанногоОбъекта", Истина);
			Если ОбъектДанных.Модифицированность() Тогда
				ОбъектДанных.Записать();
			КонецЕсли;
			РазблокироватьДанныеДляРедактирования(Объект.Ссылка);
			ЗаписанныйОбъект = ОбъектДанных;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Если ЗначениеЗаполнено(СообщениеЖурналаРегистрации) Тогда
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Процессы обработки документов.Ошибка удаления простой подписи'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Информация,
				Объект.Метаданные(),
				Объект.Ссылка,
				СообщениеЖурналаРегистрации + "
				|
				|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Для процедуры УдалитьПростуюПодпись.
Процедура УдалитьСтрокуПростойПодписи(ПодписанныйОбъект, СообщениеЖурналаРегистрации)
	
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПростыеЭлектронныеПодписиПОД.ПодписанныйОбъект КАК ПодписанныйОбъект
	|ИЗ
	|	РегистрСведений.ПростыеЭлектронныеПодписиПОД КАК ПростыеЭлектронныеПодписиПОД
	|ГДЕ
	|	ПростыеЭлектронныеПодписиПОД.ПодписанныйОбъект = &ПодписанныйОбъект";
	
	Запрос.УстановитьПараметр("ПодписанныйОбъект", ПодписанныйОбъект.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Строка с подписью не существует.'");
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ПростыеЭлектронныеПодписиПОД.СоздатьМенеджерЗаписи();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	МенеджерЗаписи.Прочитать();
	
	ЕстьПрава = ЭтоПолноправныйПользователь
		Или МенеджерЗаписи.УстановившийПодпись = Пользователи.АвторизованныйПользователь();
		
	СообщениеЖурналаРегистрации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Дата подписи: %1'"), Формат(МенеджерЗаписи.ДатаПодписи, "ДЛФ=DT"));
		
	Если ЕстьПрава Тогда
		МенеджерЗаписи.Удалить();
	Иначе
		ВызватьИсключение НСтр("ru = 'Недостаточно прав на удаление простой подписи.'");
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Процессы обработки документов.Удаление простой подписи'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,
		ПодписанныйОбъект.Метаданные(),
		ПодписанныйОбъект.Ссылка,
		СообщениеЖурналаРегистрации,
		РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);
	
КонецПроцедуры

Процедура ДобавитьПростуюПодпись(Объект, Знач СвойстваПодписи) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПроверитьИзменениеРазрешено(Объект);
	КонецЕсли;
	
	Если ТипЗнч(СвойстваПодписи) = Тип("Строка") Тогда
		СвойстваПодписи = ПолучитьИзВременногоХранилища(СвойстваПодписи);
		
	ИначеЕсли ТипЗнч(СвойстваПодписи) = Тип("Массив") Тогда
		ИндексПоследнего = СвойстваПодписи.Количество()-1;
		Для Индекс = 0 По ИндексПоследнего Цикл
			Если ТипЗнч(СвойстваПодписи[Индекс]) = Тип("Строка") Тогда
				СвойстваПодписи[Индекс] = ПолучитьИзВременногоХранилища(СвойстваПодписи[Индекс]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект));
	
	НачатьТранзакцию();
	Попытка
		
		Если ЭтоСсылка Тогда
			ЗаблокироватьДанныеДляРедактирования(Объект);
			ОбъектДанных = Объект.ПолучитьОбъект();
		Иначе
			ОбъектДанных = Объект;
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ОбъектДанных.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ОбъектДанных.Ссылка);
		Блокировка.Заблокировать();
		
		СообщениеЖурналаРегистрации = "";
		
		ДобавитьСтрокуПростойПодписи(ОбъектДанных, СвойстваПодписи, СообщениеЖурналаРегистрации);
		
		Если Не ОбъектДанных.ПодписанЭП
			И (ТипЗнч(СвойстваПодписи) <> Тип("Массив")
				Или СвойстваПодписи.Количество() > 0) Тогда
			ОбъектДанных.ПодписанЭП = Истина;
		КонецЕсли;
		
		Если ЭтоСсылка Тогда
			// Чтобы определить, что это запись с целью добавления/удаления подписи.
			ОбъектДанных.ДополнительныеСвойства.Вставить("ЗаписьПодписанногоОбъекта", Истина);
			Если ОбъектДанных.Модифицированность() Тогда
				ОбъектДанных.Записать();
			КонецЕсли;
			РазблокироватьДанныеДляРедактирования(Объект.Ссылка);
			ЗаписанныйОбъект = ОбъектДанных;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Если ЗначениеЗаполнено(СообщениеЖурналаРегистрации) Тогда
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Процессы обработки документов.Ошибка добавления простой подписи'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Информация,
				Объект.Метаданные(),
				Объект.Ссылка,
				СообщениеЖурналаРегистрации + "
				|
				|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ДобавитьСтрокуПростойПодписи(ОбъектДанных, СвойстваПодписи, СообщениеЖурналаРегистрации)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НоваяЗапись = РегистрыСведений.ПростыеЭлектронныеПодписиПОД.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(НоваяЗапись, СвойстваПодписи);
	
	НоваяЗапись.ПодписанныйОбъект = ОбъектДанных.Ссылка;
	
	Если Не ЗначениеЗаполнено(НоваяЗапись.УстановившийПодпись) Тогда
		НоваяЗапись.УстановившийПодпись = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
	СообщениеЖурналаРегистрации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Дата подписи: %1'"), Формат(НоваяЗапись.ДатаПодписи, "ДЛФ=DT"));
	
	НоваяЗапись.Записать();
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Процессы обработки документов.Добавление простой подписи'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,
		ОбъектДанных.Метаданные(),
		ОбъектДанных.Ссылка,
		СообщениеЖурналаРегистрации,
		РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);
	
КонецПроцедуры

Функция УстановленныеПростыеПодписи(Объект) Экспорт
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) Тогда
		ОбъектСсылка = Объект;
	Иначе
		ОбъектСсылка = Объект.Ссылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК Подпись,
	|	1 КАК ПорядковыйНомер,
	|	ЭлектронныеПодписи.УстановившийПодпись КАК УстановившийПодпись,
	|	ЭлектронныеПодписи.ДатаПодписи КАК ДатаПодписи,
	|	ЭлектронныеПодписи.ВладелецПодписи КАК ВладелецПодписи,
	|	ЭлектронныеПодписи.Организация КАК Организация,
	|	ЭлектронныеПодписи.Должность КАК Должность,
	|	ИСТИНА КАК ПростаяПодпись
	|ИЗ
	|	РегистрСведений.ПростыеЭлектронныеПодписиПОД КАК ЭлектронныеПодписи
	|ГДЕ
	|	ЭлектронныеПодписи.ПодписанныйОбъект = &ПодписанныйОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("ПодписанныйОбъект", ОбъектСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЭлектронныеПодписи = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ОтпечатокСтруктура = Новый Структура(
			"ПорядковыйНомер, ДатаПодписи, УстановившийПодпись, ПростаяПодпись,
			|ДатаПроверкиПодписи, ИмяФайлаПодписи, Комментарий, ПодписьВерна,
			|КомуВыданСертификат, ВладелецПодписи, Организация, Должность");
		ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, Выборка);
		ОтпечатокСтруктура.КомуВыданСертификат = Выборка.ВладелецПодписи + ", " + Строка(Выборка.Организация) + ", " + Выборка.Должность;
		ЭлектронныеПодписи.Добавить(ОтпечатокСтруктура);
	КонецЦикла;
	
	Возврат ЭлектронныеПодписи;
	
КонецФункции

Функция ШтампВизуализацииПростойЭлектроннойПодписи(Свойства, ТекстОтметки = "", ЛоготипОрганизации = Неопределено) Экспорт
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	
	ПараметрыОтображения = Новый Структура;
	ПараметрыОтображения.Вставить("Организация", Свойства.Организация);
	Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭППОД.Получить() = Истина 
		И ПроцессыОбработкиДокументовПереопределяемый.ОтображатьДатуПодписанияВШтампе(ПараметрыОтображения) Тогда
		Штамп = МодульУправлениеПечатью.МакетПечатнойФормы("Обработка.ПодготовкаДокументовПОД.ПФ_MXL_ШтампПЭПсДатой")
	Иначе
		Штамп = МодульУправлениеПечатью.МакетПечатнойФормы("Обработка.ПодготовкаДокументовПОД.ПФ_MXL_ШтампПЭП")
	КонецЕсли;
	
	ПараметрыШтампа = Новый Структура;
	ПараметрыШтампа.Вставить("ВладелецПодписи", Свойства.ВладелецПодписи); 
	НаименованиеОрганизацииВШтампе = "";
	ПроцессыОбработкиДокументовПереопределяемый.НаименованиеОрганизацииВШтампеПЭП(НаименованиеОрганизацииВШтампе, Свойства.Организация);
	Если ЗначениеЗаполнено(НаименованиеОрганизацииВШтампе) Тогда
		ПараметрыШтампа.Вставить("Организация", НаименованиеОрганизацииВШтампе);
	Иначе
		ПараметрыШтампа.Вставить("Организация", Свойства.Организация);
	КонецЕсли;	
	ПараметрыШтампа.Вставить("Должность", Свойства.Должность);
	ПараметрыШтампа.Вставить("ДатаПодписи", Свойства.ДатаПодписи);
	ПараметрыШтампа.Вставить("УстановившийПодпись", Свойства.УстановившийПодпись);
	ПараметрыШтампа.Вставить("ТекстОтметки", ТекстОтметки);
	
	ЗаполнитьЗначенияСвойств(Штамп.Параметры, ПараметрыШтампа);
	
	Если ЛоготипОрганизации <> Неопределено Тогда
		Штамп.Области.Картинка.Картинка = ЛоготипОрганизации;
	КонецЕсли;
	
	Возврат Штамп;
	
КонецФункции

Процедура УдалитьПодписиФайлаПоИдентификаторуЭтапа(Файл, ИдентификаторЭтапа, Задача)
	
	Если НЕ ЗначениеЗаполнено(Файл) Тогда
		Возврат;
	КонецЕсли;
	
	УстановленныеПодписи = УстановленныеПодписи(Файл);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИсполнителиГрупповогоЭтапа.ПорядковыйНомер КАК ПорядковыйНомер
	|ПОМЕСТИТЬ ПорядковыйНомерТекущегоИсполнителя
	|ИЗ
	|	РегистрСведений.ИсполнителиГрупповогоЭтапа КАК ИсполнителиГрупповогоЭтапа
	|ГДЕ
	|	ИсполнителиГрупповогоЭтапа.Задача = &Задача
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрисоединенныеФайлыПодписанныеЗадачами.Задача КАК Задача,
	|	ПрисоединенныеФайлыПодписанныеЗадачами.Файл КАК Файл,
	|	ПрисоединенныеФайлыПодписанныеЗадачами.ДатаПодписи КАК ДатаПодписи,
	|	ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ПрисоединенныеФайлыПодписанныеЗадачами.УстановившийПодпись КАК УстановившийПодпись
	|ИЗ
	|	РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиГрупповогоЭтапа КАК ИсполнителиГрупповогоЭтапа
	|		ПО ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа = ИсполнителиГрупповогоЭтапа.ИдентификаторЭтапа
	|			И ПрисоединенныеФайлыПодписанныеЗадачами.Задача = ИсполнителиГрупповогоЭтапа.Задача
	|ГДЕ
	|	ПрисоединенныеФайлыПодписанныеЗадачами.Файл = &Файл
	|	И ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа = &ИдентификаторЭтапа
	|	И ВЫБОР
	|			КОГДА НЕ ИсполнителиГрупповогоЭтапа.ПорядковыйНомер ЕСТЬ NULL
	|				ТОГДА ИсполнителиГрупповогоЭтапа.ПорядковыйНомер В
	|						(ВЫБРАТЬ
	|							ПорядковыйНомерТекущегоИсполнителя.ПорядковыйНомер
	|						ИЗ
	|							ПорядковыйНомерТекущегоИсполнителя)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Файл", Файл);
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ФайлыПодписанныеНаЭтапе = Запрос.Выполнить().Выгрузить();
	
	// Удаление связи задач и подписанных файлов
	Для Каждого ФайлПодписанныйНаЭтапе Из ФайлыПодписанныеНаЭтапе Цикл
		Запись = РегистрыСведений.ПрисоединенныеФайлыПодписанныеЗадачами.СоздатьМенеджерЗаписи();
		Запись.Задача = ФайлПодписанныйНаЭтапе.Задача;
		Запись.Файл = ФайлПодписанныйНаЭтапе.Файл;
		Запись.Удалить();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	// Удаление электронных подписей предыдущих задач
	СписокНомеровДляУдаления = Новый СписокЗначений;
	Для Каждого УстановленнаяПодпись Из УстановленныеПодписи Цикл
		Для Каждого ФайлПодписанныйНаЭтапе Из ФайлыПодписанныеНаЭтапе Цикл
			Если УстановленнаяПодпись.УстановившийПодпись = ФайлПодписанныйНаЭтапе.УстановившийПодпись
				И УстановленнаяПодпись.ДатаПодписи = ФайлПодписанныйНаЭтапе.ДатаПодписи Тогда
				СписокНомеровДляУдаления.Добавить(УстановленнаяПодпись.ПорядковыйНомер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	СписокНомеровДляУдаления.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Для Каждого НомеровДляУдаления Из СписокНомеровДляУдаления Цикл
		УдалитьПодпись(Файл, НомеровДляУдаления.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписьПодписанногоОбъекта(Объект) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПроверитьИзменениеРазрешено(Объект);
	КонецЕсли;
	
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект));
	
	НачатьТранзакцию();
	Попытка
		
		Если ЭтоСсылка Тогда
			ЗаблокироватьДанныеДляРедактирования(Объект);
			ОбъектДанных = Объект.ПолучитьОбъект();
		Иначе
			ОбъектДанных = Объект;
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ОбъектДанных.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ОбъектДанных.Ссылка);
		Блокировка.Заблокировать();
		
		СообщениеЖурналаРегистрации = "";
		
		Если Не ОбъектДанных.ПодписанЭП Тогда
			ОбъектДанных.ПодписанЭП = Истина;
		КонецЕсли;
		
		Если ЭтоСсылка Тогда
			Если ОбъектДанных.Модифицированность() Тогда
				ОбъектДанных.Записать();
			КонецЕсли;
			РазблокироватьДанныеДляРедактирования(Объект.Ссылка);
			ЗаписанныйОбъект = ОбъектДанных;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Если ЗначениеЗаполнено(СообщениеЖурналаРегистрации) Тогда
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Процессы обработки документов.Ошибка добавления простой подписи'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Информация,
				Объект.Метаданные(),
				Объект.Ссылка,
				СообщениеЖурналаРегистрации + "
				|
				|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ГрафическаяСхема

Процедура УстановитьЗаголовокЭлементаСхемы(ОбъектXDTOЭлемент, Знач ЗаголовокЭлемента)
	
	СписокЭлементов = ОбъектXDTOЭлемент.ПолучитьСписок("item");
	
	Если СписокЭлементов.Количество() > 0 Тогда
		Элемент = СписокЭлементов[0];
		Элемент.Content = ЗаголовокЭлемента;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьРазмерЗаголовкаСхемы(ЭлементСхемы, ЗаголовокСхемы, Коэффициент)
	
	ЭлементСхемы.RectRight = Мин(СтрДлина(ЗаголовокСхемы)*Коэффициент, 1000);
	
КонецПроцедуры

Процедура ДобавитьЭтапы(ЭлементыСхемы, ШаблонСсылка, ТаблицаЭтапов, ТаблицаВлияний, Контекст, Настройки)
	
	ТаблицаВлияний.Свернуть("ИдентификаторЭтапа, Статус, ЗависимыйШаблон");
	ТаблицаВлияний.Колонки.Добавить("Порядок");
	
	Если ТаблицаЭтапов.Колонки.Найти("ИсполнительЭтапаСтрокой") = Неопределено Тогда
		ТаблицаЭтапов.Колонки.Добавить("ИсполнительЭтапаСтрокой");
		Для Каждого ДанныеЭтапа Из ТаблицаЭтапов Цикл
			
			Если ДанныеЭтапа.ЭтапВыполняетсяНесколькимиИсполнителями Тогда
				ИсполнителиЭтапаСтрокой = Новый Массив;
				ИсполнителиГрупповыхЭтапов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонСсылка, "ИсполнителиГрупповыхЭтапов").Выгрузить();
				Для Каждого Исполнитель Из ИсполнителиГрупповыхЭтапов Цикл
					Если Исполнитель.ИдентификаторЭтапа <> ДанныеЭтапа.ИдентификаторЭтапа Тогда
						Продолжить;
					КонецЕсли;
					ИсполнителиЭтапаСтрокой.Добавить(ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(
						Исполнитель.Исполнитель,
						Исполнитель.ОсновнойОбъектАдресации,
						Исполнитель.ДополнительныйОбъектАдресации,
						Исполнитель.ИмяРеквизитаОсновногоОбъектаАдресации,
						Исполнитель.ИмяРеквизитаДополнительногоОбъектаАдресации));
				КонецЦикла;
				ДанныеЭтапа.ИсполнительЭтапаСтрокой = НСтр("ru = 'Параллельно: '") + СтрСоединить(ИсполнителиЭтапаСтрокой, "; ");
			Иначе 
				ДанныеЭтапа.ИсполнительЭтапаСтрокой = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеИсполнителяЭтапа(
					ДанныеЭтапа.Исполнитель,
					ДанныеЭтапа.ОсновнойОбъектАдресации,
					ДанныеЭтапа.ДополнительныйОбъектАдресации,
					ДанныеЭтапа.ИмяРеквизитаОсновногоОбъектаАдресации,
					ДанныеЭтапа.ИмяРеквизитаДополнительногоОбъектаАдресации);
				
			КонецЕсли;
				
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаЭтапов.Сортировать("Порядок, НомерСтроки");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка КАК Этап,
	|	ЭтапыПроцессовРезультатыВыполнения.ПредставлениеРезультата КАК ПредставлениеРезультата,
	|	ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения КАК СтатусПослеВыполнения,
	|	ЭтапыПроцессовРезультатыВыполнения.ОтрицательныйРезультат КАК ОтрицательныйРезультат,
	|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяЭП КАК ТребуетсяЭП,
	|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяПростаяЭП КАК ТребуетсяПростаяЭП
	|ИЗ
	|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|ГДЕ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка В(&Этапы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтрицательныйРезультат,
	|	ЭтапыПроцессовРезультатыВыполнения.НомерСтроки
	|ИТОГИ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПредставлениеРезультата)
	|ПО
	|	Этап";
	Запрос.УстановитьПараметр("Этапы", ТаблицаЭтапов.ВыгрузитьКолонку("Этап"));
	ВыборкаЭтапыРезультатыВыполнения = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МакетЭтапа = Справочники.ШаблоныПроцессов.ПолучитьМакет("Элементы");
	
	ШириныПорядков = Новый Соответствие;
	//поиск максимально широкого участка для корректного размещения элементов
	Порядок = -1;
	МаксимальнаяШиринаПорядка = Настройки.ШиринаЭтапа;
	Для Каждого ДанныеЭтапа Из ТаблицаЭтапов Цикл
		ВыборкаЭтапыРезультатыВыполнения.Сбросить();
		ВыборкаЭтапыРезультатыВыполнения.НайтиСледующий(Новый Структура("Этап", ДанныеЭтапа.Этап));
		КоличествоРезолюций = ВыборкаЭтапыРезультатыВыполнения.ПредставлениеРезультата;
		Если КоличествоРезолюций < 3 Тогда
			ШиринаЭтапа = Настройки.ШиринаЭтапа;
		Иначе
			ШиринаЭтапа = Настройки.ШиринаЭтапа*КоличествоРезолюций/2;
		КонецЕсли;
		Если Порядок <> ДанныеЭтапа.Порядок Тогда
			ШиринаПорядка = ШиринаЭтапа;
			Порядок = ДанныеЭтапа.Порядок;
		Иначе
			ШиринаПорядка = ШиринаПорядка + ШиринаЭтапа + Настройки.ОтступМеждуЭтапамиПоГоризонтали;
		КонецЕсли;
		МаксимальнаяШиринаПорядка = Макс(МаксимальнаяШиринаПорядка, ШиринаПорядка);
		ШириныПорядков.Вставить(ДанныеЭтапа.Порядок, ШиринаПорядка);
		
		Контекст.МаксимальныйПорядокЭтапа = Макс(Контекст.МаксимальныйПорядокЭтапа, ДанныеЭтапа.Порядок);
		
	КонецЦикла;
	
	Контекст.Середина = МаксимальнаяШиринаПорядка/2;
	
	// Наличие влияющих процессов может сместить середину вправо.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.Ссылка КАК ВлияющийПроцесс,
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.ИдентификаторЭтапаЗависимогоШаблона КАК ИдентификаторЭтапаЗависимогоШаблона,
	|	ШаблоныПроцессовВлияниеНаДругиеПроцессы.УстанавливаемыйСтатус КАК УстанавливаемыйСтатус,
	|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ВлияниеНаДругиеПроцессы КАК ШаблоныПроцессовВлияниеНаДругиеПроцессы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО ШаблоныПроцессовВлияниеНаДругиеПроцессы.ЗависимыйШаблон = ШаблоныПроцессовЭтапы.Ссылка
	|			И ШаблоныПроцессовВлияниеНаДругиеПроцессы.ИдентификаторЭтапаЗависимогоШаблона = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа
	|			И (ШаблоныПроцессовЭтапы.Ссылка = &ЗависимыйШаблон)";
	Запрос.УстановитьПараметр("ЗависимыйШаблон", ШаблонСсылка);
	ВлияющиеПроцессы = Запрос.Выполнить().Выгрузить();
	
	Контекст.ВлияющиеПроцессы = ВлияющиеПроцессы;
	
	Порядки = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ВлияющиеПроцессы.ВыгрузитьКолонку("Порядок"));
	Для Каждого Порядок Из Порядки Цикл
		СмещениеСУчетомВлияния = ШириныПорядков[Порядок]/2
					+ Настройки.ОтступДоВлияющегоЭтапа
					+ Настройки.ШиринаВлияющегоЭтапа;
		Контекст.Середина = Макс(Контекст.Середина, СмещениеСУчетомВлияния)
	КонецЦикла;
	
	Контекст.Середина = Контекст.Середина + Настройки.ОтступПоГоризонтали;
	
	Для Каждого ШиринаПорядка Из ШириныПорядков Цикл
		ЗначенияКоординатПорядка = Новый Структура();
		ЗначенияКоординатПорядка.Вставить("Ширина", ШиринаПорядка.Значение);
		ЗначенияКоординатПорядка.Вставить("ЛеваяГраница", Контекст.Середина-Цел(ШиринаПорядка.Значение/2));
		ЗначенияКоординатПорядка.Вставить("ВерхняяГраница", 0);
		ЗначенияКоординатПорядка.Вставить("ВерхняяГраницаВлияющие", 0);
		ЗначенияКоординатПорядка.Вставить("ВерхняяГраницаЗависимые", 0);
		ЗначенияКоординатПорядка.Вставить("ЛинииСправа", Новый Массив);
		ЗначенияКоординатПорядка.Вставить("ЛинииСлева", Новый Массив);
		Контекст.КоординатыПорядков.Вставить(ШиринаПорядка.Ключ, ЗначенияКоординатПорядка);
	КонецЦикла;
	
	Порядок = -1;
	ДобавленныйЭлементЭтап = Неопределено;
	Для Каждого ДанныеЭтапа Из ТаблицаЭтапов Цикл
		
		// Если это этап того же порядка, то перенесем нижнюю границу обратно на высоту этапа
		Если Порядок = ДанныеЭтапа.Порядок Тогда
			Контекст.ТекущаяНижняяГраница = ДобавленныйЭлементЭтап.rectTop - Настройки.ОтступМеждуПорядкамиПоВертикали;
		Иначе
			Контекст.КоординатыПорядков[ДанныеЭтапа.Порядок].ВерхняяГраница = Контекст.ТекущаяНижняяГраница + Настройки.ОтступМеждуПорядкамиПоВертикали;
			Контекст.КоординатыПорядков[ДанныеЭтапа.Порядок].ВерхняяГраницаВлияющие = Контекст.ТекущаяНижняяГраница + Настройки.ОтступМеждуПорядкамиПоВертикали;
			Контекст.КоординатыПорядков[ДанныеЭтапа.Порядок].ВерхняяГраницаЗависимые = Контекст.ТекущаяНижняяГраница + Настройки.ОтступМеждуПорядкамиПоВертикали;
		КонецЕсли;
		
		ЭлементЭтап = ЭлементСхемыПоИмени(МакетЭтапа, "БлокЭтапа");
		ДобавленныйЭлементЭтап = ЭлементыСхемы.Добавить(ЭлементЭтап);
		УстановитьСвойстваБлокаЭтапа(ДобавленныйЭлементЭтап, ДанныеЭтапа, ВыборкаЭтапыРезультатыВыполнения, Контекст, Настройки);
		
		ВыборкаРезультатыВыполнения = ВыборкаЭтапыРезультатыВыполнения.Выбрать();
		Пока ВыборкаРезультатыВыполнения.Следующий() Цикл
			ЭлементРезолюция = ЭлементСхемыПоИмени(МакетЭтапа, "БлокРезолюция");
			ДобавленныйЭлементРезолюция = ЭлементыСхемы.Добавить(ЭлементРезолюция);
			УстановитьСвойстваБлокаРезолюции(ДобавленныйЭлементРезолюция, ДанныеЭтапа, ВыборкаРезультатыВыполнения, Контекст, Настройки);
		КонецЦикла;
		Контекст.ТекущаяНижняяГраница = ДобавленныйЭлементРезолюция.rectBottom;
		
		// выделение рамкой текущего этапа и его резолюций
		Если Контекст.ЭтапыДляВыделения <> Неопределено
			И Контекст.ЭтапыДляВыделения.Найти(ДанныеЭтапа.ИдентификаторЭтапа) <> Неопределено Тогда
			ЭлементРамка = ЭлементСхемыПоИмени(МакетЭтапа, "ТекущийЭтап");
			ДобавленныйЭлементРамкаТекущегоЭтапа = ЭлементыСхемы.Добавить(ЭлементРамка);
			УстановитьСвойстваРамкиТекущегоЭтапа(ДобавленныйЭлементРамкаТекущегоЭтапа, ЭлементЭтап, Контекст, Настройки);
		КонецЕсли;
		
		// нижняя граница может быть сдвинута вниз при большом числе влияющих (зависимых) процессов
		МассивСтрок = ВлияющиеПроцессы.НайтиСтроки(Новый Структура("Порядок", ДанныеЭтапа.Порядок));
		Если МассивСтрок.Количество() > 0 Тогда
			ВысотаВлияний = 0;
			Для Каждого СтрокаВлияние Из МассивСтрок Цикл
				ВысотаВлияющегоЭтапа = ?(СтрДлина(СтрокаВлияние.ВлияющийПроцесс)<=35,
										Настройки.ВысотаВлияющегоЭтапа,
										Настройки.ВысотаВлияющегоЭтапа + Настройки.ШагСетки);
				ВысотаВлияний = ВысотаВлияний + ВысотаВлияющегоЭтапа;
			КонецЦикла;
			ВысотаВлияний = ВысотаВлияний + Настройки.ОтступМеждуВлияющимиЭтапамиПоВертикали;
			Контекст.ТекущаяНижняяГраница = Макс(Контекст.ТекущаяНижняяГраница, ДобавленныйЭлементЭтап.rectTop + ВысотаВлияний);
		КонецЕсли;
		
		МассивСтрок = ТаблицаВлияний.НайтиСтроки(Новый Структура("ИдентификаторЭтапа", ДанныеЭтапа.ИдентификаторЭтапа));
		Если МассивСтрок.Количество() > 0 Тогда
			ВысотаВлияний = 0;
			Для Каждого СтрокаВлияние Из МассивСтрок Цикл
				ВысотаВлияющегоЭтапа = ?(СтрДлина(СтрокаВлияние.ЗависимыйШаблон)<=35,
										Настройки.ВысотаВлияющегоЭтапа,
										Настройки.ВысотаВлияющегоЭтапа + Настройки.ШагСетки);
				ВысотаВлияний = ВысотаВлияний + ВысотаВлияющегоЭтапа;
			КонецЦикла;
			ВысотаВлияний = ВысотаВлияний + Настройки.ОтступМеждуВлияющимиЭтапамиПоВертикали;
			Контекст.ТекущаяНижняяГраница = Макс(Контекст.ТекущаяНижняяГраница, ДобавленныйЭлементЭтап.rectTop + ВысотаВлияний);
		КонецЕсли;
		// дополнение таблицы влияний полем "Порядок"
		Для Каждого Строка Из МассивСтрок Цикл
			Строка.Порядок = ДанныеЭтапа.Порядок;
		КонецЦикла;
		
		Порядок = ДанныеЭтапа.Порядок;
		
	КонецЦикла;
	
	Контекст.ЗависимыеПроцессы = ТаблицаВлияний;
	
КонецПроцедуры

Процедура ДобавитьСвязиМеждуЭтапами(ЭлементыСхемы, ТаблицаПредшественников, Контекст, Настройки)
	
	МакетЭтапа = Справочники.ШаблоныПроцессов.ПолучитьМакет("Элементы");
	
	Для Каждого Предшественник Из ТаблицаПредшественников Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторЭтапа", Предшественник.ИдентификаторПоследователя);
		Отбор.Вставить("УсловиеРассмотрения", ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка"));
		СтрокиКуда = Контекст.ТаблицаИдентификаторовЭлементов.НайтиСтроки(Отбор);
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторЭтапа", Предшественник.ИдентификаторПредшественника);
		Отбор.Вставить("ТипЭлемента", "Резолюция");
		Если Предшественник.УсловиеРассмотрения <> ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка") Тогда
			Отбор.Вставить("УсловиеРассмотрения", Предшественник.УсловиеРассмотрения);
		КонецЕсли;
		СтрокиОткуда = Контекст.ТаблицаИдентификаторовЭлементов.НайтиСтроки(Отбор);
		Для Каждого СтрокаОткуда Из СтрокиОткуда Цикл
			
			ЭлементЛиния = ЭлементСхемыПоИмени(МакетЭтапа, "ДекоративнаяЛиния");
			ДобавленныйЭлементЛиния = ЭлементыСхемы.Добавить(ЭлементЛиния);
			УстановитьСвойстваЛинии(ДобавленныйЭлементЛиния, "", СтрокаОткуда, СтрокиКуда[0], Контекст, Настройки);
			
			ЭлементОткуда = Контекст.СоответствиеЭлементов[СтрокаОткуда.ItemID];
			ИндексЭлементаОткуда = Контекст.РезолюцииБезСвязи.Найти(ЭлементОткуда);
			Если ИндексЭлементаОткуда <> Неопределено Тогда
				Контекст.РезолюцииБезСвязи.Удалить(ИндексЭлементаОткуда);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

