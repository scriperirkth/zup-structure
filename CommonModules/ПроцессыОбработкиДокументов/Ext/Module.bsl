Функция НайтиФайлПредставленияФормуляраПервичногоДокументаДляЗадачиПОД(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(СведенияПредставленияВнутреннегоЭД) = Тип("Массив") Тогда
		Результат = Новый Соответствие;
		ИдентификаторыПечатнойФормы = Новый Массив; 
		КодыВидаСведений = Новый Массив;
		УчетныеДокументы = Новый Массив;
		
		Для Каждого СведениеЭД Из СведенияПредставленияВнутреннегоЭД Цикл
			ИдентификаторыПечатнойФормы.Добавить(СведениеЭД.ИдентификаторПечати);
			КодыВидаСведений.Добавить(СведениеЭД.КодВидаСведений);
			УчетныеДокументы.Добавить(СведениеЭД.Предмет);
		КонецЦикла;	
			
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ФормулярПервичногоДокументаПОД.Ссылка КАК Ссылка,
		|	ФормулярПервичногоДокументаПОД.Предмет КАК Предмет,
		|	ФормулярПервичногоДокументаПОД.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы,
		|	ФормулярПервичногоДокументаПОД.КодВидаСведений КАК КодВидаСведений
		|ИЗ
		|	Документ.ПредставлениеФормуляраПервичногоДокументаПОД КАК ФормулярПервичногоДокументаПОД
		|ГДЕ
		|	ФормулярПервичногоДокументаПОД.Предмет В (&Предмет)
		|	И ФормулярПервичногоДокументаПОД.ИдентификаторПечатнойФормы В (&ИдентификаторыПечатнойФормы)
		|	И ФормулярПервичногоДокументаПОД.ВыполняемаяЗадачаСоздатель = &ВыполняемаяЗадача
		|	И ФормулярПервичногоДокументаПОД.КодВидаСведений В (&КодыВидаСведений)
		|	И ФормулярПервичногоДокументаПОД.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФормулярПервичногоДокументаПОД.Дата УБЫВ";
		
		Запрос.УстановитьПараметр("Предмет", УчетныеДокументы);
		Запрос.УстановитьПараметр("ИдентификаторыПечатнойФормы", ИдентификаторыПечатнойФормы);
		Если ВыполняемаяЗадача = Неопределено Тогда
			Запрос.УстановитьПараметр("ВыполняемаяЗадача", Задачи.ЗадачаПоОбработкеДокумента.ПустаяСсылка());
		Иначе
			Запрос.УстановитьПараметр("ВыполняемаяЗадача", ВыполняемаяЗадача);
		КонецЕсли;	
		Запрос.УстановитьПараметр("КодыВидаСведений", КодыВидаСведений);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		
		Для Каждого СведениеЭД Из СведенияПредставленияВнутреннегоЭД Цикл
			Выборка.Сбросить();
			
			СтруктураПоиска = Новый Структура("Предмет, ИдентификаторПечатнойФормы, КодВидаСведений");
			СтруктураПоиска.Предмет = СведениеЭД.Предмет;
			СтруктураПоиска.ИдентификаторПечатнойФормы = СведениеЭД.ИдентификаторПечати;
			СтруктураПоиска.КодВидаСведений = СведениеЭД.КодВидаСведений;
			
			Если Выборка.НайтиСледующий(СтруктураПоиска) Тогда
			     Результат.Вставить(СведениеЭД, Выборка.Ссылка);
		    КонецЕсли;
		КонецЦикла;	
		
	Иначе

		Результат = Документы.ПредставлениеФормуляраПервичногоДокументаПОД.ПустаяСсылка();
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ФормулярПервичногоДокументаПОД.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.ПредставлениеФормуляраПервичногоДокументаПОД КАК ФормулярПервичногоДокументаПОД
		               |ГДЕ
		               |	ФормулярПервичногоДокументаПОД.Предмет = &Предмет
		               |	И ФормулярПервичногоДокументаПОД.ИдентификаторПечатнойФормы = &ИдентификаторПечатнойФормы
		               |	И ФормулярПервичногоДокументаПОД.ВыполняемаяЗадачаСоздатель = &ВыполняемаяЗадача
		               |	И ФормулярПервичногоДокументаПОД.КодВидаСведений = &КодВидаСведений
		               |	И ФормулярПервичногоДокументаПОД.ПометкаУдаления = ЛОЖЬ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ФормулярПервичногоДокументаПОД.Дата УБЫВ";
		
		Запрос.УстановитьПараметр("Предмет", СведенияПредставленияВнутреннегоЭД.Предмет);
		Запрос.УстановитьПараметр("ИдентификаторПечатнойФормы", СведенияПредставленияВнутреннегоЭД.ИдентификаторПечати);
		Запрос.УстановитьПараметр("ВыполняемаяЗадача", ВыполняемаяЗадача);
		Запрос.УстановитьПараметр("КодВидаСведений", СведенияПредставленияВнутреннегоЭД.КодВидаСведений);

		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;	

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;
	
КонецФункции	

Функция ФайлПредставленияФормуляраПервичногоДокументаПОД(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД, ИдентификаторЭтапа, РеквизитыДокумента, ДатаФормирования, ФайлФормируетПользователь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Организация = РеквизитыДокумента.Организация;
    	
	СуществующееПредставлениеФормуляраЭтапа = НайтиФайлПредставленияФормуляраПервичногоДокументаДляЗадачиПОД(ВыполняемаяЗадача, 
			СведенияПредставленияВнутреннегоЭД);
	
	Если ТипЗнч(СуществующееПредставлениеФормуляраЭтапа) = Тип("Соответствие") Тогда
		Результат = Новый Массив;
		
		Для каждого СведениеЭД Из СведенияПредставленияВнутреннегоЭД Цикл
			
			ТекФормуляр = СуществующееПредставлениеФормуляраЭтапа.Получить(СведениеЭД);
			Если ЗначениеЗаполнено(ТекФормуляр) Тогда;
				ФормулярОбъект = ТекФормуляр.ПолучитьОбъект(); 
			Иначе	
				ФормулярОбъект = Документы.ПредставлениеФормуляраПервичногоДокументаПОД.СоздатьДокумент();
			КонецЕсли;	
				
			ЗаполнитьЗначенияСвойств(ФормулярОбъект, СведениеЭД);
			
			ФормулярОбъект.Дата = ДатаФормирования;
			ФормулярОбъект.ИдентификаторПечатнойФормы = СведениеЭД.ИдентификаторПечати;
			ФормулярОбъект.НаименованиеПечатнойФормы = СведениеЭД.НаименованиеПечатнойФормыДокумента;
			ФормулярОбъект.ИдентификаторФормуляра = СведениеЭД.ИдентификаторФормуляра;
			ФормулярОбъект.Организация = Организация;
			ФормулярОбъект.ВыполняемаяЗадачаСоздатель = ВыполняемаяЗадача;
			
			Если РеквизитыДокумента.Свойство("ВидРегистра") Тогда
				Если ЗначениеЗаполнено(РеквизитыДокумента.ВидРегистра) Тогда
					ФормулярОбъект.НаименованиеВидаРегистраУчета = Строка(РеквизитыДокумента.ВидРегистра);
					ФормулярОбъект.ОписаниеРегистраУчета = РеквизитыДокумента.Описание;
					ФормулярОбъект.НачалоПериода = РеквизитыДокумента.НачалоПериода;
					ФормулярОбъект.КонецПериода = РеквизитыДокумента.КонецПериода;
				КонецЕсли;
			КонецЕсли;
			
			ДвоичныеДанныеДокумента = СведениеЭД.ДвоичныеДанныеФайла;
			АдресОсновногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеДокумента, Новый УникальныйИдентификатор);
			
			ИмяБезРасширения = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеФормуляраПоСвойствам(СведениеЭД);
			ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, " ", "_");
			ИмяБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяБезРасширения, "_");
			
			Расширение = РасширениеФайлаФормуляра(СведениеЭД.КодВидаСведений);
			ПолноеИмяФайла = ИмяБезРасширения + "." + Расширение;
			
			ФормулярОбъект.ДополнительныеСвойства.Вставить("АдресОсновногоФайла", АдресОсновногоФайла);
			ФормулярОбъект.ДополнительныеСвойства.Вставить("ИмяФайла", ПолноеИмяФайла);
			ФормулярОбъект.ДополнительныеСвойства.Вставить("ФайлФормируетПользователь", ФайлФормируетПользователь);
			
			ФормулярОбъект.Записать();
			
			Результат.Добавить(ФормулярОбъект.Ссылка) ;
			
		КонецЦикла;	
		
		
	Иначе

		Результат = Документы.ПредставлениеФормуляраПервичногоДокументаПОД.ПустаяСсылка();
		
		Если ЗначениеЗаполнено(СуществующееПредставлениеФормуляраЭтапа) Тогда
			ФормулярОбъект = СуществующееПредставлениеФормуляраЭтапа.ПолучитьОбъект();
		Иначе	
			ФормулярОбъект = Документы.ПредставлениеФормуляраПервичногоДокументаПОД.СоздатьДокумент();
		КонецЕсли;	
		
		ЗаполнитьЗначенияСвойств(ФормулярОбъект, СведенияПредставленияВнутреннегоЭД);
		
		ФормулярОбъект.Дата = ДатаФормирования;
		ФормулярОбъект.ИдентификаторПечатнойФормы = СведенияПредставленияВнутреннегоЭД.ИдентификаторПечати;
		ФормулярОбъект.НаименованиеПечатнойФормы = СведенияПредставленияВнутреннегоЭД.НаименованиеПечатнойФормыДокумента;
		ФормулярОбъект.ИдентификаторФормуляра = СведенияПредставленияВнутреннегоЭД.ИдентификаторФормуляра;
		ФормулярОбъект.Организация = Организация;
		ФормулярОбъект.ВыполняемаяЗадачаСоздатель = ВыполняемаяЗадача;
		
		Если РеквизитыДокумента.Свойство("ВидРегистра") Тогда
			Если ЗначениеЗаполнено(РеквизитыДокумента.ВидРегистра) Тогда
				ФормулярОбъект.НаименованиеВидаРегистраУчета = Строка(РеквизитыДокумента.ВидРегистра);
				ФормулярОбъект.ОписаниеРегистраУчета = РеквизитыДокумента.Описание;
				ФормулярОбъект.НачалоПериода = РеквизитыДокумента.НачалоПериода;
				ФормулярОбъект.КонецПериода = РеквизитыДокумента.КонецПериода;
			КонецЕсли;
		КонецЕсли;
		
		ДвоичныеДанныеДокумента = СведенияПредставленияВнутреннегоЭД.ДвоичныеДанныеФайла;
		АдресОсновногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеДокумента, Новый УникальныйИдентификатор);
		
		ИмяБезРасширения = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеФормуляраПоСвойствам(СведенияПредставленияВнутреннегоЭД);
		ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, " ", "_");
		ИмяБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяБезРасширения, "_");
		
		Расширение = РасширениеФайлаФормуляра(СведенияПредставленияВнутреннегоЭД.КодВидаСведений);
		ПолноеИмяФайла = ИмяБезРасширения + "." + Расширение;
		
		ФормулярОбъект.ДополнительныеСвойства.Вставить("АдресОсновногоФайла", АдресОсновногоФайла);
		ФормулярОбъект.ДополнительныеСвойства.Вставить("ИмяФайла", ПолноеИмяФайла);
		ФормулярОбъект.ДополнительныеСвойства.Вставить("ФайлФормируетПользователь", ФайлФормируетПользователь);
		
		ФормулярОбъект.Записать();
		
		Результат = ФормулярОбъект.Ссылка; 
	КонецЕсли;	

	УстановитьПривилегированныйРежим(Ложь);
		
	Возврат Результат;
КонецФункции	

Функция ПрисоединенныеФайлыПредставленияФормуляраПервичногоДокумента(Предмет, ИдентификаторФормуляра) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ФайлПустой = Справочники.ПредставлениеФормуляраПервичногоДокументаПОДПрисоединенныеФайлы.ПустаяСсылка();

	Результат = Новый Структура;
	Результат.Вставить("ФайлMXL", ФайлПустой);
	Результат.Вставить("ФайлPDF", ФайлПустой);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.КодВидаСведений КАК КодВидаСведений,
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.Ссылка КАК Ссылка,
	               |	ВЫРАЗИТЬ(ПредставлениеФормуляраПервичногоДокументаПОД.Ссылка КАК Документ.ПредставлениеФормуляраПервичногоДокументаПОД).ОсновнойФайл КАК ОсновнойФайлФормуляра
	               |ИЗ
	               |	Документ.ПредставлениеФормуляраПервичногоДокументаПОД КАК ПредставлениеФормуляраПервичногоДокументаПОД
	               |ГДЕ
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.Предмет = &Предмет
	               |	И ПредставлениеФормуляраПервичногоДокументаПОД.ИдентификаторФормуляра = &ИдентификаторФормуляра
	               |	И ПредставлениеФормуляраПервичногоДокументаПОД.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПредставлениеФормуляраПервичногоДокументаПОД.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Предмет", Предмет);
	Запрос.УстановитьПараметр("ИдентификаторФормуляра", ИдентификаторФормуляра);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.КодВидаСведений = 1 Тогда
			Результат.ФайлMXL = Выборка.ОсновнойФайлФормуляра;
		ИначеЕсли Выборка.КодВидаСведений = 2 Тогда	
			Результат.ФайлPDF = Выборка.ОсновнойФайлФормуляра;
		КонецЕсли;	
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьСведенияПредставленияВнутреннегоЭДВФайл(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД, РеквизитыДокумента, Шаблон, ИдентификаторЭтапа, ФайлФормируетПользователь = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ДатаФормирования = ТекущаяДатаСеанса();
	
	ФайлПредставленияФормуляраПервичногоДокумента = ФайлПредставленияФормуляраПервичногоДокументаПОД(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД, 
		ИдентификаторЭтапа, РеквизитыДокумента, ДатаФормирования, ФайлФормируетПользователь);
	
	Если ТипЗнч(ФайлПредставленияФормуляраПервичногоДокумента) = Тип("Массив") Тогда
		
		Для каждого СведениеЭД Из СведенияПредставленияВнутреннегоЭД Цикл
			ЗаписатьПредставленияФормуляраПервичногоДокумента(ДатаФормирования, ИдентификаторЭтапа, РеквизитыДокумента, 
				СведениеЭД, ФайлПредставленияФормуляраПервичногоДокумента[СведенияПредставленияВнутреннегоЭД.Найти(СведениеЭД)]);
		КонецЦикла;
		
	Иначе
	
		ЗаписатьПредставленияФормуляраПервичногоДокумента(ДатаФормирования, ИдентификаторЭтапа, РеквизитыДокумента, 
			СведенияПредставленияВнутреннегоЭД, ФайлПредставленияФормуляраПервичногоДокумента);
	
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура УдалитьСохраненныеФормулярыЭДПоЭтапу(Задача)

	УстановитьПривилегированныйРежим(Истина);

	ИдентификаторЭтапа = Задача.ИдентификаторЭтапа;
	Предмет = Задача.Предмет;
	Исполнитель = Задача.Исполнитель;
	
	НаборЗаписейПриложения = РегистрыСведений.ФайлыФормуляровЭДПОД.СоздатьНаборЗаписей();
	НаборЗаписейПриложения.Отбор.Предмет.Установить(Предмет);
	НаборЗаписейПриложения.Отбор.ИдентификаторЭтапа.Установить(ИдентификаторЭтапа);
	НаборЗаписейПриложения.Отбор.Исполнитель.Установить(Исполнитель);
	
	НаборЗаписейПриложения.Записать();

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ИдентификаторыЭтаповШаблона(Шаблон)
	ЗапросЭтапов = Новый Запрос;
	ЗапросЭтапов.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                     |	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа КАК ИдентификаторЭтапа
	                     |ИЗ
	                     |	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	                     |ГДЕ
	                     |	ШаблоныПроцессовЭтапы.Ссылка = &Шаблон";
	ЗапросЭтапов.УстановитьПараметр("Шаблон", Шаблон);
	ИдентификаторыЭтапов = ЗапросЭтапов.Выполнить().Выгрузить();
	
	Результат = ИдентификаторыЭтапов.ВыгрузитьКолонку("ИдентификаторЭтапа");

	Возврат Результат;
КонецФункции	

Функция НаименованиеПечатнойФормыПоИдентификаторуПечати(Предмет, Шаблон, ИдентификаторПечати) Экспорт
	Результат = "";
	
	ПроцессыОбработкиДокументовПереопределяемый.НаименованиеПечатнойФормыПоИдентификаторуПечати(Предмет, Шаблон, ИдентификаторПечати, Результат);
	
	Возврат Результат;	
КонецФункции	

Функция НаименованиеПервичногоДокументаПоИдентификаторуПечати(Предмет, Шаблон, ИдентификаторПечати) Экспорт
	Результат = "";
	
	ПроцессыОбработкиДокументовПереопределяемый.НаименованиеПервичногоДокументаПоИдентификаторуПечати(Предмет, Шаблон, ИдентификаторПечати, Результат);
	
	Возврат Результат;	
КонецФункции	

Функция СведенияПредставленияВнутреннегоЭД(ИдентификаторФормуляра, Предмет, Шаблон, ИдентификаторПечати, НаименованиеПечатнойФормыДокумента, НаименованиеДокумента, ДатаДокумента, НомерДокумента, Расширение, ВыводитьШтампы) Экспорт
	
	СоответствиеКодаВидаСведений = Новый Соответствие;
	Результат = Новый Структура;
	КодВидаСведений = 0;
	
	Если ТипЗнч(Расширение) = Тип("Массив") Тогда
		ТипФайлаТабДок = Новый Массив;
		
		Для Каждого Элемент Из Расширение Цикл
			
			Если Элемент = "MXL" Тогда
				ТипФайлаТабДок.Добавить(ТипФайлаТабличногоДокумента.MXL);
				КодВидаСведений = 1;
				СоответствиеКодаВидаСведений.Вставить(Элемент, КодВидаСведений);
			ИначеЕсли Элемент = "PDF" Тогда
				ТипФайлаТабДок.Добавить(ТипФайлаТабличногоДокумента.PDF_A_3);
				КодВидаСведений = 2;
				СоответствиеКодаВидаСведений.Вставить(Элемент, КодВидаСведений);
			КонецЕсли;	
			
		КонецЦикла;
	Иначе
		Если Расширение = "MXL" Тогда
			ТипФайлаТабДок = ТипФайлаТабличногоДокумента.MXL;
			КодВидаСведений = 1;
		ИначеЕсли Расширение = "PDF" Тогда
			ТипФайлаТабДок = ТипФайлаТабличногоДокумента.PDF_A_3;
			КодВидаСведений = 2;
		КонецЕсли;	
	КонецЕсли;
	
	Результат.Вставить("ИдентификаторФормуляра", ИдентификаторФормуляра);
	
	Если КодВидаСведений = 0 Тогда
		Результат.Вставить("Предмет", Предмет);
		Результат.Вставить("ИдентификаторПечати", ИдентификаторПечати);
		Результат.Вставить("Расширение", Расширение);
		Результат.Вставить("ДвоичныеДанныеФайла", Неопределено);
		Результат.Вставить("КодВидаСведений", КодВидаСведений);
		Результат.Вставить("НаименованиеПечатнойФормыДокумента", НаименованиеПечатнойФормыДокумента);
		Результат.Вставить("НаименованиеДокумента", НаименованиеДокумента);
		Результат.Вставить("НомерДокумента", НомерДокумента);
		Результат.Вставить("ДатаДокумента", ДатаДокумента);
	Возврат Результат;
		
	КонецЕсли;	
	
	ДвоичныеДанные = ДвоичныеДанныеПредставленияДокументаПОД(Предмет, ИдентификаторПечати, ТипФайлаТабДок, ВыводитьШтампы);
	
	Если ТипЗнч(ДвоичныеДанные) = Тип("Массив") Тогда 
		РезультатМассив = Новый Массив;
		Для Каждого Элемент Из Расширение Цикл
			Индекс = Расширение.Найти(Элемент);
			Результат = Новый Структура;
			Результат.Вставить("Предмет", Предмет);
			Результат.Вставить("ИдентификаторПечати", ИдентификаторПечати);
			Результат.Вставить("ИдентификаторФормуляра", ИдентификаторФормуляра);
			Результат.Вставить("Расширение", Элемент);
			Результат.Вставить("ДвоичныеДанныеФайла", ДвоичныеДанные[Индекс]);
			Результат.Вставить("КодВидаСведений", СоответствиеКодаВидаСведений.Получить(Элемент));
			Результат.Вставить("НаименованиеПечатнойФормыДокумента", НаименованиеПечатнойФормыДокумента);
			Результат.Вставить("НаименованиеДокумента", НаименованиеДокумента);
			Результат.Вставить("НомерДокумента", НомерДокумента);
			Результат.Вставить("ДатаДокумента", ДатаДокумента);
			
			РезультатМассив.Добавить(Результат);
		КонецЦикла;
		
		Возврат РезультатМассив;
	Иначе       
		Результат = Новый Структура;
		Результат.Вставить("Предмет", Предмет);
		Результат.Вставить("ИдентификаторПечати", ИдентификаторПечати);
		Результат.Вставить("Расширение", Расширение);
		Результат.Вставить("ДвоичныеДанныеФайла", ДвоичныеДанные);
		Результат.Вставить("КодВидаСведений", КодВидаСведений);
		Результат.Вставить("НаименованиеПечатнойФормыДокумента", НаименованиеПечатнойФормыДокумента);
		Результат.Вставить("НаименованиеДокумента", НаименованиеДокумента);
		Результат.Вставить("НомерДокумента", НомерДокумента);
		Результат.Вставить("ДатаДокумента", ДатаДокумента);
	КонецЕсли;	
		
	Возврат Результат;
КонецФункции

Функция ДвоичныеДанныеПредставленияДокументаПОД(ОбъектУчета, ИдентификаторКомандыПечати, Формат, ВыводитьШтампыЭлектронныхПодписейПриПечати) Экспорт
	ДвоичныеДанныеРезультатаПечати = Неопределено;
	ПроцессыОбработкиДокументовПереопределяемый.РезультатПечатиПредставленияДокумента(ОбъектУчета, ИдентификаторКомандыПечати, Формат, 
		ВыводитьШтампыЭлектронныхПодписейПриПечати, ДвоичныеДанныеРезультатаПечати);
	Если ЗначениеЗаполнено(ДвоичныеДанныеРезультатаПечати) Тогда
		Возврат ДвоичныеДанныеРезультатаПечати;
	КонецЕсли;
	
 	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");

	МетаданныеОбъекта = ОбъектУчета.Метаданные();
	
	ПолноеИмяФормы = МетаданныеОбъекта.ОсновнаяФормаОбъекта.Имя;
	СписокОбъектов = Новый Массив();
	СписокОбъектов.Добавить(МетаданныеОбъекта);
	
	КомандыПечати = МодульУправлениеПечатью.КомандыПечатиФормы(ПолноеИмяФормы, СписокОбъектов);
	НайденнаяКоманда = Неопределено;
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		Если КомандаПечати.Идентификатор = ИдентификаторКомандыПечати Тогда
			  НайденнаяКоманда = КомандаПечати;
			  Прервать;
		  ИначеЕсли КомандаПечати.МенеджерПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки"
			  И ИдентификаторКомандыПечати = КомандаПечати.Идентификатор + КомандаПечати.УникальныйИдентификатор Тогда
			НайденнаяКоманда = КомандаПечати;
			прервать;
		КонецЕсли;	
		
	КонецЦикла;

	Если НайденнаяКоманда = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КомандаПечатиВФайл = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяКоманда);

	Если НЕ ВыводитьШтампыЭлектронныхПодписейПриПечати Тогда
		КомандаПечатиВФайл.ДополнительныеПараметры.Вставить("ИсключитьШтампы");
	КонецЕсли;	
	
	МассивОбъектовУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектУчета);
	
	НастройкиСохранения = МодульУправлениеПечатью.НастройкиСохранения();
	Если ТипЗнч(Формат) = Тип("Массив") Тогда
		 Для Каждого Элемент Из Формат Цикл
		НастройкиСохранения.ФорматыСохранения.Добавить(Элемент); 
		КонецЦикла;
	Иначе	
		НастройкиСохранения.ФорматыСохранения.Добавить(Формат);
	КонецЕсли;
	
	РезультатПечати = Неопределено;
	Попытка
		РезультатПечати = МодульУправлениеПечатью.НапечататьВФайл(КомандаПечатиВФайл, МассивОбъектовУчета, НастройкиСохранения);
	Исключение
		ТекстСообщения  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось сформировать на сервере печатную форму ""%1"" " +
			"для формуляра документа ""%2"".'"), НайденнаяКоманда, ОбъектУчета);
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецПопытки;
	
	Если РезультатПечати.Количество() = 1 Тогда
		Если ЗначениеЗаполнено(РезультатПечати) Тогда
			Возврат РезультатПечати[0].ДвоичныеДанные;
		КонецЕсли;
	ИначеЕсли РезультатПечати.Количество() > 1 Тогда
		 Возврат РезультатПечати.ВыгрузитьКолонку("ДвоичныеДанные");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ФормулярЭтапаВыполняемогоНесколькимиИсполнителями(Шаблон, ИдентификаторЭтапа)
	Результат = Ложь;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныПроцессовЭтапы.ЭтапВыполняетсяНесколькимиИсполнителями КАК ЭтапВыполняетсяНесколькимиИсполнителями
	               |ИЗ
	               |	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	               |ГДЕ
	               |	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = &ИдентификаторЭтапа
	               |	И ШаблоныПроцессовЭтапы.Ссылка = &Шаблон";
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЭтапВыполняетсяНесколькимиИсполнителями;
	КонецЕсли;	

	Возврат Результат;
КонецФункции	

Функция СписокКодовНастроекПечатныхФормФормуляровЭтапа(Шаблон, ИдентификаторЭтапа)
	Результат = Новый Структура;
