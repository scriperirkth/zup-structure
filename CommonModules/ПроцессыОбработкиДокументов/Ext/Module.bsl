Процедура СформироватьПредставлениеФормуляровЭДДляДокументовПрошлыхПериодов(Параметры, АдресВХранилище) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВыводитьШтампы = Истина;
	НастройкиФормированияФормуляров = НастройкиФормированияФайловПредставленийФормуляровДокументовПрошлыхПериодов();
	
	ТаблицаШаблоновИПечатныхФорм = Новый ТаблицаЗначений;
	ТаблицаШаблоновИПечатныхФорм.Колонки.Добавить("Шаблон", Новый ОписаниеТипов("СправочникСсылка.ШаблоныПроцессов"));
	ТаблицаШаблоновИПечатныхФорм.Колонки.Добавить("ИдентификаторПечатнойФормы", Новый ОписаниеТипов("Строка"));
	Для Каждого ТекСтрока Из НастройкиФормированияФормуляров Цикл
		ИдентификаторыКомандПечатиСоШтампом = СтрРазделить(ТекСтрока.ИдентификаторыПечатныхФорм, ",");
		Для Каждого ТекПФ Из ИдентификаторыКомандПечатиСоШтампом Цикл
			НоваяСтрока = ТаблицаШаблоновИПечатныхФорм.Добавить();
			НоваяСтрока.Шаблон = ТекСтрока.Шаблон;
			НоваяСтрока.ИдентификаторПечатнойФормы = ТекПФ;
		КонецЦикла;	
	КонецЦикла;	
	
    //Формирование представлений ЭД
	РеквизитыДокумента = Новый Структура;
	РеквизитыДокумента.Вставить("Организация", "");
	РеквизитыДокумента.Вставить("Дата", Дата(1,1,1));
	РеквизитыДокумента.Вставить("Номер", "");
	
	ВыполняемаяЗадача = Неопределено;
	ИдентификаторЭтапа = Неопределено;
	
	Выборка = РезультатыЗапросаДокументовДляОбработкиДокументовПрошлыхПериодов();
	
	Пока Выборка.Следующий() Цикл
		Предмет = Выборка.Предмет;
		Шаблон = Выборка.Шаблон;

		ПроцессыОбработкиДокументовПереопределяемый.ЗаполнитьРеквизитыДокументаУчета(Предмет, РеквизитыДокумента);
		
		ДатаДокумента = РеквизитыДокумента.Дата;
		НомерДокумента = РеквизитыДокумента.Номер;

		Отбор = Новый Структура("Шаблон", Шаблон);
		МассивИдентификаторовПФШаблона = ТаблицаШаблоновИПечатныхФорм.НайтиСтроки(Отбор);
		Для Каждого ТекПФ Из МассивИдентификаторовПФШаблона Цикл
			ИдентификаторПечати = ТекПФ.ИдентификаторПечатнойФормы;
			ИдентификаторФормуляра = Строка(Новый УникальныйИдентификатор);
			
			НаименованиеДокумента = НаименованиеПервичногоДокументаПоИдентификаторуПечати(Предмет, Шаблон, ИдентификаторПечати);
			НаименованиеПечатнойФормыДокумента = НаименованиеПечатнойФормыПоИдентификаторуПечати(Предмет, Шаблон, ИдентификаторПечати);
			
			Расширение = Новый Массив;
			Расширение.Добавить("PDF");
			Расширение.Добавить("MXL");

			СведенияПредставленияВнутреннегоЭД = СведенияПредставленияВнутреннегоЭД(ИдентификаторФормуляра, Предмет, Шаблон, ИдентификаторПечати, 
				НаименованиеПечатнойФормыДокумента, НаименованиеДокумента, ДатаДокумента, НомерДокумента, Расширение, ВыводитьШтампы);
			
			ЗаписатьСведенияПредставленияВнутреннегоЭДВФайл(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД, 
				РеквизитыДокумента, Шаблон, ИдентификаторЭтапа);
			
		КонецЦикла;
	КонецЦикла;	

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаполнитьСписокДокументовУчетаДляФормированияПредставленияФормуляровЭДДляДокументовПрошлыхПериодов(Параметры, АдресВХранилище) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписейСпискаДокументовДляОбработки = РегистрыСведений.ПредметыДляФормированияФайловПредставленийФормуляровПОД.СоздатьНаборЗаписей();
	НаборЗаписейСпискаДокументовДляОбработки.Записать();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТекущиеСтатусыДокументов.Предмет КАК Предмет,
	|	ТекущиеСтатусыДокументов.Статус КАК Статус,
	|	ТекущиеСтатусыДокументов.Шаблон КАК Шаблон,
	|	ТИПЗНАЧЕНИЯ(ТекущиеСтатусыДокументов.Предмет) КАК ТипДокумента
	|ПОМЕСТИТЬ ВсеПроцессы
	|ИЗ
	|	РегистрСведений.ТекущиеСтатусыДокументов КАК ТекущиеСтатусыДокументов
	|ГДЕ
	|	ТекущиеСтатусыДокументов.ДатаУстановки МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ТекущиеСтатусыДокументов.Предмет.Проведен = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеПроцессы.Предмет КАК Предмет,
	|	ВсеПроцессы.Статус КАК Статус,
	|	ВсеПроцессы.Шаблон КАК Шаблон,
	|	ВЫБОР
	|		КОГДА ПодписанныеФормулярыЭДПОД.Подписан ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьФормуляр,
	|	ВЫБОР
	|		КОГДА ПредставлениеФормуляраПервичногоДокументаПОД.Предмет ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьПредставление
	|ПОМЕСТИТЬ РезультатыОтбора
	|ИЗ
	|	ВсеПроцессы КАК ВсеПроцессы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодписанныеФормулярыЭДПОД КАК ПодписанныеФормулярыЭДПОД
	|		ПО ВсеПроцессы.Предмет = ПодписанныеФормулярыЭДПОД.Предмет
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПредставлениеФормуляраПервичногоДокументаПОД КАК ПредставлениеФормуляраПервичногоДокументаПОД
	|		ПО ВсеПроцессы.Предмет = ПредставлениеФормуляраПервичногоДокументаПОД.Предмет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РезультатыОтбора.Предмет КАК Предмет,
	|	РезультатыОтбора.Статус КАК Статус,
	|	РезультатыОтбора.Шаблон КАК Шаблон
	|ПОМЕСТИТЬ ПредметыБезФормуляраИПредставления
	|ИЗ
	|	РезультатыОтбора КАК РезультатыОтбора
	|ГДЕ
	|	РезультатыОтбора.ЕстьФормуляр = ЛОЖЬ
	|	И РезультатыОтбора.ЕстьПредставление = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПредметыБезФормуляраИПредставления.Предмет КАК Предмет,
	|	ПредметыБезФормуляраИПредставления.Шаблон КАК Шаблон
	|ИЗ
	|	ПредметыБезФормуляраИПредставления КАК ПредметыБезФормуляраИПредставления";
	
	Если НЕ Параметры.ФормироватьТолькоДляПроведенныхДокументовУчета Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекущиеСтатусыДокументов.Предмет.Проведен = ИСТИНА", "ИСТИНА");
	КонецЕсли;	

	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Параметры.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Параметры.КонецПериода));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяЗапись = РегистрыСведений.ПредметыДляФормированияФайловПредставленийФормуляровПОД.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
		НоваяЗапись.Записать(Ложь);
	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура УстановитьОтметкуОПодписанииФормуляра(ВыполняемаяЗадача, ДанныеПодписания, УсиленнаяПодпись)
	
	ТипЭлектроннойПодписи = 1;
	Если УсиленнаяПодпись Тогда
		ТипЭлектроннойПодписи = 2;
	КонецЕсли;
	
	КодВидаСведений = 1;
	Если ДанныеПодписания.ФорматПервичногоДокумента = "PDF" Тогда
		КодВидаСведений = 2;
	КонецЕсли;
	
	ДатаПодписи = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(ДанныеПодписания.СвойстваПодписи) Тогда
		ДатаПодписи = ДанныеПодписания.СвойстваПодписи.ДатаПодписи;
	КонецЕсли;
	
	РеквизитыДокумента = Новый Структура;
	ПроцессыОбработкиДокументовПереопределяемый.СтруктураРеквизитовОбъектаУчета(РеквизитыДокумента);

	ПроцессыОбработкиДокументовПереопределяемый.ЗаполнитьРеквизитыДокументаУчета(ДанныеПодписания.Предмет, РеквизитыДокумента);
	
	ДатаДокумента = РеквизитыДокумента.Дата;
	НомерДокумента = РеквизитыДокумента.Номер;
	
	ОписаниеФормуляра = Новый Структура;
	ОписаниеФормуляра.Вставить("Организация", РеквизитыДокумента.Организация);
	ОписаниеФормуляра.Вставить("Предмет", ДанныеПодписания.Предмет);
	ОписаниеФормуляра.Вставить("ИдентификаторПечатнойФормы", ДанныеПодписания.ИдентификаторПечатнойФормы);
	ОписаниеФормуляра.Вставить("ИдентификаторЭтапа", ДанныеПодписания.ИдентификаторЭтапа);
	ОписаниеФормуляра.Вставить("КодВидаСведений", КодВидаСведений);
	ОписаниеФормуляра.Вставить("Формат", ДанныеПодписания.ФорматПервичногоДокумента);
	ОписаниеФормуляра.Вставить("ДатаПодписи", ДатаПодписи);
	ОписаниеФормуляра.Вставить("НаименованиеДокумента", ДанныеПодписания.ВидДокумента);
	ОписаниеФормуляра.Вставить("НомерДокумента", НомерДокумента);
	ОписаниеФормуляра.Вставить("ДатаДокумента", ДатаДокумента);

	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписейПриложения = РегистрыСведений.ПодписанныеФормулярыЭДПОД.СоздатьНаборЗаписей();
	НаборЗаписейПриложения.Отбор.Организация.Установить(ОписаниеФормуляра.Организация);
	НаборЗаписейПриложения.Отбор.Предмет.Установить(ОписаниеФормуляра.Предмет);
	НаборЗаписейПриложения.Отбор.ИдентификаторПечатнойФормы.Установить(ОписаниеФормуляра.ИдентификаторПечатнойФормы);
	НаборЗаписейПриложения.Отбор.ИдентификаторЭтапа.Установить(ОписаниеФормуляра.ИдентификаторЭтапа);
	НаборЗаписейПриложения.Отбор.КодВидаСведений.Установить(ОписаниеФормуляра.КодВидаСведений);
	НаборЗаписейПриложения.Отбор.ВыполняемаяЗадача.Установить(ВыполняемаяЗадача);
	
	ЗаписьПриложение = НаборЗаписейПриложения.Добавить();
	ЗаписьПриложение.Предмет = ОписаниеФормуляра.Предмет;
	ЗаписьПриложение.ИдентификаторПечатнойФормы = ОписаниеФормуляра.ИдентификаторПечатнойФормы;
	ЗаписьПриложение.Организация = ОписаниеФормуляра.Организация;	
	ЗаписьПриложение.КодВидаСведений = ОписаниеФормуляра.КодВидаСведений;
	ЗаписьПриложение.ИдентификаторЭтапа = ОписаниеФормуляра.ИдентификаторЭтапа;
	ЗаписьПриложение.ВыполняемаяЗадача = ВыполняемаяЗадача;
	ЗаписьПриложение.Формат = ОписаниеФормуляра.Формат;
	ЗаписьПриложение.ДатаПодписи = ОписаниеФормуляра.ДатаПодписи;
	ЗаписьПриложение.НаименованиеДокумента = ОписаниеФормуляра.НаименованиеДокумента;
	ЗаписьПриложение.НомерДокумента = ОписаниеФормуляра.НомерДокумента;
	ЗаписьПриложение.ДатаДокумента = ОписаниеФормуляра.ДатаДокумента;
	ЗаписьПриложение.Подписан = Истина;
	ЗаписьПриложение.ТипЭлектроннойПодписи = ТипЭлектроннойПодписи;
	ЗаписьПриложение.ДанныеПредставленияПервичногоДокумента = ДанныеПодписания.Владелец;
	Если ЗначениеЗаполнено(ДанныеПодписания.СвойстваПодписи) Тогда
		ЗаписьПриложение.УстановившийПодпись = ДанныеПодписания.СвойстваПодписи.УстановившийПодпись;
	КонецЕсли;
	
	НаборЗаписейПриложения.Записать();
	
	//Простая подпись для формуляра
	Если ТипЭлектроннойПодписи = 1 Тогда
		СообщениеЖурналаРегистрации = "";
		Реквизиты = "ОсновнойФайл";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПодписания.Владелец, Реквизиты);
 		ДобавитьСтрокуПростойПодписиДляФормуляра(ВыполняемаяЗадача, ЗначенияРеквизитов.ОсновнойФайл, ДанныеПодписания.СвойстваПодписи, СообщениеЖурналаРегистрации);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура СнятьОтметкиОПодписанииФормуляровЭтапа(Задача)

	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписейПриложения = РегистрыСведений.ПодписанныеФормулярыЭДПОД.СоздатьНаборЗаписей();
	НаборЗаписейПриложения.Отбор.Предмет.Установить(Задача.Предмет);
	НаборЗаписейПриложения.Отбор.ИдентификаторЭтапа.Установить(Задача.ИдентификаторЭтапа);
	
	НаборЗаписейПриложения.Записать();

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ОтображатьДатуПодписанияПоОрганизации(Организация = Неопределено) Экспорт
	
	ОтображатьДатуПодписанияВШтампеЭП = Истина;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсключенияОтображенияДатыПодписанияВШтампе.Организация КАК Организация
			|ИЗ
			|	РегистрСведений.ИсключенияОтображенияДатыПодписанияВШтампеКОРП КАК ИсключенияОтображенияДатыПодписанияВШтампе
			|ГДЕ
			|	ИсключенияОтображенияДатыПодписанияВШтампе.Организация = &Организация";
		
		Запрос.УстановитьПараметр("Организация", Организация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ОтображатьДатуПодписанияВШтампеЭП = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОтображатьДатуПодписанияВШтампеЭП;
	
КонецФункции

Функция ЭлектронныеПодписиВнешнегоЭДСвязанногоСВнутреннимЭД(ФормулярЭД) Экспорт

	Результат = Новый ТаблицаЗначений;

	ПроцессыОбработкиДокументовПереопределяемый.ЗаполнитьЭлектронныеПодписиВнешнегоЭДСвязанногоСВнутреннимЭД(ФормулярЭД, Результат);
	
	Возврат Результат;
КонецФункции

#КонецОбласти

Функция ПроверитьЗаданныхИсполнителейЭтапа(ИсполнителиЭтапа)
	
		РезультатПроверки = Новый Массив;
	
	Для Каждого ИсполнительЭтапа Из ИсполнителиЭтапа Цикл
		
		Если ИсполнительЭтапа.НеСоздаватьЗадачу Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсполнительЭтапа.Исполнитель) Тогда
			Продолжить;
		КонецЕсли;
		
		ИсполнителиПоРоли = НайтиИсполнителейПоРоли(ИсполнительЭтапа.РольИсполнителя, ИсполнительЭтапа.ОсновнойОбъектАдресации, ИсполнительЭтапа.ДополнительныйОбъектАдресации);
		
		Если НЕ ЗначениеЗаполнено(ИсполнителиПоРоли) Тогда
			
			ШаблонСообщения = НСтр("ru='""%1""%2%3'");
			ОсновнойОбъектАдресации = ?(ЗначениеЗаполнено(ИсполнительЭтапа.ОсновнойОбъектАдресации), 
			СтрШаблон(НСтр("ru=' для основного объекта адресации ""%1""'"), Строка(ИсполнительЭтапа.ОсновнойОбъектАдресации)),"");
			ДополнительныйОбъектАдресации = ?(ЗначениеЗаполнено(ИсполнительЭтапа.ДополнительныйОбъектАдресации), 
			СтрШаблон(НСтр("ru=' для дополнительного объекта адресации ""%1""'"), Строка(ИсполнительЭтапа.ДополнительныйОбъектАдресации)),"");
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
			Строка(ИсполнительЭтапа.РольИсполнителя), ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации);
			
			РезультатПроверки.Добавить(ТекстСообщения); 
			
			Продолжить;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат РезультатПроверки;
	
КонецФункции

Функция НайтиИсполнителейПоРоли(РольИсполнителя, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации)
	
	НайденныеИсполнители = Неопределено;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнителиЗадач.Исполнитель КАК Исполнитель
		|ИЗ
		|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
		|ГДЕ
		|	ИсполнителиЗадач.РольИсполнителя = &РольИсполнителя
		|	И ИсполнителиЗадач.ОсновнойОбъектАдресации = &ОсновнойОбъектАдресации
		|	И ИсполнителиЗадач.ДополнительныйОбъектАдресации = &ДополнительныйОбъектАдресации";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("РольИсполнителя", РольИсполнителя);
	Запрос.УстановитьПараметр("ОсновнойОбъектАдресации", ?(ЗначениеЗаполнено(ОсновнойОбъектАдресации), ОсновнойОбъектАдресации, Неопределено));
	Запрос.УстановитьПараметр("ДополнительныйОбъектАдресации", ?(ЗначениеЗаполнено(ДополнительныйОбъектАдресации), ДополнительныйОбъектАдресации, Неопределено));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		НайденныеИсполнители = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Исполнитель");
	КонецЕсли;
	
	Возврат НайденныеИсполнители;
	
КонецФункции

// Позволяет определить значение реквизита документа указанного в шаблоне для расчета срока обработки
//
// Параметры:
// 	 	Шаблон - СправочникСсылка.ШаблоныПроцессов - текущий шаблон для задачи
//  	Документ - ДокументСсылка - текущий предмет для задачи 
//
//  Возвращаемое значение  - Дата - Значение реквизита. Если не заполнен реквизит, то возвращает Неопределено.
Функция ОпределитьРеквизитДляПодсчетаРегламента(Знач Шаблон, Знач Документ)
	ЗначениеРеквизитаДляПодсчетаРегламента = Неопределено;
	
	Если Константы.ИспользоватьРеквизитыДокументовДляРасчетаСроковОбработки.Получить() Тогда	
		  Если Не (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шаблон, "ИспользоватьРеквизитДляРасчетаСроковОбработки")) Тогда
			  Возврат Неопределено;
		  КонецЕсли;
		  
		  ИмяРеквизитаДляПодсчетаНорматива = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шаблон, "РеквизитДляРасчетаСроковОбработки");
		  Если Не ЗначениеЗаполнено(ИмяРеквизитаДляПодсчетаНорматива) Тогда
			  Возврат Неопределено;
		  КонецЕсли;
		  
		  ЗначениеРеквизитаДляПодсчетаРегламента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ,
		  																			 		 ИмяРеквизитаДляПодсчетаНорматива);
		  
		  Если ТипЗнч(ЗначениеРеквизитаДляПодсчетаРегламента) <> Тип("Дата") 
			   ИЛИ Не ЗначениеЗаполнено(ЗначениеРеквизитаДляПодсчетаРегламента) Тогда
			  Возврат Неопределено;
		  КонецЕсли;
	КонецЕсли;	  
	  
  Возврат ЗначениеРеквизитаДляПодсчетаРегламента;
  
КонецФункции

// Позволяет определить продолжительность всех последующих этапов для расчета сроков обработки
//
// Параметры:
// 	 	ПорядокЭтапа - Число - текущий порядок для этапа
//  	Шаблон - СправочникСсылка.ШаблоныПроцессов - текущий шаблон для задачи 
//
//  Возвращаемое значение  - Структура - 
//						*Дни  - Число - сумма дней всех последующих этапов.
//						*Часы - Число - сумма часов всех последующих этапов.
Функция ОпределитьПродолжительностьПоследующихЭтаповПоРегламенту(ПорядокЭтапа, Шаблон)
	Результат = Новый Структура;	
	Результат.Вставить("Дни",0);
	Результат.Вставить("Часы",0); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕстьNULL(СУММА(ШаблоныПроцессовЭтапы.СрокиОбработкиПоРеквизитуДни),0) КАК Дни,
	|	ЕстьNULL(СУММА(ШаблоныПроцессовЭтапы.СрокиОбработкиПоРеквизитуЧасы),0) КАК Часы
	|ИЗ
	|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|ГДЕ
	|	ШаблоныПроцессовЭтапы.Ссылка = &Шаблон
	|	И ШаблоныПроцессовЭтапы.Порядок > &ПорядокЭтапа";
	
	Запрос.УстановитьПараметр("ПорядокЭтапа", ПорядокЭтапа);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() тогда
		ВсегоДней = Выборка.Дни;
		ВсегоЧасов = Выборка.Часы;
		
		Если ВсегоЧасов > 24 Тогда
			
			ЧистыхДней = Цел(ВсегоЧасов/24);
			ВсегоЧасов = ВсегоЧасов - ЧистыхДней*24;
			ВсегоДней = ВсегоДней+ЧистыхДней;
			
		КонецЕсли; 
		
		Результат.Вставить("Дни", ВсегоДней);
		Результат.Вставить("Часы", ВсегоЧасов);
		
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции	

// Получает сроки обработки задачи по дате со смещением времени назад .
// 
// Параметры:
//  Объект - ДокументОбъект:
//   * ДатаОтсчета     - Дата - Предельная дата от которой считается срок обработки
//   * КоличествоДней  - Число - Дней для отсчета назад по времени
//   * КоличествоЧасов - Число - Часов для отсчета назад по времени
// 
// Возвращаемое значение:
//  Структура -
//		*СрокОбработки 			  - Дата - Дата предельного срока обработки для этапа
//		*СрокНапоминанияОбработки - Дата - Дата напоминания о приближении срока обработки этапа
Функция СрокиОбработкиИНапоминанияПоРеквизиту(РеквизитыАдресации, ДатаОтсчета, КоличествоДней = 0, КоличествоЧасов = 0)
	
	Результат = Новый Структура;
	Результат.Вставить("СрокОбработки", Дата(1,1,1));
	Результат.Вставить("СрокНапоминанияОбработки", Дата(1,1,1));
	
	СрокНапоминанияМинуты = ?(Константы.НапоминатьОПриближенииСрокаВыполненияЗадач.Получить(), 
								Константы.СрокНапоминанияМинуты.Получить(),
								0);
	
	Если Константы.ИспользоватьГрафикиРаботы.Получить() Тогда
		СтандартнаяОбработка = Истина;
		ГрафикРаботы = ГрафикРаботыИсполнителя(РеквизитыАдресации, СтандартнаяОбработка);
		Если СтандартнаяОбработка И Не ЗначениеЗаполнено(ГрафикРаботы) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Срок выполнения не рассчитан'"));
			Возврат Результат;
		КонецЕсли; 
		
		СрокиОбработки = СрокиОбработкиИНапоминанияПоГрафикуРаботы(ГрафикРаботы, СтандартнаяОбработка,
												ДатаОтсчета, КоличествоДней, КоличествоЧасов, СрокНапоминанияМинуты);
		Результат.СрокОбработки = СрокиОбработки.СрокОбработки;
		Результат.СрокНапоминанияОбработки = СрокиОбработки.СрокНапоминанияОбработки;
					
	Иначе
		
		Результат.СрокОбработки = (ДатаОтсчета -1) - КоличествоДней * 24 * 60 * 60 - КоличествоЧасов * 60 * 60;
		Если СрокНапоминанияМинуты > 0 Тогда
			Результат.СрокНапоминанияОбработки = Результат.СрокОбработки - СрокНапоминанияМинуты * 60;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// Получает количество рабочих часов в дне.
// 
// Параметры:
//  ГрафикРаботы - Произвольный - разрез для учета расписания работы в конфигурации:
//  СтандартнаяОбработка - Булево - Признак учета по по подсистеме "ГрафикиРаботы"
// 
// Возвращаемое значение:
//		Результат - Число - количество рабочих часов в дне
Функция РабочихЧасовВДнеПоГрафикуРаботы(ГрафикРаботы, СтандартнаяОбработка)
	Результат = 24;	
	
	Если СтандартнаяОбработка Тогда
		
		Если ГрафикРаботы <> Неопределено  
			И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ГрафикиРаботы")
		    И РасписаниеРаботыСуществует(ГрафикРаботы, СтандартнаяОбработка)  Тогда
			
			 Результат = ОпределитьКоличествоРабочихЧасовВДне(ГрафикРаботы);
		 КонецЕсли;
	 Иначе
		 
		 ПроцессыОбработкиДокументовПереопределяемый.ПриОпределенииРабочихЧасовВДне(ГрафикРаботы, Результат);
		 
	 КонецЕсли;
	 
	 Возврат Результат;
 КонецФункции
 
 // Проверяет существование расписания работы.
// 
// Параметры:
//  ГрафикРаботы - Произвольный - разрез для учета расписания работы в конфигурации:
//  СтандартнаяОбработка - Булево - Признак учета по подсистеме "ГрафикиРаботы" 
// Возвращаемое значение:
//		Результат - Булево - признак наличия расписания работы в разрезе графиков работы в конфигурации
Функция РасписаниеРаботыСуществует(ГрафикРаботы, СтандартнаяОбработка) 
	Результат = Ложь;	
	
	Если СтандартнаяОбработка Тогда
		
		Если ГрафикРаботы <> Неопределено 
			И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ГрафикиРаботы")
		    И ГрафикРаботы.РасписаниеРаботы.Количество() > 0  Тогда
			
			 Результат = Истина;
			 
		 КонецЕсли;
	 Иначе 
		 
		 РасписаниеРаботы = Новый ТаблицаЗначений;
		 ПроцессыОбработкиДокументовПереопределяемый.ПриПолученииРасписанияРаботы(РасписаниеРаботы); 
		 Если РасписаниеРаботы.Количество() > 0 Тогда
			 Результат = Истина;
		 КонецЕсли;	 
		 
	 КонецЕсли;
	 
	 Возврат Результат;
 КонецФункции
 
// Получает количество рабочих часов в дне по графику работы с учётом подсистемы "ГрафикиРаботы".
// 
// Параметры:
//  ГрафикРаботы - СправочникСсылка.Календари:
// 
// Возвращаемое значение:
//		Результат - Число - количество рабочих часов в дне
Функция ОпределитьКоличествоРабочихЧасовВДне(ГрафикРаботы)
	Результат = 24;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ГрафикРаботы);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Выразить(СУММА(РАЗНОСТЬДАТ(КалендариРасписаниеРаботы.ВремяНачала, КалендариРасписаниеРаботы.ВремяОкончания, ЧАС)) /
		|	Количество(Различные КалендариРасписаниеРаботы.НомерДня) Как Число (3,0))  КАК РабочихЧасовВДне
		|ИЗ
		|	Справочник.Календари.РасписаниеРаботы КАК КалендариРасписаниеРаботы
		|ГДЕ
		|	КалендариРасписаниеРаботы.Ссылка = &Ссылка
		|
		|";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.РабочихЧасовВДне;
	КонецЕсли;
	
	Возврат Результат; 
КонецФункции 
 	
// Создает таблицу ПриращениеДней, в которой для каждого элемента из МассивДней 
// формируется строка с индексом элемента и значением - количеством дней.
// Рассчитывает максимальный сдвиг дней.
// 
// Параметры:
//  МассивДней - Массив из Число - массив дней
//  РассчитыватьСледующуюДатуОтПредыдущей - Булево - рассчитывать следующую дату от предыдущей
// 
// Возвращаемое значение:
//  Структура:
//   * ПриращениеДней - ТаблицаЗначений
//   * Максимум - Число
//
Функция ПриращениеДнейПоГрафикуРаботы(МассивДней, Знач РассчитыватьСледующуюДатуОтПредыдущей = Ложь) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("ПриращениеДней", Новый ТаблицаЗначений);
	Результат.Вставить("Максимум", 0);

	Результат.ПриращениеДней.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
	Результат.ПриращениеДней.Колонки.Добавить("КоличествоДней", Новый ОписаниеТипов("Число"));
	
	КоличествоДней = 0;
	НомерСтроки = 0;
	Для Каждого СтрокаДней Из МассивДней Цикл
		КоличествоДней = КоличествоДней + СтрокаДней;
		Строка = Результат.ПриращениеДней.Добавить();
		Строка.ИндексСтроки = НомерСтроки;
		Строка.КоличествоДней = ?(РассчитыватьСледующуюДатуОтПредыдущей, КоличествоДней, СтрокаДней);
		Результат.Максимум = Макс(Результат.Максимум, Строка.КоличествоДней);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция СрокиОбработкиИНапоминанияПоГрафикуРаботы(ГрафикРаботы, СтандартнаяОбработка, ДатаОтсчета, КоличествоДней = 0,
										КоличествоЧасов = 0, СрокНапоминанияМинуты = 0, РасписаниеРаботы = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("СрокОбработки", Дата(1,1,1));
	Результат.Вставить("СрокНапоминанияОбработки", Дата(1,1,1));
	
	ПредельнаяДатаОтсчета = ?(КоличествоДней = 0 и КоличествоЧасов = 0, ДатаОтсчета-1, ДатаОтсчета);
	ДатаОкончания = ДатаПоГрафикуСрокОбработкиПоРеквизиту(ГрафикРаботы, ПредельнаяДатаОтсчета, КоличествоДней, КоличествоЧасов,
															СтандартнаяОбработка);
	СрокИсполнения = ДатаОкончания;
	ДатаНачала = ДатаОтсчета;

	// TODO: алгоритм расчета количества рабочих часов в дне
	// пока берём из расписания или переопределяемого метода 
	РабочихЧасовВДне = РабочихЧасовВДнеПоГрафикуРаботы(ГрафикРаботы, СтандартнаяОбработка);
	СрокВСекундах = КоличествоДней * РабочихЧасовВДне * 60 * 60 + КоличествоЧасов * 60 * 60; 
	ДляГрафикаУказаноРасписаниеРаботы = РасписаниеРаботыСуществует(ГрафикРаботы, СтандартнаяОбработка);
	
	Если СрокВСекундах = 0 И Не ДляГрафикаУказаноРасписаниеРаботы Тогда
		СрокВСекундах = 0;  
		СрокИсполнения = ДатаОтсчета - 1;
	ИначеЕсли СрокВСекундах = 0 И ДляГрафикаУказаноРасписаниеРаботы Тогда
		СрокВСекундах = 1;
	ИначеЕсли СрокВСекундах > 1 И ДляГрафикаУказаноРасписаниеРаботы Тогда	
		СрокВСекундах = СрокВСекундах + 1;	
	КонецЕсли;
	 
	Пока СрокВСекундах > 0 Цикл
		
		ИнтервалыРабочегоВремени = РасписаниеРаботыНаПериод(ГрафикРаботы, ДатаОкончания, ДатаОтсчета-1,
																			СтандартнаяОбработка, Истина);
		
		Если НЕ ЗначениеЗаполнено(ИнтервалыРабочегоВремени) Тогда
			СрокВСекундах = 0;
			СрокИсполнения = ДатаНачала;
			Прервать;
		КонецЕсли;
		
		Для Каждого Интервал Из ИнтервалыРабочегоВремени Цикл
			
			Если СрокВСекундах = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если СрокВСекундах > Интервал.Длительность Тогда
				СрокВСекундах = СрокВСекундах - Интервал.Длительность;
			Иначе 
				
				СрокИсполнения = Интервал.ДатаОкончания - СрокВСекундах;
 				СрокВСекундах = 0;
			КонецЕсли;
			
		КонецЦикла;
			
		// Расписание работы необходимо передать выше для расчета сроков этапов интервала
		Если РасписаниеРаботы = Неопределено Тогда
			РасписаниеРаботы = ИнтервалыРабочегоВремени.Скопировать();
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ИнтервалыРабочегоВремени, РасписаниеРаботы);
		КонецЕсли;
		
		Если СрокВСекундах = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ДатаНачала = ДатаОкончания; 
		ДатаОкончания = ДатаПоГрафику(ГрафикРаботы, ДатаОкончания, 2, 0, СтандартнаяОбработка);
		ДатаОкончания = КонецДня(ДатаОкончания);
		
	КонецЦикла;

	
	Результат.СрокОбработки = СрокИсполнения;
	
	// Расчет срока напоминания
	СрокВСекундах = СрокНапоминанияМинуты * 60;
	РасписаниеРаботы = РасписаниеРаботыНаПериод(ГрафикРаботы, ДатаОкончания, СрокИсполнения, СтандартнаяОбработка, Ложь);
	Результат.СрокНапоминанияОбработки = ДатаПоГрафикуДоНаступленияСрока(РасписаниеРаботы, ГрафикРаботы, СтандартнаяОбработка, 
																			СрокИсполнения, СрокВСекундах);

	Возврат Результат;
	
КонецФункции

Функция ДатаПоГрафикуСрокОбработкиПоРеквизиту(ГрафикРаботы, ДатаОтсчета, КоличествоДней, КоличествоЧасов, СтандартныйРасчетСроков)

	Если КоличествоДней > 0 Тогда
		Дни = КоличествоДней + Цел(КоличествоЧасов/8) + 1;
	Иначе	 
		// TODO: Расчет количества рабочих часов в дне
		Дни = Цел(КоличествоЧасов/8) + 1;
	КонецЕсли;
	
	Если СтандартныйРасчетСроков Тогда
		
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ГрафикиРаботы") Тогда
			МодульГрафикиРаботы = ОбщегоНазначения.ОбщийМодуль("ГрафикиРаботы");
			УстановитьПривилегированныйРежим(Истина);
			Возврат ДатаПоГрафикуСрокиОбработкиПоРеквизиту(ГрафикРаботы, ДатаОтсчета, Дни, Истина);
		Иначе
			ВызватьИсключение НСтр("ru='Не обнаружена подсистема БСП ""Графики работы""'");
		КонецЕсли;
	Иначе
		Возврат ПроцессыОбработкиДокументовПереопределяемый.ПриОпределенииДатыПоГрафикуРаботы(ГрафикРаботы, ДатаОтсчета, Дни,
																									КоличествоЧасов);
	КонецЕсли;
	
КонецФункции

Функция ДатаПоГрафикуСрокиОбработкиПоРеквизиту(Знач ГрафикРаботы, Знач ДатаОт, Знач КоличествоДней, ВызыватьИсключение = Истина) Экспорт
	
	Если КоличествоДней = 0 Тогда
		Возврат ДатаОт;
	КонецЕсли;
	
	ДатаОт = НачалоДня(ДатаОт);
	
	МассивДней = Новый Массив;
	МассивДней.Добавить(КоличествоДней);
	
	МассивДат = ДатыПоГрафикуСрокиОбработкиПоРеквизиту(ГрафикРаботы, ДатаОт, МассивДней, ВызыватьИсключение);
	
	Возврат ?(МассивДат <> Неопределено, МассивДат[0], Неопределено);
	
КонецФункции

Функция ДатыПоГрафикуСрокиОбработкиПоРеквизиту(Знач ГрафикРаботы, Знач ДатаОт, Знач МассивДней, ВызыватьИсключение = Истина) Экспорт 
																									
	СдвигДней = ПриращениеДнейПоГрафикуРаботы(МассивДней, Ложь);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОт", НачалоДня(ДатаОт));
	Запрос.УстановитьПараметр("ГрафикРаботы", ГрафикРаботы);
	Запрос.УстановитьПараметр("Дни", СдвигДней.ПриращениеДней.ВыгрузитьКолонку("КоличествоДней"));
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	КалендарныеГрафики.ДатаГрафика КАК Дата
	|ИЗ
	|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	|ГДЕ
	|	КалендарныеГрафики.ДатаГрафика < &ДатаОт
	|	И КалендарныеГрафики.Календарь = &ГрафикРаботы
	|	И КалендарныеГрафики.ДеньВключенВГрафик
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата Убыв";

	// Ограничим выборку максимальной величиной сдвига для того, чтобы исключить избыточную выборку дней.
	СхемаЗапроса = Новый СхемаЗапроса();
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	СхемаЗапроса.ПакетЗапросов[0].Операторы[0].КоличествоПолучаемыхЗаписей = СдвигДней.Максимум;
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();

	ЗапрошенныеДни = Новый Соответствие();
	Для Каждого СтрокаТаблицы Из СдвигДней.ПриращениеДней Цикл
		ЗапрошенныеДни.Вставить(СтрокаТаблицы.КоличествоДней, Ложь);
	КонецЦикла;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() < СдвигДней.Максимум Тогда
		Если ВызыватьИсключение Тогда
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'График работы ""%1"" не заполнен с даты %2 на указанное количество рабочих дней.'"), 
			ГрафикРаботы, 
			Формат(ДатаОт, "ДЛФ=D"));
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Дней = 0;
	Пока Выборка.Следующий() Цикл
		Дней = Дней + 1;
		Если ЗапрошенныеДни[Дней] = Ложь Тогда
			ЗапрошенныеДни.Вставить(Дней, Выборка.Дата);
		КонецЕсли;
	КонецЦикла;

	МассивДат = Новый Массив;
	Для Каждого СтрокаТаблицы Из СдвигДней.ПриращениеДней Цикл
		Дата = ЗапрошенныеДни[СтрокаТаблицы.КоличествоДней];
		ОбщегоНазначенияКлиентСервер.Проверить(ТипЗнч(Дата) = Тип("Дата") И ЗначениеЗаполнено(Дата));
		МассивДат.Добавить(Дата);
	КонецЦикла;

	Возврат МассивДат;

КонецФункции   

Функция ПолучитьФайлПодписанныеДанныеПОД(Задача)  
	СсылкаНаФайл = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодписанныеДанныеПОД.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПодписанныеДанныеПОД КАК ПодписанныеДанныеПОД
		|ГДЕ
		|	ПодписанныеДанныеПОД.Задача = &Задача";
	
	Запрос.УстановитьПараметр("Задача", Задача);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СсылкаНаФайл = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат СсылкаНаФайл;
КонецФункции	

Процедура ПроверкаПроведенияПередФормированиемФормуляра(Знач ИдентификаторыДляФормированияФормуляров, Предмет, Этап)
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	МетаданныеОбъекта = Предмет.Метаданные();
	ОшибкиФормированияФормуляров = "";
	КомандыПечати = МодульУправлениеПечатью.КомандыПечатиОбъекта(МетаданныеОбъекта);
	
	Если КомандыПечати.Колонки.Найти("ПроверкаПроведенияПередПечатью") <> Неопределено Тогда 
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Предмет, "Проведен, Представление"); 
		ДокументПроведен =  ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыДокумента, "Проведен", Ложь);
		ПредставлениеДокумента = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыДокумента, "Представление", ""); 
		Для Каждого КодПечатнойФормы Из ИдентификаторыДляФормированияФормуляров Цикл
			
			НайденныеКоманды = КомандыПечати.НайтиСтроки(Новый Структура("Идентификатор", КодПечатнойФормы));
			Для Каждого НайденнаяКоманда Из НайденныеКоманды Цикл
				Если НайденнаяКоманда.ПроверкаПроведенияПередПечатью 
					И Не ДокументПроведен Тогда
					
					ПредставлениеПечатнойФормы = НайденнаяКоманда.Представление;
					
					ШаблонСообщенияОбОшибке = НСтр("ru='- для формирования формуляра первичного документа ""%1"" "+
					"учетный документ ""%2"" должен быть проведен'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщенияОбОшибке,
					ПредставлениеПечатнойФормы, ПредставлениеДокумента);
					ОшибкиФормированияФормуляров = ОшибкиФормированияФормуляров + ТекстОшибки + Символы.ПС;
				КонецЕсли;	
			КонецЦикла
			
		КонецЦикла;
		Если ЗначениеЗаполнено(ОшибкиФормированияФормуляров) Тогда 
			ПредставлениеТекущегоЭтапа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Этап, "Представление");
			
			ШаблонСообщенияОбОшибке = НСтр("ru='Ошибка при выполнении этапа ""%1"" для документа ""%2"":
			|%3'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщенияОбОшибке, 
			ПредставлениеТекущегоЭтапа, ПредставлениеДокумента, ОшибкиФормированияФормуляров);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

Процедура ВосстановитьРегламентныйИнтервал(Предмет, РегламентныйИнтервал, НомерИтерации)
	
	Запись = РегистрыСведений.РегламентныеИнтервалыДокументов.СоздатьМенеджерЗаписи();
	Запись.Предмет = Предмет;
	Запись.РегламентныйИнтервал = РегламентныйИнтервал;
	Запись.НомерИтерации = НомерИтерации;
	Запись.Прочитать();
	Если Запись.Выбран() И Запись.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияРегламентныхИнтервалов.Активен") Тогда
		Запись.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияРегламентныхИнтервалов.Активен");
		Запись.ДатаВыполнения = Дата(1,1,1);
		Запись.ОтклонениеОтПлана = 0;
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрерватьРегламентныйИнтервал(Предмет, РегламентныйИнтервал, НомерИтерации)
	
	Запись = РегистрыСведений.РегламентныеИнтервалыДокументов.СоздатьМенеджерЗаписи();
	Запись.Предмет = Предмет;
	Запись.РегламентныйИнтервал = РегламентныйИнтервал;
	Запись.НомерИтерации = НомерИтерации;
	Запись.Прочитать();
	Если Запись.Выбран() И Запись.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияРегламентныхИнтервалов.Активен") Тогда
		Запись.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияРегламентныхИнтервалов.Активен");
		Запись.ДатаВыполнения = Дата(1,1,1);
		Запись.ОтклонениеОтПлана = 0;
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция КомандаПечатиДляВнешнейПечатнойФормы(Знач ИдентификаторыКомандыПечатиШаблона, Знач Документ, Знач ИдентификаторТекущейКомандыПечати) 
	Результат = Ложь;
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");

	МетаданныеОбъекта = Документ.Метаданные();

	ПолноеИмяФормы = МетаданныеОбъекта.ОсновнаяФормаОбъекта.Имя;
	СписокОбъектов = Новый Массив();
	СписокОбъектов.Добавить(МетаданныеОбъекта);

	КомандыПечати = МодульУправлениеПечатью.КомандыПечатиФормы(ПолноеИмяФормы, СписокОбъектов);

	НайденнаяКоманда = Неопределено;
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		Если КомандаПечати.МенеджерПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
			
			Если КомандаПечати.Идентификатор = ИдентификаторТекущейКомандыПечати
				И ИдентификаторыКомандыПечатиШаблона.Найти(ИдентификаторТекущейКомандыПечати + КомандаПечати.УникальныйИдентификатор) <> Неопределено  Тогда
				НайденнаяКоманда = КомандаПечати;
				прервать;  
			КонецЕсли; 
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Если НайденнаяКоманда <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УправлениеРазБлокировкойЭлементовФормы(Форма, Знач БлокируемыеЭлементы, Знач НевидимыеЭлементы, Знач ЭлементыСОтметкойНезаполненного)
	
	// Разблокировка редактирования элементов формы, доступных на текущем этапе и недоступных на прошлом.
	РеквизитФормыПроцесса = "ПроцессыОбработкиДокументов_ЗаблокированныеЭлементы";
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, РеквизитФормыПроцесса) Тогда
		ЗаблокированныеЭлементыПрошлогоЭтапа = СтрРазделить(Форма[РеквизитФормыПроцесса], ";", Ложь);
		
		Если ЗаблокированныеЭлементыПрошлогоЭтапа.Количество() > 0 Тогда 
			РазБлокируемыеЭлементы = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ЗаблокированныеЭлементыПрошлогоЭтапа, 
				БлокируемыеЭлементы);
			Если РазБлокируемыеЭлементы.Количество() > 0 Тогда
				УправлениеБлокировкойЭлементовФормы(Форма, РазБлокируемыеЭлементы, Ложь);
			КонецЕсли; 
		КонецЕсли;
		
		Форма[РеквизитФормыПроцесса] = СтрСоединить(БлокируемыеЭлементы, ";");
		
	КонецЕсли; 
	
	// Изменение видимости элементов формы, доступных на текущем этапе и недоступных на прошлом.
	РеквизитФормыПроцесса = "ПроцессыОбработкиДокументов_НевидимыеЭлементы";
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, РеквизитФормыПроцесса) Тогда 
		НевидимыеЭлементыПрошлогоЭтапа = СтрРазделить(Форма[РеквизитФормыПроцесса], ";", Ложь);;
		
		Если НевидимыеЭлементыПрошлогоЭтапа.Количество() > 0 Тогда 
			ВидимыеЭлементы = ОбщегоНазначенияКлиентСервер.РазностьМассивов(НевидимыеЭлементыПрошлогоЭтапа, 
				НевидимыеЭлементы);
			Для Каждого ВидимыйЭлемент Из ВидимыеЭлементы Цикл
				УправлениеВидимостьюЭлементаФормы(Форма, ВидимыйЭлемент, Истина);
			КонецЦикла; 
		КонецЕсли;
		
		Форма[РеквизитФормыПроцесса] = СтрСоединить(НевидимыеЭлементы, ";");;
	КонецЕсли; 
	
	// Изменение отметки незаполненного элементов формы, доступных на текущем этапе и недоступных на прошлом.
	РеквизитФормыПроцесса = "ПроцессыОбработкиДокументов_ЭлементыСОтметкойНезаполненного";
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, РеквизитФормыПроцесса) Тогда 
		ЭлементыСОтметкойНезаполненногоПрошлогоЭтапа = СтрРазделить(Форма[РеквизитФормыПроцесса], ";", Ложь);;
		
		Если ЭлементыСОтметкойНезаполненногоПрошлогоЭтапа.Количество() > 0 Тогда 
			ЭлементыСОтметкой = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ЭлементыСОтметкойНезаполненногоПрошлогоЭтапа,
				ЭлементыСОтметкойНезаполненного);
			Для Каждого ЭлементСОтметкой Из ЭлементыСОтметкой Цикл
				УправлениеОтметкойНезаполенногоЭлементаФормы(Форма, ЭлементСОтметкой, Истина);
			КонецЦикла; 
		КонецЕсли;
		
		Форма[РеквизитФормыПроцесса] = СтрСоединить(ЭлементыСОтметкойНезаполненного, ";");;
	КонецЕсли; 
	
КонецПроцедуры  

Процедура УстановитьСтартовуюСтраницу(Форма, СтраницаПоУмолчанию, СтраницаРодитель) 
	
	ЭлементФормыСтраницаРодитель = Форма.Элементы.Найти(СтраницаРодитель);
	Если ЭлементФормыСтраницаРодитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементФормыСтраницаПоУмолчанию = Форма.Элементы.Найти(СтраницаПоУмолчанию);
	Если ЭлементФормыСтраницаПоУмолчанию = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭлементФормыСтраницаРодитель.Вид = ВидГруппыФормы.Страницы 
		И ЭлементФормыСтраницаПоУмолчанию.Вид = ВидГруппыФормы.Страница Тогда
		ЭлементФормыСтраницаРодитель.ТекущаяСтраница = ЭлементФормыСтраницаПоУмолчанию;
	КонецЕсли;
	
КонецПроцедуры	

Процедура УправлениеВидимостьюЭлементаФормы(Форма, Элемент, Значение) 
	
		ЭлементФормы = Форма.Элементы.Найти(Элемент);
		Если ЭлементФормы = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ЕстьВидимость = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		ЭлементФормы, "Видимость");
		Если Не ЕстьВидимость Тогда
			Возврат;
		КонецЕсли;
		
	    ЭлементФормы.Видимость = Значение;
		
КонецПроцедуры

Процедура УправлениеОтметкойНезаполенногоЭлементаФормы(Форма, Элемент, Значение) 
	
		 ЭлементФормы = Форма.Элементы.Найти(Элемент);
		 Если ЭлементФормы = Неопределено Тогда
			 Возврат;
		 КонецЕсли;
		 
		 ЕстьАвтоОтметкаНезаполненного = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		 ЭлементФормы, "АвтоОтметкаНезаполненного");
		 Если Не ЕстьАвтоОтметкаНезаполненного Тогда
			 Возврат;
		 КонецЕсли;
		 
		 ТипЭлементаФормы = ТипЗнч(ЭлементФормы);

		 Если ТипЭлементаФормы = Тип("ПолеФормы")
			 И ЭлементФормы.Вид = ВидПоляФормы.ПолеВвода
			 И ЕстьАвтоОтметкаНезаполненного Тогда
			 ЭлементФормы.АвтоОтметкаНезаполненного = Значение;
		 КонецЕсли;
 
 КонецПроцедуры   
 
