Функция ШаблонИСтатусДокумента(Документ, БезПроверкиУсловия = Ложь) Экспорт
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
		Ссылка = Документ;
	Иначе
		Ссылка = Документ.Ссылка;
	КонецЕсли;
	
	Если Ссылка.Пустая() Тогда
		
		ВозвращаемаяСтруктура = ШаблонИСтатусНовогоДокумента(Документ, БезПроверкиУсловия);
		
	Иначе
		
		ВозвращаемаяСтруктура = Новый Структура;
		ВозвращаемаяСтруктура.Вставить("Шаблон", Неопределено);
		ВозвращаемаяСтруктура.Вставить("Статус", Неопределено);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТекущиеСтатусыДокументов.Шаблон КАК Шаблон,
		|	ТекущиеСтатусыДокументов.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ТекущиеСтатусыДокументов КАК ТекущиеСтатусыДокументов
		|ГДЕ
		|	ТекущиеСтатусыДокументов.Предмет = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		УстановитьПривилегированныйРежим(Истина);
		Выборка = Запрос.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
		Если Выборка.Следующий() Тогда
			ВозвращаемаяСтруктура.Вставить("Шаблон", Выборка.Шаблон);
			ВозвращаемаяСтруктура.Вставить("Статус", Выборка.Статус);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВозвращаемаяСтруктура;
	
КонецФункции

Функция ШаблонИСтатусНовогоДокумента(Документ, БезПроверкиУсловия) Экспорт
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
		Ссылка = Документ;
	Иначе
		Ссылка = Документ.Ссылка;
	КонецЕсли;
	
	ВозвращаемаяСтруктура = Новый Структура;
	ВозвращаемаяСтруктура.Вставить("Шаблон", Неопределено);
	ВозвращаемаяСтруктура.Вставить("Статус", Неопределено);
	
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовПереопределяемый.ПриОпределенииШаблонаИСтатусаНовогоДокумента(
		Документ, БезПроверкиУсловия, ВозвращаемаяСтруктура, СтандартнаяОбработка);
	
	Если НЕ СтандартнаяОбработка Тогда
		Возврат ВозвращаемаяСтруктура;
	КонецЕсли;
	
	Выборка = ВыборкаИспользуемыхШаблоновДокумента(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Ссылка)));
	
	ПодходящиеШаблоны = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если ДокументПодходитПоУсловию(Документ, Выборка.УсловиеИспользования) Тогда
			ПодходящиеШаблоны.Добавить(Новый Структура("Шаблон, Статус", Выборка.Шаблон, Выборка.Статус));
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПодходящиеШаблоны.Количество() = 1 Тогда
		ВозвращаемаяСтруктура.Вставить("Шаблон", ПодходящиеШаблоны[0].Шаблон);
		ВозвращаемаяСтруктура.Вставить("Статус", ПодходящиеШаблоны[0].Статус);
	ИначеЕсли ПодходящиеШаблоны.Количество() > 1 Тогда
		ВозвращаемаяСтруктура.Вставить("ШаблонНеОпределен", НСтр("ru='Не удалось определить шаблон процесса: обнаружено более одного подходящего шаблона (с учетом условий использования)'"));
	ИначеЕсли Выборка.Количество() > 0 И НЕ Константы.РазрешитьЗаписьДокументаБезШаблона.Получить() Тогда
		ВозвращаемаяСтруктура.Вставить("ШаблонНеОпределен", НСтр("ru='Не удалось определить шаблон процесса: не найдено ни одного подходящего шаблона (с учетом условий использования)'"));
	КонецЕсли;
	
	Возврат ВозвращаемаяСтруктура;
	
КонецФункции

Функция УстановленныеПодписиДляШтампа(Документ, Шаблон, ИдентификаторКомандыПечати = "") Экспорт
	
	ПорядокТекущегоЭтапа = ПорядокТекущегоЭтапаШаблонаПроцесса(Документ, Шаблон);
	
	Если ПорядокТекущегоЭтапа = -1 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
	|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок,
	|	ШаблоныПроцессовЭтапы.ИдентификаторыКомандПечатиСоШтампом КАК ИдентификаторыКомандПечатиСоШтампом
	|ИЗ
	|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ПО ШаблоныПроцессовЭтапы.Ссылка = ЗадачаПоОбработкеДокумента.Шаблон
	|			И ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа
	|			И (ШаблоныПроцессовЭтапы.Ссылка = &Шаблон)
	|			И (ШаблоныПроцессовЭтапы.ВключатьВШтампВизуализацииЭП)
	|			И (ШаблоныПроцессовЭтапы.Порядок <= &Порядок)
	|			И (ЗадачаПоОбработкеДокумента.Предмет = &Документ)
	|			И (ЗадачаПоОбработкеДокумента.ПодписанЭП)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ШаблоныПроцессовЭтапы.Порядок";
	
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Порядок", ПорядокТекущегоЭтапа);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЭлектронныеПодписиРезультат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		ИдентификаторыКомандПечатиСоШтампом = СтрРазделить(Выборка.ИдентификаторыКомандПечатиСоШтампом, ",", Ложь);
		
		Если ИдентификаторыКомандПечатиСоШтампом.Количество() > 0
			 И (ИдентификаторыКомандПечатиСоШтампом.Найти(ИдентификаторКомандыПечати) = Неопределено 
			 И Не КомандаПечатиДляВнешнейПечатнойФормы(ИдентификаторыКомандПечатиСоШтампом, Документ, ИдентификаторКомандыПечати)) Тогда			
			Продолжить;
		КонецЕсли;
		
		ЭлектронныеПодписи = УстановленныеПодписи(Выборка.Ссылка);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЭлектронныеПодписиРезультат, ЭлектронныеПодписи);
		
	КонецЦикла;
	
	ПроцессыОбработкиДокументовПереопределяемый.УстановленныеПодписиДляШтампа(Документ, Шаблон, ИдентификаторКомандыПечати, ЭлектронныеПодписиРезультат);
	
	Возврат ЭлектронныеПодписиРезультат;
	
КонецФункции

Функция ПорядокТекущегоЭтапаШаблонаПроцесса(Документ, Шаблон) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("Документ", Документ);
	
	// Определение текущего этапа обработки документа и его порядка
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО ЗадачаПоОбработкеДокумента.Шаблон = ШаблоныПроцессовЭтапы.Ссылка
	|			И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Шаблон = &Шаблон
	|	И ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|	И НЕ ЗадачаПоОбработкеДокумента.Выполнена";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Порядок;
	Иначе
		// Если по документу нет невыполненных задач, то определим последнюю выполненную задачу
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
		|ИЗ
		|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
		|		ПО ЗадачаПоОбработкеДокумента.Шаблон = ШаблоныПроцессовЭтапы.Ссылка
		|			И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа
		|ГДЕ
		|	ЗадачаПоОбработкеДокумента.Шаблон = &Шаблон
		|	И ЗадачаПоОбработкеДокумента.Предмет = &Документ
		|	И ЗадачаПоОбработкеДокумента.Выполнена
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗадачаПоОбработкеДокумента.ДатаИсполнения УБЫВ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Порядок + 1;
		Конецесли;
		
	КонецЕсли;
	
	Возврат -1;
	
КонецФункции

// Возвращает признак запрета редактирования документа текущим пользователем
//
// Параметры:
//   ДокументСсылка - ОпределяемыйТип.ПредметПроцессаОбработкиДокументов - Ссылка на предмет процесса обработки
//   СообщитьПричинуЗапрета - Булево - признак необходимости вывода сообщения о причинах запрета редактирования документа
//
Функция ЗапрещеноРедактированиеДокумента(ДокументСсылка, СообщитьПричинуЗапрета = Ложь) Экспорт
	
	Шаблон = ШаблонИСтатусДокумента(ДокументСсылка).Шаблон;
	
	Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
		Возврат Ложь;
	ИначеЕсли НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ШаблоныПроцессов) Тогда
		ТекстСообщения = НСтр("ru='Недостаточно прав для получения сведений о процессе обработки документа'");
		Если СообщитьПричинуЗапрета Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(ДокументСсылка, Шаблон, , Истина);
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		ТекстСообщения = НСтр("ru='Редактирование запрещено. '") + ПараметрыТекущегоЭтапа;
		Если СообщитьПричинуЗапрета Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Возврат Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		ТекстСообщения = НСтр("ru='Редактирование запрещено. В данный момент выполняется задача по обработке документа.'");
		Если СообщитьПричинуЗапрета Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Возврат Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая()
		И НЕ ТекущийПользовательМожетБытьИсполнителем(ДокументСсылка, ПараметрыТекущегоЭтапа, Шаблон) Тогда
		ТекстСообщения = НСтр("ru='Недостаточно прав для редактирования.'");
		Если СообщитьПричинуЗапрета Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Возврат Истина;
	ИначеЕсли НЕ Константы.РазрешитьРедактированиеДокументаДоПринятияКИсполнению.Получить()
		И НЕ ПараметрыТекущегоЭтапа.Задача.Пустая()
		И НесколькоПользователейМогутБытьИсполнителями(ДокументСсылка, ПараметрыТекущегоЭтапа) Тогда
		ТекстСообщения = НСтр("ru='Недостаточно прав для редактирования.'");
		Если СообщитьПричинуЗапрета Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ОбновитьТипыДополнительныхКолонок() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеКолонкиСписковЗадач.Ссылка КАК Ссылка,
	|	ДополнительныеКолонкиСписковЗадач.ТипыЗначений КАК ТипыЗначений,
	|	ПутиКЗначениямДополнительныхКолонокЗадач.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ПутиКЗначениямДополнительныхКолонокЗадач.ПутьКЗначению КАК ПутьКЗначению
	|ИЗ
	|	Справочник.ДополнительныеКолонкиСписковЗадач КАК ДополнительныеКолонкиСписковЗадач
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПутиКЗначениямДополнительныхКолонокЗадач КАК ПутиКЗначениямДополнительныхКолонокЗадач
	|		ПО (ПутиКЗначениямДополнительныхКолонокЗадач.Колонка = ДополнительныеКолонкиСписковЗадач.Ссылка)
	|ИТОГИ
	|	КОЛИЧЕСТВО(ИдентификаторДокумента),
	|	КОЛИЧЕСТВО(ПутьКЗначению)
	|ПО
	|	Ссылка";
	
	ВыборкаПоКолонкам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоКолонкам.Следующий() Цикл
		
		Типы = Новый Соответствие;
		
		ВыборкаПоДокументам = ВыборкаПоКолонкам.Выбрать();
		Пока ВыборкаПоДокументам.Следующий() Цикл
			
			МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ВыборкаПоДокументам.ИдентификаторДокумента);
			
			Для Каждого Реквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
				Если Реквизит.Имя = ВыборкаПоДокументам.ПутьКЗначению Тогда
					Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
						Типы.Вставить(Тип);
					КонецЦикла;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Реквизит = МетаданныеДокумента.Реквизиты.Найти(ВыборкаПоДокументам.ПутьКЗначению);
			Если Реквизит <> Неопределено Тогда
				Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
					Типы.Вставить(Тип);
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		МассивТипов = Новый Массив;
		Для Каждого Тип Из Типы Цикл
			МассивТипов.Добавить(ОбщегоНазначения.СтроковоеПредставлениеТипа(Тип.Ключ));
		КонецЦикла;
		
		МассивТиповТекущий = СтрРазделить(ВыборкаПоКолонкам.ТипыЗначений, ",");
		
		Если НЕ ОбщегоНазначенияКлиентСервер.СпискиЗначенийИдентичны(МассивТипов, МассивТиповТекущий) Тогда
			КолонкаОбъект = ВыборкаПоКолонкам.Ссылка.ПОлучитьОбъект();
			КолонкаОбъект.ТипыЗначений = СтрСоединить(МассивТипов, ",");
			КолонкаОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПометитьНаУдалениеДанныеПриСверткеИнформационнойБазы(ДатаСвертки, ИмяСобытияЖурналаРегистрации) Экспорт
	
	ТипыПредмета = Метаданные.ОпределяемыеТипы.ПредметПроцессаОбработкиДокументов.Тип.Типы();
	
	Шаблон = "ВЫБРАТЬ Таблица.Ссылка %1 ИЗ %2 КАК Таблица ГДЕ Таблица.ПометкаУдаления И Таблица.Дата <= &ДатаСвертки";
	ЧастьПервогоЗапроса = "КАК Ссылка ПОМЕСТИТЬ ВТ_Предметы";
	
	СписокПодзапросов = Новый Массив;
	Для Каждого ТипПредмета Из ТипыПредмета Цикл
		ИмяТипа = Метаданные.НайтиПоТипу(ТипПредмета).ПолноеИмя();
		Подзапрос = СтрШаблон(Шаблон, ЧастьПервогоЗапроса, ИмяТипа);
		СписокПодзапросов.Добавить(Подзапрос);
		ЧастьПервогоЗапроса = "";
	КонецЦикла;
	
	ОкончаниеЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.Предмет КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ПредметыВРегистрах
	|ИЗ
	|	РегистрСведений.УдалитьИсторияСтатусовДокументов КАК Таблица
	|ГДЕ
	|	Таблица.Предмет В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка
	|			ИЗ
	|				ВТ_Предметы КАК ВТ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таблица.Предмет
	|ИЗ
	|	РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК Таблица
	|ГДЕ
	|	Таблица.Предмет В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка
	|			ИЗ
	|				ВТ_Предметы КАК ВТ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таблица.Предмет
	|ИЗ
	|	РегистрСведений.ТекущиеСтатусыДокументов КАК Таблица
	|ГДЕ
	|	Таблица.Предмет В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка
	|			ИЗ
	|				ВТ_Предметы КАК ВТ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таблица.Предмет
	|ИЗ
	|	РегистрСведений.ИсполнителиГрупповогоЭтапа КАК Таблица
	|ГДЕ
	|	Таблица.Предмет В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка
	|			ИЗ
	|				ВТ_Предметы КАК ВТ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_ПредметыВРегистрах КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК Таблица
	|ГДЕ
	|	Таблица.Предмет В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка
	|			ИЗ
	|				ВТ_Предметы КАК ВТ)
	|	И НЕ Таблица.ПометкаУдаления";
	
	ТекстЗапроса = СтрСоединить(СписокПодзапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
		+ ";" + Символы.ПС + ОкончаниеЗапроса;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаСвертки", ДатаСвертки);
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	Выборка = ПакетЗапросов[ПакетЗапросов.ВГраница()-1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.УдалитьИсторияСтатусовДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предмет.Установить(Выборка.Ссылка);
		ОтключитьМеханизмыОбъекта(НаборЗаписей);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.ИсторияИзмененияСтатусовДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предмет.Установить(Выборка.Ссылка);
		ОтключитьМеханизмыОбъекта(НаборЗаписей);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.ТекущиеСтатусыДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предмет.Установить(Выборка.Ссылка);
		ОтключитьМеханизмыОбъекта(НаборЗаписей);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.ИсполнителиГрупповогоЭтапа.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предмет.Установить(Выборка.Ссылка);
		ОтключитьМеханизмыОбъекта(НаборЗаписей);
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
	Выборка = ПакетЗапросов[ПакетЗапросов.ВГраница()].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ТекОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ТекОбъект.ПометкаУдаления = Истина;
		ОтключитьМеханизмыОбъекта(ТекОбъект);
		ТекОбъект.Записать();
	КонецЦикла;
	
	Сообщение = НСтр("ru = 'Помечено на удаление задач по обработке документов: %1 шт.'");
	Комментарий = СтрШаблон(Сообщение, Формат(Выборка.Количество(), "ЧН=0"));
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации, УровеньЖурналаРегистрации.Информация,,, Комментарий);
	
КонецПроцедуры

Функция ПакетЗапросовПоИмеющимсяПервичнымДокументам(Документ, ИдентификаторПечатнойФормы, Шаблон, ИдентификаторЭтапа) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПервичныеДокументыПОД.ПервичныйДокумент КАК ПервичныйДокумент
	|ИЗ
	|	РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
	|		ПО ПервичныеДокументыПОД.ПервичныйДокумент = ПрисоединенныеФайлыПодписанныеЗадачами.Файл
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапыПрошедшие
	|		ПО (ШаблоныПроцессовЭтапыПрошедшие.Ссылка = &Шаблон)
	|			И (ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа = ШаблоныПроцессовЭтапыПрошедшие.ИдентификаторЭтапа)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапыТекущий
	|		ПО (ШаблоныПроцессовЭтапыТекущий.Ссылка = &Шаблон)
	|			И (ШаблоныПроцессовЭтапыТекущий.ИдентификаторЭтапа = &ИдентификаторЭтапа)
	|ГДЕ
	|	ПервичныеДокументыПОД.Предмет = &Предмет
	|	И ПервичныеДокументыПОД.ИдентификаторПечатнойФормы = &ИдентификаторПечатнойФормы
	|	И ПервичныеДокументыПОД.Формат = ""mxl""
	|	И ШаблоныПроцессовЭтапыПрошедшие.Порядок <= ШаблоныПроцессовЭтапыТекущий.Порядок
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПрисоединенныеФайлыПодписанныеЗадачами.ДатаПодписи УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПервичныеДокументыПОД.ПервичныйДокумент КАК ПервичныйДокумент
	|ИЗ
	|	РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
	|		ПО ПервичныеДокументыПОД.ПервичныйДокумент = ПрисоединенныеФайлыПодписанныеЗадачами.Файл
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапыПрошедшие
	|		ПО (ШаблоныПроцессовЭтапыПрошедшие.Ссылка = &Шаблон)
	|			И (ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа = ШаблоныПроцессовЭтапыПрошедшие.ИдентификаторЭтапа)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапыТекущий
	|		ПО (ШаблоныПроцессовЭтапыТекущий.Ссылка = &Шаблон)
	|			И (ШаблоныПроцессовЭтапыТекущий.ИдентификаторЭтапа = &ИдентификаторЭтапа)
	|ГДЕ
	|	ПервичныеДокументыПОД.Предмет = &Предмет
	|	И ПервичныеДокументыПОД.ИдентификаторПечатнойФормы = &ИдентификаторПечатнойФормы
	|	И ПервичныеДокументыПОД.Формат = ""pdf""
	|	И ШаблоныПроцессовЭтапыПрошедшие.Порядок <= ШаблоныПроцессовЭтапыТекущий.Порядок
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПрисоединенныеФайлыПодписанныеЗадачами.ДатаПодписи УБЫВ";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	Запрос.УстановитьПараметр("ИдентификаторПечатнойФормы", ИдентификаторПечатнойФормы);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

Функция ВыводитьШтампыЭлектронныхПодписейПриПечати(Документ, ИдентификаторКомандыПечати, Шаблон=Неопределено,
	СообщитьОНаличииПервичногоДокумента=Ложь) Экспорт
	
	Если Шаблон = Неопределено Тогда
		Шаблон = ШаблонИСтатусДокумента(Документ).Шаблон;
	КонецЕсли;
	
	ПорядокТекущегоЭтапа = ПорядокТекущегоЭтапаШаблонаПроцесса(Документ, Шаблон);
	
	Если ПорядокТекущегоЭтапа = -1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// логика проверки: если в шаблоне процесса настроено подписание печатных форм и есть задачи с ЭП
	// и хотя бы одна из этих задач НЕ подписала первичный документ, значит она была выполнена до появления
	// функционала с подписанием первичных документов, значит ндо вывести штампы ЭП по команде "Печать"
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
	|	ШаблоныПроцессовЭтапы.ИдентификаторыКомандПечатиСоШтампом КАК ИдентификаторыКомандПечатиСоШтампом,
	|	ВЫБОР
	|		КОГДА ПервичныеДокументыПОД.ПервичныйДокумент ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьПодписанныйПервичныйДокумент
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО (ШаблоныПроцессовЭтапы.Ссылка = ЗадачаПоОбработкеДокумента.Шаблон)
	|			И (ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа)
	|			И (ШаблоныПроцессовЭтапы.Ссылка = &Шаблон)
	|			И (ШаблоныПроцессовЭтапы.ВключатьВШтампВизуализацииЭП)
	|			И (ШаблоныПроцессовЭтапы.Порядок <= &Порядок)
	|			И (ЗадачаПоОбработкеДокумента.Предмет = &Документ)
	|			И (ЗадачаПоОбработкеДокумента.ПодписанЭП)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
	|		ПО ЗадачаПоОбработкеДокумента.Ссылка = ПрисоединенныеФайлыПодписанныеЗадачами.Задача
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
	|		ПО (ПрисоединенныеФайлыПодписанныеЗадачами.Файл = ПервичныеДокументыПОД.ПервичныйДокумент)
	|			И ЗадачаПоОбработкеДокумента.Предмет = ПервичныеДокументыПОД.Предмет";
	
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Порядок", ПорядокТекущегоЭтапа);
	Запрос.УстановитьПараметр("ИдентификаторКомандыПечати", ИдентификаторКомандыПечати);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ЕстьПодписанныйПервичныйДокумент = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		ИдентификаторыКомандПечатиСоШтампом = СтрРазделить(Выборка.ИдентификаторыКомандПечатиСоШтампом, ",", Ложь);
		
		// Если задача должна была подписать все печатные формы, то штампы надо вывести
		Если ИдентификаторыКомандПечатиСоШтампом.Количество() = 0 Тогда
			Возврат Истина;
		КонецЕсли;
		
		// Если задача должна была подписать текущую печатную форму, то штампы надо вывести
		Если ИдентификаторыКомандПечатиСоШтампом.Найти(ИдентификаторКомандыПечати) <> Неопределено 
			ИЛИ КомандаПечатиДляВнешнейПечатнойФормы(ИдентификаторыКомандПечатиСоШтампом, Документ, ИдентификаторКомандыПечати) Тогда
			 Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьПодписанныйПервичныйДокумент И СообщитьОНаличииПервичногоДокумента Тогда
		ТекстСообщения = НСтр("ru = 'Просмотр подписанного электронного документа возможен из карточки процесса по документу (закладка ""Первичные документы"")'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает двоичные данные визуализации актуального первичного документа
//
// Параметры:
//   Документ - ОпределяемыйТип.ПредметПроцессаОбработкиДокументов - Ссылка на предмет процесса обработки
//	 СведенияОФормуляреПервичногоДокумента - Соответствие, содержащее сведения о формулярах первичного ЭД в разрезе ИдентификаторПечатнойФормы
//   ИдентификаторПечатнойФормы - Строка - Идентификатор команды печати, соответствующей первичному документу
//   Формат - ТипФайлаТабличногоДокумента - Формат, в котором надо сохранить табличный документ
//
Функция ДвоичныеДанныеВизуализацииТекущегоПервичногоДокумента(Документ, СведенияОФормулярахПервичногоДокумента, ИдентификаторПечатнойФормы, Формат) Экспорт
	
	Если Не ЗначениеЗаполнено(СведенияОФормулярахПервичногоДокумента) 
			ИЛИ ТипЗнч(СведенияОФормулярахПервичногоДокумента) <> Тип("Соответствие") Тогда
		 СведенияОФормулярахПервичногоДокумента = ПолучитьПредставлениеФормуляровПервичногоДокумента(Документ);
	КонецЕсли;	
		
	ТабличныйДокумент = ВизуализацияТекущегоПервичногоДокумента(Документ, ИдентификаторПечатнойФормы, СведенияОФормулярахПервичногоДокумента.Получить(ИдентификаторПечатнойФормы));
	
	Возврат ТабличныйДокументВДвоичныеДанные(ТабличныйДокумент, Формат);
	
КонецФункции

#Область УстаревшиеПроцедурыИФункции

// Устарела. Следует использовать
//   ПроцессыОбработкиДокументов.ИзменитьИсториюСтатусовДокумента()
// И ПроцессыОбработкиДокументов.УстановитьТекущийСтатусДокумента().
//
Процедура УстановитьСтатусДокумента(Документ, Шаблон, Статус, Знач Установил, Период = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период) Тогда 
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Установил) Тогда
		Установил = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	// история
	МенеджерЗаписи = РегистрыСведений.ИсторияИзмененияСтатусовДокументов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Предмет = Документ;
	МенеджерЗаписи.Установил = Установил;
	МенеджерЗаписи.Статус = Статус;
	МенеджерЗаписи.ДатаУстановки = Период;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи.Записать(Ложь);
	
	// текущий статус устанавливается, если нет активных невыполненных задач (c заполненным конечным статусом)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|		ПО ЗадачаПоОбработкеДокумента.Этап = ЭтапыПроцессовРезультатыВыполнения.Ссылка
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|	И НЕ ЗадачаПоОбработкеДокумента.Выполнена
	|	И НЕ ЗадачаПоОбработкеДокумента.ПометкаУдаления
	|	И НЕ ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = ЗНАЧЕНИЕ(Справочник.СтатусыДокументов.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Документ", Документ);
	Если Запрос.Выполнить().Пустой() Тогда
		МенеджерЗаписи = РегистрыСведений.ТекущиеСтатусыДокументов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Предмет 			= Документ;
		МенеджерЗаписи.Статус 			= Статус;
		МенеджерЗаписи.Шаблон 			= Шаблон;
		МенеджерЗаписи.Установил 		= Установил;
		МенеджерЗаписи.ДатаУстановки 	= Период;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

//  Устарела. Следует использовать ПроцессыОбработкиДокументов.ДокументПодходитПоУсловию
// Процедура копирует отбор компоновки данных в условие запроса.
//
Процедура СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, ОтборСписка, ЭлементыОтбора, ПервоеУсловие, НомерПараметра=1, ВидУсловия = "И") Экспорт
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			Если ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ Тогда
				ТипГруппы = "ИЛИ";
			Иначе
				ТипГруппы = "И";
			КонецЕсли;
			
			Если НЕ ПервоеУсловие Тогда
				ОтборСписка = ОтборСписка + Символы.ПС + ВидУсловия + " ";
			КонецЕсли;
			ПервоеУсловие = Ложь;
			Если ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда 
				ОтборСписка = ОтборСписка + "НЕ (";
			Иначе
				ОтборСписка = ОтборСписка + "(";
			КонецЕсли;
			СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, ОтборСписка, ЭлементОтбора.Элементы, Истина, НомерПараметра, ТипГруппы);
			ОтборСписка = ОтборСписка + ")";
		Иначе
			Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено 
				ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
			
			Иначе
				
				Если НЕ ПервоеУсловие Тогда
					ОтборСписка = ОтборСписка + Символы.ПС + ВидУсловия + " ";
				КонецЕсли;
				ПервоеУсловие = Ложь;
				
				Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" В (&П"+НомерПараметра+")";
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
					ОтборСписка = ОтборСписка + "НЕ ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" В (&П"+НомерПараметра+")";
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" = &П"+НомерПараметра;
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" <> &П"+НомерПараметра;
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии
					ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" В ИЕРАРХИИ (&П"+НомерПараметра+")";
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии
					ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
					ОтборСписка = ОтборСписка + "НЕ ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" В ИЕРАРХИИ (&П"+НомерПараметра+")";
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" > &П"+НомерПараметра;
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" >= &П"+НомерПараметра;
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" < &П"+НомерПараметра;
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" <= &П"+НомерПараметра;
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" ПОДОБНО &П"+НомерПараметра+" СПЕЦСИМВОЛ ""/""";
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
					ОтборСписка = ОтборСписка + "НЕ ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" ПОДОБНО &П"+НомерПараметра+" СПЕЦСИМВОЛ ""/""";
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС Тогда
					ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" ПОДОБНО &П"+НомерПараметра+" СПЕЦСИМВОЛ ""/""";
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда
					ОтборСписка = ОтборСписка + "НЕ ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" ПОДОБНО &П"+НомерПараметра+" СПЕЦСИМВОЛ ""/""";
				КонецЕсли;
				Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
					Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
					ЗначениеПараметра = "%"+ЭлементОтбора.ПравоеЗначение+"%";
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС
					Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда 
					ЗначениеПараметра = ЭлементОтбора.ПравоеЗначение+"%";
				ИначеЕсли ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СтандартнаяДатаНачала") Тогда
					ЗначениеПараметра = ЭлементОтбора.ПравоеЗначение.Дата;
				Иначе
					ЗначениеПараметра = ЭлементОтбора.ПравоеЗначение;
				КонецЕсли;
				Запрос.УстановитьПараметр("П"+НомерПараметра, ЗначениеПараметра);
				НомерПараметра = НомерПараметра+1;
				
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьИдентификаторыПредшественниковПоИдентификатору(Шаблон, ИдентификаторЭтапа)
	
	ИдентификаторыПредшественников = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа КАК ИдентификаторПредшественника,
		|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок,
		|	ЕСТЬNULL(ШаблоныПроцессовПредшественникиЭтапов.ИдентификаторПоследователя, НЕОПРЕДЕЛЕНО) КАК ИдентификаторПоследователя
		|ИЗ
		|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.ПредшественникиЭтапов КАК ШаблоныПроцессовПредшественникиЭтапов
		|		ПО ШаблоныПроцессовЭтапы.Ссылка = ШаблоныПроцессовПредшественникиЭтапов.Ссылка
		|			И ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = ШаблоныПроцессовПредшественникиЭтапов.ИдентификаторПредшественника
		|ГДЕ
		|	ШаблоныПроцессовЭтапы.Ссылка = &Шаблон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
		|ИЗ
		|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
		|ГДЕ
		|	ШаблоныПроцессовЭтапы.Ссылка = &Шаблон
		|	И ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	
	ТаблицаИдентификаторов = Новый ТаблицаЗначений;
	ТаблицаИдентификаторов.Колонки.Добавить("ИдентификаторПредшественника");
	ТаблицаИдентификаторов.Колонки.Добавить("Порядок");
	ТаблицаИдентификаторов.Колонки.Добавить("ИдентификаторПоследователя");
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаИдентификаторов = РезультатыЗапроса[0].Выгрузить();
	
	СтартовыйПорядок = 0;
	Если НЕ РезультатыЗапроса[1].Пустой() Тогда
		Выборка = РезультатыЗапроса[1].Выбрать();
		Если Выборка.Следующий() Тогда
			СтартовыйПорядок = Выборка.Порядок;
		КонецЕсли;
	КонецЕсли;
	
	ПолучитьПредшественниковПоЦепочке(ТаблицаИдентификаторов, ИдентификаторЭтапа, СтартовыйПорядок, ИдентификаторыПредшественников);
	
	Возврат ИдентификаторыПредшественников;
	
КонецФункции

Функция ПолучитьИдентификаторыПредшественниковОбъекта(ШаблонОбъект, ИдентификаторЭтапа)
	
	ТаблицаЭтапы = ШаблонОбъект.Этапы.Выгрузить();
	ТаблицаПредшественникиЭтапов = ШаблонОбъект.ПредшественникиЭтапов.Выгрузить();
	
	ИдентификаторыПредшественников = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа); 
	Запрос.УстановитьПараметр("ВТ_Этапы", ТаблицаЭтапы);
	Запрос.УстановитьПараметр("ВТ_ПредшественникиЭтапов", ТаблицаПредшественникиЭтапов);

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
		|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
		|ПОМЕСТИТЬ ВТ_ЭтапыШаблонов
		|ИЗ
		|	&ВТ_Этапы КАК ШаблоныПроцессовЭтапы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПредшественникиЭтапов.ИдентификаторПоследователя КАК ИдентификаторПоследователя,
		|	ПредшественникиЭтапов.ИдентификаторПредшественника КАК ИдентификаторПредшественника
		|ПОМЕСТИТЬ ВТ_ПредшественникиЭтапов
		|ИЗ
		|	&ВТ_ПредшественникиЭтапов КАК ПредшественникиЭтапов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа КАК ИдентификаторПредшественника,
		|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок,
		|	ЕСТЬNULL(ШаблоныПроцессовПредшественникиЭтапов.ИдентификаторПоследователя, НЕОПРЕДЕЛЕНО) КАК ИдентификаторПоследователя
		|ИЗ
		|	ВТ_ЭтапыШаблонов КАК ШаблоныПроцессовЭтапы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПредшественникиЭтапов КАК ШаблоныПроцессовПредшественникиЭтапов
		|		ПО ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = ШаблоныПроцессовПредшественникиЭтапов.ИдентификаторПредшественника
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
		|ИЗ
		|	ВТ_ЭтапыШаблонов КАК ШаблоныПроцессовЭтапы
		|ГДЕ
		|	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
		
	ТаблицаИдентификаторов = Новый ТаблицаЗначений;
	ТаблицаИдентификаторов.Колонки.Добавить("ИдентификаторПредшественника");
	ТаблицаИдентификаторов.Колонки.Добавить("Порядок");
	ТаблицаИдентификаторов.Колонки.Добавить("ИдентификаторПоследователя");
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаИдентификаторов = РезультатыЗапроса[2].Выгрузить();
	
	СтартовыйПорядок = 0;
	Если НЕ РезультатыЗапроса[3].Пустой() Тогда
		Выборка = РезультатыЗапроса[3].Выбрать();
		Если Выборка.Следующий() Тогда
			СтартовыйПорядок = Выборка.Порядок;
		КонецЕсли;
	КонецЕсли;
	
	ПолучитьПредшественниковПоЦепочке(ТаблицаИдентификаторов, ИдентификаторЭтапа, СтартовыйПорядок, ИдентификаторыПредшественников);
	
	Возврат ИдентификаторыПредшественников;
	
КонецФункции

Процедура ПолучитьПредшественниковПоЦепочке(ТаблицаИдентификаторов, ИдентификаторЭтапа, Порядок, ИдентификаторыПредшественников)
	
	Отбор = Новый Структура();
	Отбор.Вставить("ИдентификаторПоследователя",ИдентификаторЭтапа);
	
	НайденныеСтроки = ТаблицаИдентификаторов.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Для Каждого Строка Из НайденныеСтроки Цикл
			Если Строка.Порядок < Порядок Тогда
				ИдентификаторПредшественника = Строка.ИдентификаторПредшественника;
				ИдентификаторыПредшественников.Добавить(ИдентификаторПредшественника);
				ПолучитьПредшественниковПоЦепочке(ТаблицаИдентификаторов, ИдентификаторПредшественника, Строка.Порядок, ИдентификаторыПредшественников);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция МЧДПодписи(ПодписанныйОбъект, ИдентификаторПодписи) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("НомерДоверенности", "");
	Результат.Вставить("МашиночитаемаяДоверенность", Неопределено);
	Результат.Вставить("Представление", "");
	Результат.Вставить("ДатаВыдачи", Дата(1,1,1));
	Результат.Вставить("ДатаОкончания", Дата(1,1,1));
	
	УстановитьПривилегированныйРежим(Истина);
	
	МодульМашиночитаемыеДоверенностиФНССлужебный = ОбщегоНазначения.ОбщийМодуль("МашиночитаемыеДоверенностиФНССлужебный");

	ВыборкаМЧД = МодульМашиночитаемыеДоверенностиФНССлужебный.МЧДПодписей(ПодписанныйОбъект, ИдентификаторПодписи);
	НомерДоверенности = "";
	Если ЗначениеЗаполнено(ВыборкаМЧД) Тогда
		Если ВыборкаМЧД.Следующий() Тогда
			МашиночитаемаяДоверенность = ВыборкаМЧД.МашиночитаемаяДоверенность;
			Реквизиты = "НомерДоверенности, ДатаВыдачи, ДатаОкончания";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МашиночитаемаяДоверенность, Реквизиты);
			Если ЗначениеЗаполнено(МашиночитаемаяДоверенность) Тогда
				НомерДоверенности = ЗначенияРеквизитов.НомерДоверенности;
			КонецЕсли;	
			
			Результат.НомерДоверенности = НомерДоверенности;
			Результат.МашиночитаемаяДоверенность = МашиночитаемаяДоверенность;
			Результат.Представление = ВыборкаМЧД.Представление;
			Результат.ДатаВыдачи = ЗначенияРеквизитов.ДатаВыдачи;
			Результат.ДатаОкончания = ЗначенияРеквизитов.ДатаОкончания;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции

// Возвращает структуру, содержащую имена недоступных для редактирования реквизитов
//
// Параметры:
//   Шаблон - ссылка на шаблон процесса обработки
//   ИДЭтапа - Строка - Идентификатор этапа, для которого выполняется проверка доступности
//
Функция ИменаНедоступныхДляРедактированияРеквизитов(Шаблон, ИДЭтапа) Экспорт
	
	Результат = Новый Структура;
	Для Каждого ИмяРеквизита Из НедоступныеДляРедактированияРеквизиты(Шаблон, ИДЭтапа) Цикл
		Результат.Вставить(СтрЗаменить(ИмяРеквизита, ".", "__"));
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

//Определяет исключения при определении недоступных команд для табличных частей на форме документа учета
//
// Параметры:
//  Форма - УправляемаяФорма - Открываемая форма объекта процесса обработки документов
//
//  НедоступныеРеквизиты - Массив - перечень недоступных реквизитов, полученный из шаблона процесса для текущего этапа, вида:
//       * [ИмяТабличнойЧасти].[ИмяРеквизита] - Строка - Имя табличной части и реквизита, если ИмяТабличнойЧасти не заполнено,
//                                                       то только элемент содержит только [ИмяРеквизита] (без точки)
//
//  ЗонаОтветственности - ТаблицаЗначений - перечень имен данных в зоне ответственности текущего этапа, колонки:
//       * ИмяТабличнойЧасти - Строка - Идентификатор табличной части (коллекции), которой принадлежит реквизит
//       * ИмяРеквизита - Строка - Идентификатор реквизита
//
//  БлокируемыеЭлементы - Массив - коллекция имен реквизитов формы, которые будут недоступны для редактирования
//
Процедура ЗаблокироватьЭлементыКоманднйПанелиТабличнойЧасти(Форма, Знач НедоступныеРеквизиты, БлокируемыеЭлементы, Знач ЭлементФормы, Знач ИмяРеквизита)  Экспорт

КонецПроцедуры

// Функция - Поместить подписанные данные в присоединенный файл
//
// Параметры:
//  Задача				 - Ссылка.ЗадачаПоОбработкеДокументов - текущая задача 
//  ДвоичныеДанные		 - ДвоичныеДанные -  подписанные данные XML
//  ПрисоединенныйФайл	 - Ссылка.ПодписанныеДанныеПОДПрисоединенныеФайлы - ссылка на присоединенный файл
// 
// Возвращаемое значение:
//   -Ссылка.ПодписанныеДанныеПОД - ссылка на подписанные файл 
//
Функция ПоместитьПодписанныеДанныеВПрисоединенныйФайл(Задача, ДвоичныеДанные, ПрисоединенныйФайл = Неопределено) Экспорт
	Владелец = Неопределено;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Владелец;
	КонецЕсли;
	
	ПредставлениеЗадачи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Задача, "Представление");
	ИмяБезРасширения = СтрЗаменить(ПредставлениеЗадачи, " ", "_");
	ИмяБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяБезРасширения, "_");
	
	Расширение = "XML";
	АдресФайлаВХранилище	= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	ПараметрыФайла = Новый Структура; 
	ПараметрыФайла.Вставить("АдресФайлаВоВременномХранилище", АдресФайлаВХранилище);
	ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());	
	ПараметрыФайла.Вставить("ИмяБезРасширения", ИмяБезРасширения);
	ПараметрыФайла.Вставить("РасширениеБезТочки", Расширение);
	ПараметрыФайла.Вставить("ВремяИзменения", Неопределено);
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", Неопределено);
	ПараметрыФайла.Вставить("Служебный", Истина); 
	
	ПодписанныеДанныеФайл = ПолучитьФайлПодписанныеДанныеПОД(Задача);
	
	Если ЗначениеЗаполнено(ПодписанныеДанныеФайл) Тогда
		
		Владелец = ПодписанныеДанныеФайл; 
		ПараметрыФайла.Вставить("ВладелецФайлов", Владелец); 
		
		ФайлПомеченНаУдаление = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПодписанныеДанныеФайл, "ПометкаУдаления");
		Если ФайлПомеченНаУдаление Тогда
			ПодписанныеДанныеОбъект = ПодписанныеДанныеФайл.ПолучитьОбъект();
			ПодписанныеДанныеОбъект.УстановитьПометкуУдаления(Ложь);
			ПодписанныеДанныеОбъект.Записать();
		КонецЕсли;
		
		ПрисоединенныеФайлы = Новый Массив; 
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(Владелец, ПрисоединенныеФайлы);
		
		Если ПрисоединенныеФайлы.Количество() > 0 И ЗначениеЗаполнено(ПрисоединенныеФайлы[0]) Тогда
			ПараметрыФайла.Вставить("АдресВременногоХранилищаТекста", "");
			РаботаСФайлами.ОбновитьФайл(ПрисоединенныеФайлы[0], ПараметрыФайла);
			ПрисоединенныйФайл = ПрисоединенныеФайлы[0];
		Иначе
			ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаВХранилище);
		КонецЕсли;
		
	Иначе 
		
		НоваяЗапись = Справочники.ПодписанныеДанныеПОД.СоздатьЭлемент();
		НоваяЗапись.Наименование = ИмяБезРасширения;
		НоваяЗапись.Задача = Задача;
		НоваяЗапись.Записать(); 
		
		Владелец = НоваяЗапись.Ссылка;
		ПараметрыФайла.Вставить("ВладелецФайлов", Владелец);
		
		ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаВХранилище);
		
	КонецЕсли;
	
	Возврат Владелец;
	
КонецФункции

Функция НастройкиУправленияСвойствамиЭлементовСогласноЭтапу(Шаблон, ИДЭтапа) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИДЭтапа);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УправлениеЭлементамиФормы.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	УправлениеЭлементамиФормы.ИмяЭлемента КАК ИмяЭлемента,
	|	УправлениеЭлементамиФормы.ЗапретДоступности КАК ЗапретДоступности,
	|	УправлениеЭлементамиФормы.ЗапретВидимости КАК ЗапретВидимости,
	|	УправлениеЭлементамиФормы.ОтметкаНезаполненного КАК ОтметкаНезаполненного,
	|	УправлениеЭлементамиФормы.СтартоваяСтраница КАК СтартоваяСтраница
	|ИЗ
	|	Справочник.ШаблоныПроцессов.УправлениеЭлементамиФормы КАК УправлениеЭлементамиФормы
	|ГДЕ
	|	УправлениеЭлементамиФормы.Ссылка = &Шаблон
	|	И УправлениеЭлементамиФормы.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДобавитьФункцииПредопределенныхУсловий(Знач ОписаниеФункций, Знач ПараметрыНастройки, СхемаКомпоновки)
	
	ВидНастройкиФункцийУсловий = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыНастройки, "ВидНастройкиФункцийУсловий", "");
	
	Для Каждого ФункцияУсловия Из ОписаниеФункций Цикл
		
		НеИспользоватьВНастройкахИспользования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ФункцияУсловия, "ИсключитьИзНастроекИспользования", Ложь);
		Если ВидНастройкиФункцийУсловий = "НастройкиИспользования" 
			И НеИспользоватьВНастройкахИспользования Тогда
			Продолжить;
		КонецЕсли;
		
		НеИспользоватьВНастройкахУсловийПерехода = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ФункцияУсловия, "ИсключитьИзУсловийПерехода", Ложь);
		Если ВидНастройкиФункцийУсловий = "НастройкиУсловийПерехода"
			И НеИспользоватьВНастройкахУсловийПерехода Тогда
			Продолжить;
		КонецЕсли;
		
		ДоступныеОбъектыДляФункции = СтрРазделить(ФункцияУсловия.ОбъектыМетаданных, Символы.ПС, Ложь);
		Если ДоступныеОбъектыДляФункции.Найти("Документ." + ПараметрыНастройки.ИдентификаторДокумента.Имя) <> Неопределено Тогда
			ШаблонПредставления = НСтр("ru = 'Функция [%1]'");; 
			ПредставлениеФункции = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПредставления, ФункцияУсловия.Представление);
			
			ОбщийМодульВВыражении = Метаданные.ОбщиеМодули.Найти(ФункцияУсловия.Выражение) <> Неопределено; 
			ВыражениеФункции = ?(ОбщийМодульВВыражении, 
			ФункцияУсловия.Выражение +"." + ФункцияУсловия.Идентификатор + "()",
			ФункцияУсловия.Выражение + "()");						
			
			ВычисляемоеПоле = СхемаКомпоновки.ВычисляемыеПоля.Добавить();
			ВычисляемоеПоле.ПутьКДанным = ФункцияУсловия.Идентификатор;
			ВычисляемоеПоле.Заголовок = ПредставлениеФункции;
			ВычисляемоеПоле.Выражение = ВыражениеФункции;
			ВычисляемоеПоле.ТипЗначения = Новый ОписаниеТипов("Булево");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры  

Функция ОписаниеФункцийПредопределенныхУсловий() Экспорт

	ФункцииУсловий = Новый Массив;
	
	ПроцессыОбработкиДокументовПереопределяемый.ОписаниеФункцийПредопределенныхУсловий(ФункцииУсловий);

	Возврат ФункцииУсловий;
	
КонецФункции

