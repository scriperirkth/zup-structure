Функция УсловиеПереходаВыполнено(ИдентификаторЭтапа, УсловиеРассмотрения, УсловиеПерехода,
	Документ, Предшественники = Неопределено, ЛюбаяЗадача = Ложь)
	
	Результат = Ложь;
	
	НовыеПредшественники = Новый Массив;
	
	АктуальныйНомерИтерации = Неопределено;
	
	// условие проверяется по результату последней выполненной задачи по этапу,
	// при этом не должно быть активных (невыполненных) задач по этому же этапу.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
	|	ЗадачаПоОбработкеДокумента.Выполнена КАК Выполнена,
	|	ИсторияИзмененияСтатусовДокументов.Статус КАК Статус,
	|	ИсполнителиГрупповогоЭтапа.НомерИтерации КАК НомерИтерации
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов
	|		ПО ЗадачаПоОбработкеДокумента.Предмет = ИсторияИзмененияСтатусовДокументов.Предмет
	|			И ЗадачаПоОбработкеДокумента.Ссылка = ИсторияИзмененияСтатусовДокументов.Установил
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиГрупповогоЭтапа КАК ИсполнителиГрупповогоЭтапа
	|		ПО ЗадачаПоОбработкеДокумента.Предмет = ИсполнителиГрупповогоЭтапа.Предмет
	|			И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = ИсполнителиГрупповогоЭтапа.ИдентификаторЭтапа
	|			И ИсполнителиГрупповогоЭтапа.Задача = ЗадачаПоОбработкеДокумента.Ссылка
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|	И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = &ИдентификаторЭтапа
	|	И НЕ ЗадачаПоОбработкеДокумента.Прервана
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗадачаПоОбработкеДокумента.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		
		// При смене номера итерации - прерывание проверки
		Если АктуальныйНомерИтерации <> Неопределено И АктуальныйНомерИтерации <> Выборка.НомерИтерации Тогда
			Прервать;
		КонецЕсли;
		
		Если НЕ Выборка.Выполнена Тогда
			Результат = Ложь;
		ИначеЕсли ЗначениеЗаполнено(УсловиеРассмотрения) Тогда
			Результат = Выборка.Статус = УсловиеРассмотрения;
		Иначе
			Результат = Истина;
		КонецЕсли;
		
		Если Результат Тогда
			НовыеПредшественники.Добавить(Выборка.Ссылка);
		КонецЕсли;
		
		// Если это не групповая задача - ответ уже получен
		Если Выборка.НомерИтерации = NULL Тогда
			Прервать;
		КонецЕсли;
		
		// В режиме "любая", если в групповом этапе хотя бы одна задача подходит, - прерывание проверки
		Если Результат И ЛюбаяЗадача Тогда
			Прервать;
		КонецЕсли;
		
		// В режиме "все", если в групповом этапе хотя бы одна задача не подходит, - прерывание проверки
		Если Не Результат И НЕ ЛюбаяЗадача Тогда
			Прервать;
		КонецЕсли;
		
		Если АктуальныйНомерИтерации = Неопределено Тогда
			АктуальныйНомерИтерации = Выборка.НомерИтерации;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Результат И ДокументПодходитПоУсловию(Документ, УсловиеПерехода);
	
	Если Результат И Предшественники <> Неопределено Тогда
		Для Каждого Предшественник Из НовыеПредшественники Цикл
			Предшественники.Добавить(Предшественник);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПользовательЯвляетсяОднимИзИсполнителейРоли(ПользовательСсылка, РольСсылка, ОсновнойОбъектАдресации = Неопределено,
	ДополнительныйОбъектАдресации = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
	|ГДЕ
	|	ИсполнителиЗадач.Исполнитель = &Исполнитель
	|	И ИсполнителиЗадач.РольИсполнителя = &РольИсполнителя";
	Если ОсновнойОбъектАдресации <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст 
			+ "	И ИсполнителиЗадач.ОсновнойОбъектАдресации = &ОсновнойОбъектАдресации";
		Запрос.Параметры.Вставить("ОсновнойОбъектАдресации",
			?(ЗначениеЗаполнено(ОсновнойОбъектАдресации),ОсновнойОбъектАдресации, Неопределено));
	КонецЕсли;
	Если ДополнительныйОбъектАдресации <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст 
			+ "	И ИсполнителиЗадач.ДополнительныйОбъектАдресации = &ДополнительныйОбъектАдресации";
		Запрос.Параметры.Вставить("ДополнительныйОбъектАдресации",
			?(ЗначениеЗаполнено(ДополнительныйОбъектАдресации),ДополнительныйОбъектАдресации, Неопределено));
	КонецЕсли;
	
	Запрос.Параметры.Вставить("Исполнитель", ПользовательСсылка);
	Запрос.Параметры.Вставить("РольИсполнителя", РольСсылка);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ПользовательЯвляетсяНеЕдинственнымИсполнителемРоли(ПользовательСсылка, РольСсылка,
	ОсновнойОбъектАдресации = Неопределено, ДополнительныйОбъектАдресации = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
	|ГДЕ
	|	ИсполнителиЗадач.Исполнитель <> &Исполнитель
	|	И ИсполнителиЗадач.РольИсполнителя = &РольИсполнителя";
	Если ОсновнойОбъектАдресации <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст 
			+ "	И ИсполнителиЗадач.ОсновнойОбъектАдресации = &ОсновнойОбъектАдресации";
		Запрос.Параметры.Вставить("ОсновнойОбъектАдресации", ОсновнойОбъектАдресации);
	КонецЕсли;
	Если ДополнительныйОбъектАдресации <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст 
			+ "	И ИсполнителиЗадач.ДополнительныйОбъектАдресации = &ДополнительныйОбъектАдресации";
		Запрос.Параметры.Вставить("ДополнительныйОбъектАдресации", ДополнительныйОбъектАдресации);
	КонецЕсли;
	
	Запрос.Параметры.Вставить("Исполнитель", ПользовательСсылка);
	Запрос.Параметры.Вставить("РольИсполнителя", РольСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Процедура ПриСозданииНаСервереФормыНовогоДокумента(Форма, Источник, СтандартнаяОбработка)
	
	ИмяТипаОтчетаБРО = "ДокументСсылка.РегламентированныйОтчет";
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированнаяОтчетность")
		И ТипЗнч(Источник) = Тип(ИмяТипаОтчетаБРО) Тогда
		
		МодульРегламентированнаяОтчетностьВызовСервера = ОбщегоНазначения.ОбщийМодуль("РегламентированнаяОтчетностьВызовСервера");
		
		ИсточникОтчета = МодульРегламентированнаяОтчетностьВызовСервера.ИсточникОтчета(Форма.ИмяФормы);
		
		Источник = Новый Структура("Ссылка, ИсточникОтчета", Источник, ИсточникОтчета);
		
	КонецЕсли;
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриСозданииНаСервереФормыНовогоДокумента(Форма, Источник, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура СтруктуруВЗаписьXML(Структура, ЗаписьXML)
	
	Для Каждого КлючЗначение Из Структура Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлючЗначение.Ключ);
			СтруктуруВЗаписьXML(КлючЗначение.Значение, ЗаписьXML);
			ЗаписьXML.ЗаписатьКонецЭлемента();
		ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлючЗначение.Ключ);
			Если КлючЗначение.Значение.ВГраница() = -1 Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("СтрокаТабличнойЧасти");
				ЗаписьXML.ЗаписатьКонецЭлемента();
			Иначе
				Для Каждого ЭлементМассива Из КлючЗначение.Значение Цикл
					ЗаписьXML.ЗаписатьНачалоЭлемента("СтрокаТабличнойЧасти");
					СтруктуруВЗаписьXML(ЭлементМассива, ЗаписьXML);
					ЗаписьXML.ЗаписатьКонецЭлемента();
				КонецЦикла;
			КонецЕсли;
			ЗаписьXML.ЗаписатьКонецЭлемента();
		Иначе
			ЗаписатьЭлемент(ЗаписьXML, КлючЗначение.Ключ, КлючЗначение.Значение)
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицуЗначенийВЗаписьXML(Таблицы, Таблица, КорневойЭлемент, ЗаписьXML)
	
	ТипТаблицаЗначений = Новый ОписаниеТипов("ТаблицаЗначений");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Не КорневойЭлемент Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("СтрокаТабличнойЧасти");
		КонецЕсли;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если Колонка.ТипЗначения = ТипТаблицаЗначений Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента(Колонка.Имя);
				ТаблицуЗначенийВЗаписьXML(Таблицы, Таблицы[Колонка.Имя], Ложь, ЗаписьXML);
				ЗаписьXML.ЗаписатьКонецЭлемента();
			Иначе
				ЗаписатьЭлемент(ЗаписьXML, Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
			КонецЕсли;
		КонецЦикла;
		Если Не КорневойЭлемент Тогда
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьЭлемент(ЗаписьXML, ИмяЭлемента, ЗначениеЭлемента)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	Если ЭтоСтрокаXML(ЗначениеЭлемента) Тогда
		ЗаписьXML.ЗаписатьСекциюCDATA(XMLСтрока(ЗначениеЭлемента));
	Иначе
		ЗаписьXML.ЗаписатьТекст(СокрП(XMLСтрока(ЗначениеЭлемента)));
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция ЭтоСтрокаXML(Текст)
	Возврат СтрНачинаетсяС(Текст, "<?xml version=""1.0""") ИЛИ СтрНачинаетсяС(ВРег(Текст), "<!DOCTYPE HTML");
КонецФункции

Функция XMLВМассив(ЧтениеXML)
	
	ИмяСвойства = "";
	Значение = "";
	
	ВозвращаемыйМассив = Новый Массив;
	ВозвращаемаяСтруктура = Новый Структура;
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если ЧтениеXML.Имя = "СтрокаТабличнойЧасти" Тогда
				ВозвращаемаяСтруктура = Новый Структура;
			ИначеЕсли ИмяСвойства = "" Тогда
				ИмяСвойства = ЧтениеXML.Имя;
			Иначе
				ВозвращаемаяСтруктура.Вставить(ИмяСвойства, XMLВСтруктуру(ЧтениеXML));
				ИмяСвойства = "";
			КонецЕсли;
		ИначеЕсли ЧтениеXML.ИмеетЗначение Тогда
			Значение = ЧтениеXML.Значение;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если ЧтениеXML.Имя = "СтрокаТабличнойЧасти" Тогда
				//Если структура пустая, значит в табличной части нет строк, возвращаем пустой массив
				Если ВозвращаемаяСтруктура.Количество() > 0 Тогда
					ВозвращаемыйМассив.Добавить(ВозвращаемаяСтруктура);
				КонецЕсли;
			ИначеЕсли ИмяСвойства = "" Тогда
				Возврат ВозвращаемыйМассив;
			Иначе
				ВозвращаемаяСтруктура.Вставить(ИмяСвойства, Значение);
				ИмяСвойства = "";
				Значение = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция СоставПодписиИзПодписанныхДанных(ПодписанныеДанные)
	
	СоставПодписи = Новый ТаблицаЗначений;
	СоставПодписи.Колонки.Добавить("ИмяРеквизита", ОбщегоНазначения.ОписаниеТипаСтрока(255));
	СоставПодписи.Колонки.Добавить("ИмяТабличнойЧасти", ОбщегоНазначения.ОписаниеТипаСтрока(255));
	СоставПодписи.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(9));
	СоставПодписи.Колонки.Добавить("Порядок", ОбщегоНазначения.ОписаниеТипаЧисло(2));
	СоставПодписи.Колонки.Добавить("СоставСвойствРеквизита", Новый ОписаниеТипов("Массив"));
	
	Если ПодписанныеДанные.Свойство("ПодписываемыеДанныеДокументов") Тогда
		Если ТипЗнч(ПодписанныеДанные.ПодписываемыеДанныеДокументов) <> Тип("Структура") Тогда
			ПодписываемыеДанныеДокументов = Новый Структура;
		Иначе
			ПодписываемыеДанныеДокументов = ПодписанныеДанные.ПодписываемыеДанныеДокументов;
		КонецЕсли;
	Иначе
		ПодписываемыеДанныеДокументов = ПодписанныеДанные;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ПодписываемыеДанныеДокументов Цикл
		
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Строка") Тогда
			// простое свойство
			НоваяСтрока = СоставПодписи.Добавить();
			НоваяСтрока.ИмяРеквизита = КлючЗначение.Ключ;
			
		ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
			// свойство с разыменовкой полей
			НоваяСтрока = СоставПодписи.Добавить();
			НоваяСтрока.ИмяРеквизита = КлючЗначение.Ключ;
			НоваяСтрока.СоставСвойствРеквизита = СоставКлючейСтруктуры(КлючЗначение.Значение);
			
		ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
			// табличная часть - массив структур
			Для Каждого ЭлементМассива Из КлючЗначение.Значение Цикл
				Если ЭлементМассива.Количество() = 0 Тогда
					НоваяСтрока = СоставПодписи.Добавить();
					НоваяСтрока.ИмяТабличнойЧасти = КлючЗначение.Ключ;
				Иначе
					Для Каждого КлючЗначениеСтроки Из ЭлементМассива Цикл
						Если КлючЗначениеСтроки.Ключ = "НомерСтроки" Тогда
							Продолжить;
						КонецЕсли;
						НоваяСтрока = СоставПодписи.Добавить();
						НоваяСтрока.ИмяТабличнойЧасти = КлючЗначение.Ключ;
						НоваяСтрока.ИмяРеквизита = КлючЗначениеСтроки.Ключ;
						НоваяСтрока.НомерСтроки = ЭлементМассива.НомерСтроки;
						Если ТипЗнч(КлючЗначениеСтроки.Значение) = Тип("Структура") Тогда
							// свойство с разыменовкой полей
							НоваяСтрока.СоставСвойствРеквизита = СоставКлючейСтруктуры(КлючЗначениеСтроки.Значение);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ВызватьИсключение НСтр("ru = 'Тип подписанного значения отличается от ожидаемого'");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СоставПодписи;
	
КонецФункции

Функция ЗадачиДляПрерыванияВыполнения(ЗадачаПредшественник)
	
	ЗадачиВсе = Новый Массив;
	ЗадачиАктивные = Новый Массив;
	МинимальныйПорядокПоследователя = 99;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка КАК Последователь,
	|	ЗадачаПоОбработкеДокументаПредшественники.ЗадачаПредшественник КАК Предшественник,
	|	ЗадачаПоОбработкеДокумента.Выполнена КАК Выполнена,
	|	ЗадачаПоОбработкеДокумента.Прервана КАК Прервана,
	|	ЗадачаПоОбработкеДокумента.ПринятаКИсполнению КАК ПринятаКИсполнению,
	|	ЕСТЬNULL(СоставПачекВыполняемыхЗадач.ИдентификаторПачки, НЕОПРЕДЕЛЕНО) КАК ИдентификаторПачки,
	|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента.Предшественники КАК ЗадачаПоОбработкеДокументаПредшественники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ПО ЗадачаПоОбработкеДокументаПредшественники.Ссылка = ЗадачаПоОбработкеДокумента.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО (ЗадачаПоОбработкеДокумента.Шаблон = ШаблоныПроцессовЭтапы.Ссылка)
	|			И (ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
	|		ПО ЗадачаПоОбработкеДокументаПредшественники.Ссылка = СоставПачекВыполняемыхЗадач.Задача
	|ГДЕ
	|	ЗадачаПоОбработкеДокументаПредшественники.ЗадачаПредшественник = &ЗадачаПредшественник";
	
	Запрос.УстановитьПараметр("ЗадачаПредшественник", ЗадачаПредшественник);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗадачиВсе.Добавить(Выборка.Последователь);
		Если Выборка.Прервана Тогда
			Продолжить;
		ИначеЕсли Выборка.Выполнена ИЛИ Выборка.ПринятаКИсполнению Тогда
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'следующая задача ""%1"" уже выполнена или принята к исполнению.'"),
				Выборка.Последователь);
		ИначеЕсли Выборка.ИдентификаторПачки <> Неопределено Тогда
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'в данный момент выполняется следующая задача ""%1"".'"),
				Выборка.Последователь);
		КонецЕсли;
		ЗадачиАктивные.Добавить(Выборка.Последователь);
		МинимальныйПорядокПоследователя = Мин(МинимальныйПорядокПоследователя, Выборка.Порядок);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ЗадачиДляПрерыванияВсе", ОбщегоНазначенияКлиентСервер.СвернутьМассив(ЗадачиВсе));
	Результат.Вставить("ЗадачиДляПрерыванияАктивные", ОбщегоНазначенияКлиентСервер.СвернутьМассив(ЗадачиАктивные));
	Результат.Вставить("МинимальныйПорядокПоследователя", МинимальныйПорядокПоследователя);
	
	Возврат Результат;
	
КонецФункции

Функция ЗадачиДляВосстановления(ИнициаторПрерывания)
	
	МассивЗадач = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрерванныеЗадачи.ПрерваннаяЗадача КАК ПрерваннаяЗадача,
	|	ЕСТЬNULL(СоставПачекВыполняемыхЗадач.ИдентификаторПачки, НЕОПРЕДЕЛЕНО) КАК ИдентификаторПачки
	|ИЗ
	|	РегистрСведений.ПрерванныеЗадачи КАК ПрерванныеЗадачи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
	|		ПО ПрерванныеЗадачи.ПрерваннаяЗадача.Ссылка = СоставПачекВыполняемыхЗадач.Задача
	|ГДЕ
	|	ПрерванныеЗадачи.ИнициаторПрерывания = &ИнициаторПрерывания";
	
	Запрос.УстановитьПараметр("ИнициаторПрерывания", ИнициаторПрерывания);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ИдентификаторПачки <> Неопределено Тогда
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'в данный момент выполняется восстанавливаемая задача ""%1"".'"),
				Выборка.ПрерваннаяЗадача);
		КонецЕсли;
		МассивЗадач.Добавить(Выборка.ПрерваннаяЗадача);
	КонецЦикла;
	
	Возврат ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЗадач);
	
КонецФункции

Процедура ПрерватьВыполнениеЗадач(ЗадачиДляПрерывания, ЗадачиОбъекты)
	
	Для Каждого ЗадачаДляПрерывания Из ЗадачиДляПрерывания Цикл
		
		ЗадачаОбъектДляПрерывания = Неопределено;
		
		УстановитьПривилегированныйРежим(Истина);
		
		ВыполнитьЗадачуПользователя(ЗадачаДляПрерывания, Истина, , ЗадачаОбъектДляПрерывания);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		// Для этапа, который прерывается, необходимо удалить признак перехода к нему от других (не отзываемых) этапов
		УстановкаПризнаковПереходаПоЗапускаемомуЭтапу(ЗадачаОбъектДляПрерывания.Предмет, ЗадачаОбъектДляПрерывания.Шаблон,
			ЗадачаОбъектДляПрерывания.ИдентификаторЭтапа, , Ложь);
		
		ПроцессыОбработкиДокументовПереопределяемый.ПриВыполненииЗадачи(ЗадачаДляПрерывания);
		
		ЗадачиОбъекты.Добавить(ЗадачаОбъектДляПрерывания);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВосстановитьЗадачи(ЗадачиДляВосстановления, ЗадачиОбъекты)
	
	Для Каждого ЗадачаДляВосстановления Из ЗадачиДляВосстановления Цикл
		
		УстановитьПривилегированныйРежим(Истина);
		
		ЗадачаОбъектДляВосстановления = ЗадачаДляВосстановления.ПолучитьОбъект();
		ЗадачаОбъектДляВосстановления.Заблокировать();
		ЗадачаОбъектДляВосстановления.Выполнена = Ложь;
		ЗадачаОбъектДляВосстановления.Прервана = Ложь;
		ЗадачаОбъектДляВосстановления.Записать();
		
		УстановитьПривилегированныйРежим(Ложь);
		
		// Для этапа, который восстанавливается, необходимо восстановить признак перехода
		УстановкаПризнаковПереходаПоЗапускаемомуЭтапу(ЗадачаОбъектДляВосстановления.Предмет, ЗадачаОбъектДляВосстановления.Шаблон,
			ЗадачаОбъектДляВосстановления.ИдентификаторЭтапа);
		
		ПроцессыОбработкиДокументовПереопределяемый.ПриВыполненииЗадачи(ЗадачаДляВосстановления);
		
		ЗадачиОбъекты.Добавить(ЗадачаОбъектДляВосстановления);
		
	КонецЦикла;
	
КонецПроцедуры

Функция НевыполненныеЭтапыПроцессаДокумента(ШаблонСсылка, ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа КАК ИдентификаторЭтапа
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Шаблон = &Шаблон
	|	И ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|	И НЕ ЗадачаПоОбработкеДокумента.Выполнена";
	Запрос.УстановитьПараметр("Шаблон", ШаблонСсылка);
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторЭтапа");
	
КонецФункции

Процедура ДобавитьПодписьПриВыполненииЗадачи(ДанныеДокумента, ЗадачаОбъект, Контекст)
	
	УсиленнаяПодпись = Неопределено;
	
	Если ДанныеДокумента.Свойство("ПодписанЭП")
		И ДанныеДокумента.ПодписанЭП Тогда
		Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
			Возврат;
		КонецЕсли;
		УсиленнаяПодпись = Истина;
	ИначеЕсли ДанныеДокумента.Свойство("ПодписанПростойЭП")
		И ДанныеДокумента.ПодписанПростойЭП Тогда
		УсиленнаяПодпись = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	// Проверка соответствия текущих данных документа и подписанных на клиенте
	
	// Установка разделяемой блокировки для ответственного чтения данных документа
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(ОбщегоНазначения.ИмяТаблицыПоСсылке(ДанныеДокумента.Документ));
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ДанныеДокумента.Документ);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
	Блокировка.Заблокировать();
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Подписи = Новый Массив;
	
	Подпись = Новый Структура;
	Подпись.Вставить("ПодписанныеДанные", ДанныеДокумента.АдресДанных);
	Подпись.Вставить("Индекс", 0);
	Подпись.Вставить("ОписаниеОшибки", "");
	Подпись.Вставить("Этап", ЗадачаОбъект.Этап);
	Подпись.Вставить("УстановившийПодпись", ТекущийПользователь);  
	Подпись.Вставить("Задача", ЗадачаОбъект.Ссылка);
	
	Подписи.Добавить(Подпись);
	
	ПроверитьСоответствиеПодписанныхИТекущихДанных(ДанныеДокумента.Документ, Подписи, ДанныеДокумента.ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(Подписи[0].ОписаниеОшибки) Тогда
		
		ВызватьИсключение Подписи[0].ОписаниеОшибки;
		
	КонецЕсли;
	
	// Добавление подписи
	Если Константы.ХранитьПодписанныеДанныеXMLВПрисоединенныхФайлах.Получить() Тогда
		ПодписанныеДанныеПрисоединенныйФайл = Неопределено;
		ДобавитьПодписанныеДанныеФайл(ДанныеДокумента.Задача, ДанныеДокумента.АдресДанных, ПодписанныеДанныеПрисоединенныйФайл);
	Иначе
		ДобавитьПодписанныеДанные(ДанныеДокумента.Задача, ДанныеДокумента.АдресДанных);
	КонецЕсли;

	Для Каждого Данные Из Контекст.НаборДанных Цикл
		Если ТипЗнч(Данные.Владелец) = Тип("ДокументСсылка.ФормулярПервичногоДокументаПОД") И Данные.Свойство("ИдентификаторПечатнойФормы") 
			И Данные.Свойство("Предмет") И Данные.Предмет = ДанныеДокумента.Документ Тогда
			//Отметка о подписании формуляра
			УстановитьОтметкуОПодписанииФормуляра(ДанныеДокумента.Задача, Данные, УсиленнаяПодпись);

			// Если файл уже был подписан на этом этапе, то необходимо удалить старую подпись
			УдалитьПодписиФайлаПоИдентификаторуЭтапа(Данные.Ссылка, ЗадачаОбъект.ИдентификаторЭтапа, ДанныеДокумента.Задача);
			
			// Сохранение связи задачи и подписанного файла
			СохранитьСвязьЗадачиИПодписанногоФайла(Данные.Ссылка, ДанныеДокумента.Задача, ЗадачаОбъект.ИдентификаторЭтапа,
				Данные.СвойстваПодписи.ДатаПодписи, Данные.СвойстваПодписи.УстановившийПодпись);
			
			Если УсиленнаяПодпись Тогда
				ДобавитьПодпись(Данные.Ссылка, Данные.СвойстваПодписи);
			КонецЕсли;
			
		ИначеЕсли Данные.Ссылка = ДанныеДокумента.Документ Тогда
			// Если задача переподписывается после отмены выполнения, то необходимо удалить ранее установленную подпись
			Если ЗадачаОбъект.ПодписанЭП Тогда
				Если УсиленнаяПодпись Тогда
					УдалитьПодпись(ЗадачаОбъект, 1);
				Иначе
					УдалитьПростуюПодпись(ЗадачаОбъект);
				КонецЕсли;
			КонецЕсли;
			
			Если УсиленнаяПодпись Тогда
				ДобавитьПодпись(ЗадачаОбъект, Данные.СвойстваПодписи);
                //подписываем присоединенный файл
				Если Константы.ХранитьПодписанныеДанныеXMLВПрисоединенныхФайлах.Получить() 
					И ПодписанныеДанныеПрисоединенныйФайл <> Неопределено Тогда
				 	ДобавитьПодпись(ПодписанныеДанныеПрисоединенныйФайл, Данные.СвойстваПодписи); 
				КонецЕсли; 
			Иначе
				ДобавитьПростуюПодпись(ЗадачаОбъект, Данные.СвойстваПодписи);
			КонецЕсли;
			
		ИначеЕсли Данные.Владелец = ДанныеДокумента.Документ Тогда
			
			// Если файл уже был подписан на этом этапе, то необходимо удалить старую подпись
			УдалитьПодписиФайлаПоИдентификаторуЭтапа(Данные.Ссылка, ЗадачаОбъект.ИдентификаторЭтапа, ДанныеДокумента.Задача);
			
			// Сохранение связи задачи и подписанного файла
			СохранитьСвязьЗадачиИПодписанногоФайла(Данные.Ссылка, ДанныеДокумента.Задача, ЗадачаОбъект.ИдентификаторЭтапа,
				Данные.СвойстваПодписи.ДатаПодписи, Данные.СвойстваПодписи.УстановившийПодпись);
			
			Если УсиленнаяПодпись Тогда
				ДобавитьПодпись(Данные.Ссылка, Данные.СвойстваПодписи);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	// При повторной подписи необходимо проверить, был ли документ подписан на этом этапе ранее и удалить старую подпись
	УдалитьПредыдущуюПодпись(ДанныеДокумента.Шаблон, ДанныеДокумента.ИдентификаторЭтапа, ДанныеДокумента.Документ, ДанныеДокумента.Задача);

КонецПроцедуры

Процедура ПодписаниеФормуляровЭД(Задача, НаборДанныхДляПодписи, УсиленнаяПодпись, УИДФормы) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ТипЭлектроннойПодписи = 1;
	Если ЗначениеЗаполнено(УсиленнаяПодпись) Тогда
		Если УсиленнаяПодпись Тогда
			ТипЭлектроннойПодписи = 2;
		КонецЕсли;
	КонецЕсли;

	ИдентификаторЭтапа = Задача.ИдентификаторЭтапа;
	Предмет = Задача.Предмет;
	Шаблон = Задача.Шаблон;

	ЭтапВыполняетсяНесколькимиИсполнителями = ФормулярЭтапаВыполняемогоНесколькимиИсполнителями(Шаблон, ИдентификаторЭтапа);
	Исполнитель = Задача.Исполнитель;
	
	//Файлы текущего этапа
	ИдентификаторыПечатнойФормы = Новый Массив;

	Запрос = Новый Запрос;

	ТекстЗапроса = "ВЫБРАТЬ
	               |	ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК ДанныеПредставленияПервичногоДокумента,
	               |	ФайлыФормуляровЭДПОД.Формат КАК Формат,
	               |	ФайлыФормуляровЭДПОД.ДатаФормирования КАК ДатаФормирования,
	               |	ФайлыФормуляровЭДПОД.НаименованиеДокумента КАК НаименованиеДокумента,
	               |	ФайлыФормуляровЭДПОД.НомерДокумента КАК НомерДокумента,
	               |	ФайлыФормуляровЭДПОД.ДатаДокумента КАК ДатаДокумента,
	               |	ФайлыФормуляровЭДПОД.ИдентификаторПечатнойФормы КАК ИдентификаторПечатнойФормы,
	               |	ФайлыФормуляровЭДПОД.Организация КАК Организация,
	               |	ФайлыФормуляровЭДПОД.Предмет КАК Предмет,
	               |	ФайлыФормуляровЭДПОД.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	               |	ФайлыФормуляровЭДПОД.КодВидаСведений КАК КодВидаСведений,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ОсновнойФайл КАК ОсновнойФайл,
	               |	ВЫРАЗИТЬ(ФайлыФормуляровЭДПОД.ДанныеПредставленияПервичногоДокумента КАК Документ.ФормулярПервичногоДокументаПОД).ОписаниеРегистраУчета КАК ОписаниеРегистраУчета,
	               |	ФайлыФормуляровЭДПОД.НаименованиеПечатнойФормы КАК НаименованиеПечатнойФормы
	               |ИЗ
	               |	РегистрСведений.ФайлыФормуляровЭДПОД КАК ФайлыФормуляровЭДПОД
	               |ГДЕ
	               |	ФайлыФормуляровЭДПОД.Предмет = &Предмет
	               |	И ФайлыФормуляровЭДПОД.ИдентификаторЭтапа = &ИдентификаторЭтапа
	               |	И ФайлыФормуляровЭДПОД.Исполнитель = &Исполнитель";
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	
	Если НЕ ЭтапВыполняетсяНесколькимиИсполнителями Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ФайлыФормуляровЭДПОД.Исполнитель = &Исполнитель", "ИСТИНА");
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Предмет", Предмет);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеПредставленияПервичногоДокумента = Выборка.ДанныеПредставленияПервичногоДокумента;
		ОсновнойФайл = Выборка.ОсновнойФайл;

		ПараметрыДанныхФайла = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Истина;
		ПараметрыДанныхФайла.ИдентификаторФормы = УИДФормы;
		
		ДанныеСтруктура = Новый Структура;
		
		ДополнениеЗаголовка = ПроцессыОбработкиДокументовКлиентСервер.ДополнениеНаименованияФормуляра(Выборка.КодВидаСведений);	
		НаименованиеДокумента = СтрШаблон("%1%2", Выборка.НаименованиеПечатнойФормы, ДополнениеЗаголовка);		
		Если ЗначениеЗаполнено(Выборка.ОписаниеРегистраУчета) Тогда
			НаименованиеДокумента = СтрШаблон("%1%2", Выборка.ОписаниеРегистраУчета, ДополнениеЗаголовка);		
		КонецЕсли;
		
		ДанныеСтруктура.Вставить("ВидДокумента", НаименованиеДокумента);
		ДанныеСтруктура.Вставить("ИдентификаторПечатнойФормы", Выборка.ИдентификаторПечатнойФормы);

		ДанныеСтруктура.Вставить("Шаблон", Задача.Шаблон);
		ДанныеСтруктура.Вставить("ИдентификаторЭтапа", Выборка.ИдентификаторЭтапа);
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ОсновнойФайл, ПараметрыДанныхФайла);
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		
		Представление = НаименованиеДокумента;
		
		ДанныеСтруктура.Вставить("Данные", ДвоичныеДанные);
		ДанныеСтруктура.Вставить("Представление", Представление);
		ДанныеСтруктура.Вставить("Ссылка", ОсновнойФайл);
		ДанныеСтруктура.Вставить("Предмет", Выборка.Предмет);
		ДанныеСтруктура.Вставить("Владелец", ДанныеПредставленияПервичногоДокумента);
		ДанныеСтруктура.Вставить("Формуляр", ДанныеПредставленияПервичногоДокумента);
		ДанныеСтруктура.Вставить("ИмяФайла", ПроцессыОбработкиДокументовПереопределяемый.НаименованиеФайлаФормуляра(Выборка));
		ДанныеСтруктура.Вставить("ФорматПервичногоДокумента", Выборка.Формат);
		
		НаборДанныхДляПодписи.Добавить(ДанныеСтруктура);
		
	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ДобавитьПодписанныеДанные(Задача, ПодписанныеДанные)
	
	ТекущийПользовательПолноправный = Пользователи.ЭтоПолноправныйПользователь();
	
	НаборЗаписей = РегистрыСведений.ПодписанныеДанные.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Задача.Установить(Задача);
	
	Запись = НаборЗаписей.Добавить();
	Запись.Задача = Задача;
	
	Если ЭтоАдресВременногоХранилища(ПодписанныеДанные) Тогда
		Данные = ПолучитьИзВременногоХранилища(ПодписанныеДанные);
	Иначе
		Данные = ПодписанныеДанные;
	КонецЕсли;
	
	Запись.ПодписанныеДанные = Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(9));
	
	Запись.ДанныеАктуальны = Истина;
	Запись.ДатаПроверкиДанных = ТекущаяДатаСеанса();
	
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	НаборЗаписей.Записать();
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПодписанныеДанныеФайл(Задача, ПодписанныеДанные, ПрисоединенныйФайл)

	ТекущийПользовательПолноправный = Пользователи.ЭтоПолноправныйПользователь();
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.ПодписанныеДанные.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Задача.Установить(Задача);

	Запись = НаборЗаписей.Добавить();
	Запись.Задача = Задача;

	Если ЭтоАдресВременногоХранилища(ПодписанныеДанные) Тогда
		Данные = ПолучитьИзВременногоХранилища(ПодписанныеДанные);
	Иначе
		Данные = ПодписанныеДанные;
	КонецЕсли;
	
	ПодписанныеДанныеФайл = ПоместитьПодписанныеДанныеВПрисоединенныйФайл(Задача, Данные, ПрисоединенныйФайл);
	Если ТипЗнч(ПодписанныеДанныеФайл) = Тип("СправочникСсылка.ПодписанныеДанныеПОД") Тогда
		Запись.ПодписанныеДанныеФайл = ПодписанныеДанныеФайл; 
		Запись.ПодписанныеДанные = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;
	
	Запись.ДанныеАктуальны = Истина;
	Запись.ДатаПроверкиДанных = ТекущаяДатаСеанса();
	
	НаборЗаписей.Записать();
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры 

Процедура УдалитьПодписанныеДанные(Задача)
	
	ТекущийПользовательПолноправный = Пользователи.ЭтоПолноправныйПользователь();
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	ПодписанныеДанныеФайл = ПолучитьФайлПодписанныеДанныеПОД(Задача); 
	Если ЗначениеЗаполнено(ПодписанныеДанныеФайл) Тогда

		ПрисоединенныеФайлы = Новый Массив; 
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ПодписанныеДанныеФайл, ПрисоединенныеФайлы);
		Если ПрисоединенныеФайлы.Количество() > 0 Тогда
			ПрисоединенныйФайл = ПрисоединенныеФайлы[0];
			
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПрисоединенныйФайл, "ПодписанЭП") Тогда
				МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
				МодульЭлектроннаяПодпись.УдалитьПодпись(ПрисоединенныйФайл, 1);
			КонецЕсли;
			
			ПодписанныеДанныеПОДФайл = ПодписанныеДанныеФайл.ПолучитьОбъект();
			ПодписанныеДанныеПОДФайл.УстановитьПометкуУдаления(Истина);
			ПодписанныеДанныеПОДФайл.Записать(); 
		КонецЕсли;
	КонецЕсли;	
	
	НаборЗаписей = РегистрыСведений.ПодписанныеДанные.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Задача.Установить(Задача);
	
	НаборЗаписей.Записать();
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьПредыдущуюПодпись(Шаблон, ИдентификаторЭтапа, Документ, Задача)
	
	ТекущийПользовательПолноправный = Пользователи.ЭтоПолноправныйПользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИсполнителиГрупповогоЭтапа.ПорядковыйНомер КАК ПорядковыйНомер
	|ПОМЕСТИТЬ ПорядковыйНомерТекущегоИсполнителя
	|ИЗ
	|	РегистрСведений.ИсполнителиГрупповогоЭтапа КАК ИсполнителиГрупповогоЭтапа
	|ГДЕ
	|	ИсполнителиГрупповогоЭтапа.Предмет = &Документ
	|	И ИсполнителиГрупповогоЭтапа.Задача = &Задача
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ЗадачиСПодписью
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиГрупповогоЭтапа КАК ИсполнителиГрупповогоЭтапа
	|		ПО ЗадачаПоОбработкеДокумента.Предмет = ИсполнителиГрупповогоЭтапа.Предмет
	|			И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = ИсполнителиГрупповогоЭтапа.ИдентификаторЭтапа
	|			И ЗадачаПоОбработкеДокумента.Ссылка = ИсполнителиГрупповогоЭтапа.Задача
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.ПодписанЭП
	|	И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = &ИдентификаторЭтапа
	|	И ЗадачаПоОбработкеДокумента.Шаблон = &Шаблон
	|	И ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|	И ВЫБОР
	|			КОГДА НЕ ИсполнителиГрупповогоЭтапа.ПорядковыйНомер ЕСТЬ NULL
	|				ТОГДА ИсполнителиГрупповогоЭтапа.ПорядковыйНомер В
	|						(ВЫБРАТЬ
	|							ПорядковыйНомерТекущегоИсполнителя.ПорядковыйНомер
	|						ИЗ
	|							ПорядковыйНомерТекущегоИсполнителя)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ЗадачаПоОбработкеДокумента.Ссылка <> &Задача
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗадачиСПодписью.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА НЕ ПростыеЭлектронныеПодписиПОД.ПодписанныйОбъект ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПростаяПодпись
	|ИЗ
	|	ЗадачиСПодписью КАК ЗадачиСПодписью
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПростыеЭлектронныеПодписиПОД КАК ПростыеЭлектронныеПодписиПОД
	|		ПО ЗадачиСПодписью.Ссылка = ПростыеЭлектронныеПодписиПОД.ПодписанныйОбъект";
	
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Задача", Задача);
	
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПредыдущаяЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.ПростаяПодпись Тогда
			УдалитьПростуюПодпись(ПредыдущаяЗадачаОбъект);
		Иначе
			УдалитьПодпись(ПредыдущаяЗадачаОбъект, 1);
		КонецЕсли;
		ПредыдущаяЗадачаОбъект.Записать();
		УдалитьПодписанныеДанные(Выборка.Ссылка);
	КонецЦикла;
	
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьТекстЗапроса(ТипыЗначения, Отказ)
	
	Запрос = "";
	
	Если ТипыЗначения.Типы().Количество() = 1 Тогда
		ТипЗначения = ТипыЗначения.Типы()[0];
		Если ТипЗначения = Тип("Строка")
			ИЛИ ТипЗначения = Тип("Дата")
			ИЛИ ТипЗначения = Тип("Число")
			ИЛИ ТипЗначения = Тип("Булево") Тогда
			
			ТекстСообщения = НСтр("ru='Для простого типа не поддерживается установка отбора'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			
			Возврат Запрос;
			
		КонецЕсли;
		
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗначения);
		Запрос = "Выбрать";
		Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			Запрос = Запрос + "
				|ВыбОбъект.Ссылка,"
		Иначе
			Для Каждого СтандартныйРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				
				Запрос = Запрос + "
					|ВыбОбъект." + СтандартныйРеквизит.Имя + ",";
				
			КонецЦикла;
			Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
				
				Запрос = Запрос + "
					|ВыбОбъект." + Реквизит.Имя + ",";
				
				Если Реквизит.Тип.Типы().Количество() > 1 Тогда
					Запрос = Запрос + "
						|ТИПЗНАЧЕНИЯ(" + Реквизит.Имя + ") КАК " + "типРеквизита_" + Реквизит.Имя + ",";
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		Запрос = Лев(Запрос, СтрДлина(Запрос)-1);
		Запрос = Запрос + "
				|Из
				|"+ОбщегоНазначения.ВидОбъектаПоТипу(ТипЗначения)+"."+МетаданныеОбъекта.Имя+" Как ВыбОбъект";
		
	Иначе
		ТекстСообщения = НСтр("ru='Для составного типа не поддерживается установка отбора'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции // СформироватьТекстЗапроса()

// Копирует элементы отбора компоновки данных
// Параметры:
//	КоллекцияПриемник - ОтборКомпоновкиДанных
//	КоллекцияИсточник - ОтборКомпоновкиДанных
//
// Пример использования:
//	ПроцессыОбработкиДокументов.СкопироватьОтборНастроекКомпоновкиДанных(КомпоновщикНастроек.Настройки.Отбор, Список.Отбор);
//
Процедура СкопироватьОтборНастроекКомпоновкиДанных(КоллекцияПриемник, КоллекцияИсточник)
	
	Для Каждого ЭлементОтбора Из КоллекцияИсточник.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НоваяГруппа = КоллекцияПриемник.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НоваяГруппа, ЭлементОтбора);
			СкопироватьОтборНастроекКомпоновкиДанных(НоваяГруппа, ЭлементОтбора);
		Иначе
			НовыйЭлемент = КоллекцияПриемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОтбора);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьИменаРеквизитовИзОтбораКомпоновкиДанных(Отбор, Реквизиты)
	
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ПолучитьИменаРеквизитовИзОтбораКомпоновкиДанных(ЭлементОтбора, Реквизиты);
		Иначе
			Реквизиты.Добавить(ЭлементОтбора.ЛевоеЗначение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьСоответствиеПодписанныхИТекущихДанныхПоСоставуСвойств(СоставСвойствРеквизита, ПодписанноеЗначение, ТекущееЗначение, ИмяДанных, ОписаниеОшибки)
	
	Для Каждого СвойствоРеквизита Из СоставСвойствРеквизита Цикл
		
		Если ТипЗнч(СвойствоРеквизита) = Тип("Структура") Тогда
			Для Каждого СоставСвойстваРеквизита Из СвойствоРеквизита Цикл
				
				ИмяСвойства = СоставСвойстваРеквизита.Ключ;
				НаборСвойствРеквизита = СоставСвойстваРеквизита.Значение;
				
				ПодписанноеСвойствоРеквизита = ПодписанноеЗначение[ИмяСвойства];
				ТекущееСвойствоРеквизита = Неопределено;
				
				Если ТекущееЗначение = Неопределено Тогда
					ПроверитьСоответствиеПодписанныхИТекущихДанныхПоСоставуСвойств(НаборСвойствРеквизита,
																					ПодписанноеСвойствоРеквизита,
																					Неопределено,
																					ИмяДанных+"."+ИмяСвойства,
																					ОписаниеОшибки);
				ИначеЕсли ТекущееЗначение.Свойство(ИмяСвойства, ТекущееСвойствоРеквизита) Тогда
					ПроверитьСоответствиеПодписанныхИТекущихДанныхПоСоставуСвойств(НаборСвойствРеквизита,
																					ПодписанноеСвойствоРеквизита,
																					ТекущееСвойствоРеквизита,
																					ИмяДанных+"."+ИмяСвойства,
																					ОписаниеОшибки);
				КонецЕсли;
			КонецЦикла;
		Иначе
			ПодписанноеСвойствоРеквизита = ПодписанноеЗначение[СвойствоРеквизита];
			ТекущееСвойствоРеквизита = Неопределено;
			Если ТекущееЗначение = Неопределено Тогда
				Если НЕ ПустаяСтрока(ПодписанноеСвойствоРеквизита) Тогда
					ОписаниеОшибки = ОписаниеОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
									|- Поле ""%1"": подписанное значение ""%2"" <-> текущее значение ""%3""'"),
									ИмяДанных+"."+СвойствоРеквизита,
									ПодписанноеСвойствоРеквизита,
									Неопределено);
				КонецЕсли;
			ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("Структура")
				И ТекущееЗначение.Свойство(СвойствоРеквизита, ТекущееСвойствоРеквизита)
				И НЕ ПодписанноеСвойствоРеквизита = СокрП(XMLСтрока(ТекущееСвойствоРеквизита)) Тогда
					ОписаниеОшибки = ОписаниеОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '
									|- Поле ""%1"": подписанное значение ""%2"" <-> текущее значение ""%3""'"),
									ИмяДанных+"."+СвойствоРеквизита,
									ПодписанноеСвойствоРеквизита,
									СокрП(XMLСтрока(ТекущееСвойствоРеквизита)));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьПоляЗапросаПоСоставуСвойств(МассивПолейЗапроса, ИмяПоля, ПсевдонимПоля, СоставСвойств, РазделителиПсевдонимовУровнейВложенности, ТекущаяГлубинаВложенности)
	
	Если СоставСвойств.ВГраница() > -1 Тогда
		
		Если РазделителиПсевдонимовУровнейВложенности.Количество() < ТекущаяГлубинаВложенности Тогда
			РазделителиПсевдонимовУровнейВложенности.Вставить(ТекущаяГлубинаВложенности - 1, СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "_"));
		КонецЕсли;
		Разделитель = РазделителиПсевдонимовУровнейВложенности[ТекущаяГлубинаВложенности - 1];
		
		Для Каждого Свойство Из СоставСвойств Цикл
			Если ТипЗнч(Свойство) = Тип("Структура") Тогда
				Для Каждого КлючЗначение Из Свойство Цикл
					ПолучитьПоляЗапросаПоСоставуСвойств(
						МассивПолейЗапроса,
						ИмяПоля + "." +КлючЗначение.Ключ,
						ПсевдонимПоля + Разделитель + КлючЗначение.Ключ,
						КлючЗначение.Значение,
						РазделителиПсевдонимовУровнейВложенности,
						ТекущаяГлубинаВложенности + 1)
				КонецЦикла;
			Иначе
				МассивПолейЗапроса.Добавить(ИмяПоля + "." + Свойство + " КАК " + ПсевдонимПоля + Разделитель + Свойство);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		МассивПолейЗапроса.Добавить(ИмяПоля + " КАК " + ПсевдонимПоля);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВставитьЗначениеВСтруктуруСУчетомВложенности(Структура, Значение, МассивИменУровнейВложенности)
	
	Если МассивИменУровнейВложенности.Количество() = 1 Тогда
		Структура.Вставить(МассивИменУровнейВложенности[0], Значение);
	Иначе
		ВложеннаяСтруктура = Неопределено;
		Если НЕ Структура.Свойство(МассивИменУровнейВложенности[0], ВложеннаяСтруктура) Тогда
			ВложеннаяСтруктура = Новый Структура;
			Структура.Вставить(МассивИменУровнейВложенности[0], ВложеннаяСтруктура);
		КонецЕсли;
		МассивИменУровнейВложенности.Удалить(0);
		ВставитьЗначениеВСтруктуруСУчетомВложенности(ВложеннаяСтруктура, Значение, МассивИменУровнейВложенности);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЗначениеВДанныеДляРазыменовки(ДанныеДляРазыменовки, Знач Значение)
	
	ТипРеквизита = ТипЗнч(Значение);
	
	Если Значение <> Неопределено
		И ПроцессыОбработкиДокументовПовтИсп.ОписаниеТиповСРазыменовкой().СодержитТип(ТипРеквизита) Тогда
		
		МассивЗначений = ДанныеДляРазыменовки.Получить(ТипРеквизита);
		Если МассивЗначений = Неопределено Тогда
			ДанныеДляРазыменовки.Вставить(ТипРеквизита, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Значение));
		Иначе
			МассивЗначений.Добавить(Значение);
			ДанныеДляРазыменовки.Вставить(ТипРеквизита, МассивЗначений);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция РазыменовкаРеквизитовСогласноНастройке(ДанныеДляРазыменовки, НастройкаХранения)
	
	РезультатРазыменовкиРеквизитов = Новый Соответствие;
	ДанныеДляДальнейшейРазыменовки = Новый Соответствие;
	
	Для Каждого ТипДляРазыменовки Из ДанныеДляРазыменовки Цикл
		
		ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипДляРазыменовки.Ключ);
		ПараметрыПоиска = Новый Структура("ТипДанных", ИдентификаторОбъекта);
		МассивРеквизитов = НастройкаХранения.Скопировать(ПараметрыПоиска, "ИмяРеквизита").ВыгрузитьКолонку("ИмяРеквизита");
		
		Если МассивРеквизитов.Количество() > 0 Тогда
			
			РезультатРазыменовкиРеквизита = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ТипДляРазыменовки.Значение, МассивРеквизитов);
			
			Для Каждого ЗначенияРеквизитовОбъекта Из РезультатРазыменовкиРеквизита Цикл
				
				Для Каждого ИмяРеквизита Из МассивРеквизитов Цикл
					
					ДобавитьЗначениеВДанныеДляРазыменовки(ДанныеДляДальнейшейРазыменовки, ЗначенияРеквизитовОбъекта.Значение[ИмяРеквизита]);
					
				КонецЦикла;
				
				РезультатРазыменовкиРеквизитов.Вставить(ЗначенияРеквизитовОбъекта.Ключ, ЗначенияРеквизитовОбъекта.Значение);
				
			КонецЦикла;
			
			// Также в результат разыменовки надо добавить ключ с пустой ссылкой и значения реквизитов = Неопределено
			РазыменовкаПустойСсылки = Новый Структура(СтрСоединить(МассивРеквизитов, ","));
			РезультатРазыменовкиРеквизитов.Вставить(
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторОбъекта, "ЗначениеПустойСсылки"),
				РазыменовкаПустойСсылки);
			
		Иначе
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для типа данных ""%1"" не задана настройка состава реквизитов для электронной подписи.'"),
				ИдентификаторОбъекта);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДанныеДляДальнейшейРазыменовки.Количество() > 0 Тогда
		
		РезультатДальнейшейРазыменовкиРеквизитов = РазыменовкаРеквизитовСогласноНастройке(ДанныеДляДальнейшейРазыменовки, НастройкаХранения);
		
		// Необходимо заменить ссылки на разыменованные данные
		Для Каждого РазыменовкаРеквизита Из РезультатРазыменовкиРеквизитов Цикл
			
			Для Каждого ЗначениеРазыменовки Из РазыменовкаРеквизита.Значение Цикл
				
				РазыменованныеДанные = РезультатДальнейшейРазыменовкиРеквизитов.Получить(ЗначениеРазыменовки.Значение);
				
				Если НЕ РазыменованныеДанные = Неопределено Тогда
					
					РазыменовкаРеквизита.Значение.Вставить(ЗначениеРазыменовки.Ключ, РазыменованныеДанные);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РезультатРазыменовкиРеквизитов;
	
КонецФункции

Процедура ОбновитьЗначенияКонстантВРеквизитахФормы(Форма)
	
	Форма.ПроцессыОбработкиДокументов_НеЗаполнятьКомментарийПриОтрицательномРезультате =
		Константы.НеЗаполнятьКомментарийПриОтрицательномРезультате.Получить();
	Форма.ПроцессыОбработкиДокументов_ПроверятьИмеющиесяЭППриОчередномПодписании =
		Константы.ПроверятьИмеющиесяЭППриОчередномПодписании.Получить();
	Форма.ПроцессыОбработкиДокументов_ПроверятьПодписанныеДанныеПриОчередномПодписании =
		Константы.ПроверятьПодписанныеДанныеПриОчередномПодписании.Получить();
	Форма.ПроцессыОбработкиДокументов_ПроверятьНаличиеКлючаПЭПВРеестре =
		Константы.ПроверятьНаличиеКлючаПЭПВРеестре.Получить();
	Форма.ПроцессыОбработкиДокументов_ИспользоватьМногопоточнуюПроверку =
	Константы.ИспользоватьПроверкуПодписываемыхДанныхЧерезХэш.Получить(); 
	
КонецПроцедуры

// Обновляет дату обновления пачки выполняемых задач. Если задач в пачке больше нет, то пачка удаляется
//
// Параметры:
//   ПачкиВыполняемыхЗадач - Массив - Массив иденитификаторов пачек выполняемых задач, у которых требуется обновить дату.
Процедура ОбновитьДатуОбновленияПачекВыполняемыхЗадач(ПачкиВыполняемыхЗадач)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПачкиВыполняемыхЗадач.ИдентификаторПачки КАК ИдентификаторПачки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СоставПачекВыполняемыхЗадач.Задача) КАК КоличествоЗадачВПачке
	|ИЗ
	|	РегистрСведений.ПачкиВыполняемыхЗадач КАК ПачкиВыполняемыхЗадач
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
	|		ПО ПачкиВыполняемыхЗадач.ИдентификаторПачки = СоставПачекВыполняемыхЗадач.ИдентификаторПачки
	|ГДЕ
	|	ПачкиВыполняемыхЗадач.ИдентификаторПачки В(&ИдентификаторыПачек)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПачкиВыполняемыхЗадач.ИдентификаторПачки";
	
	Запрос.УстановитьПараметр("ИдентификаторыПачек", ПачкиВыполняемыхЗадач);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ПачкиВыполняемыхЗадач.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторПачки = Выборка.ИдентификаторПачки;
		Если Выборка.КоличествоЗадачВПачке = 0 Тогда
			МенеджерЗаписи.Удалить();
		Иначе
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.ДатаПоследнегоОбновления = ТекущаяДатаСеанса();
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает длительность ожидания выполнения задачи в секундах, по прошествии которого
// эта задача и задачи из этой же пачки будут отмечены как невыполняемые
Функция ВремяОжиданияВыполненияЗадачи()
	
	ВремяОжиданияВыполненияЗадачи = 3600; // по умолчанию 1 час
	
	ПроцессыОбработкиДокументовПереопределяемый.ИзменитьВремяОжиданияВыполненияЗадачи(ВремяОжиданияВыполненияЗадачи);
	
	Возврат ВремяОжиданияВыполненияЗадачи;
	
КонецФункции

Процедура ЗаменитьАдресаВременногоХранилищаНаЗначения(Контекст)
	
	Для Каждого ДанныеДокумента Из Контекст.ДанныеДокументов Цикл
		
		Если (ДанныеДокумента.Свойство("ПодписанЭП") И ДанныеДокумента.ПодписанЭП)
			ИЛИ (ДанныеДокумента.Свойство("ПодписанПростойЭП") И ДанныеДокумента.ПодписанПростойЭП) Тогда
			
			ДанныеДокумента.АдресДанных = ПолучитьИзВременногоХранилища(ДанныеДокумента.АдресДанных);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Контекст.Свойство("НаборДанных") Тогда
		
		Для Каждого Данные Из Контекст.НаборДанных Цикл
			
			Если Не (ТипЗнч(Данные.Владелец) = Тип("ДокументСсылка.ФормулярПервичногоДокументаПОД")) Тогда
				Данные.Данные = ПолучитьИзВременногоХранилища(Данные.Данные);
			КонецЕсли;
			
			Если Данные.Свойство("СвойстваПодписи")
				И ЭтоАдресВременногоХранилища(Данные.СвойстваПодписи) Тогда
				Данные.СвойстваПодписи = ПолучитьИзВременногоХранилища(Данные.СвойстваПодписи)
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОПрогрессеВыполненияЗадач(Всего, Обработано, ВыполненоУспешно, ВыполеноНеуспешно)
	
	Если ВыполеноНеуспешно > 0 Тогда
		ШаблонСообщения = НСтр("ru = 'Выполнено %1 из %2 задач, из них %3 успешно и %4 с ошибками'");
	Иначе
		ШаблонСообщения = НСтр("ru = 'Выполнено %1 из %2 задач'");
	КонецЕсли;
	
	ИнформацияОВыполнении = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
		Обработано, Всего, ВыполненоУспешно, ВыполеноНеуспешно);
	
	ДлительныеОперации.СообщитьПрогресс(, ИнформацияОВыполнении);
	
КонецПроцедуры

Функция СрокиВыполненияИНапоминания(РеквизитыАдресации, ДатаОтсчета, КоличествоДней = 0, КоличествоЧасов = 0)
	
	Результат = Новый Структура;
	Результат.Вставить("СрокВыполнения", Дата(1,1,1));
	Результат.Вставить("СрокНапоминания", Дата(1,1,1));
	
	СрокНапоминанияМинуты = ?(Константы.НапоминатьОПриближенииСрокаВыполненияЗадач.Получить(), 
		Константы.СрокНапоминанияМинуты.Получить(), 0);
	
	Если Константы.ИспользоватьГрафикиРаботы.Получить() Тогда
		СтандартнаяОбработка = Истина;
		ГрафикРаботы = ГрафикРаботыИсполнителя(РеквизитыАдресации, СтандартнаяОбработка);
		Если СтандартнаяОбработка И Не ЗначениеЗаполнено(ГрафикРаботы) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Срок выполнения не рассчитан'"));
			Возврат Результат;
		КонецЕсли;
		Сроки = СрокиВыполненияИНапоминанияПоГрафикуРаботы(ГрафикРаботы, СтандартнаяОбработка,
			ДатаОтсчета, КоличествоДней, КоличествоЧасов, СрокНапоминанияМинуты);
		Результат.СрокВыполнения = Сроки.СрокВыполнения;
		Результат.СрокНапоминания = Сроки.СрокНапоминания;
	Иначе
		Результат.СрокВыполнения = ДатаОтсчета + КоличествоДней * 24 * 60 * 60 + КоличествоЧасов * 60 * 60;
		Если СрокНапоминанияМинуты > 0 Тогда
			Результат.СрокНапоминания = Результат.СрокВыполнения - СрокНапоминанияМинуты * 60;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СрокВыполненияПоГрафикуРаботы(ГрафикРаботы, СтандартнаяОбработка, ДатаОтсчета, КоличествоДней = 0,
		КоличествоЧасов = 0, РасписаниеРаботы)
	
	ДатаОкончания = ДатаПоГрафику(ГрафикРаботы, ДатаОтсчета, КоличествоДней, КоличествоЧасов, СтандартнаяОбработка);
	
	Если КоличествоДней > 0 Тогда
		ДатаНачала = ДобавитьВремя(ДатаОкончания, ВремяИзДаты(ДатаОтсчета));
		СрокИсполнения = ДатаНачала;
	Иначе
		ДатаНачала = ДатаОтсчета;
		СрокИсполнения = ДатаНачала;
	КонецЕсли;
	
	ДатаОкончания = КонецДня(ДатаОкончания);
	
	СрокВСекундах = КоличествоЧасов * 60 * 60;
	
	// Если количество часов = 0, то срок задан в формате "До конца дня" или "До указанного времени",
	// поэтому в качестве срока передается одна секунда, чтобы расчитать расписание работы этого дня
	Если СрокВСекундах = 0 Тогда
		СрокВСекундах = 1;
	КонецЕсли;
	
	Пока СрокВСекундах > 0 Цикл
		
		ИнтервалыРабочегоВремени = РасписаниеРаботыНаПериод(ГрафикРаботы, ДатаНачала, ДатаОкончания, СтандартнаяОбработка);
		
		Если НЕ ЗначениеЗаполнено(ИнтервалыРабочегоВремени) Тогда
			СрокВСекундах = 0;
			Прервать;
		КонецЕсли;
		
		Для Каждого Интервал Из ИнтервалыРабочегоВремени Цикл
			
			Если СрокВСекундах = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если СрокВСекундах > Интервал.Длительность Тогда
				СрокВСекундах = СрокВСекундах - Интервал.Длительность;
			Иначе
				СрокИсполнения = Интервал.ДатаНачала + СрокВСекундах;
				СрокВСекундах = 0;
			КонецЕсли;
			
		КонецЦикла;
		
		// Расписание работы необходимо передать выше для расчета сроков этапов интервала
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ИнтервалыРабочегоВремени, РасписаниеРаботы);
		
		Если СрокВСекундах = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ДатаНачала = ДатаОкончания;
		ДатаОкончания = ДатаПоГрафику(ГрафикРаботы, ДатаОкончания, 2, 0, СтандартнаяОбработка);
		ДатаОкончания = КонецДня(ДатаОкончания);
		
	КонецЦикла;
	
	Возврат СрокИсполнения;
	
КонецФункции

Функция СрокиВыполненияИНапоминанияПоГрафикуРаботы(ГрафикРаботы, СтандартнаяОбработка, ДатаОтсчета, КоличествоДней = 0,
	КоличествоЧасов = 0, СрокНапоминанияМинуты = 0, РасписаниеРаботы = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("СрокВыполнения", Дата(1,1,1));
	Результат.Вставить("СрокНапоминания", Дата(1,1,1));
	
	ДатаНачала = ДатаОтсчета;
	ДатаОкончания = ДатаПоГрафику(ГрафикРаботы, ДатаОтсчета, КоличествоДней, КоличествоЧасов, СтандартнаяОбработка);
	ДатаОкончания = КонецДня(ДатаОкончания);
	
	// TODO: алгоритм расчета количества рабочих часов в дне
	СрокВСекундах = КоличествоДней * 8 * 60 * 60 + КоличествоЧасов * 60 * 60;
	
	// Если количество часов = 0, то срок задан в формате "До конца дня" или "До указанного времени",
	// поэтому в качестве срока передается одна секунда, чтобы расчитать расписание работы этого дня
	Если СрокВСекундах = 0 Тогда
		СрокВСекундах = 1;
	КонецЕсли;
	
	Пока СрокВСекундах > 0 Цикл
		
		ИнтервалыРабочегоВремени = РасписаниеРаботыНаПериод(ГрафикРаботы, ДатаНачала, ДатаОкончания, СтандартнаяОбработка);
		
		Если НЕ ЗначениеЗаполнено(ИнтервалыРабочегоВремени) Тогда
			СрокВСекундах = 0;
			СрокИсполнения = ДатаНачала;
			Прервать;
		КонецЕсли;
		
		Для Каждого Интервал Из ИнтервалыРабочегоВремени Цикл
			
			Если СрокВСекундах = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если СрокВСекундах > Интервал.Длительность Тогда
				СрокВСекундах = СрокВСекундах - Интервал.Длительность;
			Иначе
				СрокИсполнения = Интервал.ДатаНачала + СрокВСекундах;
				СрокВСекундах = 0;
			КонецЕсли;
			
		КонецЦикла;
		
		// Расписание работы необходимо передать выше для расчета сроков этапов интервала
		Если РасписаниеРаботы = Неопределено Тогда
			РасписаниеРаботы = ИнтервалыРабочегоВремени.Скопировать();
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ИнтервалыРабочегоВремени, РасписаниеРаботы);
		КонецЕсли;
		
		Если СрокВСекундах = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ДатаНачала = ДатаОкончания;
		ДатаОкончания = ДатаПоГрафику(ГрафикРаботы, ДатаОкончания, 2, 0, СтандартнаяОбработка);
		ДатаОкончания = КонецДня(ДатаОкончания);
		
	КонецЦикла;
	
	Результат.СрокВыполнения = СрокИсполнения;
	
	// Расчет срока напоминания
	СрокВСекундах = СрокНапоминанияМинуты * 60;
	
	Результат.СрокНапоминания = ДатаПоГрафикуДоНаступленияСрока(РасписаниеРаботы, ГрафикРаботы, СтандартнаяОбработка, СрокИсполнения, СрокВСекундах);
	
	Возврат Результат;
	
КонецФункции

Функция ДатаПоГрафику(ГрафикРаботы, ДатаОтсчета, КоличествоДней, КоличествоЧасов, СтандартныйРасчетСроков)
	
	Если СтандартныйРасчетСроков Тогда
		Если КоличествоДней > 0 Тогда
			Дни = КоличествоДней;
		Иначе
			// TODO: Расчет количества рабочих часов в дне
			Дни = Цел(КоличествоЧасов/8) + 1;
		КонецЕсли;
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ГрафикиРаботы") Тогда
			МодульГрафикиРаботы = ОбщегоНазначения.ОбщийМодуль("ГрафикиРаботы");
			УстановитьПривилегированныйРежим(Истина);
			Возврат МодульГрафикиРаботы.ДатаПоГрафику(ГрафикРаботы, ДатаОтсчета, Дни, Истина);
		Иначе
			ВызватьИсключение НСтр("ru='Не обнаружена подсистема БСП ""Графики работы""'");
		КонецЕсли;
	Иначе
		Возврат ПроцессыОбработкиДокументовПереопределяемый.ДатаПоГрафику(ГрафикРаботы, ДатаОтсчета, КоличествоДней, КоличествоЧасов);
	КонецЕсли;
	
КонецФункции

Функция РасписаниеРаботыНаПериод(ГрафикРаботы, ДатаНачала, ДатаОкончания, СтандартныйРасчетСроков, ОбратныйПорядок = Ложь)
	
	Если СтандартныйРасчетСроков Тогда
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ГрафикиРаботы") Тогда
			МодульГрафикиРаботы = ОбщегоНазначения.ОбщийМодуль("ГрафикиРаботы");
			УстановитьПривилегированныйРежим(Истина);
			ИнтервалыРабочегоВремени = МодульГрафикиРаботы.РасписанияРаботыНаПериод(
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ГрафикРаботы), НачалоДня(ДатаНачала), ДатаОкончания);
			УстановитьПривилегированныйРежим(Ложь);
		Иначе
			ВызватьИсключение НСтр("ru='Не обнаружена подсистема БСП ""Графики работы""'");
		КонецЕсли;
	Иначе
		ИнтервалыРабочегоВремени = ПроцессыОбработкиДокументовПереопределяемый.РасписаниеРаботыНаПериод(
			ГрафикРаботы, НачалоДня(ДатаНачала), ДатаОкончания);
	КонецЕсли;
	
	// таблица рабочего времени
	ТаблицаРабочегоВремени = ПустаяТаблицаРабочегоВремени();
		
	Для Каждого Интервал Из ИнтервалыРабочегоВремени Цикл
		
		// Если время начала не заполнено, устанавливается начало дня
		Если НЕ ЗначениеЗаполнено(Интервал.ВремяНачала) Тогда
			ДатаНачалаИнтервала = НачалоДня(Интервал.ДатаГрафика);
		Иначе
			ДатаНачалаИнтервала = ДобавитьВремя(Интервал.ДатаГрафика, Интервал.ВремяНачала);
		КонецЕсли;
		
		// Если время окончания на заполнено, устанавливается конец дня
		Если НЕ ЗначениеЗаполнено(Интервал.ВремяОкончания) Тогда
			ДатаОкончанияИнтервала = КонецДня(Интервал.ДатаГрафика);
		Иначе
			ДатаОкончанияИнтервала = ДобавитьВремя(Интервал.ДатаГрафика, Интервал.ВремяОкончания);
		КонецЕсли;
		
		Если ДатаНачала >= ДатаОкончанияИнтервала Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДатаНачала > ДатаНачалаИнтервала Тогда
			ДатаНачалаИнтервала = ДатаНачала;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаРабочегоВремени.Добавить();
		НоваяСтрока.ДатаНачала = ДатаНачалаИнтервала;
		НоваяСтрока.ДатаОкончания = ДатаОкончанияИнтервала;
		
		НоваяСтрока.Длительность = НоваяСтрока.ДатаОкончания - НоваяСтрока.ДатаНачала;
		Если НоваяСтрока.ДатаОкончания = КонецДня(НоваяСтрока.ДатаОкончания) Тогда 
			НоваяСтрока.Длительность = НоваяСтрока.Длительность + 1
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОбратныйПорядок Тогда
		ТаблицаРабочегоВремени.Сортировать("ДатаНачала Убыв");
	Иначе
		ТаблицаРабочегоВремени.Сортировать("ДатаНачала Возр");
	КонецЕсли;

	Возврат ТаблицаРабочегоВремени;
	
КонецФункции

Функция ДобавитьВремя(Дата, Время)
	
	Возврат НачалоДня(Дата) + Час(Время)*3600 + Минута(Время)*60 + Секунда(Время);
	
КонецФункции

Функция ВремяИзДаты(Дата)
	
	Возврат Дата(1, 1, 1, Час(Дата), Минута(Дата), Секунда(Дата));
	
КонецФункции

Процедура УправлениеРегламентнымиИнтерваламиПриВыполненииЗадачи(Задача)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьРегламентныеИнтервалы") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Задача.РегламентныйИнтервал) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка наличия активных задач по регламентному интервалу документа
	Если ЕстьАктивныеЗадачиПоРегламентномуИнтервалуДокумента(Задача.Предмет, Задача.РегламентныйИнтервал, Задача.НомерИтерации) Тогда
		Возврат;
	КонецЕсли;
	
	// Нет активных задач по регламентному интервалу -> его следует либо выполнить, либо прервать
	Запись = РегистрыСведений.РегламентныеИнтервалыДокументов.СоздатьМенеджерЗаписи();
	Запись.Предмет = Задача.Предмет;
	Запись.РегламентныйИнтервал = Задача.РегламентныйИнтервал;
	Запись.НомерИтерации = Задача.НомерИтерации;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Если Задача.ИдентификаторЭтапа = Запись.ИдентификаторКонечногоЭтапа Тогда
			Запись.Состояние = Перечисления.СостоянияРегламентныхИнтервалов.Выполнен;
			Запись.ДатаВыполнения = Задача.ДатаИсполнения;
			Если Запись.Срок > Запись.ДатаВыполнения Тогда
				Запись.ОтклонениеОтПлана = РабочееВремяМеждуДатами(Запись.ДатаВыполнения, Запись.Срок, Задача);
			Иначе
				Запись.ОтклонениеОтПлана = -1 * РабочееВремяМеждуДатами(Запись.Срок, Запись.ДатаВыполнения, Задача);
			КонецЕсли;
		Иначе
			Запись.Состояние = Перечисления.СостоянияРегламентныхИнтервалов.Прерван;
		КонецЕсли;
		УстановитьПривилегированныйРежим(Истина);
		Запись.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	// После завершения предыдущего регламентного интервала -> попытка создания нового регламентного интервала для запущенных по документу задач
	
	// Поиск задач - последователей только что выполненной задачи
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка КАК Ссылка,
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка.Дата КАК Дата,
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка.Предмет КАК Предмет,
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка.Шаблон КАК Шаблон,
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка.Исполнитель КАК Исполнитель,
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка.РольИсполнителя КАК РольИсполнителя,
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
	|	ЗадачаПоОбработкеДокументаПредшественники.Ссылка.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента.Предшественники КАК ЗадачаПоОбработкеДокументаПредшественники
	|ГДЕ
	|	ЗадачаПоОбработкеДокументаПредшественники.ЗадачаПредшественник = &ЗадачаПредшественник
	|	И НЕ ЗадачаПоОбработкеДокументаПредшественники.Ссылка.Выполнена
	|	И НЕ ЗадачаПоОбработкеДокументаПредшественники.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ЗадачаПредшественник", Задача.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		
		РегламентныйИнтервалДокумента = СоздатьРегламентныйИнтервал(Выборка);
		
		Если НЕ ЗначениеЗаполнено(РегламентныйИнтервалДокумента.РегламентныйИнтервал) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЗадачаОбъект.РегламентныйИнтервал = РегламентныйИнтервалДокумента.РегламентныйИнтервал;
		ЗадачаОбъект.НомерИтерации = РегламентныйИнтервалДокумента.НомерИтерации;
		ЗадачаОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеРегламентнымиИнтерваламиПриОтменеВыполненияЗадачи(Задача, ПрерванныеЗадачи, ВосстановленныеЗадачи)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьРегламентныеИнтервалы") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(Задача.РегламентныйИнтервал) Тогда
		ВосстановитьРегламентныйИнтервал(Задача.Предмет, Задача.РегламентныйИнтервал, Задача.НомерИтерации);
	КонецЕсли;
	
	Для Каждого ПрерваннаяЗадача Из ПрерванныеЗадачи Цикл
		Если ЗначениеЗаполнено(ПрерваннаяЗадача.РегламентныйИнтервал)
			И ПрерваннаяЗадача.РегламентныйИнтервал <> Задача.РегламентныйИнтервал Тогда
			ПрерватьРегламентныйИнтервал(ПрерваннаяЗадача.Предмет, ПрерваннаяЗадача.РегламентныйИнтервал, ПрерваннаяЗадача.НомерИтерации);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ВосстановленнаяЗадача Из ВосстановленныеЗадачи Цикл
		Если ЗначениеЗаполнено(ВосстановленнаяЗадача.РегламентныйИнтервал)
			И ВосстановленнаяЗадача.РегламентныйИнтервал <> Задача.РегламентныйИнтервал Тогда
			ВосстановитьРегламентныйИнтервал(ВосстановленнаяЗадача.Предмет, ВосстановленнаяЗадача.РегламентныйИнтервал, ВосстановленнаяЗадача.НомерИтерации);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеРегламентнымиИнтерваламиПриСозданииЗадачи(Задача)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьРегламентныеИнтервалы") Тогда
		Возврат;
	КонецЕсли;
	
	РегламентныйИнтервалДокумента = АктивныйРегламентныйИнтервалДокумента(Задача.Предмет);
	Если ЗначениеЗаполнено(РегламентныйИнтервалДокумента.РегламентныйИнтервал) Тогда
		ЭтапыРегламентногоИнтервала = ЭтапыРегламентногоИнтервалаДокумента(Задача.Предмет,
			РегламентныйИнтервалДокумента.РегламентныйИнтервал, РегламентныйИнтервалДокумента.НомерИтерации);
		СвойстваЭтапа = ЭтапыРегламентногоИнтервала.Найти(Задача.ИдентификаторЭтапа, "ИдентификаторЭтапа");
		// Есть активный регламентный интервал документа -> проверка, входит ли задача в текущий регламентный интервал
		Если СвойстваЭтапа = Неопределено Тогда
			// Новая задача не входит в регламентный интервал
		Иначе
			// Задача входит в регламентный интервал: запись реквизитов задачи
			Задача.РегламентныйИнтервал = РегламентныйИнтервалДокумента.РегламентныйИнтервал;
			Задача.НомерИтерации = РегламентныйИнтервалДокумента.НомерИтерации;
			
			Задача.СрокВыполненияЧасы = СвойстваЭтапа.СрокВыполненияЧасы;
			
			РеквизитыАдресации = Новый Структура("Исполнитель, РольИсполнителя, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации");
			ЗаполнитьЗначенияСвойств(РеквизитыАдресации, Задача);
			
			Сроки = СрокиВыполненияИНапоминания(РеквизитыАдресации, Задача.Дата, , Задача.СрокВыполненияЧасы);
			
			Задача.СрокВыполнения = Сроки.СрокВыполнения;
			Задача.СрокНапоминания = Сроки.СрокНапоминания;
			
		КонецЕсли;
	Иначе
		// Нет активного регламентного интервала документа -> попытка создания нового регламентного интервала
		РегламентныйИнтервалДокумента = СоздатьРегламентныйИнтервал(Задача);
		
		Если НЕ ЗначениеЗаполнено(РегламентныйИнтервалДокумента.РегламентныйИнтервал) Тогда
			Возврат;
		КонецЕсли;
		
		Задача.РегламентныйИнтервал = РегламентныйИнтервалДокумента.РегламентныйИнтервал;
		Задача.НомерИтерации = РегламентныйИнтервалДокумента.НомерИтерации;
		
		Задача.СрокВыполненияЧасы = РегламентныйИнтервалДокумента.СрокВыполненияЧасы;
		
		РеквизитыАдресации = Новый Структура("Исполнитель, РольИсполнителя, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации");
		ЗаполнитьЗначенияСвойств(РеквизитыАдресации, Задача);
		
		Сроки = СрокиВыполненияИНапоминания(РеквизитыАдресации, Задача.Дата, , Задача.СрокВыполненияЧасы);
		
		Задача.СрокВыполнения = Сроки.СрокВыполнения;
		Задача.СрокНапоминания = Сроки.СрокНапоминания;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтапыРегламентногоИнтервалаДокумента(Документ, РегламентныйИнтервал, НомерИтерации)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭтапыРегламентногоИнтервалаДокумента.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ЭтапыРегламентногоИнтервалаДокумента.СрокВыполненияЧасы КАК СрокВыполненияЧасы
	|ИЗ
	|	РегистрСведений.ЭтапыРегламентногоИнтервалаДокумента КАК ЭтапыРегламентногоИнтервалаДокумента
	|ГДЕ
	|	ЭтапыРегламентногоИнтервалаДокумента.Предмет = &Предмет
	|	И ЭтапыРегламентногоИнтервалаДокумента.РегламентныйИнтервал = &РегламентныйИнтервал
	|	И ЭтапыРегламентногоИнтервалаДокумента.НомерИтерации = &НомерИтерации";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	Запрос.УстановитьПараметр("РегламентныйИнтервал", РегламентныйИнтервал);
	Запрос.УстановитьПараметр("НомерИтерации", НомерИтерации);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СоздатьРегламентныйИнтервал(Параметры)
	
	Результат = Новый Структура;
	Результат.Вставить("РегламентныйИнтервал");
	Результат.Вставить("НомерИтерации");
	Результат.Вставить("СрокВыполненияЧасы");
	
	РеквизитыАдресации = Новый Структура("Исполнитель, РольИсполнителя, ОсновнойОбъектАдресации, ДополнительныйОбъектАдресации");
	ЗаполнитьЗначенияСвойств(РеквизитыАдресации, Параметры);
	
	РегламентныйИнтервал = РегламентныйИнтервалДляЗапуска(Параметры.Шаблон, Параметры.ИдентификаторЭтапа);
	
	Если Не ЗначениеЗаполнено(РегламентныйИнтервал) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НомерИтерации = ПоследнийНомерИтерацииРегламентногоИнтервалаДокумента(Параметры.Предмет, РегламентныйИнтервал) + 1;
	
	ИдентификаторыИСрокиЭтапов = ИдентификаторыИСрокиВыполненияЭтапов(РегламентныйИнтервал, РеквизитыАдресации, Параметры.Дата);
	
	Если ИдентификаторыИСрокиЭтапов.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Регламентный интервал не создан: не заполнены сроки выполнения этапов по регламенту'"));
		Возврат Результат;
	КонецЕсли;
	
	Запись = РегистрыСведений.РегламентныеИнтервалыДокументов.СоздатьМенеджерЗаписи();
	Запись.Предмет = Параметры.Предмет;
	Запись.РегламентныйИнтервал = РегламентныйИнтервал;
	Запись.НомерИтерации = НомерИтерации;
	Запись.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияРегламентныхИнтервалов.Активен");
	Запись.ДатаСоздания = Параметры.Дата;
	Запись.Срок = ИдентификаторыИСрокиЭтапов[ИдентификаторыИСрокиЭтапов.Количество() - 1].СрокПоРегламенту;
	Запись.ИдентификаторКонечногоЭтапа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РегламентныйИнтервал, "ИдентификаторКонечногоЭтапа");
	
	УстановитьПривилегированныйРежим(Истина);
	Запись.Записать(Ложь);
	УстановитьПривилегированныйРежим(Ложь);
	
	Набор = РегистрыСведений.ЭтапыРегламентногоИнтервалаДокумента.СоздатьНаборЗаписей();
	Набор.Отбор.Предмет.Установить(Параметры.Предмет);
	Набор.Отбор.РегламентныйИнтервал.Установить(РегламентныйИнтервал);
	Набор.Отбор.НомерИтерации.Установить(НомерИтерации);
	Для Каждого ИдентификаторИСрокЭтапа Из ИдентификаторыИСрокиЭтапов Цикл
		Запись = Набор.Добавить();
		Запись.Предмет = Параметры.Предмет;
		Запись.РегламентныйИнтервал = РегламентныйИнтервал;
		Запись.НомерИтерации = НомерИтерации;
		Запись.ИдентификаторЭтапа = ИдентификаторИСрокЭтапа.ИдентификаторЭтапа;
		Запись.СрокПоРегламенту = ИдентификаторИСрокЭтапа.СрокПоРегламенту;
		Запись.СрокНапоминания = ИдентификаторИСрокЭтапа.СрокНапоминания;
		Запись.СрокВыполненияЧасы = ИдентификаторИСрокЭтапа.СрокВыполненияЧасы;
		Если Параметры.ИдентификаторЭтапа = ИдентификаторИСрокЭтапа.ИдентификаторЭтапа Тогда
			Результат.СрокВыполненияЧасы = ИдентификаторИСрокЭтапа.СрокВыполненияЧасы;
		КонецЕсли;
	КонецЦикла;
	Набор.Записать(Ложь);
	
	Результат.РегламентныйИнтервал = РегламентныйИнтервал;
	Результат.НомерИтерации = НомерИтерации;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьАктивныеЗадачиПоРегламентномуИнтервалуДокумента(Документ, РегламентныйИнтервал, НомерИтерации)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Задача
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Предмет = &Предмет
	|	И ЗадачаПоОбработкеДокумента.РегламентныйИнтервал = &РегламентныйИнтервал
	|	И ЗадачаПоОбработкеДокумента.НомерИтерации = &НомерИтерации
	|	И НЕ ЗадачаПоОбработкеДокумента.Выполнена
	|	И НЕ ЗадачаПоОбработкеДокумента.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	Запрос.УстановитьПараметр("РегламентныйИнтервал", РегламентныйИнтервал);
	Запрос.УстановитьПараметр("НомерИтерации", НомерИтерации);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция РегламентныйИнтервалДляЗапуска(Шаблон, ИдентификаторНачальногоЭтапа)
	
	СтандартнаяОбработка = Истина;
	РегламентныйИнтервал = ПроцессыОбработкиДокументовПереопределяемый.РегламентныйИнтервалДляЗапуска(
		Шаблон, ИдентификаторНачальногоЭтапа, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Возврат РегламентныйИнтервал;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДействующиеРегламентныеИнтервалы.РегламентныйИнтервал КАК РегламентныйИнтервал
	|ИЗ
	|	РегистрСведений.ДействующиеРегламентныеИнтервалы КАК ДействующиеРегламентныеИнтервалы
	|ГДЕ
	|	ДействующиеРегламентныеИнтервалы.Шаблон = &Шаблон
	|	И ДействующиеРегламентныеИнтервалы.ИдентификаторНачальногоЭтапа = &ИдентификаторНачальногоЭтапа";
	
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторНачальногоЭтапа", ИдентификаторНачальногоЭтапа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РегламентныйИнтервал;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПоследнийНомерИтерацииРегламентногоИнтервалаДокумента(Документ, РегламентныйИнтервал)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегламентныеИнтервалыДокументов.НомерИтерации КАК НомерИтерации
	|ИЗ
	|	РегистрСведений.РегламентныеИнтервалыДокументов КАК РегламентныеИнтервалыДокументов
	|ГДЕ
	|	РегламентныеИнтервалыДокументов.Предмет = &Предмет
	|	И РегламентныеИнтервалыДокументов.РегламентныйИнтервал = &РегламентныйИнтервал
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерИтерации УБЫВ";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	Запрос.УстановитьПараметр("РегламентныйИнтервал", РегламентныйИнтервал);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НомерИтерации;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ИдентификаторыИСрокиВыполненияЭтапов(РегламентныйИнтервал, РеквизитыАдресации, ДатаОтсчета)
	
	Если РегламентныйИнтервал.СрокЗависитОтВремениНачала
		И ВремяИзДаты(ДатаОтсчета) >= РегламентныйИнтервал.ВремяНачала Тогда
		Постфикс = "После";
	Иначе
		Постфикс = "";
	КонецЕсли;
	
	КоличествоЧасов = РегламентныйИнтервал["СрокВыполненияЧасы" + Постфикс];
	КоличествоДней = РегламентныйИнтервал["СрокВыполненияДни" + Постфикс];
	СпособУказанияВремениОкончания = РегламентныйИнтервал["СпособУказанияВремениОкончания" + Постфикс];
	ВремяОкончания = РегламентныйИнтервал["ВремяОкончания" + Постфикс];
	
	ИнтервалыРабочегоВремени = ПустаяТаблицаРабочегоВремени();
	СтандартнаяОбработка = Истина;
	ГрафикРаботы = Неопределено;
	
	Если Константы.ИспользоватьГрафикиРаботы.Получить() Тогда
		ГрафикРаботы = ГрафикРаботыИсполнителя(РеквизитыАдресации, СтандартнаяОбработка);
		Если СтандартнаяОбработка И Не ЗначениеЗаполнено(ГрафикРаботы) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Срок выполнения регламентного интервала не рассчитан'"));
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
		СрокВыполенияИнтервала = СрокВыполненияПоГрафикуРаботы(ГрафикРаботы, СтандартнаяОбработка,
			ДатаОтсчета, КоличествоДней, КоличествоЧасов, ИнтервалыРабочегоВремени);
		Если СпособУказанияВремениОкончания = 0 И КоличествоЧасов = 0 Тогда
			СрокВыполенияИнтервала = КонецРабочегоДняПоРасписанию(СрокВыполенияИнтервала, ИнтервалыРабочегоВремени);
		ИначеЕсли СпособУказанияВремениОкончания = 1 И КоличествоЧасов = 0  Тогда
			СрокВыполенияИнтервала = ДобавитьВремя(СрокВыполенияИнтервала, ВремяОкончания)
		КонецЕсли;
	Иначе
		СрокВыполенияИнтервала = ДатаОтсчета + КоличествоДней * 24 * 60 * 60 + КоличествоЧасов * 60 * 60;
		Если СпособУказанияВремениОкончания = 0 И КоличествоЧасов = 0  Тогда
			СрокВыполенияИнтервала = КонецДня(СрокВыполенияИнтервала);
		ИначеЕсли СпособУказанияВремениОкончания = 1 И КоличествоЧасов = 0  Тогда
			СрокВыполенияИнтервала = ДобавитьВремя(СрокВыполенияИнтервала, ВремяОкончания)
		КонецЕсли;
	КонецЕсли;
	
	// Расчет сроков выполнения этапов регламентного интервала
	Предшественники = РегламентныйИнтервал.ПредшественникиЭтапов;
	
	Результат = РегламентныйИнтервал.Этапы.Выгрузить(, "ИдентификаторЭтапа, СрокВыполненияЧасы");
	Результат.Колонки.Добавить("СрокПоРегламенту");
	Результат.Колонки.Добавить("СрокНапоминания");
	Результат.Колонки.Добавить("НачалоЭтапаНеПозднее");
	
	РасчетРегламентныхСроковЭтапаИЕгоПредшественников(Результат, РегламентныйИнтервал.ИдентификаторКонечногоЭтапа,
		СрокВыполенияИнтервала, ИнтервалыРабочегоВремени, ГрафикРаботы, СтандартнаяОбработка, Предшественники, Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

Функция ДатаПоГрафикуДоНаступленияСрока(ИнтервалыРабочегоВремени, ГрафикРаботы, СтандартнаяОбработка, Срок, Знач СрокВСекундах)
	
	Если СрокВСекундах = 0 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	ДатаПоГрафику = Неопределено;
	
	//Обход таблицы интервалов в обратном порядке
	КоличествоЭлементовКоллекции = ИнтервалыРабочегоВремени.Количество();
	Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
		Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
		Интервал = ИнтервалыРабочегоВремени[Индекс];
		
		Если Срок < Интервал.ДатаНачала Тогда
			Продолжить;
		КонецЕсли;
		
		Если Срок > Интервал.ДатаОкончания Тогда
			ДлительностьИнтервала = Интервал.Длительность;
			ДатаОкончанияПоРасписанию = Интервал.ДатаОкончания;
		Иначе
			ДлительностьИнтервала = Срок - Интервал.ДатаНачала;
			ДатаОкончанияПоРасписанию = Срок;
		КонецЕсли;
		
		Если СрокВСекундах > ДлительностьИнтервала Тогда
			СрокВСекундах = СрокВСекундах - ДлительностьИнтервала;
			ДатаПоГрафику = Интервал.ДатаНачала;
		Иначе
			ДатаПоГрафику = ДатаОкончанияПоРасписанию - СрокВСекундах;
			СрокВСекундах = 0;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ДатаПоГрафику = ?(ДатаПоГрафику = Неопределено, Срок, ДатаПоГрафику);
	
	// Если время не выбрано, то требуется дополнительно запросить рабочее расписание "в прошлое"
	ДатаНачала = ДатаПоГрафику;
	
	НезаполненоПериодов = 0;
	ПоследняяДатаЗаполненногоГрафика = ДатаНачала;
	
	Пока СрокВСекундах > 0 Цикл
		
		ДатаОкончания = ДатаНачала;
		ДатаНачала = НачалоДня(ДатаОкончания - 86400);
		
		ДополнительныеИнтервалыРабочегоВремени = РасписаниеРаботыНаПериод(ГрафикРаботы, ДатаНачала, ДатаОкончания, СтандартнаяОбработка);
		
		//Обход таблицы интервалов в обратном порядке
		КоличествоЭлементовКоллекции = ДополнительныеИнтервалыРабочегоВремени.Количество();
		Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
			Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
			Интервал = ДополнительныеИнтервалыРабочегоВремени[Индекс];
			
			Если ИнтервалыРабочегоВремени.Найти(Интервал.ДатаНачала, "ДатаНачала") = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ИнтервалыРабочегоВремени.Добавить(), Интервал);
			КонецЕсли;
			
			Если ДатаОкончания < Интервал.ДатаНачала Тогда
				Продолжить;
			КонецЕсли;
			
			Если ДатаОкончания > Интервал.ДатаОкончания Тогда
				ДлительностьИнтервала = Интервал.Длительность;
				ДатаОкончанияПоРасписанию = Интервал.ДатаОкончания;
			Иначе
				ДлительностьИнтервала = ДатаОкончания - Интервал.ДатаНачала;
				ДатаОкончанияПоРасписанию = ДатаОкончания;
			КонецЕсли;
			
			Если СрокВСекундах > ДлительностьИнтервала Тогда
				СрокВСекундах = СрокВСекундах - ДлительностьИнтервала;
			Иначе
				ДатаПоГрафику = ДатаОкончанияПоРасписанию - СрокВСекундах;
				СрокВСекундах = 0;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если КоличествоЭлементовКоллекции = 0 Тогда
			НезаполненоПериодов = НезаполненоПериодов + 1;
			Если НезаполненоПериодов > 100 Тогда
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Невозможно определить ближайшую дату, включенную в график %1, предшествующую дате %2,
						|возможно, график работы не заполнен.'"),
						ГрафикРаботы, Формат(ПоследняяДатаЗаполненногоГрафика, "ДЛФ=D"));
			КонецЕсли;
		Иначе
			НезаполненоПериодов = 0;
			ПоследняяДатаЗаполненногоГрафика = ДатаНачала;
		КонецЕсли;
		
	КонецЦикла;
	
	ИнтервалыРабочегоВремени.Сортировать("ДатаНачала");
	
	Возврат ДатаПоГрафику;
	
КонецФункции

Функция КонецРабочегоДняПоРасписанию(Срок, ИнтервалыРабочегоВремени)
	
	КонецРабочегоДня = НачалоДня(Срок);
	
	Для Каждого Интервал Из ИнтервалыРабочегоВремени Цикл
		Если НачалоДня(КонецРабочегоДня) = НачалоДня(Интервал.ДатаОкончания) Тогда
			КонецРабочегоДня = Макс(КонецРабочегоДня, Интервал.ДатаОкончания);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ?(КонецРабочегоДня > Срок, КонецРабочегоДня, Срок);
	
КонецФункции

Процедура ПроложитьМаршрутыДоКонечногоЭтапа(Маршруты, МаршрутБазовый, ТаблицаПредшественников, ПройденныеЭтапы, ИдентификаторКонечногоЭтапа)
	
	// Проверка граничного условия: если последний элемент маршрута и есть конечный этап, то маршрут добавляется в список возможных маршрутов
	Если МаршрутБазовый[МаршрутБазовый.ВГраница()] = ИдентификаторКонечногоЭтапа Тогда
		Маршруты.Добавить(МаршрутБазовый);
		Возврат;
	КонецЕсли;
	
	Последователи = ТаблицаПредшественников.НайтиСтроки(Новый Структура("ИдентификаторПредшественника", МаршрутБазовый[МаршрутБазовый.ВГраница()]));
	
	ПройденныеЭтапы.Вставить(МаршрутБазовый[МаршрутБазовый.ВГраница()], Истина);
	
	Для Каждого Последователь Из Последователи Цикл
		Если ПройденныеЭтапы.Получить(Последователь.ИдентификаторПоследователя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Маршрут = ОбщегоНазначения.СкопироватьРекурсивно(МаршрутБазовый);
		Маршрут.Добавить(Последователь.ИдентификаторПоследователя);
		ПройденныеЭтапыМаршрута = ОбщегоНазначенияКлиентСервер.СкопироватьСоответствие(ПройденныеЭтапы);
		ПроложитьМаршрутыДоКонечногоЭтапа(Маршруты, Маршрут, ТаблицаПредшественников, ПройденныеЭтапыМаршрута, ИдентификаторКонечногоЭтапа);
	КонецЦикла;
	
КонецПроцедуры

Функция ДобавитьПоследовательнуюГруппуВДерево(Родитель)
	
	Группа = Родитель.ПолучитьЭлементы().Добавить();
	Группа.ИдентификаторЭтапа = "Последовательно";
	Группа.ПредставлениеЭтапа = "Последовательные этапы";
	
	Возврат Группа;
	
КонецФункции

Функция ДобавитьПараллельнуюГруппуВДерево(Родитель)
	
	Группа = Родитель.ПолучитьЭлементы().Добавить();
	Группа.ИдентификаторЭтапа = "Параллельно";
	Группа.ПредставлениеЭтапа = "Параллельные этапы";
	
	Возврат Группа;
	
КонецФункции

Процедура ОбъединениеГруппЭтаповДерева(ДеревоЭтапов)
	
	Для Каждого ЭлементПервогоУровня Из ДеревоЭтапов.ПолучитьЭлементы() Цикл
		Если ЭлементПервогоУровня.ИдентификаторЭтапа = "Параллельно" Тогда
			СтрокиСОбщимиЭтапами = Новый Соответствие;
			Для Каждого ЭлементВторогоУровня Из ЭлементПервогоУровня.ПолучитьЭлементы() Цикл
				Если ЭлементВторогоУровня.ИдентификаторЭтапа = "Последовательно" Тогда
					Для Каждого ЭлементТретьегоУровня Из ЭлементВторогоУровня.ПолучитьЭлементы() Цикл
						Если ТипЗнч(ЭлементТретьегоУровня.ИдентификаторЭтапа) = Тип("УникальныйИдентификатор") Тогда
							СтрокиСОбщимЭтапом = СтрокиСОбщимиЭтапами.Получить(ЭлементТретьегоУровня.ИдентификаторЭтапа);
							Если СтрокиСОбщимЭтапом = Неопределено Тогда
								СтрокиСОбщимиЭтапами.Вставить(ЭлементТретьегоУровня.ИдентификаторЭтапа, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЭлементВторогоУровня));
							Иначе
								СтрокиСОбщимЭтапом.Добавить(ЭлементВторогоУровня);
								СтрокиСОбщимиЭтапами.Вставить(ЭлементТретьегоУровня.ИдентификаторЭтапа, СтрокиСОбщимЭтапом);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			Для Каждого СтрокиСОбщимЭтапом Из СтрокиСОбщимиЭтапами Цикл
				Если СтрокиСОбщимЭтапом.Значение.Количество() < 2 Тогда
					Продолжить;
				КонецЕсли;
				ЭлементВторогоУровня = ДобавитьПоследовательнуюГруппуВДерево(ЭлементПервогоУровня);
				ЭлементТретьегоУровня = ДобавитьПараллельнуюГруппуВДерево(ЭлементВторогоУровня);
				СтрокаСОбщимЭтапом = Неопределено;
				Для Каждого ГруппаСОбщимЭтапом Из СтрокиСОбщимЭтапом.Значение Цикл
					НоваяГруппаОставшихсяЭтапов = Неопределено;
					Для Каждого СтрокаГруппы Из ГруппаСОбщимЭтапом.ПолучитьЭлементы() Цикл
						Если СтрокаГруппы.ИдентификаторЭтапа = СтрокиСОбщимЭтапом.Ключ Тогда
							ДобавитьОбщийЭтапВНачало = ГруппаСОбщимЭтапом.ПолучитьЭлементы().Индекс(СтрокаГруппы) = 0;
							СтрокаСОбщимЭтапом = СтрокаГруппы;
						Иначе
							Если НоваяГруппаОставшихсяЭтапов = Неопределено Тогда
								НоваяГруппаОставшихсяЭтапов = ДобавитьПоследовательнуюГруппуВДерево(ЭлементТретьегоУровня);
							КонецЕсли;
							ЗаполнитьЗначенияСвойств(НоваяГруппаОставшихсяЭтапов.ПолучитьЭлементы().Добавить(), СтрокаГруппы);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				Если ДобавитьОбщийЭтапВНачало Тогда
					ЗаполнитьЗначенияСвойств(ЭлементВторогоУровня.ПолучитьЭлементы().Вставить(0), СтрокаСОбщимЭтапом);
				Иначе
					ЗаполнитьЗначенияСвойств(ЭлементВторогоУровня.ПолучитьЭлементы().Добавить(), СтрокаСОбщимЭтапом);
				КонецЕсли;
				Для Каждого ГруппаСОбщимЭтапом Из СтрокиСОбщимЭтапом.Значение Цикл
					ЭлементПервогоУровня.ПолучитьЭлементы().Удалить(ГруппаСОбщимЭтапом);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УпроститьДерево(Дерево)
	
	// Упрощение дерева достигается удалением групп вида "Параллельно" и "Последовательно",
	// если они содержат всего один элемент с переносом этого элемента выше, на уровень группы.
	// Если в корневом элементе есть группа вида "Последовательно", то ее содержимое также
	// переносится выше, а группа удаляется
	Для Каждого ЭлементДерева Из Дерево.ПолучитьЭлементы() Цикл
		Если ЭлементДерева.ИдентификаторЭтапа = "Параллельно" ИЛИ ЭлементДерева.ИдентификаторЭтапа = "Последовательно" Тогда
			ДочерниеЭлементы = ЭлементДерева.ПолучитьЭлементы();
			Если ДочерниеЭлементы.Количество() = 1 Тогда
				ИндексЭлементаДерева = Дерево.ПолучитьЭлементы().Индекс(ЭлементДерева);
				СкопироватьДерево(Дерево.ПолучитьЭлементы().Вставить(ИндексЭлементаДерева), ДочерниеЭлементы[0]);
				Дерево.ПолучитьЭлементы().Удалить(ЭлементДерева);
				ЭлементДерева = Дерево.ПолучитьЭлементы().Получить(ИндексЭлементаДерева);
			КонецЕсли;
			УпроститьДерево(ЭлементДерева);
		КонецЕсли;
		Если ЭлементДерева.ИдентификаторЭтапа = "Последовательно" И ЭлементДерева.ПолучитьРодителя() = Неопределено Тогда
			ИндексЭлементаДерева = Дерево.ПолучитьЭлементы().Индекс(ЭлементДерева);
			Для Каждого ДочернийЭлемент Из ЭлементДерева.ПолучитьЭлементы() Цикл
				СкопироватьДерево(Дерево.ПолучитьЭлементы().Вставить(ИндексЭлементаДерева), ДочернийЭлемент);
				ИндексЭлементаДерева = ИндексЭлементаДерева + 1;
			КонецЦикла;
			Дерево.ПолучитьЭлементы().Удалить(ЭлементДерева);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьДерево(ЭлементПриемник, ЭлементИсточник)
	
	ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);
	
	Для Каждого ДочернийЭлементИсточник Из ЭлементИсточник.ПолучитьЭлементы() Цикл
		СкопироватьДерево(ЭлементПриемник.ПолучитьЭлементы().Добавить(), ДочернийЭлементИсточник);
	КонецЦикла;
	
КонецПроцедуры

Функция ВыборкаИспользуемыхШаблоновДокумента(ИдентификаторДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкаИспользованияШаблонов.Шаблон КАК Шаблон,
	|	НастройкаИспользованияШаблонов.УсловиеИспользования КАК УсловиеИспользования,
	|	ШаблоныПроцессов.НачальныйСтатус КАК Статус
	|ИЗ
	|	РегистрСведений.НастройкаИспользованияШаблонов КАК НастройкаИспользованияШаблонов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов КАК ШаблоныПроцессов
	|		ПО НастройкаИспользованияШаблонов.Шаблон = ШаблоныПроцессов.Ссылка
	|ГДЕ
	|	НастройкаИспользованияШаблонов.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И НастройкаИспользованияШаблонов.Использовать";
	
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	
	Если ТипЗнч(ИдентификаторДокумента) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "= &ИдентификаторДокумента", "В (&ИдентификаторДокумента)");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура УправлениеИсполнителямиГрупповогоЭтапаПриЗапускеЭтапа(Документ, ИсполнителиЭтапа, СвойстваЭтапа)
	
	Если НЕ СвойстваЭтапа.ЭтапВыполняетсяНесколькимиИсполнителями Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ИсполнителиГрупповогоЭтапа.НомерИтерации), 0) КАК НомерИтерации
	|ИЗ
	|	РегистрСведений.ИсполнителиГрупповогоЭтапа КАК ИсполнителиГрупповогоЭтапа
	|ГДЕ
	|	ИсполнителиГрупповогоЭтапа.Предмет = &Предмет
	|	И ИсполнителиГрупповогоЭтапа.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", СвойстваЭтапа.ИдентификаторЭтапа);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НомерИтерации = Выборка.НомерИтерации + 1;
	Иначе
		НомерИтерации = 1;
	КонецЕсли;
	
	Для Индекс = 0 По ИсполнителиЭтапа.ВГраница() Цикл
		
		Запись = РегистрыСведений.ИсполнителиГрупповогоЭтапа.СоздатьМенеджерЗаписи();
		Запись.Предмет = Документ;
		Запись.ИдентификаторЭтапа = СвойстваЭтапа.ИдентификаторЭтапа;
		Запись.НомерИтерации = НомерИтерации;
		Запись.ПорядковыйНомер = Индекс + 1;
		Запись.Исполнитель = ИсполнителиЭтапа[Индекс].Исполнитель;
		Запись.РольИсполнителя = ИсполнителиЭтапа[Индекс].РольИсполнителя;
		Запись.ОсновнойОбъектАдресации = ИсполнителиЭтапа[Индекс].ОсновнойОбъектАдресации;
		Запись.ДополнительныйОбъектАдресации = ИсполнителиЭтапа[Индекс].ДополнительныйОбъектАдресации;
		Если ИсполнителиЭтапа[Индекс].Свойство("Задача") Тогда
			Запись.Задача = ИсполнителиЭтапа[Индекс].Задача;
		КонецЕсли;
		
		Запись.Записать(Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеИсполнителямиГрупповогоЭтапаПриОтменеВыполненияЗадачи(Задача, ПрерванныеЗадачи)
	
	// Если среди прерванных задач есть групповые, то необходимо по ним очистить регистр исполнителей
	// Если эти групповые задачи были прерваны ранее вручную, то по ним все равно необходимо очистить регистр
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсполнителиГрупповогоЭтапа.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ИсполнителиГрупповогоЭтапа.НомерИтерации КАК НомерИтерации
	|ИЗ
	|	РегистрСведений.ИсполнителиГрупповогоЭтапа КАК ИсполнителиГрупповогоЭтапа
	|ГДЕ
	|	ИсполнителиГрупповогоЭтапа.Предмет = &Предмет
	|	И ИсполнителиГрупповогоЭтапа.Задача В(&ПрерванныеЗадачи)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИсполнителиГрупповогоЭтапа.ИдентификаторЭтапа,
	|	ИсполнителиГрупповогоЭтапа.НомерИтерации";
	
	Запрос.УстановитьПараметр("Предмет", Задача.Предмет);
	Запрос.УстановитьПараметр("ПрерванныеЗадачи", ПрерванныеЗадачи);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Если отменяется выполнение задачи этого же этапа, то очищать регистр не требуется
		Если Задача.ИдентификаторЭтапа = Выборка.ИдентификаторЭтапа Тогда
			Продолжить;
		КонецЕсли;
		НаборЗаписей = РегистрыСведений.ИсполнителиГрупповогоЭтапа.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предмет.Установить(Задача.Предмет);
		НаборЗаписей.Отбор.ИдентификаторЭтапа.Установить(Выборка.ИдентификаторЭтапа);
		НаборЗаписей.Отбор.НомерИтерации.Установить(Выборка.НомерИтерации);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриВыполненииЗадачиКуратораГрупповогоЭтапа(Документ, Шаблон, ИдентификаторЭтапа, Задача)
	
	// Задача куратора не может быть выполнена, если имеются активные курируемые им задачи
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
	|	ЗадачаПоОбработкеДокумента.Выполнена КАК Выполнена,
	|	ЗадачаПоОбработкеДокумента.Прервана КАК Прервана,
	|	ВЫБОР
	|		КОГДА ЗадачиПрерванныхЭтапов.ЗадачаПреванногоЭтапа ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтапЗадачиПрерван
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО ЗадачаПоОбработкеДокумента.Шаблон = ШаблоныПроцессовЭтапы.Ссылка
	|			И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗадачиПрерванныхЭтапов КАК ЗадачиПрерванныхЭтапов
	|		ПО (ЗадачиПрерванныхЭтапов.ЗадачаПреванногоЭтапа = ЗадачаПоОбработкеДокумента.Ссылка)
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Предмет = &Предмет
	|	И ЗадачаПоОбработкеДокумента.Шаблон = &Шаблон
	|	И ШаблоныПроцессовЭтапы.ЭтапВыполняетсяНесколькимиИсполнителями
	|	И ШаблоныПроцессовЭтапы.ИдентификаторЭтапаКуратора = &ИдентификаторЭтапа";
	
	Запрос.УстановитьПараметр("Предмет", Документ);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", ИдентификаторЭтапа);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.Выполнена Тогда
			ТекстСообщения = НСтр("ru = 'Задача не может быть выполнена при наличии незавершенных курируемых задач'");
			ВызватьИсключение ТекстСообщения;
		ИначеЕсли НЕ Выборка.Прервана И НЕ Выборка.ЭтапЗадачиПрерван Тогда
			СохранитьСвязьСИнициаторамиПрерыванияЭтапа(
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Задача), Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура КонтрольИзмененияРеквизитовПередЗаписьюДокумента(Источник, Ссылка, Шаблон, ПараметрыТекущегоЭтапа, Отказ)
	
	Ошибки = Неопределено;
	
	КонтролируемыеРеквизиты = НедоступныеДляИзмененияРеквизиты(Шаблон, ПараметрыТекущегоЭтапа.ИдентификаторЭтапа);
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриКонтролеИзмененияРеквизитов(Источник, Ссылка, КонтролируемыеРеквизиты, ПараметрыТекущегоЭтапа, Отказ);
	
	ТаблицаТЧ = КонтролируемыеРеквизиты.Скопировать(,"ИмяТабличнойЧасти");
	ТаблицаТЧ.Свернуть("ИмяТабличнойЧасти");
	МассивТЧ = ТаблицаТЧ.ВыгрузитьКолонку("ИмяТабличнойЧасти");
	
	ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти","");
	ПроверяемыеРеквизиты = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "ИмяРеквизита");
	
	Для Каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
		
		Если Источник.ДополнительныеСвойства.ЭтоНовый Тогда
			Если ТипЗнч(Источник[ТекРеквизит.ИмяРеквизита]) = Тип("Булево") Тогда
				РеквизитЗаполнен = Источник[ТекРеквизит.ИмяРеквизита];
			Иначе
				РеквизитЗаполнен = ЗначениеЗаполнено(Источник[ТекРеквизит.ИмяРеквизита]);
			КонецЕсли;
			Если РеквизитЗаполнен Тогда
				ОписаниеРеквизита = Ссылка.Метаданные().Реквизиты.Найти(ТекРеквизит.ИмяРеквизита);
				Если ОписаниеРеквизита = Неопределено Тогда
					ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
				Иначе
					ПредставлениеРеквизита = ОписаниеРеквизита.Синоним;
				КонецЕсли;
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Был изменен реквизит ""%1"", который запрещен для изменения на этапе ""%2"".'"),
					ПредставлениеРеквизита,
					ПараметрыТекущегоЭтапа.Этап);
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "Объект."+ТекРеквизит.ИмяРеквизита, ТекстСообщения, Неопределено);
			КонецЕсли;
		//Для реквизитов типа "ХранилищеЗначения" сравниваются XML-представления
		ИначеЕсли ТипЗнч(Источник[ТекРеквизит.ИмяРеквизита]) = Тип("ХранилищеЗначения")
			И ТипЗнч(Ссылка[ТекРеквизит.ИмяРеквизита]) = Тип("ХранилищеЗначения") Тогда
			Если XMLСтрока(Источник[ТекРеквизит.ИмяРеквизита]) <> XMLСтрока(Ссылка[ТекРеквизит.ИмяРеквизита]) Тогда
				ОписаниеРеквизита = Ссылка.Метаданные().Реквизиты.Найти(ТекРеквизит.ИмяРеквизита);
				Если ОписаниеРеквизита = Неопределено Тогда
					ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
				Иначе
					ПредставлениеРеквизита = ОписаниеРеквизита.Синоним;
				КонецЕсли;
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Был изменен реквизит ""%1"", который запрещен для изменения на этапе ""%2""'"),
					ПредставлениеРеквизита,
					ПараметрыТекущегоЭтапа.Этап);
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "Объект."+ТекРеквизит.ИмяРеквизита, ТекстСообщения, Неопределено);
			КонецЕсли;
		ИначеЕсли Источник[ТекРеквизит.ИмяРеквизита] <> Ссылка[ТекРеквизит.ИмяРеквизита] Тогда
			ОписаниеРеквизита = Ссылка.Метаданные().Реквизиты.Найти(ТекРеквизит.ИмяРеквизита);
			Если ОписаниеРеквизита = Неопределено Тогда
				ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
			Иначе
				ПредставлениеРеквизита = ОписаниеРеквизита.Синоним;
			КонецЕсли;
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Был изменен реквизит ""%1"", который запрещен для изменения на этапе ""%2"".
				|Предыдущее значение реквизита - %3, новое значение реквизита - %4.'"),
				ПредставлениеРеквизита,
				ПараметрыТекущегоЭтапа.Этап,
				Ссылка[ТекРеквизит.ИмяРеквизита],
				Источник[ТекРеквизит.ИмяРеквизита]);
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "Объект."+ТекРеквизит.ИмяРеквизита, ТекстСообщения, Неопределено);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекТЧ Из МассивТЧ Цикл
		
		Если ПустаяСтрока(ТекТЧ) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеТЧ = Ссылка.Метаданные().ТабличныеЧасти.Найти(ТекТЧ);
		Если ОписаниеТЧ = Неопределено Тогда
			ПредставлениеТЧ = ТекТЧ;
		Иначе
			ПредставлениеТЧ = ОписаниеТЧ.Синоним;
		КонецЕсли;
		
		ОтборТЧ = Новый Структура("ИмяТабличнойЧасти,ИмяРеквизита",ТекТЧ,"");
		Если КонтролируемыеРеквизиты.НайтиСтроки(ОтборТЧ).Количество() > 0
			И Источник[ТекТЧ].Количество() <> Ссылка[ТекТЧ].Количество() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Изменено количество строк в табличной части ""%1"", которая запрещена для изменения на этапе ""%2"".
				|Предыдущее количество строк - %3, новое количество строк - %4.'"),
				ПредставлениеТЧ,
				ПараметрыТекущегоЭтапа.Этап,
				Ссылка[ТекТЧ].Количество(),
				Источник[ТекТЧ].Количество());
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "Объект."+ТекТЧ, ТекстСообщения, Неопределено);
		КонецЕсли;
		
		// Если ранее строк не было совсем, то сравнивать текущие строки не с чем
		Если Ссылка[ТекТЧ].Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти",ТекТЧ);
		ПроверяемыеРеквизиты = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "ИмяРеквизита");
		КоличествоСтрок = Мин(Источник[ТекТЧ].Количество(),Ссылка[ТекТЧ].Количество());
		Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
			СтрокаИсточник = Источник[ТекТЧ][ИндексСтроки];
			СтрокаСсылка = Ссылка[ТекТЧ][ИндексСтроки];
			Для Каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
				Если ПустаяСтрока(ТекРеквизит.ИмяРеквизита) Тогда
					Продолжить;
				КонецЕсли;
				Если Источник.ДополнительныеСвойства.ЭтоНовый Тогда
					Если ТипЗнч(СтрокаИсточник[ТекРеквизит.ИмяРеквизита]) = Тип("Булево") Тогда
						РеквизитЗаполнен = СтрокаИсточник[ТекРеквизит.ИмяРеквизита];
					Иначе
						РеквизитЗаполнен = ЗначениеЗаполнено(СтрокаИсточник[ТекРеквизит.ИмяРеквизита]);
					КонецЕсли;
					Если РеквизитЗаполнен Тогда
						
						Если ОписаниеТЧ <> Неопределено Тогда
							ОписаниеРеквизита = ОписаниеТЧ.Реквизиты.Найти(ТекРеквизит.ИмяРеквизита);
							Если ОписаниеРеквизита = Неопределено Тогда
								ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
							Иначе
								ПредставлениеРеквизита = ОписаниеРеквизита.Синоним;
							КонецЕсли;
						Иначе
							ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
						КонецЕсли;
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'В строке %1 табличной части ""%2"" был изменен реквизит ""%3"", который запрещен для изменения на этапе ""%4"".'"),
							ИндексСтроки + 1,
							ПредставлениеТЧ,
							ПредставлениеРеквизита,
							ПараметрыТекущегоЭтапа.Этап);
						ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
							"Объект."+ТекТЧ+"["+ИндексСтроки+"]."+ТекРеквизит.ИмяРеквизита,
							ТекстСообщения,
							Неопределено);
					КонецЕсли;
					
				//Для реквизитов типа "ХранилищеЗначения" сравниваются XML-представления
				ИначеЕсли ТипЗнч(СтрокаИсточник[ТекРеквизит.ИмяРеквизита]) = Тип("ХранилищеЗначения")
					И ТипЗнч(СтрокаСсылка[ТекРеквизит.ИмяРеквизита]) = Тип("ХранилищеЗначения") Тогда
					
					Если XMLСтрока(СтрокаИсточник[ТекРеквизит.ИмяРеквизита]) <> XMLСтрока(СтрокаСсылка[ТекРеквизит.ИмяРеквизита]) Тогда
					
						Если ОписаниеТЧ <> Неопределено Тогда
							ОписаниеРеквизита = ОписаниеТЧ.Реквизиты.Найти(ТекРеквизит.ИмяРеквизита);
							Если ОписаниеРеквизита = Неопределено Тогда
								ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
							Иначе
								ПредставлениеРеквизита = ОписаниеРеквизита.Синоним;
							КонецЕсли;
						Иначе
							ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
						КонецЕсли;
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'В строке %1 табличной части ""%2"" был изменен реквизит ""%3"", который запрещен для изменения на этапе ""%4""'"),
							ИндексСтроки + 1,
							ПредставлениеТЧ,
							ПредставлениеРеквизита,
							ПараметрыТекущегоЭтапа.Этап);
						ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
							"Объект."+ТекТЧ+"["+ИндексСтроки+"]."+ТекРеквизит.ИмяРеквизита,
							ТекстСообщения,
							Неопределено);
					КонецЕсли;
					
				ИначеЕсли СтрокаИсточник[ТекРеквизит.ИмяРеквизита] <> СтрокаСсылка[ТекРеквизит.ИмяРеквизита] Тогда
					
					Если ОписаниеТЧ <> Неопределено Тогда
						ОписаниеРеквизита = ОписаниеТЧ.Реквизиты.Найти(ТекРеквизит.ИмяРеквизита);
						Если ОписаниеРеквизита = Неопределено Тогда
							ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
						Иначе
							ПредставлениеРеквизита = ОписаниеРеквизита.Синоним;
						КонецЕсли;
					Иначе
						ПредставлениеРеквизита = ТекРеквизит.ИмяРеквизита;
					КонецЕсли;
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'В строке %1 табличной части ""%2"" был изменен реквизит ""%3"", который запрещен для изменения на этапе ""%4"".
						|Предыдущее значение реквизита - %5, новое значение реквизита - %6.'"),
						ИндексСтроки+1,
						ПредставлениеТЧ,
						ПредставлениеРеквизита,
						ПараметрыТекущегоЭтапа.Этап,
						СтрокаСсылка[ТекРеквизит.ИмяРеквизита],
						СтрокаИсточник[ТекРеквизит.ИмяРеквизита]);
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
						"Объект."+ТекТЧ+"["+ИндексСтроки+"]."+ТекРеквизит.ИмяРеквизита,
						ТекстСообщения,
						Неопределено);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Если НЕ Ошибки = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не выполнена запись документа %1'"), Ссылка));
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьСнятьПометкуУдаленияЗадачПередЗаписьюДокумента(Источник, Ссылка, Отказ)
	
	Если Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ПредыдущаяПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ПометкаУдаления");
	Если Источник.ПометкаУдаления = ПредыдущаяПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки = Неопределено;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
	|	ЗадачаПоОбработкеДокумента.Наименование КАК Наименование,
	|	ЗадачаПоОбработкеДокумента.Выполнена КАК Выполнена,
	|	ЗадачаПоОбработкеДокумента.ПринятаКИсполнению КАК ПринятаКИсполнению,
	|	ЗадачаПоОбработкеДокумента.Прервана КАК Прервана,
	|	ЗадачаПоОбработкеДокумента.Исполнитель КАК Исполнитель
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Предмет = &Документ";
	Запрос.УстановитьПараметр("Документ", Ссылка);
	
	ЗадачиДляОбработки = Новый Массив;
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Источник.ПометкаУдаления Тогда
			// Нельзя помечать на удаление документ, если есть выполненные непрерванные задачи
			Если Выборка.Выполнена И НЕ Выборка.Прервана Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Есть выполненная задача ""%1""'"),
								Выборка.Наименование);
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "", ТекстСообщения, Неопределено);
			// Нельзя помечать на удаление документ, если задача принята к исполнению другим пользователем
			ИначеЕсли НЕ Выборка.Прервана И Выборка.ПринятаКИсполнению И НЕ Выборка.Исполнитель = ТекущийПользователь Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Есть принятая к исполнению пользователем ""%1"" задача ""%2""'"),
								Выборка.Исполнитель,
								Выборка.Наименование);
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "", ТекстСообщения, Неопределено);
			Иначе
				ЗадачиДляОбработки.Добавить(Выборка.Ссылка);
			КонецЕсли;
		Иначе
			// Снимать пометку удаления можно всегда
			ЗадачиДляОбработки.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Ошибки = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось пометить на удаление документ %1'"), Ссылка));
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	Иначе
		УстановитьПометкуУдаленияЗадачи(ЗадачиДляОбработки, Источник.ПометкаУдаления);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияДополнительныхКолонокЗадач(Источник)
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Источник.Ссылка));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПутиКЗначениямДополнительныхКолонокЗадач.Колонка КАК Колонка,
	|	ПутиКЗначениямДополнительныхКолонокЗадач.ПутьКЗначению КАК ПутьКЗначению,
	|	ЗначенияДополнительныхКолонокЗадач.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ПутиКЗначениямДополнительныхКолонокЗадач КАК ПутиКЗначениямДополнительныхКолонокЗадач
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхКолонокЗадач КАК ЗначенияДополнительныхКолонокЗадач
	|		ПО ПутиКЗначениямДополнительныхКолонокЗадач.Колонка = ЗначенияДополнительныхКолонокЗадач.Колонка
	|			И (ЗначенияДополнительныхКолонокЗадач.Предмет = &Ссылка)
	|ГДЕ
	|	ПутиКЗначениямДополнительныхКолонокЗадач.ИдентификаторДокумента = &ИдентификаторДокумента";
	
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Значение = Источник[Выборка.ПутьКЗначению] Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Источник[Выборка.ПутьКЗначению]) = Тип("Строка")
			И Выборка.Значение = Лев(Источник[Выборка.ПутьКЗначению], 1024) Тогда
			Продолжить;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.ЗначенияДополнительныхКолонокЗадач.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Колонка = Выборка.Колонка;
		МенеджерЗаписи.Предмет = Источник.Ссылка;
		МенеджерЗаписи.Значение = Источник[Выборка.ПутьКЗначению];
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗапросДляЗаполненияДополнительнойКолонки(Колонка, ИдентификаторДокумента, ПутьКЗначению, КоличествоВВыборке)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	ТекущиеСтатусыДокументов.Предмет КАК Предмет,
	|	ВЫРАЗИТЬ(ТекущиеСтатусыДокументов.Предмет КАК Документ.ДополнительноеЗадание).Номер КАК Значение
	|ИЗ
	|	РегистрСведений.ТекущиеСтатусыДокументов КАК ТекущиеСтатусыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхКолонокЗадач КАК ЗначенияДополнительныхКолонокЗадач
	|		ПО ТекущиеСтатусыДокументов.Предмет = ЗначенияДополнительныхКолонокЗадач.Предмет
	|			И (ЗначенияДополнительныхКолонокЗадач.Колонка = &Колонка)
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ТекущиеСтатусыДокументов.Предмет) = &ТипДокумента
	|	И (ВЫРАЗИТЬ(ТекущиеСтатусыДокументов.Предмет КАК Документ.ДополнительноеЗадание).Номер <> ЗначенияДополнительныхКолонокЗадач.Значение
	|			ИЛИ ЗначенияДополнительныхКолонокЗадач.Значение ЕСТЬ NULL)";
	
	Запрос.УстановитьПараметр("Колонка", Колонка);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТипДокумента",
		"ТИП(" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "ПолноеИмя") + ")");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ДополнительноеЗадание",
	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "ПолноеИмя"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, ".Номер", "." + ПутьКЗначению);
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	МетаданныеРеквизита = МетаданныеДокумента.Реквизиты.Найти(ПутьКЗначению);
	Если МетаданныеРеквизита <> Неопределено
		И МетаданныеРеквизита.Тип.СодержитТип(ОбщегоНазначения.ОписаниеТипаСтрока(0).Типы()[0]) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И (ВЫРАЗИТЬ", "И (ВЫРАЗИТЬ(ВЫРАЗИТЬ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " <>", " КАК СТРОКА(1024)) <>");
	КонецЕсли;
	
	Если КоличествоВВыборке = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " ПЕРВЫЕ 1000", "");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " ПЕРВЫЕ 1000"," ПЕРВЫЕ " + Формат(КоличествоВВыборке, "ЧГ=0"));
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Функция ЗапросДляОчисткиДополнительнойКолонки(Колонка, ИдентификаторДокумента, КоличествоВВыборке)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Значения.Предмет КАК Предмет
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхКолонокЗадач КАК Значения
	|ГДЕ
	|	Значения.Колонка = &Колонка
	|	И ТИПЗНАЧЕНИЯ(Значения.Предмет) = &ТипДокумента";
	
	Запрос.УстановитьПараметр("Колонка", Колонка);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТипДокумента",
		"ТИП(" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "ПолноеИмя") + ")");
	
	Если КоличествоВВыборке = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " ПЕРВЫЕ 1000", "");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " ПЕРВЫЕ 1000"," ПЕРВЫЕ " + Формат(КоличествоВВыборке, "ЧГ=0"));
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Процедура УдалитьНедопустимыеСимволыПсевдонимаПоляЗапроса(СтрокаДляОбработки)
	
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "&", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "$", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "+", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "-", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "*", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, ",", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, ".", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "/", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "\", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, ":", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, ";", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "=", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "?", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "@", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "#", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "!", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "?", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "№", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "~", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "<", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, ">", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "[", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "]", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "{", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "}", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "(", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, ")", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "|", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "^", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "%", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "`", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, "'", "");
	СтрокаДляОбработки = СтрЗаменить(СтрокаДляОбработки, """", "");
	
КонецПроцедуры

Процедура ОтключитьМеханизмыОбъекта(Объект)
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
	Объект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
	
КонецПроцедуры

Процедура НастроитьЭлементыФормыПриОчисткеШаблонаПроцесса(Форма)
	
	Форма.ПроцессыОбработкиДокументов_ТекущийШаблон = ПредопределенноеЗначение("Справочник.ШаблоныПроцессов.ПустаяСсылка");
	Форма.ПроцессыОбработкиДокументов_ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыДокументов.ПустаяСсылка");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКомментарии", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ТекущийСтатус", "Видимость", Ложь);
	
	УдалитьКнопкиСКомандамиРезультатовВыполнения(Форма);
	
КонецПроцедуры

Функция ФайлЯвляетсяПервичнымДокументом(Файл)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПервичныеДокументыПОД.ПервичныйДокумент КАК ПервичныйДокумент
	|ИЗ
	|	РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
	|ГДЕ
	|	ПервичныеДокументыПОД.ПервичныйДокумент = &ПервичныйДокумент";
	
	Запрос.УстановитьПараметр("ПервичныйДокумент", Файл);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура СохранитьСвязьЗадачиИПодписанногоФайла(Файл, Задача, ИдентификаторЭтапа, ДатаПодписи, УстановившийПодпись)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запись = РегистрыСведений.ПрисоединенныеФайлыПодписанныеЗадачами.СоздатьМенеджерЗаписи();
	Запись.Задача = Задача;
	Запись.Файл = Файл;
	Запись.ИдентификаторЭтапа = ИдентификаторЭтапа;
	Запись.ДатаПодписи = ДатаПодписи;
	Запись.УстановившийПодпись = УстановившийПодпись;
	Запись.Записать();
	
КонецПроцедуры

Функция ФайлыПодписанныеЗадачами(Файлы)
	
	Если ТипЗнч(Файлы) = Тип("Массив") Тогда
		ФайлыДляЗапроса = Файлы;
	Иначе
		ФайлыДляЗапроса = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Файлы);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрисоединенныеФайлыПодписанныеЗадачами.Файл КАК Файл
	|ИЗ
	|	РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
	|ГДЕ
	|	ПрисоединенныеФайлыПодписанныеЗадачами.Файл В (&Файлы)";
	
	Запрос.УстановитьПараметр("Файлы", ФайлыДляЗапроса);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Файл");
	
КонецФункции

Функция ТабличныйДокументВДвоичныеДанные(ТабличныйДокумент, Формат)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ТабличныйДокумент.Записать(ИмяВременногоФайла, Формат);
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат ДвоичныеДанные;
	
КонецФункции

// Формирует таблицу команд печати для исключения из сценариев ПОД
//
// // Возвращаемое значение:
//           ТаблицаИсключений  - ТаблицаЗначений - таблица команд для исключения из ПОД
//                ** УчетныйДокумент    - ДокументСсылка - документ для которого применяется исключение.
//                ** ИдентификаторКомандыПечати - Строка - идентификатор команды.
//                ** ПричинаИсключенияКомандыПечати - Строка - текстовое сообщение для пользователя о причинах исключения из ПОД.
Функция ПодготовитьТаблицуИсключенийПервичныхДокументов() Экспорт
	
	ТаблицаИсключений = Новый ТаблицаЗначений;
	ТаблицаИсключений.Колонки.Добавить("УчетныйДокумент",				 Метаданные.ОпределяемыеТипы.ПредметПроцессаОбработкиДокументов.Тип);
	ТаблицаИсключений.Колонки.Добавить("ИдентификаторКомандыПечати",     Новый ОписаниеТипов("Строка"));
	ТаблицаИсключений.Колонки.Добавить("ПричинаИсключенияКомандыПечати", Новый ОписаниеТипов("Строка"));
	ТаблицаИсключений.Колонки.Добавить("СкрыватьКомандуПечати", 		 Новый ОписаниеТипов("Булево"));
	ТаблицаИсключений.Индексы.Добавить("УчетныйДокумент,ИдентификаторКомандыПечати");
	
	Возврат ТаблицаИсключений; 

КонецФункции

#Область УведомленияОЗадачах

// Возвращает адрес электронной почты пользователя Получатель для рассылки уведомлений о задачах.
//
// Параметры:
//  Получатель  - СправочникСсылка.Пользователи - исполнитель задачи.
//  Адрес       - Строка - возвращаемый адрес электронной почты.
//
//
Функция АдресЭлектроннойПочты(Получатель)
	
	Адрес = "";
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.КонтактнаяИнформация") Тогда
		МодульУправлениеКонтактнойИнформацией = ОбщегоНазначения.ОбщийМодуль("УправлениеКонтактнойИнформацией");
		Если ТипЗнч(Получатель) = Тип("СправочникСсылка.Пользователи") Тогда
			Адрес = МодульУправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Получатель, МодульУправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("EmailПользователя"));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

Функция СистемнаяУчетнаяЗаписьНастроена(ОписаниеОшибки)
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		ОписаниеОшибки = НСтр("ru = 'Отправка почты не предусмотрена в программе.'");
	Иначе
		МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
		Если МодульРаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), Истина, Ложь) Тогда
			Возврат Истина;
		КонецЕсли;
		ОписаниеОшибки = НСтр("ru = 'Системная учетная запись электронной почты не настроена для отправки.'");
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

Функция ВыбратьНовыеЗадачиПоИсполнителям(Знач ДатаВремяОт, Знач ДатаВремяПо)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсключенияУведомленийПоРолямИсполнителей.РольИсполнителя КАК РольИсполнителя
		|ПОМЕСТИТЬ ВТ_РолиИсключения
		|ИЗ
		|	РегистрСведений.ИсключенияУведомленийПоРолямИсполнителей КАК ИсключенияУведомленийПоРолямИсполнителей
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	РольИсполнителя
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсключенияУведомленийПоПользователям.Пользователь КАК Пользователь
		|ПОМЕСТИТЬ ВТ_ПользователиИсключения
		|ИЗ
		|	РегистрСведений.ИсключенияУведомленийПоПользователям КАК ИсключенияУведомленийПоПользователям
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадачаИсполнителя.Ссылка КАК Ссылка,
		|	ЗадачаИсполнителя.Номер КАК Номер,
		|	ЗадачаИсполнителя.Дата КАК Дата,
		|	ЗадачаИсполнителя.Наименование КАК Наименование,
		|	ЗадачаИсполнителя.СрокВыполнения КАК СрокВыполнения,
		|	ЭтапыРегламентногоИнтервалаДокумента.СрокПоРегламенту КАК СрокПоРегламенту,
		|	ЗадачаИсполнителя.Автор КАК Автор,
		|	ЗадачаИсполнителя.Описание КАК Описание,
		|	ЗадачаИсполнителя.Этап КАК Этап,
		|	ЗадачаИсполнителя.Предмет КАК Предмет,
		|	ВЫБОР
		|		КОГДА ЗадачаИсполнителя.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|			ТОГДА ЗадачаИсполнителя.Исполнитель
		|		ИНАЧЕ ИсполнителиЗадач.Исполнитель
		|	КОНЕЦ КАК Исполнитель,
		|	ЗадачаИсполнителя.РольИсполнителя КАК РольИсполнителя,
		|	ЗадачаИсполнителя.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
		|	ЗадачаИсполнителя.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации
		|ПОМЕСТИТЬ ВТ_ЗадачиПоИсполнителям
		|ИЗ
		|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаИсполнителя
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
		|		ПО ЗадачаИсполнителя.РольИсполнителя = ИсполнителиЗадач.РольИсполнителя
		|			И ЗадачаИсполнителя.ОсновнойОбъектАдресации = ИсполнителиЗадач.ОсновнойОбъектАдресации
		|			И ЗадачаИсполнителя.ДополнительныйОбъектАдресации = ИсполнителиЗадач.ДополнительныйОбъектАдресации
		|			И (ЗадачаИсполнителя.Исполнитель = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭтапыРегламентногоИнтервалаДокумента КАК ЭтапыРегламентногоИнтервалаДокумента
		|		ПО ЗадачаИсполнителя.РегламентныйИнтервал = ЭтапыРегламентногоИнтервалаДокумента.РегламентныйИнтервал
		|			И ЗадачаИсполнителя.НомерИтерации = ЭтапыРегламентногоИнтервалаДокумента.НомерИтерации
		|			И ЗадачаИсполнителя.Предмет = ЭтапыРегламентногоИнтервалаДокумента.Предмет
		|			И ЗадачаИсполнителя.ИдентификаторЭтапа = ЭтапыРегламентногоИнтервалаДокумента.ИдентификаторЭтапа
		|ГДЕ
		|	ЗадачаИсполнителя.Выполнена = ЛОЖЬ
		|	И ЗадачаИсполнителя.Дата МЕЖДУ &ДатаВремяОт И &ДатаВремяПо
		|	И ЗадачаИсполнителя.ПометкаУдаления = ЛОЖЬ
		|	И (ЗадачаИсполнителя.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|			ИЛИ ИсполнителиЗадач.Исполнитель ЕСТЬ НЕ NULL 
		|				И ИсполнителиЗадач.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
		|	И НЕ ЗадачаИсполнителя.РольИсполнителя В
		|				(ВЫБРАТЬ
		|					ВТ_РолиИсключения.РольИсполнителя КАК РольИсполнителя
		|				ИЗ
		|					ВТ_РолиИсключения КАК ВТ_РолиИсключения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЗадачиПоИсполнителям.Ссылка КАК Ссылка,
		|	ВТ_ЗадачиПоИсполнителям.Номер КАК Номер,
		|	ВТ_ЗадачиПоИсполнителям.Дата КАК Дата,
		|	ВТ_ЗадачиПоИсполнителям.Наименование КАК Наименование,
		|	ВТ_ЗадачиПоИсполнителям.СрокВыполнения КАК СрокВыполнения,
		|	ВТ_ЗадачиПоИсполнителям.СрокПоРегламенту КАК СрокПоРегламенту,
		|	ВТ_ЗадачиПоИсполнителям.Автор КАК Автор,
		|	ВТ_ЗадачиПоИсполнителям.Описание КАК Описание,
		|	ВТ_ЗадачиПоИсполнителям.Этап КАК Этап,
		|	ВТ_ЗадачиПоИсполнителям.Предмет КАК Предмет,
		|	ВТ_ЗадачиПоИсполнителям.Исполнитель КАК Исполнитель,
		|	ВТ_ЗадачиПоИсполнителям.РольИсполнителя КАК РольИсполнителя,
		|	ВТ_ЗадачиПоИсполнителям.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
		|	ВТ_ЗадачиПоИсполнителям.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации
		|ИЗ
		|	ВТ_ЗадачиПоИсполнителям КАК ВТ_ЗадачиПоИсполнителям
		|ГДЕ
		|	НЕ ВТ_ЗадачиПоИсполнителям.Исполнитель В
		|				(ВЫБРАТЬ
		|					ВТ_ПользователиИсключения.Пользователь КАК Пользователь
		|				ИЗ
		|					ВТ_ПользователиИсключения КАК ВТ_ПользователиИсключения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Исполнитель,
		|	СрокВыполнения УБЫВ
		|ИТОГИ ПО
		|	Исполнитель");
	
	Запрос.Параметры.Вставить("ДатаВремяОт", ДатаВремяОт + 1);
	Запрос.Параметры.Вставить("ДатаВремяПо", ДатаВремяПо);
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьУведомлениеОНовыхЗадачах(Исполнитель, ЗадачиПоИсполнителю, ПараметрыРассылки)
	
	ПочтовыйАдресПолучателя = АдресЭлектроннойПочты(Исполнитель);
	Если ПустаяСтрока(ПочтовыйАдресПолучателя) Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Процессы обработки документов.Уведомление о новых задачах'",
			ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Информация,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомление не отправлено, так как не указан почтовый адрес у пользователя %1.'"), Строка(Исполнитель)));
		Возврат Ложь;
	КонецЕсли;
	
	ТекстПисьма = "";
	Для Каждого Задача Из ЗадачиПоИсполнителю.Строки Цикл
		ТекстПисьма = ТекстПисьма + СформироватьПредставлениеЗадачи(Задача, ПараметрыРассылки);
	КонецЦикла;
	ТемаПисьма = НСтр("ru = 'Новые задачи по обработке документов'");
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Тема", ТемаПисьма);
	ПараметрыПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыПисьма.Вставить("Кому", ПочтовыйАдресПолучателя);
	
	МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	Попытка
		УчетнаяЗапись = МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		Письмо = МодульРаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
		МодульРаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Процессы обработки документов.Уведомление о новых задачах'",
			ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка при отправке уведомления о новых задачах: %1'"), 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Процессы обработки документов.Уведомление о новых задачах'",
		ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,,,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомления успешно отправлены на адрес %1.'"), ПочтовыйАдресПолучателя));
	Возврат Истина;
	
КонецФункции

Функция СформироватьПредставлениеЗадачи(ЗадачаСтруктура, ПараметрыРассылки)
	
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Задача: %1'"), ЗадачаСтруктура.Этап) + Символы.ПС;
	ДополнительноеПредставлениеЗадачи = ПроцессыОбработкиДокументовПереопределяемый.СформироватьДополнительноеПредставлениеЗадачи(ЗадачаСтруктура);
	Если ЗначениеЗаполнено(ДополнительноеПредставлениеЗадачи) Тогда
		Результат = Результат + ДополнительноеПредставлениеЗадачи + Символы.ПС;
	КонецЕсли;
	Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Документ: %1'"), ЗадачаСтруктура.Предмет) + Символы.ПС;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.СрокВыполнения) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Срок по нормативу: %1'"), Формат(ЗадачаСтруктура.СрокВыполнения, "ДФ=""dd.MM.yyyy HH:mm""")) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.СрокПоРегламенту) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Срок по регламенту: %1'"), Формат(ЗадачаСтруктура.СрокПоРегламенту, "ДФ=""dd.MM.yyyy HH:mm""")) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.Исполнитель) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Исполнитель: %1'"), ЗадачаСтруктура.Исполнитель) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.РольИсполнителя) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Роль: %1'"), ЗадачаСтруктура.РольИсполнителя) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.ОсновнойОбъектАдресации) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Основной объект адресации: %1'"), ЗадачаСтруктура.ОсновнойОбъектАдресации) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.ДополнительныйОбъектАдресации) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Доп. объект адресации: %1'"), ЗадачаСтруктура.ДополнительныйОбъектАдресации) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.Автор) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Автор: %1'"), ЗадачаСтруктура.Автор) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.Описание) Тогда
		Результат = Результат + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1'"), ЗадачаСтруктура.Описание) + Символы.ПС;
	КонецЕсли;
	
	ВывестиСсылки(Результат, ЗадачаСтруктура.Предмет, ПараметрыРассылки);
	
	Возврат Результат + Символы.ПС;
	
КонецФункции

Процедура ВывестиСсылки(Результат, Ссылка, ПараметрыРассылки)
	
	Результат = Результат + Символы.ПС;
	
	Если ЗначениеЗаполнено(ПараметрыРассылки.АдресИБВЛокальнойСети) Тогда
		// Выводится ссылка в локальной сети
		Результат = Результат +
			НСтр("ru='Ссылка: '")
			+ Символы.ПС
			+ НавигационнаяСсылкаДляУведомления(Ссылка, ПараметрыРассылки.АдресИБВЛокальнойСети)
			+ Символы.ПС;
	Иначе
		// Если не указан адрес в локальной сети и не указан внешний адрес,
		// то выводится внутренняя ссылка.
		Если НЕ ЗначениеЗаполнено(ПараметрыРассылки.АдресИБВИнтернет) Тогда
			Результат = Результат +
				НСтр("ru='Ссылка: '")
				+ Символы.ПС
				+ ПолучитьНавигационнуюСсылку(Ссылка)
				+ Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметрырассылки.АдресИБВИнтернет) Тогда
		// Выводится внешняя ссылка
		Результат = Результат +
			НСтр("ru='Внешняя ссылка: '")
			+ Символы.ПС
			+ НавигационнаяСсылкаДляУведомления(Ссылка, ПараметрыРассылки.АдресИБВИнтернет, Истина)
			+ Символы.ПС;
	КонецЕсли;
	
КонецПроцедуры

Функция НавигационнаяСсылкаДляУведомления(Ссылка, АдресПубликацииИБ, ВебПубликация=Ложь)
	
	АдресПубликацииИБ = СОКРЛП(АдресПубликацииИБ);
	
	Если ВебПубликация И Прав(АдресПубликацииИБ, 1) <> "/" Тогда
		АдресПубликацииИБ = АдресПубликацииИБ + "/";
	КонецЕсли;
	
	Возврат АдресПубликацииИБ + "#" + ПолучитьНавигационнуюСсылку(Ссылка);
	
КонецФункции

#КонецОбласти

#Область ЭлектроннаяПодпись

// См. ЭлектроннаяПодпись.УдалитьПодпись
Процедура УдалитьПодпись(Объект, ПорядковыйНомер, ИдентификаторФормы = Неопределено, ВерсияОбъекта = Неопределено,
			ЗаписанныйОбъект = Неопределено) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ПроцессыОбработкиДокументовПереопределяемый.УдалитьПодпись(Объект, ПорядковыйНомер, ИдентификаторФормы, ВерсияОбъекта,
		ЗаписанныйОбъект, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		УстановленПривилегированныйРежим = Ложь;
		Если НЕ Пользователи.ЭтоПолноправныйПользователь()
			И УправлениеДоступом.ЕстьРоль("ДобавлениеИзменениеЭлектронныхПодписей") Тогда
			УстановитьПривилегированныйРежим(Истина);
			УстановленПривилегированныйРежим = Истина;
		КонецЕсли;
		
		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
		МодульЭлектроннаяПодпись.УдалитьПодпись(Объект, ПорядковыйНомер, ИдентификаторФормы, ВерсияОбъекта, ЗаписанныйОбъект);
		
		Если УстановленПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ЭлектроннаяПодпись.ДобавитьПодпись
Процедура ДобавитьПодпись(Объект, Знач СвойстваПодписи, ИдентификаторФормы = Неопределено,
			ВерсияОбъекта = Неопределено, ЗаписанныйОбъект = Неопределено) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ПроцессыОбработкиДокументовПереопределяемый.ДобавитьПодпись(Объект, СвойстваПодписи, ИдентификаторФормы, ВерсияОбъекта, ЗаписанныйОбъект, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		УстановленПривилегированныйРежим = Ложь;
		Если НЕ Пользователи.ЭтоПолноправныйПользователь()
			И УправлениеДоступом.ЕстьРоль("ДобавлениеИзменениеЭлектронныхПодписей") Тогда
			УстановитьПривилегированныйРежим(Истина);
			УстановленПривилегированныйРежим = Истина;
		КонецЕсли;
		
		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
		МодульЭлектроннаяПодпись.ДобавитьПодпись(Объект, СвойстваПодписи, ИдентификаторФормы, ВерсияОбъекта, ЗаписанныйОбъект);
		
		Если УстановленПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ЭлектроннаяПодпись.ОбновитьПодпись
Процедура ОбновитьПодпись(Объект, Знач СвойстваПодписи) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ПроцессыОбработкиДокументовПереопределяемый.ОбновитьПодпись(Объект, СвойстваПодписи, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
