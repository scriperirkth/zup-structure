	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Использование", Использование);
	ПараметрыЗадания.Вставить("Расписание", Расписание);
	
	РегламентныеЗаданияСервер.ИзменитьЗадание(РегламентноеЗадание, ПараметрыЗадания);
	
КонецПроцедуры

Функция ИнформацияОПереданныхПравахИсполнителю(Пользователь) Экспорт
	
	Информация = Новый Структура;
	Информация.Вставить("ИсполнителюПереданыПрава", Ложь);
	Информация.Вставить("КоличествоНевыполненныхЗадач", 0);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкаПередачиПравИсполнителей.ОтКого КАК ОтКого,
	|	НастройкаПередачиПравИсполнителей.РольИсполнителей КАК РольИсполнителей,
	|	НастройкаПередачиПравИсполнителей.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
	|	НастройкаПередачиПравИсполнителей.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации
	|ПОМЕСТИТЬ ПередавшиеПраваТекущемуПользователю
	|ИЗ
	|	РегистрСведений.НастройкаПередачиПравИсполнителей КАК НастройкаПередачиПравИсполнителей
	|ГДЕ
	|	НастройкаПередачиПравИсполнителей.Кому = &ТекущийПользователь
	|	И НастройкаПередачиПравИсполнителей.ДатаНачалаДействия <= &ТекущаяДата
	|	И (КОНЕЦПЕРИОДА(НастройкаПередачиПравИсполнителей.ДатаОкончанияДействия, ДЕНЬ) >= &ТекущаяДата
	|			ИЛИ НастройкаПередачиПравИсполнителей.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователь);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Запрос.Выполнить();
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы[0].ПолучитьДанные().Пустой() Тогда
		Возврат Информация;
	КонецЕсли;
	
	Информация.ИсполнителюПереданыПрава = Истина;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(ЗадачаПоОбработкеДокумента.Ссылка) КАК КоличествоНевыполненныхЗадач
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПередавшиеПраваТекущемуПользователю КАК ПередавшиеПраваТекущемуПользователю
	|		ПО ЗадачаПоОбработкеДокумента.Исполнитель = ПередавшиеПраваТекущемуПользователю.ОтКого
	|			И ЗадачаПоОбработкеДокумента.РольИсполнителя = ПередавшиеПраваТекущемуПользователю.РольИсполнителей
	|			И ЗадачаПоОбработкеДокумента.ОсновнойОбъектАдресации = ПередавшиеПраваТекущемуПользователю.ОсновнойОбъектАдресации
	|			И ЗадачаПоОбработкеДокумента.ДополнительныйОбъектАдресации = ПередавшиеПраваТекущемуПользователю.ДополнительныйОбъектАдресации
	|ГДЕ
	|	НЕ ЗадачаПоОбработкеДокумента.Прервана
	|	И НЕ ЗадачаПоОбработкеДокумента.Выполнена";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Информация.КоличествоНевыполненныхЗадач = Выборка.КоличествоНевыполненныхЗадач;
	КонецЕсли;
	
	Возврат Информация;
	
КонецФункции

Процедура ПараметрыРаботыКлиентаПриЗапуске(Параметры) Экспорт
	
	Если НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.Задачи.ЗадачаПоОбработкеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ПоказыватьОповещенияОНовыхЗадачах = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПроцессовОбработкиДокументов",
		"ПоказыватьОповещенияОНовыхЗадачах",
		Истина);
	
	ИнтервалОповещенийОНовыхЗадачах = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПроцессовОбработкиДокументов",
		"ИнтервалОповещенийОНовыхЗадачах",
		?(ПоказыватьОповещенияОНовыхЗадачах, 10, 0));
	
	Параметры.Вставить("ПроцессыОбработкиДокументов_ПоказыватьОповещенияОНовыхЗадачах", ПоказыватьОповещенияОНовыхЗадачах);
	Параметры.Вставить("ПроцессыОбработкиДокументов_ИнтервалОповещенийОНовыхЗадачах", ИнтервалОповещенийОНовыхЗадачах);
	
КонецПроцедуры

Функция ЕстьТипыДокументовСНесколькимиШаблонами() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкаИспользованияШаблонов.ИдентификаторДокумента КАК ИдентификаторДокумента
	|ИЗ
	|	РегистрСведений.НастройкаИспользованияШаблонов КАК НастройкаИспользованияШаблонов
	|
	|СГРУППИРОВАТЬ ПО
	|	НастройкаИспользованияШаблонов.ИдентификаторДокумента
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(НастройкаИспользованияШаблонов.Шаблон) > 1";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция УПользователяОтсутствуетКлючПЭПВРеесте() Экспорт
	
	Пользователь = Пользователи.ТекущийПользователь();
	ДатаПроверки = ТекущаяДатаСеанса();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.Пользователь КАК Пользователь,
	|	РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.ДатаОтзыва КАК ДатаОтзыва
	|ИЗ
	|	РегистрСведений.РеестрКлючейПростыхЭлектронныхПодписейПОД.СрезПоследних(
	|			&ДатаПроверки,
	|			Пользователь = &Пользователь) КАК РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних
	|ГДЕ
	|	(РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.ДатаОтзыва = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ КОНЕЦПЕРИОДА(РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.ДатаОтзыва, ДЕНЬ) >= &ДатаПроверки)";
	
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура УстановитьОграничениеИспользованияПоляДинамическогоСписка(
	Список, ИмяПоля, Поле=Неопределено, Условие=Неопределено, Группировка=Неопределено, Порядок=Неопределено,
	ПолеРеквизиты=Неопределено, УсловиеРеквизиты=Неопределено, ГруппировкаРеквизиты=Неопределено, ПорядокРеквизиты=Неопределено) Экспорт
	
	ПолеНабораДанных = Список.Поля.Найти(ИмяПоля);
	Если ПолеНабораДанных = Неопределено Тогда
		ПолеНабораДанных = Список.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабораДанных.Поле = ИмяПоля;
		ПолеНабораДанных.ПутьКДанным = ИмяПоля;
	КонецЕсли;
	Если Поле <> Неопределено Тогда
		ПолеНабораДанных.ОграничениеИспользования.Поле = Поле;
	КонецЕсли;
	Если Условие <> Неопределено Тогда
		ПолеНабораДанных.ОграничениеИспользования.Условие = Условие;
	КонецЕсли;
	Если Группировка <> Неопределено Тогда
		ПолеНабораДанных.ОграничениеИспользования.Группировка = Группировка;
	КонецЕсли;
	Если Порядок <> Неопределено Тогда
		ПолеНабораДанных.ОграничениеИспользования.Порядок = Порядок;
	КонецЕсли;
	Если ПолеРеквизиты <> Неопределено Тогда
		ПолеНабораДанных.ОграничениеИспользованияРеквизитов.Поле = ПолеРеквизиты;
	КонецЕсли;
	Если УсловиеРеквизиты <> Неопределено Тогда
		ПолеНабораДанных.ОграничениеИспользованияРеквизитов.Условие = УсловиеРеквизиты;
	КонецЕсли;
	Если ГруппировкаРеквизиты <> Неопределено Тогда
		ПолеНабораДанных.ОграничениеИспользованияРеквизитов.Группировка = ГруппировкаРеквизиты;
	КонецЕсли;
	Если ПорядокРеквизиты <> Неопределено Тогда
		ПолеНабораДанных.ОграничениеИспользованияРеквизитов.Порядок = ПорядокРеквизиты;
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеДокументаДляИмениФайла(ДокументСсылка) Экспорт
	
	ПредставлениеДокумента = Строка(ДокументСсылка);
	
	// Время не должно содержаться в имени файла - недопустимые символы
	Если Сред(ПредставлениеДокумента, СтрДлина(ПредставлениеДокумента) - 2, 1) = ":"
		И Сред(ПредставлениеДокумента, СтрДлина(ПредставлениеДокумента) - 5, 1) = ":" Тогда
		ПозицияПробелаПередВременем = СтрНайти(ПредставлениеДокумента, " ", НаправлениеПоиска.СКонца);
		Если ПозицияПробелаПередВременем > 0 Тогда
			ПредставлениеДокумента = Сред(ПредставлениеДокумента, 1, ПозицияПробелаПередВременем - 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПредставлениеДокумента;
	
КонецФункции

Функция ФайлыПервичныхДокументов(Предмет) Экспорт
	
	Файлы = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПервичныеДокументыПОД.ПервичныйДокумент КАК ПервичныйДокумент
	|ИЗ
	|	РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
	|ГДЕ
	|	ПервичныеДокументыПОД.Предмет = &Предмет";
	
	Запрос.УстановитьПараметр("Предмет", Предмет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Файлы.Добавить(Выборка.ПервичныйДокумент);
	КонецЦикла;
	
	Возврат Файлы;
	
КонецФункции

Функция ВизуализацияПервичногоДокумента(Документ, ИдентификаторПечатнойФормы, ПервичныйДокумент,
	Шаблон, ПорядокТекущегоЭтапа) Экспорт
	
	ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ПервичныйДокумент, Ложь);
	
	Если ДвоичныеДанные = Неопределено Тогда
		
		ТекстСообщения = НСтр("ru = 'Не удалось получить данные документа, так как он помечен на удаление.
			|Для продолжения работы с документом необходимо снять пометку удаления.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат Новый ТабличныйДокумент;
		
	КонецЕсли;
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	
	ТабличныйДокумент = МодульУправлениеПечатью.ТабличныйДокументПоДвоичнымДанным(ДвоичныеДанные);
	
	// штампы ЭП
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрисоединенныеФайлыПодписанныеЗадачами.Задача КАК Задача
	|ИЗ
	|	РегистрСведений.ПервичныеДокументыПОД КАК ПервичныеДокументыПОД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрисоединенныеФайлыПодписанныеЗадачами КАК ПрисоединенныеФайлыПодписанныеЗадачами
	|		ПО ПервичныеДокументыПОД.ПервичныйДокумент = ПрисоединенныеФайлыПодписанныеЗадачами.Файл
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|		ПО (ПрисоединенныеФайлыПодписанныеЗадачами.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа)
	|			И (ШаблоныПроцессовЭтапы.Ссылка = &ШаблонПроцесса)
	|ГДЕ
	|	ПервичныеДокументыПОД.Предмет = &Документ
	|	И ПервичныеДокументыПОД.ИдентификаторПечатнойФормы = &ИдентификаторПечатнойФормы
	|	И ПервичныеДокументыПОД.Формат = ""mxl""
	|	И ШаблоныПроцессовЭтапы.Порядок <= &ПорядокТекущегоЭтапа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ШаблоныПроцессовЭтапы.Порядок,
	|	ПрисоединенныеФайлыПодписанныеЗадачами.Задача.ДатаИсполнения";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ШаблонПроцесса", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторПечатнойФормы", ИдентификаторПечатнойФормы);
	Запрос.УстановитьПараметр("ПорядокТекущегоЭтапа", ПорядокТекущегоЭтапа);
	
	ЭлектронныеПодписиДляШтампа = Новый Массив;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			ЭлектронныеПодписиДляШтампа, УстановленныеПодписи(Выборка.Задача));
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Штампы = ШтампыДляТабличногоДокумента(ЭлектронныеПодписиДляШтампа);
	
	ДобавитьШтампыВТабличныйДокумент(
		Документ, Шаблон, ИдентификаторПечатнойФормы, ТабличныйДокумент, Штампы);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ВизуализацияТекущегоПервичногоДокумента(Документ, ИдентификаторПечатнойФормы, СведенияОПервичиномДокументе) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Шаблон = ШаблонИСтатусДокумента(Документ).Шаблон;
	ПорядокТекущегоЭтапа = ПорядокТекущегоЭтапаШаблонаПроцесса(Документ, Шаблон);
	                                                          
	СсылкаНаДокументПредставленияФормуляраЭД = НайтиФайлПредставленияФормуляраПервичногоДокументаДляЗадачиПОД(СведенияОПервичиномДокументе.ВыполняемаяЗадача, СведенияОПервичиномДокументе);
	
	Если ЗначениеЗаполнено(СсылкаНаДокументПредставленияФормуляраЭД) Тогда
		
		ТабличныйДокумент = ВизуализацияПредставленияЭлектронногоДокументаПоСсылке(СсылкаНаДокументПредставленияФормуляраЭД);
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОПервичиномДокументе)
		И ЗначениеЗаполнено(СведенияОПервичиномДокументе.ДанныеПредставленияПервичногоДокумента) Тогда
		
		ТабличныйДокумент = ВизуализацияИтоговогоФормуляраПервичногоДокумента(Документ, Шаблон,
			СведенияОПервичиномДокументе.ДанныеПредставленияПервичногоДокумента, СведенияОПервичиномДокументе.ИдентификаторыПрочихФормуляров);
		
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Возвращает массив текстовых ошибок при проверке шаблона процессов на наличие настроек  
// формирования и подписания формуляров
//
// Параметры:
//  Объект - СправочникОбъект.ШаблоныПроцессов - Шаблон для проверки
//  ЕстьНастройкиФормированияИПодписанияФормуляров - Булево - признак наличия ненулевых настроек формирования формуляров
//                                                            для всех этапов шаблона
Функция ПроверитьНастройкиФормированияИПодписанияФормуляров(Знач Объект, Знач ЕстьНастройкиФормированияИПодписанияФормуляров) Экспорт  
	ОшибкиЗаполенияФормуляров = Новый Массив;
	
	Если ЕстьНастройкиФормированияИПодписанияФормуляров Тогда
			
		НастройкиФормуляровЭтапов = Новый ТаблицаЗначений;
		НастройкиФормуляровЭтапов.Колонки.Добавить("Порядок");
		НастройкиФормуляровЭтапов.Колонки.Добавить("НаименованиеЭтапа");
		НастройкиФормуляровЭтапов.Колонки.Добавить("ИдентификаторЭтапа");
		НастройкиФормуляровЭтапов.Колонки.Добавить("ИдентификаторПечатнойФормы");
		НастройкиФормуляровЭтапов.Колонки.Добавить("ПечатнаяФорма");
	    НастройкиФормуляровЭтапов.Колонки.Добавить("КодНастройкиФормуляра");
		
		Для Каждого Этап Из Объект.Этапы Цикл
			
			Если Этап.ИдентификаторыКомандПечатиСоШтампом = "" Тогда
				Продолжить;
			КонецЕсли;
			
			НаименованиеЭтапа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Этап.Этап, "Наименование");
			
			КодыНастроекФормуляровЭтапа = СтрРазделить(Этап.КодыНастройкиФормированияИПодписанияФормуляров,",");
			ПечатныеФормыЭтапа = СтрРазделить(Этап.ИдентификаторыКомандПечатиСоШтампом,",", Истина);
			ИдентификаторыПечатныхФорм = ОбщегоНазначения.СкопироватьРекурсивно(ПечатныеФормыЭтапа, Ложь);
			
			ВсеФормы = Ложь;
			ИдентификаторДокумента = Объект.ИдентификаторДокумента;
			ПечатныеФормыДокументовПоИдентификаторам = СписокПечатныхФормОбъектаУчета(ИдентификаторДокумента, 
														 ИдентификаторыПечатныхФорм, ВсеФормы);

			КоличествоПечатныхФорм = ПечатныеФормыЭтапа.Количество();
			
			Индекс = 0;
			Пока Индекс < КоличествоПечатныхФорм Цикл
				СтрокаТаблицы = НастройкиФормуляровЭтапов.Добавить();
				СтрокаТаблицы.Порядок = Этап.Порядок;
				СтрокаТаблицы.НаименованиеЭтапа = НаименованиеЭтапа;
				СтрокаТаблицы.ИдентификаторЭтапа = Этап.ИдентификаторЭтапа; 
				СтрокаТаблицы.ИдентификаторпечатнойФормы = ПечатныеФормыЭтапа[Индекс];
				СтрокаТаблицы.ПечатнаяФорма = ПечатныеФормыДокументовПоИдентификаторам.НайтиПоЗначению(ПечатныеФормыЭтапа[Индекс]);
				
				Если Индекс >= КодыНастроекФормуляровЭтапа.Количество() Тогда
					 СтрокаТаблицы.КодНастройкиФормуляра = "0";
				 Иначе
					 КодНастройки = КодыНастроекФормуляровЭтапа[Индекс];
					 СтрокаТаблицы.КодНастройкиФормуляра = ?(Не ЗначениеЗаполнено(КодНастройки), "0", КодНастройки); 
				КонецЕсли;
				Индекс = Индекс + 1;
			КонецЦикла;	
					
		КонецЦикла; 
		
		Для Каждого НастройкаФормуляра Из НастройкиФормуляровЭтапов Цикл
			
			//не заполненные формуляры
			Если НастройкаФормуляра.КодНастройкиФормуляра = "0" Тогда
				ШаблонСообщения = НСтр("ru='Для этапа ""%1"" и печатной формы ""%2"" не указаны настройки формирования" + 
				                         "и подписания формуляров'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
									НастройкаФормуляра.НаименованиеЭтапа, НастройкаФормуляра.ПечатнаяФорма);
				ОшибкиЗаполенияФормуляров.Добавить(ТекстСообщения);
			КонецЕсли;
			
			//для варианта настройки "Подписывать ранее созданный" должен быть уже созданный ранее формуляр в настройках этапов 
			Если НастройкаФормуляра.КодНастройкиФормуляра = "3" Тогда
				
				ЕстьРанееПодписанныйФормуляр = Ложь;
				ПечатнаяФорма = НастройкаФормуляра.ПечатнаяФорма;
			    ИдентификаторыПредшественников = ПолучитьИдентификаторыПредшественниковОбъекта(Объект, 
					Этап.ИдентификаторЭтапа);			
				Для Каждого Предшественник Из  ИдентификаторыПредшественников Цикл
					СтруктураОтбора = Новый Структура("ИдентификаторЭтапа, ИдентификаторПечатнойФормы, КодНастройкиФормуляра",
														Предшественник, НастройкаФормуляра.ИдентификаторПечатнойФормы, "2");
					
					НайденныеСтроки = НастройкиФормуляровЭтапов.НайтиСтроки(СтруктураОтбора);
					Если НайденныеСтроки.Количество() <> 0 Тогда
						 
						 ЕстьРанееПодписанныйФормуляр = Истина;
						 Прервать;
					КонецЕсли;	
				КонецЦикла;
				
				Если Не ЕстьРанееПодписанныйФормуляр Тогда
					 ШаблонСообщения = НСтр("ru='Для этапа ""%1"" и печатной формы ""%2"" указана " + 
					 						"настройка ""Подписывать ранее созданный"", в этом случае для одного из предшествующих этапов " + 
					 						"должна быть указана настройка ""Формировать и подписывать на этом и следующих этапах""'");
					 ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
					 					НастройкаФормуляра.НаименованиеЭтапа, ПечатнаяФорма);
					 ОшибкиЗаполенияФормуляров.Добавить(ТекстСообщения);
				КонецЕсли;
				 
			  КонецЕсли;	
		  КонецЦикла;
	  ИначеЕсли Объект.ЕстьНастройкиФормированияИПодписанияФормуляров Тогда
		  // ситуация когда пустые настройки формуляров типа "0,0" для этапов
		  Для Каждого Этап Из Объект.Этапы Цикл
			  Если ЗначениеЗаполнено(Этап.КодыНастройкиФормированияИПодписанияФормуляров) Тогда
				  НаименованиеЭтапа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Этап.Этап, "Наименование");
				  ШаблонСообщения = НСтр("ru='Для этапа ""%1"" указаны неверные настройки подписания формуляров " +
				                          "необходимо пересохранить настройки ответсвенности'");
				  ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеЭтапа);
				  ОшибкиЗаполенияФормуляров.Добавить(ТекстСообщения);
			  КонецЕсли;
		  КонецЦикла;
	КонецЕсли; 
	
	Возврат ОшибкиЗаполенияФормуляров;

КонецФункции

//Проверка наличия настроек формирования формуляров на Этапах в Шаблоне процесса
// Параметры:
//  ШаблонОбъект - СправочникОбъект.ШаблоныПроцессов - Шаблон для проверки
// Возвращаемое значение:
//   Возвращает Истина, если хотя бы для одого этапа есть не пустая настройка формирования формуляров
Функция ЕстьНастройкиФормированияИПодписанияФормуляровУЭтапов(Знач ШаблонОбъект) Экспорт
	ЕстьНастройкиФормированияИПодписанияФормуляров = Ложь;
	
	Для Каждого Этап Из ШаблонОбъект.Этапы Цикл
		 КодыНастройкиФормированияИПодписанияФормуляров = Этап.КодыНастройкиФормированияИПодписанияФормуляров; 
		
		Если ЗначениеЗаполнено(КодыНастройкиФормированияИПодписанияФормуляров) Тогда 
			
				КодыНастроек = СтрРазделить(КодыНастройкиФормированияИПодписанияФормуляров,",", Истина);
                КоличествоНастроек = КодыНастроек.Количество();
				КоличествоПустыхФормуляров = СтрЧислоВхождений(КодыНастройкиФормированияИПодписанияФормуляров, "0");
				Если Не (КоличествоПустыхФормуляров = КоличествоНастроек) Тогда
                    	ЕстьНастройкиФормированияИПодписанияФормуляров = Истина;
			       		Прервать;
				КонецЕсли;	

		КонецЕсли;
	КонецЦикла;	

	
Возврат ЕстьНастройкиФормированияИПодписанияФормуляров;	
	
КонецФункции

Функция СсылкаНаСертификатПоОтпечатку(Отпечаток) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Отпечаток", Отпечаток);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сертификаты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования КАК Сертификаты
	|ГДЕ
	|	Сертификаты.Отпечаток = &Отпечаток";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ПриПолученииФормыВидовПрисоединенныхФайлов(НаименованиеФормы) Экспорт
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриПолученииФормыВидовПрисоединенныхФайлов(НаименованиеФормы);
	
КонецПроцедуры

#Область ИнтеграцияСДругимиПодсистемами

Процедура ДобавитьБлокировкуИзмененияОбъекта(КоллекцияБлокировок, СсылкаНаОбъект) Экспорт
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы.БлокировкаИзмененияОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	МодульБлокировкаИзмененияОбъектов = ОбщегоНазначения.ОбщийМодуль("БлокировкаИзмененияОбъектов");
	
	ШаблонИСтатус = ШаблонИСтатусДокумента(СсылкаНаОбъект, Истина);
	Шаблон = ШаблонИСтатус.Шаблон;
	
	Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
		Возврат;
	ИначеЕсли НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ШаблоныПроцессов) Тогда
		БлокировкаИзмененияОбъекта = МодульБлокировкаИзмененияОбъектов.ОписаниеБлокировкиИзмененияОбъекта(
			"ПроцессыОбработкиДокументов",
			НСтр("ru = 'Недостаточно прав для получения сведений о процессе обработки документа'"),
			Ложь,
			НСтр("ru = 'Редактирование ограничено функционалом библиотеки ""Процессы обработки документов""'"));
		КоллекцияБлокировок.Добавить(БлокировкаИзмененияОбъекта);
		Возврат;
	КонецЕсли;
	
	// Определение текущего этапа и возможности его выполнения текущим пользователем
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(СсылкаНаОбъект, Шаблон);
	
	РазрешитьТолькоПросмотрФормы = Ложь;
	ДобавитьКомандуПринятьКИсполнению = Ложь;
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая()
		И НЕ ТекущийПользовательМожетБытьИсполнителем(СсылкаНаОбъект, ПараметрыТекущегоЭтапа, Шаблон) Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли НЕ Константы.РазрешитьРедактированиеДокументаДоПринятияКИсполнению.Получить()
		И НЕ ПараметрыТекущегоЭтапа.Задача.Пустая()
		И НесколькоПользователейМогутБытьИсполнителями(СсылкаНаОбъект, ПараметрыТекущегоЭтапа) Тогда
		// При ролевой адресации и наличии нескольких потенциальных исполнителей
		// перед работой с документом требуется предварительно "захватить задачу"
		РазрешитьТолькоПросмотрФормы = Истина;
		ДобавитьКомандуПринятьКИсполнению = Истина;
	КонецЕсли;
	
	Если РазрешитьТолькоПросмотрФормы Тогда
		ПричинаОтказаОтключенияБлокировки = ?(ДобавитьКомандуПринятьКИсполнению,
			НСтр("ru = 'Для разблокировки формы нажмите кнопку ""Принять задачу к исполнению""'"),
			НСтр("ru = 'Редактирование ограничено функционалом библиотеки ""Процессы обработки документов""'"));
		БлокировкаИзмененияОбъекта = МодульБлокировкаИзмененияОбъектов.ОписаниеБлокировкиИзмененияОбъекта(
			"ПроцессыОбработкиДокументов",
			НСтр("ru = 'Редактирование ограничено функционалом библиотеки ""Процессы обработки документов""'"),
			Ложь,
			ПричинаОтказаОтключенияБлокировки);
		КоллекцияБлокировок.Добавить(БлокировкаИзмененияОбъекта);
	КонецЕсли;
	
КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
//  ДокументыБИА - Заполняемое значение, массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
//  ВызовИсключенияПриОшибке - Булево, вызывается исключение при ошибке
//
Процедура СоздатьДокументыБИАДляДокументаУчетаЭД(СсылкаНаОбъектИсточник, ДокументыБИА, ВызовИсключенияПриОшибке = Истина) Экспорт

	ПроцессыОбработкиДокументовПереопределяемый.СоздатьДокументыБИАДляДокументаУчетаЭД(СсылкаНаОбъектИсточник, 
		ДокументыБИА, ВызовИсключенияПриОшибке);
	
КонецПроцедуры	

Функция ИспользуетсяПроверкаХэшДляДанныхБольшогоОбъема(Шаблон, Знач РазмерДвоичныхДанныхXML) Экспорт
	ИспользуетсяПроверкаХэш = Ложь;
	МинимальныйРазмерФайла = 0;
		
	// возможность использования проверки через Хэш по условию размера файла
	ПроцессыОбработкиДокументовПереопределяемый.ПриПолученииРазмерФайлаПроверкиДанныхБольшогоОбъема(МинимальныйРазмерФайла);
	МинимальныйРазмерФайла = МинимальныйРазмерФайла * 1000000; // переводим  в Байты
	
	// возможность использования проверки через Хэш по условию из списка шаблонов
	ШаблоныСПроверкойПодписиЧерезХэш = Новый Массив;
	ПроцессыОбработкиДокументовПереопределяемый.ПриПолученииШаблоновПроверкиДанныхБольшогоОбъема(ШаблоныСПроверкойПодписиЧерезХэш);
	
	Если РазмерДвоичныхДанныхXML > МинимальныйРазмерФайла Тогда
		ИспользуетсяПроверкаХэш = Истина;
	КонецЕсли; 
	
	Если ШаблоныСПроверкойПодписиЧерезХэш.Количество() > 0 
		И ШаблоныСПроверкойПодписиЧерезХэш.Найти(Шаблон) = Неопределено Тогда
		ИспользуетсяПроверкаХэш = Ложь;
	КонецЕсли;
	
	Возврат ИспользуетсяПроверкаХэш;
	
КонецФункции

Функция НастройкиДляПроверкиДанныхБольшихОбъемов(Задача) Экспорт
	НастройкиДляПроверкиДанных = Новый Структура();
	
	МенеджерЗаписи = РегистрыСведений.СведенияПодписанныхДанныхБольшогоОбъема.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Задача = Задача;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		НастройкиДляПроверкиДанных.Вставить("СоставПодписи", МенеджерЗаписи.СоставПодписи);
		НастройкиДляПроверкиДанных.Вставить("НастройкаПодписиСсылочныхДанных", МенеджерЗаписи.НастройкаПодписиСсылочныхДанных);
	КонецЕсли;
	
	Возврат НастройкиДляПроверкиДанных 
	
КонецФункции

Процедура ДобавитьНастройкиПроверкиДанныхБольшихОбъемов(Задача, СоставПодписи, НастройкаПодписиСсылочныхДанных, 
	Знач РазмерФайлаXML) Экспорт
	ТекущийПользовательПолноправный = Пользователи.ЭтоПолноправныйПользователь();
	
	НаборЗаписей = РегистрыСведений.СведенияПодписанныхДанныхБольшогоОбъема.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Задача.Установить(Задача);
	НаборЗаписей.Прочитать(); 
	Если НаборЗаписей.Количество() = 0 Тогда
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Задача = Задача;
		НоваяЗапись.СоставПодписи = СоставПодписи; 
		НоваяЗапись.НастройкаПодписиСсылочныхДанных = НастройкаПодписиСсылочныхДанных;
		НоваяЗапись.РазмерФайла = РазмерФайлаXML;
	ИначеЕсли НаборЗаписей.Количество() = 1  Тогда
		НаборЗаписей[0].СоставПодписи = СоставПодписи; 
		НаборЗаписей[0].НастройкаПодписиСсылочныхДанных = НастройкаПодписиСсылочныхДанных;
		НаборЗаписей[0].РазмерФайла = РазмерФайлаXML;
	КонецЕсли;
	
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	НаборЗаписей.Записать();
	Если Не ТекущийПользовательПолноправный Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Функция ВыполнитьПроверкуПодписанныхДанныхМногопоточно(Поток, Параметры) Экспорт
	
	Результат = "";
	ПараметрыПроверки = ?(Параметры.Свойство("ПараметрыПроверки"), Параметры.ПараметрыПроверки, Неопределено); 
	
	ЭлектронныеПодписиПредыдущихЭтапов = ЭлектронныеПодписиПредыдущихЭтапов(Параметры.Документ, Параметры.Шаблон, 
		Параметры.ИдентификаторЭтапа);
	
	ПодписиДляПроверкиДанных = ЭлектронныеПодписиПредыдущихЭтапов.ПодписиДляПроверкиДанных; 
	ТекущаяПодписьПотока = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПодписиДляПроверкиДанных[Параметры.ИндексПотока]); 
	
	ПроверитьСоответствиеПодписанныхИТекущихДанных(Параметры.Документ, ТекущаяПодписьПотока, ПараметрыПроверки);
		
	ПровереннаяПодпись = ПодписиДляПроверкиДанных[Параметры.ИндексПотока];
			
	Если Не ПустаяСтрока(ПровереннаяПодпись.ОписаниеОшибки) Тогда
		ШаблонСообщения = НСтр("ru='Ошибка проверки подписанных данных: %1'");
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ПровереннаяПодпись.ОписаниеОшибки);
		ВызватьИсключение(Результат);
	КонецЕсли;
			
	Возврат Результат;
	
КонецФункции

Функция ПараметрыМногопоточнойФункции() Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Документ", Неопределено); 
	Результат.Вставить("Шаблон", Неопределено);
	Результат.Вставить("ИдентификаторЭтапа", Неопределено);
	Результат.Вставить("ИндексПотока", Неопределено);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызывается чтобы среди контролируемых реквизитов документа найти реквизиты составного типа, для которых требуется разыменование,
// в тексте запроса обращение к их свойствам будет реализовано через функцию "ВЫРАЗИТЬ()"
//
// Параметры:
//  МассивПолейЗапроса	 - Массив         - строки полей для построения запроса
//  МетаданныеОбъекта	 - Метаданные	  -  Метаданные документа
//  Ссылка				 - СсылкаДокумент - подписываемый учётный документ по задаче
//  ТекРеквизит			 - Строка		  - имя текущего контролируемого реквизита для подписи
//
Процедура РазыменоватьПоляЗапросаДляРеквизитовСоставногоТипа(МассивПолейЗапроса, Знач МетаданныеОбъекта, Знач Ссылка, Знач ТекРеквизит)
	
	ИмяРеквизитаРазыменования = ТекРеквизит.ИмяРеквизита;
	ЗначениеРеквизитаРазыменования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизитаРазыменования); 
	ТипЗначения = ТипЗнч(ЗначениеРеквизитаРазыменования);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	
	Если ОбъектМетаданных <> Неопределено
        И Не ОбщегоНазначения.ЭтоСтандартныйРеквизит(МетаданныеОбъекта.СтандартныеРеквизиты, ИмяРеквизитаРазыменования)
	    И МетаданныеОбъекта.Реквизиты[ИмяРеквизитаРазыменования].Тип.СодержитТип(ТипЗначения)
		И МетаданныеОбъекта.Реквизиты[ИмяРеквизитаРазыменования].Тип.Типы().Количество() > 1 
		И Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		
		Для Каждого ПолеЗапроса Из МассивПолейЗапроса Цикл
			
			Если СтрНачинаетсяС(ПолеЗапроса, ИмяРеквизитаРазыменования+ ".") Тогда
				
				НовоеЗначение = СтрЗаменить(ПолеЗапроса,
											ИмяРеквизитаРазыменования + ".",
											"Выразить(" + ИмяРеквизитаРазыменования +" Как "+ ОбъектМетаданных.ПолноеИмя() + ")."
											);
				
				Индекс = МассивПолейЗапроса.Найти(ПолеЗапроса);
				МассивПолейЗапроса.Установить(Индекс, НовоеЗначение); 
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьЗависимыеЗадачи(Объект, Шаблон, ИдентификаторЭтапа, НовыйСтатус, ВлияющаяЗадача, ДополнительныйКонтекст, КомментарийСледующему)
	
	ДанныеДокументов = Новый Массив;
	
	Отбор = Новый Структура("ИдентификаторЭтапа, Статус", ИдентификаторЭтапа, НовыйСтатус);
	ВлияниеНаДругиеПроцессы = Шаблон.ВлияниеНаДругиеПроцессы.НайтиСтроки(Отбор);
	
	Для Каждого Влияние Из ВлияниеНаДругиеПроцессы Цикл
		
		Если Лев(Влияние.СвязьСОбъектом, 9) = "(функция)" Тогда
			// для поиска зависимых документов используется подключаемая функция
			ИмяФункции = СокрЛП(Сред(Влияние.СвязьСОбъектом, 10));
			ЗависимыеДокументы = ПроцессыОбработкиДокументовПереопределяемый.ЗависимыеОбъекты(ИмяФункции, Объект);
		Иначе
			
			ЗависимыеДокументы = Новый Массив;
			
			ПутьКДанным = СтрРазделить(Влияние.СвязьСОбъектом, ".");
			Если ПутьКДанным.Количество() = 1 Тогда
				// Ссылка на зависимый документ в шапке
				ЗависимыеДокументы.Добавить(Объект[ПутьКДанным[0]]);
			Иначе
				// Ссылка на зависимый документ в табличной части
				Для Каждого СтрокаТЧ Из Объект[ПутьКДанным[0]] Цикл
					ЗависимыеДокументы.Добавить(СтрокаТЧ[ПутьКДанным[1]]);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗависимыеДокументы = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ЗависимыеДокументы);
		
		Если ЗависимыеДокументы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЗависимогоДокумента = Тип("ДокументСсылка."
			+ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Влияние.ЗависимыйШаблон, "ИдентификаторДокумента.Имя"));
		
		Для Каждого ЗависимыйДокумент Из ЗависимыеДокументы Цикл
			Если Не ЗначениеЗаполнено(ЗависимыйДокумент) ИЛИ ТипЗнч(ЗависимыйДокумент) <> ТипЗависимогоДокумента Тогда
				Продолжить;
			КонецЕсли;
			ШаблонЗависимогоДокумента = ШаблонИСтатусДокумента(ЗависимыйДокумент).Шаблон;
			Если ШаблонЗависимогоДокумента = Влияние.ЗависимыйШаблон
				ИЛИ ПроцессыОбработкиДокументовПереопределяемый.ВыполненоАльтернативноеУсловиеДляЗависимогоШаблона(ШаблонЗависимогоДокумента, Влияние) Тогда
				ДанныеДокумента = Новый Структура;
				ДанныеДокумента.Вставить("Ссылка", ЗависимыйДокумент);
				ДанныеДокумента.Вставить("Шаблон", ШаблонЗависимогоДокумента);
				ДанныеДокумента.Вставить("ИдентификаторЭтапа", Влияние.ИдентификаторЭтапаЗависимогоШаблона);
				ДанныеДокумента.Вставить("Статус", Влияние.УстанавливаемыйСтатус);
				ДанныеДокумента.Вставить("Исполнитель", Неопределено);
				ДанныеДокумента.Вставить("Комментарий", КомментарийСледующему);
				
				ДанныеДокументов.Добавить(ДанныеДокумента);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Если ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	Конецесли;
	
	ПодходящиеДокументы = Новый Соответствие;
	
	// Если результат выполнения этапа предполагает электронную подпись, то он не может быть выполнен без клиента
	ПроверитьТребованиеОНаличииЭП = ПолучитьФункциональнуюОпцию("ИспользоватьЭППриВыполненииЭтапов")
		И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись");
	
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
		ДанныеДокумента.Вставить("Отказ", Ложь);
		ДанныеДокумента.Вставить("СообщенияОбОшибке", Новый Массив);
		
		ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(ДанныеДокумента.Ссылка, ДанныеДокумента.Шаблон, , Истина);
		
		ДанныеДокумента.Вставить("ПараметрыТекущегоЭтапа", ПараметрыТекущегоЭтапа);
		
		Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
			ДанныеДокумента.СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Статус документа %1 не может быть изменен. %2'"),
					ДанныеДокумента.Ссылка,
					ПараметрыТекущегоЭтапа));
			ДанныеДокумента.Отказ = Истина;
			Продолжить;
		ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
			ДанныеДокумента.СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Статус документа %1 не может быть изменен. В данный момент выполняется задача по обработке документа.'"),
					ДанныеДокумента.Ссылка));
			ДанныеДокумента.Отказ = Истина;
			Продолжить;
		ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторЭтапа <> ДанныеДокумента.ИдентификаторЭтапа Тогда
			ДанныеДокумента.СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Статус документа %1 не может быть изменен. Документ находится на неподходящем этапе.'"),
				ДанныеДокумента.Ссылка));
			ДанныеДокумента.Отказ = Истина;
			Продолжить;
		ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая() Тогда
			Если НЕ ТекущийПользовательМожетБытьИсполнителем(ДанныеДокумента.Ссылка, ПараметрыТекущегоЭтапа, Шаблон) Тогда
				ДанныеДокумента.СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Статус документа %1 не может быть изменен. Недостаточно прав.'"),
						ДанныеДокумента.Ссылка));
				ДанныеДокумента.Отказ = Истина;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПроверитьТребованиеОНаличииЭП Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ИСТИНА КАК Поле1
			|ИЗ
			|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
			|ГДЕ
			|	ЭтапыПроцессовРезультатыВыполнения.Ссылка = &Ссылка
			|	И ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = &СтатусПослеВыполнения
			|	И ЭтапыПроцессовРезультатыВыполнения.ТребуетсяЭП";
			Запрос.УстановитьПараметр("Ссылка", ПараметрыТекущегоЭтапа.Этап);
			Запрос.УстановитьПараметр("СтатусПослеВыполнения", ДанныеДокумента.Статус);
			Если НЕ Запрос.Выполнить().Пустой() Тогда
				ДанныеДокумента.СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Статус документа %1 не может быть изменен. Этап, предполагающий использование усиленной электронной подписи, не может быть выполнен на сервере'"),
					ДанныеДокумента.Ссылка));
				ДанныеДокумента.Отказ = Истина;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ПодходящиеДокументы.Вставить(ДанныеДокумента.Ссылка, Истина);
		
	КонецЦикла;
	
	СообщенияОбОшибке = Новый Массив;
	
	// Если для документа настроено несколько влияний, и одно из них подходит, то другие следует удалить
	КоличествоЭлементовКоллекции = ДанныеДокументов.Количество();
	Для Индекс = 1 По КоличествоЭлементовКоллекции Цикл
		ОбратныйИндекс = КоличествоЭлементовКоллекции - Индекс;
		ДанныеДокумента = ДанныеДокументов[ОбратныйИндекс];
		Если ДанныеДокумента.Отказ И ПодходящиеДокументы[ДанныеДокумента.Ссылка] = Истина Тогда
			ДанныеДокументов.Удалить(ОбратныйИндекс);
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СообщенияОбОшибке, ДанныеДокумента.СообщенияОбОшибке);
		КонецЕсли;
	КонецЦикла;
	
	ПроверкаВыполненияТребованийШаблоновПроцессов(ДанныеДокументов, СообщенияОбОшибке);
	
	ВыполнитьЗадачиВТранзакции(ДанныеДокументов, СообщенияОбОшибке, ДополнительныйКонтекст, ВлияющаяЗадача);
	
	// Проброс исключения во внешнюю транзакцию
	Если СообщенияОбОшибке.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(СообщенияОбОшибке, Символы.ПС);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьЗапускЭтапов(Ссылка, Шаблон, ИдентификаторЭтапа, НовыйСтатус, КомментарийСледующему)
	
	// определение списка следующих задач
	МассивВозможныхЭтаповКЗапуску = Новый Массив;
	Для Каждого Последователь Из Шаблон.ПредшественникиЭтапов Цикл
		Если Последователь.ИдентификаторПредшественника = ИдентификаторЭтапа Тогда
			ДанныеПоследователя = Новый Структура;
			ДанныеПоследователя.Вставить("ИдентификаторПоследователя", Последователь.ИдентификаторПоследователя);
			ДанныеПоследователя.Вставить("УсловиеПерехода", Последователь.УсловиеПерехода);
			ДанныеПоследователя.Вставить("УсловиеРассмотрения", Последователь.УсловиеРассмотрения);
			МассивВозможныхЭтаповКЗапуску.Добавить(ДанныеПоследователя);
		КонецЕсли;
	КонецЦикла;
	
	ПроверятьНаличиеИсполнителейЭтапа = Константы.ПроверятьНаличиеИсполнителейПередЗапускомЭтапа.Получить();
	
	// определения возможности запуска задач и запуск
	Для Каждого Этап Из МассивВозможныхЭтаповКЗапуску Цикл
		
		ЭтапДляЗапуска = Шаблон.Этапы.Найти(Этап.ИдентификаторПоследователя, "ИдентификаторЭтапа");
		Если ЭтапДляЗапуска = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В шаблона процесса обнаружено рассогласование таблиц ""Этапы"" и ""Предшественники"".'");
		КонецЕсли;
		
		// Определим возможность запуска этапа
		
		УстановитьПривилегированныйРежим(Истина);
		
		ПредшественникиЭтапа = Новый Массив;
		Для Каждого Предшественник Из Шаблон.ПредшественникиЭтапов Цикл
			Если Предшественник.ИдентификаторПоследователя = ЭтапДляЗапуска.ИдентификаторЭтапа Тогда
				
				НаборЗаписейПереходов = РегистрыСведений.ПереходыМеждуЭтапамиПроцесса.СоздатьНаборЗаписей();
				НаборЗаписейПереходов.Отбор.Предмет.Установить(Ссылка);
				НаборЗаписейПереходов.Отбор.ИдентификаторПоследователя.Установить(ЭтапДляЗапуска.ИдентификаторЭтапа);
				НаборЗаписейПереходов.Отбор.ИдентификаторПредшественника.Установить(Предшественник.ИдентификаторПредшественника);
				НаборЗаписейПереходов.Прочитать();
				
				ДанныеПредшественника = Новый Структура;
				ДанныеПредшественника.Вставить("ИдентификаторПредшественника", Предшественник.ИдентификаторПредшественника);
				ДанныеПредшественника.Вставить("УсловиеПерехода", Предшественник.УсловиеПерехода);
				ДанныеПредшественника.Вставить("УсловиеРассмотрения", Предшественник.УсловиеРассмотрения);
				ДанныеПредшественника.Вставить("ЛюбаяЗадачаПредшественника", Предшественник.ЛюбаяЗадачаПредшественника);
				
				Если НаборЗаписейПереходов.Количество() > 0 Тогда
					ДанныеПредшественника.Вставить("УсловныйПереходБылВыполнен", НаборЗаписейПереходов[0].УсловныйПереходБылВыполнен);
				Иначе
					ДанныеПредшественника.Вставить("УсловныйПереходБылВыполнен", Ложь);
				КонецЕсли;
				
				ПредшественникиЭтапа.Добавить(ДанныеПредшественника);
			КонецЕсли;
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Предшественники = Новый Массив;
		
		// В зависимости от варианта завершения предшественников 
		// устанавливается начальное значение результата проверки.
		Если СтрНайти(ЭтапДляЗапуска.ПредшественникиВариантИспользования, "ВсеПредшественники") > 0 Тогда
			Запуск = "ЗапускПоИ";
			Результат = Истина;
		ИначеЕсли СтрНайти(ЭтапДляЗапуска.ПредшественникиВариантИспользования, "ОдинИзПредшественников") > 0 Тогда
			Запуск = "ЗапускПоИЛИ";
			Результат = Ложь;
		Иначе
			ВызватьИсключение НСтр("ru = 'В шаблона процесса не указано условие запуска этапа '") + Строка(ЭтапДляЗапуска.Этап);
		КонецЕсли;
		
		Для Каждого ПредшественникЭтапа Из ПредшественникиЭтапа Цикл
			// Для запуска по И проверяем всех предшественников
			Если Запуск = "ЗапускПоИ" Тогда
				ПереходВозможен = НЕ ПредшественникЭтапа.УсловныйПереходБылВыполнен
					И УсловиеПереходаВыполнено(
						ПредшественникЭтапа.ИдентификаторПредшественника,
						ПредшественникЭтапа.УсловиеРассмотрения,
						ПредшественникЭтапа.УсловиеПерехода,
						Ссылка,
						Предшественники,
						ПредшественникЭтапа.ЛюбаяЗадачаПредшественника);
				Результат = Результат И ПереходВозможен;
				// Если уже Ложь, то дальнейшая проверка по И не имеет смысла
				Если Не Результат Тогда
					Прервать;
				КонецЕсли;
			ИначеЕсли Запуск = "ЗапускПоИЛИ" Тогда
				// Для запуска по ИЛИ проверяем только текущего предшественника
				Если ПредшественникЭтапа.ИдентификаторПредшественника <> ИдентификаторЭтапа Тогда
					Продолжить;
				КонецЕсли;
				ПереходВозможен = НЕ ПредшественникЭтапа.УсловныйПереходБылВыполнен
					И УсловиеПереходаВыполнено(
						ПредшественникЭтапа.ИдентификаторПредшественника,
						ПредшественникЭтапа.УсловиеРассмотрения,
						ПредшественникЭтапа.УсловиеПерехода,
						Ссылка,
						Предшественники,
						ПредшественникЭтапа.ЛюбаяЗадачаПредшественника);
				Результат = Результат ИЛИ ПереходВозможен;
				// Если уже Истина, то дальнейшая проверка по ИЛИ не имеет смысла
				Если Результат Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если Не Результат Тогда
			Продолжить;
		КонецЕсли;
		
		// для этапа, который запускается, надо удалить признак перехода по нему
		УстановкаПризнаковПереходаПоЗапускаемомуЭтапу(Ссылка, Шаблон, ЭтапДляЗапуска.ИдентификаторЭтапа);
		
		ИсполнителиЭтапа = ИсполнителиЭтапаПроцесса(Ссылка, Шаблон, ЭтапДляЗапуска);
		
		Если ПроверятьНаличиеИсполнителейЭтапа Тогда
			СтандартнаяОбработка = Истина;
			ИсполнителиЭтапаНайдены = ПроцессыОбработкиДокументовПереопределяемый.ПроверитьЗаданныхИсполнителейЭтапа(ИсполнителиЭтапа, СтандартнаяОбработка);
			
			Если СтандартнаяОбработка Тогда
				НеНайденныеИсполнителиЭтапа = ПроверитьЗаданныхИсполнителейЭтапа(ИсполнителиЭтапа); 
				
				Если НеНайденныеИсполнителиЭтапа.Количество() > 0 Тогда
					ТекстИсполнителиЭтапа = СтрСоединить(НеНайденныеИсполнителиЭтапа, " и ");
					НаименованиеЭтапа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтапДляЗапуска.Этап, "Наименование");
					ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не определены исполнители задачи для ролей %1 для этапа ""%2"".'"),
					ТекстИсполнителиЭтапа, НаименованиеЭтапа);
				КонецЕсли; 
			ИначеЕсли Не ИсполнителиЭтапаНайдены Тогда
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не определены исполнители задачи по роли для этапа ""%1"".'"),
				Строка(ЭтапДляЗапуска.Этап));
			КонецЕсли;
			
		КонецЕсли;
		
		// создание следующих задач
		Для Каждого ИсполнительЭтапа Из ИсполнителиЭтапа Цикл
			
			Если ИсполнительЭтапа.НеСоздаватьЗадачу Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыЗадачи = ПараметрыСозданияЗадачи();
			ПараметрыЗадачи.Шаблон = Шаблон;
			ПараметрыЗадачи.Этап = ЭтапДляЗапуска.Этап;
			ПараметрыЗадачи.ИдентификаторЭтапа = ЭтапДляЗапуска.ИдентификаторЭтапа;
			ПараметрыЗадачи.НаименованиеЭтапа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтапДляЗапуска.Этап, "Наименование");
			ПараметрыЗадачи.Статус = НовыйСтатус;
			ПараметрыЗадачи.Документ = Ссылка;
			ПараметрыЗадачи.Описание = КомментарийСледующему;
			ПараметрыЗадачи.РезультатВыполнения = "";
			ПараметрыЗадачи.ПринятаКИсполнению = Ложь;
			ПараметрыЗадачи.Предшественники = Предшественники;
			ПараметрыЗадачи.СрокВыполненияЧасы = ЭтапДляЗапуска.СрокВыполненияЧасы;
			ПараметрыЗадачи.СрокиОбработкиПоРеквизитуДни = ЭтапДляЗапуска.СрокиОбработкиПоРеквизитуДни; 
			ПараметрыЗадачи.СрокиОбработкиПоРеквизитуЧасы = ЭтапДляЗапуска.СрокиОбработкиПоРеквизитуЧасы;
			ПараметрыЗадачи.Порядок = ЭтапДляЗапуска.Порядок; 
			
			ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыЗадачи, ИсполнительЭтапа, Истина);
			
			СоздатьЗадачу(ПараметрыЗадачи);
			
			ИсполнительЭтапа.Вставить("Задача", ПараметрыЗадачи.Задача);
			
		КонецЦикла;
		
		УправлениеИсполнителямиГрупповогоЭтапаПриЗапускеЭтапа(Ссылка, ИсполнителиЭтапа, ЭтапДляЗапуска);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьПрерываниеЭтапов(Ссылка, Шаблон, ИдентификаторЭтапа, НовыйСтатус, ИнициаторПрерывания, Комментарий)
	
	// определение списка прерываемых этапов
	МассивВозможныхЭтаповДляПрерывания = Новый Массив;
	Для Каждого Последователь Из Шаблон.ПрерываниеЭтапов Цикл
		Если Последователь.ИдентификаторПредшественника = ИдентификаторЭтапа Тогда
			ДанныеПоследователя = Новый Структура;
			ДанныеПоследователя.Вставить("ИдентификаторПоследователя", Последователь.ИдентификаторПоследователя);
			ДанныеПоследователя.Вставить("УсловиеПерехода", Последователь.УсловиеПерехода);
			ДанныеПоследователя.Вставить("УсловиеРассмотрения", Последователь.УсловиеРассмотрения);
			ДанныеПоследователя.Вставить("ЛюбаяЗадачаПредшественника", Последователь.ЛюбаяЗадачаПредшественника);
			// при прерывании этапов важно сначала выполнить прерывание задач этого же этапа, а потом всех остальных
			Если Последователь.ИдентификаторПоследователя = ИдентификаторЭтапа Тогда
				МассивВозможныхЭтаповДляПрерывания.Вставить(0, ДанныеПоследователя);
			Иначе
				МассивВозможныхЭтаповДляПрерывания.Добавить(ДанныеПоследователя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// определение возможности прерывания задач и прерывание
	Для Каждого ЭтапДляПрерывания Из МассивВозможныхЭтаповДляПрерывания Цикл
		
		СвойстваЭтапаДляПрерывания = Шаблон.Этапы.Найти(ЭтапДляПрерывания.ИдентификаторПоследователя, "ИдентификаторЭтапа");
		
		Если СвойстваЭтапаДляПрерывания = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В шаблона процесса обнаружено рассогласование таблиц ""Этапы"" и ""Прерывание этапов"".'");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтапДляПрерывания.УсловиеРассмотрения) И НовыйСтатус <> ЭтапДляПрерывания.УсловиеРассмотрения Тогда
			Продолжить;
		КонецЕсли;
		
		Предшественники = Новый Массив;
		
		Если УсловиеПереходаВыполнено(
				ИдентификаторЭтапа,
				ЭтапДляПрерывания.УсловиеРассмотрения,
				ЭтапДляПрерывания.УсловиеПерехода,
				Ссылка,
				Предшественники,
				ЭтапДляПрерывания.ЛюбаяЗадачаПредшественника) Тогда
				
			// поиск непрерванных задач по прерываемому этапу и прерывание невыполненных
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ЗадачаПоОбработкеДокумента.Ссылка КАК Задача,
			|	ЗадачаПоОбработкеДокумента.Выполнена КАК Выполнена
			|ИЗ
			|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗадачиПрерванныхЭтапов КАК ЗадачиПрерванныхЭтапов
			|		ПО ЗадачаПоОбработкеДокумента.Ссылка = ЗадачиПрерванныхЭтапов.ЗадачаПреванногоЭтапа
			|ГДЕ
			|	НЕ ЗадачаПоОбработкеДокумента.Прервана
			|	И ЗадачаПоОбработкеДокумента.Предмет = &Документ
			|	И ЗадачаПоОбработкеДокумента.ИдентификаторЭтапа = &ИдентификаторЭтапа
			|	И НЕ ЗадачаПоОбработкеДокумента.Ссылка = &Ссылка
			|	И ЗадачиПрерванныхЭтапов.ЗадачаПреванногоЭтапа ЕСТЬ NULL
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЗадачаПоОбработкеДокумента.Дата УБЫВ";
			
			Запрос.УстановитьПараметр("Документ", Ссылка);
			Запрос.УстановитьПараметр("ИдентификаторЭтапа", ЭтапДляПрерывания.ИдентификаторПоследователя);
			Запрос.УстановитьПараметр("Ссылка", ИнициаторПрерывания);
			
			УстановитьПривилегированныйРежим(Истина);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			УстановитьПривилегированныйРежим(Ложь);
			
			Пока Выборка.Следующий() Цикл
				
				// даже если задача уже выполнена, ее все равно надо записать в регистр как потенциально прерванную,
				// чтобы позже нельзя было отменить ее выполнение
				
				Если Не Выборка.Выполнена Тогда
					
					УстановитьПривилегированныйРежим(Истина);
					
					ВыполнитьЗадачуПользователя(Выборка.Задача, Истина, Комментарий);
					
					УстановитьПривилегированныйРежим(Ложь);
					
					СохранитьСвязьСИнициаторамиПрерывания(Предшественники, Выборка.Задача);
					
					СохранитьСобытиеИсторииЗадач(Выборка.Задача, ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.Прерывание"));
					
					ПроцессыОбработкиДокументовПереопределяемый.ПриВыполненииЗадачи(Выборка.Задача);
					
				Иначе
					
					СохранитьСвязьСИнициаторамиПрерыванияЭтапа(Предшественники, Выборка.Задача);
					
				Конецесли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьСвязьСИнициаторамиПрерывания(ИнициаторыПрерывания, ПрерваннаяЗадача)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого ИнициаторПрерывания Из ИнициаторыПрерывания Цикл
		МенеджерЗаписи = РегистрыСведений.ПрерванныеЗадачи.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИнициаторПрерывания = ИнициаторПрерывания;
		МенеджерЗаписи.ПрерваннаяЗадача = ПрерваннаяЗадача;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьСвязьСИнициаторамиПрерыванияЭтапа(ИнициаторыПрерывания, ЗадачаПреванногоЭтапа)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого ИнициаторПрерывания Из ИнициаторыПрерывания Цикл
		МенеджерЗаписи = РегистрыСведений.ЗадачиПрерванныхЭтапов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИнициаторПрерывания = ИнициаторПрерывания;
		МенеджерЗаписи.ЗадачаПреванногоЭтапа = ЗадачаПреванногоЭтапа;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСвязьСИнициаторомПрерывания(ИнициаторПрерывания)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.ПрерванныеЗадачи.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИнициаторПрерывания.Установить(ИнициаторПрерывания);
	НаборЗаписей.Записать();
	
	НаборЗаписей = РегистрыСведений.ЗадачиПрерванныхЭтапов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИнициаторПрерывания.Установить(ИнициаторПрерывания);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура СохранитьСвязьСВлияющейЗадачей(ВлияющаяЗадача, ЗависимаяЗадача)
	
	Если НЕ ЗначениеЗаполнено(ВлияющаяЗадача) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЗависимыеЗадачи.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ВлияющаяЗадача = ВлияющаяЗадача;
	МенеджерЗаписи.ЗависимаяЗадача = ЗависимаяЗадача;
	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура ВыполнитьДополнительныйОбработчик(Ссылка, Задача, Шаблон, ИдентификаторЭтапа, НовыйСтатус,
	ДополнительныйКонтекст, ДополнительныеПараметры = Неопределено, КонтекстЗадачи = Неопределено,
	ОтменаВыполнения = Ложь, ВыполнитьОбработчикДоТранзакции = Ложь, Комментарий = "")
	
	Отбор = Новый Структура("ИдентификаторЭтапа, Статус", ИдентификаторЭтапа, НовыйСтатус);
	ДополнительныеОбработчики = Шаблон.ДополнительныеОбработчики.НайтиСтроки(Отбор);
	
	Если ДополнительныеОбработчики.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыполнитьОбработчикДоТранзакции Тогда
		
		Для Каждого Обработчик Из СтрРазделить(ДополнительныеОбработчики[0].ОбработчикДоТранзакции, ";", Ложь) Цикл
		
			ПараметрыОбработчика = Новый Структура;
			ПараметрыОбработчика.Вставить("Источник", Ссылка);
			ПараметрыОбработчика.Вставить("Задача", Задача);
			ПараметрыОбработчика.Вставить("ОтменаВыполнения", ОтменаВыполнения);
			ПараметрыОбработчика.Вставить("Отказ", Ложь);
			ПараметрыОбработчика.Вставить("ОписаниеОшибки", "");
			ПараметрыОбработчика.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
			ПараметрыОбработчика.Вставить("ДополнительныйКонтекст", ДополнительныйКонтекст);
			ПараметрыОбработчика.Вставить("Комментарий", Комментарий);
			
			ПроцессыОбработкиДокументовОбработчикиПереопределяемый.ВыполнитьДополнительныйОбработчик(Обработчик, ПараметрыОбработчика);
			
			Если ПараметрыОбработчика.Отказ Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В дополнительном обработчике документа %1 был установлен отказ от выполнения этапа по причине:
						|%2'"), Ссылка, ПараметрыОбработчика.ОписаниеОшибки);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
			
			ДополнительныйКонтекст = ПараметрыОбработчика.ДополнительныйКонтекст;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого Обработчик Из СтрРазделить(ДополнительныеОбработчики[0].Обработчик, ";", Ложь) Цикл
		
		ПараметрыОбработчика = Новый Структура;
		
		ПараметрыОбработчика.Вставить("Источник", Ссылка);
		ПараметрыОбработчика.Вставить("Задача", Задача);
		ПараметрыОбработчика.Вставить("ОтменаВыполнения", ОтменаВыполнения);
		ПараметрыОбработчика.Вставить("Отказ", Ложь);
		ПараметрыОбработчика.Вставить("ОписаниеОшибки", "");
		ПараметрыОбработчика.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
		ПараметрыОбработчика.Вставить("ДополнительныйКонтекст", ДополнительныйКонтекст);
		ПараметрыОбработчика.Вставить("Комментарий", Комментарий);
		
		ПроцессыОбработкиДокументовОбработчикиПереопределяемый.ВыполнитьДополнительныйОбработчик(Обработчик, ПараметрыОбработчика);
		
		Если ПараметрыОбработчика.Отказ Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В дополнительном обработчике документа %1 был установлен отказ от выполнения этапа по причине:
					|%2'"), Ссылка, ПараметрыОбработчика.ОписаниеОшибки);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		Если ПараметрыОбработчика.Свойство("ПараметрыОповещения")
			И КонтекстЗадачи <> Неопределено Тогда
			КонтекстЗадачи.Вставить("ПараметрыОповещения", ПараметрыОбработчика.ПараметрыОповещения);
		КонецЕсли;
		
		ДополнительныеПараметры = ПараметрыОбработчика.ДополнительныеПараметры;
		
		ДополнительныйКонтекст = ПараметрыОбработчика.ДополнительныйКонтекст;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтменитьВыполнениеЗависимыхЗадач(ВлияющаяЗадача)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗависимыеЗадачи.ЗависимаяЗадача КАК Задача,
	|	ЗависимыеЗадачи.ЗависимаяЗадача.Предмет КАК Предмет,
	|	ЗависимыеЗадачи.ЗависимаяЗадача.Шаблон КАК Шаблон,
	|	ЗависимыеЗадачи.ЗависимаяЗадача.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	|	ЗависимыеЗадачи.ЗависимаяЗадача.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ЗависимыеЗадачи КАК ЗависимыеЗадачи
	|ГДЕ
	|	ЗависимыеЗадачи.ВлияющаяЗадача = &ВлияющаяЗадача";
	
	Запрос.УстановитьПараметр("ВлияющаяЗадача", ВлияющаяЗадача);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ПроверитьИЗаблокироватьЗадачиОтВыполнения(Выборка.Задача);
			
			ЗаблокироватьЗадачи(Выборка.Задача);
			
			СвойстваЭтапа = СвойстваЭтапаШаблонаПроцесса(Выборка.Шаблон, Выборка.ИдентификаторЭтапа);
			ПроверитьНаличиеПрерванных = СвойстваЭтапа.НеЗапрещатьОтменуВыполненияПриНаличииПрерванных;
			
			Если ПроверитьНаличиеПрерванных И ЕстьРанееПрерванныеЗадачи(Выборка.Задача) Тогда
				ВызватьИсключение НСтр("ru = 'При выполнении задачи были прерваны другие задачи.'");
			КонецЕсли;
			
			ОтменитьВыполнениеЗадачи(
				Выборка.Задача,
				Выборка.Предмет,
				Выборка.Шаблон,
				Выборка.ИдентификаторЭтапа,
				СвойстваЭтапа,
			);
			
		Исключение
			
			ТекстСообщения = НСтр("ru = 'не удалось выполнить отмену выполнения зависимой задачи ""'")
								+ Строка(Выборка.Задача)
								+ НСтр("ru = '"" по причине: '")
								+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			
			ВызватьИсключение ТекстСообщения;
			
		КонецПопытки;
		
	КонецЦикла;
	
	// Если отмена выполнения зависимых задач прошла успешно, то необходимо очистить связь с влияющей задачей
	НаборЗаписей = РегистрыСведений.ЗависимыеЗадачи.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВлияющаяЗадача.Установить(ВлияющаяЗадача);
	УстановитьПривилегированныйРежим(Истина);
	НаборЗаписей.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПараметрыТекущегоЭтапаПроцесса(Ссылка, Шаблон, НовыйДокумент = Ложь,
	ПодробноеПредставлениеОшибки = Ложь, Пользователь = Неопределено) Экспорт
	
	Если НовыйДокумент Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ШаблоныПроцессовЭтапы.Этап КАК СтартовыйЭтап,
		|	ШаблоныПроцессовЭтапы.Этап.Наименование КАК НаименованиеЭтапа,
		|	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
		|	ШаблоныПроцессовЭтапы.Исполнитель КАК Исполнитель,
		|	ШаблоныПроцессовЭтапы.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
		|	ШаблоныПроцессовЭтапы.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации,
		|	ШаблоныПроцессовЭтапы.ИмяРеквизитаОсновногоОбъектаАдресации КАК ИмяРеквизитаОсновногоОбъектаАдресации,
		|	ШаблоныПроцессовЭтапы.ИмяРеквизитаДополнительногоОбъектаАдресации КАК ИмяРеквизитаДополнительногоОбъектаАдресации,
		|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок,
		|	ШаблоныПроцессовЭтапы.ЗапретитьПроведениеОтменуПроведения КАК ЗапретитьПроведениеОтменуПроведения,
		|	ШаблоныПроцессовЭтапы.ЗапретитьПерепроведение КАК ЗапретитьПерепроведение,
		|	ШаблоныПроцессовЭтапы.ЗапрещеноДобавлениеФайлов КАК ЗапрещеноДобавлениеФайлов,
		|	ШаблоныПроцессовЭтапы.ЗапрещеноИзменениеФайлов КАК ЗапрещеноИзменениеФайлов,
		|	ШаблоныПроцессовЭтапы.НаличиеФайловОбязательно КАК НаличиеФайловОбязательно,
		|	ШаблоныПроцессовЭтапы.РасшифровкаОбязательныхПрисоединенныхФайлов КАК РасшифровкаОбязательныхПрисоединенныхФайлов,
		|	ШаблоныПроцессовЭтапы.СрокВыполненияЧасы КАК СрокВыполненияЧасы,
		|	ШаблоныПроцессовЭтапы.СрокиОбработкиПоРеквизитуДни КАК СрокиОбработкиПоРеквизитуДни,
		|	ШаблоныПроцессовЭтапы.СрокиОбработкиПоРеквизитуЧасы КАК СрокиОбработкиПоРеквизитуЧасы,
		|	ЛОЖЬ КАК ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске,
		|	ШаблоныПроцессовЭтапы.ЭтапВыполняетсяНесколькимиИсполнителями КАК ЭтапВыполняетсяНесколькимиИсполнителями,
		|	ЗНАЧЕНИЕ(Задача.ЗадачаПоОбработкеДокумента.ПустаяСсылка) КАК Задача,
		|	"""" КАК Автор,
		|	"""" КАК Описание,
		|	"""" КАК РезультатВыполнения,
		|	НЕОПРЕДЕЛЕНО КАК ИдентификаторПачки
		|ИЗ
		|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
		|ГДЕ
		|	ШаблоныПроцессовЭтапы.Ссылка = &Шаблон
		|	И ШаблоныПроцессовЭтапы.ПредшественникиВариантИспользования ПОДОБНО ""Старт,%""";
		Запрос.УстановитьПараметр("Шаблон", Шаблон);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Этап 										= Выборка.СтартовыйЭтап;
			НаименованиеЭтапа 							= Выборка.НаименованиеЭтапа;
			ИдентификаторЭтапа 							= Выборка.ИдентификаторЭтапа;
			Исполнитель 								= Выборка.Исполнитель;
			ОсновнойОбъектАдресации 					= Выборка.ОсновнойОбъектАдресации;
			ДополнительныйОбъектАдресации 				= Выборка.ДополнительныйОбъектАдресации;
			ИмяРеквизитаОсновногоОбъектаАдресации 		= Выборка.ИмяРеквизитаОсновногоОбъектаАдресации;
			ИмяРеквизитаДополнительногоОбъектаАдресации = Выборка.ИмяРеквизитаДополнительногоОбъектаАдресации;
			Порядок 									= Выборка.Порядок;
			ЗапретитьПроведениеОтменуПроведения 		= Выборка.ЗапретитьПроведениеОтменуПроведения;
			ЗапретитьПерепроведение 					= Выборка.ЗапретитьПерепроведение;
			ЗапрещеноДобавлениеФайлов 					= Выборка.ЗапрещеноДобавлениеФайлов;
			ЗапрещеноИзменениеФайлов 					= Выборка.ЗапрещеноИзменениеФайлов;
			НаличиеФайловОбязательно 					= Выборка.НаличиеФайловОбязательно;
			РасшифровкаОбязательныхПрисоединенныхФайлов = Выборка.РасшифровкаОбязательныхПрисоединенныхФайлов;
			СрокВыполненияЧасы 							= Выборка.СрокВыполненияЧасы;
			СрокиОбработкиПоРеквизитуДни 				= Выборка.СрокиОбработкиПоРеквизитуДни;
			СрокиОбработкиПоРеквизитуЧасы 				= Выборка.СрокиОбработкиПоРеквизитуЧасы;
			ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске = Выборка.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске;
			ЭтапВыполняетсяНесколькимиИсполнителями 	= Выборка.ЭтапВыполняетсяНесколькимиИсполнителями;
			Задача 										= Выборка.Задача;
			Автор 										= Выборка.Автор;
			Описание 									= Выборка.Описание;
			РезультатВыполнения 						= Выборка.РезультатВыполнения;
			ИдентификаторПачки 							= Выборка.ИдентификаторПачки;
		Иначе
			Возврат НСтр("ru='Не определен стартовый этап процесса.'");
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТекущиеНевыполненныеЗадачи.Этап КАК Этап,
		|	ТекущиеНевыполненныеЗадачи.Этап.Наименование КАК НаименованиеЭтапа,
		|	ТекущиеНевыполненныеЗадачи.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
		|	ВЫБОР
		|		КОГДА ТекущиеНевыполненныеЗадачи.Исполнитель = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|			ТОГДА ТекущиеНевыполненныеЗадачи.РольИсполнителя
		|		ИНАЧЕ ТекущиеНевыполненныеЗадачи.Исполнитель
		|	КОНЕЦ КАК Исполнитель,
		|	ТекущиеНевыполненныеЗадачи.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
		|	ТекущиеНевыполненныеЗадачи.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации,
		|	ШаблоныПроцессовЭтапы.ИмяРеквизитаОсновногоОбъектаАдресации КАК ИмяРеквизитаОсновногоОбъектаАдресации,
		|	ШаблоныПроцессовЭтапы.ИмяРеквизитаДополнительногоОбъектаАдресации КАК ИмяРеквизитаДополнительногоОбъектаАдресации,
		|	ШаблоныПроцессовЭтапы.Порядок КАК Порядок,
		|	ШаблоныПроцессовЭтапы.ЗапретитьПроведениеОтменуПроведения КАК ЗапретитьПроведениеОтменуПроведения,
		|	ШаблоныПроцессовЭтапы.ЗапретитьПерепроведение КАК ЗапретитьПерепроведение,
		|	ШаблоныПроцессовЭтапы.ЗапрещеноДобавлениеФайлов КАК ЗапрещеноДобавлениеФайлов,
		|	ШаблоныПроцессовЭтапы.ЗапрещеноИзменениеФайлов КАК ЗапрещеноИзменениеФайлов,
		|	ШаблоныПроцессовЭтапы.НаличиеФайловОбязательно КАК НаличиеФайловОбязательно,
		|	ШаблоныПроцессовЭтапы.РасшифровкаОбязательныхПрисоединенныхФайлов КАК РасшифровкаОбязательныхПрисоединенныхФайлов,
		|	ШаблоныПроцессовЭтапы.СрокВыполненияЧасы КАК СрокВыполненияЧасы,
		|	ШаблоныПроцессовЭтапы.СрокиОбработкиПоРеквизитуДни КАК СрокиОбработкиПоРеквизитуДни,
		|	ШаблоныПроцессовЭтапы.СрокиОбработкиПоРеквизитуЧасы КАК СрокиОбработкиПоРеквизитуЧасы,
		|	ШаблоныПроцессовЭтапы.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске КАК ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске,
		|	ШаблоныПроцессовЭтапы.ЭтапВыполняетсяНесколькимиИсполнителями КАК ЭтапВыполняетсяНесколькимиИсполнителями,
		|	ЕСТЬNULL(ТекущиеНевыполненныеЗадачи.Ссылка, ЗНАЧЕНИЕ(Задача.ЗадачаПоОбработкеДокумента.ПустаяСсылка)) КАК Задача,
		|	ЕСТЬNULL(ТекущиеНевыполненныеЗадачи.Автор, """") КАК Автор,
		|	ЕСТЬNULL(ТекущиеНевыполненныеЗадачи.Описание, """") КАК Описание,
		|	ЕСТЬNULL(ТекущиеНевыполненныеЗадачи.РезультатВыполнения, """") КАК РезультатВыполнения,
		|	ЕСТЬNULL(СоставПачекВыполняемыхЗадач.ИдентификаторПачки, НЕОПРЕДЕЛЕНО) КАК ИдентификаторПачки
		|ИЗ
		|	Задача.ЗадачаПоОбработкеДокумента.ЗадачиПоИсполнителю(
		|			&Пользователь,
		|			Шаблон = &Шаблон
		|				И Предмет = &Ссылка
		|				И НЕ Выполнена) КАК ТекущиеНевыполненныеЗадачи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
		|		ПО (ШаблоныПроцессовЭтапы.Ссылка = ТекущиеНевыполненныеЗадачи.Шаблон)
		|			И (ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = ТекущиеНевыполненныеЗадачи.ИдентификаторЭтапа)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
		|		ПО ТекущиеНевыполненныеЗадачи.Ссылка = СоставПачекВыполняемыхЗадач.Задача
		|
		|УПОРЯДОЧИТЬ ПО
		|	ШаблоныПроцессовЭтапы.ЭтапВыполняетсяНесколькимиИсполнителями УБЫВ,
		|	ТекущиеНевыполненныеЗадачи.Дата,
		|	ТекущиеНевыполненныеЗадачи.Ссылка";
		Запрос.УстановитьПараметр("Шаблон", Шаблон);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Если Пользователь = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Пользователь", "");
		Иначе
			Запрос.УстановитьПараметр("Пользователь", Пользователь);
		КонецЕсли;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.Порядок = Null Тогда
				Возврат НСтр("ru='Ошибка получения свойств этапа в шаблоне процесса'");
			КонецЕсли;
			Этап 										= Выборка.Этап;
			НаименованиеЭтапа 							= Выборка.НаименованиеЭтапа;
			ИдентификаторЭтапа 							= Выборка.ИдентификаторЭтапа;
			Исполнитель 								= Выборка.Исполнитель;
			ОсновнойОбъектАдресации 					= Выборка.ОсновнойОбъектАдресации;
			ДополнительныйОбъектАдресации 				= Выборка.ДополнительныйОбъектАдресации;
			ИмяРеквизитаОсновногоОбъектаАдресации 		= Выборка.ИмяРеквизитаОсновногоОбъектаАдресации;
			ИмяРеквизитаДополнительногоОбъектаАдресации = Выборка.ИмяРеквизитаДополнительногоОбъектаАдресации;
			Порядок 									= Выборка.Порядок;
			ЗапретитьПроведениеОтменуПроведения 		= Выборка.ЗапретитьПроведениеОтменуПроведения;
			ЗапретитьПерепроведение 					= Выборка.ЗапретитьПерепроведение;
			ЗапрещеноДобавлениеФайлов 					= Выборка.ЗапрещеноДобавлениеФайлов;
			ЗапрещеноИзменениеФайлов 					= Выборка.ЗапрещеноИзменениеФайлов;
			НаличиеФайловОбязательно 					= Выборка.НаличиеФайловОбязательно;
			РасшифровкаОбязательныхПрисоединенныхФайлов = Выборка.РасшифровкаОбязательныхПрисоединенныхФайлов;
			СрокВыполненияЧасы 							= Выборка.СрокВыполненияЧасы;
			СрокиОбработкиПоРеквизитуДни 				= Выборка.СрокиОбработкиПоРеквизитуДни;
			СрокиОбработкиПоРеквизитуЧасы 				= Выборка.СрокиОбработкиПоРеквизитуЧасы;
			ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске = Выборка.ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске;
			ЭтапВыполняетсяНесколькимиИсполнителями 	= Выборка.ЭтапВыполняетсяНесколькимиИсполнителями;
			Задача 										= Выборка.Задача;
			Автор 										= Выборка.Автор;
			Описание 									= Выборка.Описание;
			РезультатВыполнения 						= Выборка.РезультатВыполнения;
			ИдентификаторПачки 							= Выборка.ИдентификаторПачки;
		Иначе
			Если ПодробноеПредставлениеОшибки Тогда
				Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	ЗадачаПоОбработкеДокумента.ПринятаКИсполнению КАК ПринятаКИсполнению,
				|	ЕСТЬNULL(СоставПачекВыполняемыхЗадач.ИдентификаторПачки, НЕОПРЕДЕЛЕНО) КАК ИдентификаторПачки
				|ИЗ
				|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
				|		ПО СоставПачекВыполняемыхЗадач.Задача = ЗадачаПоОбработкеДокумента.Ссылка
				|ГДЕ
				|	ЗадачаПоОбработкеДокумента.Шаблон = &Шаблон
				|	И ЗадачаПоОбработкеДокумента.Предмет = &Ссылка
				|	И НЕ ЗадачаПоОбработкеДокумента.Выполнена";
				УстановитьПривилегированныйРежим(Истина);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Если Выборка.ПринятаКИсполнению Тогда
						Возврат НСтр("ru='Документ находится на обработке у другого исполнителя.'");
					ИначеЕсли Выборка.ИдентификаторПачки <> Неопределено Тогда
						Возврат НСтр("ru='В данный момент выполняется задача по обработке документа.'");
					Иначе
						Возврат НСтр("ru='Недостаточно прав.'");
					КонецЕсли;
				Иначе
					Возврат НСтр("ru='Обработка документа уже завершена.'");
				КонецЕсли;
			Иначе
				Возврат НСтр("ru='Недостаточно прав.'");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыЭтапа = Новый Структура;
	ПараметрыЭтапа.Вставить("Этап",											Этап);
	ПараметрыЭтапа.Вставить("НаименованиеЭтапа",							НаименованиеЭтапа);
	ПараметрыЭтапа.Вставить("ИдентификаторЭтапа",							ИдентификаторЭтапа);
	ПараметрыЭтапа.Вставить("Исполнитель",									Исполнитель);
	ПараметрыЭтапа.Вставить("ОсновнойОбъектАдресации",						ОсновнойОбъектАдресации);
	ПараметрыЭтапа.Вставить("ДополнительныйОбъектАдресации",				ДополнительныйОбъектАдресации);
	ПараметрыЭтапа.Вставить("ИмяРеквизитаОсновногоОбъектаАдресации", 		ИмяРеквизитаОсновногоОбъектаАдресации);
	ПараметрыЭтапа.Вставить("ИмяРеквизитаДополнительногоОбъектаАдресации", 	ИмяРеквизитаДополнительногоОбъектаАдресации);
	ПараметрыЭтапа.Вставить("Порядок",										Порядок);
	ПараметрыЭтапа.Вставить("ЗапретитьПроведениеОтменуПроведения", 			ЗапретитьПроведениеОтменуПроведения);
	ПараметрыЭтапа.Вставить("ЗапретитьПерепроведение", 						ЗапретитьПерепроведение);
	ПараметрыЭтапа.Вставить("ЗапрещеноДобавлениеФайлов", 					ЗапрещеноДобавлениеФайлов);
	ПараметрыЭтапа.Вставить("ЗапрещеноИзменениеФайлов", 					ЗапрещеноИзменениеФайлов);
	ПараметрыЭтапа.Вставить("НаличиеФайловОбязательно", 					НаличиеФайловОбязательно);
	ПараметрыЭтапа.Вставить("РасшифровкаОбязательныхПрисоединенныхФайлов", 	РасшифровкаОбязательныхПрисоединенныхФайлов);
	ПараметрыЭтапа.Вставить("СрокВыполненияЧасы", 							СрокВыполненияЧасы);
	ПараметрыЭтапа.Вставить("СрокиОбработкиПоРеквизитуДни", 				СрокиОбработкиПоРеквизитуДни);
	ПараметрыЭтапа.Вставить("СрокиОбработкиПоРеквизитуЧасы", 				СрокиОбработкиПоРеквизитуЧасы);
	ПараметрыЭтапа.Вставить("ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске", ОтправлятьПредыдущемуИсполнителюПриПовторномЗапуске);
	ПараметрыЭтапа.Вставить("ЭтапВыполняетсяНесколькимиИсполнителями", 		ЭтапВыполняетсяНесколькимиИсполнителями);
	ПараметрыЭтапа.Вставить("Задача",										Задача);
	ПараметрыЭтапа.Вставить("Автор",										Автор);
	ПараметрыЭтапа.Вставить("Описание",										Описание);
	ПараметрыЭтапа.Вставить("РезультатВыполнения",							РезультатВыполнения);
	ПараметрыЭтапа.Вставить("ИдентификаторПачки",							ИдентификаторПачки);
	
	Возврат ПараметрыЭтапа;
	
КонецФункции

Процедура ПроверкаВыполненияТребованийШаблоновПроцессов(ДанныеДокументов, СообщенияОбОшибке)
	
	// Проверка выполнения требований к проведению
	МассивДокументовДляПроведения = Новый Массив;
	МассивДокументовДляПроведенияЛК = Новый Массив;
	МассивДокументовДляОтменыПроведения = Новый Массив;
	
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
		Если ДанныеДокумента.Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		ПризнакПроведенности = ПроцессыОбработкиДокументовПовтИсп.ПризнакПроведенности(
			ДанныеДокумента.Шаблон,
			Строка(ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа),
			ДанныеДокумента.Статус);
		
		Если ПризнакПроведенности = Истина Тогда
			Если ДанныеДокумента.Свойство("ЗадачаВыполненаВЛичномКабинете") Тогда
				МассивДокументовДляПроведенияЛК.Добавить(ДанныеДокумента.Ссылка);
			Иначе
				МассивДокументовДляПроведения.Добавить(ДанныеДокумента.Ссылка);
			КонецЕсли;
		ИначеЕсли ПризнакПроведенности = Ложь Тогда
			МассивДокументовДляОтменыПроведения.Добавить(ДанныеДокумента.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументыТребующиеПроведения = ОбщегоНазначения.ПроверитьПроведенностьДокументов(МассивДокументовДляПроведения);
	НепроведенныеДокументы = ОбщегоНазначения.ПровестиДокументы(ДокументыТребующиеПроведения);
	
	ДокументыТребующиеПроведенияЛК = ОбщегоНазначения.ПроверитьПроведенностьДокументов(МассивДокументовДляПроведенияЛК);
	ДополнительныеСвойства = Новый Структура();
	ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверки");
	НепроведенныеДокументыЛК = ПровестиДокументы(ДокументыТребующиеПроведенияЛК, ДополнительныеСвойства);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НепроведенныеДокументы, НепроведенныеДокументыЛК);
	
	Для Каждого НепроведенныйДокумент Из НепроведенныеДокументы Цикл
		
		Если НепроведенныйДокумент.ОписаниеОшибки = НСтр("ru = 'Поля документа не заполнены.'") Тогда
			СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Документ %1 не удалось провести по причине:
				|%2'"), НепроведенныйДокумент.Ссылка, НепроведенныйДокумент.ОписаниеОшибки));
		Иначе
			СообщенияОбОшибке.Добавить(НепроведенныйДокумент.ОписаниеОшибки);
		КонецЕсли;
		
		Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
			Если ДанныеДокумента.Ссылка = НепроведенныйДокумент.Ссылка Тогда
				ДанныеДокумента.Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ДокументыТребующиеОтменыПроведения = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		МассивДокументовДляОтменыПроведения, ОбщегоНазначения.ПроверитьПроведенностьДокументов(МассивДокументовДляОтменыПроведения));
	ПроведенныеДокументы = ОтменитьПроведениеДокументов(ДокументыТребующиеОтменыПроведения, Новый Структура);
	
	Для Каждого ПроведенныйДокумент Из ПроведенныеДокументы Цикл
		
		СообщенияОбОшибке.Добавить(ПроведенныйДокумент.ОписаниеОшибки);
		
		Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
			Если ДанныеДокумента.Ссылка = ПроведенныйДокумент.Ссылка Тогда
				ДанныеДокумента.Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	// Проверка выполнения требований к выполнению
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
		Если ДанныеДокумента.Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		УсловиеВыполнения = ПроцессыОбработкиДокументовПовтИсп.УсловиеВыполнения(
			ДанныеДокумента.Шаблон,
			Строка(ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа),
			ДанныеДокумента.Статус);
		
		Если НЕ ЗначениеЗаполнено(УсловиеВыполнения) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ДокументПодходитПоУсловию(ДанныеДокумента.Ссылка, УсловиеВыполнения) Тогда
			СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не выполнено условие выполнения этапа документа ""%1"":
				|%2'"),
				ДанныеДокумента.Ссылка,
				ПредставлениеОтбораКомпоновщикаНастроек(УсловиеВыполнения)));
			ДанныеДокумента.Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверка выполнения требований к заполненности обязательных реквизитов
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
		Если ДанныеДокумента.Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеДокументаДляПроверки = Новый Структура;
		ДанныеДокументаДляПроверки.Вставить("Источник", ДанныеДокумента.Ссылка);
		ДанныеДокументаДляПроверки.Вставить("Шаблон", ДанныеДокумента.Шаблон);
		ДанныеДокументаДляПроверки.Вставить("ИдентификаторЭтапа", ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа);
		ДанныеДокументаДляПроверки.Вставить("Отказ", Ложь);
		ДанныеДокументаДляПроверки.Вставить("ОписаниеОшибки", "");
		ДанныеДокументаДляПроверки.Вставить("Исполнитель", ДанныеДокумента.Исполнитель);
		
		ПроверитьЗаполненностьОбязательныхРеквизитов(ДанныеДокументаДляПроверки);
		Если ДанныеДокументаДляПроверки.Отказ Тогда
			СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка при выполнении этапа документа ""%1"":'"),
				ДанныеДокумента.Ссылка) + "
				|" + ДанныеДокументаДляПроверки.ОписаниеОшибки);
			ДанныеДокумента.Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	Иначе
		МодульРаботаСФайлами = Неопределено;
	КонецЕсли;
	
	// Проверка выполнения требования к наличию присоединенных файлов
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
		Если ДанныеДокумента.Отказ ИЛИ МодульРаботаСФайлами = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДанныеДокумента.ПараметрыТекущегоЭтапа.НаличиеФайловОбязательно Тогда
			
			Файлы = Новый Массив;
			МодульРаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ДанныеДокумента.Ссылка, Файлы);
			
			ФайлыПервичныхДокументов = ФайлыПервичныхДокументов(ДанныеДокумента.Ссылка);
			
			Файлы = ОбщегоНазначенияКлиентСервер.РазностьМассивов(Файлы, ФайлыПервичныхДокументов);
			
			Если Файлы.Количество() = 0 Тогда
				РасшифровкаПрисоединенныхФайлов = ДанныеДокумента.ПараметрыТекущегоЭтапа.РасшифровкаОбязательныхПрисоединенныхФайлов; 
				Если ЗначениеЗаполнено(РасшифровкаПрисоединенныхФайлов) Тогда
					ПредставлениеРасшифровки = "";
					МассивРасшифровки = СтрРазделить(РасшифровкаПрисоединенныхФайлов, ";", Ложь);
					Для Каждого СтрокаРасшифровки Из МассивРасшифровки Цикл
						ПредставлениеРасшифровки = ПредставлениеРасшифровки + "- " + СтрокаРасшифровки + Символы.ПС;
					КонецЦикла;
					СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для выполнения текущего этапа документ ""%1"" должен содержать присоединенные файлы: (%2)'"),
					ДанныеДокумента.Ссылка, ПредставлениеРасшифровки));
				Иначе
					СообщенияОбОшибке.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для выполнения текущего этапа документ ""%1"" должен содержать присоединенные файлы'"),
					ДанныеДокумента.Ссылка));
				КонецЕсли;	

				ДанныеДокумента.Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьЗадачиВТранзакции(ДанныеДокументов, СообщенияОбОшибке, ДополнительныйКонтекст, ВлияющаяЗадача = Неопределено)
	
	ДокументыДляБлокировки = ДокументыБезОтказа(ДанныеДокументов);
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьРегистрТекущиеСтатусыДокументов(ДокументыДляБлокировки);
		
		Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
			
			Если ДанныеДокумента.Отказ Тогда
				Продолжить;
			КонецЕсли;
			
			Исполнитель = ?(ДанныеДокумента.Свойство("Исполнитель") И ЗначениеЗаполнено(ДанныеДокумента.Исполнитель),
				ДанныеДокумента.Исполнитель, Пользователи.ТекущийПользователь());
			
			// если это стартовый этап, то создадим пользователю текущую задачу и сразу ее выполним
			Если ДанныеДокумента.ПараметрыТекущегоЭтапа.Задача.Пустая() Тогда
				
				ЗадачаОбъект = Задачи.ЗадачаПоОбработкеДокумента.СоздатьЗадачу();
				ЗадачаОбъект.Дата 				= ТекущаяДатаСеанса();
				ЗадачаОбъект.Автор 				= Исполнитель;
				ЗадачаОбъект.Исполнитель 		= Исполнитель;
				ЗадачаОбъект.Предмет 			= ДанныеДокумента.Ссылка;
				ЗадачаОбъект.Этап 				= ДанныеДокумента.ПараметрыТекущегоЭтапа.Этап;
				ЗадачаОбъект.ИдентификаторЭтапа = ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа;
				ЗадачаОбъект.Шаблон 			= ДанныеДокумента.Шаблон;
				ЗадачаОбъект.Статус 			= ДанныеДокумента.Статус;
				ЗадачаОбъект.Наименование 		= ДанныеДокумента.ПараметрыТекущегоЭтапа.НаименованиеЭтапа + ": " + ДанныеДокумента.Ссылка;
				
				ЗадачаСсылка = ЗадачаОбъект.Ссылка;
				
			Иначе
				
				ЗадачаСсылка = ДанныеДокумента.ПараметрыТекущегоЭтапа.Задача
				
			КонецЕсли;
			
			ДанныеДокумента.Вставить("Задача", ЗадачаСсылка);
			
			Отбор = Новый Структура("ИдентификаторЭтапа, Статус",
				ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа, ДанныеДокумента.Статус);
			ДополнительныеОбработчики = ДанныеДокумента.Шаблон.ДополнительныеОбработчики.НайтиСтроки(Отбор);
			Если ДополнительныеОбработчики.Количество() > 0 Тогда
				ДанныеДокумента.Вставить("ОбработчикДоТранзакции", ДополнительныеОбработчики[0].ОбработчикДоТранзакции);
			Иначе
				ДанныеДокумента.Вставить("ОбработчикДоТранзакции", "");
			КонецЕсли;
			
		КонецЦикла;
		
		// Поиск и выполнение групповых обработчиков
		ГрупповыеОбработчики = Новый Массив;
		Для Каждого Обработчик Из ОписаниеДополнительныхОбработчиков() Цикл
			Если Обработчик.Свойство("ГрупповаяОбработка") И Обработчик.ГрупповаяОбработка Тогда
				ГрупповыеОбработчики.Добавить(Обработчик.Идентификатор);
			КонецЕсли;
		КонецЦикла;
		
		НаборыДанныхДляГрупповойОбработки = Новый Структура;
		ИндексыЗадачСГрупповойОбработкой = Новый Соответствие;
		
		Для Индекс = 0 По ДанныеДокументов.ВГраница() Цикл
			ДанныеДокумента = ДанныеДокументов[Индекс];
			
			Если ДанныеДокумента.Отказ Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ПустаяСтрока(ДанныеДокумента.ОбработчикДоТранзакции)
				И ГрупповыеОбработчики.Найти(ДанныеДокумента.ОбработчикДоТранзакции) <> Неопределено Тогда
				
				ПараметрыДокумента = Новый Структура;
				ПараметрыДокумента.Вставить("Источник", ДанныеДокумента.Ссылка);
				ПараметрыДокумента.Вставить("Задача", ДанныеДокумента.Задача);
				ПараметрыДокумента.Вставить("Отказ", Ложь);
				ПараметрыДокумента.Вставить("ОписаниеОшибки", "");
				ПараметрыДокумента.Вставить("ДополнительныеПараметры", Неопределено);
				
				Если НаборыДанныхДляГрупповойОбработки.Свойство(ДанныеДокумента.ОбработчикДоТранзакции) Тогда
					НаборыДанныхДляГрупповойОбработки[ДанныеДокумента.ОбработчикДоТранзакции].Добавить(ПараметрыДокумента);
				Иначе
					НаборыДанныхДляГрупповойОбработки.Вставить(
					ДанныеДокумента.ОбработчикДоТранзакции, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыДокумента));
				КонецЕсли;
				
				ИндексыЗадачСГрупповойОбработкой.Вставить(ПараметрыДокумента.Задача, Индекс);
				
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого НаборДанныхДляГрупповойОбработки Из НаборыДанныхДляГрупповойОбработки Цикл
			
			ПараметрыОбработчика = Новый Структура;
			ПараметрыОбработчика.Вставить("НаборДанных", НаборДанныхДляГрупповойОбработки.Значение);
			ПараметрыОбработчика.Вставить("Отказ", Ложь);
			ПараметрыОбработчика.Вставить("ОписаниеОшибки", "");
			ПараметрыОбработчика.Вставить("ДополнительныйКонтекст", ДополнительныйКонтекст);
			
			ПроцессыОбработкиДокументовОбработчикиПереопределяемый.ВыполнитьДополнительныйОбработчик(
				НаборДанныхДляГрупповойОбработки.Ключ, ПараметрыОбработчика);
			
			Если ПараметрыОбработчика.Отказ Тогда
				СообщенияОбОшибке.Добавить(НСтр("ru = 'В дополнительном обработчике был установлен отказ от выполнения этапа по причине:
					|'") + ПараметрыОбработчика.ОписаниеОшибки);
				Для Каждого ДанныеДокумента Из НаборДанныхДляГрупповойОбработки.Значение Цикл
					ДанныеДокументов[ИндексыЗадачСГрупповойОбработкой.Получить(ДанныеДокумента.Задача)].Отказ = Истина;
				КонецЦикла;
			Иначе
				Для Каждого ДанныеДокумента Из НаборДанныхДляГрупповойОбработки.Значение Цикл
					Если ДанныеДокумента.Отказ Тогда
						СообщенияОбОшибке.Добавить(НСтр("ru = 'В дополнительном обработчике был установлен отказ от выполнения этапа по причине:
						|'") + ДанныеДокумента.ОписаниеОшибки);
						ДанныеДокументов[ИндексыЗадачСГрупповойОбработкой.Получить(ДанныеДокумента.Задача)].Отказ = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			ДополнительныйКонтекст = ПараметрыОбработчика.ДополнительныйКонтекст;
			
		КонецЦикла;
		
		Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
			
			Если ДанныеДокумента.Отказ Тогда
				Продолжить;
			КонецЕсли;
			
			Исполнитель = ?(ДанныеДокумента.Свойство("Исполнитель") И ЗначениеЗаполнено(ДанныеДокумента.Исполнитель),
				ДанныеДокумента.Исполнитель, Пользователи.ТекущийПользователь());
				
			ДополнительныеПараметры = Новый Структура;
			Если ДанныеДокумента.Свойство("ЗадачаВыполненаВЛичномКабинете") Тогда
				ДополнительныеПараметры.Вставить("ЗадачаВыполненаВЛичномКабинете", Истина);
				ДополнительныеПараметры.Вставить("Исполнитель", Исполнитель);
			КонецЕсли;
				
			// Если обработчик "до транзакции" был групповым, то осталось выполнить только обработчик "в транзакции"
			ВыполнитьДополнительныйОбработчик(
				ДанныеДокумента.Ссылка,
				ДанныеДокумента.Задача,
				ДанныеДокумента.Шаблон,
				ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа,
				ДанныеДокумента.Статус,
				ДополнительныйКонтекст,
				ДополнительныеПараметры,
				,
				,
				ИндексыЗадачСГрупповойОбработкой.Получить(ДанныеДокумента.Задача) = Неопределено,
				ДанныеДокумента.Комментарий);
				
			Если ДанныеДокумента.Свойство("ЗадачаВыполненаВЛичномКабинете") Тогда
				Если ДанныеДокумента.ПодписанПростойЭП Тогда
					ЗаписьПодписанногоОбъекта(ДанныеДокумента.Задача);
					ДобавитьПодписанныеДанные(ДанныеДокумента.Задача, ДанныеДокумента.ПодписанныеДанные);
					
					УсиленнаяПодпись = Ложь;
				    УИДФормы = Неопределено;
					НаборДанныхДляПодписи = Новый Массив;
					Если ВключенаПоддержкаФормированияИПодписанияФормуляров() Тогда
						Реквизиты = "ЕстьНастройкиФормированияИПодписанияФормуляров";
						ЗначенияРеквизитовШаблона = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДокумента.Шаблон, Реквизиты);
						
						Если ЗначенияРеквизитовШаблона.ЕстьНастройкиФормированияИПодписанияФормуляров Тогда
							ФормированиеФормуляраДляПодписания(ДанныеДокумента.Задача, ДанныеДокумента.Ссылка,
							ДанныеДокумента.Шаблон,
							ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа);
							
							ПодписаниеФормуляровЭД(ДанныеДокумента.Задача,НаборДанныхДляПодписи,
							УсиленнаяПодпись, УИДФормы); 
							
							СвойстваПодписи = Новый Структура("ДатаПодписи, Организация, Должность, УстановившийПодпись, ВладелецПодписи");
							НаборЗаписей = РегистрыСведений.ПростыеЭлектронныеПодписиПОД.СоздатьНаборЗаписей();
							НаборЗаписей.Отбор.ПодписанныйОбъект.Установить(ДанныеДокумента.Задача);
                            НаборЗаписей.Прочитать();
							ЗаполнитьЗначенияСвойств(СвойстваПодписи, НаборЗаписей[0]); 
							
							Для Каждого ЭлементДанных Из НаборДанныхДляПодписи Цикл
								
								Если ТипЗнч(ЭлементДанных.Владелец) = Тип("ДокументСсылка.ФормулярПервичногоДокументаПОД") И ЭлементДанных.Свойство("ИдентификаторПечатнойФормы") Тогда
									
									ЭлементДанных.Вставить("СвойстваПодписи", СвойстваПодписи);
									//Отметка о подписании формуляра
									УстановитьОтметкуОПодписанииФормуляра(ДанныеДокумента.Задача, ЭлементДанных, УсиленнаяПодпись);
									
									// Если файл уже был подписан на этом этапе, то необходимо удалить старую подпись
									УдалитьПодписиФайлаПоИдентификаторуЭтапа(ЭлементДанных.Ссылка, ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа, ДанныеДокумента.Задача);
									
									// Сохранение связи задачи и подписанного файла
									СохранитьСвязьЗадачиИПодписанногоФайла(ЭлементДанных.Ссылка, ДанныеДокумента.Задача, ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа,
									ЭлементДанных.СвойстваПодписи.ДатаПодписи, ЭлементДанных.СвойстваПодписи.УстановившийПодпись);
									
									Если УсиленнаяПодпись Тогда
										ДобавитьПодпись(ЭлементДанных.Ссылка, ЭлементДанных.СвойстваПодписи);
									КонецЕсли;
								 КонецЕсли;
							
							КонецЦикла;
						
					     КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
				
			// выполнение текущей задачи пользователя
			ВыполнитьЗадачуПользователя(ДанныеДокумента.Задача, , ДанныеДокумента.Комментарий, , Исполнитель);
			
			ИзменитьИсториюСтатусовДокумента(ДанныеДокумента.Ссылка, ДанныеДокумента.Шаблон, ДанныеДокумента.Статус,
				ДанныеДокумента.Задача, ДанныеДокумента.Задача.ДатаИсполнения);
				
			ПроцессыОбработкиДокументовПереопределяемый.ПередЗапускомПрерываниемСледующихЭтапов(ДанныеДокумента.Ссылка,
				ДанныеДокумента.Шаблон, ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа, ДанныеДокумента.Статус, ДанныеДокумента.Задача);
				
			ВыполнитьПрерываниеЭтапов(
				ДанныеДокумента.Ссылка,
				ДанныеДокумента.Шаблон,
				ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа,
				ДанныеДокумента.Статус,
				ДанныеДокумента.Задача,
				ДанныеДокумента.Комментарий);
			
			ПриВыполненииЗадачиКуратораГрупповогоЭтапа(ДанныеДокумента.Ссылка, ДанныеДокумента.Шаблон,
				ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа, ДанныеДокумента.Задача);
			
			УстановитьТекущийСтатусДокумента(ДанныеДокумента.Ссылка, ДанныеДокумента.Шаблон, ДанныеДокумента.Статус,
				ДанныеДокумента.Задача, ДанныеДокумента.Задача.ДатаИсполнения);
			
			// Если выполнение данного этапа является триггером для выполнения этапа другого документа,
			// необходимо запустить выполнение связанных этапов/задач
			ВыполнитьЗависимыеЗадачи(
				ДанныеДокумента.Ссылка,
				ДанныеДокумента.Шаблон,
				ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа,
				ДанныеДокумента.Статус,
				ДанныеДокумента.Задача,
				ДополнительныйКонтекст,
				ДанныеДокумента.Комментарий);
			
			ВыполнитьЗапускЭтапов(
				ДанныеДокумента.Ссылка,
				ДанныеДокумента.Шаблон,
				ДанныеДокумента.ПараметрыТекущегоЭтапа.ИдентификаторЭтапа,
				ДанныеДокумента.Статус,
				ДанныеДокумента.Комментарий);
			
			УправлениеРегламентнымиИнтерваламиПриВыполненииЗадачи(ДанныеДокумента.Задача);
			
			СохранитьСвязьСВлияющейЗадачей(ВлияющаяЗадача, ДанныеДокумента.Задача);
			
			СохранитьСобытиеИсторииЗадач(ДанныеДокумента.Задача, ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.Выполнение"));
			
			ПроцессыОбработкиДокументовПереопределяемый.ПриВыполненииЗадачи(ДанныеДокумента.Задача);
			
		КонецЦикла;
		
		//При наличии ошибок, в том числе входящих, транзакция должна быть отменена
		Если СообщенияОбОшибке.Количество() > 0 Тогда
			ОтменитьТранзакцию();
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	Исключение
		ОтменитьТранзакцию();
		СообщенияОбОшибке.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ДокументыБезОтказа(ДанныеДокументов)
	
	Результат = Новый Массив;
	
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		Если НЕ ДанныеДокумента.Отказ Тогда
			Результат.Добавить(ДанныеДокумента.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Выполняет попытку проведения документов.
//
// Параметры:
//  Документы - Массив - документы, которые необходимо провести.
//
// Возвращаемое значение:
//  Массив из Структура - результат проведения:
//   * Ссылка         - ДокументСсылка - документ, который не удалось провести,
//   * ОписаниеОшибки - Строка         - текст описания ошибки при проведении.
//
Функция ПровестиДокументы(Документы, ДополнительныеСвойства) Экспорт
	
	НепроведенныеДокументы = Новый Массив;
	
	Для Каждого ДокументСсылка Из Документы Цикл
		
		ВыполненоУспешно = Ложь;
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		Если ДокументОбъект.ПроверитьЗаполнение() Тогда
			РежимПроведения = РежимПроведенияДокумента.Неоперативный;
			Если ДокументОбъект.Дата >= НачалоДня(ТекущаяДатаСеанса())
				И ДокументСсылка.Метаданные().ОперативноеПроведение = Метаданные.СвойстваОбъектов.ОперативноеПроведение.Разрешить Тогда
					РежимПроведения = РежимПроведенияДокумента.Оперативный;
			КонецЕсли;
			Попытка
				ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДокументОбъект.ДополнительныеСвойства, ДополнительныеСвойства, Истина);
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения);
				ВыполненоУспешно = Истина;
			Исключение
				ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
		Иначе
			ПредставлениеОшибки = НСтр("ru = 'Поля документа не заполнены.'");
		КонецЕсли;
		
		Если Не ВыполненоУспешно Тогда
			НепроведенныеДокументы.Добавить(Новый Структура("Ссылка,ОписаниеОшибки", ДокументСсылка, ПредставлениеОшибки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НепроведенныеДокументы;
	
КонецФункции 

// Выполняет попытку отмены проведения документов.
//
// Параметры:
//   Документы - Массив - документы, проведение которых необходимо отменить.
//
// Возвращаемое значение:
//   Массив - массив структур со свойствами:
//      * Ссылка         - ДокументСсылка - документ, проведение которого не удалось отменить.
//      * ОписаниеОшибки - Строка         - текст описания ошибки при отмене проведения.
//
Функция ОтменитьПроведениеДокументов(Документы, ДополнительныеСвойства) Экспорт
	
	ПроведенныеДокументы = Новый Массив;
	
	Для Каждого ДокументСсылка Из Документы Цикл
		
		ВыполненоУспешно = Ложь;
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Попытка
			ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДокументОбъект.ДополнительныеСвойства, ДополнительныеСвойства, Истина);
			ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			ВыполненоУспешно = Истина;
		Исключение
			ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Если Не ВыполненоУспешно Тогда
			ПроведенныеДокументы.Добавить(Новый Структура("Ссылка,ОписаниеОшибки", ДокументСсылка, ПредставлениеОшибки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПроведенныеДокументы;
	
КонецФункции

Функция ПризнакЗапретаПроведенияЭтапа(Шаблон, ИдентификаторЭтапа) Экспорт
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессовТребованияКПроведению.ЗапретитьПроведениеОтменуПроведения КАК ЗапретитьПроведениеОтменуПроведения
	|ИЗ
	|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовТребованияКПроведению
	|ГДЕ
	|	ШаблоныПроцессовТребованияКПроведению.Ссылка = &Ссылка
	|	И ШаблоныПроцессовТребованияКПроведению.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
	Запрос.УстановитьПараметр("Ссылка", Шаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", Новый УникальныйИдентификатор(ИдентификаторЭтапа));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЗапретитьПроведениеОтменуПроведения;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ТекущийПользовательМожетБытьИсполнителем(Документ, Параметры, Шаблон, РеквизитыАдресации = Неопределено)
	
	Результат = Ложь;
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
		Ссылка = Документ;
	Иначе
		Ссылка = Документ.Ссылка;
	КонецЕсли;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Если РеквизитыАдресации = Неопределено Тогда
		ИсполнителиЭтапа = ИсполнителиЭтапаПроцесса(Документ, Шаблон, Параметры);
	Иначе
		ИсполнителиЭтапа = Новый Массив;
		ИсполнителиЭтапа.Добавить(РеквизитыАдресации);
	КонецЕсли;
	
	Для Каждого ИсполнительЭтапа Из ИсполнителиЭтапа Цикл
		
		Если ПроцессыОбработкиДокументовПереопределяемый.ПользовательМожетБытьИсполнителем(Ссылка, Параметры, ИсполнительЭтапа, ТекущийПользователь) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИсполнительЭтапа.Исполнитель) И НЕ ЗначениеЗаполнено(ИсполнительЭтапа.РольИсполнителя) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсполнительЭтапа.Исполнитель) Тогда
			РезультатПоИсполнителю = ТекущийПользователь = ИсполнительЭтапа.Исполнитель;
		Иначе
			РезультатПоИсполнителю = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсполнительЭтапа.РольИсполнителя) Тогда
			РезультатПоРоли = ПользовательЯвляетсяОднимИзИсполнителейРоли(ТекущийПользователь, ИсполнительЭтапа.РольИсполнителя,
				ИсполнительЭтапа.ОсновнойОбъектАдресации, ИсполнительЭтапа.ДополнительныйОбъектАдресации);
		Иначе
			РезультатПоРоли = Истина;
		КонецЕсли;
		
		Результат = РезультатПоИсполнителю И РезультатПоРоли;
		
		// При первом же подходящем исполнителе - выход
		Если Результат Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НесколькоПользователейМогутБытьИсполнителями(Ссылка, Параметры)
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Исполнитель = Параметры.Исполнитель;
	
	Если НЕ ТипЗнч(Исполнитель) = Тип("СправочникСсылка.РолиИсполнителей") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РольИсполнителя = Исполнитель;
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РольИсполнителя, "ИспользуетсяСОбъектамиАдресации") Тогда
		Если ЗначениеЗаполнено(Параметры.ИмяРеквизитаОсновногоОбъектаАдресации) Тогда
			Если Лев(Параметры.ИмяРеквизитаОсновногоОбъектаАдресации, 1) = "*" Тогда
				МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
				Если МодульУправлениеСвойствами.ИспользоватьДопРеквизиты(Ссылка) Тогда
					ДополнительныеРеквизиты = МодульУправлениеСвойствами.СвойстваОбъекта(Ссылка, Истина, Ложь);
					Для Каждого Реквизит Из ДополнительныеРеквизиты Цикл
						Если Реквизит.ИдентификаторДляФормул = Сред(Параметры.ИмяРеквизитаОсновногоОбъектаАдресации, 2) Тогда
							ОсновнойОбъектАдресации = МодульУправлениеСвойствами.ЗначениеСвойства(Ссылка, Реквизит.Ссылка);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Иначе
				ОсновнойОбъектАдресации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, Параметры.ИмяРеквизитаОсновногоОбъектаАдресации);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Параметры.ОсновнойОбъектАдресации) Тогда
			ОсновнойОбъектАдресации = Параметры.ОсновнойОбъектАдресации;
		КонецЕсли;
		Если ЗначениеЗаполнено(Параметры.ИмяРеквизитаДополнительногоОбъектаАдресации) Тогда
			Если Лев(Параметры.ИмяРеквизитаДополнительногоОбъектаАдресации, 1) = "*" Тогда
				МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
				Если МодульУправлениеСвойствами.ИспользоватьДопРеквизиты(Ссылка) Тогда
					ДополнительныеРеквизиты = МодульУправлениеСвойствами.СвойстваОбъекта(Ссылка, Истина, Ложь);
					Для Каждого Реквизит Из ДополнительныеРеквизиты Цикл
						Если Реквизит.ИдентификаторДляФормул = Сред(Параметры.ИмяРеквизитаДополнительногоОбъектаАдресации, 2) Тогда
							ДополнительныйОбъектАдресации = МодульУправлениеСвойствами.ЗначениеСвойства(Ссылка, Реквизит.Ссылка);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Иначе
				ДополнительныйОбъектАдресации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, Параметры.ИмяРеквизитаДополнительногоОбъектаАдресации);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Параметры.ДополнительныйОбъектАдресации) Тогда
			ДополнительныйОбъектАдресации = Параметры.ДополнительныйОбъектАдресации;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПользовательЯвляетсяНеЕдинственнымИсполнителемРоли(ТекущийПользователь,РольИсполнителя,ОсновнойОбъектАдресации,ДополнительныйОбъектАдресации);
	
КонецФункции

Функция ПользователюПереданоПравоОтменыВыполненияПринятияКИсполнениюЗадачи(Пользователь, Задача)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	РегистрСведений.НастройкаПередачиПравИсполнителей КАК НастройкаПередачиПравИсполнителей
	|ГДЕ
	|	НастройкаПередачиПравИсполнителей.Кому = &Кому
	|	И НастройкаПередачиПравИсполнителей.ОтКого = &ОтКого
	|	И НастройкаПередачиПравИсполнителей.РольИсполнителей = &РольИсполнителей
	|	И НастройкаПередачиПравИсполнителей.ОсновнойОбъектАдресации = &ОсновнойОбъектАдресации
	|	И НастройкаПередачиПравИсполнителей.ДополнительныйОбъектАдресации = &ДополнительныйОбъектАдресации
	|	И НастройкаПередачиПравИсполнителей.ДатаНачалаДействия <= &ТекущаяДата
	|	И (КОНЕЦПЕРИОДА(НастройкаПередачиПравИсполнителей.ДатаОкончанияДействия, ДЕНЬ) >= &ТекущаяДата
	|			ИЛИ НастройкаПередачиПравИсполнителей.ДатаОкончанияДействия = &ПустаяДата)";
	Запрос.УстановитьПараметр("Кому", Пользователь);
	Запрос.УстановитьПараметр("ОтКого", Задача.Исполнитель);
	Запрос.УстановитьПараметр("РольИсполнителей", Задача.РольИсполнителя);
	Если ЗначениеЗаполнено(Задача.ОсновнойОбъектАдресации) Тогда
		Запрос.УстановитьПараметр("ОсновнойОбъектАдресации", Задача.ОсновнойОбъектАдресации);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НастройкаПередачиПравИсполнителей.ОсновнойОбъектАдресации = &ОсновнойОбъектАдресации", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(Задача.ДополнительныйОбъектАдресации) Тогда
		Запрос.УстановитьПараметр("ДополнительныйОбъектАдресации", Задача.ДополнительныйОбъектАдресации);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НастройкаПередачиПравИсполнителей.ДополнительныйОбъектАдресации = &ДополнительныйОбъектАдресации", "");
	КонецЕсли;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ДобавитьРеквизитСИменемГруппыРазмещения(Форма, ИмяГруппыДляРазмещения, НовыйДокумент = Ложь)
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения") Тогда
		ДобавляемыеРеквизиты = Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения", Новый ОписаниеТипов("Строка")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_НовыйДокумент", Новый ОписаниеТипов("Булево")));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения = ИмяГруппыДляРазмещения;
		Форма.ПроцессыОбработкиДокументов_НовыйДокумент = НовыйДокумент;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьРеквизитыФормыПроцесса(Форма, ИмяГруппыДляРазмещения, ПерваяИнициализация = Истина, ДоступноВыполнение = Истина)
	
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка");
	ОписаниеТипаБулево = Новый ОписаниеТипов("Булево");
	ОписаниеТипаБулевоNULL = Новый ОписаниеТипов("Булево, Null");
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	Если ПерваяИнициализация Тогда
		
		Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения") Тогда
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
				"ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения", ОписаниеТипаСтрока));
		КонецЕсли;
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТекущийСтатус", Новый ОписаниеТипов("СправочникСсылка.СтатусыДокументов")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТекущийШаблон", Новый ОписаниеТипов("СправочникСсылка.ШаблоныПроцессов")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ШаблонВРегистре", Новый ОписаниеТипов("СправочникСсылка.ШаблоныПроцессов")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_НаименованиеЭтапа", ОписаниеТипаСтрока));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТекстПредупреждения", ОписаниеТипаСтрока));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_КомментарийНаправившего", ОписаниеТипаСтрока));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_КомментарийСледующему", ОписаниеТипаСтрока));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"ПроцессыОбработкиДокументов_ЗаблокированныеЭлементы", ОписаниеТипаСтрока));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"ПроцессыОбработкиДокументов_НевидимыеЭлементы", ОписаниеТипаСтрока));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"ПроцессыОбработкиДокументов_ЭлементыСОтметкойНезаполненного", ОписаниеТипаСтрока));
		
	КонецЕсли;
	
	Если ДоступноВыполнение Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТекущаяЗадача", Новый ОписаниеТипов("ЗадачаСсылка.ЗадачаПоОбработкеДокумента")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа", Новый ОписаниеТипов("УникальныйИдентификатор")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТекущийЭтап", Новый ОписаниеТипов("СправочникСсылка.ЭтапыПроцессов")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТекущийПорядок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Неотрицательный))));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_НеЗаполнятьКомментарийПриОтрицательномРезультате", ОписаниеТипаБулево));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ПроверятьИмеющиесяЭППриОчередномПодписании", ОписаниеТипаБулево));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ПроверятьПодписанныеДанныеПриОчередномПодписании", ОписаниеТипаБулево));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ПроверятьНаличиеКлючаПЭПВРеестре", ОписаниеТипаБулево));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ИзмененКомментарийИсполнителя", ОписаниеТипаБулево));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТребуетсяПроверкаЗаполненностиРеквизитов", ОписаниеТипаБулево));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТребуетсяПроверкаЗаполненностиРеквизитовПД", ОписаниеТипаБулево));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ВыполняетсяЗаписьПоКнопкеВыполненияЭтапа", ОписаниеТипаБулево));
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ТаблицаКоманд", Новый ОписаниеТипов("ТаблицаЗначений")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ИмяКоманды", ОписаниеТипаСтрока, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"Статус", Новый ОписаниеТипов("СправочникСсылка.СтатусыДокументов"), "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"Отрицательная", ОписаниеТипаБулево, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ТребуетсяЭП", ОписаниеТипаБулево, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ТребуетсяПростаяЭП", ОписаниеТипаБулево, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ОбработчикДоТранзакции", ОписаниеТипаСтрока, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ОбработчикКлиентский", ОписаниеТипаСтрока, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПризнакПроведенности", ОписаниеТипаБулевоNULL, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"УсловиеВыполнения", ОписаниеТипаСтрока, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"НаличиеФайловОбязательно", ОписаниеТипаБулево, "ПроцессыОбработкиДокументов_ТаблицаКоманд")); 
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"РасшифровкаОбязательныхПрисоединенныхФайлов", ОписаниеТипаСтрока, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПодписыватьФайлыЭП", ОписаниеТипаБулево, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ОбособленнаяЗонаОтветственности", ОписаниеТипаБулево, "ПроцессыОбработкиДокументов_ТаблицаКоманд"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			"ПроцессыОбработкиДокументов_ИспользоватьМногопоточнуюПроверку", ОписаниеТипаБулево)); 
		
	КонецЕсли;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения = ИмяГруппыДляРазмещения;
	
	Если ДоступноВыполнение Тогда
		
		ГруппаПроцесс = НайтиДобавитьГруппуДляРазмещения(Форма);
		ГруппаРезультатыВыполнения = НайтиДобавитьГруппуРезультатыВыполнения(Форма, ГруппаПроцесс);
		
		ДобавитьЭлементыКомментарии(Форма, ГруппаПроцесс);
		
	КонецЕсли;
	
	ДобавитьЭлементФормыТекущийСтатус(Форма, Истина);
	
КонецПроцедуры

Процедура ДобавитьЭлементФормыТекущийСтатус(Форма, НаФормеЕстьКоманды = Истина)
	
	ГруппаПроцесс = НайтиДобавитьГруппуДляРазмещения(Форма);
	
	ПолеТекущийСтатус = Форма.Элементы.Найти("ТекущийСтатус");
	Если ПолеТекущийСтатус = Неопределено Тогда
		ПолеТекущийСтатус = Форма.Элементы.Добавить("ТекущийСтатус",Тип("ПолеФормы"),ГруппаПроцесс);
		ПолеТекущийСтатус.Заголовок = "Текущий статус";
		ПолеТекущийСтатус.Вид = ВидПоляФормы.ПолеНадписи;
		ПолеТекущийСтатус.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
		ПолеТекущийСтатус.АвтоМаксимальнаяШирина = Ложь;
		ПолеТекущийСтатус.МаксимальнаяШирина = 28;
		ПолеТекущийСтатус.Шрифт = Новый Шрифт(Новый Шрифт(),,12,Истина,,,,);
		ПолеТекущийСтатус.ПутьКДанным = "ПроцессыОбработкиДокументов_ТекущийСтатус";
	КонецЕсли;
	ПолеТекущийСтатус.ПоложениеЗаголовка =
		?(НаФормеЕстьКоманды, ПоложениеЗаголовкаЭлементаФормы.Верх, ПоложениеЗаголовкаЭлементаФормы.Авто);
	
	Форма.Элементы.Переместить(ПолеТекущийСтатус, ГруппаПроцесс);
	
КонецПроцедуры

Процедура ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, ИмяГруппыДляРазмещения, Заголовок)
	
	ДобавитьРеквизитСИменемГруппыРазмещения(Форма, ИмяГруппыДляРазмещения, Истина);
	
	ЭлементФормыШаблонНеОпределен = Форма.Элементы.Найти("ДекорацияШаблонНеОпределен");
	Если ЭлементФормыШаблонНеОпределен = Неопределено Тогда
		ГруппаПроцесс = НайтиДобавитьГруппуДляРазмещения(Форма);
		ЭлементФормыШаблонНеОпределен = Форма.Элементы.Добавить("ДекорацияШаблонНеОпределен",Тип("ДекорацияФормы"),ГруппаПроцесс);
		ЭлементФормыШаблонНеОпределен.Вид = ВидДекорацииФормы.Надпись;
		ЭлементФормыШаблонНеОпределен.АвтоМаксимальнаяШирина = Ложь;
	КонецЕсли;
	
	ЭлементФормыШаблонНеОпределен.Заголовок = Заголовок;
	
КонецПроцедуры

Процедура УдалитьЭлементФормыНевозможностьОбработкиДокумента(Форма)
	
	Если Форма.Элементы.Найти("ДекорацияШаблонНеОпределен") <> Неопределено Тогда
		Форма.Элементы.Удалить(Форма.Элементы.ДекорацияШаблонНеОпределен);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПризнакПроверкиОбязательныхРеквизитовТекущегоЭтапа(Форма)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШаблоныПроцессовОбязательныеРеквизиты.ИдентификаторЭтапа КАК ИдентификаторЭтапа
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ОбязательныеРеквизиты КАК ШаблоныПроцессовОбязательныеРеквизиты
	|ГДЕ
	|	ШаблоныПроцессовОбязательныеРеквизиты.Ссылка = &Ссылка
	|	И ШаблоныПроцессовОбязательныеРеквизиты.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
	Запрос.УстановитьПараметр("Ссылка", Форма.ПроцессыОбработкиДокументов_ТекущийШаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа);
	
	Форма.ПроцессыОбработкиДокументов_ТребуетсяПроверкаЗаполненностиРеквизитов = НЕ Запрос.Выполнить().Пустой();
	
КонецПроцедуры

Процедура ЗаполнитьПризнакПроверкиОбязательныхРеквизитовПервичногоДокументаТекущегоЭтапа(Форма)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШаблоныПроцессовОбязательныеРеквизиты.ИдентификаторЭтапа КАК ИдентификаторЭтапа
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ОбязательностьПервичныеДокументы КАК ШаблоныПроцессовОбязательныеРеквизиты
	|ГДЕ
	|	ШаблоныПроцессовОбязательныеРеквизиты.Ссылка = &Ссылка
	|	И ШаблоныПроцессовОбязательныеРеквизиты.ИдентификаторЭтапа = &ИдентификаторЭтапа";
	
	Запрос.УстановитьПараметр("Ссылка", Форма.ПроцессыОбработкиДокументов_ТекущийШаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа);
	
	Форма.ПроцессыОбработкиДокументов_ТребуетсяПроверкаЗаполненностиРеквизитовПД = НЕ Запрос.Выполнить().Пустой();
	
КонецПроцедуры

Процедура ДобавитьКомандыРезолюцийТекущегоЭтапа(Форма)
	
	ИспользуетсяУсиленнаяЭП = ПолучитьФункциональнуюОпцию("ИспользоватьЭППриВыполненииЭтапов");
	ИспользуетсяПростаяЭП = ПолучитьФункциональнуюОпцию("ИспользоватьПростыеЭППриВыполненииЭтапов");
	
	Форма.ПроцессыОбработкиДокументов_ТаблицаКоманд.Очистить();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШаблоныПроцессовЭтапы.НаличиеФайловОбязательно КАК НаличиеФайловОбязательно,
	|	ШаблоныПроцессовЭтапы.РасшифровкаОбязательныхПрисоединенныхФайлов КАК РасшифровкаОбязательныхПрисоединенныхФайлов,
	|	ШаблоныПроцессовЭтапы.ПодписыватьФайлыЭП КАК ПодписыватьФайлыЭП,
	|	ШаблоныПроцессовЭтапы.ОбособленнаяЗонаОтветственности КАК ОбособленнаяЗонаОтветственности
	|ПОМЕСТИТЬ ЭтапыШаблона
	|ИЗ
	|	Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
	|ГДЕ
	|	ШаблоныПроцессовЭтапы.Ссылка = &Ссылка
	|	И ШаблоныПроцессовЭтапы.ИдентификаторЭтапа = &ИдентификаторЭтапа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ШаблоныПроцессовДополнительныеОбработчики.Статус КАК Статус,
	|	ШаблоныПроцессовДополнительныеОбработчики.ОбработчикДоТранзакции КАК ОбработчикДоТранзакции,
	|	ШаблоныПроцессовДополнительныеОбработчики.ОбработчикКлиентский КАК ОбработчикКлиентский
	|ПОМЕСТИТЬ ДополнительныеОбработчики
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ДополнительныеОбработчики КАК ШаблоныПроцессовДополнительныеОбработчики
	|ГДЕ
	|	ШаблоныПроцессовДополнительныеОбработчики.Ссылка = &Ссылка
	|	И ШаблоныПроцессовДополнительныеОбработчики.ИдентификаторЭтапа = &ИдентификаторЭтапа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ШаблоныПроцессовТребованияКПроведению.Статус КАК Статус,
	|	ШаблоныПроцессовТребованияКПроведению.ПризнакПроведенности КАК ПризнакПроведенности
	|ПОМЕСТИТЬ ТребованияКПроведению
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ТребованияКПроведению КАК ШаблоныПроцессовТребованияКПроведению
	|ГДЕ
	|	ШаблоныПроцессовТребованияКПроведению.Ссылка = &Ссылка
	|	И ШаблоныПроцессовТребованияКПроведению.ИдентификаторЭтапа = &ИдентификаторЭтапа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ШаблоныПроцессовТребованияКВыполнению.Статус КАК Статус,
	|	ШаблоныПроцессовТребованияКВыполнению.УсловиеВыполнения КАК УсловиеВыполнения
	|ПОМЕСТИТЬ ТребованияКВыполнению
	|ИЗ
	|	Справочник.ШаблоныПроцессов.ТребованияКВыполнению КАК ШаблоныПроцессовТребованияКВыполнению
	|ГДЕ
	|	ШаблоныПроцессовТребованияКВыполнению.Ссылка = &Ссылка
	|	И ШаблоныПроцессовТребованияКВыполнению.ИдентификаторЭтапа = &ИдентификаторЭтапа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭтапыПроцессовРезультатыВыполнения.ПредставлениеРезультата КАК ПредставлениеРезультата,
	|	ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения КАК СтатусПослеВыполнения,
	|	ЭтапыПроцессовРезультатыВыполнения.ОтрицательныйРезультат КАК ОтрицательныйРезультат,
	|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяЭП КАК ТребуетсяЭП,
	|	ЭтапыПроцессовРезультатыВыполнения.ТребуетсяПростаяЭП КАК ТребуетсяПростаяЭП,
	|	ЭтапыШаблона.НаличиеФайловОбязательно КАК НаличиеФайловОбязательно,
	|	ЭтапыШаблона.РасшифровкаОбязательныхПрисоединенныхФайлов КАК РасшифровкаОбязательныхПрисоединенныхФайлов,
	|	ЭтапыШаблона.ПодписыватьФайлыЭП КАК ПодписыватьФайлыЭП,
	|	ЭтапыШаблона.ОбособленнаяЗонаОтветственности КАК ОбособленнаяЗонаОтветственности,
	|	ЕСТЬNULL(ДополнительныеОбработчики.ОбработчикДоТранзакции, """") КАК ОбработчикДоТранзакции,
	|	ЕСТЬNULL(ДополнительныеОбработчики.ОбработчикКлиентский, """") КАК ОбработчикКлиентский,
	|	ТребованияКПроведению.ПризнакПроведенности КАК ПризнакПроведенности,
	|	ЕСТЬNULL(ТребованияКВыполнению.УсловиеВыполнения, """") КАК УсловиеВыполнения
	|ИЗ
	|	Справочник.ЭтапыПроцессов.РезультатыВыполнения КАК ЭтапыПроцессовРезультатыВыполнения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЭтапыШаблона КАК ЭтапыШаблона
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДополнительныеОбработчики КАК ДополнительныеОбработчики
	|		ПО ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = ДополнительныеОбработчики.Статус
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТребованияКПроведению КАК ТребованияКПроведению
	|		ПО ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = ТребованияКПроведению.Статус
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТребованияКВыполнению КАК ТребованияКВыполнению
	|		ПО ЭтапыПроцессовРезультатыВыполнения.СтатусПослеВыполнения = ТребованияКВыполнению.Статус
	|ГДЕ
	|	ЭтапыПроцессовРезультатыВыполнения.Ссылка = &Этап
	|	И НЕ ЭтапыПроцессовРезультатыВыполнения.Скрытый
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтапыПроцессовРезультатыВыполнения.ОтрицательныйРезультат,
	|	ЭтапыПроцессовРезультатыВыполнения.НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Форма.ПроцессыОбработкиДокументов_ТекущийШаблон);
	Запрос.УстановитьПараметр("ИдентификаторЭтапа", Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа);
	Запрос.УстановитьПараметр("Этап", Форма.ПроцессыОбработкиДокументов_ТекущийЭтап);
	
	Результат = Запрос.Выполнить();
	// Если в выборке нет ни одной кнопки с результатами выполнения, то в группу добавляется пустая надпись, иначе - удаляется
	ДекорацияПустая = Форма.Элементы.Найти("ПроцессыОбработкиДокументовДекорацияПустая");
	Если Результат.Пустой() Тогда
		Если ДекорацияПустая = Неопределено Тогда
			ДекорацияПустая = Форма.Элементы.Добавить("ПроцессыОбработкиДокументовДекорацияПустая", Тип("ДекорацияФормы"), Форма.Элементы.ГруппаРезультатыВыполнения);
			ДекорацияПустая.Вид = ВидДекорацииФормы.Надпись;
		КонецЕсли;
	ИначеЕсли ДекорацияПустая <> Неопределено Тогда
		Форма.Элементы.Удалить(ДекорацияПустая);
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	// согласно текущему этапу разместим кнопки с резолюциями
	Пока Выборка.Следующий() Цикл
		
		ДляВыполненияЭтапаТребуетсяУсиленнаяЭП = Выборка.ТребуетсяЭП И ИспользуетсяУсиленнаяЭП;
		ДляВыполненияЭтапаТребуетсяПростаяЭП = Выборка.ТребуетсяПростаяЭП И ИспользуетсяПростаяЭП;
		ДляВыполненияЭтапаТребуетсяЭП = ДляВыполненияЭтапаТребуетсяУсиленнаяЭП ИЛИ ДляВыполненияЭтапаТребуетсяПростаяЭП;
		
		ИдентификаторКоманды = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "_");
		
		ИмяКоманды = "ПроцессыОбработкиДокументов" + ИдентификаторКоманды;
		
		НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = "Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента";
		НоваяКоманда.Заголовок = Выборка.ПредставлениеРезультата;
		Если ДляВыполненияЭтапаТребуетсяУсиленнаяЭП Тогда
			НоваяКоманда.Картинка = БиблиотекаКартинок.ПодписанЭП;
		ИначеЕсли ДляВыполненияЭтапаТребуетсяПростаяЭП Тогда
			НоваяКоманда.Картинка = БиблиотекаКартинок.ПодписанПростойЭП;
		КонецЕсли;
		НоваяКоманда.Отображение = ?(ДляВыполненияЭтапаТребуетсяЭП, ОтображениеКнопки.КартинкаИТекст, ОтображениеКнопки.Авто);
		
		ГруппаРезультатВыполнения = Форма.Элементы.Добавить(
			"Группа" + ИдентификаторКоманды, Тип("ГруппаФормы"), Форма.Элементы.ГруппаРезультатыВыполнения);
		ГруппаРезультатВыполнения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаРезультатВыполнения.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаРезультатВыполнения.ОтображатьЗаголовок = Ложь;
		
		НоваяКнопка = Форма.Элементы.Добавить(
			"Кнопка" + ИдентификаторКоманды, Тип("КнопкаФормы"), ГруппаРезультатВыполнения);
		НоваяКнопка.ЦветТекста = ?(Выборка.ОтрицательныйРезультат, WebЦвета.Кирпичный, WebЦвета.Зеленый);
		НоваяКнопка.Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,,,Истина);
		НоваяКнопка.ИмяКоманды = ИмяКоманды;
		
		СвойстваКоманды = Форма.ПроцессыОбработкиДокументов_ТаблицаКоманд.Добавить();
		СвойстваКоманды.ИмяКоманды = НоваяКнопка.ИмяКоманды;
		СвойстваКоманды.Статус = Выборка.СтатусПослеВыполнения;
		СвойстваКоманды.ТребуетсяЭП = ДляВыполненияЭтапаТребуетсяУсиленнаяЭП;
		СвойстваКоманды.ТребуетсяПростаяЭП = ДляВыполненияЭтапаТребуетсяПростаяЭП;
		СвойстваКоманды.Отрицательная = Выборка.ОтрицательныйРезультат;
		СвойстваКоманды.ОбработчикДоТранзакции = Выборка.ОбработчикДоТранзакции;
		СвойстваКоманды.ОбработчикКлиентский = Выборка.ОбработчикКлиентский;
		СвойстваКоманды.ПризнакПроведенности = Выборка.ПризнакПроведенности;
		СвойстваКоманды.УсловиеВыполнения = Выборка.УсловиеВыполнения;
		СвойстваКоманды.НаличиеФайловОбязательно = Выборка.НаличиеФайловОбязательно;
		СвойстваКоманды.РасшифровкаОбязательныхПрисоединенныхФайлов = Выборка.РасшифровкаОбязательныхПрисоединенныхФайлов;
		СвойстваКоманды.ПодписыватьФайлыЭП = Выборка.ПодписыватьФайлыЭП;
		СвойстваКоманды.ОбособленнаяЗонаОтветственности = Выборка.ОбособленнаяЗонаОтветственности;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиДобавитьГруппуДляРазмещения(Форма, ВернутьРодительскуюГруппу = Ложь)
	
	ГруппаПроцесс = Форма.Элементы.Найти(Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения);
	
	Если ГруппаПроцесс = Неопределено Тогда
		
		ГруппаПроцесс = Форма.Элементы.Добавить(Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения, Тип("ГруппаФормы"));
		ГруппаПроцесс.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаПроцесс.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаПроцесс.ОтображатьЗаголовок = Ложь;
		ГруппаПроцесс.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаПроцесс.ЦветФона = WebЦвета.ТопленоеМолоко;
		ГруппаПроцесс.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
		ГруппаПроцесс.РастягиватьПоГоризонтали = Истина;
		
	КонецЕсли;
	
	ГруппаПроцессОсновная = Форма.Элементы.Найти("ГруппаПроцессОсновная");
	
	Если ГруппаПроцессОсновная = Неопределено Тогда
		
		ГруппаПроцессОсновная = Форма.Элементы.Добавить("ГруппаПроцессОсновная", Тип("ГруппаФормы"), ГруппаПроцесс);
		ГруппаПроцессОсновная.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаПроцессОсновная.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаПроцессОсновная.ОтображатьЗаголовок = Ложь;
		ГруппаПроцессОсновная.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ГруппаПроцессОсновная.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
		ГруппаПроцессОсновная.РастягиватьПоГоризонтали = Истина;
		
	КонецЕсли;
	
	Если ВернутьРодительскуюГруппу Тогда
		Возврат ГруппаПроцесс;
	Иначе
		Возврат ГруппаПроцессОсновная;
	КонецЕсли;
	
КонецФункции

Функция НайтиДобавитьГруппуРезультатыВыполнения(Форма, ГруппаРодитель)
	
	ГруппаРезультатыВыполнения = Форма.Элементы.Найти("ГруппаРезультатыВыполнения");
	Если ГруппаРезультатыВыполнения = Неопределено Тогда
		ГруппаРезультатыВыполнения = Форма.Элементы.Добавить("ГруппаРезультатыВыполнения", Тип("ГруппаФормы"), ГруппаРодитель);
		ГруппаРезультатыВыполнения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаРезультатыВыполнения.ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаФормы;
		ГруппаРезультатыВыполнения.ПутьКДаннымЗаголовка = "ПроцессыОбработкиДокументов_НаименованиеЭтапа";
	КонецЕсли;
	Возврат ГруппаРезультатыВыполнения;
	
КонецФункции

Процедура ДобавитьЭлементыКомментарии(Форма, ГруппаРодитель)
	
	Если НЕ Форма.Элементы.Найти("ГруппаКомментарии") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаКомментарии = Форма.Элементы.Добавить("ГруппаКомментарии", Тип("ГруппаФормы"), ГруппаРодитель);
	ГруппаКомментарии.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКомментарии.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаКомментарии.ОтображатьЗаголовок = Ложь;
	ГруппаКомментарии.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаКомментарии.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	ГруппаКомментарии.РастягиватьПоГоризонтали = Истина;
	
	ГруппаКомментарииСтраницы = Форма.Элементы.Добавить("ГруппаКомментарииСтраницы", Тип("ГруппаФормы"), ГруппаКомментарии);
	ГруппаКомментарииСтраницы.Вид = ВидГруппыФормы.Страницы;
	ГруппаКомментарииСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	ГруппаСтраницаКомментарийНаправившего = Форма.Элементы.Добавить("ГруппаСтраницаКомментарийНаправившего", Тип("ГруппаФормы"), ГруппаКомментарииСтраницы);
	ГруппаСтраницаКомментарийНаправившего.Вид = ВидГруппыФормы.Страница;
	
	ПолеКомментарийНаправившего = Форма.Элементы.Добавить("КомментарийНаправившего", Тип("ПолеФормы"), ГруппаСтраницаКомментарийНаправившего);
	ПолеКомментарийНаправившего.Заголовок = НСтр("ru='Комментарий направившего'");
	ПолеКомментарийНаправившего.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКомментарийНаправившего.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеКомментарийНаправившего.ТолькоПросмотр = Истина;
	ПолеКомментарийНаправившего.МногострочныйРежим = Истина;
	ПолеКомментарийНаправившего.КнопкаОткрытия = Истина;
	ПолеКомментарийНаправившего.АвтоМаксимальнаяШирина = Ложь;
	ПолеКомментарийНаправившего.РастягиватьПоВертикали = Ложь;
	ПолеКомментарийНаправившего.ПутьКДанным = "ПроцессыОбработкиДокументов_КомментарийНаправившего";
	
	ПолеКомментарийНаправившего.УстановитьДействие("Открытие","Подключаемый_КомментарийНаправившегоОткрытие");
	
	ГруппаСтраницаКомментарийСледующему = Форма.Элементы.Добавить("ГруппаСтраницаКомментарийСледующему", Тип("ГруппаФормы"), ГруппаКомментарииСтраницы);
	ГруппаСтраницаКомментарийСледующему.Вид = ВидГруппыФормы.Страница;
	
	ПолеКомментарийСледующему = Форма.Элементы.Добавить("КомментарийСледующему", Тип("ПолеФормы"), ГруппаСтраницаКомментарийСледующему);
	ПолеКомментарийСледующему.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКомментарийСледующему.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеКомментарийСледующему.МногострочныйРежим = Истина;
	ПолеКомментарийСледующему.КнопкаВыбора = Истина;
	ПолеКомментарийСледующему.АвтоМаксимальнаяШирина = Ложь;
	ПолеКомментарийСледующему.РастягиватьПоВертикали = Ложь;
	ПолеКомментарийСледующему.ПодсказкаВвода = НСтр("ru='Комментарий для следующего исполнителя, описание выполнения задачи'");
	ПолеКомментарийСледующему.ПутьКДанным = "ПроцессыОбработкиДокументов_КомментарийСледующему";
	
	ПолеКомментарийСледующему.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента");
	ПолеКомментарийСледующему.УстановитьДействие("НачалоВыбора","Подключаемый_КомментарийСледующемуНачалоВыбора");
	
	ГруппаКомандыКомментарии = Форма.Элементы.Добавить("ГруппаКомандыКомментарии", Тип("ГруппаФормы"), ГруппаКомментарии);
	ГруппаКомандыКомментарии.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКомандыКомментарии.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаКомандыКомментарии.ОтображатьЗаголовок = Ложь;
	ГруппаКомандыКомментарии.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаКомандыКомментарии.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	ГруппаКомандыКомментарии.Ширина = 3;
	ГруппаКомандыКомментарии.РастягиватьПоГоризонтали = Ложь;
	
	// команда "Описание задачи"
	ИмяКоманды = "ПоказатьКомментарийНаправившего";
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие = "Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента";
	НоваяКоманда.Заголовок = НСтр("ru='Описание задачи'");
	НоваяКоманда.Подсказка = НСтр("ru='Описание задачи'");
	НоваяКоманда.Картинка = БиблиотекаКартинок.КомментарийНаправившего;
	НоваяКоманда.Отображение = ОтображениеКнопки.Картинка;
	
	НоваяКнопка = Форма.Элементы.Добавить("Кнопка"+ИмяКоманды, Тип("КнопкаФормы"), ГруппаКомандыКомментарии);
	НоваяКнопка.ИмяКоманды = ИмяКоманды;
	
	// команда "Ввести комментарий"
	ИмяКоманды = "ПоказатьКомментарийСледующему";
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие = "Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента";
	НоваяКоманда.Заголовок = НСтр("ru='Ввести комментарий'");
	НоваяКоманда.Подсказка = НСтр("ru='Ввести комментарий'");
	НоваяКоманда.Картинка = БиблиотекаКартинок.КомментарийСледующему;
	НоваяКоманда.Отображение = ОтображениеКнопки.Картинка;
	
	НоваяКнопка = Форма.Элементы.Добавить("Кнопка"+ИмяКоманды, Тип("КнопкаФормы"), ГруппаКомандыКомментарии);
	НоваяКнопка.ИмяКоманды = ИмяКоманды;
	
КонецПроцедуры

Процедура ДобавитьКнопкуСКомандойПринятьКИсполнению(Форма, ГруппаРодитель)
	
	ИдентификаторКоманды = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "_");
	ИмяКоманды = "ПринятьКИсполнениюПроцессыОбработкиДокументов";
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие = "Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента";
	НоваяКоманда.Заголовок = "Принять задачу к исполнению";
	
	ГруппаПринятьКИсполнению = Форма.Элементы.Добавить("Группа"+ИдентификаторКоманды, Тип("ГруппаФормы"), ГруппаРодитель);
	ГруппаПринятьКИсполнению.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПринятьКИсполнению.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаПринятьКИсполнению.ОтображатьЗаголовок = Ложь;
	
	НоваяКнопка = Форма.Элементы.Добавить("Кнопка"+ИдентификаторКоманды, Тип("КнопкаФормы"), ГруппаПринятьКИсполнению);
	НоваяКнопка.Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,,,Истина);
	НоваяКнопка.ИмяКоманды = ИмяКоманды;
	
КонецПроцедуры

Процедура ДобавитьКнопкуСКомандойПроцесс(Форма, Группа)
	
	Если Группа = Неопределено Тогда
		Возврат;
	ИначеЕсли ТипЗнч(Группа) = Тип("ГруппаФормы") Тогда
		ГруппаРодитель = Группа;
	ИначеЕсли ТипЗнч(Группа) = Тип("Строка") Тогда
		ГруппаРодитель = Форма.Элементы.Найти(Группа);
		Если ГруппаРодитель = Неопределено Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	ИмяКоманды = "КарточкаПроцессаДокумента";
	
	Если Форма.Команды.Найти(ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ГруппаРодитель.Вид = ВидГруппыФормы.КоманднаяПанель Тогда
		ГруппаРодитель = Форма.Элементы.Добавить("ГруппаКнопок" + ИмяКоманды, Тип("ГруппаФормы"), ГруппаРодитель);
		ГруппаРодитель.Вид = ВидГруппыФормы.ГруппаКнопок;
	КонецЕсли;
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие = "Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента";
	НоваяКоманда.Заголовок = "Процесс";
	
	НоваяКнопка = Форма.Элементы.Добавить("Кнопка"+ИмяКоманды, Тип("КнопкаФормы"), ГруппаРодитель);
	НоваяКнопка.ИмяКоманды = ИмяКоманды;
	
КонецПроцедуры

Процедура ИнициализацияФормыСогласноТекущемуЭтапу(Форма, ПараметрыТекущегоЭтапа, ПовторноеЧтениеОбъекта = Ложь)
	
	Форма.ПроцессыОбработкиДокументов_ТекущийЭтап 				= ПараметрыТекущегоЭтапа.Этап;
	Форма.ПроцессыОбработкиДокументов_НаименованиеЭтапа 		= ПараметрыТекущегоЭтапа.НаименованиеЭтапа;
	Форма.ПроцессыОбработкиДокументов_ТекущаяЗадача 			= ПараметрыТекущегоЭтапа.Задача;
	Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа = ПараметрыТекущегоЭтапа.ИдентификаторЭтапа;
	Форма.ПроцессыОбработкиДокументов_ТекущийПорядок 			= ПараметрыТекущегоЭтапа.Порядок;
	Форма.ПроцессыОбработкиДокументов_КомментарийНаправившего 	= Строка(ПараметрыТекущегоЭтапа.Автор) + ": " + ПараметрыТекущегоЭтапа.Описание;
	Форма.ПроцессыОбработкиДокументов_КомментарийСледующему 	= ПараметрыТекущегоЭтапа.РезультатВыполнения;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КомментарийНаправившего", "Видимость", НЕ ПустаяСтрока(ПараметрыТекущегоЭтапа.Описание));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКомандыКомментарии", "Видимость", НЕ ПустаяСтрока(ПараметрыТекущегоЭтапа.Описание));
	
	Если НЕ ПовторноеЧтениеОбъекта Тогда
		Если НЕ ПустаяСтрока(ПараметрыТекущегоЭтапа.Описание) Тогда
			Форма.Элементы.ГруппаКомментарииСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаСтраницаКомментарийНаправившего;
		Иначе
			Форма.Элементы.ГруппаКомментарииСтраницы.ТекущаяСтраница = Форма.Элементы.ГруппаСтраницаКомментарийСледующему;
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьКомандыРезолюцийТекущегоЭтапа(Форма);
	
	ЗаполнитьПризнакПроверкиОбязательныхРеквизитовТекущегоЭтапа(Форма);
	ЗаполнитьПризнакПроверкиОбязательныхРеквизитовПервичногоДокументаТекущегоЭтапа(Форма);
	
	УправлениеДоступностьюРеквизитовСогласноШаблону(Форма);
	
КонецПроцедуры

Процедура ПринятьКИсполнениюИРазблокироватьФорму(Форма, Источник)
	
	Ссылка = Источник.Ссылка;
	
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Форма.ПроцессыОбработкиДокументов_ТекущийШаблон);
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	ИначеЕсли ПараметрыТекущегоЭтапа.Задача.Пустая() Тогда
		РазрешитьТолькоПросмотрФормы = Истина;
	Иначе
		РазрешитьТолькоПросмотрФормы = Ложь;
	КонецЕсли;
	
	УдалитьКнопкиСКомандамиРезультатовВыполнения(Форма);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКомментарии", "Видимость", НЕ РазрешитьТолькоПросмотрФормы);
	ДобавитьЭлементФормыТекущийСтатус(Форма, НЕ РазрешитьТолькоПросмотрФормы);
	
	// Если задача уже принята к исполнению другим исполнителем, то кнопка "Принять к исполнению" удаляется,
	// форма остается только на просмотр
	Если РазрешитьТолькоПросмотрФормы Тогда
		
		Форма.ПроцессыОбработкиДокументов_ТекстПредупреждения = НСтр("ru='Задача уже принята к исполнению другим пользователем, редактирование запрещено.'");
		
	Иначе
		
		Форма.ПроцессыОбработкиДокументов_ТекстПредупреждения = "";
		
		Если ПравоДоступа("Изменение", Ссылка.Метаданные()) Тогда
			Форма.ТолькоПросмотр = Ложь;
		КонецЕсли;
		
		ПроцессыОбработкиДокументовВызовСервера.ПринятьЗадачиКИсполнению(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыТекущегоЭтапа.Задача),
			Новый Массив);
		
		Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ТекущаяЗадача") Тогда
			ДобавитьРеквизитыФормыПроцесса(Форма, Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения, Ложь);
			ОбновитьЗначенияКонстантВРеквизитахФормы(Форма);
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КомментарийСледующему", "Видимость", Истина);
		
		ИнициализацияФормыСогласноТекущемуЭтапу(Форма, ПараметрыТекущегоЭтапа);
		
		ОбновитьПодсказкуВозможностиИзмененияШаблона(Форма, Источник);
		
	КонецЕсли;
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриИнициализацииФормыДокумента(Форма, Источник, ПараметрыТекущегоЭтапа);
	
КонецПроцедуры

Процедура ОбновитьРеквизитыПоШаблонуПроцесса(Форма, Источник)
	
	Если НЕ Источник.Ссылка.Пустая() Тогда
		// Проверка возможности изменения шаблона
		Если ЕстьВыполненныеИПринятыеКИсполнениюЗадачи(Источник.Ссылка, Новый Массив) Тогда
			Возврат;
		КонецЕсли;
		// Проверка ранее проведенной инициализации формы
		Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
			Форма, "ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ШаблонИСтатус = ШаблонИСтатусНовогоДокумента(Источник, Истина);
	Шаблон = ШаблонИСтатус.Шаблон;
	Статус = ШаблонИСтатус.Статус;
	
	Если ШаблонИСтатус.Свойство("ШаблонНеОпределен") Тогда
		// Если шаблон не определен, то необходимо добавить планку с сообщением, если ее не было,
		// и очистить команды резолюций, статус, поле комментария, если ранее шаблон был заполнен.
		ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения,
			ШаблонИСтатус.ШаблонНеОпределен);
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ТекущийШаблон")
			И ЗначениеЗаполнено(Форма.ПроцессыОбработкиДокументов_ТекущийШаблон) Тогда
			НастроитьЭлементыФормыПриОчисткеШаблонаПроцесса(Форма);
		КонецЕсли;
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Шаблон) Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ТекущийШаблон")
			И ЗначениеЗаполнено(Форма.ПроцессыОбработкиДокументов_ТекущийШаблон) Тогда
			НастроитьЭлементыФормыПриОчисткеШаблонаПроцесса(Форма);
		КонецЕсли;
		Возврат;
	Иначе
		// Если шаблон определен, то планка удаляется
		УдалитьЭлементФормыНевозможностьОбработкиДокумента(Форма);
		
		// Если реквизиты уже были проинициализированы, то повторная инициализация не требуется
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ПроцессыОбработкиДокументов_ТекущийШаблон") Тогда
			ТребуетсяДобавлениеРеквизитов = Ложь;
			Если Форма.ПроцессыОбработкиДокументов_ТекущийШаблон <> Шаблон Тогда
				// Если шаблон уже заполнен и он изменился, то требуется переинициализация реквизитов по новому шаблону
				НастроитьЭлементыФормыПриОчисткеШаблонаПроцесса(Форма);
			Иначе
				УстановитьВидимостьПодсказкиВозможностиИзмененияШаблона(Форма, Ложь);
				// Если шаблон уже заполнен и он остался таким же, то все уже должно быть проиницииализировано - выходим
				Возврат;
			КонецЕсли;
		Иначе
			ТребуетсяДобавлениеРеквизитов = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Ссылка = Источник.Ссылка;
	
	// Определение текущего этапа и возможности его выполнения текущим пользователем
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Шаблон, Истина);
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения,
			ПараметрыТекущегоЭтапа);
		Возврат;
	ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения,
			НСтр("ru='В данный момент выполняется задача по обработке документа.'"));
		Возврат;
	ИначеЕсли НЕ ТекущийПользовательМожетБытьИсполнителем(Источник, ПараметрыТекущегоЭтапа, Шаблон) Тогда
		ДобавитьЭлементФормыНевозможностьОбработкиДокумента(Форма, Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения,
			НСтр("ru='Недостаточно прав для обработки документа по шаблону процесса.'"));
		Возврат;
	КонецЕсли;
	
	Если ТребуетсяДобавлениеРеквизитов Тогда
		ДобавитьРеквизитыФормыПроцесса(Форма, Форма.ПроцессыОбработкиДокументов_ИмяГруппыДляРазмещения);
		ОбновитьЗначенияКонстантВРеквизитахФормы(Форма);
	КонецЕсли;
	
	Форма.ПроцессыОбработкиДокументов_ТекущийШаблон = Шаблон;
	Форма.ПроцессыОбработкиДокументов_ТекущийСтатус = Статус;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКомментарии", "Видимость", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ТекущийСтатус", "Видимость", Истина);
	
	ИнициализацияФормыСогласноТекущемуЭтапу(Форма, ПараметрыТекущегоЭтапа);
	
	ПроцессыОбработкиДокументовПереопределяемый.ПриИнициализацииФормыДокумента(Форма, Источник, ПараметрыТекущегоЭтапа);
	
КонецПроцедуры

Процедура УправлениеДоступностьюРеквизитовСогласноШаблону(Форма)
	
	// Если для документа не задан шаблон, то доступность не ограничивается
	Если Не ОбщегоНазначения.СсылкаСуществует(Форма.ПроцессыОбработкиДокументов_ТекущийШаблон) Тогда
		Форма.ТолькоПросмотр = Ложь;
		Возврат;
	КонецЕсли;

	НедоступныеРеквизиты = НедоступныеДляРедактированияРеквизиты(
	Форма.ПроцессыОбработкиДокументов_ТекущийШаблон, Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа);

	ЗонаОтветственности = РеквизитыВЗонеОтветственности(
	Форма.ПроцессыОбработкиДокументов_ТекущийШаблон, Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа);

	БлокируемыеЭлементы = Новый Массив;

	Для Каждого ЭлементФормы Из Форма.Элементы Цикл

		Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы")
			И ЭлементФормы.Вид <> ВидПоляФормы.ПолеНадписи
			ИЛИ ТипЗнч(ЭлементФормы) = Тип("ТаблицаФормы") Тогда

			РазложенныйПутьКДанным = СтрРазделить(ЭлементФормы.ПутьКДанным, ".", Ложь);

			Если РазложенныйПутьКДанным.Количество() = 2 Тогда
				ИмяРеквизита = РазложенныйПутьКДанным[1];
			ИначеЕсли РазложенныйПутьКДанным.Количество() = 3 Тогда
				Если Прав(РазложенныйПутьКДанным[1], 3) = "[0]" Тогда
					ИмяТЧ = Лев(РазложенныйПутьКДанным[1], СтрДлина(РазложенныйПутьКДанным[1]) - 3);
					ИмяРеквизита = ИмяТЧ + "." + РазложенныйПутьКДанным[2];
				Иначе
					ИмяРеквизита = РазложенныйПутьКДанным[1] + "." + РазложенныйПутьКДанным[2];
				КонецЕсли;
			ИначеЕсли РазложенныйПутьКДанным.Количество() = 4
				И РазложенныйПутьКДанным[0] = "Элементы"
				И РазложенныйПутьКДанным[2] = "ТекущиеДанные" Тогда
				РазложенныйПутьКДаннымТЧ = СтрРазделить(Форма.Элементы[РазложенныйПутьКДанным[1]].ПутьКДанным, ".", Ложь);
				Если РазложенныйПутьКДаннымТЧ.Количество() < 2 Тогда
					Продолжить;
				КонецЕсли;
				ИмяРеквизита = РазложенныйПутьКДаннымТЧ[1] + "." + РазложенныйПутьКДанным[3];
			Иначе
				Продолжить;
			КонецЕсли;

			Если НЕ НедоступныеРеквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
				БлокируемыеЭлементы.Добавить(ЭлементФормы.Имя); 
				
	            ПроцессыОбработкиДокументовПереопределяемый.ЗаблокироватьЭлементыКоманднйПанелиТабличнойЧасти(Форма, 
																									НедоступныеРеквизиты, 
																									БлокируемыеЭлементы, 
																									ЭлементФормы, 
																									ИмяРеквизита); 
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	ПроцессыОбработкиДокументовПереопределяемый.УправлениеДоступностьюРеквизитовСогласноШаблону(
	Форма, НедоступныеРеквизиты, ЗонаОтветственности, БлокируемыеЭлементы);
	
	НастройкиЭлементовФормы = НастройкиУправленияСвойствамиЭлементовСогласноЭтапу(
	Форма.ПроцессыОбработкиДокументов_ТекущийШаблон, Форма.ПроцессыОбработкиДокументов_ТекущийИдентификаторЭтапа);
	
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовПереопределяемый.УправлениеСвойствамиЭлементовФормыСогласноШаблону(
	Форма, НастройкиЭлементовФормы, СтандартнаяОбработка);

	Если СтандартнаяОбработка Тогда
		НевидимыеЭлементы = Новый Массив;
		ЭлементыСОтметкойНезаполненного = Новый Массив;
		СтартоваяСтраница = Новый Массив; 

		Для Каждого СтрокаЭлемент Из НастройкиЭлементовФормы Цикл
			
			Если СтрокаЭлемент.ЗапретДоступности
				И БлокируемыеЭлементы.Найти(СтрокаЭлемент.ИмяЭлемента) = Неопределено Тогда
				БлокируемыеЭлементы.Добавить(СтрокаЭлемент.ИмяЭлемента); 
			КонецЕсли; 
			
			Если СтрокаЭлемент.ЗапретВидимости Тогда
				НевидимыеЭлементы.Добавить(СтрокаЭлемент.ИмяЭлемента);
				УправлениеВидимостьюЭлементаФормы(Форма, СтрокаЭлемент.ИмяЭлемента, Ложь)
			КонецЕсли;
			
			Если СтрокаЭлемент.ОтметкаНезаполненного Тогда 
				ЭлементыСОтметкойНезаполненного.Добавить(СтрокаЭлемент.ИмяЭлемента);
				УправлениеОтметкойНезаполенногоЭлементаФормы(Форма, СтрокаЭлемент.ИмяЭлемента, Истина)
			КонецЕсли;   
			
			Если ЗначениеЗаполнено(СтрокаЭлемент.СтартоваяСтраница) Тогда 
				СтартоваяСтраница.Добавить(СтрокаЭлемент.ИмяЭлемента);
				СтартоваяСтраница.Добавить(СтрокаЭлемент.СтартоваяСтраница);
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтартоваяСтраница.Количество() = 2 Тогда
			УстановитьСтартовуюСтраницу(Форма, СтартоваяСтраница[1], СтартоваяСтраница[0])
		КонецЕсли;
	 
	КонецЕсли; 
	
	// Блокировка редактирования элементов формы, связанных с заданными реквизитами.
	УправлениеБлокировкойЭлементовФормы(Форма, БлокируемыеЭлементы, Истина);
	
	Если СтандартнаяОбработка Тогда  
		УправлениеРазБлокировкойЭлементовФормы(Форма, БлокируемыеЭлементы, НевидимыеЭлементы, ЭлементыСОтметкойНезаполненного); 
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбновитьПодсказкуВозможностиИзмененияШаблона(Форма, Документ)
	
	ТекущийШаблон = Форма.ПроцессыОбработкиДокументов_ТекущийШаблон;
	
	ПодходящийШаблон = ПодходящийШаблонДляИзменения(Документ, ТекущийШаблон, Новый Массив);
	
	ДобавитьЭлементФормыИзменениеШаблона(Форма, ПодходящийШаблон);
	
	УстановитьВидимостьПодсказкиВозможностиИзмененияШаблона(Форма, ЗначениеЗаполнено(ПодходящийШаблон));
	
КонецПроцедуры

Функция ПодходящийШаблонДляИзменения(Документ, ТекущийШаблон, ЗадачиДляПрерывания)
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ШаблоныПроцессов) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Документ) Тогда
		Ссылка = Документ;
	Иначе
		Ссылка = Документ.Ссылка;
	КонецЕсли;
	
	Результат = Новый Структура("Шаблон", Неопределено);
	
	СтандартнаяОбработка = Истина;
	ПроцессыОбработкиДокументовПереопределяемый.ПриОпределенииШаблонаИСтатусаНовогоДокумента(
		Документ, Ложь, Результат, СтандартнаяОбработка);
	
	Если НЕ СтандартнаяОбработка Тогда
		
		Если Результат.Свойство("ШаблонНеОпределен") Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПодходящийШаблон = Результат.Шаблон;
		
		// Если текущий шаблон подходящий, то изменение не требуется
		Если ПодходящийШаблон = ТекущийШаблон Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		Выборка = ВыборкаИспользуемыхШаблоновДокумента(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Ссылка)));
		
		ПодходящиеШаблоны = Новый Соответствие;
		
		Пока Выборка.Следующий() Цикл
			Если ДокументПодходитПоУсловию(Документ, Выборка.УсловиеИспользования) Тогда
				ПодходящиеШаблоны.Вставить(Выборка.Шаблон, Истина);
			КонецЕсли;
		КонецЦикла;
		
		// Если текущий шаблон подходящий, то изменение не требуется
		Если ПодходящиеШаблоны.Получить(ТекущийШаблон) <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Если подходящих шаблонов больше одного, то изменение невозможно
		Если ПодходящиеШаблоны.Количество() <> 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПодходящийШаблон = Неопределено;
		Для Каждого Шаблон Из ПодходящиеШаблоны Цикл
			ПодходящийШаблон = Шаблон.Ключ
		КонецЦикла;
		
	КонецЕсли;
	
	// Проверка наличия выполненных задач
	Если ЕстьВыполненныеИПринятыеКИсполнениюЗадачи(Ссылка, ЗадачиДляПрерывания) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Проверка возможности перехода на новый шаблон текущим пользователем
	// Определение текущего этапа и возможности его выполнения текущим пользователем
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, ПодходящийШаблон, Истина);
	
	Если ТипЗнч(ПараметрыТекущегоЭтапа) = Тип("Строка") Тогда
		Возврат Неопределено;
	ИначеЕсли ПараметрыТекущегоЭтапа.ИдентификаторПачки <> Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли НЕ ТекущийПользовательМожетБытьИсполнителем(Ссылка, ПараметрыТекущегоЭтапа, ПодходящийШаблон) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПодходящийШаблон;
	
КонецФункции

Функция ЕстьВыполненныеИПринятыеКИсполнениюЗадачи(Документ, Задачи)
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаПоОбработкеДокумента.Ссылка КАК Ссылка,
	|	ЗадачаПоОбработкеДокумента.Наименование КАК Наименование,
	|	ЗадачаПоОбработкеДокумента.Выполнена КАК Выполнена,
	|	ЗадачаПоОбработкеДокумента.ПринятаКИсполнению КАК ПринятаКИсполнению,
	|	ЗадачаПоОбработкеДокумента.Исполнитель КАК Исполнитель
	|ИЗ
	|	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
	|ГДЕ
	|	ЗадачаПоОбработкеДокумента.Предмет = &Документ
	|	И НЕ ЗадачаПоОбработкеДокумента.Прервана";
	Запрос.УстановитьПараметр("Документ", Документ);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Выполнена Тогда
			Возврат Истина;
		ИначеЕсли Выборка.ПринятаКИсполнению И НЕ Выборка.Исполнитель = ТекущийПользователь Тогда
			Возврат Истина;
		Иначе
			Задачи.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДобавитьЭлементФормыИзменениеШаблона(Форма, ПодходящийШаблон)
	
	ЭлементФормыТекущийШаблонНеПодходит = Форма.Элементы.Найти("ДекорацияТекущийШаблонНеПодходит");
	Если ЭлементФормыТекущийШаблонНеПодходит = Неопределено Тогда
		
		ГруппаПроцесс = НайтиДобавитьГруппуДляРазмещения(Форма, Истина);
		
		ГруппаИзменениеШаблона = Форма.Элементы.Добавить("ГруппаИзменениеШаблона", Тип("ГруппаФормы"), ГруппаПроцесс);
		ГруппаИзменениеШаблона.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаИзменениеШаблона.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаИзменениеШаблона.ОтображатьЗаголовок = Ложь;
		ГруппаИзменениеШаблона.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ГруппаИзменениеШаблона.РастягиватьПоГоризонтали = Истина;
		
		ЭлементФормыТекущийШаблонНеПодходит = Форма.Элементы.Добавить(
			"ДекорацияТекущийШаблонНеПодходит", Тип("ДекорацияФормы"), ГруппаИзменениеШаблона);
		ЭлементФормыТекущийШаблонНеПодходит.Вид = ВидДекорацииФормы.Надпись;
		ЭлементФормыТекущийШаблонНеПодходит.АвтоМаксимальнаяШирина = Ложь;
		ЭлементФормыТекущийШаблонНеПодходит.ЦветТекста = WebЦвета.Кирпичный;
		ЭлементФормыТекущийШаблонНеПодходит.Заголовок =
			НСтр("ru='Текущий шаблон процесса не подходит по условию использования. Предлагается заменить его на подходящий шаблон:'");
		
		ЭлементФормыВыбратьШаблонВручную = Форма.Элементы.Добавить(
			"ДекорацияПодходящийШаблон", Тип("ДекорацияФормы"), ГруппаИзменениеШаблона);
		ЭлементФормыВыбратьШаблонВручную.Вид = ВидДекорацииФормы.Надпись;
		ЭлементФормыВыбратьШаблонВручную.АвтоМаксимальнаяШирина = Ложь;
		ЭлементФормыВыбратьШаблонВручную.Гиперссылка = Истина;
		ЭлементФормыВыбратьШаблонВручную.УстановитьДействие("Нажатие","Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента");
		
		Форма.Элементы.Переместить(ГруппаИзменениеШаблона, ГруппаПроцесс, НайтиДобавитьГруппуДляРазмещения(Форма));
		
	Иначе
		
		ЭлементФормыВыбратьШаблонВручную = Форма.Элементы.Найти("ДекорацияПодходящийШаблон");
		
	КонецЕсли;
	
	ЭлементФормыВыбратьШаблонВручную.Заголовок = Строка(ПодходящийШаблон);
	
КонецПроцедуры

Процедура УстановитьВидимостьПодсказкиВозможностиИзмененияШаблона(Форма, Видимость)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ДекорацияТекущийШаблонНеПодходит", "Видимость", Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ДекорацияПодходящийШаблон", "Видимость", Видимость);
	
КонецПроцедуры

Процедура ИзменитьШаблонПроцессаНаФорме(Форма, Источник)
	
	ТекущийШаблон = Форма.ПроцессыОбработкиДокументов_ТекущийШаблон;
	
	ЗадачиДляПрерывания = Новый Массив;
	
	ПодходящийШаблон = ПодходящийШаблонДляИзменения(Источник, ТекущийШаблон, ЗадачиДляПрерывания);
	
	Если Не ЗначениеЗаполнено(ПодходящийШаблон) Тогда
		ТекстСообщения = НСтр("ru='Не удалось изменить шаблон процесса'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Ссылка = Источник.Ссылка;
	
	НачатьТранзакцию();
	Попытка
		
		ИзменитьШаблонПроцесса(Ссылка, ПодходящийШаблон, ЗадачиДляПрерывания);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
	// В случае успешного измения шаблона требуется переинициализация формы
	Форма.Прочитать();
	
КонецПроцедуры

Процедура ИзменитьШаблонПроцесса(Ссылка, Шаблон, ЗадачиДляПрерывания)
	
	ПроверитьИЗаблокироватьЗадачиОтВыполнения(ЗадачиДляПрерывания);
	
	ЗаблокироватьЗадачи(ЗадачиДляПрерывания);
	
	ЗаблокироватьРегистрТекущиеСтатусыДокументов(Ссылка);
	
	// Прерывание текущей задачи пользователя
	ЗадачиОбъектыДляПрерывания = Новый Массив;
	
	ПрерватьВыполнениеЗадач(ЗадачиДляПрерывания, ЗадачиОбъектыДляПрерывания);
	
	СохранитьСобытиеИсторииЗадач(ЗадачиДляПрерывания, ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.Прерывание"));
	
	// Прерывание регламентного(ых) интервала(ов)
	Для Каждого ПрерваннаяЗадача Из ЗадачиОбъектыДляПрерывания Цикл
		ПрерватьРегламентныйИнтервал(ПрерваннаяЗадача.Предмет, ПрерваннаяЗадача.РегламентныйИнтервал, ПрерваннаяЗадача.НомерИтерации);
	КонецЦикла;
	
	// Присвоение начального статуса и запуск стартового этапа нового шаблона
	НачальныйСтатус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шаблон, "НачальныйСтатус");
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	ДатаИзмененияСтатуса = ТекущаяДатаСеанса();
	
	ИзменитьИсториюСтатусовДокумента(Ссылка, Шаблон, НачальныйСтатус, ТекущийПользователь, ДатаИзмененияСтатуса);
	УстановитьТекущийСтатусДокумента(Ссылка, Шаблон, НачальныйСтатус, ТекущийПользователь, ДатаИзмененияСтатуса);
	
	ПараметрыТекущегоЭтапа = ПараметрыТекущегоЭтапаПроцесса(Ссылка, Шаблон, Истина);
	
	ИсполнителиЭтапа = ИсполнителиЭтапаПроцесса(Ссылка, Шаблон, ПараметрыТекущегоЭтапа);
	
	// создание стартовых задач
	Для Каждого ИсполнительЭтапа Из ИсполнителиЭтапа Цикл
		
		Если ИсполнительЭтапа.НеСоздаватьЗадачу Тогда
			Продолжить;
		КонецЕсли;
		
		ПринятьЗадачуКИсполнению = ТекущийПользовательМожетБытьИсполнителем(
			Ссылка, ПараметрыТекущегоЭтапа, Шаблон, ИсполнительЭтапа);
		
		ПараметрыЗадачи = ПараметрыСозданияЗадачи();
		ПараметрыЗадачи.Шаблон = Шаблон;
		ПараметрыЗадачи.Этап = ПараметрыТекущегоЭтапа.Этап;
		ПараметрыЗадачи.ИдентификаторЭтапа = ПараметрыТекущегоЭтапа.ИдентификаторЭтапа;
		ПараметрыЗадачи.НаименованиеЭтапа = ПараметрыТекущегоЭтапа.НаименованиеЭтапа;
		ПараметрыЗадачи.Статус = НачальныйСтатус;
		ПараметрыЗадачи.Документ = Ссылка;
		ПараметрыЗадачи.Описание = "";
		ПараметрыЗадачи.Автор = ТекущийПользователь;
		ПараметрыЗадачи.РезультатВыполнения = "";
		ПараметрыЗадачи.ПринятаКИсполнению = ПринятьЗадачуКИсполнению;
		ПараметрыЗадачи.Предшественники = Новый Массив;
		ПараметрыЗадачи.СрокВыполненияЧасы = ПараметрыТекущегоЭтапа.СрокВыполненияЧасы;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыЗадачи, ИсполнительЭтапа, Истина);
		
		СоздатьЗадачу(ПараметрыЗадачи);
		
		Если ПараметрыЗадачи.ПринятаКИсполнению Тогда
			СохранитьСобытиеИсторииЗадач(ПараметрыЗадачи.Задача,
			ПредопределенноеЗначение("Перечисление.СобытияИсторииЗадач.ПринятиеКИсполнению"), , ПараметрыЗадачи.Дата);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

