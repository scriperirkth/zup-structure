Функция ФайлФормуляраПервичногоДокументаПОД(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД, ИдентификаторЭтапа, РеквизитыДокумента, ДатаФормирования, ФайлФормируетПользователь) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Результат = Документы.ФормулярПервичногоДокументаПОД.ПустаяСсылка();
	
	Организация = РеквизитыДокумента.Организация;
	
	СуществующийФормулярЭтапа = НайтиФайлФормуляраПервичногоДокументаДляЗадачиПОД(ВыполняемаяЗадача, СведенияПредставленияВнутреннегоЭД);
	Если ЗначениеЗаполнено(СуществующийФормулярЭтапа) Тогда
		ФормулярОбъект = СуществующийФормулярЭтапа.ПолучитьОбъект();
	Иначе	
		ФормулярОбъект = Документы.ФормулярПервичногоДокументаПОД.СоздатьДокумент();
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(ФормулярОбъект, СведенияПредставленияВнутреннегоЭД);
	
	ФормулярОбъект.Дата = ДатаФормирования;
	ФормулярОбъект.ИдентификаторПечатнойФормы = СведенияПредставленияВнутреннегоЭД.ИдентификаторПечати;
	ФормулярОбъект.НаименованиеПечатнойФормы = СведенияПредставленияВнутреннегоЭД.НаименованиеПечатнойФормыДокумента;
	ФормулярОбъект.ИдентификаторФормуляра = СведенияПредставленияВнутреннегоЭД.ИдентификаторФормуляра;
	ФормулярОбъект.Организация = Организация;
	ФормулярОбъект.ВыполняемаяЗадачаСоздатель = ВыполняемаяЗадача;
	ФормулярОбъект.ИдентификаторЭтапа = ВыполняемаяЗадача.ИдентификаторЭтапа;
	
	Если ЗначениеЗаполнено(РеквизитыДокумента.ВидРегистра) Тогда
		ФормулярОбъект.НаименованиеВидаРегистраУчета = Строка(РеквизитыДокумента.ВидРегистра);
		ФормулярОбъект.ОписаниеРегистраУчета = РеквизитыДокумента.Описание;
		ФормулярОбъект.НачалоПериода = РеквизитыДокумента.НачалоПериода;
		ФормулярОбъект.КонецПериода = РеквизитыДокумента.КонецПериода;
	КонецЕсли;	
	
	ДвоичныеДанныеДокумента = СведенияПредставленияВнутреннегоЭД.ДвоичныеДанныеФайла;
	АдресОсновногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеДокумента, Новый УникальныйИдентификатор);
	
	ИмяБезРасширения = ПроцессыОбработкиДокументовКлиентСервер.ПредставлениеФормуляраПоСвойствам(СведенияПредставленияВнутреннегоЭД);
	ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, " ", "_");
	ИмяБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяБезРасширения, "_");
	
	Расширение = РасширениеФайлаФормуляра(СведенияПредставленияВнутреннегоЭД.КодВидаСведений);
	ПолноеИмяФайла = ИмяБезРасширения + "." + Расширение;
	
	ФормулярОбъект.ДополнительныеСвойства.Вставить("АдресОсновногоФайла", АдресОсновногоФайла);
	ФормулярОбъект.ДополнительныеСвойства.Вставить("ИмяФайла", ПолноеИмяФайла);
	ФормулярОбъект.ДополнительныеСвойства.Вставить("ФайлФормируетПользователь", ФайлФормируетПользователь);
	
	ФормулярОбъект.Записать();
	
	Результат = ФормулярОбъект.Ссылка;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции	

Функция ПрисоединенныеФайлыФормуляраПервичногоДокумента(Предмет, ИдентификаторФормуляра) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ФайлПустой = Справочники.ФормулярПервичногоДокументаПОДПрисоединенныеФайлы.ПустаяСсылка();

	Результат = Новый Структура;
	Результат.Вставить("ФайлMXL", ФайлПустой);
	Результат.Вставить("ФайлPDF", ФайлПустой);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФормулярПервичногоДокументаПОД.КодВидаСведений КАК КодВидаСведений,
